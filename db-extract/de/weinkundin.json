                "senses": [
                    {
                        "sense_id": "253abe09-b324-345d-b070-99aa15788c5c",
                        "entry_id": "19c7b321-2a95-3b1a-afed-f9e49ea90b86",
                        "glosses": [
                            "Käuferin, Abnehmerin von Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c4396f9-2fcd-4cee-a10e-a22f38d71a4f",
                                "sense_id": "253abe09-b324-345d-b070-99aa15788c5c",
                                "text": "„Woran erkenne ich als Verbraucher einen Biowein, einen Wein aus kontrolliert ökologischem Anbau? ‚Am Etikett natürlich!‘, möchte man der Weinkundin schnell zurufen.“"
                            },
                            {
                                "example_id": "547fcd51-67dd-4355-bd76-6338cd064e31",
                                "sense_id": "253abe09-b324-345d-b070-99aa15788c5c",
                                "text": "„Sie hat es mit Fassung getragen, denn als Weinkundin meines Vaters habe ich sie kennenlernen dürfen.“"
                            },
                            {
                                "example_id": "b2a26575-933b-4b1f-8198-225555687eda",
                                "sense_id": "253abe09-b324-345d-b070-99aa15788c5c",
                                "text": "„Deutsche Weinkundinnen und -kunden sind bereit, für deutsche Öko-Weine deutliche Aufschläge zu zahlen.“"
                            },
                            {
                                "example_id": "24ab161c-efea-438c-8c37-a8d68b27fc6c",
                                "sense_id": "253abe09-b324-345d-b070-99aa15788c5c",
                                "text": "„Die bieten im Auftrag ihrer Weinkundinnen und -kunden und sind damit Mittler zwischen denen die verkaufen und denen die kaufen.“"
                            },
                            {
                                "example_id": "bd31e3d9-3e4a-477e-99a7-f59f6db5d017",
                                "sense_id": "253abe09-b324-345d-b070-99aa15788c5c",
                                "text": "„Regionalität hat für junge Weinkundinnen die höchste Bedeutung“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
