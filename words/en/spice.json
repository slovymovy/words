{
    "word_family": [
        "spicy",
        "spiciness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "faf9da65-7722-3242-adcc-4c72ceffe15d",
                    "sense_definition": "Aromatic or pungent plant matter, usually dried, used to season or flavor food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_ingredient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cinnamon is a very popular <w>spice</w> used in baking cakes.",
                            "target_lang_translations": {
                                "ru": "Корица — очень популярная <w>специя</w>, используемая при выпечке тортов.",
                                "zh": "肉桂是烤蛋糕时常用的一种<w>香料</w>。"
                            }
                        },
                        {
                            "text": "You should add some <w>spice</w> to the soup to make it tastier.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит добавить в суп немного <w>специй</w>, чтобы он стал вкуснее.",
                                "zh": "你应该在汤里加一些<w>香料</w>，让它更好喝。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spice rack",
                        "ground spice",
                        "add spice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ароматическое или острое вещество растительного происхождения, обычно в сушеном виде, используемое для придания вкуса или аромата пище.",
                        "zh": "芳香或辛辣的植物性材料，通常为干制，用来给食物调味或增添风味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специя",
                                "target_lang_sense_clarification": "вкусовая добавка"
                            },
                            {
                                "target_lang_word": "пряность",
                                "target_lang_sense_clarification": "растительного происхождения"
                            },
                            {
                                "target_lang_word": "приправа",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "香料",
                                "target_lang_sense_clarification": "用于给食物增香增味的植物性材料"
                            },
                            {
                                "target_lang_word": "香辛料",
                                "target_lang_sense_clarification": "多指干燥后的调味植物成分"
                            },
                            {
                                "target_lang_word": "调料",
                                "target_lang_sense_clarification": "较宽泛的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db878392-7122-3013-a15f-274e08fa00c5",
                    "sense_definition": "The quality of being spicy or hot to the taste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flavor_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoy the <w>spice</w> of these chili peppers in my dinner.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>острота</w> этих перцев чили в моем ужине.",
                                "zh": "我喜欢晚饭里这些辣椒的<w>辣味</w>。"
                            }
                        },
                        {
                            "text": "The curry has a good <w>spice</w> level that is not too overwhelming.",
                            "target_lang_translations": {
                                "ru": "У этого карри хороший уровень <w>остроты</w>, не слишком чрезмерный.",
                                "zh": "这道咖喱的<w>辣度</w>正好，不会太冲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spiciness",
                        "heat",
                        "kick"
                    ],
                    "common_phrases": [
                        "spice level",
                        "mild spice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть острым или жгучим на вкус.",
                        "zh": "味道上辛辣、带刺激感的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острота",
                                "target_lang_sense_clarification": "жгучий вкус"
                            },
                            {
                                "target_lang_word": "пикантность",
                                "target_lang_sense_clarification": "умеренная острота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辣味",
                                "target_lang_sense_clarification": "辛辣的味道"
                            },
                            {
                                "target_lang_word": "辣度",
                                "target_lang_sense_clarification": "辣的强弱程度"
                            },
                            {
                                "target_lang_word": "辛辣感",
                                "target_lang_sense_clarification": "书面一些，指辛辣感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcc2306e-5d5c-3316-8646-997645a4070d",
                    "sense_definition": "Appeal, interest, or excitement; an attribute that makes something engaging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They say that variety is the <w>spice</w> of life.",
                            "target_lang_translations": {
                                "ru": "Говорят, что разнообразие придает <w>вкус</w> жизни.",
                                "zh": "人们常说，多样变化是生活的<w>调味剂</w>。"
                            }
                        },
                        {
                            "text": "Traveling to new places adds much needed <w>spice</w> to her routine.",
                            "target_lang_translations": {
                                "ru": "Путешествия в новые места добавляют столь необходимую <w>изюминку</w> в её рутину.",
                                "zh": "去新的地方旅行，给她一成不变的生活增添了不少<w>乐趣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spice of life",
                        "add spice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательность, интерес или острота ощущений; качество, делающее что-либо увлекательным.",
                        "zh": "吸引力、趣味或刺激感；使某事更有意思的特质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изюминка",
                                "target_lang_sense_clarification": "особенность"
                            },
                            {
                                "target_lang_word": "острота",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "интерес",
                                "target_lang_sense_clarification": "увлекательность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调味剂",
                                "target_lang_sense_clarification": "使事物更有趣、更有变化的东西"
                            },
                            {
                                "target_lang_word": "趣味",
                                "target_lang_sense_clarification": "吸引人的特别之处"
                            },
                            {
                                "target_lang_word": "乐趣",
                                "target_lang_sense_clarification": "让生活或活动更有意思的成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "775e727e-f0bb-34d0-976a-cf6c5f992a89",
                    "sense_definition": "A type of synthetic psychoactive drug.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police warned the public about the dangers of using <w>spice</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция предупредила общественность об опасности употребления <w>спайса</w>.",
                                "zh": "警方警告公众吸食<w>Spice</w>的危险。"
                            }
                        },
                        {
                            "text": "He was treated in the hospital after reacting badly to <w>spice</w>.",
                            "target_lang_translations": {
                                "ru": "Он лечился в больнице после тяжелой реакции на <w>спайс</w>.",
                                "zh": "他因对<w>Spice</w>产生严重不良反应而在医院接受治疗。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "street name for synthetic cannabinoids"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность синтетического психоактивного наркотика.",
                        "zh": "一种合成的致幻或兴奋类毒品，常指合成大麻素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спайс",
                                "target_lang_sense_clarification": "сленговое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Spice",
                                "target_lang_sense_clarification": "街头称呼，指一种合成大麻素类毒品"
                            },
                            {
                                "target_lang_word": "合成大麻素",
                                "target_lang_sense_clarification": "较说明性的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b38425-1978-3299-b200-106933c683b0",
                    "sense_definition": "Sweets or candy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regional_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran to the shop to buy some <w>spice</w> with their pocket money.",
                            "target_lang_translations": {
                                "ru": "Дети побежали в магазин, чтобы купить <w>сладостей</w> на свои карманные деньги.",
                                "zh": "孩子们拿着零花钱跑到商店去买些<w>糖果</w>。"
                            }
                        },
                        {
                            "text": "My grandmother always kept a jar of <w>spice</w> on the shelf.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка всегда держала банку с <w>конфетами</w> на полке.",
                                "zh": "我奶奶总是在架子上放着一罐<w>糖果</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern English / Yorkshire dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладости или конфеты.",
                        "zh": "糖果或其他甜食。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сладости",
                                "target_lang_sense_clarification": "кондитерские изделия"
                            },
                            {
                                "target_lang_word": "конфеты",
                                "target_lang_sense_clarification": "лакомство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糖果",
                                "target_lang_sense_clarification": "方言义，泛指甜食"
                            },
                            {
                                "target_lang_word": "甜食",
                                "target_lang_sense_clarification": "较宽泛，指甜的零食"
                            },
                            {
                                "target_lang_word": "糖",
                                "target_lang_sense_clarification": "口语里也可指糖类小零嘴"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98eb80ac-8bf1-3f31-8744-136034ae5ef2",
                    "sense_definition": "To add spice or seasoning to food to improve its flavor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>spiced</w> the stew with paprika and black pepper.",
                            "target_lang_translations": {
                                "ru": "Она <w>приправила</w> рагу паприкой и черным перцем.",
                                "zh": "她用红椒粉和黑胡椒给炖菜<w>调味</w>。"
                            }
                        },
                        {
                            "text": "The chef <w>spiced</w> the meat heavily before grilling it.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар щедро <w>посыпал специями</w> мясо перед тем, как жарить его.",
                                "zh": "厨师在烤之前给肉加了很多<w>香料</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heavily spiced",
                        "lightly spiced"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять специи или приправы в пищу для улучшения её вкуса.",
                        "zh": "给食物加入香料或调味品，以改善其味道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приправлять",
                                "target_lang_sense_clarification": "добавлять приправу"
                            },
                            {
                                "target_lang_word": "добавлять специи",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调味",
                                "target_lang_sense_clarification": "给食物加调料或调味品"
                            },
                            {
                                "target_lang_word": "加香料",
                                "target_lang_sense_clarification": "加入香辛料"
                            },
                            {
                                "target_lang_word": "加调料",
                                "target_lang_sense_clarification": "烹饪中使味道更丰富"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fc281db-cf51-32d9-8dd1-8a39871def04",
                    "sense_definition": "To make something more interesting, exciting, or engaging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>spice</w> up his presentation with some funny jokes.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>оживить</w> свою презентацию несколькими смешными шутками.",
                                "zh": "他试着用几个好笑的笑话来<w>活跃</w>一下自己的演讲。"
                            }
                        },
                        {
                            "text": "We need to <w>spice</w> up the party with some better music.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>добавить огня</w> вечеринке с помощью музыки получше.",
                                "zh": "我们得用更好的音乐让派对<w>热闹</w>起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spice up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо более интересным, захватывающим или увлекательным.",
                        "zh": "使某事变得更有趣、更刺激或更吸引人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживить",
                                "target_lang_sense_clarification": "сделать интереснее"
                            },
                            {
                                "target_lang_word": "придать остроту",
                                "target_lang_sense_clarification": "разнообразить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活跃",
                                "target_lang_sense_clarification": "让内容或气氛更生动有趣"
                            },
                            {
                                "target_lang_word": "热闹",
                                "target_lang_sense_clarification": "让场面更有气氛"
                            },
                            {
                                "target_lang_word": "增添趣味",
                                "target_lang_sense_clarification": "较宽泛，指增添趣味"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c482dc9f-0619-3a6e-8fdb-da4a9eb786a3",
                    "sense_definition": "A general-purpose, open-source analog electronic circuit simulator.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "software",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The engineering students used <w>SPICE</w> to model the behavior of the circuit.",
                            "target_lang_translations": {
                                "ru": "Студенты-инженеры использовали <w>SPICE</w> для моделирования поведения схемы.",
                                "zh": "工程专业的学生用<w>SPICE</w>来模拟电路的工作情况。"
                            }
                        },
                        {
                            "text": "You can verify your design using a <w>SPICE</w> simulation before building it.",
                            "target_lang_translations": {
                                "ru": "Вы можете проверить свой проект с помощью симуляции <w>SPICE</w> перед сборкой.",
                                "zh": "你可以在制作之前先用<w>SPICE</w>仿真来验证自己的设计。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Универсальный симулятор аналоговых электронных схем с открытым исходным кодом.",
                        "zh": "一种通用的开源模拟电子电路仿真器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SPICE",
                                "target_lang_sense_clarification": "название программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "SPICE",
                                "target_lang_sense_clarification": "电路仿真软件名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "549f846f-95ce-393a-a5a6-2ba6725d6640",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Spice</w> was known in the town for his bakery.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Спайс</w> был известен в городе своей пекарней.",
                                "zh": "<w>斯派斯</w>先生因他的面包店而在镇上小有名气。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Spice</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Спайс</w>.",
                                "zh": "我以前从没见过姓<w>斯派斯</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спайс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯派斯",
                                "target_lang_sense_clarification": "英语姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}