                "senses": [
                    {
                        "sense_id": "acb80869-750d-3307-a837-e75545e74610",
                        "entry_id": "09ff2892-d5ef-39c0-a894-c8ac0d7a918c",
                        "glosses": [
                            "über den Rachen und die Speiseröhre bis zum Magen vorgeschobener Schlauch zur künstlichen Ernährung oder Entleerung des Magens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cefc6ca-6aac-4a0c-8d2f-30501f176da7",
                                "sense_id": "acb80869-750d-3307-a837-e75545e74610",
                                "text": "„Eine Frau hatte den Schlauch der Magensonde durchgeschnitten, durch die ihre im Koma liegende Mutter ernährt wurde.“"
                            },
                            {
                                "example_id": "7d37ca9b-830c-49b3-9bea-5cf4b8c61a9a",
                                "sense_id": "acb80869-750d-3307-a837-e75545e74610",
                                "text": "„Ein Polizeiarzt soll dem Mann im Jahr 2004 Brechmittel und Wasser über eine Magensonde eingeflößt haben, damit er zuvor geschluckte Kokainkügelchen wieder erbricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
