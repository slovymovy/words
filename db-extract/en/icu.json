                    {
                        "translation_id": "74c4b2eb-fefd-443e-a447-8d62c7e4af57",
                        "source_entry_id": "233f1876-52ed-315c-addb-387b70f7661b",
                        "source_sense_description": "intensive care unit",
                        "target_lang_word": "Intensivstation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intensivstation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7568ad11-5d70-3e2a-bb5a-a0b65973fc18",
                                        "entry_id": "8fe6c679-f414-3f7f-96da-14f3cb1bc904",
                                        "glosses": [
                                            "Abteilung eines Krankenhauses, in der Patienten liegen, deren Leben in Gefahr ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b2a860f-73f4-41c6-98dd-e6f5c4c67407",
                                                "sense_id": "7568ad11-5d70-3e2a-bb5a-a0b65973fc18",
                                                "text": "Der Patient wurde auf die Intensivstation verlegt."
                                            },
                                            {
                                                "example_id": "e5193912-8a89-44cc-8523-0ad70bab6180",
                                                "sense_id": "7568ad11-5d70-3e2a-bb5a-a0b65973fc18",
                                                "text": "„Die Intensivstation hatte er lediglich verlassen dürfen, weil die Ärzte ihm keine Chance mehr gaben.“"
                                            },
                                            {
                                                "example_id": "2717f2ea-d600-4b29-ac8f-a0c8b3c539ca",
                                                "sense_id": "7568ad11-5d70-3e2a-bb5a-a0b65973fc18",
                                                "text": "„Um das Lungenleiden Covid-19 zu behandeln, werden Betroffene auf Intensivstationen mit Beatmungsgeräten versorgt.“"
                                            },
                                            {
                                                "example_id": "1efe354a-178c-41bd-a1cf-7bcd7a7549e1",
                                                "sense_id": "7568ad11-5d70-3e2a-bb5a-a0b65973fc18",
                                                "text": "„Mannomann, dachte ich, das ist wirklich eine verdammt gut versteckte Intensivstation.“"
                                            },
                                            {
                                                "example_id": "3845304f-9680-4c99-bf20-4ae973a584f5",
                                                "sense_id": "7568ad11-5d70-3e2a-bb5a-a0b65973fc18",
                                                "text": "„Auf der Intensivstation hatte sie ein Einzelzimmer, sie trug das gleiche blaue Hemd wie alle anderen Patientinnen und Patienten, so durchschnittlich und wie alle anderen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
