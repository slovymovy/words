{
    "word_family": [
        "doer",
        "doing",
        "overdo",
        "redo",
        "undone"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e32b479-1ce1-362d-86c2-0fb55ad109f5",
                    "sense_definition": "To open or unfasten something that is tied, buttoned, or locked.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unfasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you please help me <w>undo</w> my buckle?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы помочь мне <w>расстегнуть</w> пряжку?"
                            }
                        },
                        {
                            "text": "He had to <w>undo</w> a button because the shirt was too tight.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>расстегнуть</w> пуговицу, потому что рубашка была слишком тесной."
                            }
                        }
                    ],
                    "synonyms": [
                        "unbuckle",
                        "unbutton",
                        "untie",
                        "unzip"
                    ],
                    "antonyms": [
                        "do up",
                        "button",
                        "button up",
                        "tie up",
                        "zip",
                        "zip up"
                    ],
                    "common_phrases": [
                        "undo a button",
                        "undo a knot",
                        "undo a zipper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыть или расстегнуть что-то завязанное, застегнутое на пуговицы или запертое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстегнуть",
                                "target_lang_sense_clarification": "пуговицы, молнию или пряжку"
                            },
                            {
                                "target_lang_word": "развязать",
                                "target_lang_sense_clarification": "узлы, шнурки или что-то связанное"
                            },
                            {
                                "target_lang_word": "открыть",
                                "target_lang_sense_clarification": "замок или засов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                    "sense_definition": "To reverse the effects or results of a previous action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reverse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>undo</w> the changes if you make a mistake while typing.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>отменить</w> изменения, если допустите ошибку при наборе текста."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>undo</w> the damage caused by a natural disaster.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>исправить</w> ущерб, нанесенный стихийным бедствием."
                            }
                        }
                    ],
                    "synonyms": [
                        "cancel",
                        "reverse"
                    ],
                    "antonyms": [
                        "redo"
                    ],
                    "common_phrases": [
                        "undo the damage",
                        "undo the changes",
                        "undo the effects"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отменить последствия или результаты предыдущего действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменить",
                                "target_lang_sense_clarification": "изменения или действие"
                            },
                            {
                                "target_lang_word": "исправить",
                                "target_lang_sense_clarification": "нанесенный вред или ошибку"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "последствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9aacc2b-f356-30c7-8faa-7d0383cc84d8",
                    "sense_definition": "To cause the downfall or ruin of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His extreme arrogance will eventually <w>undo</w> him.",
                            "target_lang_translations": {
                                "ru": "Его крайнее высокомерие в конце концов <w>погубит</w> его."
                            }
                        },
                        {
                            "text": "The scandal threatened to <w>undo</w> the reputation he had built over decades.",
                            "target_lang_translations": {
                                "ru": "Скандал грозил <w>разрушить</w> репутацию, которую он создавал десятилетиями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "undo a reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать причиной гибели, краха или разорения кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погубить",
                                "target_lang_sense_clarification": "человека или репутацию"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "планы или достижения"
                            },
                            {
                                "target_lang_word": "свести на нет",
                                "target_lang_sense_clarification": "усилия или результаты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e5adfc8-f3b5-3e88-8e54-7b62fc4e9300",
                    "sense_definition": "A command or feature in a computer program that reverses the last action performed.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reverse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally deleted the paragraph, so I clicked <w>undo</w> to get it back.",
                            "target_lang_translations": {
                                "ru": "Я случайно удалил абзац, поэтому нажал «<w>отменить</w>», чтобы вернуть его."
                            }
                        },
                        {
                            "text": "How many <w>undos</w> does this photo editing program support?",
                            "target_lang_translations": {
                                "ru": "Сколько уровней <w>отмены</w> поддерживает эта программа для редактирования фотографий?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "click undo",
                        "undo button"
                    ],
                    "target_lang_definitions": {
                        "ru": "Команда или функция в компьютерной программе, которая отменяет последнее выполненное действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмена",
                                "target_lang_sense_clarification": "название функции в интерфейсе"
                            },
                            {
                                "target_lang_word": "отмена действия",
                                "target_lang_sense_clarification": "описание команды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10c0b849-c0fd-34ed-9ae5-684ab74d0435",
                    "sense_definition": "A misspelling of the word <w>undue</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document contained a typo where the author wrote <w>undo</w> instead of undue.",
                            "target_lang_translations": {
                                "ru": "В документе была опечатка: автор написал <w>undo</w> вместо undue."
                            }
                        },
                        {
                            "text": "Using <w>undo</w> in this context is technically a misspelling of the intended adjective.",
                            "target_lang_translations": {
                                "ru": "Использование <w>undo</w> в этом контексте технически является орфографической ошибкой вместо нужного прилагательного."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное написание слова undue (чрезмерный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опечатка",
                                "target_lang_sense_clarification": "вместо прилагательного undue"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}