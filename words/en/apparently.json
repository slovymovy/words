{
    "word_family": [
        "apparent",
        "appearance",
        "appear",
        "reappear",
        "disappear"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                    "sense_definition": "Used to say that something seems to be true based on what you have heard or read, though you are not certain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evidential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Apparently</w> you are quite a good dancer according to the people at the party.",
                            "target_lang_translations": {
                                "ru": "<w>Говорят</w>, ты неплохо танцуешь, если верить людям на вечеринке."
                            }
                        },
                        {
                            "text": "I heard that <w>apparently</w> they are going to contact the agency to find the child.",
                            "target_lang_translations": {
                                "ru": "Я слышал, что они, <w>по всей видимости</w>, собираются связаться с агентством, чтобы найти ребенка."
                            }
                        }
                    ],
                    "synonyms": [
                        "allegedly",
                        "reportedly",
                        "seemingly"
                    ],
                    "common_phrases": [
                        "apparently they are",
                        "apparently so"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для обозначения того, что что-то кажется правдой на основе услышанного или прочитанного, хотя вы в этом не уверены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по всей видимости",
                                "target_lang_sense_clarification": "судя по имеющейся информации"
                            },
                            {
                                "target_lang_word": "говорят",
                                "target_lang_sense_clarification": "согласно слухам или чужим словам"
                            },
                            {
                                "target_lang_word": "по слухам",
                                "target_lang_sense_clarification": "на основе того, что люди рассказывают"
                            },
                            {
                                "target_lang_word": "как утверждают",
                                "target_lang_sense_clarification": "согласно сообщениям других"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d7256d8-ee5b-3dd6-ab02-b8577ada3865",
                    "sense_definition": "Used to describe something that appears to be true based on the available evidence or logical deduction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evidential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Based on the results, you <w>apparently</w> know more about this subject than I do.",
                            "target_lang_translations": {
                                "ru": "Судя по результатам, вы, <w>по-видимому</w>, знаете об этом предмете больше, чем я."
                            }
                        },
                        {
                            "text": "The car <w>apparently</w> broke down because there is a large oil leak underneath it.",
                            "target_lang_translations": {
                                "ru": "Машина, <w>видать</w>, сломалась, потому что под ней большая лужа масла."
                            }
                        }
                    ],
                    "synonyms": [
                        "seemingly",
                        "evidently",
                        "ostensibly"
                    ],
                    "common_phrases": [
                        "apparently simple",
                        "apparently true"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания чего-либо, что кажется правдой на основе имеющихся доказательств или логического вывода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по-видимому",
                                "target_lang_sense_clarification": "судя по фактам или ситуации"
                            },
                            {
                                "target_lang_word": "очевидно",
                                "target_lang_sense_clarification": "вероятно, исходя из логики"
                            },
                            {
                                "target_lang_word": "видать",
                                "target_lang_sense_clarification": "разговорный вариант для логического вывода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                    "sense_definition": "In a way that relates to how something looks on the surface, which may be different from reality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A man may be <w>apparently</w> friendly yet remain very malicious in his heart.",
                            "target_lang_translations": {
                                "ru": "Человек может быть <w>внешне</w> дружелюбным, но при этом оставаться очень злобным в душе."
                            }
                        },
                        {
                            "text": "The <w>apparently</w> calm sea hid a very dangerous current underneath the surface.",
                            "target_lang_translations": {
                                "ru": "<w>С виду</w> спокойное море скрывало под поверхностью очень опасное течение."
                            }
                        }
                    ],
                    "synonyms": [
                        "seemingly",
                        "outwardly",
                        "superficially",
                        "on the surface"
                    ],
                    "common_phrases": [
                        "apparently healthy",
                        "apparently normal"
                    ],
                    "target_lang_definitions": {
                        "ru": "В значении, относящемся к тому, как что-то выглядит внешне, что может отличаться от действительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешне",
                                "target_lang_sense_clarification": "на первый взгляд, с виду"
                            },
                            {
                                "target_lang_word": "с виду",
                                "target_lang_sense_clarification": "по наружности"
                            },
                            {
                                "target_lang_word": "казалось бы",
                                "target_lang_sense_clarification": "создает впечатление, которое может быть обманчивым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                    "sense_definition": "In a way that is easy to see or understand; clearly or obviously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The error was so <w>apparently</w> wrong that even a child could see it.",
                            "target_lang_translations": {
                                "ru": "Ошибка была настолько <w>очевидно</w> нелепой, что даже ребенок мог ее заметить."
                            }
                        },
                        {
                            "text": "He showed his anger so <w>apparently</w> that everyone in the room felt uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он проявлял свой гнев так <w>явно</w>, что всем в комнате стало не по себе."
                            }
                        }
                    ],
                    "synonyms": [
                        "obviously",
                        "plainly",
                        "clearly",
                        "manifestly",
                        "visibly"
                    ],
                    "common_phrases": [
                        "so apparently"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense of 'clearly' is less common in modern usage than 'seemingly'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, что это легко увидеть или понять; ясно или явно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явно",
                                "target_lang_sense_clarification": "совершенно заметно для всех"
                            },
                            {
                                "target_lang_word": "очевидно",
                                "target_lang_sense_clarification": "ясно и бесспорно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}