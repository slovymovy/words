                "senses": [
                    {
                        "sense_id": "4f40ad1c-123a-3413-9d54-9507f563c154",
                        "entry_id": "36a5eb69-1538-3ca6-91a1-f3292bd2e492",
                        "glosses": [
                            "Reise, die dazu dient, eine Fremdsprache während des Aufenthaltes zu erlernen oder zu verbessern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "befd0d89-e8b1-4879-a354-4676391cc1bf",
                                "sense_id": "4f40ad1c-123a-3413-9d54-9507f563c154",
                                "text": "Auf einer Sprachreise lernte sie ihren Mann kennen."
                            },
                            {
                                "example_id": "3d15310a-8a9e-467a-80d5-cfb8146c7db3",
                                "sense_id": "4f40ad1c-123a-3413-9d54-9507f563c154",
                                "text": "„Dafür haben sie immer ja gesagt, wenn ich einen Sport lernen wollte, eine Sprachreise plante oder sonst welche Projekte vorhatte.“"
                            },
                            {
                                "example_id": "b17881d5-b5aa-4d35-b3e2-fbd630cd25c4",
                                "sense_id": "4f40ad1c-123a-3413-9d54-9507f563c154",
                                "text": "„Wem vor purem Vokabelpauken graut, für den sind Sprachreisen eine gute Möglichkeit, sein Englisch - oder Französisch - aufzupolieren und dabei auch noch Spaß zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
