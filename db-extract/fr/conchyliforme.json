                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef93ef5-3a2c-487f-bb32-8c90b3905a5d",
                                "sense_id": "122a0fb4-c47b-3ab2-a055-90934d94686d",
                                "text": "Partie postérieure du corps pourvue d’un écusson large, embrassant, recouvrant les branchies, et contenant un corps conchyliforme."
                            },
                            {
                                "example_id": "2c6cd4c1-1081-4eac-b0b1-366eb204e52a",
                                "sense_id": "122a0fb4-c47b-3ab2-a055-90934d94686d",
                                "text": "Sur la face, le col, le tronc, on les membres, on trouve un ou deux, ou plusieurs foyers rupioïdes, isolés ou cohérents ayant, au centre, une croûte conchyliforme de couleur généralement brune, noirâtre, un bord élevé qui l’embrasse, et qui est serti par un anneau rouge."
                            }
                        ]
                    }
