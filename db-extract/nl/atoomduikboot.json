                            {
                                "example_id": "94268b85-6b09-40c2-8b4d-7b76bb0dddba",
                                "sense_id": "b2b01c6d-6209-3086-bb7b-a6424a8f80eb",
                                "text": "Enkele Noorse vissers wilden heilbot vangen, maar tot hun verbazing vonden ze iets heel anders in hun netten: een Amerikaanse atoomduikboot met kruisraketten. Totale vangst: 200 kilo heilbot en 7800 ton onderzeeër. De Amerikaanse marine bevestigt het incident."
                            },
                            {
                                "example_id": "6116de32-0d36-4c63-9b32-fab84f91b2fe",
                                "sense_id": "b2b01c6d-6209-3086-bb7b-a6424a8f80eb",
                                "text": "Vier Russische oorlogsschepen, waaronder een atoomduikboot, zijn op weg naar Havana voor een tussenstop. Volgens Cuba betekent het bezoek zeker geen bedreiging voor de regio."
                            }
                        ]
