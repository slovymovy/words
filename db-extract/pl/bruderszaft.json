                "senses": [
                    {
                        "sense_id": "31b64eff-8311-379d-b014-ba1254342bfb",
                        "entry_id": "5c6b4944-6851-3a27-9020-ddb0727893e9",
                        "glosses": [
                            "Ritual, bei dem man mit einer Person Alkohol trinkt und sich danach duzt; Brüderschaft, Bruderschaft, Duzfreundschaft"
                        ],
                        "tags": [
                            "Ethnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e24a8c7b-7318-4fd1-9e79-3b5d86984364",
                                "sense_id": "31b64eff-8311-379d-b014-ba1254342bfb",
                                "text": "Zaproponowała mi bruderszaft.",
                                "translation": "Sie hat mir die Brüderschaft angeboten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcaddddf-e8e1-48dc-9736-2b5868df766b",
                        "source_entry_id": "5c6b4944-6851-3a27-9020-ddb0727893e9",
                        "source_sense_id": "31b64eff-8311-379d-b014-ba1254342bfb",
                        "source_sense_description": "Ritual, bei dem man mit einer Person Alkohol trinkt und sich danach duzt",
                        "target_lang_word": "Brüderschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brüderschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9374bc8c-3d5b-328f-a4c5-4cd8df7f69e8",
                                        "entry_id": "a894ef13-75f8-35ed-9c4c-ff13c0f6e5c0",
                                        "glosses": [
                                            "Blutsverwandtschaft mehrerer Familien derselben Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcdf02e1-464b-3a40-b6c7-6e397ef39768",
                                        "entry_id": "a894ef13-75f8-35ed-9c4c-ff13c0f6e5c0",
                                        "glosses": [
                                            "religiöse Körperschaft von Geistlichen und Laien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4869a3fa-028f-435a-b8ed-6e953e7e84d5",
                                                "sense_id": "dcdf02e1-464b-3a40-b6c7-6e397ef39768",
                                                "text": "Schnell fanden sich viele Bürger, die in der neuen Pfarre eine Bruderschaft gründen wollten."
                                            },
                                            {
                                                "example_id": "db8df115-c197-43cd-a6e7-d3b78e6041ad",
                                                "sense_id": "dcdf02e1-464b-3a40-b6c7-6e397ef39768",
                                                "text": "„Erwachsen aus einer Bruderschaft zur Krankenpflege, die sich im Heiligen Land am Ende des Dritten Kreuzzugs zusammengefunden hatte, war er nach dem Vorbild der Templer und Johanniter in den Stand eines Ritterordens erhoben worden und hatte sich rasch in Europa ausgebreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7073f563-774d-3ecf-893e-45b8ebb3287d",
                                        "entry_id": "a894ef13-75f8-35ed-9c4c-ff13c0f6e5c0",
                                        "glosses": [
                                            "gewerkschaftliche Körperschaft von Gildenbrüdern oder Gewerkschaftsbrüdern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf308da-0643-45e6-93f7-208cd4a08470",
                                                "sense_id": "7073f563-774d-3ecf-893e-45b8ebb3287d",
                                                "text": "„Die in Wien seit dem 13. Jahrhundert nachweisbaren Bruderschaften waren Vereine mit Rechtspersönlichkeit, eigenem Vermögen (genannt Zeche, danach im weiteren Sinn Zeche = Bruderschaft) und periodisch gewählten Organen.“"
                                            },
                                            {
                                                "example_id": "ebfb4ef6-95fa-4334-ad5a-3c141aae4bed",
                                                "sense_id": "7073f563-774d-3ecf-893e-45b8ebb3287d",
                                                "text": "„Es waren absolut harmlose Leute, die hier aus und ein gingen und deren Spleen einzig und allein der war, daß sie sich nicht KLub oder Verein, sondern Loge oder Bruderschaft nannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3628290f-8578-4454-a39e-5671389d2184",
                        "source_entry_id": "5c6b4944-6851-3a27-9020-ddb0727893e9",
