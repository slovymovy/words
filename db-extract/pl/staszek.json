                        "examples": [
                            {
                                "example_id": "d26b8bb3-0ee0-452a-93ec-dddaf64d9b58",
                                "sense_id": "bdd13a1a-84e1-35db-85bf-24030cffdf60",
                                "text": "Staszek wypił cały wyciąg z owoców, z którego babcia chciała zrobić kompot."
                            },
                            {
                                "example_id": "64848e3d-0839-4db0-877c-507acd3dff56",
                                "sense_id": "bdd13a1a-84e1-35db-85bf-24030cffdf60",
                                "text": "Wciąż pieprzysz, jak o nas się troszczysz, a jak dotąd gówno zrobiłeś i jeszcze masz krew na rękach. Gdyby nie ty, Renia by żyła, i Staszek może też"
                            }
                        ],
