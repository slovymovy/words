                                        "examples": [
                                            {
                                                "example_id": "52ddba71-d20e-4f8d-ad62-8e9abc4dc1b8",
                                                "sense_id": "8bf5321a-bb7c-3d5b-8c39-90ba3016e83a",
                                                "text": "Мария… Миранда… Мирэй… ― ей достаточно было быть собой, чтобы быть ― всеми .."
                                            },
                                            {
                                                "example_id": "768c567a-bf48-4117-b239-92d373e4eb1b",
                                                "sense_id": "8bf5321a-bb7c-3d5b-8c39-90ba3016e83a",
                                                "text": "В ролях: Николь Кидман, Джулианн Мур, Мерил Стрип, Миранда Ричардсон, Эд Харрис, Джон Си Рейли, Стивен Диллейн и другие."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Миранда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45a23729-7b02-3a93-b105-f42c6fe7a18e",
                                        "entry_id": "6598d79c-5477-3ae7-8c0c-bef3f2bebb9f",
                                        "glosses": [
                                            "фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed21754-1da1-4f8b-8a3f-556217b1ced6",
                                                "sense_id": "45a23729-7b02-3a93-b105-f42c6fe7a18e",
                                                "text": "В 1601 году были в Москве нунции Климента VIII, Франциск Коста и Дидак Миранда .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Миранда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dd36ceef-a37d-342c-8633-f41df63c6d50",
