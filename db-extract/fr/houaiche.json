                        "form": "houache"
                    },
                    {
                        "form_id": "119deaf3-6cbe-4678-997f-84cc8135e52c",
                        "entry_id": "046d8cd6-2c6f-38c8-9128-0761cdb5183e",
                        "tags": [],
                        "form": "ouage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c05b5c11-0c3c-3dee-bfb2-286eb0fdc4d7",
                        "entry_id": "046d8cd6-2c6f-38c8-9128-0761cdb5183e",
                        "glosses": [
                            "Trace ou sillage laissé par un navire pendant sa marche, et qui en indique la vraie direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83006d1d-f419-4f59-84af-5c0e8fda39d9",
                                "sense_id": "c05b5c11-0c3c-3dee-bfb2-286eb0fdc4d7",
                                "text": "Après avoir un peu admiré la houaiche, il approcha un matelot qui vérifiait consciencieusement le bon entretien des canots de sauvetage et les regardait avec tendresse."
                            },
                            {
                                "example_id": "847e9a0a-12d9-4d52-a31e-f9a3f3002ad5",
                                "sense_id": "c05b5c11-0c3c-3dee-bfb2-286eb0fdc4d7",
                                "text": "Dans le vocabulaire de la marine à voiles, on désignait ainsi la vitesse d'un navire, liée à l'aspect des remous de son sillage, nommé à l'époque houache ou houaiche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dfe5eaf-9c35-4e84-ba7b-dcb91b76d430",
                        "source_entry_id": "046d8cd6-2c6f-38c8-9128-0761cdb5183e",
                        "source_sense_id": "c05b5c11-0c3c-3dee-bfb2-286eb0fdc4d7",
                        "target_lang_word": "wake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eab099cc-288d-3429-ac2a-e38044f9a039",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "(often followed by up) To stop sleeping."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86fff9ce-a527-481b-823d-5f9ef744ea53",
                                                "sense_id": "eab099cc-288d-3429-ac2a-e38044f9a039",
                                                "text": "I woke up at four o'clock this morning."
                                            },
                                            {
                                                "example_id": "657fae5f-a1c3-4d05-bcf9-f0cf194b6a3a",
                                                "sense_id": "eab099cc-288d-3429-ac2a-e38044f9a039",
                                                "text": "How long I slept I cannot tell, for I had nothing to guide me to the time, but woke at length, and found myself still in darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f28378-4d60-3826-9af6-444c0c29d3c0",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "(often followed by up) To make somebody stop sleeping; to rouse from sleep."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a8101f-93d0-46fc-a8ee-a1283f964005",
                                                "sense_id": "75f28378-4d60-3826-9af6-444c0c29d3c0",
                                                "text": "The neighbour's car alarm woke me from a strange dream."
                                            },
                                            {
                                                "example_id": "5e64994b-c462-45a5-b927-ec06b37dd588",
                                                "sense_id": "75f28378-4d60-3826-9af6-444c0c29d3c0",
                                                "text": "And the Angell that talked with me, came againe and waked me, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee42ba84-a028-36d3-8be3-df0e88cb7812",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "To put in motion or action; to arouse; to excite."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0826f1d-c97f-493b-9611-ab9a5c636ba3",
                                                "sense_id": "ee42ba84-a028-36d3-8be3-df0e88cb7812",
                                                "text": "Not for my life, leſt fierce remembrance wake\n My ſudden rage to tear thee joint by joint."
                                            },
                                            {
                                                "example_id": "23597981-9d22-45a5-8666-fc596b9dc7e3",
                                                "sense_id": "ee42ba84-a028-36d3-8be3-df0e88cb7812",
                                                "text": "Even Richard's crusade woke little interest in his island realm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4516ecda-c081-34c2-837c-a9318f876222",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "To be excited or roused up; to be stirred up from a dormant, torpid, or inactive state; to be active."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6224d5fb-940d-48f0-92c9-213402313a3a",
                                                "sense_id": "4516ecda-c081-34c2-837c-a9318f876222",
                                                "text": "and gentle Aires due at thir hour\n To fan the Earth now wak'd,"
                                            },
                                            {
                                                "example_id": "5e23a369-7c87-4060-aae2-0568b791a01b",
                                                "sense_id": "4516ecda-c081-34c2-837c-a9318f876222",
                                                "text": "Then wake, my soul, to high desires,\n And earlier light thine altar fires: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db43cae-844a-32ce-bbea-ffe4390fefa2",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "To watch, or sit up with, at night, as a dead body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3833b2-dd4c-4ff9-955f-1ca438136cd9",
                                                "sense_id": "1db43cae-844a-32ce-bbea-ffe4390fefa2",
                                                "text": "Dougal said that being alone with the dead on that floor of the tower (for naebody cared to wake Sir Robert Redgauntlet like another corpse) he had never daured^([sic]) to answer the call, but that now his conscience checked him for neglecting his duty; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976230c3-8ea5-3345-a8f0-34f7d92e1c09",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "To be or remain awake; not to sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8431cc76-4532-49e8-920b-21df1f97c0b5",
                                                "sense_id": "976230c3-8ea5-3345-a8f0-34f7d92e1c09",
                                                "text": "The father waketh for the daughter when no man knoweth, and the care for her taketh away sleepe;"
                                            },
                                            {
                                                "example_id": "1b4ddc33-5d1b-4ec2-8280-02793e4e1ac7",
                                                "sense_id": "976230c3-8ea5-3345-a8f0-34f7d92e1c09",
                                                "text": "And oft though wiſdom wake, ſuspicion ſleeps\n At wiſdoms Gate,"
                                            },
                                            {
                                                "example_id": "7e4d9843-74b7-490c-87df-6852f656be9d",
                                                "sense_id": "976230c3-8ea5-3345-a8f0-34f7d92e1c09",
                                                "text": ", Book II, Chapter I\nI cannot think any time, waking or sleeping, without being sensible of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66d507e-efdb-36fb-909e-fef0b5a49ea6",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "To be alert; to keep watch"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955def10-7483-43d7-9d55-bc0e3590f171",
                                                "sense_id": "b66d507e-efdb-36fb-909e-fef0b5a49ea6",
                                                "text": "Command unto the guards that they diligently wake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56410af4-9c5d-3a88-abe6-299915910943",
                                        "entry_id": "2574aff7-f0d6-3166-adef-e76f6a0faafe",
                                        "glosses": [
                                            "To sit up late for festive purposes; to hold a night revel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3e65b24-5efd-45a9-b970-46679f154b80",
                                                "sense_id": "56410af4-9c5d-3a88-abe6-299915910943",
                                                "text": "The king doth wake to-night, and takes his rouse,\n Keeps wassail, and the swaggering upspring reels."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "154ddf88-df67-32cf-b0c0-303514275b12",
                                        "entry_id": "ffbd90ed-0a64-396e-8214-e8d853c83757",
                                        "glosses": [
                                            "The act of waking, or state of being awake."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "often",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93cdade1-7d9f-4960-80b3-f2ecaacf3493",
                                                "sense_id": "154ddf88-df67-32cf-b0c0-303514275b12",
                                                "text": "Making such difference 'twixt wake and sleep."
                                            },
                                            {
                                                "example_id": "6e3aa862-5f07-43af-9418-232b957636eb",
                                                "sense_id": "154ddf88-df67-32cf-b0c0-303514275b12",
                                                "text": "Singing her flatteries to my morning wake."
                                            },
                                            {
                                                "example_id": "853e2228-3260-41b2-8339-1b17e4a2ed4b",
                                                "sense_id": "154ddf88-df67-32cf-b0c0-303514275b12",
                                                "text": "After a few weeks of age, longer periods of sleep and wake are seen […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0316f48c-016b-391a-863f-f2c64bd325c3",
                                        "entry_id": "ffbd90ed-0a64-396e-8214-e8d853c83757",
                                        "glosses": [
                                            "The state of forbearing sleep, especially for solemn or festive purposes; a vigil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cf90d20-0806-4bc0-9d2f-61aea80d066c",
                                                "sense_id": "0316f48c-016b-391a-863f-f2c64bd325c3",
                                                "text": "The warlike wakes continued all the night,\n And funeral games played at new returning light."
                                            },
                                            {
                                                "example_id": "04a57d9b-4cf3-40a6-9124-fdc4e12fab9d",
                                                "sense_id": "0316f48c-016b-391a-863f-f2c64bd325c3",
                                                "text": "The wood nymphs, deckt with daises trim,\n Their merry wakes and pastimes keep.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea77347-fae8-3dca-8ac4-9aded2cd1f08",
                                        "entry_id": "ffbd90ed-0a64-396e-8214-e8d853c83757",
                                        "glosses": [
                                            "A period after a person's death before or after the body is buried, cremated, etc.; in some cultures accompanied by a party or collectively sorting through the deceased's personal effects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc59f745-09b8-4139-a044-04994840eff1",
                                                "sense_id": "1ea77347-fae8-3dca-8ac4-9aded2cd1f08",
                                                "text": "Where any person has died whilst being, or suspected of being, a case or carrier or contact of an infectious disease, the Director may by order prohibit the conduct of a wake over the body of that person or impose such conditions as he thinks fit on the conduct of such wake […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e01ce2e-9b9b-3f98-8725-8a2f7d624419",
                                        "entry_id": "ffbd90ed-0a64-396e-8214-e8d853c83757",
                                        "glosses": [
                                            "A yearly parish festival formerly held in commemoration of the dedication of a church. Originally, prayers were said on the evening preceding, and hymns were sung during the night, in the church; subsequently, these vigils were discontinued, and the day itself, often with succeeding days, was occupied in rural pastimes and exercises, attended by eating and drinking."
                                        ],
                                        "tags": [
                                            "Church-of-England",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe5af9e9-5b2b-445a-9d1c-b824d463cdb5",
                                                "sense_id": "1e01ce2e-9b9b-3f98-8725-8a2f7d624419",
                                                "text": "1523–1525, Jean Froissart, John Bourchier, 2nd Baron Berners (translator), Froissart's Chronicles\nGreat solemnities were made in all churches, and great fairs and wakes throughout all England."
                                            },
                                            {
                                                "example_id": "05295ef7-eb9d-4ddb-a5f0-8bd716cc1abd",
                                                "sense_id": "1e01ce2e-9b9b-3f98-8725-8a2f7d624419",
                                                "text": "And every village smokes at wakes with lusty cheer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a7d9351-75e1-3dcc-837a-0d891009ee6c",
                                        "entry_id": "ffbd90ed-0a64-396e-8214-e8d853c83757",
                                        "glosses": [
                                            "A number of vultures assembled together."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "299716fc-4ef8-3158-b8cf-ea945c40bf4b",
                                        "entry_id": "8c98bb25-4268-3998-bc67-164da1f5b858",
                                        "glosses": [
                                            "The path left behind a ship on the surface of the water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "697e1ec6-8c77-35ed-9d5b-461f91b9ac42",
                                        "entry_id": "8c98bb25-4268-3998-bc67-164da1f5b858",
                                        "glosses": [
                                            "The movement of water created when an animal or a person moves through water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65984532-4c07-33e7-a580-64e3b53b5df7",
                                        "entry_id": "8c98bb25-4268-3998-bc67-164da1f5b858",
                                        "glosses": [
                                            "The turbulent air left behind a flying aircraft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                                        "entry_id": "8c98bb25-4268-3998-bc67-164da1f5b858",
                                        "glosses": [
                                            "The area behind something or somebody rapidly-moving"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e763f635-e1d6-4d92-966e-3aab18d633f8",
                                                "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                                                "text": "The player left the rest of the field trailing in her wake."
                                            },
                                            {
                                                "example_id": "df37b9d4-a98f-4863-a8d0-6c05e18ba163",
                                                "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                                                "text": "This effect followed immediately in the wake of his earliest exertions."
                                            },
                                            {
                                                "example_id": "d2a6f9b6-8a1b-4fec-b141-3bb53bab735f",
                                                "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                                                "text": "Several humbler persons […] formed quite a procession in the dusty wake of his chariot wheels."
                                            },
                                            {
                                                "example_id": "0ff9afa6-98d9-4040-b66f-1848074fe19b",
                                                "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                                                "text": "It was all of a piece. If you believed in capitalism, you had to attack science, because science had revealed the hazards that capitalism had brought in its wake."
                                            },
                                            {
                                                "example_id": "ea4f01a6-f3a0-4d12-ac8b-d444d6526753",
                                                "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                                                "text": "Alex Song launched a long ball forward from the back and the winger took it down nicely on his chest. He cut across the penalty area from the right and after one of the three defenders in his wake failed to make a meaningful clearance, the Oxlade-Chamberlain was able to dispatch a low left-footed finish into the far corner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
