                "senses": [
                    {
                        "sense_id": "28c0b147-d641-311f-baf5-3df88713676a",
                        "entry_id": "a1edf3ca-6e02-36e8-b8e4-9ec4c27d5aab",
                        "glosses": [
                            "Qui se moque ; qui raille ; qui a l’habitude de se moquer ou de railler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3afbaa4-db8c-43f7-83b4-d80793e5c323",
                                "sense_id": "28c0b147-d641-311f-baf5-3df88713676a",
                                "text": "Le vieillard épiait d'un œil plus curieux que moqueur les signes d'impatience et de crainte qui se jouaient sur le charmant visage de sa compagne, …."
                            },
                            {
                                "example_id": "d07b0c4a-aebf-4a97-9fe2-bc57ced9a743",
                                "sense_id": "28c0b147-d641-311f-baf5-3df88713676a",
                                "text": "Il faut croire que le Père de Ragon était peu soucieux de livrer aux moqueuses oreilles de Chiffon les confidences de celles qu'elle appelait si irrévérencieusement « les grenouilles de bénitier », car subitement il se ravisa, disant, comme s'il n'avait rien entendu : […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f9eca8c-fbf0-4230-8e7a-948ddd021e14",
                        "source_entry_id": "a1edf3ca-6e02-36e8-b8e4-9ec4c27d5aab",
                        "source_sense_id": "28c0b147-d641-311f-baf5-3df88713676a",
                        "target_lang_word": "spöttisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spöttisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                        "entry_id": "f66e1e07-c40e-3e5f-9a8d-d3392dd94616",
                                        "glosses": [
                                            "Spott in Sprache, Gestik und Mimik treibend"
                                        ],
                                        "tags": [
                                            "als Adjektiv gebraucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731a9189-27c7-43b7-ad60-38c2a8cef5ae",
                                                "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                                "text": "Das ungewöhnliche, scharfe, spöttische Wort bringt seine Wirkung hervor."
                                            },
                                            {
                                                "example_id": "5719be73-59ac-45ee-8d82-f2ff1b2df751",
                                                "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                                "text": "Ein bitter spöttischer Zug glitt um Judikas schön geschweifte, rote Lippen, als der Mann da vor ihr von einem Gewissen sprach."
                                            },
                                            {
                                                "example_id": "fe6a1eac-378e-41fd-b20d-b839b5a794e1",
                                                "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                                "text": "Sie aber legte ihm, ohne zu wissen, was sie tat, beide Hände auf die Schultern und sah eine Minute lang entzückt, wie berauscht auf sein kluges, spöttisches Gesicht, auf seine Augen und auf seinen schönen Bart …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                        "entry_id": "f66e1e07-c40e-3e5f-9a8d-d3392dd94616",
                                        "glosses": [
                                            "Spott in Sprache, Gestik und Mimik treibend"
                                        ],
                                        "tags": [
                                            "adverbiell gebraucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cf6295-9365-40ea-9d6e-401e530c4d5b",
                                                "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                                "text": "Die Republikaner machen sich über den Personenkult lustig, bezeichnen Obama spöttisch als „The One“ und meinen, er sei nicht viel besser als Paris Hilton, keinesfalls sei er ein seriöser Politiker."
                                            },
                                            {
                                                "example_id": "a99ce58e-dac9-4bfc-9258-beae1ea2b907",
                                                "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                                "text": "Weniger destruktiv, aber zutiefst spöttisch gegenüber bürgerlichen Interieurs geht es auch in der restlichen Schau weiter."
                                            },
                                            {
                                                "example_id": "3e8d51d3-7ab9-4a3a-a417-6e6dd05542f4",
                                                "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                                "text": "„Mutrobarock“ nennen die Bulgaren spöttisch die gestalterisch lauten Wohntempel des raschen Aufstiegs und neuen Wohlstandes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
