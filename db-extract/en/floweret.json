                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6fbfc35-dc4e-424f-9ed7-02260b6d966f",
                                "sense_id": "7cf70984-f7a2-38b6-a0c7-ff0deb3db94d",
                                "text": "No more ſhall trenching Warre channell her fields, / Nor bruiſe her Flowrets with the Armed hoofes / Of hoſtile paces."
                            },
                            {
                                "example_id": "91f20330-368e-4a20-a51c-f39c790dbff1",
                                "sense_id": "7cf70984-f7a2-38b6-a0c7-ff0deb3db94d",
                                "text": "And, hark! she whispers in the zephyr's voice, Lift up thy head, fair floweret, and rejoice!"
                            },
                            {
                                "example_id": "405804c9-3cca-4da0-b04d-0d8cdab43f30",
                                "sense_id": "7cf70984-f7a2-38b6-a0c7-ff0deb3db94d",
                                "text": "Handsome piece, with floweret at the apex, scrolls on the side, and a scalloped band around the middle."
                            },
                            {
                                "example_id": "92a38988-5017-44f7-855b-e11de281131a",
                                "sense_id": "7cf70984-f7a2-38b6-a0c7-ff0deb3db94d",
                                "text": "The domestic sheep, on the contrary, is only a fraction of an animal, a whole flock being required to form an individual, just as numerous flowerets are required to make one complete sunflower."
                            }
                        ]
                    }
