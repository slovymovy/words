                "senses": [
                    {
                        "sense_id": "68a17579-cd9f-3836-8bc5-9bcbce9bc778",
                        "entry_id": "7adc4ffb-b8ed-3610-8844-d9148c75c3e4",
                        "glosses": [
                            "Asparagus officinalis subsp. officinalis een plant die in het wild vooral voorkomt in kuststreken en langs rivieren. De plant wordt vanwege de jonge scheuten geteeld als groente. Er zijn witte, groene en paarse asperges op de markt. De witte zijn onder de grond gegroeid en uit het licht gehouden, de groene en paarse asperges hebben wel zon gezien. In Noordwest-Europa zijn witte het meest gebruikelijk, in landen als Italië groene"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c436ea34-7f1c-3e77-88c0-7c8a10f69b15",
                        "entry_id": "7adc4ffb-b8ed-3610-8844-d9148c75c3e4",
                        "glosses": [
                            "de jonge scheuten van deze plant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2939d225-4955-404a-9022-69fc00e8570b",
                                "sense_id": "c436ea34-7f1c-3e77-88c0-7c8a10f69b15",
                                "text": "Asperges zijn een dure groente en wordt dan ook wel het witte goud genoemd."
                            },
                            {
                                "example_id": "a86b3919-81e8-4da5-b91f-6176c8d19a19",
                                "sense_id": "c436ea34-7f1c-3e77-88c0-7c8a10f69b15",
                                "text": "Met getuite lippen zoog ze aan een groene asperge; het geval verdween volledig in haar keel en verlustigd keek ze omhoog richting Badmuts, die blozend redderde met glazen en servet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6c7e1ff-2e01-40c5-b08d-4847e8d9aabd",
                        "source_entry_id": "7adc4ffb-b8ed-3610-8844-d9148c75c3e4",
                        "source_sense_id": "68a17579-cd9f-3836-8bc5-9bcbce9bc778",
                        "source_sense_description": "Asperagas officinalis, een plant waarvan de jonge scheuten geteeld worden als groente",
                        "target_lang_word": "Spargel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spargel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                        "entry_id": "a15e7433-f29e-3be9-ac98-db39bf158dcc",
                                        "glosses": [
                                            "staudenartiges Liliengewächs mit dünnen, grünen, bäumchenartig verzweigten Trieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa88639e-e6e7-4d3b-863e-180b933ba7cc",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "Der Spargel ist eine mehrjährige, krautige Pflanze."
                                            },
                                            {
                                                "example_id": "6639bdaa-454a-44f5-94be-f38a7738bb05",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "«Auch brauchen die Spargeln genügend Wasser, denn Wärme und Wasser bewirken ein schnelleres Wachstum, und je schneller der Spargel wächst, desto zarter wird er.»"
                                            },
                                            {
                                                "example_id": "7913ed47-a707-4663-b57d-6b1993001515",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "„Spargel ist ebenfalls ein Liliengewächs; seine Blätter sind zu winzigen Schuppen zurückgebildet.“"
                                            },
                                            {
                                                "example_id": "2fd73f29-ec5b-4a66-9987-4c83ae6a6407",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "«Während die weisse Spargel unterirdisch wächst und gestochen wird, gedeiht die Grünspargel oberirdisch.»"
                                            },
                                            {
                                                "example_id": "fa50c26b-ba32-446e-a9c7-5dabcf1ddff9",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "„Schon vor über 3.000 Jahren waren Geschmack und Heilkraft des Spargels geschätzt. Man nimmt an, dass die Ägypter den Wildspargel auf ihrem Speisezettel kannten. Sicher ist jedenfalls, dass den Griechen die Heilkraft dieser schmackhaften Pflanze bekannt war. Und wie könnte es anders sein, die ‚verfressenen‘ Römer wussten genau, wie man Spargeln anbaut.“"
                                            },
                                            {
                                                "example_id": "31bb49b4-2eb1-46ba-9e87-406acab956c5",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "„Schon Hippokrates erwähnte den Spargel als Heilpflanze – das war etwa 450 vor Christus.“"
                                            },
                                            {
                                                "example_id": "635bd859-9c4c-4d58-a14c-c422747aa7d2",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "„Ganze Regionen sind inzwischen mit den Folien und Planen überzogen, unter denen der Spargel heranwächst, Felder aus Plastik.“"
                                            },
                                            {
                                                "example_id": "abbbb0c1-3314-4f92-b784-a3fa028f1001",
                                                "sense_id": "24b633e0-67db-35c3-ac16-98a225c5eb38",
                                                "text": "„In der Landwirtschaft fehlten saisonale Feldarbeiter, Kartoffeln wurden nicht gesetzt, der Spargel schoss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                        "entry_id": "a15e7433-f29e-3be9-ac98-db39bf158dcc",
                                        "glosses": [
                                            "als Gemüse verwendeter stangenförmiger, fleischiger Spross beziehungsweise Sprosse des Wurzelstocks des unter [1] beschriebenen Gewächses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cec05651-0072-47f8-a7b7-67ad91b4853f",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "Der Spargel war heute ausgezeichnet."
                                            },
                                            {
                                                "example_id": "3721a286-dbb7-4e1a-b519-1ec8ff9b27b2",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Artischocken, Bündel von grünen Spargeln, Häufchen von Trüffeln, kostbare kleine Leberwürste in Stanniol waren wie in prahlerischem Überfluß dazwischen verteilt, und auf Nebentischen standen offene Blechbüchsen voll feiner Biskuits.“"
                                            },
                                            {
                                                "example_id": "9c5c28ad-37af-411f-bd5d-c1cbb28e34ae",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Malina verspricht mir Spargel mit Sauce Hollandaise und auch Schneeballen mit Schokolade. […] Ich will aber Spargel mit Sauce Mousseline und eine Crème Caramel.“"
                                            },
                                            {
                                                "example_id": "f141ce03-f207-45d6-b2c8-8b0ff0b81332",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Die Spargeln, die er bislang stechen konnte, brachten im Anteil weniger große Ware, dafür aber geschmacklich hochwertigen Spargel.“"
                                            },
                                            {
                                                "example_id": "61b8e8a7-20c4-4129-a1fe-e5fb28649239",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Die Nordseescholle ist fangfrisch, die Estragonsoße fließt gelb und würzig über den Fisch und die grünen Spargel.“"
                                            },
                                            {
                                                "example_id": "3189f6cb-ad37-4495-93b4-2f375576c4ad",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Serviert wird Lamm mit Spargel und als vegetarische Alternative ein Kartoffelgericht mit Spargeln und Pilzen.“"
                                            },
                                            {
                                                "example_id": "ea630ecc-edb1-4bce-8e7e-228570c3ce7a",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Im Freien wird gespeist, die Spargel schmecken gar köstlich, und süße Walzermelodien wetteifern mit Kuckuck und Specht.“"
                                            },
                                            {
                                                "example_id": "1022bfb6-1c45-4ef5-823c-9853520a51f1",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "„Die einen schwören auf zerlassene Butter zum Spargel, die anderen halten Sauce Hollandaise für das einzig Wahre.“"
                                            },
                                            {
                                                "example_id": "796044fb-8d01-4bbc-8b36-ca4893da183b",
                                                "sense_id": "8cbb799f-50ef-30c7-aad1-5f1dd343ece9",
                                                "text": "«Spargeln sind ein vergängliches Vergnügen. Im Kühlschrank können Sie die Spargeln ein bis zwei Tage aufbewahren, indem Sie die Spargeln in ein feuchtes Tuch einwickeln oder indem Sie den Spargelbund aufrecht in eine Schale mit Wasser (2–3 cm) stellen.»"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
