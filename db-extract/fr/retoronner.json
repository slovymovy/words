                "senses": [
                    {
                        "sense_id": "9d6ed21c-bc13-33db-a80d-ba318403acb4",
                        "entry_id": "caf64025-b12f-3056-a309-c9f2be74c179",
                        "glosses": [
                            "Toronner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938f2b5e-c7f0-4be4-862b-f421ea866087",
                                "sense_id": "9d6ed21c-bc13-33db-a80d-ba318403acb4",
                                "text": "En fait c'est le contraire, plus tu es léger, 20gr, plus tu peux attaquer dans le fin, et plus tu es lourd, plus tu peux retoronner des fils ensemble: (...)"
                            },
                            {
                                "example_id": "b00023b2-32a3-4e32-a065-e7cb4032d2a3",
                                "sense_id": "9d6ed21c-bc13-33db-a80d-ba318403acb4",
                                "text": "Et retoronner sans passer dans cette boucle."
                            },
                            {
                                "example_id": "803a0e29-d8ee-4cb0-8d05-d30d71b5a4a2",
                                "sense_id": "9d6ed21c-bc13-33db-a80d-ba318403acb4",
                                "text": "Enfin, après avoir bien tordu mes torons individuellement, je retoronne mes trois brins maintenant effilés."
                            }
                        ]
                    }
