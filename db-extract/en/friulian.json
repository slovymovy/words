                                    {
                                        "sense_id": "2f35657a-00ac-3a35-864e-f3e8056527bf",
                                        "entry_id": "173756a4-7f3c-3db2-85ba-a5179e4d0062",
                                        "glosses": [
                                            "rätoromanische Sprache, die in Friaul im Nordosten Italiens gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87114feb-6ea5-4b29-9e73-34296d62a3b5",
                                                "sense_id": "2f35657a-00ac-3a35-864e-f3e8056527bf",
                                                "text": "Friaulisch ist als Minderheitensprache in Italien offiziell anerkannt."
                                            },
                                            {
                                                "example_id": "95f2abe0-47c4-4f28-ba29-7c7bc0b91def",
                                                "sense_id": "2f35657a-00ac-3a35-864e-f3e8056527bf",
                                                "text": "„Die ersten Schriftzeugnisse des Friaulischen reichen bis in das 13. Jahrhundert zurück und sind meist wirtschaftlicher oder juristischer Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb6b7daf-af04-4e72-86c9-8f0fef178996",
