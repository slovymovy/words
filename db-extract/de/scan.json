                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "492c0bfe-d187-3657-ac44-a214342c2a03",
                                        "entry_id": "b49b3c84-714d-3014-b5d8-98194c688256",
                                        "glosses": [
                                            "An instance of scanning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37759e45-f9ba-48f2-8d4b-d58c0040a1a3",
                                                "sense_id": "492c0bfe-d187-3657-ac44-a214342c2a03",
                                                "text": "The operators vacated the room during the scan."
                                            },
                                            {
                                                "example_id": "8ead456a-c31b-4b4f-bdf3-562f0a2e64c9",
                                                "sense_id": "492c0bfe-d187-3657-ac44-a214342c2a03",
                                                "text": "In the dispute with the RMT about scanning tickets, Jackson said it was the right thing to do to pay conductors something to scan tickets. Northern pays two pence per scan, Jackson noted, adding that ticket scanning helps to cut fraud and increase staff visibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60ce75f-bf85-3a3f-8ecd-101d3c11e0a7",
                                        "entry_id": "b49b3c84-714d-3014-b5d8-98194c688256",
                                        "glosses": [
                                            "The result or output of a scanning process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd54804f-9357-4799-b954-13ee2cc50fc6",
                                                "sense_id": "a60ce75f-bf85-3a3f-8ecd-101d3c11e0a7",
                                                "text": "The doctors looked at the scans and made a diagnosis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40b33006-1df1-3f63-b776-a33375e8ea41",
                                        "entry_id": "b49b3c84-714d-3014-b5d8-98194c688256",
                                        "glosses": [
