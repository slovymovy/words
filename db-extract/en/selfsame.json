                                        "sense_id": "fc615a86-370f-347f-a7d4-1d6da00f9e9b",
                                        "entry_id": "d63c0e3e-20a4-36e3-af7d-2adfda107778",
                                        "glosses": [
                                            "de gelijke identiteit bezittend; meervoud of mannelijk en vrouwelijk enkelvoud, zowel zelfstandig als bijvoeglijk gebruikt (als 'het' het lidwoord zou zijn dan gebruiken we hetzelfde)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52997e87-baac-4afd-aa2b-227ee25a2c91",
                                                "sense_id": "fc615a86-370f-347f-a7d4-1d6da00f9e9b",
                                                "text": "Dit is dezelfde brief die ik gisteren zat te lezen."
                                            },
                                            {
                                                "example_id": "dbed09c7-aae0-4f91-99ca-772f99228e9c",
                                                "sense_id": "fc615a86-370f-347f-a7d4-1d6da00f9e9b",
                                                "text": "Dat zijn weer dezelfde als gisteren."
                                            },
                                            {
                                                "example_id": "2e1ef7fd-0fd8-4b12-9195-6733f9017471",
                                                "sense_id": "fc615a86-370f-347f-a7d4-1d6da00f9e9b",
                                                "text": "Zou zij dezelfde leegte voelen die ik nu ook voelde?"
                                            },
                                            {
                                                "example_id": "50eb7fe1-59b5-4d64-a8f1-f71ce30c8b6f",
                                                "sense_id": "fc615a86-370f-347f-a7d4-1d6da00f9e9b",
                                                "text": "\"De bagageafhandelingsbedrijven en de luchtvaartmaatschappijen die zorg dragen voor deze processen hebben net als wij bij de beveiliging te maken met personeelstekorten\", zegt een woordvoerder van Schiphol desgevraagd. Daardoor zijn passagiers en de koffers niet meer op hetzelfde moment op dezelfde plek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6dd9e9d-ce35-4d49-bfbd-fc19e079ed3a",
