                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c9c4df-e8e6-4ec4-b663-39a420400a48",
                                "sense_id": "c9928073-80f8-3adb-aa26-3f70e0587904",
                                "text": "Die tschechische Autobahnmaut soll schon im kommenden Jahr auf Autos über 3,5 Tonnen ausgeweitet werden.",
                                "translation": "Les péages autoroutiers tchèques s’appliqueront également aux véhicules de plus de 3,5 tonnes dès les années à venir."
                            },
                            {
                                "example_id": "be956039-f580-427a-a0fa-a153faf1d531",
                                "sense_id": "c9928073-80f8-3adb-aa26-3f70e0587904",
                                "text": "Schon jetzt, nachdem die Autobahnmaut eingeführt wurde merkt man spürbar die Zunahme des LKW-Vehkehrs auf der Bundesstrasse.",
                                "translation": "D’ores et déjà après l’instauration des péages autoroutiers, on remarque une augmentation sensible du traffic de poids lourds sur les routes nationales."
                            }
                        ]
                    }
