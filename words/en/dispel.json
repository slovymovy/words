{
    "word_family": [
        "dispeller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34ed9f94-627a-3568-a77b-90d64c8e0b2f",
                    "sense_definition": "To remove fears, doubts, or false beliefs by proving them to be wrong or unnecessary.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remove_mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager's speech helped to <w>dispel</w> any fears about potential job losses.",
                            "target_lang_translations": {
                                "ru": "Речь менеджера помогла <w>развеять</w> любые опасения по поводу возможных сокращений."
                            }
                        },
                        {
                            "text": "We need to <w>dispel</w> the myth that healthy food is always expensive.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>развенчать</w> миф о том, что здоровая еда — это всегда дорого."
                            }
                        }
                    ],
                    "synonyms": [
                        "disperse"
                    ],
                    "antonyms": [
                        "confirm",
                        "reinforce",
                        "encourage"
                    ],
                    "common_phrases": [
                        "dispel the myth",
                        "dispel any doubts",
                        "dispel the notion",
                        "dispel fears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устранять страхи, сомнения или ложные убеждения, доказывая их ошибочность или беспочвенность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развеивать",
                                "target_lang_sense_clarification": "устранять сомнения или страхи"
                            },
                            {
                                "target_lang_word": "рассеивать",
                                "target_lang_sense_clarification": "делать менее выраженным, уничтожать гнетущее чувство"
                            },
                            {
                                "target_lang_word": "развенчивать",
                                "target_lang_sense_clarification": "разоблачать мифы или ложные убеждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dbee63c-e9d2-3ce1-ad63-11b75743f4d1",
                    "sense_definition": "To drive away or cause something, such as mist or darkness, to vanish by scattering it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scatter_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning sun began to <w>dispel</w> the thick fog that covered the valley.",
                            "target_lang_translations": {
                                "ru": "Утреннее солнце начало <w>рассеивать</w> густой туман, окутавший долину."
                            }
                        },
                        {
                            "text": "A strong breeze helped <w>dispel</w> the smoke from the campfire.",
                            "target_lang_translations": {
                                "ru": "Сильный ветерок помог <w>развеять</w> дым от костра."
                            }
                        }
                    ],
                    "synonyms": [
                        "disperse"
                    ],
                    "antonyms": [
                        "gather",
                        "collect",
                        "accumulate"
                    ],
                    "common_phrases": [
                        "dispel the fog",
                        "dispel the darkness",
                        "dispel the mist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогонять или заставлять что-либо (например, туман или тьму) исчезнуть, рассеивая это."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развеивать",
                                "target_lang_sense_clarification": "прогонять туман или дым ветром"
                            },
                            {
                                "target_lang_word": "рассеивать",
                                "target_lang_sense_clarification": "заставлять исчезнуть, распределяя в пространстве"
                            },
                            {
                                "target_lang_word": "разгонять",
                                "target_lang_sense_clarification": "заставлять тучи или тьму разойтись"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43a799ad-be58-3837-988d-4205cf69ff79",
                    "sense_definition": "An act or instance of removing a magical effect or a mental state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard attempted a <w>dispel</w> to break the enchantment on the door.",
                            "target_lang_translations": {
                                "ru": "Волшебник попытался применить <w>рассеивание</w>, чтобы разрушить чары на двери."
                            }
                        },
                        {
                            "text": "Her quick <w>dispel</w> of the rumors saved the company's reputation.",
                            "target_lang_translations": {
                                "ru": "Ее быстрое <w>опровержение</w> слухов спасло репутацию компании."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in gaming or fantasy contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по снятию магического эффекта или устранению ментального состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассеивание",
                                "target_lang_sense_clarification": "процесс устранения чар или слухов"
                            },
                            {
                                "target_lang_word": "снятие",
                                "target_lang_sense_clarification": "прекращение действия заклинания"
                            },
                            {
                                "target_lang_word": "развеивание",
                                "target_lang_sense_clarification": "устранение сомнений или мифов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}