                                        "entry_id": "04f2203b-77a0-3b14-92fa-65e97bd126d3",
                                        "glosses": [
                                            "stuk grond waarop rijst geteeld wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca55b64-66e4-46fb-bcf4-ad971b525dfa",
                                                "sense_id": "82d78833-e8eb-3121-8493-b39c192889f4",
                                                "text": "In China en Indonesië zijn veel rijstvelden."
                                            }
