                                        "entry_id": "a4892f4f-0db2-3b71-8904-ee75c3295c57",
                                        "glosses": [
                                            "A participant in any of a group of sporting activities including track and field, road running, cross country running and racewalking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b3547f-de55-330a-b1ec-f1af666ee2a2",
                                        "entry_id": "a4892f4f-0db2-3b71-8904-ee75c3295c57",
                                        "glosses": [
                                            "A person who actively participates in physical sports, especially with great skill; a sportsperson."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "909b73a6-559d-4f34-98c3-bd0e18ec3027",
                                                "sense_id": "54b3547f-de55-330a-b1ec-f1af666ee2a2",
                                                "text": "She's the first athlete in her sport to obtain a corporate sponsor."
                                            },
                                            {
                                                "example_id": "4dec9a7c-a898-4d72-8dfa-2de1a28961d5",
                                                "sense_id": "54b3547f-de55-330a-b1ec-f1af666ee2a2",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades. At the top of the list of popular herbs are echinacea and ginseng, whereas garlic, St. John's wort, soybean, ephedra and others are also surging in popularity or have been historically prevalent."
                                            }
                                        ]
                                    },
