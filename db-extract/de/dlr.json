                        "examples": [
                            {
                                "example_id": "51bd6ce9-c76d-49bb-abff-d1647e405ec7",
                                "sense_id": "71b8c771-5aab-348a-80a8-f6614264ad69",
                                "text": "Das DLR hat 7.400 Mitarbeiterinnen und Mitarbeiter."
                            },
                            {
                                "example_id": "3c3143c0-137c-47ba-b2ea-41a03bd077ff",
                                "sense_id": "71b8c771-5aab-348a-80a8-f6614264ad69",
                                "text": "„Wissenschaftler der Bereiche Medizin, Aeroakustik, Flugmechanik, Flugführung, Lärmphysik, Atmosphärenphysik und Verkehrsforschung aus insgesamt acht Einrichtungen des DLR arbeiten in koordinierter Weise an den nachfolgend mit ihren Zielsetzungen skizzierten Hauptarbeitspaketen zusammen unter der Projektleitung von Dr. Ullrich Isermann vom DLR Institut für Strömungsmechanik.“"
                            }
                        ],
