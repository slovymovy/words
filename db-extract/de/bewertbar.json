                ],
                "senses": [
                    {
                        "sense_id": "d2ab6d73-f9bd-3c0b-aaca-57ee595fa18c",
                        "entry_id": "ce76106e-2dc9-34f6-88f1-3f490fe92e58",
                        "glosses": [
                            "so, dass es bewertet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8fc205-2401-48d0-b1d8-e9406d1b0f25",
                                "sense_id": "d2ab6d73-f9bd-3c0b-aaca-57ee595fa18c",
                                "text": "„Die Sportart steht außerdem grundsätzlich im Verdacht, überhaupt nicht objektiv bewertbar zu sein.“"
                            },
                            {
                                "example_id": "86f47609-e833-4275-b9d0-6b77d1aee314",
                                "sense_id": "d2ab6d73-f9bd-3c0b-aaca-57ee595fa18c",
                                "text": "„Als selbständig bewertbar gilt ein Wirtschaftsgut, wenn es in seiner Einzelheit von Bedeutung und bei einer Veräußerung greifbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
