                    {
                        "sense_id": "e97aebdb-9780-3537-a76b-39cb9af13171",
                        "entry_id": "20af8b86-006c-3c1b-bcba-593fd108835a",
                        "glosses": [
                            "gebied met kleiachtige grond; een grondsoort fijner dan zand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd244189-9d84-4266-bb08-902115e3f5df",
                                "sense_id": "e97aebdb-9780-3537-a76b-39cb9af13171",
                                "text": "Van Aerle vermoedt dat de Brabantse leemgrond door de warme winter wel eens aan de oppervlakte zou kunnen komen. En dat zorgt voor drassigheid."
                            },
                            {
                                "example_id": "7d6478cd-1fcb-4ebc-8c65-6031bb7f8481",
                                "sense_id": "e97aebdb-9780-3537-a76b-39cb9af13171",
                                "text": "Wanneer niet snel een flinke portie leemgrond op de huidige fourageerplek van de vele steltlopers wordt gebracht, zijn de slikveldjes binnen enkele maanden geheel onder de waterspiegel verdwenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37bbe5f6-8a25-4ef7-989f-6af1f1c7dded",
                        "source_entry_id": "20af8b86-006c-3c1b-bcba-593fd108835a",
                        "source_sense_id": "e97aebdb-9780-3537-a76b-39cb9af13171",
                        "target_lang_word": "silt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
