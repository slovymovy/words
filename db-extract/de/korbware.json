                        "examples": [
                            {
                                "example_id": "b7ac15a5-6962-4600-a73d-0944c02ed9f0",
                                "sense_id": "af5147d9-62d1-3e38-aebc-665db21fd3d1",
                                "text": "Es gab (auf dem Markt) vor allem Korbwaren, Töpferei und timples – eine Art kleiner, viersaitiger Gitarren, typisch für die Insel, wenn man wiederum den Hotel-Broschüren glauben konnte.",
                                "translation": "Il y avait surtout de la vannerie, de la poterie et des timples – sorte de petites guitares à quatre cordes spécifiques à l'île, toujours selon les brochures de l’hôtel."
                            }
                        ]
                    }
