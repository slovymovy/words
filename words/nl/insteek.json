                            }
                        ]
                    }
                },
                {
                    "sense_id": "24bdcb0b-55a5-3595-821e-85e03d02de44",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd in de bijzin van <w>insteken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij stelt voor dat ik de draad eerst <w>insteek</w>.",
                            "target_lang_translations": {
                                "en": "She suggests that I <w>thread</w> the needle first."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat ik de stekker voorzichtig <w>insteek</w>.",
                            "target_lang_translations": {
                                "en": "It is important that I <w>plug in</w> the connector carefully."
                            }
