                "senses": [
                    {
                        "sense_id": "8e801e1d-7c27-3eab-a5c9-85d0725450e9",
                        "entry_id": "07c4a966-a702-3e42-92b4-b861db703d04",
                        "glosses": [
                            "Garçon-meunier, chargé de la quête du grain à moudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b42927-5b85-47ba-9d34-0362bd1cbf3d",
                                "sense_id": "8e801e1d-7c27-3eab-a5c9-85d0725450e9",
                                "text": "Les moissonneurs avaient un épi ou une herbe épigée ; le meunier ou le chasseron un fouet."
                            },
                            {
                                "example_id": "94b6034a-d1e0-40ca-ba3b-4984102fc9e5",
                                "sense_id": "8e801e1d-7c27-3eab-a5c9-85d0725450e9",
                                "text": "Chasseron, chassiron, Valet de meunier, chassant aux pochées ou sacs des accoursiers, des pratiques."
                            },
                            {
                                "example_id": "7c1b852f-90c2-4fdd-8870-c22b9af20f10",
                                "sense_id": "8e801e1d-7c27-3eab-a5c9-85d0725450e9",
                                "text": "Les chasserons. Circulaient aussi les chasserons. On appelait ainsi les fariniers qui prenaient les sacs de grain chez les clients. Lorsque le grain était moulu, ils rapportaient les sacs de farine chez les pratiques. Ces « chasserons » n’étaient pas toujours pressés."
                            }
                        ]
                    }
                ],
