                "senses": [
                    {
                        "sense_id": "b19f7d0f-24a4-3fe4-ac2e-6e0c50ee8db5",
                        "entry_id": "a3d81506-9da5-3490-a105-2c5ccae49ce1",
                        "glosses": [
                            "A false god; an idol."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ceb525d8-8293-411a-878c-17115f14726c",
                                "sense_id": "b19f7d0f-24a4-3fe4-ac2e-6e0c50ee8db5",
                                "text": "Moloc that mawmett. there darre no man wᵗ ſay\nThe Reſte of ſuche Reconyng may make a fowle fraye"
                            }
                        ]
                    },
                    {
                        "sense_id": "c66c5a60-d5ae-3171-b32d-0a42dfaa2838",
                        "entry_id": "a3d81506-9da5-3490-a105-2c5ccae49ce1",
                        "glosses": [
                            "A doll or puppet; a lifeless figure, an effigy, a scarecrow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eaa45eb-c5d3-45dd-b209-38077586eecc",
                                "sense_id": "c66c5a60-d5ae-3171-b32d-0a42dfaa2838",
                                "text": "And then to haue a wretched puling foole, / A whining mammet, in her Fortunes tender, / To answer, Ile not wed, I cannot Loue: / I am too young, I pray you pardon me."
                            },
                            {
                                "example_id": "410518b7-359a-4d55-a9c5-e9d320163e0f",
                                "sense_id": "c66c5a60-d5ae-3171-b32d-0a42dfaa2838",
                                "text": "this is no world / To play with mammets and to tilt with lips"
                            },
                            {
                                "example_id": "415f19a8-bada-4f8c-a03b-5e587f6fb275",
                                "sense_id": "c66c5a60-d5ae-3171-b32d-0a42dfaa2838",
                                "text": "He didn't want to go, and I didn't want him to go; and we stood there like two mommets and there was nothing we could say."
                            }
                        ]
                    },
                    {
                        "sense_id": "505e464e-9282-33e0-9b97-d10cfb70eaba",
                        "entry_id": "a3d81506-9da5-3490-a105-2c5ccae49ce1",
                        "glosses": [
                            "A contemptible person; a weakling, a fool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d94644-1f5d-4008-a340-2d06be637b3a",
                                "sense_id": "505e464e-9282-33e0-9b97-d10cfb70eaba",
                                "text": "Blind, deaf, insensate driveler!—Torpid, blockish, brainless mammet!"
                            },
                            {
                                "example_id": "e0dcdaa9-7b0c-42e6-b58f-98bfe035cd40",
                                "sense_id": "505e464e-9282-33e0-9b97-d10cfb70eaba",
                                "text": "\"Had it anything to do with father's making such a mommet of himself in the carriage this afternoon?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
