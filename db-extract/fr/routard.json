                    },
                    {
                        "form_id": "f349731b-bb36-448d-8778-6426f9154718",
                        "entry_id": "416711b4-4e26-3652-a177-eac0082f0c5a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "routarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebe6f67d-b8ec-33ef-9cae-0a43931b41dd",
                        "entry_id": "416711b4-4e26-3652-a177-eac0082f0c5a",
                        "glosses": [
                            "Voyageur, généralement solitaire et préférant les formules bon marché."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3c691a1b-7a87-4a23-94a6-afd06c084821",
                                "sense_id": "ebe6f67d-b8ec-33ef-9cae-0a43931b41dd",
                                "text": "Dans toute ma vie de routard, j’ai vu presque tous les plus beaux endroits du monde, mais rien n’a jamais égalé, dans mon esprit, ces rencontres folles, inattendues, toutes simples."
                            },
                            {
                                "example_id": "3e8b4a4a-5dbf-4c69-84ac-0611e19ece59",
                                "sense_id": "ebe6f67d-b8ec-33ef-9cae-0a43931b41dd",
                                "text": "C'était le rendez-vous des babs, des routards, des beatniks en partance pour les Indes. Les minibus se garaient en face. On y mangeait pour pas cher,on s'y reposait avant le grand saut dans l'inconnu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "535335af-7f26-4b53-bec5-31b5d95f25b3",
                        "source_entry_id": "416711b4-4e26-3652-a177-eac0082f0c5a",
                        "source_sense_id": "ebe6f67d-b8ec-33ef-9cae-0a43931b41dd",
                        "target_lang_word": "Rucksacktourist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rucksacktourist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2141cbfd-eaf4-3dfd-9c46-845b67d691ea",
                                        "entry_id": "6b8e7648-6f92-352e-8bf3-818041ffa217",
                                        "glosses": [
                                            "Tourist, der mit einer sehr geringen, in einem Rucksack mitgeführten Menge an Gepäck reist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb71acf-c229-440d-ace8-d9bcb04654ff",
                                                "sense_id": "2141cbfd-eaf4-3dfd-9c46-845b67d691ea",
                                                "text": "„Er nahm sich vor, die Musik auf seinem 32 Gig iPod touch zu hören, den er im Dezember einem deutschen Rucksacktouristen geklaut hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34da20b4-3633-427b-a132-45396e3cdb67",
                        "source_entry_id": "416711b4-4e26-3652-a177-eac0082f0c5a",
                        "source_sense_id": "ebe6f67d-b8ec-33ef-9cae-0a43931b41dd",
                        "target_lang_word": "backpacker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backpacker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                        "entry_id": "9f635467-3583-315a-a393-e355f18f3222",
                                        "glosses": [
                                            "A traveler whose luggage consists of a backpack; especially, such a traveler who uses hostels, public transport, and other inexpensive services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed83ee32-1d02-4a6b-b075-09d60aeaf722",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "Among the ah bengs and ah lians, the mats and the minahs, the young expats and the backpackers, he stood out like a dozen guys on a male-only dance floor singing Dancing Queen (I'll never forgive Blur for ruining my 21st birthday)."
                                            },
                                            {
                                                "example_id": "d203cf7c-6410-46fb-bc28-6781f1fa5502",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "A decade ago, I was a backpacker entirely reliant on the railways as a means to see Britain, and with castles as my destination. Via trains alone, I was able to tick off nearly all of the castles that my English Heritage annual pass afforded me."
                                            },
                                            {
                                                "example_id": "a47687cd-0835-4c23-b85e-a43d43e56b58",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "Eight staff members of a backpacker hostel in Laos have been detained by local authorities as they investigate the deaths of six foreign tourists from suspected methanol poisoning, according to state-affiliated media in the Southeast Asian country."
                                            },
                                            {
                                                "example_id": "bcca4a90-ea4c-41b6-a4c0-80d70a19a9e6",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "Lots of pockets help with a commute, a storm hood is great if you get caught in a storm on a hike, weight and packability are essential for backpackers and if you’re a climber or biker, you’ll want a helmet-compatible hood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf58b53f-995e-389f-8c55-0a3f2b3f58b1",
                                        "entry_id": "9f635467-3583-315a-a393-e355f18f3222",
                                        "glosses": [
                                            "A hostel offering accommodation for such people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585a009f-7fca-46ba-806a-1798f53738f6",
                                                "sense_id": "cf58b53f-995e-389f-8c55-0a3f2b3f58b1",
                                                "text": "We hardly ever stayed in backpackers as it was approximately double the cost of pitching a tent in a caravan park or nature reserve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                                        "entry_id": "9f635467-3583-315a-a393-e355f18f3222",
                                        "glosses": [
                                            "A fan or performer of backpack rap."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a62b14-62c6-468d-ab95-9bfea71ea23c",
                                                "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                                                "text": "Blacks and Latinos were more likely to be gangsta rappers than backpackers."
                                            },
                                            {
                                                "example_id": "326f154f-355a-46d6-b76e-fe4812b16f12",
                                                "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                                                "text": "To him the white backpackers are abject, 'safari wiggers' who threaten to undo all his careful work at 'passing' in this culture. With their earnestness and clumsy naiveté they betray the scandalous truth of his posturing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb56e191-1ad3-4fe7-a0e5-5b3b826d3a9d",
                        "source_entry_id": "416711b4-4e26-3652-a177-eac0082f0c5a",
                        "source_sense_id": "ebe6f67d-b8ec-33ef-9cae-0a43931b41dd",
                        "target_lang_word": "drifter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drifter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06f9521a-b3b2-3ecb-b1d3-dfe1712a4858",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A person who moves from place to place or job to job."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88147aae-ce07-4f60-8ca9-c54c690aee2a",
                                                "sense_id": "06f9521a-b3b2-3ecb-b1d3-dfe1712a4858",
                                                "text": "There are drifters painting beside you / They don't see the future that I do"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A type of lightweight sail used in light winds like a spinnaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c15678-379b-415f-a885-d458f617bd8f",
                                                "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                                "text": "In winds above 10 knots we usually run wing-and-wing with our 100 percent lapper set on a whisker pole opposite the mainsail. As the wind drops, we get out the drifter and set it flying to leeward (Fig. 1)."
                                            },
                                            {
                                                "example_id": "6a3ff44f-92bd-471c-88d2-f78160ad69af",
                                                "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                                "text": "After trying a variety of light-wind sails, we've found the most versatile and simple one to be a nylon drifter."
                                            },
                                            {
                                                "example_id": "3d5db2ec-7b58-4f79-b5e8-8d883edba46e",
                                                "sense_id": "54f41aad-1b83-37cd-991c-3bb6a3b955b0",
                                                "text": "Some people recommend a medium- to lightweight 140- or 150-percent headsail, and others go for a drifter/reacher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A driver who uses driving techniques to modify vehicle traction to cause a vehicle to slide or power slide rather than drive in line with the tires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74bc41be-f807-4395-9813-7f4e754bb21c",
                                                "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                                "text": "However, sensing the available traction may actually be more important to a drifter."
                                            },
                                            {
                                                "example_id": "4f2312cc-2a72-483a-a011-79e94adc13fe",
                                                "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                                "text": "For professional drifters looking for even more fine-tuning of their suspension setups, some companies offer more advanced two-way adjustable shocks […]"
                                            },
                                            {
                                                "example_id": "404f7264-7f38-4212-8166-b1b14df1256d",
                                                "sense_id": "31e6e40a-5f91-3e0e-9bc2-d01c0d068e2b",
                                                "text": "While this method is used by a few drifters in rear-wheel drive cars, this technique is really the only way one can drift in a front-wheel drive car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c8352d-af75-33aa-af40-43fc31a2dd17",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A parachutist who jumps before the rest of the group to determine wind direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63ebe9a-5897-4af3-9b07-903095f0b3b9",
                                                "sense_id": "e9c8352d-af75-33aa-af40-43fc31a2dd17",
                                                "text": "As we circled the area, the Dakota appeared and dropped a drifter."
                                            },
                                            {
                                                "example_id": "763d0d3e-6d75-41c8-b83e-7c9d3a14d988",
                                                "sense_id": "e9c8352d-af75-33aa-af40-43fc31a2dd17",
                                                "text": "[…] a circling Beverley dropped parachutists in small groups — a few hard words were said about R.A.F. organisation. The time came at last for the first four to get into the balloon car. First out was a drifter — an experienced parachutist who jumps first to assess conditions by allowing himself to drift at random."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ceef1ce-ea96-3750-8217-113ace32c2c4",
                                        "entry_id": "527aa0b6-e98b-3958-93a1-67f501afc650",
                                        "glosses": [
                                            "A person employed in driving in rock other than coal."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "drifter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efc34a13-a0ba-300d-be84-51c05a0a91be",
                                        "entry_id": "79c55f8e-7b5a-3b98-8e61-374fe554bede",
