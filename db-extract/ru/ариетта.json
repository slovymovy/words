                        "cross_references": [
                            {
                                "target_word": "ariette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c171fa27-2cb8-3bef-979d-5b07079b6a9d",
                                        "entry_id": "eac76272-d444-3144-8e1b-d2f7e69e09eb",
                                        "glosses": [
                                            "Air léger, d’un mouvement plus ou moins vif et marqué, qui s’adapte à des paroles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68faa931-85f6-49e9-93cf-9f1160fd9e47",
                                                "sense_id": "c171fa27-2cb8-3bef-979d-5b07079b6a9d",
                                                "text": "Les vaudevilles se sont nommés longtemps comédies à ariettes."
                                            },
                                            {
                                                "example_id": "15a592d6-979d-42dc-ab22-c283f3bc98bd",
                                                "sense_id": "c171fa27-2cb8-3bef-979d-5b07079b6a9d",
                                                "text": "Eh ! je me mouche dedans, puis, pirouettant sur mes talons, je sifflote quelque ariette en vogue."
                                            },
                                            {
                                                "example_id": "f761dde3-8555-41d0-91c6-ea845fc9bf96",
                                                "sense_id": "c171fa27-2cb8-3bef-979d-5b07079b6a9d",
                                                "text": "Si je m’en souviens ! comme elle disait son grand air, mon cousin Robinson !\n– Et son duo badin, mon cousin Turner !\n– Et son ariette !"
                                            },
                                            {
                                                "example_id": "b47b3e8b-12f9-467d-8a52-dd050ac0e26d",
                                                "sense_id": "c171fa27-2cb8-3bef-979d-5b07079b6a9d",
                                                "text": "Pendant tout le premier acte, Orphée se plaignit avec facilité, quelques femmes en tuniques commentèrent avec grâce son malheur, et l'amour fut chanté en ariettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
