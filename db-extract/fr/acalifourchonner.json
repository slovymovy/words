                        "sense_id": "ef74272a-4911-345d-8963-1680d79e10b1",
                        "entry_id": "a84b1b9a-75fe-361f-818c-ea1017ca8877",
                        "glosses": [
                            "Mettre à califourchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ec37ff-4a23-42cc-9e29-c9ae04f35c26",
                                "sense_id": "ef74272a-4911-345d-8963-1680d79e10b1",
                                "text": "On ne peut pas se battre pour la démocratie et acalifourchonner l'autocratie."
                            },
                            {
                                "example_id": "91f18699-f10b-45e5-a390-bb694d36f697",
                                "sense_id": "ef74272a-4911-345d-8963-1680d79e10b1",
                                "text": "Puis, de s'acalifourchonner sur le faîte, comme sur l'échine d'une haquenée, — pour arrêter, disait-il, l'incendie en crachant dessus ;"
                            }
                        ]
                    }
