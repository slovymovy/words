                        "entry_id": "c27ee0ea-1ca9-357d-a53c-b1f010bab4f8",
                        "glosses": [
                            "Postwertzeichen, das zu einem besonderen Thema oder Ereignis in begrenzter Auflage herausgegeben wird"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "8aa44ebc-2e59-4b70-8ca4-c37dd873a907",
                                "sense_id": "6926b1c8-1ab5-3838-a082-e788fb519307",
                                "text": "Ich sammle Briefmarken, aber nur Sonderbriefmarken."
                            },
                            {
                                "example_id": "41bacf2e-9936-4f5e-b1bb-2296b4bd8a6f",
                                "sense_id": "6926b1c8-1ab5-3838-a082-e788fb519307",
                                "text": "„Mehrere Schulen sind nach ihr benannt, die DDR gibt zu ihrer und ihres Mannes Ehre 1964 eine Sonderbriefmarke heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
