                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1e677aa-2c88-374f-ac29-87063f9f7519",
                        "entry_id": "b78d8925-3421-3283-9220-a3f13748789d",
                        "glosses": [
                            "Körper mit zwölf Seitenflächen"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "f4f253a4-5296-4f92-9bb9-46fc40bb1ef2",
                                "sense_id": "b1e677aa-2c88-374f-ac29-87063f9f7519",
                                "text": "Die Lehrerin trug ihren Schülern auf, das Netz eines Dodekaeders zu zeichnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9df596db-1d3d-32bb-9c04-65f52160f5e6",
                        "entry_id": "b78d8925-3421-3283-9220-a3f13748789d",
                        "glosses": [
                            "Körper mit zwölf Seitenflächen",
                            "regelmäßiges Pentagondodekaeder; Körper, der von zwölf gleichseitigen Fünfecken begrenzt wird"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "bb208f22-53c0-4a53-b25a-da53f5ee85b2",
                                "sense_id": "9df596db-1d3d-32bb-9c04-65f52160f5e6",
                                "text": "Das Dodekaeder ist dual zum regelmäßigen Ikosaeder."
                            },
                            {
                                "example_id": "6151f473-cd39-4e41-9870-70d8f486b41b",
                                "sense_id": "9df596db-1d3d-32bb-9c04-65f52160f5e6",
                                "text": "„Der Dodekaeder nimmt also in der Kosmogonie Platons die Rolle der entstandenen Gestalt des vollendeten Einen ein.“"
                            },
                            {
                                "example_id": "8b47fb4c-8aa7-479a-a9c8-d2e1abe7f947",
                                "sense_id": "9df596db-1d3d-32bb-9c04-65f52160f5e6",
                                "text": "„Jede der Pyramiden besitzt, wie der Dodekaeder selbst, eine regelmäßige Form.“"
                            },
                            {
                                "example_id": "b02e0765-ed8e-4e71-bd9c-7535858d93b8",
                                "sense_id": "9df596db-1d3d-32bb-9c04-65f52160f5e6",
                                "text": "„Es folgt also, daß es insgesamt 20 · 3 = 60 Operationen inklusive der identischen gibt, die den Dodekaeder in Deckungsgleichheit mit sich selbst überführen.“"
                            },
                            {
                                "example_id": "75034be6-a49e-407c-a566-f2f6f1ba565b",
                                "sense_id": "9df596db-1d3d-32bb-9c04-65f52160f5e6",
                                "text": "„Das Messsignal wurde über eine externe Soundkarte vom Notebook zum Verstärker geschickt und über den Dodekaeder in den Raum abgestrahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4955c135-2f97-4ed1-9c12-e8da8cac472b",
                        "source_entry_id": "b78d8925-3421-3283-9220-a3f13748789d",
                        "target_lang_word": "dodecahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dodecahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                        "entry_id": "b15d36b1-6040-3818-b3cb-a6770c3c1713",
                                        "glosses": [
                                            "A polyhedron with twelve faces; the regular dodecahedron has regular pentagons as faces and is one of the Platonic solids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7596c97-eb85-4e5b-895d-dbd1886869b3",
                                                "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                                "text": "1707, Thomas Blount, Glossographia Anglicana Nova: Or, A Dictionary, Interpreting Such Hard Words, D. Brown, heading DO–DO,\nDodecahedron, (Gr.) in Geometry, is a solid Figure of 12 Sides or Faces that are regular Pentagons, it is one of the Platonick or Regular Bodies."
                                            },
                                            {
                                                "example_id": "8eb4625b-7256-407b-8569-6f143dc1a70b",
                                                "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                                "text": "It took me two years, but by the time I was 12 I could imagine the fifth four-dimensional polytope, which is made up of 120 dodecahedrons."
                                            },
                                            {
                                                "example_id": "b2448926-3d40-45ba-9b36-e7e4e822258d",
                                                "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                                "text": "There is no uniformity in the size or shape of the dodecahedra found so far, nor in their metal composition or even in the level of craftsmanship. If they were important objects, we would expect to also discover contextual evidence in the archaeological record, such as depictions in paintings or mosaics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fb3ca89-0897-490b-a272-9f539fc3ffdf",
                        "source_entry_id": "b78d8925-3421-3283-9220-a3f13748789d",
