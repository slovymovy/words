                            {
                                "example_id": "d6c3fb1d-f54d-4d27-a739-bb4816507743",
                                "sense_id": "21d07b6e-793b-351b-9e07-2df08f6c8d02",
                                "text": "Am Wege links und auch sonst an den Gräben bemerken wir öfters eine wilde Johannisbeere (Ribes nigrum), die Fuchs- oder Ahlbeere, deren Blätter sich durch einen „würzigen“ Geruch auszeichnen und ihr den Namen „Fuchsbeere“ eingetragen haben.",
                                "translation": "On the way left and else at the trenches we note often a wild currant (Ribes nigrum), the fox- or elecampane-berry, the leaves of which are marked by a “savoury” smell and have spawned its name “fox-berry”.",
                                "english": "On the way left and else at the trenches we note often a wild currant (Ribes nigrum), the fox- or elecampane-berry, the leaves of which are marked by a “savoury” smell and have spawned its name “fox-berry”."
                            }
                        ]
                    }
