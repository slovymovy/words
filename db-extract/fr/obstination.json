        "fr-extract.jsonl": [
            {
                "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                "word": "obstination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "15426ac3-32b5-4aab-a9ea-4f5607c7d66e",
                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                        "tags": [
