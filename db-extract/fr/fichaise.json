        "fr-extract.jsonl": [
            {
                "entry_id": "85d59fc3-02d4-3685-aa01-6ea7ef165ebd",
                "word": "fichaise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "faad9371-72f3-4567-a332-337341696074",
                        "entry_id": "85d59fc3-02d4-3685-aa01-6ea7ef165ebd",
                        "tags": [
                            "plural"
                        ],
                        "form": "fichaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "601ebfc4-4413-3255-bfdf-4020fc0429d6",
                        "entry_id": "85d59fc3-02d4-3685-aa01-6ea7ef165ebd",
                        "glosses": [
                            "Chose de peu de valeur ; propos sans intérêt."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "925100b2-07e4-4423-8350-2bd80ac0d5ab",
                                "sense_id": "601ebfc4-4413-3255-bfdf-4020fc0429d6",
                                "text": "– Bon. Et qu'as-tu trouvé?\n– Ma fine !... pas grand’chose.., des bricoles, quoi ? Tout au plus des fichaises... bien juste pour vos cinq cents francs !"
                            },
                            {
                                "example_id": "274ad588-d2af-4e29-8a4b-4eda6641c583",
                                "sense_id": "601ebfc4-4413-3255-bfdf-4020fc0429d6",
                                "text": "— Les feuilles sont amusantes, ce matin. Je vais les lire ici pendant une heure. Vous avez une heure à vous pour vous raconter vos fichaises. Après, je reconduirai mademoiselle à son bureau et j'irai faire ma visite à Mme Eudeline."
                            },
                            {
                                "example_id": "d98904da-0331-4931-83c9-907769f55496",
                                "sense_id": "601ebfc4-4413-3255-bfdf-4020fc0429d6",
                                "text": "Fichaises! Balivernes! Qu'on me laisse prendre mon bain en paix!"
                            },
                            {
                                "example_id": "bd9ffa03-e41d-4293-af93-477c1f655004",
                                "sense_id": "601ebfc4-4413-3255-bfdf-4020fc0429d6",
                                "text": "Est-ce qu’il ne pouvait pas donner sa paie d’un seul coup, au lieu de la débiter en tranches sous prétexte qu’on ne faisait jamais la soudure ? La soudure ! Belle fichaise. Comme s’il ne valait pas mieux vivre quelques bonnes journées – au risque d’en jeûner quelques autres – plutôt que de grignoter des miettes tout le mois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2f93b2c-4298-4e08-aa91-53f8093cb94e",
                        "source_entry_id": "85d59fc3-02d4-3685-aa01-6ea7ef165ebd",
                        "source_sense_id": "601ebfc4-4413-3255-bfdf-4020fc0429d6",
                        "target_lang_word": "Lappalie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lappalie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29bd2c78-c1b6-356b-8329-14f29d2dd32a",
                                        "entry_id": "b10fd460-673e-3405-b9c0-8244e3341c41",
                                        "glosses": [
                                            "eine Kleinigkeit, eine Nichtigkeit, eine höchst unbedeutende Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8573caa9-27a5-4e6b-b735-cbd371e9901c",
                                                "sense_id": "29bd2c78-c1b6-356b-8329-14f29d2dd32a",
                                                "text": "Ich beschäftige mich nicht mit einer solchen Lappalie."
                                            },
                                            {
                                                "example_id": "0f4f0426-1492-4d9e-a572-2f667ac53c4e",
                                                "sense_id": "29bd2c78-c1b6-356b-8329-14f29d2dd32a",
                                                "text": "„Ich sah den vier Jungs deutlich an, dass sie keine große Lust verspürten, ihr Kartenspiel wegen so einer Lappalie zu unterbrechen.“"
                                            },
                                            {
                                                "example_id": "1e2290fb-8737-436f-8422-e1c8bbafc6af",
                                                "sense_id": "29bd2c78-c1b6-356b-8329-14f29d2dd32a",
                                                "text": "„Die Geschichte ist eine Lappalie.“"
                                            },
                                            {
                                                "example_id": "6a16696c-69e2-46c9-8dce-76a44cfb1ddc",
                                                "sense_id": "29bd2c78-c1b6-356b-8329-14f29d2dd32a",
                                                "text": "„Immer kommt's zu einem Streit wegen irgendeiner Lappalie, und das Mädchen – jetzt sind's meistens Frauen – verzieht sich in die unbekannten Gegenden, aus denen sie herkam oder wohin sie strebte, als Mansfield sie für sich beschlagnahmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
