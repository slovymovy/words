                    {
                        "sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
                        "entry_id": "0b1878c1-bc69-367c-9cf3-20af10f22cca",
                        "glosses": [
                            "jeden z dwóch lub więcej autorów tego samego dzieła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "040350bb-b729-4386-832a-74c48077f959",
                                "sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
                                "text": "Nie jest zaś tak, jak Pan pisze, aby współautorka stłumiła w tym współautora"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3870d471-412b-4405-b800-5bb32b96aeab",
                        "source_entry_id": "0b1878c1-bc69-367c-9cf3-20af10f22cca",
                        "source_sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
                        "target_lang_word": "co-author",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "co-author",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b59cac9-ba08-380a-9d32-75772e62bd52",
                                        "entry_id": "1240cb21-8935-31f2-857f-b86af23d4149",
                                        "glosses": [
                                            "Alternative form of coauthor."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b9a9467-db9c-4ccf-b2d4-3db3cee7f6f4",
                                                "sense_id": "6b59cac9-ba08-380a-9d32-75772e62bd52",
                                                "text": "The report's co-authors Ian Wray, David Thrower, and Jim Steer point to the building of the motorways in the 1960s and 1970s, when new sections were added progressively and in \"financially digestible chunks\"."
                                            },
                                            {
                                                "example_id": "74c85eb0-a696-40e5-9881-6e0525c4c482",
                                                "sense_id": "6b59cac9-ba08-380a-9d32-75772e62bd52",
                                                "text": "While Linder prefers his taters cut skinny, as they are in restaurant iterations of the dish, his co-author, the television chef Johanna Westman, says she prefers them thick, as in her Grandma Alva’s recipe."
                                            },
                                            {
                                                "example_id": "6b668ecb-2362-4140-bc64-54090d262bd4",
                                                "sense_id": "6b59cac9-ba08-380a-9d32-75772e62bd52",
                                                "text": "“This suggests that most of the foraging that the bees do occurs very close to the hive,” study co-author Margarita López-Uribe, an associate professor of entomology at PSU, told CNN on Monday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "co-author",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3afe755-d161-39e1-8def-fc9f05315a4a",
                                        "entry_id": "c0b4823c-8075-35ce-b742-96b865deea50",
                                        "glosses": [
                                            "Alternative form of coauthor."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da72e863-6257-4e49-813f-3df8c856f964",
                        "source_entry_id": "0b1878c1-bc69-367c-9cf3-20af10f22cca",
                        "source_sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
                        "target_lang_word": "coautor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "336d8d2c-a918-4732-bcf3-89247bab6f26",
                        "source_entry_id": "0b1878c1-bc69-367c-9cf3-20af10f22cca",
                        "source_sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
                        "target_lang_word": "Koautor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koautor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf04dc07-6613-3e5e-ae3b-75738673ec02",
                                        "entry_id": "04080bfb-7b01-32a2-9118-7a541e1242b6",
                                        "glosses": [
                                            "(männliche^☆) Person, die ein literarisches Werk zusammen mit einer anderen Person oder mehreren anderen Personen verfasst hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501b7dc7-def2-41fd-9a8b-10eba195e58d",
                                                "sense_id": "bf04dc07-6613-3e5e-ae3b-75738673ec02",
                                                "text": "Dank der Recherche meines Koautors und besten Freundes gelang es uns, die historischen Gegebenheiten ziemlich exakt darzustellen."
                                            },
                                            {
                                                "example_id": "47f57101-9e42-4393-83f8-7edc83edceab",
                                                "sense_id": "bf04dc07-6613-3e5e-ae3b-75738673ec02",
                                                "text": "Ein „Hans Müller“ wird auf dem Umschlag des Romans als Koautor genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71e48561-eae6-4c2d-b534-3d3f7eb7b09f",
                        "source_entry_id": "0b1878c1-bc69-367c-9cf3-20af10f22cca",
                        "source_sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
                        "target_lang_word": "Mitautor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitautor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71c727d8-d9f8-382c-a7ff-557b9085ea30",
                                        "entry_id": "3fb7f867-1b40-392e-b27d-dee574b69b21",
                                        "glosses": [
                                            "eine Person, die zugleich (auch/mit) als schreibende Person (Autor) tätig ist; eine von zwei oder mehreren Personen, die gemeinsam einen Text verfassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16c70f02-2f2a-4ee8-b18b-bb315434b246",
                                                "sense_id": "71c727d8-d9f8-382c-a7ff-557b9085ea30",
                                                "text": "„Mein Vater wurde übrigens ohne sein Wissen Mitautor von ‚Göttliche Erkenntnis‘, er blieb deswegen auch, insbesondere mangels seiner Einwilligung und weil ich seinen Text komplett sprachlich bearbeitete, als Autor unerwähnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdeff7da-a379-40c0-b7df-9507156d3fb2",
                        "source_entry_id": "0b1878c1-bc69-367c-9cf3-20af10f22cca",
                        "source_sense_id": "32d25d0c-08f3-32cc-8668-394396f0fdb6",
