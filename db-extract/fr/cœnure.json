                        "sense_id": "b7af74cd-5f92-328d-b7e4-24288f4a14eb",
                        "entry_id": "6fcec4d6-eaad-3df5-afbc-279e0fa15e16",
                        "glosses": [
                            "Variante de cénure."
                        ],
