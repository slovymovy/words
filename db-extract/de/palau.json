                ],
                "senses": [
                    {
                        "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                        "entry_id": "bfcb262c-a866-39ee-b4b6-f98ccc79fc55",
                        "glosses": [
                            "Inselstaat im Pazifischen Ozean"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8476dc4c-9c81-49a2-80ae-a6d2c801973f",
                                "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                                "text": "Wir machen eine Reise nach Palau."
                            },
                            {
                                "example_id": "bf9ba4d6-61d6-4cc5-ab8b-6c7f4f2a12e6",
                                "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                                "text": "Theo weilt im Moment in Palau."
                            },
                            {
                                "example_id": "ed736341-22b0-44ab-80bf-01887bdc0b90",
                                "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                                "text": "Ngerulmud ist die Hauptstadt von Palau."
                            },
                            {
                                "example_id": "d2ea9fe2-b8d4-4e4b-9030-7f499712958f",
                                "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                                "text": "„Die Inseltwelt Palaus weist eine ungewöhnlich reiche Meeresflora und -fauna auf; dem steht eine auffallende Artenarmut an Land gegenüber.“"
                            },
                            {
                                "example_id": "bccdc736-8bdf-476f-b3f2-77794816801b",
                                "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                                "text": "„Die ersten Bewohner von Palau kamen vermutlich aus Indonesien, Australien oder Polynesien und besiedelten die Inseln schon um 1000 v. Chr.“"
                            },
                            {
                                "example_id": "6a69a4c7-cabb-4e3a-9197-180526b9eede",
                                "sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
                                "text": "„Jene wurden am 22. Dezember 1990 … unabhängig, die Republik Palau (Belau) am 1. Oktober 1994.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5046fb0-f968-44fc-8dce-e93233d356ca",
                        "source_entry_id": "bfcb262c-a866-39ee-b4b6-f98ccc79fc55",
                        "source_sense_id": "5ba1e5be-e501-3c59-aa74-b63bca10da6d",
