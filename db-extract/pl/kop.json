                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17bb21eb-28ba-3911-ad61-01e419ec34c1",
                                        "entry_id": "2a0705f5-b92f-30f4-9f34-a4b812db0afb",
                                        "glosses": [
                                            "körperliche Attacke durch Treten oder Stoßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe07682-91c2-4484-87b6-aef2d1ea28cb",
                                                "sense_id": "17bb21eb-28ba-3911-ad61-01e419ec34c1",
                                                "text": "„Und wo ist es jetzt, das Schöne, hätte ich schreien mögen, aber die Pillen dämpften meine Empörung zu einem unwilligen Kick gegen die Bordsteinkante in den Arkaden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00e813d8-d62c-39b6-9d25-bfcbfc6ea2e2",
                                        "entry_id": "2a0705f5-b92f-30f4-9f34-a4b812db0afb",
                                        "glosses": [
                                            "eine kurzzeitige nervliche und emotionale Erregung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800d26fa-3709-4de7-825a-f04285ceaab8",
                                                "sense_id": "00e813d8-d62c-39b6-9d25-bfcbfc6ea2e2",
                                                "text": "Der Sieg war der Kick, den die Mannschaft noch brauchte."
                                            },
                                            {
                                                "example_id": "43042848-8721-40a2-9225-cb72c55de135",
                                                "sense_id": "00e813d8-d62c-39b6-9d25-bfcbfc6ea2e2",
                                                "text": "„Nebenbei fragt man sich natürlich, wie versaut einer sein muss, wenn ihn der ultimative Kick erst dann einholt, wenn er andere auslöscht.“"
                                            },
                                            {
                                                "example_id": "233b75ae-d1d1-45e3-a8dc-14b62b63e4cc",
                                                "sense_id": "00e813d8-d62c-39b6-9d25-bfcbfc6ea2e2",
                                                "text": "„Was das Motorradfahren betrifft, war das hier ein Kick, wie ich ihn nie zuvor verspürt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f910851e-7f4f-35ad-ae5d-256a7047d2df",
                                        "entry_id": "2a0705f5-b92f-30f4-9f34-a4b812db0afb",
                                        "glosses": [
