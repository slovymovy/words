                "senses": [
                    {
                        "sense_id": "aa0a29ad-e621-311b-bb79-b9cd6f9aed52",
                        "entry_id": "49032095-3173-30de-8e7a-4e5c416c1c90",
                        "glosses": [
                            "Leiter einer Abfallbehörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de5ea57-99d0-442e-a572-31e9f029a877",
                                "sense_id": "aa0a29ad-e621-311b-bb79-b9cd6f9aed52",
                                "text": "„Der Christdemokrat galt bisher als Mann der Industrie: Er war Abfallreferent beim Bundesverband der Deutschen Industrie und ist jetzt Chef des industrienahen Instituts für gewerbliche Wasserwirtschaft und Luftreinhaltung.“"
                            },
                            {
                                "example_id": "572d37ae-7d76-4765-a579-ffc1a64da7d2",
                                "sense_id": "aa0a29ad-e621-311b-bb79-b9cd6f9aed52",
                                "text": "„UBV-Kreisrat Jakob Drexler, seit anderthalb Jahren Abfallreferent des Kreistags, wurde in der Vergangenheit nicht müde, bei jeder Gelegenheit einen Systemwechsel weg von den im Kreis Fürstenfeldbruck benutzten Sammelsäcken hin zur Biotonne zu fordern.“"
                            },
                            {
                                "example_id": "7ae1ffc0-4c05-4ea9-b639-80a629d205bc",
                                "sense_id": "aa0a29ad-e621-311b-bb79-b9cd6f9aed52",
                                "text": "„Den (Rest-)Abfallberg zu verkleinern, sieht Umwelt- und Klimastadtrat sowie Abfallreferent Thomas Rammerstorfer als eine seiner vorrangigen Aufgaben.“"
                            },
                            {
                                "example_id": "0a7cb313-817d-4fc9-91ec-b21de3151e1f",
                                "sense_id": "aa0a29ad-e621-311b-bb79-b9cd6f9aed52",
                                "text": "„Auch der Abfallreferent räumte ein: »Ja, die Biotonne stinkt, alles andere wäre ja weltfremd, aber jetzt landen Schnitzel, Kartoffel und Co. eben in der normalen Mülltonne.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
