                            }
                        ]
                    },
                    {
                        "translation_id": "74bf21af-29bb-4db5-8757-d50acbcaddc6",
                        "source_entry_id": "42b4d4e9-9667-30ec-b594-6fc1875cd862",
                        "source_sense_id": "0ca50d1a-ee14-3fae-bf14-a22773e23b5f",
