                        "examples": [
                            {
                                "example_id": "85f463dd-0b61-4a2e-942a-17653fc9401a",
                                "sense_id": "fbbc4df4-ec6b-392a-aca9-34fc4510a207",
                                "text": "Een hondengeleider van de politie liet het dier in zijn vrije tijd uit. De hond gaf op een gegeven moment een harde ruk aan de lijn, waardoor een haakje brak en hij ervandoor ging."
                            },
                            {
                                "example_id": "01abdd69-c1d1-4fdd-b61c-9e1aab44d308",
                                "sense_id": "fbbc4df4-ec6b-392a-aca9-34fc4510a207",
                                "text": "Een hondengeleider heeft de twee honden en drie andere honden die losliepen bij het huis in beslag genomen. De brandweer heeft het varken uit de sloot gehaald en hem schoongemaakt. Zijn oor was aangevreten, verder bleken de verwondingen mee te vallen. Hij is voor verzorging ergens anders ondergebracht."
                            }
                        ]
                    }
