                "senses": [
                    {
                        "sense_id": "1ad3b12b-8952-3aca-bd12-46b847e6624a",
                        "entry_id": "9093a0be-23f3-32f1-bb91-cf1831270573",
                        "glosses": [
                            "Ensemble de l’expérience sensible, considérée comme fondement ou limite de la connaissance humaine ; domaine de ce qui est donné par l’expérience, par opposition à l’a priori ou au transcendantal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b3e523-9651-45c1-b9e4-3b65b4184cf8",
                                "sense_id": "1ad3b12b-8952-3aca-bd12-46b847e6624a",
                                "text": "Nous sommes guidés par la distinction habituelle, entre les sciences descriptives, qui sur le fond de l’expérience, décrivent et classent l’existence factuelle et projettent des généralités inductives à l’intérieur de l’empirie intuitive en vue d’établir cette existence pour tout homme qui se tient dans la même empirie."
                            },
                            {
                                "example_id": "02561756-2600-49b5-ab07-430e3715f4bb",
                                "sense_id": "1ad3b12b-8952-3aca-bd12-46b847e6624a",
                                "text": "Kant, comme on sait, a vigoureusement contesté cet éloge de l’empirie au détriment de la théorie. Non sans raison, il l’a jugé obscurantiste."
                            }
                        ]
                    }
