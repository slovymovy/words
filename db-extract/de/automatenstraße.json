                        "glosses": [
                            "hintereinanderliegende ((teil-)automatisierte) Fertigungsplätze, durch die ein Produkt auf dem Weg zu seiner Fertigstellung hindurchwandert"
                        ],
                        "tags": [],
                        "examples": [
