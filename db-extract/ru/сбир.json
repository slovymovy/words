                                                "sense_id": "4975762e-fd38-3525-b27a-ca84f9971f94",
                                                "text": "Quello sbirro a tiro con l'arco è un portento."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "625858b8-993f-3f2f-a6b0-07b35811fb66",
                                        "entry_id": "2a1b8cc7-4df4-37e6-ae33-1a11abff9703",
