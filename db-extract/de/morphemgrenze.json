                "senses": [
                    {
                        "sense_id": "51721803-c5b6-3d93-9c62-6b2418d71a3b",
                        "entry_id": "11e6acee-fb56-3de1-b1c3-b1c21c745739",
                        "glosses": [
                            "Anfang und/oder Ende eines Morphems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf9ad9a-4b9f-48ce-b4f8-27de67c54c1f",
                                "sense_id": "51721803-c5b6-3d93-9c62-6b2418d71a3b",
                                "text": "„In morphologisch komplexen Wörtern können Silbengrenzen von Morphemgrenzen abhängen: gelb-lich [ɡɛlp.lɪç] (Im Süden des deutschen Sprachraums aber meist [ɡɛl.blɪç].“"
                            },
                            {
                                "example_id": "3cbeafa5-9096-44e1-8aa6-d9d88fc3da3d",
                                "sense_id": "51721803-c5b6-3d93-9c62-6b2418d71a3b",
                                "text": "„Es zeigt sich jedoch eine starke Abhängigkeit vom jeweiligen Digraphem, z.B. hat die Kombination ‹o—t› bei den kombinierten Silben- und Morphemgrenzen zwar eine relativ geringe mittlere Dauer, aber eine sehr hohe Anzahl von Luftsprüngen.“"
                            },
                            {
                                "example_id": "95e25c3c-b541-4af5-82cf-0b873b79f862",
                                "sense_id": "51721803-c5b6-3d93-9c62-6b2418d71a3b",
                                "text": "„Die Anzahl der möglichen Buchstaben wird dabei immer weiter abnehmen, bis man auf die Morphemgrenze stößt, wo sie dann sprunghaft ansteigt.“"
                            },
                            {
                                "example_id": "dd37d806-224a-4201-9740-d9ec1dff5dce",
                                "sense_id": "51721803-c5b6-3d93-9c62-6b2418d71a3b",
                                "text": "„Der phonologische Prozess versucht zu vermeiden, dass (an der Morphemgrenze) zwei Vokale aufeinandertreffen.“"
                            },
                            {
                                "example_id": "1f30f71e-12a1-427e-a471-cdd75f45d518",
                                "sense_id": "51721803-c5b6-3d93-9c62-6b2418d71a3b",
                                "text": "„Der Bindestrich ist das allgemeinste Symbol für die Morphemgrenze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
