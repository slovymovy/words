                "senses": [
                    {
                        "sense_id": "62a057a5-5804-32e7-a4e7-a93958c87b99",
                        "entry_id": "836e5967-a568-31cb-bc12-e87d31034e13",
                        "glosses": [
                            "iets wat gedrukt is met behulp van een printer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969b41da-ab2a-4d4b-a8ac-d34e7f50f2fa",
                                "sense_id": "62a057a5-5804-32e7-a4e7-a93958c87b99",
                                "text": "Repro Twente aan de Dorpsmatenstraat in Hengelo bestond vier jaar en was gespecialiseerd in kopieer- en (digitaal) printwerk. Curator is mr. Van Wijk."
                            },
                            {
                                "example_id": "2eef2bb2-b7ea-44d2-9083-b5ad818ede00",
                                "sense_id": "62a057a5-5804-32e7-a4e7-a93958c87b99",
                                "text": "De Almelose ondernemingen Lulof Druktechniek en Dutchmail zetten samen een nieuw grafisch bedrijf in de markt: Next. De nieuwkomer is specialist in het verzorgen van druk- en printwerk, mailingen en grafische afwerking. Het twee jaar oude Dutchmail gaat helemaal op in het nieuwe Next, Lulof brengt wat kleine bedrijfsonderdelen onder in de nieuwe zaak."
                            },
                            {
                                "example_id": "4b5672f6-0faa-4e85-98f6-0b04f42774c2",
                                "sense_id": "62a057a5-5804-32e7-a4e7-a93958c87b99",
                                "text": "Een kunstmarktplaats, noemt Dirk van Beest zijn Atelier Céramique in het historische centrum van Barendrecht. Hij verkoopt er lijsten, exclusieve verlichting, lampenkappen, printwerk, glaskunst, etsen, schilderijen. En sinds kort heeft hij een expositieruimte op de verbouwde bovenverdieping. „Alleen voor kunstenaars die goede kwaliteit leveren.”"
                            }
                        ]
                    }
