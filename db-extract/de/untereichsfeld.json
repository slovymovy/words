                ],
                "senses": [
                    {
                        "sense_id": "135eae2c-5c3e-3f37-b196-f11a4f329cef",
                        "entry_id": "c8baa72c-4570-3642-bc26-958873d442a3",
                        "glosses": [
                            "Teil des Eichsfeldes, der im niederdeutschen Sprachgebiet und großenteils in Südostniedersachsen liegt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "a63834bf-7987-4f23-aa1c-13da68299621",
                                "sense_id": "135eae2c-5c3e-3f37-b196-f11a4f329cef",
                                "text": "„Dem kleinen Untereichsfeld droht in einem neuen südniedersächsischen Großkreis die Bedeutungslosigkeit.“"
                            },
                            {
                                "example_id": "992f06d6-d054-4171-bd74-430f09a7c004",
                                "sense_id": "135eae2c-5c3e-3f37-b196-f11a4f329cef",
                                "text": "„Besondere Beachtung wird wohl die historisch-archäologische Karte des Untereichsfeldes im Maßstab 1:50000 finden, die es in dieser Form als Gesamtkarte bisher nicht gab.“"
                            },
                            {
                                "example_id": "d2c1e861-d24b-489c-9772-014f7b220303",
                                "sense_id": "135eae2c-5c3e-3f37-b196-f11a4f329cef",
                                "text": "„Das Untereichsfeld ist Teil des niedersächsischen Landkreises Göttingen, das Obereichsfeld liegt im thüringischen Landkreis Eichsfeld.“"
                            },
                            {
                                "example_id": "d3586975-0099-432e-89ea-00c452f4f2ab",
                                "sense_id": "135eae2c-5c3e-3f37-b196-f11a4f329cef",
                                "text": "„Allgemein gliedert man dieses gesamte Gebiet in zwei Teile auf, und zwar in das Ober- und Untereichsfeld, wobei aber über den Verlauf einer genauen Grenzlinie zwischen beiden Teilen keineswegs Einigkeit besteht.“"
                            },
                            {
                                "example_id": "8e7bbe78-66ad-4003-9fdd-8188ab4fd427",
                                "sense_id": "135eae2c-5c3e-3f37-b196-f11a4f329cef",
                                "text": "„Später wurde es um ein nördlich in den Niederungen gelegenes Gebiet der Sachsen, das Untereichsfeld, erweitert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
