                "senses": [
                    {
                        "sense_id": "2b4e5ba1-b2d4-3c14-b369-8c29ce7bccb8",
                        "entry_id": "e6140d48-6fc7-3a66-aa97-58db2d8fc811",
                        "glosses": [
                            "godzina nadliczbowa, spędzona w pracy poza obowiązującym wymiarem"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "e2f5cb10-76af-4746-aa49-613803f8b5e8",
                                "sense_id": "2b4e5ba1-b2d4-3c14-b369-8c29ce7bccb8",
                                "text": "Marta późno wraca z pracy, bo ma sporo nadgodzin."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5738120d-7aff-42c2-9f0c-936756d2fb36",
                        "source_entry_id": "e6140d48-6fc7-3a66-aa97-58db2d8fc811",
                        "source_sense_id": "2b4e5ba1-b2d4-3c14-b369-8c29ce7bccb8",
                        "target_lang_word": "overtime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overtime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bd831d0-4135-37ee-81c3-f40ea1081918",
                                        "entry_id": "417ce82d-4c7d-37ac-a64c-37c134b04e80",
                                        "glosses": [
                                            "Working time outside of one's regular hours."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5083f1b-caed-4b4d-9fe9-87458fc911fc",
                                                "sense_id": "5bd831d0-4135-37ee-81c3-f40ea1081918",
                                                "text": "Workers are usually paid extra for working overtime."
                                            },
                                            {
                                                "example_id": "443c7d24-328c-4efb-a33a-ced70193fbd8",
                                                "sense_id": "5bd831d0-4135-37ee-81c3-f40ea1081918",
                                                "text": "Nor is it good for the name of the railway industry that skilled men should have to put in so much overtime to keep up financially with the Joneses in other walks of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbddf8dc-a1b4-3c2a-a86b-62458a211ae6",
                                        "entry_id": "417ce82d-4c7d-37ac-a64c-37c134b04e80",
                                        "glosses": [
                                            "The rate of pay, usually higher, for work done outside of or in addition to regular hours."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f8516f3-4ccf-3968-95e8-dcab8e98022b",
                                        "entry_id": "417ce82d-4c7d-37ac-a64c-37c134b04e80",
                                        "glosses": [
                                            "An extra period of play when a contest has a tie score at the end of regulation."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ba7866-018f-4913-bc71-8648c03b3973",
                                                "sense_id": "2f8516f3-4ccf-3968-95e8-dcab8e98022b",
                                                "text": "That last-second shot ties the game 99-99 and sends it to overtime!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e65efbd-1488-3172-af60-3b8e3f49108f",
                                        "entry_id": "417ce82d-4c7d-37ac-a64c-37c134b04e80",
                                        "glosses": [
                                            "A period of time longer than scheduled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aef136e-4f95-4ffd-8fa2-e4c04002626c",
                                                "sense_id": "4e65efbd-1488-3172-af60-3b8e3f49108f",
                                                "text": "Little need be said about the remainder of the run; the Dumfries-Annan and Annan-Carlisle times are very sharp with such loads, and the driver was just observing them, with nothing in hand, though overtime at stations made us late into Carlisle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overtime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eba3b295-0173-3dcf-ac49-81d939746fe4",
                                        "entry_id": "33ea42c3-245a-3b95-9e3f-7cf59fa71a3a",
                                        "glosses": [
                                            "Exceeding regular working hours."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fd2274c-e9f7-3fc2-94d8-df5a3812973f",
                                        "entry_id": "33ea42c3-245a-3b95-9e3f-7cf59fa71a3a",
                                        "glosses": [
                                            "Beyond the normal or usual extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7b27dc-2f85-4b2f-983d-854b347d34e7",
                                                "sense_id": "6fd2274c-e9f7-3fc2-94d8-df5a3812973f",
                                                "text": "He worked his mighty money-spinner overtime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overtime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d073b0-0d91-33a1-8f6c-6ed2915427c9",
                                        "entry_id": "ec8b32f7-3ad4-36c4-abcd-d39c89f509d1",
                                        "glosses": [
                                            "To measure something incorrectly, as taking more time than it actually did."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d75796f-7ece-4dc1-a32b-4e00b51c8259",
                                                "sense_id": "e4d073b0-0d91-33a1-8f6c-6ed2915427c9",
                                                "text": "With automatic timing, overtiming is virtually impossible. However, there are inherent inaccuracies in manual timing of telephone messages which, on the average, tend toward overtiming messages […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overtime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d00d579b-9f76-3a4d-b24f-c7fdeb28f8d9",
                                        "entry_id": "f28d88e4-e9a0-3576-9ea8-529002dbab90",
                                        "glosses": [
                                            "Misspelling of over time."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "837b8faf-e80c-45dc-b870-d12582db3ad2",
                        "source_entry_id": "e6140d48-6fc7-3a66-aa97-58db2d8fc811",
                        "source_sense_id": "2b4e5ba1-b2d4-3c14-b369-8c29ce7bccb8",
                        "target_lang_word": "overhour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "de50edd4-b812-4ba2-bf60-05320175e97c",
                        "source_entry_id": "e6140d48-6fc7-3a66-aa97-58db2d8fc811",
                        "source_sense_id": "2b4e5ba1-b2d4-3c14-b369-8c29ce7bccb8",
                        "target_lang_word": "Überstunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überstunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                        "entry_id": "5dec7f57-1a95-31d8-8ce3-681f4032072b",
                                        "glosses": [
                                            "Arbeitszeit, die über die im Arbeitsvertrag festgelegte Zeit hinausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d67360-7e56-4e72-955f-03c472424f75",
                                                "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                                "text": "„Tredup macht viele Überstunden.“"
                                            },
                                            {
                                                "example_id": "181cf3a9-ce0c-4de2-8451-d93697b669c3",
                                                "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                                "text": "„Er könnte im Grunde so viel arbeiten, wie er wollte, von jetzt an würden alle Überstunden wie die Tagesschicht bezahlt.“"
                                            },
                                            {
                                                "example_id": "84aa0649-a6bc-4023-8d1c-1ed4fb52a001",
                                                "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                                "text": "„Oliver nutzt jede Überstunde und den Resturlaub und kommt so oft wie möglich nach Wien.“"
                                            },
                                            {
                                                "example_id": "370d5b45-cc47-4710-954d-fd12c31c6458",
                                                "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                                "text": "Nur die Bezahlung war früher schlecht: \"Wir haben bei den Stadtwerken viel weniger verdient als Handwerker in anderen Betrieben. Viele Kollegen haben Überstunden gekloppt, um etwas mehr zu verdienen.\""
                                            },
                                            {
                                                "example_id": "3d0e250e-9e7e-44c9-a940-889626e5f5e4",
                                                "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                                "text": "Früher haben Assistenzärzte Überstunden und Nachtdienste akzeptiert."
                                            },
                                            {
                                                "example_id": "070aef34-d1cf-482c-8624-74d2f3a513fd",
                                                "sense_id": "7301b321-20b0-3594-9fbb-2e8b73f58228",
                                                "text": "„Grundsätzlich sind Überstunden Überschreitungen der durch einen Arbeitsvertrag, einen Tarifvertrag oder eine Betriebsvereinbarung festgelegten regelmäßigen Arbeitszeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
