{
    "word_family": [
        "уклон",
        "уклонение",
        "отклонение",
        "отклоняться",
        "наклонение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d97a9e4-f0a2-36ea-8100-934d68529782",
                    "sense_definition": "Стараться избежать чего-либо, не выполнять обязательства или ответственность.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие пытаются <w>уклоняться</w> от уплаты налогов.",
                            "target_lang_translations": {
                                "de": "Viele versuchen, sich der Steuerzahlung zu <w>entziehen</w>."
                            }
                        },
                        {
                            "text": "Он всегда старается <w>уклоняться</w> от прямого ответа на вопрос.",
                            "target_lang_translations": {
                                "de": "Er versucht immer, einer direkten Antwort auf die Frage zu <w>ausweichen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "избегать",
                        "увиливать"
                    ],
                    "common_phrases": [
                        "уклоняться от ответа",
                        "уклоняться от службы"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich bemühen, etwas zu vermeiden oder Verpflichtungen nicht nachzukommen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich entziehen",
                                "target_lang_sense_clarification": "sich einer Pflicht oder Verantwortung entziehen"
                            },
                            {
                                "target_lang_word": "ausweichen",
                                "target_lang_sense_clarification": "einer unangenehmen Situation oder Frage ausweichen"
                            },
                            {
                                "target_lang_word": "sich drücken",
                                "target_lang_sense_clarification": "umgangssprachlich für sich vor einer Arbeit oder Pflicht drücken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "740b811c-d8ba-39c4-a81b-3edc83a5541c",
                    "sense_definition": "Менять направление движения, сходить с прямого пути.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Судно начало <w>уклоняться</w> от заданного курса из-за сильного ветра.",
                            "target_lang_translations": {
                                "de": "Das Schiff begann, wegen des starken Windes vom vorgegebenen Kurs <w>abzuweichen</w>."
                            }
                        },
                        {
                            "text": "Водитель был вынужден <w>уклоняться</w> от столкновения с препятствием на дороге.",
                            "target_lang_translations": {
                                "de": "Der Fahrer war gezwungen, einem Hindernis auf der Straße <w>auszuweichen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "отклоняться",
                        "сворачивать"
                    ],
                    "antonyms": [
                        "придерживаться"
                    ],
                    "common_phrases": [
                        "уклоняться от курса"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Bewegungsrichtung ändern oder vom direkten Weg abweichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abweichen",
                                "target_lang_sense_clarification": "von einem Kurs oder einer Linie abweichen"
                            },
                            {
                                "target_lang_word": "ausweichen",
                                "target_lang_sense_clarification": "einem Hindernis ausweichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36f4bcdb-6162-3baf-be94-094e8a5d8656",
                    "sense_definition": "Переставать следовать основной теме разговора или мысли.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Оратор начал <w>уклоняться</w> от темы своего выступления.",
                            "target_lang_translations": {
                                "de": "Der Redner begann, vom Thema seines Vortrags <w>abzuweichen</w>."
                            }
                        },
                        {
                            "text": "Не стоит <w>уклоняться</w> от сути обсуждаемого вопроса.",
                            "target_lang_translations": {
                                "de": "Man sollte nicht vom Kern der diskutierten Frage <w>abschweifen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "отвлекаться"
                    ],
                    "common_phrases": [
                        "уклоняться от темы"
                    ],
                    "target_lang_definitions": {
                        "de": "Aufhören, dem Hauptthema eines Gesprächs oder Gedankengangs zu folgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vom Thema abweichen",
                                "target_lang_sense_clarification": "den roten Faden verlieren oder das Thema wechseln"
                            },
                            {
                                "target_lang_word": "abschweifen",
                                "target_lang_sense_clarification": "gedanklich oder in der Rede vom Thema abkommen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18771ea5-f856-32d7-8f76-f764e6a4e0e1",
                    "sense_definition": "Физически отодвигаться или отстраняться в сторону, чтобы избежать удара или контакта.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Боксер успел <w>уклоняться</w> от резкого удара противника.",
                            "target_lang_translations": {
                                "de": "Der Boxer konnte dem schnellen Schlag des Gegners rechtzeitig <w>ausweichen</w>."
                            }
                        },
                        {
                            "text": "Ему пришлось <w>уклоняться</w> от летящего в него мяча.",
                            "target_lang_translations": {
                                "de": "Er musste dem auf ihn zufliegenden Ball <w>ausweichen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "уворачиваться",
                        "отстраняться"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich körperlich zur Seite bewegen, um einem Schlag oder Kontakt zu entgehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ausweichen",
                                "target_lang_sense_clarification": "einem Schlag oder Objekt durch eine Bewegung ausweichen"
                            },
                            {
                                "target_lang_word": "sich ducken",
                                "target_lang_sense_clarification": "sich schnell nach unten bewegen, um einem Treffer zu entgehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}