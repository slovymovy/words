                    {
                        "translation_id": "e9c3d277-66ed-48be-b936-b0ddac67a613",
                        "source_entry_id": "220243c4-8fe1-3ad8-8381-e8ac07f67392",
                        "source_sense_id": "327a7740-3b8f-340d-8cb0-b24ceb4ec3e7",
                        "target_lang_word": "Linux",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linux",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "99b092ec-c464-3b3f-8577-e4fa3ed92d64",
                                        "entry_id": "a47e0d62-cf21-3c93-aec3-a2c0dcf4f6c7",
                                        "glosses": [
                                            "jádro pro některé operační systémy unixového charakteru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0527d3ca-eb07-4955-be86-2e5b5c9e2d21",
                                                "sense_id": "99b092ec-c464-3b3f-8577-e4fa3ed92d64",
                                                "text": "Linux je základem několika operačních systémů, například GNU/Linux nebo Android."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d0d464-e47b-3087-b19a-3d68b261381e",
                                        "entry_id": "a47e0d62-cf21-3c93-aec3-a2c0dcf4f6c7",
                                        "glosses": [
                                            "první z několika druhů operačního systému unixového charakteru založeného na tomto jádře\\n* Příklad: Linuxy mi teď běží rychleji než Windowsy, ale ještě si na ně zvykám."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce216f72-d411-4f90-b362-a1ca3f03aa01",
                                                "sense_id": "15d0d464-e47b-3087-b19a-3d68b261381e",
                                                "text": "GNU/Linux se také zkracuje na pouhé Linux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "242b5f54-9b77-3a09-8108-7bef3d3510a4",
                                        "entry_id": "a47e0d62-cf21-3c93-aec3-a2c0dcf4f6c7",
                                        "glosses": [
                                            "jeden z mnoha jednotlivých distribucí tohoto druhu operačního systému"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59de76e8-3e1d-4336-be64-deb15ccaaf30",
                                                "sense_id": "242b5f54-9b77-3a09-8108-7bef3d3510a4",
                                                "text": "Který máš raději Linux – Ubuntu nebo Mandrivu?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0065966d-1c8f-44bb-a8f6-51c08d9617fd",
                        "source_entry_id": "220243c4-8fe1-3ad8-8381-e8ac07f67392",
                        "source_sense_id": "327a7740-3b8f-340d-8cb0-b24ceb4ec3e7",
                        "target_lang_word": "Linux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32572b57-20d8-348d-b100-b362809598c9",
                                        "entry_id": "50e1fb20-cf09-390d-b5cd-d92eeb5d5bfa",
                                        "glosses": [
                                            "Noyau de système d’exploitation développé sous licence GPL et adoptant une architecture de type UNIX."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad5c2f7-6d4b-4819-8043-87158523348e",
                                                "sense_id": "32572b57-20d8-348d-b100-b362809598c9",
                                                "text": "Né en 1991, Linux est un noyau de système d'exploitation (en anglais kernel) permettant de gérer l'exécution d'application que ce soit sur un terminal ou un serveur. Il se charge également de piloter l'ensemble des processus matériels associés, informatiques et réseau. Linux est disponible en open source sous licence GNU, pour GNU GPL (voir le site officiel du noyau Linux : kernel.org)."
                                            },
                                            {
                                                "example_id": "8ac737ed-dd02-457a-93c6-2055d1e38351",
                                                "sense_id": "32572b57-20d8-348d-b100-b362809598c9",
                                                "text": "Le noyau Linux est central pour le système d'exploitation de l'ordinateur Linux. Le noyau est l'interface de base entre le hardware d'un ordinateur et ses processus. Elle s'assure de la disponibilité de la mémoire pour les applications Linux à exécuter, optimise les processeurs et en retrouve la configuration système requise entre les applications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b8cfb7-534e-391c-ad48-b8953734a38c",
                                        "entry_id": "50e1fb20-cf09-390d-b5cd-d92eeb5d5bfa",
                                        "glosses": [
                                            "Système d’exploitation basé sur ce noyau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6abc16f6-14c5-409c-a397-03275823c1ba",
                                                "sense_id": "d2b8cfb7-534e-391c-ad48-b8953734a38c",
                                                "text": "Lorsque l’on commence à travailler sur un système de type Unix (Unix, AIX, HP-UX, Solaris, Linux…), les premières expressions régulières que l’on découvre sont généralement celles de l’interpréteur de commande, ou shell."
                                            },
                                            {
                                                "example_id": "14339f25-59f0-4451-9a20-513b7fa452f1",
                                                "sense_id": "d2b8cfb7-534e-391c-ad48-b8953734a38c",
                                                "text": "Pour les autres Linux, on installera la version contenue dans les paquets standards."
                                            },
                                            {
                                                "example_id": "de7a6c25-bc1f-4b9f-b54f-7cd777850ad3",
                                                "sense_id": "d2b8cfb7-534e-391c-ad48-b8953734a38c",
                                                "text": "Déjà, il n’existe pas une seule distribution Linux, mais plusieurs dizaines utilisant le même noyau. Tant mieux diront certains. Mais parmi ces dizaines de distributions Linux, il existe aussi plusieurs déclinaisons, adaptées à différents usages, et différentes configurations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a61625a-9317-4744-b296-6d012271869e",
                        "source_entry_id": "220243c4-8fe1-3ad8-8381-e8ac07f67392",
                        "source_sense_id": "327a7740-3b8f-340d-8cb0-b24ceb4ec3e7",
                        "target_lang_word": "Linux",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linux",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b79fe538-d31e-33b0-abe1-854323c5afc1",
                                        "entry_id": "8908da3d-45a6-3453-9fd2-98d7bed53169",
                                        "glosses": [
                                            "verzameling opensource programma's die samen het hart van het besturingssysteem voor een computer vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a65c8a-4e89-4ba7-b96f-a35811859537",
                                                "sense_id": "b79fe538-d31e-33b0-abe1-854323c5afc1",
                                                "text": "Android is het mobiele besturingssysteem van Google en is gedeeltelijke gebaseerd op Linux. Veel fabrikanten van de toestellen van Android hebben licenties voor het gebruik van delen van de code van Linux. Volgens de GPLv2-licentie waaronder Linux geschreven is, moet de code altijd openbaar zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce1c7bd-4fe9-3e2e-9953-4789571c1c26",
                                        "entry_id": "8908da3d-45a6-3453-9fd2-98d7bed53169",
                                        "glosses": [
                                            "opensource besturingssysteem voor computers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216274d6-bb13-42b0-ba4d-593c4863fbbd",
                                                "sense_id": "0ce1c7bd-4fe9-3e2e-9953-4789571c1c26",
                                                "text": "Een Canadese ontwikkelaar werkt aan een goedkope tablet die niet op Android, Windows, iOS of Palm OS werkt, maar op Linux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf69608d-ca99-46be-841a-35e92f03df83",
                        "source_entry_id": "220243c4-8fe1-3ad8-8381-e8ac07f67392",
                        "source_sense_id": "327a7740-3b8f-340d-8cb0-b24ceb4ec3e7",
                        "target_lang_word": "Linux",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linux",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d15a0ba6-bad6-3df1-8820-42fe802be77a",
                                        "entry_id": "865bf672-dfa3-35f1-a5f9-4b1377e527b9",
                                        "glosses": [
                                            "der Name eines freien Betriebssystemkernels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caa8c639-8dee-41f3-b94a-c1aef536a6af",
                                                "sense_id": "d15a0ba6-bad6-3df1-8820-42fe802be77a",
                                                "text": "Das Debian-System baut auf einem Linux(-Kernel) auf."
                                            },
                                            {
                                                "example_id": "0f07e23d-950c-4e5f-8ee4-f3d0bebabcba",
                                                "sense_id": "d15a0ba6-bad6-3df1-8820-42fe802be77a",
                                                "text": "„Nutzer von Chrome und dessen freiem Pendant Chromium werden künftig Schwierigkeiten haben, den Browser auf älteren Linux-Versionen zu nutzen. Denn die Google-Entwickler planen, künftig eine Sicherheitsfunktion des Linux-Kernels zu nutzen, die erst seit Kurzem zur Verfügung steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f6c7e32-ccd8-3900-b59e-23b48008debe",
                                        "entry_id": "865bf672-dfa3-35f1-a5f9-4b1377e527b9",
                                        "glosses": [
                                            "ein auf dem Linux-Kernel aufbauendes Betriebssystem"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ab97fa-e016-46ad-9bfa-7851fea0b972",
                                                "sense_id": "7f6c7e32-ccd8-3900-b59e-23b48008debe",
