                "senses": [
                    {
                        "sense_id": "828d8d37-4da7-3827-8bc8-672d890b658e",
                        "entry_id": "039d22ea-e708-3ccf-84f8-23dc81ca9abb",
                        "glosses": [
                            "das Kipplüften; Luftaustausch für einen Raum durch ein gekipptes Fenster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b2da4c-ad2a-4558-8171-f7bc068fee62",
                                "sense_id": "828d8d37-4da7-3827-8bc8-672d890b658e",
                                "text": "„Schlafzimmer sind traditionell Orte der Kipplüftung.“"
                            },
                            {
                                "example_id": "1aa41249-3be9-4239-87ab-c950347da8c0",
                                "sense_id": "828d8d37-4da7-3827-8bc8-672d890b658e",
                                "text": "„Vermeiden Sie die so genannte Kipplüftung, bei der das Fenster über längere Zeit gekippt bleibt.“"
                            },
                            {
                                "example_id": "66ba0a06-ba84-4b55-a3c2-51774a458903",
                                "sense_id": "828d8d37-4da7-3827-8bc8-672d890b658e",
                                "text": "„Es wird bei der dauerhaften Kipplüftung viel Wärmeenergie vernichtet“"
                            },
                            {
                                "example_id": "3eb86e2f-a666-4d92-a4cf-86272b7bea78",
                                "sense_id": "828d8d37-4da7-3827-8bc8-672d890b658e",
                                "text": "„Bei der Kipplüftung wird die meiste Zeit für einen kompletten Luftaustausch benötigt, das heißt, hier geht die meiste Wärme verloren.“"
                            },
                            {
                                "example_id": "c0b5b314-48f8-4a98-bf2a-58628c31a3ed",
                                "sense_id": "828d8d37-4da7-3827-8bc8-672d890b658e",
                                "text": "„Neben der Gefahr der Schimmelbildung an dem Fenstersturz oberhalb des Fensters wird durch die Kipplüftung kein vernünftiger Luftaustausch erzielt, aber sehr viel Energie verschwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
