                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wagon",
                                "target_lang_sense_clarification": "a heavy four-wheeled vehicle for goods, often horse-drawn"
                            },
                            {
                                "target_lang_word": "cart",
                                "target_lang_sense_clarification": "a smaller, often two-wheeled vehicle for carrying goods"
                            },
                            {
                                "target_lang_word": "carriage",
                                "target_lang_sense_clarification": "a horse-drawn vehicle primarily for transporting people"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "повозка",
                                "target_lang_sense_clarification": "общее название для гужевого транспорта"
                            },
                            {
                                "target_lang_word": "телега",
                                "target_lang_sense_clarification": "простая четырехколесная грузовая повозка"
