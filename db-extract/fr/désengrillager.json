                        "glosses": [
                            "Débarrasser des grillages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "920aa37a-0ce0-4f80-9351-494938a21d10",
                                "sense_id": "fc0970ea-117e-33fd-96c1-6875506c3071",
                                "text": "Je rêve de m’acheter un territoire, de le désengrillager, d’y mettre une volière anglaise et de parvenir à recréer un biotope de compétition."
                            },
                            {
                                "example_id": "23d2a736-4768-47f7-b4b1-7811f084193a",
                                "sense_id": "fc0970ea-117e-33fd-96c1-6875506c3071",
                                "text": "Une nouvelle surface fraîchement régénérée et désengrillagée vient s’ajouter aux surfaces riches en nourriture, déjà accessibles aux cervidés."
                            },
                            {
                                "example_id": "611e2eca-6f92-4db2-ba0a-f02baa8a03dc",
                                "sense_id": "fc0970ea-117e-33fd-96c1-6875506c3071",
                                "text": "D’autre part, au-delà de l’interdiction de futures clôtures, il convient d’inciter les propriétaires des clôtures déjà existantes à se désengrillager volontairement si des réponses fortes garantissant le droit de propriété sont mises en œuvre."
                            }
                        ]
                    }
