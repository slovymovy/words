                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The scholar provided a detailed commentary on the sura known as the <w>Proof</w>.",
                            "target_lang_translations": {
                                "ru": "Ученый представил подробный комментарий к суре, известной как «<w>Ясное знамение</w>»."
                            }
                        },
                        {
                            "text": "In Islamic tradition the <w>Proof</w> emphasizes the clarity of divine evidence.",
                            "target_lang_translations": {
                                "ru": "В исламской традиции сура «<w>Доказательство</w>» подчеркивает ясность божественных свидетельств."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "98-я сура (глава) Корана."
                    },
                    "translations": {
