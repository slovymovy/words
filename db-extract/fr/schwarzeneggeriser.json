                "senses": [
                    {
                        "sense_id": "357c11dc-d128-392c-b874-6e09281967a2",
                        "entry_id": "f8ffa120-989d-32dd-aa75-a8ecb71f5f22",
                        "glosses": [
                            "Muscler à l’extrême, bodybuilder."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4231204d-dc1a-4a6b-a9a0-9e4f88b83e40",
                                "sense_id": "357c11dc-d128-392c-b874-6e09281967a2",
                                "text": "On pourrait dire que vous mettez en valeur le corps de Schwarzy et que vous cherchez à Schwarzeneggeriser vos acteurs"
                            },
                            {
                                "example_id": "8e1f4f54-d79e-42fd-8fcc-c6095e1e6b1a",
                                "sense_id": "357c11dc-d128-392c-b874-6e09281967a2",
                                "text": "Parfait dans \" Fred \", en prolo grassouillet, il a du mal à schwarzeneggeriser du jour au lendemain."
                            },
                            {
                                "example_id": "1cd2efe9-8fd0-40a7-adc7-f708a1ac872e",
                                "sense_id": "357c11dc-d128-392c-b874-6e09281967a2",
                                "text": "sinon tu peux pas le Schwarzeneggeriser car je te rappelle que depuis qu'il est gouverneur, il ne fait plus que de la politique et (...)"
                            },
                            {
                                "example_id": "b49fe808-6bb5-4809-a50c-06feafb4cd6d",
                                "sense_id": "357c11dc-d128-392c-b874-6e09281967a2",
                                "text": "Plaisir des yeux, car l'homme est musclé et joli, mais non encore schwarzeneggerisé ou stallonisé."
                            },
                            {
                                "example_id": "b124ea48-1d6c-4f93-a50c-80d615b0ca3a",
                                "sense_id": "357c11dc-d128-392c-b874-6e09281967a2",
                                "text": "Jason Statham reprend son rôle de James \"Bruce Lee\" Bond schwarzeneggerisé et le rend bien."
                            }
                        ]
                    }
