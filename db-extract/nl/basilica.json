                "senses": [
                    {
                        "sense_id": "cd6921e2-afa4-3928-907e-3b89bca48627",
                        "entry_id": "8d67c7bb-cdbe-313f-a4e5-0ae5aad1a99c",
                        "glosses": [
                            "eretitel toegekend aan kerkgebouwen die van bijzondere religieuze betekenis zijn"
                        ],
                        "tags": [
                            "rooms-katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "1f05a5d8-056b-4fc8-9687-85be77d7f4e0",
                                "sense_id": "cd6921e2-afa4-3928-907e-3b89bca48627",
                                "text": "In de Katholieke Kerk is de basiliek of basilica een eretitel voor bijzondere kerken."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd662757-e089-3045-b644-124cb06f7e06",
                        "entry_id": "8d67c7bb-cdbe-313f-a4e5-0ae5aad1a99c",
                        "glosses": [
                            "kerkgebouw met klassieke vorm, waarbij een hoger schip (middendeel) links en rechts door zuilenrijen is gescheiden van zijbeuken en een halfronde uitbouw aan de korte kant die traditioneel naar het oosten is gericht\\nVaak worden aan deze basisvorm een transept en een toren toegevoegd."
                        ],
                        "tags": [
                            "christelijk"
                        ],
                        "examples": [
                            {
                                "example_id": "6ed0df45-5aea-4371-935d-c6c2a6d20080",
                                "sense_id": "fd662757-e089-3045-b644-124cb06f7e06",
                                "text": "Mahlers Auferstehungssymphonie onder leiding van Helmuth Rilling wordt gespeeld in de basilica van een klooster."
                            }
                        ]
                    },
                    {
                        "sense_id": "02e5d285-3434-3715-bbd0-29461e14f29f",
                        "entry_id": "8d67c7bb-cdbe-313f-a4e5-0ae5aad1a99c",
                        "glosses": [
                            "in de Romeinse tijd een gebouw voor handel en rechtspraak dat een rechthoekige vorm had met een middendeel dat links en rechts door zuilenrijen was gescheiden van de zijbeuken en dat vaak een halfronde uitbouw aan de korte kant had"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df5ee5b-ec50-43a2-b0dd-f428af713bd1",
                                "sense_id": "02e5d285-3434-3715-bbd0-29461e14f29f",
                                "text": "Van Vitruvius zelf weten wij weinig. Hij moet zijn geboren tussen 100 en 80 jaar voor Christus. Als architect is slechts één gebouw van hem bekend omdat het in zijn eigen, geschreven levenswerk figureert: een basilica in Colonia Julia Fanestris, het huidige Fano, een plaatsje aan de Adriatische kust tussen Ravenna en Ancona. Opgravingen hebben nooit een spoor opgeleverd van dit grote, openbare gebouw dat uit hout was opgetrokken."
                            }
                        ]
                    }
                ],
