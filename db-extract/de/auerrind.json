                "senses": [
                    {
                        "sense_id": "5e06774f-4d00-35cd-bed4-b1b32d1c1962",
                        "entry_id": "36452dd6-22da-3b48-a5d0-5981214a9f3b",
                        "glosses": [
                            "aurochs"
                        ],
                        "tags": [
                            "neuter",
                            "rare",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b21a43b1-d613-417f-b121-03345f872c43",
                                "sense_id": "5e06774f-4d00-35cd-bed4-b1b32d1c1962",
                                "text": "Oder wollen Sie ohne Selektion etwa das Auerrind bzw. den Urochsen mit einer tgl. Milchleistung von etwa 4,5l als Favoriten bezeichnen?",
                                "translation": "Or do you really want to call the aurochs/the aurox with a daily milk performance of 4,5l your favorite?",
                                "english": "Or do you really want to call the aurochs/the aurox with a daily milk performance of 4,5l your favorite?"
                            },
                            {
                                "example_id": "69750d4c-f96e-4113-b155-94dd24034fd8",
                                "sense_id": "5e06774f-4d00-35cd-bed4-b1b32d1c1962",
                                "text": "Laut Schrifttum war das Auerrind\nbescheiden, gottgefällig, bieder.\nEs glaubte fest ans Himmelskind\nund kaute hin und wieder wieder.",
                                "translation": "According to scripture the auroxen were\nhumble, godly, upright.\nThey strongly believed in the heavenly child\nand chewed again then and again.",
                                "english": "According to scripture the auroxen were\nhumble, godly, upright.\nThey strongly believed in the heavenly child\nand chewed again then and again."
                            },
                            {
                                "example_id": "77260953-d8bd-428f-93a6-1eeee85031ba",
                                "sense_id": "5e06774f-4d00-35cd-bed4-b1b32d1c1962",
                                "text": "Am Südrand der Alpen waren Elch, Wisent und Auerrind zu Ötzis Zeit aber schon ziemlich rar, wenn nicht gar schon ausgestorben.",
                                "translation": "On the southern edge of the alps, moose, wisent and auroxen were already rare in Ötzi's time, if not extinct yet.",
                                "english": "On the southern edge of the alps, moose, wisent and auroxen were already rare in Ötzi's time, if not extinct yet."
                            },
                            {
                                "example_id": "60764e65-2110-4b0b-a134-91fdb7900e03",
                                "sense_id": "5e06774f-4d00-35cd-bed4-b1b32d1c1962",
                                "text": "[...] kann mit Sicherheit auch für die Auer gelten, dass sie ein Ur, ein Auerrind, zu ihrem Wappentier gewählt hatten. Die Auer zur Aug-Radisch hatten offensichtlich den Namen vom Auerrind hergeleitet und nicht von der Au. Zur Zeit der Auer war das Auerrind in der Steiermark schon längst ausgestorben.",
                                "translation": "… it's safe to say that that's also true for the Auers, that they chose an owre, an aurochs as their charge. The Auers of Aug-Radisch obviously derived their name from the aurochs and not from the meadow (Au). In the Auers' time the aurochs was long extinct in Styria.",
                                "english": "… it's safe to say that that's also true for the Auers, that they chose an owre, an aurochs as their charge. The Auers of Aug-Radisch obviously derived their name from the aurochs and not from the meadow (Au). In the Auers' time the aurochs was long extinct in Styria."
                            }
                        ]
                    },
                    {
                        "sense_id": "b158a246-7817-35c4-bd8b-76fa5290350f",
                        "entry_id": "36452dd6-22da-3b48-a5d0-5981214a9f3b",
                        "glosses": [
                            "taurine cattle, Bos primigenius taurus"
