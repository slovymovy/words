                                "target_senses": [
                                    {
                                        "sense_id": "4d7d8990-11a4-3084-ada6-8e0075fee794",
                                        "entry_id": "50789811-50d7-316b-96d3-9a3dd6b2d984",
                                        "glosses": [
                                            "chinesisches Legespiel für vier Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
