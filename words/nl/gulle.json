                        {
                            "text": "Dat <w>gulle</w> gebaar van hem werd door iedereen gewaardeerd.",
                            "target_lang_translations": {
                                "zh": "他那<w>慷慨的</w>举动受到了所有人的赞赏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gulle aanbod",
                        "gulle gebaar"
