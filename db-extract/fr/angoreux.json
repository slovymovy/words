                        "glosses": [
                            "Personne sujette à des crises d’angor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f66f9ea-5d47-4221-ad81-212bd62b2756",
                                "sense_id": "732c30c7-31a8-3c39-9aa3-e6ec08363096",
                                "text": "L’angoreux doit s'attacher à éviter toutes les causes qui peuvent exagérer l’action du cœur, les fatigues, les veilles prolongées, les excès d’aliments ou de boissons, les représentations théâtrales dramatiques, les émotions vives."
                            },
                            {
                                "example_id": "eee3b5dc-f5b9-4e70-8e74-2fc030d31fd3",
                                "sense_id": "732c30c7-31a8-3c39-9aa3-e6ec08363096",
                                "text": "Dans sa thèse, Moussard-Risze note que chez 26 angoreux avec anémie dont il put faire l’autopsie, il y a 15 fois des altérations coronariennes ; mais 11 fois, le cœur et ses vaisseaux pouvaient être considérés comme normaux."
                            }
                        ]
                    }
