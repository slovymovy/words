                "senses": [
                    {
                        "sense_id": "da2e5ff8-28c2-3993-b19c-248b43aa2b87",
                        "entry_id": "242ab00a-3fb2-38cf-962e-c998ec873bf9",
                        "glosses": [
                            "To unload goods from an aircraft or ship."
                        ],
                        "tags": [
