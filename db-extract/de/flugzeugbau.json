                "senses": [
                    {
                        "sense_id": "8e2100d8-6c35-3038-8919-6fa3ff0777bb",
                        "entry_id": "2599b4ba-4cb1-35f0-8aa7-c579c7525226",
                        "glosses": [
                            "die Zusammensetzung von mehreren (Flugzeug-)Teilen zu einem Flugzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2316d1b1-97a1-4008-a708-59b0efa0ebef",
                                "sense_id": "8e2100d8-6c35-3038-8919-6fa3ff0777bb",
                                "text": "„Die Nutzung eines elektrischen Antriebs im Flugzeugbau bringt Vor- und Nachteile mit sich.“"
                            },
                            {
                                "example_id": "156875c7-1089-44d3-b7ee-91b1d414ac14",
                                "sense_id": "8e2100d8-6c35-3038-8919-6fa3ff0777bb",
                                "text": "„Nun, Platin, dieses edle Metall, fand in der Rüstungsindustrie Verwendung und war, insbesondere beim Flugzeugbau, unentbehrlich für die Herstellung von Unterbrechern und Magnetzündungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
