                "senses": [
                    {
                        "sense_id": "6c911b4b-df92-3bd9-abc0-e2b198cd5746",
                        "entry_id": "c99ba598-e96b-3cd9-a56f-7c1413aefba0",
                        "glosses": [
                            "de kunst om door chemische inwerking van licht op een gevoelige plaat afbeeldingen te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4006bbe7-5354-44e7-b94f-8d2f442757eb",
                                "sense_id": "6c911b4b-df92-3bd9-abc0-e2b198cd5746",
                                "text": "Fotografie is mijn grootste hobby."
                            }
                        ]
                    },
                    {
                        "sense_id": "48d9ba17-8de3-3831-817a-66db79d8cdd9",
                        "entry_id": "c99ba598-e96b-3cd9-a56f-7c1413aefba0",
                        "glosses": [
                            "de kunst om met behulp van een camera een afbeelding te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117838f9-0174-4e1e-98be-fab70be7ae36",
                                "sense_id": "48d9ba17-8de3-3831-817a-66db79d8cdd9",
                                "text": "Er ging een hele nieuwe wereld voor me open door opeens met woorden te moeten schilderen. Als art director in de reclame was ik altijd al visueel ingesteld, degene die verhalen vertelt op een beeldende manier, door middel van illustraties, fotografie of film."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dd66213-744c-40fe-b875-3d4347853f50",
                        "source_entry_id": "c99ba598-e96b-3cd9-a56f-7c1413aefba0",
                        "source_sense_id": "6c911b4b-df92-3bd9-abc0-e2b198cd5746",
                        "source_sense_description": "de kunst om door chemische inwerking van licht op een gevoelige plaat afbeeldingen te maken",
                        "target_lang_word": "Fotografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fc4b9a9-aaec-3311-a632-a530f4dce661",
                                        "entry_id": "8c8b8d85-a817-3bce-aaea-1dafb6688fb1",
                                        "glosses": [
                                            "technisches Verfahren, bei dem mit Hilfe von optischen Verfahren ein Bild (Fotografie, Lichtbild) auf ein lichtempfindliches Medium produziert und dort dauerhaft gespeichert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41f4adc-f207-4b99-ac79-02601196bec7",
                                                "sense_id": "9fc4b9a9-aaec-3311-a632-a530f4dce661",
                                                "text": "Die Schwarz-Weiß-Fotografie ist ein anspruchsvolles künstlerisches Genre."
                                            },
                                            {
                                                "example_id": "1c0cfa5f-95d1-4764-9fe9-0915fab8edb2",
                                                "sense_id": "9fc4b9a9-aaec-3311-a632-a530f4dce661",
                                                "text": "„Mit dem Lichtdruck sind im Gegensatz zur Fotografie silberlose und preisgünstige Abbildungen in allen Halbtönen zu erzielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93437bca-4e11-306a-ba7d-b70ad5b1217d",
                                        "entry_id": "8c8b8d85-a817-3bce-aaea-1dafb6688fb1",
                                        "glosses": [
                                            "ein auf chemisch behandelten lichtempfindlichen Platten oder Filmen, über ein Linsensystem scharfgestelltes und fokussiertes, durch die Reaktion der Chemikalien mit dem eintreffenden Licht, festgehaltenes Bildnis der realen Umgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "932f3663-7896-4b49-8b0f-e5dfdd4f605a",
                                                "sense_id": "93437bca-4e11-306a-ba7d-b70ad5b1217d",
                                                "text": "Diese Fotografie ist dir aber besonders gut gelungen."
                                            },
                                            {
                                                "example_id": "e7d2fb78-a5ea-4d7d-bce1-67c804f42192",
                                                "sense_id": "93437bca-4e11-306a-ba7d-b70ad5b1217d",
                                                "text": "„Ich kann mich noch an jene Fotografie erinnern.“"
                                            },
                                            {
                                                "example_id": "135a6e7b-4137-416e-9976-d9d6b2717ff2",
                                                "sense_id": "93437bca-4e11-306a-ba7d-b70ad5b1217d",
                                                "text": "„Der Major hielt die Fotografie in seiner gesunden Hand und betrachtete sie eingehend.“"
                                            },
                                            {
                                                "example_id": "11ec4c05-91eb-42e0-ae97-c2cbd98ddaaa",
                                                "sense_id": "93437bca-4e11-306a-ba7d-b70ad5b1217d",
                                                "text": "„Ich stehe an einer Glasvitrine, gefüllt mit vielen alten Fotografien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c4109e8-81ce-4241-985b-22984a057ddb",
                        "source_entry_id": "c99ba598-e96b-3cd9-a56f-7c1413aefba0",
                        "source_sense_id": "6c911b4b-df92-3bd9-abc0-e2b198cd5746",
                        "source_sense_description": "de kunst om door chemische inwerking van licht op een gevoelige plaat afbeeldingen te maken",
                        "target_lang_word": "Photography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51a991ed-ade6-4cc1-b45b-a2b62dc9e5cc",
                        "source_entry_id": "c99ba598-e96b-3cd9-a56f-7c1413aefba0",
                        "source_sense_id": "6c911b4b-df92-3bd9-abc0-e2b198cd5746",
                        "source_sense_description": "de kunst om door chemische inwerking van licht op een gevoelige plaat afbeeldingen te maken",
                        "target_lang_word": "photographie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photographie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26cf5c3f-8b0e-36b2-9c4e-fe493dc64b84",
                                        "entry_id": "419450d4-6fb0-3cb7-b863-ff3402e23881",
                                        "glosses": [
                                            "Processus de fabrication d’images sur une surface sensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146f2485-1aeb-4a7c-9fb0-5cf43f99ccb6",
                                                "sense_id": "26cf5c3f-8b0e-36b2-9c4e-fe493dc64b84",
                                                "text": "Il n’est plus permis aujourd’hui à un photographe quelque peu averti, d’ignorer la sensitométrie. Les méthodes de mesures créées par Hürter et Driffield, perfectionnées par un grand nombre de savants, ont acquis une importance considérable en photographie."
                                            },
                                            {
                                                "example_id": "367f2a4c-5126-4624-a01e-c0c7c9bc9365",
                                                "sense_id": "26cf5c3f-8b0e-36b2-9c4e-fe493dc64b84",
                                                "text": "Toutefois, c’est finalement le recours à la photographie astronomique qui a rendu possible, plusieurs années après le décès de Lowell, le succès de cette entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58475c3d-fd32-31d2-bea4-62973cc83384",
                                        "entry_id": "419450d4-6fb0-3cb7-b863-ff3402e23881",
                                        "glosses": [
                                            "Image sur un support photosensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff537485-4898-4e08-8583-4df9b0f72def",
                                                "sense_id": "58475c3d-fd32-31d2-bea4-62973cc83384",
                                                "text": "La moindre photographie nous apprend cent fois plus sur le Parthénon qu’un volume consacré à vanter les merveilles de ce monument."
                                            },
                                            {
                                                "example_id": "8367ca1c-0e88-48b1-a228-c1c74a5b82f7",
                                                "sense_id": "58475c3d-fd32-31d2-bea4-62973cc83384",
                                                "text": "Le pilote nous montra la photographie d’un phoquier bloqué dans les glaces, entouré de tentes."
                                            },
                                            {
                                                "example_id": "ccc5eb6f-4d3c-4593-abb2-320526007273",
                                                "sense_id": "58475c3d-fd32-31d2-bea4-62973cc83384",
                                                "text": "Enfin, je pus appareiller le 27 février, suivi de plusieurs amis qui, dans un canot à moteur, prenaient des photographies de mon départ."
                                            },
                                            {
                                                "example_id": "71ef9100-8ead-4207-abaa-8fa49a8a581c",
                                                "sense_id": "58475c3d-fd32-31d2-bea4-62973cc83384",
                                                "text": "Je possède encore dans le tiroir d’un meuble une photographie que mon ami Jean-Marc Bernard m’envoya lors de l’exécution capitale à Valence des chauffeurs de la Drôme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1973681-65bd-3676-a79d-1383147ddb02",
                                        "entry_id": "419450d4-6fb0-3cb7-b863-ff3402e23881",
                                        "glosses": [
                                            "Portrait réalisé par photographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff2b0b6-25b0-4c44-89b5-fb6350ca4411",
                                                "sense_id": "c1973681-65bd-3676-a79d-1383147ddb02",
                                                "text": "Pour ce qui est des différences, notons que la photographie, qui figure de manière indispensable sur la carte d’identité, n’est qu’une option dans le certificat."
                                            },
                                            {
                                                "example_id": "445d16bd-939a-45e9-bcd0-6f9333c53833",
                                                "sense_id": "c1973681-65bd-3676-a79d-1383147ddb02",
                                                "text": "Ainsi, son ambition n’est pas seulement de montrer que la pratique de la photographie d’identité en Afrique a eu pour conséquence de perpétuer un mode de contrôle administratif et judiciaire […], c’est aussi montrer […] comment un tel genre de photographie a pu marquer de façon durable l’imaginaire africain contemporain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349f96c9-0a00-3c71-a099-aae703cfc481",
                                        "entry_id": "419450d4-6fb0-3cb7-b863-ff3402e23881",
                                        "glosses": [
                                            "Art des photographes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b805525-4920-4777-b4d7-c9fbd743ed53",
                                                "sense_id": "349f96c9-0a00-3c71-a099-aae703cfc481",
                                                "text": "Si seules de rares femmes photographes marquent l’histoire de la photographie au XIXᵉ siècle, elles prennent superbement leur revanche à partir des années vingt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5548880-a1d0-31d7-8157-9566b6da027a",
                                        "entry_id": "419450d4-6fb0-3cb7-b863-ff3402e23881",
                                        "glosses": [
                                            "Résumé ou synthèse d’une situation à un moment donné."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e55d4a-a33a-4972-980b-44a8283f9ce8",
                                                "sense_id": "a5548880-a1d0-31d7-8157-9566b6da027a",
                                                "text": "C’est une photographie qui en dit long sur les difficultés rencontrées en fin de carrière par des centaines de milliers de personnes. En 2015, près d’un tiers des seniors n’ayant ni emploi ni retraite (« NER ») vivaient en dessous du seuil de pauvreté, selon une note rendue publique, mercredi 19 septembre, par la direction de la recherche, des études, de l’évaluation et des statistiques (Drees), un service rattaché à trois ministères (solidarités, travail, comptes publics)."
                                            }
                                        ]
                                    }
                                ]
                            },
