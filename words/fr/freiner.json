            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aed4c869-3412-3e4f-aa4a-4656a78f3485",
                    "sense_definition": "Ralentir ou arrêter le mouvement d'un véhicule ou d'un mécanisme à l'aide d'un frein.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a dû <w>freiner</w> brusquement lorsqu'un piéton a traversé la rue."
                        },
                        {
                            "text": "Tu roules trop vite sur cette route mouillée, pense à <w>freiner</w> avant le virage."
                        }
                    ],
                    "synonyms": [
                        "ralentir"
                    ],
                    "antonyms": [
                        "accélérer"
                    ],
                    "common_phrases": [
