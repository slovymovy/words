                        "glosses": [
                            "Donner un caractère girondin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d301f96c-eb5f-4ba6-9af3-4908d5ff6b14",
                                "sense_id": "4822a721-8eb2-3ec3-b702-6e5f7d847fa8",
                                "text": "Je sais de bonne source qu’il y a intrigué près des administrateurs des départements pour capter leur confiance et les girondiniser."
                            },
                            {
                                "example_id": "72c720b7-b743-4136-b2c1-cb8600a157d5",
                                "sense_id": "4822a721-8eb2-3ec3-b702-6e5f7d847fa8",
                                "text": "Mais l’État se « girondinise » et va demander davantage à de grandes régions plus émancipées (et aux intercommunalités)."
                            },
                            {
                                "example_id": "878b9be0-233b-4153-bf68-d78e493875cd",
                                "sense_id": "4822a721-8eb2-3ec3-b702-6e5f7d847fa8",
                                "text": "Marco, je crois que ton Inter est en train de se girondiniser."
                            }
                        ]
                    }
