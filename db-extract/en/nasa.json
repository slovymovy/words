                        "examples": [
                            {
                                "example_id": "f80e822f-dab4-4226-9ead-b542693cf0d3",
                                "sense_id": "b47036ac-0d5b-3894-a8d7-1a5e35234178",
                                "text": "„Mars' 20-kilometer, potato-shaped moon is shown in many NASA visuals as a precursor destination in the 30s. The first human missions to Mars might land there, paving the way for future crews to take the final plunge into the planet's gravity well.“",
                                "translation": "Der 20-Kilometer[-große], kartoffelförmige Mond von Mars wird in zahlreichen NASA-Anschauungsmaterial als ein vorläufiges Ziel in den 2020er Jahren dargestellt. Der ersten bemannten Raumfahrten zum Mars landen dort [und] bereiten den Weg für spätere Teams, um den endgültig in den \"Schwerkraftbrunnen\" des Planeten einzutauchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
