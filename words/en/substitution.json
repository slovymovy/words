{
    "word_family": [
        "substitute",
        "substitutable",
        "substitutability"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "131eb7ed-a0d8-3971-96af-5f1e309fb349",
                    "sense_definition": "The act of replacing one person or thing with another, or the state of being replaced.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "replacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this football tournament, three <w>substitutions</w> can be made during the match.",
                            "target_lang_translations": {
                                "ru": "В этом футбольном турнире во время матча можно провести три <w>замены</w>."
                            }
                        },
                        {
                            "text": "The chef suggested a <w>substitution</w> of honey for sugar in the recipe.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар предложил <w>замену</w> сахара медом в рецепте."
                            }
                        }
                    ],
                    "synonyms": [
                        "replacement",
                        "exchange",
                        "swap"
                    ],
                    "common_phrases": [
                        "make a substitution",
                        "substitution of honey",
                        "player substitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт замены одного человека или предмета другим, или состояние замены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена",
                                "target_lang_sense_clarification": "процесс или акт замены"
                            },
                            {
                                "target_lang_word": "подстановка",
                                "target_lang_sense_clarification": "в математике или логике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b932795c-15ef-3dfe-944a-98ceced2cf92",
                    "sense_definition": "A person or thing that takes the place of another; a substitute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gary is off this weekend, so Jeff will be his <w>substitution</w> for the shift.",
                            "target_lang_translations": {
                                "ru": "Гэри не работает в эти выходные, поэтому Джефф будет его <w>заменой</w> на смене."
                            }
                        },
                        {
                            "text": "The manager looked for a suitable <w>substitution</w> for the injured player.",
                            "target_lang_translations": {
                                "ru": "Менеджер искал подходящую <w>замену</w> травмированному игроку."
                            }
                        }
                    ],
                    "synonyms": [
                        "substitute",
                        "replacement",
                        "stand-in"
                    ],
                    "common_phrases": [
                        "suitable substitution",
                        "temporary substitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который занимает место другого; заместитель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена",
                                "target_lang_sense_clarification": "о человеке или предмете"
                            },
                            {
                                "target_lang_word": "заместитель",
                                "target_lang_sense_clarification": "о человеке, выполняющем чужую работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bca4a52c-2af9-3d42-a81f-eaa2ece84fbb",
                    "sense_definition": "The replacement of an atom or a group of atoms in a chemical compound with another atom or group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical reaction involves the <w>substitution</w> of a hydrogen atom with a chlorine atom.",
                            "target_lang_translations": {
                                "ru": "Химическая реакция включает <w>замещение</w> атома водорода атомом хлора."
                            }
                        },
                        {
                            "text": "A nucleophilic <w>substitution</w> is a fundamental class of reactions in organic chemistry.",
                            "target_lang_translations": {
                                "ru": "Нуклеофильное <w>замещение</w> — это фундаментальный класс реакций в органической химии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nucleophilic substitution",
                        "aromatic substitution",
                        "substitution reaction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Замещение атома или группы атомов в химическом соединении другим атомом или группой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замещение",
                                "target_lang_sense_clarification": "химическая реакция"
                            },
                            {
                                "target_lang_word": "подстановка",
                                "target_lang_sense_clarification": "в контексте химических реакций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8238e8ef-14d5-3b45-be03-f44d4be0ba72",
                    "sense_definition": "The creation of a new word in a language using native roots to correspond to a foreign term.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguistic <w>substitution</w> helps preserve the native character of a language against loanwords.",
                            "target_lang_translations": {
                                "ru": "Лингвистическая <w>субституция</w> помогает сохранить самобытность языка, противодействуя заимствованиям."
                            }
                        },
                        {
                            "text": "The academy preferred lexical <w>substitution</w> over simply adopting the English technical term.",
                            "target_lang_translations": {
                                "ru": "Академия предпочла лексическое <w>замещение</w> простому заимствованию английского технического термина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lexical substitution",
                        "linguistic substitution"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создание нового слова в языке с использованием исконных корней для соответствия иностранному термину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "субституция",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "замещение",
                                "target_lang_sense_clarification": "лексическое или языковое"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}