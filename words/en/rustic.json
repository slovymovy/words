{
    "word_family": [
        "rustical",
        "rusticalness",
        "rusticity",
        "rusticate",
        "rustication"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a20e9f4-0360-3267-818f-4fce70a642d6",
                    "sense_definition": "Characteristic of or relating to the countryside; rural or pastoral in style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rural_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel was decorated with a <w>rustic</w> charm that reminded guests of an old farmhouse.",
                            "target_lang_translations": {
                                "ru": "Отель был оформлен с <w>деревенским</w> шармом, напоминавшим гостям о старой ферме."
                            }
                        },
                        {
                            "text": "They spent the weekend in a <w>rustic</w> cabin surrounded by tall pine trees.",
                            "target_lang_translations": {
                                "ru": "Они провели выходные в <w>простом деревянном</w> домике в окружении высоких сосен."
                            }
                        }
                    ],
                    "synonyms": [
                        "bucolic"
                    ],
                    "antonyms": [
                        "urban"
                    ],
                    "common_phrases": [
                        "rustic charm",
                        "rustic cabin",
                        "rustic setting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для деревни или сельской местности; деревенский или пасторальный по стилю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельский",
                                "target_lang_sense_clarification": "относящийся к деревне или деревенскому укладу"
                            },
                            {
                                "target_lang_word": "деревенский",
                                "target_lang_sense_clarification": "в стиле деревенской жизни или быта"
                            },
                            {
                                "target_lang_word": "рустикальный",
                                "target_lang_sense_clarification": "о стиле в дизайне и интерьере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3ca8e8f-67b5-3722-8134-d35fb663a168",
                    "sense_definition": "Made in a simple, rough, or unfinished style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rough_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat around a <w>rustic</w> table built from heavy reclaimed wood planks.",
                            "target_lang_translations": {
                                "ru": "Мы сидели за <w>грубо сколоченным</w> столом из тяжелых старых досок."
                            }
                        },
                        {
                            "text": "The garden was bordered by a <w>rustic</w> fence fashioned from unpainted tree branches.",
                            "target_lang_translations": {
                                "ru": "Сад был огорожен <w>грубым</w> забором, сделанным из неокрашенных веток деревьев."
                            }
                        }
                    ],
                    "antonyms": [
                        "polished",
                        "refined"
                    ],
                    "common_phrases": [
                        "rustic furniture",
                        "rustic bench"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполненный в простом, грубом или нарочито необработанном стиле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубоватый",
                                "target_lang_sense_clarification": "о простой, грубой отделке предметов"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "неотесанный, необработанный"
                            },
                            {
                                "target_lang_word": "неотесанный",
                                "target_lang_sense_clarification": "о материале или изделии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59b5f9fc-19f6-3a2d-9e51-869636400249",
                    "sense_definition": "Simple, artless, or lacking sophistication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rough_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city visitors were charmed by the quiet innkeeper's <w>rustic</w> simplicity.",
                            "target_lang_translations": {
                                "ru": "Городских гостей очаровала <w>простая</w> безыскусность немногословного трактирщика."
                            }
                        },
                        {
                            "text": "His <w>rustic</w> manners seemed unpolished in the formal atmosphere of the grand banquet.",
                            "target_lang_translations": {
                                "ru": "Его <w>неотесанные</w> манеры казались грубоватыми в торжественной обстановке пышного банкета."
                            }
                        }
                    ],
                    "antonyms": [
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "rustic manners",
                        "rustic simplicity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простой, безыскусный или лишенный утонченности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простодушный",
                                "target_lang_sense_clarification": "неискушенный, наивный"
                            },
                            {
                                "target_lang_word": "безыскусный",
                                "target_lang_sense_clarification": "простой, без изысков"
                            },
                            {
                                "target_lang_word": "неотесанный",
                                "target_lang_sense_clarification": "о манерах или поведении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41d99e0b-e3c9-3021-982d-5ceaf2926945",
                    "sense_definition": "A person who lives in or comes from a rural or country area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rural_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play contrasts wealthy urban visitors with local <w>rustics</w> who tend the fields.",
                            "target_lang_translations": {
                                "ru": "В пьесе богатые городские гости противопоставляются местным <w>селянам</w>, возделывающим поля."
                            }
                        },
                        {
                            "text": "A lone <w>rustic</w> walked slowly down the lane guiding his cattle toward the barn.",
                            "target_lang_translations": {
                                "ru": "Одинокий <w>селянин</w> медленно шел по тропинке, направляя скот к хлеву."
                            }
                        }
                    ],
                    "synonyms": [
                        "provincial"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живущий в сельской местности или происходящий из деревни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "селянин",
                                "target_lang_sense_clarification": "житель деревни, сельский житель"
                            },
                            {
                                "target_lang_word": "деревенский житель",
                                "target_lang_sense_clarification": "обитатель деревни"
                            },
                            {
                                "target_lang_word": "крестьянин",
                                "target_lang_sense_clarification": "житель села, земледелец"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bade2e61-004c-3d2a-818a-d1517d4ef35d",
                    "sense_definition": "An unsophisticated or uncultured person from the countryside.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rural_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snobbish aristocrat dismissed the villagers as simple <w>rustics</w> who knew nothing of art.",
                            "target_lang_translations": {
                                "ru": "Высокомерный аристократ с пренебрежением считал жителей деревни недалекой <w>деревенщиной</w>, ничего не смыслящей в искусстве."
                            }
                        },
                        {
                            "text": "He hated being treated like an uneducated <w>rustic</w> whenever he traveled into the capital.",
                            "target_lang_translations": {
                                "ru": "Он ненавидел, когда с ним обращались как с необразованной <w>деревенщиной</w> каждый раз, когда он приезжал в столицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "boor",
                        "country bumpkin",
                        "hick",
                        "hillbilly",
                        "yokel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неотесанный, необразованный или некультурный выходец из сельской местности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "неотесанный провинциал"
                            },
                            {
                                "target_lang_word": "провинциал",
                                "target_lang_sense_clarification": "не искушенный в городской культуре человек"
                            },
                            {
                                "target_lang_word": "мужик",
                                "target_lang_sense_clarification": "грубоватый, простой выходец из народа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a4c4577-7111-3cbe-aec3-b4c35f0df3dc",
                    "sense_definition": "Any of various night-flying moths of the owlet family.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entomologist pointed out a common <w>rustic</w> fluttering around the porch lantern.",
                            "target_lang_translations": {
                                "ru": "Энтомолог указал на обыкновенную <w>совку</w>, порхавшую вокруг фонаря на крыльце."
                            }
                        },
                        {
                            "text": "A dull brown <w>rustic</w> landed quietly on the weathered wooden fence post.",
                            "target_lang_translations": {
                                "ru": "Тускло-коричневая <w>совка</w> бесшумно опустилась на выветрившийся деревянный столб забора."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из различных ночных бабочек семейства совок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совка",
                                "target_lang_sense_clarification": "ночная бабочка семейства Noctuidae"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7833a7ea-144a-35fe-b1d5-c42f5742339e",
                    "sense_definition": "Any of various brush-footed butterflies with brown and orange patterned wings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While walking through the tropical forest, we spotted a colorful <w>rustic</w> resting on a wide leaf.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки по тропическому лесу мы заметили яркую <w>куфу</w>, сидевшую на широком листе."
                            }
                        },
                        {
                            "text": "The bright orange wings of the <w>rustic</w> made it easy to distinguish among the bushes.",
                            "target_lang_translations": {
                                "ru": "Ярко-оранжевые крылья <w>куфы</w> позволяли легко различить ее среди кустов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из бабочек семейства нимфалид с коричнево-оранжевым узором на крыльях (род Cupha)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куфа",
                                "target_lang_sense_clarification": "дневная бабочка рода Cupha"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}