                                                "example_id": "e464fe71-ed24-468a-8125-b7cd4eca920b",
                                                "sense_id": "ba62b9e6-e92e-3f24-bc63-7fdd1b9832e4",
                                                "text": "Plötzlich fiel mir das Versprechen wieder ein; deswegen war ich so still."
                                            },
                                            {
                                                "example_id": "633e8909-242c-4c5f-87cb-bf8965a516ae",
                                                "sense_id": "ba62b9e6-e92e-3f24-bc63-7fdd1b9832e4",
                                                "text": "„Immer populärer wird deswegen Bodyflying, auch bekannt als Indoor-Skydiving.“"
                                            },
                                            {
                                                "example_id": "a36eeeec-e8dc-41f1-984a-746c85dc7c23",
                                                "sense_id": "ba62b9e6-e92e-3f24-bc63-7fdd1b9832e4",
                                                "text": "„Deswegen ist sie Geologin geworden.“"
                                            },
                                            {
                                                "example_id": "926d2c98-bea7-4dff-8641-f36b8eb560c9",
                                                "sense_id": "ba62b9e6-e92e-3f24-bc63-7fdd1b9832e4",
                                                "text": "Weswegen wollte sie nicht kommen? Wegen der langen Anreise? Ach, deswegen!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
