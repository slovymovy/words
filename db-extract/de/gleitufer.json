                "senses": [
                    {
                        "sense_id": "b155f91d-92e8-3e89-975f-e1e35da6de9a",
                        "entry_id": "6bd9a64e-806c-35b0-9519-b3ad8b3bb3c2",
                        "glosses": [
                            "gekrümmt verlaufender Bereich eines Ufers, auf den die Fließrichtung eines Gewässers nicht direkt gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53aa801-0c83-4493-96ae-7d8502e5dba9",
                                "sense_id": "b155f91d-92e8-3e89-975f-e1e35da6de9a",
                                "text": "„An diesen Stellen liegen sich ein steileres Prallufer und ein seicht auslaufendes Gleitufer gegenüber.“"
                            },
                            {
                                "example_id": "802f6bda-490c-466e-8e90-ad8d38355d70",
                                "sense_id": "b155f91d-92e8-3e89-975f-e1e35da6de9a",
                                "text": "„Typische Merkmale der Krümmungserosion sind steile bis senkrechte Prall- und flache Gleitufer.“"
                            },
                            {
                                "example_id": "3d1597a9-0b19-4033-acbc-e65f7f9b3398",
                                "sense_id": "b155f91d-92e8-3e89-975f-e1e35da6de9a",
                                "text": "„Am gegenüber liegenden, flachen Ufer in der Innenkurve der Flussbiegung befindet sich das Gleitufer.“"
                            },
                            {
                                "example_id": "59401d59-ad15-4f4c-955a-64ae75c5f2b2",
                                "sense_id": "b155f91d-92e8-3e89-975f-e1e35da6de9a",
                                "text": "„Infolge der Asymmetrie des Profils kann man hier Prallufer und Gleitufer unterscheiden. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
