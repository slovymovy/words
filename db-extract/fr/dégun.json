                        "entry_id": "772c2cf4-3450-3d10-a3e5-7f6cfda3c2da",
                        "glosses": [
                            "Individu sans importance et méprisable."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "64b15900-27ca-47d0-b506-c294190f9fe4",
                                "sense_id": "c83f2835-bd49-34c7-bd39-26d17cbe1f99",
                                "text": "Vas-y Papa vas-y\nElle a raison la minote, barre-toi !\nTu vois pas que t’y es un dégun !\nY’a longtemps que t’es à Marseille ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e61ba37-813c-4940-a14d-c9d533c4a38e",
                        "source_entry_id": "772c2cf4-3450-3d10-a3e5-7f6cfda3c2da",
                        "source_sense_id": "c83f2835-bd49-34c7-bd39-26d17cbe1f99",
                        "target_lang_word": "niemand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niemand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                        "entry_id": "ee9b5196-dd7c-399b-b32f-590a10aabe50",
                                        "glosses": [
                                            "keiner, kein Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e9f7dc-51f1-4401-8053-e0bb70aa1720",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "Diesen Begriff kann niemand leicht erklären."
                                            },
                                            {
                                                "example_id": "327dd4b7-e301-4e0d-92cb-6e53f2fa79b1",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "„Politische Herrschaftsrechte […] waren vererbbar, übertragbar, verpfändbar, und ihr Inhaber war prinzipiell niemand Rechenschaft schuldig.“"
                                            },
                                            {
                                                "example_id": "2dbbbc67-3a44-47f8-9d8c-89894cc40c8f",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "„Hineinreden in seine Lebensführung läßt er sich überhaupt von niemandem mehr, nicht von Vater und Mutter und schon gar nicht von einem Hansnarren.“"
                                            },
                                            {
                                                "example_id": "ad149bf6-5d04-4c0e-b210-0abe9420ed22",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "„In diesem Papier werde ein für allemal festgelegt, dass niemand anderes als die Gebrüder Wright als erste Motorflieger genannt werden dürften; zwei Amerikaner und nicht der Bayer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
