        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9aaf399e-b837-37a6-a2e9-744620eb584d",
                    "sense_definition": "A severe snowstorm with high winds and low visibility.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was paralyzed by a massive <w>blizzard</w> that lasted for two days.",
                            "target_lang_translations": {
                                "ru": "Город был парализован из-за мощной <w>метели</w>, которая длилась два дня."
                            }
                        },
                        {
                            "text": "Drivers were warned to stay off the roads during the <w>blizzard</w>.",
                            "target_lang_translations": {
                                "ru": "Водителей предупредили не выезжать на дороги во время <w>бурана</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snowstorm"
                    ],
                    "common_phrases": [
                        "severe blizzard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная снежная буря с порывистым ветром и плохой видимостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мете́ль",
                                "target_lang_sense_clarification": "Общее название сильного ветра со снегом."
                            },
                            {
                                "target_lang_word": "бура́н",
                                "target_lang_sense_clarification": "Сильная снежная буря, характерная для степной местности."
                            },
                            {
                                "target_lang_word": "пурга́",
                                "target_lang_sense_clarification": "Сильная низовая метель, поднимающая снег с земли."
                            },
                            {
                                "target_lang_word": "вью́га",
                                "target_lang_sense_clarification": "Сильная метель, часто сопровождающаяся завыванием ветра."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                    "sense_definition": "A large, overwhelming number of similar things arriving all at once.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company received a <w>blizzard</w> of complaints after the product launch.",
                            "target_lang_translations": {
                                "ru": "Компания получила <w>лавину</w> жалоб после запуска продукта."
                            }
                        },
                        {
                            "text": "She had to deal with a <w>blizzard</w> of emails every single morning.",
                            "target_lang_translations": {
                                "ru": "Каждое утро ей приходилось разбираться с <w>лавиной</w> электронных писем."
                            }
                        }
                    ],
                    "synonyms": [
                        "flood",
                        "inundation",
                        "torrent"
                    ],
                    "common_phrases": [
                        "blizzard of emails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромное, подавляющее количество чего-либо, поступающее одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лави́на",
                                "target_lang_sense_clarification": "Переносное значение: внезапный и резкий наплыв чего-либо в большом количестве."
                            },
                            {
                                "target_lang_word": "пото́к",
                                "target_lang_sense_clarification": "Большое количество чего-либо, движущееся непрерывно."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "033ce573-e18c-37f8-b697-a9afa707e842",
                    "sense_definition": "A large, overwhelming amount of paperwork.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was buried under a <w>blizzard</w> of legal documents.",
                            "target_lang_translations": {
                                "ru": "Адвокат был завален <w>лавиной</w> юридических документов."
                            }
                        },
                        {
                            "text": "He spent the entire weekend sorting through a <w>blizzard</w> of forms.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные, разбирая <w>гору</w> бланков."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромное, подавляющее количество бумажной работы или документов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лави́на",
                                "target_lang_sense_clarification": "Используется для описания огромного объема документов, с которыми трудно справиться."
                            },
                            {
                                "target_lang_word": "гора́",
                                "target_lang_sense_clarification": "Разговорное выражение для обозначения очень большого количества бумаг."
                            }
                        ]
                    }
                }
            ]
        },
        {
