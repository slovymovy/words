                "senses": [
                    {
                        "sense_id": "cf4e0b30-a499-33f0-baf4-6271bf8f91be",
                        "entry_id": "7a12b158-e78f-31f4-91db-34725bd4f0b4",
                        "glosses": [
                            "Gesamtheit der Verhaltensregeln für alle möglichen Vorgänge an einem Herrschersitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06570270-73ed-4c51-bba2-75d21f53154a",
                                "sense_id": "cf4e0b30-a499-33f0-baf4-6271bf8f91be",
                                "text": "„Das Wasserschloss Unterwittelsbach bei Aichach – besser bekannt als Sisi-Schloss – war einst Sommerresidenz von Sisis Vater Herzog Max. Hier konnte die junge Sisi jenseits der Hofetikette unbeschwerte Kindheitstage verbringen.“"
                            },
                            {
                                "example_id": "59ea9d25-592e-4a11-a548-c89965e298fd",
                                "sense_id": "cf4e0b30-a499-33f0-baf4-6271bf8f91be",
                                "text": "„Die Hofetikette verbot den Propheten […] wahrscheinlich den direkten Zugang zum König, weshalb sie auf die Verschriftung durch Schreiber angewiesen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
