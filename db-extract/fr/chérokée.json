                "senses": [
                    {
                        "sense_id": "8bfdf2e2-ddf6-3d06-9b57-5842d289c284",
                        "entry_id": "f6a4e5c0-39cc-3bbe-8cbc-31a723461882",
                        "glosses": [
                            "Variante orthographique de Cherokee."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "51a704ba-225b-4be2-919d-94eec58d9335",
                                "sense_id": "8bfdf2e2-ddf6-3d06-9b57-5842d289c284",
                                "text": "Les Chérokées ne sont pas errants comme plusieurs autres tribus : ils croient que leur premier père descendit des nuages sur les contrées qu’ils occupent encore ; les lieux où reposent leur ancêtres sont en vénération ; tout homme est tenu de les défendre, et ils regarderaient comme honteux de les abandonner."
                            },
                            {
                                "example_id": "02cebe91-63af-422b-b3b9-9c0a4d140852",
                                "sense_id": "8bfdf2e2-ddf6-3d06-9b57-5842d289c284",
                                "text": "Sylvie devint ingénieuse et poussa les raffinements de sa tyrannie jusqu’aux recherches les plus sauvages. Les Illinois, les Chérokées, les Mohicans auraient pu s’instruire avec elle."
                            },
                            {
                                "example_id": "0aed69f8-9fd5-4bd2-962f-cae3e3b08928",
                                "sense_id": "8bfdf2e2-ddf6-3d06-9b57-5842d289c284",
                                "text": "Brainerd est le siège d’une mission importante dont le but est de convertir et de civiliser les Chérokées."
                            },
                            {
                                "example_id": "398d32c5-1162-4bc9-b45f-7e0dcab98855",
                                "sense_id": "8bfdf2e2-ddf6-3d06-9b57-5842d289c284",
                                "text": "Les Chérokées n’occupaient pas moins de trente-six millions d’acres de terre pour leur chasse."
                            }
                        ]
                    }
                ],
