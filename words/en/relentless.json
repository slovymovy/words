    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24d26953-ae84-3a09-b10a-b77d1ca96909",
                    "sense_definition": "Continuing without stopping or losing intensity; steady and persistent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>relentless</w> rain caused the river to overflow its banks after three days.",
                            "target_lang_translations": {
                                "ru": "<w>Непрекращающийся</w> дождь привел к тому, что через три дня река вышла из берегов."
                            }
                        },
                        {
                            "text": "The team's <w>relentless</w> pursuit of excellence led them to win the championship.",
                            "target_lang_translations": {
                                "ru": "<w>Неустанное</w> стремление команды к совершенству привело их к победе в чемпионате."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "unremitting",
                        "unstoppable"
                    ],
                    "antonyms": [
                        "stoppable",
                        "remitting"
                    ],
                    "common_phrases": [
                        "relentless pursuit",
                        "relentless pressure",
                        "relentless rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжающийся без остановок или потери интенсивности; устойчивый и настойчивый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрекращающийся",
                                "target_lang_sense_clarification": "о дожде, шуме или процессе"
                            },
                            {
                                "target_lang_word": "неустанный",
                                "target_lang_sense_clarification": "о стремлении или усилиях"
                            },
                            {
                                "target_lang_word": "упорный",
                                "target_lang_sense_clarification": "настойчивый и постоянный"
                            },
                            {
                                "target_lang_word": "неослабевающий",
                                "target_lang_sense_clarification": "не теряющий силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52388ed9-ea72-30c4-b3fe-5fba63c15b5b",
                    "sense_definition": "Harsh, cruel, or refusing to give up a strict or severe attitude.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was <w>relentless</w> in his treatment of those who opposed his rule.",
                            "target_lang_translations": {
                                "ru": "Диктатор был <w>неумолим</w> в своем отношении к тем, кто выступал против его правления."
                            }
                        },
                        {
                            "text": "She fixed her son with a <w>relentless</w> eye until he finally told the truth.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на сына <w>непреклонным</w> взглядом, пока он наконец не сказал правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "grim",
                        "inexorable",
                        "unyielding",
                        "unrelenting"
                    ],
                    "antonyms": [
                        "yielding",
                        "relenting",
                        "exorable"
                    ],
                    "common_phrases": [
                        "relentless critic",
                        "relentless heat",
                        "relentless pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровый, жестокий или отказывающийся смягчить строгое отношение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неумолимый",
                                "target_lang_sense_clarification": "не поддающийся просьбам, суровый"
                            },
                            {
                                "target_lang_word": "беспощадный",
                                "target_lang_sense_clarification": "крайне жестокий"
                            },
                            {
                                "target_lang_word": "непреклонный",
                                "target_lang_sense_clarification": "твердый в своем решении"
                            },
                            {
                                "target_lang_word": "безжалостный",
                                "target_lang_sense_clarification": "лишенный сострадания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
