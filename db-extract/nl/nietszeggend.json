                "senses": [
                    {
                        "sense_id": "b2e2ee99-b3db-325a-9411-3b76ef666e7b",
                        "entry_id": "f95786e8-a02d-3301-9c20-7f9b73f7861c",
                        "glosses": [
                            "geen nadere informatie gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099738fe-742b-43ba-8908-b31dc091664d",
                                "sense_id": "b2e2ee99-b3db-325a-9411-3b76ef666e7b",
                                "text": "Op het affiche staan enkel mij nietszeggende bandnamen."
                            },
                            {
                                "example_id": "0548a2d8-54e1-4004-b7be-e0903b4dfa10",
                                "sense_id": "b2e2ee99-b3db-325a-9411-3b76ef666e7b",
                                "text": "Verder dan wat nietszeggende opmerkingen komt het jurylid niet."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2ab5468-f0f7-3e52-872d-00e6d2dd2f0a",
                        "entry_id": "f95786e8-a02d-3301-9c20-7f9b73f7861c",
                        "glosses": [
                            "onbeduidend; karakterloos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fa7d8f-4f31-4808-a4de-321182b2a61a",
                                "sense_id": "b2ab5468-f0f7-3e52-872d-00e6d2dd2f0a",
                                "text": "Er staan wat nietszeggende oefenpotjes op het programma."
                            },
                            {
                                "example_id": "90dd2067-f51d-48e9-be16-27c8c9a00899",
                                "sense_id": "b2ab5468-f0f7-3e52-872d-00e6d2dd2f0a",
                                "text": "Hij werd afgescheept met een nietszeggende portefeuille."
                            },
                            {
                                "example_id": "cf5900c6-e942-4d6e-b5f0-16e28f8f1b71",
                                "sense_id": "b2ab5468-f0f7-3e52-872d-00e6d2dd2f0a",
                                "text": "Een nietszeggend landschap."
                            }
                        ]
                    }
