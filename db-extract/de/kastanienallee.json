                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c73323-1d52-47a1-b5a4-564e77da49c6",
                                "sense_id": "d8a5e640-8263-3010-9029-8942d2e7b711",
                                "text": "„Eine lange Kastanienallee führt zu einem kleinen Palais, dem Poppelsdorfer Schloss, an das sich der Botanische Garten schmiegt.“"
                            },
                            {
                                "example_id": "c0298654-2515-4c02-98d2-fea1d212b80b",
                                "sense_id": "d8a5e640-8263-3010-9029-8942d2e7b711",
                                "text": "„Etwa hundert Häuser und Hütten bilden hier eine lange, schmale Gasse, die sich nur da, wo eine von Kloster Wutz her heranführende Kastanienallee die Gasse durchschneidet, platzartig erweitert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
