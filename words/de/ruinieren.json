                    "frequency": "Middle",
                    "semantic_group_id": "sachschaden_beschaedigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der viele Regen hat die teuren Schuhe komplett <w>ruiniert</w>."
                        },
                        {
                            "text": "Mit diesen ständigen Lügen wirst du deinen guten Ruf <w>ruinieren</w>."
                        }
                    ],
                    "synonyms": [
