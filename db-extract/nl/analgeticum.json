                                                "example_id": "6be4c483-1911-488f-9dd7-02652f4634bb",
                                                "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                                "text": "Gegen ihre Migräne nahm sie schon lange starke Schmerzmittel."
                                            },
                                            {
                                                "example_id": "5b864169-8912-4cf7-80f3-224ddf1c14ff",
                                                "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                                "text": "Obwohl man viele Schmerzmittel rezeptfrei bekommt, sind diese keineswegs harmlos."
                                            },
                                            {
                                                "example_id": "bfdb1892-1d02-447b-95b8-065546ea492e",
                                                "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                                "text": "„Auch wissen wir, dass Cook auf seiner zweiten Reise mit Opiaten behandelt worden war, dem einzigen effektiven Schmerzmittel in der Medizinkiste des Schiffsarztes.“"
                                            }
