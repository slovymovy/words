                                        "examples": [
                                            {
                                                "example_id": "c142d6e9-e114-446b-8cec-131ef4ab7e25",
                                                "sense_id": "ca529a55-42af-34b2-ae84-50e35c399af8",
                                                "text": "ha risposto positivamente alla mia richiesta"
                                            },
                                            {
                                                "example_id": "baa18c03-354a-4786-bd0f-77d1d4a1b3b7",
                                                "sense_id": "ca529a55-42af-34b2-ae84-50e35c399af8",
