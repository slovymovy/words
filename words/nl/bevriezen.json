{
    "word_family": [
        "bevriezing",
        "vriezen",
        "vriespunt",
        "vriezer",
        "diepvries"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68cac8f5-7a93-332c-bed0-b60c8681be41",
                    "sense_definition": "door afkoeling in vaste toestand komen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water <w>bevriest</w> bij nul graden Celsius.",
                            "target_lang_translations": {
                                "en": "Water <w>freezes</w> at zero degrees Celsius."
                            }
                        },
                        {
                            "text": "Door de harde wind <w>bevroor</w> zijn baard tijdens de wandeling.",
                            "target_lang_translations": {
                                "en": "Due to the strong wind, his beard <w>froze</w> during the walk."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstijven"
                    ],
                    "antonyms": [
                        "ontdooien"
                    ],
                    "common_phrases": [
                        "water bevriest"
                    ],
                    "target_lang_definitions": {
                        "en": "to become solid as a result of cooling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "of a liquid becoming solid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9379eab-3c90-3bdc-b62e-026c1a8e614a",
                    "sense_definition": "iets door afkoeling in vaste toestand doen komen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>bevriezen</w> onze groenten direct na de oogst.",
                            "target_lang_translations": {
                                "en": "We <w>freeze</w> our vegetables immediately after the harvest."
                            }
                        },
                        {
                            "text": "Je kunt deze soep prima <w>bevriezen</w> voor later gebruik.",
                            "target_lang_translations": {
                                "en": "You can easily <w>freeze</w> this soup for later use."
                            }
                        }
                    ],
                    "synonyms": [
                        "invriezen"
                    ],
                    "antonyms": [
                        "ontdooien"
                    ],
                    "common_phrases": [
                        "groenten bevriezen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause something to become solid by cooling it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "to preserve food or lower temperature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51ba10a7-e7d4-3b0d-b509-717be187493e",
                    "sense_definition": "ineens ophouden met bewegen of verstijven door schrik of emotie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegingloosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>bevroor</w> van schrik toen ze de slang zag.",
                            "target_lang_translations": {
                                "en": "She <w>froze</w> with terror when she saw the snake."
                            }
                        },
                        {
                            "text": "Zijn glimlach <w>bevroor</w> op zijn gezicht.",
                            "target_lang_translations": {
                                "en": "His smile <w>froze</w> on his face."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstijven",
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "van schrik bevriezen"
                    ],
                    "target_lang_definitions": {
                        "en": "to suddenly stop moving or become stiff due to shock or emotion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "to become motionless from fear or surprise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "075414fa-83e0-3d6f-80ba-455367ecb912",
                    "sense_definition": "iets blokkeren of niet verder laten toenemen, zoals prijzen of rekeningen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blokkeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bank besloot zijn rekening tijdelijk te <w>bevriezen</w>.",
                            "target_lang_translations": {
                                "en": "The bank decided to temporarily <w>freeze</w> his account."
                            }
                        },
                        {
                            "text": "De regering wil de prijzen voor energie <w>bevriezen</w>.",
                            "target_lang_translations": {
                                "en": "The government wants to <w>freeze</w> energy prices."
                            }
                        }
                    ],
                    "synonyms": [
                        "blokkeren",
                        "vastzetten"
                    ],
                    "common_phrases": [
                        "rekening bevriezen",
                        "prijzen bevriezen"
                    ],
                    "target_lang_definitions": {
                        "en": "to block something or prevent it from increasing further, such as prices or accounts"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "to stop movement of assets or price increases"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5ee21f-fd11-35be-b149-8bf1ee3d8d17",
                    "sense_definition": "door kou beschadigd raken of ophouden met functioneren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens deze strenge winter is een groot deel van de oogst <w>bevroren</w>.",
                            "target_lang_translations": {
                                "en": "During this severe winter, a large part of the crop <w>froze</w>."
                            }
                        },
                        {
                            "text": "De leidingen zijn <w>bevroren</w> en nu hebben we geen water.",
                            "target_lang_translations": {
                                "en": "The pipes have <w>frozen</w> and now we have no water."
                            }
                        }
                    ],
                    "synonyms": [
                        "kapotvriezen"
                    ],
                    "common_phrases": [
                        "oogst bevriezen"
                    ],
                    "target_lang_definitions": {
                        "en": "to become damaged or stop functioning due to cold"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "of pipes or crops being damaged by cold"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}