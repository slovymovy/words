                                "target_senses": [
                                    {
                                        "sense_id": "06d7435c-015b-3875-a3e4-de3696b607ca",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen",
                                            "schriftlicher oder mündlicher Bericht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4873a3ac-bb5d-4fc2-9e0d-258c81903af8",
                                                "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                                "text": "Beim Schreiben des Referates fielen ihm wieder alle Kritikpunkte ein."
                                            },
                                            {
                                                "example_id": "88b92076-a47f-4d7c-887b-a58117932955",
                                                "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                                "text": "Spätestens ab der Hälfte des etwa 200 Seiten langen Buchs hat der Leser das Anliegen des Verfassers begriffen – kurz nachdem das unvermeidliche Referat über die früheste positive Darstellung der Melancholie überstanden ist."
                                            },
                                            {
                                                "example_id": "7a96bd97-da2a-472d-b10b-74fb824e4f20",
                                                "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                                "text": "„Ein richtiges Referat hatte er gehalten und auf all meine kritischen Fragen die Antwort gewusst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "e7419cc7-ad0e-3deb-ae41-3fa8cf1070f7",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen",
                                            "ein Vortrag vor einem Publikum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb7895d-db19-4544-9c96-d66dc5d65dc4",
                                                "sense_id": "e7419cc7-ad0e-3deb-ae41-3fa8cf1070f7",
                                                "text": "So traurig das war, man sah doch viele Zuhörer lächeln, als das Referat des bekennenden Ironikers verlesen wurde – der übrigens, ein kleiner Tribut an den Feminismus, stets von „der Ironikerin“ sprach."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
