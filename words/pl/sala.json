            "senses": [
                {
                    "sense_id": "aec8e175-9780-3b91-a421-7095e319d10c",
                    "sense_definition": "Przestronne pomieszczenie w budynku przeznaczone do określonych celów, np. zajęć lekcyjnych, spotkań, ćwiczeń sportowych lub leczenia szpitalnego.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "room_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uczniowie czekali przed <w>salą</w> na nauczyciela matematyki.",
                            "target_lang_translations": {
                                "ru": "Ученики ждали учителя математики перед <w>классом</w>.",
                                "en": "The pupils waited outside the <w>classroom</w> for the maths teacher."
                            }
                        },
                        {
                            "text": "W dużej <w>sali</w> konferencyjnej zebrali się wszyscy pracownicy firmy.",
                            "target_lang_translations": {
                                "ru": "В большом конференц-<w>зале</w> собрались все сотрудники фирмы.",
                                "en": "All the company's employees gathered in the large conference <w>room</w>."
                            }
                        },
                        {
                            "text": "Pacjent został przewieziony na inną <w>salę</w> po operacji.",
                            "target_lang_translations": {
                                "ru": "После операции пациента перевезли в другую <w>палату</w>.",
                                "en": "The patient was transferred to another <w>ward</w> after the surgery."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sala lekcyjna",
                        "sala gimnastyczna",
                        "sala konferencyjna",
                        "sala operacyjna",
                        "sala sądowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просторное помещение в здании, предназначенное для определенных целей, например, учебных занятий, встреч, спорта или больничного лечения.",
                        "en": "A large or spacious room in a building designed for specific purposes, such as classes, meetings, sports, or hospital treatment."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зал",
                                "target_lang_sense_clarification": "большое помещение"
                            },
                            {
                                "target_lang_word": "палата",
                                "target_lang_sense_clarification": "в больнице"
                            },
                            {
