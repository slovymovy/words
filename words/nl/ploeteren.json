                },
                {
                    "sense_id": "899729f6-acf1-3292-8a0d-5ec8285f0b47",
                    "sense_definition": "zich met grote moeite voortbewegen door een lastige ondergrond zoals modder of sneeuw",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeizaam voortbewegen",
                    "name_type": "no",
                    "examples": [
                        {
