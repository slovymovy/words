                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дразнящий",
                                "target_lang_sense_clarification": "о поведении или словах, вызывающих легкое раздражение или смех"
                            },
                            {
                                "target_lang_word": "насмешливый",
                                "target_lang_sense_clarification": "выражающий иронию или легкую насмешку"
                            }
                        ]
