                "senses": [
                    {
                        "sense_id": "291e277f-ee34-322a-9c9e-85cde12541da",
                        "entry_id": "6921e8fa-8fff-38e0-a3e4-485dc394702c",
                        "glosses": [
                            "hoher germanischer Gott"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccac6848-09d1-4b71-a8d4-22461e32e22b",
                                "sense_id": "291e277f-ee34-322a-9c9e-85cde12541da",
                                "text": "Donar wird manchmal mit dem „Donnerer“ Jupiter oder Zeus gleichgesetzt."
                            },
                            {
                                "example_id": "c371a025-7cdf-4bf3-aa68-38c6eec3a048",
                                "sense_id": "291e277f-ee34-322a-9c9e-85cde12541da",
                                "text": "„Nach alter Überlieferung stand hier einmal eine heidnische Donareiche, die der heilige Bonifatius höchstpersönlich fällte, um dem ganz und gar unchristlichen Treiben des germanischen Gottes Donar endlich ein Ende zu setzen und die Eingeborenen von der einzig seligmachenden Religion zu überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21406f73-a4f3-40ed-933f-0a949cae01e4",
                        "source_entry_id": "6921e8fa-8fff-38e0-a3e4-485dc394702c",
                        "source_sense_id": "291e277f-ee34-322a-9c9e-85cde12541da",
                        "source_sense_description": "Mythologie: hoher germanischer Gott",
                        "target_lang_word": "Thor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d1a191-7520-3a9f-a728-0028ae0fd2e4",
                                        "entry_id": "8dfe0985-a5a6-3a09-8741-a16c0fa11e1a",
                                        "glosses": [
                                            "A hammer-wielding god associated with thunder, lightning, storms, sacred groves and trees, strength, and the protection of mankind."
                                        ],
                                        "tags": [
                                            "Norse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4077e105-e698-4de7-91fa-edbb2493ad34",
                                                "sense_id": "78d1a191-7520-3a9f-a728-0028ae0fd2e4",
                                                "text": "So likewise a day comes when the Runic Thor, with his Eddas, must withdraw into dimness; and many an African Mumbo-Jumbo and Indian Pawpaw be utterly abolished."
                                            },
                                            {
                                                "example_id": "3cfcdc4e-9f78-460c-b940-993494438a48",
                                                "sense_id": "78d1a191-7520-3a9f-a728-0028ae0fd2e4",
                                                "text": "There’s the Thor fly in tribute of the God of Thunder, played in Marvel by Chris Hemsworth. Its scientific name is “Daptolestes bronteflavus,” which is derived from Latin like most scientific names – and translates to “blond thunder.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba82d80-9059-303a-a65c-f2d2b3f248cf",
                                        "entry_id": "8dfe0985-a5a6-3a09-8741-a16c0fa11e1a",
                                        "glosses": [
                                            "A male given name from the Germanic languages occasionally borrowed from Scandinavia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce0d98e-66c4-3071-96ce-7ae2e8f8be32",
                                        "entry_id": "8dfe0985-a5a6-3a09-8741-a16c0fa11e1a",
                                        "glosses": [
                                            "A mountain on Baffin Island, Canada."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc7abc92-67d1-406b-b7f4-e36db02e01b3",
                        "source_entry_id": "6921e8fa-8fff-38e0-a3e4-485dc394702c",
                        "source_sense_id": "291e277f-ee34-322a-9c9e-85cde12541da",
                        "source_sense_description": "Mythologie: hoher germanischer Gott",
                        "target_lang_word": "Thor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thor",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7de9cb07-777a-35a5-a116-d5f0d2afcdfb",
                                        "entry_id": "1d9b4fe3-76b0-36df-a1a4-d4c1dda95e3a",
                                        "glosses": [
                                            "Dieu nordique du tonnerre."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8b56812-14be-4bf8-aeac-cc4c2d69d58e",
                                                "sense_id": "7de9cb07-777a-35a5-a116-d5f0d2afcdfb",
                                                "text": "Les rafales d’une violence inouïe, accès de colère de Wottan ou de Thor, tombent des hauteurs en sifflant et soulèvent des tourbillons d’embruns qui sillonnent la mer."
                                            },
                                            {
                                                "example_id": "030f90be-cda4-4566-a1ad-c1780f0a9dad",
                                                "sense_id": "7de9cb07-777a-35a5-a116-d5f0d2afcdfb",
                                                "text": "Après soixante heures de traversée, nous jetons l’ancre devant Thorshavn, capitale des Féroë. […]. Les Féroésiens l’ont consacrée à Thor : de tous les dieux de l’ancienne mythologie scandinave, Thor est celui qui a la vie la plus dure."
                                            },
                                            {
                                                "example_id": "6fbb0264-d67c-40b2-9ee6-1b4f6bf277df",
                                                "sense_id": "7de9cb07-777a-35a5-a116-d5f0d2afcdfb",
                                                "text": "Le personnage de Loki, frère de Thor, est intéressant pour cela."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
