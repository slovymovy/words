        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "16c9a587-0735-30dc-85ea-93a0ac9936bd",
                "word": "dancing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1845faa4-f5a7-4e97-ae20-78ee4844b011",
