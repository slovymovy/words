                                            {
                                                "example_id": "ef00a058-18f9-48df-b8ca-5d46b109b9dc",
                                                "sense_id": "d635e431-3f09-3e1f-b7b3-0e85959f690f",
                                                "text": "Le docteur, se servant lui-même, puisa trois fois dans le plat, tandis que Mme Caravan, de temps en temps, piquait un gros morceau au bout de sa fourchette et l’avalait avec une sorte d’inattention étudiée."
                                            },
                                            {
                                                "example_id": "3e5d871b-56e4-4c19-9803-a1fdf6d23b77",
                                                "sense_id": "d635e431-3f09-3e1f-b7b3-0e85959f690f",
                                                "text": "A quoi songes-tu donc ? s'informa la maîtresse du logis, surprise de l’inattention qu'elle lisait dans les yeux de l'artiste. Tu n'as pas de contrariétés."
                                            }
                                        ]
                                    }
                                ]
                            }
