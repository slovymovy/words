                "senses": [
                    {
                        "sense_id": "f2d23b33-4323-3281-b7f1-ed1ea8dcac1d",
                        "entry_id": "4a388c9a-4f61-3c43-9e27-3bf90cb4d0d3",
                        "glosses": [
                            "elektrischer Widerstand zwischen den Anschlussklemmen eines Erders und dem Erdreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09c015f4-396f-404e-97b7-ae4864bcb3c9",
                                "sense_id": "f2d23b33-4323-3281-b7f1-ed1ea8dcac1d",
                                "text": "„Vor der Durchführung einer Erdungsmessung sollte man natürlich wissen, wie groß der gemessene Erdungswiderstand sein darf, um noch von einer \"ordnungsgemäßen Erdung\" sprechen zu können.“"
                            },
                            {
                                "example_id": "5b1592a4-4385-4028-aa42-a9cf551d356d",
                                "sense_id": "f2d23b33-4323-3281-b7f1-ed1ea8dcac1d",
                                "text": "„Da der spezifische Widerstand mit zunehmender Bodentiefe meist abnimmt, werden die Erder zur Verringerung des Erdungswiderstands möglichst tief verlegt.“"
                            },
                            {
                                "example_id": "13d841f0-b9ae-4fd0-ad13-ae6e7567117b",
                                "sense_id": "f2d23b33-4323-3281-b7f1-ed1ea8dcac1d",
                                "text": "„Bei einem gemessenen Erdungswiderstand von 7,4 Ohm ist mit einem Wert von 10 Ohm zu rechnen.“"
                            },
                            {
                                "example_id": "aeabb16b-d027-4aad-86eb-1906d63bea09",
                                "sense_id": "f2d23b33-4323-3281-b7f1-ed1ea8dcac1d",
                                "text": "„Der Erdungswiderstand wird zwischen Bezugserde und dem Anschlusspunkt der Erdungsanlage gemessen und muss möglichst niederohmig sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
