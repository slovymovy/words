                "senses": [
                    {
                        "sense_id": "dd2bfa7a-d5ed-331f-965b-df4664dcb2de",
                        "entry_id": "63c5c4c4-f981-38f3-9a26-6c9e9dcd08f5",
                        "glosses": [
                            "Donner un caractère plurilatéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ba2f9e-b554-41e3-8c50-2a8e8115f7aa",
                                "sense_id": "dd2bfa7a-d5ed-331f-965b-df4664dcb2de",
                                "text": "Plurilatéraliser le traité commercial entre l’Union européenne et les États-Unis et accompagner la libéralisation des échanges"
                            },
                            {
                                "example_id": "f32543fb-1d50-47f9-83de-4a0211ce030f",
                                "sense_id": "dd2bfa7a-d5ed-331f-965b-df4664dcb2de",
                                "text": "D'où la question, qui surgit souvent chez les décideurs politiques: pourquoi ne pas «plurilatéraliser» les concessions faites, afin de bénéficier de la protection du droit contenu dans l’AMP ainsi que des opportunités offertes par les concessions faites par les parties?"
                            },
                            {
                                "example_id": "325170a3-04b4-406c-aaa1-99592586be42",
                                "sense_id": "dd2bfa7a-d5ed-331f-965b-df4664dcb2de",
                                "text": "Enfin, cette approche est maintenue dans la négociation d’accords sectoriels, quoique sous une forme modifiée et « plurilatéralisée »."
                            }
                        ]
                    }
                ],
