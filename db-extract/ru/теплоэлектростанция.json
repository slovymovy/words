                    {
                        "translation_id": "090f7cd3-e3f9-46c1-a4b9-32c644ff78ab",
                        "source_entry_id": "cc5fda16-0d17-3357-ad37-49a262494d39",
                        "source_sense_id": "70e8a7cf-454c-3bad-ba5c-0dabfbcf474a",
                        "target_lang_word": "Fernwärmekraftwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernwärmekraftwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79dec4af-24a9-3a9a-a624-0bcdaacecf13",
                                        "entry_id": "3aad18b7-e362-385d-b6c7-18ca2ce889c9",
                                        "glosses": [
                                            "Kraftwerk, das der Erzeugung von Fernwärme dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc36f6bb-ef8c-42a8-a6bb-2a9ea86669b1",
                                                "sense_id": "79dec4af-24a9-3a9a-a624-0bcdaacecf13",
                                                "text": "Mit einem Fernwärmekraftwerk kann man ganze Siedlungen mit Wärme versorgen."
                                            },
                                            {
                                                "example_id": "b19059d5-bce4-44ea-8822-cd1473df9b88",
                                                "sense_id": "79dec4af-24a9-3a9a-a624-0bcdaacecf13",
                                                "text": "„Der im Kraftwerk Scholven produzierte Strom deckt etwa 3% des deutschen Strombedarfes. Die Blöcke B - F, das Fernwärmekraftwerk Buer (FWK) und das Dampfwerk Scholven (DWS) liefern Dampf an benachbarte Chemiebetriebe und Fernwärme an einige umliegende Städte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e7041d6-7639-4543-a742-88393327b031",
                        "source_entry_id": "cc5fda16-0d17-3357-ad37-49a262494d39",
                        "source_sense_id": "70e8a7cf-454c-3bad-ba5c-0dabfbcf474a",
                        "target_lang_word": "Heizkraftwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heizkraftwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30e8ad29-fd29-33de-aea9-d5a809322630",
                                        "entry_id": "506f0927-296d-3fbf-9db0-20d4f7dc591c",
                                        "glosses": [
                                            "Kraftwerk, das außer Strom auch Wärme zum Heizen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2c9d8e-944d-4fc6-a4e2-64efd743b363",
                                                "sense_id": "30e8ad29-fd29-33de-aea9-d5a809322630",
                                                "text": "„Heizkraftwerke (HKW) können als modifizierte thermische Kraftwerke angesehen werden: In einem thermischen Kraftwerk wird Wärme durch die Verbrennung fossiler Brennstoffe, durch einen Kernreaktor oder durch die Sonne erzeugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6391e1ed-f36c-4ac1-a66f-fbd82ae1a969",
                        "source_entry_id": "cc5fda16-0d17-3357-ad37-49a262494d39",
                        "source_sense_id": "70e8a7cf-454c-3bad-ba5c-0dabfbcf474a",
                        "target_lang_word": "Heizwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heizwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "075d47db-7208-3fbe-9931-95f6729a1612",
                                        "entry_id": "4e67a984-b110-3adb-a7c8-d7b82de75ab7",
                                        "glosses": [
                                            "größere Heizanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8bc691f-25fa-458e-aac3-40e61d53cfa7",
                                                "sense_id": "075d47db-7208-3fbe-9931-95f6729a1612",
                                                "text": "Das Heizwerk wurde in einer Rekordzeit von eineinhalb Jahren fertiggestellt."
                                            },
                                            {
                                                "example_id": "61c553b8-d01c-4eb4-a077-73e7d9b901da",
                                                "sense_id": "075d47db-7208-3fbe-9931-95f6729a1612",
                                                "text": "„Die Sprecher der IG in spe sind sicher, dass auf dem Weg vom Heizwerk an der Mörfelder Landstraße bis zu den Häusern sehr viel Energie verloren geht.“"
                                            }
                                        ],
