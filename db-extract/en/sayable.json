                        ],
                        "form": "more sayable"
                    },
                    {
                        "form_id": "884df01f-0091-4f59-8443-63ced15a894f",
                        "entry_id": "aa27afc4-758b-372c-a61b-879d90dc6f3e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most sayable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c610b0f-5bd5-33fb-a22c-6ffd838537ab",
                        "entry_id": "aa27afc4-758b-372c-a61b-879d90dc6f3e",
                        "glosses": [
                            "Capable of being pronounced or uttered; articulable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084e9379-a2ff-4360-ae0b-0db395878c5d",
                                "sense_id": "6c610b0f-5bd5-33fb-a22c-6ffd838537ab",
                                "text": "Rimbaud is the enfant terrible who burns through the sayable; Oppen is the poet of the left whose quiet is a sign of commitment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6652a1d3-3204-4967-9d75-a977b9af8f96",
                        "source_entry_id": "aa27afc4-758b-372c-a61b-879d90dc6f3e",
                        "source_sense_id": "6c610b0f-5bd5-33fb-a22c-6ffd838537ab",
                        "source_sense_description": "Translations",
                        "target_lang_word": "dicible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dicible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                        "entry_id": "0c909467-4dd2-3468-9f63-3e77111efb27",
                                        "glosses": [
                                            "Qui peut être dit ; qui est exprimable par des mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c62247-c5bf-45cf-80c6-b929b6fe7805",
                                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                                "text": "Comme toute voie est viable, toute parole est dicible."
                                            },
                                            {
                                                "example_id": "375344fe-9001-4a5e-b019-d50059c1afb7",
                                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                                "text": "Et ce quelque chose est dicible d'une certaine façon, d'où les affres que je vous fais partager au séminaire."
                                            },
                                            {
                                                "example_id": "f796b6b1-773a-4d94-a533-b71144ac1cfa",
                                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                                "text": "Passer par un acte de mutation de ce qui dans la pensée se déclare dicible à ce qui, à un moment donné, devient chose dite est ce dont la parole est chargée. Cette mutation constitue un acte d'expression, […]."
                                            },
                                            {
                                                "example_id": "3f243979-6636-42a7-aa45-589f85453f67",
                                                "sense_id": "b6851951-5a34-3298-952b-aa2400ecaa55",
                                                "text": "Le conscient élémentaire non verbal n'est évidemment pas toujours directement dicible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dicible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d33c0978-73f8-353f-be34-0f2e8a26ebd0",
                                        "entry_id": "5b5cccc0-6d1e-3596-8331-38f99c79cd06",
                                        "glosses": [
                                            "Ce qui peut s'exprimer, ce qui est nommable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e1947e6-c214-4d8b-a0da-384052277168",
                                                "sense_id": "d33c0978-73f8-353f-be34-0f2e8a26ebd0",
                                                "text": "Les discours et les institutions étaient en retard sur nos désirs mais le fossé entre le dicible de la société et notre indicible nous paraissait normal et irrémédiable […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c1a445e-c385-4e8d-b40e-05302602d77f",
                        "source_entry_id": "aa27afc4-758b-372c-a61b-879d90dc6f3e",
                        "source_sense_id": "6c610b0f-5bd5-33fb-a22c-6ffd838537ab",
