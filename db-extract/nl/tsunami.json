                "senses": [
                    {
                        "sense_id": "ac9a6a85-5dcf-3763-abc3-039331643450",
                        "entry_id": "f997a267-8b23-3410-b336-a288a28b4ec4",
                        "glosses": [
                            "een grote vloedgolf door een aardbeving veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81add629-c0ad-44a0-9ddf-26ba8cfd5125",
                                "sense_id": "ac9a6a85-5dcf-3763-abc3-039331643450",
                                "text": "In dat gebied was laatst een grote tsunami."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5b49f3a-acf8-4937-a5b8-ab0153928d23",
                        "source_entry_id": "f997a267-8b23-3410-b336-a288a28b4ec4",
                        "source_sense_id": "ac9a6a85-5dcf-3763-abc3-039331643450",
                        "source_sense_description": "een grote vloedgolf",
                        "target_lang_word": "Tsunami",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tsunami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ef9dbdc-2f49-32ba-b3d8-60813b54f010",
                                        "entry_id": "cec7f672-6802-3eae-aa97-3ce01f629ac0",
                                        "glosses": [
                                            "eine seismische Meereswoge, die überwiegend durch Seebeben, also durch unterseeische Erdbeben ausgelöst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5406be0d-7fdf-433f-823f-d55bfb4806f4",
                                                "sense_id": "4ef9dbdc-2f49-32ba-b3d8-60813b54f010",
                                                "text": "Beim Tsunami von Weihnachten 2004 kamen Hunderttausende ums Leben."
                                            },
                                            {
                                                "example_id": "70da5676-3616-4bdf-b6db-086430298010",
                                                "sense_id": "4ef9dbdc-2f49-32ba-b3d8-60813b54f010",
                                                "text": "„Stillstehende Züge gehören für Holländer nun mal zu den Schicksalsschlägen, die über die Menschheit hereinbrechen wie Tsunamis oder Taubenschwärme.“"
                                            },
                                            {
                                                "example_id": "4b7b74e0-ef18-4332-9e4b-4c0782b145c6",
                                                "sense_id": "4ef9dbdc-2f49-32ba-b3d8-60813b54f010",
                                                "text": "„Als am 26. Dezember 2004 der Tsunami über Südostasien hereinbrach, war ich im Thailand.“"
                                            },
                                            {
                                                "example_id": "ab770b07-f118-4924-a9f6-93c851c5fa1f",
                                                "sense_id": "4ef9dbdc-2f49-32ba-b3d8-60813b54f010",
                                                "text": "„Immer hatte ich mich in Tsunamis, Lawinen oder Waldbränden als Überlebender imaginiert.“"
                                            },
                                            {
                                                "example_id": "5796c781-a68a-4f1e-a5fa-cee1014e3941",
                                                "sense_id": "4ef9dbdc-2f49-32ba-b3d8-60813b54f010",
                                                "text": "„Als 2011 ein Tsunami Fukushima traf und einen GAU auslöste, hatte Angela Merkel längst bekannt gegeben, dass sie Atomkraft für alternativlos hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90f7a534-7bbf-4c21-a66a-3930715e860d",
                        "source_entry_id": "f997a267-8b23-3410-b336-a288a28b4ec4",
                        "source_sense_id": "ac9a6a85-5dcf-3763-abc3-039331643450",
                        "source_sense_description": "een grote vloedgolf",
                        "target_lang_word": "tsunami",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsunami",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "992398b4-b0ca-3529-b677-3d00d14b1f57",
                                        "entry_id": "9ff75ff0-3212-3389-8230-5b7c4f018d69",
                                        "glosses": [
                                            "A very large and destructive wave, generally caused by a tremendous disturbance in the ocean, such as an undersea earthquake or volcanic eruption; often a series of waves (a wave train)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4199b7f6-ab02-4475-b093-bc12568e6589",
                                                "sense_id": "992398b4-b0ca-3529-b677-3d00d14b1f57",
                                                "text": "A tsunami struck Japan recently."
                                            },
                                            {
                                                "example_id": "0a6b2ba0-ec5c-4891-a638-ba3e7f1068a1",
                                                "sense_id": "992398b4-b0ca-3529-b677-3d00d14b1f57",
                                                "text": "A wave simulator in the tank can re-enact tsunamis and northeasters, and imitate wave conditions from midocean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                                        "entry_id": "9ff75ff0-3212-3389-8230-5b7c4f018d69",
                                        "glosses": [
                                            "A large and generally unstoppable surge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c97b58-2a45-4df4-9541-a1d80eb25ed8",
                                                "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                                                "text": "It seemed that what started out as a handful of isolated cases gradually turned into a tsunami of complaints."
                                            },
                                            {
                                                "example_id": "90c9e21c-e9dd-4092-8701-09702ab19f00",
                                                "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                                                "text": "It set off a tsunami of debate among the more esoteric critics, who either loved it or hated it but could not ignore it."
                                            },
                                            {
                                                "example_id": "69762a97-5ca1-4dc6-bbe6-70286f6f664a",
                                                "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                                                "text": "The next decade would culminate in a tsunami of legislation, civil litigation, and criminal prosecutions in which assisted suicide was both criminalized (as in Michigan) and decriminalized (as in Oregon)."
                                            },
                                            {
                                                "example_id": "67bc3b2c-5e2e-469a-a65e-580b1e52c089",
                                                "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                                                "text": "The editor paid a heavy price - he was subsequently compelled to offer a grovelling and humiliating personal apology, following a tsunami of protest."
                                            },
                                            {
                                                "example_id": "f1653bd3-e945-49e4-8a6a-37e42d71273f",
                                                "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                                                "text": "Sadly, [Anna] Wintour did not control the weather, which was disappointingly inclement. But, no matter, because the event was awash with a “tsunami of love”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5d52bb-57f2-41d2-a353-a2bbe796617a",
                        "source_entry_id": "f997a267-8b23-3410-b336-a288a28b4ec4",
                        "source_sense_id": "ac9a6a85-5dcf-3763-abc3-039331643450",
                        "source_sense_description": "een grote vloedgolf",
                        "target_lang_word": "tsunami",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsunami",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be46be4b-5318-3a96-84b7-505b935f6f31",
                                        "entry_id": "d7c9d24f-3db0-34e6-91e7-525ea350b0d5",
                                        "glosses": [
                                            "Énorme vague causée par un évènement géologique comme un séisme ou une éruption volcanique ou astronomique comme un météorite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d3936b-8e09-466b-9cf0-a450cf7d857c",
                                                "sense_id": "be46be4b-5318-3a96-84b7-505b935f6f31",
                                                "text": "Le tsunami de décembre 2004 a balayé l’Asie du Sud-Est."
                                            },
                                            {
                                                "example_id": "1b7d108e-4a7a-49fd-90f5-7b03bbe283a1",
                                                "sense_id": "be46be4b-5318-3a96-84b7-505b935f6f31",
                                                "text": "J’ignorais que la ville avait été dévastée par un tsunami, deux ans plus tôt, et qu’il ne restait plus grand-chose pouvant éveiller l’intérêt du touriste de passage."
                                            },
                                            {
                                                "example_id": "559ae241-3bb5-44c9-9e57-35af239df368",
                                                "sense_id": "be46be4b-5318-3a96-84b7-505b935f6f31",
                                                "text": "Le tsunami [que le mégaséisme] provoqua dévasta non seulement les côtes chiliennes, mais déferla aussi à Hawaii, au Japon, aux Philippines, en Nouvelle-Zélande orientale, en Australie du Sud-Est et jusque dans les îles Aléoutiennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0332583c-e97d-35fe-b9e5-ca8eac51bb5d",
                                        "entry_id": "d7c9d24f-3db0-34e6-91e7-525ea350b0d5",
                                        "glosses": [
                                            "Afflux, mouvement important et spontané."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a314a1-9c96-4f97-b6cb-813fd890a1b5",
                                                "sense_id": "0332583c-e97d-35fe-b9e5-ca8eac51bb5d",
                                                "text": "Cet hiver, la cinquième vague de Covid-19 due au variant delta s’est transformée en tsunami de cas, avec l’arrivée du très contagieux omicron début décembre."
                                            },
                                            {
                                                "example_id": "6b801924-048a-4eab-97ee-d6085097b707",
                                                "sense_id": "0332583c-e97d-35fe-b9e5-ca8eac51bb5d",
                                                "text": "« Quand vous avez une augmentation des prix de 100 %, c’est un tsunami », s’inquiète M. Lavazza."
                                            },
                                            {
                                                "example_id": "33f4c6ee-0b05-4cab-85b6-5b886a30fef2",
                                                "sense_id": "0332583c-e97d-35fe-b9e5-ca8eac51bb5d",
                                                "text": "Et le « tsunami » de 89 députés du Rassemblement national – qui multiplie par 11 le nombre de ses députés – va donner un nouvel élan aux nationalistes identitaires français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
