                                                "example_id": "616f68e1-9464-470e-8551-8aba84d4aaf9",
                                                "sense_id": "eacd8e62-77f2-3575-a30e-0cff5fccabb8",
                                                "text": "su arrogancia ante el peligro me fascinaba."
