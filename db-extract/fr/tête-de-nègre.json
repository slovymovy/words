                    {
                        "sense_id": "b59eb82f-297b-31ac-ac99-d278cab716ad",
                        "entry_id": "67759612-84bf-3e7c-8c8f-27d69a09ee78",
                        "glosses": [
                            "Couleur marron très foncé, tirant sur le noir."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "518fec95-cfa1-491a-ac5f-1d22c627e70c",
                                "sense_id": "b59eb82f-297b-31ac-ac99-d278cab716ad",
                                "text": "Mon gilet très court, en drap rouge soutaché de soie noire, rejoignait à grand-peine un pantalon tête-de-nègre échancré sur la botte, et armé, en guise de sous-pieds, de gourmettes de cuivre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48dac58c-9f75-48ed-99f4-11b02f8eefe0",
                        "source_entry_id": "67759612-84bf-3e7c-8c8f-27d69a09ee78",
                        "source_sense_id": "b59eb82f-297b-31ac-ac99-d278cab716ad",
                        "source_sense_description": "Couleur",
                        "target_lang_word": "nigger-brown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nigger-brown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbb5888-9cc6-3f7b-9670-f8c27dd87ae6",
                                        "entry_id": "5f1cc439-12c5-3b3f-af71-f4fd7f11661b",
                                        "glosses": [
                                            "A dark brown color."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "ethnic",
                                            "offensive",
                                            "slur",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0624bb0-ebc8-4720-9cef-637a44e86b83",
                                                "sense_id": "6bbb5888-9cc6-3f7b-9670-f8c27dd87ae6",
                                                "text": "Looking at the slight naked figures of various shades from Ng-Gunko's nigger-brown to Sigrid's rich cream, […] I felt that I had strayed into an island of goblins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nigger-brown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b41cef6e-d012-3ec8-9761-8f1df431fa7e",
                                        "entry_id": "4354048e-1c2c-3bdf-b4fa-49311c73f01f",
                                        "glosses": [
                                            "Having a dark brown colour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d99c1800-7fc5-4bbc-93de-1128d134b316",
                                                "sense_id": "b41cef6e-d012-3ec8-9761-8f1df431fa7e",
                                                "text": "She is on the sofa, knitting a nigger-brown jumper which looks as if it will be quite successful."
                                            },
                                            {
                                                "example_id": "1b1b150c-a492-4723-afff-58309648dac7",
                                                "sense_id": "b41cef6e-d012-3ec8-9761-8f1df431fa7e",
                                                "text": "Fireplace, AT LEFT, tiled with nigger-brown briquettes."
                                            },
                                            {
                                                "example_id": "28a93fbd-2e6a-4b28-8c6d-ff09b5a33e04",
                                                "sense_id": "b41cef6e-d012-3ec8-9761-8f1df431fa7e",
                                                "text": "The walls and ceiling of this drawing-room in Montague Square are painted ivory. The modern sofa built on classical lines is covered in nigger brown striped moire and fringed all round with brown and white spaced fringe […]"
                                            },
                                            {
                                                "example_id": "23c0b902-86c4-45b8-8159-8f1d76bb095a",
                                                "sense_id": "b41cef6e-d012-3ec8-9761-8f1df431fa7e",
                                                "text": "The first class compartments are trimmed below the waist with grained nigger-brown leather cloth and above with beige leather cloth with a nigger brown band behind the chromium-plated luggage racks."
                                            },
                                            {
                                                "example_id": "ba97c5df-9f52-4439-8b9f-e1e97c227ed0",
                                                "sense_id": "b41cef6e-d012-3ec8-9761-8f1df431fa7e",
                                                "text": "We have a three-piece suite upholstered in nigger-brown velvet […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
