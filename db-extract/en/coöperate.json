                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30d50e06-000b-4f9a-bf04-0b3941d37298",
                                "sense_id": "0e008978-bab0-3c7f-a2fd-12d086cb0c64",
                                "text": "The best progress is made by combining the practice of coöperation with the science of coöperation. They are one and inseparable to the fullest benefit. But the real way to coöperate is to coöperate."
                            },
                            {
                                "example_id": "5f9450b4-90e9-4e6c-a491-37a56234a328",
                                "sense_id": "0e008978-bab0-3c7f-a2fd-12d086cb0c64",
                                "text": "Other bodies of Federal troops had advanced into Virginia to coöperate with the main force on the Peninsula. [...] This would completely insure the communications of his army from interruption; and it was no doubt expected that Generals Fremont and Banks would coöperate in the movement also."
                            },
                            {
                                "example_id": "f296ecc2-18b4-4d00-8ca8-0d5be7182fc0",
                                "sense_id": "0e008978-bab0-3c7f-a2fd-12d086cb0c64",
                                "text": "Zeldin imagined Mueller taking such a step to pressure Manafort to coöperate."
                            }
                        ]
                    }
