                        "entry_id": "c9b12b7f-4eb9-3a11-8ebd-01b5337158fa",
                        "glosses": [
                            "Without pity."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e27cdffc-866d-4144-bba7-547ac9c6bbc0",
                                "sense_id": "df3923f2-61b9-37bc-a130-7603db6794c6",
                                "text": "If avarice be thy vice, yet make it not thy punishment. Miserable men commiserate not themselves, bowelless unto others, and merciless unto their own bowels."
                            },
                            {
                                "example_id": "cd5cfb60-ffed-4c7b-90db-6b9a27f11410",
                                "sense_id": "df3923f2-61b9-37bc-a130-7603db6794c6",
                                "text": "1792, “Louis XIV,” The European Magazine and London Review, Volume 22, July 1792, p. 8,\nOn his coffin at St. Denis, by the side of which stands the urn that contains his bowels, some one wrote,\nC’y gyst sans entrailles,\nComme il etoit à Versailles.\nWhat little change in men by death is made!\nLouis the Great here bowelless is laid;\nSuch as he play’d the tyrant’s lofty part\nAt proud Versailles, and liv’d without a heart."
                            }
                        ]
                    }
