                "senses": [
                    {
                        "sense_id": "19170141-1d04-3439-93f5-a089fd16c6a3",
                        "entry_id": "d4b8b299-c02f-37d3-b7b2-2994a69b3dfc",
                        "glosses": [
                            "een kanon waarmee grotere projectielen kunnen worden afgevuurd; stuk geschut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a3d7c6-6e12-42ef-9a49-032876c367c1",
                                "sense_id": "19170141-1d04-3439-93f5-a089fd16c6a3",
                                "text": "Het leger van Kim Jong-Un beschikt op papier over een enorme hoeveelheid tanks, gepantserde voertuigen en kanonnen. Maar liefst 4300 stuks geschut zou de despoot hebben waarvan de vuurmonden vooral richting het zuiden gericht staan. Net als een arsenaal conventionele langeafstandsraketten; vooral Russische Scuds."
                            },
                            {
                                "example_id": "dff6a8fc-fcdf-4ba2-9e85-866aaa58e999",
                                "sense_id": "19170141-1d04-3439-93f5-a089fd16c6a3",
                                "text": "Marinier '2D' besloot veertig jaar geleden tijdens de Molukse treinkaping in een fractie van een seconde te schieten op een menselijke beweging die hij rechts in de hoek van de treincoupé zag. Vlak daarvoor was hij zelf beschoten vanuit die hoek. Hij merkte dat doordat hij een vuurmond zag en een schampschot op zijn helm voelde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73487b04-72a0-45fc-b9ca-7aa6d80c686b",
                        "source_entry_id": "d4b8b299-c02f-37d3-b7b2-2994a69b3dfc",
