                "senses": [
                    {
                        "sense_id": "f14d6d5d-9f26-3420-9b3d-64bed5919aa0",
                        "entry_id": "49d44230-ecb3-3120-af74-0a0d87c99820",
                        "glosses": [
                            "vertelsel waarin men slechte dingen over iemand zegt zonder dat deze zaken bewezen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e409863f-3a5a-4763-bf96-29f93d0d41b6",
                                "sense_id": "f14d6d5d-9f26-3420-9b3d-64bed5919aa0",
                                "text": "Bewogen slechts door het ootmoedige oogmerk te verstrooien sprak hij voort, hij verhaalde van de grote audiëntie aan het Hof; gewaagde van de bedelbroertjes op het plein, de opkomst van de Majesteit, de val van Bergen op Zoom en Ypeys lasterpraat, alles schilderend met het kleurigste palet, als voor een blinde."
                            },
                            {
                                "example_id": "69a9770f-d70f-40f6-8e95-b6f71f65e4ef",
                                "sense_id": "f14d6d5d-9f26-3420-9b3d-64bed5919aa0",
                                "text": "De delen die gebaseerd zijn op racistische vooroordelen, religieuze en seksuele lasterpraat, mag Böhmermann niet meer herhalen. De zinnen over Erdogans politieke optreden mogen wel."
                            }
                        ]
                    }
