                "senses": [
                    {
                        "sense_id": "4d0f5d23-eed6-3eca-92ee-3fb7981b5934",
                        "entry_id": "4455d91a-1390-3f45-b93c-c4aab7ebf83e",
                        "glosses": [
                            "Autre orthographe de guillemeter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6509bd5-4421-4f76-b3fc-62b9f63657ce",
                                "sense_id": "4d0f5d23-eed6-3eca-92ee-3fb7981b5934",
                                "text": "Un médecin, qui écrivait un essai sur une maladie nerveuse, inscrit sur les épreuves typographiques qu’il corrigeait :\n— Il faut guilleméter tous les alinéas.\nLorsqu’il revit son œuvre imprimée, elle se terminait ainsi :\n— Il faut guillotiner tous les aliénés."
                            },
                            {
                                "example_id": "3572eb75-57cc-4cd8-ab9a-87ae7e09380b",
                                "sense_id": "4d0f5d23-eed6-3eca-92ee-3fb7981b5934",
                                "text": "Là, après une vague référence, on met à contribution le travail d’un écrivain dont on reproduit le texte, sans le guilleméter, et les figures, sans plus spécifier la source."
                            }
                        ]
                    }
