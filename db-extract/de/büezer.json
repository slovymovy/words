                "senses": [
                    {
                        "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                        "entry_id": "ee2ed9de-25ea-3ae7-bb15-b069026f5a4d",
                        "glosses": [
                            "jemand, der zum Lohnerwerb einer körperlichen oder handwerklichen Tätigkeit nachgeht und in historischer Sichtweise zur Arbeiterklasse zählt, in verallgemeinernder Bedeutung auch übergehend in die Bedeutung einfacher, macht- und einflussloser Mensch"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0351ca-fd30-47ca-bcce-1c24a704b541",
                                "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                                "text": "„Was? […] du wosch doch nid zur Bahn un e Büetzer [sic] wärde! Du wosch doch lieber e Buur sy oder ömel e Fasch-Buur!“ [Was? Du willst doch nicht zur Bahn und ein Büezer werden! Du willst doch lieber ein Bauer sein oder jedenfalls ein Fast-Bauer!]"
                            },
                            {
                                "example_id": "11d36b1f-2534-4f7c-a1c8-8ef35ac33946",
                                "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                                "text": "„Dr Hans Bläsi het am enen Ort in ere Kolonie in Afrika e Schtell agnoh als junge, tatedurschtige Koufmaa, u dr Ruedi Oerli isch als Büetzer [sic] vo eim Ort a ds andere i dr Wält ume züglet.“ [Hans Bläsi nahm an einem Ort in einer Kolonie in Afrika eine Stelle an als junger, tatendurstiger Kaufmann, und Rudi Oerli zog als Büezer von einem Ort an den anderen in der Welt herum.]"
                            },
                            {
                                "example_id": "0907a0b3-1bf8-4ab9-95e0-c8108f884a30",
                                "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                                "text": "„Nicht die «Zürichbergleute» [Zürichs Oberschicht und oberer Mittelstand] müssten [es] in erster Linie […] als Ungerechtigkeit empfinden, wenn […] rare billige Wohnungen zum Nutzen von ganz wenigen noch zusätzlich verbilligt werden, sondern der krampfende Büezer, der auch für eine Genossenschaftswohnung in der Regel etliches mehr blecht.“"
                            },
                            {
                                "example_id": "65aac7c3-b5b6-4973-a2b4-5960268e7a34",
                                "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                                "text": "„Ich finde es ungerecht, wenn ein Lottomillionär keine Steuern zahlen und ein normaler ‚Büezer‘ seinen Lohn von 5000 Franken als Einkommen versteuern muss.“"
                            },
                            {
                                "example_id": "23c4e240-c4f9-40c6-89f0-f797af4557cc",
                                "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                                "text": "„Der ‚Sonntagsblick‘ machte damals [1998] eine Videoumfrage auf der Strasse und wollte wissen, was die Leute von einem Büezer hielten. Ausnahmslos alle Befragten fanden den Büezer eine positive Figur.“"
                            },
                            {
                                "example_id": "6118488d-2252-4025-a380-a9f06d29c52e",
                                "sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                                "text": "„Beizen für Büezer! Die Petition fordert: Restaurants sollen während des Lockdowns als Kantinen betrieben werden dürfen. Sie öffnen ab sofort für Berufsleute, die draussen arbeiten!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1b71497-f249-3e53-93a2-d33bf37fe459",
                        "entry_id": "ee2ed9de-25ea-3ae7-bb15-b069026f5a4d",
                        "glosses": [
                            "Person, die Kleidung ausbessert, flickt"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "ad308832-4644-40e5-958f-590397b7401c",
                                "sense_id": "e1b71497-f249-3e53-93a2-d33bf37fe459",
                                "text": "„Büetzer, Der ein Ding wider macht. Refector, Sarcinator.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c534a2e-661e-4ae5-aa2a-fed93b618955",
                        "source_entry_id": "ee2ed9de-25ea-3ae7-bb15-b069026f5a4d",
                        "source_sense_id": "8a240bf5-adfe-3713-a88e-1de0ede43acb",
                        "source_sense_description": "jemand, der zum Lohnerwerb einer körperlichen oder handwerklichen Tätigkeit nachgeht",
                        "target_lang_word": "worker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "One who works: a person who performs labor for a living; traditionally, especially, manual labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13711fdb-2e40-46b9-80e0-247a5e15e7eb",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Near-synonym: employee"
                                            },
                                            {
                                                "example_id": "5a6399c5-0b3f-4ae8-b142-5fa2bb33b805",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Fret not thy ſelfe becauſe of euill doers, neither bee thou enuious againſt the workers of iniquitie."
                                            },
                                            {
                                                "example_id": "fbc7e998-979d-49b3-b47c-2996222eeb64",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Writer Ta Chen, in a statistical study of industrial labor in China in 1933, recorded that 66.6 percent of the total number of workers in the four main industrial regions of Kwangtung were women. In Shun-te, 81.2 percent of the labor force were women."
                                            },
                                            {
                                                "example_id": "68875285-4c6f-47f6-81e0-48c104c9ee14",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese […] began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death. Nowadays workers are exposed to far lower doses and manganism is rare."
                                            },
                                            {
                                                "example_id": "9f6a7db4-d29c-4779-b9f9-7c7fad265f74",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Although the radiation levels identified are high, a threat to human health is very unlikely because apart from workers at the site, no-one goes there."
                                            },
                                            {
                                                "example_id": "455b28ad-223f-4925-b8b4-8ab3789d13cc",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "That would allow employers to keep some tip money for themselves, as long as each worker made at least the full federal minimum wage of $7.25 an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de39e866-8ea3-3fd0-8c54-2ae731a05a99",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a901efe-a474-3783-a606-47ae4f5de623",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp.",
                                            "A female ant, bee, termite or wasp."
                                        ],
                                        "tags": [
