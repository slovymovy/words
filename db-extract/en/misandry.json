                                        "entry_id": "9cc9f49e-487c-3cfd-b1ae-7ae7135c6f07",
                                        "glosses": [
                                            "Actitud de sumisión que el machismo espera de una mujer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ace184b-b7fd-4b03-853c-e744336941cc",
                                                "sense_id": "8bd2bdaa-cd8a-3e15-89bd-bf8bb0be34f1",
                                                "text": "El machismo es el rol de dominador que el varón perpetúa, mientras que el hembrismo es el rol de dominada que reproducen las mujeres"
