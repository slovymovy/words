                        "examples": [
                            {
                                "example_id": "ca8cf5a5-0468-49ee-a818-b6b2e634a318",
                                "sense_id": "68e1045f-09fd-3cd1-b38d-e3419a55edec",
                                "text": "„Für Befremdung sorgt der angebliche Raub eines mit einer Million Euro gefüllten Geldkoffers in Italien, mit dem Haberleitner vermeintliche Geschäftspartner dazu bewegen wollte, bei Dayli 25 Millionen Euro zu investieren.“"
                            },
                            {
                                "example_id": "01b0d12d-2f5e-49d3-b0f1-74b363fbf924",
                                "sense_id": "68e1045f-09fd-3cd1-b38d-e3419a55edec",
                                "text": "„Die Geschichte mit dem Geldkoffer ist von einer Reihe seltsamer Umstände begleitet, die auf jeden Fall den Verdacht nähren, dass es sich nicht um eine legale finanzielle Transaktion gehandelt haben kann - im Übrigen schon deshalb nicht, weil jeder Barbetrag über zehntausend Dollar bei der Einfuhr nach Argentinien deklariert werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
