                        "glosses": [
                            "Variante orthographique de crêpelure."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "9a36a639-b59d-41e6-9ffb-003e9827c7be",
                                "sense_id": "a8679833-0b52-34f6-b539-98ff24089529",
                                "text": "Derrière elle, une figure épaisse et deux gros yeux ternes d’homme suaient l’angoisse sous la crépelure d’une tignasse laineuse."
                            },
                            {
                                "example_id": "fa97170c-a926-4d7f-9fc4-936fe064245c",
                                "sense_id": "a8679833-0b52-34f6-b539-98ff24089529",
                                "text": "— Tu es assez dépeignée pour la chanter au naturel, dit Clarisse, non sans aigreur, à la jeune fille, dont les cheveux, en effet, laissaient leur noire crépelure pendre sur ses épaules, impatiemment."
                            },
                            {
                                "example_id": "33c008ff-6b4a-47b5-afac-dea19d1c3c43",
                                "sense_id": "a8679833-0b52-34f6-b539-98ff24089529",
                                "text": "La crépelure domptée de ses cheveux châtains se révélait, quand même, en petites ondes qui accrochaient la lumière, en vapeur dorée sur la nuque et près des oreilles."
                            }
                        ]
                    }
                ],
