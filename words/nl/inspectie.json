                    "sense_id": "01a2fe4c-ff0d-31c2-9798-f9b3475ad1de",
                    "sense_definition": "Een grondige en nauwkeurige controle om de toestand van iets vast te stellen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>inspectie</w> werd uitgevoerd door twee heren van de politie.",
                            "target_lang_translations": {
                                "en": "The <w>inspection</w> was carried out by two gentlemen from the police.",
                                "ru": "<w>Проверка</w> была проведена двумя сотрудниками полиции.",
                                "zh": "这次<w>检查</w>是由两位警官执行的。"
                            }
                        },
                        {
                            "text": "Voor de verkoop moet de auto een technische <w>inspectie</w> ondergaan.",
                            "target_lang_translations": {
                                "en": "Before the sale, the car must undergo a technical <w>inspection</w>.",
                                "ru": "Перед продажей автомобиль должен пройти технический <w>осмотр</w>.",
                                "zh": "在出售前，这辆车必须通过技术<w>检验</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "controle",
                        "keuring",
                        "onderzoek"
                    ],
                    "common_phrases": [
                        "inspectie uitvoeren",
                        "technische inspectie",
                        "aan een inspectie onderwerpen"
                    ],
                    "target_lang_definitions": {
                        "en": "A thorough and accurate check to determine the condition of something.",
                        "ru": "Тщательная проверка для установления состояния чего-либо",
                        "zh": "为确定某事物的状况而进行的彻底且准确的检查。"
                    },
