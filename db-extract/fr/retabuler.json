                "senses": [
                    {
                        "sense_id": "67fb5b87-0705-3892-8a24-799f90946b55",
                        "entry_id": "1ff05ef1-676a-3a56-ac4a-7afbcfb8fb6f",
                        "glosses": [
                            "Tabuler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a739b9e5-cb68-4450-a796-fb5317374061",
                                "sense_id": "67fb5b87-0705-3892-8a24-799f90946b55",
                                "text": "Les banques de données se remplissent aujourd'hui beaucoup plus rapidement, si bien que la charge de calcul qui consiste à retabuler les occurrences des k-uplets à chaque mise à jour devient prohibitive."
                            },
                            {
                                "example_id": "8576f248-ce9a-45ee-af2d-a14c42709016",
                                "sense_id": "67fb5b87-0705-3892-8a24-799f90946b55",
                                "text": "Au contraire des techniques simples permettant le stockage de données à l'aide de tableurs, les RDB et les OODB permettent de retabuler rapidement de quantités de données, de les trier, de les visualiser et d'effectuer des requêtes sur elles."
                            }
                        ]
                    }
