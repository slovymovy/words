                                                "example_id": "5f844f11-e041-4ee9-83cb-93143515ae07",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "Corps du délit. Voyez « corps »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                        "entry_id": "5498cff8-dcb9-385b-830b-669104ab4c53",
                                        "glosses": [
                                            "Infraction que la loi punit de peines correctionnelles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082c046d-1671-47d7-99ee-179947a3d84e",
                                                "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                                "text": "Individuellement ou en \"petty sessions\", les Magistrats procèdent à la recherche, dans leur voisinage, des contraventions, délits et crimes de toute espèce."
                                            },
                                            {
                                                "example_id": "9fa68e61-2db6-4b88-8226-1a11b02f7165",
                                                "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                                "text": "Mais le chantage est un délit, Monsieur le juge. Il faut l'établir."
                                            },
                                            {
                                                "example_id": "c8b51122-e355-411b-aded-ddae66c81bb6",
                                                "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                                "text": "Mentir devant la représentation nationale, et pas seulement dans une enceinte judiciaire, est un délit."
                                            },
                                            {
                                                "example_id": "a6d1c897-2281-4acd-99c0-cf423ba6185d",
                                                "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                                "text": "Acte de justice –\nSuite au délit de violence\npsychologique et émotionnelle\nen parole,\nvous allez verser\nun dédommagement\nà votre\n…\nassistant personnel virtuel."
                                            }
                                        ]
                                    }
                                ]
                            },
