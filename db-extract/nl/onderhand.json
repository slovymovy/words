                            {
                                "example_id": "fef4752f-8f6c-4fe7-aa69-6cb645bd97f8",
                                "sense_id": "a72b200b-54e4-3b5f-ad0f-a8a8e3b84922",
                                "text": "Veel stamhoofden geloofden Tecumseh niet, zagen niet in dat de blanken ook hún gebieden zouden willen innemen of waren jaloers op zijn populariteit bij jongere krijgers. Daarnaast meenden zij vaak dat 'de blanken' onderhand wel genoeg land bezaten en dat Tecumseh de toekomst veel te zwart inzag."
                            },
                            {
                                "example_id": "2de043d3-29c5-43db-96b9-8d3220c34f8d",
                                "sense_id": "a72b200b-54e4-3b5f-ad0f-a8a8e3b84922",
                                "text": "De leraar had onderhand wel genoeg van alle smoesjes die de leerlingen hadden om geen huiswerk te maken."
                            }
                        ]
                    }
