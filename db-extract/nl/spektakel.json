                "senses": [
                    {
                        "sense_id": "54c17bbe-94e0-3c02-b904-2c37ce36317b",
                        "entry_id": "8601107d-ab49-38f5-8896-c7c66cde79af",
                        "glosses": [
                            "opzienbarend schouwspel, wonderbare vertoning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9526d7d4-468c-40b6-b87f-e18fd8fcef57",
                                "sense_id": "54c17bbe-94e0-3c02-b904-2c37ce36317b",
                                "text": "De festiviteiten werden geopend met een groots spektakel."
                            },
                            {
                                "example_id": "2afede31-49f2-44aa-8351-ae9f0699d01a",
                                "sense_id": "54c17bbe-94e0-3c02-b904-2c37ce36317b",
                                "text": "De kroning van de oudste monarch uit de Britse geschiedenis was in Londen tot in de puntjes georganiseerd. Het moest een spektakel worden, het werd een spektakel. Een ceremonie vol met verwijzingen naar de duizend jaar van koninklijke en religieuze historie."
                            },
                            {
                                "example_id": "786dfa5b-75f9-4c18-9ced-1adc563cbf69",
                                "sense_id": "54c17bbe-94e0-3c02-b904-2c37ce36317b",
                                "text": "In de taxi naar huis, een gewone doorrookte Volvo, in alle discretie, was het een goed gevoel om weg te komen van het spektakel in Riche, ook al voelde het misschien een beetje vreemd om het op Erkki te schuiven."
                            }
                        ]
                    },
                    {
                        "sense_id": "64f584af-df6d-3c7f-97d5-83ff95ab8ee2",
                        "entry_id": "8601107d-ab49-38f5-8896-c7c66cde79af",
                        "glosses": [
                            "opgewonden, luidruchtig gedrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10eb70a1-0371-4274-bb31-a2d23a18273b",
                                "sense_id": "64f584af-df6d-3c7f-97d5-83ff95ab8ee2",
                                "text": "De bestorming van overheidsgebouwen in Brazilië roept de vraag op of meer landen dit soort spektakel wacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3792fe6-1845-4e32-8150-147246dd18e8",
                        "source_entry_id": "8601107d-ab49-38f5-8896-c7c66cde79af",
