                ],
                "senses": [
                    {
                        "sense_id": "d186b915-c6e5-30e7-a070-c2e2e977aad1",
                        "entry_id": "0f91f453-e396-34ca-af82-2761202f1d4b",
                        "glosses": [
                            "Tag im März"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fbc9d01-eb92-4cc6-9518-0c7e1504527f",
                                "sense_id": "d186b915-c6e5-30e7-a070-c2e2e977aad1",
                                "text": "Milena kam an einem Märztag."
                            },
                            {
                                "example_id": "708068d0-31cd-4704-9726-676d1ae619ac",
                                "sense_id": "d186b915-c6e5-30e7-a070-c2e2e977aad1",
                                "text": "„An diesem Märztag kam es im Speisesaal zwischen beiden zu einem Wortwechsel über einen erneut geplanten Besuch von Strouds Bruder.“"
                            },
                            {
                                "example_id": "f0fc1df2-efae-43a1-9952-5327f4ff9401",
                                "sense_id": "d186b915-c6e5-30e7-a070-c2e2e977aad1",
                                "text": "„Ich besuchte ihn an einem sonnigen Märztag in Waldachtal, dem Stammsitz der Fischerwerke.“"
                            },
                            {
                                "example_id": "9954949e-36be-4c3b-9c2f-7ea7715328bd",
                                "sense_id": "d186b915-c6e5-30e7-a070-c2e2e977aad1",
                                "text": "„Die Beerdigung fand an einem kalten, windigen Märztag statt.“"
                            },
                            {
                                "example_id": "01040c0b-aafc-4a45-9d89-001b3900d678",
                                "sense_id": "d186b915-c6e5-30e7-a070-c2e2e977aad1",
                                "text": "„Die ersten Märztage brachten einen milden Vorfrühling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
