                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd45d29e-799e-42f6-8aa5-9f57c69cc212",
                                "sense_id": "d778cec7-4afb-3618-ace3-f960d5302b01",
                                "text": "Les scientologues interrogés martèlent tous le même message: il y a de plus en plus de gens qui s’intéressent à leur «religion»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6004a31c-eb32-4a02-8788-a3e7df2c9aca",
                        "source_entry_id": "5de15dc4-d75b-3ad5-82b9-ba0546c3add0",
