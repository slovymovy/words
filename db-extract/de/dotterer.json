                                "example_id": "a1ff19ea-7620-4b6b-9994-4f5982759fc0",
                                "sense_id": "798ad7b5-eac6-3b60-b5e9-184a0a77f777",
                                "text": "„Kreisgeschäftsführerin Edeltraud Dotterer blickte auf das Jubiläumsjahr, in dem 60 Jahre Landfrauengeschichte im Landkreis Heilbronn gefeiert wurde, mit Freude in den Augen zurück.“"
                            },
                            {
                                "example_id": "d006f85e-012f-412c-be2c-f01e4d75fd8d",
                                "sense_id": "798ad7b5-eac6-3b60-b5e9-184a0a77f777",
                                "text": "„‚Wir haben viele versteckte Talente‘, freut sich Kristina Dotterer.“"
                            }
                        ],
