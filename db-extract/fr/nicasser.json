                        "examples": [
                            {
                                "example_id": "a2c43676-ec34-430f-b6e0-b31e9648572c",
                                "sense_id": "53132f96-5398-3d55-9230-ec272cad2373",
                                "text": "Nous les filles, on nicassait bêtement, armées des premières hormones qui nous titillaient..."
                            },
                            {
                                "example_id": "c0bb7842-d80c-4b7e-bd36-843974839d3f",
                                "sense_id": "53132f96-5398-3d55-9230-ec272cad2373",
                                "text": "Bref, après être passée pour une incompétente à ses yeux, avec la horde de mâles (toujours la même) qui nicassait, il a tout débranché en me prévenant bien que si quelqu’un avait un arrêt cardiaque je n’étais plus couverte !"
                            }
                        ]
                    }
