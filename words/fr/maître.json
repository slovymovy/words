                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "autorité et possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le valet apporte le courrier à son <w>maître</w> chaque matin."
                        },
                        {
                            "text": "Le <w>maître</w> des lieux nous a accueillis dans le grand salon."
                        }
                    ],
                    "synonyms": [
