                                "sense_id": "a82c5fc1-8586-323f-a045-7c1343571468",
                                "text": "Zonder daarbij iets van zijn apathische houding te verliezen, stond Jeroen op van de bank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8404d973-aa31-43ad-9974-caf9dac16942",
                        "source_entry_id": "4fd83f6a-4253-3a01-938b-9e6b82c023d2",
