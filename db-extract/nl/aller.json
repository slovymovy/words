                "senses": [
                    {
                        "sense_id": "e06e5273-4671-3ae7-9029-041198798b4d",
                        "entry_id": "08cdd788-5724-3eae-a677-7ad3778e530b",
                        "glosses": [
                            "van alle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f05dd11e-d23d-4552-9bd1-7adb135f167f",
                                "sense_id": "e06e5273-4671-3ae7-9029-041198798b4d",
                                "text": "In de tweede helft van de twaalfde eeuw kreeg, verspreid over heel Noord-Europa, het omvangrijkste project voor buitenlichtreclame aller tijden gestalte."
                            },
                            {
                                "example_id": "786efdff-a73a-4726-8384-a1edb3389e09",
                                "sense_id": "e06e5273-4671-3ae7-9029-041198798b4d",
                                "text": "Tot op heden is Beethoven nog steeds een van de meest beroemde en meest invloedrijke musici aller tijden."
                            },
                            {
                                "example_id": "a26c0c00-ea8b-480b-a01c-387b1f5c20b4",
                                "sense_id": "e06e5273-4671-3ae7-9029-041198798b4d",
                                "text": "Loffeld, de aardigste aller trainers, die afscheid leemt van zijn lunchende spelers, terwijl voorzitter Aalbers gelaten toehoort."
                            }
                        ]
                    },
                    {
                        "sense_id": "febd89a2-1cbc-313e-9b63-d74e2de1a8bb",
                        "entry_id": "08cdd788-5724-3eae-a677-7ad3778e530b",
                        "glosses": [
                            "bij een bijvoeglijk naamwoord in de overtreffende trap"
                        ],
