                                "target_senses": [
                                    {
                                        "sense_id": "e8c7798c-24b9-355a-b043-e439a1e10683",
                                        "entry_id": "bf580b00-54d3-3b1b-9413-a711bfcd3f51",
                                        "glosses": [
                                            "женск. к специалист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08f6609-55d9-4707-a987-18e458d15d99",
                                                "sense_id": "e8c7798c-24b9-355a-b043-e439a1e10683",
                                                "text": "Я не специалистка по античной литературе, но сотрудники его сектора недовольны."
                                            },
                                            {
                                                "example_id": "78e3c9c5-d43d-48af-b7b7-2b8494baa529",
                                                "sense_id": "e8c7798c-24b9-355a-b043-e439a1e10683",
                                                "text": "Скажем, в Лондоне есть одна индуска, специалистка по кринолинам и тюрнюрам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff73b6ad-bf1d-420f-a6b8-8f1af08717fe",
                        "source_entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                        "source_sense_description": "female doyen",
                        "target_lang_word": "профессиона́лка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "профессиона́лка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ac0ba0-19fe-3913-9414-d035bf38cdaf",
                                        "entry_id": "ac41f85a-e9ad-315a-8dbe-85ae8260e968",
                                        "glosses": [
                                            "женск. к профессионал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2dc38a-3a5c-4734-baa7-bf5372a4f838",
                                                "sense_id": "e2ac0ba0-19fe-3913-9414-d035bf38cdaf",
                                                "text": "Впрочем, как профессионалка, она должна знать понемногу все языки."
                                            },
                                            {
                                                "example_id": "60a6f164-1d23-4164-a726-4106b51241cc",
                                                "sense_id": "e2ac0ba0-19fe-3913-9414-d035bf38cdaf",
                                                "text": "Возможно, как профессионалка, она была и права, но мне почему-то не захотелось с ней разговаривать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
