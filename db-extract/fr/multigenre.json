                                                "example_id": "6fe92bf6-85d0-4760-901e-e92849e799e3",
                                                "sense_id": "8f4e28cf-83c9-34ce-823b-0e51313b3a50",
                                                "text": "Androgyny—the presence of male and female characteristics in one individual. Androgynous individuals describe themselves as ambigender, polygender, or genderless."
                                            }
