                        "entry_id": "499e4178-0b14-33a2-b4b6-a870951893f6",
                        "glosses": [
                            "To remove the surplice (and associated religious status) from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a23e7b3a-cea1-4281-a2da-84fc96a4be1f",
                                "sense_id": "bcbfb842-8fb7-3643-9fa3-fde560448cfa",
                                "text": "If a Wesleyan member in Parliament has the power to unsurplice the priests and deacons of the Church of England, the member of the Church of England may hang the cope upon the shoulders of the Conference."
                            },
                            {
                                "example_id": "a8b4ee93-cc6f-4f49-860c-aa2cfc63ac7e",
                                "sense_id": "bcbfb842-8fb7-3643-9fa3-fde560448cfa",
                                "text": "[…] but Mr. — and such like, might hold an indignation meeting against him for going against the Bishops, if he did not unsurplice his choir and degrade his service to their Dissenting level."
                            }
                        ]
                    }
