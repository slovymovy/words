            {
                "entry_id": "0a644776-d465-306c-829f-5e60cb2d1089",
                "word": "sucrose",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "51f6ad1c-f624-4d75-8695-67d12736f01c",
                        "entry_id": "0a644776-d465-306c-829f-5e60cb2d1089",
                        "tags": [
                            "plural"
