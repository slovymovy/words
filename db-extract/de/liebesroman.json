                "senses": [
                    {
                        "sense_id": "6da7b1d7-6326-3afa-9709-84bdfed2e44c",
                        "entry_id": "2d0595b0-9084-3713-b372-39f6f553ee93",
                        "glosses": [
                            "Roman, dessen Inhalt aus einer Liebesgeschichte besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9e5655-c5b9-4fbb-b104-848c459935ba",
                                "sense_id": "6da7b1d7-6326-3afa-9709-84bdfed2e44c",
                                "text": "Marius verschlingt die Liebesromane seiner Lieblingsautorin stets sofort am Tag des Erscheinens."
                            },
                            {
                                "example_id": "7f834124-3fb3-4b8c-90cf-261a60d04276",
                                "sense_id": "6da7b1d7-6326-3afa-9709-84bdfed2e44c",
                                "text": "Dieses Theaterstück basiert auf einem Liebesroman."
                            },
                            {
                                "example_id": "445273bd-f240-4760-b914-daa45ff31ea8",
                                "sense_id": "6da7b1d7-6326-3afa-9709-84bdfed2e44c",
                                "text": "„Nach Bouvards Ansicht verdarb diese das Dichterische, und er ließ aus der Leihbibliohek Liebesromane kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
