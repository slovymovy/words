                ],
                "senses": [
                    {
                        "sense_id": "71dd1769-f601-3c5b-89da-de456fc73a3b",
                        "entry_id": "0683f7d1-2bc5-334f-9a3a-c867046887f5",
                        "glosses": [
                            "Tortellini russes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27df2cf8-ff33-45d2-ae26-8860eef7c837",
                                "sense_id": "71dd1769-f601-3c5b-89da-de456fc73a3b",
                                "text": "Tout est dans le nom chez Pelmenya : on y sert des pelmeni, que des pelmeni, mais tous les pelmeni !"
                            },
                            {
                                "example_id": "b430523a-cc7a-4852-ab1b-b84f2f667e01",
                                "sense_id": "71dd1769-f601-3c5b-89da-de456fc73a3b",
                                "text": "Les hommes rongeaient leur frein de longs mois, traversant le désert du temps grâce aux petites bibliothèques et aux vinyles. On préparait des milliers de pelmeni, les raviolis russes. On organisait des tournois d’échecs par radio avec les autres bases."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af661278-bd82-43e2-bc32-7b6f9b5f2593",
                        "source_entry_id": "0683f7d1-2bc5-334f-9a3a-c867046887f5",
                        "source_sense_id": "71dd1769-f601-3c5b-89da-de456fc73a3b",
                        "target_lang_word": "pelmeni",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelmeni",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                        "entry_id": "14e2b83b-77a0-37e7-8828-264c074d45b9",
                                        "glosses": [
                                            "Russian dumplings resembling ravioli."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de01775-b31f-4b7f-b954-78301fad5774",
                                                "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                                "text": "The dish most closely associated with Siberia is pelmeni, meat-filled dumplings. In Siberia, pelmeni are traditionally filled with horse meat and are served with vinegar."
                                            },
                                            {
                                                "example_id": "295b0efb-60cc-44c6-9597-91488876ac05",
                                                "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                                "text": "My favorite dish was a wonderful broth with pelmeni, Siberian dumplings filled with seasoned chopped meat."
                                            },
                                            {
                                                "example_id": "e7566db7-d758-4131-bb55-03732af5c9bf",
                                                "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                                "text": "\"This is pelmeni — Siberian dumplings,\" he said, \"And you better get used to it, because you're going to be eating a lot of it while you're here.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0ae07e2-8adc-4a7f-876b-d7b32ea1f54e",
                        "source_entry_id": "0683f7d1-2bc5-334f-9a3a-c867046887f5",
                        "source_sense_id": "71dd1769-f601-3c5b-89da-de456fc73a3b",
