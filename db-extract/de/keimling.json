                    {
                        "translation_id": "574b2225-75f3-4802-a641-2e24683112de",
                        "source_entry_id": "05fae6b9-ddd0-3afe-a70c-85501d3db7fe",
                        "source_sense_id": "a354ca4b-ce74-3a4d-9010-af0b4a2a9d79",
                        "source_sense_description": "Botanik: Pflanze im frühesten Entwicklungsstadium",
                        "target_lang_word": "kiemplant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiemplant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "522f712f-48ff-385c-ac91-0981572d7696",
                                        "entry_id": "0e15c34b-68b3-3043-84f9-3dc459cecbcb",
