                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schrijft een brief met een <w>pen</w>.",
                            "target_lang_translations": {
                                "en": "He is writing a letter with a <w>pen</w>.",
                                "ru": "Он пишет письмо <w>ручкой</w>.",
                                "pl": "On pisze list <w>długopisem</w>.",
                                "de": "Er schreibt einen Brief mit einem <w>Stift</w>.",
                                "fr": "Il écrit une lettre avec un <w>stylo</w>.",
                                "it": "Scrive una lettera con una <w>penna</w>.",
                                "cs": "Píše dopis <w>perem</w>.",
                                "tr": "O, <w>kalemle</w> bir mektup yazıyor.",
                                "es": "Él escribe una carta con un <w>bolígrafo</w>."
                            }
                        },
                        {
                            "text": "Mag ik even jouw <w>pen</w> lenen om dit op te schrijven?",
                            "target_lang_translations": {
                                "en": "May I borrow your <w>pen</w> for a moment to write this down?",
                                "ru": "Могу я одолжить твою <w>ручку</w>, чтобы записать это?",
                                "pl": "Czy mogę pożyczyć twój <w>długopis</w> na chwilę, żeby to zapisać?",
                                "de": "Kann ich mir kurz deinen <w>Stift</w> leihen, um das aufzuschreiben?",
                                "fr": "Puis-je emprunter ton <w>stylo</w> un instant pour noter cela ?",
                                "it": "Posso prendere in prestito la tua <w>penna</w> per un momento per scriverlo?",
                                "cs": "Mohu si půjčit tvé <w>pero</w>, abych si to zapsal?",
                                "tr": "Bunu yazmak için <w>kalemini</w> ödünç alabilir miyim?",
                                "es": "¿Me prestas tu <w>bolígrafo</w> un momento para escribir esto?"
                            }
                        }
