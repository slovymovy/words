                                        "entry_id": "095134be-c282-3865-8541-ed6c078d2622",
                                        "glosses": [
                                            "To qualify for the final round of a competition."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4782a673-0b6f-4942-a463-952097861898",
                                                "sense_id": "0a7b7a4e-1c36-3fea-9382-28b476fc3bc0",
                                                "text": "Mike finalled in both the 400 meter and the 800 meter races."
                                            },
                                            {
                                                "example_id": "a3d0d086-569d-4a2d-b5df-46d4346385ee",
                                                "sense_id": "0a7b7a4e-1c36-3fea-9382-28b476fc3bc0",
                                                "text": "Early in his swimming career, Baker finaled in the 200 fly at both the 1980 and 1984 Olympic Trials and was a two-time Pacific 10 Champion in the event for the University of Arizona."
                                            },
                                            {
                                                "example_id": "26c85184-4938-4e05-bd92-f6cbafd557ef",
                                                "sense_id": "0a7b7a4e-1c36-3fea-9382-28b476fc3bc0",
                                                "text": "Last year, Carlson would have A finaled in the 100-yard breast (58.75) and B finaled in the 200-yard breast (2:09.66)."
                                            },
                                            {
                                                "example_id": "48602ffa-e3b9-4e00-acfe-fa239aa26685",
                                                "sense_id": "0a7b7a4e-1c36-3fea-9382-28b476fc3bc0",
                                                "text": "Vocab-wise, medalling and PB-ing are now totally part-and-parcelled, and most experts in South Korea believe podiumed, finalled and all-comered are not far off lexiconing."
                                            },
                                            {
                                                "example_id": "de4dadf8-f816-4a47-8173-51a27446d824",
                                                "sense_id": "0a7b7a4e-1c36-3fea-9382-28b476fc3bc0",
                                                "text": "In Summer 2019, he finaled in a pair of events at Gainesville Sectionals before going on to take 22nd in the 100m and 200m free at Greensboro Futures."
                                            }
                                        ]
                                    }
                                ]
                            }
