                "senses": [
                    {
                        "sense_id": "cdd5aa51-6eb3-31ac-9074-46881ffdef68",
                        "entry_id": "4b944cf4-e5c3-3b8a-9203-9c3c134d0d09",
                        "glosses": [
                            "Nichteinhaltung des geltenden Völkerrechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738dd872-0197-4bcc-a555-f9753b165d82",
                                "sense_id": "cdd5aa51-6eb3-31ac-9074-46881ffdef68",
                                "text": "„Wie und wo tritt ein Ankläger auf, der nicht nur mit dem Krieg gegen den Irak selbst einen schweren Völkerrechtsverstoß gegen Art. 2 Z. 4 UNO-Charta begangen hat und zudem dem einzigen legitimen internationalen Gericht, dem Weltstrafgerichtshof, die Anerkennung verweigert?“"
                            },
                            {
                                "example_id": "388a12fe-7eee-401f-832c-ae9dcf2aef12",
                                "sense_id": "cdd5aa51-6eb3-31ac-9074-46881ffdef68",
                                "text": "„Denn die Anerkennung eines gewaltsam vollzogenen Gebietswechsels stellt sich als eine Unterstützung eines Völkerrechtsverstoßes dar und teilt daher dessen Schicksal, sie ist selbst völkerrechtswidrig.“"
                            },
                            {
                                "example_id": "3f6bd88e-a20b-482a-b0db-6fc806563a19",
                                "sense_id": "cdd5aa51-6eb3-31ac-9074-46881ffdef68",
                                "text": "„Die deutsche Presse hat amerikanische Völkerrechtsverstöße immer wesentlich genauer seziert und schärfer verurteilt als russische.“"
                            },
                            {
                                "example_id": "21cb9112-aa0d-4f09-be0a-c4e4c79583c1",
                                "sense_id": "cdd5aa51-6eb3-31ac-9074-46881ffdef68",
                                "text": "„Auch diese These verkennt allerdings den Sinn der Staatenimmunität, die zwangsläufig erst bei Völkerrechtsverstößen zum Tragen kommen kann. Daher ist ein Ausschluss der Immunität bei groben Völkerrechtsverstößen abzulehnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
