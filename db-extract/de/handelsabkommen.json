                ],
                "senses": [
                    {
                        "sense_id": "812b2bce-5797-36e0-9117-2c90c63586b7",
                        "entry_id": "d6b1d8c1-0076-3b20-9f0e-fa204c7501ff",
                        "glosses": [
                            "vertragliche Vereinbarung zwischen Staaten, mit der die Regeln für die Handelsbeziehungen festgelegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ee104c-9caa-4a57-b866-891ae7d37749",
                                "sense_id": "812b2bce-5797-36e0-9117-2c90c63586b7",
                                "text": "„Die EU strebt derzeit mit allen großen Industrienationen der Welt Handelsabkommen an.“"
                            },
                            {
                                "example_id": "9db95812-6f8f-499f-a16d-22857b45efa9",
                                "sense_id": "812b2bce-5797-36e0-9117-2c90c63586b7",
                                "text": "„Dieses neue Verfahren soll die bisher in vielen Handelsabkommen vereinbarten privaten und geheim tagenden Ad-hoc-Schiedsgerichte ersetzen, deren Rechtsprechung oft auf Kosten der schwächeren Handelspartner ging.“"
                            },
                            {
                                "example_id": "84be3f49-44ef-4914-b91c-2b356d6ae7ae",
                                "sense_id": "812b2bce-5797-36e0-9117-2c90c63586b7",
                                "text": "„In Kuka abgekommen, schließt er im Namen der Londoner Regierung ein Handelsabkommen mit dem Herrscher von Kanem-Bornu, einem bedeutenden Reich am Tschadsee.“"
                            },
                            {
                                "example_id": "0c8b41ab-d239-4373-ba51-0ea026c36ccf",
                                "sense_id": "812b2bce-5797-36e0-9117-2c90c63586b7",
                                "text": "„In der Regel wurden Handelsabkommen mit anderen Nationen zentral für alle Mitgliedstaaten von Preußen ausgehandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
