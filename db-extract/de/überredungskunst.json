                "senses": [
                    {
                        "sense_id": "dadc2719-c0fa-3719-a213-94874de37a95",
                        "entry_id": "adcc46d3-2ce2-34c0-8933-3ff94dfadff2",
                        "glosses": [
                            "Fähigkeit, jemanden zu etwas zu bewegen, was er/sie zunächst nicht wollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3673a015-8817-4425-a16f-e07b2fc70ca9",
                                "sense_id": "dadc2719-c0fa-3719-a213-94874de37a95",
                                "text": "„Großer Überredungskünste von seiner Seite hatte es gewiß nicht bedurft, daß sie sich nach kurzem schwanger fühlte.“"
                            },
                            {
                                "example_id": "182095dd-4e24-41f7-a1fa-bf60dc5e1cb9",
                                "sense_id": "dadc2719-c0fa-3719-a213-94874de37a95",
                                "text": "„Es bedurfte einiger Überredungskunst Lillis, um den Widerstand ihrer Eltern gegen die Verbindung mit einem Nichtjuden zu überwinden.“"
                            },
                            {
                                "example_id": "e8d4942f-6844-4179-85fc-6ab84982b5ac",
                                "sense_id": "dadc2719-c0fa-3719-a213-94874de37a95",
                                "text": "„Dieser schien von seinem Versprechen Abstand nehmen zu wollen, und es bedurfte einiger Überredungskunst meinerseits, ihn dazu zu bringen, sein Wort zu halten.“"
                            },
                            {
                                "example_id": "4e289889-ffed-4555-8ca4-e05691ec6ba4",
                                "sense_id": "dadc2719-c0fa-3719-a213-94874de37a95",
                                "text": "„Grüner versucht es mit verständnisvoller Überredungskunst.“"
                            },
                            {
                                "example_id": "a92d02c1-fc05-4ceb-a7fe-f2f356bf76a4",
                                "sense_id": "dadc2719-c0fa-3719-a213-94874de37a95",
                                "text": "„Es bedurfte einiger Überredungskunst, ihn zur Rückkehr nach Südrhodesien zu bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
