                        "cross_references": [
                            {
                                "target_word": "liche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3331065b-bf34-3ba7-8ba2-bc76712edbe3",
                                        "entry_id": "9d817169-9630-3f52-8612-a5c4b8583842",
                                        "glosses": [
                                            "Nom donné par les ardoisiers à de petites surfaces lisses au toucher, coupant en tous sens le plan de fissilité de manière à empêcher la séparation du schiste en feuillets, de dimension suffisante pour faire de l’ardoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b0cd9c-57ad-4e2b-ab6b-88b2291e4bfa",
                                                "sense_id": "3331065b-bf34-3ba7-8ba2-bc76712edbe3",
                                                "text": "La Veine du Sud […] présente un pendage de 20 à 25 degrés sur la verticale du sud, et se trouve limitée du ce côté par des schistes à pyrites de fer en lames plus ou moins épaisses et rapprochées (foriaces); au nord il n'y a pas de pyrites, la veine est limitée par la liche, c'est-à-dire par de petites surfaces douces au toucher, coupant en tous sens le plan de fissilité, de façon à empêcher la séparation du schiste en feuillets de dimension suffisante pour faire de l'ardoise."
                                            },
                                            {
                                                "example_id": "efdaa8a0-0d72-4574-b51f-2041b334536c",
                                                "sense_id": "3331065b-bf34-3ba7-8ba2-bc76712edbe3",
                                                "text": "Le passage du schiste non fissile à l'ardoise est généralement graduel ; près de Trélazé, la veine du Sud, qui a un pendage Sud de 20° sur la verticale, est limitée au Nord par la liche, c'est-à-dire par un schiste coupé de petits joints transversaux doux au toucher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab55119e-3799-3c0d-9657-43bc5e725d40",
                                        "entry_id": "b8d8d179-7155-390d-afa3-af4433cd8ed6",
                                        "glosses": [
                                            "Espèce de grand poisson osseux marin carnivore, carangidé au corps aplati."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e300e7-e981-49bd-9aa6-470a72a9cb2d",
                                                "sense_id": "ab55119e-3799-3c0d-9657-43bc5e725d40",
                                                "text": "Les carangues, les pompaneaux, les trachinotes et les liches font tous partie de la famille des carangidés qui compte 140 espèces dans le monde, principalement dans les mers tropicales. Très recherchés pour la qualité de leur chair, ces poissons sont très importants sur le plan commercial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab50fa0-1134-3c73-ae55-c4f1258ec2ef",
                                        "entry_id": "b8d8d179-7155-390d-afa3-af4433cd8ed6",
                                        "glosses": [
                                            "Synonyme de sériole couronnée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98c23445-350f-3cc8-85db-def9450020b0",
                                        "entry_id": "b8d8d179-7155-390d-afa3-af4433cd8ed6",
                                        "glosses": [
                                            "Un des noms vernaculaires du Scymnus lichia, nommé aussi gatta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "liche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                        "entry_id": "7713aabb-f5aa-39df-8a3c-beeb9fb1b78b",
                                        "glosses": [
                                            "Créature des mondes imaginaires, magicien mort-vivant d’apparence quasi squelettique."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3d32ab-1677-453a-8df8-1e7cfca0a44b",
                                                "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                                "text": "Se riant de la liche, il saisit une page du grimoire et la déchira, certain d'avoir découvert le secret. Une nouvelle déchirure apparut dans la cape élimée de la liche."
                                            },
                                            {
                                                "example_id": "a4810f1f-24c1-40a4-af33-d8c0a177458e",
                                                "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                                "text": "La liche projeta devant elle un rayon d'énergie noir et maléfique qui aurait absorbé une grande partie des forces vitales de l’Archimage s'il avait touché sa cible."
                                            },
                                            {
                                                "example_id": "1a01ca73-4542-4339-871b-aac57248a59a",
                                                "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                                "text": "Shader n'avait pas besoin qu'on lui dise que ces trois auriges étaient des liches, formés post-mortem par le Seigneur Liche lui-même."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6422125-6f28-3c8d-9732-b0ac38fe6d2a",
                                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                                        "glosses": [
                                            "Variante de lèche."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b36600-7de4-4303-b2d3-0c3056114805",
                                                "sense_id": "a6422125-6f28-3c8d-9732-b0ac38fe6d2a",
                                                "text": "D'une mine revêche la paysanne donna du beurre, poussa le chapeau de la table posée sur un coffre, coupa des liches de pain, cassa ses œufs dans un plat de terre jaune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c870a5cf-815b-381e-8a19-35a7c3a10c3b",
                                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                                        "glosses": [
                                            "Fait de bien manger."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8accb2c7-ee32-3c67-a4db-471a0d38b8d4",
                                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                                        "glosses": [
                                            "Fait de boire, de s’enivrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d70623-dfd1-4daa-93d3-05d899354589",
                                                "sense_id": "8accb2c7-ee32-3c67-a4db-471a0d38b8d4",
                                                "text": "Ma pauvre Amélie n’a plus eu la force de vivre, je l’ai retrouvée pendue un beau matin dans l’arbre que vous voyez en face de l’entrée, moi je me suis réfugié dans la liche pour oublier, mais j’ai rien oublié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da58e1b-48da-3626-9133-d5bea1bb6242",
                                        "entry_id": "22270435-bfaf-3579-a577-f35c97586baa",
                                        "glosses": [
                                            "Lichette, un petit peu de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3ff1da-0d91-4943-b738-34625e1a8d2f",
                                                "sense_id": "2da58e1b-48da-3626-9133-d5bea1bb6242",
                                                "text": "Je n’avais pas besoin de faire une liste pour me souvenir qu’il fallait rapporter une liche de pâté dans la pointe, deux centimètres de rillettes du Mans, du bricheton, du fromtogom ou trois betteraves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6494ed9-7aa0-3b97-9b56-16c5adf8f73a",
                                        "entry_id": "beade4f0-33ee-3068-a8f2-f6c74ac30a5b",
                                        "glosses": [
                                            "Chienne."
                                        ],
                                        "tags": [
                                            "Nord de la France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "505f38ed-73ee-4481-b066-5b588d7f2805",
                                                "sense_id": "f6494ed9-7aa0-3b97-9b56-16c5adf8f73a",
                                                "text": "Lisse , lice , liche : chienne née d'un loup, femelle des animaux, femme de mauvaise vie, du grec λύκος, loup."
                                            }
                                        ]
                                    }
                                ]
                            },
