                ],
                "translations": [
                    {
                        "translation_id": "65a9768f-67a2-47f0-be31-e7a3dd9d7c63",
                        "source_entry_id": "a05f698e-ff4c-36b7-b6de-e2b5fcad9b02",
                        "source_sense_id": "f17e295d-d211-30e6-bead-fb088d9c2963",
                        "target_lang_word": "hatchet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hatchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a0b7b30-aa54-38f9-9ee5-c79b356b1af7",
                                        "entry_id": "c8975c12-9eff-32eb-99eb-eb23941e5c42",
                                        "glosses": [
                                            "A small, light axe with a short handle; a tomahawk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472be60b-8e0f-4e8a-a5da-568bfea421a5",
                                                "sense_id": "5a0b7b30-aa54-38f9-9ee5-c79b356b1af7",
                                                "text": "“It must be admitted, Nick, you are a very literal logician—‘dog won't eat dog,’ is our English saying. Still the Yankee will fight the Yengeese, it would seem. In a word, the Great Father, in England, has raised the hatchet against his American children.”"
                                            },
                                            {
                                                "example_id": "202e0aa5-00fb-46d2-b1c9-7d5f517266d8",
                                                "sense_id": "5a0b7b30-aa54-38f9-9ee5-c79b356b1af7",
                                                "text": "Buried was the bloody hatchet, / Buried was the dreadful war-club, / Buried were all warlike weapons, / And the war-cry was forgotten."
                                            },
                                            {
                                                "example_id": "557d3c9b-d0e0-4b05-960d-58b56fb9b86b",
                                                "sense_id": "5a0b7b30-aa54-38f9-9ee5-c79b356b1af7",
                                                "text": "The fellow was armed with a stone-shod spear, a stone knife and a hatchet. In his black hair were several gay-colored feathers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac101717-44c1-3df5-9537-e2d19c068b72",
                                        "entry_id": "c8975c12-9eff-32eb-99eb-eb23941e5c42",
                                        "glosses": [
                                            "Belligerence, animosity; harsh criticism."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0760f77-e07b-4b60-8312-2b20007c8083",
                                                "sense_id": "ac101717-44c1-3df5-9537-e2d19c068b72",
                                                "text": "to bury the hatchet"
                                            },
                                            {
                                                "example_id": "8bdf2576-11f9-4fdc-8a9d-c08822ebf61c",
                                                "sense_id": "ac101717-44c1-3df5-9537-e2d19c068b72",
                                                "text": "hatchet job"
                                            },
                                            {
                                                "example_id": "7b86c702-a75f-4824-8335-641ceb7a98b3",
                                                "sense_id": "ac101717-44c1-3df5-9537-e2d19c068b72",
                                                "text": "“Dat true as missionary! What a soldier do, cap'in, if so much peace? Warrior love a war-path.”\n“I wish it were not so, Nick. But my hatchet is buried, I hope, for ever.”"
                                            },
                                            {
                                                "example_id": "71dd976e-cac2-42e8-8047-b1bd9be17b97",
                                                "sense_id": "ac101717-44c1-3df5-9537-e2d19c068b72",
                                                "text": "The savagery with which Michael Hofmann can wield a hatchet has earned him unlikely fans outside the literary circuit. A recent issue of Viz ran a cartoon of the critic, poet and translator urinating all over a phone booth, while two donnish FR Leavis types nodded appreciatively from a safe distance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hatchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baab1498-d969-33b6-9fe9-739b1b4711ad",
                                        "entry_id": "315163f6-1246-32a1-b85b-bb10ab7f2f12",
                                        "glosses": [
                                            "To cut with a hatchet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
