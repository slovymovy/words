                "senses": [
                    {
                        "sense_id": "17ec5f09-46a1-34fa-8742-02f57684f494",
                        "entry_id": "1c9e311f-83ec-3f3a-b76b-dae8399e423e",
                        "glosses": [
                            "Hin- und Herbewegung des Kopfes als Geste der Ablehnung/Verneinung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e460b56-dfd4-4404-942a-e31cf52847c5",
                                "sense_id": "17ec5f09-46a1-34fa-8742-02f57684f494",
                                "text": "„Worüber heute in Schlagzeilen und mit fassungslosem Kopfschütteln berichtet würde, das war in diesen Tagen fürchterliche Normalität.“"
                            },
                            {
                                "example_id": "b2664a48-85b3-4607-9edc-29e9d324f299",
                                "sense_id": "17ec5f09-46a1-34fa-8742-02f57684f494",
                                "text": "„Fabiola nippte an ihrem Weinglas und stellte es dann mit Kopfschütteln ab.“"
                            },
                            {
                                "example_id": "e73693ce-1648-4bd6-844f-ac694ca0f7f7",
                                "sense_id": "17ec5f09-46a1-34fa-8742-02f57684f494",
                                "text": "„Dann lauschte ich meinen eigenen Sätzen nach, als hätte ein anderer sie gesprochen, und es kam vor, dass ich meine eigenen Sätze mit einem bestätigenden Kopfnicken oder einem erstaunten Kopfschütteln begleitete.“"
                            },
                            {
                                "example_id": "3496b6be-ef6c-4b9b-b43f-28a870f0a93c",
                                "sense_id": "17ec5f09-46a1-34fa-8742-02f57684f494",
                                "text": "„Er wusste bereits, dass Matthias fortgelaufen war, und quittierte alles, was der berichtete, mit Kopfschütteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
