                "senses": [
                    {
                        "sense_id": "90c29e83-41e1-3792-b135-9ff4c12e11fa",
                        "entry_id": "98f04d19-34a5-360d-9317-7123b8ae78a0",
                        "glosses": [
                            "Eigenschaft (eines Produktes/Faktors), ersetzbar (substituierbar) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cbb0698-28f8-41ba-a6b2-483d4e2ef072",
                                "sense_id": "90c29e83-41e1-3792-b135-9ff4c12e11fa",
                                "text": "„Eine Nachfragebeziehung zwischen zwei oder mehr Gütern ist durch Substitutionalität gekennzeichnet, wenn die Mindernachfrage nach dem einen Gut durch eine entsprechende Mehrnachfrage nach dem anderen Gut ersetzt (substituiert) wird.“"
                            },
                            {
                                "example_id": "187fd259-7fe4-41b3-b05b-da9c82ccde7c",
                                "sense_id": "90c29e83-41e1-3792-b135-9ff4c12e11fa",
                                "text": "„Die Mehrzahl der Arbeiten zur Produktivitätsforschung im Handel vernachlässigt die explizite Überprüfung der Limitationalität bzw. Substitutionalität der Leistungsfaktoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
