                "senses": [
                    {
                        "sense_id": "51ecf9bd-614e-387b-8fe1-c362e5cbae6e",
                        "entry_id": "da170674-7a51-3b35-8ce3-3c2f7692f1f8",
                        "glosses": [
                            "sesshafter, bäuerlicher Landbewohner in den arabischen Ländern (vor allem im Vorderen Orient und dort besonders in Ägypten), der hauptsächlich Ackerbau betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd298ae-38da-4b1f-9658-1fd2fe49187f",
                                "sense_id": "51ecf9bd-614e-387b-8fe1-c362e5cbae6e",
                                "text": "„Aber das ist kein entscheidender Faktor, denn der überwiegende Teil der marokkanischen Bauern besitzt ja keinen Grund und Boden. Der größte Teil arbeitet als armselige Landarbeiter, als sogenannter Fellah. Der Fellah arbeitet bei seinem französischen Herrn und von diesem lebt er.“"
                            },
                            {
                                "example_id": "360d3a16-d90a-4b40-bb9c-d930c42280ad",
                                "sense_id": "51ecf9bd-614e-387b-8fe1-c362e5cbae6e",
                                "text": "„Diese städtische soziale Schicht war offener und gebildeter als die Fellahs vom Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
