                            },
                            {
                                "target_lang_word": "andauern",
                                "target_lang_sense_clarification": "ohne Unterbrechung fortbestehen"
                            },
                            {
                                "target_lang_word": "sich hinziehen",
                                "target_lang_sense_clarification": "länger als erwartet andauern"
