                "senses": [
                    {
                        "sense_id": "08afd36d-ea1d-3a84-962b-df2a7de56473",
                        "entry_id": "3a95ca71-b732-3b30-a7f9-e40a4fb1511b",
                        "glosses": [
                            "историческая область на северо-западе полуострова Индостан"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e54e38c-9697-4f39-8c57-0115f2c8d77e",
                                "sense_id": "08afd36d-ea1d-3a84-962b-df2a7de56473",
                                "text": "Распространение культа сомы по городам и весям Индостана требовало всё больших и больших количеств этой травы, которая росла только в Кашмире на склонах Гималаев и в горах Ирана."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afbdef3c-6bde-4f8a-8a14-ca3f55f635f9",
                        "source_entry_id": "3a95ca71-b732-3b30-a7f9-e40a4fb1511b",
                        "source_sense_id": "08afd36d-ea1d-3a84-962b-df2a7de56473",
                        "target_lang_word": "Kashmir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kashmir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                        "entry_id": "19cba338-da0f-3b8e-859e-98d9c75ce418",
                                        "glosses": [
                                            "A contested geographic region of South Asia in the northern part of the Indian subcontinent, located between (and de facto divided between) India, Pakistan and China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265db145-68a0-4ec3-a760-99c471226bff",
                                                "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                                "text": "The picturesque Himalayan region of Kashmir is dangerously contested territory, parts of it claimed by India, Pakistan and China. While the three nuclear armed nations have gone to war over territorial disputes over the past seven decades, the rights of Kashmiris and their dreams of self-determination have been systematically sacrificed, like lambs to slaughter for the Muslim festival."
                                            },
                                            {
                                                "example_id": "6898075d-4058-489f-9fbc-97ce220743b0",
                                                "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                                "text": "Pakistan has claimed Kashmir since the partition of India in 1947 and the countries have fought two wars over the region, which is also partially claimed by China."
                                            },
                                            {
                                                "example_id": "5d57388a-f3a2-45fa-8260-1dda0fa7429b",
                                                "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                                "text": "The biggest rivalry in cricket reflects bilateral ties outside the ground, as India and Pakistan have fought several wars since the subcontinent was divided into two nations upon its independence from the British empire in 1947.\nThe two neighboring countries are involved in a territorial dispute over the Kashmir region, and New Delhi has accused Islamabad of sponsoring cross-border terrorism, a charge that the latter denies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73076fa-7a65-36c8-96f9-8b82fa358eff",
                                        "entry_id": "19cba338-da0f-3b8e-859e-98d9c75ce418",
                                        "glosses": [
                                            "An intermontane valley situated between Pir Panjal Range and Himadri."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Kashmir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "746f6ead-510e-3153-94b2-865afbfcff26",
                                        "entry_id": "fc20303f-a29c-3a06-9873-e17500eaaa92",
                                        "glosses": [
                                            "Alternative form of Cashmere (“type of goat”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05ac959-61ac-45ef-90fc-e1d4f9f04b51",
                        "source_entry_id": "3a95ca71-b732-3b30-a7f9-e40a4fb1511b",
                        "source_sense_id": "08afd36d-ea1d-3a84-962b-df2a7de56473",
                        "target_lang_word": "Kaschmir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaschmir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4bb510a-a336-32a5-8b77-f8120beeae57",
                                        "entry_id": "7a0f2254-70ee-3880-8628-2015a8371751",
                                        "glosses": [
                                            "aus Ziegenhaar gewonnene Wolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2306d142-5b69-46c0-9fc5-7ccb61db66b5",
                                                "sense_id": "b4bb510a-a336-32a5-8b77-f8120beeae57",
                                                "text": "Der Pullover ist aus Kaschmir."
                                            },
                                            {
                                                "example_id": "5f1d7e96-2816-4426-8137-16b4747b1dab",
                                                "sense_id": "b4bb510a-a336-32a5-8b77-f8120beeae57",
                                                "text": "„Denn Kaschmir ist unendlich weich, leicht, schmeichelt der Haut und ist wie eine sanfte Umarmung, weswegen manche Frauen Kaschmirschals bei Abwesenheit des Liebsten auch gerne als Streichelersatz nutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kaschmir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                        "entry_id": "892f8363-c9e4-34f5-b988-d0bb21d103d3",
                                        "glosses": [
                                            "Region im Grenzgebiet von Indien und Pakistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c250e7-a368-4d3e-bdd5-99a317e1cc1f",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Eine Sonderstellung nahmen auf dem Gebiet des heutigen Pakistan die Kleinreiche ein, denen die Briten ihre interne Autonomie beließen: In erster Linie ist hier Kaschmir zu nennen, dessen Bevölkerung zu über 90 Prozent muslimisch ist, das aber von einem hinduistischen Maharadscha beherrscht wurde.“"
                                            },
                                            {
                                                "example_id": "7134164f-264f-4e0c-b309-0224ebc570c7",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Im letzten Moment beschloss Neschkow, mit uns nach Kaschmir und Tadschikistan zu kommen.“"
                                            },
                                            {
                                                "example_id": "a54ac574-7222-4d27-a3c4-60d631cc3039",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Wahrscheinlich ist er hellhätug und führt seine Herkunft auf Zentralasien über Kaschmir zurück.“"
                                            },
                                            {
                                                "example_id": "c7ff4fd7-aadf-4bd5-bbfa-59fcd3d40df8",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Das Einzige, was ihm in Amerika wirklich gefallen hatte, waren die Rocky Mountains gewesen, deren schroffe Gipfel in dünner Luft ihn an seine Heimat in den Bergen von Kaschmir erinnert hatten.“"
                                            },
                                            {
                                                "example_id": "6501b0ed-bf98-42e4-bc4e-879f8e4b631a",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Um 1761 besiegte Ahmed Schah Durrani die Hindu Mahrattas, eroberte den Thron in Delhi und Kaschmir und schuf damit das erste afghanische Reich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
