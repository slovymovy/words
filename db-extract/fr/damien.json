                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55588b8a-242d-4c85-9df4-680d20e2759a",
                                "sense_id": "10ffe322-eb1e-3fa7-a95b-5be465875a5f",
                                "text": "En cruisers 35/39 ans, Damien Grouazel (Quévert) a subi un vol plané en finale dans la première ligne droite, engendrant un énorme carambolage avec trois candidats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db2c70a-5e44-47ac-b9cf-01c3d98bc4ed",
                        "source_entry_id": "0d41bed3-9293-37e1-b453-009fdac4a4b5",
                        "source_sense_id": "10ffe322-eb1e-3fa7-a95b-5be465875a5f",
                        "target_lang_word": "Damian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Damian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                        "entry_id": "11e07b99-d5ca-3567-a0c6-bd45f50c854b",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b25baa-123b-40f9-8ddc-c37d05390f54",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Frau Damian ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "63c33c5b-1a17-48f9-84fd-31e4138cf764",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Herr Damian wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "97188558-189e-4480-9505-e18984f6317d",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Die Damians kommen heute aus der Schweiz."
                                            },
                                            {
                                                "example_id": "bcac89e0-4cf7-4b6f-99fb-d9bec70f81a4",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Der Damian trägt nie die Schals, die die Damian ihm strickt."
                                            },
                                            {
                                                "example_id": "08e1caf0-69d1-44d4-9305-d2a16e222b22",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Damian kommt, geht der Herr Damian.“"
                                            },
                                            {
                                                "example_id": "4c3f1957-e4d1-4d5d-9cbc-137c774cb0e8",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Damian kommt und geht."
                                            },
                                            {
                                                "example_id": "71cc1e9e-65ae-4ba0-aed3-8292ddf98804",
                                                "sense_id": "9669cee9-99b3-36b1-a7a7-4752d030b2e6",
                                                "text": "Damians kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11cfbdd1-08f9-4a9c-81f2-003f0a4c64e7",
                        "source_entry_id": "0d41bed3-9293-37e1-b453-009fdac4a4b5",
