                        "form": "ornées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "615a7b1d-2715-3f01-b8cf-31bfa69844fe",
                        "entry_id": "02cf6ecb-26b8-3d27-986a-e6740aafbc7f",
                        "glosses": [
                            "Pourvu de ce qui embellit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f5b87cd-9c10-454a-a4dd-468752b2021a",
                                "sense_id": "615a7b1d-2715-3f01-b8cf-31bfa69844fe",
                                "text": "Le linge orné de fleurs fut couvert pour tous mets\nD'un peu de lait, de fruits et des dons de Cérès."
                            },
                            {
                                "example_id": "7cda6603-8f90-4a76-89bc-ce149123bfe4",
                                "sense_id": "615a7b1d-2715-3f01-b8cf-31bfa69844fe",
                                "text": "L'épigramme, plus libre en son tour plus borné,\nN'est souvent qu'un bon mot de deux rimes orné."
                            },
                            {
                                "example_id": "6f1d2c55-8120-4fa0-a221-14ce79ecd901",
                                "sense_id": "615a7b1d-2715-3f01-b8cf-31bfa69844fe",
                                "text": "Autant que la terre de Cypre nous avait paru négligée et inculte, autant celle de Crète se montrait fertile et ornée de tous les fruits par le travail de ses habitants."
                            }
                        ]
                    },
                    {
                        "sense_id": "c35acce0-d38e-342f-851a-4494a5cfee8f",
                        "entry_id": "02cf6ecb-26b8-3d27-986a-e6740aafbc7f",
                        "glosses": [
                            "Pourvu de choses comparées à des ornements matériels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "367bf324-6dca-42b9-ab12-390a576337e3",
                                "sense_id": "c35acce0-d38e-342f-851a-4494a5cfee8f",
                                "text": "Brisacier avait l'esprit orné de lieux communs et de chansonnettes."
                            },
                            {
                                "example_id": "371b2d4b-a242-45c9-9e04-a99e3ce5c019",
                                "sense_id": "c35acce0-d38e-342f-851a-4494a5cfee8f",
                                "text": "On veut un roi dont le corps soit fort et adroit, et dont l'âme soit ornée de la sagesse et de la vertu."
                            },
                            {
                                "example_id": "1cbe6d59-c74b-490d-9907-6b7b678d2f3c",
                                "sense_id": "c35acce0-d38e-342f-851a-4494a5cfee8f",
                                "text": "Qui a vu la cour a vu du monde ce qui est le plus beau, le plus spécieux et le plus orné."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5832670-0f2f-35c9-a089-59a45f9e1752",
                        "entry_id": "02cf6ecb-26b8-3d27-986a-e6740aafbc7f",
                        "glosses": [
                            "Se dit d’un écu qui est entouré de lambrequins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2584d06f-f11d-4bde-8818-62776e3fc2ec",
                                "sense_id": "e5832670-0f2f-35c9-a089-59a45f9e1752",
                                "text": "D’argent à la fasce de gueules accompagnée en chef de trois coqs rangés de sable crêtés et barbés du second soutenus de la fasce ; l’écu orné de lambrequins d’argent et de gueules, un coq de l’écu démembré entre un vol banneret d’argent, Lambrequin d’argent et de gueules, qui est de la famille d’Occoche de Manchicourt → voir illustration « armoiries ornées »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d8e706a-5e39-4c7a-b54b-e9cd78ef22ed",
                        "source_entry_id": "02cf6ecb-26b8-3d27-986a-e6740aafbc7f",
                        "target_lang_word": "ornate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornate",
