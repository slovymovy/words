                                        "sense_id": "4cf7a3da-cc81-3767-952e-3072eface608",
                                        "entry_id": "f4bcf380-c7ae-3a82-9eae-8cc1b12cd173",
                                        "glosses": [
                                            "A part of any of several scientific or measuring instruments that moves back and forth to indicate a position."
