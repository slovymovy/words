                        "sense_id": "665e8e53-0d27-32cd-8bfc-318bdc4c0ab6",
                        "entry_id": "559a57c7-b9dc-3cd0-a4ee-a45e627fe4a7",
                        "glosses": [
                            "жарг. член группы шулеров, тасующий карты в определенном порядке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f520e6ba-3558-4c29-8163-a617717301b0",
                                "sense_id": "665e8e53-0d27-32cd-8bfc-318bdc4c0ab6",
                                "text": "Ковшики используют приёмы из арсенала иллюзионистов."
