                "senses": [
                    {
                        "sense_id": "536bc2ee-b3e8-382e-ae7a-3bd5258078d3",
                        "entry_id": "ae8eb759-cbab-3bc0-bba4-d06c527e7798",
                        "glosses": [
                            "Raum, in dem geschlafen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e9e759-ace0-4622-84dc-faad42e59576",
                                "sense_id": "536bc2ee-b3e8-382e-ae7a-3bd5258078d3",
                                "text": "„In der Schlafstube roch es immerzu nach Machorka.“"
                            },
                            {
                                "example_id": "51a6e3c7-70b7-4ce6-81be-b1e1752f7a35",
                                "sense_id": "536bc2ee-b3e8-382e-ae7a-3bd5258078d3",
                                "text": "„Sie verstand, begab sich nach vorn und legte ihr Haarhäubchen ab; sie flocht ihr Haar nach Hangdschou-Art, glättete den Puder in ihrem Antlitze neu, färbte ihre Lippen erneut rot nach und deckte in ihrer Schlafstube die Tafel zum leckeren Schmause.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49a08cfa-5cb0-4115-a25e-bda0c7283b96",
                        "source_entry_id": "ae8eb759-cbab-3bc0-bba4-d06c527e7798",
                        "source_sense_id": "536bc2ee-b3e8-382e-ae7a-3bd5258078d3",
                        "source_sense_description": "Raum, in dem geschlafen wird",
                        "target_lang_word": "chambre à coucher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
