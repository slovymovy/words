                        "examples": [
                            {
                                "example_id": "4d8a0bfe-adad-4713-add1-c2a23cd48aaa",
                                "sense_id": "77521781-4397-3da6-ae5a-a4c9793f6257",
                                "text": "In de jeugdboeken die dit jaar van u verschenen zijn [Het hebzuchtgas en Kop uit ’t Zand] laat u jonge mensen een opstand ontketenen tegen een overheid die niets doet om het milieu op aarde te redden."
                            },
                            {
                                "example_id": "b26f9815-0e97-4d0f-85e9-4663aebb1ea5",
                                "sense_id": "77521781-4397-3da6-ae5a-a4c9793f6257",
                                "text": "Vier Vlaamse en Twee Nederlandse jeugdboeken zijn genomineerd voor de Thea Beckman Prijs voor de beste historische jeugdroman van het afgelopen schooljaar."
                            },
                            {
                                "example_id": "c447416b-dfd5-4cca-a1f8-38817b8c5397",
                                "sense_id": "77521781-4397-3da6-ae5a-a4c9793f6257",
                                "text": "Nadat voor deze dure oplossing was gekozen, schreef hij er het jeugdboek Oosterschelde windkracht 10 over."
                            }
                        ]
                    }
