                {
                    "sense_id": "02f19d0f-cf63-3ee4-bd11-3c26ad338d59",
                    "sense_definition": "Sarcastische uitdrukking van ongeloof; het tegenovergestelde wordt bedoeld",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sarcasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zegt dat hij de loterij heeft gewonnen, ja <w>tuurlijk</w>.",
                            "target_lang_translations": {
                                "en": "He says he won the lottery, yeah <w>right</w>.",
                                "ru": "Он говорит, что выиграл в лотерею, ага, <w>конечно</w>.",
                                "pl": "Mówi, że wygrał na loterii, <w>jasne</w>.",
                                "de": "Er sagt, er habe im Lotto gewonnen, <w>ja klar</w>.",
                                "fr": "Il dit qu'il a gagné au loto, <w>mon œil</w>.",
                                "it": "Dice di aver vinto alla lotteria, <w>sì, certo</w>.",
                                "cs": "Říká, že vyhrál v loterii, <w>jasně</w>.",
                                "tr": "Piyangoyu kazandığını söylüyor, <w>hadi oradan</w>.",
                                "es": "Dice que ha ganado la lotería, <w>sí, claro</w>.",
                                "zh": "他说他中了彩票，<w>得了吧</w>。"
                            }
                        },
                        {
                            "text": "Je denkt toch niet dat ik dat geloof, <w>tuurlijk</w>.",
                            "target_lang_translations": {
                                "en": "You don't think I believe that, <w>sure</w>.",
                                "ru": "Ты же не думаешь, что я в это поверю, <w>ну да</w>.",
                                "pl": "Chyba nie myślisz, że w to uwierzę, <w>akurat</w>.",
                                "de": "Du glaubst doch nicht etwa, dass ich das glaube, <w>sicher</w>.",
                                "fr": "Tu ne crois quand même pas que je vais croire ça, <w>tu parles</w>.",
                                "it": "Non penserai mica che io ci creda, <w>figurati</w>.",
                                "cs": "Snad si nemyslíš, že ti to věřím, <w>určitě</w>.",
                                "tr": "Buna inanacağımı sanmıyorsun herhalde, <w>tabii canım</w>.",
                                "es": "No pensarás que me creo eso, <w>ya</w>.",
                                "zh": "你不会以为我会信吧，<w>才怪</w>。"
                            }
                        }
