                "senses": [
                    {
                        "sense_id": "e82e7890-7cdb-30ef-aa70-13345feb5984",
                        "entry_id": "4591f5e6-bbd5-3ec7-9e7b-71badc9384f4",
                        "glosses": [
                            "Schlüssel für einen Wagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f529e25-5d83-44b1-833d-d55cd42bf836",
                                "sense_id": "e82e7890-7cdb-30ef-aa70-13345feb5984",
                                "text": "„Wie sich später herausstellte, hatte der junge Autofan den Wagenschlüssel des Vaters unbemerkt an sich genommen und war durch ein Fenster aus dem Haus gestiegen.“"
                            },
                            {
                                "example_id": "eac591fa-aca6-40f1-a86e-823f45267c08",
                                "sense_id": "e82e7890-7cdb-30ef-aa70-13345feb5984",
                                "text": "„Ich lege also meine Wagenschlüssel auf den Tisch, werfe die Werbung in den Mülleimer und bemerke, dass er voll ist.“"
                            },
                            {
                                "example_id": "95dfb57c-b184-4696-afec-e8522a49a195",
                                "sense_id": "e82e7890-7cdb-30ef-aa70-13345feb5984",
                                "text": "„Der Tankwart brachte den Wagenschlüssel zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
