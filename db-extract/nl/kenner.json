                            {
                                "example_id": "c2c5a172-30f7-4e2f-b305-566a72282071",
                                "sense_id": "dfcd8185-7bb3-33c5-b4cc-3bce57e2b178",
                                "text": "Een wijnkenner weet veel van wijn."
                            },
                            {
                                "example_id": "337fc85f-e4c3-4e4f-b5ab-670a0a0ff904",
                                "sense_id": "dfcd8185-7bb3-33c5-b4cc-3bce57e2b178",
                                "text": "Veel mensen zijn bezorgd. Ook kenners maken zich zorgen, zoals professor Bongers. Hij werkt bij de universiteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d732b81e-a5bf-4ab1-b6e4-447f3af0b549",
