                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La jeune femme est apparue <w>rayonnante</w> de joie en apprenant la bonne nouvelle."
                        },
                        {
                            "text": "Il affichait un visage <w>rayonnant</w> après avoir brillamment réussi son examen final."
                        }
