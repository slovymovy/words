                        "sense_id": "98c78d72-9dc9-3082-8b60-128a063801ff",
                        "entry_id": "ab07baf2-a78a-3c7a-bd92-c86939815e98",
                        "glosses": [
                            "Notes in the margin of a document."
                        ],
                        "tags": [
                            "plural",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "be8bb64e-5491-4f2c-a3d8-a9405e45ae88",
                                "sense_id": "98c78d72-9dc9-3082-8b60-128a063801ff",
                                "text": "We know what the composer was thinking as he wrote the piece because we can read his handwritten marginalia on the manuscript."
                            },
                            {
                                "example_id": "54624b0b-a3da-443c-a6df-9b45a4e6b2b0",
                                "sense_id": "98c78d72-9dc9-3082-8b60-128a063801ff",
                                "text": "In so doing, he transforms the Foxian compulsion to distinguish true martyrs from false ones —and thus to differentiate his own saint-making project from medieval hagiography—into a model of textual criticism, directed at detecting and desanctifying the false martyr through the critical medium of marginalia."
                            }
                        ]
                    }
                ],
