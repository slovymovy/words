                                "target_senses": [
                                    {
                                        "sense_id": "43fe0f1c-48c0-332b-815d-593ea2ed8fb0",
                                        "entry_id": "5bd38388-f071-32c9-ad5d-48fa68f1e47e",
                                        "glosses": [
                                            "As a matter of form; formally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f420a94-c55b-4881-87b5-894ea1480e46",
                                                "sense_id": "43fe0f1c-48c0-332b-815d-593ea2ed8fb0",
                                                "text": "[I]t being unlikely, he ſays, that he can procure in the time, a letter from Lady Betty, under her own hand, inviting me in form to her houſe, […]"
                                            },
                                            {
                                                "example_id": "c47f7347-9e57-4cc6-ba66-af981d1f8647",
                                                "sense_id": "43fe0f1c-48c0-332b-815d-593ea2ed8fb0",
                                                "text": "[C]uriosity could not be satisfied by a bride in a pew, and it must be left for the visits in form which were then to be paid, to settle whether she were very pretty indeed, or only rather pretty, or not pretty at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6bdbd4c-0d1e-33aa-9b0e-233dbede34f1",
                                        "entry_id": "5bd38388-f071-32c9-ad5d-48fa68f1e47e",
                                        "glosses": [
                                            "Having good form; fit, performing well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0d582fa-55fd-496f-b5ce-fd862b5919ae",
                                                "sense_id": "a6bdbd4c-0d1e-33aa-9b0e-233dbede34f1",
                                                "text": "Manchester United's in-form striker rose to head home Stewart Downing's corner and then rounded off a sweeping counter-attack involving Theo Walcott and Ashley Young to wrap up the formalities seconds before the break."
                                            }
                                        ]
                                    }
                                ]
