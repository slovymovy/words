                "senses": [
                    {
                        "sense_id": "dd46d677-f830-34e3-aa54-018dce355827",
                        "entry_id": "3dc911d4-5ab4-35f3-a26b-cff3cf3203b6",
                        "glosses": [
                            "Débarrasser de l’influence des énarques."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "cdbe5bc0-550f-48b1-bf3b-d1a3518b3b95",
                                "sense_id": "dd46d677-f830-34e3-aa54-018dce355827",
                                "text": "J’en profiterais aussi pour désénarchiser l’État."
                            },
                            {
                                "example_id": "7121b079-4184-4641-8993-f5dfba7c4829",
                                "sense_id": "dd46d677-f830-34e3-aa54-018dce355827",
                                "text": "Vivement qu’advienne ce merveilleux pays de cocagne, désénarchisé, égalitaire, uni, équitable, juste dans lequel l’on ne s’emmerdera plus à tout critiquer et tout détruire, en particulier ce qui marche."
                            },
                            {
                                "example_id": "439cd990-36fe-40c7-8912-c40ecc15a92d",
                                "sense_id": "dd46d677-f830-34e3-aa54-018dce355827",
                                "text": "Verbes utiles pour décalcifier l’époque : dénormer, dénormaliser, déformater, désénarchiser, détrister, désennuyer, décadrer… gaiement !"
                            }
                        ]
                    }
                ],
