                                "target_senses": [
                                    {
                                        "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                        "entry_id": "effe6ae3-f745-3c0c-83df-2d51a8aafba2",
                                        "glosses": [
                                            "Bande étroite d’étoffe qu’on met entre les deux parties d’une couture, ou entre le dessus et la doublure, de manière qu’elle dépasse un peu l’un et l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b36de0-9a8b-4128-bbec-17c88571e154",
                                                "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                                "text": "Un être insolite s’offrait à leurs regards : rouge, jaune, vert, bleu, couvert de passepoils, de franges, de rubans."
                                            },
                                            {
                                                "example_id": "0ad96716-1c10-45ee-8a2a-2de2bfa7dada",
                                                "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                                "text": "Le garde-chiourme parlait à une voisine. Son képi à visière carrée, son ceinturon, son dolman noir et son pantalon bleu, à passepoil jonquille, provoquaient dans la rue une grandissante curiosité."
                                            },
                                            {
                                                "example_id": "490804dc-ab88-4e8a-9ec6-7cc8cc7b4521",
                                                "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                                "text": "Pendant ce, le vieux aux cheveux gris, qui venait d’attacher les deux chevaux à une barrière, passait une veste écarlate de hussard, aux brandebourgs et au passepoil d’argent, et prenant un arrosoir, se dirigeait vers la ville."
                                            }
                                        ]
