                {
                    "sense_id": "1238f55c-f508-3efe-a471-be638f3a1bec",
                    "sense_definition": "Gracz w karty, który zbyt długo zastanawia się nad ruchem.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź taki <w>czajnik</w>, rzucaj wreszcie tę kartę!",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>тормозом</w>, бросай наконец эту карту!",
                                "en": "Don't be such a <w>slowcoach</w>, just play that card already!",
                                "nl": "Wees niet zo'n <w>treuzelaar</w>, gooi die kaart nu eindelijk op!",
                                "de": "Sei kein solcher <w>Trödler</w>, spiel endlich die Karte aus!",
                                "fr": "Ne sois pas si <w>lent</w>, jette enfin cette carte !",
                                "it": "Non essere così <w>lento</w>, lancia finalmente questa carta!",
                                "cs": "Nebuď taková <w>brzda</w>, hoď už konečně tu kartu!",
                                "tr": "Bu kadar <w>uyuntu</w> olma, at artık şu kartı!",
                                "es": "¡No seas tan <w>lento</w>, echa la carta de una vez!"
                            }
                        },
                        {
                            "text": "Gra z nim to męka, bo straszny z niego <w>czajnik</w>.",
                            "target_lang_translations": {
                                "ru": "Играть с ним — мучение, потому что он жуткий <w>тормоз</w>.",
                                "en": "Playing with him is torture because he is such a <w>slowpoke</w>.",
                                "nl": "Met hem spelen is een kwelling, want hij is een vreselijke <w>treuzelaar</w>.",
                                "de": "Mit ihm zu spielen ist eine Qual, weil er eine schreckliche <w>Schlafmütze</w> ist.",
                                "fr": "Jouer avec lui est un supplice parce que c'est un vrai <w>lambin</w>.",
                                "it": "Giocare con lui è un supplizio, perché è una vera <w>lumaca</w>.",
                                "cs": "Hra s ním je utrpení, protože je to strašný <w>šnek</w>.",
                                "tr": "Onunla oynamak bir işkence, çünkü tam bir <w>mıymıntı</w>.",
                                "es": "Jugar con él es un suplicio porque es una <w>tortuga</w> jugando."
                            }
                        }
