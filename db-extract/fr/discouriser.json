                "senses": [
                    {
                        "sense_id": "1f2ac8d5-ce1e-393f-a3f6-0d9950da238d",
                        "entry_id": "35b933ed-4e40-34b0-bcef-39939a60c162",
                        "glosses": [
                            "S’exprimer sous forme de discours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64205d65-169a-44ec-acda-a26799b20561",
                                "sense_id": "1f2ac8d5-ce1e-393f-a3f6-0d9950da238d",
                                "text": "Quand on lui pose cette question, Geneviève Rodriguez, maire de Morsang-sur-Orge (Essonne), ne «discourise» pas, ne se réfugie pas ailleurs, derrière des impondérables extérieurs, mais répond d'emblée: «D'abord, voir avec les gens, rien ne peut se faire sans eux.»"
                            },
                            {
                                "example_id": "332e3917-1010-447d-93ef-9b5aec62c368",
                                "sense_id": "1f2ac8d5-ce1e-393f-a3f6-0d9950da238d",
                                "text": "Mais le tonnerre gronde (et notre amie Marie-Ségolène discourise en se faisant passer pour une révolutionnaire italienne)."
                            }
                        ]
                    },
                    {
                        "sense_id": "caf1ffe0-6883-3066-9832-559e0931e818",
                        "entry_id": "35b933ed-4e40-34b0-bcef-39939a60c162",
                        "glosses": [
                            "Exprimer sous forme de discours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b97827-2400-49f8-ac1f-da3c6b318504",
                                "sense_id": "caf1ffe0-6883-3066-9832-559e0931e818",
                                "text": "Et, bien sûr! le Jeu du Noir et du Blanc, discourisé dans la langue partenaire."
                            }
                        ]
                    }
                ],
