                        "entry_id": "8301964b-b171-3b95-ae65-795cd3bb0437",
                        "glosses": [
                            "In close conjunction with the sun (so that its astrological influence is \\\"burnt up\\\"), sometimes specified to be within 8 degrees 30'."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649c5922-9ee6-4b93-8b30-62eaf1cfa1d1",
                                "sense_id": "0d627d9e-4539-33f0-aae0-c096b4da586e",
                                "text": "Guianerius had a patient could make Latin verses when the moon was combust, otherwise illiterate."
                            },
                            {
                                "example_id": "1b4bc3ec-f4fd-4885-841a-f99ae7bcd1bd",
                                "sense_id": "0d627d9e-4539-33f0-aae0-c096b4da586e",
                                "text": "Who can discern those planets that are oft Combust, and those stars of brightest magnitude that rise and set with the Sun, untill the opposite motion of their orbs bring them to such a place in the firmament, where they may be seen evning or morning."
                            }
                        ]
                    }
