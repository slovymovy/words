                "senses": [
                    {
                        "sense_id": "a74426d1-ad16-3942-822e-f20bde78481c",
                        "entry_id": "b529e2b0-616c-3d20-a7ee-39771926d567",
                        "glosses": [
                            "Personne sans logement."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1b18a152-d996-436b-b618-85740f294f5d",
                                "sense_id": "a74426d1-ad16-3942-822e-f20bde78481c",
                                "text": "Au cours d’une rafle opérée la nuit dernière dans les environs de la porte de Passy, les agents de la brigade mobile ont arrêté quinze sans-asile qui ont été envoyés au Dépôt."
                            },
                            {
                                "example_id": "839b1df5-e071-4a6c-aae5-84cba0a12f3b",
                                "sense_id": "a74426d1-ad16-3942-822e-f20bde78481c",
                                "text": "On requinqua les malheureux qui étaient dans le plus grand dénuement ; on rechercha et on logea les sans-asile dans les chambres vides des hôtels du voisinage."
                            }
                        ]
                    }
                ],
