                ],
                "senses": [
                    {
                        "sense_id": "b7ed999b-a2db-317a-b484-b6c60ace0c81",
                        "entry_id": "0f75a8a8-eb26-37e8-bd54-1502ff418d48",
                        "glosses": [
                            "maatregel ter bestraffing van ongewenst gedrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "288da537-62c4-4f50-a1b3-62aedb142ae3",
                                "sense_id": "b7ed999b-a2db-317a-b484-b6c60ace0c81",
                                "text": "Tegen het apartheidsbewind werden steeds meer sancties getroffen."
                            },
                            {
                                "example_id": "a5a77480-6688-4726-9bf3-7b77c8ada605",
                                "sense_id": "b7ed999b-a2db-317a-b484-b6c60ace0c81",
                                "text": "EU koopt voor een recordbedrag aan Russisch gas ondanks sancties."
                            },
                            {
                                "example_id": "55b7d863-d42f-4426-a939-9919ae06c81f",
                                "sense_id": "b7ed999b-a2db-317a-b484-b6c60ace0c81",
                                "text": "Dit heeft REPO, een speciale werkgroep die aan de sancties werkt, naar buiten gebracht. Het zou gaan om 300 miljard dollar van de centrale bank in Moskou en nog eens 30 miljard dollar aan bezittingen van politieke en zakelijke relaties van president Vladimir Poetin. Ook zijn er onder meer diverse luxejachten in beslag genomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "34188917-0cfb-3386-98ea-5fd56c59c1b3",
                        "entry_id": "0f75a8a8-eb26-37e8-bd54-1502ff418d48",
                        "glosses": [
                            "bekrachtiging of goedkeuring"
                        ],
                        "tags": [],
                        "examples": []
                    },
