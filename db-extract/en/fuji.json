                    {
                        "sense_id": "53d433d5-c626-3db5-861d-e94ed9164c2e",
                        "entry_id": "23daec25-7ce8-39be-8d4b-ea1cefe91aff",
                        "glosses": [
                            "A harbor in Shimen district, New Taipei City, Taiwan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac56a2f6-2551-42d5-86f5-0e8dc2ce7a1b",
                                "sense_id": "53d433d5-c626-3db5-861d-e94ed9164c2e",
                                "text": "After taking some time to dry off while having a seafood lunch at the nearby Fuchi (Fuji) Fishing Harbor 富基漁港, we continued down the coast to the Temple of the Eighteen Lords 十八王公廟."
                            },
                            {
                                "example_id": "91642c4f-ba9c-4f64-96da-0d4e8e6b7789",
                                "sense_id": "53d433d5-c626-3db5-861d-e94ed9164c2e",
                                "text": "A Wanli Crab is pictured in the northern coastal fishing port of Fuji Thursday by the Agriculture Department of the New Taipei City Government. Seafood promotional sales will be held during the 4-day Tomb Sweeping holiday from April 2-5. Photo courtesy of the Agriculture Department of New Taipei City Government March 31, 2016"
                            },
                            {
                                "example_id": "655615e9-5c66-4349-b6e3-d9d432b60227",
                                "sense_id": "53d433d5-c626-3db5-861d-e94ed9164c2e",
                                "text": "Fuji Fishing Port is in the Fuji Neighborhood of Shimen District in New Taipei City."
                            }
                        ]
