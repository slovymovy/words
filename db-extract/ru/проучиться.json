                    }
                ],
                "translations": [
                    {
                        "translation_id": "eea7dbe3-72b3-4e0f-9750-4d98b023cfb3",
                        "source_entry_id": "a11a12c6-2b26-3869-9051-05f8e27e55aa",
                        "source_sense_id": "3d26d086-97dd-31f7-bba4-6220fa887606",
                        "target_lang_word": "study",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "study",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66668202-cb2c-351e-bb9c-40e2e13fe6b6",
                                        "entry_id": "f9bae053-290c-35fd-8139-253a43b5a270",
                                        "glosses": [
                                            "To review materials already learned in order to make sure one does not forget them, usually in preparation for an examination."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literary",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f37ef0a1-5836-44eb-943e-e033664d0722",
                                                "sense_id": "66668202-cb2c-351e-bb9c-40e2e13fe6b6",
                                                "text": "Students are expected to start studying for final exams in March."
                                            },
                                            {
                                                "example_id": "755d3a88-d835-4946-81d7-0ce11ed65f45",
                                                "sense_id": "66668202-cb2c-351e-bb9c-40e2e13fe6b6",
                                                "text": "I need to study my biology notes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f9877b1-aeb5-3153-8968-33f6ba1209b4",
                                        "entry_id": "f9bae053-290c-35fd-8139-253a43b5a270",
                                        "glosses": [
                                            "To take a course or courses on a subject."
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dba98e2-abb6-4ddd-83bd-53d1e222869b",
                                                "sense_id": "3f9877b1-aeb5-3153-8968-33f6ba1209b4",
                                                "text": "I study medicine at the university."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2399e84-b9c6-31ce-8c7f-93c7b0cfddbd",
                                        "entry_id": "f9bae053-290c-35fd-8139-253a43b5a270",
                                        "glosses": [
                                            "To acquire knowledge on a subject with the intention of applying it in practice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3494f0b-82a9-4449-b0eb-f9cd783cdda8",
                                                "sense_id": "b2399e84-b9c6-31ce-8c7f-93c7b0cfddbd",
                                                "text": "Biologists study living things."
                                            },
                                            {
                                                "example_id": "89bc0828-e7cb-4ed0-9add-2380c37a3efa",
                                                "sense_id": "b2399e84-b9c6-31ce-8c7f-93c7b0cfddbd",
                                                "text": "In 2015, scientists found that 82 percent of glaciers studied in China had decreased in size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d35795-1309-3cea-a7f1-d81c53c38924",
                                        "entry_id": "f9bae053-290c-35fd-8139-253a43b5a270",
                                        "glosses": [
                                            "To look at carefully and minutely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "471819b8-f511-4cf0-b6ab-a1218936be1d",
                                                "sense_id": "c1d35795-1309-3cea-a7f1-d81c53c38924",
                                                "text": "He studied the map in preparation for the hike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043525bc-cd93-39aa-abb5-f5b080dddcf8",
                                        "entry_id": "f9bae053-290c-35fd-8139-253a43b5a270",
                                        "glosses": [
                                            "To fix the mind closely upon a subject; to dwell upon anything in thought; to muse; to ponder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ebb2d13-4138-46b5-9209-f1202d325afa",
                                                "sense_id": "043525bc-cd93-39aa-abb5-f5b080dddcf8",
                                                "text": "July 10, 1732, Jonathan Swift, letter to Mr. Gay and The Duchess of Queensberry\nI found a moral first, and studied for a fable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067330f7-24f8-3a33-aa34-fcfdbdbcfeeb",
                                        "entry_id": "f9bae053-290c-35fd-8139-253a43b5a270",
                                        "glosses": [
                                            "To endeavor diligently; to be zealous."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d24e7c01-c1a6-44cd-9653-0396b09c29c6",
                                                "sense_id": "067330f7-24f8-3a33-aa34-fcfdbdbcfeeb",
                                                "text": "And that ye study to be quiet, and to do your own business, and to work with your own hands, as we commanded you […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "study",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae59cd8-ba34-389a-a2f6-1a206cbf0e2b",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "Mental effort to acquire knowledge or learning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58f8486a-f9be-4978-acfd-64a9ebe2e6ef",
                                                "sense_id": "8ae59cd8-ba34-389a-a2f6-1a206cbf0e2b",
                                                "text": "The study of languages is fascinating."
                                            },
                                            {
                                                "example_id": "20b7fd14-f3ad-4447-844a-819e154098e7",
                                                "sense_id": "8ae59cd8-ba34-389a-a2f6-1a206cbf0e2b",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "746ec914-a750-49b2-907d-778356ce7dae",
                                                "sense_id": "8ae59cd8-ba34-389a-a2f6-1a206cbf0e2b",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            },
                                            {
                                                "example_id": "1d5b02b4-7fb6-4adb-831e-f53ae0b83ebd",
                                                "sense_id": "8ae59cd8-ba34-389a-a2f6-1a206cbf0e2b",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5975ecf6-cb34-34bd-a1df-7b203825b08f",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "The act of studying or examining; examination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a92e5d-456b-47be-b5b3-3819e6d2182c",
                                                "sense_id": "5975ecf6-cb34-34bd-a1df-7b203825b08f",
                                                "text": "I made a careful study of his sister."
                                            },
                                            {
                                                "example_id": "da798272-7c2e-4d68-8791-641f15ebc146",
                                                "sense_id": "5975ecf6-cb34-34bd-a1df-7b203825b08f",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4f55ce0-0cd9-35ac-b72e-8d3909da7538",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "Any particular branch of learning that is studied; any object of attentive consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632f0dff-749c-45c9-84b6-e619c1c76e40",
                                                "sense_id": "f4f55ce0-0cd9-35ac-b72e-8d3909da7538",
                                                "text": "The Holy Scriptures, especially the New Testament, are her daily study."
                                            },
                                            {
                                                "example_id": "0a6ace41-e32a-461f-9cec-480da4a39a8a",
                                                "sense_id": "f4f55ce0-0cd9-35ac-b72e-8d3909da7538",
                                                "text": "The proper study of mankind is man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ccf8f1-dbb4-325e-b3e9-095cf727af19",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "A room in a house intended for reading and writing; traditionally the private room of the male head of household."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ae13a9f-97d7-48c1-a718-164d2a4775d4",
                                                "sense_id": "50ccf8f1-dbb4-325e-b3e9-095cf727af19",
                                                "text": "Father spends all his time in the study poring over manuscripts."
                                            },
                                            {
                                                "example_id": "9aeb317c-d457-4e69-93c0-df18f6d15401",
                                                "sense_id": "50ccf8f1-dbb4-325e-b3e9-095cf727af19",
                                                "text": "his cheery little study"
                                            },
                                            {
                                                "example_id": "e8fcb86d-8c15-4d3c-9718-f0345c8aa853",
                                                "sense_id": "50ccf8f1-dbb4-325e-b3e9-095cf727af19",
                                                "text": "I was asked round once for dinner, and my tongue was hanging out at the sheer scale of it – complete with three bathrooms, two studies, and a sauna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b30eb95d-9cae-3106-9ed5-da066b5fd9cd",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "An artwork made in order to practise or demonstrate a subject or technique."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85ba7b7-a7ff-4edb-9cac-cf592406486e",
                                                "sense_id": "b30eb95d-9cae-3106-9ed5-da066b5fd9cd",
                                                "text": "a study of heads or of hands for a figure picture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4030b30-3fc8-39a4-ac97-58e5babac8f4",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "The human face, bearing an expression which the observer finds amusingly typical of a particular emotion or state of mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a2eef4-5c65-44e4-82de-18eb300ad390",
                                                "sense_id": "a4030b30-3fc8-39a4-ac97-58e5babac8f4",
                                                "text": "Geoffrey's face was a study."
                                            },
                                            {
                                                "example_id": "c84f7a36-3b85-49f6-9e6b-7576f1a712a6",
                                                "sense_id": "a4030b30-3fc8-39a4-ac97-58e5babac8f4",
                                                "text": "Geoffrey's face was a study in amazement [or in bewilderment, irritation, distress etc.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fca0251-b9b1-3632-b5bf-222dad825140",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "A piece for special practice; an etude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59cf3838-a08f-3267-aaed-7d6e12abfa54",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "An academic publication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2934338-f887-4987-a6bd-e8a18f060b4a",
                                                "sense_id": "59cf3838-a08f-3267-aaed-7d6e12abfa54",
                                                "text": "That new study on noncommutative symmetries looks promising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83043011-7288-3c06-ada9-311dddd89e15",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "One who commits a theatrical part to memory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4e313a3-9b9d-3ea8-9318-d555ac08d52b",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "An endgame problem composed for artistic merit, where one side is to play for a win or for a draw."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1bd7edd-7a58-3222-af28-77621c47874c",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "A state of mental perplexity or worried thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4529e930-063a-4bac-9a21-d80b2160be71",
                                                "sense_id": "e1bd7edd-7a58-3222-af28-77621c47874c",
                                                "text": "wel said the kynge thow mayst take myn hors by force but and I myȝte preue the whether thow were better on horsbak or I / wel said the knyght seke me here whan thow wolt and here nygh this wel thow shalt fynde me / and soo passyd on his weye / thenne the kyng sat in a study and bad his men fetche his hors as faste as euer they myghte",
                                                "translation": "Well, said the king, thou mayst take my horse by force, but an I might prove thee whether thou were better on horseback or I. Well, said the knight, seek me here when thou wilt, and here nigh this well thou shalt find me, and so passed on his way. Then the king sat in a study, and bade his men fetch his horse as fast as ever they might.",
                                                "english": "Well, said the king, thou mayst take my horse by force, but an I might prove thee whether thou were better on horseback or I. Well, said the knight, seek me here when thou wilt, and here nigh this well thou shalt find me, and so passed on his way. Then the king sat in a study, and bade his men fetch his horse as fast as ever they might."
                                            },
                                            {
                                                "example_id": "df1ad782-e2fb-48e7-aaf6-29b1ff5b71cc",
                                                "sense_id": "e1bd7edd-7a58-3222-af28-77621c47874c",
                                                "text": "When they had stood for a while without speech, gazing over the sea, Gro spake and said, “Consider how as day now dieth in yonder chambers of the west, so hath the glory departed from Witchland.” ¶ But the Red Foliot answered him not, being in a study."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6716d84-04ef-3aa1-ac37-437ce1e01138",
                                        "entry_id": "13312333-b908-3ee1-bf2c-0526fb02cde3",
                                        "glosses": [
                                            "Thought, as directed to a specific purpose; one's concern."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ce1a64-b570-4dda-a242-97a6762cae13",
                                                "sense_id": "b6716d84-04ef-3aa1-ac37-437ce1e01138",
                                                "text": "My study was to avoid disturbing her."
                                            },
                                            {
                                                "example_id": "c71f177e-21f6-4796-a9d9-b94afbd5dadd",
                                                "sense_id": "b6716d84-04ef-3aa1-ac37-437ce1e01138",
                                                "text": "Just men they seemd, and all thir study bent / To worship God aright, and know his works."
                                            }
                                        ]
                                    }
