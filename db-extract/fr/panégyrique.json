        "fr-extract.jsonl": [
            {
                "entry_id": "7c25d8a0-b9b1-33ab-abce-ade7fdf965fb",
                "word": "panégyrique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b2dd2fe-d3ac-4642-a6b5-b9db2e1275c9",
                        "entry_id": "7c25d8a0-b9b1-33ab-abce-ade7fdf965fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "panégyriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                        "entry_id": "7c25d8a0-b9b1-33ab-abce-ade7fdf965fb",
                        "glosses": [
                            "Discours public fait à la louange de quelqu’un ou de quelque chose, éloge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "033373d3-88e3-43d2-8260-46080f8f2b50",
                                "sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                                "text": "Ô crime ! ô honte ! La tribune du peuple français a retenti du panégyrique de Louis XVI ; nous avons entendu vanter les vertus et les bienfaits du tyran !"
                            },
                            {
                                "example_id": "4e04cc53-9a5c-4127-a376-d02ab7870a15",
                                "sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                                "text": "L’un célébrait les louanges d’Athelsthane dans un panégyrique lugubre ; un autre redisait, dans un poème généalogique en langue saxonne, les noms étrangement durs et sauvages de ses nobles ancêtres."
                            },
                            {
                                "example_id": "d579a805-d2cc-401d-9de9-b27ae1f9661c",
                                "sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                                "text": "Pendant que des regrets unanimes se formulaient à la Bourse, sur le port, dans toutes les maisons ; quand le panégyrique d’un homme irréprochable, honorable et bienfaisant, remplissait toutes les bouches, Latournelle et Dumay, […], vendaient, réalisaient, payaient et liquidaient."
                            },
                            {
                                "example_id": "a327da61-9e09-4287-ac9e-afaa5ccdf35a",
                                "sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                                "text": "Un colonel ventripotent lit, trémolos dans la voix, un panégyrique de l’État ouvrier et paysan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccffefe3-db7d-498c-8c0c-2e341c8e4a94",
                        "source_entry_id": "7c25d8a0-b9b1-33ab-abce-ade7fdf965fb",
                        "source_sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                        "target_lang_word": "Loblied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Loblied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                        "entry_id": "943b4cc0-91bc-31ce-a8b7-75cfc6dbfa43",
                                        "glosses": [
                                            "Lied, in dem jemand oder etwas gepriesen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f97179-da40-4605-a66b-326296bf34d1",
                                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                                "text": "„Dazu schreibt der Priester Prophet Zacharias im Loblied: Gottes Wille ist auch in Worten seiner Engel.“"
                                            },
                                            {
                                                "example_id": "fd4fa5b8-ae5d-49a6-8621-e5fd7096b5fc",
                                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                                "text": "„Es ist auch ein Loblied auf das bürgerliche Leben und auf die Harmonie von Natur und Kultur.“"
                                            },
                                            {
                                                "example_id": "7ede5d4c-39e4-4d6e-ab3d-4738519c9966",
                                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                                "text": "„Nun so komt, meine Lieben, um unsern Schöpfer bei dem Lichte seines herlichen Mondes ein Loblied für die Freuden des verflossenen Tages zu singen!“"
                                            },
                                            {
                                                "example_id": "07d53b03-9763-4550-86d3-94f6c6f9a02d",
                                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                                "text": "„Seit jener Zeit des Ambrosius wurden bis dato 35 000 solche Loblieder gezählt, und bisweilen gibt es noch heute Kleriker und Lateiner, die etwelche dichten.“"
                                            },
                                            {
                                                "example_id": "52679394-09c7-4887-ba47-2e29db525298",
                                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                                "text": "„Nonnen tanzen, Tausende singen Loblieder auf Baschar al Assad, dessen Porträt überlebensgroß über der Menge thront.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "386da578-963a-41b5-a0c0-ce59debcf3fa",
                        "source_entry_id": "7c25d8a0-b9b1-33ab-abce-ade7fdf965fb",
                        "source_sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                        "target_lang_word": "feierliche Lobrede",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b31bdf8b-73e2-4092-9141-769a09e7628c",
                        "source_entry_id": "7c25d8a0-b9b1-33ab-abce-ade7fdf965fb",
                        "source_sense_id": "7430ea23-96c2-304b-8206-d795bf1aa42b",
                        "target_lang_word": "panegyric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panegyric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc47dbd-6fbd-358f-b388-5258dc21ec72",
                                        "entry_id": "e9f6b407-b01d-326a-b5bd-a3a5a04d9cca",
                                        "glosses": [
                                            "A formal speech publicly praising someone or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd16804a-6135-4f1e-a827-900f350a7c35",
                                                "sense_id": "4dc47dbd-6fbd-358f-b388-5258dc21ec72",
                                                "text": "My little Friend Grildrig, you have made a moſt admirable Panegyrick upon your Country: […]"
                                            },
                                            {
                                                "example_id": "28a8ccc6-82b8-4ba6-890c-df1965532842",
                                                "sense_id": "4dc47dbd-6fbd-358f-b388-5258dc21ec72",
                                                "text": "Want of something else to say, and a very shady lane, disposed him to confidence; and he forthwith began a panegyric on himself, and on the good fortune of Miss Arundel, stating, he was now on his road to offer himself and his debts to her acceptance."
                                            },
                                            {
                                                "example_id": "11c47b17-f6db-40cd-bf3c-06dae617db4d",
                                                "sense_id": "4dc47dbd-6fbd-358f-b388-5258dc21ec72",
                                                "text": "The painter's absurd fits of jealousy, his wild devotion, his extravagant panegyrics, his curious reticences—he understood them all now, and he felt sorry."
                                            },
                                            {
                                                "example_id": "4fd18d65-51e3-4352-8480-b901a57e9e12",
                                                "sense_id": "4dc47dbd-6fbd-358f-b388-5258dc21ec72",
                                                "text": "He then spoke in the usual boastful manner of his progenitors, added a flaming panegyric upon himself, and strolled down the road to repeat his speech at the next house."
                                            },
                                            {
                                                "example_id": "59c05215-52af-4ae0-9653-9688e5640b52",
                                                "sense_id": "4dc47dbd-6fbd-358f-b388-5258dc21ec72",
                                                "text": "Another manifestation, significantly reaching its apogee in the midst of Antonine virtues, was the growing popularity of adoxographical exercises. Mock panegyrics were dashed off, not just by sardonic intellectuals such as Lucian, but also by trained courtiers and polished encomiasts of the stamp of [Marcus Cornelius] Fronto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778e99bb-c94b-3594-bd15-442380a0fb6d",
                                        "entry_id": "e9f6b407-b01d-326a-b5bd-a3a5a04d9cca",
                                        "glosses": [
                                            "Someone who writes or delivers such a speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "panegyric",
