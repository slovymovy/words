    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fb2dd42-de80-324a-aa69-a2e2baa37d0d",
                    "sense_definition": "Eerste, tweede en derde persoon enkelvoud onvoltooid tegenwoordige tijd van <w>moeten</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>moet</w> nu echt naar huis gaan omdat het al laat is.",
                            "target_lang_translations": {
                                "ru": "Мне <w>нужно</w> сейчас же идти домой, так как уже поздно.",
                                "en": "I really <w>have to</w> go home now because it is already late.",
                                "de": "Ich <w>muss</w> jetzt wirklich nach Hause gehen, weil es schon spät ist."
                            }
                        },
                        {
                            "text": "Hij <w>moet</w> elke dag hard werken om zijn gezin te onderhouden.",
                            "target_lang_translations": {
                                "ru": "Он <w>должен</w> много работать каждый день, чтобы содержать свою семью.",
                                "en": "He <w>has to</w> work hard every day to support his family.",
                                "de": "Er <w>muss</w> jeden Tag hart arbeiten, um seine Familie zu ernähren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dat moet",
                        "ik moet weg",
                        "het moet wel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первое, второе и третье лицо единственного числа настоящего времени глагола <w>moeten</w>.",
                        "en": "First, second, and third person singular present tense of <w>moeten</w>.",
                        "de": "Erste, zweite und dritte Person Singular Präsens Indikativ von <w>moeten</w> (müssen)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "должен",
                                "target_lang_sense_clarification": "обязанность (согласуется с родом)"
                            },
                            {
                                "target_lang_word": "нужно",
                                "target_lang_sense_clarification": "необходимость (безличная форма)"
                            },
                            {
                                "target_lang_word": "надо",
                                "target_lang_sense_clarification": "разговорная форма необходимости"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "have to",
                                "target_lang_sense_clarification": "external obligation or necessity"
                            },
                            {
                                "target_lang_word": "must",
                                "target_lang_sense_clarification": "strong internal obligation or deduction"
                            },
                            {
                                "target_lang_word": "need to",
                                "target_lang_sense_clarification": "requirement"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "muss",
                                "target_lang_sense_clarification": "1. und 3. Person Singular von 'müssen'"
                            },
                            {
                                "target_lang_word": "musst",
                                "target_lang_sense_clarification": "2. Person Singular von 'müssen'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "635c0145-b07e-334d-ba3c-13ae99d64596",
                    "sense_definition": "Gebiedende wijs van <w>moeten</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Moet</w> dat nou echt op deze onhandige manier gebeuren?",
                            "target_lang_translations": {
                                "ru": "<w>Обязательно</w> ли это должно происходить таким неудобным способом?",
                                "en": "Does that really <w>have to</w> happen in this clumsy way?",
                                "de": "<w>Muss</w> das denn wirklich auf diese umständliche Art und Weise geschehen?"
                            }
                        },
                        {
                            "text": "<w>Moet</w> niet denken dat je zomaar alles kunt maken.",
                            "target_lang_translations": {
                                "ru": "<w>Не нужно</w> думать, что тебе всё сойдет с рук.",
                                "en": "You <w>must</w> not think that you can just get away with anything.",
                                "de": "Du <w>musst</w> gar nicht denken, dass du dir einfach alles erlauben kannst."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повелительное наклонение глагола <w>moeten</w>.",
                        "en": "Imperative mood of <w>moeten</w>.",
                        "de": "Imperativform von <w>moeten</w> (müssen)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нужно",
                                "target_lang_sense_clarification": "в риторических вопросах или побуждениях"
                            },
                            {
                                "target_lang_word": "обязательно",
                                "target_lang_sense_clarification": "в значении неизбежности действия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "have to",
