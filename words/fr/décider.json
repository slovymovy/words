                    ]
                },
                {
                    "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                    "sense_definition": "Résoudre une difficulté ou trancher un litige après délibération.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
