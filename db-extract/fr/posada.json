                                                "text": "A rundown hostel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc75da6-d8b1-3bbb-a322-4fe31c272b91",
                                        "entry_id": "1f7e3f4b-7072-3c46-a107-85f2c5e4c693",
                                        "glosses": [
                                            "A temporary refuge for the homeless providing a bed and sometimes food."
                                        ],
                                        "tags": [
                                            "not US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "128696aa-02eb-3d82-a80b-39284e559109",
                                        "entry_id": "1f7e3f4b-7072-3c46-a107-85f2c5e4c693",
                                        "glosses": [
                                            "A small, unendowed college in Oxford or Cambridge."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c64d2cc-2dcc-4c39-9d75-be5359d2bdfd",
                                                "sense_id": "128696aa-02eb-3d82-a80b-39284e559109",
                                                "text": "There are also in Oxford certeine hostels or hals, which may rightwell be called by the names of colleges , if it were not that there is more libertie in them , than is to be seen in the other"
                                            }
                                        ]
                                    },
