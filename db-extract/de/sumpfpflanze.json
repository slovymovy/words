                        "entry_id": "5473e5af-7b29-37b5-96eb-3e6f75ab3677",
                        "glosses": [
                            "Pflanze, die vornehmlich oder ausschließlich in Sümpfen vorkommt, auf sumpfigem Boden wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d07636-db76-44f8-af72-ea2560ed4d29",
                                "sense_id": "6b103996-25e4-3377-b171-82d03754d936",
                                "text": "„Wenn der Gärtner nicht erfährt, wo und wie die Pflanze wächst, dann säet er am Ende den Samen einer Sumpfpflanze in trocknen Sand, als stammte er von einem Steppengewächs und steckt den Samen einer Kletterpflanze ins Wasser.“"
                            }
                        ],
