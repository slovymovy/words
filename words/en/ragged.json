{
    "word_family": [
        "rag",
        "raggery"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0ea2c1d-ac98-3d3d-8af3-8a9b5312936e",
                    "sense_definition": "In tatters or having a broken, worn-out texture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "worn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beggar wore a <w>ragged</w> coat that had seen better days.",
                            "target_lang_translations": {
                                "de": "Der Bettler trug einen <w>zerlumpten</w> Mantel, der schon bessere Tage gesehen hatte."
                            }
                        },
                        {
                            "text": "Strong winds tore the <w>ragged</w> sail during the storm.",
                            "target_lang_translations": {
                                "de": "Starke Winde zerrissen das <w>zerfetzte</w> Segel während des Sturms."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ragged coat"
                    ],
                    "target_lang_definitions": {
                        "de": "In Fetzen oder mit einer abgenutzten, kaputten Textur."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerlumpt",
                                "target_lang_sense_clarification": "bezogen auf Kleidung oder Stoffe"
                            },
                            {
                                "target_lang_word": "zerfetzt",
                                "target_lang_sense_clarification": "stark zerrissen oder abgenutzt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec1a628c-56fe-3ea1-b147-f1eb6383b1a9",
                    "sense_definition": "Wearing clothes that are torn or in poor condition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "worn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>ragged</w> child stood on the corner asking for help.",
                            "target_lang_translations": {
                                "de": "Ein <w>zerlumptes</w> Kind stand an der Ecke und bat um Hilfe."
                            }
                        },
                        {
                            "text": "The <w>ragged</w> street urchin played music for coins.",
                            "target_lang_translations": {
                                "de": "Der <w>zerlumpte</w> Straßenjunge spielte Musik für Münzen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Kleidung tragend, die zerrissen oder in schlechtem Zustand ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerlumpt",
                                "target_lang_sense_clarification": "in Lumpen gekleidet"
                            },
                            {
                                "target_lang_word": "verwahrlost",
                                "target_lang_sense_clarification": "in einem ungepflegten, armseligen Zustand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfeedd83-f2f7-3435-9d24-4fc441072962",
                    "sense_definition": "Having rough, uneven, or sharp edges.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uneven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers climbed over the <w>ragged</w> rocks near the cliff.",
                            "target_lang_translations": {
                                "de": "Die Wanderer kletterten über die <w>zerklüfteten</w> Felsen in der Nähe der Klippe."
                            }
                        },
                        {
                            "text": "The coastline had a <w>ragged</w> edge where the sea met the land.",
                            "target_lang_translations": {
                                "de": "Die Küstenlinie hatte einen <w>unebenen</w> Rand, wo das Meer auf das Land traf."
                            }
                        }
                    ],
                    "synonyms": [
                        "jagged"
                    ],
                    "common_phrases": [
                        "ragged rocks"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit rauen, unebenen oder scharfen Kanten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerklüftet",
                                "target_lang_sense_clarification": "bei Felsen oder Landschaften"
                            },
                            {
                                "target_lang_word": "uneben",
                                "target_lang_sense_clarification": "allgemein für Kanten oder Oberflächen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37b1a58f-0265-3345-92ae-95ab045e3390",
                    "sense_definition": "Not aligned on one side, resulting in an uneven vertical margin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uneven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document was formatted with a <w>ragged</w> right margin.",
                            "target_lang_translations": {
                                "de": "Das Dokument war mit einem <w>Flattersatz</w> am rechten Rand formatiert."
                            }
                        },
                        {
                            "text": "Designers often prefer a <w>ragged</w> edge for a more natural look.",
                            "target_lang_translations": {
                                "de": "Designer bevorzugen oft einen <w>unebenen</w> Rand für ein natürlicheres Aussehen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht auf einer Seite ausgerichtet, was zu einem unebenen vertikalen Rand führt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "flattersatz",
                                "target_lang_sense_clarification": "typografischer Fachbegriff für unebenen Rand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5714ccf9-f56f-3162-800d-b22ec6d68db7",
                    "sense_definition": "Lacking skill, reliability, or proper organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poor_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team gave a <w>ragged</w> performance and lost the game.",
                            "target_lang_translations": {
                                "de": "Das Team lieferte eine <w>unkoordinierte</w> Leistung ab und verlor das Spiel."
                            }
                        },
                        {
                            "text": "After the break, the match became increasingly <w>ragged</w>.",
                            "target_lang_translations": {
                                "de": "Nach der Pause wurde das Spiel zunehmend <w>holpriger</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ragged performance"
                    ],
                    "target_lang_definitions": {
                        "de": "Mangel an Geschick, Zuverlässigkeit oder ordentlicher Organisation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unkoordiniert",
                                "target_lang_sense_clarification": "bei Leistungen oder Abläufen"
                            },
                            {
                                "target_lang_word": "holprig",
                                "target_lang_sense_clarification": "bei einer Leistung, die nicht flüssig läuft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c958a07-baea-3cca-a7a3-1742d68be70e",
                    "sense_definition": "Having uneven levels or varying sizes within a data structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "uneven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer created a <w>ragged</w> array to store the data.",
                            "target_lang_translations": {
                                "de": "Der Programmierer erstellte ein <w>unregelmäßiges</w> Array, um die Daten zu speichern."
                            }
                        },
                        {
                            "text": "The database uses a <w>ragged</w> hierarchy for complex categories.",
                            "target_lang_translations": {
                                "de": "Die Datenbank verwendet eine <w>unregelmäßige</w> Hierarchie für komplexe Kategorien."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ragged array"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit ungleichen Ebenen oder variierenden Größen innerhalb einer Datenstruktur."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unregelmäßig",
                                "target_lang_sense_clarification": "in Bezug auf Datenstrukturen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccf96ae7-d087-3ee6-987b-e02a9d267ea7",
                    "sense_definition": "Simple past and past participle of <w>rag</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students <w>ragged</w> the new teacher until he left the room.",
                            "target_lang_translations": {
                                "de": "Die Schüler haben den neuen Lehrer so lange <w>aufgezogen</w>, bis er den Raum verließ."
                            }
                        },
                        {
                            "text": "He felt <w>ragged</w> by his friends after the embarrassing mistake.",
                            "target_lang_translations": {
                                "de": "Er fühlte sich von seinen Freunden nach dem peinlichen Fehler <w>aufgezogen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in British English to mean teasing or bullying."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheit und Partizip von 'rag' (aufziehen, necken)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufgezogen",
                                "target_lang_sense_clarification": "im Sinne von jemanden ärgern oder necken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}