        "pl-extract.jsonl": [
            {
                "entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                "word": "łapczywie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                        "entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                        "glosses": [
                            "w sposób łapczywy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cffbcbdf-d17f-43f0-95a7-c7debc750cae",
                                "sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                                "text": "Owce, woły i cielęta zarzynali na pobojowisku, jedząc łapczywie surowe mięso wraz z krwią"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3a7cff3-64c4-45b7-a125-8fce754e4ee3",
                        "source_entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                        "source_sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                        "target_lang_word": "hungrily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hungrily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3bfef5-cc29-30c6-bf10-db13587bc6aa",
                                        "entry_id": "08f84c34-0b5c-3ce8-8053-2211ac3b34f7",
                                        "glosses": [
                                            "In a hungry way or manner; with hunger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6277ae-5575-45e0-918d-750673c70680",
                                                "sense_id": "ea3bfef5-cc29-30c6-bf10-db13587bc6aa",
                                                "text": "For at the last shall the thunder, fleeing to escape from the doom of the gods, roar horribly among the Worlds; and Time, the hound of the gods, shall bay hungrily at his masters because he is lean with age."
                                            },
                                            {
                                                "example_id": "afc1fa17-b15a-4a8d-8ac7-e48b1ac4dccf",
                                                "sense_id": "ea3bfef5-cc29-30c6-bf10-db13587bc6aa",
                                                "text": "Nungi was too hungrily cross to be respectful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67327336-3d35-4998-a77d-7fd4a4aa55a8",
                        "source_entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                        "source_sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                        "target_lang_word": "ravenously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravenously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3844778a-8cc2-335e-9a97-07d4c2aa61a3",
                                        "entry_id": "83d8c0a5-5d69-3fdb-a0d6-5af22b3ccd27",
                                        "glosses": [
                                            "In a ravenous manner; voraciously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9563bf98-8965-4670-86d7-2f9e5e0af10a",
                                                "sense_id": "3844778a-8cc2-335e-9a97-07d4c2aa61a3",
                                                "text": "Francesca marked with delight the eager manner in which Guido began his meal, and almost forgot her own hunger in the amusement of watching him eat so ravenously;..."
                                            },
                                            {
                                                "example_id": "e30983e9-7d6e-4019-91d5-25df86c39b6e",
                                                "sense_id": "3844778a-8cc2-335e-9a97-07d4c2aa61a3",
                                                "text": "Our bread was baked for us by one of the Government cooks, and the scones and cakes which we consumed so ravenously were baked by my mother in a camp oven. This primitive but useful oven requires very little description. It is a round iron vessel, standing on three legs and covered with a dome-shaped tightly-fitting lid. Fire is placed above and below, and I know no more satisfactory mode of baking bread or cake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccfc19d6-21f3-4566-aed8-33875b86ff15",
                        "source_entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                        "source_sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                        "target_lang_word": "avidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                        "entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
                                        "glosses": [
                                            "D’une manière avide ; avec avidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "427607ab-6569-4e09-b83c-2caa4257ebe8",
                                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                                "text": "L’homme souleva ma tête avec des mouvements doux, me fit boire quelques gorgées d’un breuvage que j’avalai avidement."
                                            },
                                            {
                                                "example_id": "af47a634-919d-4d99-bc0f-a234c43e4f8c",
                                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                                "text": "On lui mit une boîte de viande entre les mains et il en dévora avidement le contenu, non sans boire à même la bouteille d’ale."
                                            },
                                            {
                                                "example_id": "0f8c299a-b36e-44e7-a617-94549cf7df6b",
                                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                                "text": "— Il la couvrait avidement de caresses, murmurait les mots d'amour les plus doux, et tous deux se perdaient dans une extase furieuse et passionnée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "598a38ae-3f25-4167-87e1-ce34f5ad6373",
                        "source_entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                        "source_sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                        "target_lang_word": "voracement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voracement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "320b8b76-a074-32f1-83b6-f17664f50770",
                                        "entry_id": "ebece8e6-b81b-35ba-a01b-ee23496167e1",
                                        "glosses": [
                                            "Avec voracité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ed67e9-51fa-4bac-932f-61c9ce47abfe",
                                                "sense_id": "320b8b76-a074-32f1-83b6-f17664f50770",
                                                "text": "À table, José, qui se tenait mal et mangeait voracement, répétait sa mère, et qui ne s’était pas lavé les mains, racontait sa course dans la lande avec Burthe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b584e83-5160-4c1e-b60d-b4a08fbf63ca",
                        "source_entry_id": "c929a543-1399-3169-89ef-505eb25595bc",
                        "source_sense_id": "71ca009c-636b-39d3-9e92-01783ef3cbb6",
                        "target_lang_word": "жадно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жадно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1b8bbc-603a-3573-bdda-cd1e9c4ced02",
                                        "entry_id": "cb597359-1f51-3e68-b691-e69aacb6225e",
                                        "glosses": [
                                            "наречие к жадный"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7546f66-528c-437f-8586-4e95a6db7e60",
                                                "sense_id": "0d1b8bbc-603a-3573-bdda-cd1e9c4ced02",
                                                "text": "Он много и жадно ел и много пил, как и всегда."
                                            },
                                            {
                                                "example_id": "0cea4e13-cad3-4249-b11b-3af0fcf0d940",
                                                "sense_id": "0d1b8bbc-603a-3573-bdda-cd1e9c4ced02",
                                                "text": "Сумасшедший, сидя на койке, жадно курил папиросу, которую ему дал Нехлюдов."
                                            },
                                            {
                                                "example_id": "d1512015-1477-4d17-8023-d426a300a7be",
                                                "sense_id": "0d1b8bbc-603a-3573-bdda-cd1e9c4ced02",
                                                "text": "Несколько раз похвалив детей и тем хотя отчасти удовлетворив мать, жадно впитывающую в себя эти похвалы, он вышел за ней в гостиную, где англичанин уже дожидался его, чтобы вместе, как они уговорились, ехать в тюрьму."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e80bbb-97cf-3cca-a902-3ef169694c86",
                                        "entry_id": "cb597359-1f51-3e68-b691-e69aacb6225e",
                                        "glosses": [
                                            "быстро, сразу (впитывать, поглощать)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b8ee8e-a134-451e-a458-cc9f98d75f3d",
                                                "sense_id": "73e80bbb-97cf-3cca-a902-3ef169694c86",
                                                "text": "Так земля полуденная, в палящие дни, жадно пьёт небесную росу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe36e20-9e56-3c46-bd9e-7294e2f2c110",
                                        "entry_id": "cb597359-1f51-3e68-b691-e69aacb6225e",
                                        "glosses": [
                                            "перен. с нетерпением, с напряжённым вниманием (следить за чем-либо, ожидать чего-либо и т.п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5909f619-dc18-47ff-b541-a1ccbf77e008",
                                                "sense_id": "cfe36e20-9e56-3c46-bd9e-7294e2f2c110",
                                                "text": "Её слух жадно ловил далёкие, еле слышные здесь, на высоте скал, шумы и голоса вечно-беспокойных волн милого, непокорного моря."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "жадно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e9d727f4-146a-3e76-be1e-353998505d1e",
                                        "entry_id": "85969076-8ef6-3ad9-8f05-ecc2623340b2",
                                        "glosses": [
                                            "краткая форма среднего рода единственного числа прилагательного жадный"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
