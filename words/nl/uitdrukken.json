    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35c7726e-e6c5-3c62-a7f3-fab675e8f152",
                    "sense_definition": "een gevoel, gedachte of mening in woorden of tekens kenbaar maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is soms lastig om je gevoelens goed <w>uit te drukken</w> in een vreemde taal.",
                            "target_lang_translations": {
                                "en": "It is sometimes difficult to <w>express</w> your feelings well in a foreign language."
                            }
                        },
                        {
                            "text": "Hij <w>drukte</w> zijn dankbaarheid <w>uit</w> met een prachtig boeket bloemen voor de gastvrouw.",
                            "target_lang_translations": {
                                "en": "He <w>expressed</w> his gratitude with a beautiful bouquet of flowers for the hostess."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwoorden",
                        "uiten",
                        "formuleren"
                    ],
                    "antonyms": [
                        "verzwijgen",
                        "onderdrukken"
                    ],
                    "common_phrases": [
                        "gevoelens uitdrukken",
                        "zich uitdrukken",
                        "in woorden uitdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a feeling, thought, or opinion known through words or signs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "express",
                                "target_lang_sense_clarification": "to convey or communicate thoughts or feelings"
                            },
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "to put into words, especially an opinion"
                            },
                            {
                                "target_lang_word": "articulate",
                                "target_lang_sense_clarification": "to express an idea or feeling fluently and coherently"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00d97117-f6e0-37dd-bff4-2028dc3fa6a5",
                    "sense_definition": "iets weergeven of berekenen in een bepaalde eenheid of vorm, zoals geld of symbolen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De waarde van dit antieke schilderij is bijna niet in geld <w>uit te drukken</w>.",
                            "target_lang_translations": {
                                "en": "The value of this antique painting can hardly be <w>expressed</w> in money."
                            }
                        },
                        {
                            "text": "Je kunt de snelheid van een auto <w>uitdrukken</w> in kilometers per uur.",
                            "target_lang_translations": {
                                "en": "You can <w>express</w> the speed of a car in kilometers per hour."
                            }
                        }
                    ],
                    "synonyms": [
                        "weergeven",
                        "meten"
                    ],
                    "common_phrases": [
                        "in geld uitdrukken",
                        "in cijfers uitdrukken",
                        "in percentages uitdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "To represent or calculate something in a specific unit or form, such as money or symbols."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "express",
                                "target_lang_sense_clarification": "to represent in terms of a specific unit"
                            },
                            {
                                "target_lang_word": "state",
                                "target_lang_sense_clarification": "to present or specify in a certain way"
                            },
                            {
                                "target_lang_word": "put",
                                "target_lang_sense_clarification": "to state or express in a particular form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "883a8d7e-6169-367b-8a2c-302a15d082bb",
                    "sense_definition": "door te duwen of te persen iets naar buiten halen of verwijderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet een sigaret goed <w>uitdrukken</w> in de asbak om brand te voorkomen.",
                            "target_lang_translations": {
                                "en": "You must <w>put out</w> a cigarette properly in the ashtray to prevent fire."
                            }
                        },
                        {
                            "text": "Zij <w>drukte</w> voorzichtig de laatste restjes tandpasta <w>uit</w> de tube.",
                            "target_lang_translations": {
                                "en": "She carefully <w>squeezed</w> the last bits of toothpaste out of the tube."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitpersen",
                        "uitknijpen",
                        "doven"
                    ],
                    "common_phrases": [
                        "een sigaret uitdrukken",
                        "een puistje uitdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove or bring something out by pushing, pressing, or squeezing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "express",
                                "target_lang_sense_clarification": "to squeeze out liquid or contents"
                            },
                            {
                                "target_lang_word": "put out",
                                "target_lang_sense_clarification": "to extinguish a cigarette"
                            },
                            {
                                "target_lang_word": "squeeze out",
                                "target_lang_sense_clarification": "to force something out by pressing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}