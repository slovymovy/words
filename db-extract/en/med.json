                        ],
                        "form": "the MED"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "248dc05a-5a09-3d22-bf8f-46bec3791ad6",
                        "entry_id": "0b123240-e215-37d0-8144-736552c7fb71",
                        "glosses": [
                            "Initialism of Middle English Dictionary."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "9ae761d6-a14e-47c6-911c-39f962158cac",
                                "sense_id": "248dc05a-5a09-3d22-bf8f-46bec3791ad6",
                                "text": "As frequent users of the MED well know, of course, the MED history of ‘misledinge’ only appears inverted if we look at dates of composition, since it is in fact manuscript date that dictates the order of quotation under any of the semantic subdivisions in any MED entry."
                            },
                            {
                                "example_id": "adc7049d-89d3-46ab-baf3-d2a604c37078",
                                "sense_id": "248dc05a-5a09-3d22-bf8f-46bec3791ad6",
                                "text": "Make a list of the lexical (that is open-class words) in the passage, and use the OED and/or MED online to find other citations elsewhere in ME texts."
                            },
                            {
                                "example_id": "37365d88-5fa4-4787-a37d-bd0fb50fd7c4",
                                "sense_id": "248dc05a-5a09-3d22-bf8f-46bec3791ad6",
                                "text": "The MED evidence gives the impression that non-impersonal verbs of Pleasure/enjoyment other than lŏven cannot be strictly distinguished from the impersonal counterparts, apart from the presence or absence of impersonal use."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0cdfd2ea-bd50-3a1b-8c66-08ca4b5781de",
                "word": "Med",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "456074c8-4c5c-30f4-af03-143644fdca4f",
                        "entry_id": "0cdfd2ea-bd50-3a1b-8c66-08ca4b5781de",
                        "glosses": [
                            "Clipping of Mediterranean."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
