{
    "word_family": [
        "flittingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "958519e9-ddda-382b-9fe9-feb9459e2839",
                    "sense_definition": "To move about rapidly and nimbly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small birds <w>flit</w> between the branches of the trees in the garden.",
                            "target_lang_translations": {
                                "cs": "Malí ptáčci <w>poletují</w> mezi větvemi stromů v zahradě."
                            }
                        },
                        {
                            "text": "Butterflies <w>flit</w> from flower to flower in the warm summer sun.",
                            "target_lang_translations": {
                                "cs": "Motýli <w>poletují</w> z květu na květ v teplém letním slunci."
                            }
                        }
                    ],
                    "synonyms": [
                        "dart",
                        "flutter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle a hbitě se pohybovat sem a tam."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poletovat",
                                "target_lang_sense_clarification": "pohybovat se lehkým, rychlým pohybem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6efcfc4b-3886-39e9-a59a-153daf59dac0",
                    "sense_definition": "To move quickly from one location to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Shadows <w>flit</w> across the wall as the candle burns low.",
                            "target_lang_translations": {
                                "cs": "Stíny <w>těkají</w> po zdi, jak svíčka dohořívá."
                            }
                        },
                        {
                            "text": "Memories <w>flit</w> through her mind as she looks at the old photographs.",
                            "target_lang_translations": {
                                "cs": "Vzpomínky jí <w>těkají</w> myslí, když se dívá na staré fotografie."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "skim"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle se přesunout z jednoho místa na druhé."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "těkat",
                                "target_lang_sense_clarification": "rychle přecházet (např. pohledem nebo myšlenkami)"
                            },
                            {
                                "target_lang_word": "přelétávat",
                                "target_lang_sense_clarification": "rychle se přesouvat z místa na místo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8734e197-2a85-3ded-88c9-f56d4c647fa2",
                    "sense_definition": "To move house, sometimes suddenly to avoid debts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>flit</w> in the middle of the night to escape their creditors.",
                            "target_lang_translations": {
                                "cs": "Museli se <w>tajně odstěhovat</w> uprostřed noci, aby unikli věřitelům."
                            }
                        },
                        {
                            "text": "The family decided to <w>flit</w> to a new city after the lease expired.",
                            "target_lang_translations": {
                                "cs": "Rodina se rozhodla <w>přestěhovat</w> do nového města poté, co vypršela nájemní smlouva."
                            }
                        }
                    ],
                    "synonyms": [
                        "relocate",
                        "move"
                    ],
                    "common_phrases": [
                        "moonlight flit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přestěhovat se, někdy náhle, aby se člověk vyhnul dluhům."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tajně se odstěhovat",
                                "target_lang_sense_clarification": "náhlé opuštění bydliště (často kvůli dluhům)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3b7cd3e-7a97-3894-9131-2c039e7ea292",
                    "sense_definition": "To unpredictably change state for short periods of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The screen began to <w>flit</w> because of a loose connection in the cable.",
                            "target_lang_translations": {
                                "cs": "Obrazovka začala <w>blikat</w> kvůli uvolněnému kontaktu v kabelu."
                            }
                        },
                        {
                            "text": "The light will <w>flit</w> if the voltage is not stable.",
                            "target_lang_translations": {
                                "cs": "Světlo bude <w>mihotat</w>, pokud napětí není stabilní."
                            }
                        }
                    ],
                    "synonyms": [
                        "flicker"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nepředvídatelně měnit stav na krátkou dobu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "blikat",
                                "target_lang_sense_clarification": "nestabilní světelný nebo obrazový projev"
                            },
                            {
                                "target_lang_word": "mihotat se",
                                "target_lang_sense_clarification": "nestálý, chvějivý pohyb nebo světlo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0f822b-58d7-3ad2-9564-a9d786c3f8f4",
                    "sense_definition": "To move a tethered animal to a new grazing location.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "relocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer had to <w>flit</w> the goats to fresh grass every morning.",
                            "target_lang_translations": {
                                "cs": "Farmář musel každé ráno <w>přepásat</w> kozy na čerstvou trávu."
                            }
                        },
                        {
                            "text": "It is time to <w>flit</w> the sheep to the other side of the field.",
                            "target_lang_translations": {
                                "cs": "Je čas <w>přepásat</w> ovce na druhou stranu pole."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přesunout uvázané zvíře na nové místo k pastvě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přepásat",
                                "target_lang_sense_clarification": "přesunout dobytek na jinou pastvu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e1b7620-d61a-3975-91a2-f470eac4c54e",
                    "sense_definition": "To be unstable; to be easily or often moved.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The curtains <w>flit</w> in the breeze coming through the open window.",
                            "target_lang_translations": {
                                "cs": "Záclony se <w>třepotají</w> ve vánku proudícím otevřeným oknem."
                            }
                        },
                        {
                            "text": "The loose papers <w>flit</w> around the room whenever the door is opened.",
                            "target_lang_translations": {
                                "cs": "Volné papíry <w>poletují</w> po místnosti, kdykoliv se otevřou dveře."
                            }
                        }
                    ],
                    "synonyms": [
                        "waver"
                    ],
                    "target_lang_definitions": {
                        "cs": "Být nestabilní; být snadno nebo často v pohybu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třepotat se",
                                "target_lang_sense_clarification": "rychlý, nestálý pohyb ve větru"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23ea13ec-cde3-3ae0-8bac-4a57ef68b990",
                    "sense_definition": "A fluttering or darting movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>flit</w> of its wings, the bird took off into the sky.",
                            "target_lang_translations": {
                                "cs": "Rychlým <w>třepotem</w> křídel pták vzlétl k obloze."
                            }
                        },
                        {
                            "text": "The sudden <w>flit</w> of the shadow caught my attention.",
                            "target_lang_translations": {
                                "cs": "Náhlý <w>pohyb</w> stínu upoutal mou pozornost."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Třepotavý nebo rychlý pohyb."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třepot",
                                "target_lang_sense_clarification": "rychlý, kmitavý pohyb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2887a9fb-cbfa-316a-ada1-3397318f3f8a",
                    "sense_definition": "A sudden departure from a property.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They made a midnight <w>flit</w> to avoid paying the overdue rent.",
                            "target_lang_translations": {
                                "cs": "Uprostřed noci se <w>tajně odstěhovali</w>, aby se vyhnuli placení dlužného nájemného."
                            }
                        },
                        {
                            "text": "The landlord was surprised by their sudden <w>flit</w> from the apartment.",
                            "target_lang_translations": {
                                "cs": "Domácí byl překvapen jejich náhlým <w>odstěhováním</w> z bytu."
                            }
                        }
                    ],
                    "synonyms": [
                        "departure"
                    ],
                    "common_phrases": [
                        "moonlight flit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhlý odchod z nemovitosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náhlé odstěhování",
                                "target_lang_sense_clarification": "často tajné opuštění bytu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2661c5b3-37f1-3e2c-a97b-cca092bdf698",
                    "sense_definition": "A particular, unexpected, short lived change of state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monitor had a brief <w>flit</w> before returning to normal.",
                            "target_lang_translations": {
                                "cs": "Monitor měl krátký <w>výpadek</w>, než se vrátil do normálu."
                            }
                        },
                        {
                            "text": "There was a small <w>flit</w> in the power supply during the storm.",
                            "target_lang_translations": {
                                "cs": "Během bouřky došlo k malému <w>záškubu</w> v napájení."
                            }
                        }
                    ],
                    "synonyms": [
                        "glitch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Konkrétní, nečekaná, krátkodobá změna stavu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výpadek",
                                "target_lang_sense_clarification": "krátkodobá technická chyba"
                            },
                            {
                                "target_lang_word": "záškub",
                                "target_lang_sense_clarification": "náhlý, krátký pohyb nebo chyba"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1051568-e21b-3c8c-8f04-faa59b646e7d",
                    "sense_definition": "A flow control unit or flow control digit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network router processes each <w>flit</w> to manage data traffic.",
                            "target_lang_translations": {
                                "cs": "Síťový směrovač zpracovává každý <w>flit</w> pro řízení datového provozu."
                            }
                        },
                        {
                            "text": "A single <w>flit</w> contains the header information for the packet.",
                            "target_lang_translations": {
                                "cs": "Jeden <w>flit</w> obsahuje hlavičkové informace pro paket."
                            }
                        }
                    ],
                    "common_phrases": [
                        "header flit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jednotka nebo číslice řízení toku dat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "flit",
                                "target_lang_sense_clarification": "technický termín pro část datového paketu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "329827a9-f79a-3a14-ba10-526bbbbde846",
                    "sense_definition": "A homosexual.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term was used as a derogatory <w>flit</w> in older literature.",
                            "target_lang_translations": {
                                "cs": "Tento výraz byl ve starší literatuře používán jako hanlivé označení <w>teplouš</w>."
                            }
                        },
                        {
                            "text": "He was unfairly labeled a <w>flit</w> by his peers.",
                            "target_lang_translations": {
                                "cs": "Vrstevníci ho nespravedlivě označili za <w>teplouše</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Offensive and dated term."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Homosexuál (hanlivé)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "teplouš",
                                "target_lang_sense_clarification": "hanlivé označení pro homosexuála"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae71bf58-a4b3-316a-afe3-463978850e41",
                    "sense_definition": "Fast and nimble.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flit</w> movements of the dancer were truly impressive to watch.",
                            "target_lang_translations": {
                                "cs": "Hbité pohyby tanečníka byly skutečně působivé na pohled."
                            }
                        },
                        {
                            "text": "He was known for his <w>flit</w> speed on the track.",
                            "target_lang_translations": {
                                "cs": "Byl známý svou mrštnou rychlostí na dráze."
                            }
                        }
                    ],
                    "synonyms": [
                        "nimble",
                        "agile"
                    ],
                    "antonyms": [
                        "clumsy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychlý a hbitý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hbitý",
                                "target_lang_sense_clarification": "rychlý a obratný"
                            },
                            {
                                "target_lang_word": "mrštný",
                                "target_lang_sense_clarification": "velmi obratný v pohybu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}