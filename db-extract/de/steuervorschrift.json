                ],
                "senses": [
                    {
                        "sense_id": "16b5f22b-3428-30b8-bedf-334879ac6dda",
                        "entry_id": "e793bc8b-bebe-3bff-ba48-990ec1c73a48",
                        "glosses": [
                            "durch den Gesetzgeber erlassene Regel (= Gesetz, Verordnung), welche die Erhebung von Steuern durch den Staat festlegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f48ed67-db8f-4564-9f15-44d296f82036",
                                "sense_id": "16b5f22b-3428-30b8-bedf-334879ac6dda",
                                "text": "Statt Steuervorschriften abzuschaffen, mit denen man andere [Länder] schädigt, haben mehrere Staaten in den vergangenen Jahren neue eingeführt oder planen dies sogar noch."
                            },
                            {
                                "example_id": "0a989122-e4ab-4319-a634-5f89782785fc",
                                "sense_id": "16b5f22b-3428-30b8-bedf-334879ac6dda",
                                "text": "Die Steuervorschrift aber, nach der Bewirtungsspesen steuerrechtlich anerkannt werden, verlangt ausdrücklich, daß „Geschäftsfreunde“ bewirtet worden sind."
                            },
                            {
                                "example_id": "bf2073e5-bb0f-4082-ae6c-39092b362f27",
                                "sense_id": "16b5f22b-3428-30b8-bedf-334879ac6dda",
                                "text": "1957 fiel die Steuervorschrift, wonach berufstätige Ehepaare steuerlich höher belastet werden sollten."
                            },
                            {
                                "example_id": "65436354-bb27-4a06-8773-be59058e902d",
                                "sense_id": "16b5f22b-3428-30b8-bedf-334879ac6dda",
                                "text": "Kaum eine Steuervorschrift unterlag so grundlegenden Änderungen wie die Regelungen zu den Kosten für Fahrten zwischen Wohnung und Arbeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
