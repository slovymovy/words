                        "cross_references": [
                            {
                                "target_word": "мугам",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "78167e09-f13d-31b0-8e78-e497467dfaad",
                                        "entry_id": "9da02915-fa06-35cb-b95b-fb8e7f6ab38a",
                                        "glosses": [
                                            "муз., этнолог. часть большого циклического произведения, называемого «дастгях», представляющего собой определённый жанр инструментальной и инструментально-вокальной музыки Закавказья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c97c16d-e22a-4498-8c5b-269d77e6d6c5",
                                                "sense_id": "78167e09-f13d-31b0-8e78-e497467dfaad",
                                                "text": "Азербайджанский дастгях - многочастный вокально-инструментальный цикл, основными компонентами которого являются мугамы одночастные вокально-инструментальные произведения с нерегулярным метроритмом импровизационного характера."
                                            },
                                            {
                                                "example_id": "65c0e225-34ce-4abb-a653-a1501e02a4a4",
                                                "sense_id": "78167e09-f13d-31b0-8e78-e497467dfaad",
                                                "text": "Мугамы в «Лейли и Меджнуне» заменяют арии, ариозо, речитативы, ансамбли и имеются в партии почти каждого действующего лица."
                                            },
                                            {
                                                "example_id": "39664232-6637-4d66-af85-90ec771d6fe4",
                                                "sense_id": "78167e09-f13d-31b0-8e78-e497467dfaad",
                                                "text": "К древней музыке Востока восходят мугамы — крупные вокально-инструментальные произведения."
                                            },
                                            {
                                                "example_id": "a121968c-5814-4c6c-bc86-82cd2e032d6c",
                                                "sense_id": "78167e09-f13d-31b0-8e78-e497467dfaad",
                                                "text": "В некоторых республиках Средней Азии и Закавказья сложилась самобытная форма народного творчества — мугамы. Такое название носят большие вокально-инструментальные поэмы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
