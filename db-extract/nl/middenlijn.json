                        "glosses": [
                            "een lijn die iets in twee gelijke helften verdeelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80613946-ca17-40b7-81f4-098a0b8e104f",
                                "sense_id": "d4da25a7-c5ba-3c35-9942-d2ea66823c0c",
                                "text": "Snel en geruisloos ging het door de gangen, tot Breukje van de middenlijn afweek naar opzij en een deur openduwde."
                            },
                            {
                                "example_id": "bdcb2c93-4f66-4294-9471-b286a1d68009",
                                "sense_id": "d4da25a7-c5ba-3c35-9942-d2ea66823c0c",
                                "text": "Even later speelde Fernandinho - ingevallen voor John Stones - een negatieve hoofdrol. Hij stapte op de middenlijn te gretig in op Vinicius, die zijn landgenoot handig door de benen speelde, in een ruk naar het doel van Ederson rende en besloot met een schuiver in de lange hoek: 3-2."
                            }
                        ]
                    }
