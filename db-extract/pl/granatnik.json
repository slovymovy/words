                        "sense_id": "4e4759d8-2160-3f03-89c3-78f8c65bcef7",
                        "entry_id": "db96df44-fde4-340e-9806-00f1251d3db0",
                        "glosses": [
                            "rodzaj długolufowej haubicy strzelającej granatami, używanej w XVIII–XIX wieku w artylerii polowej i oblężniczej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0a8acaf5-d927-3dd3-917c-b62853b42de7",
                        "entry_id": "db96df44-fde4-340e-9806-00f1251d3db0",
                        "glosses": [
                            "krótka strzelba o mocno rozszerzonej lufie do miotania niewielkich granatów przez piechotę w XVII–XVIII wieku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
