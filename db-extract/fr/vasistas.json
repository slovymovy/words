        "de-extract.jsonl": [
            {
                "entry_id": "a4761c62-aa1c-3172-9809-a234c384e338",
                "word": "vasistas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29ec557e-6385-3457-a009-5c77d27780fb",
                        "entry_id": "a4761c62-aa1c-3172-9809-a234c384e338",
                        "glosses": [
                            "Oberlichtfenster, Kämpferfenster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8007a2bb-0faa-4c50-bcb5-3100a97a42f7",
                                "sense_id": "29ec557e-6385-3457-a009-5c77d27780fb",
                                "text": "La porte a un vasistas.",
                                "translation": "Die Türe hat ein Oberlichtfenster."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "150e5abe-c3c0-404f-a115-df0aa5699c16",
                        "source_entry_id": "a4761c62-aa1c-3172-9809-a234c384e338",
                        "source_sense_id": "29ec557e-6385-3457-a009-5c77d27780fb",
                        "source_sense_description": "Oberlichtfenster, Kämpferfenster",
                        "target_lang_word": "Oberlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2fc68e-e817-3929-ab41-7def24a5ab7e",
                                        "entry_id": "b1927858-8418-3798-adbd-0ea46cf08215",
                                        "glosses": [
                                            "Fenster in der Decke eines Raums, das den Innenraum mit Tageslicht versorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82aa4511-9d62-4021-b523-64dc2a7b5af8",
                                                "sense_id": "cf2fc68e-e817-3929-ab41-7def24a5ab7e",
                                                "text": "„Die Ausbildung eines Oberlichtes ist abhängig von der Geometrie des Deckenausschnitts, der Deckenform, der Dachneigung, der Materialbeschaffenheit, der bevorzugten Lichtrichtung bzw. der möglichen Ausblendung der Sonne sowie dem gewünschten architektonischen Erscheinungsbild.“"
                                            },
                                            {
                                                "example_id": "04cca04e-96f8-4943-a360-ce444ca66d71",
                                                "sense_id": "cf2fc68e-e817-3929-ab41-7def24a5ab7e",
                                                "text": "„Die Sonne schien durch das kleine Oberlicht und vergoldete eine Zinkpfanne, die über dem Herd hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee5d85f5-4350-363f-b394-3e7bdac7db57",
                                        "entry_id": "b1927858-8418-3798-adbd-0ea46cf08215",
                                        "glosses": [
                                            "von oben in einen Raum hereinfallendes Tageslicht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab98da00-b7c3-33bf-a808-dff7c81663cc",
                                        "entry_id": "b1927858-8418-3798-adbd-0ea46cf08215",
                                        "glosses": [
                                            "der obere Teil eines Fensters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288db9f7-7ba4-409d-bb1a-ca332c6dc143",
                                                "sense_id": "ab98da00-b7c3-33bf-a808-dff7c81663cc",
                                                "text": "„Ich öffnete das Oberlicht, und Kasimir versprühte etwas Parfüm, das er aus seinem Gepäck in die Zelle eingeschmuggelt hatte.“"
                                            },
                                            {
                                                "example_id": "b1372840-f98a-4e03-b90c-f01f03a26a4f",
                                                "sense_id": "ab98da00-b7c3-33bf-a808-dff7c81663cc",
                                                "text": "„Oberlicht-Öffnungssysteme ermöglichen die einfache tägliche Lüftung durch Oberlichter aus Kunststoff, Holz oder Metall, welche nicht im Zugangsbereich des Nutzers liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6679a61-8392-4d1f-9473-393371beca9d",
                        "source_entry_id": "a4761c62-aa1c-3172-9809-a234c384e338",
                        "source_sense_id": "29ec557e-6385-3457-a009-5c77d27780fb",
                        "source_sense_description": "Oberlichtfenster, Kämpferfenster",
                        "target_lang_word": "Oberfenster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberfenster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                        "entry_id": "e3d925aa-be2e-3ff8-a3e1-4ebba333b479",
                                        "glosses": [
                                            "Fenster im oberen Bereich eines Raumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0362ee1-5355-4df9-96b2-59ae0cec5249",
                                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                                "text": "„Durch das gekippte Oberfenster drang der Verkehrslärm der Leipziger Straße herein.“"
                                            },
                                            {
                                                "example_id": "9c948d1e-e5d2-4310-b8b3-f4fb3f19d6d2",
                                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                                "text": "„Phasenweise waren die Diskussionen über das Oberfenster und den Notausgang das alles beherrschende Thema in der Kita.“"
                                            },
                                            {
                                                "example_id": "52faf7c2-94f3-4102-9333-d957a18aa083",
                                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                                "text": "„Eine dort angestellte Schwester erlitt beim Schließen eines Unterfensters dadurch einen Körperschaden, daß dabei das nur von 4 Riegeln festgehaltene Oberfenster auf ihren Kopf stürzte.“"
                                            },
                                            {
                                                "example_id": "4468aed9-7598-47d0-999f-9479d2c4d7e8",
                                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                                "text": "„Der Raum zwischen den Oberfenstern und den Scheidbögen der Schiffarkaden wird durch ein Triforium mit geschlossener Rückwand ausgefüllt; das Stabwerk des Triforiums ist Fortsetzung des Fensterstabwerkes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33587db4-89da-4b86-9b73-09f2da451f55",
                        "source_entry_id": "a4761c62-aa1c-3172-9809-a234c384e338",
