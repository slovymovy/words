                        "entry_id": "d39a375c-2e06-3f18-a672-0a2fdac71917",
                        "glosses": [
                            "Qui peut être déduit d’un bénéfice, d’un revenu, d’une déclaration fiscale, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f51c888-c13e-48b6-ab10-bfe8d5e1e2a8",
                                "sense_id": "767dc8d9-fcba-300a-9691-ffb3578ffa99",
                                "text": "La taxe sur la valeur ajoutée qui a grevé les éléments du prix d’une opération imposable est déductible de la taxe sur la valeur ajoutée applicable à cette opération."
                            }
                        ]
                    }
                ],
                "translations": [
