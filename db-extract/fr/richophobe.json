                        "examples": [
                            {
                                "example_id": "fe6c5dea-08c0-40dd-aa57-91992e1c1743",
                                "sense_id": "67945b9a-c9d0-31cc-8fae-1d867e601b0e",
                                "text": "Les slogans et les banderoles richophobes seront interdites, surtout lorsqu’elles banalisent des pratiques aussi humiliantes que « la main au portefeuille »."
                            },
                            {
                                "example_id": "acc92c5a-1d5f-4346-b5d8-00f92c936f20",
                                "sense_id": "67945b9a-c9d0-31cc-8fae-1d867e601b0e",
                                "text": "Et encore dans cette époque déprimante, la haine de l’autre, la haine antisémite jamais loin, la haine de classe, la haine des riches, puisque certains se revendiquent désormais richophobes."
                            }
                        ]
