                                "sense_id": "b91bcd26-64b7-35f1-ae2f-f2b578843c17",
                                "text": "Sac de couchage."
                            }
                        ]
                    },
                    {
                        "sense_id": "7da4c26d-965d-3d28-badc-e52d49151b41",
