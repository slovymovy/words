                                    {
                                        "sense_id": "27ad42b1-7dc1-3a6c-b9e4-99cc6e1fc398",
                                        "entry_id": "7c741431-ad99-3de3-ad36-566f17e245ea",
                                        "glosses": [
                                            "A multi-piece barrier used to close an opening, such as across a gate or channel, that is dropped into groves on the two sides of the opening."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5fa7c07-05b0-48b6-b9f1-0c724e4b9af3",
                        "source_entry_id": "4d901698-cafc-3237-a19e-24e1322d469e",
                        "target_lang_word": "flashboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flashboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3809785-17cb-3ddc-b0f5-fa79194aab30",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "A board placed temporarily upon a dam, river, stream, etc. (typically within a permanent frame) to raise the water above its usual level."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c45cd0-0585-42ce-98a8-66bdef9678d6",
                                                "sense_id": "b3809785-17cb-3ddc-b0f5-fa79194aab30",
                                                "text": "A form of cheap open weir which has been commonly constructed in the West is the open wooden frame and flashboard weir."
                                            },
                                            {
                                                "example_id": "9740f76f-38a7-4413-b15a-25f022d09d1d",
                                                "sense_id": "b3809785-17cb-3ddc-b0f5-fa79194aab30",
                                                "text": "The railing at the upstream side also serves as a guide and a support for the manually operated hoist for the flashboard placement and removal."
                                            },
                                            {
                                                "example_id": "ea8f8c24-28ff-4f4f-9122-6499e1429e09",
                                                "sense_id": "b3809785-17cb-3ddc-b0f5-fa79194aab30",
                                                "text": "Although flashboards are designed to fail when reservoir level rises rapidly to an elevation greater than the flashboards, NPI states that most flashboard failures occur as a result of debris or ice hitting the '''flashboards."
                                            },
                                            {
                                                "example_id": "f7f8a437-bc1e-4a08-9c4a-1dc5815ee6b8",
                                                "sense_id": "b3809785-17cb-3ddc-b0f5-fa79194aab30",
                                                "text": "The discharge pipe for the flashboard riser structure is sized as a culvert ( i.e., boards are out and ditch is flowing full), although the weir is normally sized as though boards are in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f819993-1508-390e-b00a-204997ea873c",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "A board that controls the flow of any material."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9ba859-e16c-49cf-8ccf-5a94c4bc40de",
                                                "sense_id": "2f819993-1508-390e-b00a-204997ea873c",
                                                "text": "There exists a trapezoidal groove in the bottom of each container and a flashboard fixed in feeding system which match the groove."
                                            },
                                            {
                                                "example_id": "b3958af3-035d-4371-8618-3dc627651e9b",
                                                "sense_id": "2f819993-1508-390e-b00a-204997ea873c",
                                                "text": "[…] a flashboard is installed on the outer side of the rear wall to adjust and open-close the seed discharge hole, with the flashboard fastened with a wedge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83599057-5628-37c1-a48e-c468e30a8afe",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "A sheet of material that is subjected to an electric pulse or flashover in order to produce plasma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e4e765-cffa-42b7-86c2-7e2245aa6a24",
                                                "sense_id": "83599057-5628-37c1-a48e-c468e30a8afe",
                                                "text": "The plasma produced by the flashboard was mostly C⁺ and C⁺⁺."
                                            },
                                            {
                                                "example_id": "c7a793af-bcb3-4b2e-b51e-8c3c57fa002d",
                                                "sense_id": "83599057-5628-37c1-a48e-c468e30a8afe",
                                                "text": "A polyethylene sheet (flashboard) is attached on the anode (aluminum), which acts as the ion source."
                                            },
                                            {
                                                "example_id": "764d04d4-9c77-4165-a786-d5672148510b",
                                                "sense_id": "83599057-5628-37c1-a48e-c468e30a8afe",
                                                "text": "The time delay between the beginning of the flashboard plasma formation and the HPM pulse generation, determines the plasma density encountered by the microwave pulse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f73df1e8-aafd-309b-bf27-a9940de1a799",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "Any automated display that shows temporary information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ad3bf0-293e-4e9d-91e5-0f3191dd4e78",
                                                "sense_id": "f73df1e8-aafd-309b-bf27-a9940de1a799",
                                                "text": "Thus encroaching telephone wires, angrily projecting one's arm, an overhanging flashboard, or tree, leaning walls, and overhanging roof, projecting eaves and the shooting of guns have all been regarded as invasions of the superincumbent airspace — the exclusive realm of the landownder."
                                            },
                                            {
                                                "example_id": "ae9cd0f3-5ce6-43f6-a212-1ffa7b29ce72",
                                                "sense_id": "f73df1e8-aafd-309b-bf27-a9940de1a799",
                                                "text": "With the new flashboard, a good team could concentrate on one target at a time, even in fairly heavy firing ."
                                            },
                                            {
                                                "example_id": "d708e83c-13b5-4b9f-bc2d-758aad581f3a",
                                                "sense_id": "f73df1e8-aafd-309b-bf27-a9940de1a799",
                                                "text": "In jumping, a jump recording and display system was newly developed to meet the requirements of this fast-moving event in which the jumper's results were instantaneously displayed on the electronic flashboard after performing a complex score calculation."
                                            },
                                            {
                                                "example_id": "e4cb27ef-52dd-4a91-bfd7-30c9a655450e",
                                                "sense_id": "f73df1e8-aafd-309b-bf27-a9940de1a799",
                                                "text": "They both looked at the computerized flashboard above the betting windows . It displayed a schedule of all of Sunday's National Football League games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "419ccc4a-f782-32d9-8205-52e10411dede",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "Any automated display that shows temporary information.",
                                            "An electronic display that shows the winning values in various gambling games such as keno or bingo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231ca646-fe0b-42d0-b1de-f62abc680dfc",
                                                "sense_id": "419ccc4a-f782-32d9-8205-52e10411dede",
                                                "text": "The holder of a ticket that contains a match of all the numbers on any one of the Player's Cards to the numbers on the Flashboard card using the 48 Flashboard card numbers and the 49th and 50th Bonus Balls shall be entitled to a prize of $50."
                                            },
                                            {
                                                "example_id": "e5fb44a3-f2f8-42d1-b486-87e154e3d0d9",
                                                "sense_id": "419ccc4a-f782-32d9-8205-52e10411dede",
                                                "text": "In the middle of the table, a roll-down hopper connected to a flashboard. Players bought cards from the dealer, then tried to roll a ball into the hopper in such a way that the flashboard would register a card of a suit and number that would match the cards the players had bought, filling in a four-card sequence."
                                            },
                                            {
                                                "example_id": "dba0a78e-fa38-41f5-9999-0956c026f880",
                                                "sense_id": "419ccc4a-f782-32d9-8205-52e10411dede",
                                                "text": "A breakopen bingo game begins when, in the presence of players, the organization calls and posts, either manually or by use of a flashboard, a predetermined quantity of bingo numbers."
                                            },
                                            {
                                                "example_id": "0a814f03-de4e-4424-a7f0-b5404adc513d",
                                                "sense_id": "419ccc4a-f782-32d9-8205-52e10411dede",
                                                "text": "It's quite possible that the flashboard has one or more burned-out light bulbs—the very same lamps that light up the numbers you needed to catch to turn your losing ticket into a winner!"
                                            },
                                            {
                                                "example_id": "44cf6fc2-43ce-47e8-87de-5401bd3df871",
                                                "sense_id": "419ccc4a-f782-32d9-8205-52e10411dede",
                                                "text": "He walked back to the closet and pulled out the Bingo flashboard. Mary glanced at the movement of the flashboard and paused."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c58f7eb5-88ee-34a4-8ed1-bcefe6081f48",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "An acrylic board used to display children's work in a school."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d51e2b4-f76b-3e19-9577-70b72f83b044",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "A board for displaying language material in the classroom, used like a flashcard but potentially holding more information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f728ab-2472-4185-b0dd-0ee8a4f1e6d7",
                                                "sense_id": "2d51e2b4-f76b-3e19-9577-70b72f83b044",
                                                "text": "Then he comes forward, takes the flashboard V, and stands in front of the class so that all may see it ."
                                            },
                                            {
                                                "example_id": "13b3d86c-088e-47cc-84d3-d9316db7148f",
                                                "sense_id": "2d51e2b4-f76b-3e19-9577-70b72f83b044",
                                                "text": "The tachistoscope is a mechanical flashboard, an apparatus for testing recognition, attention, and memory, which flashes images on a screen for measured periods of time, usually from 1/100 of a second to one second."
                                            },
                                            {
                                                "example_id": "3013c916-927a-447d-8ac8-08d15fb82256",
                                                "sense_id": "2d51e2b4-f76b-3e19-9577-70b72f83b044",
                                                "text": "It is also at this level that each sentence of the experience story is put on a separate strip of paper or flashboard."
                                            },
                                            {
                                                "example_id": "28838dfd-4f74-4b93-afe6-0156c09e96e5",
                                                "sense_id": "2d51e2b4-f76b-3e19-9577-70b72f83b044",
                                                "text": "A set of nine or ten flashboards is sufficient for most purposes and avoids the consumption of great quantities of card."
                                            },
                                            {
                                                "example_id": "8f15444d-d976-4e82-a10b-12812eeacc5d",
                                                "sense_id": "2d51e2b4-f76b-3e19-9577-70b72f83b044",
                                                "text": "Unlike a picture chart the flashboard contains only language material ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d84e72dc-a155-39eb-b9af-3f3c356d6991",
                                        "entry_id": "fadb1112-f85a-3cef-a118-5e3ee25e476f",
                                        "glosses": [
                                            "A device used in the 1920s for teaching typing skills which provided feedback on which key was pressed by lighting up the corresponding value."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a84881a-f997-447e-b3f4-1d27400a4106",
                                                "sense_id": "d84e72dc-a155-39eb-b9af-3f3c356d6991",
                                                "text": "There is a regular typewriter keyboard which is in mechanical connection with a scientifically designed, step by step \"flashboard.\" The machine is designed to develop accurate typists through the realization of visual images."
                                            },
                                            {
                                                "example_id": "deb6e23a-442a-4acc-bebb-e1d8f7ead041",
                                                "sense_id": "d84e72dc-a155-39eb-b9af-3f3c356d6991",
                                                "text": "This flashboard also is equipped with the standard layout of letters, signs, etc., each having a white spot under it, but which is conceled by a small shutter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
