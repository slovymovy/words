                                        "sense_id": "9f434816-ffa3-354d-b442-c71c1afe33c1",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To liquify by heat; melt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7762cb2b-994c-4861-aeb0-4c0eecef9132",
                                                "sense_id": "9f434816-ffa3-354d-b442-c71c1afe33c1",
                                                "text": "Pure sodium is a lustrous metal... it fuses very easily at a temperature of 97°, and distils at a bright red heat (742°...)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c81f7a-49d5-3cc9-9c10-1acea179e26e",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To melt together; to blend; to mix indistinguishably."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17eb5e8c-9f7f-4d0d-b372-a453beeff1f6",
                                                "sense_id": "b9c81f7a-49d5-3cc9-9c10-1acea179e26e",
                                                "text": "That each, who seems a separate whole,\nShould move his rounds, and fusing all\nThe skirts of self again, should fall\nRemerging in the general Soul,\nIs faith as vague as all unsweet: […]"
                                            },
                                            {
                                                "example_id": "1ab32cd8-b862-42c0-9db2-f9776755f921",
                                                "sense_id": "b9c81f7a-49d5-3cc9-9c10-1acea179e26e",
                                                "text": "All these were based broadly on the management framework of the old companies, except that the former Southern and North Eastern Areas of the old L.N.E.R. became separate management units, while the former L.M.S.R. and L.N.E.R. lines north of the Border were fused into a self-contained Scottish Region."
                                            },
                                            {
                                                "example_id": "8c6f30d8-733a-4bb1-9ab2-872f94268d5b",
                                                "sense_id": "b9c81f7a-49d5-3cc9-9c10-1acea179e26e",
                                                "text": "Actually the New York, New Haven and Hartford, Boston & Maine, Maine Central, Bangor & Aroostook and Rutland Railroads already are doing so; if they are fused, they would have a combined route mileage of 5,269 and assets totalling £318 million, [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b12b16-bc26-3012-b76c-2a612cb77672",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To melt together."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54bca4e8-7588-37cf-adb6-9a19b80466f1",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To combine through nuclear fusion."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0dd6df1-e1c4-31d5-bfb9-76c94353ef13",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To furnish with or install a fuse in (a circuit) to protect against overcurrent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb5ec125-d541-3947-9999-f3574efc567a",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To stop operating, having been protected against overcurrent by its fuse blowing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c95c15d-8031-4cd6-a809-c32a665cda9c",
                                                "sense_id": "bb5ec125-d541-3947-9999-f3574efc567a",
                                                "text": "When the bath overflowed, the downstairs lights fused, so we need a torch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06646844-6000-3703-b998-f32dff1ae091",
                                        "entry_id": "da03ecda-40f5-3558-8edf-226cc545738d",
                                        "glosses": [
                                            "To form a bicyclic compound from two similar or different types of ring such that two or more atoms are shared between the resulting rings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
