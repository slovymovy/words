                "senses": [
                    {
                        "sense_id": "a73f4fec-b745-3a01-a645-ef404db7ea6c",
                        "entry_id": "24bce4c7-1a56-3a24-9b33-2e8236864ac1",
                        "glosses": [
                            "Antrieb, bei dem der Ausstoß eines Ionenstrahls für die Fortbewegung genutzt wird"
                        ],
                        "tags": [
                            "Raumfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "d1ef9631-7aee-4671-b7fe-fa8bee85a746",
                                "sense_id": "a73f4fec-b745-3a01-a645-ef404db7ea6c",
                                "text": "„In den letzten Jahren hat sich das Prinzip des Ionenantriebes mit Xenon als Arbeitsmedium als zukunftsträchtig erwiesen.“"
                            },
                            {
                                "example_id": "4a7d61c4-20ff-40e5-8192-aa640d803511",
                                "sense_id": "a73f4fec-b745-3a01-a645-ef404db7ea6c",
                                "text": "„Klassische Raketenantriebe sind chemisch und basieren auf der Verbrennung riesiger Mengen an Treibstoff. Die Alternative sind elektrische Antriebe, zu denen auch Ionenantriebe gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
