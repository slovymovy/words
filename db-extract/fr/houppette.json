                                    {
                                        "sense_id": "0c247b36-6469-32eb-855b-f768bc6a16a3",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A small quantity of gas or smoke in the air."
                                        ],
                                        "tags": [
