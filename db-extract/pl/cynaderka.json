                "translations": [
                    {
                        "translation_id": "1d806036-b803-4e12-9124-460bcbc19e70",
                        "source_entry_id": "d64b7047-9e5b-37bb-b92f-b700e44d6861",
                        "source_sense_id": "58a08708-c3b6-32f6-9598-6e080c3b1a93",
                        "target_lang_word": "kidney",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kidney",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8982d0e5-12c4-30d8-a4bf-bb992fd17a42",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "An organ in the body that filters the blood, producing urine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e422ed4-2b24-4db0-a2dd-732fc0d7ff86",
                                                "sense_id": "8982d0e5-12c4-30d8-a4bf-bb992fd17a42",
                                                "text": "The liver and the kidneys of animals have long been gastronomically popular for their aphrodisiac properties."
                                            },
                                            {
                                                "example_id": "9bc39b1a-e94d-43d3-b741-b0f77c80ca51",
                                                "sense_id": "8982d0e5-12c4-30d8-a4bf-bb992fd17a42",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468b1578-4b26-3818-b3ce-63ad9830083f",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "This organ (of an animal) cooked as food."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "Constitution, temperament, nature, type, character, disposition. (usually used of people)"
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ae452b-2752-4888-b156-a3a2f917bf01",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "[…] think of that, – a man of my kidney, – think of that, […]"
                                            },
                                            {
                                                "example_id": "7f59d930-398a-4153-8909-7e07f685590e",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "Millions in the World of this Man's Kidney"
                                            },
                                            {
                                                "example_id": "c7c965a7-bd81-4ba7-ba99-f74ea001ee22",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "30th June, 1788, Robert Burns, letter to Mr Robert Ainslie\nYour poets, spendthrifts, and other fools of that kidney, pretend, forsooth, to crack their jokes on prudence."
                                            },
                                            {
                                                "example_id": "1861e761-bbcb-43cb-851f-f17cdf40c70e",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "I shall not want Honour in Heaven\n For I shall meet Sir Philip Sidney\nAnd have talk with Coriolanus\n And other heroes of that kidney."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a1a4db-920a-335a-aa1b-ace71aa3be81",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "A waiter."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697afd2b-da10-47c4-93b1-f376e0370703",
                                                "sense_id": "e0a1a4db-920a-335a-aa1b-ace71aa3be81",
                                                "text": "I once more desire my readers to consider that as I cannot keep an ingenious man to go daily to Will's under twopence each day merely for his charges, to White's under sixpence, nor to the Grecian without allowing him some plain Spanish, to be as able as others at the learned table; and that a good observer cannot speak with even Kidney at St. James's without clean linen; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "effb9c1b-447c-438a-bdaa-1664e4a2946a",
                        "source_entry_id": "d64b7047-9e5b-37bb-b92f-b700e44d6861",
                        "source_sense_id": "58a08708-c3b6-32f6-9598-6e080c3b1a93",
