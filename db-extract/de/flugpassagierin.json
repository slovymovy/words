                ],
                "senses": [
                    {
                        "sense_id": "fcfc2cb9-2865-3dd0-aaeb-4983544ea9c9",
                        "entry_id": "dd5b4224-99ea-330d-942e-3c77bd5bdd36",
                        "glosses": [
                            "weibliche Person, die eine Reise mit einem Flugzeug unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ecbb71-e8f8-4773-b0e3-a2f50aa6ec6a",
                                "sense_id": "fcfc2cb9-2865-3dd0-aaeb-4983544ea9c9",
                                "text": "„Eine Flugpassagierin hat in Wien bei ihrem Sitznachbarn eine Nähe zur Terrormiliz Islamischer Staat vermutet und so den Start der Maschine um Stunden verschoben.“"
                            },
                            {
                                "example_id": "19c355f7-c9f6-4807-b96f-2aa9898b6b4d",
                                "sense_id": "fcfc2cb9-2865-3dd0-aaeb-4983544ea9c9",
                                "text": "„Eine Flugpassagierin hat nach der Landung auf dem Moskauer Flughafen eine ungewollte Ehrenrunde gedreht: Die ältere Dame habe beim Griff nach ihrem Gepäck auf dem Gepäckband das Gleichgewicht verloren, sei auf das rotierende Band gestürzt und von diesem bis in den Frachtraum getragen worden, erklärte die Polizei des Flughafens Scheremetjewo am Sonntag gegenüber russischen Medien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
