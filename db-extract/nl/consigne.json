                                        "glosses": [
                                            "Instructions for how to reach a destination or how to do something"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "872648d9-951c-4edb-8c8d-a8ef9d9bb9e2",
                                                "sense_id": "ded0c5c5-013b-3cd0-9c1a-9a91529fe267",
                                                "text": "Please follow the attached directions when assembling these shelves."
                                            },
                                            {
                                                "example_id": "8ded1ed2-4881-4ab4-a864-79291089f363",
                                                "sense_id": "ded0c5c5-013b-3cd0-9c1a-9a91529fe267",
                                                "text": "I got so lost on my way downtown I had to ask for directions."
                                            }
                                        ]
                                    }
                                ]
