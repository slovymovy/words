                        "examples": [
                            {
                                "example_id": "ce26453b-ccf4-4adc-af6a-393a47305197",
                                "sense_id": "fcea2a17-8a05-3c2c-9bf4-7a913639d579",
                                "text": "Het is een wankel evenwicht waarop Landschap Overijssel balanceert aan het Lonnekermeer. Sinds vrijdag beschikt de landschapbeheerder over een nieuw pion in het subtiele spel: een observatiehut. ‘Als je alles afsluit, raak je de toekomst kwijt.’"
                            },
                            {
                                "example_id": "5b46cfd5-c99c-40f0-96a1-db24b2693964",
                                "sense_id": "fcea2a17-8a05-3c2c-9bf4-7a913639d579",
                                "text": "Bij observatiehut De Elsberg lieten zich veel herten zien. Het observatiepunt is al sinds augustus gesloten omdat het er eerder zo druk was dat bezoekers er geen anderhalve meter afstand konden houden. Toch kwamen er tijdens de bronst mensen heen en zijn daar bekeuringen uitgedeeld."
                            }
                        ]
