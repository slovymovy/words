                "senses": [
                    {
                        "sense_id": "e31bb311-7260-3225-935d-5405a91f2603",
                        "entry_id": "9ccca796-b478-3f15-a435-dee22c2820d7",
                        "glosses": [
                            "stählerner Helm"
                        ],
                        "tags": [
                            "Fußvolk",
                            "Frühe Neuzeit"
                        ],
                        "examples": [
                            {
                                "example_id": "07b9cc16-81f7-4b63-a6d1-fb3b7e913cd2",
                                "sense_id": "e31bb311-7260-3225-935d-5405a91f2603",
                                "text": "Die Sturmhaube ist eine Weiterentwicklung des Schallers."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0eb1d3b-e037-35b6-a53c-558579c7af5d",
                        "entry_id": "9ccca796-b478-3f15-a435-dee22c2820d7",
                        "glosses": [
                            "den ganzen Kopf und den Hals umhüllende Mütze, die entweder nur das Gesicht oder auch nur Augen und Mund freilässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794f1228-c990-4096-a691-c0ea81f701f4",
                                "sense_id": "a0eb1d3b-e037-35b6-a53c-558579c7af5d",
                                "text": "Die Demonstranten waren mit schwarzen Sturmhauben maskiert und verstießen somit gegen das Vermummungsverbot."
                            },
                            {
                                "example_id": "e968464f-416d-477b-a860-4dd534fd9f29",
                                "sense_id": "a0eb1d3b-e037-35b6-a53c-558579c7af5d",
                                "text": "„Und er kam herein mit einer Sturmhaube auf dem Kopf; einem eisernen Topf mit spitzen Wangenklappen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "251ba36b-9f14-4d92-b670-ac3e7e426c9f",
                        "source_entry_id": "9ccca796-b478-3f15-a435-dee22c2820d7",
                        "source_sense_id": "a0eb1d3b-e037-35b6-a53c-558579c7af5d",
                        "source_sense_description": "Kopf und den Hals umhüllende Mütze",
                        "target_lang_word": "morion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                        "entry_id": "dec81638-1bad-39d0-81e0-6d19181e9273",
                                        "glosses": [
                                            "A kind of open brimmed helmet used by footsoldiers in the 16th and 17th centuries, having no visor or bevor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b199f661-92f7-4765-8a98-a58e2916952d",
                                                "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                                "text": "The Roman footmen caried not their morions, sword and target only, as for other armes (saith Cicero) they were so accustomed to weare them continually, that they hindered them no more than their limbs[…]."
                                            },
                                            {
                                                "example_id": "47b6fb05-7205-40ae-9783-15f55dfa3ac1",
                                                "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                                "text": "This unlucky defect, however, his industry supplied by a vizor, which he made of paste-board, and fixed so artificially to the morrion, that it looked like an intire helmet."
                                            },
                                            {
                                                "example_id": "18b7a180-f1b9-48c5-8d2d-ade9d0c609ce",
                                                "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                                "text": "The morion is a kind of open helmet, without visor or bever, somewhat resembling a hat; it was commonly worn by the harqubussiers and musqueteers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "262e791c-f10a-3661-a5c2-84fb658d7aad",
                                        "entry_id": "9a0cb8ac-0200-3da9-a9a8-f0d162e650dd",
                                        "glosses": [
                                            "A brown or black variety of quartz."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2870fdd-d0c2-4840-bfa4-2df4d0dd6700",
                        "source_entry_id": "9ccca796-b478-3f15-a435-dee22c2820d7",
                        "source_sense_id": "a0eb1d3b-e037-35b6-a53c-558579c7af5d",
