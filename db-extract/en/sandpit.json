                        "entry_id": "14c107ee-020e-36bc-93a9-d94932cd797d",
                        "glosses": [
                            "A small-scale illustrative model of the theater of war in the Middle East."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f0bc8ef-005a-4ad1-94ad-c2cd938e5b0f",
                                "sense_id": "cf2bf170-7607-3c99-8af4-265ee2e242c5",
                                "text": "Originally designed to illustrate Kuwait and the oil pipelines, the 'sandpit', based on maps and photographs to a scale of 1:1,000,000, was extended to include other countries."
                            },
                            {
                                "example_id": "eb386e6c-532b-4fb7-be9a-732e520233af",
                                "sense_id": "cf2bf170-7607-3c99-8af4-265ee2e242c5",
                                "text": "[…] the commentaries on the battle given by Peter Snow with the aid of a model of the theatre of war, known as the 'Sandpit'."
                            },
                            {
                                "example_id": "73e4115e-190a-40ae-b813-0f6d73971ed9",
                                "sense_id": "cf2bf170-7607-3c99-8af4-265ee2e242c5",
                                "text": "[…] a conflict that did not fit so easily into the television studios, with their super-patriotic anchormen, their verbose ex-generals, their model tanks and their bloodless sandpits."
                            }
                        ]
                    }
