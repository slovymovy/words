                        "glosses": [
                            "Qui met en présence plusieurs partis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4ed038-d460-4e5d-9ad9-4c737305b471",
                                "sense_id": "29f82e33-c885-34c2-9137-d4d54142925c",
                                "text": "Elle considéra les revendications de la société civile urbaine en faveur d'une démocratie représentative pluripartite, exigence confortée par un grand nombre de donateurs occidentaux, comme une menace […]."
                            },
                            {
                                "example_id": "5852b0c4-9762-485f-a976-463b159edef2",
                                "sense_id": "29f82e33-c885-34c2-9137-d4d54142925c",
                                "text": "Cependant, le processus de transition de la Guinée vers un système pluripartite ne devait pas être terminé avant les premières élections législatives de 1995."
                            }
                        ]
                    },
                    {
                        "sense_id": "28a16e44-30c4-36c3-a114-2695751bae80",
                        "entry_id": "4cbc9894-d02e-39c8-95f2-06fcedbda9b1",
                        "glosses": [
                            "Qui est divisé en plusieurs parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "250a7da1-f3f7-4a51-bdae-5b5260d58a3f",
                                "sense_id": "28a16e44-30c4-36c3-a114-2695751bae80",
                                "text": "Cette Fougère se distingue de l'espèce précédente, avec laquelle elle a été confondue, par sa fronde normalement pluripartite jusqu'à la base, tandis que celle du C. digitata est plutôt lacérée que divisée, et cette lacération ne s'étend jamais jusqu'à la base du limbe."
                            }
                        ]
