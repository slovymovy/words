                ],
                "translations": [
                    {
                        "translation_id": "6d4b21d0-f4e5-4180-b1e6-f5ac04c64189",
                        "source_entry_id": "b977ef9d-dfef-3741-b5bf-39c589b7e20f",
                        "source_sense_id": "54d436aa-528d-3087-a85f-a6fe0b9b4c88",
                        "source_sense_description": "de daad van het belasteren.",
                        "target_lang_word": "Verleumdung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verleumdung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                        "entry_id": "cee8490b-b862-32b4-ba2e-a784e5cd7d76",
                                        "glosses": [
                                            "Rufschädigung durch falsche Aussagen oder Behauptungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dca24f7-47c3-4147-8f1b-0310965f8578",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "Die Verleumdung hinterlässt auch bei Widerruf ein schlechtes Image."
                                            },
                                            {
                                                "example_id": "18e5d9b8-d47c-44c9-8e33-e8ef27ae9cf1",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "Der Arbeitskollege meiner Tante wurde wegen Verleumdung angeklagt, weil er in der Abteilung behauptet hatte, er hätte meine Tante beim Ladendiebstahl beobachtet."
                                            },
                                            {
                                                "example_id": "0cff0c36-0fa2-4bef-87cf-74e1c37e7648",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "„Mengs schloß sich dem Gesandten an; er lud mich ein, bei ihm zu wohnen, damit ich nicht mehr der Verleumdung von Spitzeln ausgesetzt sei, von denen Madrid voll war.“"
                                            },
                                            {
                                                "example_id": "cd94be79-c71f-45cf-b9b6-0b843baddc1e",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "„Eine Verleumdung desjenigen, der anders in die Welt sieht, ist damit natürlich nicht per se gegeben, aber sie kann neheliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a4156c3-c358-3663-a8fa-4239f2426ef4",
                                        "entry_id": "cee8490b-b862-32b4-ba2e-a784e5cd7d76",
                                        "glosses": [
                                            "Straftatbestand des § 187 StGB, der verwirklicht ist, wenn jemand wider besseres Wissen über einen anderen eine unwahre Tatsache, also Vorgänge oder Zustände der Vergangenheit oder der Gegenwart, die dem Beweis zugänglich sind, behauptet, das heißt, als nach seiner eigenen Überzeugung wahr hinstellt oder verbreitet, sie also als Gegenstand fremden Wissens weitergibt, die dazu geeignet ist, diesen verächtlich zu machen, ihn in der öffentlichen Meinung herabzuwürdigen oder seinen Kredit zu gefährden"
                                        ],
                                        "tags": [
                                            "deutsches Strafrecht"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49f0e056-a0ae-4a1e-a33b-8624c9cf487c",
                        "source_entry_id": "b977ef9d-dfef-3741-b5bf-39c589b7e20f",
                        "source_sense_id": "54d436aa-528d-3087-a85f-a6fe0b9b4c88",
                        "source_sense_description": "de daad van het belasteren.",
                        "target_lang_word": "defamation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defamation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                        "entry_id": "f3835acf-71e6-322a-baeb-25850966d48c",
                                        "glosses": [
                                            "The act of injuring another person's reputation by any slanderous communication, written or oral; the wrong of maliciously injuring the good name of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d99e7a4-7a62-470f-a05a-fd7bb51c80d2",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "She sued his ex-boyfriend for defamation and is seeking $14,000."
                                            },
                                            {
                                                "example_id": "7d261924-66e3-446f-b888-2b35316a94a9",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "In a closed trial on December 24, 2004, the People’s Court of Jinshui District in the city of Zhengzhou, Henan Province, convicted Zhang Ruquan, along with his associate Zhang Zhengyao, in a public prosecution on charges of defamation that “seriously undermined social order or the state interest.” The two were sentenced to three years in prison for defaming former Chinese President Jiang Zemin."
                                            },
                                            {
                                                "example_id": "142f3666-4acd-4fbf-ac68-55a3edaabe68",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "An hour later, when the Fox board approved the wire payment for $787.5 million — one of the largest known defamation settlements in history — Fox acknowledged what we needed it to acknowledge: spreading false claims comes with a huge price tag."
                                            },
                                            {
                                                "example_id": "7d53dc7c-0039-450d-9828-4728e62750f1",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "Merryday, who was appointed by President Geroge^([sic]) H. W. Bush, said the complaint contains eighty pages of repetitive claims and praise for President Trump, but fails to establish the two counts of defamation alleged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65730856-e408-49a1-9441-a769d955a405",
                        "source_entry_id": "b977ef9d-dfef-3741-b5bf-39c589b7e20f",
                        "source_sense_id": "54d436aa-528d-3087-a85f-a6fe0b9b4c88",
                        "source_sense_description": "de daad van het belasteren.",
                        "target_lang_word": "diffamation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diffamation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e295ca6-336c-3952-8418-465b93d84de9",
                                        "entry_id": "433ee9c8-283e-3083-86fe-8374a4d804dc",
                                        "glosses": [
                                            "Action de diffamer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026cd704-0003-44e6-a20f-dba3430b5944",
                                                "sense_id": "0e295ca6-336c-3952-8418-465b93d84de9",
                                                "text": "Être en butte à de lâches diffamations."
                                            },
                                            {
                                                "example_id": "64313f38-f517-4a01-aed8-ea385f00ba35",
                                                "sense_id": "0e295ca6-336c-3952-8418-465b93d84de9",
                                                "text": "Il n’a pu souffrir une si cruelle diffamation."
                                            },
                                            {
                                                "example_id": "8d64af9c-ca0b-4d84-84ea-b6f76f184fff",
                                                "sense_id": "0e295ca6-336c-3952-8418-465b93d84de9",
                                                "text": "Se rendre coupable de diffamation."
                                            },
                                            {
                                                "example_id": "b82ca472-4773-46f1-a549-f5bc9102eb71",
                                                "sense_id": "0e295ca6-336c-3952-8418-465b93d84de9",
                                                "text": "La question de la liberté d’expression n’est pas compliquée. Mis à part la diffamation et l’appel à la violence, rien ne devrait être interdit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1d106e8-b8d7-34f1-a8a5-d74452c5cb29",
                                        "entry_id": "433ee9c8-283e-3083-86fe-8374a4d804dc",
                                        "glosses": [
                                            "En droit, l’allégation ou l'imputation d’un fait qui porte atteinte à l’honneur ou à la considération de la personne à laquelle le fait est imputé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3620669-5104-409d-b0a7-32d20a778610",
                                                "sense_id": "d1d106e8-b8d7-34f1-a8a5-d74452c5cb29",
                                                "text": "C’est là ce qui constitue le délit de diffamation, délit qui absorbe la calomnie, puisque le plaignant n’est obligé de prouver que la réalité de la diffamation et que le défendeur n’est pas en droit de lui opposer la vérité des faits."
                                            },
                                            {
                                                "example_id": "3d85612d-776d-4635-9220-0d700ea69d6d",
                                                "sense_id": "d1d106e8-b8d7-34f1-a8a5-d74452c5cb29",
                                                "text": "Le droit de la diffamation, qui, on s’en rend compte aisément, peut entrer en collision frontale avec le droit de la liberté d’expression, possède des caractéristiques différentes selon les pays démocratiques concernés."
                                            },
                                            {
                                                "example_id": "14ed717b-595d-49a2-a48e-fe6b4dce697f",
                                                "sense_id": "d1d106e8-b8d7-34f1-a8a5-d74452c5cb29",
                                                "text": "Ce lundi, se tient le procès en diffamation intenté par l’ex-maire de Drancy contre la journaliste Eve Szeftel pour son livre Le Maire et les Barbares, dans lequel elle dénonçait notamment les pratiques clientélistes de Jean-Christophe Lagarde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
