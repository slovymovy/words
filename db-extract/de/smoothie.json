                "senses": [
                    {
                        "sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                        "entry_id": "f5575eb5-6d0f-3ad5-a217-c1becd4b5e5e",
                        "glosses": [
                            "kaltes Mischgetränk aus püriertem Obst oder Gemüse, häufig auch mit Saft oder Milchprodukten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "582cd770-0b14-4912-9f73-852ca3b81bd1",
                                "sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                                "text": "„Wenn nichts im Kühlschrank ist, habe ich immer gefrorene Früchte da, um mir einen Smoothie zu mixen.“"
                            },
                            {
                                "example_id": "6179dc5a-0da3-4570-b410-3358c53a1d87",
                                "sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                                "text": "„Und nichts liegt da näher, als die Smoothies einfach in den bestehenden Speiseplan aufzunehmen und zusätzlich zu oder nach den Mahlzeiten zu trinken.“"
                            },
                            {
                                "example_id": "ae778dce-fb3b-46db-a363-b4fc638e84e5",
                                "sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                                "text": "„Mit frischem Obst und Gemüse lassen sich leckere, extrem gesunde und vor allem entzündungshemmende Smoothies zubereiten, die Immunboost-Smoothies!“"
                            },
                            {
                                "example_id": "9b502a04-b747-4ee0-ab0f-4040033b097c",
                                "sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                                "text": "„Sie können einen Smoothie ein bis zwei Tage in einem abgedeckten Behälter im Kühlschrank aufbewahren.“"
                            },
                            {
                                "example_id": "fe714944-fdd8-4925-a87c-5a2b3f8e6b85",
                                "sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                                "text": "„Statt die Smoothies in allen erdenklichen Farben und Sorten im Supermarkt zu kaufen, mixen sich immer mehr Verbraucher ihr Obst und Gemüse zuhause zurecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a56778f7-d194-4b18-ba03-04521a19109f",
                        "source_entry_id": "f5575eb5-6d0f-3ad5-a217-c1becd4b5e5e",
                        "source_sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                        "source_sense_description": "kaltes Mischgetränk aus püriertem Obst oder Gemüse, häufig auch mit Saft oder Milchprodukten",
                        "target_lang_word": "smoothie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoothie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4977fb76-d77f-3a87-8f71-2e1bb6b0f079",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A smooth-talking person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741c7657-e000-432a-801b-1f302c6f83a9",
                                                "sense_id": "4977fb76-d77f-3a87-8f71-2e1bb6b0f079",
                                                "text": "True to their reputations, Paul was a smoothie who put a public relations gloss on everything he said, and John was abrasive and sarcastic, speaking his mind and letting the chips fall where they may."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27032b09-1bae-3223-bca4-4e9d19c6db94",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A drink made from whole fruit, thus thicker than fruit juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5b69ca-0acb-4a83-9179-8196628e5972",
                                                "sense_id": "27032b09-1bae-3223-bca4-4e9d19c6db94",
                                                "text": "Sometimes he brings her smoothies from his favourite place on Judd Street. He has a weakness for these glutinous confections that are supposed to extend his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b396bf1e-91f6-3ad3-a197-9433ca062928",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A blending of different things, a mishmash"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6d29ff-f246-4a93-967a-0837ee539cdb",
                                                "sense_id": "b396bf1e-91f6-3ad3-a197-9433ca062928",
                                                "text": "He shook his head and cleared the pentup anger and sadness that mixed his mind into a smoothie of emotions he bottled up inside, then scolded himself for allowing the outburst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A member of the mod subculture who is relatively non-violent and wears expensive clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52df37dd-5bb9-4cc3-af4e-7863b9e908e8",
                                                "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                                "text": "1987, John Irwin (quoting Piri Thomas), The Felon\nThe decision to cool myself made the next two years the hardest I had done because it meant being a smoothie and staying out of trouble, which in prison is difficult, […]"
                                            },
                                            {
                                                "example_id": "87a4124c-52a9-4da8-845d-50e665fee1da",
                                                "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                                "text": "Film Comment's David Chute described him as: \"small, stringy and intense, but he's better dressed and groomed (than Ferrara), less of a punk and more of a smoothie.\""
                                            },
                                            {
                                                "example_id": "fdbb87b2-f3e4-4134-8dbc-769a2972cfa7",
                                                "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                                "text": "2011, Gerard DeGroot (quoting Brown), Seventies Unplugged\n[…] mods, skins, suedes, smoothies, punks, skunks, rude boys, soul boys and headbangers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A person with shaven body hair, especially pubic hair."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef5a2b6a-6770-407b-a010-5f3667b37caf",
                                                "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                                "text": "Smoothies seem much more acceptable now. Back in the \"good old days\" it [pubic hair] was almost essential for pics etc."
                                            },
                                            {
                                                "example_id": "ea424026-8d39-48d4-b9e2-201e76b0fac7",
                                                "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                                "text": "These new smoothies are everywhere. The \"Body for Life\" fitness program asks people to spend six weeks getting into shape and then send in before-and-after pictures. The men in the \"after\" shots invariably have shaved chests."
                                            },
                                            {
                                                "example_id": "d7d24775-113c-4481-81c9-8306491705b3",
                                                "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                                "text": "not a wisp of pubic hair peeking out of even the tiniest thongs and bikini briefs and jockstraps. they should hire, oh, zak spears. he'd blow these smoothies off the page."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26d0927e-789e-4d1f-be41-e468872037bd",
                        "source_entry_id": "f5575eb5-6d0f-3ad5-a217-c1becd4b5e5e",
                        "source_sense_id": "144039be-fe8e-3808-89b0-473dcbe3f5ea",
                        "source_sense_description": "kaltes Mischgetränk aus püriertem Obst oder Gemüse, häufig auch mit Saft oder Milchprodukten",
                        "target_lang_word": "smoothie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoothie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                        "entry_id": "c9c0c232-8e3b-3397-98bb-c7807040efb2",
                                        "glosses": [
                                            "Boisson faite principalement à base de fruits frais mixés ou en jus, selon les fruits, parfois mélangés à du yaourt, lait, fromage blanc ou de la glace pilée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1b1d01-2c4a-4d7d-9c8e-5e8ce8906836",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Des clients lisent ensemble des magazines qu'ils ont achetés, en mangeant une glace ou en swipant un smoothie (jus de fruits mixés au yaourt ou à la glace)."
                                            },
                                            {
                                                "example_id": "7d7f5be1-4eb6-461d-8bf8-77d8c596580a",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Les smoothies sont partout autour de nous : dans les bars à jus, dans les restaurants, dans nos supermarchés, et même dans les cafés !"
                                            },
                                            {
                                                "example_id": "6516ecc1-b1c9-45d3-bfce-a86748f647b6",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Un smoothie ultranutritif, plein de protéines et de vitamines !"
                                            },
                                            {
                                                "example_id": "12129bed-0049-421b-9904-8d5c4d581850",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Je commande toujours la même chose : du houmous allégé avec des graines germées et deux tranches de pain aux flocons d'avoine ([…]). Mais l'inconnue m'a encore devancée. Elle prend un smoothie au comptoir."
                                            },
                                            {
                                                "example_id": "1adf526f-a1da-442b-a9e8-e040acb846ad",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Igor était tellement enthousiaste de son aspect rajeuni qu'il est devenu le paladin des smoothies verts dans notre famille. Le matin, il se réveillait tôt et il préparait 6 à 8 litres de smoothie qui duraient deux ou trois jours […]."
                                            },
                                            {
                                                "example_id": "7d006f02-62f3-4dab-9c7e-a7fdf1de4f76",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Que l’on mange une banane, une poire ou un avocat en entier ou réduits en pièces dans un smoothie, on ingère la même quantité de fibres. En revanche, le fait de mixer les fibres, en les rendant plus petites, modifie la façon dont elles sont digérées, remarque Balazs Bajka, professeur de sciences nutritionnelles au King’s College de Londres."
                                            },
                                            {
                                                "example_id": "d3f21f04-12c6-4a9d-8963-c1a136589cac",
                                                "sense_id": "076100f1-0fb0-3814-8b45-6784592ace69",
                                                "text": "Pour accompagner ce menu primesautier, pourquoi ne pas goûter un smoothie pomme, carotte, céleri, aux vertus dépuratives ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
