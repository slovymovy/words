                "senses": [
                    {
                        "sense_id": "5093a6d2-1746-3320-8bd7-20a526aaf381",
                        "entry_id": "5c8bb8fc-0471-3e60-a425-6b54365558e7",
                        "glosses": [
                            "Ouvrier qui houppe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "184758d5-b283-395b-a638-daf43bb214d7",
                        "entry_id": "5c8bb8fc-0471-3e60-a425-6b54365558e7",
                        "glosses": [
                            "Fabricant et commerçant spécialisé dans les houppes, les toupets et les floches."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bff90114-e872-315a-a81c-b0ec87758080",
                        "entry_id": "5c8bb8fc-0471-3e60-a425-6b54365558e7",
                        "glosses": [
                            "Ensemble des parties aériennes d’un arbre (branches, rameaux et feuillage), à l’exception de la base du tronc (le fût)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527e1b69-7b2b-4c41-bda2-adebb90cf571",
                                "sense_id": "bff90114-e872-315a-a81c-b0ec87758080",
                                "text": "Cour Chabrié, un Platane solitaire (Platanus vulgaris) élève son houppier à plus de 20 m de hauteur. Il atteint 80 cm de diamètre."
                            },
                            {
                                "example_id": "1f2ecc84-fe02-4c3d-a823-ff22fc271d31",
                                "sense_id": "bff90114-e872-315a-a81c-b0ec87758080",
                                "text": "Un coq de bruyère ? Ce nom m’est inconnu, mais, chamboulé par cette apparition, je reste un long moment à fixer les houppiers, dont l’un cachait l’oiseau sauvage."
                            },
                            {
                                "example_id": "07eed026-d85a-423f-8813-2edb1b4d70d5",
                                "sense_id": "bff90114-e872-315a-a81c-b0ec87758080",
                                "text": "Ainsi, on parle d’une forêt dense ou fermée lorsque la projection des houppiers sur le sol couvre plus de 2/3 de la surface ; dans le cas contraire, il s’agit d’une forêt claire ou ouverte."
                            }
                        ]
                    },
                    {
                        "sense_id": "3719caca-5638-31e7-9880-068a49785a0c",
                        "entry_id": "5c8bb8fc-0471-3e60-a425-6b54365558e7",
                        "glosses": [
                            "Arbre ébranché auquel on n’a laissé que sa houppe."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dccf49f9-b817-3f08-8e1d-ccfe8b95b505",
                        "entry_id": "5c8bb8fc-0471-3e60-a425-6b54365558e7",
                        "glosses": [
                            "Maladie des arbres qui attaque la cime."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19ab28da-39cc-4a4f-b6c2-7fe358920348",
                        "source_entry_id": "5c8bb8fc-0471-3e60-a425-6b54365558e7",
                        "source_sense_id": "bff90114-e872-315a-a81c-b0ec87758080",
                        "source_sense_description": "Ensemble des parties aériennes d’un arbre",
                        "target_lang_word": "Baumkrone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baumkrone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                        "entry_id": "8ecd9fc0-fc85-3639-b92e-0f1d54be25ed",
                                        "glosses": [
                                            "benadelter bzw. belaubter Teil des Baumes, der sich zwischen dem Kronenansatz (erster grüner Ast, ohne Berücksichtigung der Klebäste) und dem Baumwipfel befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8902ac-33db-4618-876d-a06a124c60bf",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "Baumkronen sind überall wichtige Lebensräume, so dienen sie Vögeln als Nistplätze oder Eichhörnchen als Nahrungsquelle."
                                            },
                                            {
                                                "example_id": "3dd575e7-8872-460f-8990-78d163e65d16",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Die Granate schien in einer Baumkrone krepiert zu sein.“"
                                            },
                                            {
                                                "example_id": "24a562ee-a1ac-4c47-b53a-ac51f222aea2",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Er zeigte auf eine Hügelkette, die sich auf der anderen Seite des Tals über die Baumkronen erhob.“"
                                            },
                                            {
                                                "example_id": "b97a1d48-6d62-434c-8f0e-806c9b807436",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Anfangs hielten die Baumkronen das Wasser ab, dann fiel es umso heftiger auf die im Gras Schlafenden.“"
                                            },
                                            {
                                                "example_id": "ecd422f6-e2b6-4509-bd16-c6da72b7c5a7",
                                                "sense_id": "2fa7ec0e-f9f0-3def-a237-cf8b250be217",
                                                "text": "„Sie hockten unter Brückenbögen, in Baumkronen, in den Dachböden alter Windmühlen und Bauernhäuser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
