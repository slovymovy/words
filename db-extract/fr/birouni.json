                ],
                "senses": [
                    {
                        "sense_id": "465e2e18-353b-30de-a35c-393926f82d9b",
                        "entry_id": "65f90296-a561-341d-b535-1fc053326296",
                        "glosses": [
                            "Espace d'accueil proche de l'entrée de la maison traditionnelle iranienne, dont l’accès est permis aux hommes adultes qui ne sont pas membres de la famille, contrairement à l'andarouni, réservé aux femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca6eed6b-9c8a-4bdf-831b-d005053ad3dd",
                                "sense_id": "465e2e18-353b-30de-a35c-393926f82d9b",
                                "text": "D’ordinaire, je demeurais loin des portes d’entrée, celle du birouni, qui mène à la demeure des hommes et qui est la porte principale, et celle du jardin, par laquelle j’étais entré."
                            },
                            {
                                "example_id": "ee7bd46a-a23f-4176-ac0e-b0e7db89583b",
                                "sense_id": "465e2e18-353b-30de-a35c-393926f82d9b",
                                "text": "Dans certaines maisons à une ou deux cours, le birouni se définit par une pièce d'accueil près de l'entrée qui permet le contact extérieur sans pour autant entraver l'intimité de la famille ou permettre un accès au sein de la cour."
                            }
                        ]
                    }
                ],
