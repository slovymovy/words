                        "form": "more worthily"
                    },
                    {
                        "form_id": "c551ed5b-84f9-4b6c-b8cb-bee9d487b6a5",
                        "entry_id": "df0a03b1-736f-335c-a4ca-872b108a32bf",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most worthily"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba78b536-9af2-3803-a5a2-93cb4055a3b6",
                        "entry_id": "df0a03b1-736f-335c-a4ca-872b108a32bf",
                        "glosses": [
                            "In a worthy manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63562e5d-02d3-4ec5-b412-b480695b4ca6",
                                "sense_id": "ba78b536-9af2-3803-a5a2-93cb4055a3b6",
                                "text": "Then, as my gueſt, and thine ovvne acquiſition / VVorthily purchas'd, take my daughter […]"
                            },
                            {
                                "example_id": "70dc8a1b-fbed-42f9-810e-4adee67dd59a",
                                "sense_id": "ba78b536-9af2-3803-a5a2-93cb4055a3b6",
                                "text": "We should conceive of poetry worthily, and more highly than it has been the custom to conceive of it."
                            },
                            {
                                "example_id": "fa9f8f5b-44cc-42a1-8d28-01d8361af8bc",
                                "sense_id": "ba78b536-9af2-3803-a5a2-93cb4055a3b6",
                                "text": "This world-wide travel organisation recently attained its centenary, and under happier conditions than those prevailing at the present time the event would doubtless have been celebrated worthily."
                            },
                            {
                                "example_id": "aea071ae-7b1e-41bf-a901-90540c533a66",
                                "sense_id": "ba78b536-9af2-3803-a5a2-93cb4055a3b6",
                                "text": "[S]ustain worthily your name of gentleman, which has been worthily borne by your ancestors for five hundred years, both for your own sake and the sake of those who belong to you."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43b04dbd-76f3-42c2-9bad-105501dfd24c",
                        "source_entry_id": "df0a03b1-736f-335c-a4ca-872b108a32bf",
                        "source_sense_id": "ba78b536-9af2-3803-a5a2-93cb4055a3b6",
                        "source_sense_description": "in a worthy manner",
                        "target_lang_word": "dignement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dignement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25e820e6-7b74-3da2-9f0c-c2dac09f6dd0",
                                        "entry_id": "f3de1f2b-6178-30e1-b8f8-7ef6e4ae1c44",
                                        "glosses": [
                                            "Selon ce qu’on mérite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dfb8349-89e2-4197-a9cc-799918b1b5ab",
                                                "sense_id": "25e820e6-7b74-3da2-9f0c-c2dac09f6dd0",
                                                "text": "Je ne vous en saurais remercier dignement, assez dignement."
                                            },
                                            {
                                                "example_id": "38a3aaf5-e7ac-470f-942f-ca0924e92595",
                                                "sense_id": "25e820e6-7b74-3da2-9f0c-c2dac09f6dd0",
                                                "text": "Il a été dignement récompensé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b45d426-56a7-3f4f-832a-217a92815850",
                                        "entry_id": "f3de1f2b-6178-30e1-b8f8-7ef6e4ae1c44",
                                        "glosses": [
                                            "Convenablement, comme il faut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a75455-73b0-4e07-9587-59e21029e6b5",
                                                "sense_id": "4b45d426-56a7-3f4f-832a-217a92815850",
                                                "text": "S’acquitter dignement de sa mission."
                                            },
                                            {
                                                "example_id": "51b98aa7-b4db-41e9-9413-4ed587a88541",
                                                "sense_id": "4b45d426-56a7-3f4f-832a-217a92815850",
                                                "text": "Il s’est dignement comporté."
                                            },
                                            {
                                                "example_id": "073398f9-25f2-491a-b2bb-527e3af0ca8a",
                                                "sense_id": "4b45d426-56a7-3f4f-832a-217a92815850",
                                                "text": "C’est parler dignement."
                                            },
                                            {
                                                "example_id": "9c90e10d-6d6f-42d7-9d8d-b7e50f206d18",
                                                "sense_id": "4b45d426-56a7-3f4f-832a-217a92815850",
                                                "text": "Il a fait dignement les choses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
