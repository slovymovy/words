                ],
                "senses": [
                    {
                        "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                        "entry_id": "6c5133e6-6d56-3f29-bfec-e02541a435a6",
                        "glosses": [
                            "unbestimmte, kleine Sache, oft als Fortsatz eines anderen Gegenstands"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "08a765f5-a4bf-4d25-8e51-8498b0b308c8",
                                "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                                "text": "Steck das Ding auf den Pinöpel!"
                            },
                            {
                                "example_id": "e157f47b-f869-4c2f-81a8-cb201dcec16d",
                                "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                                "text": "„Wie bei den Konzernkumpels des neuen Octavia gibt es auch hier einen Mini-Wählhebel auf dem Mitteltunnel, von mir poetisch Pinöpel getauft.“"
                            },
                            {
                                "example_id": "03253f37-f005-4f98-885d-06ec5a08cecd",
                                "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                                "text": "Pinöpel"
                            },
                            {
                                "example_id": "5819cfca-9fff-48f1-9af8-6d77af635db9",
                                "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                                "text": "„Denn auf der Seite ‚Hamburg für Anfänger‘ wird Neubürgern erklärt, dass der Pinöpel ein Gegenstand ist, bei dem man nicht auf Anhieb sagen kann, um was es sich dabei eigentlich handelt.“"
                            },
                            {
                                "example_id": "4564f1a3-0fa5-4cd0-ae6d-6268ddeb7ac1",
                                "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                                "text": "„Tja, es gibt diesen tollen Pinöpel, den man drücken kann und das Benzin läuft, während man das Portemonnaie aus dem Auto hangelt oder andere Dinge erledigt.“"
                            },
                            {
                                "example_id": "46eaadc5-80bd-49a7-aab4-bf72ba8c4bb7",
                                "sense_id": "2adadc90-a5f5-31e8-b797-bae9eb31d2b8",
                                "text": "„Sybian ist so ein Masturbationshocker. Ein halbrundes Ding, wo auf der Oberseite ein Pinöpel ist, wo man verschiedene Aufsätze drauf tun kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
