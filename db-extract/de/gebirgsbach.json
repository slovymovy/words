                ],
                "senses": [
                    {
                        "sense_id": "5d5be908-6481-37ab-86fa-29d195a72597",
                        "entry_id": "74db309d-2559-3e2e-b332-b93660ce95bf",
                        "glosses": [
                            "Bach, der durch ein Gebirge fließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e752a6-ba4d-4b2c-a7b0-40bbceaa409a",
                                "sense_id": "5d5be908-6481-37ab-86fa-29d195a72597",
                                "text": "„Es war von Gebirgsbächen umgeben, die sich im Frühjahr, zur Zeit der Schneeschmelze, in reißende Fluten verwandelten.“"
                            },
                            {
                                "example_id": "a4a276bc-7ab2-43b8-b464-c511b697ef6a",
                                "sense_id": "5d5be908-6481-37ab-86fa-29d195a72597",
                                "text": "„Spektakulär steile Klippen spiegelten sich im Wasser. Verzerrte Gipfel, reflektiert in den wirbelnden Strudeln schneller Gebirgsbäche.“"
                            },
                            {
                                "example_id": "73948f65-5f83-4851-959e-46b4b1a49237",
                                "sense_id": "5d5be908-6481-37ab-86fa-29d195a72597",
                                "text": "„Ein Berghang. Ein Gebirgsbach. Eine Höhle in einem Flussufer. Eine Efeuranke. Alle diese Details fliegen ihr zu, und die kann Misty doch nicht liegen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
