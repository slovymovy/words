                    "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                    "sense_definition": "In a way that cannot be avoided or is certain to happen; inevitably.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Expensive products are not <w>necessarily</w> better than cheaper ones.",
                            "target_lang_translations": {
                                "ru": "Дорогие товары не <w>обязательно</w> лучше дешёвых.",
                                "zh": "昂贵的产品并不<w>一定</w>比便宜的产品更好。"
                            }
                        },
                        {
                            "text": "Just because he is quiet, it does not <w>necessarily</w> mean he is unfriendly.",
                            "target_lang_translations": {
                                "ru": "То, что он молчалив, не <w>обязательно</w> означает, что он недружелюбен.",
                                "zh": "仅仅因为他安静，并不<w>一定</w>意味着他不友好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "needs"
                    ],
                    "common_phrases": [
                        "not necessarily",
                        "necessarily true",
                        "necessarily mean"
                    ],
                    "target_lang_definitions": {
