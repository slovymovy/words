                        "examples": [
                            {
                                "example_id": "16edf690-969b-46c5-80d6-5becad8768f3",
                                "sense_id": "ed80ce25-c210-39fa-8d4b-f59006d62556",
                                "text": "Ook komt er een oplossing voor baggeraars die tot nu toe hun verontreinigd baggerslib niet kwijt konden. Vanaf vandaag kunnen ze daarvoor terecht bij baggerdepots van de Rijksoverheid. Volgens het kabinet is dat op korte termijn een oplossing voor baggerprojecten die door de PFAS-problematiek stil waren komen te liggen."
                            },
                            {
                                "example_id": "5a599245-7083-4093-a306-707bc7c65ae2",
                                "sense_id": "ed80ce25-c210-39fa-8d4b-f59006d62556",
                                "text": "Het lek werd gevonden bij een baggerdepot. \"Maar het zit echt heel diep onder de grond, dus het gaat nog even duren voordat we de watervoorziening helemaal hebben hersteld\", zegt een woordvoerster. Inmiddels wordt het water via andere leidingen omgeleid. Daardoor is de waterdruk wel lager dan normaal."
                            }
                        ]
                    }
