                                    {
                                        "sense_id": "982e9c12-5b64-32de-b026-80670ba8982c",
                                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                                        "glosses": [
                                            "The sound or action of something being scraped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e67aced7-85f6-4859-9e7b-61b8cea09ff7",
                                                "sense_id": "982e9c12-5b64-32de-b026-80670ba8982c",
                                                "text": "We explored the basement, wherein she had so often heard heavy footsteps, thuddings, and scrapings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c3b0f7-3091-374e-b2b6-d9fe081f680f",
                                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                                        "glosses": [
                                            "Something removed by being scraped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eba55b4-3d90-42d2-a34d-dd715bb7c4b5",
                                                "sense_id": "52c3b0f7-3091-374e-b2b6-d9fe081f680f",
                                                "text": "the scrapings of roads and ditches"
                                            },
                                            {
                                                "example_id": "8b6b5fa4-e270-41cf-97dd-a53e52e601de",
                                                "sense_id": "52c3b0f7-3091-374e-b2b6-d9fe081f680f",
                                                "text": "[…] the tables in the refectory would be laid out with plates of bread and scrapings of butter, with bowls ready for the saltless and slightly burned porridge, with the dark wells of golden syrup that served a universal purpose in early Australian cookery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1850dcde-8ec0-3603-a691-439185273ccb",
                                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                                        "glosses": [
                                            "Automated collection of data, data scraping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b08fbfd-f2d7-4bfc-bbcb-0c42a3c4679d",
                                                "sense_id": "1850dcde-8ec0-3603-a691-439185273ccb",
                                                "text": "The practice of scraping the internet is longstanding and was largely disclosed by the companies and nonprofit organizations that did it. But it was not well understood or seen as especially problematic by the companies that owned the data."
                                            }
                                        ]
                                    }
                                ]
