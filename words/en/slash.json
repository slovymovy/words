{
    "word_family": [
        "slasher",
        "slashing",
        "slash-and-burn"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b31bd7d-dfeb-33bb-9313-be52a4c037a9",
                    "sense_definition": "To reduce something, such as prices or a budget, very sharply and suddenly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store decided to <w>slash</w> prices by fifty percent to attract more customers during the holiday sale.",
                            "target_lang_translations": {
                                "ru": "Магазин решил <w>резко снизить</w> цены на пятьдесят процентов, чтобы привлечь больше покупателей во время праздничной распродажи.",
                                "zh": "为了在节日促销期间吸引更多顾客，这家商店决定把价格<w>大幅下调</w>百分之五十。"
                            }
                        },
                        {
                            "text": "The company had to <w>slash</w> overhead costs to remain profitable after the market crash.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось <w>урезать</w> накладные расходы, чтобы остаться прибыльной после краха рынка.",
                                "zh": "市场崩盘后，公司不得不<w>大幅削减</w>管理费用以维持盈利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cut",
                        "reduce",
                        "drop",
                        "axe",
                        "lower"
                    ],
                    "common_phrases": [
                        "slash prices",
                        "slash the budget",
                        "slash overhead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко и внезапно сокращать что-либо, например, цены или бюджет.",
                        "zh": "将某物，如价格或预算，突然大幅削减。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резко сокращать",
                                "target_lang_sense_clarification": "о ценах или бюджете"
                            },
                            {
                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "о расходах или штате"
                            },
                            {
                                "target_lang_word": "сбивать",
                                "target_lang_sense_clarification": "о ценах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大幅削减",
                                "target_lang_sense_clarification": "指价格、预算、成本等突然大幅降低"
                            },
                            {
                                "target_lang_word": "大幅下调",
                                "target_lang_sense_clarification": "多指价格明显降低"
                            },
                            {
                                "target_lang_word": "猛砍",
                                "target_lang_sense_clarification": "口语，强调狠而快地减少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe8e2f16-0eb1-385b-8e76-22f1ae78a207",
                    "sense_definition": "To cut something with a swift, broad, and forceful stroke, typically using an edged weapon or tool.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer had to <w>slash</w> her way through the thick vines of the jungle with a machete.",
                            "target_lang_translations": {
                                "ru": "Исследовательнице пришлось <w>прорубать</w> себе путь сквозь густые лианы джунглей с помощью мачете.",
                                "zh": "那名探险者不得不用砍刀一路<w>砍</w>开茂密的丛林藤蔓前进。"
                            }
                        },
                        {
                            "text": "He tried to <w>slash</w> at the rope, but the blade was too dull to make a clean cut.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>перерубить</w> веревку, но лезвие было слишком тупым для чистого разреза.",
                                "zh": "他试着朝那根绳子<w>猛砍</w>，但刀刃太钝，无法利落地切断。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gash",
                        "hack",
                        "slit"
                    ],
                    "common_phrases": [
                        "slash through",
                        "slash at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резать что-либо быстрым, широким и сильным ударом, обычно используя холодное оружие или инструмент.",
                        "zh": "用迅速、幅度大且有力的一击切砍某物，通常使用带刃的武器或工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рубить",
                                "target_lang_sense_clarification": "наносить удары острым инструментом"
                            },
                            {
                                "target_lang_word": "рассекать",
                                "target_lang_sense_clarification": "разделять ударом"
                            },
                            {
                                "target_lang_word": "полосовать",
                                "target_lang_sense_clarification": "наносить длинные разрезы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛砍",
                                "target_lang_sense_clarification": "用刀或利器用力砍"
                            },
                            {
                                "target_lang_word": "挥砍",
                                "target_lang_sense_clarification": "强调挥动利器砍击"
                            },
                            {
                                "target_lang_word": "砍",
                                "target_lang_sense_clarification": "把某物砍开或切开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70756edf-506a-3d8b-bd9b-d9049496f95a",
                    "sense_definition": "To clear land by cutting down and often burning trees and brush.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "land_clearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers in the region still use <w>slash</w>-and-burn techniques to prepare the soil for planting.",
                            "target_lang_translations": {
                                "ru": "Фермеры в этом регионе до сих пор используют методы <w>подсечно-огневого</w> земледелия для подготовки почвы к посадке.",
                                "zh": "这个地区的农民仍然使用<w>刀耕火种</w>的方式来整地备耕。"
                            }
                        },
                        {
                            "text": "The developers began to <w>slash</w> the forest to make room for the new housing complex.",
                            "target_lang_translations": {
                                "ru": "Застройщики начали <w>вырубать</w> лес, чтобы освободить место для нового жилого комплекса.",
                                "zh": "开发商开始<w>砍伐</w>森林，好为新的住宅区腾出空间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slash-and-burn agriculture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать землю, вырубая и часто сжигая деревья и кустарники.",
                        "zh": "通过砍倒并常常焚烧树木和灌木来清理土地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырубать",
                                "target_lang_sense_clarification": "лес для расчистки земли"
                            },
                            {
                                "target_lang_word": "подсекать",
                                "target_lang_sense_clarification": "в контексте подсечно-огневого земледелия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "砍伐",
                                "target_lang_sense_clarification": "指为腾地而砍树清林"
                            },
                            {
                                "target_lang_word": "烧荒开垦",
                                "target_lang_sense_clarification": "指通过砍树烧荒来开垦土地"
                            },
                            {
                                "target_lang_word": "刀耕火种",
                                "target_lang_sense_clarification": "固定说法，多指传统开垦方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5ba1267-2909-377e-bcf3-fde1072c0093",
                    "sense_definition": "To urinate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "urination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stopped behind a tree to <w>slash</w> before continuing the long hike.",
                            "target_lang_translations": {
                                "ru": "Он остановился за деревом, чтобы <w>отлить</w>, прежде чем продолжить долгий поход.",
                                "zh": "他在一棵树后停下来<w>撒尿</w>，然后继续长途徒步。"
                            }
                        },
                        {
                            "text": "The drunk man was caught trying to <w>slash</w> in the alleyway behind the pub.",
                            "target_lang_translations": {
                                "ru": "Пьяного мужчину поймали, когда он пытался <w>пописать</w> в переулке за пабом.",
                                "zh": "那个醉汉想在酒吧后面的巷子里<w>小便</w>时被逮了个正着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "piss",
                        "pee",
                        "urinate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мочиться (сленг).",
                        "zh": "小便；撒尿（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отлить",
                                "target_lang_sense_clarification": "грубый сленг"
                            },
                            {
                                "target_lang_word": "пописать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撒尿",
                                "target_lang_sense_clarification": "粗俗口语"
                            },
                            {
                                "target_lang_word": "小便",
                                "target_lang_sense_clarification": "较常见的口语说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f1a25e4-156a-3099-b987-d3e1b6f4d8ba",
                    "sense_definition": "The punctuation mark / used to separate words, numbers, or options.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "punctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please separate the day, month, and year with a <w>slash</w> when writing the date.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, разделяйте день, месяц и год <w>косой чертой</w> при написании даты.",
                                "zh": "写日期时，请用<w>斜杠</w>把日、月、年分开。"
                            }
                        },
                        {
                            "text": "The web address requires a forward <w>slash</w> after the domain name to work correctly.",
                            "target_lang_translations": {
                                "ru": "Для корректной работы веб-адреса после имени домена требуется <w>слэш</w>.",
                                "zh": "这个网址要想正常使用，域名后面必须加一个正<w>斜杠</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forward slash",
                        "stroke",
                        "solidus",
                        "virgule",
                        "oblique"
                    ],
                    "antonyms": [
                        "backslash"
                    ],
                    "common_phrases": [
                        "slash mark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак пунктуации /, используемый для разделения слов, чисел или вариантов.",
                        "zh": "标点符号“/”，用于分隔单词、数字或不同选项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слэш",
                                "target_lang_sense_clarification": "типографский знак"
                            },
                            {
                                "target_lang_word": "косая черта",
                                "target_lang_sense_clarification": "официальное название символа"
                            },
                            {
                                "target_lang_word": "дробь",
                                "target_lang_sense_clarification": "в номерах домов или математике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斜杠",
                                "target_lang_sense_clarification": "最常用的名称"
                            },
                            {
                                "target_lang_word": "斜线",
                                "target_lang_sense_clarification": "较正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d57d9eed-2028-3257-8080-01f907b57453",
                    "sense_definition": "A long, deep cut or wound made by a sharp object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim had a deep <w>slash</w> across his arm that required several stitches.",
                            "target_lang_translations": {
                                "ru": "У пострадавшего был глубокий <w>порез</w> на руке, на который пришлось наложить несколько швов.",
                                "zh": "伤者手臂上有一道很深的<w>划伤</w>，需要缝好几针。"
                            }
                        },
                        {
                            "text": "The painting was ruined by a jagged <w>slash</w> right through the center of the canvas.",
                            "target_lang_translations": {
                                "ru": "Картина была испорчена неровным <w>разрезом</w> прямо по центру холста.",
                                "zh": "这幅画被画布中央一道参差不齐的<w>裂口</w>毁了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gash",
                        "laceration",
                        "incision"
                    ],
                    "common_phrases": [
                        "deep slash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный глубокий порез или рана, нанесенная острым предметом.",
                        "zh": "由尖锐物体造成的又长又深的切口或伤口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрез",
                                "target_lang_sense_clarification": "глубокая рана"
                            },
                            {
                                "target_lang_word": "рваная рана",
                                "target_lang_sense_clarification": "повреждение тканей"
                            },
                            {
                                "target_lang_word": "прорезь",
                                "target_lang_sense_clarification": "на ткани или холсте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "划伤",
                                "target_lang_sense_clarification": "被尖锐物划出的伤口"
                            },
                            {
                                "target_lang_word": "裂口",
                                "target_lang_sense_clarification": "较深的切口或伤口"
                            },
                            {
                                "target_lang_word": "刀口",
                                "target_lang_sense_clarification": "强调刀割形成的口子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02e31616-db84-3fe8-a4b9-b3ab8987654f",
                    "sense_definition": "A sudden and significant reduction in an amount or quantity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government announced a major <w>slash</w> in funding for public arts programs.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило о крупном <w>сокращении</w> финансирования программ в области общественного искусства.",
                                "zh": "政府宣布将大幅<w>削减</w>公共艺术项目的经费。"
                            }
                        },
                        {
                            "text": "After the merger, employees feared a <w>slash</w> in their benefits and retirement plans.",
                            "target_lang_translations": {
                                "ru": "После слияния сотрудники опасались <w>урезания</w> льгот и пенсионных планов.",
                                "zh": "合并后，员工担心他们的福利和退休计划会遭到<w>缩减</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cut",
                        "reduction"
                    ],
                    "common_phrases": [
                        "budget slash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное и значительное сокращение суммы или количества.",
                        "zh": "数量或金额突然且显著的减少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "резкое уменьшение бюджета"
                            },
                            {
                                "target_lang_word": "урезание",
                                "target_lang_sense_clarification": "финансирования или льгот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "削减",
                                "target_lang_sense_clarification": "金额、数量等明显减少"
                            },
                            {
                                "target_lang_word": "缩减",
                                "target_lang_sense_clarification": "较中性，指规模变小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "136ccac2-c042-3a0c-aba2-eb3aaf69bee5",
                    "sense_definition": "An act of urinating.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "urination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'll be back in a minute; I just need to take a <w>slash</w>.",
                            "target_lang_translations": {
                                "ru": "Я вернусь через минуту, мне просто нужно <w>сходить по-маленькому</w>.",
                                "zh": "我马上回来，我只是得去<w>尿个尿</w>。"
                            }
                        },
                        {
                            "text": "The pub was crowded, and there was a long queue for a <w>slash</w> in the gents.",
                            "target_lang_translations": {
                                "ru": "В пабе было много народу, и в мужской туалет выстроилась длинная очередь <w>пописать</w>.",
                                "zh": "酒吧里人很多，男厕所前排着长队等着去<w>小便</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "piss",
                        "leak"
                    ],
                    "common_phrases": [
                        "take a slash"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт мочеиспускания (сленг).",
                        "zh": "一次小便行为（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поход по-маленькому",
                                "target_lang_sense_clarification": "эвфемизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尿个尿",
                                "target_lang_sense_clarification": "很口语的说法"
                            },
                            {
                                "target_lang_word": "小便",
                                "target_lang_sense_clarification": "较普通的说法"
                            },
                            {
                                "target_lang_word": "撒泡尿",
                                "target_lang_sense_clarification": "较粗俗的说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "9f27d6c3-b551-371d-a174-1ec3e98a8732",
                    "sense_definition": "Used to connect two or more roles, identities, or qualities of a single person or thing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very talented singer <w>slash</w> actress who has won many awards.",
                            "target_lang_translations": {
                                "ru": "Она очень талантливая певица <w>и</w> актриса, завоевавшая множество наград.",
                                "zh": "她是一位非常有才华的歌手<w>兼</w>演员，获得过很多奖项。"
                            }
                        },
                        {
                            "text": "The room serves as a guest bedroom <w>slash</w> home office for the family.",
                            "target_lang_translations": {
                                "ru": "Комната служит семье одновременно гостевой спальней <w>и</w> домашним кабинетом.",
                                "zh": "这个房间是家里的客卧<w>兼</w>家庭办公室。"
                            }
                        }
                    ],
                    "synonyms": [
                        "and",
                        "plus",
                        "stroke"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для соединения двух или более ролей, идентичностей или качеств одного человека или вещи.",
                        "zh": "用于连接同一个人或事物的两种或多种角色、身份或性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "в значении совмещения ролей"
