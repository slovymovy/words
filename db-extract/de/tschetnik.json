                        "sense_id": "92f5c881-f841-320e-950d-7aa2ace70ea6",
                        "entry_id": "f5d8d145-bf6c-3481-96bb-22bc381c0974",
                        "glosses": [
                            "Angehöriger einer antikommunistischen serbischen/montenegrinischen Miliz im 2. Weltkrieg"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2b311ee6-0b6f-4dcf-9c30-f3cd2f6a862b",
                                "sense_id": "92f5c881-f841-320e-950d-7aa2ace70ea6",
                                "text": "„Neben der Ustascha sind auch die Tschetniks involviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d12c4e30-0ae0-4f3d-8a36-7707887049ee",
                        "source_entry_id": "f5d8d145-bf6c-3481-96bb-22bc381c0974",
                        "source_sense_id": "92f5c881-f841-320e-950d-7aa2ace70ea6",
                        "target_lang_word": "chetnik",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chetnik",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f05b0b4d-768f-3df3-83a1-671e7fe54809",
                                        "entry_id": "88bcbf07-b13b-373a-ad28-2c51d001fbfd",
                                        "glosses": [
                                            "A member of a Serbian royalist army band."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016d32b6-137c-4b56-a6a1-5eae9a1d5a2c",
                                                "sense_id": "f05b0b4d-768f-3df3-83a1-671e7fe54809",
                                                "text": "Since most Chetniks only wanted to fight close to their homes, a mobile army that could carry out sustained campaigns under central command never developed."
                                            },
                                            {
                                                "example_id": "a2ac482d-4f56-4fc5-9d8c-7559e01fb171",
                                                "sense_id": "f05b0b4d-768f-3df3-83a1-671e7fe54809",
                                                "text": "By the end of February 1942 Glaise von Horstenau reported to the OKW that the cetniks were parading in every village occupied by the Italians fully armed."
                                            },
                                            {
                                                "example_id": "948fe4ec-4aea-4c8c-b5f8-0fc07786e261",
                                                "sense_id": "f05b0b4d-768f-3df3-83a1-671e7fe54809",
                                                "text": "By the winter of 1907, it was clear that a number of the četnik bands were operating in Macedonia independently of any supervision; only with some difficulty did an emissary from Belgrade succeed in re-imposing control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ee8b409-fa31-361e-ba8a-37e99cf348b9",
                                        "entry_id": "88bcbf07-b13b-373a-ad28-2c51d001fbfd",
                                        "glosses": [
                                            "An adherent of an nationalist revival of the historical Chetnik movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b947f7-65dd-4d40-b835-34cdc9040884",
                                                "sense_id": "8ee8b409-fa31-361e-ba8a-37e99cf348b9",
                                                "text": "The Visegrad gathering, which saw uniform-wearing participants singing songs that included lines such as \"there will be hell, the Drina will be bloody, here come the Chetniks from the Serb mountains’, provoked wariness and fear among Bosniak residents who survived some of the worst atrocities committed by Chetniks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
