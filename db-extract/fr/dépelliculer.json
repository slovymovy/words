                ],
                "senses": [
                    {
                        "sense_id": "3a4b0581-0700-3cea-acfa-740e031deb7c",
                        "entry_id": "020f1693-cc05-395a-8214-1000364d15d2",
                        "glosses": [
                            "Enlever la pellicule qui couvre (une plante, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e64807d2-2b5e-413f-8920-572e8a331ddc",
                                "sense_id": "3a4b0581-0700-3cea-acfa-740e031deb7c",
                                "text": "Tout ceci est accompagné de chiffres fantaisistes, cela va sans dire et l'auteur conclut... que l'on doit dépelliculer !"
                            },
                            {
                                "example_id": "f72d5128-3464-495d-95a1-d8dce0996e1b",
                                "sense_id": "3a4b0581-0700-3cea-acfa-740e031deb7c",
                                "text": "Il est possible de dépelliculer l'original en décollant simplement la pellicule couvrant les deux faces."
                            }
                        ]
                    },
                    {
                        "sense_id": "72e744de-df0e-3f14-b2a8-c5317eaaba27",
                        "entry_id": "020f1693-cc05-395a-8214-1000364d15d2",
                        "glosses": [
                            "Débarrasser les cheveux des pellicules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee56f7d2-1588-4ce4-b188-4d4a62759002",
                                "sense_id": "72e744de-df0e-3f14-b2a8-c5317eaaba27",
                                "text": "Car la mode, c’est aussi les millions de tonnes de crèmes, poudres, laits, lotions, maquillages, démaquillants, prémaquillants, produits à se peindre, à se bronzer, à ôter la peinture, à s’oindre, à s’enduire, à se désenduire, à se pommader, à se friser, à s’onduler, à se défriser, à nourrir les cheveux, les laver, les traiter, les dépelliculer, les blondir, les faire briller, les remplir de reflets, les décolorer, les recolorer, les soigner, les faire respirer, les faire pousser, repousser, ôter les duvets superflus, maigrir, mincir, grandir, développer les seins, gommer les hanches, affiner la taille, avaler l’estomac, fondre les kilos en trop, exalter le buste, renforcer les appas défaillants…"
                            }
                        ]
                    }
                ],
