                    },
                    {
                        "translation_id": "b1560f6d-59c0-4780-8dd4-ae9b4c266e7a",
                        "source_entry_id": "12c28eb0-76aa-3992-8c25-2fd97986e8e3",
                        "source_sense_id": "946906c0-eff6-35ee-bb66-4298b414e261",
                        "source_sense_description": "Christentum: christlicher Feiertag am Montag des Osterfestes",
                        "target_lang_word": "lundi de Pâques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lundi de Pâques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9ca591-02ae-3215-a335-1debb8a35aa5",
                                        "entry_id": "f449fd37-e339-3b08-9e0a-fcbdcee1864f",
                                        "glosses": [
                                            "Lendemain de Pâques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f039fe-4fd8-4e19-9b62-d5cf0cb24b15",
                                                "sense_id": "bf9ca591-02ae-3215-a335-1debb8a35aa5",
                                                "text": "Ce magasin est fermé le lundi de Pâques."
                                            },
                                            {
                                                "example_id": "8e124684-bdaf-4aec-8830-8f9c7e725df7",
                                                "sense_id": "bf9ca591-02ae-3215-a335-1debb8a35aa5",
                                                "text": "Dans ce petit coin de la terre lorraine, les garçons et les filles vont danser le lundi de Pâques, au val des Nonnes."
                                            },
                                            {
                                                "example_id": "48b30259-7732-4caa-9c1f-b99770d2f841",
                                                "sense_id": "bf9ca591-02ae-3215-a335-1debb8a35aa5",
                                                "text": "La brocante exceptionnelle de Pâques de la Place d'Aligre se tient tous les lundis de Pâques depuis 2007."
                                            },
                                            {
                                                "example_id": "2b81a9ae-f6e0-45bc-a968-b1c5817c1d2d",
                                                "sense_id": "bf9ca591-02ae-3215-a335-1debb8a35aa5",
                                                "text": "Des Marocains d’une section lourde viennent renforcer le point d’appui des anciens maquisards avec leurs mortiers dès le lundi de Pâques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
