                        ],
                        "form": "mendiantes"
                    },
                    {
                        "form_id": "3102b3cf-bc9c-4002-87ca-2d356286b3a5",
                        "entry_id": "fd154aa3-6cd8-353c-9087-a2d98d6b6e87",
                        "tags": [
                            "masculine"
                        ],
                        "form": "mendiant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0168c64a-c356-3f2f-b310-782cc0c7969c",
                        "entry_id": "fd154aa3-6cd8-353c-9087-a2d98d6b6e87",
                        "glosses": [
                            "Celle qui sollicite des dons pour survivre, qui vit de mendicité."
                        ],
                        "tags": [
                            "Errance"
                        ],
                        "examples": [
                            {
                                "example_id": "f786c28c-9a97-4c72-b6c3-815e7796a600",
                                "sense_id": "0168c64a-c356-3f2f-b310-782cc0c7969c",
                                "text": "Ce furent les jeunes gens qui trouvèrent. Un soir, plusieurs d’entre eux attendirent les demoiselles Amadou à la sortie d’un village, et comme elles étaient des mendiantes, ils se conduisirent vis-à-vis d’elles avec grossièreté."
                            },
                            {
                                "example_id": "1316ea74-e863-4e84-9f7a-5c115ba0b31e",
                                "sense_id": "0168c64a-c356-3f2f-b310-782cc0c7969c",
                                "text": "Les mendiantes et les prostituées sont également marginalisées par la société canadienne."
                            },
                            {
                                "example_id": "10851e13-aeb5-4388-b38d-4d7a510c7d26",
                                "sense_id": "0168c64a-c356-3f2f-b310-782cc0c7969c",
                                "text": "Osera-t-elle confier à ce bon petit diable, à ce démon sans manières ni éducation le soin de faire d’elle cette merveille d’imperfection, cette mendiante richissime, cette dérangeuse comblante qu’est une femme amoureuse ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e828bbdc-f51c-4fcc-aeba-9fdd6b6f4eef",
                        "source_entry_id": "fd154aa3-6cd8-353c-9087-a2d98d6b6e87",
                        "source_sense_id": "0168c64a-c356-3f2f-b310-782cc0c7969c",
                        "target_lang_word": "Bettlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                        "entry_id": "69af3fe7-f042-3d5e-bd87-002d98b37b64",
                                        "glosses": [
                                            "weibliche Person, die Almosen erbittet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b899504-c400-4737-86a3-d3c296f7f527",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "Sie schämte sich anfangs, als Bettlerin aufzutreten. Aber das verging."
                                            },
                                            {
                                                "example_id": "321be53e-f763-4e59-90d6-6e83db353f05",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "Ist eine Frau, die auf der Straße singt, eine \"aufdringliche\" Bettlerin oder doch eine \"gewerbsmäßige\", weil das Betteln ihr Hauptverdienst ist – oder gar beides?"
                                            },
                                            {
                                                "example_id": "b5f989a0-d953-48ab-b40a-47421a89ec59",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "Am Mittwoch gegen 18 Uhr fielen vor einem Einkaufsmarkt in der Rodinger Straße in Cham zwei Bettlerinnen auf. Die zwei rumänischen Staatsangehörigen, 22 und 40 Jahre alt, […]"
                                            },
                                            {
                                                "example_id": "150fbed5-4929-476f-9797-d07ee2b0e8b8",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "\"Danke, danke\", ruft die Bettlerin mit hoher Stimme. \"Bisher habe ich in Hamburg kein böses Wort gehört\", erzählt sie, \"fast alle Leute sind freundlich.\" Im bulgarischen Kjustendil, wo sie mit sechs Verwandten in einer kleinen Hütte am Fluss lebe, sei das anders: \"Wer bettelt, wird bespuckt und geschlagen.\""
                                            },
                                            {
                                                "example_id": "52335cd1-2acb-44cc-85a7-556b3b16c64c",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "„Im Moslemviertel kostümierten die Bettlerinnen sich als fromme Moslems.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a6ae0dc-1f1e-4e6c-8a34-de4ea4e21df0",
                        "source_entry_id": "fd154aa3-6cd8-353c-9087-a2d98d6b6e87",
                        "source_sense_id": "0168c64a-c356-3f2f-b310-782cc0c7969c",
                        "target_lang_word": "beggar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beggar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A person who begs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926205e5-52fd-41c4-b113-10bbd42fa6bf",
                                                "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            },
                                            {
                                                "example_id": "6124751d-c4b7-43e7-8e6c-4f5670435b06",
                                                "sense_id": "f0a2c568-ca68-365a-ac35-30d1bee0dce2",
                                                "text": "Odysseus has returned to his home disguised as a beggar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9395d9ae-6187-3568-9c22-59033e99ce7b",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A person suffering from extreme poverty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514e818e-86ed-4dde-9fbb-67b283bb0107",
                                                "sense_id": "9395d9ae-6187-3568-9c22-59033e99ce7b",
                                                "text": "I'm to be a poor, crawling beggar, sponging for rum, when I might be rolling in a coach!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8067cce7-1ab4-32ad-b5e1-52455d14aea7",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A mean or wretched person; a scoundrel."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "endearing",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07950a43-0f15-4657-a4d3-0668f5da171b",
                                                "sense_id": "8067cce7-1ab4-32ad-b5e1-52455d14aea7",
                                                "text": "What does that silly beggar think he's doing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e45c299-4aec-3741-af0b-422b7af78250",
                                        "entry_id": "6ad00d84-bafc-3f45-9809-d8d3cdff1c56",
                                        "glosses": [
                                            "A minced oath for bugger."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beggar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e32bae4-1ba6-3548-b770-126bc1fadcd7",
                                        "entry_id": "9b0a77e1-ca87-3ee7-9f17-96c8ed32b183",
                                        "glosses": [
                                            "To make a beggar of someone; impoverish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                        "entry_id": "9b0a77e1-ca87-3ee7-9f17-96c8ed32b183",
                                        "glosses": [
                                            "To exhaust the resources of; to outdo or go beyond."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c4659a-da1d-4b96-8272-c04324f808e0",
                                                "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                                "text": "`Now,' answered Ayesha, with proud humility - `now when my lord doth speak thus royally and give with so free a hand, it cannot become me to lag behind in words, and be beggared of my generosity.'"
                                            },
                                            {
                                                "example_id": "a5772ead-83c2-4953-870a-75dbbecf1719",
                                                "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                                "text": "It was a scene of such beauty it caught all his attention. / Some things beggar likeness, he thought."
                                            },
                                            {
                                                "example_id": "8380af4a-ef98-47a3-b51d-f2547b2c3f99",
                                                "sense_id": "6efa4dea-8814-3995-a787-a1059d4c4de5",
                                                "text": "Taking the ontological temperature of today and of the pre-revolutionary 18th century, Mr. Kundera finds that the speed we love has beggared us of pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
