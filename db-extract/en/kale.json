                                                "sense_id": "09c9f995-4166-3fb4-8524-8f3dc09bc32d",
                                                "text": "„Der Rosenkohl und der Grünkohl stehen noch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ec1f5fc-1c80-3b0e-8c93-2ee6bc338d30",
                                        "entry_id": "c9872887-2366-36f4-b5be-3a52544ea0ad",
