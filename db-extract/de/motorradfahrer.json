                        ]
                    },
                    {
                        "translation_id": "bd1132fd-259a-4b7c-8aaa-d119682e7946",
                        "source_entry_id": "9b2fd396-f067-39f6-8e29-26b63921bd98",
                        "source_sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                        "source_sense_description": "Person, die auf einem Motorrad fährt",
                        "target_lang_word": "biker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                        "entry_id": "401d2f42-13b1-3c65-9b0d-d9fcb49700eb",
                                        "glosses": [
                                            "A person whose lifestyle is centered on motorcycles, sometimes a member of a motorcycle club."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b07fb8-dc32-4561-a675-758345643199",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "Others, mostly behelmeted casual bikers whose enthusiasm for motorcycling is a monthly Sunday morning ride, also took in the gleam of the chrome and outrageous styling, but were confused that it had a Honda badge on it rather than Harley’s winged logo."
                                            },
                                            {
                                                "example_id": "977e5324-5ac7-468a-8796-4f1b30256fa0",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "There’s a wonderful sketch of a formidable biker called “Roundhouse,” who is “humongously fat and hasn’t had a haircut since third grade.”"
                                            },
                                            {
                                                "example_id": "7c5c9fe1-878b-439f-ba6f-dd2be809f9f4",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "Bikers did what bikers do. They raced around and popped wheelies. The state police were called in to clear the town.\nThe event got big play in Life magazine and inspired the 1953 film “The Wild One,” starring Marlon Brando. His leather jacket and brooding demeanor gave a face to the bad-boy biker image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dbc6b0c-0ff6-3eac-b7e3-5b07071d9325",
                                        "entry_id": "401d2f42-13b1-3c65-9b0d-d9fcb49700eb",
                                        "glosses": [
                                            "A cyclist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f200aa1d-1ecd-4147-a520-0db31f4edbf1",
                                                "sense_id": "4dbc6b0c-0ff6-3eac-b7e3-5b07071d9325",
                                                "text": "Lots of pockets help with a commute, a storm hood is great if you get caught in a storm on a hike, weight and packability are essential for backpackers and if you’re a climber or biker, you’ll want a helmet-compatible hood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fcf5c25-ee9f-419d-aee4-c0bd17426839",
                        "source_entry_id": "9b2fd396-f067-39f6-8e29-26b63921bd98",
                        "source_sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                        "source_sense_description": "Person, die auf einem Motorrad fährt",
                        "target_lang_word": "motocycliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motocycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2312a46-13e3-3db9-9e03-ecba8b116555",
                                        "entry_id": "41b95140-ba0e-300a-97b5-508635da4004",
                                        "glosses": [
                                            "Relatif à la motocyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43233677-7a11-48e1-8565-b6551b8672a3",
                                                "sense_id": "e2312a46-13e3-3db9-9e03-ecba8b116555",
                                                "text": "On sait qu’une fédération des clubs motocyclistes, issue du récent congrès tenu à Lyon, nourrit la prétention, louable en elle-même, de régir, elle aussi, le sport motocycliste …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "motocycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                        "entry_id": "9aad3e69-b7bf-3d40-a73d-70432ab97ddb",
                                        "glosses": [
                                            "Celui, celle qui conduit une motocyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6b56e1-4c42-4688-8793-d3d4eaca265a",
                                                "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                                "text": "En revenant de chez Jacques Philostène, il avait eu la chance de tomber sur un motocycliste."
                                            },
                                            {
                                                "example_id": "d01b33a9-2bdc-40e2-aa21-3ec713ae37a8",
                                                "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                                "text": "Guidés par des motocyclistes, leurs véhicules se rangent le long des trottoirs, ils s’installent dans nos casernes et bâtiments militaires, les ex-camps anglais, les grands hôtels et belles propriétés réquisitionnés."
                                            },
                                            {
                                                "example_id": "154cd777-68c4-43b6-b0be-4414e0a5bfbd",
                                                "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                                "text": "Selon les constatations de la gendarmerie, le motocycliste doublait une file de véhicules quand il a percuté de plein fouet une voiture qui traversait la route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
