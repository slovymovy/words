                        "examples": [
                            {
                                "example_id": "2a3ac9f7-0cbe-4248-adae-9ff522e86fe9",
                                "sense_id": "fe68931b-b03d-3080-8e3b-027c3bf4ff22",
                                "text": "Zabrania się defekowania na trotuarze!"
                            },
                            {
                                "example_id": "db2b0b9a-af7a-4f01-ab5a-984962d0632c",
                                "sense_id": "fe68931b-b03d-3080-8e3b-027c3bf4ff22",
                                "text": "Przy hemoroidach pożądane jest defekowanie miękkim kałem."
                            },
                            {
                                "example_id": "ba8285e7-531f-4329-a721-b9450f4d96f5",
                                "sense_id": "fe68931b-b03d-3080-8e3b-027c3bf4ff22",
                                "text": "Ludzie myślą, że życie to jedzenie, defekowanie, pracowanie, czynienie zadość popędom, organizowanie przyjemności, dbanie o zdrowie"
                            }
                        ],
