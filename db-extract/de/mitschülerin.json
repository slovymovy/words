                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e4c6150-fdf2-4df0-8311-b041aece6111",
                                "sense_id": "e9fa5fcd-260f-39e2-88aa-ede9bc9fb1f2",
                                "text": "„Eine Mitschülerin starb und eine geliebte Lehrerin.“"
                            },
                            {
                                "example_id": "6e236ad1-8ded-4175-8cf2-e5792e2fafaf",
                                "sense_id": "e9fa5fcd-260f-39e2-88aa-ede9bc9fb1f2",
                                "text": "„Sie vermisste ihre Mitschülerinnen, die sie nie mehr sah, weil sie jetzt ganz andere Pflichten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
