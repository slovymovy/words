        "fr-extract.jsonl": [
            {
                "entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                "word": "galiote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a15379a9-6dd1-40d2-9f15-bfef419ebc79",
                        "entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                        "tags": [
                            "plural"
                        ],
                        "form": "galiotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d3b2fce-f783-309f-82f8-8daa17d783df",
                        "entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                        "glosses": [
                            "Bateau à voile de transport à formes rondes dont se servaient les Hollandais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3ee8bf-90eb-44b5-8edd-bc729402f891",
                                "sense_id": "8d3b2fce-f783-309f-82f8-8daa17d783df",
                                "text": "On nous transvase dans des wagons jaune-paille aux formes arrondies et ventrues, ayant une vague coupe de galiote, comme si l’on eût enlevé des canaux les bateaux-poste inutiles pour les poser sur les lignes de chemins de fer."
                            },
                            {
                                "example_id": "a39d33e2-2af8-443c-be8c-999a086c14f8",
                                "sense_id": "8d3b2fce-f783-309f-82f8-8daa17d783df",
                                "text": "Près du quai, au bas du Louvre, les galiotes royales attiraient l’œil par leurs ornements sculptés et dorés et leurs pavillons aux couleurs de France."
                            },
                            {
                                "example_id": "78cd66cb-e6ed-415f-ba17-dbf9ee1be8b0",
                                "sense_id": "8d3b2fce-f783-309f-82f8-8daa17d783df",
                                "text": "Cette chaloupe était de forme un peu grossière, […], et, avec son avant en forme de galiote, elle devait mieux résister au choc des glaces."
                            },
                            {
                                "example_id": "13415c4d-41e4-4703-845f-b6f94846574c",
                                "sense_id": "8d3b2fce-f783-309f-82f8-8daa17d783df",
                                "text": "Une galiote hollandaise, l’Élisabeth, chargée de planches et de cordages, tomba en leur pouvoir le 27 aout, à la hauteur des côtes de Zélande."
                            },
                            {
                                "example_id": "c1bae038-0f1c-43d7-8f18-77993e729646",
                                "sense_id": "8d3b2fce-f783-309f-82f8-8daa17d783df",
                                "text": "La galiote est une embarcation moyenne à deux mâts, dont celui d’arrière, l’artimon, est fort réduit."
                            }
                        ]
                    },
                    {
                        "sense_id": "25c80e9e-e4c8-31d8-b0ed-94567e7feacd",
                        "entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                        "glosses": [
                            "Barre métallique servant à la manutention de charges lourdes."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "74caf31c-66b1-42f5-a2a0-a19c7b02fa78",
                                "sense_id": "25c80e9e-e4c8-31d8-b0ed-94567e7feacd",
                                "text": "J’ai vu des hommes écrasés par une palanquée […], des galiotes, ces barres qui servaient à fermer les panneaux de cales, tomber sur des hommes parce que mal enclenchées."
                            }
                        ]
                    },
                    {
                        "sense_id": "02efa530-56bc-363f-b229-b6255ea73830",
                        "entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                        "glosses": [
                            "Petite galère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0295419e-1a91-4761-a719-08282cc50af9",
                                "sense_id": "02efa530-56bc-363f-b229-b6255ea73830",
                                "text": "Une galiote de Tunis, de Maroc."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dccf812-51a9-3bdf-9b00-605bd608cc7b",
                        "entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                        "glosses": [
                            "Petit bateau utilisé sur les rivières en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e219ded-26ef-4129-9b89-4b8bec1cb065",
                                "sense_id": "5dccf812-51a9-3bdf-9b00-605bd608cc7b",
                                "text": "Chaque fois qu’il lui fallait entrer dans la maudite galiote, c’était, chez elle, le même désarroi, le même coup d’œil de regret donné au plancher des vaches."
                            }
                        ]
                    }
                ],
