                    {
                        "translation_id": "f7390b90-b9a2-4857-a543-3dd0b7d4bbc4",
                        "source_entry_id": "ccbd826c-751c-32c5-8d19-8a5b23c7f135",
                        "source_sense_id": "65535af0-3315-3ddc-99b7-ed7feabee07b",
                        "target_lang_word": "Akkordeonspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkordeonspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                        "entry_id": "d2abb5e2-b05b-3706-920c-e96232c745c7",
                                        "glosses": [
                                            "(männliche) Person, die Akkordeon spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d8df00-af29-4eb8-8152-14ea17e47988",
                                                "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                                "text": "Aus einem Aufenthalt in Rio de Janeiro entstand 1987 das Album Let’s Vamos (Sonet) mit dem brasilianischen Akkordeonspieler Sivuca."
                                            },
                                            {
                                                "example_id": "982f9662-b6c2-4cfd-a99c-194aee1d0376",
                                                "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                                "text": "„Mit Chris Strachwitz vom Label Arhoolie und dem Filmemacher Les Blank flog er nach San Antonio und traf den Akkordeonspieler Flaco Jiménez, eine Freundschaft entstand.“"
                                            },
                                            {
                                                "example_id": "cd5968b8-f111-464c-bf84-0da10eaefb20",
                                                "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                                "text": "„Für die rund 250 Abgesandten aus der ganzen Deutschschweiz, die 103 Vereine und etwa 1900 Akkordeonspieler vertreten, müssen die Räumlichkeiten zur Verfügung gestellt und das Mittagessen organisiert werden. Ein Konzert dürfen die Kreuzlinger Akkordeonspieler im Dreispitz-Saal auch noch geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5939e3a5-d80d-48dd-bcc6-2d90539dfc34",
                        "source_entry_id": "ccbd826c-751c-32c5-8d19-8a5b23c7f135",
                        "source_sense_id": "65535af0-3315-3ddc-99b7-ed7feabee07b",
                        "target_lang_word": "Akkordeonist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkordeonist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa234ed-1241-35e7-b0e0-4f0ea84d530c",
                                        "entry_id": "e80bd225-9e58-3a68-b675-9107c7a3cb63",
                                        "glosses": [
                                            "(männliche^☆) Person, die (professionell) Akkordeon spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6558f873-757c-4b09-95b8-e3efbf77510a",
                                                "sense_id": "6aa234ed-1241-35e7-b0e0-4f0ea84d530c",
                                                "text": "„Mittlerweile kennt man das Quartett um Akkordeonist Krzysztof Dobrek gut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db0726eb-e5c6-4ad5-b5c9-79d5c0f38006",
                        "source_entry_id": "ccbd826c-751c-32c5-8d19-8a5b23c7f135",
                        "source_sense_id": "65535af0-3315-3ddc-99b7-ed7feabee07b",
                        "target_lang_word": "harmonicaspeler",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmonicaspeler",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a1c5d0-928b-33ef-891a-06297b0c39b0",
                                        "entry_id": "fae3565f-68ec-3ec3-b06a-97c10663c829",
                                        "glosses": [
                                            "persoon die op een (mond)harmonica speelt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e08c5c40-3f84-4978-b28e-bb42bc08640f",
                                                "sense_id": "b8a1c5d0-928b-33ef-891a-06297b0c39b0",
                                                "text": "Producer en muzikant Jones is onder meer de man die Michael Jackson groot heeft gemaakt. Hij is een van de vele muzikale grootmachten waarmee Thielemans op het podium heef gestaan. Van Charlie Parker tot Paul Simon. Billy Joel introduceerde de Belg steevast als \"de beste harmonicaspeler van de wereld.\""
                                            },
                                            {
                                                "example_id": "81dca03e-804a-43ef-868b-6dac4f556a7e",
                                                "sense_id": "b8a1c5d0-928b-33ef-891a-06297b0c39b0",
                                                "text": "De Amerikaanse zanger kan al veel artiesten van zijn lijstje afstrepen. ,,Ik ben op tour geweest met Michael McDonald, Kenny Loggins en Sheena Easton. Dat heeft mijn leven wel veranderd. Als harmonicaspeler stond ik op albums van Al Jarreau, Earth, Wind and Fire en Natalie Cole en ik heb live met Andrea Bocelli gespeeld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
