                    },
                    {
                        "translation_id": "1df6e17a-c5d1-43c0-8094-0ee5f4fc8631",
                        "source_entry_id": "624b5196-17ca-3881-a658-392121238ab1",
                        "source_sense_id": "ec5efd90-53ec-3c3a-97dd-7f08d33b2c8c",
                        "source_sense_description": "de vlezige schutbladeren van de gesloten bloemknop worden als groente gegeten",
                        "target_lang_word": "artichaut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artichaut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c21d329-80af-3bee-b000-d4f25fb84650",
                                        "entry_id": "a291c32d-6efb-3654-963c-8d4eaac24f2a",
                                        "glosses": [
                                            "Plante de la famille des Astéracées qui porte une inflorescence à bractées piquantes se recouvrant les unes les autres et dont le réceptacle charnu est comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf91cada-1249-4e16-b997-62692b22ee41",
                                                "sense_id": "4c21d329-80af-3bee-b000-d4f25fb84650",
                                                "text": "Il avait aussi appris à manier la pelle, la fourche à dents plates, le plantoir, le sarcloir, à repiquer lui-même ses frêles laitues, voire à « forcir » la tête d’un artichaut en en transperçant la tige d’une chevillette."
                                            },
                                            {
                                                "example_id": "36820315-dec4-487d-9cbe-1171b9d8203f",
                                                "sense_id": "4c21d329-80af-3bee-b000-d4f25fb84650",
                                                "text": "Entre Saint-Pol-de-Léon et Roscoff, je fais route parmi d'immenses plantations d’artichauts et de choux-fleurs, prosaïquement accroupies entre leurs murets de pierres sèches."
                                            },
                                            {
                                                "example_id": "5e1e95ce-6490-4685-a489-2541f5a3e08a",
                                                "sense_id": "4c21d329-80af-3bee-b000-d4f25fb84650",
                                                "text": "Les avis divergent sur la nature du scolymos et du cynara mentionnés dans les textes grecs et latins et l’existence d’une forme cultivée de l’artichaut en Italie, en Espagne et en Grèce durant l’Antiquité [André, 1981 ; Sonnante et al., 2007]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                        "entry_id": "a291c32d-6efb-3654-963c-8d4eaac24f2a",
                                        "glosses": [
                                            "Capitule de la plante, utilisé crue ou cuite comme légume."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a79a75bf-b86f-43a6-9770-9ad97c4b4f68",
                                                "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                                "text": "Une pomme d’artichaut."
                                            },
                                            {
                                                "example_id": "e8cf50bc-a371-42ba-a185-f65917f28efb",
                                                "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                                "text": "Des artichauts à la poivrade."
                                            },
                                            {
                                                "example_id": "d64426fb-54cc-4f44-9048-2cc0ec88b6d3",
                                                "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                                "text": "Une friture d’artichauts."
                                            },
                                            {
                                                "example_id": "ec41b181-e9da-4307-b6d5-11155aac2576",
                                                "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                                "text": "Arnold achète un artichaut – il aime bien le cérémonial de l’artichaut, la longueur de la cuisson, le dépouillement des feuilles, puis le rituel de l’assiette relevée, un couteau en dessous pour accueillir la vinaigrette, avec le fond qui reste toujours un peu poilu."
                                            },
                                            {
                                                "example_id": "4e81e50b-3dc8-43e2-bf23-eae2d0c4d87b",
                                                "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                                "text": "Ma mère, une Belge francophone vivant à New York, avait pris l’habitude de m’installer devant la télévision pour me faire manger mon artichaut jusqu’au cœur."
                                            },
                                            {
                                                "example_id": "41898148-41fa-4f5f-a46b-6dc7e56f65cf",
                                                "sense_id": "07cc8619-bb13-3937-a758-c8077f9fd7a5",
                                                "text": "Les artichauts, c’est un vrai plat de pauvres. C’est le seul plat que quand t’as fini de manger, t’en as plus dans ton assiette que quand tu as commencé !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a164bced-1f01-31db-93f2-d44016261ba6",
                                        "entry_id": "a291c32d-6efb-3654-963c-8d4eaac24f2a",
                                        "glosses": [
                                            "Pièce de ferronnerie, hérissée de plusieurs pointes et de crocs et dont on garnit une clôture pour empêcher de passer ou d’escalader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91892d08-9ed1-46f0-add6-f4cfbdff42ea",
                                                "sense_id": "a164bced-1f01-31db-93f2-d44016261ba6",
                                                "text": "Soudain, une voix formidable cria : − À l'assaut! Et l'on vit le prince des Boscénos dressant sur le mur armé de pointes et d'artichauts de fer sa forme gigantesque."
                                            },
                                            {
                                                "example_id": "2f2191bc-8180-48c1-ad7b-87f3b00cf487",
                                                "sense_id": "a164bced-1f01-31db-93f2-d44016261ba6",
                                                "text": "Je n'ai jamais vu dans un endroit en maçonnerie une telle multiplicité de fers de lance, de pals, d'artichauts, de buissons et de ronces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7bd93f-2283-3911-a2af-bf80e8f6c040",
                                        "entry_id": "a291c32d-6efb-3654-963c-8d4eaac24f2a",
                                        "glosses": [
                                            "Grande bardane (Arctium lappa L.)."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b18de85-7679-31e6-9424-3293f251e252",
                                        "entry_id": "a291c32d-6efb-3654-963c-8d4eaac24f2a",
                                        "glosses": [
                                            "Portefeuille, par analogie avec les nombreuses feuilles du capitule."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d521391-ad65-4924-bd23-06640626cb66",
                                                "sense_id": "9b18de85-7679-31e6-9424-3293f251e252",
                                                "text": "On barbote au pauvr' diable qui crève\nCe qu'il a dans son artichaut,\nSes beaux crocs même on lui enlève,\nÀ l'hosteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
