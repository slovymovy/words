                                "example_id": "7f8c2b2b-3c96-4e4b-8a40-a922cc314670",
                                "sense_id": "53d2b3cc-cf3f-3b2a-a1c1-a51be5819eed",
                                "text": "Auf der Autobahn 7 in Richtung Elbtunnel herrschen zwischen Hamburg-Schnelsen und Hamburg-Stellingen vier Kilometer Stop-and-go."
                            },
                            {
                                "example_id": "80128eb7-09ba-40d2-aee8-7561ae8e571d",
                                "sense_id": "53d2b3cc-cf3f-3b2a-a1c1-a51be5819eed",
                                "text": "Wir hatten kurz vor Mailand zwei Stunden Stop-and-go."
                            },
                            {
                                "example_id": "a48d32ef-439b-458b-be31-b529dad0125b",
                                "sense_id": "53d2b3cc-cf3f-3b2a-a1c1-a51be5819eed",
                                "text": "Dank des ewigen Stop-and-go(s) hatten Gisa und ich auf der Fahrt nach Kaiserslautern die Gelegenheit, einige heikle Fragen zu besprechen."
