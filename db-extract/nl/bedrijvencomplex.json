                "senses": [
                    {
                        "sense_id": "25843a98-53df-3ffa-b3e1-99badb9a8677",
                        "entry_id": "7be0c698-1636-35ad-8412-eb233dec66d3",
                        "glosses": [
                            "groep bedrijfsgebouw die samen op één terrein zijn gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0621d99-6397-49c2-a3fd-2e616f58281a",
                                "sense_id": "25843a98-53df-3ffa-b3e1-99badb9a8677",
                                "text": "In Schiedam zijn drie brandweerlieden gewond geraakt bij het blussen van een brand in een bedrijvencomplex. Twee van hen liepen beenletsel op toen in het brandende pand een zware explosie was en de voorgevel werd weggeblazen. De hulpverleners zijn naar een ziekenhuis gebracht."
                            },
                            {
                                "example_id": "6bc55d34-4c93-46a1-af78-7dada0af3129",
                                "sense_id": "25843a98-53df-3ffa-b3e1-99badb9a8677",
                                "text": "Het gaat om een man van 40 uit de gemeente Langedijk, schrijft de regionale omroep NH. Gisteren was al duidelijk dat hij er slecht aan toe was. Waarschijnlijk werkte de man bij een van de bedrijven in het complex waar de brand woedde."
                            }
                        ]
                    }
