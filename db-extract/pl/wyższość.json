                        "target_lang_word": "superiority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superiority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4696bac-4c9a-326b-8887-c3321ec6fd44",
                                        "entry_id": "b4436663-423e-3b72-b7c2-acddef4dbe5c",
                                        "glosses": [
                                            "The state of being superior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61fa202f-d12e-4ec0-8e51-5cd85eeb121a",
                                                "sense_id": "b4696bac-4c9a-326b-8887-c3321ec6fd44",
                                                "text": "Many US colleges want to achieve superiority in the sport of football."
                                            },
                                            {
                                                "example_id": "bc848f1b-bb79-42b9-9f79-744dbeca90ae",
                                                "sense_id": "b4696bac-4c9a-326b-8887-c3321ec6fd44",
                                                "text": "The fact that in most lands the moon was originally a female deity has led many historians to dispute the superiority of the moon over the sun in ancient mythology."
                                            },
                                            {
                                                "example_id": "bf965b31-12ae-4c8b-a5db-3188c64978f1",
                                                "sense_id": "b4696bac-4c9a-326b-8887-c3321ec6fd44",
                                                "text": "Chelsea will point to that victory margin as confirmation of their superiority - but Spurs will complain their hopes of turning the game around were damaged fatally by Atkinson's decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91d3f6e-56f8-300a-95ae-465b4e638a6d",
                                        "entry_id": "b4436663-423e-3b72-b7c2-acddef4dbe5c",
                                        "glosses": [
                                            "The right which the superior enjoys in the land held by the vassal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9358c2a-f0bf-438c-a6cb-c336f3aebc89",
                        "source_entry_id": "8518e29d-7c58-393f-a88a-b72d0f28da7e",
                        "source_sense_id": "348549d7-20d5-3562-87cf-91fb1ec493e3",
                        "target_lang_word": "supériorité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supériorité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                        "entry_id": "54c272ca-4291-3880-9d0b-990a926cc90d",
                                        "glosses": [
                                            "Prééminence, autorité, excellence au-dessus des autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e676b814-42af-41d5-8453-bb1238957bfa",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "Mais il était modeste au logis, il y sentait instinctivement la supériorité de sa femme, quelque jeune qu'elle fût ; […]."
                                            },
                                            {
                                                "example_id": "29ad5f1f-cbdf-4c90-b684-830edfa71e78",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "Gross-Aspern est attaqué par le général Hiller avec une étonnante vigueur et une grande supériorité de forces."
                                            },
                                            {
                                                "example_id": "87992fb7-908d-4625-9d76-288740205722",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "Elle est franchement bébête, d'ailleurs, et n'affirme sa supériorité que dans la gymnastique amoureuse. Elle excelle aux tortillements, […]."
                                            },
                                            {
                                                "example_id": "79c62594-fa5e-471e-af68-fa92138e5347",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "À noter l'insistance mise par Nadvi sur la supériorité et l'exclusivisme de l'islam vis-à-vis de toutes les autres religions et de tous les autres systèmes."
                                            },
                                            {
                                                "example_id": "a816335b-1b8c-4de8-8c31-217806a1624a",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "La supériorité militaire écrasante de l’hyperpuissance américaine lui permet certes d’organiser ses expéditions sans l’aide de personne. Mais ces opérations punitives ne peuvent fonder un nouvel ordre du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f7cdee-1f6f-35c4-9218-c40c85ce7402",
                                        "entry_id": "54c272ca-4291-3880-9d0b-990a926cc90d",
                                        "glosses": [
                                            "Sentiment d’avoir une valeur supérieure aux autres ; comportement qui découle de ce sentiment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d040f6e7-cb18-4316-8aa1-181b9ee9e3e4",
                        "source_entry_id": "8518e29d-7c58-393f-a88a-b72d0f28da7e",
                        "source_sense_id": "348549d7-20d5-3562-87cf-91fb1ec493e3",
                        "target_lang_word": "transcendance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transcendance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84bb2270-4724-32ca-9a6d-924f05af9bd6",
                                        "entry_id": "5c54d4d8-7fcf-3b61-b3df-922e16bd0e0d",
                                        "glosses": [
                                            "Caractère de ce qui est transcendant. Supériorité incontestable d’une personne ou d’une chose sur une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1e454d-5463-4b3d-945a-346af1c7a6e9",
                                                "sense_id": "84bb2270-4724-32ca-9a6d-924f05af9bd6",
                                                "text": "A-t-on pensé aussi que dès que l’on abandonne la notion de liberté, on accède immédiatement, sans effort, sans tromperie langagière, sans exhortations humanistes, sans transcendance, à la notion toute simple de tolérance ?"
                                            },
                                            {
                                                "example_id": "d7e17ac8-9a99-43ec-b9b6-2a43e9da9ce5",
                                                "sense_id": "84bb2270-4724-32ca-9a6d-924f05af9bd6",
                                                "text": "La transcendance du génie de Pascal, de Leibniz, du Professeur Botul."
                                            },
                                            {
                                                "example_id": "bd3a45eb-2487-41ba-bf23-8dc4e21ef91a",
                                                "sense_id": "84bb2270-4724-32ca-9a6d-924f05af9bd6",
                                                "text": "Un air de hauteur, de transcendance, de pédanterie. (Saint-Simon) un air de supériorité désagréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac98718-3afe-31ee-8a76-8d3642ff9bdf",
                                        "entry_id": "5c54d4d8-7fcf-3b61-b3df-922e16bd0e0d",
                                        "glosses": [
                                            "Propriété d’un nombre ne pouvant être la racine d’aucun polynôme à coefficients entiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83325463-8222-42f6-b47a-1eb9ce3ad6d7",
                                                "sense_id": "6ac98718-3afe-31ee-8a76-8d3642ff9bdf",
                                                "text": "La transcendance de π et e a été prouvée."
                                            },
                                            {
                                                "example_id": "5568438b-407a-4dad-bb44-c741ed25fa62",
                                                "sense_id": "6ac98718-3afe-31ee-8a76-8d3642ff9bdf",
                                                "text": "Géométrie transcendante ; Courbe transcendante ; Équations transcendantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a80dfc0-fe48-3856-80ba-fbaf42abe423",
                                        "entry_id": "5c54d4d8-7fcf-3b61-b3df-922e16bd0e0d",
                                        "glosses": [
                                            "Caractère de ce qui est transcendant. Nom de réalités transcendantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24d06d6-196d-4507-aa5b-20495daa20f0",
                                                "sense_id": "9a80dfc0-fe48-3856-80ba-fbaf42abe423",
                                                "text": "Transcendance de Dieu, du divin, du sacré."
                                            },
                                            {
                                                "example_id": "c5ed35e4-815a-4d17-bc78-2c35dd1342be",
                                                "sense_id": "9a80dfc0-fe48-3856-80ba-fbaf42abe423",
                                                "text": "Soit nous choisissons une transcendance qui nous écrase et ne nous laisse d'autre attitude possible que la prosternation et la soumission, et là, on arrête de rire. Soit on affirme que la liberté humaine est à la hauteur de cette transcendance, on la regarde dans les yeux, et on rit."
                                            },
                                            {
                                                "example_id": "cc86d75e-4960-4fb1-8e90-ade1ce3d51fc",
                                                "sense_id": "9a80dfc0-fe48-3856-80ba-fbaf42abe423",
                                                "text": "Termes transcendants : les termes ens, unum, verum, bonum, res. (d'Alembert)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c720c59-5aa5-31b3-b452-40385b6f63a9",
                                        "entry_id": "5c54d4d8-7fcf-3b61-b3df-922e16bd0e0d",
                                        "glosses": [
                                            "Chez Husserl et dans la philosophie de Heidegger. Ce qui est en dehors de la conscience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d6b011-a667-455d-818f-d5daa5617175",
                                                "sense_id": "3c720c59-5aa5-31b3-b452-40385b6f63a9",
                                                "text": "La transcendance…[cet] antérieur à tout comportement."
                                            },
                                            {
                                                "example_id": "def0591d-a896-4255-8b2e-19788f1b39da",
                                                "sense_id": "3c720c59-5aa5-31b3-b452-40385b6f63a9",
                                                "text": "Il faut entendre par transcendance le mode de présentation de l’objet en général."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbe0106d-e3d7-4cf2-93ea-2097f531623f",
                        "source_entry_id": "8518e29d-7c58-393f-a88a-b72d0f28da7e",
                        "source_sense_id": "348549d7-20d5-3562-87cf-91fb1ec493e3",
