                "senses": [
                    {
                        "sense_id": "3194a69b-9b31-3ae8-810e-46e7fc59265a",
                        "entry_id": "25201b5e-0375-3102-b7df-b4a822e2196d",
                        "glosses": [
                            "ten, kto reformuje, dokonuje reformy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e92b6e-353f-4be5-855c-845a699c12a4",
                                "sense_id": "3194a69b-9b31-3ae8-810e-46e7fc59265a",
