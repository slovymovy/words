                        "entry_id": "94d959f0-8a17-3314-962d-3cb34134435e",
                        "glosses": [
                            "To interrogate; to question."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f11528b1-8ee9-46ba-8a34-f24508a5a0d1",
                                "sense_id": "98019333-ced0-38b0-a35b-3cfcb63bda3a",
                                "text": "I shal assaye hir my-self · and sothelich appose / What man of þis worlde · þat hire were leueste."
                            },
                            {
                                "example_id": "1ff3fd4d-be8f-4acc-a399-32f5b3c90d3b",
                                "sense_id": "98019333-ced0-38b0-a35b-3cfcb63bda3a",
                                "text": "Then gan Authority her to appose / With peremptorie powre […]."
                            }
                        ]
                    }
                ],
