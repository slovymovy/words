                "senses": [
                    {
                        "sense_id": "9d0c9f04-4c0e-3fa3-a687-3d33cdb1c967",
                        "entry_id": "ce6651ab-1747-31fb-ac01-52d2712ecc29",
                        "glosses": [
                            "Remuer, feuilleter, arranger des papiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf73ae9-eb2c-4a3e-8e32-d8e415e4f9a1",
                                "sense_id": "9d0c9f04-4c0e-3fa3-a687-3d33cdb1c967",
                                "text": "Si nous avions eu le temps de « paperasser » autant que nous le désirions dans les archives […], nous eussions pu être renseigné à cet égard, […]."
                            },
                            {
                                "example_id": "f6e72b08-47d6-4531-819b-7c0d089cc03d",
                                "sense_id": "9d0c9f04-4c0e-3fa3-a687-3d33cdb1c967",
                                "text": "Et l’homme aux lunettes vertes, s’asseyant devant le bureau, se mit à paperasser fébrilement."
                            }
                        ]
                    },
                    {
                        "sense_id": "96b83d70-09a8-3279-837d-a6373460e5e0",
                        "entry_id": "ce6651ab-1747-31fb-ac01-52d2712ecc29",
                        "glosses": [
                            "Faire des écritures inutiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e69f86-bf32-4043-9680-6c3d1a9f3b35",
                                "sense_id": "96b83d70-09a8-3279-837d-a6373460e5e0",
                                "text": "Ainsi l’administration française, la plus pure de toutes celles qui paperassent sur le globe, a rendu, comme vient de le dire Son Excellence, le vol impossible."
                            }
                        ]
                    }
                ],
