                "senses": [
                    {
                        "sense_id": "ca577360-c8aa-32ff-8f15-af6bfe7a3f25",
                        "entry_id": "d3dee192-45c0-33c0-8c3b-599e2ab6162c",
                        "glosses": [
                            "Redonner un caractère diabolique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2461358d-22f6-4a49-9cc5-cbdebeff35da",
                                "sense_id": "ca577360-c8aa-32ff-8f15-af6bfe7a3f25",
                                "text": "Et sur la forme, son tri revendiqué entre les journalistes et l’exclusion manu militari d’une manifestante pro-ukrainienne n’ont pas manqué de « re-diaboliser » Marine Le Pen."
                            },
                            {
                                "example_id": "94bf9512-5e23-4269-b539-8118dfa6b03d",
                                "sense_id": "ca577360-c8aa-32ff-8f15-af6bfe7a3f25",
                                "text": "L’opposition, bien sûr, veut profiter de ce rendez-vous avec le calendrier pour « rediaboliser » Nicolas Sarkozy."
                            },
                            {
                                "example_id": "552f64e9-3ecd-4513-8bc8-f75812a758a1",
                                "sense_id": "ca577360-c8aa-32ff-8f15-af6bfe7a3f25",
                                "text": "Marine Le Pen qualifie d’« épiphénomène » le départ en septembre de son bras droit Florian Philippot, qui a fondé son propre parti souverainiste et juge désormais le FN « embourbé » et « rediabolisé »."
                            }
                        ]
                    }
