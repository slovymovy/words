                "forms": [
                    {
                        "form_id": "8a8bf8b8-fa5c-4f82-9257-286246299b0e",
                        "entry_id": "2b9c7e2f-18e9-358c-aaa6-e6d5fe3a0a5f",
                        "tags": [
                            "plural"
                        ],
                        "form": "archéoastronomies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e555ba6a-8ba9-36c1-af76-ae15c358c5cf",
                        "entry_id": "2b9c7e2f-18e9-358c-aaa6-e6d5fe3a0a5f",
                        "glosses": [
                            "Combinaison d’études astronomiques et archéologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b28cf8-6078-41d0-a923-561184694225",
                                "sense_id": "e555ba6a-8ba9-36c1-af76-ae15c358c5cf",
                                "text": "L’archéoastronomie se veut une nouvelle discipline dont l’objet est la recherche et l’étude des connaissances astronomiques des anciennes civilisations."
                            },
                            {
                                "example_id": "ff17b4e3-21ce-4c42-b101-4ccec5964f2f",
                                "sense_id": "e555ba6a-8ba9-36c1-af76-ae15c358c5cf",
                                "text": "Plusieurs archéologues, astronomes et étudiants désiraient un documentaire d’initiation à l’archéoastronomie conciliant accessibilité au grand public et exigence académique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d0cb648-6bac-409d-be1e-7ab5eb4d861f",
                        "source_entry_id": "2b9c7e2f-18e9-358c-aaa6-e6d5fe3a0a5f",
                        "source_sense_id": "e555ba6a-8ba9-36c1-af76-ae15c358c5cf",
                        "target_lang_word": "archaeastronomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archaeastronomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a118107-58fa-3437-ac7b-534dcc0e4e28",
                                        "entry_id": "f5184eac-c0b2-3b39-8e95-5f74683cb523",
                                        "glosses": [
                                            "The historical, especially archeological, study of astronomy; the study of the astronomical systems and methods of ancient cultures often embracing the astrology and cosmology of the past."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2d054de-5508-45da-85dd-0346a402824a",
                                                "sense_id": "2a118107-58fa-3437-ac7b-534dcc0e4e28",
                                                "text": "The current fashion is to call the subject archaeoastronomy, as if it were more the business of astronomers or historians of astronomy than of archaeologists."
                                            },
                                            {
                                                "example_id": "060e56e9-a75a-458c-a7cb-8c6310d59265",
                                                "sense_id": "2a118107-58fa-3437-ac7b-534dcc0e4e28",
                                                "text": "Archaeoastronomy is an endeavor to find out something about ancient astronomy and related matters through the use of archeological data and the study of ancient texts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba68bb92-2243-4066-a937-a9abe0bdf015",
                        "source_entry_id": "2b9c7e2f-18e9-358c-aaa6-e6d5fe3a0a5f",
