                        ],
                        "form": "den Schutzschirm"
                    },
                    {
                        "form_id": "d879aa3c-759f-410e-9e8c-938041840ae0",
                        "entry_id": "7b035b67-ede6-30b6-8bcb-16ab9770997d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schutzschirme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76f82eaf-dd0b-323f-aa6f-5290799b2702",
                        "entry_id": "7b035b67-ede6-30b6-8bcb-16ab9770997d",
                        "glosses": [
                            "Maßnahmenkatalog, der (eine bestimmte Zielgruppe) vor Schaden bewahren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fe6032-d009-44e8-911e-d2331ae3ed7b",
                                "sense_id": "76f82eaf-dd0b-323f-aa6f-5290799b2702",
                                "text": "„Gut geborgen im westlichen Bündnis, vor allem unter dem atlantischen Schutzschirm der USA und der NATO, bestand nur wenig Bereitschaft, sich jenen neuen Herausforderungen zu stellen, die an Deutschland jetzt von westlicher wie östlicher Seite adressiert wurden.“"
                            },
                            {
                                "example_id": "f456d305-701d-48dc-966c-956f7afbbc35",
                                "sense_id": "76f82eaf-dd0b-323f-aa6f-5290799b2702",
                                "text": "„Kann jedes Unternehmen mit einem solchen Verfahren gerettet werden? Nein. Sind die Schulden des Betriebs bereits so hoch, dass Zahlungsunfähigkeit vorliegt, so kommt die Firma nicht unter den Schutzschirm.“"
                            },
                            {
                                "example_id": "5826a336-1134-41d3-a29d-6d2635f9de48",
                                "sense_id": "76f82eaf-dd0b-323f-aa6f-5290799b2702",
                                "text": "„Im Jahr 2008 sagte die deutsche Bundesregierung den Banken einen ‚Schutzschirm‘ im Volumen von bis zu 400 Mrd. € zu […].“"
                            },
                            {
                                "example_id": "d4ec142e-3f9e-41b6-a8f6-d26317950db7",
                                "sense_id": "76f82eaf-dd0b-323f-aa6f-5290799b2702",
                                "text": "„Kleine Unternehmen, Selbstständige und Freiberufler sehen angesichts der Corona-Krise ihre Existenz bedroht. Die Bundesregierung verspricht mehrere Möglichkeiten, Finanzhilfen zu bekommen. Verschiedene Schutzschirme werden derzeit erarbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9ad08f8-8d86-3a14-b52c-9e35d4bc294c",
                        "entry_id": "7b035b67-ede6-30b6-8bcb-16ab9770997d",
                        "glosses": [
                            "flache Vorrichtung, die vor schädlichen Einflüssen bewahren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef030d5-da2f-49a2-a747-855a520383ca",
                                "sense_id": "a9ad08f8-8d86-3a14-b52c-9e35d4bc294c",
                                "text": "„Die lineare Extraction war unter dem Einfluss der schrägen Beleuchtung mit Schutzschirm ausgeführt worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
