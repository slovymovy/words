                        "examples": [
                            {
                                "example_id": "1b1f7eab-ea2e-44b9-9d30-5404330d067f",
                                "sense_id": "bea63336-4813-30f3-9286-52f30050950f",
                                "text": "Речь идёт об электронных микрозондах и микроскопах, широко используемых для изучения состава руд, форм нахождения полезных элементов в минеральных видах, их распределении в продуктах переработки руд на всех этапах — от исходного сырья до так называемых хвостов — отходов производства."
                            }
                        ]
                    }
