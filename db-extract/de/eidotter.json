                                "target_senses": [
                                    {
                                        "sense_id": "9ee7d2b6-4a63-34f3-8265-bffe0a3efde3",
                                        "entry_id": "d64d7320-2a5a-34bb-8877-31f55eb34c50",
                                        "glosses": [
                                            "The yellow, spherical part of an egg that is surrounded by the white albumen, and serves as nutriment for the growing young."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4db541c-4679-4091-a3b1-0cd8ebd1efc4",
                                                "sense_id": "9ee7d2b6-4a63-34f3-8265-bffe0a3efde3",
                                                "text": "To make meringue, you have to separate the white from the yolk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c5d2d9e-56ed-36a7-96be-5404720683b3",
                                        "entry_id": "d64d7320-2a5a-34bb-8877-31f55eb34c50",
                                        "glosses": [
                                            "The grease in a sheep's fleece; lanolin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb77de5d-db65-4bff-8e77-1cf34e30b961",
                                                "sense_id": "3c5d2d9e-56ed-36a7-96be-5404720683b3",
                                                "text": "Wool-growers appear to entertain different opinions in regard to the effect which yolk has on the value of the fleece. Some seem to suppose that the aggregate amount which they receive for their wool is increased from the greater weight which it possesses by being charged with this substance[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yolk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "344a5a64-fc90-3969-a746-b59d838ef627",
                                        "entry_id": "5ae61581-9f42-30c5-91b3-216e7a3ff8e1",
                                        "glosses": [
                                            "To produce yolk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc5b8f8d-baf7-47c6-a4e3-f2a87c6cc1a8",
                                                "sense_id": "344a5a64-fc90-3969-a746-b59d838ef627",
                                                "text": "This is surprising in that these females were yolking up their clutch of eggs"
                                            }
                                        ]
