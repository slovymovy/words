                    {
                        "sense_id": "629d829c-397c-3add-987f-98f1af8aca75",
                        "entry_id": "4de134cb-41ff-359e-abed-f7c11ae8af0b",
                        "glosses": [
                            "Full of something causing fright, whether",
                            "Unpleasant, dreadful, awful (also used as an intensifier)."
                        ],
                        "tags": [
                            "excessive"
                        ],
                        "examples": [
                            {
                                "example_id": "18f918aa-bd59-417f-a7d9-1d3653338667",
                                "sense_id": "629d829c-397c-3add-987f-98f1af8aca75",
                                "text": "Francis Urquhart: What a frightful little man. Where do they find them these days?\nTim Stamper: God knows. If I had a dog like that, I'd shoot it.\nFrancis Urquhart: Well, yes. Quite."
                            }
                        ]
