                            {
                                "target_word": "bearing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4867d89-665a-39d5-b3ab-8b8ff6972814",
                                        "entry_id": "c2727a5e-e6d0-3763-b76b-91ce5b0773a5",
                                        "glosses": [
                                            "That bears (some specified thing)."
                                        ],
                                        "tags": [
                                            "in-compounds",
