                                        "entry_id": "51f46c59-cafd-3aff-9c42-1f3c91f4627c",
                                        "glosses": [
                                            "A person from Benin or of Beninese descent."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be643e13-312d-47d4-a47c-142567c49c65",
                                                "sense_id": "7f83a585-6fdf-34c3-9bbb-8bf959425931",
                                                "text": "“They wanted to know what part of Africa my parents hailed from,” Caesar said. “How was I to know? He said I had the nose of a Beninese.”"
                                            }
                                        ]
                                    }
                                ]
