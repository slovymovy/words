                "senses": [
                    {
                        "sense_id": "6c101d26-f455-3d21-85ad-1461bab8c973",
                        "entry_id": "e0aa52df-4e36-3996-b57c-36ee0cb8293e",
                        "glosses": [
                            "Sorte, die jemand am meisten mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f7467d-170c-47d3-ba8a-4214e8b4a900",
                                "sense_id": "6c101d26-f455-3d21-85ad-1461bab8c973",
                                "text": "„Er hatte eine Tetanusspritze bekommen, und sein Vater hatte ihm ein Eis gekauft, ein großes Kwality Vanille, seine Lieblingssorte.“"
                            },
                            {
                                "example_id": "c680d8ee-4bd8-4ff3-9657-8fb716e90afe",
                                "sense_id": "6c101d26-f455-3d21-85ad-1461bab8c973",
                                "text": "„Bei seinen häufigen Reisen zählte es zu seinen Gewohnheiten, stets die einheimischen Biermarken zu probieren. Dies war eine seiner Lieblingssorten.“"
                            },
                            {
                                "example_id": "7c1bed29-0576-48ce-b38d-c028ab292192",
                                "sense_id": "6c101d26-f455-3d21-85ad-1461bab8c973",
                                "text": "„›Schokolade ist meine Lieblingssorte. Hast du auch eine?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
