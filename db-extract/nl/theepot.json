                "translations": [
                    {
                        "translation_id": "8d31934c-efce-4d55-9cdd-05170172ea93",
                        "source_entry_id": "ad7d6c2f-3193-35c0-a493-1a16a52fb0e5",
                        "source_sense_id": "da923f16-e434-3250-b1dd-ea5e9fc8662a",
                        "source_sense_description": "kan met deksel en schenktuit waarin een warme drank wordt bereid door bladeren in heet water te laten trekken",
                        "target_lang_word": "Teekanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teekanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                        "entry_id": "e9d992be-eb6c-3753-a9e5-1b6a129cbd62",
                                        "glosses": [
                                            "(bauchige) Kanne, in der Tee oder Kräuteraufgüsse zubereitet und warmgehalten werden und die zum Servieren dieser Art von Aufgüssen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c08915e1-f0a0-48eb-b72b-c595d2c7dfd6",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "Teekannen gibt es in verschiedensten Farben, Formen und Größen."
                                            },
                                            {
                                                "example_id": "6f84b934-3c0c-4b2b-8f1b-47e101b30e51",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Die Teekanne blies noch Wölkchen aus der Tülle, und Sonnenlicht strömte durch die offenen Fenster.“"
                                            },
                                            {
                                                "example_id": "9765aaaf-3861-4793-990f-9d3e05335ad9",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Die Kaffeekanne war verschwunden und an ihre Stelle war eine silberne Teekanne getreten.“"
                                            },
                                            {
                                                "example_id": "2c77c223-965e-4efe-8b06-6559035c568f",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Sie stellte die Teekanne ab und legte die Hände um ihre dampfende Tasse.“"
                                            },
                                            {
                                                "example_id": "4774a218-4363-4ba3-b361-d6d098bab023",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Didier spielte ein bisschen an der Teekanne herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
