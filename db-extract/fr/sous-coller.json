                "senses": [
                    {
                        "sense_id": "6b63ac94-dcbf-3d8b-947d-28ce7cdd1dab",
                        "entry_id": "9f977d2c-d940-32ee-9f59-38df2d6ab12a",
                        "glosses": [
                            "S’organiser à deux (ou plusieurs) pour faire ses révisions pour un examen, en se posant mutuellement des questions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095eeb29-990d-4217-9297-bd5e10e76159",
                                "sense_id": "6b63ac94-dcbf-3d8b-947d-28ce7cdd1dab",
                                "text": "6 mai 42 – Je sous-colle deux fois par semaine en philologie avec des amis qui préparent l’agrégation. Je ne peux qu’être reçue cette fois."
                            },
                            {
                                "example_id": "fc7291f1-3256-4bef-87f8-192cd8948f2f",
                                "sense_id": "6b63ac94-dcbf-3d8b-947d-28ce7cdd1dab",
                                "text": "La sous-colle a peu de succès. Toutefois, ceux qui sous-collent plus de deux semaines par an augmentent régulièrement de P 2 (30%) à D 4 (60%)."
                            },
                            {
                                "example_id": "c23f7b89-062c-458f-b9ee-38dec222e49c",
                                "sense_id": "6b63ac94-dcbf-3d8b-947d-28ce7cdd1dab",
                                "text": "Peut-on sous-coller avec sa copine (ou son copain) ?"
                            },
                            {
                                "example_id": "376ce905-1c58-4e0c-a484-e6a7ed4dc89d",
                                "sense_id": "6b63ac94-dcbf-3d8b-947d-28ce7cdd1dab",
                                "text": "rech personne motivée pour sous-coller"
                            }
                        ]
                    }
