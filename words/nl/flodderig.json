    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed6d985c-b750-306e-a289-218af15b0c35",
                    "sense_definition": "slap en losjes hangend of wapperend, vooral van kleding of lappen stof",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze droeg een <w>flodderige</w> jurk die zachtjes meebewoog in de wind.",
                            "target_lang_translations": {
                                "fr": "Elle portait une robe <w>flottante</w> qui ondulait doucement dans le vent."
                            }
                        },
                        {
                            "text": "Zijn oude trui was helemaal uitgerekt en hing nogal <w>flodderig</w> om zijn schouders.",
                            "target_lang_translations": {
                                "fr": "Son vieux pull était complètement distendu et tombait de manière assez <w>avachie</w> sur ses épaules."
                            }
                        }
                    ],
                    "synonyms": [
                        "slordig"
                    ],
                    "common_phrases": [
                        "flodderige kleding",
                        "flodderige jurk",
                        "flodderige broek"
                    ],
                    "target_lang_definitions": {
                        "fr": "Mou, informe et pendant lâchement ou flottant au vent, en parlant particulièrement de vêtements ou de tissu."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "flottant",
                                "target_lang_sense_clarification": "ample et fluide"
                            },
                            {
                                "target_lang_word": "informe",
                                "target_lang_sense_clarification": "qui a perdu sa tenue ou sa forme"
                            },
                            {
                                "target_lang_word": "avachi",
                                "target_lang_sense_clarification": "détendu, distendu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d17fa368-500d-3b1a-8138-71161a3f1fd6",
                    "sense_definition": "een verwaarloosde of armoedige indruk makend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "armoedig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zwerver zag er met zijn versleten jas en kapotte schoenen erg <w>flodderig</w> uit.",
                            "target_lang_translations": {
                                "fr": "Avec son manteau usé et ses chaussures trouées, le sans-abri avait l'air très <w>débraillé</w>."
                            }
                        },
                        {
                            "text": "Het oude schuurtje achter in de tuin maakte een buitengewoon <w>flodderige</w> indruk.",
                            "target_lang_translations": {
                                "fr": "La vieille cabane au fond du jardin donnait une impression extrêmement <w>délabrée</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "haveloos",
                        "pover",
                        "sjofel",
                        "slordig",
                        "verlopen"
                    ],
                    "common_phrases": [
                        "flodderig uiterlijk"
                    ],
                    "target_lang_definitions": {
                        "fr": "Donnant une impression de négligence, débraillée ou misérable."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "débraillé",
                                "target_lang_sense_clarification": "vêtements négligés, mal ajustés"
                            },
                            {
                                "target_lang_word": "délabré",
                                "target_lang_sense_clarification": "en mauvais état, décrépit"
                            },
                            {
                                "target_lang_word": "miteux",
                                "target_lang_sense_clarification": "misérable, usé"
                            },
                            {
                                "target_lang_word": "négligé",
                                "target_lang_sense_clarification": "qui manque de soin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
