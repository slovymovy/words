                "senses": [
                    {
                        "sense_id": "a12e3d64-411f-3023-9b5c-bcb4c4adc19c",
                        "entry_id": "a8db2698-7b42-31a7-b95f-8d46e2270883",
                        "glosses": [
                            "Nebenform von Sabbat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0cdcba-da9a-4aca-a85c-9e4060df9a77",
                                "sense_id": "a12e3d64-411f-3023-9b5c-bcb4c4adc19c",
                                "text": "„Und wenn ihnen das fromme Jerusalem zu eng wird, fahren sie ins säkulare Tel Aviv, wo sich das Leben am Schabbat kaum von einem Wochentag unterscheidet.“"
                            },
                            {
                                "example_id": "7575fd14-4482-4795-8614-40112db9783b",
                                "sense_id": "a12e3d64-411f-3023-9b5c-bcb4c4adc19c",
                                "text": "„Am Schabbat erwacht die Stadt später als sonst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1f7ac27-8e3a-4fe0-84b9-e987af5d49b7",
                        "source_entry_id": "a8db2698-7b42-31a7-b95f-8d46e2270883",
