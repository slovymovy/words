                        "translation_id": "1198cf9a-af97-4f0e-89ab-407c211d1221",
                        "source_entry_id": "d3e53eb5-45b7-3192-81c7-ae06d572385f",
                        "source_sense_id": "b7e9b929-64c5-303d-a579-5c4d432ad85c",
                        "target_lang_word": "lucky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                                        "entry_id": "013e5bca-4d7e-3c0c-ae12-5f3f7cfda462",
                                        "glosses": [
                                            "Favoured by luck; fortunate; having good success or good fortune."
                                        ],
                                        "tags": [
                                            "of people"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "110b9760-7f23-4c64-94fa-0492e10f5e45",
                                                "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                                                "text": "The luckier and less disabled ones manned lifts or were posted at the doors of public buildings, a uniformed and bemedalled conciergerie who were more often than not unhelpful, making the most of whatever petty authority they were invested with."
                                            },
                                            {
                                                "example_id": "d5a49b47-4bfd-45fa-b77b-aec3ff6da7cd",
                                                "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                                                "text": "a lucky adventurer"
                                            },
                                            {
                                                "example_id": "26009e52-1ed7-466d-bbdb-4651533c5179",
                                                "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                                                "text": "The downed pilot is very lucky to be alive."
                                            },
                                            {
                                                "example_id": "ac1366c8-a262-4ad8-906d-b5dd5563200a",
                                                "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                                                "text": "I thought my nephew a fool ; I now know that he is a doosed sensible fellow, and the luckiest dog in Christendom — luckiest dog in Christendom, I declare."
                                            },
                                            {
                                                "example_id": "c7199cd3-b456-4e6a-af39-c4550c2180e6",
                                                "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                                                "text": "They sad ’cause they in their bowl / But fish in the bowl is lucky / They in for a worser fate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85fb9f9e-2cbe-36e4-843a-9c60188c99ea",
                                        "entry_id": "013e5bca-4d7e-3c0c-ae12-5f3f7cfda462",
                                        "glosses": [
                                            "Producing, or resulting in, good fortune"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df94629-9ec9-474d-a0f3-a1eea6f6e7a3",
                                                "sense_id": "85fb9f9e-2cbe-36e4-843a-9c60188c99ea",
                                                "text": "a lucky hour"
                                            },
                                            {
                                                "example_id": "49a89038-365d-475f-8b54-cbede037f2c8",
                                                "sense_id": "85fb9f9e-2cbe-36e4-843a-9c60188c99ea",
                                                "text": "A local doctor had bought one canvas and but for that lucky chance he would have been out of pocket."
                                            },
                                            {
                                                "example_id": "a2140506-a5d2-4662-86e2-be674702cb98",
                                                "sense_id": "85fb9f9e-2cbe-36e4-843a-9c60188c99ea",
                                                "text": "a lucky mistake"
                                            },
                                            {
                                                "example_id": "0d2685f4-8d5b-41c3-a836-b5c9bed6dc83",
                                                "sense_id": "85fb9f9e-2cbe-36e4-843a-9c60188c99ea",
                                                "text": "a lucky cast"
                                            }
                                        ]
                                    }
                                ]
                            },
