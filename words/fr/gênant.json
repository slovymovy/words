                            },
                            {
                                "target_lang_word": "engorroso",
                                "target_lang_sense_clarification": "objetos voluminosos, trámites complicados"
                            },
                            {
                                "target_lang_word": "inconveniente",
                                "target_lang_sense_clarification": "testigos, presencias que estorban"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碍事",
                                "target_lang_sense_clarification": "妨碍通行或活动"
                            },
                            {
