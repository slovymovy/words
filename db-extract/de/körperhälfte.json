                        "examples": [
                            {
                                "example_id": "c6b13698-b011-4baf-9473-5523ec1ede4a",
                                "sense_id": "73fa6878-b66b-3fe6-9f7d-2faf6b9599e1",
                                "text": "„Schon aus Tab. 4 und Abb. 12 a, b kann man erkennen, daß bei vielen chronisch Kranken in beiden Körperhälften verschiedene Ausgangslagen und Reaktionsweisen bestehen.“"
                            },
                            {
                                "example_id": "dd391f22-1e92-4a85-9e78-4973a5dcb38d",
                                "sense_id": "73fa6878-b66b-3fe6-9f7d-2faf6b9599e1",
                                "text": "„Doch jetzt war meine gelöschte Körperhälfte zum Luftpolster geworden, durch das heiße Partikel strömten.“"
                            }
                        ],
