                                                "sense_id": "100e8bc4-c714-3c89-a240-ca3a8b3190ce",
                                                "text": "3,5 Millionen Menschen leben in Liberia."
                                            },
                                            {
                                                "example_id": "8858a2c9-1c61-41d4-b19c-605b743f16a3",
                                                "sense_id": "100e8bc4-c714-3c89-a240-ca3a8b3190ce",
                                                "text": "Monrovia ist die Hauptstadt von Liberia."
                                            },
                                            {
                                                "example_id": "6b5ee7d8-b6fe-402d-8eba-82f960f213bd",
                                                "sense_id": "100e8bc4-c714-3c89-a240-ca3a8b3190ce",
                                                "text": "Woher bekomme ich verlässliche Informationen über das Liberia der Gegenwart?"
