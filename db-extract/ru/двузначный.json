                                "target_senses": [
                                    {
                                        "sense_id": "6ff3c7f7-0220-319f-bc8e-7cb3ddc8b3ce",
                                        "entry_id": "8bcf8b4b-dea0-31ae-b426-2efe090405f7",
                                        "glosses": [
                                            "składający się z dwóch cyfr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ee4873-93dc-4edf-bbab-6d7a937f8d3b",
                                                "sense_id": "6ff3c7f7-0220-319f-bc8e-7cb3ddc8b3ce",
                                                "text": "Liczba pięćdziesiąt sześć jest liczbą dwucyfrową."
                                            },
                                            {
                                                "example_id": "1c547a5a-7b89-493b-95e2-82e36f12248d",
                                                "sense_id": "6ff3c7f7-0220-319f-bc8e-7cb3ddc8b3ce",
                                                "text": "Firma może się pochwalić dwucyfrowym wzrostem sprzedaży w minionym roku."
                                            }
                                        ],
