                ],
                "senses": [
                    {
                        "sense_id": "a621d5b1-9a3a-3e02-94ad-08ca66d20939",
                        "entry_id": "2df0bc6b-5401-33b6-a85d-7d4d9440e8ed",
                        "glosses": [
                            "Auswirkung auch auf Anderes, als das eigentlich zunächst Betroffene/Gemeinte"
                        ],
                        "tags": [
                            "Soziologie",
                            "Werbung"
                        ],
                        "examples": [
                            {
                                "example_id": "c390c376-527c-4f69-8ffa-21b26a5c4221",
                                "sense_id": "a621d5b1-9a3a-3e02-94ad-08ca66d20939",
                                "text": "„Möglich ist auch ein Spillover von der Freizeit auf die Arbeit oder die gleichzeitige Beeinflussung von Arbeit und Freizeit durch Drittvariablen wie beispielsweise Persönlichkeit, Ausbildung oder spezifische Kompetenzen.“"
                            },
                            {
                                "example_id": "ea930928-a7d8-4ad4-acb9-1ba89076cebc",
                                "sense_id": "a621d5b1-9a3a-3e02-94ad-08ca66d20939",
                                "text": "„Bei Spillover handelt es sich um die Übertragung zwischen Lebensbereichen einer Person, während Crossover die Übertragung von einer Person auf eine andere Person innerhalb eines Lebensbereiches beschreibt. Beide Übertragungseffekte werden von Bakker und Demerouti (2013) im Spillover-Crossover Modell (SCM) integriert beschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2531a6c7-d8aa-3d7c-8939-60b8f7cda537",
                        "entry_id": "2df0bc6b-5401-33b6-a85d-7d4d9440e8ed",
                        "glosses": [
                            "Übertragung über die Artengrenze hinweg; insbesondere der Wechsel eines Virus vom Wirt Tier zum Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d483aa9-ce8d-4720-8000-70e1573eaa21",
                                "sense_id": "2531a6c7-d8aa-3d7c-8939-60b8f7cda537",
                                "text": "„Der Spillover zum Menschen kann entweder direkt oder über Zwischenwirte erfolgen.“"
                            },
                            {
                                "example_id": "03dc87e6-42ed-4800-b6c7-876018944f4d",
                                "sense_id": "2531a6c7-d8aa-3d7c-8939-60b8f7cda537",
                                "text": "„Als Mittler zwischen Tier und Mensch gerieten Schlangen wie die chinesische Kobra unter Verdacht. Der Übersprung, der \"Spillover\", könnte dieser Vermutung zufolge durch den Genuss von Schlangenfleisch geschehen sein.“"
                            },
                            {
                                "example_id": "c4f2f6ff-168e-4ca3-afc8-8eec3885e529",
                                "sense_id": "2531a6c7-d8aa-3d7c-8939-60b8f7cda537",
                                "text": "„Die Jagd auf wilde Tiere und der Handel mit ihnen steigern die Gefahr des sogenannten Spillovers.“"
                            },
                            {
                                "example_id": "49c6f672-36d3-4a56-98c6-d3eea2c9c45c",
                                "sense_id": "2531a6c7-d8aa-3d7c-8939-60b8f7cda537",
                                "text": "„Seuchen wie Ebola, Aids und SARS erreichen dank moderner Verkehrsmittel schnell mehrere Kontinente. Ihnen ist eines gemeinsam: Die Erreger sprangen vom Tier auf den Menschen über – der sogenannte Spillover.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
