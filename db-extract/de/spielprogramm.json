                "senses": [
                    {
                        "sense_id": "48add427-f964-36d9-927e-dbbccfb45bef",
                        "entry_id": "cda63799-507a-3021-b7f7-cea6c824267e",
                        "glosses": [
                            "systematische, zum Beispiel zeitliche, strukturelle und/oder inhaltliche Festlegung einer Abfolge von Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49a409c-f076-4b0b-bdf1-d951e8ac7635",
                                "sense_id": "48add427-f964-36d9-927e-dbbccfb45bef",
                                "text": "„Dies führt zu einer Spielmüdigkeit, der mitunter auch durch immer wieder neue oder neu zusammengesetzte Spielprogramme nicht mehr entgegenzuwirken ist.“"
                            },
                            {
                                "example_id": "0fd7cc01-b07d-4847-8a55-c19a808ebbd4",
                                "sense_id": "48add427-f964-36d9-927e-dbbccfb45bef",
                                "text": "„Der zweite Antrag will gar erreichen, dass die Herstellung, das Anpreisen, die Einfuhr, der Verkauf und die Weitergabe von Spielprogrammen verboten werden, in denen grausame Gewalttätigkeiten gegen Menschen und menschenähnliche Wesen zum Spielerfolg beitragen.“"
                            },
                            {
                                "example_id": "b32ecae8-b860-468e-860f-4ee4bb347899",
                                "sense_id": "48add427-f964-36d9-927e-dbbccfb45bef",
                                "text": "„Nachmittags treffen sich Jungen und Mädchen für Sport- und Spielprogramme; Tutoren bereiten Jugendliche auf den High-School-Abschluß und das College vor.“"
                            },
                            {
                                "example_id": "8e91f4ae-fb96-49b6-b0d7-b5aab4524be2",
                                "sense_id": "48add427-f964-36d9-927e-dbbccfb45bef",
                                "text": "„Die Spielprogramme expandieren, immer neue Figuren betreten die Szene, immer neue Geschichten werden erfunden.“"
                            },
                            {
                                "example_id": "b0ed5cfc-9476-4ded-84de-f5219dacada3",
                                "sense_id": "48add427-f964-36d9-927e-dbbccfb45bef",
                                "text": "„Die Hoteliers sind sich sicher, mit ihrem Freizeit- und Spielprogramm die Möglichkeiten, die Eltern ihren Sprößlingen bieten, weit zu übertreffen und somit auch Ferienfreiheit für die Eltern zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
