                "senses": [
                    {
                        "sense_id": "832f3172-ec91-3b4e-b0bd-6962bf1a83e8",
                        "entry_id": "2abd29cb-7121-39ae-9d06-693e1f5266ea",
                        "glosses": [
                            "Nervengeflecht des sympathischen Nervensystems im Oberbauch zwischen der Aorta und dem Magen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db312373-470e-42dd-ab9f-3645b569d73e",
                                "sense_id": "832f3172-ec91-3b4e-b0bd-6962bf1a83e8",
                                "text": "„Dass der Solarplexus existiert, ist in der Regel erst dann spürbar, wenn sich ein Druck- oder ein Spannungsgefühl mit Übelkeit aufbaut. Darüber hinaus ist der Solarplexus an schmerzhaften Beschwerden der Bauchspeicheldrüse, der tiefen und der knapp unter der Hautoberfläche verlaufenden Rückenmuskulatur und des Dickdarms beteiligt.“"
                            },
                            {
                                "example_id": "aae30799-6a73-4346-bc80-c58c1965c580",
                                "sense_id": "832f3172-ec91-3b4e-b0bd-6962bf1a83e8",
                                "text": "„Er schlug ihm kurze Gerade und gewaltige Schwinger um Kinn und Ohren, er pfefferte zwei wüste Herzhaken und einen grauenhaften Schlag auf den Solarplexus hinterher, und es schien ihm, als hörte er Ammers mit einem Ächzen zu Boden krachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
