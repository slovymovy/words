                        "source_sense_id": "f76e59eb-1147-3764-9ab1-d77f6395caaa",
                        "target_lang_word": "tilde",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tilde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97900a30-c5b1-39ee-8d66-465371990818",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "In Spanish, ⟨ñ⟩ is a palatalized ⟨n⟩, for example in ⟨cañón⟩."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a119a038-9598-4f24-a63c-d09d155d3dd8",
                                                "sense_id": "97900a30-c5b1-39ee-8d66-465371990818",
                                                "text": "California, like several other states, prohibits the use of diacritical marks or accents on official documents. That means no tilde (~), no accent grave (`), no umlaut (¨) and certainly no cedilla (¸)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4e6c03-3130-3728-80ea-0caa1c52bf21",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "In Portuguese, ⟨ã⟩ and ⟨õ⟩ are nasalized vowels, for example in ⟨canção⟩."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262395d5-6dc9-435b-9530-bd5e265b239e",
                                                "sense_id": "1c4e6c03-3130-3728-80ea-0caa1c52bf21",
                                                "text": "The tilde was used similarly in Portuguese on vowels to show that the letter bearing the tilde should be pronounced nasally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464d3e56-4dbf-383a-8988-4644d7794edf",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "Another name for the Vietnamese tone mark dấu ngã, which is placed above a vowel to indicate a creaky rising tone (thanh ngã)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbd3c3b5-baf7-38bf-a3ac-365a123b5a4e",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "Another name for apex, a curved diacritic used in the 17th century to mark final nasalization in the early Vietnamese alphabet. It was an adoption of the Portuguese tilde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1412cd2b-ab09-3219-833f-6b9df6321d37",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A symbol ⟨~⟩, with various names and uses, also known as swung dash or wave dash. In the computer industry, various other names may be used, such as squiggle and twiddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "883f57c2-9268-47bf-862a-00b1232199ff",
                                                "sense_id": "1412cd2b-ab09-3219-833f-6b9df6321d37",
                                                "text": "swung dash A stock keyboard character, used in mathematics as the sign of similarity (a ~ b) and in lexicography as a sign of repetition. The same sign has been used in symbolic logic to indicate negation, but to avoid confusion, the angular negation symbol (¬) is preferred. Not to be confused with the tilde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25837a23-5b35-3ca6-aba0-e16fd2cb9f1f",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A symbol ⟨~⟩, with various names and uses, also known as swung dash or wave dash. In the computer industry, various other names may be used, such as squiggle and twiddle.",
                                            "The character encoded as decimal 126 in the 1967 ASCII character set, and later in the 1992 Unicode character set."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e24c71f-a49e-3da5-bd0b-fb5b6c4450b2",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A symbol ⟨~⟩, with various names and uses, also known as swung dash or wave dash. In the computer industry, various other names may be used, such as squiggle and twiddle.",
                                            "A punctuation mark that indicates range (from a number to another number). This use is common in Asia, where the symbol in this case is also called a wave dash."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0593bb1d-218a-39da-a2ae-9ce8cc7eaf9e",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A symbol ⟨~⟩, with various names and uses, also known as swung dash or wave dash. In the computer industry, various other names may be used, such as squiggle and twiddle.",
                                            "In lexicography, the ⟨~⟩ symbol is used used to indicate the repetition of the topical word or item. In this case, the symbol is also called a swung dash."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4ecc836-f945-3b9c-8a6d-fef17d723ae5",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A symbol ⟨~⟩, with various names and uses, also known as swung dash or wave dash. In the computer industry, various other names may be used, such as squiggle and twiddle.",
                                            "May be used to represent approximation, in English prose and in mathematics. For example, “My dog weighs ~30 pounds.”"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
