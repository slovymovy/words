                        "entry_id": "43356977-64b4-3269-8080-777214c8135c",
                        "glosses": [
                            "A Mexican sandal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb754894-7474-4da7-a870-d478c3a8a477",
                                "sense_id": "2cc6c9ed-c1b5-30f6-9073-dfcaa8e9c666",
                                "text": "My shoes, damn fool that I am, were Mexican huaraches, plantlike sieves not fit for the rainy night of America and the raw road night."
                            },
                            {
                                "example_id": "6a7929ed-a27f-4d71-a89f-909a54235103",
                                "sense_id": "2cc6c9ed-c1b5-30f6-9073-dfcaa8e9c666",
                                "text": "The huaraches he wore looked like dried and blackened fish lashed to the floors of his feet."
                            }
                        ]
                    },
                    {
                        "sense_id": "88efffcd-2f1f-3962-b9fc-559a0d7bc66a",
                        "entry_id": "43356977-64b4-3269-8080-777214c8135c",
                        "glosses": [
                            "A food similar in shape to such a sandal, consisting of a fried masa dough base with a topping, typically salsa, potato, meat, or cheese."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53ae514-a825-4b2b-a0f5-571e12e9bac1",
                                "sense_id": "88efffcd-2f1f-3962-b9fc-559a0d7bc66a",
                                "text": "They’re then ground into a homogeneous dough that holds whatever shape you choose to give it: thin circles for tortillas, thicker ones for gorditas and sopes, plump ovals for huaraches and triangles for black-bean stuffed tetelas."
                            }
                        ]
                    }
