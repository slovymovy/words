                "senses": [
                    {
                        "sense_id": "1abf0df9-d8e9-3aac-9859-8d252b59a6c9",
                        "entry_id": "d4a21906-2ff1-32f4-80e3-34bf00e1a005",
                        "glosses": [
                            "der ranghöchste Titel christlicher Kirchen, den originär folgende fünf römischen Basiliken führen: St. Johann im Lateran, S. Maria Maggiora, St. Peter im Vatikan, St. Paul und St. Laurentius. Diese fünf Kirchen unterstehen direkt dem Papst. Die besonderen Kennzeichen der Patriarchalbasiliken sind der Papstaltar und der Papstthron."
                        ],
                        "tags": [
                            "christliche Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "a0254c67-3e2b-4aa2-a0ca-65cb46919d66",
                                "sense_id": "1abf0df9-d8e9-3aac-9859-8d252b59a6c9",
                                "text": "„Papst Benedikt XIV verlieh 1756 der Kirche St. Francesco in Assisi und Papst Pius X 1909 ebenda der Kirche S. Maria degli Angeli den Titel Patriarchalbasilika“."
                            },
                            {
                                "example_id": "e5fdffcb-3b14-4db2-9f71-a80b86cdd8d4",
                                "sense_id": "1abf0df9-d8e9-3aac-9859-8d252b59a6c9",
                                "text": "„Der Ausdruck \"Basilicae maiores\", um insbesondere die Patriarchalbasiliken zu bezeichnen, kam erst seit Beginn des 18. Jahrhunderts in allgemeinen Gebrauch.\""
                            },
                            {
                                "example_id": "7c0206b6-b4fa-4f80-8a94-5ae5eaa44eb2",
                                "sense_id": "1abf0df9-d8e9-3aac-9859-8d252b59a6c9",
                                "text": "Die größte Patriarchalbasilika ist der Petersdom."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
