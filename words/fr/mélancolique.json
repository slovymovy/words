                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il écoute une chanson <w>mélancolique</w> en regardant la pluie tomber sur la vitre."
                        },
                        {
                            "text": "Le peintre a choisi des couleurs sombres pour créer une atmosphère particulièrement <w>mélancolique</w>."
                        }
                    ],
                    "synonyms": [
