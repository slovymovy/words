                        ],
                        "examples": [
                            {
                                "example_id": "eb56c624-ab1c-4a7d-af21-51100d493cec",
                                "sense_id": "55e69cbe-d7c5-3df0-9f0d-1ad4b238119d",
                                "text": "De ontdekkingsreiziger deed een opmerkelijke ontdekking in het onbekende gebied.",
                                "translation": "The explorer made a remarkable discovery in the uncharted territory.",
                                "english": "The explorer made a remarkable discovery in the uncharted territory."
                            },
                            {
                                "example_id": "baa4f1cf-c73b-470a-83b6-e89ad66a85f0",
                                "sense_id": "55e69cbe-d7c5-3df0-9f0d-1ad4b238119d",
                                "text": "De wetenschappers deden een baanbrekende ontdekking op het gebied van geneeskunde.",
                                "translation": "The scientists made a groundbreaking discovery in the field of medicine.",
                                "english": "The scientists made a groundbreaking discovery in the field of medicine."
                            },
                            {
                                "example_id": "fe4bbb9b-ea02-48d3-961e-4b6d4b88298e",
                                "sense_id": "55e69cbe-d7c5-3df0-9f0d-1ad4b238119d",
                                "text": "De archeologen deden een belangrijke ontdekking in de oude ruïnes.",
                                "translation": "The archaeologists made an important discovery in the ancient ruins.",
                                "english": "The archaeologists made an important discovery in the ancient ruins."
                            }
                        ]
                    }
