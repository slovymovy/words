                ],
                "senses": [
                    {
                        "sense_id": "ff3773d6-d33f-30fe-bd64-e8a1a03ce78f",
                        "entry_id": "c8c6df60-1004-30b9-a616-4710703e3a25",
                        "glosses": [
                            "der Glaube an übernatürliche Eigenschaften eines Gegenstands und dessen Verehrung bzw. ebendieser Gegenstand"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b20d0225-2d1b-453b-818e-a78404852aa5",
                                "sense_id": "ff3773d6-d33f-30fe-bd64-e8a1a03ce78f",
                                "text": "„Es liegen Beispiele genug vor Augen, dass, wenn auf allzu harte Proben gestellt, die Geduld des frommen Verehrers schliesslich abriss, und der Fetisch zerbrochen wurde oder doch zum Tempel hinausgeworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fdfe34d4-2c3c-35e4-9501-304647c38333",
                        "entry_id": "c8c6df60-1004-30b9-a616-4710703e3a25",
                        "glosses": [
                            "Sexualtrieb, der auf unbelebte Objekte bezogen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b67353e-261e-49af-9c91-434ea6df4a78",
                                "sense_id": "fdfe34d4-2c3c-35e4-9501-304647c38333",
                                "text": "Häufig ist sexueller Fetischismus auf bestimmte Kleidungsstücke oder Schuhe bezogen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ecfec988-3038-39d0-b579-a3fdcc5e243d",
                        "entry_id": "c8c6df60-1004-30b9-a616-4710703e3a25",
                        "glosses": [
                            "Sexualtrieb, der von der \\\"Norm\\\" abweicht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9063f30d-b3f7-410d-a51e-51107760781c",
                                "sense_id": "ecfec988-3038-39d0-b579-a3fdcc5e243d",
                                "text": "Im Alltag wird von Laien auch im Bezug auf Körperteile oder Tiere gerne mal ein Fetischismus diagnostiziert."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "82e4b3e2-ed83-38fc-8153-fb073ede55cb",
                        "entry_id": "c8c6df60-1004-30b9-a616-4710703e3a25",
                        "glosses": [
                            "die quasireligiöse Verehrung hergestellter Waren"
                        ],
                        "tags": [
                            "Marxismus"
                        ],
                        "examples": [
                            {
                                "example_id": "e5918afb-1889-454f-b519-25248b60360b",
                                "sense_id": "82e4b3e2-ed83-38fc-8153-fb073ede55cb",
                                "text": "„Dies nenne ich den Fetischismus, der den Arbeitsprodukten anklebt, sobald sie als Waren produziert werden, und der daher von der Warenproduktion unzertrennlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
