                        ],
                        "examples": [
                            {
                                "example_id": "f2beac5a-ad20-4a57-ae4b-bb4475bff602",
                                "sense_id": "4e3b2abf-1cfe-3816-a335-37843e13da31",
                                "text": "W naszej klasie jest czterech spadochroniarzy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5256e3e5-179d-30c7-b4b5-251cd981a1aa",
                        "entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
                        "glosses": [
                            "polityk, który startuje w wyborach w innym, niż macierzysty, okręgu wyborczym"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0b190d05-fd1d-44ec-b779-118861bfc982",
                                "sense_id": "5256e3e5-179d-30c7-b4b5-251cd981a1aa",
                                "text": "Polityczny spadochroniarz nie ma łatwego życia w nowym okręgu wyborczym."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b952dced-595c-4631-b7bc-620951d01c58",
                        "source_entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
                        "source_sense_id": "ccc3689d-ec28-3beb-8f2d-8f74dcd9bf5d",
                        "target_lang_word": "parachutist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parachutist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                        "entry_id": "62a4667d-3299-3f30-b45f-3dc006656c52",
                                        "glosses": [
                                            "Someone who jumps from an aircraft using a parachute, especially as a sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2452500e-908e-4ecc-90ea-ef33d9707641",
                                                "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                                "text": "If any of the extreme sports can be considered truly high risk, then B.A.S.E. Jumping is that sport. […] Modern B.A.S.E. jumping is believed to have started in 1978, where daring parachutists first began jumping off of El Capitan, a 3,000 foot (915m) cliff high above Yosemite National Park."
                                            },
                                            {
                                                "example_id": "f21d26b2-a14d-4d95-ba85-c55c37b6d090",
                                                "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                                "text": "I waited and he came to the point: he wanted me simply to talk to a patient he had inherited, a sports parachutist who had Roman Candled into a tree and broken and disarticulated his back."
                                            },
                                            {
                                                "example_id": "ff9130b4-d3b8-421c-9dab-15533634d195",
                                                "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                                "text": "Some hit the rocky outcrops\n Some fell into the sea\n Some even 'Roman Candled'\n (A parachutist I would never be)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "433edf97-32ff-4229-b16b-a41f5a4ae5e7",
                        "source_entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
                        "source_sense_id": "ccc3689d-ec28-3beb-8f2d-8f74dcd9bf5d",
                        "target_lang_word": "sky-diver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c5350485-017a-4e62-aca8-8bf3dff98b78",
                        "source_entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
                        "source_sense_id": "ccc3689d-ec28-3beb-8f2d-8f74dcd9bf5d",
                        "target_lang_word": "paratrooper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paratrooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c15e4a93-af09-3519-8852-598561ae7c12",
                                        "entry_id": "5b8af89c-1f00-3326-a2fd-bd6dcab2628f",
                                        "glosses": [
                                            "A type of soldier who is trained to enter combat zones by parachuting from aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c63e26-adcb-4579-9729-2ae412fc93b5",
                                                "sense_id": "c15e4a93-af09-3519-8852-598561ae7c12",
                                                "text": "Upon receiving intelligence reports about the massing of enemy paratroopers, General Peng Dehuai posted a defence regiment at Yan'an airfield, and requested that Mao leave Yan'an as soon as possible.",
                                                "translation": "Mao Zedong: Man, Not God",
                                                "english": "Mao Zedong: Man, Not God"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9723ac0-1729-4845-a8f7-35ce50816dc0",
                        "source_entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
                        "source_sense_id": "ccc3689d-ec28-3beb-8f2d-8f74dcd9bf5d",
                        "target_lang_word": "parašutista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parašutista",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "60c091e6-cd3d-3603-944a-85e05e498cb5",
                                        "entry_id": "5dfc4259-804b-33e2-9d23-ae3b077ba96e",
                                        "glosses": [
                                            "ten, kdo skočí a padá s padákem"
                                        ],
                                        "tags": [
                                            "příp. tak činí pravidelně"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e1999d-310e-41f2-8c1a-1b96cfeca887",
                                                "sense_id": "60c091e6-cd3d-3603-944a-85e05e498cb5",
                                                "text": "Třiapadesátiletý parašutista, který loni v srpnu zemřel při seskoku na letišti v Klatovech po kolizi s jiným parašutistou ve vzduchu, pozdě aktivoval záložní padák."
                                            },
                                            {
                                                "example_id": "60078586-fb0a-48c3-92b6-0d59d91a67dd",
                                                "sense_id": "60c091e6-cd3d-3603-944a-85e05e498cb5",
                                                "text": "Boj v kostele sv. Cyrila a Metoděje se odehrál 18. června 1942 mezi příslušníky SS a gestapa a sedmi československými parašutisty z výsadků Anthropoid, Silver A, Out Distance, Bioscop a Tin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5abbfee-66b3-487e-9c61-22cb8d09bfa8",
                        "source_entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
