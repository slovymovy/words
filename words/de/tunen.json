            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d64372d1-b926-352b-9d74-d8d60b1ed45f",
                    "sense_definition": "Ein Fahrzeug oder ein technisches Gerät modifizieren, um dessen Leistung, Geschwindigkeit oder Aussehen zu verbessern.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "optimieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat viel Zeit und Geld investiert, um sein altes Auto zu <w>tunen</w>."
                        },
                        {
                            "text": "In seiner Freizeit <w>tunt</w> er gerne Motoren von Motorrädern, um mehr Leistung herauszuholen."
                        }
                    ],
                    "synonyms": [
                        "frisieren",
                        "aufmotzen"
                    ],
                    "common_phrases": [
                        "ein Auto tunen",
                        "den Motor tunen"
                    ]
                },
                {
                    "sense_id": "17c23558-3fc9-36ad-8255-a45ad73190d5",
                    "sense_definition": "Etwas gezielt optimieren oder an spezielle Anforderungen anpassen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "optimieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man muss kein Experte sein, um das Betriebssystem seines Computers gezielt zu <w>tunen</w>."
                        },
                        {
                            "text": "Vor dem Start des Projekts <w>tunte</w> das Team die Software noch einmal gründlich."
                        }
                    ],
                    "synonyms": [
                        "optimieren",
                        "anpassen",
                        "nachjustieren"
                    ],
                    "common_phrases": [
                        "das System tunen"
                    ]
                },
                {
