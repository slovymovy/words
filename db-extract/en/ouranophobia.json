                        "examples": [
                            {
                                "example_id": "40c75527-3c13-4bc2-b478-2c2b4da3fceb",
                                "sense_id": "8635498e-3e8c-3b28-b260-7539b4b74120",
                                "text": "Now I’m not saying I was ever clinically diagnosed with ouranophobia. I wasn’t."
                            },
                            {
                                "example_id": "8514c56e-0bb2-4153-8b35-d514f4cdb9c8",
                                "sense_id": "8635498e-3e8c-3b28-b260-7539b4b74120",
                                "text": "Besides, maybe I don't want heaven regardless of the price. Maybe I have Ouranophobia and am consequently scared shitless by the very mention of heaven."
                            },
                            {
                                "example_id": "34bae6db-8736-44af-8c6e-45cbdec8b8f4",
                                "sense_id": "8635498e-3e8c-3b28-b260-7539b4b74120",
                                "text": "She thinks I'm bringing this up to make fun of her, but I explain that (a) her fears are adorable, and (b) that's not the point. I tell her I think we both suffer from ouranophobia and she asks what that means and I tell her we're afraid of heaven."
                            }
                        ]
