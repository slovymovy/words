{
    "word_family": [
        "conspicuous",
        "conspicuously",
        "inconspicuously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "721975b5-7ae7-3d84-b63b-d4923f38a58d",
                    "sense_definition": "Not prominent or easily noticeable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small camera was <w>inconspicuous</w> and hidden in the corner of the room.",
                            "target_lang_translations": {
                                "tr": "Küçük kamera <w>göze çarpmıyordu</w> ve odanın köşesinde gizlenmişti."
                            }
                        },
                        {
                            "text": "He wore an <w>inconspicuous</w> grey suit to blend in with the crowd.",
                            "target_lang_translations": {
                                "tr": "Kalabalığa karışmak için <w>dikkat çekmeyen</w> gri bir takım elbise giydi."
                            }
                        }
                    ],
                    "synonyms": [
                        "unobtrusive",
                        "discreet"
                    ],
                    "antonyms": [
                        "visible",
                        "conspicuous"
                    ],
                    "common_phrases": [
                        "remain inconspicuous"
                    ],
                    "target_lang_definitions": {
                        "tr": "Göze çarpmayan, dikkat çekmeyen veya kolayca fark edilmeyen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göze çarpmayan",
                                "target_lang_sense_clarification": "Dikkat çekmeyen, fark edilmesi zor olan durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "dikkat çekmeyen",
                                "target_lang_sense_clarification": "Öne çıkmayan, çevresiyle uyum sağlayan."
                            },
                            {
                                "target_lang_word": "göze batmayan",
                                "target_lang_sense_clarification": "Rahatsız edici derecede belirgin olmayan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42812afe-5ea8-3998-89f2-2cdc646111bd",
                    "sense_definition": "Impossible to see; not visible.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tiny insect was <w>inconspicuous</w> against the dark bark of the tree.",
                            "target_lang_translations": {
                                "tr": "Küçücük böcek, ağacın koyu renkli kabuğu üzerinde <w>görünmez</w> haldeydi."
                            }
                        },
                        {
                            "text": "The secret door was made <w>inconspicuous</w> by the wallpaper covering it.",
                            "target_lang_translations": {
                                "tr": "Gizli kapı, üzerini kaplayan duvar kağıdı sayesinde <w>göze çarpmayacak</w> hale getirilmişti."
                            }
                        }
                    ],
                    "synonyms": [
                        "hidden",
                        "invisible"
                    ],
                    "antonyms": [
                        "visible"
                    ],
                    "target_lang_definitions": {
                        "tr": "Görülmesi imkansız veya zor olan; görünür olmayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "görünmez",
                                "target_lang_sense_clarification": "Gözle görülmesi mümkün olmayan."
                            },
                            {
                                "target_lang_word": "gizli",
                                "target_lang_sense_clarification": "Saklanmış veya fark edilmesi engellenmiş."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}