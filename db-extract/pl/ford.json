                                "target_senses": [
                                    {
                                        "sense_id": "8ca481c2-ad9d-3f60-9a20-6e75e00414a0",
                                        "entry_id": "a6643d07-62b0-34f5-9dd6-1648b50e6394",
                                        "glosses": [
                                            "автомобиль марки «Ford»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cd93dc-2be9-4834-80aa-400ece7e37a7",
                                                "sense_id": "8ca481c2-ad9d-3f60-9a20-6e75e00414a0",
                                                "text": "Пульсирующая мигалка гаишного «форда» плавила асфальт переливчатым пунцово-синим огнём."
                                            },
                                            {
                                                "example_id": "3a06ac05-93d1-4804-afb5-47dbcdba624c",
                                                "sense_id": "8ca481c2-ad9d-3f60-9a20-6e75e00414a0",
                                                "text": "Нет-нет да мелькнёт за стеклом «форда», «тойоты» или «лендровера» пиратская косица, шляпа с перьями, бархатный плащ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
