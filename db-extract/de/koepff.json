                "senses": [
                    {
                        "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                        "entry_id": "3dcb4e0d-7aaf-3eb5-8f5e-aadc48378fec",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba3289a9-c5cd-4c13-a9c7-db4e50527da3",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Frau Koepff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0457094-6d14-451f-900b-5cbfa40e77b2",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Herr Koepff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b52c31d4-361e-4c0d-95f1-ff30467ad239",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Die Koepffs fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9e142475-ee3e-4a2c-a6c1-1546c92f1221",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Der Koepff trägt nie die Pullover, die die Koepff ihm strickt."
                            },
                            {
                                "example_id": "8c0ff8a0-d76f-440f-8636-28ef7c8c4219",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Koepff kommt, geht der Herr Koepff.“"
                            },
                            {
                                "example_id": "3ff2eecc-40cb-4dfc-a2bb-769c037e58da",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Koepff kommt und geht."
                            },
                            {
                                "example_id": "2b4ae235-c519-4d22-a2de-750979efac60",
                                "sense_id": "f84d7528-d6f6-3703-9c75-5e2906cf40f1",
                                "text": "Koepffs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
