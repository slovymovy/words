            {
                "entry_id": "1de8668f-28fc-3a1e-9b46-41394fbc063d",
                "word": "sellable",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "caf1c9a1-79a5-4808-a02a-145d1015f99c",
                        "entry_id": "1de8668f-28fc-3a1e-9b46-41394fbc063d",
                        "tags": [
                            "plural"
                        ],
                        "form": "sellables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3db05033-a7b2-3059-8c7f-f118c86eca72",
                        "entry_id": "1de8668f-28fc-3a1e-9b46-41394fbc063d",
                        "glosses": [
                            "Something sellable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56dcf84-c05d-449d-9454-3341d3eea43c",
                                "sense_id": "3db05033-a7b2-3059-8c7f-f118c86eca72",
                                "text": "I have been doing my best to overcome jitters after two Whittingehame Court burglaries, one next door and one in the flat above me, both too near for comfort, done in mid-afternoon by the total non-finesse of smashing the door open, stuffing videos and other portable sellables into a large holdall, and making off into the May sunshine apparently unnoticed by anyone."
                            },
                            {
                                "example_id": "216f4652-8512-4340-9903-12e214465f17",
                                "sense_id": "3db05033-a7b2-3059-8c7f-f118c86eca72",
                                "text": "The cobblestone block of Fulton Street is home to more upscale shops and restaurants, but the old wooden pier is where you’ll find food stands, clothing kiosks, and more random sellables like balloon animal crafts."
                            },
                            {
                                "example_id": "90d80029-4f43-403a-9ff0-e75ea5cb9d36",
                                "sense_id": "3db05033-a7b2-3059-8c7f-f118c86eca72",
                                "text": "“Whatcha got?” He nodded to the piles of swag and sellables."
                            },
                            {
                                "example_id": "bd35ec67-e150-44bb-a24e-d357ed0d74c3",
                                "sense_id": "3db05033-a7b2-3059-8c7f-f118c86eca72",
                                "text": "They’re traders, girl. If they stop it’s only to make themselves a sale. And do you think they’d throw off some of their sellables to make way for a pregnant whore?"
                            }
                        ]
                    }
                ],
