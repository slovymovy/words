                                        "entry_id": "acd6859e-7561-35f4-ab69-4f8ef3062b41",
                                        "glosses": [
                                            "A fortified place; a large and permanent fortification, sometimes including a town; for example a fort, a castle; a stronghold; a place of defense or security."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3095e9-5a55-458a-a233-b54602f9ffd2",
                                                "sense_id": "04b67daa-b8b3-3d83-9529-f131eb6326b6",
                                                "text": "Like the Mesolithic age of 10,000-8000 B.C., the period 6000-4000 B.C. seems to be one of the fall of fortresses and the rise of pastoral nomadism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4418a9f-a482-34b8-b581-5756f6e62eca",
                                        "entry_id": "acd6859e-7561-35f4-ab69-4f8ef3062b41",
                                        "glosses": [
                                            "A position that, if obtained by the weaker side, will prevent penetration by the opposing side, generally achieving a draw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
