                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e86d655-9b13-4817-aa97-21add7473a30",
                                                "sense_id": "4edbfb71-0eb1-319c-8e82-d8db916fd659",
                                                "text": "Nos conversations, pleines de bonhomie, avaient lieu en flamand et en bas-saxon."
                                            }
