                            {
                                "target_lang_word": "автошина",
                                "target_lang_sense_clarification": "специально для автомобилей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40ef7909-8741-39ef-881f-4eb5961b5891",
                    "sense_definition": "The metal rim or outer covering of a wheel, typically found on railway carriages, locomotives, or old horse-drawn wagons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wheel_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith worked all afternoon to fit the heavy iron <w>tyre</w> onto the wooden wagon wheel.",
                            "target_lang_translations": {
                                "ru": "Кузнец работал весь день, чтобы установить тяжелую железную <w>шину</w> на деревянное колесо повозки."
                            }
                        },
                        {
                            "text": "Engineers inspected the steel <w>tyre</w> of the locomotive for any signs of structural fatigue or cracking.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели стальной <w>бандаж</w> локомотива на наличие признаков усталости металла или трещин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iron tyre",
                        "steel tyre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический обод или внешнее покрытие колеса, обычно встречающееся на железнодорожных вагонах, локомотивах или старых конных повозках."
                    },
                    "translations": {
