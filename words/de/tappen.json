            "senses": [
                {
                    "sense_id": "d8a9db99-0858-3ce0-8a75-6e193f3b2b5e",
                    "sense_definition": "sich unsicher, tastend oder mit leisen Schritten vorwärtsbewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ohne Licht <w>tappte</w> er vorsichtig durch den langen, dunklen Flur."
                        },
                        {
                            "text": "Nachts <w>tappt</w> sie barfuß und ohne Licht in die Küche, um die anderen nicht zu wecken."
                        }
                    ],
                    "synonyms": [
                        "tasten",
                        "schleichen",
                        "stapfen"
                    ],
                    "common_phrases": [
                        "im Dunkeln tappen",
                        "in die Falle tappen"
                    ]
                },
                {
                    "sense_id": "860147fe-35e6-3d45-923e-c2183b9e194e",
                    "sense_definition": "unsicher oder suchend mit den Händen nach etwas greifen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "greifen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Müde und schlaftrunken <w>tappte</w> sie am frühen Morgen nach ihrem Wecker auf dem Nachttisch."
                        },
                        {
                            "text": "Er streckte die Hand aus und <w>tappte</w> im finsteren Raum nach dem Lichtschalter."
                        }
                    ],
                    "synonyms": [
                        "fühlen",
                        "tasten"
                    ],
                    "common_phrases": [
                        "nach dem Lichtschalter tappen"
                    ]
                },
                {
                    "sense_id": "8c9aaf20-51f5-32e8-9ced-b8a71f3cb61f",
                    "sense_definition": "mit den Füßen dumpfe, hörbare Geräusche beim Auftreten erzeugen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kinder <w>tappten</w> barfuß über die knarrenden Dielen des alten Hauses."
                        },
                        {
                            "text": "Die Seeleute sangen laut und <w>tappten</w> mit den Füßen rhythmisch auf die Planken des Decks."
                        }
                    ],
                    "synonyms": [
                        "stampfen",
                        "trappeln"
                    ]
                }
            ]
        },
