{
    "word_family": [
        "deject",
        "dejected",
        "dejectedly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df24a7b8-59ca-3406-8593-14101c0e05d3",
                    "sense_definition": "A state of deep sadness, gloom, or low spirits.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat in deep <w>dejection</w> after hearing the disappointing news about his job application.",
                            "target_lang_translations": {
                                "ru": "Он сидел в глубоком <w>унынии</w>, услышав неутешительные новости по поводу своего заявления на работу.",
                                "es": "Se quedó sentado en un profundo <w>abatimiento</w> tras escuchar las decepcionantes noticias sobre su solicitud de empleo."
                            }
                        },
                        {
                            "text": "There was a clear look of <w>dejection</w> on her face when she realized she had lost the match.",
                            "target_lang_translations": {
                                "ru": "На её лице читалась явная <w>подавленность</w>, когда она поняла, что проиграла матч.",
                                "es": "Había una clara mirada de <w>desánimo</w> en su rostro cuando se dio cuenta de que había perdido el partido."
                            }
                        }
                    ],
                    "synonyms": [
                        "despondency",
                        "depression",
                        "melancholy",
                        "sadness",
                        "gloom",
                        "unhappiness",
                        "misery",
                        "woe",
                        "sorrow",
                        "downheartedness"
                    ],
                    "antonyms": [
                        "happiness",
                        "joy",
                        "elation",
                        "cheerfulness",
                        "delight"
                    ],
                    "common_phrases": [
                        "deep dejection",
                        "utter dejection",
                        "state of dejection",
                        "sigh of dejection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние глубокой печали, мрачности или упадка духа.",
                        "es": "Estado de profunda tristeza, desánimo o decaimiento moral."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "состояние безнадёжной печали, гнетущая скука"
                            },
                            {
                                "target_lang_word": "подавленность",
                                "target_lang_sense_clarification": "угнетённое, мрачное настроение"
                            },
                            {
                                "target_lang_word": "удручение",
                                "target_lang_sense_clarification": "крайне огорчённое, угнетённое состояние"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "abatimiento",
                                "target_lang_sense_clarification": "decaimiento físico o moral profundo"
                            },
                            {
                                "target_lang_word": "desaliento",
                                "target_lang_sense_clarification": "falta de ánimo o pérdida de esperanza"
                            },
                            {
                                "target_lang_word": "desánimo",
                                "target_lang_sense_clarification": "falta de entusiasmo o voluntad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                    "sense_definition": "The discharge of feces from the body, or the feces itself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physiology_waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor monitored the patient's <w>dejections</w> closely for any signs of internal bleeding.",
                            "target_lang_translations": {
                                "ru": "Врач внимательно следил за <w>испражнениями</w> пациента на предмет признаков внутреннего кровотечения.",
                                "es": "El médico vigiló de cerca las <w>deyecciones</w> del paciente en busca de cualquier signo de sangrado interno."
                            }
                        },
                        {
                            "text": "Severe illness caused the child to suffer from frequent and watery <w>dejections</w>.",
                            "target_lang_translations": {
                                "ru": "Тяжёлая болезнь вызывала у ребёнка частые и жидкие <w>испражнения</w>.",
                                "es": "Una grave enfermedad hizo que el niño sufriera <w>deyecciones</w> frecuentes y acuosas."
                            }
                        }
                    ],
                    "synonyms": [
                        "defecation",
                        "feces",
                        "excrement",
                        "stool",
                        "bowel movement",
                        "ordure"
                    ],
                    "common_phrases": [
                        "frequent dejections",
                        "copious dejections"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English typically uses 'stools' or 'feces'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделение кала из организма или сам кал (медицинский или устаревший термин).",
                        "es": "Expulsión de excrementos del cuerpo, o las heces mismas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испражнение",
                                "target_lang_sense_clarification": "выделение экскрементов или сами экскременты"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deyección",
                                "target_lang_sense_clarification": "evacuación o excremento, término médico o formal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebda68d7-5357-3a06-852b-6f5d2152a5da",
                    "sense_definition": "The act of humbling oneself or submitting to authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior_submission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servant bowed in <w>dejection</w> before the king to show his total obedience.",
                            "target_lang_translations": {
                                "ru": "Слуга поклонился в <w>уничижении</w> перед королём, чтобы показать своё полное повиновение.",
                                "es": "El sirviente se inclinó con <w>sumisión</w> ante el rey para mostrar su total obediencia."
                            }
                        },
                        {
                            "text": "True worship in that culture implied a spirit of <w>dejection</w> and humility.",
                            "target_lang_translations": {
                                "ru": "Истинное поклонение в той культуре подразумевало дух <w>уничижения</w> и смирения.",
                                "es": "La verdadera adoración en esa cultura implicaba un espíritu de <w>humillación</w> y humildad."
                            }
                        }
                    ],
                    "synonyms": [
                        "abasement",
                        "humiliation",
                        "submission"
                    ],
                    "antonyms": [
                        "pride",
                        "arrogance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт самоуничижения или подчинения власти (устаревшее).",
                        "es": "Acto de humillarse o someterse a una autoridad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уничижение",
                                "target_lang_sense_clarification": "умаление своего достоинства, смирение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "humillación",
                                "target_lang_sense_clarification": "acto de rebajarse o someterse"
                            },
                            {
                                "target_lang_word": "sumisión",
                                "target_lang_sense_clarification": "acatamiento total a una autoridad"
                            },
                            {
                                "target_lang_word": "envilecimiento",
                                "target_lang_sense_clarification": "degradación o rebajamiento moral"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}