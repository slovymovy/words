                },
                {
                    "sense_id": "0ae43203-3b16-366f-a00b-c8976543aad3",
                    "sense_definition": "een bak specifiek bedoeld voor papierafval of kleine prullen binnenshuis",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "afvalbeheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn kleine <w>prullenbakje</w> zit alweer helemaal vol met oude bonnetjes.",
                            "target_lang_translations": {
