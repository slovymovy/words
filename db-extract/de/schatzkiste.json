                ],
                "senses": [
                    {
                        "sense_id": "99de234b-7559-3d12-9ff9-159bae9565f8",
                        "entry_id": "def70164-0c46-3043-a392-c3dfaa04f690",
                        "glosses": [
                            "massiver, verborgener Behälter aus Holz, in welchem Gegenstände aus Edelmetallen und Edelsteinen versteckt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6b693b-7a6d-4a10-a989-e27ea95cd2f6",
                                "sense_id": "99de234b-7559-3d12-9ff9-159bae9565f8",
                                "text": "„Mancher wusste von einem riesigen, gefährlichen Hund zu berichten, der Tag und Nacht über eine tief unter dem Schutt vergrabene Schatzkiste wache.“"
                            },
                            {
                                "example_id": "902a856f-7a23-473f-bdb3-58065ac7e60a",
                                "sense_id": "99de234b-7559-3d12-9ff9-159bae9565f8",
                                "text": "„Er saß nun da, die gefesselten Hände im Schoß und mit gesenktem Kopf, und starrte mit scharfen, funkelnden Augen auf die Schatzkiste, die Ursache seiner Übeltaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad8b5a4c-c186-4004-956a-46339355c58e",
                        "source_entry_id": "def70164-0c46-3043-a392-c3dfaa04f690",
                        "source_sense_id": "99de234b-7559-3d12-9ff9-159bae9565f8",
                        "target_lang_word": "treasure chest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treasure chest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f2f33f-789c-32f9-9b2b-2dcea636c4c5",
                                        "entry_id": "45b9bc37-d12e-3486-a733-9af6f2142c6a",
                                        "glosses": [
                                            "A chest filled with treasure, especially one used by pirates, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c446187-c3de-34f9-8fc2-070aae60d833",
                                        "entry_id": "45b9bc37-d12e-3486-a733-9af6f2142c6a",
                                        "glosses": [
                                            "A treasury, especially a state or royal treasury."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d82296c-1b8c-4b74-8584-c21a168e155d",
                                                "sense_id": "3c446187-c3de-34f9-8fc2-070aae60d833",
                                                "text": "They acted the part of a sponge for the Royal Treasury, they gathered up all the floating money of the country, to be squeezed from time to time into the king’s treasure-chest […]"
                                            },
                                            {
                                                "example_id": "b56ee8df-acc3-4ef3-861f-48a8136911bd",
                                                "sense_id": "3c446187-c3de-34f9-8fc2-070aae60d833",
                                                "text": "The visitors pour upward of $60,000 into the state’s treasure chest."
                                            },
                                            {
                                                "example_id": "3fa13552-98f8-48b0-a189-64626cf7d316",
                                                "sense_id": "3c446187-c3de-34f9-8fc2-070aae60d833",
                                                "text": "When Anglo-Saxon coins left England for Scandinavia they could, hypothetically, have been withdrawn from a royal treasure-chest replenished from tolls and taxes collected nationwide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe5c499-2608-3f92-b275-64298169f776",
                                        "entry_id": "45b9bc37-d12e-3486-a733-9af6f2142c6a",
                                        "glosses": [
                                            "Any source of something valuable or beautiful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2937e8b6-cee4-47e6-81ce-fea5f6ce4444",
                                                "sense_id": "dbe5c499-2608-3f92-b275-64298169f776",
                                                "text": "a treasure chest of poems"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
