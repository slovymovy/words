                    {
                        "sense_id": "4c0ce083-0c26-3c94-811d-913b4f8cbc92",
                        "entry_id": "94657f70-998a-3d6e-9dd9-c620040845aa",
                        "glosses": [
                            "kleine Schleuder, bestehend aus einer (Ast-)Gabel und spannbaren Riemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c408803-38a8-4f6a-b124-cfdc03997e2a",
                                "sense_id": "4c0ce083-0c26-3c94-811d-913b4f8cbc92",
                                "text": "„Sie warten dort unter Sonnenschirmen des Rotary Clubs auf die Gegner, die vorige Woche mit Zwillen und Speeren in ihren roten Hemden aus der Provinz anreisten.“"
                            },
                            {
                                "example_id": "b9592115-bff8-4f9f-a5ea-21d8b1973cb7",
                                "sense_id": "4c0ce083-0c26-3c94-811d-913b4f8cbc92",
                                "text": "„Die Spieler schießen nun die Vögel mit einer gigantischen Zwille auf die Schweine und deren Verstecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
