{
    "word_family": [
        "parasitic",
        "parasitism",
        "parasitize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f81338ab-c42e-3ddb-93b2-91b175e0eac9",
                    "sense_definition": "An organism that lives on or inside another organism of a different species, benefiting at the host's expense.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "biological_organism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ticks and fleas are common <w>parasites</w> that feed on the blood of animals."
                        },
                        {
                            "text": "The <w>parasite</w> lives inside the host and slowly drains its energy."
                        }
                    ],
                    "antonyms": [
                        "commensal",
                        "mutualist"
                    ],
                    "common_phrases": [
                        "internal parasite",
                        "external parasite"
                    ]
                },
                {
                    "sense_id": "4e6c9de8-7a95-3095-9af9-161642b5d316",
                    "sense_definition": "A person who relies on others for support or money without contributing anything in return.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a total <w>parasite</w> who refuses to get a job and lives off his parents."
                        },
                        {
                            "text": "The community grew tired of supporting the <w>parasite</w> who never helped with any chores."
                        }
                    ],
                    "synonyms": [
                        "freeloader",
                        "leech",
                        "moocher",
                        "sponger"
                    ],
                    "common_phrases": [
                        "social parasite"
                    ]
                },
                {
                    "sense_id": "b36f250a-16cc-3b67-b9fe-9b4c7370a43c",
                    "sense_definition": "A person who acts in an overly flattering way to gain favor or advantage from someone powerful.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy politician was constantly surrounded by <w>parasites</w> hoping for a promotion."
                        },
                        {
                            "text": "He acted like a <w>parasite</w> to the boss, always agreeing with every word spoken."
                        }
                    ],
                    "synonyms": [
                        "sucker"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1566e1b-c7e7-3014-abeb-d1803e40af76",
                    "sense_definition": "To live off another person or entity as a parasite.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been <w>parasiting</w> off his brother's success for years without showing any gratitude."
                        },
                        {
                            "text": "It is unfair to <w>parasite</w> on the hard work of others while contributing nothing yourself."
                        }
                    ],
                    "synonyms": [
                        "mooch",
                        "sponge"
                    ]
                }
            ]
        }
    ]
}