                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umwinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad13f0f3-453f-3f9b-b61e-7e0c93199371",
                                        "entry_id": "10d2c0fd-7d44-336c-9582-435180f5d6ef",
                                        "glosses": [
                                            "um den Körper legen/schlingen (winden)"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb3a91b-9086-4fe3-aa2a-69505afe1ca5",
                                                "sense_id": "ad13f0f3-453f-3f9b-b61e-7e0c93199371",
                                                "text": "„O edle Ritter, hört mein Flehen, Legt ab die Scherpen, die Ihr umgewunden.“ (1831)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "umwinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3782ab-6c1d-39a1-9826-d6a02e1afdb6",
                                        "entry_id": "8f4f88d0-bd71-3c32-a798-3a1b0a8ee2b7",
                                        "glosses": [
                                            "etwas um etwas herumwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44a2e09e-dd81-4f2e-a16f-ff266a4453bf",
                                                "sense_id": "3e3782ab-6c1d-39a1-9826-d6a02e1afdb6",
                                                "text": "„Er dürfe aber nicht vergessen, seine eigene Hand mit einem Tuch zu umwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2f153d8-8912-3170-810a-9148273f38d4",
                                        "entry_id": "8f4f88d0-bd71-3c32-a798-3a1b0a8ee2b7",
                                        "glosses": [
                                            "etwas (zum Beispiel eine Pflanze) wickelt sich von alleine um etwas herum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "973a0f23-2f7a-4220-b8ee-e3a302a17a8e",
                                                "sense_id": "a2f153d8-8912-3170-810a-9148273f38d4",
                                                "text": "„Eine weisse Ranke umwindet den gelben Stamm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d465175-a640-415e-8be9-93198541836d",
                        "source_entry_id": "8fdcf376-00a8-39b0-8da0-3acd46d76042",
                        "source_sense_id": "6462bc1b-4bf9-3fed-8e1e-524e2d17b77f",
