                                "target_senses": [
                                    {
                                        "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                        "entry_id": "7948362c-85ff-3569-9989-1475077c426c",
                                        "glosses": [
                                            "Personne habilitée à agir pour autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c93645e8-416e-43ee-bef2-1cdac281eac2",
                                                "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                                "text": "Le comte des Essarts , parti de Versailles le 9 Février, pour se rendre à sa terre des Essarts, ayant trouvé que la route de traverse de Damville aux Essarts étoit impraticable & dangereuse par la surabondance des neiges, se vit forcé de rester plusieurs jours à Damville chez le procureur fiscal."
                                            },
                                            {
                                                "example_id": "4a2c492a-c4ed-4454-b291-b7ef1aa89ed0",
                                                "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                                "text": "Agir par procureur."
                                            },
                                            {
                                                "example_id": "9595d9a5-06f7-4014-8d65-69fb93271e7e",
                                                "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                                "text": "Le roi seul plaidait par procureur."
                                            },
                                            {
                                                "example_id": "5ee0fe12-bcdf-440c-a374-057c63b58b09",
                                                "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                                "text": "Les princes se marient ordinairement par procureur."
                                            },
                                            {
                                                "example_id": "e9b3df08-b79b-48e2-9993-0f6a387c0b39",
                                                "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                                "text": "Le moins qu’on peut faire par procureur, c’est le mieux."
                                            },
                                            {
                                                "example_id": "c7b2c5f9-36a3-4fc0-b02f-ab575b0759b0",
                                                "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                                                "text": "Il l’a nommé son procureur général et spécial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                        "entry_id": "7948362c-85ff-3569-9989-1475077c426c",
                                        "glosses": [
                                            "Officier établi pour agir en justice au nom de ceux qui plaident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65a7fa4-b148-477c-8d64-f3bbae275fb7",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Étude de procureur."
                                            },
                                            {
                                                "example_id": "6b9a6c76-e295-4527-8a61-b7080ddf9efe",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "La qualification de procureur a été remplacée par celle d’avoué."
                                            },
                                            {
                                                "example_id": "82af5bce-77fa-4bc4-a6c4-979230d13ea2",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Un procureur au parlement."
                                            },
                                            {
                                                "example_id": "ed1fd0d1-cf0f-4e66-89db-a18cb9db196b",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Un procureur au Châtelet."
                                            },
                                            {
                                                "example_id": "9d78c3e3-9312-456e-a307-635da71cf95b",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Constituer un procureur."
                                            },
                                            {
                                                "example_id": "472cf332-b411-4a16-9d15-cec284ff6a3c",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Constituer procureur."
                                            },
                                            {
                                                "example_id": "f9778241-0103-455a-ae03-f20fbdf1b5cb",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Clerc de procureur."
                                            },
                                            {
                                                "example_id": "92f35b90-1027-40ec-817a-651bf69df1bd",
                                                "sense_id": "9cc7265a-dfed-309d-9c6d-f1ff59d53f48",
                                                "text": "Même si la pratique est courante, on reste toujours étonné d’apprendre que les représentants du ministère public et les procureurs de criminels endurcis négocient pour échanger des aveux de culpabilité contre des accusations réduites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                                        "entry_id": "7948362c-85ff-3569-9989-1475077c426c",
                                        "glosses": [
                                            "Avocat représentant le ministère public."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6aee011-19a8-4a20-ae4e-adc16fcc93e6",
                                                "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                                                "text": "Khairullozhon Matanov […] est accusé d’avoir voulu cacher aux enquêteurs qu’il était ami avec Tamerlan Tsarnaev […], a indiqué dans un communiqué la procureuse fédérale du Massachusetts, Carmen Ortiz."
                                            },
                                            {
                                                "example_id": "71684e41-1235-44b8-91c3-2079c44f58e1",
                                                "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                                                "text": "Jusqu'ici, les demandes de la procureure sont restées sans réponse."
                                            },
                                            {
                                                "example_id": "bdb92439-6d01-4b3f-8f7a-d70364f34e8b",
                                                "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                                                "text": "Le procureur, représentant du ministère public, agit au nom de la société et soutient l’accusation au cours de la procédure. Il saisit le juge d’instruction, celui-ci ne pouvant prendre seul l’initiative."
                                            },
                                            {
                                                "example_id": "6f1fecc6-e684-4edb-801d-bb07b11db028",
                                                "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                                                "text": "[…], il m'a fallu impérativement faire une évaluation personnelle, compte tenu de l'étrangeté de la procédure suivie : le procureur de la République en personne vient me voir dans mon bureau - ce qui est déjà une démarche assez atypique - pour me transmettre des éléments non sourcés alors qu'il ne doit transmettre que des éléments sourcés…"
                                            },
                                            {
                                                "example_id": "f9fe8105-609a-49a1-94ea-0b4d2574e04e",
                                                "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                                                "text": "Un adolescent de 14 ans a […] agressé une procureur. Le jeune homme assistait au procès de son père qui comparaissait pour violences conjugales. Au moment des réquisitions, il a sauté à la gorge de la représentante du ministère public…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11bf5c61-cb6c-3b89-afdd-0e2ef452e4a2",
                                        "entry_id": "7948362c-85ff-3569-9989-1475077c426c",
                                        "glosses": [
                                            "Religieux chargé des intérêts temporels d’une maison religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d411b54-b916-4489-9994-9587db1b0efe",
                                                "sense_id": "11bf5c61-cb6c-3b89-afdd-0e2ef452e4a2",
                                                "text": "Le procureur, le père procureur des chartreux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b43ee26-8692-40c4-afb7-a06a248b777b",
                        "source_entry_id": "9ebaf80f-8d05-377d-8061-6a7c73a01ccb",
                        "source_sense_id": "4fb3d6ad-dd38-39ca-a034-b1d97d31dc2c",
                        "source_sense_description": "bevollmächtigte Vertreterin einer öffentlich-rechtlichen Einrichtung oder auch eines Klosters",
                        "target_lang_word": "procureure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procureure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "033fdd21-6c2a-3519-9510-5e32787018b2",
                                        "entry_id": "b582fe2f-54d6-387d-a1e0-746d94dc9cb3",
                                        "glosses": [
                                            "Avocate représentant le ministère public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13ae010-83b9-4066-a4af-577eee1bac05",
                                                "sense_id": "033fdd21-6c2a-3519-9510-5e32787018b2",
                                                "text": "Le nombre de plaintes pour violences sexuelles déposées à Paris a augmenté de 30 % par rapport à 2021, d’après la procureure de la République de Paris, Laure Beccuau."
                                            },
                                            {
                                                "example_id": "27861fdf-2090-4155-87a2-5fa966daabe6",
                                                "sense_id": "033fdd21-6c2a-3519-9510-5e32787018b2",
                                                "text": "Dans une déclaration à la presse ce jeudi soir, la procureure de la République de Besançon a critiqué la « folie médiatique », appelant à respecter la présomption d’innocence."
                                            },
                                            {
                                                "example_id": "be2f9948-635b-4377-bc31-a20409b313ba",
                                                "sense_id": "033fdd21-6c2a-3519-9510-5e32787018b2",
                                                "text": "Soucieuse de justifier un tel déploiement de forces, la procureure de la République, un brin gênée, s’est expliquée le lendemain face à la presse : « On peut supposer qu’il y avait une arme, car la personne a prétendu en avoir une. Seulement, personne ne l’a vue. »"
                                            },
                                            {
                                                "example_id": "7692b9b6-ef50-438e-9e81-1d89118c3397",
                                                "sense_id": "033fdd21-6c2a-3519-9510-5e32787018b2",
                                                "text": "La procureure a souligné que les deux derniers cas étaient liés à « de la contamination secondaire, par les mains. C’est-à-dire qu’une personne contaminée a dû (…) sortir des toilettes sans bien se laver les mains, et tenir les mains d’une autre personne qui du coup va être contaminée »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94ccecb3-1bf0-4dd9-b978-fd95b50bb870",
                        "source_entry_id": "9ebaf80f-8d05-377d-8061-6a7c73a01ccb",
