                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bec-en-ciseaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3cbedec-9421-3e4e-9f1d-5dae7cbdb5b2",
                                        "entry_id": "aa9cc496-ada6-3312-8675-0bcb44743585",
                                        "glosses": [
                                            "Oiseau aquatique de taille moyenne du genre Rhynchops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e26c91-4afb-4804-b258-ef718c39d27d",
                                                "sense_id": "e3cbedec-9421-3e4e-9f1d-5dae7cbdb5b2",
                                                "text": "Le bec-en-ciseaux est un oiseau aquatique caractérisé par son bec dont les mandibules se croisent et son vol rapide au ras de la surface de l’eau."
                                            },
                                            {
                                                "example_id": "44b668cc-233c-4e1c-9bd9-949b623eb0ee",
                                                "sense_id": "e3cbedec-9421-3e4e-9f1d-5dae7cbdb5b2",
                                                "text": "De loin on pourrait croire assister à une scène anodine sur une plage de Floride. Celle d’un bec-en-ciseaux noir qui nourrit son petit."
                                            },
                                            {
                                                "example_id": "89283b7d-883b-4176-8baa-550bdc7ec0d5",
                                                "sense_id": "e3cbedec-9421-3e4e-9f1d-5dae7cbdb5b2",
                                                "text": "Loin d’être un handicap, cette adaptation permet aux becs-en-ciseaux, présents dans toutes les régions subtropicales, de pêcher de manière unique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
