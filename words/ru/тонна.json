            "senses": [
                {
                    "sense_id": "34c6f7bf-3966-38e4-b801-9ffb0efc6613",
                    "sense_definition": "Единица измерения массы, равная одной тысяче килограммов",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот грузовик может перевозить до пяти <w>тонн</w> различных грузов.",
                            "target_lang_translations": {
                                "fr": "Ce camion peut transporter jusqu'à cinq <w>tonnes</w> de marchandises diverses."
                            }
                        },
                        {
                            "text": "Кубический метр чистой воды весит ровно одну <w>тонну</w>.",
                            "target_lang_translations": {
                                "fr": "Un mètre cube d'eau pure pèse exactement une <w>tonne</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "мегаграмм"
                    ],
                    "common_phrases": [
                        "метрическая тонна",
                        "тонна груза"
                    ],
                    "target_lang_definitions": {
                        "fr": "Unité de mesure de masse équivalant à mille kilogrammes"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tonne",
                                "target_lang_sense_clarification": "unité de masse (1 000 kg)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06daa075-3a49-316a-8b75-d56080e8fea8",
                    "sense_definition": "Очень большое, огромное количество чего-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед экзаменами студентам приходится читать <w>тонны</w> сложной литературы.",
                            "target_lang_translations": {
                                "fr": "Avant les examens, les étudiants doivent lire des <w>tonnes</w> d'ouvrages complexes."
                            }
                        },
                        {
                            "text": "У меня сегодня просто <w>тонна</w> работы, поэтому я не смогу пойти на прогулку.",
                            "target_lang_translations": {
                                "fr": "J'ai tout simplement une <w>tonne</w> de travail aujourd'hui, donc je ne pourrai pas aller me promener."
                            }
                        }
                    ],
                    "synonyms": [
                        "гора́",
                        "ку́ча",
                        "ма́сса",
                        "мно́жество",
                        "у́йма"
                    ],
                    "common_phrases": [
                        "тонна работы",
                        "тонна свободного времени"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Très grande quantité de quelque chose"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tonne",
                                "target_lang_sense_clarification": "quantité énorme, au sens figuré"
                            },
                            {
                                "target_lang_word": "tas",
                                "target_lang_sense_clarification": "grande quantité (familier)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "028a643c-34ad-39aa-8902-f07c2543fd3b",
                    "sense_definition": "Тысяча каких-либо единиц, чаще всего денег",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За старый подержанный автомобиль он попросил всего одну <w>тонну</w> долларов.",
                            "target_lang_translations": {
                                "fr": "Pour sa vieille voiture d'occasion, il n'a demandé qu'un <w>mille</w> dollars."
                            }
                        },
                        {
                            "text": "Откуда у простого студента нашлась целая <w>тонна</w> баксов на покупку техники?",
                            "target_lang_translations": {
                                "fr": "Où un simple étudiant a-t-il bien pu trouver mille <w>balles</w> pour acheter du matériel ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "штука"
                    ],
                    "common_phrases": [
                        "тонна баксов"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное обозначение тысячи"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Mille unités de quelque chose, le plus souvent d'argent"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "mille",
                                "target_lang_sense_clarification": "somme de mille unités (familier)"
                            },
                            {
                                "target_lang_word": "bâton",
                                "target_lang_sense_clarification": "argot pour une somme d'argent"
                            }
                        ]
                    }
                }
            ]
