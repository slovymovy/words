                                        "glosses": [
                                            "A person from Peru or of Peruvian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37114bfa-c8da-41ba-9b94-ebdc3f3f7b45",
                                                "sense_id": "76b401e1-8cb8-3a28-99d9-4df74a8e0391",
                                                "text": "After a raucous two weeks of power plays at the highest levels of government that saw three different men pass through Peru’s presidency, thousands of young Peruvians have reinvigorated protest and politics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Peruvian",
                                "target_lang_code": "en",
                                "target_senses": [
