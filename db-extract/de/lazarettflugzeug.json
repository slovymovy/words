                    {
                        "sense_id": "f8f2a2a2-2811-3561-a9eb-12ce80ea21db",
                        "entry_id": "9b957031-bb1a-37a4-abe1-118e4feaf6eb",
                        "glosses": [
                            "speziell eingerichtetes Flugzeug für den Transport von Verwundeten, ausgestattet mit medizinischem Personal und Gerät für die Versorgung während des Flugs"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "de328a4b-c3ab-4244-8e06-3903a0064134",
                                "sense_id": "f8f2a2a2-2811-3561-a9eb-12ce80ea21db",
                                "text": "„Inzwischen hat der Regierungschef wegen der Überforderung der überfüllten Krankenhäuser ein Lazarettflugzeug und ein Transportflugzeug der Luftwaffe nach Bali geschickt, um die australischen Schwerverwundeten zu behandeln und – falls erforderlich – nach Australien auszufliegen.“"
                            },
                            {
                                "example_id": "612cc696-665d-45d8-b83b-d28d3ab26227",
                                "sense_id": "f8f2a2a2-2811-3561-a9eb-12ce80ea21db",
                                "text": "„Der Medevac-Airbus der Bundeswehr ist das beste Lazarettflugzeug der Welt.“"
                            }
                        ],
