        "fr-extract.jsonl": [
            {
                "entry_id": "5048817b-e451-371b-8d7c-4762b5ed755c",
                "word": "Dulcinée",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65e12665-a0f0-3649-b064-7cf6380e40fa",
                        "entry_id": "5048817b-e451-371b-8d7c-4762b5ed755c",
                        "glosses": [
                            "Personnage féminin du Don Quichotte de Miguel de Cervantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a24d5bb-0a80-467c-86bc-9fc169a2b16d",
                                "sense_id": "65e12665-a0f0-3649-b064-7cf6380e40fa",
                                "text": "Mais à cette impossibilité s’en ajoute une plus grande : c’est la foi que j’ai promise et donnée à la sans pareille Dulcinée du Toboso, unique dame de mes plus secrètes pensées."
                            },
                            {
                                "example_id": "73d69952-bc52-4a84-abd0-ce05695bf90e",
                                "sense_id": "65e12665-a0f0-3649-b064-7cf6380e40fa",
                                "text": "Quelle pitié de quitter Virgile et Racine pour les feuilles volantes de nos jours ! Don Quichotte fit une infidélité d’un moment à Dulcinée pour Maritorne. Adieu, adieu ; quand je songe aux infidélités, je suis si honteux que je me tais."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a6b8b8c1-e0c1-34b5-8ce1-d6c2b4af2dd3",
                "word": "dulcinée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0626bf35-c6c1-45cb-95d4-9c916a9dd191",
                        "entry_id": "a6b8b8c1-e0c1-34b5-8ce1-d6c2b4af2dd3",
                        "tags": [
                            "plural"
                        ],
                        "form": "dulcinées"
                    },
                    {
                        "form_id": "92e75b59-9103-41f5-a22e-010ed68ca0cc",
                        "entry_id": "a6b8b8c1-e0c1-34b5-8ce1-d6c2b4af2dd3",
                        "tags": [],
                        "form": "Dulcinée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "286838d9-0b78-3eac-aa58-1b71ff80916d",
                        "entry_id": "a6b8b8c1-e0c1-34b5-8ce1-d6c2b4af2dd3",
                        "glosses": [
                            "Femme inspirant une passion romanesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a301219f-1672-43a2-868c-284a12815a6e",
                                "sense_id": "286838d9-0b78-3eac-aa58-1b71ff80916d",
                                "text": "Il était aux pieds de sa dulcinée."
                            },
                            {
                                "example_id": "fc107795-12e0-4eb5-918e-60e1cb48e1b3",
                                "sense_id": "286838d9-0b78-3eac-aa58-1b71ff80916d",
                                "text": "Je crois qu'il n'y a pas de plus beau cadeau à offrir à sa dulcinée que de s'être préservé pour celle avec qui on voudrait vivre sa vie."
                            },
                            {
                                "example_id": "f7aa1eed-a191-4aae-a9c0-a1710f705321",
                                "sense_id": "286838d9-0b78-3eac-aa58-1b71ff80916d",
                                "text": "Comme on admirait son esprit, on le traitait avec les plus grands ménagements « ainsi qu’un collégien qui se trompe de porte dans un hôtel », me disait une de ses illusoires dulcinées."
                            },
                            {
                                "example_id": "1b424108-70f2-428c-861a-1fec44b03fe4",
                                "sense_id": "286838d9-0b78-3eac-aa58-1b71ff80916d",
                                "text": "Après avoir trait les vaches et avoir soupé, il allait s'asseoir sur une poutre qu'il avait roulée près du bâtiment et il attendait sa dulcinée."
                            },
                            {
                                "example_id": "42b0c739-0573-4377-b5f6-d509ad0c9a2e",
                                "sense_id": "286838d9-0b78-3eac-aa58-1b71ff80916d",
                                "text": "Soudainement, monsieur, qui jusque-là n’adressait la parole à bobonne que pour lui demander d’aller lui chercher une bière dans le frigo, se vide un flacon d’Aqua Velva derrière les oreilles, achète des fleurs de dépanneur à sa dulcinée et l’amène manger chez Da Giovanni."
                            }
                        ]
                    }
                ],
