                                "target_senses": [
                                    {
                                        "sense_id": "d1f3a69d-aff7-3f02-9f9a-b1fa0c9c48a8",
                                        "entry_id": "dc5e2848-59d6-3314-b210-42d57668c77a",
                                        "glosses": [
                                            "zonder hoed of ander kledingstuk dat het hoofd bedekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421e5c01-7b0d-454b-a2e2-31e950c3aeb9",
                                                "sense_id": "d1f3a69d-aff7-3f02-9f9a-b1fa0c9c48a8",
                                                "text": "Maria deed haar hoofddoek af, waste zich en blootshoofds, de mouwen van haar hemd opgerold tot aan haar ellebogen, maakte ze koffie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49dc2a9c-6a58-4427-86b3-29231f48a11a",
                        "source_entry_id": "3e841eed-fd90-3e4f-861d-683fb85e5f3e",
                        "source_sense_id": "38ee0ab2-4487-32c5-a3c6-a7ba462aafd7",
                        "source_sense_description": "having no covering on the head",
                        "target_lang_word": "nu-tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nu-tête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3622a975-2f1f-3757-97b7-bb687bd2cef1",
                                        "entry_id": "e1ecf673-ff3b-3230-99ea-24cfceefe1c5",
                                        "glosses": [
                                            "Sans couvre-chef, découvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9465569-0471-4a31-ad08-3b620527179c",
                                                "sense_id": "3622a975-2f1f-3757-97b7-bb687bd2cef1",
                                                "text": "Oui, monsieur, tout homme qui ne rend pas un coup de chapeau est un manant… à moins qu’il ne soit nu-tête."
                                            },
                                            {
                                                "example_id": "6c0814c5-6070-428d-9a09-5e067473fcbc",
                                                "sense_id": "3622a975-2f1f-3757-97b7-bb687bd2cef1",
                                                "text": "Bien que Paul eut une tête de plus que sa mère, elle le traitait toujours comme un marmot, lui demandant encore: « Tu n'as pas froid aux pieds, Poulet? » et, quand il se promenait devant le perron, après déjeuner, en fumant une cigarette, elle ouvrait la fenêtre pour lui crier: « Ne sors pas nu-tête, je t'en supplie, tu vas attraper un rhume de cerveau. »"
                                            },
                                            {
                                                "example_id": "9d4fc911-c0bc-4d17-8dbd-0213265eb187",
                                                "sense_id": "3622a975-2f1f-3757-97b7-bb687bd2cef1",
                                                "text": "– Mais vous n'avez pas froid, nu-tête comme cela ? – Ah ! je serai pas nu-tête, j'aurai mon polo, et je pourrais m'en passer avec tous mes cheveux. »"
                                            },
                                            {
                                                "example_id": "06c61100-41e1-4dbd-899d-c03a0f61b2a8",
                                                "sense_id": "3622a975-2f1f-3757-97b7-bb687bd2cef1",
                                                "text": "Être, aller nu-tête"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5356bca0-1b17-4b31-94aa-f5be645b1383",
                        "source_entry_id": "3e841eed-fd90-3e4f-861d-683fb85e5f3e",
                        "source_sense_id": "38ee0ab2-4487-32c5-a3c6-a7ba462aafd7",
                        "source_sense_description": "having no covering on the head",
                        "target_lang_word": "barhäuptig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barhäuptig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59beec04-0858-3e03-811d-6bcb9f01a61c",
                                        "entry_id": "5638ecbc-a3a0-39d9-96ab-b366285ff7d2",
                                        "glosses": [
                                            "ohne Kopfbedeckung, baren Hauptes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fff67a0-d15e-46a4-b026-6c78e8710ecc",
                                                "sense_id": "59beec04-0858-3e03-811d-6bcb9f01a61c",
                                                "text": "Er lief barhäuptig im Regen."
                                            },
                                            {
                                                "example_id": "6fccba4a-0d32-4b99-8082-9daafe20643e",
                                                "sense_id": "59beec04-0858-3e03-811d-6bcb9f01a61c",
                                                "text": "Entschlossen betrat sie das Hutgeschäft, um dem barhäuptigen Zeitalter ein Ende zu bereiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8f070a1-75ed-4c69-9822-7c367930fe2e",
                        "source_entry_id": "3e841eed-fd90-3e4f-861d-683fb85e5f3e",
                        "source_sense_id": "38ee0ab2-4487-32c5-a3c6-a7ba462aafd7",
                        "source_sense_description": "having no covering on the head",
                        "target_lang_word": "barhaupt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barhaupt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                        "entry_id": "a39a79e2-8086-3131-9d0e-9238064a887f",
                                        "glosses": [
                                            "keine Kopfbedeckung (zum Beispiel Hut oder Mütze) tragend, ein unbedecktes Haupt aufweisend"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a27dc1f2-541b-44da-bde7-4530ea09c759",
                                                "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                                "text": "„Er war barhaupt und hatte eine Glatze.“"
                                            },
                                            {
                                                "example_id": "d4587d95-f0c5-456b-bccd-6a22868d87fa",
                                                "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                                "text": "„Das Kind schob einen Teppichkehrer kreuz und quer; die Frau, barhaupt auf der Terrasse, putzte die große Fensterfront mit alten Zeitungen.“"
                                            },
                                            {
                                                "example_id": "2b930fe4-8c65-4bdb-98ce-314b42845f9b",
                                                "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                                "text": "„…; rechts ist Hieronymus als Eremit dargestellt, barhaupt, mit blauem Mantelgewand, zu seinen Füßen sein Attribut, der Löwe; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
