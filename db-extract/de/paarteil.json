                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05fc6bbf-d7e5-4837-b4cb-11921e5a71a3",
                                                "sense_id": "e4d12180-f2a2-338a-99a9-9112a380b0cd",
                                                "text": "Et qu’elle le sache ou non, ou qu’elle soit prête pour cela, pour nous, j’étais son être cher et elle était le mien."
                                            },
                                            {
                                                "example_id": "8b967c9e-b9dd-4d8f-8028-c393591607a9",
                                                "sense_id": "e4d12180-f2a2-338a-99a9-9112a380b0cd",
                                                "text": "Voir son mari, son être cher, son amour être avalé par la terre était inconcevable, inadmissible."
