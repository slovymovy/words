                    {
                        "translation_id": "1223bfcc-50fb-4c68-aabd-310292cf90d6",
                        "source_entry_id": "3ee49c94-5aaa-3897-b645-abf5bed7e610",
                        "source_sense_id": "35e5d765-134f-39d2-ae85-d23f59df2df7",
                        "source_sense_description": "Arzneibuch, Kodex",
                        "target_lang_word": "Kodex",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kodex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0e17d6b-9c87-3a14-8323-ab8ebcf5727c",
                                        "entry_id": "e80bcc82-8287-3e84-8e02-f60c41bf12e2",
                                        "glosses": [
                                            "die Gesamtheit aller in einer Gesellschaft maßgebenden Vorschriften, Normen und Regeln (auch nicht schriftlich fixierte Normen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "080f5b43-7e14-40f7-89b7-eb6af08a4ad0",
                                                "sense_id": "f0e17d6b-9c87-3a14-8323-ab8ebcf5727c",
                                                "text": "„Viele Beschimpfungen folgten einem festgeschriebenen Kodex und waren häufig sogar in eine fixe Syntax eingebunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61a4d688-2a46-3577-8b21-155d5afec3bd",
                                        "entry_id": "e80bcc82-8287-3e84-8e02-f60c41bf12e2",
                                        "glosses": [
                                            "Gesetzessammlung, Gesetzbuch"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5333af0-47ec-47fa-a2ac-6dacc3420fc7",
                                                "sense_id": "61a4d688-2a46-3577-8b21-155d5afec3bd",
                                                "text": "Hammurapi hat eine Gesetzessammlung begründet, die nach ihm benannt ist, den sogenannten \"Codex Hammurapi\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "edbcfcd9-fd41-307d-93b9-2327ea87aa93",
                                        "entry_id": "e80bcc82-8287-3e84-8e02-f60c41bf12e2",
                                        "glosses": [
                                            "mehrere mit Wachs überzogene hölzerne Schreibtäfelchen zur Verwendung als Notizbuch"
                                        ],
                                        "tags": [
                                            "in der Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa4f39f-2773-4a1e-9f98-90e3f3edd455",
                                                "sense_id": "edbcfcd9-fd41-307d-93b9-2327ea87aa93",
                                                "text": "Vorläufer des Kodex sind die so genannten membranae, eine Art Notizbücher, die nur aus wenigen zusammengehefteten Papyrusbögen bestanden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c756a091-cc34-31fe-a691-19eb3547e329",
                                        "entry_id": "e80bcc82-8287-3e84-8e02-f60c41bf12e2",
                                        "glosses": [
                                            "eine Sammlung von Handschriften, die meist zwischen zwei Holzdeckeln zusammengefügt wurden"
                                        ],
                                        "tags": [
                                            "im Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4d61fd-14d0-4065-b88e-0e6e3aa60aeb",
                                                "sense_id": "c756a091-cc34-31fe-a691-19eb3547e329",
                                                "text": "In den Sammlungen der Bibliothek sind Handschriften aufbewahrt, wie der Goldene Kodex von Pultusk (11. Jahrhundert), die Kroniken des Jan Długosz (15. Jahrhundert) und das Pontifikal des Erazm Ciołek (16. Jahrhundert) sowie viele andere."
                                            },
                                            {
                                                "example_id": "d5d5484e-bdc1-4d11-bcdc-2dd2a3e3422c",
                                                "sense_id": "c756a091-cc34-31fe-a691-19eb3547e329",
                                                "text": "„Dieser Kodex aus dem Jahr 1382 wurde Ende des 19. Jahrhunderts zusammen mit hebräischen, aramäischen und judäo-arabischen Texten in einer Genisa im ägyptischen Fustat (heute Kairo) entdeckt.“"
                                            },
                                            {
                                                "example_id": "eb0a729b-6d6d-44bf-b311-2504924e10f6",
                                                "sense_id": "c756a091-cc34-31fe-a691-19eb3547e329",
                                                "text": "„Die kostbar illustrierten Prachtexemplare in zwei Bänden mit 648 und 634 Seiten zu (in der Regel) je 42 Zeilen pro Seite ahmten im Schriftbild noch die mittelalterlichen Handschriften und im Format die mittelalterlichen Kodices nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
