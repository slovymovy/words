                "translations": [
                    {
                        "translation_id": "5c90d281-8ceb-4dc4-b8fd-c8f270702a3c",
                        "source_entry_id": "afee30eb-3299-3865-acf2-3e38fc265cca",
                        "target_lang_word": "disagreement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disagreement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                                        "entry_id": "d9149ee4-5167-3fd7-84c5-45bc5412ef60",
                                        "glosses": [
                                            "An argument or debate."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00eab32-b70c-4b37-a533-ae67805227a8",
                                                "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                                                "text": "They had a bit of a disagreement about what color to paint the bedroom, but they have reached a compromise."
                                            },
                                            {
                                                "example_id": "599b9db2-fd7e-450c-a7a5-1b2430d68c89",
                                                "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                                                "text": "In any event, agreement or disagreement, joke or no joke, in my 28 years on the court I did not hear a voice raised in anger in that conference, nor were snide or personal remarks ever made. The discussion was professional, disagreements reflected legal differences on the merits, and the justices tried to find ways to reach court agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                                        "entry_id": "d9149ee4-5167-3fd7-84c5-45bc5412ef60",
                                        "glosses": [
                                            "A condition of not agreeing or concurring."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac2f4d0-b3f3-4e0d-9608-fd19d88f06c9",
                                                "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                                                "text": "The theory shows considerable disagreement with the data."
                                            },
                                            {
                                                "example_id": "e58f5727-565d-4973-a9bd-422aaedcb038",
                                                "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                                                "text": "The two sides were in disagreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
