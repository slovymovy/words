                "senses": [
                    {
                        "sense_id": "1559a882-7868-3d7f-8113-5f9d48de2d1c",
                        "entry_id": "dcdcd334-e09e-33dc-bb96-631e429ea45e",
                        "glosses": [
                            "Gerät, das mit einem eigenen Fuß frei stehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f01667f-8d60-4069-91b1-d4c5bc1da1d8",
                                "sense_id": "1559a882-7868-3d7f-8113-5f9d48de2d1c",
                                "text": "Ein Fernsehgerät kann mit einem dazugehörigen Fuß oder Gestell, auf dem Boden stehen und ist so ein Standgerät."
                            },
                            {
                                "example_id": "9fd76e78-ec0c-4eaa-a127-cbec0ad3b6ab",
                                "sense_id": "1559a882-7868-3d7f-8113-5f9d48de2d1c",
                                "text": "„Ziel der Loewe Designer und der Stuttgarter Designschmiede Phoenix Design ist es zunächst, ein exklusives TV-Standgerät nach allen Regeln der Kunst zu schaffen. Der monolithische TV soll sich nahtlos in die Reihe der Loewe Designklassiker wie Loewe Art 1 (1985) und Loewe Spheros (1998) – beides Standgeräte, die mit zahlreichen Designpreisen ausgezeichnet wurden – einfügen. “"
                            },
                            {
                                "example_id": "bb26d744-dc1d-457a-b7a9-1acaa046dd0d",
                                "sense_id": "1559a882-7868-3d7f-8113-5f9d48de2d1c",
                                "text": "„Das Fernsehen automisierte die Welt, und seine Abstraktionsebenen waren dermaßen komplex, daß alle anderen Kommunikationswerkzeuge dahinter verblaßten; es war vielleicht die optisch-visuelle Revolution, die sich exakt mit dem 31. Dezember 1950 […] vollzog, das Wahrnehmungsmuster der Illusion in Standgeräte gehauen, begann seinen Siegeszug mit reproduzierenden Bildern, ausgebreitete amerikanische Kultur, graphischen Blättern, Annoncen, Plakaten, Schaustücken das Begreifen so nahe und doch so fern MILLOWITSCH; die Einpflanzung von Perversionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d74b7ec-06cd-349b-8a8f-b294db5e5c2d",
                        "entry_id": "dcdcd334-e09e-33dc-bb96-631e429ea45e",
                        "glosses": [
                            "Gerät, das nicht für den Einbau in einen Schrank, sondern für eine selbstständige Aufstellung im Raum vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b67d48-a11f-4658-b0c2-62a530e86bc1",
                                "sense_id": "6d74b7ec-06cd-349b-8a8f-b294db5e5c2d",
                                "text": "Eine Geschirrspülmaschine ist sowohl als Einbaugerät wie auch als Standgerät erhältlich."
                            },
                            {
                                "example_id": "26cdc439-318a-4e50-824d-791edeaeaeab",
                                "sense_id": "6d74b7ec-06cd-349b-8a8f-b294db5e5c2d",
                                "text": "„Einen Kühlschrank gibt es mit und ohne Gefrierfach, als kleines und als großes Standgerät.“"
                            },
                            {
                                "example_id": "e5bf110d-7eda-4693-88b9-ec35fa560432",
                                "sense_id": "6d74b7ec-06cd-349b-8a8f-b294db5e5c2d",
                                "text": "„Im Frühjahr 2012 gibt es am Markt bereits zahlreiche Geräte mit Energielabel A+++. Dabei ist die Auswahl unter den Tisch- und Standgeräten größer als unter den Einbaugeräten, die erheblich teurer sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
