                    "sense_id": "82a63f8f-ef45-32f5-8aed-d03384d0378f",
                    "sense_definition": "Opnieuw, voor de tweede of een volgende keer; synoniem voor <w>weer</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opnieuw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij sprak <w>weder</w> over zijn oude avonturen tijdens het diner.",
                            "target_lang_translations": {
                                "en": "He spoke <w>again</w> about his old adventures during dinner."
                            }
                        },
                        {
                            "text": "Na een lange afwezigheid is het stormachtige weer <w>weder</w> gekeerd.",
                            "target_lang_translations": {
                                "en": "After a long absence, the stormy weather has returned <w>once more</w>."
                            }
