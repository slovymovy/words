                                "target_senses": [
                                    {
                                        "sense_id": "fde95211-9c98-3a79-9d90-4446babea989",
                                        "entry_id": "e51b4fb1-e382-3a30-9862-41ecf3b041f6",
                                        "glosses": [
                                            "A flight recorder; the brightly colored cockpit voice recorders and flight data recorders in an aircraft designed to aid in determining the cause of an accident."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9a48496-4ed4-49ba-8513-7f924a2f72fe",
                                                "sense_id": "fde95211-9c98-3a79-9d90-4446babea989",
                                                "text": "scrutinizing all utterances recorded by the black box"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf51c0cc-e743-37d7-bad4-a2949c400c19",
                                        "entry_id": "e51b4fb1-e382-3a30-9862-41ecf3b041f6",
                                        "glosses": [
                                            "Any similar device on motor vehicles, such as rail event recorders and ship trip recorders."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f39f33-de8e-405c-b2c2-d53bd8dca058",
                                                "sense_id": "cf51c0cc-e743-37d7-bad4-a2949c400c19",
                                                "text": "the pilothouse's analogue of an airliner's black box"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60ffd2bd-3b3a-3a8f-8708-4e577109cb40",
                                        "entry_id": "e51b4fb1-e382-3a30-9862-41ecf3b041f6",
                                        "glosses": [
                                            "A theoretical construct or device with known input and output characteristics but unknown method of operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6c5521-5da1-4fb3-aa77-a94a43d6c014",
                                                "sense_id": "60ffd2bd-3b3a-3a8f-8708-4e577109cb40",
                                                "text": "The authentication method and its details can be treated as a black box for purposes of this security architecture overview."
                                            }
                                        ]
                                    },
