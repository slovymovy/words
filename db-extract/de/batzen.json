                ],
                "senses": [
                    {
                        "sense_id": "bf29cac6-b2ab-3a45-85a4-9130f38ebb3d",
                        "entry_id": "1682ecf9-0bf4-3499-b479-52478202f80b",
                        "glosses": [
                            "eine Münze im süddeutschen und Schweizer Raum"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "34b49b22-6e8a-467b-85fe-b8c8de4a81a1",
                                "sense_id": "bf29cac6-b2ab-3a45-85a4-9130f38ebb3d",
                                "text": "Der Batzen ist eine Münze, die zwischen 1492 und 1850 in Bern geprägt wurde."
                            },
                            {
                                "example_id": "d8e3a528-bc7d-45a6-bc2c-1177d44c916c",
                                "sense_id": "bf29cac6-b2ab-3a45-85a4-9130f38ebb3d",
                                "text": "„Doch bereits in einer urkundlichen Erwähnung von 1595 verkündete ein Vogt aus Tuttlingen bei seinem Amtsantritt, dass die Metzger zu Postritten verpflichtet seien, wofür sie für den Tag und je ein Pferd 5 Batzen erhalten sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8e3fc0a3-7cc4-3b25-ad25-155961efd2d5",
                        "entry_id": "1682ecf9-0bf4-3499-b479-52478202f80b",
                        "glosses": [
                            "ein größerer Klumpen eines weichen Materials"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "85a417db-98d8-4022-a22c-a6bf6a589032",
                                "sense_id": "8e3fc0a3-7cc4-3b25-ad25-155961efd2d5",
                                "text": "Ein fetter Batzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2bb61189-cfba-3b56-a86b-f042edcc1d0a",
                        "entry_id": "1682ecf9-0bf4-3499-b479-52478202f80b",
                        "glosses": [
                            "ein großer Geldbetrag"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a7891d75-ad36-459d-9664-31e5a65028bd",
                                "sense_id": "2bb61189-cfba-3b56-a86b-f042edcc1d0a",
                                "text": "Ich fand einen Batzen Geld auf der Straße."
                            },
                            {
                                "example_id": "43c7a858-80d9-46f9-9e39-5ec75aa0d7cd",
                                "sense_id": "2bb61189-cfba-3b56-a86b-f042edcc1d0a",
                                "text": "„Seine Schwägerin in Irland war nach langen Jahren des Siechtums an Krebs gestorben, und dieser Krebs hatte ihn einen ganz schönen Batzen gekostet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
