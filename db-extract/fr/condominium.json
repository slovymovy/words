                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268d3bbe-e9ce-4765-8be5-b39dabf891e9",
                                                "sense_id": "51bd0595-0e08-3b81-b045-779ba15e165c",
                                                "text": "Österreich fühlte sich Kraft seines Kondominats befugt, einzugreifen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6d37365-dfb5-38ff-8b3d-0f98f902d11e",
                                        "entry_id": "d1af421f-a291-3d00-b454-db411719280c",
                                        "glosses": [
                                            "Gebiet, das unter der Herrschaft mehrerer Staaten steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0a1959-c0b5-4510-a58f-06e6f5274b8b",
                                                "sense_id": "c6d37365-dfb5-38ff-8b3d-0f98f902d11e",
                                                "text": "Andorra war über lange Zeit ein Kondominat (1278-1993)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
