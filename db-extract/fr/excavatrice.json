        "fr-extract.jsonl": [
            {
                "entry_id": "73321c94-9f1b-3494-ae7e-26c8d0fbf45a",
                "word": "excavatrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08687878-8107-45ab-9d42-6620019e430e",
                        "entry_id": "73321c94-9f1b-3494-ae7e-26c8d0fbf45a",
                        "tags": [
