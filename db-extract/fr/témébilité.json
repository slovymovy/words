                        "examples": [
                            {
                                "example_id": "841ed20d-526e-4a90-9978-073f0d78e226",
                                "sense_id": "d1b45008-5596-3f2b-9420-47e55d54bff0",
                                "text": "Il crée les termes de « périculosité » et de « témébilité » pour définir la dangerosité. La « témébilité » correspond à une « corruption permanente et active chez un délinquant »."
                            },
                            {
                                "example_id": "bde54f8d-d7f4-46fb-88e7-f5bf29b4b771",
                                "sense_id": "d1b45008-5596-3f2b-9420-47e55d54bff0",
                                "text": "Il désigne, par le mot « témébilité », la perversité constante et agissante du délinquant, et la quantité de mal qu'on peut redouter de sa part, en d'autres termes, sa capacité criminelle."
                            }
                        ]
