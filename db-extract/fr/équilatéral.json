                "senses": [
                    {
                        "sense_id": "0f39dbb7-6879-3709-8f57-a714ef873ce3",
                        "entry_id": "98e67908-c58f-3cda-9ed2-710688ca0576",
                        "glosses": [
                            "Qui a ses côtés égaux entre eux, en parlant d’une figure géométrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a607c1a1-2bb0-4383-83ba-41e2f8670e22",
                                "sense_id": "0f39dbb7-6879-3709-8f57-a714ef873ce3",
                                "text": "Triangle équilatéral."
                            },
                            {
                                "example_id": "1277e018-189d-4f9c-8446-7ebcd2d1af63",
                                "sense_id": "0f39dbb7-6879-3709-8f57-a714ef873ce3",
                                "text": "Polygones équilatéraux."
                            }
                        ]
                    },
                    {
                        "sense_id": "2617bfd3-d852-3809-8dbb-f397cbada87f",
                        "entry_id": "98e67908-c58f-3cda-9ed2-710688ca0576",
                        "glosses": [
                            "Indifférent, sans importance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4ff92bab-571a-4303-8b75-9ba6d6e80fc8",
                                "sense_id": "2617bfd3-d852-3809-8dbb-f397cbada87f",
                                "text": "M’ennuyer ? Qu’est-ce que vous voulez que ça me fiche ? Voilà qui m’est équilatéral. Est-ce qu’ils ne devaient pas avoir Mlle Vinteuil ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d79acca7-8022-4274-b409-1ce8834d5c01",
                        "source_entry_id": "98e67908-c58f-3cda-9ed2-710688ca0576",
                        "target_lang_word": "gleichseitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichseitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39540507-59fe-397a-a369-aad1b7c0756b",
                                        "entry_id": "5a74ab6f-73bc-3296-bd1b-c56faaef6a0f",
                                        "glosses": [
                                            "(als geometrische Figur) jeweils dieselbe Entfernung zwischen zwei benachbarten Eckpunkten aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b51fe70-0bb4-4dc2-a2d1-693640bd0379",
                                                "sense_id": "39540507-59fe-397a-a369-aad1b7c0756b",
                                                "text": "„Aus Sizilien sind sie gekommen, wie man an der Trinacria auf dem Ofen sieht, dem Wappen der Insel in Form eines gleichseitigen Dreiecks aus drei laufenden Beinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "625dec09-7906-3d1b-8d63-bce5b0a3951f",
                                        "entry_id": "5a74ab6f-73bc-3296-bd1b-c56faaef6a0f",
                                        "glosses": [
                                            "auf beiden Seiten vorhanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e56b8d-52b2-47bc-ba4f-fe2547c2b4e6",
                                                "sense_id": "625dec09-7906-3d1b-8d63-bce5b0a3951f",
                                                "text": "„Eine Alternative ist der Porkpie. ‚Er hat einen kreisrunden Kopf, eine gleichseitig steife Krempe, ist rund eingeschlagen und wird auf dem Hinterkopf getragen‘, beschreibt Michel.“"
                                            },
                                            {
                                                "example_id": "7059bed3-ef7d-43b0-ad4a-66a8472f0527",
                                                "sense_id": "625dec09-7906-3d1b-8d63-bce5b0a3951f",
                                                "text": "„Durch diese Vertheilung auf die einzelnen Lappen wird auch die Ansicht von Jobert‚ auf die wir weiter unten zurückkommen werden, dass gleichseitige Hemiplegie nur bei Erkrankung des hintern Lappens vorkomme, widerlegt.“"
                                            },
                                            {
                                                "example_id": "e0fc123a-d8ef-4323-a759-929680ba36d7",
                                                "sense_id": "625dec09-7906-3d1b-8d63-bce5b0a3951f",
                                                "text": "„Von größter Wichtigkeit ist hingegen der Unterschied zwischen gleichseitigen und ungleichseitigen Verhältnissen bzw. Verknüpfungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "92ea5d96-6cbc-36fc-8185-c2a2b3ed167e",
                                        "entry_id": "5a74ab6f-73bc-3296-bd1b-c56faaef6a0f",
                                        "glosses": [
                                            "mit gleicher Anzahl Kettfadenhoch- und –tiefgängen"
                                        ],
                                        "tags": [
                                            "Weben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54522f3-5b09-4633-902a-c14e190bd963",
                                                "sense_id": "92ea5d96-6cbc-36fc-8185-c2a2b3ed167e",
                                                "text": "„Die Köperbindungen können eingeteilt werden: In Schuß- und Kettköperbindungen als nur einseitige Köperbindungen, in Effekt- und Mehrgradköperbindungen, als gleichseitige und ungleichseitige Köperbindungen.“"
                                            },
                                            {
                                                "example_id": "ba0fbbad-56ff-416e-b64f-9c6267b645a0",
                                                "sense_id": "92ea5d96-6cbc-36fc-8185-c2a2b3ed167e",
                                                "text": "„Mehrgratköper weisen zwei verschieden breite Grate auf, es gibt sie als Kett-, Schuss- oder gleichseitige Köper.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
