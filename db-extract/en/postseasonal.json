                                "example_id": "dfa6ff00-fb29-4809-a85c-a5d9d6bfc9e5",
                                "sense_id": "31244f2c-a379-3845-b505-aca2e3e23b2d",
                                "text": "Atmospheric mold sensitivity may prolong postseasonal ragweed symptoms until frost."
                            },
                            {
                                "example_id": "8cff1ecb-983e-47db-b495-2c498c36e2e8",
                                "sense_id": "31244f2c-a379-3845-b505-aca2e3e23b2d",
                                "text": "Then, for a third time in postseasonal play , the Dodgers rose from the dead ; after snatching three single - run victories , the Dodgers buried the Yanks 9-2 before a shocked Yankee Stadium crowd."
                            },
                            {
                                "example_id": "8f105e9a-3c16-4eab-8675-72fda8b7cf24",
                                "sense_id": "31244f2c-a379-3845-b505-aca2e3e23b2d",
                                "text": "But few small shops have the traffic to ensure that all of the postseasonal merchandise is sold within a few days of a holiday."
                            },
                            {
                                "example_id": "dbba6b71-3f95-4c15-9cd9-ab31f7f17a9e",
                                "sense_id": "31244f2c-a379-3845-b505-aca2e3e23b2d",
                                "text": "An unwanted distraction looms darkly on the horizon, a postseasonal hurricane."
                            }
                        ]
                    },
