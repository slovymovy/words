                "senses": [
                    {
                        "sense_id": "f24464c4-8fd6-3862-ab88-57080b74f545",
                        "entry_id": "64391fad-3243-3b23-94b9-f290dd83e9a8",
                        "glosses": [
                            "Vorbereitung der Umluft zur weiteren Nutzung; Luftaufbereitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c654e8a-4088-4578-881e-334a486a953d",
                                "sense_id": "f24464c4-8fd6-3862-ab88-57080b74f545",
                                "text": "„Ein energie- und platzsparendes Konzept eines Minireaktors zur photokatalytischen Umluftaufbereitung wurde entwickelt und umgesetzt.“"
                            },
                            {
                                "example_id": "f533d81a-5d1a-4228-af6d-ff4a51f6ca3c",
                                "sense_id": "f24464c4-8fd6-3862-ab88-57080b74f545",
                                "text": "„Die Umluftaufbereitung ist über der Arbeitskammer aufgesetzt.“"
                            },
                            {
                                "example_id": "8e71c3eb-a483-406a-b756-d7a526e38ce4",
                                "sense_id": "f24464c4-8fd6-3862-ab88-57080b74f545",
                                "text": "„Moderne Klima-Konzepte für Operationsräume sehen eine zentrale Mindest-Außenluftaufbereitung mit zentraler oder dezentraler Umluftaufbereitung vor.“"
                            },
                            {
                                "example_id": "7d801a14-875e-4f8a-9057-f41c2aabe52b",
                                "sense_id": "f24464c4-8fd6-3862-ab88-57080b74f545",
                                "text": "„Wann ein solches System zur Umluftaufbereitung in der Praxis eingesetzt werden könne, ist nach Einschätzung der Jenaer Chemiker jedoch noch offen.“"
                            },
                            {
                                "example_id": "f325bf1a-96bc-4640-8e79-00d30e31563f",
                                "sense_id": "f24464c4-8fd6-3862-ab88-57080b74f545",
                                "text": "„Diese Umluftaufbereitung besteht aus einer Pumpe sowie einem Filtersystem aus Natronkalk und Aktivkohle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
