                "senses": [
                    {
                        "sense_id": "04001414-d79a-3c38-b95e-9e9a6d712798",
                        "entry_id": "fb1d349f-64b8-356c-94d6-ca966d2b3df0",
                        "glosses": [
                            "Vertreter der Ordnung Galliformes; Vogel mit kurzen Flügeln und einem kräftigen Schnabel, der auf dem Boden lebt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "9d92d096-d7af-4464-85cc-243b6ad759c8",
                                "sense_id": "04001414-d79a-3c38-b95e-9e9a6d712798",
                                "text": "Wachteln sind Hühnervögel."
                            },
                            {
                                "example_id": "939dc8b5-bf99-4bc8-ba99-cf6f7f060ec9",
                                "sense_id": "04001414-d79a-3c38-b95e-9e9a6d712798",
                                "text": "„Das Rebhuhn soll wieder heimisch werden[.] In manchen Regionen gilt der scheue Hühnervogel fast als ausgerottet.“"
                            },
                            {
                                "example_id": "7ab4dd15-e193-4538-ac79-462705fb8af1",
                                "sense_id": "04001414-d79a-3c38-b95e-9e9a6d712798",
                                "text": "„Auf dem Weitermarsch kamen die Männer durch einen dichten Wald, wo ein paar Tragopans, Hühnervögel aus der Familie der Fasanen, vor ihnen aufflatterten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
