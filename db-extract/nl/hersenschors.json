                                        "entry_id": "257d08be-93ba-366d-aa59-05d824afaebe",
                                        "glosses": [
                                            "The grey, folded, outermost layer of the cerebrum that is responsible for higher brain processes such as sensation, voluntary muscle movement, thought, reasoning, and memory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b46ff2a8-e057-45f8-87d5-baf6788afa7b",
                                                "sense_id": "1051ff16-8919-3cb8-a377-29afb0670f46",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems— […]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            }
                                        ]
                                    }
