                "translations": [
                    {
                        "translation_id": "e8b8b614-c22f-4e01-a41e-c3d145c70d6c",
                        "source_entry_id": "04e19ad5-b8b5-318e-bf65-8b81ec594c02",
                        "source_sense_id": "4de81575-2841-35bd-b890-f751aeb21a58",
                        "source_sense_description": "Medizin: Ambulanz, Ambulanzstation, Ambulatorium",
                        "target_lang_word": "Ambulanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ambulanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aadbb2e-b286-3b43-afc6-35d4833d6931",
                                        "entry_id": "59231601-c1d9-39c9-bc36-9af95bea51ef",
                                        "glosses": [
                                            "Krankentransportwagen"
                                        ],
                                        "tags": [
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c8874c-46e9-4bae-97d8-07cbe59ac3b4",
                                                "sense_id": "8aadbb2e-b286-3b43-afc6-35d4833d6931",
                                                "text": "Das Unfallopfer wurde von der Ambulanz mit Blaulicht ins Krankenhaus gebracht."
                                            },
                                            {
                                                "example_id": "13061fa5-c9a4-4f41-bcd1-e36ed6d67529",
                                                "sense_id": "8aadbb2e-b286-3b43-afc6-35d4833d6931",
                                                "text": "„Privatkliniken haben eigene Ambulanzen.“"
                                            },
                                            {
                                                "example_id": "2daae425-5db7-415f-ba27-ef7f5a2c531c",
                                                "sense_id": "8aadbb2e-b286-3b43-afc6-35d4833d6931",
                                                "text": "„Veber hatte den Lichtchalter angedreht, als die Polizei und die Ambulanz kamen.“"
                                            },
                                            {
                                                "example_id": "d3a7dd2b-230a-4080-b7f6-00740b861008",
                                                "sense_id": "8aadbb2e-b286-3b43-afc6-35d4833d6931",
                                                "text": "„Es war nicht dasselbe, wie Wunden zu versorgen oder eine Ambulanz zu fahren, aber es war harte, befriedigende Arbeit, und sie sehnte sich nach sinnvoller körperlicher Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56234ed8-7bb1-30b3-8e16-01eeb833a93a",
                                        "entry_id": "59231601-c1d9-39c9-bc36-9af95bea51ef",
                                        "glosses": [
                                            "Kurzbezeichnung für ambulante, das heißt nicht stationäre Behandlung (der Patient bleibt nicht über Nacht im Haus, mit der Ausnahmen des Behandlungsbereich für Notfälle, in der Regel der »Notfallstation«)"
                                        ],
                                        "tags": [
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926e20ab-a7ac-4f7b-a605-8ddd23cdbaff",
                                                "sense_id": "56234ed8-7bb1-30b3-8e16-01eeb833a93a",
                                                "text": "In dieser Ambulanz wurde eine Diabetikerschulung über mehrere Tage durchgeführt, wodurch meine Frau endlich ihre Fragen beantwortet bekam."
                                            },
                                            {
                                                "example_id": "7a28f2b2-d2a4-4e6d-ac8c-df18e2323584",
                                                "sense_id": "56234ed8-7bb1-30b3-8e16-01eeb833a93a",
                                                "text": "„Das Navi hatte die Ambulanz gefunden, langsam fuhr ich voraus, eine Ortskunde behauptend, die reine Anmaßung war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cd5e9f4d-cbe0-36d0-8536-187805cfb0fa",
                                        "entry_id": "59231601-c1d9-39c9-bc36-9af95bea51ef",
                                        "glosses": [
                                            "ambulante Sprechstunde von Ärzten in Krankenhäusern für auswärtige Patienten."
                                        ],
                                        "tags": [
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bdb2abb-d31d-42e4-991a-34489d6c3aec",
                                                "sense_id": "cd5e9f4d-cbe0-36d0-8536-187805cfb0fa",
                                                "text": "Nach der Operation in der Ambulanz geht der Patient nach Hause."
                                            }
                                        ],
