                    {
                        "translation_id": "b1f2ebfb-3809-45ad-b39b-dffaf7b0ec85",
                        "source_entry_id": "958df445-1293-3823-80e1-02db8938b832",
                        "source_sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                        "target_lang_word": "шовинизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шовинизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75e318d5-6f81-3251-8dd7-7148a78d9cb6",
                                        "entry_id": "0688eeef-afd7-34ba-ae05-f90ed672dc14",
                                        "glosses": [
                                            "полит. идеология и политика воинствующего национализма, проповедь национальной исключительности; противопоставление интересов одной нации интересам других наций, распространение национального чванства, разжигание национальной вражды и ненависти"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "192149b2-acd2-4203-9a7c-8263f9958e94",
                                                "sense_id": "75e318d5-6f81-3251-8dd7-7148a78d9cb6",
                                                "text": "Не родись я в эпоху русской славы и искреннего народного патриотизма, какою были годы моего детства, едва ли бы из меня не вышел космополит; я так думаю потому, что у меня очень рано развилась вместе с глубоким сочувствием к родине какая-то непреодолимая брезгливость к национальному хвастовству, ухарству и шовинизму."
                                            },
                                            {
                                                "example_id": "8147bb40-39fb-4831-ad78-70853735c1e0",
                                                "sense_id": "75e318d5-6f81-3251-8dd7-7148a78d9cb6",
                                                "text": "Несмотря на свой крайний шовинизм, он, однако, вынужден был признаться в докладе своему правительству «В присутствие миноносцев я сам в конце концов потерял всякую веру, а отстаивать эту версию при таких условиях было, разумеется, невозможно.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016f8d5d-2ced-3dde-bae6-1a19c9b7fc92",
                                        "entry_id": "0688eeef-afd7-34ba-ae05-f90ed672dc14",
                                        "glosses": [
                                            "перен. социальные, этнические, религиозные, сексуально-ориентационные, возрастные и любые другие стереотипы, убеждения и верования, утверждающие неполноценность одного типа людей по сравнению с остальными"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e68da5a1-7984-4f4b-ace4-35013e2df1dc",
                                                "sense_id": "016f8d5d-2ced-3dde-bae6-1a19c9b7fc92",
                                                "text": "Мужской шовинизм стал в последнее время сверхпопулярным."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
