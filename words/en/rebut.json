{
    "word_family": [
        "rebuttal",
        "rebutter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d3c5a53-aa95-35f9-9eef-8e90ee9b88e7",
                    "sense_definition": "To deny the truth of something, especially by presenting arguments that disprove it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disprove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney worked hard to <w>rebut</w> the allegations with solid evidence.",
                            "target_lang_translations": {
                                "de": "Der Verteidiger arbeitete hart daran, die Anschuldigungen mit soliden Beweisen zu <w>widerlegen</w>."
                            }
                        },
                        {
                            "text": "She managed to <w>rebut</w> the argument during the debate by presenting new statistics.",
                            "target_lang_translations": {
                                "de": "Es gelang ihr, das Argument während der Debatte durch die Vorlage neuer Statistiken zu <w>entkräften</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "refute",
                        "disprove",
                        "deny",
                        "contradict"
                    ],
                    "antonyms": [
                        "confirm",
                        "prove",
                        "corroborate"
                    ],
                    "common_phrases": [
                        "rebut the allegations",
                        "rebut the argument",
                        "rebut the claims"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Wahrheit von etwas bestreiten, insbesondere durch das Vorbringen von Argumenten, die es widerlegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "widerlegen",
                                "target_lang_sense_clarification": "durch Argumente oder Beweise die Unrichtigkeit von etwas zeigen"
                            },
                            {
                                "target_lang_word": "entkräften",
                                "target_lang_sense_clarification": "Argumente oder Anschuldigungen unwirksam machen"
                            },
                            {
                                "target_lang_word": "zurückweisen",
                                "target_lang_sense_clarification": "Anschuldigungen oder Behauptungen entschieden von sich weisen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9c2d597-c719-3f88-8dd4-39350fcb9a2b",
                    "sense_definition": "To drive back or beat back; to repulse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repulse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers managed to <w>rebut</w> the enemy forces back to the border.",
                            "target_lang_translations": {
                                "de": "Den Soldaten gelang es, die feindlichen Truppen bis an die Grenze <w>zurückzudrängen</w>."
                            }
                        },
                        {
                            "text": "With a heavy shield, he <w>rebutted</w> the incoming blows of his opponent.",
                            "target_lang_translations": {
                                "de": "Mit einem schweren Schild <w>wehrte</w> er die herannahenden Schläge seines Gegners <w>ab</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "repulse",
                        "repel",
                        "ward off"
                    ],
                    "common_phrases": [
                        "rebutted back"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is archaic and rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zurückdrängen oder zurückschlagen; abwehren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zurückschlagen",
                                "target_lang_sense_clarification": "einen Angreifer oder gegnerische Kräfte zurückdrängen"
                            },
                            {
                                "target_lang_word": "abwehren",
                                "target_lang_sense_clarification": "einen physischen Angriff oder Schläge abblocken"
                            },
                            {
                                "target_lang_word": "zurückdrängen",
                                "target_lang_sense_clarification": "den Feind zum Rückzug zwingen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}