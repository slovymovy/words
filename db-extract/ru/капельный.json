                    {
                        "form_id": "9724d5b9-01dd-4bd1-9196-cee48f91691b",
                        "entry_id": "bd8e6664-685a-335f-bd63-ec4f44a824de",
                        "tags": [
                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "ка́пельна"
                    },
                    {
                        "form_id": "b79d4366-9f48-4063-8f48-7e54300e157f",
                        "entry_id": "bd8e6664-685a-335f-bd63-ec4f44a824de",
                        "tags": [
                            "plural",
