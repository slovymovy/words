                        "examples": [
                            {
                                "example_id": "7a5aa960-5c85-4370-91b9-94a1260a2178",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Setze ein' Schritt in die Bank, hol mir dort mein Flus\nUnd meine Skimaske hat nix mit dem Sport zu tun"
                            },
                            {
                                "example_id": "3d4fd420-fb45-4a8d-9260-852b5db67ff9",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Ich mach lilanes Flus, fahr als Knastrapper Maybach"
                            },
                            {
                                "example_id": "7567f078-3f04-405a-a3fa-ddab3b52f73a",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Business und Geschäfte, man kriegt nie genug (way)\nGib mir meine hälfte, Brudi, will mein Flouz (way)"
                            },
                            {
                                "example_id": "2c1769f0-dc85-4bf8-b916-0e04423b8f74",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Zwanni-Baggies pack' ich in den Schuh (Ey)\nBin im Studio, packe in der Booth (Taş)\nBin im Traphouse, hustle mein Flouz\nWährenddessen schicken Slutties die Nudes"
                            },
                            {
                                "example_id": "f9aa4f2b-9a48-4e16-966d-ccd3c795b0a3",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "YONII am Mic, mach mein Flouz und bleib' real"
                            },
                            {
                                "example_id": "4042a5ad-5d29-4e77-94f5-1fa40a60588b",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Meine Gang macht Flous\nKriminell, schnelles Geld, mach' Moves"
                            },
                            {
                                "example_id": "2e72fd36-847c-490b-a7bf-e8ffc810a934",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "„Was für Thomas? Ah, Ich bin Said\n[?] wo ist mein Flouz?\nWenn ich dich erwische [?], wo ist mein Flouz?”"
                            },
                            {
                                "example_id": "9475737e-a7ac-4e16-ab5c-0ee6c2d28e1e",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Ich kenn' alle Risikos, ich mach’ draußen easy Flouz\nAber wenn mich Zivi sucht, jump' ich weg in Yeezy Boost"
                            },
                            {
                                "example_id": "a5823b9f-a520-4d1d-bab7-41fe721359d5",
                                "sense_id": "d7c9246d-8ba3-3459-a9e4-6ae641b417ae",
                                "text": "Ich möchte kein Minus, ich möchte nur Plus\nSie will auch noch Liebe und nicht nur ein Kuss\nAber gebe ihr höchstens nur meine Nummer\nDenn ich weiß, die Bennett, sie will eh nur mein Flouz"
                            }
                        ]
                    }
