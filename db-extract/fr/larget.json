                        "glosses": [
                            "Gros lingot d’acier à section rectangulaire, que l’on destine ensuite au laminage ou au forgeage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c4fcde-edc5-4e69-beb5-7f71de05376c",
                                "sense_id": "e4867154-b0bf-3b69-a686-f98f7dc617fd",
                                "text": "Les largets on en général la longueur égale à la largeur des tôles que l'on compte obtenir après laminage."
                            },
                            {
                                "example_id": "e488260f-f72c-42b1-8125-6a41df3cbd0e",
                                "sense_id": "e4867154-b0bf-3b69-a686-f98f7dc617fd",
                                "text": "Un massiau, sorti du feu comtois, a été porté sous le marteau, et on l’a étiré sous la forme de larget."
                            }
                        ]
