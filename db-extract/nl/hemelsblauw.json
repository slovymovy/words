                    },
                    {
                        "translation_id": "973cb5f2-cc8d-49e8-a08d-5af499a98d23",
                        "source_entry_id": "9b559aad-59cd-3a20-8d92-2298e9fa2d59",
                        "source_sense_id": "7d8aace8-fc17-3a0d-a96d-a9b27ac65694",
                        "target_lang_word": "sky blue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sky blue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b699f96f-9fe7-3383-8be7-9c1def53a713",
                                        "entry_id": "dd19c8e3-b3af-3342-9369-21da0d43881c",
                                        "glosses": [
                                            "Of a vibrant light blue colour, like that of the sky on a fine day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcb811a-9ac6-4304-b054-e78c1334d3cf",
                                                "sense_id": "b699f96f-9fe7-3383-8be7-9c1def53a713",
                                                "text": "“Hi! Kostandi!” called out an old sailor in a sky-blue cloak. “How are things with you?”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sky blue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6435dd3-3496-3c03-af77-3c61be7fcb83",
                                        "entry_id": "c81f4517-e4b6-35d7-a1f4-d2df60b93ea1",
                                        "glosses": [
                                            "A vibrant light blue colour, like that of the sky on a fine day."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a91ef33-4197-3c99-a36c-99146685b10e",
                                        "entry_id": "c81f4517-e4b6-35d7-a1f4-d2df60b93ea1",
                                        "glosses": [
                                            "Milk excessively diluted with water, or from which the cream was too closely skimmed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603bf857-49f7-4e43-8f3c-68ab38625f0d",
                                                "sense_id": "8a91ef33-4197-3c99-a36c-99146685b10e",
                                                "text": "Hence, Suffolk dairy wives run mad for cream,\n And leave their milk with nothing but the name;\n Its name derision and reproach pursue,\n And strangers tell of three-times-skimm'd sky-blue."
                                            },
                                            {
                                                "example_id": "a51de9e3-ba47-48ac-b277-5d67e0597fba",
                                                "sense_id": "8a91ef33-4197-3c99-a36c-99146685b10e",
                                                "text": "To be sure, your Aunt Betsey lives in a brick house, and has a sight of furniture, […] yet she has all her bread to buy by the loaf, and the milk is sky-blue; as to cream, I don't believe they ever heard on't."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96447ce5-d9f6-437f-8a7b-c31f04156678",
                        "source_entry_id": "9b559aad-59cd-3a20-8d92-2298e9fa2d59",
                        "source_sense_id": "7d8aace8-fc17-3a0d-a96d-a9b27ac65694",
