                "senses": [
                    {
                        "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                        "entry_id": "66e5d99c-5979-3aef-bec9-28fed5634368",
                        "glosses": [
                            "Betätigungsform, bei der die Motorik im Zentrum des Spielgeschehens steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad1cd509-2452-45ef-a7be-52ced7436a03",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Wenn Spiel als Bewegungsphänomen definiert ist, so scheint der Ausdruck Bewegungsspiel zunächst eine Tautologie zu enthalten.“"
                            },
                            {
                                "example_id": "0f3d6e19-fd3a-4e9b-bd2c-5481b19138f9",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Beim Menschen kann gar kein Zweifel bestehen, daß alles Laufen und Springen, alles Hüpfen und Schaukeln, alles Gleiten und Sausen für den Anblick wie für das Erleben selbst zum echten Bewegungsspiel wird.“"
                            },
                            {
                                "example_id": "215825f1-3891-4241-9f28-13eb1e490765",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Als Bewegungsspiele bezeichnet man die Gruppe von Spielen, bei denen die körperliche Eigenbewegung den Spielcharakter bestimmt.“"
                            },
                            {
                                "example_id": "308445e1-afe6-4df0-a30d-401f5bdb042c",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Bewegungsspiele brauchen Platz.“"
                            },
                            {
                                "example_id": "ca3ea4cc-3d5d-4386-80d2-9879197b6f26",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Dabei wird übersehen, daß das Bewegungsspiel im Leben der Kinder –vor allem im Freien- weiterhin einen bedeutsamen Platz einnimmt.“"
                            },
                            {
                                "example_id": "b24bd46a-300f-4df2-90e0-6d6535d1a22b",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Hausaufgaben, Förderstunden, Arbeitsgemeinschaften und Bewegungsspiele in der Ganztagsschule fordern ihren Tribut.“"
                            },
                            {
                                "example_id": "be8fd1c7-dd45-4fce-8afb-c732d067f6ea",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Es gibt viele Bücher über Bewegungsspiele, nützliche und unnütze, gute und schlechte.“"
                            },
                            {
                                "example_id": "1795ca0b-8fc5-489f-a2ae-0da2e1097ff4",
                                "sense_id": "806c02bc-088b-3fbb-9783-2b1963704065",
                                "text": "„Denn auch die Bewegungsspiele wie Dritten-Abschlagen und Neckball haben ihre bestimmten einfachen Regeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
