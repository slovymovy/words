                                "sense_id": "d1d7ccd8-74cd-3ec0-9845-1b4a348ba560",
                                "text": "In de loop van de ochtend zal de mistigheid afnemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9163b867-166f-3c4a-a562-77586a8fbc85",
                        "entry_id": "1d8f42ad-8e34-3537-8732-dbac5357a679",
                        "glosses": [
                            "de mate waarin iemand onduidelijk en vaag is"
