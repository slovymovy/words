                ],
                "senses": [
                    {
                        "sense_id": "42bb7e7b-0e92-3062-acbf-be7c00df32a8",
                        "entry_id": "f434b237-2adc-3c04-8c15-f272f92db1ac",
                        "glosses": [
                            "Tailler une branche pour la réduire à un courson."
                        ],
                        "tags": [
                            "Arboriculture",
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "d07a0597-70d2-49f2-9349-971ed77c3006",
                                "sense_id": "42bb7e7b-0e92-3062-acbf-be7c00df32a8",
                                "text": "Coursonner une branche, c’est la raccourcir à la moitié, au tiers, au quart environ de son développement, de manière à la réduire à l’état de courson."
                            },
                            {
                                "example_id": "fc447761-6501-43b8-b0df-b618fb336fc9",
                                "sense_id": "42bb7e7b-0e92-3062-acbf-be7c00df32a8",
                                "text": "L’élagage sur la jeune flèche sera modéré ; on se bornera à coursonner les ramifications trop longues qui s’y seraient développées, et à laisser les autres."
                            },
                            {
                                "example_id": "8e9e68d7-4dc8-4ebe-8642-5b044e99344b",
                                "sense_id": "42bb7e7b-0e92-3062-acbf-be7c00df32a8",
                                "text": "À cet effet, on choisira parmi les sarments à coursonner ceux qui ne sont pas atteints ou le sont le moins ; la maladie étant rarement généralisée sur les pieds il est souvent possible de trouver le nombre de sarments sains nécessaires pour établir les porteurs."
                            }
                        ]
                    }
                ],
