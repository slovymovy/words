                "senses": [
                    {
                        "sense_id": "20cd2e79-4a36-37dc-955d-3cea698d4c17",
                        "entry_id": "eff7c5ac-caa8-3587-9bc6-cb86759c1d24",
                        "glosses": [
                            "in einem Garten genutztes Gerät, das zum Garen vom Fleisch, Wurst, Fisch, Grillkäse und Gemüse auf einem Rost verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9677c74-2a09-4d40-bd9c-536ccb57499e",
                                "sense_id": "20cd2e79-4a36-37dc-955d-3cea698d4c17",
                                "text": "„Ende Mai feiert die Familie ein Dankesfest, Sarah trägt einen weißen Rock, eine schwarze Bluse mit weißen Tupfen, zwei goldene Herzen am Hals, der Vater steht am Gartengrill.“"
                            },
                            {
                                "example_id": "acdd2c52-9a9b-4b37-8e53-473f6ffde2ae",
                                "sense_id": "20cd2e79-4a36-37dc-955d-3cea698d4c17",
                                "text": "„Therese, Zora und Hedwig laufen zwischen Küche und Garten hin und her, decken den Tisch, entkapseln Weinflaschen, machen Feuer unter dem Gartengrill.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
