                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "getand",
                                "target_lang_sense_clarification": "met kartelingen of tanden"
                            },
                            {
                                "target_lang_word": "gekarteld",
                                "target_lang_sense_clarification": "met een gekartelde rand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84f7aba-d191-344c-968f-1321939e3590",
                    "sense_definition": "Having teeth of a specified colour or appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blazon described a fearsome lion rampant, langued and <w>dented</w> gules.",
                            "target_lang_translations": {
                                "nl": "De wapenbeschrijving meldde een angstaanjagende klimmende leeuw, getongd en <w>getand</w> van keel."
                            }
                        },
                        {
                            "text": "The crest portrayed a mythical dragon <w>dented</w> sable upon a gold field.",
                            "target_lang_translations": {
                                "nl": "Het helmteken toonde een fabeldraak <w>getand</w> van sabel op een gouden veld."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "voorzien van tanden van een specifieke kleur of tint (heraldiek)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "getand",
