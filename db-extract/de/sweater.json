                "senses": [
                    {
                        "sense_id": "b29f1706-b24e-3cd3-a4b5-fb6c2ba6916d",
                        "entry_id": "ab24da1f-3ccc-30cd-9ff2-942936f4c29b",
                        "glosses": [
                            "Pullover, der unter anderem zum Sport getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac3c95e-ac20-4f48-a271-18e000f76439",
                                "sense_id": "b29f1706-b24e-3cd3-a4b5-fb6c2ba6916d",
                                "text": "„An seinem Sweater prangen Anstecker, die ihm die Schule für seine Leistungen verliehen hat."
                            },
                            {
                                "example_id": "b6c5824a-836f-4a99-b222-c1fb85436d2b",
                                "sense_id": "b29f1706-b24e-3cd3-a4b5-fb6c2ba6916d",
                                "text": "„Bei ihrer ersten Zusammenkunft mit Major Dincklage trug Käthe, was sie immer trug: einen schwarzen Sweater mit dreieckigem Ausschnitt, einen engen dunkelbraunen Rock, dünne graue Wollstrümpfe, ziemlich feste Schuhe.“"
                            },
                            {
                                "example_id": "1ef3ffad-d3c4-436d-9ec4-a734c5a70a87",
                                "sense_id": "b29f1706-b24e-3cd3-a4b5-fb6c2ba6916d",
                                "text": "„Sie trägt einen grünen Sweater, einen kurzen Rock und große Ohrringe mit falschen Steinen.“"
                            },
                            {
                                "example_id": "4f68cd95-9a5b-4e00-9ed3-a304181b892b",
                                "sense_id": "b29f1706-b24e-3cd3-a4b5-fb6c2ba6916d",
                                "text": "„Sie trug eine Sommerhose – aus indischer Seide? – purpurn und weit über weißen Stiefeln, einen schwarzen geschlossenen Sweater und einen Shawl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6f83f84-08b9-4b28-a789-cc0fc0ab1c44",
                        "source_entry_id": "ab24da1f-3ccc-30cd-9ff2-942936f4c29b",
                        "source_sense_id": "b29f1706-b24e-3cd3-a4b5-fb6c2ba6916d",
