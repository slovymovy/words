                "entry_id": "8039c5cb-0a27-369b-8236-c438ae1b9610",
                "word": "Halloween",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                        "entry_id": "8039c5cb-0a27-369b-8236-c438ae1b9610",
                        "glosses": [
                            "święto duchów obchodzone 31 października (w wigilię Wszystkich Świętych) w krajach anglosaskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21615c9-b8d5-41a2-acec-c82ce794bd4b",
                                "sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                                "text": "W Stanach Zjednoczonych najbardziej charakterystycznymi świętami są Halloween oraz Święto Dziękczynienia."
                            },
                            {
                                "example_id": "17b7100e-a827-4677-b871-ee4e95525c3a",
                                "sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                                "text": "Symbolem Halloween jest wydrążona dynia z otworami w kształcie twarzy i świecą w środku"
                            },
                            {
                                "example_id": "6f79ddab-97ae-4daf-a00c-25be78a305ce",
                                "sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                                "text": "Czy Polacy powinni świętować Halloween?"
                            },
                            {
                                "example_id": "3c87cd45-190e-474d-b1a6-164d4fce6ddd",
                                "sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                                "text": "W Halloween Amerykanie, Brytyjczycy, Irlandczycy i Kanadyjczycy przebierają się za duchy, czarownice, upiory, wampiry itp."
                            },
                            {
                                "example_id": "06564ab0-203d-4dda-96eb-7641853abf32",
                                "sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                                "text": "Z Halloween wiążą się wierzenia związane z duszami zmarłych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e18f3565-00bf-423d-9be7-9b085e8752ae",
                        "source_entry_id": "8039c5cb-0a27-369b-8236-c438ae1b9610",
