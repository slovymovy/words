                        "source_sense_id": "89dbcac0-ea88-3684-8593-358dc457b184",
                        "target_lang_word": "declamatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "declamatory",
