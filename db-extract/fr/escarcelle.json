                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beurs",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3a65d3a2-c4b0-349c-95e4-37a8a4273402",
                                        "entry_id": "fec60110-1f17-3660-82a9-a68991b723c2",
                                        "glosses": [
                                            "het beursgebouw waar effecten (waardepapieren) gekocht en verkocht worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2486248-e3f6-404a-905b-a90c50332073",
                                                "sense_id": "3a65d3a2-c4b0-349c-95e4-37a8a4273402",
                                                "text": "De Amsterdamse beurs was gevestigd aan het Damrak"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f97e5a-a5f7-35f7-916e-71fa78b2af53",
                                        "entry_id": "fec60110-1f17-3660-82a9-a68991b723c2",
                                        "glosses": [
                                            "een houder voor munten en biljetten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e2f2f3-87a3-4c3a-a1a7-2a4ba6ba9220",
                                                "sense_id": "e7f97e5a-a5f7-35f7-916e-71fa78b2af53",
                                                "text": "Hij had zijn beurs in zijn kontzak."
                                            },
                                            {
                                                "example_id": "744dfe48-5036-474c-924a-aeb8b54f5f53",
                                                "sense_id": "e7f97e5a-a5f7-35f7-916e-71fa78b2af53",
                                                "text": "Het gaat natuurlijk om Thea's leven, want dat gaat veranderen - een leven als echtgenote, met een volle beurs en nieuwe kleren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea13510-a543-315d-8f61-8db672e8ca13",
                                        "entry_id": "fec60110-1f17-3660-82a9-a68991b723c2",
                                        "glosses": [
                                            "toelage voor iemand die studeren wil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "335aef95-bd46-4b1d-b87f-172d63d8ad85",
                                                "sense_id": "5ea13510-a543-315d-8f61-8db672e8ca13",
                                                "text": "Kinderen van arme ouders krijgen een beurs van de overheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e6e176-a532-33a8-8355-ccbc1429ccf6",
                                        "entry_id": "fec60110-1f17-3660-82a9-a68991b723c2",
                                        "glosses": [
                                            "tentoonstelling waar producenten in een bepaalde branche, nieuwe producten tonen, of het gebouw waarin zulke tentoonstellingen gehouden kunnen worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a217e8-3a84-4d7b-a16d-3e0f7e462e1b",
                                                "sense_id": "23e6e176-a532-33a8-8355-ccbc1429ccf6",
                                                "text": "Veel huisvrouwen gaan naar de huishoudbeurs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf089e35-88d9-3f8b-b4c5-f7dd46b5460f",
                                        "entry_id": "fec60110-1f17-3660-82a9-a68991b723c2",
                                        "glosses": [
                                            "een markt waar de transacties openbaar zijn en waar men financiële instrumenten, goederen of diensten kan aan- en verkopen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10dc263b-44df-38aa-bf64-644da0cdbc0b",
                                        "entry_id": "fec60110-1f17-3660-82a9-a68991b723c2",
                                        "glosses": [
                                            "slijmbeurs (een kleine zakvormige holte gevuld met een visceuze vloeistof, welke dient als stootkussen op plaatsen, waar druk of wrijving bestaat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85004c9e-4a13-4a12-b30e-fd41ee936a2c",
                                                "sense_id": "10dc263b-44df-38aa-bf64-644da0cdbc0b",
                                                "text": "Hij had een rood gezwollen knie door een ontsteking van de slijmbeurs voor de knieschijf (bursitis praepatellaris)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beurs",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "25c319e0-4bc6-3501-a378-4a898b9dbfb8",
                                        "entry_id": "56eb0d4d-0256-3b2a-a1e4-348c4b095447",
                                        "glosses": [
                                            "overrijp, buikziek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f596eb8e-d15d-4f0f-9a1c-3e1a61afbd33",
                                                "sense_id": "25c319e0-4bc6-3501-a378-4a898b9dbfb8",
                                                "text": "Hij geloofde ze net zomin als de propaganda aan het begin, toen bijvoorbeeld werd beweerd dat de kogels van de moffen zo zacht waren dat ze onder daverend gelach van de Franse regimenten als beurse peren op hun uniform te pletter sloegen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bde32c26-a3ed-3a7c-bce2-5b8b30ea2e84",
                                        "entry_id": "56eb0d4d-0256-3b2a-a1e4-348c4b095447",
                                        "glosses": [
                                            "beschadigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f07392-b260-45ec-bb8a-ed879f4b67a6",
                                                "sense_id": "bde32c26-a3ed-3a7c-bce2-5b8b30ea2e84",
                                                "text": "Ik ging naar de wc en stak mijn hand tussen mijn benen; wat geronnen bloed, maar het duidelijkste symptoom was de vage buikpijn die ik had, onderin, een doffe pijn, het gevoel dat ik was opengereten en beurs was."
                                            },
                                            {
                                                "example_id": "2a5b45f7-4044-40cb-ab1d-feaf19e7e83e",
                                                "sense_id": "bde32c26-a3ed-3a7c-bce2-5b8b30ea2e84",
                                                "text": "De tweede dag was alles nog zwaarder dan de eerste dag. Mijn 18 kilo zware rugzak, bepakt met voedsel en water, voelde als lood op mijn rug. Door de eindeloze herhaling van mijn stappen werden mijn voeten langzaam beurs."
                                            },
                                            {
                                                "example_id": "07e4f60e-b610-455c-a517-5283e5e504ce",
                                                "sense_id": "bde32c26-a3ed-3a7c-bce2-5b8b30ea2e84",
                                                "text": "Maar op de laatste dag wandelde ik, afgezien van wat spierpijn en beurse knieën, het kustplaatsje Chora Sfakion binnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
