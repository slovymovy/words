                        "glosses": [
                            "Blesser avec un couteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7604729f-054f-4f1f-9cdd-521b3ecb133e",
                                "sense_id": "4fba5a8a-5c5c-3294-95c9-faf1f26ec3c0",
                                "text": "Il prend aisément en pitié l’homme qui tombe d’inanition sur une borne ; mais que deux hommes ivres se battent, se mordent, se coutellent, il étend les bras pour empêcher de passer ceux qui veulent les arrêter; il fait cercle, et il admire."
                            },
                            {
                                "example_id": "ceea49d4-0051-4c1a-abef-f8a9a1f4b519",
                                "sense_id": "4fba5a8a-5c5c-3294-95c9-faf1f26ec3c0",
                                "text": "Peau coutelée, peau qui a été endommagée par le couteau."
                            }
                        ]
                    }
