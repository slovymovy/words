                                                "sense_id": "d61734fb-c061-30c2-826e-3b14647e598b",
                                                "text": "Wenn meine Alte die Fünf in Mathe sieht, wird sie sich nicht sehr darüber freuen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d83c82cb-33db-3ad8-9c25-fc3b6e3b3696",
