                                    {
                                        "sense_id": "fa12ee98-738d-3847-ae17-ee8ef8e45666",
                                        "entry_id": "5f354e20-c4fb-30be-8207-a509a1867939",
                                        "glosses": [
                                            "A Japanese shish kebab-type dish made with small pieces of chicken or other ingredients cooked on skewers, often marinated in soy sauce or seasoned with salt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f876f1-5552-4136-854f-0e13b8e09536",
                                                "sense_id": "fa12ee98-738d-3847-ae17-ee8ef8e45666",
                                                "text": "Friday night on Ninsei. He passed yakitori stands and massage parlors, a franchised coffee shop called Beautiful Girl, the electronic thunder of an arcade."
                                            },
                                            {
                                                "example_id": "04b3cb96-4733-414d-b2d7-79bfd076e6c9",
                                                "sense_id": "fa12ee98-738d-3847-ae17-ee8ef8e45666",
                                                "text": "We should have the bazaars full of yakitori pitches and geishas in bamboo cages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06e0abd8-0309-4e8c-b0d3-1b4f7d17bbc6",
                        "source_entry_id": "a0b3d4f3-209a-389e-89a1-3dd27a6ed3b2",
                        "source_sense_id": "9272014f-1f92-38bc-9510-b20fdccb1b26",
                        "source_sense_description": "gebratenes oder gegrilltes Fleischspießchen, typischerweise mit Teriyaki-Soße serviert",
                        "target_lang_word": "yakitori",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yakitori",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                        "entry_id": "79de8077-15ae-3b28-bcd2-1b03d24957eb",
                                        "glosses": [
                                            "Brochette de volaille grillée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0107fe6-ead1-4f3c-b472-dac82d111e09",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "Admirer le feu d’artifice une bière à la main en grignotant des yakitoris et des graines de soja sans se faire bousculer par la foule, c’est un luxe extraordinaire."
                                            },
                                            {
                                                "example_id": "9d1449b1-f072-472d-9b61-4c0ce93c6801",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "– Je peux passer te prendre à quelle heure ce soir ? Je t’achèterai des yakitori."
                                            },
                                            {
                                                "example_id": "69333455-1bd1-40aa-a652-8be5c7bdfa2b",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "J’ouvre le réfrigérateur. Il n’y a pas grand-chose ; fromage, pains tranchés, saucisses. Je n’aime pas ces produits. Je veux manger une soupe de miso, du poisson grillé, des yakitoris, des sashimis."
                                            },
                                            {
                                                "example_id": "9177f51e-59ce-416f-abc0-7d9ef5310d4d",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "Pareil pour les yakitoris, des brochettes de légumes et de poulet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
