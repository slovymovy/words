                        "target_lang_word": "avertisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avertisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b635091-6aa9-3eb6-b27c-def3d5dacb86",
                                        "entry_id": "34171d2b-128f-317a-a655-705d6440ae7c",
                                        "glosses": [
                                            "Celui qui avertit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7f8d9c-3c0d-450a-8ca4-c1c7bd4a5b01",
                                                "sense_id": "8b635091-6aa9-3eb6-b27c-def3d5dacb86",
                                                "text": "Il y a un avertisseur, au théâtre, pour que l’acteur ne manque pas son entrée."
                                            },
                                            {
                                                "example_id": "99dafc79-d6bd-4bc1-acf1-3d14525e6b99",
                                                "sense_id": "8b635091-6aa9-3eb6-b27c-def3d5dacb86",
                                                "text": "Aussi, se résignant à son rôle, il s’adapta son masque, boucla son ceinturon, drapa sa cape sur son épaule et attendit que l’avertisseur lui vînt dire que c’était son tour."
                                            },
                                            {
                                                "example_id": "6c6cb5b7-50af-4a4c-aae0-52be3b40dd8f",
                                                "sense_id": "8b635091-6aa9-3eb6-b27c-def3d5dacb86",
                                                "text": "Cette loge paraissait un palais aux gamines du corps de ballet, qui étaient logées dans des chambres communes, où elles passaient leur temps à chanter, à se disputer, à battre les coiffeurs et les habilleuses et à se payer des petits verres de cassis ou de bière ou même de rhum jusqu’au coup de cloche de l’avertisseur."
                                            },
                                            {
                                                "example_id": "26d4eab1-e234-4daa-a0ef-05b30af21f15",
                                                "sense_id": "8b635091-6aa9-3eb6-b27c-def3d5dacb86",
                                                "text": "Eh bien ! madame, écoutez-moi ça : son plus jeune s’est mis à avoir des convulsions dès qu’il apercevait un sergent de ville ! Croyez-vous que c’était agréable ! Juché sur l’épaule de sa mère, il servait d’avertisseur, sans qu’elle eût la peine de rester aux aguets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aaed490-5096-3a79-b0ec-0e99b7afbcce",
                                        "entry_id": "34171d2b-128f-317a-a655-705d6440ae7c",
                                        "glosses": [
                                            "Officier qui avertissait de l'approche du roi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51050de4-9feb-382e-aab8-739ae6e7174e",
                                        "entry_id": "34171d2b-128f-317a-a655-705d6440ae7c",
                                        "glosses": [
                                            "Un appareil destiné à donner un signal ou à prévenir d’un danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1aa6531-cc2a-42e0-9c8d-52b2caf81be1",
                                                "sense_id": "51050de4-9feb-382e-aab8-739ae6e7174e",
                                                "text": "Dix secondes après, plusieurs avertisseurs se mirent à corner d’une façon lugubre, de loin en loin, appelant les « rondards » en tournée sur les lieux présumés du sinistre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d01c274b-848b-33b8-b532-bee885d22e4d",
                                        "entry_id": "34171d2b-128f-317a-a655-705d6440ae7c",
                                        "glosses": [
                                            "Klaxon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a30c8d0-bbfd-4f00-95e0-b5f7d3b69ed3",
                                                "sense_id": "d01c274b-848b-33b8-b532-bee885d22e4d",
                                                "text": "Hébé! Celui-là, il ne doit pas user son avertisseur. On l’entend venir…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
