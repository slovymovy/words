                            {
                                "example_id": "bcb21c1a-d8f5-47e9-bf09-d0f7eab01eb3",
                                "sense_id": "c5034956-510c-37e8-bcb5-a1fb779c08a1",
                                "text": "Er erzählte die ganze Zeit alberne Kalauer und langweilte uns damit.",
                                "translation": "Он всё время рассказывал глупые шутки и тем самым надоедал нам."
                            },
                            {
                                "example_id": "dd781daf-514c-4199-846c-6e51c3a9db36",
                                "sense_id": "c5034956-510c-37e8-bcb5-a1fb779c08a1",
                                "text": "Beispiel für einen Kalauer: Fährt der alte Lord fort, fährt er nur im Ford fort.",
                                "translation": "Пример каламбура: Уезжает старый лорд, уезжает он на Ford."
                            }
