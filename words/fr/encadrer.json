                        "encadrer un groupe",
                        "encadrer des stagiaires"
                    ]
                },
                {
                    "sense_id": "53155428-8412-348d-96b5-d0824f8d5af1",
                    "sense_definition": "Entourer, border quelque chose de part et d'autre de manière visible.",
