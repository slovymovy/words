                "forms": [],
                "senses": [
                    {
                        "sense_id": "677a78ac-16fc-3948-b29a-8b56c448535a",
                        "entry_id": "dfef4291-5335-3bbc-a673-5f016144b461",
                        "glosses": [
                            "le borough de Bantam est situé dans le comté de Litchfield au Connecticut."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e1313d15-b56d-3518-98b7-dfc540283167",
                        "entry_id": "dfef4291-5335-3bbc-a673-5f016144b461",
                        "glosses": [
                            "L'unique village des Îles Cocos (Keeling), elle est située sur l'île Home."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "58efe155-7b39-3195-b2e6-570d3dae385a",
                        "entry_id": "dfef4291-5335-3bbc-a673-5f016144b461",
                        "glosses": [
                            "Variante orthographique de Banten, ville en Indonésie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b488c2de-a8a6-3407-9029-dec7d9d7c6b8",
                        "entry_id": "dfef4291-5335-3bbc-a673-5f016144b461",
                        "glosses": [
                            "Race de poules naines, originaires de Chine, basses sur pattes, à petite crête simple, et à oreillons rouges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c614dbfe-ccc3-4d6f-8a9c-eaa3779e74c5",
                                "sense_id": "b488c2de-a8a6-3407-9029-dec7d9d7c6b8",
                                "text": "Nous avons les poules naines, très agréables d’aspect ; la race bantam, que l’on attribue au goût et aux soins des Japonais,…"
                            },
                            {
                                "example_id": "5c5fe62e-f267-404c-8979-024e6948ff28",
                                "sense_id": "b488c2de-a8a6-3407-9029-dec7d9d7c6b8",
                                "text": "La seule [volaille] à laquelle on puisse soupçonner quelque chose comme une voix, c’est un vieux bantam du boulanger d’à côté, encore est-il devenu enroué pour avoir été trop mal nourri et mal logé dans sa dernière place."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7d7f230-9f63-3b57-aea0-60acea021626",
                        "entry_id": "dfef4291-5335-3bbc-a673-5f016144b461",
                        "glosses": [
                            "Une des catégories d’âge de hockey mineur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da66dd3f-c9e2-44f8-ae81-341897064eb6",
                                "sense_id": "f7d7f230-9f63-3b57-aea0-60acea021626",
                                "text": "Pas de la haute gastronomie, mais « ça fait la job » et ça ne coûte pas cher, le genre de resto où vous amenez une équipe de hockey bantam et leurs parents."
                            },
                            {
                                "example_id": "7730bc9a-da16-40fd-85f9-d7eb9412d796",
                                "sense_id": "f7d7f230-9f63-3b57-aea0-60acea021626",
                                "text": "Un entraîneur a sauté sur la glace pour plaquer un joueur adverse hier lors d'un match bantam B à l’aréna Côte-de-Beaupré, un geste disgracieux et dénoncé de toutes parts qui lui a valu d'être suspendu pour le reste de la saison par son organisation."
                            }
                        ]
                    }
                ],
