                ],
                "senses": [
                    {
                        "sense_id": "e38a4a39-2a9b-3d09-a39f-26900a117874",
                        "entry_id": "4a61ce5f-860e-38cb-af59-bb2e4a41cc58",
                        "glosses": [
                            "Internationales Institut für Angewandte Systemanalyse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2547bfc5-f5da-4f40-bcd2-9e2dbc6fc68e",
                                "sense_id": "e38a4a39-2a9b-3d09-a39f-26900a117874",
                                "text": "Der Sitz des IIASA ist im Neuen Schloss in Laxenburg, ungefähr 20 Kilometer südlich von Wien."
                            },
                            {
                                "example_id": "cb94d57b-f08b-4dc0-8cc9-c640e015ef27",
                                "sense_id": "e38a4a39-2a9b-3d09-a39f-26900a117874",
                                "text": "Das IIASA wurde im Jahre 1972 gegründet und ist ein internationales Forschungsinstitut, das politisch relevante Forschung in Problembereichen durchführt, die zu umfangreich oder zu komplex sind, um von einem einzelnen Land oder von einer einzigen Disziplin bewältigt zu werden."
                            },
                            {
                                "example_id": "37f321b6-d254-412a-876f-022bbb2f9071",
                                "sense_id": "e38a4a39-2a9b-3d09-a39f-26900a117874",
                                "text": "Außerdem bezieht das IIASA aus seinem weltweiten Netz von ca. 2500 externen Forschern in 65 Ländern lokale und regionale Daten, die in seine hochentwickelten wissenschaftlichen Modelle integriert werden."
                            },
                            {
                                "example_id": "205c24c4-e696-4205-99bd-fc9586ceb18d",
                                "sense_id": "e38a4a39-2a9b-3d09-a39f-26900a117874",
                                "text": "Am Sonntag, den 29. September 2019 öffnet das Internationale Institut für Angewandte Systemanalyse (IIASA) seine Tore zur einstigen Sommerresidenz der Habsburger in Zusammenarbeit mit der Gemeinde Laxenburg zum Tag des Denkmals."
                            },
                            {
                                "example_id": "27b56d1b-8065-476f-842d-74f489d07176",
                                "sense_id": "e38a4a39-2a9b-3d09-a39f-26900a117874",
                                "text": "1986 verließ er das IIASA, wurde Professor an der TU Wien - und begann, seine interdisziplinären wissenschaftlichen Kenntnisse für Studenten und interessierte Laien aufzubereiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
