                                            {
                                                "example_id": "3b6cfa88-307c-4ec6-8b06-4d9a697da1c9",
                                                "sense_id": "1e24e4e5-8f08-36a3-b1f6-060b09a985fe",
                                                "text": "Cédric Nankin appelle donc les médias « à jouer le jeu »."
                                            },
                                            {
                                                "example_id": "af82997c-caae-4caa-b6d8-3b94a4ea833e",
                                                "sense_id": "1e24e4e5-8f08-36a3-b1f6-060b09a985fe",
                                                "text": "Cédric Jimenez choisit une façon très originale de parler des attentats du 13 novembre 2015."
