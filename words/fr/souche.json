    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "696c83d4-bb02-3b9a-b795-838759662ba7",
                    "sense_definition": "Partie inférieure du tronc d'un arbre avec ses racines, restant en terre après que l'arbre a été abattu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arbre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le promeneur s'est assis sur une vieille <w>souche</w> pour reprendre son souffle."
                        },
                        {
                            "text": "Il faut retirer cette grosse <w>souche</w> avant de pouvoir replanter des fleurs dans le jardin."
                        }
                    ],
                    "common_phrases": [
                        "grosse souche",
                        "vieille souche"
                    ]
                },
                {
                    "sense_id": "f44a3804-13fc-3407-aecc-c32b36e5e73b",
                    "sense_definition": "Origine familiale, lignée ou ascendance d'une personne ou d'une communauté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette famille est installée dans la région depuis plusieurs siècles et revendique une ancienne <w>souche</w> locale."
                        },
                        {
                            "text": "Leurs ancêtres ont fait <w>souche</w> dans ce village au début du dix-neuvième siècle."
                        }
                    ],
                    "synonyms": [
                        "lignée",
                        "racine",
                        "ascendance"
                    ],
                    "common_phrases": [
                        "de souche",
                        "faire souche"
                    ]
                },
                {
                    "sense_id": "98708280-d9b5-3148-9fad-40c7d15429a6",
                    "sense_definition": "Variété ou lignée génétique particulière d'un micro-organisme, tel qu'un virus ou une bactérie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs ont identifié une nouvelle <w>souche</w> virale particulièrement contagieuse."
                        },
                        {
                            "text": "Ce laboratoire cultive une <w>souche</w> bactérienne afin de tester de nouveaux antibiotiques."
                        }
                    ],
                    "synonyms": [
                        "lignée"
                    ],
                    "common_phrases": [
                        "souche bactérienne",
                        "souche virale"
                    ]
                },
                {
                    "sense_id": "aaf5f43d-df09-3569-a5b9-005e92104756",
                    "sense_definition": "Partie fixe d'un carnet ou d'un registre qui est conservée après le détachement d'un feuillet ou d'un chèque.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pensez à bien noter le montant sur la <w>souche</w> du carnet de chèques."
                        },
                        {
                            "text": "Le comptable vérifie chaque <w>souche</w> pour s'assurer de la régularité des paiements."
                        }
                    ],
                    "synonyms": [
                        "talon"
                    ],
                    "common_phrases": [
                        "carnet à souche",
                        "souche de chèque"
                    ]
                },
                {
                    "sense_id": "67c2c5af-ff26-36c7-9e8c-bdb4aacaf14a",
                    "sense_definition": "Partie maçonnée d'un conduit de cheminée qui émerge au-dessus du toit d'un bâtiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maçon doit réparer la <w>souche</w> de cheminée qui menace de s'effondrer après la tempête."
                        },
                        {
                            "text": "Des briques rouges ornent la <w>souche</w> visible depuis la rue."
