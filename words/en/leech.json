{
    "word_family": [
        "leechcraft",
        "leechdom",
        "leeching",
        "leechline"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "defd4a5d-6285-3cab-ac44-c15dd39f5a3c",
                    "sense_definition": "An aquatic blood-sucking worm of the subclass Hirudinea, often used historically in medicine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parasitic_organism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While swimming in the murky pond, he felt a small <w>leech</w> attach itself to his ankle.",
                            "target_lang_translations": {
                                "ru": "Плавая в мутном пруду, он почувствовал, как к его лодыжке присосалась маленькая <w>пиявка</w>."
                            }
                        },
                        {
                            "text": "The <w>leech</w> on his leg had swelled to more than five inches long after feeding.",
                            "target_lang_translations": {
                                "ru": "<w>Пиявка</w> на его ноге раздулась более чем на пять дюймов в длину после кормления."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloodsucker"
                    ],
                    "common_phrases": [
                        "medicinal leech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водный кровососущий червь подкласса Hirudinea, исторически использовавшийся в медицине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиявка",
                                "target_lang_sense_clarification": "кольчатый червь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e964472-bb0d-34dc-9e24-644fb0dc765d",
                    "sense_definition": "A person who selfishly takes advantage of others or lives off their resources without giving anything back.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parasitic_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a total <w>leech</w> on society, always asking for money but never looking for a job.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>паразит</w> в обществе: вечно просит денег, но никогда не ищет работу."
                            }
                        },
                        {
                            "text": "She realized her boyfriend was a <w>leech</w> who had spent a lifetime living off her good will.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что её парень был <w>пиявкой</w>, который всю жизнь жил за счёт её доброй воли."
                            }
                        }
                    ],
                    "synonyms": [
                        "parasite",
                        "sponger",
                        "bloodsucker",
                        "vampire"
                    ],
                    "common_phrases": [
                        "leech on society"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a derogatory term for a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который эгоистично пользуется другими или живет за их счет, ничего не отдавая взамен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиявка",
                                "target_lang_sense_clarification": "о человеке-паразите"
                            },
                            {
                                "target_lang_word": "паразит",
                                "target_lang_sense_clarification": "живущий за чужой счет"
                            },
                            {
                                "target_lang_word": "кровосос",
                                "target_lang_sense_clarification": "эксплуататор"
                            },
                            {
                                "target_lang_word": "приживала",
                                "target_lang_sense_clarification": "живущий на чужой милости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                    "sense_definition": "An old-fashioned term for a physician or doctor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_practitioner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the medieval village, the local <w>leech</w> was the only person who knew how to treat wounds.",
                            "target_lang_translations": {
                                "ru": "В средневековой деревне местный <w>лекарь</w> был единственным, кто знал, как лечить раны."
                            }
                        },
                        {
                            "text": "The <w>leech</w> gathered plants with healing balm to prepare a remedy for the sick minister.",
                            "target_lang_translations": {
                                "ru": "<w>Врачеватель</w> собирал целебные травы, чтобы приготовить лекарство для больного священника."
                            }
                        }
                    ],
                    "synonyms": [
                        "doctor",
                        "physician",
                        "healer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a doctor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинное название врача или лекаря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекарь",
                                "target_lang_sense_clarification": "старинное название врача"
                            },
                            {
                                "target_lang_word": "врачеватель",
                                "target_lang_sense_clarification": "архаичный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f8f7630-e208-32e0-989d-6c58f2ab8488",
                    "sense_definition": "The edge of a sail, specifically the vertical edge of a square sail or the aft edge of a triangular sail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor adjusted the <w>leech</w> of the jib to ensure the wind was caught efficiently.",
                            "target_lang_translations": {
                                "ru": "Матрос подтянул <w>шкаторину</w> кливера, чтобы парус лучше ловил ветер."
                            }
                        },
                        {
                            "text": "Sailmakers often trim the <w>leeches</w> of their headsails to a concave profile for better performance.",
                            "target_lang_translations": {
                                "ru": "Мастера по изготовлению парусов часто обрезают <w>лики</w> передних парусов, придавая им вогнутый профиль для лучшей работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leech of the jib"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кромка паруса, в частности вертикальный край прямого паруса или задний край косого паруса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лик",
                                "target_lang_sense_clarification": "морской термин, край паруса"
                            },
                            {
                                "target_lang_word": "шкаторина",
                                "target_lang_sense_clarification": "кромка паруса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b2d898d-1e40-3a2f-bfc8-6491c4997a12",
                    "sense_definition": "A glass tube used in medical contexts to draw blood from tissue using a vacuum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon used a glass <w>leech</w> to carefully remove excess blood from the damaged area.",
                            "target_lang_translations": {
                                "ru": "Хирург использовал стеклянную <w>трубку</w>, чтобы осторожно удалить лишнюю кровь из поврежденной области."
                            }
                        },
                        {
                            "text": "Historical medical kits often included a mechanical <w>leech</w> for bloodletting procedures.",
                            "target_lang_translations": {
                                "ru": "В старинные медицинские наборы часто входила механическая <w>пиявка</w> для процедур кровопускания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стеклянная трубка, используемая в медицине для отсасывания крови из тканей с помощью вакуума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "механическая пиявка",
                                "target_lang_sense_clarification": "медицинский инструмент"
                            },
                            {
                                "target_lang_word": "кровоотсосная трубка",
                                "target_lang_sense_clarification": "инструмент для кровопускания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43b0aec3-339e-3c1c-8834-e8fedbbc3a2f",
                    "sense_definition": "To exhaust or drain resources, money, or energy from someone or something without providing anything in return.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parasitic_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continued to <w>leech</w> off his parents long after he had finished his university studies.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>паразитировать</w> на родителях еще долго после окончания университета."
                            }
                        },
                        {
                            "text": "The corrupt official was caught trying to <w>leech</w> funds from the public treasury.",
                            "target_lang_translations": {
                                "ru": "Коррумпированный чиновник был пойман при попытке <w>выкачать</w> средства из государственной казны."
                            }
                        }
                    ],
                    "synonyms": [
                        "drain"
                    ],
                    "common_phrases": [
                        "leech off someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'off'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Истощать или выкачивать ресурсы, деньги или энергию из кого-либо, не давая ничего взамен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паразитировать",
                                "target_lang_sense_clarification": "жить за чужой счет"
                            },
                            {
                                "target_lang_word": "высасывать",
                                "target_lang_sense_clarification": "деньги или силы"
                            },
                            {
                                "target_lang_word": "сидеть на шее",
                                "target_lang_sense_clarification": "быть иждивенцем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4b124bf-99bf-3a20-a0bc-fe580e98557c",
                    "sense_definition": "To apply a blood-sucking worm to a person for medical purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors decided to <w>leech</w> the patient to reduce the swelling around the wound.",
                            "target_lang_translations": {
                                "ru": "Врачи решили <w>поставить пиявки</w> пациенту, чтобы уменьшить отек вокруг раны."
                            }
                        },
                        {
                            "text": "They <w>leeched</w> him to drain off the bad blood while he was sleeping.",
                            "target_lang_translations": {
                                "ru": "Ему <w>ставили пиявки</w>, чтобы выпустить «плохую кровь», пока он спал."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical medical practices"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикладывать пиявок к человеку в медицинских целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить пиявки",
                                "target_lang_sense_clarification": "медицинская процедура"
                            },
                            {
                                "target_lang_word": "лечить пиявками",
                                "target_lang_sense_clarification": "гирудотерапия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcb6bed7-f040-39dc-9d8a-1bdf4dbf17ea",
                    "sense_definition": "To provide medical treatment, cure, or heal someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was skilled at <w>leeching</w> horses that had fallen sick on the farm.",
                            "target_lang_translations": {
                                "ru": "Старик умел <w>лечить</w> лошадей, заболевших на ферме."
                            }
                        },
                        {
                            "text": "He sought out a specialist to <w>leech</w> his broken leg after the accident.",
                            "target_lang_translations": {
                                "ru": "После аварии он разыскал специалиста, чтобы тот <w>подлечил</w> его сломанную ногу."
                            }
                        }
                    ],
                    "synonyms": [
                        "treat",
                        "cure",
                        "heal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage for healing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать медицинскую помощь, лечить или исцелять (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врачевать",
                                "target_lang_sense_clarification": "архаичный термин для лечения"
                            },
                            {
                                "target_lang_word": "исцелять",
                                "target_lang_sense_clarification": "лечить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "51b817fd-2c34-3a85-9afa-721e8d2a531f",
                    "sense_definition": "A English surname that originally referred to a person's occupation as a <w>leech</w> (physician).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous illustrator John <w>Leech</w> was well known for his work in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Знаменитый иллюстратор Джон <w>Лич</w> был хорошо известен своими работами в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Leech</w> can trace their ancestry back to medieval doctors.",
                            "target_lang_translations": {
                                "ru": "Многие люди с фамилией <w>Лич</w> могут проследить свою родословную до средневековых врачей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от названия профессии врача (leech)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лич",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}