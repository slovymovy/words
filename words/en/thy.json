{
    "word_family": [
        "thou",
        "thee",
        "thine",
        "thyself"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "16c1b65c-8249-370a-a963-76a93a105db8",
                    "sense_definition": "The possessive form of <w>thou</w>; belonging to you (singular).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Love <w>thy</w> neighbor as thyself.",
                            "target_lang_translations": {
                                "ru": "Возлюби ближнего <w>твоего</w>, как самого себя.",
                                "fr": "Aime <w>ton</w> prochain comme toi-même."
                            }
                        },
                        {
                            "text": "To <w>thy</w> own self be true.",
                            "target_lang_translations": {
                                "ru": "Будь верен <w>своему</w> 'я'.",
                                "fr": "Sois fidèle à <w>ton</w> propre moi."
                            }
                        }
                    ],
                    "synonyms": [
                        "thine"
                    ],
                    "common_phrases": [
                        "love thy neighbor",
                        "honor thy father",
                        "with all thy heart"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "standard in older texts, replaced by 'your' in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Притяжательная форма местоимения <w>thou</w>; принадлежащий тебе (единственное число).",
                        "fr": "Forme possessive archaïque de la deuxième personne du singulier; équivalent de 'ton', 'ta' ou 'tes'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твой",
                                "target_lang_sense_clarification": "принадлежащий тебе (устар./поэт.)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ton",
                                "target_lang_sense_clarification": "déterminant possessif (masculin singulier ou féminin commençant par une voyelle)"
                            },
                            {
                                "target_lang_word": "ta",
                                "target_lang_sense_clarification": "déterminant possessif (féminin singulier)"
                            },
                            {
                                "target_lang_word": "tes",
                                "target_lang_sense_clarification": "déterminant possessif (pluriel)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "a83eee3f-ed1b-3d0c-8aae-8abb0aef574a",
                    "sense_definition": "Used in the phrase 'for thy', an alternative form of <w>forthy</w> meaning because or therefore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stayed behind, for <w>thy</w> he was ill.",
                            "target_lang_translations": {
                                "ru": "Он остался, <w>ибо</w> был болен.",
                                "fr": "Il est resté en arrière, <w>car</w> il était malade."
                            }
                        },
                        {
                            "text": "She spoke the truth, for <w>thy</w> I trusted her.",
                            "target_lang_translations": {
                                "ru": "Она говорила правду, <w>поэтому</w> я поверил ей.",
                                "fr": "Elle a dit la vérité, <w>donc</w> je lui ai fait confiance."
                            }
                        }
                    ],
                    "common_phrases": [
                        "for thy"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "found only in Middle English or very archaic texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в словосочетании 'for thy', альтернативной форме <w>forthy</w>, означающей 'потому что' или 'следовательно'.",
                        "fr": "Utilisé dans l'expression 'for thy', une forme archaïque signifiant 'parce que' ou 'donc'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ибо",
                                "target_lang_sense_clarification": "устар. (for thy = forthy): потому что, поэтому"
                            },
                            {
                                "target_lang_word": "поэтому"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "car",
                                "target_lang_sense_clarification": "conjonction de coordination exprimant la cause"
                            },
                            {
                                "target_lang_word": "donc",
                                "target_lang_sense_clarification": "conjonction exprimant la conséquence"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}