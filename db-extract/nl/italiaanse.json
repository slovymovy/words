                                "example_id": "2d108e8a-4ce1-45e1-bca7-9725f628bedc",
                                "sense_id": "695c5576-04c2-3e7f-b320-92dc6e51f578",
                                "text": "Het terras is gevuld met knappe Italiaanse mannen en vrouwen."
