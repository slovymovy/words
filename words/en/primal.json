            "senses": [
                {
                    "sense_id": "6a28e526-45d9-3830-8f94-0189949310c6",
                    "sense_definition": "Relating to an essential, fundamental, or most important level of existence or emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fundamental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound of the drums triggered a <w>primal</w> instinct deep within the crowd.",
                            "target_lang_translations": {
                                "ru": "Звук барабанов пробудил <w>первобытный</w> инстинкт глубоко внутри толпы."
                            }
                        },
                        {
                            "text": "Fear of the dark is a <w>primal</w> fear that many humans share from birth.",
                            "target_lang_translations": {
                                "ru": "Страх темноты — это <w>глубинный</w> страх, который многие люди разделяют с рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "primary"
                    ],
                    "antonyms": [
                        "secondary",
                        "superficial"
                    ],
                    "common_phrases": [
                        "primal fear",
                        "primal instinct",
                        "primal urge"
                    ],
                    "target_lang_definitions": {
