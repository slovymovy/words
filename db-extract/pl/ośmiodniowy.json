                "translations": [
                    {
                        "translation_id": "b2fc60e4-e740-4f74-8640-23fac1931b4a",
                        "source_entry_id": "e2b919ba-0727-3d64-912c-3e2a64d66b19",
                        "source_sense_id": "1de4cf79-3696-33b5-aa45-05e76227e11a",
                        "target_lang_word": "восьмидневный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "восьмидневный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "de8de3af-2570-3136-a06e-59b938ff2d2c",
                                        "entry_id": "bb304473-3b4a-3fd0-a3a1-2005a6ad60b2",
                                        "glosses": [
                                            "длящийся или существующий восемь дней; рассчитанный на восемь дней; охватывающий восемь дней и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38bc0f1-f483-4427-927d-06569f7949d3",
                                                "sense_id": "de8de3af-2570-3136-a06e-59b938ff2d2c",
                                                "text": "Мы проинструктировали его, как уберечь лошадей, транспорт и конвой от инфекции, и после восьмидневного перехода вернулись в начале октября через Орск в Оренбург."
                                            },
                                            {
                                                "example_id": "2966c813-68ed-440c-babf-03ee0d627b2e",
                                                "sense_id": "de8de3af-2570-3136-a06e-59b938ff2d2c",
                                                "text": "В стандартное оборудование входят: датчик внешней температуры, часы с восьмидневным заводом, измеритель наработки двигателя в часах, пять комплектов привязных наплечных ремней с инерционным замком, узлы крепления груза, огнетушитель, аптечка, подножки для пассажиров, колеса для передвижения по земле, розетка внешнего источника питания, посадочный огонь, АНО, проблесковые огни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c164e9c3-f5d8-31fd-af4c-460ff572e29f",
                                        "entry_id": "bb304473-3b4a-3fd0-a3a1-2005a6ad60b2",
                                        "glosses": [
                                            "имеющий возраст восемь дней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638c3522-3586-4be2-a80a-f5d90b9d0827",
                                                "sense_id": "c164e9c3-f5d8-31fd-af4c-460ff572e29f",
                                                "text": "Обрезать тридцатилетнего мужчину совсем не то,что восьмидневного младенца."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
