                    {
                        "sense_id": "606425f7-0065-3af0-ba2f-d6f23a5c6e98",
                        "entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                        "glosses": [
                            "bode die vooruitgestuurd is om de komst van iets of iemand aan te kondigen, voorloper ,aankondiger"
                        ],
                        "tags": [
                            "beroep",
                            "letterlijk"
                        ],
                        "examples": [
                            {
                                "example_id": "8698b2d6-ecd6-42f8-aabe-984692273709",
                                "sense_id": "606425f7-0065-3af0-ba2f-d6f23a5c6e98",
                                "text": "De voorbode kondigde de komst van de koning en de koningin aan."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcff1451-8ee0-3749-b111-91113872f995",
                        "entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                        "glosses": [
                            "iets dat het naderen van een feit in de toekomst bekend maakt, voorteken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "adba7196-d87b-4984-8f39-9a2fd87f7a3f",
                                "sense_id": "dcff1451-8ee0-3749-b111-91113872f995",
                                "text": "De herfst kan als de voorbode van de winter gezien worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9bf3bfc-a590-4839-8591-85be74abf0a9",
                        "source_entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                        "source_sense_id": "606425f7-0065-3af0-ba2f-d6f23a5c6e98",
                        "source_sense_description": "vooruitgestuurde bode (letterlijk)",
                        "target_lang_word": "Vorbote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorbote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "533c951b-4026-3513-ae12-6860f47b7234",
                                        "entry_id": "ffca5745-fd6e-3ca4-9162-d7a653997921",
                                        "glosses": [
                                            "etwas (Vorgang, Person, …), das auf Kommendes schließen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83a87b6-56cf-4ac2-ab66-e0f9952b542d",
                                                "sense_id": "533c951b-4026-3513-ae12-6860f47b7234",
                                                "text": "„Er kam als Vorbote des Kriegsendes.“"
                                            },
                                            {
                                                "example_id": "d75204f3-f7e7-4500-b1a3-64232b04eac2",
                                                "sense_id": "533c951b-4026-3513-ae12-6860f47b7234",
                                                "text": "„Gelahrte Männer haben in ihren Büchern mancherlei über die vielen Vorboten aufgezeichnet, welche die Beulenpest auf Island ankündigten.“"
                                            },
                                            {
                                                "example_id": "58adad2b-2254-4ef8-8bb8-3df4c6630a67",
                                                "sense_id": "533c951b-4026-3513-ae12-6860f47b7234",
                                                "text": "„In aller Welt und zu allen Zeiten hat man Himmelserscheinungen und Erdbewegungen für Vorboten großer, mal guter, mal schlimmer Ereignisse gehalten.“"
                                            },
                                            {
                                                "example_id": "0b19e646-a16b-4c58-bb35-0c969deed03a",
                                                "sense_id": "533c951b-4026-3513-ae12-6860f47b7234",
                                                "text": "„Es war beißend kalt, und die ersten Schneeflocken fielen, begleitet von einem leichten Wind, vielleicht ein Vorbote des Unwetters, das nach Ostern auf sie zukam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de0a34b6-3fd3-4bea-9977-b2694010a2b3",
                        "source_entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                        "source_sense_id": "606425f7-0065-3af0-ba2f-d6f23a5c6e98",
                        "source_sense_description": "vooruitgestuurde bode (letterlijk)",
                        "target_lang_word": "harbinger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harbinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0745d35-d6b7-38d4-aa21-061fa9a1e8c9",
                                        "entry_id": "46360189-1657-3b71-8512-90be40781e24",
                                        "glosses": [
                                            "A person or thing that foreshadows or foretells the coming of someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f44a4b-d75e-440a-ac61-212298c43042",
                                                "sense_id": "e0745d35-d6b7-38d4-aa21-061fa9a1e8c9",
                                                "text": "harbinger of danger; harbinger of doom; harbinger of spring"
                                            },
                                            {
                                                "example_id": "2fc91c54-a381-439c-9a6f-98d96a12d9fe",
                                                "sense_id": "e0745d35-d6b7-38d4-aa21-061fa9a1e8c9",
                                                "text": "Make all our Trumpets ſpeak, giue thẽ all breath / Thoſe clamorous Harbingers of Blood, & Death"
                                            },
                                            {
                                                "example_id": "05d61f56-04e6-496c-8f46-1c338a5b0c76",
                                                "sense_id": "e0745d35-d6b7-38d4-aa21-061fa9a1e8c9",
                                                "text": "I knew by these harbingers who were coming."
                                            },
                                            {
                                                "example_id": "30dab924-fe5b-4f9b-a454-d72622a1e7b7",
                                                "sense_id": "e0745d35-d6b7-38d4-aa21-061fa9a1e8c9",
                                                "text": "It’s to realize that Moon Frye, by cheerfully surveilling her own life, and those first Real Worlders, by agreeing to the constant presence of producers and cameras, were the harbingers of today’s culture, in which self-image is shaped in the expectation of a lens and personhood collates with brand identity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91690336-183e-35fc-9bf7-864767d99d26",
                                        "entry_id": "46360189-1657-3b71-8512-90be40781e24",
                                        "glosses": [
                                            "One who provides lodgings; especially, the officer of the English royal household who formerly preceded the court when travelling, to provide and prepare lodgings."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbcea2f4-160e-439f-b93c-15ab9c0f3727",
                                                "sense_id": "91690336-183e-35fc-9bf7-864767d99d26",
                                                "text": "outward decency […] is the Harbinger to provide the lodging for inward holinesse"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harbinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1930eb84-787a-3687-9699-ac285398382a",
                                        "entry_id": "f4cc9669-7002-3770-927d-d017a9a9c8f2",
                                        "glosses": [
                                            "To announce or precede; to be a harbinger of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a61342-31dd-4b17-bbb5-ed0d6a3f621b",
                                                "sense_id": "1930eb84-787a-3687-9699-ac285398382a",
                                                "text": "It was harbingered also by the terrible comet of January, which appeared in a cadent and obscure house, denoting sickness and death; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6ecb1ac-8f95-4de0-9b71-a80877fd7bee",
                        "source_entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
