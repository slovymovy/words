{
    "word_family": [
        "fellowship",
        "fellowman",
        "bedfellow",
        "playfellow",
        "schoolfellow",
        "workfellow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab96c0e1-c940-337b-91d9-c92866e54a5d",
                    "sense_definition": "A person who is in the same position, involved in the same activity, or has the same interests as you; often used before another noun.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_shared_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoyed discussing the project with her <w>fellow</w> students.",
                            "target_lang_translations": {
                                "ru": "Ей нравилось обсуждать проект со своими <w>товарищами</w> по учебе.",
                                "zh": "她很乐意与<w>同学</w>们讨论这个项目。"
                            }
                        },
                        {
                            "text": "We must work together with our <w>fellow</w> citizens to improve the city.",
                            "target_lang_translations": {
                                "ru": "Мы должны работать вместе с нашими <w>согражданами</w>, чтобы улучшить город.",
                                "zh": "我们必须与<w>同胞</w>们共同努力来改善这座城市。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colleague",
                        "associate",
                        "coworker",
                        "peer",
                        "companion",
                        "comrade"
                    ],
                    "common_phrases": [
                        "fellow citizens",
                        "fellow students",
                        "fellow workers",
                        "fellow travelers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся в том же положении, занимающийся той же деятельностью или имеющий те же интересы, что и вы; часто используется перед другим существительным.",
                        "zh": "指与自己处于相同地位、从事相同活动或有相同兴趣的人；常用于名词前。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "коллега, друг или союзник"
                            },
                            {
                                "target_lang_word": "коллега",
                                "target_lang_sense_clarification": "человек той же профессии"
                            },
                            {
                                "target_lang_word": "собрат",
                                "target_lang_sense_clarification": "человек с той же судьбой или интересами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同伴",
                                "target_lang_sense_clarification": "一起活动或共事的人"
                            },
                            {
                                "target_lang_word": "同事",
                                "target_lang_sense_clarification": "一起工作的人"
                            },
                            {
                                "target_lang_word": "同胞",
                                "target_lang_sense_clarification": "指同一国家或民族的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7527ae6f-8b62-3fe6-ae72-cba8b96540be",
                    "sense_definition": "A man or a boy.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_person_man",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seems like a very nice <w>fellow</w> once you get to know him.",
                            "target_lang_translations": {
                                "ru": "Он кажется очень приятным <w>малым</w>, когда узнаешь его поближе.",
                                "zh": "一旦你了解他，就会发现他是个很不错的<w>家伙</w>。"
                            }
                        },
                        {
                            "text": "That young <w>fellow</w> helped me carry my heavy bags to the car.",
                            "target_lang_translations": {
                                "ru": "Тот молодой <w>парень</w> помог мне донести тяжелые сумки до машины.",
                                "zh": "那个<w>小伙子</w>帮我把沉重的包提到了车上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "man",
                        "guy",
                        "chap",
                        "bloke",
                        "fella"
                    ],
                    "common_phrases": [
                        "nice fellow",
                        "young fellow",
                        "poor fellow",
                        "good fellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина или мальчик.",
                        "zh": "指男人或男孩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "молодой мужчина"
                            },
                            {
                                "target_lang_word": "малый",
                                "target_lang_sense_clarification": "мужчина (разговорное)"
                            },
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "личность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "对男人的非正式称呼"
                            },
                            {
                                "target_lang_word": "小伙子",
                                "target_lang_sense_clarification": "年轻男子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6689e14f-88dd-376a-a9a7-b68c91cc6c6d",
                    "sense_definition": "A senior member of a college or university, or a member of a learned society.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After completing his doctorate, he was appointed as a research <w>fellow</w> at the university.",
                            "target_lang_translations": {
                                "ru": "После получения докторской степени он был назначен <w>научным сотрудником</w> в университете.",
                                "zh": "博士毕业后，他被大学聘为<w>研究员</w>。"
                            }
                        },
                        {
                            "text": "She was elected a <w>fellow</w> of the Royal Society for her contributions to science.",
                            "target_lang_translations": {
                                "ru": "Она была избрана <w>членом</w> Королевского общества за свой вклад в науку.",
                                "zh": "她因对科学的贡献被选为皇家学会的<w>会员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "member",
                        "scholar"
                    ],
                    "common_phrases": [
                        "research fellow",
                        "teaching fellow",
                        "honorary fellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Старший член колледжа или университета, или член научного общества.",
                        "zh": "大学或学院的高级成员，或学术团体的会员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "научный сотрудник",
                                "target_lang_sense_clarification": "должность в университете"
                            },
                            {
                                "target_lang_word": "член общества",
                                "target_lang_sense_clarification": "участник научной организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "研究员",
                                "target_lang_sense_clarification": "学术机构的职位"
                            },
                            {
                                "target_lang_word": "会员",
                                "target_lang_sense_clarification": "学术团体的成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e91a337-d912-3c5d-b0a1-2eee2938a7dc",
                    "sense_definition": "A person or thing that is equal to another in ability, rank, or qualities; a counterpart.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_equal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has no <w>fellow</w> when it comes to playing the violin.",
                            "target_lang_translations": {
                                "ru": "Ей нет <w>ровни</w>, когда дело доходит до игры на скрипке.",
                                "zh": "在拉小提琴方面，她没有<w>对手</w>。"
                            }
                        },
                        {
                            "text": "It is rare to find a <w>fellow</w> to this exquisite piece of jewelry.",
                            "target_lang_translations": {
                                "ru": "Редко можно найти <w>пару</w> этому изысканному ювелирному изделию.",
                                "zh": "很难为这件精美的首饰找到<w>配对物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equal",
                        "match",
                        "peer",
                        "counterpart"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, равный другому по способностям, положению или качествам; аналог.",
                        "zh": "在能力、地位或品质上与他人相等的人或事物；对应物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ровня",
                                "target_lang_sense_clarification": "равный по положению или качествам"
                            },
                            {
                                "target_lang_word": "пару",
                                "target_lang_sense_clarification": "парный предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对手",
                                "target_lang_sense_clarification": "实力相当的人"
                            },
                            {
                                "target_lang_word": "配对物",
                                "target_lang_sense_clarification": "成对出现的另一件物品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aac27741-eed5-3f0a-863b-10e9d7a35a55",
                    "sense_definition": "To associate with someone as a peer or equal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proud king refused to <w>fellow</w> with commoners.",
                            "target_lang_translations": {
                                "ru": "Гордый король отказывался <w>водиться</w> с простолюдинами.",
                                "zh": "傲慢的国王拒绝与平民<w>结交</w>。"
                            }
                        },
                        {
                            "text": "In his mind, he <w>fellowed</w> himself with the greatest poets of the age.",
                            "target_lang_translations": {
                                "ru": "В своих мыслях он <w>ставил</w> себя <w>в один ряд</w> с величайшими поэтами эпохи.",
                                "zh": "在他心中，他将自己与那个时代最伟大的诗人<w>并列</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "associate",
                        "consociate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общаться с кем-либо как с равным.",
                        "zh": "与某人作为同等地位的人交往。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водиться",
                                "target_lang_sense_clarification": "общаться (разговорное)"
                            },
                            {
                                "target_lang_word": "ставить наравне",
                                "target_lang_sense_clarification": "считать равным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结交",
                                "target_lang_sense_clarification": "与人交往"
                            },
                            {
                                "target_lang_word": "并列",
                                "target_lang_sense_clarification": "将自己与他人视为同等"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}