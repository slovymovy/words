                "senses": [
                    {
                        "sense_id": "b5aaf93f-fd33-33e5-bcd9-d5ab0b7028c2",
                        "entry_id": "67c37b33-8d2b-318f-a2dd-615dc39d25b1",
                        "glosses": [
                            "Couteau dont la lame, qui peut être rentrée à l’intérieur du manche en bois, est bloquée par une virole pivotante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb04d50-980d-4bb3-a04f-24784a6b5fa3",
                                "sense_id": "b5aaf93f-fd33-33e5-bcd9-d5ab0b7028c2",
                                "text": "Il n'obtempéra point, se redressant, me fixant droit dans les yeux, sortant sans crier gare un Opinel de sa poche."
                            },
                            {
                                "example_id": "a07ca77d-adad-441f-8444-ace82a8c836f",
                                "sense_id": "b5aaf93f-fd33-33e5-bcd9-d5ab0b7028c2",
                                "text": "Viens faire un tour dans la ruelle\nJ’te montrerai mon Opinel\nJ’te chourav’rai ton blouson »\nMoi j’lui dis : « Laisse béton »"
                            },
                            {
                                "example_id": "fcd9c78e-8f88-462e-b151-cf957bd954cb",
                                "sense_id": "b5aaf93f-fd33-33e5-bcd9-d5ab0b7028c2",
                                "text": "Comme nous portions les mêmes Pataugas, des sacs à dos de la même couleur et des Opinel identiques …, cela faisait de ma femme et moi les membres d'une même tribu aux yeux des Achuar..."
                            }
                        ]
                    }
                ],
