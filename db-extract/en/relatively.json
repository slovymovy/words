                                        "sense_id": "6a7ac23b-6208-3feb-98e3-81b388ab02d2",
                                        "entry_id": "006d114b-68e3-305f-9c89-bb062a11329a",
                                        "glosses": [
                                            "in einem Verhältnis zu etwas oder zu einem Kontext stehend und sich darauf beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa917462-b7c8-4b99-b995-e0f90094cd88",
                                                "sense_id": "6a7ac23b-6208-3feb-98e3-81b388ab02d2",
                                                "text": "Der Tod ist das absoluteste und dabei das relativste aller Phänomene."
                                            },
                                            {
                                                "example_id": "d7b8fbd0-dc7b-4213-95ff-bdcccc1bd97b",
                                                "sense_id": "6a7ac23b-6208-3feb-98e3-81b388ab02d2",
                                                "text": "„Beim Drachenflug ist es besonders wichtig, den Windeinfluss zu berücksichtigen, da schon relativ geringe Gegenwindgeschwindigkeiten zu einer drastischen Verschlechterung der Gleitzahl führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c24c335-a824-3ad0-8354-28e63ff89220",
                                        "entry_id": "006d114b-68e3-305f-9c89-bb062a11329a",
                                        "glosses": [
                                            "in einem Verhältnis zu etwas oder zu einem Kontext stehend und sich darauf beziehend",
                                            "im Vergleich mit einer anderen Größe, abhängig von einer anderen Größe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a27614d-115e-4929-9596-bb2191eefe70",
                                                "sense_id": "8c24c335-a824-3ad0-8354-28e63ff89220",
                                                "text": "Ein Haar auf dem Kopf ist relativ wenig — ein Haar in der Suppe ist relativ viel."
                                            },
                                            {
                                                "example_id": "f254ab92-3a33-4d59-a216-d2248cf76fb7",
                                                "sense_id": "8c24c335-a824-3ad0-8354-28e63ff89220",
                                                "text": "Zehn Euro in der Kollekte sind relativ viel, zehn Euro beim Einkaufen sind relativ wenig."
                                            },
                                            {
                                                "example_id": "97af4ce3-2426-4319-9e8d-cc946d313a01",
                                                "sense_id": "8c24c335-a824-3ad0-8354-28e63ff89220",
                                                "text": "„Man braucht kein Mathematiker zu sein, um zu wissen: Diese Zahl ist die relativste aller Zahlen, die bisher genannt wurden.“"
                                            },
                                            {
                                                "example_id": "9ae2c91f-a73c-4df4-bd1e-b48ad189f15e",
                                                "sense_id": "8c24c335-a824-3ad0-8354-28e63ff89220",
                                                "text": "„Gleitschirm: Ein Naturerlebnis der besonderen Art bietet diese relativ neue Flugsportart.“"
                                            },
                                            {
                                                "example_id": "d92adf71-8f6b-4abe-9138-b5edd7828af6",
                                                "sense_id": "8c24c335-a824-3ad0-8354-28e63ff89220",
                                                "text": "Die relative Luftfeuchte liegt bei 95 %."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ad975020-47ca-319c-bb33-6430dd8d08b6",
                                        "entry_id": "006d114b-68e3-305f-9c89-bb062a11329a",
                                        "glosses": [
                                            "in einem Verhältnis zu etwas oder zu einem Kontext stehend und sich darauf beziehend",
                                            "von nicht unbedeutendem Ausmaß, einigermaßen"
                                        ],
                                        "tags": [
                                            "ohne Steigerung",
                                            "als Adverb verwendet",
                                            "einschränkend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d174587-b094-47e7-b1c1-80737b1f7727",
                                                "sense_id": "ad975020-47ca-319c-bb33-6430dd8d08b6",
                                                "text": "Die Beweisführung der Staatsanwaltschaft war relativ lückenhaft und führte daher nicht zur Verurteilung des Angeklagten."
                                            },
                                            {
                                                "example_id": "c441cc99-e373-4b98-8aae-55aa1ac83ebf",
                                                "sense_id": "ad975020-47ca-319c-bb33-6430dd8d08b6",
                                                "text": "Das ist mir relativ egal!"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "ab4cb594-5cd1-3327-8ca9-6ab522aa652b",
                                        "entry_id": "006d114b-68e3-305f-9c89-bb062a11329a",
                                        "glosses": [
                                            "in einem Verhältnis zu etwas oder zu einem Kontext stehend und sich darauf beziehend",
                                            "auf ein vorher genanntes Wort bezüglich"
