                "senses": [
                    {
                        "sense_id": "3562099c-1e66-3757-9d2e-1b1d02b7978b",
                        "entry_id": "3271fb7f-d502-3dc0-8441-c0f5361a4447",
                        "glosses": [
                            "Verbrennungsmotor, der nach dem von Rudolf Diesel erdachten Prinzip arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a105fd-4a7d-4279-b991-90a11cf9d50a",
                                "sense_id": "3562099c-1e66-3757-9d2e-1b1d02b7978b",
                                "text": "Dieselmotoren muss man vor dem Start vorglühen."
                            },
                            {
                                "example_id": "77458c17-211d-481a-bc2d-b5ec4eb38800",
                                "sense_id": "3562099c-1e66-3757-9d2e-1b1d02b7978b",
                                "text": "„Am Nachmittag sprang der Dieselmotor an, eine schwarze Wolke strich über die Pinasse hinweg, und als die Schiffsleute den lang gestreckten hölzernen Körper mit ihren Staken vom Ufer abdrückten, bemerkte ich ein erregtes Kribbeln im Bauch.“"
                            },
                            {
                                "example_id": "98b9ca67-dbf7-4d2c-a144-423830b5fe13",
                                "sense_id": "3562099c-1e66-3757-9d2e-1b1d02b7978b",
                                "text": "„Der Raum war länglich und schmal, und an der rechten langen Wand stand der Dieselmotor.“"
                            },
                            {
                                "example_id": "8a900712-9bab-48b5-95e2-50d7d61e6840",
                                "sense_id": "3562099c-1e66-3757-9d2e-1b1d02b7978b",
                                "text": "„Der Dieselmotor muß also laufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
