                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7a8cf9-df07-3a32-9333-e1f64c1194d2",
                                        "entry_id": "51314156-549a-3870-9fad-41715e549b15",
                                        "glosses": [
                                            "Nom courant pour l’infarctus du myocarde, nécrose d'une partie du muscle cardiaque pouvant entraîner la mort."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e97360-dc89-42bb-aa50-70fc7bfc8f5d",
                                                "sense_id": "6d7a8cf9-df07-3a32-9333-e1f64c1194d2",
                                                "text": "Et que fait la diplomatie française ? Elle exprime son “émotion”, comme si ces personnes, ces secouristes étaient morts d’une crise cardiaque au cours d’une intervention israélienne ! […] L’hypocrisie atteint des sommets."
                                            }
                                        ]
