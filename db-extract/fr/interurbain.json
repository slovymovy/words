                ],
                "senses": [
                    {
                        "sense_id": "b685f5bc-c1e2-3dff-9d22-22c3d3307a6d",
                        "entry_id": "68c8dfa3-1c82-3f26-889c-1e038d957f4f",
                        "glosses": [
                            "Qui établit des communications d’une ville à une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d93d72-1929-4c4e-a465-8872d0232453",
                                "sense_id": "b685f5bc-c1e2-3dff-9d22-22c3d3307a6d",
                                "text": "Service interurbain, Service téléphonique assurant les communications d’une ville à une autre."
                            },
                            {
                                "example_id": "85e86c8a-7608-4cb0-9053-16a93754f9ba",
                                "sense_id": "b685f5bc-c1e2-3dff-9d22-22c3d3307a6d",
                                "text": "Les communications téléphoniques interurbaines, autorisées au début, provoquèrent de tels encombrements aux cabines publiques et sur les lignes, qu’elles furent totalement suspendues pendant quelques jours, puis sévèrement limitées à ce qu'on appelait les cas urgents, comme la mort, la naissance et le mariage."
                            },
                            {
                                "example_id": "0425f8b5-405f-4ae3-b115-7d47aa81aba3",
                                "sense_id": "b685f5bc-c1e2-3dff-9d22-22c3d3307a6d",
                                "text": "— Je propose de téléphoner sur-le-champ à Llanvygan.\nNous payâmes et sortîmes. Pendant que nous attentions la liaison interurbaine à la poste, Lene se frappa le front."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29a2174b-83cc-45d0-a35c-95fd80067efb",
                        "source_entry_id": "68c8dfa3-1c82-3f26-889c-1e038d957f4f",
                        "source_sense_id": "b685f5bc-c1e2-3dff-9d22-22c3d3307a6d",
                        "target_lang_word": "intercity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intercity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                                        "entry_id": "892d4251-ed4c-3aae-83a5-665c8eb3d956",
                                        "glosses": [
                                            "Between cities; connecting cities with other cities."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d9d0d6-efa2-44f6-b583-b99b32952332",
                                                "sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                                                "text": "I plan to catch an intercity train, or bus."
                                            },
                                            {
                                                "example_id": "fdfb03a7-aa12-4b85-9dec-b771203398f6",
                                                "sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                                                "text": "A “moving platform” scheme […] is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intercity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d309a8ec-1910-35b4-8d93-b86de65a063e",
                                        "entry_id": "77bc0b32-de8a-3b7e-8e77-6979489db023",
                                        "glosses": [
                                            "Something that runs between cities, such as a railroad."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4b06f52-150f-42cc-96c0-7327bffede51",
                        "source_entry_id": "68c8dfa3-1c82-3f26-889c-1e038d957f4f",
                        "source_sense_id": "b685f5bc-c1e2-3dff-9d22-22c3d3307a6d",
                        "target_lang_word": "interurban",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interurban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a71cf682-564e-336e-8bd2-51813e8c2e72",
                                        "entry_id": "900d286f-1232-3295-a62b-df095887c45d",
                                        "glosses": [
                                            "Of, pertaining to, involving or joining two or more urban centres."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38998d6d-1593-4557-9022-8e5e53078278",
                                                "sense_id": "a71cf682-564e-336e-8bd2-51813e8c2e72",
                                                "text": "One of the commercial attachés of the Department of Commerce in South America transmits the name and address of an engineer who desires to receive full information relative to an automotor for an interurban railway."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interurban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                        "entry_id": "515e4a54-3f80-3fb3-83a9-5ae19039d1ae",
                                        "glosses": [
                                            "An electric railway carrying mainly passengers between two or more urban centres."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baf19b37-013c-4b3e-98e6-4dedb7875b82",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "interurban car, interurban line, interurban railroad"
                                            },
                                            {
                                                "example_id": "ef46142e-d642-40be-978d-0f27c1979754",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "On the steam roads, the engine, representing with its tender an enormous weight, is required to generate enough power not only for its own propulsion, but drag after it a train of cars. Several important consequences result from this difference between steam and electric traction. First, on the electric railway single cars may be used, taking their power as required under such headway as may be required to accommodate the traffic, while the steam engine must for the sake of economy be loaded somewhere near its capacity, so that the service is necessarily less frequent than that offered by the interurban."
                                            },
                                            {
                                                "example_id": "bb6b8c20-2f24-41db-b48b-2f65dde6c34b",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "Q. Took the interurban at Denison? A. Yes, sir. Q. And went from there to McKinney on the interurban?"
                                            },
                                            {
                                                "example_id": "30bb574f-d238-410c-b6e6-7ee56161f8ba",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "The act was elective and included the hazardous employments listed (they fill 112 pages of print) and include railroads, mines, interurbans, logging, iron and steel manufacture, packing houses, construction work, etc., etc."
                                            },
                                            {
                                                "example_id": "1e482cf9-c23c-4663-89d6-9c062b7c9e09",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "... but debits and credits arising from the operation of such street electric passenger railways, including railways commonly called interurbans, as are at the time of the agreement not under Federal control, shall be excluded."
                                            },
                                            {
                                                "example_id": "7a2c8999-c932-44c2-b67d-c66418ee60f4",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "Returning to Seattle we took the interurban to Everett, 32 miles north, $1.30 for the round trip"
                                            },
                                            {
                                                "example_id": "419133e8-82e6-48fe-b535-d9ec4a7cfde4",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "In 1945, Vancouver had 347 street cars (not counting interurbans)"
                                            },
                                            {
                                                "example_id": "64b068a0-1372-4eb3-8531-730d121795f7",
                                                "sense_id": "835d8764-5176-3d8b-8e13-99fa213a84e5",
                                                "text": "Why did people ride the interurban? No one knows. If you had asked a rider, he might have said \"Fast, convenient, comfortable, economical“ – yet those are the same reasons that people give for riding in automobiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
