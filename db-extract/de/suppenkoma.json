                "senses": [
                    {
                        "sense_id": "cc0db3a7-14bb-39bb-92ae-0122cae47fd9",
                        "entry_id": "24c432dc-0061-370e-9648-96f7cdcdf285",
                        "glosses": [
                            "Müdigkeit nach dem Verzehr von Lebensmitteln"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "24f48c31-155b-4b43-9d76-db89c6d95625",
                                "sense_id": "cc0db3a7-14bb-39bb-92ae-0122cae47fd9",
                                "text": "„Gegen Zettelwirtschaft und Suppenkoma – Die Zeitmanagement-Branche lehrt, effektiver zu arbeiten und mehr Zeit für das Wesentliche zu haben. Voraussetzung ist die Formulierung einer Lebensvision“"
                            },
                            {
                                "example_id": "5307b068-adba-46dc-80b6-640f20e4b8fd",
                                "sense_id": "cc0db3a7-14bb-39bb-92ae-0122cae47fd9",
                                "text": "„Als Beweis, daß ihm das unterhaltsam gelingt, sieht Sprenger die Terminierung seiner Reden: ‚Um 14 Uhr, direkt nach dem Mittagessen, bin ich die Allzweckwaffe gegen das Suppenkoma.‘“"
                            },
                            {
                                "example_id": "bec6494f-ffbb-4802-b488-953a70a6eec6",
                                "sense_id": "cc0db3a7-14bb-39bb-92ae-0122cae47fd9",
                                "text": "„Unter Dozenten wird die Phase nach der Mittagspause, in der alle Teilnehmer mehr oder weniger müde sind, scherzhaft als Zeit der toten Augen oder als Suppenkoma bezeichnet.“"
                            },
                            {
                                "example_id": "5f4f7f34-f746-4269-94a8-b5e2af480f50",
                                "sense_id": "cc0db3a7-14bb-39bb-92ae-0122cae47fd9",
                                "text": "„Ob ein Trainer lieber ‚Spiele‘ einsetzt, um die Teilnehmer aus dem Suppenkoma zu holen, hängt von seinen persönlichen Vorlieben ab[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
