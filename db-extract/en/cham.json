                    {
                        "translation_id": "8c82b3f0-04ef-4a15-af1a-18489afb4f7d",
                        "source_entry_id": "7dceac6e-e015-3094-8c0d-5f6876f053b0",
                        "source_sense_id": "2523a04f-08bb-33e9-aa50-5d227b8a2f9a",
                        "source_sense_description": "ethnic group",
                        "target_lang_word": "тям",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тям",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "57681cb5-6246-3a86-9816-1f6ce60f8c7c",
                                        "entry_id": "5b1eabe7-f3be-353a-a8c4-928cd847be6c",
                                        "glosses": [
                                            "диал. разум, рассудок, ум"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213c84ab-1c07-414b-be56-2810a5577e7f",
                                                "sense_id": "57681cb5-6246-3a86-9816-1f6ce60f8c7c",
                                                "text": "А у нас-то тяма хватило в своё время это продумать."
                                            },
                                            {
                                                "example_id": "b00a12bf-dc7b-4f91-8cdc-cd87a6cb2e43",
                                                "sense_id": "57681cb5-6246-3a86-9816-1f6ce60f8c7c",
                                                "text": "― Не возьмут они его, тяму не хватит, ― сказал Поварёнок, чтобы нарушить тишину, ― даже если в зимовье окружат…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
