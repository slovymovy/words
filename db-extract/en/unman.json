                "senses": [
                    {
                        "sense_id": "9cd44213-233e-3d37-82f0-a9f3b48b2476",
                        "entry_id": "02839f1b-ed4a-3e07-914c-d0be703aee9e",
                        "glosses": [
                            "To divest of humanity."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d1a781de-15c2-4b69-b6d2-fdbe7d5c7a57",
                                "sense_id": "9cd44213-233e-3d37-82f0-a9f3b48b2476",
                                "text": "Unman not therefore thy self by a beastial transformation, nor realize old Fables."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7428bf7-b4ad-3c34-af7f-2fb675691f9e",
                        "entry_id": "02839f1b-ed4a-3e07-914c-d0be703aee9e",
                        "glosses": [
                            "To castrate; to remove the manhood of."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8a05b420-ce52-4c41-9918-930e82d22e42",
                                "sense_id": "b7428bf7-b4ad-3c34-af7f-2fb675691f9e",
                                "text": "He unmanned himself under a pine-tree and bled to death on the spot."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d71b088-6b4a-3ee7-9f84-c563a4c6d50c",
                        "entry_id": "02839f1b-ed4a-3e07-914c-d0be703aee9e",
                        "glosses": [
                            "To sap (a person) of the strength, whether physical or emotional, required to deal with a situation."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "11a4cbe3-333a-4eb6-8fa3-d7363145070e",
                                "sense_id": "6d71b088-6b4a-3ee7-9f84-c563a4c6d50c",
                                "text": "I hope to God his theories will not unman him in action, that he will not be musing and refining when he should be leading the Jacks […]"
                            },
                            {
                                "example_id": "168bb4f2-53bb-4985-9042-705d04ced5f5",
                                "sense_id": "6d71b088-6b4a-3ee7-9f84-c563a4c6d50c",
                                "text": "He dressed moodily, and left the room to go down to breakfast. Breakfast would at least alleviate this sinking feeling which was unmanning him."
                            },
                            {
                                "example_id": "8aac0ab1-bf02-44a7-be95-9dcb71f221d8",
                                "sense_id": "6d71b088-6b4a-3ee7-9f84-c563a4c6d50c",
                                "text": "Meta has created a vision of life in which, without A.I. aiding his every word, an individual can be left reeling by the simplest of human interactions, unmanned by an ordinary dad joke."
                            }
                        ]
                    },
                    {
                        "sense_id": "63e0194e-3a7e-3a30-95e0-493d3f294b2f",
                        "entry_id": "02839f1b-ed4a-3e07-914c-d0be703aee9e",
                        "glosses": [
                            "To deprive of men."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
