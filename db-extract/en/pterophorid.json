                "senses": [
                    {
                        "sense_id": "b3c390c1-c2a4-3ada-a65b-1a94989f9ce8",
                        "entry_id": "679c62bc-b44d-3326-add3-553b7be5bc4d",
                        "glosses": [
                            "Any moth of the family Pterophoridae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f10117a-39c4-4288-bf5e-a03d583bcefd",
                                "sense_id": "b3c390c1-c2a4-3ada-a65b-1a94989f9ce8",
                                "text": "No kinematic adaptations particular to the extraordinary wing structure of pterophorids are evident, and adjacent wing lobes appear to form a continuous surface (Norberg, 1972b)."
                            },
                            {
                                "example_id": "a73cfcb9-bb71-4531-8a97-e1a763eb42ca",
                                "sense_id": "b3c390c1-c2a4-3ada-a65b-1a94989f9ce8",
                                "text": "Of these, only one pterophorid appeared to probe inside flowers from both species, starting on P. dilatata then moving to P. stricta; however, no pollinia removal or transfer could be seen."
                            }
                        ]
                    }
                ],
