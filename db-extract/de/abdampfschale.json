                "senses": [
                    {
                        "sense_id": "db66cb2c-8ff6-39ab-982d-91d748756d3d",
                        "entry_id": "5b657d60-359a-3632-9603-0a657dd8feac",
                        "glosses": [
                            "flaches Laborgerät zum Erhitzen von Lösungen, meist aus Porzellan, Keramik oder Laborglas bestehend; verwendet, um überschüssiges Wasser oder ein anderes Lösungsmittel zu verdampfen und eine konzentrierte Lösung oder den darin gelösten Stoff zurückzulassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc86b0d7-172a-4910-8b8c-07da2df28ebd",
                                "sense_id": "db66cb2c-8ff6-39ab-982d-91d748756d3d",
                                "text": "„Die Nachweise sind bei den Lösungen aus dem Wasserbad positiv, bei den Lösungen aus der Abdampfschale negativ.“"
                            },
                            {
                                "example_id": "e8992711-7955-4677-a8df-ead45e738940",
                                "sense_id": "db66cb2c-8ff6-39ab-982d-91d748756d3d",
                                "text": "„Durch Nachspülen mit etwas reinem Kältemittel oder reinem Trichloräthylen werden die letzten Spuren des Extraktes in die Abdampfschale übergespült.“"
                            },
                            {
                                "example_id": "99f32b43-fa21-4306-8ba2-82bbb9967e0b",
                                "sense_id": "db66cb2c-8ff6-39ab-982d-91d748756d3d",
                                "text": "„Das Sammeln des Niederschlages in der Abdampfschale ist äußerst mühsam und langwierig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
