                    "sense_definition": "Указывает на нахождение в непосредственной близости от кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он долго стоял <w>возле</w> стола и наблюдал за игрой."
                        },
                        {
                            "text": "Машина припаркована прямо <w>возле</w> входа в здание."
                        }
                    ],
                    "synonyms": [
                        "около",
                        "рядом",
                        "подле"
                    ],
                    "common_phrases": [
