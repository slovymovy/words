                    {
                        "sense_id": "693886af-af25-3b40-b894-953456a22c7e",
                        "entry_id": "537aff38-7e34-38ed-a1db-e7748265d1e9",
                        "glosses": [
                            "Participe passé masculin singulier du verbe aspirer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
