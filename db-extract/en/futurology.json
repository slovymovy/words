                                        "sense_id": "7bb91f37-fece-353f-96a0-08790226060f",
                                        "entry_id": "7375ff6e-9749-34e0-a1b6-3ab72f0c4f21",
                                        "glosses": [
                                            "Étude qui étudie les différents scénarios possibles du futur, à partir des données technologiques, économiques ou sociales du passé et du présent, en se basant sur des techniques et des modèles scientifiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f26e80e-9c74-4679-a10a-39b0de6a88a7",
                                                "sense_id": "7bb91f37-fece-353f-96a0-08790226060f",
                                                "text": "Il existe des problèmes de futurologie où les données historiques ne sont pas d'une grande utilité pour trouver une solution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
