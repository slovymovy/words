                        "source_entry_id": "ba9afbc1-8997-3af0-91e1-3deaa1e09697",
                        "source_sense_id": "0e181998-330b-3b40-8146-1aff2ef5de00",
                        "target_lang_word": "aléatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aléatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06440ffb-1c3f-34fa-899b-5c6850c4c3cf",
                                        "entry_id": "a465d8f8-f508-3735-b781-2df506ddb5d9",
                                        "glosses": [
                                            "Qui se produit par hasard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56fb8a40-4032-45cf-94f1-a0d263a2ff9b",
                                                "sense_id": "06440ffb-1c3f-34fa-899b-5c6850c4c3cf",
                                                "text": "Un phénomène aléatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f4c9ad-391b-3840-915a-4f4bfbbf932b",
                                        "entry_id": "a465d8f8-f508-3735-b781-2df506ddb5d9",
                                        "glosses": [
                                            "Se dit d'une expérience dont l'observateur est dans l'impossibilité de prédire le résultat."
                                        ],
                                        "tags": [
                                            "Probabilités"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64016476-5166-3f5c-95a5-c267cf344919",
                                        "entry_id": "a465d8f8-f508-3735-b781-2df506ddb5d9",
                                        "glosses": [
                                            "Qui est soumis aux aléas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4718bfea-9aa1-4ee1-aeaa-13a790cc0f1a",
                                                "sense_id": "64016476-5166-3f5c-95a5-c267cf344919",
                                                "text": "La navigation sur la côte Est du Groenland est considérée à juste titre comme une des plus protéiformes et aléatoires."
                                            },
                                            {
                                                "example_id": "8fc9d3dc-61ac-4be8-8c99-0f8d9981abdb",
                                                "sense_id": "64016476-5166-3f5c-95a5-c267cf344919",
                                                "text": "Cette pratique n'est pas acceptable car elle sous entend que les gâchées seront réhomogénéisées dans la bétonnière portée (une gâchée sèche pouvant compenser une gâchée humide), ce qui est tout à fait aléatoire."
                                            },
                                            {
                                                "example_id": "04fb116b-a46f-4119-8276-c1096321f11d",
                                                "sense_id": "64016476-5166-3f5c-95a5-c267cf344919",
                                                "text": "Après avoir déposé votre demande, la Ville ne maîtrise pas les délais d’instruction par le CERT (Centre d’expertise et de ressources titres) ainsi que les délais de production par l’imprimerie qui sont très aléatoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aacd24f4-9c61-3dc0-adc1-fd94804c81d6",
                                        "entry_id": "a465d8f8-f508-3735-b781-2df506ddb5d9",
                                        "glosses": [
