                    {
                        "sense_id": "ec374db9-bf57-324d-bbf5-82eaf9d84284",
                        "entry_id": "a5820a5d-b55a-3f5a-88fa-b3613b57191e",
                        "glosses": [
                            "Se dit d’une des grandes familles linguistiques amérindiennes d’Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa37fb04-b45e-40e1-876f-330b435820eb",
                                "sense_id": "ec374db9-bf57-324d-bbf5-82eaf9d84284",
                                "text": "Le cri, l’ojibwa, le naskapi, l’attikamek et le micmac sont des langues algonquiennes."
                            },
                            {
                                "example_id": "12634fae-7c7b-424b-a27f-a1dda58e2b55",
                                "sense_id": "ec374db9-bf57-324d-bbf5-82eaf9d84284",
                                "text": "Les langues algonquiennes dominent l’est du Canada, de la Nouvelle-Écosse aux rives de la baie d’Hudson et même au-delà, le cri étant la plus parlée d’entre elles. Il est toujours utilisé en famille par les deux tiers de ses 93 000 locuteurs."
                            }
                        ]
                    },
