                "senses": [
                    {
                        "sense_id": "f4f0397e-bb7c-3434-a304-47cd25c3f91f",
                        "entry_id": "cb0cc367-3a49-3fc0-abd7-0b739a6e75dc",
                        "glosses": [
                            "Commandement suprême, l’autorité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc9cf88-2004-4e18-84d1-50fdec6066c5",
                                "sense_id": "f4f0397e-bb7c-3434-a304-47cd25c3f91f",
                                "text": "Der aufsehenerregende Marsch der Wagner-Truppe Richtung Moskau war nach Münklers Einschätzung wohl eine Reaktion Prigoschins darauf, dass Russlands Verteidigungsminister Sergej Schoigu alle Söldnertruppen unter das Oberkommando des Militärs stellen wollte.",
                                "translation": "Selon Münkler, la marche spectaculaire de la troupe Wagner en direction de Moscou était probablement une réaction de Prigojine au fait que le ministre russe de la Défense Sergueï Choïgou voulait placer toutes les troupes de mercenaires sous le commandement suprême de l’armée."
                            }
                        ]
                    },
                    {
                        "sense_id": "79cbe440-05cd-3226-ac77-d70a799144a7",
                        "entry_id": "cb0cc367-3a49-3fc0-abd7-0b739a6e75dc",
                        "glosses": [
                            "Commandement suprême, le cercle de personnes qui ont l’autorité dans leurs mains."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
