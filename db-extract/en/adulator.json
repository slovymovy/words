                                    {
                                        "sense_id": "5e3d6d9a-3a8b-3f36-9a52-90c69f72dc79",
                                        "entry_id": "977238e0-6e61-3629-a36c-ba9b15aac561",
                                        "glosses": [
                                            "Celle qui adule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930d3ea2-124f-4d1e-9629-cfbdd2bbefb1",
                                                "sense_id": "5e3d6d9a-3a8b-3f36-9a52-90c69f72dc79",
                                                "text": "Le clergé de ce temps n’était pas si chatouilleux que le nôtre, puisqu’il laissa représenter cette pièce pendant le carême de 1537, dans la ville de Bologne, qu’Arétin nomme la Servante des prêtres et l’adulatrice de leurs débauches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adulatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d1e286-e972-3f9d-872d-3f2100766e86",
                                        "entry_id": "8e8bf046-bfb9-30e3-b693-f24af563f1c1",
                                        "glosses": [
                                            "Féminin singulier de adulateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e035d91d-b33e-4fba-a680-eb2f50711efc",
                                                "sense_id": "b0d1e286-e972-3f9d-872d-3f2100766e86",
                                                "text": "[…] loin de la foule adulatrice des courtisans, il venoit se soustraire aux embarras de la grandeur […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb588083-62ed-44e3-be75-dc57857f7ba7",
