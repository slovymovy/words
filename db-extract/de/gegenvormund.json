                        "glosses": [
                            "(gerichtlich bestellter) Kontrollant/Überprüfer der Arbeit eines eingesetzten Vormunds"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b0bbc003-8b83-4a7b-9555-d30d41c7450e",
                                "sense_id": "52e7ab61-6c74-36c8-857b-66a09b54213b",
                                "text": "„Die zusätzliche Erwähnung der „fiunde“ kann daher schwerlich als ausreichender Beleg für eine neben den Vormündern bestehende eigenständige Kompetenz - insbesondere als Mitvormund oder Gegenvormund - verstanden werden.“"
                            },
                            {
                                "example_id": "d185125b-0e1e-45c8-afba-b17cad187b88",
                                "sense_id": "52e7ab61-6c74-36c8-857b-66a09b54213b",
                                "text": "„Der Gegenvormund soll gehört werden, ehe das Vormundschaftsgericht eine Genehmigung erteilt (§ 1826).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
