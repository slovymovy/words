        "nl-extract.jsonl": [
            {
                "entry_id": "8790d4d6-203e-3055-97f5-dd5a8a230969",
                "word": "anonimiteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "28ce696d-ed04-45af-bc6d-a12038ad050a",
                        "entry_id": "8790d4d6-203e-3055-97f5-dd5a8a230969",
                        "tags": [
                            "plural"
                        ],
                        "form": "anonimiteiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1002a3e1-3a88-3e2c-9554-02606d64ee29",
                        "entry_id": "8790d4d6-203e-3055-97f5-dd5a8a230969",
                        "glosses": [
                            "naamloosheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ba28631-2dc7-495b-821c-e02b5432b480",
                                "sense_id": "1002a3e1-3a88-3e2c-9554-02606d64ee29",
                                "text": "De anonimiteit en vluchtigheid die een verblijf in een hotel normaal gesproken kenmerken, die de sensatie van treurnis en opwinding teweegbrengen dat je tijdelijk in een niemandsland tussen vertrek van huis en thuiskomst verzeild bent geraakt, waar, omdat er niets gebeurt, net zo goed alles zou kunnen gebeuren, en die een man alleen tussen vreemde lakens na een whisky te veel, achterovergeslagen op een kruk aan de bar in de lobby met een laatste slappe grap voor de stoïcijns glazen polerende barman, op het idee kunnen brengen dat er geen haan naar zou kraaien als hij de nachtportier belde met de vraag of hij iemand kende die haar diensten aanbood, waarbij het alleen die whisky te veel is die hem ervan weerhoudt om dat ook echt te doen, zijn hier in Grand Hotel Europa bleke herinneringen aan een moderniteit die zich ver weg van hier afspeelt in een andere wereld."
                            },
                            {
                                "example_id": "2c5d547c-b37b-4eb7-b689-05559321c98b",
                                "sense_id": "1002a3e1-3a88-3e2c-9554-02606d64ee29",
                                "text": "Bewust was ze naar de grote supermarkt gegaan omdat daar de kans op anonimiteit het grootst was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f5f7bcc-6b23-44de-9fde-8a295d35cec0",
                        "source_entry_id": "8790d4d6-203e-3055-97f5-dd5a8a230969",
                        "source_sense_id": "1002a3e1-3a88-3e2c-9554-02606d64ee29",
                        "source_sense_description": "naamloosheid",
                        "target_lang_word": "Anonymität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anonymität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                        "entry_id": "142efd1f-c7e0-356c-8fe3-109a849e3200",
                                        "glosses": [
                                            "Zustand, in dem jemand unerkannt ist, nicht bei seinem Namen genannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2d7d15-ee14-4be7-b13e-ac9bfb0d0953",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Das Allgemeine Persönlichkeitsrecht beinhaltet unter anderem ein Recht auf Anonymität.“"
                                            },
                                            {
                                                "example_id": "1db50104-666f-4ec5-a664-ba909e59231f",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Während das Internet bislang eher ein Meer der Anonymität war, aus dem lediglich Inseln mit namentlicher Nutzernennung ragten, kehrt sich dieses Verhältnis derzeit um.“"
                                            },
                                            {
                                                "example_id": "5498d4e0-6323-420e-8570-c2f8440966c1",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Über Nacht wurde ich aus der Vertrautheit des Dorfes in die Anonymität des Molochs entlassen.“"
                                            },
                                            {
                                                "example_id": "f961fa44-749b-431f-925e-b07e403e6cb5",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Damals waren Rezensionen grundsätzlich unsigniert, weil man fand, dass Anonymität dem Kritiker die Freiheit der unverblümten Äußerung gewährte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aeec586-5dcb-4ed5-9f58-e98d90f06e43",
                        "source_entry_id": "8790d4d6-203e-3055-97f5-dd5a8a230969",
                        "source_sense_id": "1002a3e1-3a88-3e2c-9554-02606d64ee29",
                        "source_sense_description": "naamloosheid",
                        "target_lang_word": "anonymity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anonymity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "715db6fd-ecc3-3188-b61e-c69a58e62335",
                                        "entry_id": "e6cd732e-23bc-3d1e-b495-f0fa65ef7544",
                                        "glosses": [
                                            "The quality or state of being anonymous (nameless or unidentified)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ee6a5f-752e-4893-8101-f7329c9a9f40",
                                                "sense_id": "715db6fd-ecc3-3188-b61e-c69a58e62335",
                                                "text": "Now there are twenty-nine skaters on Wollman Rink\nCircling in singles and in pairs\nIn this vigorous anonymity"
                                            },
                                            {
                                                "example_id": "7c5f10f3-c698-4b51-9ea5-9a7e7d730540",
                                                "sense_id": "715db6fd-ecc3-3188-b61e-c69a58e62335",
                                                "text": "Although the pen-and-paper questionnaires did not require students to give their names, the potential for the teacher to be able to recognise handwriting of individual students led to the perceived loss of anonymity."
                                            },
                                            {
                                                "example_id": "b8715a2b-ae41-4714-a36e-2aeaa7e21cd7",
                                                "sense_id": "715db6fd-ecc3-3188-b61e-c69a58e62335",
                                                "text": "\"It really took off. People would literally come up to me in the street in New York saying 'Hey, Train Daddy, how's it goin'?'\n \"I am quite enjoying the anonymity of London so far...\"\n Given the high-profile task ahead of him, that isn't going to last for long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "660672f1-823f-35db-8b30-9ae9674b2aa7",
                                        "entry_id": "e6cd732e-23bc-3d1e-b495-f0fa65ef7544",
                                        "glosses": [
                                            "That which is anonymous."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c9e9519-d329-44a5-bde0-893560f68380",
                                                "sense_id": "660672f1-823f-35db-8b30-9ae9674b2aa7",
                                                "text": "In one sense the protagonist is the poet himself, but in another sense he is an anonymity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a24c986-a686-3eac-b26b-514ce527dfb5",
                                        "entry_id": "e6cd732e-23bc-3d1e-b495-f0fa65ef7544",
                                        "glosses": [
                                            "The quality or state of being generally unknown, unrecognized, or uncelebrated."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f958e67-42c9-4a86-b1be-2edb42ad4388",
                                                "sense_id": "6a24c986-a686-3eac-b26b-514ce527dfb5",
                                                "text": "The profiteer who through a combine fleeces the public would scorn to wrong a friend or betray those of his own household. The problem then resolves itself into a question of the elimination of the impersonality, the anonymity of modern life that is made an excuse for moral irresponsibility."
                                            },
                                            {
                                                "example_id": "49d7d5bb-97cd-41e2-a6a0-81b26b9ae243",
                                                "sense_id": "6a24c986-a686-3eac-b26b-514ce527dfb5",
                                                "text": "Actually, pin-striped anonymity in the city once seemed a more likely destination. He was a nervous, awkward teenager, six-foot by the age of 12, six-five fully grown, always trying to appear nicer and more orthodox than he felt he really was."
                                            },
                                            {
                                                "example_id": "b24e040a-678a-4fc8-bb7b-e1c0ecca5d2a",
                                                "sense_id": "6a24c986-a686-3eac-b26b-514ce527dfb5",
                                                "text": "Having been propelled from anonymity to global recognition by his role in the first four series of Emily in Paris, Bravo, 36, suggested he might not be involved in the fifth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1d1d33e-f4b5-44cb-bdd7-d153463bead4",
                        "source_entry_id": "8790d4d6-203e-3055-97f5-dd5a8a230969",
                        "source_sense_id": "1002a3e1-3a88-3e2c-9554-02606d64ee29",
                        "source_sense_description": "naamloosheid",
                        "target_lang_word": "anonymat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anonymat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f67ded4f-4d2f-3cfe-a022-80d91f8e025a",
                                        "entry_id": "342a1de8-3c7c-3e4c-a55e-68356fec3c70",
                                        "glosses": [
                                            "Qualité de ce qui est anonyme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c963129-4368-4919-b38e-2acfc9df6f5b",
                                                "sense_id": "f67ded4f-4d2f-3cfe-a022-80d91f8e025a",
                                                "text": "Globalement, cependant, l’anonymat de l’auteur pousse bien à la plainte car elle ferme toute alternative."
                                            },
                                            {
                                                "example_id": "a45e144e-51ce-4a11-ae3a-3fd91a3b5a02",
                                                "sense_id": "f67ded4f-4d2f-3cfe-a022-80d91f8e025a",
                                                "text": "D'autres se perdront, exilés de nulle part, s'oublieront dans un anonymat total, sous un faux nom. Anonymes même dans la mort, parfois."
                                            },
                                            {
                                                "example_id": "9d26cc57-7be3-42b7-b306-a3092d2692f7",
                                                "sense_id": "f67ded4f-4d2f-3cfe-a022-80d91f8e025a",
                                                "text": "Ainsi marchait désormais le monde et Kurtz, qui jouissait jusque-là d'un anonymat total, allait vite se retrouver en tête de gondole du web, lui, une bande de Beatles d'outre-tombe et la fille délurée d'un maire une année d'élections, bref."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
