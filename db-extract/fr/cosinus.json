                "senses": [
                    {
                        "sense_id": "b7350a7b-a751-3717-82aa-f97ef636159e",
                        "entry_id": "23be2848-f593-3904-aab2-690d87cadc0d",
                        "glosses": [
                            "Rapport, dans un triangle rectangle, de la longueur du côté adjacent à l’angle considéré par la longueur de l’hypoténuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf1bdf3-20da-4f95-88b2-490783fea0f0",
                                "sense_id": "b7350a7b-a751-3717-82aa-f97ef636159e",
                                "text": "Si dans un triangle rectangle on abaisse une perpendiculaire du sommet de l'angle droit sur l’hypoténuse, le rapport d'un segment d’hypoténuse à la longueur de l’hypoténuse est égal au carré du cosinus de l'angle adjacent au segment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70e11225-9ecf-42db-bbb6-231587d4bfa2",
                        "source_entry_id": "23be2848-f593-3904-aab2-690d87cadc0d",
                        "source_sense_id": "b7350a7b-a751-3717-82aa-f97ef636159e",
                        "target_lang_word": "Kosinus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosinus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e36e71de-5815-3245-907f-d712674dd486",
                                        "entry_id": "91eff0ec-06b7-3aef-8784-4a25bd9174da",
                                        "glosses": [
                                            "eine Funktion, die in der Trigonometrie eine zentrale Rolle spielt und das Verhältnis der Länge der Ankathete zur Länge der Hypotenuse in einem rechtwinkligen Dreieck angibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6dab64e-006a-421d-863f-9dd87832a701",
                                                "sense_id": "e36e71de-5815-3245-907f-d712674dd486",
                                                "text": "Der Kosinus eines Winkels von 60 Grad ist 0,5."
                                            },
                                            {
                                                "example_id": "5422cda4-8ea9-4203-8541-0296bdc7419a",
                                                "sense_id": "e36e71de-5815-3245-907f-d712674dd486",
                                                "text": "Im rechtwinkligen Dreieck ist der Kosinus eines Winkels das Verhältnis seiner Ankathete und der Hypotenuse."
                                            },
                                            {
                                                "example_id": "d19bb8df-cedd-4f9d-a36c-435e95bef513",
                                                "sense_id": "e36e71de-5815-3245-907f-d712674dd486",
                                                "text": "„Er war jetzt fest davon überzeugt, daß von Sinus und Kosinus nicht die Rede sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
