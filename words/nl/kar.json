                    "sense_definition": "Een auto of ander motorvoertuig.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een mooie nieuwe <w>kar</w> heb je gisteren gekocht!",
                            "target_lang_translations": {
                                "en": "What a beautiful new <w>car</w> you bought yesterday!",
                                "ru": "Какую классную новую <w>тачку</w> ты вчера купил!",
                                "pl": "Ale piękną nową <w>brykę</w> wczoraj kupiłeś!",
                                "de": "Was für eine schöne neue <w>Karre</w> du gestern gekauft hast!",
                                "fr": "Quelle belle <w>bagnole</w> tu as achetée hier !",
                                "it": "Che bella <w>macchina</w> nuova hai comprato ieri!",
                                "cs": "To je ale krásná nová <w>kára</w>, kterou jsi včera koupil!",
                                "tr": "Dün ne kadar güzel yeni bir <w>araba</w> almışsın!",
                                "es": "¡Qué <w>coche</w> tan bonito compraste ayer!",
                                "zh": "你昨天买的这辆新<w>车</w>真漂亮！"
                            }
                        },
                        {
                            "text": "Hij rijdt elke dag in zijn dure <w>kar</w> naar kantoor.",
                            "target_lang_translations": {
                                "en": "He drives his expensive <w>car</w> to the office every day.",
                                "ru": "Он каждый день ездит в офис на своей дорогой <w>тачке</w>.",
                                "pl": "Codziennie jeździ swoją drogą <w>furą</w> do biura.",
                                "de": "Er fährt jeden Tag mit seiner teuren <w>Karre</w> ins Büro.",
                                "fr": "Il va au bureau tous les jours dans sa <w>bagnole</w> coûteuse.",
                                "it": "Va in ufficio ogni giorno con la sua costosa <w>macchina</w>.",
                                "cs": "Každý den jezdí ve své drahé <w>káře</w> do kanceláře.",
                                "tr": "Her gün pahalı <w>arabasıyla</w> ofise gidiyor.",
                                "es": "Él va a la oficina todos los días en su <w>coche</w> caro.",
                                "zh": "他每天都开着他那辆昂贵的<w>车</w>去办公室。"
                            }
                        }
