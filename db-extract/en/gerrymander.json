                    },
                    {
                        "sense_id": "8258c3be-6ebd-3c13-b535-4253bb2fa28d",
                        "entry_id": "2d7de7cf-9bd6-31a5-bb5c-758fb198bb1c",
                        "glosses": [
                            "A voting district skewed by gerrymandering."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "7fae4bdc-bf99-4cf9-831d-bd8e3af23f2e",
                                "sense_id": "8258c3be-6ebd-3c13-b535-4253bb2fa28d",
                                "text": "Any citizen looking at a map of district 12 could immediately tell that it was a gerrymander because of the ridiculous way it cut across four counties while carving up neighborhoods in half."
                            }
                        ]
                    }
                ],
