                        "examples": [
                            {
                                "example_id": "7fadc598-0e98-474b-814d-ebe44faf8d60",
                                "sense_id": "9fce8edb-5708-3b7a-a396-832e4883d7ab",
                                "text": "Babyolifant Madiba is een enorme publiekstrekker bij safaripark Beekse Bergen. De olifant werd gisteren geboren. Vandaag staan er files op de wegen naar het park in Hilvarenbeek en zijn er lange wachtrijen bij de entree."
                            },
                            {
                                "example_id": "5db4e29a-b5b5-41eb-af84-a818d7798d45",
                                "sense_id": "9fce8edb-5708-3b7a-a396-832e4883d7ab",
                                "text": "Ruim twee dagen zaten ze vast in een vijf meter diep waterreservoir: twee volwassen wilde olifanten en een babyolifant. Met een graafmachine is de wand van het waterreservoir gesloopt, waarna de dieren eruit konden komen."
                            }
                        ]
                    }
