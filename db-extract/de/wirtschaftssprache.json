                            {
                                "example_id": "4c28d130-cf2f-4e15-8d3f-95fa54b8871f",
                                "sense_id": "32d2b424-b8b9-32bd-9456-b6a21c8ac706",
                                "text": "„An nächster Stelle rangierte, dass Deutsch eine wichtige Wirtschaftssprache sei und berufliche Vorteile bringen könne.“"
