                ],
                "senses": [
                    {
                        "sense_id": "19b530b7-0b75-39a2-8e9b-7872b679af4e",
                        "entry_id": "572be656-3bc5-31f2-bb9f-cc08e5a0d0d4",
                        "glosses": [
                            "das Zusammenkehren von Laub oder dergleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86e283dd-c7e2-4aae-b432-7cf26aa4c307",
                                "sense_id": "19b530b7-0b75-39a2-8e9b-7872b679af4e",
                                "text": "„Im Herbst bestand ein Spielnachmittag für uns Kinder oft aus vier Stunden Laubharken und abtransportieren, meist belohnt mit köstlichem Kuchen und Kakao.“"
                            },
                            {
                                "example_id": "2976e33b-e2b2-4787-a006-7c756fdc2f06",
                                "sense_id": "19b530b7-0b75-39a2-8e9b-7872b679af4e",
                                "text": "„Als Strafe für den regelwidrigen Einbruch ins Schwimmbad bekamen alle einen Monat Laubharken, Müllsammeln und einen fünfseitigen Aufsatz über die Gefahren stehender Gewässer aufgebrummt.“"
                            },
                            {
                                "example_id": "1c27e945-7756-4472-bd80-679279c0b26c",
                                "sense_id": "19b530b7-0b75-39a2-8e9b-7872b679af4e",
                                "text": "„Laubharken gehörte seit einigen Tagen zu meiner abendlichen Routine, es lockerte die Muskeln nach dem Sitzen am Computer.“"
                            },
                            {
                                "example_id": "1b2dcc68-de14-420f-a02c-ec4295964555",
                                "sense_id": "19b530b7-0b75-39a2-8e9b-7872b679af4e",
                                "text": "„Vor der Kapelle traf die selbst ernannte Friedhofsaufsicht schließlich den Gärtner beim Laubharken an.“"
                            },
                            {
                                "example_id": "bc23f8a9-5394-420a-a57a-ea68e418bd51",
                                "sense_id": "19b530b7-0b75-39a2-8e9b-7872b679af4e",
                                "text": "„Jedesmal, wenn sein Vater ihn zum Laubharken oder Unkrautzupfen mitbrachte, kam sie in Strohhut und Sandalen herbeigelaufen, um zu helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
