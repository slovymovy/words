                                "target_senses": [
                                    {
                                        "sense_id": "f82ca4d5-682a-3a43-b456-97cff11032b1",
                                        "entry_id": "7083d94c-c095-33ee-9f52-d6e8dc262f94",
                                        "glosses": [
                                            "Doctrine, philosophy, body of beliefs or principles belonging to an individual or group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ec51eb-59e2-4995-9676-424ae1f83d10",
                                                "sense_id": "f82ca4d5-682a-3a43-b456-97cff11032b1",
                                                "text": "A dictatorship bans things, that do not conform to its ideology, to secure its reign."
                                            },
                                            {
                                                "example_id": "0a39871e-628c-49dd-8c77-73c7940b669b",
                                                "sense_id": "f82ca4d5-682a-3a43-b456-97cff11032b1",
                                                "text": "This article examines how these three scholars use the term \"Occitan\" and ideologies of Occitanism to characterize southern France, and how such ideologies reflect the intellectual traditions in which they write."
                                            },
                                            {
                                                "example_id": "8db6c182-4a7c-4e20-bb7c-491858b2e006",
                                                "sense_id": "f82ca4d5-682a-3a43-b456-97cff11032b1",
                                                "text": "What is unbearable, in fact, is the feeling, 13 years after 9/11, that America has been chasing its tail; that, in some whack-a-mole horror show, the quashing of a jihadi enclave here only spurs the sprouting of another there; that the ideology of Al Qaeda is still reverberating through a blocked Arab world whose Sunni-Shia balance (insofar as that went) was upended by the American invasion of Iraq."
                                            },
                                            {
                                                "example_id": "27ad0b3e-2e71-49bc-8a29-30b40a7bf3f8",
                                                "sense_id": "f82ca4d5-682a-3a43-b456-97cff11032b1",
                                                "text": "Ideology constantly gets in the way. For the Government, unions are militant \"Trots\" out to cause political trouble. For the unions, the private sector is a grasping, evil leech. Neither is true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "910e3047-f3b6-30de-9545-b08ad8de2f63",
                                        "entry_id": "7083d94c-c095-33ee-9f52-d6e8dc262f94",
                                        "glosses": [
                                            "The study of the origin and nature of ideas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
