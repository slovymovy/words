{
    "word_family": [
        "ambition",
        "ambitionner",
        "ambitieusement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1bad32d3-d639-373a-b46d-dc8a3c15bec4",
                    "sense_definition": "Qui manifeste le désir ardent de réussir, d'obtenir le pouvoir, la gloire ou des honneurs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune chercheuse est très <w>ambitieuse</w> et espère diriger son propre laboratoire un jour."
                        },
                        {
                            "text": "Il est trop <w>ambitieux</w> pour se contenter d'un simple poste subalterne dans cette entreprise."
                        }
                    ],
                    "synonyms": [
                        "audacieux"
                    ],
                    "antonyms": [
                        "modeste"
                    ],
                    "common_phrases": [
                        "jeune ambitieux",
                        "cadre ambitieux"
                    ]
                },
                {
                    "sense_id": "9671eedd-e0d2-3e9e-928d-d633abf8d81e",
                    "sense_definition": "Qui témoigne d'une grande ambition ou vise des objectifs particulièrement élevés et difficiles à atteindre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a lancé un projet <w>ambitieux</w> de rénovation urbaine dans toute la ville."
                        },
                        {
                            "text": "Le gouvernement s'est fixé des objectifs <w>ambitieux</w> pour réduire les émissions de carbone d'ici dix ans."
                        }
                    ],
                    "synonyms": [
                        "audacieux"
                    ],
                    "common_phrases": [
                        "projet ambitieux",
                        "programme ambitieux",
                        "objectif ambitieux"
                    ]
                },
                {
                    "sense_id": "1e8d39a7-15a9-38e2-baf6-36a7be49d1b9",
                    "sense_definition": "Qualifie des formes d'expression ou de discours trop recherchées, manquant de naturel et affectées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son premier roman souffre d'un style <w>ambitieux</w> qui alourdit inutilement la narration."
                        },
                        {
                            "text": "L'orateur a employé des tournures <w>ambitieuses</w> sans parvenir à émouvoir le public."
                        }
                    ],
                    "synonyms": [
                        "prétentieux"
                    ],
                    "antonyms": [
                        "simple",
                        "naturel"
                    ],
                    "common_phrases": [
                        "style ambitieux"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e4e60f7-af46-3fbf-96fc-0009f040f3f4",
                    "sense_definition": "Personne animée par une grande ambition ou le désir de s'élever socialement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>ambitieux</w> est prêt à tout sacrifier pour accéder aux plus hautes fonctions de l'État."
                        },
                        {
                            "text": "Les <w>ambitieux</w> se heurtent souvent à des rivaux tout aussi déterminés qu'eux."
                        }
                    ],
                    "synonyms": [
                        "arriviste"
                    ],
                    "common_phrases": [
                        "un jeune ambitieux"
                    ]
                }
            ]
        }
    ]
}