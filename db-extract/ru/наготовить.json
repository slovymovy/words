                "senses": [
                    {
                        "sense_id": "ca3365ea-217a-33de-bed3-63ce5eb73b7d",
                        "entry_id": "0220afb5-0fb1-3865-873e-54d22ee54a3d",
                        "glosses": [
                            "запасти в каком-либо (обычно большом) количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5fcaa5b-e5d5-4c38-a73d-412cbeaf15a0",
                                "sense_id": "ca3365ea-217a-33de-bed3-63ce5eb73b7d",
                                "text": "А чтобы урожай вырастить, огородину выхолить, сено наготовить, избу поставить ― ох как много надо уметь, знать, стараться!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ca171ed5-b9ae-3877-8767-61846c72cd4a",
                        "entry_id": "0220afb5-0fb1-3865-873e-54d22ee54a3d",
                        "glosses": [
                            "приготовить (кушанье) в каком-либо (обычно большом) количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdfa0b8-e42a-4303-a9cc-48ab7983736b",
                                "sense_id": "ca171ed5-b9ae-3877-8767-61846c72cd4a",
                                "text": "Киргизы наготовили плова, угощали, дружелюбно поглаживали красноармейцев по вылезшим на спинах острым лопаткам."
                            }
                        ]
                    }
                ],
