                    "sense_id": "08c10f6c-6204-3ce0-94b7-bfd56b2813f6",
                    "sense_definition": "onvoltooid deelwoord van <w>grijzen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Langzaam <w>grijzend</w> bracht de oude schilder zijn laatste levensjaren door in rust.",
                            "target_lang_translations": {
