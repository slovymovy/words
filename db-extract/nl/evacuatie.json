        "nl-extract.jsonl": [
            {
                "entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                "word": "evacuatie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "462f63dd-d128-486f-84d8-8fd519547de6",
                        "entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                        "tags": [
                            "plural"
                        ],
                        "form": "evacuaties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2970615-0e20-32d3-8641-8f02deac8686",
                        "entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                        "glosses": [
                            "het weghalen van de burgerbevolking in verband met een bepaalde dreiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91de93bb-72d5-4f21-b898-4911c1396362",
                                "sense_id": "d2970615-0e20-32d3-8641-8f02deac8686",
                                "text": "Later vond ik wat het dichtst bij een antwoord op mijn vraag kwam, haar beschrijving op de eerste briefkaart die ze na onze evacuatie naar haar vrienden had gestuurd: dat het iets verschrikkelijks geweest was om al die dagen alleen in zo'n onrust te zitten."
                            },
                            {
                                "example_id": "a054d80f-6108-4e8c-ac26-cbe53c1028c9",
                                "sense_id": "d2970615-0e20-32d3-8641-8f02deac8686",
                                "text": "Pas hiermee is me duidelijk geworden wat er voorafging aan onze evacuatie en hoe het kwam dat wij op woensdag 4 februari zo abrupt werden weggehaald bij onze heerlijk geurende eerste warme maaltijd in dagen: op die dag begon de grootscheepse evacuatie van de bevolking met 'ducks' en helikopters."
                            }
                        ]
                    },
                    {
                        "sense_id": "f21e18a0-f70d-3401-ac8a-665f722707ad",
                        "entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                        "glosses": [
                            "ontlediging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c851928b-dff4-4074-8160-83cd06a50cdf",
                                "sense_id": "f21e18a0-f70d-3401-ac8a-665f722707ad",
                                "text": "De documenten onthullen dat de regering van president Vladimir Poetin bij de start van de Russische invasie van Oekraïne in 2022 de opdracht had gegeven om kinderen uit weeshuizen mee te nemen naar Rusland. Dat moest gebeuren onder het mom van \"humanitaire evacuaties\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0f241fc-b1f8-4a03-98a8-9ae0460966e6",
                        "source_entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                        "target_lang_word": "Evakuierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evakuierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                        "entry_id": "2a832213-2402-3c93-8774-59119b6de4a3",
                                        "glosses": [
                                            "Entfernung von Menschen aus einer gefährlichen oder gefährdeten Lokalität, zum Beispiel das Räumen einer Wohnung, eines Hauses, Bezirks oder Gebietes von Bewohnern vor, während oder nach Katastrophenfällen, wie Überschwemmungen, Bränden oder Bombenalarmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21bdea32-1960-4875-a93a-b3bd3eadda2a",
                                                "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                                "text": "Die Behörden ordneten aufgrund der drohenden Gefahr eine Evakuierung des Gebäudes an."
                                            },
                                            {
                                                "example_id": "3e658f3a-07d5-4d08-9b4b-fe198ca091ee",
                                                "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                                "text": "Die Evakuierung läuft, die Stadt Aken in Sachsen-Anhalt wird evakuiert. Mehrere tausend Menschen müssen vor dem Hochwasser der Elbe in Sicherheit gebracht werden."
                                            },
                                            {
                                                "example_id": "010b481d-785f-4db7-80ab-8395b96aa86d",
                                                "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                                "text": "„Die Evakuierung verlief überaus schleppend und schlug in eine planlose Flucht um, als die Rote Armee im Januar 1945 erneut vorrückte.“"
                                            },
                                            {
                                                "example_id": "0ae44bc9-c602-4e77-919d-4ce9ac174949",
                                                "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                                "text": "„Irgendwann in der darauffolgenden Woche, als der Plan schon lief, erzählte er ihr, wie er die Evakuierung Winterspelts verhindert hatte.“"
                                            },
                                            {
                                                "example_id": "cba90d11-202e-49f6-b7e3-e49af8178486",
                                                "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                                "text": "„Wo die Rote Armee vorstieß, versuchten Dienststellen der deutschen Verwaltung und der Partei Evakuierungen zu organisieren.“"
                                            },
                                            {
                                                "example_id": "11e130e0-ead7-4305-a7a1-0e88daa5b67c",
                                                "sense_id": "cab52846-1df0-3e30-841b-ee5bdc541c38",
                                                "text": "„Nach der Zerstörung der Bahnstation und einiger Wohnhäuser am Südende von Velda wurde die Evakuierung angeordnet, und die Dörfler machten sich mit Handwagen und Ochsenkarren auf den Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea3a334b-8014-30e2-974c-0e605e4cde8c",
                                        "entry_id": "2a832213-2402-3c93-8774-59119b6de4a3",
                                        "glosses": [
                                            "die Herstellung eines Vakuums in einem Gefäß, zum Beispiel in einer Elektronenröhre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28bbd75-4e15-4f83-83dd-4ad40c8aa4cd",
                                                "sense_id": "ea3a334b-8014-30e2-974c-0e605e4cde8c",
                                                "text": "Durch die Evakuierung des Glasgefäßes wird die Wärmeleitung unterbunden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f299b20-a25d-4991-89b1-a8b511d734af",
                        "source_entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                        "target_lang_word": "evacuation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evacuation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2f50bcc-5d7d-34d7-8f08-aa100f4db587",
                                        "entry_id": "ef8bdc42-f49a-3122-b13a-5939f1493569",
                                        "glosses": [
                                            "The act of evacuating; leaving a place in an orderly fashion, especially for safety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594bc795-fc5a-4999-908c-014635c4290e",
                                                "sense_id": "b2f50bcc-5d7d-34d7-8f08-aa100f4db587",
                                                "text": "The peak of the record-breaking month came during the fourth week, when the railways were called upon to handle the transport side of the official evacuation from the London area. During the first seven days of this evacuation, 175 special trains left the main London termini carrying mothers and children to the safety of the countryside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d0d127-23be-39b3-8123-24cfd607b3d8",
                                        "entry_id": "ef8bdc42-f49a-3122-b13a-5939f1493569",
                                        "glosses": [
                                            "Withdrawal of troops or civils from a town, country, fortress, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c7c2c9-099a-44ad-ac6f-9a21ee450991",
                                                "sense_id": "45d0d127-23be-39b3-8123-24cfd607b3d8",
                                                "text": "The operating difficulties of this evacuation movement were further intensified by the fact that Sunday, June 2, saw the movement of nearly 48,000 children in 70 trains from Kentish and other East Coast towns, and 32 of these trains originated on the Southern Railway. [...] Moreover, during the period of intensive B.E.F. evacuation, the British railways also carried some 20,000,000 passengers and over 6,000,000 tons of freight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be108e8b-cfb6-371c-86fd-d160802a87ed",
                                        "entry_id": "ef8bdc42-f49a-3122-b13a-5939f1493569",
                                        "glosses": [
                                            "The act of emptying, clearing of the contents, or discharging, including creating a vacuum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5830346f-a26a-3bc0-80ca-c4382d199477",
                                        "entry_id": "ef8bdc42-f49a-3122-b13a-5939f1493569",
                                        "glosses": [
                                            "Voidance of any matter by the natural passages of the body or by an artificial opening; defecation; urination; also, a diminution of the fluids of an animal body by cathartics, venesection, or other means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd977b3a-ab22-44fe-b472-932ddce93ede",
                                                "sense_id": "5830346f-a26a-3bc0-80ca-c4382d199477",
                                                "text": "A large evening meal, deep sleep in a better bed than hers, a full evacuation, a hot bath (her own house had only a cold shower), a breakfast of bacon and eggs and sausages from Crabbe's boy — these had smoothed and restored her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1301980-7595-3a09-86d8-f1e08e6db0c1",
                                        "entry_id": "ef8bdc42-f49a-3122-b13a-5939f1493569",
                                        "glosses": [
                                            "That which is evacuated or discharged; especially, a discharge by stool, urine or other natural means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2de8bc4-809f-4508-9481-4c9d68b581c9",
                                                "sense_id": "d1301980-7595-3a09-86d8-f1e08e6db0c1",
                                                "text": "The Abſcess being broken an Ulcer is left behind, which may be known by the Evacuation of Matter by Vomit and Stool"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4674a12-0ee2-3796-af2f-5815af30e092",
                                        "entry_id": "ef8bdc42-f49a-3122-b13a-5939f1493569",
                                        "glosses": [
                                            "Abolition; nullification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d30b75-fdae-4c4b-838d-1b939d38f123",
                                                "sense_id": "c4674a12-0ee2-3796-af2f-5815af30e092",
                                                "text": "evacuation of all Romish ceremonies"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "348d23e5-f65f-4616-b461-d3e8c48018d2",
                        "source_entry_id": "d170bbba-5b8e-300a-9e2f-6c0830b30576",
                        "target_lang_word": "évacuation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évacuation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Action d’évacuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ed6429-30df-45eb-91ed-12c6d339fa7f",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "En outre, la conception de l’autodéschisteur doit être telle que le blocage des dispositifs d’évacuation par la matière à éliminer soit impossible. Il doit être parfaitement automatique."
                                            },
                                            {
                                                "example_id": "1ae12b29-986b-433e-bef9-13b7c7fdafba",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "Les mâchefers doivent être traités avant évacuation. Il faut les refroidir, les broyer, les déferrailler."
                                            },
                                            {
                                                "example_id": "4f877f83-9347-4c37-949c-5484f555ea41",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "Le groupement de Cayenne, avec son hélicoptère et sa vedette de haute mer, concourt aussi à la protection civile, intervenant en cas de sinistre, pour les recherches, le secours et les évacuations sanitaires les plus urgentes."
                                            },
                                            {
                                                "example_id": "9a51847a-6430-49f6-b88a-3dc343a51da3",
                                                "sense_id": "f641d340-d5d5-31bc-97f9-a701b935168d",
                                                "text": "J'auscultais le réservoir et le petit placard. Il ne contenait que des serviettes. La poubelle : des cotons-tiges. Les tuyaux d’évacuation refoulaient du goulot. C'était intenable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Décharge, sortie d’humeurs, d’excréments, ou de matières viciées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2ca8f1-f3a7-4004-af1d-80872ad63407",
                                                "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                                "text": "Il se produisit une évacuation qui le sauva."
                                            },
                                            {
                                                "example_id": "2ecd9ff1-5cfd-42fe-9c7c-14daac51618e",
                                                "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                                "text": "à la suite d’une légère évacuation, il se trouva un peu mieux."
                                            },
                                            {
                                                "example_id": "b65dfcd4-f533-4302-97ea-f1023d1ef46a",
                                                "sense_id": "a8c22133-7a95-30bf-b63d-b57b15547b13",
                                                "text": "Évacuation par haut et par bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Matières évacuées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16c5141-15e7-4ee3-9427-018add935518",
                                                "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                                                "text": "Le médecin, en voyant les évacuations, jugea que le malade était beaucoup mieux."
                                            },
                                            {
                                                "example_id": "bdea0044-a3c5-4c11-bb05-f5fe96321f19",
                                                "sense_id": "5efea0a7-67d2-3acd-b044-cbd0b903b921",
                                                "text": "Seul avec cette enfant de deux mois à peine, qu’il va scrupuleusement voir matin et soir, assistant à son bain, s’informant de ses biberons et de ses évacuations, mais qui n’est encore qu’un petit animal que le cours des événements a mis entre ses mains, et qu’il n’y a pas déjà de raisons d’aimer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Action d’évacuer un pays, une place de guerre, en conséquence d’un traité, d’une capitulation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5d939c-f55b-4f05-9637-184c5a6a26cf",
                                                "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                                                "text": "Quelques gardes nationaux s'efforçaient de calmer l'effervescence populaire, et parlementaient, en vain, avec la troupe, pour obtenir l'évacuation du poste."
                                            },
                                            {
                                                "example_id": "b2a9080b-bbae-4558-8879-f8dbec81b512",
                                                "sense_id": "684e48bc-73e8-37c3-9f2d-7c1b9db9ce9c",
                                                "text": "Il était dit par le traité qu’après l’évacuation de la place, de la province, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88723acf-79fd-30ba-895e-6d81bbc688f1",
                                        "entry_id": "b7b44328-ccac-3e2b-8fb8-6a42c6ed27af",
                                        "glosses": [
                                            "Toute sortie en masse produite par nécessité, par ordre ou par des mesures de force."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c05426-cf76-46fe-ac64-ae4e8d139409",
                                                "sense_id": "88723acf-79fd-30ba-895e-6d81bbc688f1",
                                                "text": "La RATP veut à tout prix éviter les évacuations (lire encadré), qui génèrent des surincidents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b98a77c9-2b0f-4e1f-9f96-ebb4c29a0054",
