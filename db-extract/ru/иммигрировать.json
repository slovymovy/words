                "translations": [
                    {
                        "translation_id": "d5c71abf-7519-4987-af0e-ca0fe91ea56e",
                        "source_entry_id": "afce54c3-b6b7-33a0-8360-ba8be42801d4",
                        "source_sense_id": "102f1d64-bdd0-3627-8575-eaad8cefb742",
                        "target_lang_word": "immigrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immigrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c378dd71-8c07-3e7e-b3aa-c91e56bc1fa1",
                                        "entry_id": "79c564d2-3e66-3501-9186-59c93d448d4b",
                                        "glosses": [
                                            "To move into a foreign country to stay permanently."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "762bd32c-22d2-4455-9b95-4a44be22bac1",
                                                "sense_id": "c378dd71-8c07-3e7e-b3aa-c91e56bc1fa1",
                                                "text": "He knows hardship. He has experienced life in a cold-water flat in Moldova before he immigrated to the States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1401299-a806-476d-afc9-831bc1c05e30",
                        "source_entry_id": "afce54c3-b6b7-33a0-8360-ba8be42801d4",
                        "source_sense_id": "102f1d64-bdd0-3627-8575-eaad8cefb742",
                        "target_lang_word": "einwandern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einwandern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                        "entry_id": "c85bf36b-c35b-370d-b07b-4cafb3482e91",
                                        "glosses": [
                                            "aus einem anderen Land kommen, um sich in einem neuen Land anzusiedeln; beim Einwandern wird die Perspektive des neuen Landes angenommen (beim Auswandern die des alten Landes); meist auf Menschen bezogen, aber auch auf Tiere und Krankheiten angewendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55699b0b-7dd3-42a6-8ef0-6a23a6c36ebd",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "Unsere frühen Vorfahren wanderten vor ca. 40.000 Jahren aus Afrika ein."
                                            },
                                            {
                                                "example_id": "cfd550a0-4ffc-4cda-8865-250556454cd4",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„[Nach dem 'Anwerbestop' der Bundesregierung 1973] wanderten allerdings auch weiterhin Menschen aus der Türkei ein, überwiegend nachziehende Ehepartner und Kinder.“"
                                            },
                                            {
                                                "example_id": "be22ba78-e35c-4186-9a35-6d47906e38b9",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„2017 sind 416.000 Menschen mehr nach Deutschland eingewandert als von dort weggezogen. […] Im vergangenen Jahr wanderten demnach 1,55 Millionen Männer, Frauen und Kinder ein, während 1,14 Millionen Menschen die Bundesrepublik verließen.“"
                                            },
                                            {
                                                "example_id": "11352dc3-9a83-4562-8d3e-83bf8bc62623",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„Um genügend Arbeitskräfte in Deutschland zu haben, müssen netto 400.000 Menschen einwandern, ergaben Berechnungen des Instituts für Arbeitsmarkt- und Berufsforschung (IAB).“"
                                            },
                                            {
                                                "example_id": "0dc3c3be-5da4-4e2c-b47e-7ccf787b897f",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„Sein Vater wanderte in die USA ein und wurde dort zu einem Geschäftsmann.“"
                                            },
                                            {
                                                "example_id": "602c12ac-a98c-4f36-b65e-05eef7e29ca4",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„Englischkenntnisse, hervorragende Qualifikation, Erfolge, hoch bezahlte Jobangebote und gutes Einkommen – Leistung soll nach den Vorstellungen des US-Präsidenten [Donald Trump] künftig ausschlaggebend sein, um in die USA einwandern zu können.“"
                                            },
                                            {
                                                "example_id": "07741ed3-2b71-487c-a557-4d7f872a86ec",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„Greta Zelener war sechs Jahre alt, als sie mit ihrer Familie 1996 nach Deutschland eingewandert ist.“"
                                            },
                                            {
                                                "example_id": "e2890e17-85c3-4976-a2e5-c9bfae5f8085",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„»[…] die Schriftsprache korrekt zu lernen ist für Personen, die nach der Pubertät eingewandert sind, sicher eine große Herausforderung.«“"
                                            },
                                            {
                                                "example_id": "50c0439d-1a30-47e5-9544-3325dd41ce2b",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„Asiatische Tigermücken wandern bei uns ein – und mit ihnen das Risiko gefährlicher Tropenkrankheiten.“"
                                            },
                                            {
                                                "example_id": "9a116980-4ed4-4425-9823-e4d74a021cf3",
                                                "sense_id": "4e0e7825-a79c-3a9f-863d-93bf8072ed5b",
                                                "text": "„Sobald Wölfe in eine Gegend einwandern, müssen sich Schäfer und Ziegenhalter darauf einstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42852b62-b5f0-45d5-a58f-dcd84e241ec7",
                        "source_entry_id": "afce54c3-b6b7-33a0-8360-ba8be42801d4",
                        "source_sense_id": "102f1d64-bdd0-3627-8575-eaad8cefb742",
                        "target_lang_word": "immigrieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immigrieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                        "entry_id": "0f40f2bb-226d-3dde-8e99-e3af88d462af",
                                        "glosses": [
                                            "ins Inland aus einem anderen Land zum dauernden Aufenthalt übersiedeln"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "580946d7-724f-45e0-89dd-0de4c5e4f074",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "25 Prozent sind nicht in Australien geboren, 25 Prozent haben Mutter und/oder Vater, die immigriert sind, meist aus Europa."
                                            },
                                            {
                                                "example_id": "0f2634a3-3b2f-4017-a276-c0a93c33d00a",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "Die Hausmeister, meist aus Südamerika immigriert, haben ihre Wohn- und Arbeitsplätze mit Geschenken der Bewohner und Erinnerungen an ihre Heimat dekoriert."
                                            },
                                            {
                                                "example_id": "2faf7018-89f9-4d58-9277-2da69736c283",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "Auch sei ein Vergleich der Muslime in den verschiedenen Ländern in Westeuropa ganz schwer, da sie aus unterschiedlichen Ländern immigriert seien."
                                            },
                                            {
                                                "example_id": "4c00b550-122a-4f80-8693-829d1f17c298",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "Andy Warhol - ursprünglich Andrew Warhola - wuchs in sehr ärmlichen Verhältnissen auf. Er wurde 1928 als jüngster Sohn russischer Bauern, die in die USA immigriert waren, geboren."
                                            },
                                            {
                                                "example_id": "4b850d93-bac1-4dd9-a6a1-c880a22095dc",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "Die Südeuropäer, die seit Beginn der Krise 2008/09 immigriert sind, flüchten nicht nur vor der Arbeitslosigkeit."
                                            },
                                            {
                                                "example_id": "d6528010-1c6c-4e09-8702-9c5c2799e965",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "In seiner Predigt erinnerte der Papst dann an diejenigen, „die in der Gesellschaft den Schmerz des Elends, der Ausbeutung und des Menschenhandels spüren, (…) die Verachtung erfahren, weil sie immigriert sind, heimatlos ohne Heim und Familie“."
                                            },
                                            {
                                                "example_id": "eccda703-dce3-4968-927f-2b67ecd7a2d9",
                                                "sense_id": "f2595cc6-3494-366c-ac95-563444eb20ee",
                                                "text": "2010 sind laut OECD 98.300 Menschen nach Österreich immigriert, während 66.400 auswanderten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
