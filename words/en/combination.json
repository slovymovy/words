                    "target_lang_definitions": {
                        "ru": "Выборка элементов из множества, где порядок не имеет значения",
                        "zh": "从集合中选取元素，且顺序无关的数学概念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "组合",
                                "target_lang_sense_clarification": "数学中的组合概念"
                            }
                        ]
                    }
                },
                {
