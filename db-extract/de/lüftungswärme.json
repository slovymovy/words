                "senses": [
                    {
                        "sense_id": "07a8022e-8661-3f70-8586-e9bb1685db16",
                        "entry_id": "1ababfd3-1b76-3500-b30f-f107d3d531ae",
                        "glosses": [
                            "thermische Energie, die kalter Luft zugeführt wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a5717a53-fd9f-476a-afbe-1911f865f225",
                                "sense_id": "07a8022e-8661-3f70-8586-e9bb1685db16",
                                "text": "„Eine weitere Minderung der Lüftungswärme und insbesondere auch der Lüftungsgeräusche kann durch Überlagerung eines Tag-/Nacht-Betriebes mittels Nachtabsenkgerät NAG erreicht werden.“"
                            },
                            {
                                "example_id": "85e7b436-1a77-4b12-a8af-f5063180ffb7",
                                "sense_id": "07a8022e-8661-3f70-8586-e9bb1685db16",
                                "text": "„Unter Verlust durch Lüftungswärme versteht man den Wärmeverlust durch offene Türen und Fenster und kann beispielsweise durch die Installation einer Anlage zur Wärmerückgewinnung deutlich verringert werden.“"
                            },
                            {
                                "example_id": "4a124ced-63b2-4318-87a7-919ab5d522ef",
                                "sense_id": "07a8022e-8661-3f70-8586-e9bb1685db16",
                                "text": "„Damit das Raumklima optimal ist und möglichst wenig Lüftungswärme verloren geht, müssen Abluft und Zuluft gut geregelt sein.“"
                            },
                            {
                                "example_id": "61b7cbf1-7150-47e2-87b9-6d0a479cef76",
                                "sense_id": "07a8022e-8661-3f70-8586-e9bb1685db16",
                                "text": "„Dank hoher Dämmqualität und der Rückgewinnung von Lüftungswärme lässt sich der Energiebedarf in Effizienz- und Passivhäusern deutlich reduzieren.“"
                            },
                            {
                                "example_id": "0c4c73c2-7907-434d-929a-11695291cd0d",
                                "sense_id": "07a8022e-8661-3f70-8586-e9bb1685db16",
                                "text": "„Das Fraunhofer Institut für Bauphysik hat für eine Modellwohnung den Unterschied im Gesamtenergiebedarf für die Lüftungswärme zwischen der Aereco Lüftung und einer Zu- und Abluftanlage mit WRG berechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
