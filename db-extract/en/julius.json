                                "target_senses": [
                                    {
                                        "sense_id": "6b6d18d5-cc70-3352-a797-8ffc11237c56",
                                        "entry_id": "1a9b2049-39e7-3258-a4eb-133fdada857d",
                                        "glosses": [
                                            "mužské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f48a0ab-1725-44bc-ad08-bc128e65a700",
                                                "sense_id": "6b6d18d5-cc70-3352-a797-8ffc11237c56",
                                                "text": "Caesarův otec, Gaius Julius Caesar starší, dosáhl pouze hodnosti praetora, třebaže jeho švagrem byl Gaius Marius."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5f7ce12-6869-4ac7-80d9-54c12cb58218",
