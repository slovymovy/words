                    {
                        "sense_id": "00c3e4b0-fd5a-3467-b8a0-f6fcf67bdfdd",
                        "entry_id": "c8eca9b1-17a1-3d5f-bf45-727e7937ee4b",
                        "glosses": [
                            "religiöse Praktik in Westafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1ae18c3-ede8-453c-921b-90ff35056516",
                                "sense_id": "00c3e4b0-fd5a-3467-b8a0-f6fcf67bdfdd",
                                "text": "„›Wie albern‹, höhne ich. ›Eine ganze Stadt soll sich zusammengerottet haben, um junge Burschen für Juju zu missbrauchen?‹“"
                            },
                            {
                                "example_id": "43ec71e6-03fd-4777-9e0d-f5402ae62105",
                                "sense_id": "00c3e4b0-fd5a-3467-b8a0-f6fcf67bdfdd",
                                "text": "„›Sie hat Juju angewandt, um meinen Mann nutzlos zu machen!‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
