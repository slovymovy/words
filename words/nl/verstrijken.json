    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1b239ed-43d3-3f03-8258-1c8d9e55d07c",
                    "sense_definition": "het ten einde lopen of ongeldig worden van een bepaalde tijdsduur of termijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd_verloop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ultimatum <w>verstreek</w> zonder dat er iets gebeurde.",
                            "target_lang_translations": {
                                "en": "The ultimatum <w>expired</w> without anything happening.",
                                "ru": "Ультиматум <w>истек</w>, но ничего не произошло."
                            }
                        },
                        {
                            "text": "Je moet de rekening betalen voordat de termijn zal <w>verstrijken</w>.",
                            "target_lang_translations": {
                                "en": "You must pay the bill before the term <w>expires</w>.",
                                "ru": "Вы должны оплатить счет до того, как срок <w>истечет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflopen"
                    ],
                    "common_phrases": [
                        "termijn verstrijken",
                        "deadline verstrijken"
                    ],
                    "target_lang_definitions": {
                        "en": "the ending or becoming invalid of a specific period of time or term",
                        "ru": "истечение срока действия или окончание определенного периода времени"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expire",
                                "target_lang_sense_clarification": "of a deadline or contract"
                            },
                            {
                                "target_lang_word": "lapse",
                                "target_lang_sense_clarification": "of a period or right"
                            },
                            {
                                "target_lang_word": "run out",
                                "target_lang_sense_clarification": "of time or a term"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "о сроке действия, договоре или времени"
                            },
                            {
                                "target_lang_word": "заканчиваться",
                                "target_lang_sense_clarification": "о периоде времени или сроке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2401bf60-96b3-33ed-b216-670eb74f40c4",
                    "sense_definition": "het ongemerkt voorbijgaan van de tijd in het algemeen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd_verloop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel mannen worden met het <w>verstrijken</w> van de jaren star en minder flexibel.",
                            "target_lang_translations": {
                                "en": "Many men become rigid and less flexible with the <w>passing</w> of the years.",
                                "ru": "Многие мужчины с <w>прохождением</w> лет становятся жесткими и менее гибкими."
                            }
                        },
                        {
                            "text": "Men zou het <w>verstrijken</w> van de tijd en het verlies van alle dingen kunnen aanvaarden.",
                            "target_lang_translations": {
                                "en": "One could accept the <w>passage</w> of time and the loss of all things.",
                                "ru": "Можно принять <w>течение</w> времени и утрату всего сущего."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflopen"
                    ],
                    "common_phrases": [
                        "verstrijken van de tijd",
                        "verstrijken van de jaren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt als gesubstantiveerd infinitief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the passing of time in a general or unnoticed way",
                        "ru": "незаметное течение или прохождение времени в целом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "of time or years"
                            },
                            {
                                "target_lang_word": "elapse",
                                "target_lang_sense_clarification": "formal, of time"
                            },
                            {
                                "target_lang_word": "go by",
                                "target_lang_sense_clarification": "of time"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "о времени или годах"
                            },
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "существительное, описывающее ход времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a7350aa-38a6-3091-bf8a-ae5421ef5fed",
                    "sense_definition": "het volledig opmaken van een vloeistof of pasta door deze uit te smeren",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder moest de laatste restjes verf <w>verstrijken</w> om de muur af te krijgen.",
                            "target_lang_translations": {
                                "en": "The painter had to <w>spread</w> the last bits of paint to finish the wall.",
                                "ru": "Маляру пришлось <w>размазать</w> последние остатки краски, чтобы закончить стену."
                            }
                        },
                        {
                            "text": "Je kunt de hele pot pasta <w>verstrijken</w> over het oppervlak.",
                            "target_lang_translations": {
                                "en": "You can <w>spread</w> the whole jar of paste over the surface.",
                                "ru": "Вы можете <w>распределить</w> всю банку пасты по поверхности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "using up a liquid or paste completely by spreading it out",
                        "ru": "полное использование жидкости или пасты путем их размазывания по поверхности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spread out",
                                "target_lang_sense_clarification": "to use up by smoothing"
                            },
                            {
                                "target_lang_word": "smooth out",
                                "target_lang_sense_clarification": "a substance over a surface"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "размазывать",
                                "target_lang_sense_clarification": "распределять вещество по поверхности"
                            },
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "равномерно наносить слой материала"
                            }
                        ]
