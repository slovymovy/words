                        "entry_id": "b98a876d-695b-3e5c-afd6-23d812a047f8",
                        "glosses": [
                            "geräteseitiges Verbindungselement zwischen einem Elektrogerät und der allgemeinen Stromversorgung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe9edab9-9fb4-4d55-bbaa-46e381534663",
                                "sense_id": "f4a8f08d-e07a-36dd-932b-3505301b2c62",
                                "text": "Fassen Sie den Netzstecker nie mit nassen Händen an."
                            },
                            {
                                "example_id": "f3b0f84e-f71d-42de-912a-c64d2dc3cc03",
                                "sense_id": "f4a8f08d-e07a-36dd-932b-3505301b2c62",
                                "text": "„Michaela L***** zog daraufhin den Netzstecker, der hinter einer Wand unmittelbar links der Ente montiert war.“"
                            },
                            {
                                "example_id": "567c99e5-4b46-4ea7-8073-d6d7fbeb2fd3",
                                "sense_id": "f4a8f08d-e07a-36dd-932b-3505301b2c62",
                                "text": "„Wird man als Anwesender Zeuge eines Stromschlags, so gilt folgende wichtigste Regel: Stromfluss unterbrechen, indem man das Gerät abschaltet, den Netzstecker zieht oder die Sicherung entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
