                "translations": [
                    {
                        "translation_id": "cdff01f3-2ab6-4579-bf98-7c94443d4904",
                        "source_entry_id": "53f9f766-c0ff-36bb-9d76-0ac384e63111",
                        "source_sense_id": "3b6d6d91-5144-3a6d-8d79-7ea751bfb38a",
                        "target_lang_word": "hindrance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hindrance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58da9023-e342-34ea-926c-2db172dab684",
                                        "entry_id": "5cb589d0-dd79-3e8a-9f34-3c90a3b4983d",
                                        "glosses": [
                                            "Something which hinders: something that holds back or causes problems with something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebf1c2e-2c10-4dc3-a3e3-2c5662d840a4",
                                                "sense_id": "58da9023-e342-34ea-926c-2db172dab684",
                                                "text": "High-heeled shoes may be fashionable, but they can also be a hindrance to walking."
                                            },
                                            {
                                                "example_id": "7443f55f-5c87-4106-bfcb-fc1c999add85",
                                                "sense_id": "58da9023-e342-34ea-926c-2db172dab684",
                                                "text": "The L.C.C. [London County Council] considers viaducts in London objectionable and a hindrance to town planning and would like to abolish all the Southern Railway lines on viaducts in South London. [Nothing much happened, they still exist.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7920419-fb2a-350d-955a-5b9fdb9970af",
                                        "entry_id": "5cb589d0-dd79-3e8a-9f34-3c90a3b4983d",
                                        "glosses": [
                                            "The state or act of hindering something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b5872b-8bc2-492c-a8f3-5a9842bbd3ce",
                                                "sense_id": "a7920419-fb2a-350d-955a-5b9fdb9970af",
                                                "text": "Your hindrance of this process will not be tolerated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edd0d1a0-622f-4726-b0df-02f400531812",
                        "source_entry_id": "53f9f766-c0ff-36bb-9d76-0ac384e63111",
                        "source_sense_id": "3b6d6d91-5144-3a6d-8d79-7ea751bfb38a",
                        "target_lang_word": "stymie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stymie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165c9be7-065e-3d88-b7ad-6cbd1714bd5f",
                                        "entry_id": "91188316-4578-3a89-864f-2ad7e91f6675",
                                        "glosses": [
                                            "A situation where an opponent's ball is directly in the way of one's own ball and the hole, on the putting green (abolished 1952)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4baf77e8-7b3e-3bd1-a99e-dc55d4e2c161",
                                        "entry_id": "91188316-4578-3a89-864f-2ad7e91f6675",
                                        "glosses": [
                                            "An obstacle or obstruction."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5433d8f5-22f1-4f3b-a8b4-4dc9b64282cd",
                                                "sense_id": "4baf77e8-7b3e-3bd1-a99e-dc55d4e2c161",
                                                "text": "Mary, will you be mine? Shall we go round together? Will you fix up a match with me on the links of life which shall end only when the Grim Reaper lays us both a stymie?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stymie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                        "entry_id": "2fe72ac9-9221-38c8-b791-cb4f442f6c3d",
                                        "glosses": [
                                            "To thwart or stump; to cause to fail or to leave hopelessly puzzled, confused, or stuck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e986c0bb-cc9c-4585-af9e-6f43c8992477",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "They had lost the key, and the lock stymied the first three locksmiths they called."
                                            },
                                            {
                                                "example_id": "d40c511f-5c05-43ad-b8b3-6a3f046ff455",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "If writing dates has you stymied at times, it is probably for one of two reasons. https://www.grammarly.com/blog/how-to-write-dates/"
                                            },
                                            {
                                                "example_id": "537a19a6-dbdc-4b83-95cd-72c36cf8a914",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "It constrained governments, businesses and labour unions to collaborate in planning increased rates of output and the conditions likely to facilitate them. And above all, it blocked any return to the temptations that had so stymied the inter-war economy: under-production, mutually destructive protectionism, and a collapse of trade."
                                            },
                                            {
                                                "example_id": "8eb6639d-e141-4058-ac54-cc8018cd287a",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "I was making such a drama in my head it was stymieing me."
                                            },
                                            {
                                                "example_id": "96cd79f5-d21a-467f-bfbe-6d15a1656bc4",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "In populations that have “burst” and “path” structures, for example, individuals can never occupy positions in the graph that their ancestors held. Those structures stymie evolution by denying advantageous mutations any chance to take over a population."
                                            },
                                            {
                                                "example_id": "64c2c791-7bdf-46cc-9343-03cf9588b301",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "For all his faults and grandstanding, however, Prescott genuinely cared - and his ambitious plans for tram schemes and railway extensions were stymied by lack of support from Downing Street."
                                            },
                                            {
                                                "example_id": "b7790a16-7186-41a3-92b5-3ea9dd70865b",
                                                "sense_id": "23d615dc-eabe-30ce-a6db-96cf11e54077",
                                                "text": "Since Israel’s ground war began in Gaza over a year and a half ago, it has followed a consistent pattern of raiding key militant strongholds and then withdrawing forces, alongside periodic stymieing of food aid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31dfcb1c-815f-3cfc-b7f9-0e07f82f7b57",
                                        "entry_id": "2fe72ac9-9221-38c8-b791-cb4f442f6c3d",
                                        "glosses": [
                                            "To bring into the position of, or impede by, a stymie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aaef756-088d-4756-80bc-36eb98226076",
                        "source_entry_id": "53f9f766-c0ff-36bb-9d76-0ac384e63111",
                        "source_sense_id": "3b6d6d91-5144-3a6d-8d79-7ea751bfb38a",
                        "target_lang_word": "impediment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impediment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                        "entry_id": "257ef695-dcb2-3ecc-9802-755c7fa17fb0",
                                        "glosses": [
                                            "A hindrance; that which impedes or obstructs progress; impedance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71d82a2-02ea-46d3-871d-7e303a913f89",
                                                "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                                "text": "I require and charge you (as you will aunswere at the dreadefull daye of iudgemente, when the secretes of all hartes shalbee disclosed) that if either of you doe knowe any impedimente why ye maie not bee lawfully ioyned together in matrimonie, that ye confesse it."
                                            },
                                            {
                                                "example_id": "7ac7e0d1-c8e8-49a2-8cc3-29e614b224f9",
                                                "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                                "text": "Thus far into the bowels of the land\nHave we marched on without impediment."
                                            },
                                            {
                                                "example_id": "6ea30f36-540d-4066-a7c0-941b458a9f1d",
                                                "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                                "text": "Your kind Deſire to knovv the State of my Health had not been unſatiſfied of ſo long, had not that ill State been the Impediment."
                                            },
                                            {
                                                "example_id": "d3a96ae4-aedc-4aaf-94cd-53c782c6ffdc",
                                                "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                                "text": "I had gazed upon the fortifications and impediments that seemed to keep human beings from entering the citadel of nature, and rashly and ignorantly I had repined."
                                            },
                                            {
                                                "example_id": "d2bb9a80-518a-44b3-b42f-ff41d480b4a2",
                                                "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                                "text": "Patterns incised on this mineral form seem to evade the eye; you have to stand at a certain distance, and in a particular light, to make them out. This impediment is part of the charm for him."
                                            },
                                            {
                                                "example_id": "a8d9d0bc-d776-46d0-a57c-6234a1a84ea9",
                                                "sense_id": "eda3a809-9640-3a31-a775-950955ae6a53",
                                                "text": "In the run-up to his return to the White House next Monday, Mr. Trump has rattled the world, and America’s neighborhood in particular, with a list of objectives – buying Greenland, seizing the Panama Canal, making Canada the 51st state – that treat friendly nations as weak interlocutors and impediments to be subdued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51526b5b-8ed4-375a-8d5a-f2a6bbe49789",
                                        "entry_id": "257ef695-dcb2-3ecc-9802-755c7fa17fb0",
                                        "glosses": [
                                            "A disability, especially one affecting the hearing or speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f1ff5a-dcdf-4981-8e13-80dded9e7859",
                                                "sense_id": "51526b5b-8ed4-375a-8d5a-f2a6bbe49789",
                                                "text": "Working in a noisy factory left me with a slight hearing impediment."
                                            },
                                            {
                                                "example_id": "fc648771-588b-4a11-8b3e-62ec14838f6b",
                                                "sense_id": "51526b5b-8ed4-375a-8d5a-f2a6bbe49789",
                                                "text": "And they bring unto him one that was deaf, and had an impediment in his speech; and they beseech him to put his hand upon him."
                                            },
                                            {
                                                "example_id": "5cf11ffb-de3d-440d-a503-f141aaaee977",
                                                "sense_id": "51526b5b-8ed4-375a-8d5a-f2a6bbe49789",
                                                "text": "1730, Joseph Addison, The Evidences of the Christian Religion, London: J. Tonson, Additional Discourses, Section 10, p. 308,\nLet us suppose a person blind and deaf from his birth, who being grown to man’s estate, is by the Dead-palsy, or some other cause, deprived of his Feeling, Tasting, and Smelling; and at the same time has the impediment of his Hearing removed, and the film taken from his eyes […]"
                                            },
                                            {
                                                "example_id": "bd470bab-57c3-4e27-a6da-760d17517e46",
                                                "sense_id": "51526b5b-8ed4-375a-8d5a-f2a6bbe49789",
                                                "text": "Better for you not to be tall! In fact it is almost a kindness of Heaven to be gifted with some safe impediment of body, slightly crooked back or the like, if you much dislike the career of honor under Friedrich Wilhelm."
                                            },
                                            {
                                                "example_id": "c4d579c3-47a7-4ea7-b5fb-14035aede063",
                                                "sense_id": "51526b5b-8ed4-375a-8d5a-f2a6bbe49789",
                                                "text": "[…] Walter Ivans replied as rapidly as the impediment in his speech permitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1447b6d8-f15e-320c-b17e-b84b57a3e1ec",
                                        "entry_id": "257ef695-dcb2-3ecc-9802-755c7fa17fb0",
                                        "glosses": [
                                            "Baggage, especially that of an army; impedimenta."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd8be616-74a5-4d9e-8534-c75c38ca0948",
                                                "sense_id": "1447b6d8-f15e-320c-b17e-b84b57a3e1ec",
                                                "text": "We were all on foot, officers and men alike. Our horses, baggage, and impediments had been left at Brashear to follow the column of General Emory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
