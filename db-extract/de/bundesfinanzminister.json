                ],
                "senses": [
                    {
                        "sense_id": "6b64db5d-c0a6-3a4c-b328-2736b8ba6f12",
                        "entry_id": "f0821cc2-40ab-31aa-ac66-00dcb3d23c8d",
                        "glosses": [
                            "Leiter des Bundesministeriums für Finanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f080d8-7256-4907-aefe-4661a985a4d7",
                                "sense_id": "6b64db5d-c0a6-3a4c-b328-2736b8ba6f12",
                                "text": "„Bundesfinanzminister Wolfgang Schäuble hat das Bankengeheimnis für faktisch erledigt erklärt.“"
                            },
                            {
                                "example_id": "d256e338-73f4-4a04-98f3-2e6e81ef85d8",
                                "sense_id": "6b64db5d-c0a6-3a4c-b328-2736b8ba6f12",
                                "text": "„Bis 2018 würden insgesamt zehn Milliarden Euro zusätzlich investiert, ohne neue Schulden machen zu müssen, kündigte Bundesfinanzminister Wolfgang Schäuble (CDU) an.“"
                            },
                            {
                                "example_id": "a25f879e-63c0-4515-952d-db051c6c2174",
                                "sense_id": "6b64db5d-c0a6-3a4c-b328-2736b8ba6f12",
                                "text": "„Über die folgende Zahl dürfte auf der Bundesfinanzminister zunächst staunen, um sich dann zu ärgern: Unternehmen in Deutschland tragen gerade mal 2,6 Prozent zum gesamten Steueraufkommen bei.“"
                            },
                            {
                                "example_id": "d784afda-857e-4f70-9a3f-1d0227e6366e",
                                "sense_id": "6b64db5d-c0a6-3a4c-b328-2736b8ba6f12",
                                "text": "„Nach der Entlassung von FDP-Chef Christian Lindner als Bundesfinanzminister soll der SPD-Politiker Jörg Kukies dieses Amt übernehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
