                "senses": [
                    {
                        "sense_id": "69127f54-7a6c-35c7-a0a7-cd0e2cf3c732",
                        "entry_id": "df89252e-fd08-3fd0-a5fb-76fdb5755c28",
                        "glosses": [
                            "относящийся к крымскому городу Алушта, связанный с ним"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46575ef2-472d-4759-8192-0fa5eadd21ac",
                                "sense_id": "69127f54-7a6c-35c7-a0a7-cd0e2cf3c732",
                                "text": "А еще не так давно пустопорожние земли в алуштинском районе продавались от 25 до 60―70 коп. за квадратную сажень."
                            },
                            {
                                "example_id": "f254921f-60aa-4e79-9fb3-355d3a540f35",
                                "sense_id": "69127f54-7a6c-35c7-a0a7-cd0e2cf3c732",
                                "text": "Типичный алуштинский пляж – узкая (ну, метра четыре) галечная лента, ограниченная волнорезами."
                            }
                        ]
                    }
