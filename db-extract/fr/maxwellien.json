                        "glosses": [
                            "Physicien partisan des thèses de James Clerk Maxwell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b11059a-3e04-46a9-a15d-616d9e61446c",
                                "sense_id": "ba8c4b59-66b5-3a10-909b-cc470349cabd",
                                "text": "Les quelques adeptes réellement convaincus de la puissance de la théorie de Maxwell, les maxwelliens, forment un groupe de partisans qui s’attribue la vaste tâche d’explorer les possibilités et les conséquences de cette théorie, de la rendre moins confuse, de lui donner une forme plus utilisable et enfin de la promouvoir."
                            }
                        ]
