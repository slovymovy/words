                                        "entry_id": "8bc812c1-d371-3887-8888-c0f9047675e3",
                                        "glosses": [
                                            "Land in Südostasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d341073-f0a5-4e09-afbe-5280ae955ff7",
                                                "sense_id": "dba48b8f-d8bf-379c-b6bc-d5c097451186",
                                                "text": "Ich komme gerade aus Kambodscha."
                                            },
                                            {
                                                "example_id": "b6222eb4-1cfc-4ec3-9acf-007ddd25aa9f",
                                                "sense_id": "dba48b8f-d8bf-379c-b6bc-d5c097451186",
                                                "text": "Phnom Penh ist die Hauptstadt von Kambodscha."
                                            },
                                            {
                                                "example_id": "532cb603-cca5-4ec8-8816-d2acd10184d9",
                                                "sense_id": "dba48b8f-d8bf-379c-b6bc-d5c097451186",
                                                "text": "Das Kambodscha der Roten Khmer war ein dunkles Kapitel der Geschichte des Landes."
                                            }
                                        ],
