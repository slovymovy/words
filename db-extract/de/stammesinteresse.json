                "senses": [
                    {
                        "sense_id": "faf0a269-ce3e-353c-a454-afa63e4185bf",
                        "entry_id": "d89fec2d-5600-3859-9c5b-7d783ef1449e",
                        "glosses": [
                            "Gesamtheit der Belange, die der Existenz und dem Wohlergehen eines (Volks-)Stammes förderlich sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fa4c76e-9a2a-415c-a5af-0b3541adce1a",
                                "sense_id": "faf0a269-ce3e-353c-a454-afa63e4185bf",
                                "text": "„Innerhalb kurzer Zeit ist Afrika südlich der Sahara aufgeteilt, Briten, Franzosen, Spanier, Portugiesen und Deutsche haben willkürliche, von Stammesinteressen meist unberührte, Grenzen gezogen.“"
                            },
                            {
                                "example_id": "bda558a3-d8af-4867-9402-47a3ede66602",
                                "sense_id": "faf0a269-ce3e-353c-a454-afa63e4185bf",
                                "text": "„Seine als Kalonji-MNC bekanntgewordenen Gruppe verlor später einige Anhänger, darunter den zukünftigen Ministerpräsidenten Cyrille Adoula, die kritisierten, dass die Partei zu sehr auf Stammesinteressen statt auf den Gesamtstaat fixiert sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
