                                        "glosses": [
                                            "Carte électronique qui sert de support aux composants principaux d’un ensemble électronique et éventuellement aux cartes filles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "050d04e6-8448-4b56-8e83-bd6a42aadacf",
                                                "sense_id": "f40ce673-879f-3d63-bfb5-121723efe635",
                                                "text": "La carte mère est la colonne vertébrale de l’ordinateur. Il s’agit d’un support imprimé de pistes métalliques reliant ses circuits et ses connecteurs."
                                            }
