        "ru-extract.jsonl": [
            {
                "entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                "word": "нехотя",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                        "entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                        "glosses": [
                            "разг. без желания, неохотно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "090ca07a-47f1-4739-82c1-186604f26762",
                                "sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                                "text": "Обломов, облокотясь на него, нехотя, как очень утомлённый человек, привстал с постели и, нехотя же перейдя на большое кресло, опустился в него и остался неподвижен, как сел."
                            },
                            {
                                "example_id": "b9173df4-d411-4bf7-b6a1-924cc7a41706",
                                "sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                                "text": "Стоит, глядит и сомневается; а иногда так долго сомневается, что начнёт икать, и, уж только застыдившись своего невежества, уйдёт и сделает, что сказано, но всё-таки как будто нехотя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51e5a2ae-a74d-4edd-ac27-24de713e8371",
                        "source_entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                        "source_sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                        "target_lang_word": "unwillingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwillingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50611514-5884-301f-9f6f-936fcbc414b1",
                                        "entry_id": "20b77f01-e245-3550-b951-95567d79f0b9",
                                        "glosses": [
                                            "In an unwilling or uncooperative manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c65004-96f5-4a58-bba5-395453fe47a6",
                                                "sense_id": "50611514-5884-301f-9f6f-936fcbc414b1",
                                                "text": "Mai unwillingly starts her journey, wondering how she, still dependent on her parents, can possibly be a reliable companion to her frail grandmother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f99403a-b150-43c4-9a28-e844d45d8f73",
                        "source_entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                        "source_sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                        "target_lang_word": "unwillig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwillig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                        "entry_id": "db464410-44fc-38f5-99d1-c260f4499fe4",
                                        "glosses": [
                                            "so, dass man Verärgerung/Ablehnung bei jemandem erkennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879e69fa-86e2-47a1-b360-5533d26665a4",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "„Sie schüttelt unwillig den Kopf: Sie macht dies einfach nicht mehr mit.“"
                                            },
                                            {
                                                "example_id": "8c69085e-d57a-4790-8ae5-8ffed25a4b25",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "„Unwillig die Argumente des Gegenübers anzuhören, eskaliert die Situation und sie geben einander mit Schirmen aufs «Dach».“"
                                            },
                                            {
                                                "example_id": "8be56261-b255-496d-bbf9-1658e1dd7f8d",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "[DDR, Ostblock:] „Der unwillige Teil der Bevölkerung, der zum Teil lieber ausgewandert wäre, wurde oft durch Sperranlagen und strenge Visa-Bestimmungen am Verlassen des Staates gehindert.“"
                                            },
                                            {
                                                "example_id": "a36e880d-9e76-4423-9d69-c1fefaae54cb",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "„Der Chefcoach des russischen Teams und viele Athleten waren unwillig, das Ausmass des Dopingproblems in der Leichtathletik ihres Landes zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                        "entry_id": "db464410-44fc-38f5-99d1-c260f4499fe4",
                                        "glosses": [
                                            "nicht bereit/willens, etwas zu tun; ohne Bereitwilligkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1a9763-b0e8-464b-9ec1-a4d923b7fab9",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Unwillig die Argumente des Gegenübers anzuhören, eskaliert die Situation und sie geben einander mit Schirmen aufs «Dach».“"
                                            },
                                            {
                                                "example_id": "ca0f604a-82ad-45f3-903c-8cc5ba21fdae",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Dabei konnte man Mirko keineswegs unwillig oder widerspenstig nennen. Er tat gehorsam, was man ihm gebot,“ […]."
                                            },
                                            {
                                                "example_id": "30710135-be03-43fa-88aa-de0605e3cce8",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Ein Pferd ist kein unwilliger Gaul, den du dominieren musst. Es geht vielmehr um eine Zusammenarbeit, die du anleiten solltest.“"
                                            },
                                            {
                                                "example_id": "a62cc540-0c34-4f9e-9403-053449414dab",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "[Heinrich VIII.:] „Tatsächlich war Heinrich so unwillig, sich extra Zeit für die Lektüre seiner Korrespondenz zu nehmen, dass er sie während der Abendmesse erledigte.“"
                                            },
                                            {
                                                "example_id": "1c051924-263e-4c06-ac7f-975f70ab585c",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "[Maria Theresia:] „Die Aufhebung des Jesuitenordens 1773 ging nicht von ihr aus, sondern sie vollzog das päpstliche Verbot eher unwillig.“"
                                            },
                                            {
                                                "example_id": "2a4568c7-0ed1-424f-9559-68ec44233c2f",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Im Zuge seiner Untersuchungen bemüht er sich weiter um die Kooperation bisher unwilliger Zeugen.“"
                                            },
                                            {
                                                "example_id": "4bae3344-c31d-41ad-be02-07cb180f285e",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Wer sich nach Ansicht der Jobcenter unwillig zeigt, der muss mit Sanktionen rechnen.“"
                                            },
                                            {
                                                "example_id": "0508b8bc-3e64-4b30-9b75-edd077afb60f",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "Unwillige Staaten der Europäischen Union, sich für Rechtsstaatlichkeit, Presse- und Demonstrationsfreiheit und gegen Korruption und Behördenwillkür einzusetzen, gehören mindestens finanziell sanktioniert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5db2b9b0-17da-4870-b3d1-5d7271909599",
                        "source_entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                        "source_sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                        "target_lang_word": "à regret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à regret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75ee8400-b3b6-303a-b648-04b8b5f07484",
                                        "entry_id": "a88a34db-f6f4-32d4-b793-6f29e4935cb8",
                                        "glosses": [
                                            "Avec déplaisir, avec répugnance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529b6169-a5f8-47de-a629-e0cb2f4fda8c",
                                                "sense_id": "75ee8400-b3b6-303a-b648-04b8b5f07484",
                                                "text": "— Samuel, dis à ton frère de venir, qu’on en ait le cœur net ! concéda-t-il à regret."
                                            },
                                            {
                                                "example_id": "bf8c2abe-c8b7-4ac6-91c6-837bdcab9817",
                                                "sense_id": "75ee8400-b3b6-303a-b648-04b8b5f07484",
                                                "text": "Il a fait cela à regret."
                                            },
                                            {
                                                "example_id": "c69fc1d8-c253-42f3-b850-700a11794878",
                                                "sense_id": "75ee8400-b3b6-303a-b648-04b8b5f07484",
                                                "text": "Il ne l’a fait qu’à regret."
                                            },
                                            {
                                                "example_id": "236ed5c6-5a6f-483f-a61f-2a24637756e1",
                                                "sense_id": "75ee8400-b3b6-303a-b648-04b8b5f07484",
                                                "text": "Nous partons à regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d945ab2d-4ccc-42c9-a32a-f6e800b702f6",
                        "source_entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                        "source_sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                        "target_lang_word": "à contrecœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à contrecœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                        "entry_id": "e6992e4b-9553-364c-a0b1-df3549d561d5",
                                        "glosses": [
                                            "À regret ; avec répugnance ; malgré soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee1be61-3bd6-4f0d-b07f-7091524d8b6c",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Si un policier seul recueille un témoignage, il sera toujours possible au suspect qui a parlé à contrecœur de nier ses aveux par la suite. Deux affirmations ont plus de poids qu’une seule devant un jury"
                                            },
                                            {
                                                "example_id": "9e8290c9-5c73-4c7c-8655-5a3c01f46f60",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Sur la steppe rouge du Planalto central, où les arbres ne poussent qu’à contrecœur, Brasilia est une ville retranchée, une capitale solitaire, loin, très loin, du Brésil utile, du pays réel. Bâtie par des disciples de Le Corbusier, elle a été soumise à la rigueur, à la raideur calvinistes du vieux maître, […]."
                                            },
                                            {
                                                "example_id": "472513cc-e919-4e1a-ba83-ab9f90061db2",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Aussi, presque à contrecœur, tire-t-il de sa musette un morceau de bruccio."
                                            },
                                            {
                                                "example_id": "21f84ba7-6fbe-476b-8192-d2df9845f0b0",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Massacrer un gentil, vraiment j’y allais à contrecœur."
                                            },
                                            {
                                                "example_id": "21ef6db0-f258-4751-89e9-cb3268222e7c",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Derrière les prétendus paradoxes subversifs qu’elle expose, son discours ressasse une antienne séculaire de la libération sexuelle des 60-70, celle qui a avant tout libéré la sexualité masculine : les femmes doivent subir à contrecœur les assauts masculins pour ne pas être stigmatisées en tant que bourgeoises frigides (« psychologiquement pures »)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef6dd067-f704-4a85-b9f0-4c1808ac07e5",
                        "source_entry_id": "0b0825f9-c90c-312f-aec1-6ca2be5119d0",
                        "source_sense_id": "1e146469-abaa-3cc9-9ad4-58ea6c94060c",
                        "target_lang_word": "de mauvaise grâce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de mauvaise grâce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cce0bebc-d0a2-3307-8f14-e11b7e74a864",
                                        "entry_id": "b95c6042-547f-3bcb-bfc4-8fbbce3686e6",
                                        "glosses": [
                                            "Avec un air mal gracieux ; à regret ; comme par contrainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a5172a-d7e6-48b1-9de0-194feb5de077",
                                                "sense_id": "cce0bebc-d0a2-3307-8f14-e11b7e74a864",
                                                "text": "Après le souper elle joua au quinze, elle perdit de mauvaise grâce , paya de plus mauvaise grâce encore , & se coucha de fort méchante humeur."
                                            },
                                            {
                                                "example_id": "610341f7-15d3-42bf-b0d0-64203421dd1e",
                                                "sense_id": "cce0bebc-d0a2-3307-8f14-e11b7e74a864",
                                                "text": "Avec elle, il était formidable, constata Crystal de mauvaise grâce. De mauvaise grâce car elle refusait de voir Reed sous un autre jour que celui de la cupidité."
                                            },
                                            {
                                                "example_id": "d1c4af45-d5db-4476-8af2-80031b0b92c7",
                                                "sense_id": "cce0bebc-d0a2-3307-8f14-e11b7e74a864",
                                                "text": "Il l’avouait de mauvaise grâce mais, tout de même, on sentait que l’atmosphère s’alourdissait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
