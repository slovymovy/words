                    ]
                },
                {
                    "sense_id": "8c8a82f5-d8b4-30cc-a087-dea912df59ea",
                    "sense_definition": "S'approprier intellectuellement des notions ou des informations en les comprenant en profondeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
