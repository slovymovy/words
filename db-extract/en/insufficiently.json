                "senses": [
                    {
                        "sense_id": "a41eab29-4342-3812-95ac-4712b84f7f32",
                        "entry_id": "5372a721-9c97-3f1b-ad2b-7b98d9948f9c",
                        "glosses": [
                            "Not sufficiently."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "964acc2a-4db5-43fd-996c-732d37c51d49",
                                "sense_id": "a41eab29-4342-3812-95ac-4712b84f7f32",
                                "text": "The machine was decommissioned because it was producing widgets insufficiently."
                            },
                            {
                                "example_id": "8c816b62-a283-4f6d-9301-17d0f555b787",
                                "sense_id": "a41eab29-4342-3812-95ac-4712b84f7f32",
                                "text": "Mr. Tygart, who came to prominence for successfully pursuing doping cases against the track star Marion Jones and the cyclist Lance Armstrong, has long contended that WADA is insufficiently dedicated to holding dopers and their enablers to account."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fd3f903-594e-42d1-96dc-cab82f5f6bd7",
                        "source_entry_id": "5372a721-9c97-3f1b-ad2b-7b98d9948f9c",
                        "source_sense_id": "a41eab29-4342-3812-95ac-4712b84f7f32",
                        "source_sense_description": "not sufficiently",
                        "target_lang_word": "insuffisamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insuffisamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33ca6a78-74fc-352a-bb05-36cf952858bd",
                                        "entry_id": "ab04c661-6900-3a41-a424-509f5b11aa45",
                                        "glosses": [
                                            "D’une manière insuffisante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a81f7d1-64bf-49ca-a1bb-aff0763d8f1b",
                                                "sense_id": "33ca6a78-74fc-352a-bb05-36cf952858bd",
                                                "text": "La poussière constitue un risque pour les voies respiratoires, d'autant qu'une majorité de salariés ne porte pas de masque ou porte un masque insuffisamment protecteur ou encombrant : […]."
                                            },
                                            {
                                                "example_id": "e5e55931-7fb6-4507-a2b1-d2f2365458ce",
                                                "sense_id": "33ca6a78-74fc-352a-bb05-36cf952858bd",
                                                "text": "Celui-ci voit dans les causes profondes de ce malaise la défaillance des politiques publiques : moyens « notoirement insuffisants », réformes « insuffisamment pensées de façon systémique », trop souvent envisagées comme « des rustines visant à gérer les flux dans un contexte de sous-dotation », comme la déjudiciarisation de certains contentieux qui « ne saurait constituer le socle d’une politique judiciaire » et qui a aujourd’hui « atteint ses limites »."
                                            },
                                            {
                                                "example_id": "99409f79-6b47-4f85-8b40-39ff19b31d92",
                                                "sense_id": "33ca6a78-74fc-352a-bb05-36cf952858bd",
                                                "text": "Il est vrai, […], que le juifs, plus versés que les prêtres chrétiens dans la connaissance des Écritures, étaient de redoutables controversistes, à ce point que Saint Louis manifesta sa répugnance pour les discussions entre les juifs et les chrétiens insuffisamment instruits : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce388f76-29bd-319a-84f8-6abe5bc0b3a2",
                                        "entry_id": "ab04c661-6900-3a41-a424-509f5b11aa45",
                                        "glosses": [
                                            "Un nombre insuffisant de. Une quantité insuffisante de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad6fd25c-4e36-4931-937d-9de7deade3a8",
                                                "sense_id": "ce388f76-29bd-319a-84f8-6abe5bc0b3a2",
                                                "text": "En France, il me semble que notre lycée est trop centré sur les procédures de transmission collective et comprend insuffisamment de temps de travail personnel et en petits groupes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
