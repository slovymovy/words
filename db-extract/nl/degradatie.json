                "translations": [
                    {
                        "translation_id": "96bc0966-039c-480e-9ac6-2d7f6f5bfecf",
                        "source_entry_id": "eef63548-d660-3313-a424-3ccb1c5a406e",
                        "source_sense_id": "b5336bb7-51a9-33a2-a34e-b6514e9bdf83",
