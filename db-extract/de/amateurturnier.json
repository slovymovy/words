                "senses": [
                    {
                        "sense_id": "592e886d-f7a8-3a6c-8b24-bc11d9718be6",
                        "entry_id": "4d683737-565e-3ca3-a342-75a9c1a45819",
                        "glosses": [
                            "Turnier, bei dem nur Amateursportler antreten dürfen; bei dem nur Amateure zugelassen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c94192-cf0d-4200-84fa-6455f28c238d",
                                "sense_id": "592e886d-f7a8-3a6c-8b24-bc11d9718be6",
                                "text": "„Die 21-jährige Amerikanerin hat bereits die Zulassung für die LPGA-Tour, wollte mit dem Umstieg ins Profilager aber bis nach dem denkwürdigen Amateurturnier in Augusta warten.“"
                            },
                            {
                                "example_id": "3be5b18b-290b-496e-8ee2-24993fc6172b",
                                "sense_id": "592e886d-f7a8-3a6c-8b24-bc11d9718be6",
                                "text": "„Das Amateurturnier wird ebenfalls auf dem St.-Moritzer-See ausgetragen.“"
                            },
                            {
                                "example_id": "30b15abe-24cd-451a-8ad1-e3ef9b24d67b",
                                "sense_id": "592e886d-f7a8-3a6c-8b24-bc11d9718be6",
                                "text": "„Wer sich einmal dazu entschieden hat, Profi zu werden, darf bei keinem Amateurturnier mehr starten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
