                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Chauvinismus"
                    },
                    {
                        "form_id": "04edbf9e-ba2a-47e9-8dbb-94d90e3bdd00",
                        "entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Chauvinismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d4997bd-d7bb-3994-96df-08d723b815af",
                        "entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
                        "glosses": [
                            "extrem sexistische Einstellung einer Person, meist übersteigertes Männlichkeitsgefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18039696-e33d-431e-a555-ab0af9535560",
                                "sense_id": "3d4997bd-d7bb-3994-96df-08d723b815af",
                                "text": "„Im College setzte sie sich unerschrocken gegen sexuelle Belästigung zur Wehr. Und später gegen den Chauvinismus der Vorgesetzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41fa0964-17e5-3421-9b15-467c665f4888",
                        "entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
                        "glosses": [
                            "exzessiver Patriotismus beziehungsweise Nationalismus, übersteigerter Nationalismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "707bad5e-72e7-4875-ab45-152003b9e20f",
                                "sense_id": "41fa0964-17e5-3421-9b15-467c665f4888",
                                "text": "Manche sagen, der Chauvinismus der Kolonialzeit sei Hauptursache für den Ersten Weltkrieg gewesen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b834df0b-f671-3798-9fa8-beb001c6e227",
                        "entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
                        "glosses": [
                            "Glaube an die Überlegenheit der eigenen Gruppe"
                        ],
                        "tags": [
                            "generell"
                        ],
                        "examples": [
                            {
                                "example_id": "d424beac-18e0-4c7b-98cc-78a91ec0603b",
                                "sense_id": "b834df0b-f671-3798-9fa8-beb001c6e227",
                                "text": "Solch religiöser Chauvinismus würde von unseren Lippen sehr seltsam klingen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b56e03e9-149e-43a5-9f34-c55febc6f7b2",
                        "source_entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
                        "source_sense_id": "3d4997bd-d7bb-3994-96df-08d723b815af",
                        "source_sense_description": "extrem sexistische Einstellung einer Person, meist übersteigertes Männlichkeitsgefühl",
                        "target_lang_word": "chauvinism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauvinism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd0255c-032c-3e6c-bdd8-5b5cbdcd5b4d",
                                        "entry_id": "35473646-0be1-379f-9f76-d4bb85b4b582",
                                        "glosses": [
                                            "Excessive patriotism, eagerness for national superiority; jingoism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc77087-e6a7-41b5-8e1c-b69c7c10b6d5",
                                                "sense_id": "3bd0255c-032c-3e6c-bdd8-5b5cbdcd5b4d",
                                                "text": "(C. S.) Lewis occasionally expressed a somewhat tongue-in-cheek chauvinism towards the English. Describing an encounter with a fellow Irishman, he wrote: \"Like all Irish people who meet in England, we ended by criticisms on the invincible flippancy and dullness of the Anglo-Saxon race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839a1f46-1ee8-3d3c-8344-c08997271491",
                                        "entry_id": "35473646-0be1-379f-9f76-d4bb85b4b582",
                                        "glosses": [
                                            "Unwarranted bias, favoritism, or devotion to one's own particular group, cause, or idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e26796-4184-46e8-857c-17f9169c3350",
                                                "sense_id": "839a1f46-1ee8-3d3c-8344-c08997271491",
                                                "text": "Feminists say that male chauvinism is still prevalent in cultures worldwide."
                                            },
                                            {
                                                "example_id": "666cfe54-7f1e-44e5-b048-6299577124c3",
                                                "sense_id": "839a1f46-1ee8-3d3c-8344-c08997271491",
                                                "text": "“This is an outrageous example of unconscious racial chauvinism!” Jack said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f7b4af3-1250-4be4-a453-96f63338acfc",
                        "source_entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
                        "source_sense_id": "3d4997bd-d7bb-3994-96df-08d723b815af",
                        "source_sense_description": "extrem sexistische Einstellung einer Person, meist übersteigertes Männlichkeitsgefühl",
                        "target_lang_word": "chauvinisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauvinisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                                        "entry_id": "958df445-1293-3823-80e1-02db8938b832",
                                        "glosses": [
                                            "Sentiment de celui qui est chauvin (très patriote), le comportement qui en découle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9845d1f-89b2-4222-b29e-242358d2035d",
                                                "sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                                                "text": "Toutefois il nous semble qu’il entre dans les raisonnements de certains éléments intransigeants espagnols moins de raisons pratiques que de chauvinisme inquiet et que précisément ce chauvinisme ne nous est guère favorable."
                                            },
                                            {
                                                "example_id": "9bd71e99-a955-4f18-91ee-0c52774da160",
                                                "sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                                                "text": "À l’antisémitisme politique s’associe immanquablement l’antisémitisme religieux : le chauvinisme exploite le fanatisme et le fanatisme se fait le paravent du chauvinisme."
                                            },
                                            {
                                                "example_id": "587415bf-56bd-419f-a2a9-956e22c597a2",
                                                "sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                                                "text": "En même temps, les espérantophones se sentent profondément enracinés dans leur propre milieu ethnique, mais en évitant tout chauvinisme."
                                            },
                                            {
                                                "example_id": "701fdf9e-b0fb-4a2a-87aa-7487f2217f22",
                                                "sense_id": "5fa793c6-07de-3941-8e20-2efa1bebaddd",
                                                "text": "Elle doit aussi compter avec un chauvinisme officiellement encouragé au Maroc sur tout débat portant sur cette région et des lois punissant les propos remettant en cause la marocanité du territoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31f7be3d-ee5e-4dcb-8050-cce89873a663",
                        "source_entry_id": "abc6d267-de58-3a57-b349-631d1c4e1965",
