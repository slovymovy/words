                "senses": [
                    {
                        "sense_id": "e70ae19a-2d60-319b-9302-e5062c643f25",
                        "entry_id": "334d704d-8c8b-38e5-9d26-c1f2ad94df54",
                        "glosses": [
                            "eine Reise, die man aus beruflichen Gründen macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37cb8a53-ecae-4c2c-a4d6-0d0b6b730806",
                                "sense_id": "e70ae19a-2d60-319b-9302-e5062c643f25",
                                "text": "Der Chef ging wegen einigen Angelegenheiten auf eine Geschäftsreise."
                            },
                            {
                                "example_id": "e2e9d3ad-375b-4eae-acae-689521645648",
                                "sense_id": "e70ae19a-2d60-319b-9302-e5062c643f25",
                                "text": "Der neue Chef ging immer auf Geschäftsreisen."
                            },
                            {
                                "example_id": "3a1adda7-ca40-4dd4-b52e-c81459df6844",
                                "sense_id": "e70ae19a-2d60-319b-9302-e5062c643f25",
                                "text": "„Am nächsten Tag kauft sich der Glatzkopf zwei Flaschen Asbach Uralt, tritt eine Geschäftsreise an und will nach Helgoland fahren, um sich besoffen zu ertränken.“"
                            },
                            {
                                "example_id": "025f38b2-a997-423c-8a4e-958216e5f33a",
                                "sense_id": "e70ae19a-2d60-319b-9302-e5062c643f25",
                                "text": "„Im Flur stand noch Jürgens kleiner Koffer, den er auf Geschäftsreisen immer gerne mitnahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a360456-cdec-4369-8f2d-b13d2523af49",
                        "source_entry_id": "334d704d-8c8b-38e5-9d26-c1f2ad94df54",
                        "source_sense_id": "e70ae19a-2d60-319b-9302-e5062c643f25",
