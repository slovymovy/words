                                "target_lang_word": "w dni powszednie",
                                "target_lang_sense_clarification": "odbywający się w tygodniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dccd72e3-5cfc-3449-8e08-32f696747154",
                    "sense_definition": "alledaags of gewoon; niet behorend bij een speciale gelegenheid",
