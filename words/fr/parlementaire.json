    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ea82650-e888-3237-a0dd-8bcfb3f60ebe",
                    "sense_definition": "Membre d'une assemblée délibérante qui constitue le parlement (député ou sénateur).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune <w>parlementaire</w> a défendu son projet de loi avec beaucoup de conviction."
                        },
                        {
                            "text": "L'ensemble des <w>parlementaires</w> a voté en faveur de cette réforme constitutionnelle."
                        }
                    ],
                    "synonyms": [
                        "député",
                        "sénateur",
                        "législateur"
                    ],
                    "common_phrases": [
                        "les parlementaires de la majorité",
                        "les parlementaires de l'opposition"
                    ]
                },
                {
                    "sense_id": "8944102a-50af-39c3-89c9-a3823f4f6190",
                    "sense_definition": "Personne envoyée auprès d'une armée ennemie pour transmettre un message ou négocier des conditions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général a dépêché un <w>parlementaire</w> pour négocier les conditions de la reddition."
                        },
                        {
                            "text": "Le <w>parlementaire</w> s'est avancé vers les lignes ennemies sous la protection d'un drapeau blanc."
                        }
                    ],
                    "synonyms": [
                        "émissaire",
                        "négociateur"
                    ],
                    "common_phrases": [
                        "envoyer un parlementaire",
                        "recevoir un parlementaire"
                    ]
                },
                {
                    "sense_id": "a364680b-4437-3abe-b2cd-360f21230c06",
                    "sense_definition": "Partisan du Parlement lors de crises historiques, comme la Fronde en France ou la guerre civile anglaise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant la Fronde, plusieurs <w>parlementaires</w> s'opposèrent ouvertement au pouvoir de Mazarin."
                        },
                        {
                            "text": "Le conflit opposa les royalistes aux <w>parlementaires</w> fidèles aux principes de l'assemblée."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "contexte historique précis"
                        }
                    ]
                },
