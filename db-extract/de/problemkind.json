                "senses": [
                    {
                        "sense_id": "ea33e076-463b-3101-a72d-5dbd83a8eff6",
                        "entry_id": "c39549b8-7506-37ce-931f-4ee287f17013",
                        "glosses": [
                            "Kind, das jemandem viele Schwierigkeiten dabei bereitet, es zu erziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e431039-345f-4b46-a026-8b95ed23a065",
                                "sense_id": "ea33e076-463b-3101-a72d-5dbd83a8eff6",
                                "text": "„Geistig oder körperlich Behinderte, aufmerksamkeitsgestörte Problemkinder, schwer Erziehbare mit Migrationshintergrund – wer, der dafür nicht bezahlt wird, will schon mit ihnen zu tun haben?“"
                            },
                            {
                                "example_id": "eda317e6-0ed1-4881-beb4-1c0b4b757504",
                                "sense_id": "ea33e076-463b-3101-a72d-5dbd83a8eff6",
                                "text": "„Meine Mutter war das Problemkind, ein Wildfang, trotzig und dickköpfig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bd4790b-ba87-49d8-b365-94b57f9e158d",
                        "source_entry_id": "c39549b8-7506-37ce-931f-4ee287f17013",
                        "source_sense_id": "ea33e076-463b-3101-a72d-5dbd83a8eff6",
                        "source_sense_description": "Kind, das jemandem viele Schwierigkeiten dabei bereitet, es zu erziehen",
                        "target_lang_word": "problem child",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "problem child",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                        "entry_id": "63870929-7152-3bed-859b-bb0cef75756b",
                                        "glosses": [
                                            "A child who is particularly difficult to raise or educate, especially due to a lack of self-control and disruptive and antisocial behavior."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e1ff622-7834-4c82-b3a2-7f31263b4a41",
                                                "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                                "text": "Of recent times very much has been said regarding the problem child, but as Lady Stradbroke pointed out last week but little is being done to cope with the menace that child is to itself and to the community."
                                            },
                                            {
                                                "example_id": "40210593-38af-4ef3-a9de-fe87b3c1f8a3",
                                                "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                                "text": "Hill was a problem child who was sent to Woodlands because his parents couldn't handle him at home."
                                            },
                                            {
                                                "example_id": "3524ec5e-5497-4b5b-9a76-47707f87a470",
                                                "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                                "text": "An’ here I am. Your dream problem child. A facety ghetto rude gyal grateful for your remarkable lack of judgeyness, an’ ready to be dazzled and inspired by your penetrating insight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd0b0cbc-eccd-30ac-b4fd-9518fa6433dd",
                                        "entry_id": "63870929-7152-3bed-859b-bb0cef75756b",
                                        "glosses": [
                                            "Someone or something persistently difficult or vexing; a frequent source of trouble or annoyance."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21eb5491-cbd5-43db-add8-3ca5bbb8912f",
                                                "sense_id": "cd0b0cbc-eccd-30ac-b4fd-9518fa6433dd",
                                                "text": "[A]n ambitious supersonic carrier fighter called the F3H Demon . . . proved too heavy for its Navy-specified Westinghouse engine (in itself a problem child), and turned into a $265 million fiasco."
                                            },
                                            {
                                                "example_id": "0deee237-c488-497f-83d8-b533516897a2",
                                                "sense_id": "cd0b0cbc-eccd-30ac-b4fd-9518fa6433dd",
                                                "text": "Locally and across the nation, middle schools have generally been regarded as the problem child for school systems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a716690f-fa4f-4de2-be2a-650860664f59",
                        "source_entry_id": "c39549b8-7506-37ce-931f-4ee287f17013",
                        "source_sense_id": "ea33e076-463b-3101-a72d-5dbd83a8eff6",
                        "source_sense_description": "Kind, das jemandem viele Schwierigkeiten dabei bereitet, es zu erziehen",
                        "target_lang_word": "enfant à problèmes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a146edde-f47e-40f9-9d58-18398db6494d",
                        "source_entry_id": "c39549b8-7506-37ce-931f-4ee287f17013",
                        "source_sense_id": "ea33e076-463b-3101-a72d-5dbd83a8eff6",
                        "source_sense_description": "Kind, das jemandem viele Schwierigkeiten dabei bereitet, es zu erziehen",
                        "target_lang_word": "enfant terrible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfant terrible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f1347e2-e25f-3843-b8b1-1514ca8f2bc6",
                                        "entry_id": "8041faed-dc61-35bf-bf1b-42fdc8e10faf",
                                        "glosses": [
                                            "Jeune personne turbulente, qui met son entourage dans des situations délicates."
                                        ],
                                        "tags": [
                                            "Littéral"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdb3f711-dd53-3db2-97c2-bfff575df1ec",
                                        "entry_id": "8041faed-dc61-35bf-bf1b-42fdc8e10faf",
                                        "glosses": [
                                            "Celui ou celle qui ne se soumet pas aux conventions établies, qui tend, par ses choix, à la redéfinition du mouvement auquel il appartient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7486d7a9-4eb9-4e59-8259-8aaea03c5ae7",
                                                "sense_id": "bdb3f711-dd53-3db2-97c2-bfff575df1ec",
                                                "text": "Norman Mailer, l’enfant terrible de la littérature américaine, est mort."
                                            },
                                            {
                                                "example_id": "7b2026a5-1b18-4cb1-aadc-c1a532fe0e3f",
                                                "sense_id": "bdb3f711-dd53-3db2-97c2-bfff575df1ec",
                                                "text": "\"L’enfant terrible du hardcore français\" vient de nous offrir « de quoi occuper vos/nos soirées, en ces temps compliqués » : un DJ set de sept heures, joué le 14 février dernier au club Basis d’Utrecht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
