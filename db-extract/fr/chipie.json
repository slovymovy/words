        "fr-extract.jsonl": [
            {
                "entry_id": "0742487f-849d-311a-a5b1-32a7408a2f4f",
                "word": "chipie",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e251356d-bcd8-3d09-8e1a-471dd1596e33",
                        "entry_id": "0742487f-849d-311a-a5b1-32a7408a2f4f",
                        "glosses": [
                            "Qui a un comportement désagréable, dédaigneux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98cf293-21d0-4691-85d0-7527d492c3f6",
                                "sense_id": "e251356d-bcd8-3d09-8e1a-471dd1596e33",
                                "text": "N’oublions pas que le genre mondain comporte des mines dégoûtés, des airs chipie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                "word": "chipie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f31d2ded-fa1b-41ed-94e9-8cf59f0721f5",
                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                        "tags": [
                            "plural"
                        ],
                        "form": "chipies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3606efd-54f1-3fce-b554-8e3526cd0c59",
                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                        "glosses": [
                            "Femme ou fille acariâtre, dédaigneuse et désagréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bfaa850-4a8c-4972-a441-a6ae75dcd6ed",
                                "sense_id": "c3606efd-54f1-3fce-b554-8e3526cd0c59",
                                "text": "— Je crois avoir entendu que le docteur parlait de cette vieille chipie de Blanche de Castille, si j’ose m’exprimer ainsi."
                            },
                            {
                                "example_id": "0693cc47-5dd2-4c9b-9e30-435ef5c4e3c1",
                                "sense_id": "c3606efd-54f1-3fce-b554-8e3526cd0c59",
                                "text": "J’avoue qu’elle a d’assez beaux yeux, mais c’est une chipie, Turner, une chipie, aussi aigre et malfaisante que son mari."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b1c73a0-a043-36ce-8564-bcc88e474038",
                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                        "glosses": [
                            "Femme ou fille de caractère, et encline à jouer des tours."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a44732fc-e587-45e8-bdc0-506a8b4f879f",
                                "sense_id": "5b1c73a0-a043-36ce-8564-bcc88e474038",
                                "text": "Sa sœur est une vraie chipie !"
                            },
                            {
                                "example_id": "6c1e3dd7-299a-4a2c-a52e-3fec42f9481c",
                                "sense_id": "5b1c73a0-a043-36ce-8564-bcc88e474038",
                                "text": "Elles avaient le souvenir d'une adolescente un peu ingrate, volontiers moqueuse, leur mère disait \"un peu chipie\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "2caa0386-4d4f-3838-8743-d0344a957688",
                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                        "glosses": [
                            "Se dit affectueusement d’une très jeune fille."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5f2ce32b-4525-4a68-91c2-0754341f67da",
                                "sense_id": "2caa0386-4d4f-3838-8743-d0344a957688",
                                "text": "Ah, c’est ma petite chipie d’amour qui réclame son biberon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "facccac2-700a-45c2-be8d-45ca720585dd",
                        "source_entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                        "source_sense_description": "Femme ou fille de caractère",
                        "target_lang_word": "vixen",
