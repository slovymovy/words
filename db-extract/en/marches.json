                "senses": [
                    {
                        "sense_id": "d9047943-1cc2-32cb-8ee2-719dd9a27bd5",
                        "entry_id": "a3947861-8d49-3210-a47d-71d084196e0d",
                        "glosses": [
                            "Synonym of Marche: An administrative region in central Italy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ec802551-bb09-3bee-86e0-736834cce970",
                        "entry_id": "a3947861-8d49-3210-a47d-71d084196e0d",
                        "glosses": [
                            "The lands in the vicinity of the Welsh-English border."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c43dbcbc-09fa-4033-82ed-81a6a57471a8",
                                "sense_id": "ec802551-bb09-3bee-86e0-736834cce970",
                                "text": "A good example is Wales and the Marches where most of the great landlords were absentees who, by the mid-fifteenth century, had allowed their administrative and judicial powers to slip into the hands of a corrupt squirearchy."
                            },
                            {
                                "example_id": "f70ec302-0bbc-4042-a775-de49c604e94f",
                                "sense_id": "ec802551-bb09-3bee-86e0-736834cce970",
                                "text": "The Marches also have areas of intensive farming, as well as extensive forestry plantations where nature is struggling to thrive."
                            }
                        ]
                    },
                    {
                        "sense_id": "b11be30c-73e8-38b1-93ee-6879fa32e236",
                        "entry_id": "a3947861-8d49-3210-a47d-71d084196e0d",
                        "glosses": [
                            "The lands in the vicinity of the Scottish-English border."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d85aa7-a020-4adc-a3a7-2bb9fa0adaf4",
                                "sense_id": "b11be30c-73e8-38b1-93ee-6879fa32e236",
                                "text": "[…] sets forth the romantic story of 'the Laws of the Marches,' […] if a quarrel takes place on the Marches between the two countries [and someone dies], his body shall be brought to the Marches at the day and place within the appointed parts, […]"
                            }
                        ]
                    }
                ],
