                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поставьте это существительное во множественное <w>число</w>.",
                            "target_lang_translations": {
