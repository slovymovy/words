{
    "word_family": [
        "morpheme",
        "morphology",
        "morphism",
        "amorphous",
        "polymorphic"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31889afd-85a6-3bfa-ba7a-7bfac5b62380",
                    "sense_definition": "To change shape from one form to another using computer animation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software allows users to <w>morph</w> one face into another seamlessly.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет пользователям плавно <w>морфировать</w> одно лицо в другое."
                            }
                        },
                        {
                            "text": "The special effects team used advanced tools to <w>morph</w> the actor into a monster.",
                            "target_lang_translations": {
                                "ru": "Команда спецэффектов использовала передовые инструменты, чтобы <w>превратить</w> актера в монстра."
                            }
                        }
                    ],
                    "synonyms": [
                        "transform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять форму одного объекта в другой с помощью компьютерной анимации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морфировать",
                                "target_lang_sense_clarification": "специальный термин для компьютерной графики"
                            },
                            {
                                "target_lang_word": "плавно преобразовывать",
                                "target_lang_sense_clarification": "описание процесса изменения формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a643354d-3bc9-3cad-af65-71e494e941cd",
                    "sense_definition": "To change one's physical form or appearance",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the fantasy novel, the wizard can <w>morph</w> into a large eagle.",
                            "target_lang_translations": {
                                "ru": "В фэнтези-романе волшебник может <w>превращаться</w> в большого орла."
                            }
                        },
                        {
                            "text": "The creature began to <w>morph</w> as it prepared to attack its prey.",
                            "target_lang_translations": {
                                "ru": "Существо начало <w>трансформироваться</w>, готовясь напасть на свою добычу."
                            }
                        }
                    ],
                    "synonyms": [
                        "shapeshift",
                        "transform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять свой физический облик или внешность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превращаться",
                                "target_lang_sense_clarification": "общее значение изменения формы"
                            },
                            {
                                "target_lang_word": "принимать облик",
                                "target_lang_sense_clarification": "литературный вариант изменения внешности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23e06a3a-b0b6-331d-a951-4f1d9bbd6f07",
                    "sense_definition": "To undergo a gradual and significant change",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small local protest soon <w>morphed</w> into a massive national movement.",
                            "target_lang_translations": {
                                "ru": "Небольшой местный протест вскоре <w>перерос</w> в массовое национальное движение."
                            }
                        },
                        {
                            "text": "Their casual friendship slowly <w>morphed</w> into a deep and lasting partnership.",
                            "target_lang_translations": {
                                "ru": "Их случайная дружба постепенно <w>переросла</w> в глубокое и прочное партнерство."
                            }
                        }
                    ],
                    "synonyms": [
                        "evolve",
                        "transform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно и значительно изменяться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерастать",
                                "target_lang_sense_clarification": "о переходе одного состояния в другое"
                            },
                            {
                                "target_lang_word": "трансформироваться",
                                "target_lang_sense_clarification": "о процессе глубокого изменения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f859b201-f781-3b3b-973f-e2416c5ea873",
                    "sense_definition": "A computer-generated gradual transition between two images",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The video features a smooth <w>morph</w> between the two portraits.",
                            "target_lang_translations": {
                                "ru": "В видео представлен плавный <w>морфинг</w> между двумя портретами."
                            }
                        },
                        {
                            "text": "Creating a realistic <w>morph</w> requires precise digital editing.",
                            "target_lang_translations": {
                                "ru": "Создание реалистичного <w>морфинга</w> требует точного цифрового редактирования."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерный эффект плавного перехода между двумя изображениями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морфинг",
                                "target_lang_sense_clarification": "термин для компьютерной графики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a396816-fc00-38d9-8449-15b670accb78",
                    "sense_definition": "A distinct physical variety of an animal or plant species",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This specific <w>morph</w> of the butterfly is only found in the rainforest.",
                            "target_lang_translations": {
                                "ru": "Эта конкретная <w>морфа</w> бабочки встречается только в тропических лесах."
                            }
                        },
                        {
                            "text": "Researchers are studying how each color <w>morph</w> survives in the wild.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают, как каждая цветовая <w>морфа</w> выживает в дикой природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "variant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная физическая разновидность вида животных или растений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морфа",
                                "target_lang_sense_clarification": "биологический термин для обозначения вариации"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "общий термин для биологического варианта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "543693e5-0aca-3b19-ac7b-4267c2d78c3c",
                    "sense_definition": "A specific sound or sequence of sounds representing a linguistic unit",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist identified each <w>morph</w> within the complex word structure.",
                            "target_lang_translations": {
                                "ru": "Лингвист определил каждый <w>морф</w> в сложной структуре слова."
                            }
                        },
                        {
                            "text": "A single <w>morph</w> can sometimes represent multiple grammatical functions.",
                            "target_lang_translations": {
                                "ru": "Один <w>морф</w> иногда может представлять несколько грамматических функций."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук или последовательность звуков, представляющая лингвистическую единицу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морф",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d6e7069-388b-3e5c-bba9-fc639926b502",
                    "sense_definition": "A variant form of a morpheme used in different contexts",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plural suffix has a different <w>morph</w> depending on the final sound of the root.",
                            "target_lang_translations": {
                                "ru": "Суффикс множественного числа имеет разный <w>алломорф</w> в зависимости от последнего звука корня."
                            }
                        },
                        {
                            "text": "Each <w>morph</w> functions as a realization of the same underlying morpheme.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>морф</w> функционирует как реализация одной и той же глубинной морфемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "allomorph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариантная форма морфемы, используемая в разных контекстах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алломорф",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5cf0885-c363-3cc0-bf9d-2106ba90d646",
                    "sense_definition": "Morphine",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier was given a dose of <w>morph</w> to manage the severe pain.",
                            "target_lang_translations": {
                                "ru": "Солдату дали дозу <w>морфина</w>, чтобы облегчить сильную боль."
                            }
                        },
                        {
                            "text": "Medical staff administered <w>morph</w> to the patient after the surgery.",
                            "target_lang_translations": {
                                "ru": "Медицинский персонал ввел пациенту <w>морфин</w> после операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "morphine"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used as a shorthand for morphine."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морфин"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морфин",
                                "target_lang_sense_clarification": "медицинский препарат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "011f51b7-9ca3-3490-8ce6-b727641feced",
                    "sense_definition": "A person who is intersex or has both male and female characteristics",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term <w>morph</w> is sometimes used in older or specific subcultural contexts to describe an intersex person.",
                            "target_lang_translations": {
                                "ru": "Термин <w>морф</w> иногда используется в старых или специфических субкультурных контекстах для описания интерсекс-человека."
                            }
                        },
                        {
                            "text": "Historical texts occasionally used the word <w>morph</w> to refer to a hermaphrodite.",
                            "target_lang_translations": {
                                "ru": "В исторических текстах слово <w>морф</w> иногда использовалось для обозначения гермафродита."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Considered outdated or potentially offensive in modern contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий признаками обоих полов (устаревшее)"
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}