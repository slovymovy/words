                                "target_senses": [
                                    {
                                        "sense_id": "39a998e8-d2f9-3333-bced-8ed93b42401e",
                                        "entry_id": "e413692f-8569-31bd-a160-3fce9ef02133",
                                        "glosses": [
                                            "jung geschlachtetes Huhn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "062d91e0-7a76-47da-a76d-dd496e7cdcc8",
                                                "sense_id": "39a998e8-d2f9-3333-bced-8ed93b42401e",
                                                "text": "Heute gibt’s Hühnchen."
                                            },
                                            {
                                                "example_id": "f48cc545-7714-4613-ac88-6b5ea02216ce",
                                                "sense_id": "39a998e8-d2f9-3333-bced-8ed93b42401e",
                                                "text": "„War ihr Latein voller Fehler, so bestachen sie mich mit gebratenen Rippchen oder Hühnchen, und oft gaben sie mir auch Geld.“"
                                            },
                                            {
                                                "example_id": "861b295e-baeb-4fa0-aa5f-c95d6b4587eb",
                                                "sense_id": "39a998e8-d2f9-3333-bced-8ed93b42401e",
                                                "text": "„Das Hühnchen entzückte Direktor Schallenberg aufs neue.“"
                                            },
                                            {
                                                "example_id": "db7b22f0-07a5-46e1-abcd-76cf47f03ab8",
                                                "sense_id": "39a998e8-d2f9-3333-bced-8ed93b42401e",
                                                "text": "„Hafrún backte Schokoladenkuchen, goss Kaffee auf, briet ein Hühnchen, eine Lammkeule, und beim Abendessen erstatteten sie ihr Bericht über das, was sie den Tag über gelesen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
