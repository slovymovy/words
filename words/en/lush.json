                                "target_lang_word": "alcoolique",
                                "target_lang_sense_clarification": "personne atteinte d'alcoolisme"
                            },
                            {
                                "target_lang_word": "poivrot",
                                "target_lang_sense_clarification": "terme argotique et péjoratif pour désigner un buveur"
                            }
                        ]
                    }
