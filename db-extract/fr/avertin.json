                        "sense_id": "f67392ee-af6b-30a2-af51-bd9a6e800add",
                        "entry_id": "df316d18-18bd-3550-ae5b-cc027ddfb9ed",
                        "glosses": [
                            "Maladie d’esprit qui rend opiniâtre, emporté, furieux."
                        ],
                        "tags": [
                            "Ancienne médecine"
                        ],
                        "examples": [
                            {
                                "example_id": "900a1557-8590-4d54-8ec5-d47b84340d08",
                                "sense_id": "f67392ee-af6b-30a2-af51-bd9a6e800add",
                                "text": "Voilà Madame en venaison,\nEn bon poinct, grasse et bien refaite,\nJalouse, fascheuse et sugette\nÀ son avertin, qui soudain\nSe met en son aigre levain\nPour crier après moy trois heures."
                            }
                        ]
                    },
                    {
                        "sense_id": "69dd4e0b-b9e0-3441-b3de-6bfa54918cbd",
                        "entry_id": "df316d18-18bd-3550-ae5b-cc027ddfb9ed",
                        "glosses": [
                            "Ceux qui étaient tourmentés de cette maladie."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "60557e9c-05f4-463f-9fe6-7ebb2f8ce35e",
                                "sense_id": "69dd4e0b-b9e0-3441-b3de-6bfa54918cbd",
                                "text": "Le peuple appelait Saint-Mathurin le patron des avertins."
                            }
                        ]
                    },
                    {
                        "sense_id": "854039e4-c935-35d7-8e61-e367dee47b08",
                        "entry_id": "df316d18-18bd-3550-ae5b-cc027ddfb9ed",
                        "glosses": [
                            "Maladie des moutons, tournis."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "245c85ea-2da3-4e02-85c1-4b62f954fbd9",
                                "sense_id": "854039e4-c935-35d7-8e61-e367dee47b08",
                                "text": "Ce troupeau appartenait au juge de Werst, le biró Koltz, lequel payait à la commune un gros droit de brébiage, et qui appréciait fort son pâtour Frik, le sachant très habile à la tonte, et très entendu au traitement des maladies, muguet, affilée, avertin, douve, encaussement, falère, clavelée, piétin, rabuze et autres affections d’origine pécuaire."
                            }
                        ]
