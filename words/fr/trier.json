                    "frequency": "Low",
                    "semantic_group_id": "calibrage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette machine agricole permet de <w>trier</w> les pommes selon leur calibre exact."
                        },
                        {
                            "text": "Les ouvriers <w>trient</w> les pièces pour écarter celles qui ne respectent pas les dimensions."
                        }
