                ],
                "senses": [
                    {
                        "sense_id": "b8084624-f6bc-3235-975a-8d430ae9a383",
                        "entry_id": "5b8b1687-df73-3bdf-b65a-929f680e3c0b",
                        "glosses": [
                            "Rakete, die mit einer Geschwindigkeit von über Mach 5 fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04393e4-b1eb-4300-b192-764eeae03c87",
                                "sense_id": "b8084624-f6bc-3235-975a-8d430ae9a383",
                                "text": "„Wir können uns höchstens bei unserer Rückkehr im Ortungsschatten des vierten Planeten verstecken und von dort eine weitere Hyperschallrakete auf sie abfeuern.“"
                            },
                            {
                                "example_id": "128407e5-1edb-4eac-929a-0ad6605b8238",
                                "sense_id": "b8084624-f6bc-3235-975a-8d430ae9a383",
                                "text": "„Ein Team meiner Ingenieure hat mit der Entwicklung einer Hyperschallrakete begonnen.“"
                            },
                            {
                                "example_id": "48fd89e4-fab9-4dfc-8910-ac916c4f2df7",
                                "sense_id": "b8084624-f6bc-3235-975a-8d430ae9a383",
                                "text": "„Die Bulawa ist eine Hyperschallrakete und schneller als alles andere da draußen.“"
                            },
                            {
                                "example_id": "046f0425-a7be-4ce4-ab37-828a0e1b0477",
                                "sense_id": "b8084624-f6bc-3235-975a-8d430ae9a383",
                                "text": "„Das von der selbsterklärten Atommacht Nordkorea am Dienstag abgefeuerte Geschoss ist eigenen Angaben zufolge eine neu entwickelte sogenannte Hyperschallrakete gewesen.“"
                            },
                            {
                                "example_id": "e5d69706-db1e-40d5-a4f0-0007bbde7b0a",
                                "sense_id": "b8084624-f6bc-3235-975a-8d430ae9a383",
                                "text": "„Weil China und Russland über ähnliche Waffensysteme verfügen, hat die amerikanische Luftwaffe nun auch Hyperschallraketen in Auftrag gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
