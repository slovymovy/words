                                "target_lang_sense_clarification": "运动队统一服装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5df966-4555-32a6-9baf-2f7694a254ab",
                    "sense_definition": "A street or road lined with many shops, restaurants, or entertainment venues.",
                    "learner_level": "B2",
