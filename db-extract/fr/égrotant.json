                    {
                        "sense_id": "4e82b516-fa97-3304-81a9-d92617c5cffa",
                        "entry_id": "afc0d934-bd2a-3b9d-9ca8-f40afecccd05",
                        "glosses": [
                            "Qui est malade de façon continue, permanente."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "6a9a7131-035a-463f-9bea-791d114ca8a9",
                                "sense_id": "4e82b516-fa97-3304-81a9-d92617c5cffa",
                                "text": "[…] tout en mariant le sien propre à une princesse de Dorne égrotante aussi noiraude qu’un pruneau et plate comme une limande."
                            },
                            {
                                "example_id": "e7bc37fd-3fae-4039-86b8-dbdb74c31b50",
                                "sense_id": "4e82b516-fa97-3304-81a9-d92617c5cffa",
                                "text": "Elle aurait dû se lasser de toutes ces histoires ressassées de prêtres égrotants, de maisons et de mémoires ruinées."
                            },
                            {
                                "example_id": "412b59c2-442c-4bdd-a0bd-ab7eec3f29cb",
                                "sense_id": "4e82b516-fa97-3304-81a9-d92617c5cffa",
                                "text": "- Elle a un fils, l’héritier du Val.\n- Il est débile, égrotant, objecta Stannis."
                            }
                        ]
                    }
