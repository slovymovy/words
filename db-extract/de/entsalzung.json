                "senses": [
                    {
                        "sense_id": "4d099f9b-0e76-3cdc-a6bd-81f2696646a5",
                        "entry_id": "27f45c8c-e715-3f06-a535-9575f0a10dfa",
                        "glosses": [
                            "Verringerung des Gehaltes an Salz in einem Gegenstand/Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf37c6e-c240-4a6b-96ea-fdc2327899b0",
                                "sense_id": "4d099f9b-0e76-3cdc-a6bd-81f2696646a5",
                                "text": "Nach ausreichender Entsalzung kann auch Meerwasser zum Trinken verwandt werden."
                            },
                            {
                                "example_id": "e4d35026-3318-42c5-a61c-2b9a4abc7036",
                                "sense_id": "4d099f9b-0e76-3cdc-a6bd-81f2696646a5",
                                "text": "In manchen Wüstengegenden kann der Boden erst nach voriger Entsalzung durch Bewässerung kultiviert werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c02f0c8a-5e10-4b08-bbea-9d3f99e1390b",
                        "source_entry_id": "27f45c8c-e715-3f06-a535-9575f0a10dfa",
                        "source_sense_id": "4d099f9b-0e76-3cdc-a6bd-81f2696646a5",
                        "source_sense_description": "Verringerung des Gehaltes an Salz in einem Gegenstand/Stoff",
                        "target_lang_word": "desalination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desalination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95866642-243d-3bf9-a327-3d0052fe95ec",
                                        "entry_id": "d5b2a50f-1041-3b89-aded-49e6894cad0b",
                                        "glosses": [
                                            "The process of removing salt from sea water in order to make drinking water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dfa5a23-60af-459e-ba8e-4ff1e48d541b",
                        "source_entry_id": "27f45c8c-e715-3f06-a535-9575f0a10dfa",
                        "source_sense_id": "4d099f9b-0e76-3cdc-a6bd-81f2696646a5",
                        "source_sense_description": "Verringerung des Gehaltes an Salz in einem Gegenstand/Stoff",
                        "target_lang_word": "dessalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e381b0a-a1f0-379d-adb1-9b2dac823ae8",
                                        "entry_id": "4e7a2974-4cc4-3882-8f91-b006b8b5ffd9",
                                        "glosses": [
                                            "Action de dessaler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9463ae-890c-48cc-b88a-815a5258e217",
                                                "sense_id": "6e381b0a-a1f0-379d-adb1-9b2dac823ae8",
                                                "text": "Lorsqu'on entreprend le dessalement d'une terre, il faut dessaler cette terre à fond; donner aux fossés la distance, la longueur et la pente convenables suivant la nature des terres à traiter, et enfin proportionner la surface à dessaler avec la quantité d'eau dont on peut disposer."
                                            },
                                            {
                                                "example_id": "c23a83ee-acca-4143-b97e-b5b9c715f3b5",
                                                "sense_id": "6e381b0a-a1f0-379d-adb1-9b2dac823ae8",
                                                "text": "Les quatre pays du Golfe - Bahrein, Koweit, Arabie Saoudite et Émirats Arabes Unis - qui obtiennent 75 % de leur eau par dessalement de l'eau de mer - ont, en fait, si peu d'eau douce qu'ils recourent à un coûteux dessalement de l'eau de mer. Le vrai coût du dessalement et du transport de l'eau, certainement considérable, est un secret d'État en Arabie Saoudite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dc3f3c6-3feb-3e48-9981-36a6588ca974",
                                        "entry_id": "4e7a2974-4cc4-3882-8f91-b006b8b5ffd9",
                                        "glosses": [
                                            "Diminution de la salinité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a437bd84-0c37-411a-9a5c-e7aaabb85694",
                                                "sense_id": "7dc3f3c6-3feb-3e48-9981-36a6588ca974",
                                                "text": "Dans les années 1970-1980, des dessalements continus s'étalant sur une quinzaine d'années, rythmés seulement par les variations saisonnières habituelles, ont été observés dans les eaux superficielles (jusqu'à 700 mètres de profondeur) des zones de convection de l'Atlantique nord. Ces dessalements avaient pour origine une fonte exceptionnelle de glaces de mer en provenance de l'océan Arctique."
                                            },
                                            {
                                                "example_id": "4cfe50da-70e6-44fa-95fc-b33796a61c8c",
                                                "sense_id": "7dc3f3c6-3feb-3e48-9981-36a6588ca974",
                                                "text": "Mais, en fonction du sens des échanges lagune-mer, la salinité peut augmenter et se propager davantage selon les saisons. Les grandes crues provoquent des dessalements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2649f8e6-0e0f-475b-9318-f4c43f5e9c53",
                        "source_entry_id": "27f45c8c-e715-3f06-a535-9575f0a10dfa",
                        "source_sense_id": "4d099f9b-0e76-3cdc-a6bd-81f2696646a5",
                        "source_sense_description": "Verringerung des Gehaltes an Salz in einem Gegenstand/Stoff",
                        "target_lang_word": "désalinisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désalinisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a977cf1e-a61e-338b-ac33-03540288842e",
                                        "entry_id": "b42f29bb-3a16-3de2-a82e-53054c0b788a",
                                        "glosses": [
                                            "Dessalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c1b2883-e070-4667-a228-f810285b414e",
                                                "sense_id": "a977cf1e-a61e-338b-ac33-03540288842e",
                                                "text": "Actuellement le coût de cette opération est relativement élevé mais les choses pourraient changer et la désalinisation pourrait devenir plus intéressante dans un avenir prévisible pour les utilisateurs de faibles quantités d'eau."
                                            },
                                            {
                                                "example_id": "c6abf07a-395c-4be7-b6ce-73658577753b",
                                                "sense_id": "a977cf1e-a61e-338b-ac33-03540288842e",
                                                "text": "La désalinisation de l’eau de mer constituerait-elle une solution durable aux problèmes de carences en eau ? La multiplication des capacités de production d’eau dessalée ( d'un facteur 3 entre 1990 et 2000 ) confirme au moins la compétitivité des différents procédés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
