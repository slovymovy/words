                    },
                    {
                        "translation_id": "715df5ee-f04b-4f2f-9f87-c36a90c1ee43",
                        "source_entry_id": "7b1209d5-3082-3f86-9459-a073485e3ad6",
                        "target_lang_word": "Reue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                        "entry_id": "ce319bfd-d95e-3ddd-9306-a0796cbdee30",
                                        "glosses": [
                                            "Bedauern über die eigene Tat, Selbstschuldbewusstsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779f4f74-ea0c-4b9a-9c96-6d1cc1293ed3",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Nur, ich hatte nichts zu bereuen, gar nichts, und ich würde also Reue heucheln müssen.“"
                                            },
                                            {
                                                "example_id": "85ee8b74-f222-484d-af86-8563007a5abe",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "Voll Reue über seine Tat, entschuldigte er sich."
                                            },
                                            {
                                                "example_id": "034967b0-028b-419f-bde8-b45ed8f08d28",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Reue überkam ihn.“"
                                            },
                                            {
                                                "example_id": "30e7a599-362f-4f92-b5b1-ed0f84e82793",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Die Augenblicke der Reue sind recht traurig.“"
                                            },
                                            {
                                                "example_id": "6ac254da-8682-48d0-a0ff-1f26e4dd9772",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Die Reue war Tag und Nacht bei mir, bis meine Frau einen viel besseren Mann geheiratet hatte, als ich jemals war oder sein konnte, und ich wusste, dass sie glücklich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8662d0fa-0374-3ab1-b830-b7d9a20a7865",
                                        "entry_id": "ce319bfd-d95e-3ddd-9306-a0796cbdee30",
                                        "glosses": [
                                            "ein Milderungsgrund bei der Strafbemessung"
                                        ],
                                        "tags": [
                                            "Justiz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3014f6ce-0226-472a-b277-d3e7029977ce",
                                                "sense_id": "8662d0fa-0374-3ab1-b830-b7d9a20a7865",
                                                "text": "Er zeigte tätige Reue, wodurch die Strafe gering ausfallen konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68e8d124-9b2f-4f26-a9cb-5fdf13a02df9",
                        "source_entry_id": "7b1209d5-3082-3f86-9459-a073485e3ad6",
                        "target_lang_word": "contrition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                        "entry_id": "9f8a34b7-93f0-3039-9645-74664e42da9c",
                                        "glosses": [
                                            "The state of being contrite; sincere penitence or remorse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da100a86-da5e-4a26-b2f3-7f65aad89904",
                                                "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                                "text": "Jonathan's mother told Grace on a recent phone call that Jonathan showed no sign of remorse or contrition for his own sister's passing."
                                            },
                                            {
                                                "example_id": "14a692d7-6123-402a-b717-de58f5eefad9",
                                                "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                                "text": "President Trump on Tuesday showed no contrition or regret for instigating the mob that stormed the Capitol and threatened the lives of members of Congress and his vice president, saying that his remarks to a rally beforehand were “totally appropriate” and that the effort by Congress to impeach and convict him was “causing tremendous anger.”"
                                            },
                                            {
                                                "example_id": "eff199eb-e612-47ff-bf5c-a7eb40ace5ba",
                                                "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                                "text": "Kremlin officials have shown no signs of contrition."
                                            }
                                        ]
                                    },
