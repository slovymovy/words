                "senses": [
                    {
                        "sense_id": "3fc42bca-1fed-3a84-9bee-4fca943a5587",
                        "entry_id": "2a76dec1-c4c2-3411-b32d-cfb01c4ecba8",
                        "glosses": [
                            "Person ohne Kenntnisse einer bestimmten Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b2c94d2-2796-4444-8880-96d0f2847bde",
                                "sense_id": "3fc42bca-1fed-3a84-9bee-4fca943a5587",
                                "text": "„Nullsprachler erhalten an unserer Schule individuell zugeschnittene Einzel- oder Kleingruppenförderungen.“"
                            },
                            {
                                "example_id": "6512dad7-18e3-41f3-ab61-9c1cb1ac7a12",
                                "sense_id": "3fc42bca-1fed-3a84-9bee-4fca943a5587",
                                "text": "„Wenn Lehrer sich verpflichten, parallel zum Job eine Zusatzqualifikation zu erwerben, können sie auch ohne Vorkenntnisse damit beginnen, sogenannte Nullsprachler zu unterrichten.“"
                            },
                            {
                                "example_id": "7076cb84-4e84-4c65-bede-a89f208f2ca3",
                                "sense_id": "3fc42bca-1fed-3a84-9bee-4fca943a5587",
                                "text": "„In Sachsen und Brandenburg hat die sorbische Minderheit ein Recht auf adäquaten Sprachenunterricht an den Schulen, es werden sogar mehr Lehrer gebraucht als wir ausbilden können. Ein Nachwuchsproblem haben wir definitiv. Daher können mittlerweile auch Nullsprachler das Studium bei uns beginnen, das setzt aber eine Menge Motivation und Fleiß voraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
