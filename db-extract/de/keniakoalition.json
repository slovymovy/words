                "senses": [
                    {
                        "sense_id": "4c669dd3-4c78-39ee-8592-bcbe62078353",
                        "entry_id": "87e53c8b-d4d3-3add-80b2-368919e9e84e",
                        "glosses": [
                            "schwarz-rot-grüne Koalition aus CDU, SPD und den Grünen nach den in der kenianischen Nationalflagge verwendeten Farben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c409f9-5ece-46e2-ab58-0f240105e287",
                                "sense_id": "4c669dd3-4c78-39ee-8592-bcbe62078353",
                                "text": "„Vor welchen Konflikten stünde eine große Koalition in Rheinland-Pfalz beziehungsweise die sogenannte Keniakoalition in Sachsen-Anhalt?“"
                            },
                            {
                                "example_id": "2e4cba8d-93ff-495b-96f3-a9a3c8b5f20a",
                                "sense_id": "4c669dd3-4c78-39ee-8592-bcbe62078353",
                                "text": "Äußerst diszipliniert und seriös laufen derzeit die Haushaltsverhandlungen ab. Ungewohnt still verhandelt die Keniakoalition hinter verschlossenen Türen. Wer will am meisten, wer kriegt am wenigsten? Nichts dringt nach außen."
                            }
                        ],
                        "sense_index_json": "\"1\""
