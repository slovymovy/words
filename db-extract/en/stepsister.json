                                            {
                                                "example_id": "08b7201b-4ac0-4c57-86f1-366327610ef9",
                                                "sense_id": "23898999-4826-31f4-969b-93c65a75ac8f",
                                                "text": "Ihr Verhältnis zu ihrer Stiefschwester wurde mit der Zeit immer besser."
                                            },
                                            {
                                                "example_id": "e6c12a08-3cfa-46c9-9390-2f8a8cccd5db",
                                                "sense_id": "23898999-4826-31f4-969b-93c65a75ac8f",
                                                "text": "„Recha hob die Hand, schlug nach Leas Stiefschwester und machte Anstalten, sie wieder hinauszuwerfen, was die Schwangere, außer sich vor Lachen, mit schwerfälligen Bewegungen vereitelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52d40dc8-c054-3e6b-969a-d8c1d76a22b0",
                                        "entry_id": "591b1595-10df-3e16-a7d5-388e862b08c5",
                                        "glosses": [
                                            "weibliches Kind in einer Stieffamilie aus der Sicht eines anderen Kindes derselben Familie, mit dem es keinen gemeinsamen Elternteil hat (Kind nur des eigenen Stiefvaters oder nur der eigenen Stiefmutter)"
                                        ],
