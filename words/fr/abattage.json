                },
                {
                    "sense_id": "f702d6af-116c-3883-a37c-96007c899e28",
                    "sense_definition": "Action de poser et d'exposer ses cartes face visible sur la table de jeu.",
                    "learner_level": "C1",
                    "frequency": "Low",
