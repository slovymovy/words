                    {
                        "sense_id": "b810e846-e682-37f2-b4b0-a25650d1b0f4",
                        "entry_id": "eb8759c8-f9f6-37df-87fc-e19cc0be92ae",
                        "glosses": [
                            "groep vrouwen die een relatie hebben met één man"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2178a965-6bed-4b39-a5a4-9ec05338c664",
                                "sense_id": "b810e846-e682-37f2-b4b0-a25650d1b0f4",
                                "text": "Hefner had er een roulerende harem vriendinnen. Het was een comfortabele en tegelijkertijd harde wereld, schrijft Holly Madison in Down the Rabbit Hole, haar boek over haar tijd als ‘playmate’. Hefner betaalde voor alles, inclusief kleding en plastische chirurgie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e067321a-6ce5-4c69-8d7b-93963c2e071a",
                        "source_entry_id": "eb8759c8-f9f6-37df-87fc-e19cc0be92ae",
                        "source_sense_id": "99eeeb06-19ee-3a3e-bdd3-f9ca0acaf05c",
                        "source_sense_description": "het voor vrouwen bestemde deel van een woning van een mohammedaan",
                        "target_lang_word": "Harem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4df28b-bab5-37f5-802c-a451ede4148d",
                                        "entry_id": "56c30b5b-4efa-3bc8-8c27-ee71e632f1d9",
                                        "glosses": [
                                            "von den Männern abgegrenzter Wohnbereich für Frauen in einem Haus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7659d94a-b8dd-42eb-9ff5-b4e45781a979",
                                                "sense_id": "3b4df28b-bab5-37f5-802c-a451ede4148d",
                                                "text": "Eunuchen wurde oft als Wächter und Diener in einem Harem eingesetzt."
                                            },
                                            {
                                                "example_id": "bb965edf-b905-4d95-ba09-c96dcf2e5c48",
                                                "sense_id": "3b4df28b-bab5-37f5-802c-a451ede4148d",
                                                "text": "„Aber meine Freundin möchte ja nicht in einem Harem landen.“"
                                            },
                                            {
                                                "example_id": "b131a727-0c31-42f4-939a-73bb02e463f9",
                                                "sense_id": "3b4df28b-bab5-37f5-802c-a451ede4148d",
                                                "text": "„Er fand aber schon die Anfahrt zu meinem Harem sensationell.“"
                                            },
                                            {
                                                "example_id": "bfdf7e1b-9095-4e14-a091-6052e83a1782",
                                                "sense_id": "3b4df28b-bab5-37f5-802c-a451ede4148d",
                                                "text": "„Hier erhält ein Großwesir, der sich in seinem Harem dem Liebesspiel hingibt, plötzlich von einem Boten des nahenden Feindes eine seidene Schnur überreicht, als Fanal seines unmittelbar bevorstehenden Todes.“"
                                            },
                                            {
                                                "example_id": "7b6366fe-c364-44d1-bf26-f8e4ae0f6728",
                                                "sense_id": "3b4df28b-bab5-37f5-802c-a451ede4148d",
                                                "text": "„Wir kommen an eine ungeheure Mauer, und der Führer sagt: Das ist der Harem des Sultans.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfdf4397-de92-32b7-86d8-bf04c8e46257",
                                        "entry_id": "56c30b5b-4efa-3bc8-8c27-ee71e632f1d9",
                                        "glosses": [
                                            "Gesamtheit der in [1] lebenden Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e3e64c-1495-48f9-bc4e-a5c2c94906ce",
                                                "sense_id": "cfdf4397-de92-32b7-86d8-bf04c8e46257",
                                                "text": "Der Herrscher befahl, dass sein Harem mitreisen soll."
                                            },
                                            {
                                                "example_id": "190fa25f-4b3a-44a8-ad35-4acb9072ebfb",
                                                "sense_id": "cfdf4397-de92-32b7-86d8-bf04c8e46257",
                                                "text": "„Auch der Harem weinte, und als ich für wahrscheinlich lange Zeit oder, noch wahrscheinlicher, für immer Abschied von meinem Zauberinnenhof nahm, hätte ich um ein Haar endlich auch zu weinen begonnen, stattdessen äußerte sich der emotionale Kontrollverlust in einem bösen Sturz vor der Haustür.“"
                                            },
                                            {
                                                "example_id": "0d98d738-4924-4c3e-a8cd-6e346628e36d",
                                                "sense_id": "cfdf4397-de92-32b7-86d8-bf04c8e46257",
                                                "text": "„Zum dritten beachte man, daß der Harem keineswegs aus »Frauen« des Sultans besteht, sondern eine Gemeinschaft sämtlicher Damen des kaiserlichen Hauses mit ihren Sklavinnen und den Dienerinnen der Sklavinnen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
