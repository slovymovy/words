                                        "glosses": [
                                            "Qualité de ce qui est invariable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ddf72ee-367b-416a-98ca-5683d1f766d9",
                                                "sense_id": "741f373b-07b2-3183-a2f6-bec00bcbe198",
                                                "text": "L’invariabilité de ses principes."
                                            },
                                            {
                                                "example_id": "15608faf-505b-4d76-abc0-41c6955b7d68",
                                                "sense_id": "741f373b-07b2-3183-a2f6-bec00bcbe198",
                                                "text": "Comme lui mathématicien et polytechnicien, Comte a toujours refusé la théorie des probabilités parce qu’elle lui semblait aller contre le principe de l’invariabilité des lois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
