                        "glosses": [
                            "A neurotransmitter in humans and other animals. It is an ester of acetic acid and choline with chemical formula CH₃COOCH₂CH₂N⁺(CH₃)₃."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
