                "senses": [
                    {
                        "sense_id": "59606362-2f7b-3853-bf62-bd70abe8bba1",
                        "entry_id": "0cd00e09-6e27-34af-be67-2272e5cea5bb",
                        "glosses": [
                            "Vorteil, den man in Anspruch nehmen kann, wenn man eine Schutzimpfung (gegen SARS-CoV-2) nachweisen kann"
                        ],
                        "tags": [
                            "in der Schweiz verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "6401fe07-a5e5-479b-b19f-2890cc6a51ba",
                                "sense_id": "59606362-2f7b-3853-bf62-bd70abe8bba1",
                                "text": "„Jetzt kommt das erste Impfprivileg: Was Sie zum vierten Öffnungspaket wissen müssen.“"
                            },
                            {
                                "example_id": "f5ec1971-8baf-4e53-aefa-07b4bac660d5",
                                "sense_id": "59606362-2f7b-3853-bf62-bd70abe8bba1",
                                "text": "„Aus einem diese Woche publik gewordenen Papier geht hervor, dass der Bundesrat für ein Impfprivileg ist.“"
                            },
                            {
                                "example_id": "41bf0a0c-6591-41f7-a45a-cbaab795e74b",
                                "sense_id": "59606362-2f7b-3853-bf62-bd70abe8bba1",
                                "text": "„Der Bundesrat hat am Mittwoch das erste Impfprivileg beschlossen. Gegen das Coronavirus geimpfte Bewohner von Altersheimen dürfen die Maske im Heim ablegen.“"
                            },
                            {
                                "example_id": "745b2d39-0da8-4bc2-bfbb-3173b95fdcf9",
                                "sense_id": "59606362-2f7b-3853-bf62-bd70abe8bba1",
                                "text": "„Etwas Vergleichbares ist mit dem hitzig diskutierten Impfprivileg gewiss nicht gemeint. Vielmehr geht es wie beim Steuerprivileg auch hier angeblich um echte Vorrechte, wie die Möglichkeit des Reisens oder des Zutritts zu Konzerten oder Restaurants.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
