                "senses": [
                    {
                        "sense_id": "e8fcb485-4c1b-338d-afe5-b596beccdf3e",
                        "entry_id": "3c1d9ae8-0b59-3e52-878b-6d423aeed706",
                        "glosses": [
                            "religiöses Oberhaupt einer größeren jüdischen Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c454e8dd-aa85-48a8-a41e-39173a7b512f",
                                "sense_id": "e8fcb485-4c1b-338d-afe5-b596beccdf3e",
                                "text": "„In einer selten kühnen Geste setzte sich Rabbi Avraham Jizchak Hacohen Kook, der bald zum Oberrabbiner Palästinas ernannt werden sollte, über die Heiligkeit des siebenten Tages des Pessachfestes hinweg und unterzeichnete, noch in der Synagoge, eine Petition zugunsten Jabotinskys und seiner Kameraden.“"
                            },
                            {
                                "example_id": "a2704d63-8fa2-4f53-9400-f3a5bfd38cc0",
                                "sense_id": "e8fcb485-4c1b-338d-afe5-b596beccdf3e",
                                "text": "„Israel könnte auch ein entfernter Ableger des heutigen Iran sein, wenn man sich das Gerede einiger ehemaliger Oberrabbiner anhört.“"
                            },
                            {
                                "example_id": "db4885db-3c4f-43f1-bd41-798db16cf033",
                                "sense_id": "e8fcb485-4c1b-338d-afe5-b596beccdf3e",
                                "text": "„Einen gespaltenen Eindruck hinterließ die Begegnung mit der Westmauer auch bei dem langjährigen Oberrabbiner von Baden bei Wien, Wilhelm Reich (1852-1929), der als Teilnehmer der ‹Ersten jüdischen Reisegesellschaft aus Oesterreich nach dem heiligen Lande› im März 1905 Palästina bereiste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
