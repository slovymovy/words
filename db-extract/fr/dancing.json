                                "target_senses": [
                                    {
                                        "sense_id": "fa056c04-9c91-33f5-b3de-89348d479aff",
                                        "entry_id": "226e8940-adb3-3050-9584-d5fe22677112",
                                        "glosses": [
                                            "Alternative form of dancehall."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac27e50e-99a8-4157-a73b-6e0b64fb1911",
                                                "sense_id": "fa056c04-9c91-33f5-b3de-89348d479aff",
                                                "text": "Cheap evening trips at a uniform fare after 6 p.m. are a feature of the northern line facilities, and include tickets to one resort which combine travel and admission to a dance hall."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f74bce4-4061-4c74-b061-7eed70e90cbd",
                        "source_entry_id": "afbd5132-232c-3c39-b805-87b0ef342f20",
                        "source_sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                        "target_lang_word": "dancehall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dancehall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0697f092-a3f2-335f-b0aa-8eb8baca6587",
                                        "entry_id": "86de7956-93f1-3672-b926-7fb008cd6062",
                                        "glosses": [
                                            "A public hall for dancing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b026f0-35fb-4001-bbd7-29ee7ad81bd3",
                                                "sense_id": "0697f092-a3f2-335f-b0aa-8eb8baca6587",
                                                "text": "Six years later there were barely any dancehalls to supervise—it was all glitzy discos attached to pubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582be18d-3700-3825-a4a0-63f27e88aa36",
                                        "entry_id": "86de7956-93f1-3672-b926-7fb008cd6062",
                                        "glosses": [
                                            "A genre of Jamaican dance music derived from dub and reggae."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93e43412-bbc8-4a8e-8e99-3a002106aec2",
                                                "sense_id": "582be18d-3700-3825-a4a0-63f27e88aa36",
                                                "text": "It sounded Jamaican to me, a form of dancehall, and […] I wandered over and watched the dancing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
