                        "comportement narcissique"
                    ]
                },
                {
                    "sense_id": "1de73f26-7a81-3da3-88c8-1dd5c2da0152",
                    "sense_definition": "Relatif au narcissisme, notamment sur le plan psychanalytique ou psychiatrique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le psychologue a diagnostiqué une profonde blessure <w>narcissique</w> causée par cet échec retentissant."
                        },
                        {
                            "text": "Cette thérapie permet de soigner un trouble <w>narcissique</w> qui handicape ses relations amicales."
                        }
                    ],
                    "common_phrases": [
                        "blessure narcissique",
                        "trouble narcissique"
                    ]
                },
                {
                    "sense_id": "9061a1fd-de29-3f8f-a4ed-47c03b55d9b9",
                    "sense_definition": "Qualifie un nombre entier égal à la somme des puissances de ses chiffres d'ordre égal au nombre de ces chiffres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur explique aux élèves pourquoi cent cinquante-trois est considéré comme un nombre <w>narcissique</w>."
                        },
                        {
                            "text": "Trois cent soixante-dix est un nombre <w>narcissique</w>, égal à la somme des cubes de ses chiffres."
                        }
                    ],
                    "common_phrases": [
                        "nombre narcissique"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff2255de-ac7f-3380-8f89-7386ea8df0af",
                    "sense_definition": "Personne qui a une admiration excessive pour elle-même.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "admiration_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune homme est un <w>narcissique</w> qui ne s'intéresse jamais aux problèmes des autres."
                        },
                        {
                            "text": "Les <w>narcissiques</w> ont souvent du mal à accepter la moindre remarque critique sur leur travail."
                        }
                    ],
                    "synonyms": [
                        "narcissiste"
                    ]
                },
                {
                    "sense_id": "efd3655d-20c3-37bb-a5f9-e88e496d9954",
                    "sense_definition": "Personne présentant les symptômes cliniques du narcissisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face au refus persistant de coopérer, le psychiatre a identifié les réactions typiques d'un <w>narcissique</w>."
                        },
                        {
                            "text": "Selon ce spécialiste, le <w>narcissique</w> réagit souvent par une colère violente lorsqu'on le confronte à la réalité."
                        }
                    ],
                    "synonyms": [
                        "narcissiste"
                    ]
                }
            ]
        }
