    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "287c5b0b-e943-37f9-94b5-454c8dcff964",
                    "sense_definition": "Évolution vers un état pire ; affaiblissement ou altération progressive d'une situation, de la santé ou de l'environnement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques constatent une rapide <w>dégradation</w> des conditions climatiques sur l'ensemble de la planète."
                        },
                        {
                            "text": "Le médecin s'inquiète de la <w>dégradation</w> de l'état de santé de ce patient âgé."
                        }
                    ],
                    "synonyms": [
                        "détérioration",
                        "dégénérescence",
                        "aggravation"
                    ],
                    "antonyms": [
                        "amélioration",
                        "rétablissement"
                    ],
                    "common_phrases": [
                        "dégradation de la situation",
                        "dégradation de l'environnement"
                    ]
                },
                {
                    "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                    "sense_definition": "Dégât ou dommage matériel commis sur un bâtiment, un objet ou une propriété.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la manifestation, la mairie a constaté d'importantes <w>dégradations</w> sur les vitrines des magasins."
                        },
                        {
                            "text": "Le propriétaire demande une compensation financière pour chaque <w>dégradation</w> commise dans l'appartement."
                        }
                    ],
                    "synonyms": [
                        "dégât",
                        "détérioration",
                        "saccage"
                    ],
                    "antonyms": [
                        "réparation",
                        "restauration"
                    ],
                    "common_phrases": [
                        "commettre des dégradations",
                        "dégradations matérielles"
                    ]
                },
                {
                    "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                    "sense_definition": "Perte de la dignité, déchéance morale ou avilissement d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La misère extrême peut parfois entraîner une lente <w>dégradation</w> morale chez les individus isolés."
                        },
                        {
                            "text": "Ce roman dépeint la progressive <w>dégradation</w> spirituelle d'un homme corrompu par le pouvoir."
                        }
                    ],
                    "synonyms": [
                        "avilissement",
                        "déchéance",
                        "abaissement"
                    ],
                    "antonyms": [
                        "élévation",
                        "ennoblissement"
                    ],
                    "common_phrases": [
                        "dégradation morale"
                    ]
                },
                {
                    "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                    "sense_definition": "Privation officielle et infamante d'un grade, d'un titre militaire ou d'une fonction publique à titre de punition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dignite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a prononcé la <w>dégradation</w> solennelle de cet officier reconnu coupable de haute trahison."
                        },
                        {
                            "text": "La cérémonie publique de sa <w>dégradation</w> militaire fut une épreuve particulièrement humiliante."
                        }
                    ],
                    "synonyms": [
                        "destitution",
                        "déposition",
                        "cassation"
                    ],
                    "antonyms": [
                        "promotion",
                        "nomination"
                    ],
                    "common_phrases": [
                        "dégradation militaire"
                    ]
                },
                {
                    "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                    "sense_definition": "Diminution ou transition progressive et insensible de la lumière, des ombres ou des couleurs dans un dégradé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a réussi une subtile <w>dégradation</w> des ombres sur le visage du modèle."
                        },
                        {
                            "text": "À la fin du jour, la lente <w>dégradation</w> des teintes transforme entièrement le paysage maritime."
                        }
                    ],
                    "synonyms": [
                        "dégradé",
                        "estompage"
                    ],
                    "common_phrases": [
