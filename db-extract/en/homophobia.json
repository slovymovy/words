                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f2f0a9-68c3-482b-90b3-cc3eca157a14",
                                                "sense_id": "642a4ca9-9f38-35ad-a13a-16fb6c56f8f6",
                                                "text": "Om homofobie uit het voetbal te weren heeft de Engelse club Arsenal zich verbonden aan de Rainbow Laces-campagne."
