                "senses": [
                    {
                        "sense_id": "3f06b938-331a-34b0-96d4-66de80ae1b31",
                        "entry_id": "7f388606-08a2-3dfc-a56e-ddb77e58bbc6",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die Zigaretten herstellen oder Dienstleistungen zur Herstellung von Zigaretten anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3781f53b-cfea-4ccc-8a81-1a1909f4b73c",
                                "sense_id": "3f06b938-331a-34b0-96d4-66de80ae1b31",
                                "text": "Die Zigarettenindustrie wehrt sich gegen die erhobene Kritik."
                            },
                            {
                                "example_id": "48d5cddd-e581-449a-83ad-160dbabddec6",
                                "sense_id": "3f06b938-331a-34b0-96d4-66de80ae1b31",
                                "text": "„Die Endlos-Strangmaschine, die vom Prinzip her noch heute in der Zigarettenindustrie im Einsatz ist, spuckte zu dieser Zeit schon 60000 bis 70000 Zigaretten pro Stunde aus.“"
                            },
                            {
                                "example_id": "9dc8ee5b-e995-44de-b066-78966d818cb4",
                                "sense_id": "3f06b938-331a-34b0-96d4-66de80ae1b31",
                                "text": "„Die erste prominente Witwe, die die Zigarettenindustrie verklagte, war die Witwe von King Cole.“"
                            }
                        ],
