                                "sense_id": "1f5eae2e-dc95-32b1-9375-5ae8af62a201",
                                "text": "„Das britische Nationalarchiv hat knapp hundert Jahre nach Beginn des Ersten Weltkriegs die Tagebücher britischer Offiziere veröffentlicht.“"
                            },
                            {
                                "example_id": "0437a868-5f2f-48bc-83a4-2dd1a73bf853",
                                "sense_id": "1f5eae2e-dc95-32b1-9375-5ae8af62a201",
                                "text": "„Im litauischen Nationalarchiv befinden sich die Akten zahlreicher Wolfskinder, die zu Sowjetzeiten registriert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
