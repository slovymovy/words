                "senses": [
                    {
                        "sense_id": "993c64b3-a0db-3338-af09-c8387a3c546f",
                        "entry_id": "ccd7a9d5-08d1-370f-933d-6d7b75267335",
                        "glosses": [
                            "pogoda dżdżysta, deszczowa, nieprzyjemna od wilgoci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2769c0e9-7832-487f-8ceb-623d6b1e23b6",
                                "sense_id": "993c64b3-a0db-3338-af09-c8387a3c546f",
                                "text": "Ni żywej duszy nie wypatrzył pod sczerniałymi od pluchy topolami."
                            },
                            {
                                "example_id": "9e1b2fc3-24da-49af-aa66-a86cf2969970",
                                "sense_id": "993c64b3-a0db-3338-af09-c8387a3c546f",
                                "text": "[…] ćma była i plucha […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1302a7a7-1af4-4a55-936a-8ba77af1302a",
                        "source_entry_id": "ccd7a9d5-08d1-370f-933d-6d7b75267335",
                        "source_sense_id": "993c64b3-a0db-3338-af09-c8387a3c546f",
                        "target_lang_word": "blustery weather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "77132ce8-9fd3-41ca-a78e-1d671126a9ca",
                        "source_entry_id": "ccd7a9d5-08d1-370f-933d-6d7b75267335",
                        "source_sense_id": "993c64b3-a0db-3338-af09-c8387a3c546f",
                        "target_lang_word": "Matschwetter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "de3001d6-a588-4c03-9dc2-a7a0aa18a0ed",
                        "source_entry_id": "ccd7a9d5-08d1-370f-933d-6d7b75267335",
                        "source_sense_id": "993c64b3-a0db-3338-af09-c8387a3c546f",
                        "target_lang_word": "Regenwetter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                        "entry_id": "f290aa02-b11e-3c11-b144-53cf5b5985f3",
                                        "glosses": [
                                            "regnerisches, schlechtes Wetter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0accf3ec-4fb6-4ac8-ac1d-1a1582c980ca",
                                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                                "text": "Laut der Wettervorhersage steht uns in den nächsten Tagen Regenwetter bevor."
                                            },
                                            {
                                                "example_id": "ece3541e-ec4e-4a74-9dec-0b412cd7d55f",
                                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                                "text": "„Und keiner soll glauben, daß es mir bei Regenwetter übler erging.“"
                                            },
                                            {
                                                "example_id": "2a24e951-9fb1-4e59-a7b7-0824b26d0010",
                                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                                "text": "„Der Kutscher sprach die Hoffnung aus, es möge bis Wilna kein schweres Regenwetter geben, sonst müssten die Kranken ersaufen.“"
                                            },
                                            {
                                                "example_id": "e5790917-e44a-45a0-b867-be2d8d285fde",
                                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                                "text": "„Ihre Giebelstube war, wie sie von ihr verlassen, ausgenommen, daß man das Dach neu gedeckt, und die Giebelwände, durch die es im Herbst bei Regenwetter geleckt, waren ausgebessert; ein neues Fenster hatte man eingesetzt, und es duftete nach gehobeltem Holz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
