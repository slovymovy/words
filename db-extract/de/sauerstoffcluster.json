                ],
                "senses": [
                    {
                        "sense_id": "56b47ad7-6289-3ab8-b00f-29a590caa776",
                        "entry_id": "c32797b6-bc43-3bf3-9d31-b9371f5180b5",
                        "glosses": [
                            "als einheitliches Ganzes zu betrachtende Menge von gruppierten, geladenen Sauerstoffatomen oder -molekülen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "46b2c985-65b4-4427-bd07-1b5d0f07e9dd",
                                "sense_id": "56b47ad7-6289-3ab8-b00f-29a590caa776",
                                "text": "„Analysiert man im Rahmen eines tight-binding -Modells die Molekülorbitale des die Leerstelle umgebenden Sauerstoffclusters, so findet man einen energetisch favorisierten magnetischen Triplett-Zustand (S=1).“"
                            },
                            {
                                "example_id": "1a1d8494-8fae-43f1-b6a3-76719e8b4e01",
                                "sense_id": "56b47ad7-6289-3ab8-b00f-29a590caa776",
                                "text": "„Es entstehen sogenannte Sauerstoff-Cluster, also Molekültrauben von ca. 10-60 O²-Molekülen.“"
                            },
                            {
                                "example_id": "8eff6259-e896-4f92-aeef-2f391760ff39",
                                "sense_id": "56b47ad7-6289-3ab8-b00f-29a590caa776",
                                "text": "„Unter aktiviertem Sauerstoff versteht man Sauerstoff in Form von Sauerstoffionen (O2+, O2-, Sauerstoffcluster O2+/-) sowie Sauerstoffradikalen (O3, O).“"
                            },
                            {
                                "example_id": "dd95bf99-7df4-4b75-b0bc-533d967c26ab",
                                "sense_id": "56b47ad7-6289-3ab8-b00f-29a590caa776",
                                "text": "„Hierbei entstehen Sauerstoffcluster, die aufgrund ihres hohen Oxidationspotentials die Eigenschaft haben, Schadstoffe, Geruchsmoleküle, Bakterien, Schimmel und Viren zu neutralisieren.“"
                            },
                            {
                                "example_id": "4dac4429-c370-42ff-bf0b-cb7dd1591fa2",
                                "sense_id": "56b47ad7-6289-3ab8-b00f-29a590caa776",
                                "text": "„Die oberflächennahe Schicht ist quasi völlig frei von unerwünschten Dotanten, Störungen der kristallinen Strukturen, von Rekombinationszentren sowie komplexen Sauerstoffclustern, letzteres insbesondere auch, um Degradationseffekte zu minimieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
