                "senses": [
                    {
                        "sense_id": "667f9b16-eabb-30bd-becc-b87b2a8520de",
                        "entry_id": "1f1cfd6e-fa34-32f9-a832-aaf06bb49a1f",
                        "glosses": [
                            "alle fünf Minuten tritt etwas neu ein; alle fünf Minuten wiederholt sich etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c84edf-93df-4284-9762-e2d5591ef1b8",
                                "sense_id": "667f9b16-eabb-30bd-becc-b87b2a8520de",
                                "text": "„Die meisten Frequent Traveller fahren so lässig zum Flughafen, als gingen Flieger im Fünf-Minuten-Takt.“"
                            },
                            {
                                "example_id": "0931e356-74eb-4dc8-8c59-bf03b5abe2aa",
                                "sense_id": "667f9b16-eabb-30bd-becc-b87b2a8520de",
                                "text": "„Trotz eines Sturmlaufs über 91 Minuten und Chancen im Fünf-Minuten-Takt kam die Mannschaft gegen Borussia Mönchengladbach nicht über ein 1:1 (1:1) hinaus.“"
                            },
                            {
                                "example_id": "296bc6dc-71d5-4927-8f80-d8e464d30748",
                                "sense_id": "667f9b16-eabb-30bd-becc-b87b2a8520de",
                                "text": "„Im Fünf-Minuten-Takt übermittelt Oestkraft den aktuellen Preis für eine Kilowattstunde Strom.“"
                            },
                            {
                                "example_id": "b468d504-d9a9-47f8-b252-57442da5e10c",
                                "sense_id": "667f9b16-eabb-30bd-becc-b87b2a8520de",
                                "text": "„Zweieinhalb Stunden lang werden im Fünf-Minuten-Takt Speisen aufgetischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
