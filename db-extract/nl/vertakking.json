                "senses": [
                    {
                        "sense_id": "bef76526-b202-3066-adb6-d1af04997989",
                        "entry_id": "44643b5f-a904-38b1-922d-c7298b068b2c",
                        "glosses": [
                            "plaats waar iets vertakt is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a0b71e-2bad-4a33-a195-783d6893ef0e",
                                "sense_id": "bef76526-b202-3066-adb6-d1af04997989",
                                "text": "Er zijn in totaal vier hennepkwekerijen geruimd aan de Botniastate, Dahliastraat en Johan Jongkindstraat. In een woning werden 700 'stengels'aangetroffen. \"Men had blijkbaar net geoogst\", meldt de politie op Facebook. Bij twee woningen werd illegaal stroom afgetapt en bij de andere woningen hadden de kwekers volgens de politie 'levensgevaarlijke vertakkingen'gefabriceerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8db8bcc-1066-3118-ad4a-8dead65f3cfd",
                        "entry_id": "44643b5f-a904-38b1-922d-c7298b068b2c",
                        "glosses": [
                            "een van de delen die na het splitsen ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2499f90-46d8-4319-a1e8-161795df07be",
                                "sense_id": "b8db8bcc-1066-3118-ad4a-8dead65f3cfd",
                                "text": "Hoogleraar criminoloog Emile Kolthoff spreekt zelfs over grote georganiseerde misdaad met internationale vertakkingen die niet kan worden bedreven met slechts één vissersboot."
                            },
                            {
                                "example_id": "2fd83aa7-aa99-4b47-a6de-ebb6d0b4c6ab",
                                "sense_id": "b8db8bcc-1066-3118-ad4a-8dead65f3cfd",
                                "text": "Toen Reza Bakhtali de kans kreeg een deel van India te ontdekken, twijfelde hij geen moment. India is immers het land van zijn voorouders. De cruise over een vertakking van de heilige rivier Ganges werd een prachtige kennismaking met zijn verleden."
                            },
                            {
                                "example_id": "fbf64fca-ecd4-4342-9526-01a5017a9e29",
                                "sense_id": "b8db8bcc-1066-3118-ad4a-8dead65f3cfd",
                                "text": "Het internationale onderzoek in Duitsland, België en Cyprus kent volgens het Openbaar Ministerie vertakkingen naar ondernemingen in Brabant en Limburg. Het belastingnadeel overtreft volgens schattingen de 2 miljoen euro."
                            }
                        ]
                    }
                ],
