                {
                    "sense_id": "7eab69ab-dbe9-3619-a305-f4f7bfa9f38e",
                    "sense_definition": "Situation ou action dérisoire, ridicule ou trompeuse, indigne d'être prise au sérieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plaisanterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette élection sans véritables candidats d'opposition était une pure <w>farce</w>.",
                            "target_lang_translations": {
                                "en": "This election, with no real opposition candidates, was an utter <w>farce</w>.",
                                "ru": "Эти выборы без настоящих оппозиционных кандидатов были чистой воды <w>фарсом</w>.",
                                "de": "Diese Wahl ohne echte Oppositionskandidaten war eine reine <w>Farce</w>.",
                                "es": "Esta elección, sin verdaderos candidatos de la oposición, fue una pura <w>farsa</w>.",
                                "zh": "这场选举没有真正的反对派候选人，简直就是一场十足的<w>闹剧</w>。"
                            }
                        },
                        {
                            "text": "Tout le procès n'était qu'une mauvaise <w>farce</w> organisée par le régime.",
                            "target_lang_translations": {
                                "en": "The whole trial was nothing more than a sorry <w>farce</w> staged by the regime.",
                                "ru": "Весь судебный процесс был лишь жалким <w>фарсом</w>, устроенным режимом.",
                                "de": "Der ganze Prozess war nur eine schlechte <w>Farce</w>, vom Regime inszeniert.",
                                "es": "Todo el juicio no fue más que una mala <w>farsa</w> montada por el régimen.",
                                "zh": "整场审判不过是当局炮制的一场拙劣的<w>把戏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mascarade",
                        "comédie"
                    ],
                    "common_phrases": [
                        "mauvaise farce"
                    ],
                    "target_lang_definitions": {
                        "en": "A situation or action that is ridiculous, sham or deceptive and unworthy of serious attention.",
                        "ru": "Нелепая или обманчивая ситуация, поступок или мероприятие, которые нельзя принимать всерьёз.",
                        "de": "Eine lächerliche, unwürdige oder betrügerische Angelegenheit, die man nicht ernst nehmen kann.",
                        "es": "Situación o acción ridícula o engañosa que no merece tomarse en serio.",
                        "zh": "荒唐可笑、弄虚作假，不值得认真对待的情形或行为。"
