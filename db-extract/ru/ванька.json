                ],
                "senses": [
                    {
                        "sense_id": "ffea8438-9a10-303c-9a85-73fb7d4fa051",
                        "entry_id": "2ca90cb7-d86b-340a-9469-3892375f8006",
                        "glosses": [
                            "мужское имя; гипокор. к Иван"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f5b99b-a634-4cc0-8faf-bea1ba065fa6",
                                "sense_id": "ffea8438-9a10-303c-9a85-73fb7d4fa051",
                                "text": "Ванька свернул вчетверо исписанный лист и вложил его в конверт, купленный накануне за копейку… Подумав немного, он умокнул перо и написал адрес: На деревню дедушке. Потом почесался, подумал и прибавил: «Константину Макарычу»."
                            }
                        ]
                    }
