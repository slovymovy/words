                {
                    "sense_id": "ec6eea13-eb7b-3588-adc4-95a94c963a26",
                    "sense_definition": "Succès ou avantage remporté sur un concurrent ou un rival dans une compétition sportive, un jeu ou une élection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "succes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe a célébré cette belle <w>victoire</w> après un match très disputé."
                        },
                        {
                            "text": "Les joueurs ont réussi à remporter la <w>victoire</w> dans les dernières minutes de la rencontre."
                        }
                    ],
                    "synonyms": [
                        "gain",
                        "succès",
                        "triomphe"
                    ],
                    "antonyms": [
                        "défaite"
                    ],
                    "common_phrases": [
