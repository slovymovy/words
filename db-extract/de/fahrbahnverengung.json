                ],
                "senses": [
                    {
                        "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                        "entry_id": "2ff1db49-e1b6-38bf-a183-48f0438870cc",
                        "glosses": [
                            "Verringerung der Breite einer Straße (meist durch bauliche Maßnahmen oder durch Hindernisse), sodass weniger Platz für den Verkehr zur Verfügung steht"
                        ],
                        "tags": [
                            "Verkehrspolitik"
                        ],
                        "examples": [
                            {
                                "example_id": "44e58d5f-309e-40a1-b45f-49ed0830d0e1",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Allerdings muss man bei Brücken oft mit Fahrbahnverengungen rechnen.“"
                            },
                            {
                                "example_id": "a7fc9328-c87f-405c-9fe8-22e2a2668bbb",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Im Tunnel Tegel Ortskern gibt es bis November eine Fahrbahnverengung.“"
                            },
                            {
                                "example_id": "e2eabe0d-de69-48a5-a64e-3ba4b5319e12",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Bauarbeiten auf der A1 sorgen für Einschränkungen – […] Die Autobahn GmbH weist darauf hin, dass es zu einer zwischenzeitlichen Fahrbahnverengung kommen kann, wodurch Gefahren- und Schwerlasttransporte mit über 3,5 Metern Breite den Streckenabschnitt nicht passieren können.“"
                            },
                            {
                                "example_id": "d1069aa2-1ddb-4318-ac0a-a43f39830cf7",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "[StVO:] „§ 6 Vorbeifahren – Wer an einer Fahrbahnverengung, einem Hindernis auf der Fahrbahn oder einem haltenden Fahrzeug links vorbeifahren will, muss entgegenkommende Fahrzeuge durchfahren lassen.“"
                            },
                            {
                                "example_id": "7f6c73e7-9d4d-49e2-b24a-2326b76cdd66",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Der Lastwagen hatte am frühen Morgen bei einer Fahrbahnverengung ein Sicherungsfahrzeug der Autobahnmeisterei gerammt und war die Böschung herabgerutscht.“"
                            },
                            {
                                "example_id": "ba24e82c-e08b-4cb3-9156-d216eeb9e4ad",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Am Montag (18.02.2013) war bekannt geworden, dass die Autobahnbrücke überlastet ist. Das Verkehrsministerium in Düsseldorf teilte daraufhin mit, dass das Bauwerk saniert werden muss. Als Sofortmaßnahme wurde die Fahrbahnverengung sowie die Geschwindigkeitsreduzierung beschlossen.“"
                            },
                            {
                                "example_id": "46b06d9b-3c8c-4d8b-9c2c-22a60775d7f1",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Zwischen Brixen und Sterzing kam es gegen 15.30 bei Kilometer 18 zum folgenschweren Unfall. Im Bereich einer Fahrbahnverengung touchierten mehrere Fahrzeuge. LKW, PKW und Lieferwägen wurden teilweise ineinander verkeilt.“"
                            },
                            {
                                "example_id": "565dabc3-c463-4f5d-a544-e1ed70ad2e09",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Am Samstag hat ein 89-jähriger Autolenker auf der Brennerautobahn die Kontrolle über sein Fahrzeug verloren. Der Mann fuhr auf dem dritten Fahrstreifen am Ende der Europabrücke, kurz vor der Fahrbahnverengung, als er die Leitschiene touchierte.“"
                            },
                            {
                                "example_id": "e8bda340-396f-4f87-96fb-533d179233bb",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "[Demonstration in Berlin:] „Dank der durch viele Baustellen bedingten Fahrbahnverengung genügt hier auch schon eine Zweierreihe, um den Verkehr zu blockieren.“"
                            },
                            {
                                "example_id": "86f2b8ed-4523-4c13-afc4-31e786caedeb",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Verzichtet werden muss ferner auf einige geplante Fahrbahnverengungen zur Verkehrsberuhigung. Realisiert werden aber die Fahrbahnverengungen in der Nähe des Schulhauses in Obbürgen.“"
                            },
                            {
                                "example_id": "daec9271-2c51-4920-828c-76915723e8fa",
                                "sense_id": "248240fa-87df-378a-abc8-5b0f7b9d32b0",
                                "text": "„Eine Fahrbahnverengung, wie sie derzeit allen Entwürfen zugrunde liegt, wollen sie mehrheitlich nicht, genauso wenig wie die Abschaffung aller Parkplätze auf der Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
