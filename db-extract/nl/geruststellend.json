                    {
                        "sense_id": "5be954ac-102b-328b-ac37-d5f298c030f8",
                        "entry_id": "0829e796-6541-35a0-a398-21054d60b0b1",
                        "glosses": [
                            "iets is geruststellend als het er voor zorgt dat je niet bang of ongerust hoeft te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202bbf97-2200-41a7-9084-4f140f7328b1",
                                "sense_id": "5be954ac-102b-328b-ac37-d5f298c030f8",
                                "text": "Het is een geruststellend idee dat we nog was geld op de bank hebben staan voor onverwachte uitgaven."
                            },
                            {
                                "example_id": "1b2128c5-4772-486a-b8d0-95aeff6f4ee1",
                                "sense_id": "5be954ac-102b-328b-ac37-d5f298c030f8",
                                "text": "‘Storm? Vannacht? Nee, maak je geen zorgen.’ Na deze geruststellende woorden trokken we ons ieder terug in onze eigen tent. Doordat de wind steeds harder begon te waaien, stak ik om de paar minuten mijn hoofd uit mijn tent om te zien of de wolken groter werden of juist niet."
                            }
                        ]
                    }
