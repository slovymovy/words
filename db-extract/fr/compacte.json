                "entry_id": "0a0fcb19-4033-37aa-a600-e581a527ab66",
                "word": "compacte",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ddec4a4-6ad6-4c8c-b873-10cd941efc5b",
                        "entry_id": "0a0fcb19-4033-37aa-a600-e581a527ab66",
                        "tags": [
