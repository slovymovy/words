                        "sense_id": "d6fa1688-3645-3b41-98b2-0482fc6256dc",
                        "entry_id": "7d75a4f0-f6d6-3b1d-9051-a901a210e776",
                        "glosses": [
                            "An oppressor or extortioner."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c5d7dd86-8322-4e0f-a789-3764b38160a4",
                                "sense_id": "d6fa1688-3645-3b41-98b2-0482fc6256dc",
                                "text": "She did Accept of our intended Present, which (she said) manifested our Love and Loyalty; most graciously affirming, That She was never any greedy Griper, or fast Holder; and what We did present, She would not hoard up; but Our Eyes should see the Bestowing of it."
                            },
                            {
                                "example_id": "96cbdcd3-2984-4627-844c-f2cc40d818cc",
                                "sense_id": "d6fa1688-3645-3b41-98b2-0482fc6256dc",
                                "text": "[…] there wanted not those who condemned his pride and hypocrisy, knowing Pandulphus to be a most greedy griper, as appeared by his unconscionable oppression in the bishopric of Norwich, which was afterwards bestowed upon him."
                            },
                            {
                                "example_id": "2a297ad4-bb29-42fd-9be4-b84d6591d12a",
                                "sense_id": "d6fa1688-3645-3b41-98b2-0482fc6256dc",
                                "text": "When Southey's sackbut tunes the praise\nOf every Royal griper,\nOr any Minister, whose pipe\nTakes part in measures rotten ripe,\nWhile England pays the piper!"
                            }
                        ]
                    }
