                        "sense_id": "3584a60f-097c-3172-afb6-4732b2e70a9c",
                        "entry_id": "88f1427d-9d8b-3d16-b160-ceef38038344",
                        "glosses": [
                            "region północno-zachodniej Afryki od Atlantyku po granicę z Egiptem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38eee606-8a3c-47a6-acfc-14a4c7b0bee0",
                                "sense_id": "3584a60f-097c-3172-afb6-4732b2e70a9c",
                                "text": "Kraje Maghrebu leżą na północy Afryki, ciągnąc się od wybrzeża Morza Śródziemnego do Oceanu Atlantyckiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
