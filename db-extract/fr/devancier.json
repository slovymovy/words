                                    {
                                        "sense_id": "02b5c8ff-041c-3429-b8fe-132f513a82ed",
                                        "entry_id": "5d9e120a-b0dd-3629-aa66-5726fa35ae36",
                                        "glosses": [
                                            "That which precurses: a forerunner, predecessor, or indicator of approaching events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65b50a3-3e90-4796-9014-b4c8006c07f2",
                                                "sense_id": "02b5c8ff-041c-3429-b8fe-132f513a82ed",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6899aeb-4420-31d6-9307-9d05784857f0",
                                        "entry_id": "5d9e120a-b0dd-3629-aa66-5726fa35ae36",
                                        "glosses": [
                                            "One of the compounds that participates in the chemical reaction that produces another compound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precursor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba41c6c-913c-37f6-af3b-11f0c0aed909",
                                        "entry_id": "a9fc99c0-4ad5-31e3-8314-c02269db803d",
                                        "glosses": [
                                            "Caused by the following symbol."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fcb5687-ce3e-47d4-ab59-f5d472030e5d",
                        "source_entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                        "target_lang_word": "predecessor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predecessor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15ea6243-cac2-3955-8a72-df8295897870",
                                        "entry_id": "91d6ead0-9c02-379e-aaf1-4b519df3252b",
                                        "glosses": [
                                            "One who precedes; one who has preceded another in any state, position, office, etc.; one whom another follows or comes after, in any office or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9961836b-f5cc-484d-8c12-c6f1f6ab43b9",
                                                "sense_id": "15ea6243-cac2-3955-8a72-df8295897870",
                                                "text": "I thought about my predecessor, who had died of drink and smoke; and I could have wished he had been so good as to live, and not bother me with his decease."
                                            },
                                            {
                                                "example_id": "ea620bfc-90ae-4396-943b-08ccb4bba234",
                                                "sense_id": "15ea6243-cac2-3955-8a72-df8295897870",
                                                "text": "\"The Northern Heights at last,\" you say to yourself, hastily closing the carriage window because the Yorkshire coal used by the Eastern Region and its predecessors makes their tunnels more sulphurous than any we know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e819e9d-9a82-3b0b-9c4d-6f6844cb05bd",
                                        "entry_id": "91d6ead0-9c02-379e-aaf1-4b519df3252b",
                                        "glosses": [
                                            "A model or type of machinery or device which precedes the current (or later) one. Usually used to describe an earlier, outdated model."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9947e80-4c95-463d-b627-8c8b717aa9ae",
                                                "sense_id": "8e819e9d-9a82-3b0b-9c4d-6f6844cb05bd",
                                                "text": "The steam engine was the predecessor of diesel and electric locomotives."
                                            },
                                            {
                                                "example_id": "7f5951ee-f33d-4422-900a-0c1d3d7cc562",
                                                "sense_id": "8e819e9d-9a82-3b0b-9c4d-6f6844cb05bd",
                                                "text": "No. 6959 is painted in the standard wartime black livery and, like its immediate predecessors, does not carry a nameplate, but the words \"Hall Class\" have been painted on the middle coupled-wheel splasher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f65b1dff-e7bd-3186-aecf-7c94bb9e3e95",
                                        "entry_id": "91d6ead0-9c02-379e-aaf1-4b519df3252b",
                                        "glosses": [
                                            "A vertex having a directed path to another vertex"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
