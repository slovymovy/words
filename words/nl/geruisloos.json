                    "frequency": "Middle",
                    "semantic_group_id": "onopvallend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overgang naar het nieuwe computersysteem verliep nagenoeg <w>geruisloos</w>.",
                            "target_lang_translations": {
                                "en": "The transition to the new computer system went almost <w>seamlessly</w>."
                            }
                        },
                        {
                            "text": "De maffia bleek in staat zijn tegenstanders op <w>geruisloze</w> wijze te laten verdwijnen.",
                            "target_lang_translations": {
