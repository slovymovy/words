            "senses": [
                {
                    "sense_id": "24328a79-5259-3da6-919c-68fea49d5348",
                    "sense_definition": "The thick main stem of a tree, from which the branches grow.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "main_body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trunk</w> of the old oak tree is very wide and rough.",
                            "target_lang_translations": {
                                "ru": "<w>Ствол</w> старого дуба очень широкий и шершавый.",
                                "zh": "那棵老橡树的<w>树干</w>又粗又糙。"
                            }
                        },
                        {
                            "text": "Moss grew on the north side of the tree <w>trunk</w>.",
                            "target_lang_translations": {
                                "ru": "Мох рос на северной стороне <w>ствола</w> дерева.",
                                "zh": "苔藓长在<w>树干</w>的北侧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tree trunk"
                    ],
                    "common_phrases": [
                        "hollow trunk",
                        "massive trunk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстый основной стебель дерева, от которого растут ветви.",
                        "zh": "树木的主干，枝条由此生长。"
