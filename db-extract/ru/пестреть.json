                "senses": [
                    {
                        "sense_id": "f01c79d8-9ac2-39bc-a2d0-09100e56bdd3",
                        "entry_id": "5263a78b-7a79-3213-8517-71dff486e985",
                        "glosses": [
                            "становиться пёстрым или более пёстрым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9975147-63bc-40d8-a4f0-909f000211a4",
                                "sense_id": "f01c79d8-9ac2-39bc-a2d0-09100e56bdd3",
                                "text": "Берега реки начинали пестреть первыми вешними цветами."
                            }
                        ]
                    },
                    {
                        "sense_id": "93f141b5-b893-3099-8c94-be6b6a02bef0",
                        "entry_id": "5263a78b-7a79-3213-8517-71dff486e985",
                        "glosses": [
                            "выделяться своей разноцветностью или содержать в себе что-либо пёстрое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6647c54a-1d8e-4ec8-a633-5e9cfaca3aef",
                                "sense_id": "93f141b5-b893-3099-8c94-be6b6a02bef0",
                                "text": "Деревянная посуда красиво пестрела на солнце, серьги и бусы пленяли красных девушек."
                            },
                            {
                                "example_id": "3a301976-c7eb-437e-8c0f-1b598869870a",
                                "sense_id": "93f141b5-b893-3099-8c94-be6b6a02bef0",
                                "text": "Вообще вид на город был очень хорош и приятно для глаз пестрел своими садами и ярко расписанными церквами."
                            }
                        ]
                    }
                ],
