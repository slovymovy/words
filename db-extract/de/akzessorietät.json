                "senses": [
                    {
                        "sense_id": "3516883a-9a45-35c3-9a56-166e9efeaf25",
                        "entry_id": "06e9866f-53f2-3fe6-9839-6f1811a82137",
                        "glosses": [
                            "Zugänglichkeit"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3734941f-a639-43cb-a10e-d1e10354f99c",
                                "sense_id": "3516883a-9a45-35c3-9a56-166e9efeaf25",
                                "text": "Es ist schwer die Aksessorietät dieser orientalischen Geheimnisse zu erklären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1b0c394-2952-308a-a7c5-e49eade9ca5e",
                        "entry_id": "06e9866f-53f2-3fe6-9839-6f1811a82137",
                        "glosses": [
                            "Zulassbarkeit"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9bae8e57-2019-4e9d-9a1f-92930d69f537",
                                "sense_id": "a1b0c394-2952-308a-a7c5-e49eade9ca5e",
                                "text": "Die eigentliche Schwierigkeit besteht darin, die Akzessorietät des Produkts zu erhalten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8e476f40-74ab-375b-bbca-1c703598434f",
                        "entry_id": "06e9866f-53f2-3fe6-9839-6f1811a82137",
                        "glosses": [
                            "Abhängigkeit eines Nebenrechts von einem zugrundeliegenden Hauptrecht (häufig bei Sicherungsrechten)"
                        ],
                        "tags": [
                            "mit Plural",
                            "deutsches Privatrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "07c3fb02-6db4-48a9-83ca-707ead9f111c",
                                "sense_id": "8e476f40-74ab-375b-bbca-1c703598434f",
                                "text": "„Der Bürge haftet […] nur, wenn und soweit die Hauptschuld besteht […]. Ausfluss der Akzessorietät ist des Weiteren, dass die Rechte aus einer Bürgschaft bei Abtretung [im Original kursiv] der Hauptforderung nach § 401 I auf den neuen Gläubiger übergehen […].“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e77d0a76-db0d-3a15-9f3b-68823cf81cbc",
                        "entry_id": "06e9866f-53f2-3fe6-9839-6f1811a82137",
                        "glosses": [
                            "Abhängigkeit der Strafbarkeit eines Teilnehmers von der Strafbarkeit des Haupttäters in der Weise, dass der Teilnehmer nur dann überhaupt strafbar sein kann, wenn der Haupttäter den Tatbestand des jeweiligen Delikts zumindest rechtswidrig verwirklicht hat"
                        ],
                        "tags": [
                            "mit Plural",
                            "deutsches Strafrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "413147b2-289b-4617-a5d7-16231d146130",
                                "sense_id": "e77d0a76-db0d-3a15-9f3b-68823cf81cbc",
                                "text": "Aus der limitierten Akzessorietät der Teilnahme ergibt sich, dass der Gehilfe auch dann wegen Beihilfe strafbar ist, wenn der Haupttäter im Zustand der Schuldunfähigkeit gehandelt hat."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
