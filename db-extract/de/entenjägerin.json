                "senses": [
                    {
                        "sense_id": "c953b2ee-d08d-3712-8dc1-a05ee8710cc0",
                        "entry_id": "28feed86-90d3-3a9d-808c-f10a6b09b4b4",
                        "glosses": [
                            "Jägerin, die Enten jagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d071f72-2050-4db0-99d2-c5019b18399d",
                                "sense_id": "c953b2ee-d08d-3712-8dc1-a05ee8710cc0",
                                "text": "„Sie ist eine große Entenjägerin und bringt mindestens einen ihrer Hunde mit.“"
                            },
                            {
                                "example_id": "5d085b9a-0cc3-4c8a-80d9-b48e15d6084c",
                                "sense_id": "c953b2ee-d08d-3712-8dc1-a05ee8710cc0",
                                "text": "„In der That sah man schon nach einem Stündchen die mit Enten beladenen Batts herankommen, worauf auch die kühnen Entenjägerinnen sehr bald in ihrem Staat erschienen.“"
                            },
                            {
                                "example_id": "36fa77d1-183c-460d-afa8-5aa03a510f9d",
                                "sense_id": "c953b2ee-d08d-3712-8dc1-a05ee8710cc0",
                                "text": "„Da war meine Mum: Tango-Tänzerin. Entenjägerin. Tutorin. Wenn sie die Kursleitung lange genug behielt und gut machte, würde sie in ein paar Jahren vielleicht in den Palast der Republik eingeladen und zu einem Pfundskerl des Sozialismus erklärt werden.“"
                            },
                            {
                                "example_id": "89639887-602f-426d-a14c-12dd88c9ecbe",
                                "sense_id": "c953b2ee-d08d-3712-8dc1-a05ee8710cc0",
                                "text": "„Zu den Hungerleidern zählt die passionierte Entenjägerin freilich auch nicht.“"
                            },
                            {
                                "example_id": "d6c57c35-62f6-4550-87de-0d2ca944cdbd",
                                "sense_id": "c953b2ee-d08d-3712-8dc1-a05ee8710cc0",
                                "text": "„Dies ist eine Gemeinsamkeit mit der Spitzenpolitikerin der Demokraten und Entenjägerin Hillary Clinton, die bis in unsere Zeit ebenso gerne zum Vergnügen Tiere erschießt, die ihr nichts angetan haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
