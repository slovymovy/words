                "senses": [
                    {
                        "sense_id": "46abd0ac-2233-3ea9-9237-1edd01e5a1ca",
                        "entry_id": "a9a1f84b-5f98-3375-b39b-d746b3ed80f6",
                        "glosses": [
                            "To circumcise."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "20a2a39f-5b8c-4dd8-be40-501183cd69da",
                                "sense_id": "46abd0ac-2233-3ea9-9237-1edd01e5a1ca",
                                "text": "Again, I don't think I was *wrong* to circ my son, though some may choose to disagree quite loudly with that statement; I just think not circing is a better decision."
                            },
                            {
                                "example_id": "19f0d98a-34e8-4759-87ff-6b014e64ba5c",
                                "sense_id": "46abd0ac-2233-3ea9-9237-1edd01e5a1ca",
                                "text": "I'm not stating how i feel either way but i like it that my husband was circed."
                            },
                            {
                                "example_id": "c68bf758-123b-494c-b40f-fdcac7b942f7",
                                "sense_id": "46abd0ac-2233-3ea9-9237-1edd01e5a1ca",
                                "text": "If a person was circed they have to live with it, or attempt partial restoration, but on the whole IMO a whole penis is more beautiful than a mutilated one."
                            }
                        ]
                    }
