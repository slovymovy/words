                                "example_id": "44c2fb18-b4cf-428f-93a3-fc6cdc220ca3",
                                "sense_id": "d727d1f0-1bf5-3906-9755-520b01eebe2d",
                                "text": "Северихин сидел на пороге мельницы, околдованный её сдержанными, успокоительными звуками."
                            }
                        ]
                    }
