                        ]
                    },
                    {
                        "translation_id": "dc338137-aa01-451e-a9b3-7a3969a002ee",
                        "source_entry_id": "59551a27-ddff-3737-8920-a26e6cc964b4",
                        "source_sense_id": "275e7ce4-3d62-3426-8f6d-7e3504f6410a",
                        "target_lang_word": "melting pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melting pot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f137f5af-6219-387a-8eb2-aea10d5c73cc",
                                        "entry_id": "7f5b6584-faee-37d2-addc-7e60809c0219",
                                        "glosses": [
                                            "A crucible, or similar pot, used to fuse mixtures of metals etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c2c750a-1d2e-3e07-a0ce-e0d8c9f49bbd",
                                        "entry_id": "7f5b6584-faee-37d2-addc-7e60809c0219",
                                        "glosses": [
                                            "A place where many divergent things (often races or cultures, but also talents) come together and are homogenized."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc403d59-c9f7-4ee3-a856-8b6c8fc0f672",
                                                "sense_id": "8c2c750a-1d2e-3e07-a0ce-e0d8c9f49bbd",
                                                "text": "The festival is a true racial melting pot; people from dozens of countries take part speaking many languages."
                                            },
                                            {
                                                "example_id": "bcf365a4-c46b-4fbe-a26d-df6d844509c8",
                                                "sense_id": "8c2c750a-1d2e-3e07-a0ce-e0d8c9f49bbd",
                                                "text": "Three-quarters of a century ago this edifice, garishly handsome in the city’s brashest manner, had been dedicated, on the cornerstone, “to Pythianism”, without any embarrassment at the clash of Greek and Mesopotamian metaphors. Such plundering and jumbling of the storehouse of yesterday’s empires, this melting pot or métissage of past power, was the true indicator of present might."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78be5ac1-09e5-44f5-bb81-bc1195b00ef0",
                        "source_entry_id": "59551a27-ddff-3737-8920-a26e6cc964b4",
                        "source_sense_id": "275e7ce4-3d62-3426-8f6d-7e3504f6410a",
                        "target_lang_word": "smeltkroes",
