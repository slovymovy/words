                    {
                        "translation_id": "1e602640-5fec-47ec-b6fe-18c1b53b665b",
                        "source_entry_id": "ba5b330d-eef8-33e4-95a9-9b1bac6d6927",
                        "source_sense_description": "of or relating to the earth; inhabiting planet Earth",
                        "target_lang_word": "tellurisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
