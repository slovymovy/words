                    {
                        "form_id": "eae2303a-65a9-4e96-ab8d-b55de66efef4",
                        "entry_id": "ba355761-564b-3f4e-8eea-5342e0824df8",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "цензу́рах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee17a88c-7fe5-3097-84af-0fc61bbd1f0f",
                        "entry_id": "ba355761-564b-3f4e-8eea-5342e0824df8",
                        "glosses": [
                            "истор. в Древнем Риме — исполнение обязанностей цензора"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bb307358-2b32-3e97-bb57-1dce7041f519",
                        "entry_id": "ba355761-564b-3f4e-8eea-5342e0824df8",
                        "glosses": [
                            "система государственного надзора за печатью и средствами массовой информации для ограничения либо недопущения распространения идей и сведений, признаваемых властями нежелательными"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4df5552-f36c-41a6-9114-0ce23d7f7d17",
                                "sense_id": "bb307358-2b32-3e97-bb57-1dce7041f519",
                                "text": "Цензура того времени была строгая и притом разнообразная, разбросанная по всевозможным ведомствам."
                            },
                            {
                                "example_id": "eed9df66-9a05-446e-af93-9baedaf7cdb9",
                                "sense_id": "bb307358-2b32-3e97-bb57-1dce7041f519",
                                "text": "Похлопочите, чтобы мне из цензуры получить ответ поскорее."
                            },
                            {
                                "example_id": "6039fae5-1ec8-493a-a97f-7a01d7d9eeae",
                                "sense_id": "bb307358-2b32-3e97-bb57-1dce7041f519",
                                "text": "Борьба с цензурой, какая бы она не была и при какой бы власти она не существовала, мой писательский долг, так же как и призывы к свободе печати."
                            },
                            {
                                "example_id": "830d7a36-8732-4df1-b794-230e07a267a6",
                                "sense_id": "bb307358-2b32-3e97-bb57-1dce7041f519",
                                "text": "Действительно, в 1981 году православные церковные песнопения на московской сцене, упование к Всевышнему, торжественный подъём огромного царского Андреевского флага и финальная Аллилуйя, исполняемая всеми участниками спектакля, — всё это совершенно не соответствовало строгим идеологическим установкам партийной цензуры."
                            },
                            {
                                "example_id": "383af4af-36bc-4fbd-9c23-814d73560598",
                                "sense_id": "bb307358-2b32-3e97-bb57-1dce7041f519",
                                "text": "Цензура и ограничение информации не могут выиграть у отсутствия цензуры и свободы мнений."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e113ba4-71c5-3761-aa41-9a056819309c",
                        "entry_id": "ba355761-564b-3f4e-8eea-5342e0824df8",
                        "glosses": [
                            "контроль, надзор за соблюдением каких-либо запретов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30aa4ab-1719-4e2c-941c-378c1d998c8d",
                                "sense_id": "6e113ba4-71c5-3761-aa41-9a056819309c",
                                "text": "В коротком обществе, где умный, разнообразный разговор заменяет танцы (рауты в сторону), где говорить можно обо всём, не боясь цензуры тётушек, и не встречая чересчур строгих и неприступных дев, в таком кругу он мог бы блистать и даже нравиться, потому что ум и душа, показываясь наружу, придают чертам жизнь, игру и заставляют забыть их недостатки; но таких обществ у нас в России мало, в Петербурге ещё меньше, вопреки тому, что его называют совершенно европейским городом и владыкой хорошего тона."
                            },
                            {
                                "example_id": "b02e6809-5bc0-42ff-90fe-7b76ed930dd3",
                                "sense_id": "6e113ba4-71c5-3761-aa41-9a056819309c",
                                "text": "Учителю истории платились деньги тоже чрезвычайно исправно; но, по уходе его, мы с Александрой Михайловной историю учили по-своему: брались за книги и зачитывались иногда до глубокой ночи, или, лучше сказать читала Александра Михайловна, потому что она же и держала цензуру."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bedf0c20-35ea-4f79-a370-0109d9476a28",
                        "source_entry_id": "ba355761-564b-3f4e-8eea-5342e0824df8",
                        "source_sense_description": "система государственного надзора за печатью и средствами массовой информации",
                        "target_lang_word": "cenzura",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cenzura",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e01f121b-3f0c-3db7-abdd-a315f70bdb65",
                                        "entry_id": "00280a76-5f2b-3b4a-91c0-0927e41faebe",
                                        "glosses": [
                                            "kontrola publicznego przekazywania informacji, ograniczająca wolność publicznego wyrażania myśli i przekonań"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "102b67a9-4291-4d01-9d20-9f92b8699362",
                                                "sense_id": "e01f121b-3f0c-3db7-abdd-a315f70bdb65",
                                                "text": "A już w roku 1810 wprowadzono cenzurę prewencyjną i odtąd zgodę na publikację trzeba było uzyskać przed drukiem dzieła"
                                            }
                                        ],
