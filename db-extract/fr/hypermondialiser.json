                        "glosses": [
                            "Mondialiser à l’extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b298da80-0cee-4bfa-9987-153ffe2fec90",
                                "sense_id": "d50abb1c-3ef6-3325-bcf6-86def6f68083",
                                "text": "Mais dans une agriculture hypermondialisée aujourd'hui, je trouvais dommage de rester en Mayenne."
                            },
                            {
                                "example_id": "e734420e-bf64-48ef-9f44-b759bfff021e",
                                "sense_id": "d50abb1c-3ef6-3325-bcf6-86def6f68083",
                                "text": "Un monde numérique, avec des milliards de données au bout des doigts, hypermondialisé et en compétition partout."
                            },
                            {
                                "example_id": "8f0dc88e-8169-48a9-ac0e-d259f558c333",
                                "sense_id": "d50abb1c-3ef6-3325-bcf6-86def6f68083",
                                "text": "alors que le monde s’hypermondialise, de plus en plus de gens restent sur le carreau, un homme comme Bernard pour une Europe plus sociale, là aussi il est temps"
                            }
                        ]
                    }
