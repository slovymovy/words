                ],
                "senses": [
                    {
                        "sense_id": "511e2c20-d8ac-39f9-95cd-9e63993dc783",
                        "entry_id": "2c45c5bb-0076-3e08-af2f-84a114703aa3",
                        "glosses": [
                            "The process of deadmelting steel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8bbcbcc-0197-47d4-880d-6a1bf7fa13f9",
                                "sense_id": "511e2c20-d8ac-39f9-95cd-9e63993dc783",
                                "text": "My proposition is to take otherwise finished steel from the Bessemer or open-hearth furnace, and hold it liquid, let us say thirty minutes, giving the oxides a chance to float up and the steel a chance to rest, thus giving it the equivalent of the deadmelt in the crucible."
                            },
                            {
                                "example_id": "24634ab3-2b5f-4293-9d04-520135127bc7",
                                "sense_id": "511e2c20-d8ac-39f9-95cd-9e63993dc783",
                                "text": "A \"sufficient amount\" is defined as the gross charge weight of the alloy that is required to add the deficient weight of metal to the heat after the deadmelt oxidation losses have taken place."
                            },
                            {
                                "example_id": "d3b9981b-a0cc-4242-b497-d8b56135644d",
                                "sense_id": "511e2c20-d8ac-39f9-95cd-9e63993dc783",
                                "text": "Once the charge has melted and reached the pouring temperature the furnace is left to stand for a short time and then skimmed, after which the melt is sent for further treatment to a deadmelt and casting furnace, or cast direct."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
