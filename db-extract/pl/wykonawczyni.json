                "senses": [
                    {
                        "sense_id": "f1cb8b3b-32da-33f9-b482-cd6985ba82f8",
                        "entry_id": "cf050f1d-fd4e-315f-ab94-c716bee06453",
                        "glosses": [
                            "kobieta wykonawca, realizująca, wcielająca w życie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2be9be9-9652-47f1-af21-4483bbf5a439",
                                "sense_id": "f1cb8b3b-32da-33f9-b482-cd6985ba82f8",
                                "text": "Dlaczego to właśnie ja mam być wykonawczynią twoich zachcianek?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0000167c-20c6-3357-9fff-cbe636bc6fb8",
                        "entry_id": "cf050f1d-fd4e-315f-ab94-c716bee06453",
                        "glosses": [
                            "wykonująca rolę teatralną lub utwór muzyczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57fb8cb2-8c0a-42b7-b5a2-964dc0b29873",
                                "sense_id": "0000167c-20c6-3357-9fff-cbe636bc6fb8",
                                "text": "Wykonawczyni ostatniego utworu wręczyła kwiaty organizatorowi koncertu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "157aa589-d5ea-49f1-b117-45f057a9c8a2",
                        "source_entry_id": "cf050f1d-fd4e-315f-ab94-c716bee06453",
                        "source_sense_id": "f1cb8b3b-32da-33f9-b482-cd6985ba82f8",
                        "target_lang_word": "executrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "executrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7470187-b467-390b-ac13-d76ff679903f",
                                        "entry_id": "dcf35ee0-ac67-3fb3-aac8-ead63ef8ecac",
                                        "glosses": [
                                            "A female executor; a woman appointed to execute a will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7d196e-229f-46ef-8255-f0ac2891895b",
                                                "sense_id": "e7470187-b467-390b-ac13-d76ff679903f",
                                                "text": "‘That would be difficult, you know, Chettam, as she is an executrix, and she likes to go into these things—property, land, that kind of thing.’"
                                            },
                                            {
                                                "example_id": "a1d0238a-700d-4ea3-ac9a-d9ecd3fa8a55",
                                                "sense_id": "e7470187-b467-390b-ac13-d76ff679903f",
                                                "text": "His widow, Painter Georgia O'Keeffe, has carried on his educational work as executrix of his will by dividing Stieglitz' brilliant art collection and his own even more brilliant photographs among six widely spaced institutions […]."
                                            },
                                            {
                                                "example_id": "e0a73e3e-79eb-4202-a80f-00360b0021ba",
                                                "sense_id": "e7470187-b467-390b-ac13-d76ff679903f",
                                                "text": "One summer afternoon Mrs Oedipa Maas came home from a Tupperware party whose hostess had put perhaps too much kirsch in the fondue to find that she, Oedipa, had been named executor, or she supposed executrix, of the estate of one Pierce Inverarity […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24cf0d99-1e1c-4341-9052-662acda13a16",
                        "source_entry_id": "cf050f1d-fd4e-315f-ab94-c716bee06453",
                        "source_sense_id": "f1cb8b3b-32da-33f9-b482-cd6985ba82f8",
                        "target_lang_word": "Ausführerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a682d257-f6ac-49c8-9668-9c8f5ba0ff12",
                        "source_entry_id": "cf050f1d-fd4e-315f-ab94-c716bee06453",
                        "source_sense_id": "f1cb8b3b-32da-33f9-b482-cd6985ba82f8",
                        "target_lang_word": "исполнительница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "исполнительница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                        "entry_id": "9f1366d8-06a1-38d5-924e-1b90256aa8fd",
                                        "glosses": [
                                            "женск. к исполнитель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0399c640-dd04-46ec-8789-b32b9fd5e582",
                                                "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                                "text": "Рябая девица была Александра Ивановна Ковригина, двоюродная моя сестра, круглая сирота, с малых лет взятая на воспитанье Прасковьей Ивановной; она находилась в должности главной исполнительницы приказаний бабушки, то есть хозяйки дома."
                                            },
                                            {
                                                "example_id": "f20b528a-9b6a-4fbe-bf79-03d84624a6c5",
                                                "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                                "text": "Были такие моменты, когда Надежда Васильевна настолько увлекалась своими мыслями, что необыкновенно живо воспроизводила пред собой широкую картину осуществившихся приваловских планов, деятельной участницей и исполнительницей которых была она сама."
                                            },
                                            {
                                                "example_id": "5a2f815a-348f-445a-a183-ec631e32ff29",
                                                "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                                "text": "Говорят, что лучшие исполнительницы лезгинки ― татарки Дагестанских гор."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0b39a7b-6625-478d-8e57-0073a4de4a8a",
                        "source_entry_id": "cf050f1d-fd4e-315f-ab94-c716bee06453",
                        "source_sense_id": "0000167c-20c6-3357-9fff-cbe636bc6fb8",
