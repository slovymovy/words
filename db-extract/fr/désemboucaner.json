                "senses": [
                    {
                        "sense_id": "dc6efa81-5c63-3d09-9126-784e211998fc",
                        "entry_id": "9cf217fb-cf7c-36af-95b7-f54145b16868",
                        "glosses": [
                            "Désenvoûter."
                        ],
                        "tags": [
                            "Nouvelle-Calédonie"
                        ],
                        "examples": [
                            {
                                "example_id": "795c5018-bf24-4fa7-8315-9716c207880d",
                                "sense_id": "dc6efa81-5c63-3d09-9126-784e211998fc",
                                "text": "Des marabouts d’origine maghrébine ou sénégalaise, émigrés dans le secteur sur ce beau \"caillou\" tourmenté, profitent d’ailleurs de ces croyances pour extorquer de l’argent aux naïfs, sous prétexte de les désemboucaner."
                            },
                            {
                                "example_id": "1f91d433-1e7a-422f-860c-cc077b164311",
                                "sense_id": "dc6efa81-5c63-3d09-9126-784e211998fc",
                                "text": "J’ai été emboucané d’ailleurs une fois, et il a pu me désemboucaner heureusement ^^."
                            },
                            {
                                "example_id": "e09f8a65-b63f-4f96-bc31-0e1e1a864358",
                                "sense_id": "dc6efa81-5c63-3d09-9126-784e211998fc",
                                "text": "Elle me disait qu’elle écartait le mal grâce à ses pouvoirs, que je perdrais mes doigts de pieds et les jambes si je n’étais pas désemboucanée."
                            }
                        ]
                    }
                ],
