{
    "word_family": [
        "tantruming"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "065c2d5f-8f7a-3295-bf31-5a983faffad5",
                    "sense_definition": "An often childish display or fit of bad temper.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_outburst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many parents become embarrassed by their children throwing <w>tantrums</w> in public places.",
                            "target_lang_translations": {
                                "zh": "许多父母因为孩子在公共场合<w>发脾气</w>而感到尴尬。"
                            }
                        },
                        {
                            "text": "The toddler threw a <w>tantrum</w> because he wanted another piece of candy.",
                            "target_lang_translations": {
                                "zh": "那个幼儿因为想再吃一块糖而<w>撒泼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "meltdown",
                        "tantrum"
                    ],
                    "common_phrases": [
                        "throw a tantrum"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一个人（通常是小孩）因不满而发脾气、大吵大闹的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发脾气",
                                "target_lang_sense_clarification": "指表现出愤怒或不满的情绪。"
                            },
                            {
                                "target_lang_word": "撒泼",
                                "target_lang_sense_clarification": "指蛮横无理地吵闹。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "409d5e02-192b-3554-9b43-46f55e9ec41c",
                    "sense_definition": "To throw a tantrum.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_outburst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>tantrum</w> when the toy was taken away.",
                            "target_lang_translations": {
                                "zh": "玩具被拿走时，那个孩子开始<w>发脾气</w>。"
                            }
                        },
                        {
                            "text": "He started to <w>tantrum</w> in the middle of the store.",
                            "target_lang_translations": {
                                "zh": "他在商店中央开始<w>撒泼</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指做出发脾气或撒泼的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发脾气",
                                "target_lang_sense_clarification": "指表现出愤怒或不满的情绪。"
                            },
                            {
                                "target_lang_word": "撒泼",
                                "target_lang_sense_clarification": "指蛮横无理地吵闹。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}