                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e25c15d-95a0-4177-b38b-9bd235e79406",
                                                "sense_id": "795eafab-0e89-3c6d-8abf-1f5f133dbfa5",
                                                "text": "Phew, it stinks in here!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab3a3468-8c71-41a3-8f46-cfac888b1c37",
                        "source_entry_id": "e8708e8d-9c0d-388b-aeab-d8c100db8c04",
                        "source_sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
