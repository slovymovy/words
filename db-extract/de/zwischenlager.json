                    {
                        "sense_id": "28f20038-5de6-3aed-a6f3-dfed1bb747da",
                        "entry_id": "c130fda6-cc56-3b2d-9714-12ac231f641b",
                        "glosses": [
                            "Ort, an dem etwas zeitweise/vorübergehend gelagert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e2a28e-98d1-4725-adb6-2f9d0a91f9d9",
                                "sense_id": "28f20038-5de6-3aed-a6f3-dfed1bb747da",
                                "text": "„Begleitet von massiven Protesten und Blockadeaktionen ist der Castor-Transport mit hochradioaktivem Atommüll am Montag im niedersächsischen Gorleben angekommen – nun stehen dort 113 Behälter mit Atommüll in einer Halle, dem sogenannten Zwischenlager.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dab8c001-9060-32cb-a258-5d6a03bbb0fd",
                        "entry_id": "c130fda6-cc56-3b2d-9714-12ac231f641b",
                        "glosses": [
                            "Gebäude, in dem Personen zeitweise/vorübergehend untergebracht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b94fcef-53e5-4104-a29b-6cfd92942849",
                                "sense_id": "dab8c001-9060-32cb-a258-5d6a03bbb0fd",
                                "text": "„Im Rahmen der Aktion Reinhard wurden Tausende Juden zunächst in kleinen Orten als Zwischenlager bis zur Fertigstellung der Vernichtungslager einquartiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
