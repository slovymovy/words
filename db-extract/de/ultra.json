                "senses": [
                    {
                        "sense_id": "6165d58f-a8b9-3935-9ca3-93b3e8ae607b",
                        "entry_id": "edfc1dd8-0a75-3383-92de-df237d2262da",
                        "glosses": [
                            "Anhänger des äußersten (meist rechten) Flügels einer Gruppierung, Partei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d954dfe-50bc-47df-bbaa-810c6531714d",
                                "sense_id": "6165d58f-a8b9-3935-9ca3-93b3e8ae607b",
                                "text": "„Der heftige Parteikampf von Liberalen und Ultras, wie wir ihn in andern Hauptstädten sehen, kann bei uns nicht zum Durchbruch kommen, weil die königliche Macht, kräftig und parteilos schlichtend, in der Mitte steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69153b51-3032-3781-850d-7b3671e7e59d",
                        "entry_id": "edfc1dd8-0a75-3383-92de-df237d2262da",
                        "glosses": [
                            "extremer Anhänger, Fan einer bestimmten Mannschaft"
                        ],
                        "tags": [
                            "besonders Fußball"
                        ],
                        "examples": [
                            {
                                "example_id": "f94068cb-c3ed-44a9-a0ba-e8f8490b5133",
                                "sense_id": "69153b51-3032-3781-850d-7b3671e7e59d",
                                "text": "„Nun, im Herbst seiner Karriere, spielt der Stürmer wieder für seinen Leibesklub, für die Farben, die er im Teenageralter als Ultra, als superfanatischer Tifoso, zu verteidigen pflegte, wenn's sein musste auch mit den Fäusten: Lazio Rom.“"
                            },
                            {
                                "example_id": "95204d4e-c20f-4a1c-8007-bfe878829221",
                                "sense_id": "69153b51-3032-3781-850d-7b3671e7e59d",
                                "text": "„Die Ultras aus Block N16/N17, die lange nur zu Regionalligaspielen der zweiten Mannschaft gegangen waren, kamen zurück zu den „Roten“ in die HDI-Arena.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdf041e2-6466-4930-9224-c55e2c023e35",
                        "source_entry_id": "edfc1dd8-0a75-3383-92de-df237d2262da",
                        "source_sense_id": "6165d58f-a8b9-3935-9ca3-93b3e8ae607b",
                        "source_sense_description": "Politik: Anhänger des äußersten (meist rechten) Flügels einer Gruppierung, Partei",
                        "target_lang_word": "extremist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1c42bd-4011-3af1-9dd4-e3a44f412bfb",
                                        "entry_id": "e775ba16-7792-3df5-9d17-3e75b38fef2e",
                                        "glosses": [
                                            "A person who holds extreme views, especially one who advocates such views; a radical or fanatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05ac2d8-a5e8-410f-aa76-7a7124a32e06",
                                                "sense_id": "7f1c42bd-4011-3af1-9dd4-e3a44f412bfb",
                                                "text": "In Urif, extremists spray painted “Death to Arabs” on shipping containers belonging to a local resident and the local quarry was tagged with the words “Fight the enemy.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extremist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                                        "entry_id": "0c00c690-2cc9-333d-aea3-813ece139220",
                                        "glosses": [
                                            "Holding extreme views, especially on a political or religious subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46cb58cf-d878-4f07-8d7a-e6b5d928c361",
                                                "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                                                "text": "There are some minor extremist movements that are antiforeigner."
                                            },
                                            {
                                                "example_id": "d6d3c2fd-1149-4db2-8007-04c6162b2423",
                                                "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                                                "text": "The hate crimes, once commonly referred to as “price tag attacks,” are committed by extremist Jewish youth from nearby settlements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc726906-fe1a-3dca-9e98-9aa0e4d4af98",
                                        "entry_id": "0c00c690-2cc9-333d-aea3-813ece139220",
                                        "glosses": [
                                            "Of or relating to extremism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1182e28-0781-488f-b69d-d13b685fb46f",
                        "source_entry_id": "edfc1dd8-0a75-3383-92de-df237d2262da",
                        "source_sense_id": "6165d58f-a8b9-3935-9ca3-93b3e8ae607b",
                        "source_sense_description": "Politik: Anhänger des äußersten (meist rechten) Flügels einer Gruppierung, Partei",
                        "target_lang_word": "ultra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d796ea2a-c919-3367-969d-201653e6afdb",
                                        "entry_id": "cd10fdbe-585d-30c0-9275-b800da951dd9",
                                        "glosses": [
                                            "(Antéposé : se place avant le nom, sans trait d'union) Qui dépasse la mesure, la norme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b91ec1e-f477-4da7-9482-9e40c0c4481c",
                                                "sense_id": "d796ea2a-c919-3367-969d-201653e6afdb",
                                                "text": "Et on sent que c'est vrai. Et que les reproches de médiocre, de paresseux, de fourbe, sont ultra justifiés."
                                            },
                                            {
                                                "example_id": "6604b4cc-9cea-4ac8-a3b9-1cdd9672dbd5",
                                                "sense_id": "d796ea2a-c919-3367-969d-201653e6afdb",
                                                "text": "Cette soirée était ultra géniale !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ultra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08d68ca0-b459-387e-b5d0-04faa1903611",
                                        "entry_id": "f8d83f18-fb98-3428-b9f5-f9361716f9d7",
                                        "glosses": [
                                            "Personne exagérée dans ses opinions ; extrémiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82d6e11-ef20-4794-8ebf-438f550d8402",
                                                "sense_id": "08d68ca0-b459-387e-b5d0-04faa1903611",
                                                "text": "Mais Salomon rassemble tous les « ultras » de l'époque et annexe les marches armoricaines jusqu’alors occupées de fait par ses prédécesseurs […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80b9e7cb-6a48-3109-b578-e7465eeee4da",
                                        "entry_id": "f8d83f18-fb98-3428-b9f5-f9361716f9d7",
                                        "glosses": [
                                            "Royalistes extrémistes sous la Restauration."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e418c50-c487-4bd8-9992-0d0d56067177",
                                                "sense_id": "80b9e7cb-6a48-3109-b578-e7465eeee4da",
                                                "text": "Le portrait de Napoléon, se disait-il en hochant la tête, trouvé caché chez un homme qui fait profession d’une telle haine pour l’usurpateur! trouvé par M. de Rênal, tellement ultra et tellement irrité!"
                                            },
                                            {
                                                "example_id": "86364842-234a-4e35-bb10-04835279810c",
                                                "sense_id": "80b9e7cb-6a48-3109-b578-e7465eeee4da",
                                                "text": "« L’ultra de Paris est apprivoisé, se disait Lucien ; mais, ici, je le trouve à l’état de nature : c’est une espèce terrible, bruyante, injuriante, accoutumée à n’être jamais contredite, parlant trois quarts d’heure avec la même phrase. Les ultra les plus insupportables de Paris, ceux qui font déserter le salon de madame Grandet, ici seraient des gens de bonne compagnie, modérés, parlant d’un ton de voix convenable. »"
                                            },
                                            {
                                                "example_id": "e84391c1-fab9-41f7-bce0-da440fe1c930",
                                                "sense_id": "80b9e7cb-6a48-3109-b578-e7465eeee4da",
                                                "text": "Que sa dénomination dérive d’un nom commun ou d’un nom propre, l’adepte ne prend jamais de majuscule initiale. L’adhérent, le disciple, le fidèle, le membre pas davantage. Toutes les catégories sont concernées (religion, philosophie, littérature, arts, politique, etc.) : un anglican, sept bouddhistes, trois catholiques, un dadaïste, deux existentialistes, un gnostique, un hindou, deux impressionnistes, trois jansénistes, quelques kharidjites, soixante laxistes, trois marxistes, quatre nudistes, deux oulipistes, dix presbytériennes, un quiétiste, un rexiste, des saint-simoniens, deux trotskistes, dix ultras, une voltairienne, un wahhabite, un zoroastrien."
                                            },
                                            {
                                                "example_id": "5788e7dc-724c-4459-824c-fcf5936da43d",
                                                "sense_id": "80b9e7cb-6a48-3109-b578-e7465eeee4da",
                                                "text": "La Charte de 1814 a prévu l’instauration d'une Chambre des Députés dont les membres sont élus au suffrage censitaire. Les premières élections se déroulent dans l'été 1815 et entraînent une écrasante victoire électorale des ultras."
                                            },
                                            {
                                                "example_id": "8a05b688-ddb4-436c-9882-0f1285ea1280",
                                                "sense_id": "80b9e7cb-6a48-3109-b578-e7465eeee4da",
                                                "text": "Les ultras contribuèrent à la chute du ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbf56882-014b-3aa9-b4b6-32c68671108c",
                                        "entry_id": "f8d83f18-fb98-3428-b9f5-f9361716f9d7",
                                        "glosses": [
                                            "Chose qui passe la mesure."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d45e03c0-dc14-35d8-a966-5d97cc91b324",
                                        "entry_id": "f8d83f18-fb98-3428-b9f5-f9361716f9d7",
                                        "glosses": [
                                            "Supporter qui encourage son équipe de manière extrême au moyen de chants continus, d'animations visuelles et de déplacements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e2f769-a25c-49f5-86fe-bec068b3232c",
                                                "sense_id": "d45e03c0-dc14-35d8-a966-5d97cc91b324",
                                                "text": "J’ai parfois l’impression d’être au milieu des ultras sur des matchs U14."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "804ff84f-5a9d-4fa7-a83a-a4601242f6eb",
                        "source_entry_id": "edfc1dd8-0a75-3383-92de-df237d2262da",
                        "source_sense_id": "6165d58f-a8b9-3935-9ca3-93b3e8ae607b",
                        "source_sense_description": "Politik: Anhänger des äußersten (meist rechten) Flügels einer Gruppierung, Partei",
                        "target_lang_word": "extrémiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrémiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0996d7-6638-3146-92da-5840cd091a59",
                                        "entry_id": "d014d791-3d2a-33af-9ef6-6131638eb872",
                                        "glosses": [
                                            "Qui tient de l’extrémisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "047167b8-a8da-48da-93ad-6f229bb5d256",
                                                "sense_id": "0d0996d7-6638-3146-92da-5840cd091a59",
                                                "text": "Bagambiki, je l’apprendrai plus tard, est un personnage influent venant du MRND, le parti du président assassiné, dont il est l’un des durs. Nous réalisons vite qu’il n’est pas franc du collier et qu’il tente de nous doubler en manipulant ses réseaux extrémistes."
                                            },
                                            {
                                                "example_id": "fcef29a8-36fd-4e1c-8fce-ef500d7b4c58",
                                                "sense_id": "0d0996d7-6638-3146-92da-5840cd091a59",
                                                "text": "D’autre part, j’étais extrémiste : je voulais tout ou rien."
                                            },
                                            {
                                                "example_id": "0cb354c3-5304-4fdf-886c-bc68ad779833",
                                                "sense_id": "0d0996d7-6638-3146-92da-5840cd091a59",
                                                "text": "Les politologues parlent de Fenêtre d’Overton : cette formule décrit le type d’agenda centriste qu’un homme politique peut adopter sans risque d’être qualifié de réactionnaire ou d’extrémiste, et la manière dont il peut déplacer de quelques degrés vers la gauche ou la droite cette fenêtre d’acceptabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc871860-521e-341b-8611-5c06083e9778",
                                        "entry_id": "d014d791-3d2a-33af-9ef6-6131638eb872",
                                        "glosses": [
                                            "Au sens figuré, séparation équivalente à un cordon sanitaire au sens figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0ffbdec-5adf-4c14-8cb7-9069a97690e4",
                                                "sense_id": "fc871860-521e-341b-8611-5c06083e9778",
                                                "text": "En Allemagne, « des partis extrémistes comme l’AfD » peuvent « faire une campagne électorale tout à fait normale », a-t-il répliqué, soulignant la présence d’Alice Weidel « en prime time à la télévision » la veille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extrémiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9405763c-b8c4-3c50-9d03-fc6671d6d0c5",
                                        "entry_id": "cf08fd4f-6df5-3217-b830-66c4408c526e",
                                        "glosses": [
                                            "Personne qui est favorable à des idées et à des résolutions extrêmes. — Note d’usage : Il s’emploie surtout dans la langue politique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
