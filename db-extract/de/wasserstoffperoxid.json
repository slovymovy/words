                "senses": [
                    {
                        "sense_id": "784efc4c-e84e-396c-a7f3-daf1cd5ed592",
                        "entry_id": "b32d38f5-e54c-399c-9d45-592c79d0c979",
                        "glosses": [
                            "flüssige, chemische Verbindung aus Wasserstoff und Sauerstoff, die vor allem als Bleich- und Desinfektionsmittel genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aaa4892-41f8-4784-9507-e6826a804fea",
                                "sense_id": "784efc4c-e84e-396c-a7f3-daf1cd5ed592",
                                "text": "„Im September orderte der Terrorverdächtige noch einmal zehn Kilogramm Wasserstoffperoxid im Internet - kurz darauf stornierte er die Bestellung.“"
                            },
                            {
                                "example_id": "d23132ed-8731-4c8e-a982-8ae8808d8f87",
                                "sense_id": "784efc4c-e84e-396c-a7f3-daf1cd5ed592",
                                "text": "„Ein Griff zum falschen Kanister, und schon hatte ein Jäger in Hessen statt Benzin Wasserstoffperoxid in den Tank seines Autos gefüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
