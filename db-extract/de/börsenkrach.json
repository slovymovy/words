                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0d70dd5-b618-4b86-86a2-d3d5436f4078",
                        "source_entry_id": "b7360a58-02a6-303a-aa77-97156f59c926",
                        "source_sense_id": "b6a4ab03-129f-33c6-b0c9-8506a5ecf0a3",
                        "source_sense_description": "plötzlicher, enorm hoher Kursverlust an einer Börse",
                        "target_lang_word": "krach",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krach",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0ad05d-57d2-36e7-964f-bf17e473f469",
                                        "entry_id": "55b45e40-df7a-3469-b6d5-0b2ee8043418",
                                        "glosses": [
                                            "Désastre boursier, chute soudaine de la bourse."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a3de13-31d2-45a0-ba63-b59819e481c7",
                                                "sense_id": "8a0ad05d-57d2-36e7-964f-bf17e473f469",
                                                "text": "Elle ne devint catastrophe que dans sa troisième phase, quand soudain, au milieu d'un ciel serein, la foudre du krach bancaire de New-York frappa l’édifice orgueilleux de la prospérité du capital américain."
                                            },
                                            {
                                                "example_id": "0023bbf0-2b39-469a-aed3-05afeda50333",
                                                "sense_id": "8a0ad05d-57d2-36e7-964f-bf17e473f469",
                                                "text": "Il y a en Amérique, comme en tout pays, un chômage endémique et même avant la crise, on comptait environ deux millions de chômeurs. Mais quand, avec la baisse des prix, le manque de confiance, le krach de Wall Street, les gens cessèrent d’acheter, ce chômage augmenta en progression géométrique."
                                            },
                                            {
                                                "example_id": "dced6a2a-5cc2-4d24-8243-b1ff946fb610",
                                                "sense_id": "8a0ad05d-57d2-36e7-964f-bf17e473f469",
                                                "text": "Dieu merci, en novembre, le krach de Wall Street devait les rassurer : il l’accueillirent comme la nouvelle d'une victoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ba1c73-6978-3bb0-8477-fcb3c3dc1e56",
                                        "entry_id": "55b45e40-df7a-3469-b6d5-0b2ee8043418",
                                        "glosses": [
                                            "Effondrement du cours boursier d’une société cotée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3490f8e-d714-49b9-9c6d-28550cf3bddf",
                                                "sense_id": "96ba1c73-6978-3bb0-8477-fcb3c3dc1e56",
                                                "text": "L’AMF et la police de Laval enquêtent actuellement sur le nébuleux krach de la non moins nébuleuse cryptomonnaie québécoise MRS."
                                            },
                                            {
                                                "example_id": "6bd3c946-711e-46d1-8eba-613545812aab",
                                                "sense_id": "96ba1c73-6978-3bb0-8477-fcb3c3dc1e56",
                                                "text": "Le krach du Comptoir de Crédit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6653eaaa-813a-3c0b-bc0d-a35308bd03c0",
                                        "entry_id": "55b45e40-df7a-3469-b6d5-0b2ee8043418",
                                        "glosses": [
                                            "Ruine, faillite subite d’une entreprise financière, industrielle, cotée ou non."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a36d9ed-fedd-4dc5-b3a5-7e182306decc",
                                                "sense_id": "6653eaaa-813a-3c0b-bc0d-a35308bd03c0",
                                                "text": "Le krach Rolls-Royce en 1971."
                                            }
                                        ]
                                    }
                                ]
                            }
