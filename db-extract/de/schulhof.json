                ],
                "senses": [
                    {
                        "sense_id": "ba81f6ea-74e5-3233-999e-6e8f24952d7c",
                        "entry_id": "788e085e-68e1-3d5c-bdbf-0185c567c2ef",
                        "glosses": [
                            "Freifläche bei einer Schule, der von den Schülern zum Aufenthalt während der Pausen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b842ee17-e89e-4879-aa7d-b4e6e4c326fb",
                                "sense_id": "ba81f6ea-74e5-3233-999e-6e8f24952d7c",
                                "text": "In der großen Pause stürmen alle Schüler auf den Schulhof."
                            },
                            {
                                "example_id": "4cbcba6d-5c71-4746-b9fb-831f1f2e8daa",
                                "sense_id": "ba81f6ea-74e5-3233-999e-6e8f24952d7c",
                                "text": "„Mit Notizblock und Stift begaben sie die 15- und 16-Jährigen auf dem Schulhof, in der U-Bahn oder in den Straßen von Berlin-Kreuzberg auf die Suche nach Wörtern, die typisch für Kiezdeutsch sind.“"
                            },
                            {
                                "example_id": "9809b091-feb7-4b69-9ed7-a852e4c4b419",
                                "sense_id": "ba81f6ea-74e5-3233-999e-6e8f24952d7c",
                                "text": "„In den Pausen standen die Brüder auf dem Schulhof oft eng aneinandergedrängt und von einer tobenden, nach ihren Haaren greifenden Menge umzingelt, die um so lauter johlte, je deutlichere Zeichen des Entsetzens die beiden von sich gaben.“"
                            },
                            {
                                "example_id": "92cea9ac-1c14-48b6-ba71-8938eebb44bd",
                                "sense_id": "ba81f6ea-74e5-3233-999e-6e8f24952d7c",
                                "text": "„Es war der perfekte Ort, um den Schulhof auszuspionieren.“"
                            },
                            {
                                "example_id": "426a0f21-13d7-49b1-a604-4e786ff26a0b",
                                "sense_id": "ba81f6ea-74e5-3233-999e-6e8f24952d7c",
                                "text": "„Wenig später stapften wir über den staubigen, in der Hitze schwimmenden Schulhof.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
