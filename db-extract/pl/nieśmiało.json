                                "example_id": "ddef7dab-b52f-45d6-bc52-b95ee00d9383",
                                "sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                                "text": "Wypiła nieśmiało gin z tonikiem, a potem wyjęła papierośnicę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d28bba5-a3da-40ad-a1f2-0c0124810714",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "shyly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shyly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8540332-a8ca-391c-9430-199a2d8658ac",
                                        "entry_id": "8dbf6a34-f8d9-3005-9eb7-1f678fa4a5f8",
                                        "glosses": [
                                            "In a shy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c28ac15e-e150-4c2c-b5c2-5eb7ede2a714",
                                                "sense_id": "d8540332-a8ca-391c-9430-199a2d8658ac",
                                                "text": "The moon went slowly down in chastened loveliness; she departed like some sweet bride into her chamber, and long veil-like shadows crept up the sky through which the stars peeped shyly out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "338d5202-d333-43b0-aa32-6323c0deef5e",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "timidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc78106-4d64-3ca1-8a12-9bf52d77e28a",
                                        "entry_id": "667a51bc-83ae-39dc-93c8-2ca5ce4cb23a",
                                        "glosses": [
                                            "In a timid manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1c9ea9d-d9c2-4e0c-a4b5-c95a1e80e3f1",
                                                "sense_id": "ecc78106-4d64-3ca1-8a12-9bf52d77e28a",
                                                "text": "His mother o'er her barm-cloth wide / Gazed forward somewhat timidly / The new-comer's bright weed to see."
                                            },
                                            {
                                                "example_id": "16b3b958-efce-4066-9467-ab058d9c6615",
                                                "sense_id": "ecc78106-4d64-3ca1-8a12-9bf52d77e28a",
                                                "text": "The four young pigs who had protested when Napoleon abolished the Meetings raised their voices timidly, but they were promptly silenced by a tremendous growling from the dogs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f528706a-2675-4f51-b768-3c500db22e72",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "bashfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bashfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9970c70-8ea7-35d0-b46d-336239db2d0d",
                                        "entry_id": "6f8b356f-97b3-3767-ab87-4f09893ff9ec",
                                        "glosses": [
                                            "In a bashful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a62bae0-2656-4984-bfa1-35516b408efb",
                                                "sense_id": "f9970c70-8ea7-35d0-b46d-336239db2d0d",
                                                "text": "[T]he thrush sang his mocking songs and libellous ditties about everybody, but became occasionally a little sentimental and warbled gently and bashfully some tender stanzas."
                                            },
                                            {
                                                "example_id": "8228fa55-09a0-48ac-928d-c815577b8d82",
                                                "sense_id": "f9970c70-8ea7-35d0-b46d-336239db2d0d",
                                                "text": "The morning of the wedding he bounded up my stair, most tremendously shaved and brushed, stood upon my doormat bashfully hesitant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b31c2cb9-dfe2-4c0b-968b-fa01dbaab721",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "fearfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fearfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47e1660c-b716-3138-a96c-5110c6db3d21",
                                        "entry_id": "3807ddba-92c9-3882-acb3-869f828b84cd",
                                        "glosses": [
                                            "In a fearful manner; characterized by fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2863584-dfa8-40cb-b814-d7873fd08965",
                                                "sense_id": "47e1660c-b716-3138-a96c-5110c6db3d21",
                                                "text": "I stepped fearfully into the pitch-dark cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                        "entry_id": "3807ddba-92c9-3882-acb3-869f828b84cd",
                                        "glosses": [
                                            "very; very much."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c278a20e-37ba-4bfb-b1f9-82013bc8ab26",
                                                "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                                "text": "He's a fearfully good striker."
                                            },
                                            {
                                                "example_id": "424a3e69-00dc-40fb-bb36-916fc9a50475",
                                                "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                                "text": "Remember, when a horse is on its side the kicking-strap is useless, and the breechen nearly so, to prevent the swing of its hind legs; your aim is to get it away from the steps or wheel-plate of the trap, which, in its struggles, may cut its legs fearfully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "131310c5-2e48-4954-b0ef-fde1fe89b742",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "faintly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faintly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f72f26a1-52ae-3191-ab7e-91631f0ea52d",
                                        "entry_id": "eb00748e-a811-3f68-b8a8-461fcd73a691",
                                        "glosses": [
                                            "In a faint manner; very quietly or lightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ed7c33e-3865-4c50-99d3-f6eaf0a908d9",
                                                "sense_id": "f72f26a1-52ae-3191-ab7e-91631f0ea52d",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "7e6750b3-7329-480a-81cc-eeaf0b65ed20",
                                                "sense_id": "f72f26a1-52ae-3191-ab7e-91631f0ea52d",
                                                "text": "Faintlier, faintlier came the footfalls to his ear, until of all the faint sounds that came, by the abandoned air, to his ear, not one was a footfall, as far as he could judge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51809c87-c41b-4229-9c5f-798cd9fcc337",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "modestement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modestement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba4b6b0-57c5-305a-b3ba-eccd6b2c9368",
                                        "entry_id": "6987c370-29a2-30dd-8bd4-4a7b9eae65a3",
                                        "glosses": [
                                            "D’une manière modeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567f66bb-9018-46ae-b6c6-203809e81ba0",
                                                "sense_id": "9ba4b6b0-57c5-305a-b3ba-eccd6b2c9368",
                                                "text": "Il s’ensuit que vous commanderez modestement et humblement, et qu’on vous obéira fidèlement et promptement."
                                            },
                                            {
                                                "example_id": "6caf6c36-18f6-4bef-9b43-edc11bf055ba",
                                                "sense_id": "9ba4b6b0-57c5-305a-b3ba-eccd6b2c9368",
                                                "text": "En 1815, le père et la mère de Jeanne-Etiennette vivaient plus que modestement dans ce vieux quartier de Salins. Leur fille paraissait simple, intelligente et bonne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d57fcab-ce6a-4d80-9cff-46e7b4b856b7",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
                        "source_sense_id": "ba894b5c-420c-3687-ae2f-441baf96b939",
                        "target_lang_word": "timidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                        "entry_id": "f9892c39-9887-3e4a-821e-c64c868ad962",
                                        "glosses": [
                                            "D’une manière timide, avec timidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d86cc84-a714-4aef-a229-9c4550135472",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Sa casquette à carreaux lui attirant des quolibets, il l'ôta timidement."
                                            },
                                            {
                                                "example_id": "396797c7-7ceb-4b3d-b0e0-631ba51d8a46",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Enfin, elle articula timidement, d'une voix aiguë et mal assurée comme un violon qui crincrine : — Vous n'auriez pas une goutte de lait ?"
                                            },
                                            {
                                                "example_id": "ef9bd7e5-ca8d-4b83-aa1c-b22dc51d4fe2",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Hélas ! le citoyen, timidement fidèle, N'oserait en ces lieux imiter ce saint zèle,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e40cfec5-ffa9-43db-8a2a-a9bf6dc6c49f",
                        "source_entry_id": "fcc9d838-92a4-3080-8d8f-5be713ce9b63",
