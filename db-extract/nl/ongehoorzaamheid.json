                                "sense_id": "ee546a6b-28a1-3793-a2d1-33c3dd542275",
                                "text": "Ongehoorzaamheid kan leiden tot straf op school.",
                                "translation": "Disobedience can lead to punishment at school.",
                                "english": "Disobedience can lead to punishment at school."
                            },
                            {
                                "example_id": "43d64e35-d799-4058-98c4-3f681a3f4c0b",
                                "sense_id": "ee546a6b-28a1-3793-a2d1-33c3dd542275",
                                "text": "De ongehoorzaamheden van de jeugd verontrustten de ouderen.",
                                "translation": "The disobediences of the youth worried the elders.",
                                "english": "The disobediences of the youth worried the elders."
                            },
                            {
                                "example_id": "89707f57-82d0-40cb-b562-8ec78cc831ed",
                                "sense_id": "ee546a6b-28a1-3793-a2d1-33c3dd542275",
                                "text": "Hij werd geprezen voor zijn ongehoorzaamheidje tegen het onrechtvaardige regime.",
                                "translation": "He was praised for his small act of disobedience against the unjust regime.",
                                "english": "He was praised for his small act of disobedience against the unjust regime."
                            }
                        ]
