                "senses": [
                    {
                        "sense_id": "c5598793-775d-37f5-8ef9-433578f745a6",
                        "entry_id": "dab4fcac-0d0a-3cb6-9e61-95a3dbbfa646",
                        "glosses": [
                            "Êditer de façon supérieure à la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd33f55-3278-4f61-9ac6-fac21d86e928",
                                "sense_id": "c5598793-775d-37f5-8ef9-433578f745a6",
                                "text": "L’attirance de ce roman, parfois naïvement surécrit (ou surédité pour le succès) tient d’abord à ce délicat floutage de deux exils."
                            },
                            {
                                "example_id": "2c1af718-6229-45ae-a5b1-2e7d47744886",
                                "sense_id": "c5598793-775d-37f5-8ef9-433578f745a6",
                                "text": "Jusqu’ici, ça reste assez marginal, même si Prey Upon a été surédité, en Innistrad et en M13."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bdd0c47-5c0b-3cec-ae53-5930a0559be0",
                        "entry_id": "dab4fcac-0d0a-3cb6-9e61-95a3dbbfa646",
                        "glosses": [
                            "Modifier (un wiki) de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "680ac4db-c23b-4a11-adb6-a2551556150d",
                                "sense_id": "8bdd0c47-5c0b-3cec-ae53-5930a0559be0",
                                "text": "Les Boganov ont pris la Wikipedia pour un lieu où faire leur publicité, et l’ont éditée et suréditée en passant par quantité de proxies (pour masquer leur identité, leur tic typographique d’inclure deux espaces les trahissant de toute manière)."
                            }
                        ]
                    }
                ],
