                                        "sense_id": "4e9565c0-60fa-3446-9479-b2b3b28007f9",
                                        "entry_id": "79e256eb-c303-30cd-bf86-5b12f4d6fadc",
                                        "glosses": [
                                            "von Gang und Fahrt: stolpernd, abrupt, unbeholfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe70af68-bf85-44a9-bb03-fce17cc5ad95",
                                                "sense_id": "4e9565c0-60fa-3446-9479-b2b3b28007f9",
                                                "text": "Irgendwann wurde die Fahrt so holprig, dass das Kind im Auto aus seinem Sitz flog und mit dem Kopf gegen das Dach stieß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e648e81-656a-3219-8837-f0d740aff49c",
                                        "entry_id": "79e256eb-c303-30cd-bf86-5b12f4d6fadc",
                                        "glosses": [
                                            "von Straßen und Wegen, auf denen man geht oder fährt: uneben, voller Löcher oder Unebenheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d457cf57-61b3-41b9-b72f-5b683ecd8aad",
                                                "sense_id": "6e648e81-656a-3219-8837-f0d740aff49c",
                                                "text": "Die Strecke von der Hauptstraße zum Gut war so holperig, dass der Besucher auf der Kutsche sein Doppelkinn beben fühlte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "97d1ed43-9755-3e4c-a207-5e458b1947b3",
                                        "entry_id": "79e256eb-c303-30cd-bf86-5b12f4d6fadc",
                                        "glosses": [
                                            "bildhaft vom Sprechen und anderen Handlungen: unbeholfen, mit vielen Unterbrechungen, nur mit Ach und Krach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e752b8a3-c6b7-4542-a676-eb7ce3df78a4",
                                                "sense_id": "97d1ed43-9755-3e4c-a207-5e458b1947b3",
                                                "text": "Die erste Predigt des jungen Pfarrers war zwar etwas holprig, er würde das aber schon noch lernen."
                                            },
                                            {
                                                "example_id": "27399adf-996b-4972-853c-b3e9b7523c2a",
                                                "sense_id": "97d1ed43-9755-3e4c-a207-5e458b1947b3",
                                                "text": "Die Gründung des neuen Vereins verlief etwas holprig, weil sich zwei der Gründer gleich heftig zerstritten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
