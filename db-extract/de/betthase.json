                ],
                "senses": [
                    {
                        "sense_id": "09bfd241-440b-3e09-9002-4191585acd3d",
                        "entry_id": "a6519f37-2d4e-32cc-b2cc-a70e8266bad7",
                        "glosses": [
                            "Sexualpartnerin"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "b5d16a52-9ac2-411e-9aa3-938b7973ad3c",
                                "sense_id": "09bfd241-440b-3e09-9002-4191585acd3d",
                                "text": "„Zu seinen Betthasen, behauptet er, gehörten nicht nur namenlose Groupies, sondern jede Menge Promis: Außer Persiens Ex-Kaiserin vergnügten sich Vicky Leandros, Dunja Rajter, Tyrone Powers Witwe Linda Christian mit dem smarten Sänger.“ (Christian Anders)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef67464-7cb5-4e5f-acb5-a1f581010946",
                        "source_entry_id": "a6519f37-2d4e-32cc-b2cc-a70e8266bad7",
                        "source_sense_id": "09bfd241-440b-3e09-9002-4191585acd3d",
                        "source_sense_description": "salopp: Sexualpartnerin",
                        "target_lang_word": "coup",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Impression que fait un corps sur un autre en le frappant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eac0420-d64e-43ee-b785-f339983ba936",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "Le docteur Paul était ensuite venu, brillamment expliquer à la barre comment les coups avaient occasionné, en effet, seize blessures."
                                            },
                                            {
                                                "example_id": "54e36afd-8940-4704-b2a2-4d17f6f7e2af",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "C’est ainsi que, le 21 adar 4996 (1236), un pêcheur chrétien étant mort des coups que lui avait portés un juif au cours d’une rixe, la foule envahit la juiverie vicomtale, avec l’intention de la mettre à sac."
                                            },
                                            {
                                                "example_id": "1feaea42-6645-4da6-8f95-3b2802482184",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "J’ai vu des prisonniers jetés à coups de matraque d’un étage à l’autre et qui, hébétés par la torture et les coups, ne savaient plus que murmurer en arabe les premières paroles d’une ancienne prière."
                                            },
                                            {
                                                "example_id": "6e84c259-ac53-4b50-998c-561415e73fa0",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "Et crescendo, la querelle s’envenime en injures, bien sûr, et non en coups, car les deux gondoliers savent pratiquer l’art de « rompre le fer »."
                                            },
                                            {
                                                "example_id": "57999bd3-6f32-46d5-8264-b57a6a35481b",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "Instinctivement Éric esquive le coup, bascule en arrière en entraînant l’homme dans sa chute et l’envoie bouler à quelques mètres."
                                            },
                                            {
                                                "example_id": "31211303-ddc9-43d7-8bb7-4fce235fbca6",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "Frapper un coup ou deux coups à une porte avec le marteau."
                                            },
                                            {
                                                "example_id": "81a64935-0988-44c7-972b-fa5e5343e63b",
                                                "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                                                "text": "Faire tomber une grêle de coups sur les épaules de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Se dit en parlant des choses qui nuisent, qui causent un sentiment pénible, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659d2e70-867f-46c5-9579-00a48741f436",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "L’autre soir, je passais devant votre maison ; il y avait de la lumière, et j’ai entendu du bruit. J’étais si sotte que j’ai cru que vous étiez revenus, et ça m’a donné un coup."
                                            },
                                            {
                                                "example_id": "723d6fed-7a6e-4e14-b658-12e99b75d994",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "On affirme trop souvent qu’après la première génération félibréenne et les œuvres de Roumanille, d’Aubanel et de Mistral, la littérature de langue d’oc n’a point soutenu sa valeur, et que, Mistral disparu, le Félibrige a reçu un coup mortel."
                                            },
                                            {
                                                "example_id": "d2e7295a-7711-4f09-b41f-0fdd2e2e8b49",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "Il a déjà réussi à faire renvoyer un policier. Il continuera à faire de sales coups jusqu’au bout."
                                            },
                                            {
                                                "example_id": "26b4b033-4076-4d7b-a02a-1860f154e3e8",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "Il supporte les coups du sort, du destin, de la fortune avec une noble résignation."
                                            },
                                            {
                                                "example_id": "1e5afcaf-51d6-4d8b-8990-b45ccbc78265",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "Cette défaite porta un coup funeste à la gloire de ce prince."
                                            },
                                            {
                                                "example_id": "06270465-43b3-4c68-a58c-52258c6b638b",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "Son autorité chancelante allait recevoir un dernier coup."
                                            },
                                            {
                                                "example_id": "a358328e-d105-42e6-8bd3-456140c5b38a",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "Cette entreprise a porté un coup à sa fortune."
                                            },
                                            {
                                                "example_id": "bd024214-db3f-4fe7-83c0-be753c2dd0d6",
                                                "sense_id": "96626281-a398-3ef9-b331-dbd6e0820cb6",
                                                "text": "Ce chagrin porta un coup à sa santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea9e227-ecd1-3c5c-9f37-9ed226b8509e",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Décharge et bruit que font les armes à feu lorsqu’on les tire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7228a072-581e-4bc3-b86f-8e3ed8d85dfa",
                                                "sense_id": "bea9e227-ecd1-3c5c-9f37-9ed226b8509e",
                                                "text": "J’avais oublié le cran d’arrêt […] Pour un peu, je pressais la gâchette sans que le coup partît."
                                            },
                                            {
                                                "example_id": "81f54b6b-3d7d-4d6c-9691-a446fc6cfb5e",
                                                "sense_id": "bea9e227-ecd1-3c5c-9f37-9ed226b8509e",
                                                "text": "On chantait presque tous les mois des Te Deum pour quelque nouvelle victoire, et le canon de l’arsenal tirait ses vingt et un coups, qui vous faisaient trembler le cœur."
                                            },
                                            {
                                                "example_id": "023ce5b6-3090-461d-a5cd-3d4d6af6eabc",
                                                "sense_id": "bea9e227-ecd1-3c5c-9f37-9ed226b8509e",
                                                "text": "Mais, saperlotte ! tâchons donc que tout ça se passe tranquillement ; ça vaudrait beaucoup mieux. Puisque nous avons le suffrage universel, il n’y a plus besoin de coups de fusil."
                                            },
                                            {
                                                "example_id": "116f1bf4-fdb8-454c-b236-ccba8398851b",
                                                "sense_id": "bea9e227-ecd1-3c5c-9f37-9ed226b8509e",
                                                "text": "Tirer des coups de canon, de fusil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e64894-458e-3439-ac8d-2b4c1f743fed",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Évènement imprévu qui a frappé quelqu’un soudainement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f66bb4-d706-49a6-b34f-a13f8877f74c",
                                                "sense_id": "80e64894-458e-3439-ac8d-2b4c1f743fed",
                                                "text": "Pas de malchance envers les Françaises donc, ni de sale coup de hasard ou de cul bordé de nouilles pour leurs adversaires, rien que la gestion de la technique, l’intelligence du jeu, l’incertitude du sport."
                                            },
                                            {
                                                "example_id": "afd28af8-1b14-4f6a-b1ee-47909e592bab",
                                                "sense_id": "80e64894-458e-3439-ac8d-2b4c1f743fed",
                                                "text": "Ce fut un coup de massue, un coup de foudre, un coup de tonnerre pour lui."
                                            },
                                            {
                                                "example_id": "2b1228c0-6f73-4b88-a3a7-66c7b3969afa",
                                                "sense_id": "80e64894-458e-3439-ac8d-2b4c1f743fed",
                                                "text": "Coup de fortune, de bonheur, de malheur, de hasard."
                                            },
                                            {
                                                "example_id": "da2afd91-aa4a-4194-98f1-3b11d511366b",
                                                "sense_id": "80e64894-458e-3439-ac8d-2b4c1f743fed",
                                                "text": "Coup du ciel, d’en haut, de la Providence, de la grâce."
                                            },
                                            {
                                                "example_id": "9b0e2e70-a1d9-4688-9a6e-eae33c9092bc",
                                                "sense_id": "80e64894-458e-3439-ac8d-2b4c1f743fed",
                                                "text": "Mort sur le coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e57c97f-f5bf-3db5-b856-d6c4d467484f",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Son que rendent certains corps lorsqu’ils viennent à être frappés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa4d8a0c-9dfe-4923-916e-72ec48ac75bb",
                                                "sense_id": "8e57c97f-f5bf-3db5-b856-d6c4d467484f",
                                                "text": "Un coup de cloche, de tambour, de tam-tam."
                                            },
                                            {
                                                "example_id": "16fdeb91-4fcf-4b63-a20a-60cac8e61e40",
                                                "sense_id": "8e57c97f-f5bf-3db5-b856-d6c4d467484f",
                                                "text": "Au coup de minuit, de midi, de trois heures, etc. : Au moment où minuit, où midi, où trois heures, etc., sonnent."
                                            },
                                            {
                                                "example_id": "fe5f73b6-02b7-4e4f-b36e-e40b2bea5daf",
                                                "sense_id": "8e57c97f-f5bf-3db5-b856-d6c4d467484f",
                                                "text": "Je suis arrivé au Monte-Carlo sur le coup de onze heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "955226dc-dcc4-360b-9752-da0989c2e2ae",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Action rapide et momentanée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f1fef1-2c6d-4ab9-90d5-d0fbcb72b3d6",
                                                "sense_id": "955226dc-dcc4-360b-9752-da0989c2e2ae",
                                                "text": "D’un coup de rasoir, je lui coupai la tête, et le tronc, d’où un flot de sang s’échappait, gigota quelques secondes sur le parquet."
                                            },
                                            {
                                                "example_id": "fcfe4c34-3d67-4fab-8a87-fd4f38705d57",
                                                "sense_id": "955226dc-dcc4-360b-9752-da0989c2e2ae",
                                                "text": "Les portières sont refermées, après la visite du contrôleur. Un dernier coup de sifflet annonce que le train va se mettre en marche…"
                                            },
                                            {
                                                "example_id": "e72fe6ed-a27a-444c-814a-e84f40aed062",
                                                "sense_id": "955226dc-dcc4-360b-9752-da0989c2e2ae",
                                                "text": "Lier plusieurs notes d’un coup d’archet. — Un coup de gosier. — Un coup de ciseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010c79f2-ca2f-34ce-bc9d-1c58afd3cbfb",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Ce qu’on fait rapidement, légèrement, ou sans y apporter le même soin que de coutume."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2e20fe-d762-41da-9a67-dd15c698d185",
                                                "sense_id": "010c79f2-ca2f-34ce-bc9d-1c58afd3cbfb",
                                                "text": "Donnez un coup de balai à cette chambre."
                                            },
                                            {
                                                "example_id": "38674535-c2b4-46a9-8ff0-e4d33d217daf",
                                                "sense_id": "010c79f2-ca2f-34ce-bc9d-1c58afd3cbfb",
                                                "text": "Je suis trop pressé pour me faire coiffer, un coup de peigne suffira."
                                            },
                                            {
                                                "example_id": "5e66ff48-2cac-4138-88ec-1850a8c1dfe3",
                                                "sense_id": "010c79f2-ca2f-34ce-bc9d-1c58afd3cbfb",
                                                "text": "Dans la vie de Clémence Dufour, il y avait quand même pas mal de vaisselles, de patins à l’entrée du salon, de « petits coups à donner » sur la table, avant de mettre le couvert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aef888c-cda2-3d5e-a5ad-ea05db709576",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Petite quantité de quelque chose."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340961c9-4834-465a-927c-e90d621ab400",
                                                "sense_id": "4aef888c-cda2-3d5e-a5ad-ea05db709576",
                                                "text": "Mettre un coup de peinture, de Tipex, d’engrais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa3a996-becf-3f6d-9234-2cce769420e6",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Mouvement impétueux, comme du vent qui souffle sur la mer, d’une tempête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5064e43e-45d8-47e7-a78c-c81cbbf8452f",
                                                "sense_id": "eaa3a996-becf-3f6d-9234-2cce769420e6",
                                                "text": "Coup de vent, de mistral."
                                            },
                                            {
                                                "example_id": "1def6f47-b0b4-44f6-a6ed-54580d3b22b3",
                                                "sense_id": "eaa3a996-becf-3f6d-9234-2cce769420e6",
                                                "text": "Un coup de mer écarta leurs vaisseaux, les jeta, les poussa sur les côtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb58e84-e6e8-30b1-b794-6668e95a1e36",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Manière de jouer, chance au jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7de514-70db-421f-b1c0-ceb32a5ae88f",
                                                "sense_id": "adb58e84-e6e8-30b1-b794-6668e95a1e36",
                                                "text": "Il a fait un beau coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e92bc6ea-7044-308b-962f-88307bcf8d9f",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Action humaine inattendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814ae374-2c16-4b11-8c65-84519d31efed",
                                                "sense_id": "e92bc6ea-7044-308b-962f-88307bcf8d9f",
                                                "text": "C'est un ustensile à l'usage des voleurs, et ces gens avaient bien les allures de malandrins qui viennent faire un mauvais coup."
                                            },
                                            {
                                                "example_id": "4dc4445b-35c1-478c-9aa6-49a00770879c",
                                                "sense_id": "e92bc6ea-7044-308b-962f-88307bcf8d9f",
                                                "text": "Les affaires de banque je n'y comprends peut-être pas grand-chose, mais les mauvais coups, je les sens et je dis que cette affaire n'est pas catholique."
                                            },
                                            {
                                                "example_id": "2a014e8c-fc03-47aa-b639-8180a7706a5e",
                                                "sense_id": "e92bc6ea-7044-308b-962f-88307bcf8d9f",
                                                "text": "Heureux coup."
                                            },
                                            {
                                                "example_id": "3e3b4553-f490-425b-9e48-871969e08c07",
                                                "sense_id": "e92bc6ea-7044-308b-962f-88307bcf8d9f",
                                                "text": "C’est un coup de génie, de désespoir."
                                            },
                                            {
                                                "example_id": "da116a98-7981-41de-8324-38984878cb49",
                                                "sense_id": "e92bc6ea-7044-308b-962f-88307bcf8d9f",
                                                "text": "Je suis avec ta nana sur ce coup. Prends l'oseille et tire-toi. Accepte d'être épaulé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db6e4998-a725-3924-a044-ee709db7cdff",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac31c6c-9f82-4636-8db3-39c77ad614f7",
                                                "sense_id": "db6e4998-a725-3924-a044-ee709db7cdff",
                                                "text": "Il a réussi du premier coup."
                                            },
                                            {
                                                "example_id": "a7616c67-a145-4b26-9498-773ae0a0d7e6",
                                                "sense_id": "db6e4998-a725-3924-a044-ee709db7cdff",
                                                "text": "Il a encore trois coups à jouer."
                                            },
                                            {
                                                "example_id": "1242abc3-4a23-43f8-aaa2-03f89f29c25f",
                                                "sense_id": "db6e4998-a725-3924-a044-ee709db7cdff",
                                                "text": "J’ai eu du chagrin de savoir que ton neveu s’était fait refuser aux postes encore un coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15cdc7e1-fec6-3422-a9ec-3c4de1b39989",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Quantité que l’on boit en une fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b669b8-8130-495e-96d6-ca2a0ffa0140",
                                                "sense_id": "15cdc7e1-fec6-3422-a9ec-3c4de1b39989",
                                                "text": "Pour l’Ogre il se remit à boire ravis d’avoir de quoy si bien regaler ses amis. Il but une douzaine de coups plus qu’à l’ordinaire, ce qui luy donna un peu dans la teste, et l’obligea de s’aller coucher."
                                            },
                                            {
                                                "example_id": "432fc09f-0361-4087-9f0a-9e6ccd9e3422",
                                                "sense_id": "15cdc7e1-fec6-3422-a9ec-3c4de1b39989",
                                                "text": "On peut voir à la terrasse des petits cafés des gens qui prennent l’apéro en famille pour tuer le dimanche comme l’homme à la bêche prend un coup de blanc le matin pour « tuer le ver » avant de retrousser ses manches, se cracher dans les mains avant d'empoigner son outil […]."
                                            },
                                            {
                                                "example_id": "3365611e-7cfc-47bb-82ad-01ef39e1395c",
                                                "sense_id": "15cdc7e1-fec6-3422-a9ec-3c4de1b39989",
                                                "text": "« Tu bois des coups le samedi soir, et le dimanche matin tout le monde se réunit autour du même centre d’intérêt, la cafetière, pour passer la gueule de bois. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dfe540c-8f5a-31ff-a343-a4e59c536472",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Acte sexuel expéditif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0043baa-9020-4c6e-a0da-802a2fa925aa",
                                                "sense_id": "5dfe540c-8f5a-31ff-a343-a4e59c536472",
                                                "text": "J’ai tiré mon coup."
                                            },
                                            {
                                                "example_id": "52df6ba1-0e27-4459-938f-589db0b64979",
                                                "sense_id": "5dfe540c-8f5a-31ff-a343-a4e59c536472",
                                                "text": "T’as cassé mon coup."
                                            },
                                            {
                                                "example_id": "535b316d-ddcf-4981-9fd3-ffd80c5b2e06",
                                                "sense_id": "5dfe540c-8f5a-31ff-a343-a4e59c536472",
                                                "text": "C’était pas un bon coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd65b54-3cc4-33d7-a87f-1da9b8f8d75c",
                                        "entry_id": "d27047be-752f-3ccc-b86a-02c007971587",
                                        "glosses": [
                                            "Partie, sortie."
                                        ],
                                        "tags": [
                                            "Nouvelle-Calédonie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7110b73-9d7f-42cd-bbac-40716c6f9f17",
                                                "sense_id": "ffd65b54-3cc4-33d7-a87f-1da9b8f8d75c",
                                                "text": "Un coup de chasse."
                                            },
                                            {
                                                "example_id": "781cdbeb-666d-4687-9fe1-2d05c38eece4",
                                                "sense_id": "ffd65b54-3cc4-33d7-a87f-1da9b8f8d75c",
                                                "text": "Un coup de pêche."
                                            },
                                            {
                                                "example_id": "738cd813-3437-43dd-a959-13ed30fa6c0b",
                                                "sense_id": "ffd65b54-3cc4-33d7-a87f-1da9b8f8d75c",
                                                "text": "Un coup de fête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
