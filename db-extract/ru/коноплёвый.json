                        "entry_id": "5b127790-fc7c-35f8-ac99-a0eb7539ccf4",
                        "glosses": [
                            "ботан. используется в составных названиях травянистых растений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f434370-3f3f-4797-b095-d55c04659032",
                                "sense_id": "e19ac249-909f-36ec-817f-9058cf2979e3",
                                "text": "В Гималаях из луба волчника коноплёвого делают так называемую непальскую писчую бумагу."
                            }
                        ]
                    }
