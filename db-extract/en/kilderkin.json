                        "glosses": [
                            "An old English liquid measure, usually being half a barrel; containing 18 English beer gallons, or 83.178 L."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40af1fd-766b-4179-97f5-443e4e0b9e42",
                                "sense_id": "453b0bc5-f455-3ebd-abc2-e1cf56675aa9",
                                "text": "1882: 23 Hen. VIII, cap. 4... The barrel of beer is to hold 36 gallons, the kilderkin 18 gallons the firkin 9. But the barrel, kilderkin, and firkin of ale are to contain 32, 16, and 8 gallons. — James Edwin Thorold Rogers, A History of Agriculture and Prices in England, Volume 4, p. 205."
                            },
                            {
                                "example_id": "7c688aec-35cb-4e2a-abd9-75a8bead20f5",
                                "sense_id": "453b0bc5-f455-3ebd-abc2-e1cf56675aa9",
                                "text": "Barrels came in firkins, nine gallons; kilderkins, eighteen gallons; halves, twenty-seven gallons; barrels, thirty-six gallons and hogsheads, fifty-four."
                            }
                        ]
