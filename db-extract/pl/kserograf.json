                                            {
                                                "example_id": "bdd21b54-35b9-4710-8472-9af2b7bbc0e1",
                                                "sense_id": "84bd37a2-63f5-3b6d-82ed-66e0c94c6275",
                                                "text": "Now the chintzy nameplate is all that distinguishes his work space from those of the photocopier repairperson, diet food company, and kitchen designer down the hall."
