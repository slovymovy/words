                        "entry_id": "01841271-2d0c-3017-aa49-8604294b0f61",
                        "glosses": [
                            "Caractère de ce qui est ovipare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f05ad283-35fb-4a83-8551-f32ecdbae2b2",
                                "sense_id": "c6bec2be-5bf4-33e0-89c2-e9cc5f70d1dc",
                                "text": "L'oviparité est utilisée par de nombreux animaux, incluant tous les oiseaux, de nombreux amphibiens, insectes et arachnides, beaucoup de reptiles, de poissons et les monotrèmes."
                            },
                            {
                                "example_id": "cc51e9a9-ce14-467d-ad56-c0bb89a209d5",
                                "sense_id": "c6bec2be-5bf4-33e0-89c2-e9cc5f70d1dc",
                                "text": "Cependant, l’oviparité est particulièrement efficace et la plupart des espèces de reptiles et d’oiseaux utilisent ce mode de reproduction actuellement."
                            }
                        ]
                    }
