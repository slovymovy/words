                    {
                        "translation_id": "57456b61-6943-4d4d-82e9-f4845e1711c6",
                        "source_entry_id": "bce6c0cc-6301-3fa9-95d5-05418aca0aa2",
                        "source_sense_id": "e42161b0-9937-3171-a884-8cd728c22853",
