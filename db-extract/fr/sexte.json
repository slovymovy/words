                "senses": [
                    {
                        "sense_id": "e6d2570d-df8d-3aa7-a97a-7744a8399f3a",
                        "entry_id": "7d252a85-77a1-30fd-9db8-08c824620dce",
                        "glosses": [
                            "Troisième partie du jour, qui commençait à la fin de la sixième heure du jour, c’est-à-dire à midi dans le calendrier romain."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d0de3645-25de-3dbb-a2b4-4ecbbbb4d419",
                        "entry_id": "7d252a85-77a1-30fd-9db8-08c824620dce",
                        "glosses": [
                            "Celle des heures canoniales qui doit être chantée vers la sixième heure du jour, dans la liturgie catholique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fab7d3d-3f3c-4df9-a528-77813f6dd3db",
                                "sense_id": "d0de3645-25de-3dbb-a2b4-4ecbbbb4d419",
                                "text": "Prime, tierce, sexte, none."
                            },
                            {
                                "example_id": "c5ca3d24-be71-48ab-9c81-c0882b1f1869",
                                "sense_id": "d0de3645-25de-3dbb-a2b4-4ecbbbb4d419",
                                "text": "Fin du travail à 9 heures et intervalle, Sexte à 11 heures, Angélus et le dîner à 11 heures 1/2, Méridienne après le dîner, Fin de la méridienne à 1 heure 1/2."
                            },
                            {
                                "example_id": "e493a1d5-48ef-42a3-94ec-2a8b05e08964",
                                "sense_id": "d0de3645-25de-3dbb-a2b4-4ecbbbb4d419",
                                "text": "L’office de sexte, est chanté au réfectoire, avant le déjeuner pris en silence …. Les moines se rassembleront de nouveau pour none, vêpres, et complies."
                            },
                            {
                                "example_id": "76380704-4a05-44a7-8be2-493c07fb575d",
                                "sense_id": "d0de3645-25de-3dbb-a2b4-4ecbbbb4d419",
                                "text": "Avant de la laisser seule, le moine lui indiqua la liturgie des heures, matines, laudes, tierce, sexte, none, vêpres, complies et vigiles, et devant son air concentré et perdu, il lui dit que chaque horaire était noté sur une feuille posée sur le bureau..."
                            }
                        ]
                    }
