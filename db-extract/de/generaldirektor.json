                ],
                "senses": [
                    {
                        "sense_id": "b9d822a1-09ba-3853-9d7f-1079879e2070",
                        "entry_id": "d2a2c3e0-1262-3b26-ab5a-3282d8480ef8",
                        "glosses": [
                            "Person, die ein größeres Unternehmen oder Institution leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18e40d6-3247-405e-ba94-e428600269fe",
                                "sense_id": "b9d822a1-09ba-3853-9d7f-1079879e2070",
                                "text": "„Der Generaldirektor leitet das Sekretariat der WHO und ist der höchste technische und administrative Beamte der sind.“"
                            },
                            {
                                "example_id": "51722b68-b642-4745-8864-e6ed31094ad0",
                                "sense_id": "b9d822a1-09ba-3853-9d7f-1079879e2070",
                                "text": "„Er war der Generaldirektor, wenn nicht gar der Besitzer einer Möbelfabrik.“"
                            },
                            {
                                "example_id": "129c01ef-1fa2-43c1-9ee9-565e740d1735",
                                "sense_id": "b9d822a1-09ba-3853-9d7f-1079879e2070",
                                "text": "„Beim ORF steht die Wahl eines neuen Generaldirektors bevor.“"
                            },
                            {
                                "example_id": "a92c5ea7-a0da-41b5-b0f0-729751827e52",
                                "sense_id": "b9d822a1-09ba-3853-9d7f-1079879e2070",
                                "text": "„Die Gründungsworte spricht Adolf Grimme, letzter Preußischer Kultusminister vor der NS-Zeit, jetzt Generaldirektor des Nordwestdeutschen Rundfunks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
