                        "glosses": [
                            "Croisé réciproquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18c183e-e8a1-4f1f-9541-041fc0466d21",
                                "sense_id": "79dbe38e-a68a-372c-88ef-9d092650ff70",
                                "text": "Des fils entre-croisés."
                            },
                            {
                                "example_id": "c64ddc83-c535-4219-b60b-20b3005dac16",
                                "sense_id": "79dbe38e-a68a-372c-88ef-9d092650ff70",
                                "text": "La côte, rayée de murs blancs, couturée de pierres alignées et entre-croisées, semble un rude bord d’aiguière ou d’auge calcaire qui, par méprise, enferme une liqueur précieuse."
                            },
                            {
                                "example_id": "e6ead878-7a8c-47ca-a08e-9c8cc551e37d",
                                "sense_id": "79dbe38e-a68a-372c-88ef-9d092650ff70",
                                "text": "La teinte de polarisation reste dans les noirs bleutés lorsque les fibres sont entre-croisées, et monte jusqu'à des couleurs chaudron lorsqu'elles sont parallèles."
                            },
                            {
                                "example_id": "f2ff69ed-6718-4e25-a876-94142614938d",
                                "sense_id": "79dbe38e-a68a-372c-88ef-9d092650ff70",
                                "text": "Le sol, qui n’était point pavé, portait une épaisse couche de boue desséchée, et toute la place était entourée de petites maisons bâties en briques et en terre glaise, dont les murs étaient soutenus par des poutres et des solives entre-croisées."
                            }
                        ]
                    }
