                ],
                "senses": [
                    {
                        "sense_id": "d57c513a-8505-3ab3-8749-97b23fee8532",
                        "entry_id": "84d09578-cfbf-3cc1-9419-a998588bf8a3",
                        "glosses": [
                            "Turm mit Sendeanlagen für Hörfunk und Fernsehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ba82c5-162f-414c-8e7d-887c678c2045",
                                "sense_id": "d57c513a-8505-3ab3-8749-97b23fee8532",
                                "text": "In Berlin steht der bekannte Berliner Fernsehturm."
                            },
                            {
                                "example_id": "bc185efd-2cef-4bf2-94d4-9ae39a4af736",
                                "sense_id": "d57c513a-8505-3ab3-8749-97b23fee8532",
                                "text": "„Vom Fernsehturm war nichts zu sehen, aber der mußte irgendwo in der Richtung stehen, die wir eingeschlagen hatten.“"
                            },
                            {
                                "example_id": "bec05a86-13fd-43ca-a9e9-2b5a0787dc5a",
                                "sense_id": "d57c513a-8505-3ab3-8749-97b23fee8532",
                                "text": "„Mittags trafen sie sich auf dem Kleinen Bunkerberg, blickten am Fernsehturm vorbei in die weite, flache Stadt, bis an den Mauerlinienhorizont, bastelten und projektierten bei Kaffee und belegten Brötchen.“"
                            },
                            {
                                "example_id": "b624ddc8-551b-4699-b74e-9896207cd9c1",
                                "sense_id": "d57c513a-8505-3ab3-8749-97b23fee8532",
                                "text": "„Der Fernsehturm ist insgesamt 365 Meter hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
