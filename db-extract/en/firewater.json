                    {
                        "translation_id": "495982e1-2c16-4459-b80c-51d33a2b5b70",
                        "source_entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "source_sense_description": "high-proof alcoholic beverage",
                        "target_lang_word": "Feuerwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                        "entry_id": "2438cd32-db86-35d1-94bb-c845b97228f8",
                                        "glosses": [
                                            "hochprozentiges alkoholisches Getränk, Branntwein, Schnaps"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc7b2505-8abc-4dcf-b697-dfe3fc245045",
                                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                                "text": "„Stoßen wir trotzdem noch einmal mit dem Feuerwasser an, das immer brennt.“"
                                            },
                                            {
                                                "example_id": "7dc8211c-d5fb-402f-a627-0822258a97e2",
                                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                                "text": "„Ihre Jagdgebiete schrumpften, und das leicht zugängliche Feuerwasser forderte seinen Tribut.“"
                                            },
                                            {
                                                "example_id": "676fbb8f-b283-4a94-a4f8-6fb6afba60df",
                                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                                "text": "„Sie belohnte die Willigen mit einer Kalebasse des deliziösen Feuerwassers, während sie sie dem Mürrischen oder Widerspenstigen mit demselben schlauen Lächeln mit reinem Quellwasser füllte.“"
                                            },
                                            {
                                                "example_id": "fc6a6385-4f53-490a-955f-b0734532da2a",
                                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                                "text": "„Winnetou verfiel nicht dem Feuerwasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d96c464d-5840-4551-9df6-5c3c971111a7",
                        "source_entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "source_sense_description": "high-proof alcoholic beverage",
                        "target_lang_word": "огненная вода",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "огненная вода",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2d0079e8-3806-31b6-b2d1-9b3937ff5c36",
                                        "entry_id": "337befce-1971-352b-b9a8-98a5d71569b8",
                                        "glosses": [
                                            "жарг. любой тип алкогольного напитка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36840f1b-a791-40df-bf10-fb1e9992789b",
                                                "sense_id": "2d0079e8-3806-31b6-b2d1-9b3937ff5c36",
                                                "text": "Чего стоит хотя бы один местный шаромыга и по совместительству пьяница дед Митя (хотя он, конечно, на деда не очень-то и похож). За глоток огненной воды он может сделать всё, что угодно, и даже в окружении недоумевающих односельчан помянуть ещё не усопшую, но очень надоевшую жену."
                                            },
                                            {
                                                "example_id": "2d08b365-12bc-441e-bbec-c083ae2be254",
                                                "sense_id": "2d0079e8-3806-31b6-b2d1-9b3937ff5c36",
                                                "text": "Кстати, ни водки, ни пива после 6 вечера купить невозможно — таковы как республиканские, так и улусные законы. А в соседнем оленеводческом посёлке Учугей, где живут в основном эвенки, «огненную воду» вообще купить нельзя."
                                            },
                                            {
                                                "example_id": "821979f4-9554-482a-a65d-8888b80c6ef2",
                                                "sense_id": "2d0079e8-3806-31b6-b2d1-9b3937ff5c36",
                                                "text": "Позже, дабы не создавать новых трудностей с поставкой во дворец огненной воды, во дворце был создан водкопровод, коим и пользовался государь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3aa6603a-4e26-4cb9-81e8-bd01b66381fa",
                        "source_entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "source_sense_description": "water for use in firefighting",
                        "target_lang_word": "bluswater",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bluswater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aa8efa28-b700-3584-9cd6-82022959078c",
                                        "entry_id": "d060132e-c8dc-3854-b333-4a5496fbee20",
                                        "glosses": [
                                            "het water waarmee men een vuur dooft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540b4402-a151-42fc-b271-447e969d636c",
                                                "sense_id": "aa8efa28-b700-3584-9cd6-82022959078c",
                                                "text": "De A4 bij Bergen op Zoom is vrijdagochtend en een deel van de middag dicht geweest omdat er frituurvet op de snelweg lag. Er stond een vrachtauto met het vet in brand. Het vet en bluswater kwamen op de rijbaan terecht en liepen ook onder de vangrail door."
                                            },
                                            {
                                                "example_id": "43e4ca46-6a03-4648-8beb-6d67b7382a92",
                                                "sense_id": "aa8efa28-b700-3584-9cd6-82022959078c",
                                                "text": "Het terrein rondom de tapijthandel is afgezet. Ook is het treinverkeer tussen Roermond en Nijmegen stilgelegd, omdat de brandweer over het spoor een buis heeft aangelegd om bluswater uit de Maas te halen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7814d9ad-0695-490e-9b09-a5389b6e2d14",
                        "source_entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "source_sense_description": "water for use in firefighting",
                        "target_lang_word": "eau d'extinction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "895ecac6-97a2-4f82-9bd6-80d83dc80f8c",
                        "source_entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "source_sense_description": "water for use in firefighting",
                        "target_lang_word": "Löschwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Löschwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                        "entry_id": "dac2d488-1d38-3de5-82bd-25b6dff65100",
                                        "glosses": [
                                            "Wasser, das zum Löschen eines Feuers verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d3742e-45a5-402a-9c4b-57ff009d5d26",
                                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                                "text": "Die Feuerwehr musste das Löschwasser hunderte Meter weit pumpen."
                                            },
                                            {
                                                "example_id": "43c5f376-0a5e-4a8d-86f6-f8351018331c",
                                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                                "text": "„Durch die enorme Hitzeentwicklung brannten Leichtmetallteile im Motorraum, die heftig mit dem Löschwasser reagierten.“"
                                            },
                                            {
                                                "example_id": "5a1665d3-0cba-423c-af0e-174ee7634780",
                                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                                "text": "„Obwohl das Hotel und Restaurant direkt am Wasser liegt, war die Versorgung mit Löschwasser zunächst schwierig.“"
                                            },
                                            {
                                                "example_id": "0569aead-234d-47ce-859f-44ec30fbc7dd",
                                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                                "text": "„Während der Löscharbeiten flossen große Mengen davon mit dem Löschwasser in den Rhein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
