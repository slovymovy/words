                "senses": [
                    {
                        "sense_id": "8721a0d5-2b92-3ac5-8cb1-308eee356048",
                        "entry_id": "5f03af9c-0c8d-3eb7-8abb-5f4616d78571",
                        "glosses": [
                            "Person, die sich gegen Kolonialismus wendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf08f76-2556-4ee6-b95a-9ddded93a97d",
                                "sense_id": "8721a0d5-2b92-3ac5-8cb1-308eee356048",
                                "text": "„In Deutschland gaben die langwierigen Feldzüge in Afrika den Kolonialismuskritikern Argumente.“"
                            },
                            {
                                "example_id": "abb4b127-6741-4a74-a403-ccc4c73a137f",
                                "sense_id": "8721a0d5-2b92-3ac5-8cb1-308eee356048",
                                "text": "„Direkten Einfluss auf die britische Kolonialpolitik hatte sie nicht; indirekt wird ihre Arbeit von Forschern jedoch auch als eine der Grundlagen für die späteren Aktivitäten von Kolonialismuskritikern wie Edmund Dene Morel gesehen, der Kingsley selbst als seine „Mentorin“ bezeichnete.“"
                            },
                            {
                                "example_id": "022cd47d-b183-44ca-a21c-70f3b2098afc",
                                "sense_id": "8721a0d5-2b92-3ac5-8cb1-308eee356048",
                                "text": "„Radikale Kolonialismuskritiker wie Frantz Fanon erklärten die universalen Werte des aufklärerischen Humanismus zu einem Mythos, der die fortgesetzte Herrschaft der weißen europäischen Kultur über die einstmals kolonisierten Völker festschreiben solle.“"
                            },
                            {
                                "example_id": "0abbb9dd-7d14-4932-8045-b0874a110b9a",
                                "sense_id": "8721a0d5-2b92-3ac5-8cb1-308eee356048",
                                "text": "„Zwischen den Gefängnis-Kapiteln entfaltet Vargas Llosa in biografischen Kapiteln Casements Entwicklung vom naiven Idealisten über den mutigen Kolonialismuskritiker bis zum militanten Freiheitskämpfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
