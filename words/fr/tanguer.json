    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4349702-3e28-3886-ac2e-87e7458d0318",
                    "sense_definition": "Osciller d'avant en arrière sous l'effet des vagues, en parlant d'un navire ou d'une embarcation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux navire <w>tanguait</w> fortement sous la violence de la tempête en pleine mer."
                        },
                        {
                            "text": "Dès que le bateau a commencé à <w>tanguer</w>, plusieurs passagers ont ressenti le mal de mer."
                        }
                    ],
                    "common_phrases": [
                        "tanguer et rouler"
                    ]
                },
                {
                    "sense_id": "26cf8e6d-b83d-39a7-81c9-ae3786fd4f26",
                    "sense_definition": "Vaciller sur ses jambes ou donner l'impression d'osciller, sous l'effet de l'ivresse ou du vertige.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir trop bu, il se mit à <w>tanguer</w> en essayant vainement de marcher droit."
                        },
                        {
                            "text": "Épuisée par une forte fièvre, elle sentit soudain toute la pièce <w>tanguer</w> autour d'elle."
                        }
                    ],
                    "synonyms": [
                        "chalouper"
                    ],
                    "common_phrases": [
                        "sentir le sol tanguer"
                    ]
                },
                {
                    "sense_id": "fa2c2531-6c63-388e-8a90-a766cccdd52c",
                    "sense_definition": "Être instable, menacer de s'effondrer ou traverser une crise grave.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'économie du pays commence à <w>tanguer</w> face à cette nouvelle crise financière imprévue."
                        },
                        {
                            "text": "Le gouvernement a <w>tangué</w> pendant plusieurs semaines avant de trouver un compromis solide."
                        }
                    ]
                },
                {
                    "sense_id": "8675788b-fb4e-36b5-9de2-e98aaae1da8e",
                    "sense_definition": "Danser le tango.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant les années folles, toute la jeunesse élégante <w>tanguait</w> dans les salons parisiens."
                        },
                        {
                            "text": "Dans ce bal rétro, quelques couples <w>tanguaient</w> avec passion sur un air d'accordéon."
                        }
                    ],
