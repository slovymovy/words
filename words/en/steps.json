    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d5a05d0-01b2-368e-90ac-a310e82644e8",
                    "sense_definition": "Plural of <w>step</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby took his first <w>steps</w> across the living room.",
                            "target_lang_translations": {
                                "ru": "Ребенок сделал свои первые <w>шаги</w> по гостиной.",
                                "zh": "婴儿在客厅里迈出了他人生的第一<w>步</w>。"
                            }
                        },
                        {
                            "text": "Please follow these <w>steps</w> to complete the installation.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выполните эти <w>шаги</w>, чтобы завершить установку.",
                                "zh": "请按照这些<w>步骤</w>完成安装。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова step (шаг, мера).",
                        "zh": "指走路时脚的动作，或指完成某事的一系列阶段、措施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаги",
                                "target_lang_sense_clarification": "движения ног при ходьбе или этапы процесса"
                            },
                            {
                                "target_lang_word": "меры",
                                "target_lang_sense_clarification": "действия, предпринимаемые для достижения цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚步",
                                "target_lang_sense_clarification": "走路时脚的动作"
                            },
                            {
                                "target_lang_word": "步骤",
                                "target_lang_sense_clarification": "完成某事的过程或阶段"
                            },
                            {
                                "target_lang_word": "措施",
                                "target_lang_sense_clarification": "为达到目的而采取的行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "245c6fe4-8c37-30c5-96bc-51d8f6ff32ba",
                    "sense_definition": "A flight of stairs, especially out of doors.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stairs_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ran up the front <w>steps</w> to unlock the door.",
                            "target_lang_translations": {
                                "ru": "Он взбежал по передним <w>ступенькам</w>, чтобы открыть дверь.",
                                "zh": "他跑上门前的<w>台阶</w>去开门。"
                            }
                        },
                        {
                            "text": "Be careful because the stone <w>steps</w> are slippery when wet.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, потому что каменные <w>ступеньки</w> скользкие, когда мокрые.",
                                "zh": "小心点，因为石<w>台阶</w>湿了以后很滑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stairs",
                        "staircase"
                    ],
                    "common_phrases": [
                        "front steps",
                        "stone steps",
                        "flight of steps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лестничный пролет, особенно снаружи здания; ступеньки.",
                        "zh": "指楼梯，尤指室外的台阶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступеньки",
                                "target_lang_sense_clarification": "элементы лестницы"
                            },
                            {
                                "target_lang_word": "лестница",
                                "target_lang_sense_clarification": "сооружение для подъема"
                            },
                            {
                                "target_lang_word": "крыльцо",
                                "target_lang_sense_clarification": "площадка перед входом в дом со ступеньками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "台阶",
                                "target_lang_sense_clarification": "楼梯的每一级或室外的阶梯"
                            },
                            {
                                "target_lang_word": "楼梯",
                                "target_lang_sense_clarification": "供人上下楼的建筑结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "878da21f-c1cf-39f9-8bf7-1223e68ae4c5",
                    "sense_definition": "A course followed by a person in walking or as a metaphor for life choices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to follow in her mother's <w>steps</w> and become a writer.",
                            "target_lang_translations": {
                                "ru": "Она решила пойти по <w>стопам</w> матери и стать писательницей.",
                                "zh": "她决定追随母亲的<w>足迹</w>，成为一名作家。"
                            }
                        },
                        {
                            "text": "We had to retrace our <w>steps</w> to find the path again.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось вернуться по своим <w>следам</w>, чтобы снова найти тропу.",
                                "zh": "我们不得不原路<w>返回</w>以重新找到路径。"
                            }
                        }
                    ],
                    "synonyms": [
                        "path",
                        "track"
                    ],
                    "common_phrases": [
                        "follow in someone's steps",
                        "retrace one's steps",
                        "dog someone's steps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путь, по которому идет человек, или метафора жизненного выбора (по стопам).",
                        "zh": "指人行走的路径，或比喻人生的选择和经历。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стопы",
                                "target_lang_sense_clarification": "в идиоме 'пойти по стопам'"
                            },
                            {
                                "target_lang_word": "следы",
                                "target_lang_sense_clarification": "отпечатки ног или пройденный путь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足迹",
                                "target_lang_sense_clarification": "走过的路或留下的痕迹"
                            },
                            {
                                "target_lang_word": "后尘",
                                "target_lang_sense_clarification": "比喻前人的道路或经历"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd33d3c7-18ec-3c0c-bb68-3a74c2ec1e78",
                    "sense_definition": "A stepladder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stairs_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need the <w>steps</w> to reach the top shelf in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Мне нужна <w>стремянка</w>, чтобы достать до верхней полки на кухне.",
                                "zh": "我需要<w>梯子</w>才能拿到厨房顶层的架子。"
                            }
                        },
                        {
                            "text": "The painter folded the <w>steps</w> and put them back in the van.",
                            "target_lang_translations": {
                                "ru": "Маляр сложил <w>стремянку</w> и положил её обратно в фургон.",
                                "zh": "油漆工把<w>梯子</w>折叠起来放回了货车里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stepladder",
                        "ladder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремянка (раскладная лестница).",
                        "zh": "指可折叠的便携式梯子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремянка",
                                "target_lang_sense_clarification": "переносная лестница"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梯子",
                                "target_lang_sense_clarification": "登高的工具"
                            },
                            {
                                "target_lang_word": "人字梯",
                                "target_lang_sense_clarification": "一种常见的折叠式梯子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "853cf60d-cb5b-30c6-b7bc-c29fff38fefa",
                    "sense_definition": "Third-person singular simple present indicative of <w>step</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>steps</w> carefully over the puddle on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>переступает</w> через лужу на тротуаре.",
                                "zh": "她小心翼翼地<w>跨过</w>人行道上的水坑。"
                            }
                        },
                        {
                            "text": "He <w>steps</w> forward to accept the award from the principal.",
                            "target_lang_translations": {
                                "ru": "Он <w>шагает</w> вперед, чтобы принять награду от директора.",
                                "zh": "他向前<w>迈步</w>，从校长手中接过奖项。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола step (шагать, ступать) в 3-м лице единственного числа.",
                        "zh": "动词 step 的第三人称单数形式，意为行走或迈步。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шагает",
                                "target_lang_sense_clarification": "делает шаги"
                            },
                            {
                                "target_lang_word": "ступает",
                                "target_lang_sense_clarification": "становится ногой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迈步",
                                "target_lang_sense_clarification": "跨出脚步"
                            },
                            {
                                "target_lang_word": "跨过",
                                "target_lang_sense_clarification": "从某物上方迈过去"
                            }
                        ]
                    }
                }
            ]
        }
