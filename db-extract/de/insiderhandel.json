                "senses": [
                    {
                        "sense_id": "0f592ffe-9b2a-302d-a254-2fde396b8d36",
                        "entry_id": "6ec02c4b-e041-3dff-9828-9bc3d5400ed9",
                        "glosses": [
                            "Verwendung von Insiderinformationen für Börsengeschäfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6275eddb-0ff9-4435-aea3-efa8b3ebd57d",
                                "sense_id": "0f592ffe-9b2a-302d-a254-2fde396b8d36",
                                "text": "„Ward zählte die Beweis für den Insiderhandel auf, ohne dabei zu sagen, wie sie an die jeweiligen Informationen geraten waren.“"
                            },
                            {
                                "example_id": "2ee5c82f-1a43-4741-a16b-a792b651c2b3",
                                "sense_id": "0f592ffe-9b2a-302d-a254-2fde396b8d36",
                                "text": "„Er war noch nie im Gefängnis gewesen - jedenfalls nicht zur Verbüßung einer Haftstrafe; Festnahmen hatte er durchaus ein paar erlebt -, aber so stellte er sich die Zellen einer Anstalt der niedersten Sicherheitsstufe vor, zum Beispiel für Scheckbetrüger oder Leute, die beim Insiderhandel im unteren siebenstelligen Bereich erwischt worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39a5ce53-7091-4bef-9992-7ac0860a21d4",
                        "source_entry_id": "6ec02c4b-e041-3dff-9828-9bc3d5400ed9",
                        "source_sense_id": "0f592ffe-9b2a-302d-a254-2fde396b8d36",
                        "source_sense_description": "Börsengeschäfte mit Insiderinformationen",
                        "target_lang_word": "內線交易",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "內線交易",
