                        "examples": [
                            {
                                "example_id": "ab2cf6fc-2738-4b30-b694-b57cd126d16b",
                                "sense_id": "65553670-227a-3155-9adf-c76e957340ee",
                                "text": "The delicate stringings, or wheeled quillings, also, round the necks of the roemers and berkemeyers are not less noteworthy than the stringings or spinnings―naturally never quilled―of their bases or footings."
                            },
                            {
                                "example_id": "bacd2613-654e-4f73-8da2-deec321b3744",
                                "sense_id": "65553670-227a-3155-9adf-c76e957340ee",
                                "text": "Here the pipe and roemer glass obviously indicate taste and smell, and equally obviously, the transience of sensual pleasures."
                            },
                            {
                                "example_id": "2d5cf8ee-4d16-4ca0-9a9f-1310227c1ff3",
                                "sense_id": "65553670-227a-3155-9adf-c76e957340ee",
                                "text": "When I first saw complete roemers (often pronounced 'rummer', the name comes from the Dutch for making a toast, roemen) in the auction house where I was working, I knew their appeal went far beyond dedicated collectors."
                            }
                        ]
                    }
