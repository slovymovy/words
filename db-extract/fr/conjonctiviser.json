                "senses": [
                    {
                        "sense_id": "4f8d333b-4de5-3f73-a208-6e90b7650965",
                        "entry_id": "6a1a14cc-f04a-34c4-b1b4-eea972d02694",
                        "glosses": [
                            "Être atteint de conjonctivite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e652ed8-05cf-4f9f-adeb-9e2789cf78dc",
                                "sense_id": "4f8d333b-4de5-3f73-a208-6e90b7650965",
                                "text": "C’est simple, j’ai tellement été éblouie que je conjonctivisais dès le lendemain matin…"
                            },
                            {
                                "example_id": "876fd91c-258d-4e01-b430-f7e242cb3788",
                                "sense_id": "4f8d333b-4de5-3f73-a208-6e90b7650965",
                                "text": "le tout sans irriter mes nonoeils clairs qui conjonctivisent bcp [beaucoup] !"
                            },
                            {
                                "example_id": "fc5ce043-71f9-41b0-a43a-74bedc787a01",
                                "sense_id": "4f8d333b-4de5-3f73-a208-6e90b7650965",
                                "text": "J’ai les oreilles qui s’ensablent, les yeux qui s’conjonctivisent et les dents qui deviennent grises…"
                            },
                            {
                                "example_id": "286987fe-636f-4443-a794-2a6cc2dbb8ca",
                                "sense_id": "4f8d333b-4de5-3f73-a208-6e90b7650965",
                                "text": "Coincé dans une ride grasse et poilu ^([sic : poilue]), nageant dans les larmes de l’oeil ^([sic : œil]) conjonctivisé d’un éléphant cyclope, tel un moucheron gouverné par la surdité de son autisme latent d’enfant-adulte."
                            }
                        ]
                    }
