                ],
                "senses": [
                    {
                        "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                        "entry_id": "e526c3b2-f66e-3983-998e-74d68782a2cf",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4dcb94a-58df-4b9d-ae47-168c8ba12eac",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Frau Neudecker ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "97e7a2e2-2aa0-4672-8b99-4a7dd048fdd7",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Herr Neudecker wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "de968424-7308-4f66-aee5-4db400a99609",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Die Neudeckers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "dd9773b3-f240-47dc-b613-b56e0a8ccf6d",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Der Neudecker trägt nie die Schals, die die Neudecker ihm strickt."
                            },
                            {
                                "example_id": "f9516bfa-e5e6-433e-90ac-f2fd31ae8e18",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neudecker kommt, geht der Herr Neudecker.“"
                            },
                            {
                                "example_id": "0a43b1a9-824c-4472-a55c-534165d4c7aa",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Neudecker kommt und geht."
                            },
                            {
                                "example_id": "5ca226cc-eda1-4a47-a889-b586fd306553",
                                "sense_id": "a4076a6a-a397-3cf0-90e7-1f9052bff2bc",
                                "text": "Neudeckers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
