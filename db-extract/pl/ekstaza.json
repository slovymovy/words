                        ],
                        "examples": [
                            {
                                "example_id": "9f987258-f232-4faa-b103-d7803a5957e0",
                                "sense_id": "9ad7e100-7055-396c-82ec-1c0300924aa3",
                                "text": "Szaleje straszliwa burza wiosenna.[…]Doznaje się zwierzęcej radości wpatrując się, wsłuchując, wcielając w tę namiętną ekstazę natury.",
                                "translation": "A terrible spring storm is raging. […] One experiences animalistic joy gazing, listening, taking in this passionate ecstasy of nature.",
                                "english": "A terrible spring storm is raging. […] One experiences animalistic joy gazing, listening, taking in this passionate ecstasy of nature."
                            }
                        ]
