                    {
                        "sense_id": "29c2d763-5c92-32f4-8b98-42eb16fccee4",
                        "entry_id": "8b37d2b9-862c-3515-9305-56fb3c597575",
                        "glosses": [
                            "Jurist, der sich mit dem Völkerrecht beschäftigt, auf das Völkerrecht als Fachgebiet spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2a1da7-faae-4f28-b169-eb82aff812b4",
                                "sense_id": "29c2d763-5c92-32f4-8b98-42eb16fccee4",
                                "text": "„Der Konflikt schien sich mal als Auseinandersetzung zwischen Bauern und Schäfern, mal als Streit zwischen Völkerrechtlern abzuspielen.“"
                            },
                            {
                                "example_id": "858ba69a-d772-45bc-9506-31507f3ce77d",
                                "sense_id": "29c2d763-5c92-32f4-8b98-42eb16fccee4",
                                "text": "„Ihr ganzen Völkerrechtler seid Idioten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
