                            {
                                "example_id": "d27a18bf-9d07-4bf9-a94f-742d068a8b11",
                                "sense_id": "8e2226d7-499a-315c-b9d3-d81d3bf992df",
                                "text": "Tovenaresje, zeg mij welke macht Mij naar het snarenspel heeft teruggedreven; Hoe vurig vlamt in 't hart de liefdeskracht,0, welk een hartstocht doet mijn vingers beven! zong hij met hartstochtelijke stem, zijn fonkelende gitzwarte ogen op de verschrikte maar gelukkige Natasja gericht."
                            },
                            {
                                "example_id": "7aa7d672-4962-408f-8bb3-6e96df43b746",
                                "sense_id": "8e2226d7-499a-315c-b9d3-d81d3bf992df",
                                "text": "Haar pure stem en spel gaan kopje onder in een brouwsel van elektrisch snarenspel, pseudovolksmuziek, samples en hopeloos sentimenteel gedoe. Secret love heet de cd. Dat geeft zeer te denken."
                            }
                        ]
