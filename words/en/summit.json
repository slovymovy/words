                        {
                            "text": "I met a woman named Sarah <w>Summit</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил женщину по имени Сара <w>Саммит</w> на конференции.",
                                "tr": "Konferansta Sarah <w>Summit</w> adında bir kadınla tanıştım."
