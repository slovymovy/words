                                    {
                                        "sense_id": "cfccb1f7-8a44-3297-843e-f3c5031ccd74",
                                        "entry_id": "e2a4e89b-9eeb-32de-a2c5-42f847e6ff4c",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 53, das zur Gruppe der Halogene gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "168b8d4a-a5ec-4ac6-8cd0-1b258448d1e7",
                                                "sense_id": "cfccb1f7-8a44-3297-843e-f3c5031ccd74",
                                                "text": "Jod ist ein für den Menschen lebensnotwendiges Spurenelement."
                                            },
                                            {
                                                "example_id": "6348f7e0-979a-4db7-9c49-f3e8027bae88",
                                                "sense_id": "cfccb1f7-8a44-3297-843e-f3c5031ccd74",
                                                "text": "„Ich glaube, ich roch die Klippen und den Tang und das Schäumen der Wellen, die Schärfe des Jods und den darunterliegenden Geruch von ausgewaschenen und zerbrochenen Kalkmuscheln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70f77acc-8530-38bf-a3e7-68dd3c395124",
                                        "entry_id": "e2a4e89b-9eeb-32de-a2c5-42f847e6ff4c",
                                        "glosses": [
                                            "Tinktur zum Desinfizieren von Wunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a8f1de-ba32-405e-a856-2f587a7cd212",
                                                "sense_id": "70f77acc-8530-38bf-a3e7-68dd3c395124",
                                                "text": "Die Wundbehandlung mit Jod brennt gewaltig."
                                            },
                                            {
                                                "example_id": "ace3b0f2-1531-4204-8b1a-bba29ae8d465",
                                                "sense_id": "70f77acc-8530-38bf-a3e7-68dd3c395124",
                                                "text": "„Nein, ich habe das selbst mit Jod behandelt und Analgien habe ich gegen die Schmerzen eingenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
