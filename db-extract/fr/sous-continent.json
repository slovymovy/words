                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f79a04a-c44d-4243-bd85-ef6e9e3156ea",
                        "entry_id": "d563a53e-667a-3d5a-93ab-c1439358a145",
                        "tags": [
                            "plural"
                        ],
                        "form": "sous-continents"
                    },
                    {
                        "form_id": "c966c55b-918e-45f3-a020-ccb717cbeb11",
                        "entry_id": "d563a53e-667a-3d5a-93ab-c1439358a145",
                        "tags": [],
                        "form": "subcontinent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                        "entry_id": "d563a53e-667a-3d5a-93ab-c1439358a145",
                        "glosses": [
                            "Division d’un continent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec24605-16fb-40e9-9525-c8ee4ee48ccf",
                                "sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                                "text": "Que d'épreuves a dû surmonter le régime, après tant d'années de guerres civiles ou étrangères et de fléaux naturels, pour donner à ce sous-continent les moyens de nourrir une population foisonnante, de la vêtir, de la loger, de l'instruire – de la contenir !"
                            },
                            {
                                "example_id": "90ce05fe-372a-476b-af00-d66f5487fb5f",
                                "sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                                "text": "Il a exploré le sous-continent et rencontré son principal souverain : le Grand Moghol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc7e66b0-50af-4e60-b2b1-a257858e64d3",
                        "source_entry_id": "d563a53e-667a-3d5a-93ab-c1439358a145",
                        "source_sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                        "source_sense_description": "Division d’un continent",
                        "target_lang_word": "Subkontinent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Subkontinent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                        "entry_id": "cf10b2ff-72f7-3f62-936b-127de4e3cae7",
                                        "glosses": [
                                            "großflächiger Teil eines Kontinents, der wegen seiner Ausmaße eine gewisse Eigenständigkeit besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f25100-2e7e-417a-a8d9-f037abdaef66",
                                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                                "text": "„Als die Charta der Company 1813 erneuert wurde, erlaubte London auch christlichen Missionaren den Zugang zum Subkontinent.“"
                                            },
                                            {
                                                "example_id": "a7ccbd7b-3b4c-480f-b3df-9004a66e7507",
                                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                                "text": "„Als Indischer Subkontinent wird die Landmasse südlich des Himalayas bezeichnet, auf der die Staaten Bangladesch, Bhutan, Indien, Nepal, Pakistan und Sri Lanka liegen, die wiederum einen Teil von Südasien bilden.“"
                                            },
                                            {
                                                "example_id": "ccb86a4b-9530-4abf-b13c-8d9cb0460c83",
                                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                                "text": "„1947 wurde der Subkontinent geteilt, Millionen Muslime flohen nach Pakistan.“"
                                            },
                                            {
                                                "example_id": "ee1601ba-4cce-4657-abbe-6f6d61326f4c",
                                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                                "text": "„Ziel der Fächerkooperation war die Vermittlung eines möglichst anschaulichen geschlossenen Mosaikbildes des Subkontinents mit seiner Landschaft, seiner Vegetation, seinen Tieren und Menschen, ihren Lebensbedingungen, Lebensgewohnheiten und geistigen Vorstellungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9407ad99-0002-4222-a854-a2f242141b37",
                        "source_entry_id": "d563a53e-667a-3d5a-93ab-c1439358a145",
                        "source_sense_id": "b2169562-2d06-3fd2-ad79-f667bd7e3c77",
                        "source_sense_description": "Division d’un continent",
                        "target_lang_word": "subcontinent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subcontinent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7564956-9c09-34c8-9297-656d9888e869",
                                        "entry_id": "c671bf77-8d7e-3c5f-bb21-c0852b807883",
                                        "glosses": [
                                            "A large landmass which is either smaller than a continent (such as Greenland), or part of an even larger continent (such as the Indian subcontinent)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "subcontinent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                        "entry_id": "88c857e7-d3e1-3eb6-b7dc-ea685c2c4eb9",
                                        "glosses": [
                                            "The Indian subcontinent, South Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e75abd-2604-46c3-aa37-427a8710b0ce",
                                                "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                                "text": "The Turks had acquired the culture of power of Persia and implemented its political and administrative traditions in the subcontinent."
                                            },
                                            {
                                                "example_id": "f98c024f-9818-4914-bcec-2667b1ed9313",
                                                "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                                "text": "The terrorist attack on the Sri Lanka team in Lahore could lead to Dubai and Abu Dhabi becoming the \"home\" venues for the subcontinent’s cricket-playing countries for the forseeable future, according to leading officials in England and worldwide."
                                            },
                                            {
                                                "example_id": "18438962-aeb6-42d7-8842-cc3ca35b4556",
                                                "sense_id": "5a63c64b-c375-345d-bc49-a4cce133c1d9",
                                                "text": "Highlights include a debate on east London architecture, quirky performances staged at the Barbican, music and dance from the subcontinent, and the East Commonwealth Games in Spitalfields Market, with events ranging from bicycle polo to kabaddi (a cross between tag and wrestling)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
