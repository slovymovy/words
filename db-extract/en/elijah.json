                                            {
                                                "example_id": "e7404511-5575-4cda-a4e8-0fe640458b08",
                                                "sense_id": "411171f7-59cd-3202-8eaf-ead823d015e9",
                                                "text": "Mademoiselle, ce carrosse sera pour vous le chariot d’Élie ; il vous mènera droit au ciel."
                                            },
                                            {
                                                "example_id": "310e88ea-b21f-4579-882c-8887c4b9ad87",
