                    {
                        "translation_id": "34f8b6ce-3ca3-40f3-986c-ca7b14a59af2",
                        "source_entry_id": "b75e4d0f-7ee4-3226-87c7-7bd4cae31b80",
                        "source_sense_id": "9f9dfab7-7e38-35af-965a-a281681286e7",
                        "target_lang_word": "Höhlenforscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höhlenforscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                                        "entry_id": "cc3806c0-edaa-3a3a-985d-31c632861678",
                                        "glosses": [
                                            "Wissenschaftler, der Höhlen erforscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50a531c-6ef5-4258-886c-19f14efbba68",
                                                "sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                                                "text": "„Insgesamt waren am Dienstag sieben erfahrene Höhlenforscher zum Kartografieren in die Grotte von Romy nahe der spanischen Grenze abgestiegen.“"
                                            },
                                            {
                                                "example_id": "823fa4f5-0dcd-4ed5-adf6-ea4c23eae0fa",
                                                "sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                                                "text": "Am Donnerstagmittag konnten Retter die Trage mit dem schwer verletzten Höhlenforscher an den Ausgang der Riesending-Schachthöhle im Berchtesgadener Land bringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "705f4901-282d-48cd-8979-378dc43dbad7",
                        "source_entry_id": "b75e4d0f-7ee4-3226-87c7-7bd4cae31b80",
                        "source_sense_id": "9f9dfab7-7e38-35af-965a-a281681286e7",
                        "target_lang_word": "Speläologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speläologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd33674-0d00-30c0-88e1-a34cf3b42f3f",
                                        "entry_id": "6fa67446-b8ef-346a-8970-907751621523",
                                        "glosses": [
                                            "Wissenschaftler, der Höhlen erforscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27331ae0-fdc4-45eb-b124-6e16650e7973",
                                                "sense_id": "fbd33674-0d00-30c0-88e1-a34cf3b42f3f",
                                                "text": "„Während der Saison bietet ein Speläologe eine Schlauchbootfahrt in die dritte Grotte an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17204e94-ee87-4752-9085-c7d95a083254",
                        "source_entry_id": "b75e4d0f-7ee4-3226-87c7-7bd4cae31b80",
                        "source_sense_id": "9f9dfab7-7e38-35af-965a-a281681286e7",
                        "target_lang_word": "speleoloog",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speleoloog",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7ffef27f-c892-3b1e-a94e-75ad0cde3888",
                                        "entry_id": "fe5c17ee-2375-3a82-be97-a15ca1cb6578",
                                        "glosses": [
                                            "een onderzoeker van grotten en holen, kenner van de speleologie"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee59e39-3194-407b-a107-7ab5388307c5",
                                                "sense_id": "7ffef27f-c892-3b1e-a94e-75ad0cde3888",
                                                "text": "In de duisternis, nauwelijks in staat een rilling te onderdrukken, kruipt Hideki achter Toru aan door wat op een onderaardse gang lijkt. Hij kan niet begrijpen hoe hij hier terecht is gekomen, het enige wat hij wil is met de trein naar huis. Als een verdwaalde speleoloog die zich richt op een sprankje ver daglicht volgt hij het dansende vlammetje van Toru's aansteker."
                                            },
                                            {
                                                "example_id": "9d8ff416-20b9-4bda-9298-668f843634a4",
                                                "sense_id": "7ffef27f-c892-3b1e-a94e-75ad0cde3888",
                                                "text": "Sharon glimlacht. 'En jij ziet zo bleek als het achterste van een speleoloog."
                                            },
                                            {
                                                "example_id": "64278dce-9575-4830-99f6-468c9199d73b",
                                                "sense_id": "7ffef27f-c892-3b1e-a94e-75ad0cde3888",
                                                "text": "De onderzoekers hopen hun nieuwe inzicht te kunnen gebruiken bij het ontwerpen van betere viool- en gitaarsnaren, touwladders en hefkabels voor reddingshelikopters, abseil-touwen voor bergbeklimmers en speleologen, lijnen voor parachutes. En verhuizers zouden het ook leuk vinden als die piano onderweg naar boven niet begint te draaien."
                                            },
                                            {
                                                "example_id": "8960d009-05ce-4e25-9eff-ee2a6ca46ecd",
                                                "sense_id": "7ffef27f-c892-3b1e-a94e-75ad0cde3888",
                                                "text": "Vorig jaar zat elders in Duitsland een speleoloog lang vast in een grot. De onderzoeker liep op een kilometer diepte ernstig hoofdletsel op door een vallende rots, en werd pas na elf dagen bevrijd door reddingswerkers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f592fc6-85e0-4b87-acfb-236ba43bae4c",
                        "source_entry_id": "b75e4d0f-7ee4-3226-87c7-7bd4cae31b80",
                        "source_sense_id": "9f9dfab7-7e38-35af-965a-a281681286e7",
                        "target_lang_word": "speleolog",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speleolog",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf195a2-9660-34f3-b514-5e193379af14",
                                        "entry_id": "2cbf56de-ca29-35ff-a982-94f3f31b65d7",
                                        "glosses": [
                                            "naukowiec zajmujący się speleologią"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "259f2b0f-e3eb-4f0a-a97e-36d74cb713ae",
                                                "sense_id": "bdf195a2-9660-34f3-b514-5e193379af14",
                                                "text": "Wraz z innymi speleologami odkrył kilka jaskiń w Andach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5ec5d32a-9edc-34c2-940f-f8096fbb899f",
                                        "entry_id": "2cbf56de-ca29-35ff-a982-94f3f31b65d7",
                                        "glosses": [
                                            "osoba eksplorująca jaskinie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1951af0-439e-4a2a-9552-c842bc3f7bad",
                                                "sense_id": "5ec5d32a-9edc-34c2-940f-f8096fbb899f",
                                                "text": "W jej sklepie, oprócz alpinistów, zaopatrują się też speleolodzy amatorzy i w ogóle ambitniejsi turyści górscy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6f51324-a6bf-48b1-97d3-133d8a41a732",
                        "source_entry_id": "b75e4d0f-7ee4-3226-87c7-7bd4cae31b80",
                        "source_sense_id": "9f9dfab7-7e38-35af-965a-a281681286e7",
                        "target_lang_word": "spéléologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spéléologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc0b79d-87e2-3435-ad77-01732206c5c9",
                                        "entry_id": "8b348789-d943-3abd-95a0-1763b6c2bd70",
                                        "glosses": [
                                            "Synonyme de spéléologue."
                                        ],
                                        "tags": [
                                            "Spéléologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58cb7bbe-c5de-4b9d-819e-2e8ee74382e8",
                                                "sense_id": "1fc0b79d-87e2-3435-ad77-01732206c5c9",
                                                "text": "Pour désigner la science des gouffres, nos dictionnaires ne connaissent que le mot spéléologie, et les savants qui la pratiquent s’appellent spéléologues, terme déclaré par le Larousse du xxᵉ siècle préférable à spéléologiste, dont l’existence est attestée, mais l’usage peu fréquent."
                                            },
                                            {
                                                "example_id": "f818afcc-135f-4065-bffe-3018b36fdbda",
                                                "sense_id": "1fc0b79d-87e2-3435-ad77-01732206c5c9",
                                                "text": "À cela il faut également ajouter que certaines grottes ont été visitées de façon systématique par nos collègues spéléologistes, qui ont ainsi eu lʼoccasion dʼy faire de nombreuses captures de cet Opilion."
                                            }
                                        ]
                                    }
                                ]
