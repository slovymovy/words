                },
                {
                    "sense_id": "32633af5-0b9f-38e8-ab6e-b9893ab730e6",
                    "sense_definition": "op een zorgzame en liefdevolle manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zorgzaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moeder legde de deken <w>voorzichtig</w> over haar slapende kind.",
                            "target_lang_translations": {
                                "en": "The mother <w>gently</w> placed the blanket over her sleeping child.",
                                "ru": "Мать <w>бережно</w> накрыла одеялом своего спящего ребенка."
                            }
                        },
                        {
                            "text": "Hij tilde de gewonde vogel <w>voorzichtig</w> op om hem naar de opvang te brengen.",
                            "target_lang_translations": {
                                "en": "He <w>carefully</w> picked up the injured bird to take it to the shelter.",
                                "ru": "Он <w>осторожно</w> поднял раненую птицу, чтобы отнести ее в приют."
                            }
                        }
                    ],
                    "antonyms": [
                        "onvoorzichtig"
                    ],
                    "common_phrases": [
                        "voorzichtig omgaan met"
                    ],
                    "target_lang_definitions": {
                        "en": "in a caring and loving manner",
                        "ru": "заботливым и нежным образом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gently",
                                "target_lang_sense_clarification": "with a soft and tender touch"
                            },
                            {
                                "target_lang_word": "carefully",
                                "target_lang_sense_clarification": "with great care and precision"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бережно",
                                "target_lang_sense_clarification": "с мягкостью и нежностью"
                            },
                            {
                                "target_lang_word": "аккуратно",
