                                                "sense_id": "d15c6a7e-6688-3f24-827d-9d0b9f13f017",
                                                "text": "Les aventures de Tintin sont une BD."
                                            },
                                            {
                                                "example_id": "6ef13bac-f36e-409d-b92e-18e2833985f8",
                                                "sense_id": "d15c6a7e-6688-3f24-827d-9d0b9f13f017",
