                ],
                "senses": [
                    {
                        "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                        "entry_id": "02b446c4-b4bb-3d95-a304-7d6c0ed4a0c4",
                        "glosses": [
                            "Naht, die durch das Heften, also dem losen oder provisorischen Zusammenfügen von Stoffteilen, entsteht"
                        ],
                        "tags": [
                            "Schneidern"
                        ],
                        "examples": [
                            {
                                "example_id": "bbe3811e-7183-418c-8d7c-951e37a27826",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "„Die Heftnaht ist eine provisorische Naht, mit der zwei Stoffteile verbunden werden.“"
                            },
                            {
                                "example_id": "c403f496-b447-4248-b53f-f55a99dd958a",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "„Nähen Sie eine Heftnaht von Hand oder mit der Nähmaschine auf beiden Seiten der Schnittlinie.“"
                            },
                            {
                                "example_id": "1b1a2937-d563-4226-bd1a-c625634373dd",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "„Stellen Sie die maximale Stichlänge ein und nähen Sie rechts und links von der Nahtlinie eine Heftnaht.“"
                            },
                            {
                                "example_id": "1533fa04-bfcf-4239-a8fa-01301f4fc721",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "„Nähen Sie die zweite Heftnaht parallel zur ersten.“"
                            },
                            {
                                "example_id": "5484242f-ea43-4556-83a0-5548eb6d7f4f",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "„Eine Heftnaht hält das Ganze vorübergehend an Ort und Stelle.“"
                            },
                            {
                                "example_id": "07353355-1dc6-489e-b340-650c002801e9",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "„Klappe die Stoffteile auseinander und lege den Reißverschluss auf die Heftnaht. Der Schieber liegt dabei auf dem Stoff und endet außerhalb der Heftnaht.“"
                            },
                            {
                                "example_id": "5fd57243-9986-4b4a-9c66-8048ac903319",
                                "sense_id": "2d9525d5-0bef-36f9-bdcf-e9fe4f2c8984",
                                "text": "[Zuletzt müssen sie] „noch die Fäden versäubern und die Heftnaht entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
