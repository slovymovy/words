                                    },
                                    {
                                        "sense_id": "1af143da-5046-3255-94dc-51b68b71000a",
                                        "entry_id": "16df5b3a-55f3-3ee5-9225-a25799a4df6f",
                                        "glosses": [
                                            "Especialista, entendido en objetos antiguos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f833cd3-88e8-44a1-8f0a-29a2d32ad326",
                                                "sense_id": "1af143da-5046-3255-94dc-51b68b71000a",
                                                "text": "¿Quién más podría ser incitado a no ser nosotros, quienes nos sentamos aquí y quizás opinamos aún que la lección sobre Heráclito pone en escena una huida a la “historia del espíritu” y a los anticuarios del pensar?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e76fd7b8-e575-37d6-92a9-dd03c07dc7fd",
                                        "entry_id": "16df5b3a-55f3-3ee5-9225-a25799a4df6f",
                                        "glosses": [
                                            "Tienda, comercio de objetos antiguos o antigüedades."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "anticuario",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2876dad4-b994-3eee-9063-ae68005d559c",
                                        "entry_id": "59803889-61fe-3f8d-ae91-3a209ab9ddab",
                                        "glosses": [
                                            "Propio o relativo a las antigüedades y objetos antiguos."
                                        ],
                                        "tags": [],
