                        "source_sense_id": "afa5f44d-099d-3e43-a8fa-e275370bd87a",
                        "target_lang_word": "life-giving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life-giving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c23cc3b-6bee-35f9-8824-a2802f29eb92",
                                        "entry_id": "917899f2-84c7-33ec-8087-a0d201d47306",
                                        "glosses": [
                                            "Necessary for life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c58061c-cbd9-4594-b148-452abbf49baf",
                                                "sense_id": "2c23cc3b-6bee-35f9-8824-a2802f29eb92",
                                                "text": "We would have died without the unexpected rain that brought life-giving water."
                                            },
                                            {
                                                "example_id": "3df21867-6b3a-4d10-bdc9-88d53b4b56a8",
                                                "sense_id": "2c23cc3b-6bee-35f9-8824-a2802f29eb92",
                                                "text": "The FDA has \"blood on its hands\" in its devastatingly slow release of potentially life-giving drugs to people surviving with AIDS and ARC."
                                            },
                                            {
                                                "example_id": "b55a419c-dfb7-4e3a-b75b-6f232f501f19",
                                                "sense_id": "2c23cc3b-6bee-35f9-8824-a2802f29eb92",
                                                "text": "Her days were taken up with the life-giving, hard, unrecompensed work of women of all ages to feed, clothe and nurture her household."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df87de8c-417b-3848-828d-1e6e9fc4501c",
                                        "entry_id": "917899f2-84c7-33ec-8087-a0d201d47306",
                                        "glosses": [
                                            "Creating or engendering life; being a source of life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "life-giving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff6dfcb-a1f9-3b59-9184-16a28b483e84",
                                        "entry_id": "9bb16e25-029b-3ee5-933e-bf5b366a72c3",
                                        "glosses": [
                                            "The act of giving life, of creating beings or fostering their survival."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0fac036-32e6-4dfa-b44b-20f231791195",
                                                "sense_id": "8ff6dfcb-a1f9-3b59-9184-16a28b483e84",
                                                "text": "The systematic, violent overthrow of an ethos of lifegiving by one that placed higher value on the taking of life culminated in the destruction of the Minoan civilization of Crete some four millenia ^([sic]) later."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd59e122-836a-4cbc-a1fb-5e0be9beb4da",
                        "source_entry_id": "c7577af1-495f-31aa-b2cc-bf64ece24840",
