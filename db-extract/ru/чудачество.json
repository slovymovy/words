                            "prepositional"
                        ],
                        "form": "чуда́честве"
                    },
                    {
                        "form_id": "3a3d80d4-72a0-4dcb-8c9c-66f7653d2cd4",
                        "entry_id": "293cdedc-68b9-3091-b4a6-b65fcc03f16d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "чуда́чествах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fe392b9-5ce0-3509-a7fe-4987af3b374d",
                        "entry_id": "293cdedc-68b9-3091-b4a6-b65fcc03f16d",
                        "glosses": [
                            "странность, необычность в поступках, в поведении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9d92be2-b999-42d6-b35a-216be24a192f",
                                "sense_id": "8fe392b9-5ce0-3509-a7fe-4987af3b374d",
                                "text": "— Речь идёт о наследстве, которое оставил Митеньке знаменитый своим чудачеством […] князь Огинский."
                            }
                        ]
                    },
                    {
                        "sense_id": "d715cf77-147b-35d6-85a2-e4781d2c4d4d",
                        "entry_id": "293cdedc-68b9-3091-b4a6-b65fcc03f16d",
                        "glosses": [
                            "чудаческий поступок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff4fa22-4800-45a0-9c01-b9bd04d2db2b",
                                "sense_id": "d715cf77-147b-35d6-85a2-e4781d2c4d4d",
                                "text": "Парнишка, перестав смеяться, смотрел на него с серьёзным и радостным изумлением, как будто ждал от него ещё самых неожиданных чудачеств."
                            },
                            {
                                "example_id": "c793e775-d963-49ff-8bc1-c27ea7525804",
                                "sense_id": "d715cf77-147b-35d6-85a2-e4781d2c4d4d",
                                "text": "[Генерал] обпушился на борейко. — Пора прекратить ваши чудачества, поручик! Каждый день день ко мне со всех сторон поступают жалобы на вас."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e10d9452-65bd-428f-a6d0-bd252cafac05",
                        "source_entry_id": "293cdedc-68b9-3091-b4a6-b65fcc03f16d",
                        "target_lang_word": "bizarrerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bizarrerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                        "entry_id": "f6e2c53a-e471-3011-bb0b-576b371b196c",
                                        "glosses": [
                                            "Caractère de ce qui est bizarre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb39877-cf22-4c0b-8573-e84230cc7f5d",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "Cette bizarrerie même de m'avoir envoyé une jolie fille pour me consoler, j'aurais parié qu'elle venait de son invention, et que c'était un effet de sa compassion pour mes peines."
                                            },
                                            {
                                                "example_id": "d3173faf-709a-486c-8ac5-f09319c678cf",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "Gardez-vous donc bien d’imiter le vulgaire, qui met la Fortune au nombre des dieux ; la bizarrerie de sa conduite l’éloigne entièrement du caractère de la divinité […]"
                                            },
                                            {
                                                "example_id": "ff31e0c9-ed89-4d30-a12a-d2ab5c7a58da",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "Petites plantes annuelles, herbacées, voisines des Luzernes (Medicago), que l’on sème sur place terreautée, et que l’on cultive pour la bizarrerie de leurs fruits, qui sont hérissés, écailleux, sillonnés, et imitent parfaitement une chenille, quelquefois un limaçon ou un ver."
                                            },
                                            {
                                                "example_id": "0c933025-2905-470f-bd4c-546ebefd2b02",
                                                "sense_id": "aa3fd05f-b82a-3e66-b21d-d836903071cc",
                                                "text": "[…] et, par une bizarrerie quelquefois observée, le météore était paré de toutes les couleurs du prisme, entre lesquelles le rouge s’accusait plus nettement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be83d175-ef31-337b-af2a-322247018319",
                                        "entry_id": "f6e2c53a-e471-3011-bb0b-576b371b196c",
                                        "glosses": [
                                            "Chose bizarre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b4b1b1-f342-4557-9344-967ee3fa5144",
                                                "sense_id": "be83d175-ef31-337b-af2a-322247018319",
                                                "text": "Beaucoup de ces tournures, et particulièrement les idiotismes de figures, constituent des bizarreries dans la langue même qui les a enfantées ; […]."
                                            },
                                            {
                                                "example_id": "87f33b2c-303e-423f-8bff-3cfb3abdcd10",
                                                "sense_id": "be83d175-ef31-337b-af2a-322247018319",
                                                "text": "La bizarrerie administrative dont elle est victime, Othe s'en accommode depuis fort longtemps. Pensez donc ! Depuis 1790 (création des départements) qu'elle vit avec son statut d'enclave meurthe-et-mosellane en territoire meusien, elle s’est fait une raison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b1dfae-370d-3495-80c9-454a7d7bb5b1",
                                        "entry_id": "f6e2c53a-e471-3011-bb0b-576b371b196c",
                                        "glosses": [
                                            "Humeur bizarre ; extravagance."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ebd02b-dc32-4ab1-987c-880aa061ac9d",
                                                "sense_id": "46b1dfae-370d-3495-80c9-454a7d7bb5b1",
                                                "text": "Enfin, comme c’est un Anglais qui voyage, on doit s’attendre à des bizarreries, mais cela passe la permission."
                                            },
                                            {
                                                "example_id": "ea37faf4-0e70-4d56-90c9-ef352b6ac04b",
                                                "sense_id": "46b1dfae-370d-3495-80c9-454a7d7bb5b1",
                                                "text": "Je n’ai jamais vraiment essayé de me débarrasser de ces bizarreries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84058f65-360d-41c8-9c47-3e6f99045d78",
                        "source_entry_id": "293cdedc-68b9-3091-b4a6-b65fcc03f16d",
                        "target_lang_word": "excentricité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excentricité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Position d’un centre qui s’écarte d’un point donné."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbe302e1-19ea-47b7-842a-ba3c7bcb1f7d",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "La ceinture d’astéroïdes venait de se former. Orbitant d'abord sur des orbites très excentriques, une partie de ces astéroïdes réduisirent ensuite leurs excentricités, mais vu leur nombre et leur absence de tourbillons individuels, ils se dévièrent et se dévient encore souvent les uns les autres."
                                            },
                                            {
                                                "example_id": "99e898b4-8bce-483a-b8a6-7b5ca68e3be6",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "Alors que l’orbite de Mimas revient à la normale et que son excentricité se réduit, y aura-t-il assez d’énergie pour continuer la fonte de la glace ou bien, la source de chaleur s’épuisant, l’eau va-t-elle recristalliser ?"
                                            },
                                            {
                                                "example_id": "3f014bfa-0fce-435c-bc45-b335919f0249",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "Excentricité des couches ligneuses, disposition particulière des couches concentriques qui sont plus larges d’un côté que de l’autre."
                                            },
                                            {
                                                "example_id": "7915cf09-8beb-4c5f-b1d9-df5c644ac29f",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "Excentricité d’une bouche à feu, déviation que présente l’axe de l’âme et qui nuit à la justesse du tir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee807824-f54b-3b60-8970-a5171af88983",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Caractéristique des coniques, indiquant la forme de la courbe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e599459a-1ff7-3fe8-85ca-7eede34765c7",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Éloignement du centre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86c5981-72c0-4d3d-b51e-a8b424d7d676",
                                                "sense_id": "e599459a-1ff7-3fe8-85ca-7eede34765c7",
                                                "text": "L’excentricité d’un quartier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038c966e-8e82-3c8a-8d29-e1e9f73c9a25",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "État de celui, celle, ce qui est excentrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca55d1ae-44d5-425a-8bdf-35ba75282946",
                                                "sense_id": "038c966e-8e82-3c8a-8d29-e1e9f73c9a25",
                                                "text": "Les enfants mis en situation d’excentricité voudraient se rendre invisibles et se fondre dans la bienheureuse conformité ; être comme tout le monde est leur plus vif désir. C’était en tout cas le mien, pour mettre fin aux bizarreries de l’existence."
                                            },
                                            {
                                                "example_id": "29d61a74-f47a-4086-b83b-1d36f179cd13",
                                                "sense_id": "038c966e-8e82-3c8a-8d29-e1e9f73c9a25",
                                                "text": "Le public ne boudait pas son plaisir. Chaque nouvelle excentricité de Brunet était accueillie pas nombre égal de murmures réprobateurs et de sifflements d'approbation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfbd6102-b037-323e-b7cf-6ceea0816aa8",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Agissement ou comportement de ceux qui sont excentriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1f98e0-bfc0-4eea-8b3a-2a8691978dfa",
                                                "sense_id": "bfbd6102-b037-323e-b7cf-6ceea0816aa8",
                                                "text": "La jalousie formait la base de ce caractère plein d’excentricités, mot trouvé par les Anglais pour les folies non pas des petites mais des grandes maisons."
                                            },
                                            {
                                                "example_id": "3b43a001-ab23-4e78-87d4-b7929fd529fa",
                                                "sense_id": "bfbd6102-b037-323e-b7cf-6ceea0816aa8",
                                                "text": "Ceux qui fayotent avec l’originalité et qui à force d'abuser de fausses excentricités, de se mentir à eux-mêmes dans le but de se distinguer, ne sont plus que des pantins. Oui, on en perd du temps à s'affranchir des tabous, des flux et reflux des modes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
