                "senses": [
                    {
                        "sense_id": "1363044f-7fae-31bc-ba1a-773c50379edd",
                        "entry_id": "d92e56f7-e9ca-363b-a9f2-75cf1decae8b",
                        "glosses": [
                            "der Bau von Straßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "591be88e-ffaf-4ff3-be35-004b92d0fd16",
                                "sense_id": "1363044f-7fae-31bc-ba1a-773c50379edd",
                                "text": "„Im ersten Jahr wurde sie als Strafarbeiterin in Nischni Tagil eingesetzt, im Straßenbau, in der Ziegelei, auch in der Gärtnerei.“"
                            },
                            {
                                "example_id": "ef7ff90c-2fb4-44cd-a697-d09b459d0d89",
                                "sense_id": "1363044f-7fae-31bc-ba1a-773c50379edd",
                                "text": "„Auch wenn zahlreiche Waldbrände und der Straßenbau Narben in der üppigen Vegetation der Insel hinterlassen haben, ist Samos auch heute eine der grünsten Inseln der Ägäis.“"
                            },
                            {
                                "example_id": "b6d1a026-5529-490b-b5d9-cb8e33f77875",
                                "sense_id": "1363044f-7fae-31bc-ba1a-773c50379edd",
                                "text": "„Er beruft sich also auf die Zeit, als er unter seiner Führung am Straßenbau gearbeitet hatte.“"
                            },
                            {
                                "example_id": "1f4ba6ce-76b2-421d-8f9c-b1c2bc77088d",
                                "sense_id": "1363044f-7fae-31bc-ba1a-773c50379edd",
                                "text": "„Viertens unterstützte er den Straßenbau und die Straßenpflege (seit etwa 1833 Chausseebau).“"
                            }
                        ],
