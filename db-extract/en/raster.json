                    }
                ],
                "senses": [
                    {
                        "sense_id": "25bea0e6-6bc1-3172-ae9c-cbc07920dc5b",
                        "entry_id": "d9fd62f0-9437-3851-9efe-2a55c53fc6f1",
                        "glosses": [
                            "A scanning pattern of parallel lines that form the display of an image projected on a cathode-ray tube of a television set or display screen."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "45ffcac3-e566-32f3-aa82-affb68d12726",
                        "entry_id": "d9fd62f0-9437-3851-9efe-2a55c53fc6f1",
                        "glosses": [
                            "A bitmap image, consisting of a grid of pixels, stored as a sequence of lines."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de0e8afb-4213-45cf-8103-1142547d9359",
                        "source_entry_id": "d9fd62f0-9437-3851-9efe-2a55c53fc6f1",
                        "source_sense_description": "scanning pattern of parallel lines",
                        "target_lang_word": "Raster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18074dcd-89a6-3d49-b7b4-de4b1b0f66f4",
                                        "entry_id": "e90dcb1b-6a4b-3fef-b435-5c964c57674d",
                                        "glosses": [
                                            "technische Einrichtung zum Druck von Halbtonbildern, zum Beispiel eine Glasplatte mit eingeätztem Netz aus Linien, mit deren Hilfe man ein Bild in einzelne Punkte zerlegen kann"
                                        ],
                                        "tags": [
                                            "Druckwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed871a5e-5a29-4073-b17b-aaa41d5aae4c",
                                                "sense_id": "18074dcd-89a6-3d49-b7b4-de4b1b0f66f4",
                                                "text": "Nachdem man den Raster über das ursprüngliche Bild gelegt hat, kann man mit einer Reprokamera ein neues Bild erstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5ff54b8-d3ff-3014-b0a7-cc28459063e2",
                                        "entry_id": "e90dcb1b-6a4b-3fef-b435-5c964c57674d",
                                        "glosses": [
                                            "System von Flächen, die durch sich schneidende Linien begrenzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921b80d6-5c1a-4a6a-941b-dbf466c9f090",
                                                "sense_id": "f5ff54b8-d3ff-3014-b0a7-cc28459063e2",
                                                "text": "„In einem regelmäßigen Straßengitter mit teilweise überdachten Gehwegen standen Fachwerkhäuser unterschiedlichster Größe und mit der Front nicht unbedingt an der Straße orientiert – jedes Raster bildete eine Freifläche, auf der sich die unterschiedlichsten Gebäude versammelten, kleine Häuser und größere Gehöfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Raster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc58a233-911b-36ea-bd23-762fe854650c",
                                        "entry_id": "46bfe36a-e1fa-3a6e-9b49-48bb6dfce863",
                                        "glosses": [
                                            "System von Punkten oder Streifen, aus denen ein (Fernseh-)Bild besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78212586-28aa-4e94-8cd9-95d3b1495185",
                                                "sense_id": "bc58a233-911b-36ea-bd23-762fe854650c",
                                                "text": "Unter der Lupe kann man das Raster noch erkennen."
                                            },
                                            {
                                                "example_id": "684ca114-1a58-471a-9cbc-81c6539be882",
                                                "sense_id": "bc58a233-911b-36ea-bd23-762fe854650c",
                                                "text": "„Die Strichstärke, der Raster, der Grau- oder Farbton der Planzeichen sowie die Dichte der Eintragungen sind so zu wählen, daß die Plangrundlage erkennbar bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "245fc35f-0836-35e1-b26c-36fd5e4f2a97",
                                        "entry_id": "46bfe36a-e1fa-3a6e-9b49-48bb6dfce863",
                                        "glosses": [
                                            "System von Denkmodellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5804fd34-12f3-409f-9f80-fda3dbf8f7cd",
                                                "sense_id": "245fc35f-0836-35e1-b26c-36fd5e4f2a97",
                                                "text": "Seine Ideen lassen sich in kein Raster einordnen."
                                            },
                                            {
                                                "example_id": "09abf232-c6f2-46d4-ae1e-f5f7b5feaebf",
                                                "sense_id": "245fc35f-0836-35e1-b26c-36fd5e4f2a97",
                                                "text": "„Es muss etwas Unfassbares geschehen sein, das in keinen Raster meiner logischen Überlegungen und Erfahrungen passt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
