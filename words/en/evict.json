{
    "word_family": [
        "eviction",
        "evictee"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afc219c9-2f5a-3fa5-b6fc-0971de7018c5",
                    "sense_definition": "To legally force someone to leave a property or home, especially because they have not paid rent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord decided to <w>evict</w> the tenant after three months of unpaid rent.",
                            "target_lang_translations": {
                                "ru": "Арендодатель решил <w>выселить</w> жильца после трех месяцев неуплаты аренды."
                            }
                        },
                        {
                            "text": "They were worried that the bank might <w>evict</w> a tenant if the mortgage was not paid.",
                            "target_lang_translations": {
                                "ru": "Они беспокоились, что банк может <w>выселить</w> арендатора, если ипотека не будет выплачена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "evict a tenant",
                        "threaten to evict",
                        "legally evict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Законно принуждать кого-либо покинуть жилье или собственность, особенно по причине неуплаты аренды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выселять",
                                "target_lang_sense_clarification": "заставлять покинуть место жительства"
                            },
                            {
                                "target_lang_word": "выселить",
                                "target_lang_sense_clarification": "завершить процесс принудительного освобождения жилья"
                            },
                            {
                                "target_lang_word": "выгонять",
                                "target_lang_sense_clarification": "разговорный вариант, заставлять уйти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3970cf9f-cacc-3a26-8337-f8086c7ae664",
                    "sense_definition": "To remove data from a computer's memory cache to make room for new information.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system will <w>evict</w> the oldest data when the cache reaches its maximum capacity.",
                            "target_lang_translations": {
                                "ru": "Система будет <w>вытеснять</w> самые старые данные, когда кэш достигнет своей максимальной емкости."
                            }
                        },
                        {
                            "text": "The algorithm must decide which items to <w>evict</w> to maintain optimal performance.",
                            "target_lang_translations": {
                                "ru": "Алгоритм должен решить, какие элементы <w>удалить</w> из кэша для поддержания оптимальной производительности."
                            }
                        }
                    ],
                    "synonyms": [
                        "eject"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять данные из кэша памяти компьютера, чтобы освободить место для новой информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытеснять",
                                "target_lang_sense_clarification": "удалять данные из кэша для освобождения места"
                            },
                            {
                                "target_lang_word": "удалять",
                                "target_lang_sense_clarification": "стирать информацию из памяти"
                            },
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "технический термин для удаления объектов из кэша"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}