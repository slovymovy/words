                            {
                                "target_lang_word": "sıkıntı",
                                "target_lang_sense_clarification": "baş belası durum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f50f3f35-585a-3df0-b7c0-ef0b8fd694d7",
                    "sense_definition": "A casual or irregular piece of work; an odd job.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He earned a bit of extra cash by doing a quick <w>hobble</w> for the neighbor.",
                            "target_lang_translations": {
                                "ru": "Он заработал немного лишних денег, выполнив небольшую <w>подработку</w> для соседа.",
                                "tr": "Komşuya hızlı bir <w>ayak işi</w> yaparak biraz fazladan para kazandı."
                            }
                        },
                        {
                            "text": "The handyman was always looking for a small <w>hobble</w> to fill his weekends.",
                            "target_lang_translations": {
                                "ru": "Мастер на все руки всегда искал какую-нибудь мелкую <w>халтуру</w>, чтобы занять свои выходные.",
                                "tr": "Tamirci, hafta sonlarını doldurmak için her zaman küçük bir <w>ek iş</w> arardı."
                            }
                        }
