                                "example_id": "13e22eb5-7e41-4885-b079-c6685d321181",
                                "sense_id": "aea22658-72e3-3069-bf62-297e567bec05",
                                "text": "In hun kringen leek geweld zo ver weg."
                            },
                            {
                                "example_id": "c5449419-978e-49c8-9b17-bad2f087feda",
                                "sense_id": "aea22658-72e3-3069-bf62-297e567bec05",
                                "text": "Ik denk dat in Port of Spain meer mensen dat verhaal hebben gelezen in de literaire kringen in Londen."
                            },
                            {
                                "example_id": "e85232f1-08e1-467e-828b-5bf5eb2a3a7f",
                                "sense_id": "aea22658-72e3-3069-bf62-297e567bec05",
                                "text": "Sommige kunsthistorici beweren dat het een van de kringen van Dante is, andere dat het de maan is - en weer andere zien er de planeet aarde in, vooral vanwege die bosdieren eromheen."
                            }
                        ]
                    }
