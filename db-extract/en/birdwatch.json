                                "example_id": "5254b4fd-5fba-40a5-9726-221bddac9747",
                                "sense_id": "dd99c6ab-8962-38a9-b60d-6c87310e518c",
                                "text": "Some students can stake out a square of earth in a flowerbed and keep track of what comes up; others can start a birdwatch recording the numbers and kinds of birds they see."
                            },
                            {
                                "example_id": "66a8c272-be78-47ac-9c35-ba1d7e0796a4",
                                "sense_id": "dd99c6ab-8962-38a9-b60d-6c87310e518c",
                                "text": "I would make a point of chatting to the tenant farmers that I met while on regular birdwatches and got to know the local village elders, but ironically it was through Chris's work in Beirut that we got in touch with the Skaff family […]"
                            }
                        ]
                    }
