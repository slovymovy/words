                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0abd0e2e-ade3-47a8-8129-24f8dd3de0a9",
                                "sense_id": "0d35aa38-f7ac-3bed-8ef6-909641956f14",
                                "text": "„Sein Revier lag zwischen Webster und Bergen Avenue, wo brutale Straßengangs regierten.“"
                            },
                            {
                                "example_id": "34e88fb7-85c6-461d-8670-d7afc90a37ac",
                                "sense_id": "0d35aa38-f7ac-3bed-8ef6-909641956f14",
                                "text": "„Selbst die Homeboys von den Straßengangs, die von ihren Ecken in der Whitelock Street vertrieben werden, sind diesmal auf der Seite der Polizisten.“"
                            },
                            {
                                "example_id": "637632da-a8e1-4b2f-89eb-336fb5da45ea",
                                "sense_id": "0d35aa38-f7ac-3bed-8ef6-909641956f14",
                                "text": "„In einigen der ›Notstandsgebiete‹, wie sie mit der Zeit genannt wurden, bildeten sich Straßengangs aus jungen Leuten, die weder arbeiteten noch zur Schule gingen.“"
                            },
                            {
                                "example_id": "9ec01944-3014-4633-accd-fc0fd981cd1c",
                                "sense_id": "0d35aa38-f7ac-3bed-8ef6-909641956f14",
                                "text": "„Dem FBI zufolge sind die Maras die gefährlichste Straßengang der Welt.“"
                            }
                        ],
