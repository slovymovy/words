                "translations": [
                    {
                        "translation_id": "3d1e2291-82aa-435b-8d70-c3a99f598c7c",
                        "source_entry_id": "56f18336-39b7-3398-9122-b7702582aadc",
                        "source_sense_description": "the act of interposing, or the state of being interposed",
