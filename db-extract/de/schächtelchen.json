                        "examples": [
                            {
                                "example_id": "3753b457-b359-4e1b-b501-d9f161b84b9d",
                                "sense_id": "aca4cc07-0416-3fa2-a379-e04b6f20a070",
                                "text": "„Er wählte zwei Schächtelchen mit Geschenken, eine Rolle rotschillernden Staatsatlas, vier vergoldete Münzen aus Silber mit den Schriftzeichen für Glück, Langlebigkeit, Gesundheit und Beschaulichkeit, ferner eine goldgesprenkelte Kinderklapper mit dem mehrfarbigen Bilde der Gottheit des langen Lebens und weiter zwei Satz der Acht Kostbarkeiten aus Silber.“"
                            }
                        ],
