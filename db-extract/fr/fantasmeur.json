                        "glosses": [
                            "Personne qui fantasme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528938bc-4cc5-440c-a8e1-b3852101b638",
                                "sense_id": "e05dd094-ca38-3c31-a258-da8a9867de66",
                                "text": "Internet est peuplé de fantasmeurs."
                            },
                            {
                                "example_id": "4b9540a5-186e-495e-846c-f011c8d465a8",
                                "sense_id": "e05dd094-ca38-3c31-a258-da8a9867de66",
                                "text": "J’ai vu des femmes extrêmement déçues, voire déstabilisées, car séduites par un « fantasmeur » ou un « vieux bébé »."
                            },
                            {
                                "example_id": "94c49990-1919-4932-a29f-7447105923c0",
                                "sense_id": "e05dd094-ca38-3c31-a258-da8a9867de66",
                                "text": "Dans le fond, elle n'était ni une jouisseuse, ni une fantasmeuse, ni une rêveuse, ni une romantique, ni une idéaliste, ni une fantaisiste... Juste une travailleuse intelligente."
                            }
                        ]
                    }
