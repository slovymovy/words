                        "examples": [
                            {
                                "example_id": "5282eaa0-b843-49b8-8c60-97658ca05014",
                                "sense_id": "b7b23d71-8a93-31d0-950d-00db9c42a4ae",
                                "text": "1647, Richard Tomlinson (translator and reviser), Jean de Renou⁽ᶠʳ⁾, A Medicinal Dispensatory, [1623, Jean de Renou, Dispensatorium medicum], page 68,\nFor Ignition in ſome is the end of Uſtion, in others, Uſtion is not terminated till smoke expire; and yet many ſtones may be ignified three or four times, and ſtill ſuffunded with a certain humour, till they be bray'd."
                            },
                            {
                                "example_id": "312080b2-6801-46c8-84c9-52b0559a28fe",
                                "sense_id": "b7b23d71-8a93-31d0-950d-00db9c42a4ae",
                                "text": "[…]found, that the whole quantity of Aer ignify'd[…]."
                            },
                            {
                                "example_id": "b78d4844-2e94-4097-94b1-c83350662be6",
                                "sense_id": "b7b23d71-8a93-31d0-950d-00db9c42a4ae",
                                "text": "[…]ſerves to divide and mix ſuch parts of the fuel as are actually ignified and ſaturated with the ethereal fire, with the other freſh parts not yet actually laid hold of by the fire, or as yet but beginning to be ignified;"
                            }
                        ]
                    }
