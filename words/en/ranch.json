                            },
                            {
                                "target_lang_word": "hacienda",
                                "target_lang_sense_clarification": "gran finca o propiedad rural"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dbead39-d05e-32e0-b624-233ad6b18956",
                    "sense_definition": "A creamy salad dressing made with buttermilk, garlic, onion, herbs, and spices.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a green salad with <w>ranch</w> on the side.",
                            "target_lang_translations": {
                                "ru": "Она заказала зеленый салат с <w>соусом ранч</w> отдельно.",
                                "zh": "她点了一份蔬菜沙拉，并要求把<w>牧场沙拉酱</w>放在旁边。",
                                "es": "Ella pidió una ensalada verde con <w>salsa ranch</w> aparte."
                            }
                        },
                        {
                            "text": "I love to dip my pizza crust in <w>ranch</w>.",
                            "target_lang_translations": {
                                "ru": "Я люблю макать корочку пиццы в <w>соус ранч</w>.",
                                "zh": "我喜欢用披萨饼边蘸着<w>牧场酱</w>吃。",
                                "es": "Me encanta mojar los bordes de la pizza en <w>salsa ranch</w>."
                            }
