                                                "example_id": "a4bb54eb-7522-4880-acf2-6b80c7c2906f",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "Tous les trucs qu’il avait vu pratiquer, toutes les ficelles enregistrées au cours d’une expérience de camionneur déjà longue, des pistes pourries du llano vénézuélien aux pentes escarpées des Andes, il les passa en revue, et un par un les rejeta : ça ne collait pas."
                                            },
                                            {
                                                "example_id": "6a817a77-b19d-4de8-a7fa-99f507b46ec1",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "À la fin du repas du soir, Julien annonça qu’ils avaient trouvé un camionneur qui les emmènerait à Lyon."
                                            },
                                            {
                                                "example_id": "7774899a-fe95-409f-8bc2-d2c71fef540e",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "Au contraire, peu mais bien, les mots qui vont à l’âme, à l’os, au nerf, pour qu’à votre tour, camionneurs de chez Mory, ouvriers de chez Whirlpool, soignants du CHU, vous prononciez les mots qui vous rongent, qui pourrissent en vous, que vous les exprimiez, exprimer au sens littéral, qui vous les poussiez dehors, comme un poids, comme une douleur, comme une tumeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camionneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd984ecb-29be-3004-8545-2cbca92f1d2f",
                                        "entry_id": "6b045373-a647-32b3-b519-01e768a97a7e",
                                        "glosses": [
                                            "Cheval attelé à un camion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "404077d0-adcb-46fc-9f6a-474ef0879171",
                        "source_entry_id": "54ef86dd-6167-3eac-883c-74a8927772dd",
                        "source_sense_id": "f1ab315d-c7ec-3929-b56e-65ccd64dfe65",
                        "target_lang_word": "routier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "routier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c31b0f76-0ae2-35d9-8cfc-a58100939118",
                                        "entry_id": "cd558b4d-4ed3-3b68-8590-ce739f0709f4",
                                        "glosses": [
                                            "Qui concerne la route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c12a09-b3a9-4436-8146-aedf321910a7",
                                                "sense_id": "c31b0f76-0ae2-35d9-8cfc-a58100939118",
                                                "text": "Place Charles-Surugue, des feldgendarmes apprennent aux Auxerrois à traverser dans les passages cloutés qu’ils semblaient ignorer. C’est une leçon de prévention routière avant la lettre."
                                            },
                                            {
                                                "example_id": "7d119c40-9b05-4bda-8528-44f9d78b85b6",
                                                "sense_id": "c31b0f76-0ae2-35d9-8cfc-a58100939118",
                                                "text": "Enfin, pour le repérage des noms de lieu et des réseaux de communication terrestres, les deux atlas routiers, Southeast Asia et Indonesia, publiés chez Nelles Verlag, demeurent irremplaçables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "routier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ed6c43-0e10-3bf8-a777-6b4dc20d0f82",
                                        "entry_id": "5ae5047a-5522-3352-8107-aefec0c1fb71",
                                        "glosses": [
                                            "Livre qui marque, qui enseigne les routes de mer, les caps, les fonds, les ancrages, etc., particulièrement pour les voyages au long cours, d’échelle généralement inférieure à 1/4 000 000."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d150f96b-4961-4066-b7dc-75ba5f9c64e2",
                                                "sense_id": "b8ed6c43-0e10-3bf8-a777-6b4dc20d0f82",
                                                "text": "Le routier de la méditerranée. Le routier des Indes. Le grand routier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ed3da1-1ab3-34dd-b56f-fe24db90fca7",
                                        "entry_id": "5ae5047a-5522-3352-8107-aefec0c1fb71",
                                        "glosses": [
                                            "Restaurant qui accueille ceux qui se déplacent sur les routes."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4adaf38e-4af5-4045-98f5-e75301f6eea6",
                                                "sense_id": "a6ed3da1-1ab3-34dd-b56f-fe24db90fca7",
                                                "text": "Le soir, nous faisons halte dans un vallon, à quelques kilomètres au sud de Banswara, pour nous y restaurer. Manish nous suggère plusieurs routiers le long de la route, mais je ressens l’envie de cuisiner à la belle étoile, au feu de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1935f9ca-4522-3638-aba9-99c28d63d55c",
                                        "entry_id": "5ae5047a-5522-3352-8107-aefec0c1fb71",
                                        "glosses": [
                                            "Conducteur de camion ou de camionnette, qui assure le transport par la route."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Camion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44695410-28f2-4658-a27a-0e2540c4fd68",
                                                "sense_id": "1935f9ca-4522-3638-aba9-99c28d63d55c",
                                                "text": "Les deux routiers sont attablés, occupés à exterminer en silence un plateau de fromages et les deux kils de rouge qui vont avec."
                                            },
                                            {
                                                "example_id": "e0ce0668-6486-4a70-b324-8414c77c9713",
                                                "sense_id": "1935f9ca-4522-3638-aba9-99c28d63d55c",
                                                "text": "La colère monte chez les routiers, mais aussi parmi les salariés des bases d’entrepôts logistiques et ceux des transports sanitaires, qui ne s’estiment pas protégés contre le coronavirus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9d8a7b4-8db9-3b62-9f7d-58697a861dbd",
                                        "entry_id": "5ae5047a-5522-3352-8107-aefec0c1fb71",
                                        "glosses": [
                                            "Homme de guerre faisant partie de bandes de soldats d’aventure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c882d082-c689-4296-9e28-358e8219122b",
                                                "sense_id": "c9d8a7b4-8db9-3b62-9f7d-58697a861dbd",
                                                "text": "Ici la flamme des tisons rougeoya et bleuit, et les faces des routiers bleuirent et rougeoyèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9862eece-bda7-3fa7-a611-f8be1feeda47",
                                        "entry_id": "5ae5047a-5522-3352-8107-aefec0c1fb71",
                                        "glosses": [
                                            "Demi-baguette dans laquelle on met des frites, une viande cuite à la friture et éventuellement de la sauce."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
