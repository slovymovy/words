                        "examples": [
                            {
                                "example_id": "9ca86b46-d287-41b2-bc00-82fc851d311c",
                                "sense_id": "e493a680-d4c9-3a4e-9445-ce7b1f81b8a1",
                                "text": "Il se faut entr’aider, c’est la loi de nature."
                            },
                            {
                                "example_id": "79adff66-a986-4e9e-903d-22216532724d",
                                "sense_id": "e493a680-d4c9-3a4e-9445-ce7b1f81b8a1",
                                "text": "Aux champs, au travail, dans les fêtes, on se voit, on se parle, on se prend, on se quitte ; mais, au catéchisme, qui dure un an et souvent deux, faut se supporter ou s’entr’aider cinq ou six heures par jour. — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 5)"
                            }
                        ]
