                                "target_senses": [
                                    {
                                        "sense_id": "6c672fb5-3286-3b73-a530-a5fc4bb4d6a8",
                                        "entry_id": "8c737bc9-69da-361f-99c0-da55fa0b5466",
                                        "glosses": [
                                            "A strip of wood or iron fastened on transversely to something in order to give strength, prevent warping, hold position, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd88f966-cc71-4ccc-9f21-21994ace47dc",
                                                "sense_id": "6c672fb5-3286-3b73-a530-a5fc4bb4d6a8",
                                                "text": "I had learned that cattle willingly walk down a ramp that has cleats to provide secure, nonslip footing."
                                            },
                                            {
                                                "example_id": "04e145ee-7dc7-43e0-ace6-28314dad4d6c",
                                                "sense_id": "6c672fb5-3286-3b73-a530-a5fc4bb4d6a8",
                                                "text": "[...] the people of that island erected lofty spars along the seacoast, to which the look-outs ascended by means of nailed cleats, something as fowls go upstairs in a hen-house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a2fb57f-bf17-38bd-96a2-60a0297579c1",
                                        "entry_id": "8c737bc9-69da-361f-99c0-da55fa0b5466",
                                        "glosses": [
                                            "A continuous metal strip, or angled piece, used to secure metal components."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60649172-fff6-3b93-b88f-d31b8bf8cc82",
                                        "entry_id": "8c737bc9-69da-361f-99c0-da55fa0b5466",
                                        "glosses": [
                                            "A device to quickly affix a line or rope, and from which it is also easy to release."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c195914-7b80-36cc-a69b-a686a44fff71",
                                        "entry_id": "8c737bc9-69da-361f-99c0-da55fa0b5466",
                                        "glosses": [
                                            "A protrusion on the bottom of a shoe or wheel meant for better traction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bff9419-e99c-4239-a64c-753a8c86105c",
                                                "sense_id": "1c195914-7b80-36cc-a69b-a686a44fff71",
                                                "text": "Near-synonym: calk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a34fdba-576e-3a79-bee5-65ebe85a3f20",
                                        "entry_id": "8c737bc9-69da-361f-99c0-da55fa0b5466",
                                        "glosses": [
                                            "An athletic shoe equipped with cleats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a8d703-cde4-4460-bcdb-d7910789ca66",
                                                "sense_id": "3a34fdba-576e-3a79-bee5-65ebe85a3f20",
                                                "text": "He needs to put on five pieces of gear: his helmet, left glove, right glove, left cleat, and right cleat."
                                            }
                                        ]
                                    }
                                ]
                            },
