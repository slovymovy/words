                                    {
                                        "sense_id": "ea15c67b-2818-39c6-8d17-62f1f193870e",
                                        "entry_id": "79ed266b-8a34-3c52-9c95-2d309a3627cf",
                                        "glosses": [
                                            "one of two or more lights fitted to a ship or aircraft, which indicate position and direction taken, especially important at night. Internationally recognised colours are red on the port side, and green on the starboard side."
                                        ],
