                "translations": [
                    {
                        "translation_id": "e81cda7d-2215-4f04-a33f-09fc7e54d6da",
                        "source_entry_id": "5035b1e2-d923-389f-b86b-3f5f3e6c2e88",
                        "source_sense_id": "5a574fb6-1f31-3f23-9cce-21e3e840887b",
                        "target_lang_word": "fayenza",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0a34fa8c-d246-433e-9de7-61a4315ab357",
                        "source_entry_id": "5035b1e2-d923-389f-b86b-3f5f3e6c2e88",
                        "source_sense_id": "5a574fb6-1f31-3f23-9cce-21e3e840887b",
                        "target_lang_word": "Fayence",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fayence",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                        "entry_id": "398586a6-75b7-3439-bddf-6f7ad7605717",
                                        "glosses": [
                                            "(weiß) deckend glasiertes, oft auch bemaltes keramisches Erzeugnis"
                                        ],
                                        "tags": [
                                            "Kunsthandwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04fde74a-cc87-464b-b968-49065a9e823b",
                                                "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                                "text": "„Längst nicht so bekannt wie ihre Verwandten aus Faenza in Italien sind unverdienterweise die Kellinghusener Fayencen aus Mittelholstein. Dennoch hat die kunstvolle Herstellung von Tellern und Töpfen, von Krügen und Kummen in der kleinen Stadt eine lange Tradition, die bis auf die Zeit um 1760 zurückreicht.“"
                                            },
                                            {
                                                "example_id": "a6b978e0-c785-4ac5-bf34-eb1cacb67d51",
                                                "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                                "text": "„Die Blaue Moschee (Sultan Ahmet Moschee) ist ein einzigartiges Beispiel osmanischer Machtdemonstration mit wunderbaren Fayencen im lichtdurchfluteten Innenraum.“"
                                            },
                                            {
                                                "example_id": "fc9d5daa-b309-4c4a-b2ca-6bf6067b7d86",
                                                "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                                "text": "„Während dieser Streitereien hatte er ein paarmal die Suppenterrine wiedergesehen; und in seiner Seele war der heiße Wunsch erwacht, diese Fayence zu besitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3b0e8dc-bb6e-446a-85fa-fe65a94cdb6f",
                        "source_entry_id": "5035b1e2-d923-389f-b86b-3f5f3e6c2e88",
                        "source_sense_id": "5a574fb6-1f31-3f23-9cce-21e3e840887b",
                        "target_lang_word": "фаянс",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фаянс",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e937c591-186a-380e-9ab2-5a045004126e",
                                        "entry_id": "27470796-2f57-3fcc-9a46-6b499d94a3d7",
                                        "glosses": [
                                            "мелкопористый, обычно белый керамический материал, по составу напоминающий фарфор"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "074fab7d-e972-3eea-bafe-0e3b9c8bc83d",
                                        "entry_id": "27470796-2f57-3fcc-9a46-6b499d94a3d7",
                                        "glosses": [
                                            "собир. изделия из такой массы, обожжённые и покрытые глазурью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5a355a-8c6c-4b45-9ed5-33e225149d5d",
                                                "sense_id": "074fab7d-e972-3eea-bafe-0e3b9c8bc83d",
                                                "text": "Всё, от салфеток до серебра, фаянса и хрусталя, носило на себе тот особенный отпечаток новизны, который бывает в хозяйстве молодых супругов."
                                            },
                                            {
                                                "example_id": "eb98a3d2-f7a9-40e4-8ef8-fb44010fc266",
                                                "sense_id": "074fab7d-e972-3eea-bafe-0e3b9c8bc83d",
                                                "text": "Глину эту доставляют в Новгород, Самару и другие места; идет она для котлов, на изготовление фаянса и т. д."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
