                        "cross_references": [
                            {
                                "target_word": "deprivation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688e9dab-605f-3432-a63b-913b609a30b3",
                                        "entry_id": "3c57b357-6e9d-395a-b538-832cbf083420",
                                        "glosses": [
                                            "The act of depriving, dispossessing, or bereaving; the act of deposing or divesting of some dignity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2135f2a-cae9-3f50-9849-cf2d68bc4fed",
                                        "entry_id": "3c57b357-6e9d-395a-b538-832cbf083420",
                                        "glosses": [
                                            "The state of being deprived"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d17b75-b64d-47f6-90e3-dcc956e2287a",
                                                "sense_id": "f2135f2a-cae9-3f50-9849-cf2d68bc4fed",
                                                "text": "Outside the boundaries of the PTEs [Passenger Transport Executives], there was little mechanism to re-open routes, and despite a growing realisation that the lack of transport connectivity was a big contributor towards social deprivation and poor economic performance, there was little government policy recognition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087ba997-18bd-3b7f-8a54-876b59b39838",
                                        "entry_id": "3c57b357-6e9d-395a-b538-832cbf083420",
                                        "glosses": [
                                            "The taking away from a clergyman of his benefice, or other spiritual promotion or dignity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a2d098b-1cb1-380c-b9ab-ef19d322a008",
                                        "entry_id": "3c57b357-6e9d-395a-b538-832cbf083420",
                                        "glosses": [
                                            "lack"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "462444d7-6332-41eb-906a-3a74ab5b0826",
                                                "sense_id": "8a2d098b-1cb1-380c-b9ab-ef19d322a008",
                                                "text": "He was suffering from deprivation of sleep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee8b2a27-7209-42d6-b0ee-71adab1fc32a",
                        "source_entry_id": "a51d14cb-22ae-3913-8433-a49caef73abb",
                        "source_sense_id": "07db577d-6a20-3868-bcf5-3ff5883a78e1",
                        "target_lang_word": "divestiture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divestiture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05190f30-7660-39cc-bdc8-8a13c0f3bbe8",
                                        "entry_id": "b5155778-fed2-35a6-9f10-bde81a83357c",
                                        "glosses": [
                                            "The act of selling something off, especially an investment or a business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3045915-549b-4313-8b67-7c2f3036fd1d",
                                                "sense_id": "05190f30-7660-39cc-bdc8-8a13c0f3bbe8",
                                                "text": "Organic sales, which exclude the impact of acquisitions, divestitures and foreign exchange, are now expected to rise 2 per cent to 5 per cent[…]."
                                            },
                                            {
                                                "example_id": "d5f4d0ca-d625-4257-a1a7-8ad650e91f0f",
                                                "sense_id": "05190f30-7660-39cc-bdc8-8a13c0f3bbe8",
                                                "text": "And finally, the transnational discourses of antiapartheidism and divestiture had led the U.K. television industry to ban sales of current programs to South Africa, again shaping the ways Bop-TV could enact its particular form of antigovernment, antiapartheid cultural politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1cda808-bb6b-390d-9b03-06a548920837",
                                        "entry_id": "b5155778-fed2-35a6-9f10-bde81a83357c",
                                        "glosses": [
                                            "The process of stripping away an individual's confidence, values and attitudes in order to indoctrinate the individual into an organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "076c7f47-53e4-494f-b8b0-f49f8d9893d4",
                                                "sense_id": "e1cda808-bb6b-390d-9b03-06a548920837",
                                                "text": "Divestiture socialisation tries to strip away certain characteristics of the recruit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6c3d576-bd36-4d99-bdcb-e28551e73b19",
                        "source_entry_id": "a51d14cb-22ae-3913-8433-a49caef73abb",
                        "source_sense_id": "07db577d-6a20-3868-bcf5-3ff5883a78e1",
                        "target_lang_word": "лише́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лише́ние",
