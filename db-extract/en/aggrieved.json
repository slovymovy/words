                        "entry_id": "b38e6d90-d6cc-39c7-a6a5-136b74db1807",
                        "glosses": [
                            "Angry or resentful due to unjust treatment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e843e4-2bce-4861-82f7-ab380ab1ae84",
                                "sense_id": "5c36cee1-1d62-3419-bfff-a308ee851375",
                                "text": "I am aggrieved at the conditions which have been forced upon me."
                            },
                            {
                                "example_id": "98079cc7-0144-4c3b-a71d-2aa921346641",
                                "sense_id": "5c36cee1-1d62-3419-bfff-a308ee851375",
                                "text": "Steven Fletcher headed in for Wolves late on, who were denied a penalty and what appeared to be a legitimate equaliser in stoppage time.\nWolves boss Mick McCarthy will rightly be aggrieved by those two decisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "23d44f7d-3453-3140-b677-4a0f6b9df547",
                        "entry_id": "b38e6d90-d6cc-39c7-a6a5-136b74db1807",
                        "glosses": [
                            "Having one's rights denied or curtailed."
                        ],
                        "tags": [],
                        "examples": [
                            {
