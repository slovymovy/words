                            {
                                "example_id": "22fabdb3-480d-4de3-9eb7-fe922cb65c0c",
                                "sense_id": "57a0dfe8-203d-3571-b618-c84351595c77",
                                "text": "„Dass es bei der Zusammensetzung der Kursteilnehmer Probleme gebe, weiß auch Kopf.“"
                            },
                            {
                                "example_id": "fbb41cbb-f0a0-4993-a294-0f0ffb9ecb0c",
                                "sense_id": "57a0dfe8-203d-3571-b618-c84351595c77",
                                "text": "„Die Kursteilnehmer schnüren sich die Schlittschuhe und laufen in Gedanken wahrscheinlich schon rückwärts über das Eis.“"
                            },
                            {
                                "example_id": "77255f21-4600-4330-91c8-7b74bbb13526",
                                "sense_id": "57a0dfe8-203d-3571-b618-c84351595c77",
                                "text": "„Belachew geht zum nächsten Kursteilnehmer.“"
                            }
                        ],
