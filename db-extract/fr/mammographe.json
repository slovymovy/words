                    {
                        "sense_id": "10122a94-e12f-374c-9dab-ad0cb53467c2",
                        "entry_id": "b355d992-cd8e-35f1-8ed8-3e2f965bfe0d",
                        "glosses": [
                            "Appareil de radiographie spécialement conçu pour réaliser des mammographies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5a3434-7bd3-481e-bb7d-a5383e09849f",
                                "sense_id": "10122a94-e12f-374c-9dab-ad0cb53467c2",
                                "text": "La mammographie s'effectue avec un appareil dédié uniquement à cet usage : le mammographe. Il utilise les rayons X pour produire des images du sein en haute résolution."
                            },
                            {
                                "example_id": "8970ba33-026c-42bf-9aa9-77b925e0f838",
                                "sense_id": "10122a94-e12f-374c-9dab-ad0cb53467c2",
                                "text": "Le sein est positionné dans le mammographe et une compression progressive est appliquée pour diminuer l'épaisseur du sein afin d'obtenir un cliché de bonne qualité et donc un diagnostic fiable."
                            },
                            {
                                "example_id": "a119a333-fbfd-4200-80d0-9cc0fdbb192e",
                                "sense_id": "10122a94-e12f-374c-9dab-ad0cb53467c2",
                                "text": "Le mammographe numérique permet également une détection des tumeurs plus petites."
                            }
                        ]
                    }
                ],
