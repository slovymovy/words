                        "examples": [
                            {
                                "example_id": "dc742838-afe1-43b9-b2ec-068d51da4d3b",
                                "sense_id": "4957cda9-a547-39e9-b79b-b6c4884f2f15",
                                "text": "Вузы, прекратите жульничать!",
                                "translation": "Vysoké školy, přestaňte fixlovat!"
                            },
                            {
                                "example_id": "df1a4322-7f14-4081-a117-179f1ab586e8",
                                "sense_id": "4957cda9-a547-39e9-b79b-b6c4884f2f15",
                                "text": "здравствуйте, напишите только не жульничайте слова где идут подряд 3 одинаковые гласные",
                                "translation": "Dobrý den, napište slova, ve kterých následují za sebou tři samohlásky, ale bez opisování"
                            },
                            {
                                "example_id": "007e8197-4dd7-46c9-80ae-0befe93b59a4",
                                "sense_id": "4957cda9-a547-39e9-b79b-b6c4884f2f15",
                                "text": "Кремль! не воруйте и не жульничайте!",
                                "translation": "Kremle! Nerozkrádejte a nefixlujte!"
                            }
                        ]
