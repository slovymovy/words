                    {
                        "translation_id": "4db810e7-a86f-46e6-8c79-5aab23a98aae",
                        "source_entry_id": "3b59234b-d4ae-3f12-8a31-5cc98c7f5733",
                        "source_sense_id": "c66d5952-75b0-3240-abc5-129ded1c8d11",
                        "source_sense_description": "eerste betekenisomschrijving",
                        "target_lang_word": "urne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "953ea804-f952-3e83-b66f-b9a56c4861d0",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Vase de forme et de capacité variables qui, chez les anciens, servait à divers usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9fd1220-70ea-43c5-abf7-03eab03aec9b",
                                                "sense_id": "953ea804-f952-3e83-b66f-b9a56c4861d0",
                                                "text": "Dans cette urne sont les cendres du grand Pompée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24155a5-0299-3b19-b214-79fa342400a9",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Vases de porcelaine, de faïence ou d’autre matière, qui ont la forme des urnes antiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de0ef9f-2262-4839-815b-aa52dac455e3",
                                                "sense_id": "d24155a5-0299-3b19-b214-79fa342400a9",
                                                "text": "[…], et il exprimait un sentiment qui, en dépit des théories matérialistes, vivra toujours dans le cœur des simples : ceux qui ne comprennent pas qu'on puisse aller pleurer sur des cendres enfermées dans une urne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b405b76-3b72-3b6d-9cff-4aed4f40aa6a",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Contenant destiné à recevoir des bulletins de vote. → voir urne électorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8fbea9-9edd-4301-9ce3-8f73c10d1097",
                                                "sense_id": "6b405b76-3b72-3b6d-9cff-4aed4f40aa6a",
                                                "text": "Vous aviez à élire un conseiller général. Il en est résulté des rixes autour des urnes, évidemment, des rixes sanglantes. Ma foi, tant pis : l'urne, même électorale, appelle le cadavre."
                                            },
                                            {
                                                "example_id": "dca05821-718b-428e-9382-a9e8cb22941d",
                                                "sense_id": "6b405b76-3b72-3b6d-9cff-4aed4f40aa6a",
                                                "text": "Quand, par un beau dimanche électoral, nous mettons notre bulletin dans l’urne, nous embarquons sans y penser toute l’histoire de la philosophie politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f30260d-882d-3b9d-ac2e-0a4f0b548a22",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Chez les mousses, organe contenant les spores et qui forme avec le filament qui le soutient le sporophyte. → voir capsule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd0f941-74cd-48df-bb14-88999d29f7ea",
                                                "sense_id": "9f30260d-882d-3b9d-ac2e-0a4f0b548a22",
                                                "text": "Urne ovale à cylindrique, non plissée, très rugueuse, dépourvue d’apophyse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ddfa2f-8f28-3248-b5f0-c867b90ef1e3",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Chez certaines plantes carnivores, feuille spécialisée formant une cavité destinée à piéger des insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71d4322-7f53-4226-ac98-2eac62ce8992",
                                                "sense_id": "52ddfa2f-8f28-3248-b5f0-c867b90ef1e3",
                                                "text": "Nepenthes madagascariensis : […] Face inférieure de l’opercule portant (30-) 50-80 (-100) glandes nectarifères; partie interne et renflée de l’urne ayant 250 à 380 glandes digestives par cm. Ascidies des formes de transition (rameaux courts), à urne allongée, cylindrique, sans ailes, à 2 nervures saillantes longitudinales, de couleur jaune ou jaune tacheté ou striée de rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
