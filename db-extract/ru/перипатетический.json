                                        "sense_id": "899d6718-ba67-3853-ba48-373126b16d99",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Tending to walk about."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23e54833-1042-32a7-af82-290d57261946",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Constantly travelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3cf9a2-934d-4d25-aa1d-4b323b913e39",
                                                "sense_id": "23e54833-1042-32a7-af82-290d57261946",
                                                "text": "After peripatetic upbringing that took her from America to Portugal, Switzerland, Belgium and England, [Mary-Kay] Wilmers read French and Russian at Oxford."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Alternative letter-case form of Peripatetic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57cfe68d-d09a-442a-8f6a-ca151da5a18e",
                                                "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                                "text": "Demetreius of Phalerum, a peripatetic philosopher of the fourth century B.C., wrote an amatory treatise entitled Eroticus - no longer, however, extant."
                                            },
                                            {
                                                "example_id": "4fa707ef-e595-4c6c-9ac1-a577de52d464",
                                                "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                                "text": "The true peripatetic school."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peripatetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "313c0bf5-f430-376f-8512-0dd79d2a46cb",
                                        "entry_id": "c70623f2-3dc6-302c-923d-e790e233453a",
                                        "glosses": [
                                            "One who walks about; a pedestrian; an itinerant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c534595e-091c-3ab4-85c7-4768005ffadb",
                                        "entry_id": "c70623f2-3dc6-302c-923d-e790e233453a",
                                        "glosses": [
                                            "Alternative letter-case form of Peripatetic (“Aristotelian”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f71d08f-a8d7-486d-b5f1-fc0891c4ac02",
                                                "sense_id": "c534595e-091c-3ab4-85c7-4768005ffadb",
                                                "text": "He who would think clearly must think like a peripatetic even if he is unwilling to walk like one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d11855a1-ba54-4615-8604-a5e1b51a4de4",
