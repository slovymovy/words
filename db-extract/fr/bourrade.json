        "fr-extract.jsonl": [
            {
                "entry_id": "f0dfed07-a6c6-3fc7-bca6-04f3a1e8da33",
                "word": "bourrade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a0b87f96-9504-4366-af2a-83574f87ab4f",
                        "entry_id": "f0dfed07-a6c6-3fc7-bca6-04f3a1e8da33",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourrades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "483ff1e1-9174-3b79-88c9-89a223c97459",
                        "entry_id": "f0dfed07-a6c6-3fc7-bca6-04f3a1e8da33",
                        "glosses": [
                            "Atteinte donnée par le chien au lièvre qu’il court et auquel il enlève du poil. → voir bourrer"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "22cd267c-3fd7-3fa3-a879-4b2086d51261",
                        "entry_id": "f0dfed07-a6c6-3fc7-bca6-04f3a1e8da33",
                        "glosses": [
                            "Poussée que l’on donne à quelqu’un avec la crosse d’un fusil ou avec les poings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3965df-e4cb-46fe-94fa-1ad94aaa162b",
                                "sense_id": "22cd267c-3fd7-3fa3-a879-4b2086d51261",
                                "text": "Si j’avais osé j’aurais dit que la veille Barberin m’avait précisément reproché d’être délicat et de n’avoir ni bras ni jambes ; mais je compris que cette interruption ne servirait à rien qu’à m’attirer une bourrade, et je me tus."
                            },
                            {
                                "example_id": "d57011d0-7ce4-40ce-9e4e-e4e49c7cb2af",
                                "sense_id": "22cd267c-3fd7-3fa3-a879-4b2086d51261",
                                "text": "On prodiguait à Colas ces bourrades dans le dos, ces larges claques sur les épaules qui sont chez les simples une marque d’admiration."
                            },
                            {
                                "example_id": "4c5f2f7e-ac4b-471d-b61f-1d47ccc0fd57",
                                "sense_id": "22cd267c-3fd7-3fa3-a879-4b2086d51261",
                                "text": "La jeune fille s’était toujours méfiée de cet être positif et volontaire, aux poings solides et dont il fallait éviter les bourrades équivoques dans l’obscurité du couloir."
                            },
                            {
                                "example_id": "01b77f45-0021-412e-8fac-ed1b82eb59af",
                                "sense_id": "22cd267c-3fd7-3fa3-a879-4b2086d51261",
                                "text": "Des joueurs de belote, assis au fond d'une buvette, comptaient leurs points parmi les rires, les plaisanteries, les grosses bourrades, […]."
                            },
                            {
                                "example_id": "7603b4c5-97da-4638-8bc2-b2e756e24540",
                                "sense_id": "22cd267c-3fd7-3fa3-a879-4b2086d51261",
                                "text": "Comment Fagerolle était-il entré ? Il se souvint plus tard que Tacherot l'avait poussé en avant d'une bourrade."
                            }
                        ]
                    },
                    {
                        "sense_id": "1359a6de-f817-37e7-ac30-56da31975bad",
                        "entry_id": "f0dfed07-a6c6-3fc7-bca6-04f3a1e8da33",
                        "glosses": [
                            "Saule marsault."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b791472d-7294-4815-b032-d7372f3f6bc8",
                        "source_entry_id": "f0dfed07-a6c6-3fc7-bca6-04f3a1e8da33",
