                        "source_sense_description": "een land in Centraal-Afrika, officieel de Republiek Tsjaad",
                        "target_lang_word": "Tchad",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tchad",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "942932eb-9740-38d0-9d31-4c95e0ee6671",
                                        "entry_id": "6f091632-c2e0-314e-b27d-43ef771be740",
                                        "glosses": [
                                            "Pays d’Afrique centrale, situé au sud de la Libye, à l'est du Niger et du Nigeria, au nord du Cameroun et de la République centrafricaine, et à l’ouest du Soudan, et dont la capitale est N’Djamena."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0813d396-b666-4267-940c-80a4dc4697cd",
                                                "sense_id": "942932eb-9740-38d0-9d31-4c95e0ee6671",
                                                "text": "Le Tchad est doté d’une faune variée : lions, rhinocéros, girafes… toute la panoplie des grands animaux, jusqu’aux gazelles et fénecs du désert en passant par tous les oiseaux migrateurs ou non."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed72731f-52ed-355e-aa71-7c6532f30b4f",
                                        "entry_id": "6f091632-c2e0-314e-b27d-43ef771be740",
                                        "glosses": [
                                            "Lac Tchad ; lac endoréique d’Afrique de l’Ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c8f5e0-28b8-4992-afac-274f5eb96832",
                                                "sense_id": "ed72731f-52ed-355e-aa71-7c6532f30b4f",
                                                "text": "En second lieu, le Tchad est un lac sans profondeur : c’est le moins creux de tous les lacs."
                                            },
                                            {
                                                "example_id": "18d06190-f13e-4bfb-ad78-fb673a9462ce",
                                                "sense_id": "ed72731f-52ed-355e-aa71-7c6532f30b4f",
                                                "text": "Un lac naturel est toujours approvisionné par un ou plusieurs tributaires et a généralement un exutoire ; mais il est des lacs endoréiques, tels le Tchad et l’Okavango."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
