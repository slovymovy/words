                "senses": [
                    {
                        "sense_id": "58e8a3e6-4e00-3bb4-a8f7-cd3a1e75f0fc",
                        "entry_id": "09e902d0-ddfa-3f44-b320-c560544a42cb",
                        "glosses": [
                            "auffallende Weste, die in Tagesleuchtfarbe gehalten und mit reflektierenden Streifen versehen ist, so dass ihr Träger/ihre Trägerin (vor allem auf Baustellen, im Straßenverkehr) besser sichtbar ist und somit nicht übersehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d89c41c-1794-42cd-a982-a4a559e439f4",
                                "sense_id": "58e8a3e6-4e00-3bb4-a8f7-cd3a1e75f0fc",
                                "text": "„Denn irgendwann ist jeder Einsatz vorbei, irgendwann streifen die Männer ihre Leuchtwesten ab und kommen erschöpft nach Hause.“"
                            },
                            {
                                "example_id": "96f1420e-54a0-4708-bd68-632d3189ead4",
                                "sense_id": "58e8a3e6-4e00-3bb4-a8f7-cd3a1e75f0fc",
                                "text": "„Ein weiterer Vorteil des kleinen Lämpchens: Nicht nur man selbst sieht besser, man wird auch besser gesehen. Zu diesem Zweck zählen auch Leuchtwesten oder -bänder zu den wichtigsten Accessoires.“"
                            },
                            {
                                "example_id": "ef3b1704-2f21-4114-952e-6161b783cc55",
                                "sense_id": "58e8a3e6-4e00-3bb4-a8f7-cd3a1e75f0fc",
                                "text": "„Damit die Männer weithin gut sichtbar waren, hatten sie orangefarbene Leuchtwesten angezogen, denn die Sicherheit sollte im Vordergrund stehen.“"
                            },
                            {
                                "example_id": "ee359203-1b8f-4c45-abe3-d51456a7555b",
                                "sense_id": "58e8a3e6-4e00-3bb4-a8f7-cd3a1e75f0fc",
                                "text": "„Im Juli 2004 hat auch Spanien nachgezogen: Wer zwischen den Pyrenäen und Gibraltar unterwegs ist und sich außerorts auf der Fahrbahn oder dem Randstreifen aufhält, muss eine Leuchtweste tragen.“"
                            },
                            {
                                "example_id": "046eca3d-d9cf-4b48-a253-aba6ac5adf10",
                                "sense_id": "58e8a3e6-4e00-3bb4-a8f7-cd3a1e75f0fc",
                                "text": "„Niemand ist da, um den Kindern beim Überqueren der Straße zu helfen. Sonst ist da immer einer mit Leuchtweste und einer kleinen Kelle in der Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
