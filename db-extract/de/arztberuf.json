                "senses": [
                    {
                        "sense_id": "db34e7cb-6d5e-3da3-84b3-28056cac728f",
                        "entry_id": "a2d043e8-3045-3ea4-b9ac-c914b5828b50",
                        "glosses": [
                            "Beruf als Arzt oder Ärztin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d73a97a7-91df-45ab-b0cd-81e65951ede2",
                                "sense_id": "db34e7cb-6d5e-3da3-84b3-28056cac728f",
                                "text": "„Auf dem Weg zum Arztberuf gab es wohl doch weit mehr zu lernen als die binomischen Formeln, griechische Grammatik und lateinische Vokabeln.“"
                            },
                            {
                                "example_id": "ef5eb437-a690-4504-91d0-ab93824d262b",
                                "sense_id": "db34e7cb-6d5e-3da3-84b3-28056cac728f",
                                "text": "„Sie verhandelt mit Krankenkassen, Gremien der Selbstverwaltung und setzt sich für den Abbau der Bürokratie im Arztberuf ein, um eine bessere Vereinbarkeit von Arbeit und Familie zu erreichen.“"
                            },
                            {
                                "example_id": "d6e01628-7d39-4293-9f0e-562c8d3a6418",
                                "sense_id": "db34e7cb-6d5e-3da3-84b3-28056cac728f",
                                "text": "„Das Nichtbestehen der Facharztprüfung hat für den Betroffenen keine existenziellen Folgen, da er weiterhin den Arztberuf wie bisher ausüben kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
