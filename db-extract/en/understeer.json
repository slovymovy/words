                                        "glosses": [
                                            "eine Kurve trotz eingeschlagener Räder nicht am Innenrand durchfahren, sondern 'über die Vorderräder' auf den Außenrand zudriften"
                                        ],
                                        "tags": [
                                            "Kraftfahrzeug",
                                            "Fahrdynamik",
                                            "meist über das Fahrzeug, selten über den Fahrer"
