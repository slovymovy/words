                        "factie"
                    ],
                    "common_phrases": [
                        "politieke splinter"
                    ],
                    "target_lang_definitions": {
                        "en": "a small group of people that has separated from a larger organization or political party"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splinter group",
                                "target_lang_sense_clarification": "a small group that broke away from a larger one"
                            },
                            {
                                "target_lang_word": "faction",
                                "target_lang_sense_clarification": "a small dissenting group within a larger one"
                            },
                            {
                                "target_lang_word": "offshoot",
                                "target_lang_sense_clarification": "a group that developed from something else"
                            }
                        ]
                    }
                }
            ]
