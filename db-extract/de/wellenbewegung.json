                        "examples": [
                            {
                                "example_id": "51b8dcb8-17db-414e-afa3-1df301c8993b",
                                "sense_id": "adc713c3-044d-3381-a49b-ae97e4a85724",
                                "text": "„Die Schau, die in enger Kooperation des Kurators Günther Oberhollenzer mit Künstlergattin Elisabeth Pongratz entstand, folgt keiner Chronologie, sondern einer nach Werkgruppen geordneten Logik, einer Art Wellenbewegung der unterschiedlichen Stile und Themen: …“"
                            },
                            {
                                "example_id": "522514f0-7ecd-4a50-9d16-9b459dbda5ad",
                                "sense_id": "adc713c3-044d-3381-a49b-ae97e4a85724",
                                "text": "„Der Offizier schlug ihn und versetzte ihn damit in schwabbelnde Wellenbewegungen wie ein Wasserbett.“"
                            }
                        ],
