                    {
                        "form_id": "5e042558-20e2-4054-a0a6-f36c9a4ab3c1",
                        "entry_id": "fa14dec5-b335-3961-8d6f-f9c6e7d1c570",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
