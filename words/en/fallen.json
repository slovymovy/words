{
    "word_family": [
        "fall",
        "downfall",
        "waterfall",
        "befall",
        "windfall"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17c2004a-15a0-30e7-aa6b-b7e60d4f71bd",
                    "sense_definition": "The past participle of <w>fall</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature has <w>fallen</w> significantly since this morning.",
                            "target_lang_translations": {
                                "ru": "Температура значительно <w>упала</w> с сегодняшнего утра.",
                                "zh": "自今天早上以来，气温已经显著<w>下降</w>了。"
                            }
                        },
                        {
                            "text": "She had <w>fallen</w> asleep by the time we arrived home.",
                            "target_lang_translations": {
                                "ru": "Она <w>уснула</w> к тому времени, как мы вернулись домой.",
                                "zh": "我们到家时，她已经<w>睡着</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола <w>fall</w>.",
                        "zh": "动词 fall 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упа́вший",
                                "target_lang_sense_clarification": "причастие от «падать»"
                            },
                            {
                                "target_lang_word": "опусти́вшийся",
                                "target_lang_sense_clarification": "снизившийся (о температуре, уровне)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "落下",
                                "target_lang_sense_clarification": "指物体或数值下降"
                            },
                            {
                                "target_lang_word": "睡着",
                                "target_lang_sense_clarification": "指进入睡眠状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "868eed91-abfc-30c7-ada2-b5f5743b586f",
                    "sense_definition": "Having dropped down to the ground due to gravity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener swept the <w>fallen</w> leaves from the path.",
                            "target_lang_translations": {
                                "ru": "Садовник смел <w>упавшие</w> листья с дорожки.",
                                "zh": "园丁把小路上<w>落下的</w>叶子扫干净了。"
                            }
                        },
                        {
                            "text": "We had to climb over a <w>fallen</w> tree to continue our hike.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось перелезть через <w>упавшее</w> дерево, чтобы продолжить поход.",
                                "zh": "我们不得不爬过一棵<w>倒下</w>的树才能继续徒步。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fallen leaves",
                        "fallen tree",
                        "fallen snow",
                        "fallen rocks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упавший на землю под действием силы тяжести.",
                        "zh": "因重力作用掉落到地面上的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упа́вший",
                                "target_lang_sense_clarification": "лежащий на земле"
                            },
                            {
                                "target_lang_word": "опа́вший",
                                "target_lang_sense_clarification": "о листьях"
                            },
                            {
                                "target_lang_word": "пова́ленный",
                                "target_lang_sense_clarification": "сбитый с ног или корней (о деревьях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "落下的",
                                "target_lang_sense_clarification": "指掉落的物体"
                            },
                            {
                                "target_lang_word": "倒下的",
                                "target_lang_sense_clarification": "指树木等倒伏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f80290be-a507-3fe9-aa3d-499a6474f414",
                    "sense_definition": "Killed, especially in a war or battle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "war_casualties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general gave a speech to honor the <w>fallen</w> soldiers.",
                            "target_lang_translations": {
                                "ru": "Генерал произнес речь, чтобы почтить память <w>павших</w> солдат.",
                                "zh": "将军发表了演讲，以纪念那些<w>阵亡</w>的士兵。"
                            }
                        },
                        {
                            "text": "A memorial was built in the square for our <w>fallen</w> heroes.",
                            "target_lang_translations": {
                                "ru": "На площади был построен мемориал нашим <w>павшим</w> героям.",
                                "zh": "广场上建了一座纪念碑，以缅怀我们<w>牺牲</w>的英雄。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fallen soldiers",
                        "fallen heroes",
                        "fallen comrades"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убитый, особенно на войне или в битве.",
                        "zh": "在战争或战斗中牺牲的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́вший",
                                "target_lang_sense_clarification": "высокий стиль: погибший в бою"
                            },
                            {
                                "target_lang_word": "поги́бший",
                                "target_lang_sense_clarification": "умерший неестественной смертью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阵亡的",
                                "target_lang_sense_clarification": "指在战场上牺牲的"
                            },
                            {
                                "target_lang_word": "牺牲的",
                                "target_lang_sense_clarification": "指为正义或事业献身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ae179d8-0890-3717-a31d-70f1bb82593f",
                    "sense_definition": "Having collapsed or come down structurally.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rescue workers searched through the <w>fallen</w> building for survivors.",
                            "target_lang_translations": {
                                "ru": "Спасатели искали выживших в <w>разрушенном</w> здании.",
                                "zh": "救援人员在<w>倒塌</w>的建筑物中搜寻幸存者。"
                            }
                        },
                        {
                            "text": "The ruins of the <w>fallen</w> arch were scattered across the site.",
                            "target_lang_translations": {
                                "ru": "Руины <w>обрушившейся</w> арки были разбросаны по всему участку.",
                                "zh": "<w>倒塌</w>拱门的废墟散落在现场各处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collapsed"
                    ],
                    "common_phrases": [
                        "fallen building",
                        "fallen structure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушившийся или обвалившийся (о конструкции).",
                        "zh": "结构上坍塌或倒塌的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обру́шившийся",
                                "target_lang_sense_clarification": "развалившийся"
                            },
                            {
                                "target_lang_word": "разру́шенный",
                                "target_lang_sense_clarification": "уничтоженный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒塌的",
                                "target_lang_sense_clarification": "指建筑物结构崩塌"
                            },
                            {
                                "target_lang_word": "损毁的",
                                "target_lang_sense_clarification": "指因倒塌而损坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f7fb94-d725-36bb-aaaf-ba653245afc9",
                    "sense_definition": "Having lost power, prestige, moral standing, or divine grace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lost_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The story describes Lucifer as a <w>fallen</w> angel cast out of heaven.",
                            "target_lang_translations": {
                                "ru": "История описывает Люцифера как <w>падшего</w> ангела, изгнанного с небес.",
                                "zh": "故事将路西法描述为被逐出天堂的<w>堕落</w>天使。"
                            }
                        },
                        {
                            "text": "He lived as a <w>fallen</w> idol, ignored by the fans who once adored him.",
                            "target_lang_translations": {
                                "ru": "Он жил как <w>падший</w> идол, игнорируемый фанатами, которые когда-то его обожали.",
                                "zh": "他过着<w>失势</w>偶像的生活，被曾经崇拜他的粉丝们所忽视。"
                            }
                        }
                    ],
                    "antonyms": [
                        "arisen"
                    ],
                    "common_phrases": [
                        "fallen angel",
                        "fallen idol",
                        "fallen star"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерявший власть, престиж, моральный облик или божественную милость.",
                        "zh": "失去权力、声望、道德地位或神恩的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́дший",
                                "target_lang_sense_clarification": "нравственно опустившийся"
                            },
                            {
                                "target_lang_word": "ни́звергнутый",
                                "target_lang_sense_clarification": "лишенный высокого положения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堕落的",
                                "target_lang_sense_clarification": "指道德沦丧"
                            },
                            {
                                "target_lang_word": "失势的",
                                "target_lang_sense_clarification": "指失去权力和地位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2b84f20-00aa-3b9c-8d98-91bcb1bc3856",
                    "sense_definition": "Of a woman, considered morally ruined, typically for having sexual relations outside of marriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Victorian literature, a <w>fallen</w> woman was often shunned by society.",
                            "target_lang_translations": {
                                "ru": "В викторианской литературе <w>падшая</w> женщина часто отвергалась обществом.",
                                "zh": "在维多利亚时代的文学作品中，<w>堕落</w>女性常被社会所排斥。"
                            }
                        },
                        {
                            "text": "She was unfairly treated as a <w>fallen</w> woman despite her difficult circumstances.",
                            "target_lang_translations": {
                                "ru": "С ней несправедливо обращались как с <w>падшей</w> женщиной, несмотря на её тяжелые обстоятельства.",
                                "zh": "尽管处境艰难，她还是被不公正地视为<w>堕落</w>女性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fallen woman"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "reflects older social attitudes towards female chastity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О женщине: считающаяся нравственно испорченной, обычно из-за внебрачных связей.",
                        "zh": "指女性在道德上被认为堕落的，通常指有婚外性关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́дшая",
                                "target_lang_sense_clarification": "о женщине (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堕落的",
                                "target_lang_sense_clarification": "指道德上被社会排斥的女性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "629b1a78-ab05-3fd5-b154-a90af3c39a73",
                    "sense_definition": "People who have been killed in a war or battle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "war_casualties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gather every year to remember the <w>fallen</w> of the Great War.",
                            "target_lang_translations": {
                                "ru": "Мы собираемся каждый год, чтобы почтить память <w>павших</w> в Великой войне.",
                                "zh": "我们每年聚在一起，纪念那场大战中的<w>阵亡者</w>。"
                            }
                        },
                        {
                            "text": "The names of the <w>fallen</w> are inscribed on the stone monument.",
                            "target_lang_translations": {
                                "ru": "Имена <w>павших</w> высечены на каменном памятнике.",
                                "zh": "<w>阵亡者</w>的名字被刻在石碑上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "honor the fallen",
                        "remember the fallen",
                        "names of the fallen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, погибшие на войне или в битве.",
                        "zh": "在战争或战斗中牺牲的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́вшие",
                                "target_lang_sense_clarification": "погибшие воины"
                            },
                            {
                                "target_lang_word": "поги́бшие",
                                "target_lang_sense_clarification": "жертвы войны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阵亡者",
                                "target_lang_sense_clarification": "指战场上的牺牲者"
                            },
                            {
                                "target_lang_word": "烈士",
                                "target_lang_sense_clarification": "指为国捐躯的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "023c4583-af25-3415-a64f-b19e072842b9",
                    "sense_definition": "A person who has lost their high status, moral standing, or grace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lost_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity aims to help the <w>fallen</w> return to a productive life.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация стремится помочь <w>опустившимся</w> людям вернуться к продуктивной жизни.",
                                "zh": "该慈善机构旨在帮助<w>堕落者</w>回归正常生活。"
                            }
                        },
                        {
                            "text": "He felt like one of the <w>fallen</w> after the scandal destroyed his career.",
                            "target_lang_translations": {
                                "ru": "После скандала, разрушившего его карьеру, он чувствовал себя одним из <w>падших</w>.",
                                "zh": "丑闻毁掉他的事业后，他觉得自己成了<w>堕落者</w>之一。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, потерявший высокий статус или моральный облик.",
                        "zh": "失去高地位或道德操守的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́дший",
                                "target_lang_sense_clarification": "грешник или изгой"
                            },
                            {
                                "target_lang_word": "опусти́вшийся",
                                "target_lang_sense_clarification": "социально деградировавший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堕落者",
                                "target_lang_sense_clarification": "指道德败坏的人"
                            },
                            {
                                "target_lang_word": "失意者",
                                "target_lang_sense_clarification": "指失去地位的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}