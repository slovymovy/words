                                "example_id": "75f1dca0-b03c-472d-8212-60a3a46b84b9",
                                "sense_id": "18e90bae-7879-3613-a5e3-b6ca4888abc0",
                                "text": "[W]hen he maketh all the stones of the altar as chalkstones that are beaten in sunder, the groves and images shall not stand up."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d62deff-c3a7-3ae0-8392-a3eb6dfb0aef",
                        "entry_id": "836b6a82-f0dc-3c00-88fc-b9ea8282dd96",
                        "glosses": [
                            "A chalk-like concretion, consisting mainly of urate of sodium, found in those affected with gout; a tophus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40710645-238b-4a4e-a35a-a23a60c95b57",
                                "sense_id": "4d62deff-c3a7-3ae0-8392-a3eb6dfb0aef",
                                "text": "[T]he thoughts of his breeding Gout so fast shocks me: it has beside all the rest made a Deposit in the Great Toe—I mean in the Joint, as if intending a Chalkstone."
                            }
                        ]
                    }
