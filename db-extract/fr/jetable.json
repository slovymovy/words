                "forms": [
                    {
                        "form_id": "612516e7-a155-4a4f-938d-24aeddb16b7a",
                        "entry_id": "2c3b34b5-2564-3739-9d08-aee17288ad22",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
