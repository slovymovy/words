        "fr-extract.jsonl": [
            {
                "entry_id": "e13d1bfc-6044-35e5-8d79-95658199cb14",
                "word": "cassure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f28a8b63-c449-4b9c-b2ae-bc923443a4f1",
                        "entry_id": "e13d1bfc-6044-35e5-8d79-95658199cb14",
                        "tags": [
                            "plural"
                        ],
                        "form": "cassures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c07c6fb4-9a56-3586-a15c-c743d8fcafb7",
                        "entry_id": "e13d1bfc-6044-35e5-8d79-95658199cb14",
                        "glosses": [
                            "Endroit où un objet est cassé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "519c2962-c5e4-459b-bcee-07964a0aa51d",
                                "sense_id": "c07c6fb4-9a56-3586-a15c-c743d8fcafb7",
                                "text": "La cassure était nette, comme si elle eût été produite par un instrument tranchant."
                            },
                            {
                                "example_id": "ebe10c99-7a35-4300-aa2d-51d0fcbaa043",
                                "sense_id": "c07c6fb4-9a56-3586-a15c-c743d8fcafb7",
                                "text": "Le marbre des guéridons portaient aux angles des cassures où il apparaissait plus blanc, d’un grain serré, friable."
                            },
                            {
                                "example_id": "56905141-a5b3-46fa-9d02-a1a02bb1767b",
                                "sense_id": "c07c6fb4-9a56-3586-a15c-c743d8fcafb7",
                                "text": "Sur l’escarpement voisin de la verticale, croissent dans les fentes ou les petits replats ménagés par la cassure géométrique de la roche […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "aaa7c914-23f4-36b6-910a-4c79958fac95",
                        "entry_id": "e13d1bfc-6044-35e5-8d79-95658199cb14",
                        "glosses": [
                            "Fragment de ce qui est cassé."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c6d4762a-dbae-400b-bb4a-9cfacf73c2ba",
                                "sense_id": "aaa7c914-23f4-36b6-910a-4c79958fac95",
                                "text": "La caſſure de barreau, ainſi coulée reſſemble beaucoup à celle de l’acier poule ; il ſe trouve à ſa ſurface des petites cavités qui paroiſſent dues au retrait de la matière."
                            }
                        ]
                    },
                    {
                        "sense_id": "b04147a3-8458-35b8-a3c0-6d0e19c14a5c",
                        "entry_id": "e13d1bfc-6044-35e5-8d79-95658199cb14",
                        "glosses": [
                            "Écart net entre deux parties."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ec456eab-98b2-430f-a337-652e176fd531",
                                "sense_id": "b04147a3-8458-35b8-a3c0-6d0e19c14a5c",
                                "text": "Après un début de Championnat qui n’avait jamais été aussi serré en bas, avec longtemps une dizaine de clubs en deux ou trois points, une première cassure nette s’est formée ce week-end : cinq unités séparent la quinzième et la seizième place."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bbde312-6d24-4b8b-8611-9bea86c54ae0",
                        "source_entry_id": "e13d1bfc-6044-35e5-8d79-95658199cb14",
                        "target_lang_word": "breuk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breuk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c09f31f8-6735-3970-b566-43a1820c03a3",
                                        "entry_id": "75deed18-84f3-307d-b6c4-d07c51b7c7ce",
                                        "glosses": [
                                            "de uitkomst (quotiënt) van een deling van twee of meer gehele getallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dea94b3-c7fa-4f5b-9ba6-3d619035a189",
                                                "sense_id": "c09f31f8-6735-3970-b566-43a1820c03a3",
                                                "text": "Irrationale getallen zoals pi zijn geen breuk en kunnen ook niet als breuk geschreven worden"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b15fc9-e449-380b-a002-6adff7ef04bd",
                                        "entry_id": "75deed18-84f3-307d-b6c4-d07c51b7c7ce",
                                        "glosses": [
                                            "een gebroken gedeelte van een object"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35e4b6a2-aacd-4488-96e0-583579d378ac",
                                                "sense_id": "88b15fc9-e449-380b-a002-6adff7ef04bd",
                                                "text": "Je kon heel goed de randen van de breuk voelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8b233b-b581-32aa-ae3d-18b1edfee69f",
                                        "entry_id": "75deed18-84f3-307d-b6c4-d07c51b7c7ce",
                                        "glosses": [
                                            "grens tussen twee aardplaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7a124c-4b14-406d-86bf-7b9d3e446d1c",
                                                "sense_id": "dd8b233b-b581-32aa-ae3d-18b1edfee69f",
                                                "text": "Platentektoniek: De belangrijkste oorzaak van de bevingen zijn verschuivingen van aardplaten. \"Het gebied rond Voerendaal ligt in de Roerdalslenk, die wordt begrensd door twee grote breuken waardoor de ondergrond onder druk staat\", zegt Evers tegen 1Limburg. \"De regio staat tektonisch onder spanning. Die is te herleiden naar het Middellandse Zeegebied, waar vaker aardbevingen en vulkaanuitbarstingen voorkomen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86148e5a-c9ea-3e1a-89ce-607da9fcf1f2",
                                        "entry_id": "75deed18-84f3-307d-b6c4-d07c51b7c7ce",
                                        "glosses": [
                                            "beëindiging van een relatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f6b849-6b40-495c-81c2-350490a98974",
                                                "sense_id": "86148e5a-c9ea-3e1a-89ce-607da9fcf1f2",
                                                "text": "Misschien nog ingewikkelder was het toen het uitging met mijn oudste dochter en haar vriendje......Zij gaf later aan het lastig te hebben gevonden dat ik toen niet thuis was geweest. Ze had het gevoel dat ik daardoor minder goed kon inschatten welk effect de breuk op haar had gemaakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
