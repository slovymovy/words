                    {
                        "translation_id": "92e77fc7-9a9b-43c2-8347-c458221830de",
                        "source_entry_id": "1251be4b-bdbc-33c3-8387-bc6b8467b355",
                        "target_lang_word": "arithméticien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arithméticien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                                        "entry_id": "286982d5-87c7-33f7-b485-96a303ed8669",
                                        "glosses": [
                                            "Spécialiste de l’arithmétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac04c63-1b4d-4b20-90bc-16c9f7afe466",
                                                "sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                                                "text": "Bon arithméticien. Savant arithméticien."
                                            },
                                            {
                                                "example_id": "cc3ccf71-b6df-42d6-b97a-b8ba11768b16",
                                                "sense_id": "3cfa0925-ecfa-3b64-be53-be8c0c18a1e3",
                                                "text": "C’est ce qu’a naturellement assimilé et digéré le 14 Mars, qui n’est pas uniquement formé de Mère Teresa droits-de-l’hommistes jusqu’à la moelle et horrifiées par ce qui ressemble fort à un démarrage de génocide sunnite en Syrie, mais qui comporte dans ses rangs quelques arithméticiens et autres géomètres qui ont heureusement oublié d’être sots."
                                            }
                                        ]
                                    }
                                ]
                            }
