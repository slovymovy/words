                        "examples": [
                            {
                                "example_id": "4454d448-e870-46b3-89da-63d06f422dda",
                                "sense_id": "a23b927c-1e53-3788-a72a-88b3ecfa3aa1",
                                "text": "Comme Chronos dévore ses propres enfants, le parano s’autodévore en organisant son massacre carnivorique par l’autre."
                            },
                            {
                                "example_id": "c7ccdacc-2c49-44f1-add6-88aa0de46fc8",
                                "sense_id": "a23b927c-1e53-3788-a72a-88b3ecfa3aa1",
                                "text": "Un caillou a obstrué le cholédoque… Le pancréas, ne recevant plus sa ration de graisses, se nécrose… — C’est-à-dire ? — Il… s’autodévore. # Première personne du singulier du présent du subjonctif de autodévorer."
                            }
                        ]
