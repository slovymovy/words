                "senses": [
                    {
                        "sense_id": "11985c9b-6e6d-3b76-81e1-e3f04243130e",
                        "entry_id": "2f8c04d6-6fb6-39ba-afd0-40313c015462",
                        "glosses": [
                            "Gelände voller Trümmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e78e2ff9-1535-4957-b06e-cc7ac17b7d74",
                                "sense_id": "11985c9b-6e6d-3b76-81e1-e3f04243130e",
                                "text": "„Die zersprungenen Basaltblöcke lagen am Grunde des Fjords verstreut wie auf einem antiken Trümmerfeld.“"
                            },
                            {
                                "example_id": "30e0b833-839b-4401-8522-1f2a090caff6",
                                "sense_id": "11985c9b-6e6d-3b76-81e1-e3f04243130e",
                                "text": "„Er hatte 1811, im Alter von vierundzwanzig Jahren, als erster eine Bestandsaufnahme des Trümmerfelds von Babylon angefertigt.“"
                            },
                            {
                                "example_id": "18a445be-7a95-4698-96af-3ada8907c997",
                                "sense_id": "11985c9b-6e6d-3b76-81e1-e3f04243130e",
                                "text": "„Frau Holle bahnte sich humpelnd ihren Weg durch das Trümmerfeld.“"
                            },
                            {
                                "example_id": "cb6233c4-9288-4f6c-a830-135aa1fcb04f",
                                "sense_id": "11985c9b-6e6d-3b76-81e1-e3f04243130e",
                                "text": "„In einem Trümmerfeld ballen sie sich zu Trauben zusammen: das Zentrum des Schwarzhandels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
