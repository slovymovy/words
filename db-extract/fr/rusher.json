                ],
                "senses": [
                    {
                        "sense_id": "ffbc1bbf-8615-3f1a-a2b3-d53b4c363646",
                        "entry_id": "7b22cffb-2b9b-36fe-a646-5deb013dbb98",
                        "glosses": [
                            "Se ruer."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "29058abb-4051-4c4f-9cca-58f53f9d3b86",
                                "sense_id": "ffbc1bbf-8615-3f1a-a2b3-d53b4c363646",
                                "text": "On se rushe vers la machine."
                            },
                            {
                                "example_id": "f0ae8e1c-40d8-4c67-b250-6b2bd5bc39ba",
                                "sense_id": "ffbc1bbf-8615-3f1a-a2b3-d53b4c363646",
                                "text": "Au surplus, je ne fais pas partie de la pagaille d'auteurs qui se “rushent” sur la Place Bonaventure pendant les quatre prochains jours."
                            },
                            {
                                "example_id": "1e7f38b7-40d8-4414-b7a9-8f1824ad90b2",
                                "sense_id": "ffbc1bbf-8615-3f1a-a2b3-d53b4c363646",
                                "text": "Les instances en revanche se rushent en pilotage auto."
                            },
                            {
                                "example_id": "ff966057-a914-4b0e-8227-b04504f83bcb",
                                "sense_id": "ffbc1bbf-8615-3f1a-a2b3-d53b4c363646",
                                "text": "Vendeur de bière, videur de fûts, barmaid qui rushe, waitress dans l'jus, j'vend plus de pintes en deux couplets que Pierre Lapointe dans un show complet."
                            }
                        ]
                    }
