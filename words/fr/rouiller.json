    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f99e5af-3404-3f9f-8068-085c01c354ac",
                    "sense_definition": "Se couvrir de rouille sous l'action de l'humidité ou du temps en parlant d'un métal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corrosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu laisses ton vélo sous la pluie, la chaîne va <w>rouiller</w> très rapidement."
                        },
                        {
                            "text": "Les vieux outils abandonnés au fond du jardin ont commencé à <w>rouiller</w> avec le temps."
                        }
                    ],
                    "synonyms": [
                        "s'oxyder"
                    ],
                    "common_phrases": [
                        "laisser rouiller"
                    ]
                },
                {
                    "sense_id": "ddb83a2f-6737-357f-ab5e-1f28aa84863a",
                    "sense_definition": "Perdre de son efficacité, de sa vivacité ou de ses compétences par manque d'exercice ou de pratique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois d'arrêt, mes réflexes commencent un peu à se <w>rouiller</w>."
                        },
                        {
                            "text": "Il continue de s'entraîner chaque jour pour ne pas laisser son esprit se <w>rouiller</w>."
                        }
                    ],
                    "synonyms": [
                        "s'engourdir"
                    ],
                    "common_phrases": [
                        "se laisser rouiller"
                    ]
                },
                {
                    "sense_id": "b0cdc853-1652-39a7-98c3-c88d903bad91",
                    "sense_definition": "Attaquer un métal en y formant de la rouille.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "corrosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité constante de cette cave ancienne a fini par <w>rouiller</w> les gonds de la porte."
                        },
                        {
                            "text": "L'eau de mer a rapidement <w>rouillé</w> les vis métalliques qui fixaient le panneau extérieur."
                        }
                    ],
                    "synonyms": [
                        "oxyder"
                    ],
                    "antonyms": [
                        "dérouiller"
                    ],
                    "common_phrases": [
                        "rouiller le fer"
                    ]
                },
                {
                    "sense_id": "dea34066-83e8-37bc-a917-3a26288c1828",
                    "sense_definition": "Donner ou prendre une teinte brun-rougeâtre semblable à la couleur de la rouille.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les premières fraîcheurs de l'automne viennent lentement <w>rouiller</w> le feuillage des grands chênes."
                        },
                        {
                            "text": "Sous le soleil d'octobre, les collines semblaient <w>rouiller</w> doucement au fil des jours."
                        }
                    ]
                }
            ]
        }
    ]
}