{
    "word_family": [
        "hulking",
        "hulky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23b198e7-8a03-3b4d-9163-459a1ecf499c",
                    "sense_definition": "A very large, heavy, and often clumsy person or object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "large_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wrestler was a <w>hulk</w> of a man who barely fit through the doorway.",
                            "target_lang_translations": {
                                "ru": "Борец был настоящим <w>амбалом</w>, который едва пролезал в дверной проем.",
                                "de": "Der Wrestler war ein wahrer <w>Hüne</w> von einem Mann, der kaum durch den Türrahmen passte."
                            }
                        },
                        {
                            "text": "A rusting <w>hulk</w> of a car sat in the driveway for years.",
                            "target_lang_translations": {
                                "ru": "Ржавая <w>громадина</w> автомобиля стояла на подъездной дорожке годами.",
                                "de": "Das rostende <w>Wrack</w> eines Autos stand jahrelang in der Einfahrt."
                            }
                        }
                    ],
                    "synonyms": [
                        "giant",
                        "behemoth",
                        "lump"
                    ],
                    "antonyms": [
                        "runt",
                        "wisp"
                    ],
                    "common_phrases": [
                        "a great hulk",
                        "hulk of a man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, тяжелый и часто неуклюжий человек или предмет.",
                        "de": "Eine sehr große, schwere und oft schwerfällige Person oder ein solcher Gegenstand."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбал",
                                "target_lang_sense_clarification": "о крупном, сильном мужчине"
                            },
                            {
                                "target_lang_word": "громадина",
                                "target_lang_sense_clarification": "о большом предмете или человеке"
                            },
                            {
                                "target_lang_word": "туша",
                                "target_lang_sense_clarification": "о грузном, неповоротливом теле"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Koloss",
                                "target_lang_sense_clarification": "für sehr große Menschen oder Gegenstände"
                            },
                            {
                                "target_lang_word": "Hüne",
                                "target_lang_sense_clarification": "für einen sehr großen, breitschultrigen Mann"
                            },
                            {
                                "target_lang_word": "Kraftpaket",
                                "target_lang_sense_clarification": "für eine sehr muskulöse, kräftige Person"
                            },
                            {
                                "target_lang_word": "Wrack",
                                "target_lang_sense_clarification": "für ein verfallenes, großes Objekt wie ein Auto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8380d491-726d-3680-ae0b-9a410c9fc610",
                    "sense_definition": "An old ship that is no longer used for sailing, often stripped of equipment and used for storage or as a prison.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners were kept on a damp <w>hulk</w> anchored off the coast.",
                            "target_lang_translations": {
                                "ru": "Заключенных держали на сыром <w>блокшиве</w>, стоящем на якоре у побережья.",
                                "de": "Die Gefangenen wurden auf einer feuchten, vor der Küste vor Anker liegenden <w>Hulk</w> festgehalten."
                            }
                        },
                        {
                            "text": "Divers explored the sunken <w>hulk</w> resting on the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Дайверы исследовали затонувший <w>остов</w>, покоящийся на дне океана.",
                                "de": "Taucher erkundeten das versunkene <w>Schiffswrack</w>, das auf dem Meeresgrund lag."
                            }
                        }
                    ],
                    "synonyms": [
                        "wreck",
                        "shell"
                    ],
                    "common_phrases": [
                        "prison hulk",
                        "rotting hulk"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often refers to historical contexts like prison hulks"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старое судно, непригодное для плавания, часто используемое как склад или тюрьма.",
                        "de": "Ein altes, ausgemustertes Schiff, das oft abgetakelt als Lager oder Gefängnis genutzt wird; auch ein Schiffsrumpf oder -wrack."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блокшив",
                                "target_lang_sense_clarification": "судно-склад или плавучая тюрьма"
                            },
                            {
                                "target_lang_word": "остов",
                                "target_lang_sense_clarification": "корпус разрушенного судна"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hulk",
                                "target_lang_sense_clarification": "ausgemustertes Schiff ohne eigenen Antrieb"
                            },
                            {
                                "target_lang_word": "Schiffswrack",
                                "target_lang_sense_clarification": "untergegangenes oder verfallenes Schiff"
                            },
                            {
                                "target_lang_word": "Schiffsrumpf",
                                "target_lang_sense_clarification": "bloßer Rumpf eines alten Schiffes"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "519212e1-f8ab-3121-8820-38dffabed9fb",
                    "sense_definition": "A fictional superhero who transforms into a giant, green, and incredibly strong monster when he gets angry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "character",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "He got so angry that he looked like the <w>Hulk</w>.",
                            "target_lang_translations": {
                                "ru": "Он так разозлился, что стал похож на <w>Халка</w>.",
                                "de": "Er wurde so wütend, dass er wie der <w>Hulk</w> aussah."
                            }
                        },
                        {
                            "text": "My son wants a <w>Hulk</w> costume for Halloween.",
                            "target_lang_translations": {
                                "ru": "Мой сын хочет костюм <w>Халка</w> на Хэллоуин.",
                                "de": "Mein Sohn wünscht sich zu Halloween ein <w>Hulk</w>-Kostüm."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incredible Hulk",
                        "hulk out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленный супергерой, который превращается в огромного зеленого монстра, когда злится.",
                        "de": "Ein fiktiver Superheld, der sich bei Wut in ein riesiges, grünes und enorm starkes Monster verwandelt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Халк",
                                "target_lang_sense_clarification": "имя персонажа"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hulk",
                                "target_lang_sense_clarification": "Name der Comic- und Filmfigur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e71b00a-e4fc-300e-a266-f96f7c9586a6",
                    "sense_definition": "To appear as a large, massive, and often threatening shape, or to move in a heavy and clumsy way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark mountains <w>hulked</w> over the tiny village in the valley.",
                            "target_lang_translations": {
                                "ru": "Темные горы <w>нависали</w> над крошечной деревней в долине.",
                                "de": "Die finsteren Berge <w>türmten sich</w> über dem winzigen Dorf im Tal <w>auf</w>."
                            }
                        },
                        {
                            "text": "He <w>hulked</w> his way through the crowded room, bumping into people.",
                            "target_lang_translations": {
                                "ru": "Он <w>ломился</w> сквозь переполненную комнату, задевая людей.",
                                "de": "Er <w>stapfte</w> schwerfällig durch den überfüllten Raum und rempelte dabei Leute an."
                            }
                        }
                    ],
                    "synonyms": [
                        "loom",
                        "tower"
                    ],
                    "common_phrases": [
                        "hulk over",
                        "hulk around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нависать огромной массой или двигаться тяжело и неуклюже.",
                        "de": "Als gewaltige, massive und oft bedrohliche Gestalt aufragen oder sich schwerfällig und wuchtig fortbewegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависать",
                                "target_lang_sense_clarification": "угрожающе возвышаться"
                            },
                            {
                                "target_lang_word": "возвышаться",
                                "target_lang_sense_clarification": "быть выше окружающего"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufragen",
                                "target_lang_sense_clarification": "massiv und hoch emporragen"
                            },
                            {
                                "target_lang_word": "sich türmen",
                                "target_lang_sense_clarification": "drohend oder wuchtig emporragen"
                            },
                            {
                                "target_lang_word": "stapfen",
                                "target_lang_sense_clarification": "sich schwerfällig vorwärtsbewegen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}