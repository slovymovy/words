                "translations": [
                    {
                        "translation_id": "cf01421a-87a1-4da5-ad30-3b7c408754d9",
                        "source_entry_id": "0b3b45fa-4f30-3114-bdca-78b9e44a7e27",
                        "target_lang_word": "exaggerate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exaggerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "387dda93-8642-3ade-a11b-3cbc5fbc2daa",
                                        "entry_id": "267d14e8-8410-3c40-8d7e-2a44f15953f3",
                                        "glosses": [
                                            "To overstate, to describe more than the fact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd03e83-7b33-4408-b8ea-b4fbb0a09fbb",
                                                "sense_id": "387dda93-8642-3ade-a11b-3cbc5fbc2daa",
                                                "text": "I've told you a billion times not to exaggerate!"
                                            },
                                            {
                                                "example_id": "4638d36b-a7ef-4e1a-aef2-97f3c8855e67",
                                                "sense_id": "387dda93-8642-3ade-a11b-3cbc5fbc2daa",
                                                "text": "He said he’d slept with hundreds of girls, but I know he’s exaggerating. The real number is about ten."
                                            },
                                            {
                                                "example_id": "6d6a8a4d-bf81-4636-908b-c9e4f814ebfb",
                                                "sense_id": "387dda93-8642-3ade-a11b-3cbc5fbc2daa",
                                                "text": "These testosterone thumpers have repackaged and exaggerated the study, with a credulity born of zealotry, into articles with shitposty titles like “Trust The Science: Study Links Left-Wing Politics to Lower Testosterone,” casting it as hard proof of their hormonal theories of healthy politics."
                                            }
                                        ]
                                    }
                                ]
                            },
