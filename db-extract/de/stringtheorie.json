                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c00ef19-15d5-3d21-9cbb-d4634df2263c",
                        "entry_id": "f3e874b7-6fd6-3958-b252-825dca30ee3f",
                        "glosses": [
                            "eine Theorie, deren Ziel es ist, die beiden Hauptpfeiler der heutigen Physik zu vereinigen: die Allgemeine Relativitätstheorie, welche bei Strukturen im Großen gültig ist und die Quantenfeldtheorie, die im Mikrokosmos angewendet wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "82916cd4-fbf4-46d9-8723-87f1bb4df9e3",
                                "sense_id": "0c00ef19-15d5-3d21-9cbb-d4634df2263c",
                                "text": "Die primäre Aussage der Stringtheorie ist: Alle verschiedenen Elementarteilchen-Sorten manifestieren sich als unterschiedliche Anregungszustände einer einzigen Art von Objekten, den so genannten Strings."
                            },
                            {
                                "example_id": "1509b353-51de-4e99-93c6-f43d132b3715",
                                "sense_id": "0c00ef19-15d5-3d21-9cbb-d4634df2263c",
                                "text": "„Womöglich dauert es nicht mehr lange, bis die ersten handfesten Beobachtungen eintrudeln, welche die Stringtheorie in der Wirklichkeit verankern könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f400ff5-0899-40cc-8ab3-a35508017ffd",
                        "source_entry_id": "f3e874b7-6fd6-3958-b252-825dca30ee3f",
                        "source_sense_id": "0c00ef19-15d5-3d21-9cbb-d4634df2263c",
                        "target_lang_word": "string theory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "string theory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fac087ea-12ae-3a7c-a5e4-03fa3749aeb7",
                                        "entry_id": "a69973c6-a0d1-30a7-9a4a-1addc07ff37c",
                                        "glosses": [
                                            "A candidate unified theory of all physical forces and particles; a theory which suggests that subatomic particles are one-dimensional strings rather than zero-dimensional points. It also suggests that space-time can have up to nine dimensions, plus the dimension of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6010ad-63df-4b2c-a39d-f14a6746c755",
                                                "sense_id": "fac087ea-12ae-3a7c-a5e4-03fa3749aeb7",
                                                "text": "String theory denies the existence of a hypothetical eleventh dimension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90b0a7a2-7ae4-45a0-9f61-1a0d199a1e45",
                        "source_entry_id": "f3e874b7-6fd6-3958-b252-825dca30ee3f",
                        "source_sense_id": "0c00ef19-15d5-3d21-9cbb-d4634df2263c",
                        "target_lang_word": "théorie des cordes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théorie des cordes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "367c67ac-e4a5-307b-b253-088122d4cbd5",
                                        "entry_id": "e78294c1-f907-3c3c-bbea-25bc71039549",
                                        "glosses": [
                                            "Théorie développée pour fournir une description de la gravité quantique, qui postule que les particules élémentaires seraient des cordes unidimensionnelles contrairement aux particules actuelles de dimension 0 et que l’espace-temps serait constitué de 9 dimensions spatiales plus une de temps."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a0530b-6cc5-404f-93ab-48d918528237",
                                                "sense_id": "367c67ac-e4a5-307b-b253-088122d4cbd5",
                                                "text": "Plusieurs physiciens s’attachent à développer la théorie des cordes, censée unifier les quatre grandes forces qui régissent l’Univers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
