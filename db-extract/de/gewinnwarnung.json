                "senses": [
                    {
                        "sense_id": "7d46381d-5d94-3586-9cf9-bac64c860fd6",
                        "entry_id": "706fffc1-b9a9-3ad0-9491-86852c020e09",
                        "glosses": [
                            "Warnung einer Aktiengesellschaft, wenn zu erwarten ist, dass das prognostizierte Geschäftsergebnis nicht erfüllt beziehungsweise deutlich unterschritten wird"
                        ],
                        "tags": [
                            "Börse"
                        ],
                        "examples": [
                            {
                                "example_id": "da07011c-d8f9-4529-b871-a492515bb98a",
                                "sense_id": "7d46381d-5d94-3586-9cf9-bac64c860fd6",
                                "text": "Die Firma Z gab in diesem Quartal eine Gewinnwarnung heraus."
                            },
                            {
                                "example_id": "419b5060-0288-4ad7-b76b-8635fca7042e",
                                "sense_id": "7d46381d-5d94-3586-9cf9-bac64c860fd6",
                                "text": "„Die Aktie verlor nach der Gewinnwarnung bis zu elf Prozent an Wert auf 7,60 Euro.“"
                            },
                            {
                                "example_id": "824a30ab-45b8-4100-89e7-eab79fd9939d",
                                "sense_id": "7d46381d-5d94-3586-9cf9-bac64c860fd6",
                                "text": "„Instabile Automärkte in Westeuropa, schwache Nachfrage im Boomland China: Im ersten Jahresquartal verdiente Daimler nur halb so viel wie ein Jahr zuvor - und gibt eine Gewinnwarnung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
