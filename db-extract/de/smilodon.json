                "senses": [
                    {
                        "sense_id": "b963b01c-389d-36ae-91f8-5765cca9e7d0",
                        "entry_id": "003320c7-d10c-3f34-a61b-1ac0eefd6488",
                        "glosses": [
                            "eine ausgestorbene Großkatze des Pliozäns mit säbelartig gebogenen oberen Eckzähnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d74562-8e7e-4fe4-8c1b-d75c9ce27c89",
                                "sense_id": "b963b01c-389d-36ae-91f8-5765cca9e7d0",
                                "text": "Seit 150 Jahren streiten Forscher darüber, wie Säbelzahntiger etwa der Art Smilodon ihre Fänge eingesetzt haben."
                            },
                            {
                                "example_id": "9a55b835-ec44-42a0-a739-20ecadec36a9",
                                "sense_id": "b963b01c-389d-36ae-91f8-5765cca9e7d0",
                                "text": "Säbelzahnkatzen, insbesondere Tiere der Gattung Smilodon, werden oft auch als „Säbelzahntiger“ bezeichnet, weil sie an der Spitze der Nahrungskette standen; eine nähere Verwandtschaft mit dem heutigen Tiger besteht aber nicht."
                            },
                            {
                                "example_id": "36006f8c-304c-4172-b25d-4b2487873188",
                                "sense_id": "b963b01c-389d-36ae-91f8-5765cca9e7d0",
                                "text": "Neben Informationen über den Körperbau der bis zu etwa 300 Kilogramm schweren Raubkatzen lieferten die Fossilien von Rancho La Brea Forschern auch bereits Hinweise auf das Verhalten von Smilodon."
                            },
                            {
                                "example_id": "a95b39c4-b562-4dfe-ac9a-df396ecedae4",
                                "sense_id": "b963b01c-389d-36ae-91f8-5765cca9e7d0",
                                "text": "Dass Smilodon möglicherweise ähnlich wie Löwen in sozialen Gruppen lebte, lag aufgrund der nur entfernten Verwandtschaftsbeziehungen keineswegs nahe, betonen die Forscher abschließend."
                            },
                            {
                                "example_id": "abe46fea-771c-4050-9c25-7ddc0840abd3",
                                "sense_id": "b963b01c-389d-36ae-91f8-5765cca9e7d0",
                                "text": "„Doch im Fall von Smilodon haben wir nun das Glück, dass mittlerweile gleich mehrere Hinweise belegen, dass diese Raubkatzen sozial waren“, so Balisi."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
