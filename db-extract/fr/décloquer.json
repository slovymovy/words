                ],
                "senses": [
                    {
                        "sense_id": "a20e0c16-26e1-30ce-86a4-8c308904ad55",
                        "entry_id": "6d56b3c5-442e-3959-aa9f-5bf3f1a9d725",
                        "glosses": [
                            "Enlever les cloques de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080bf04c-8961-456e-b555-5f927d7e5540",
                                "sense_id": "a20e0c16-26e1-30ce-86a4-8c308904ad55",
                                "text": "Aplatir ou décloquer un placage sur un meuble en bois qui a souffert de variations d’hygrométrie et de température : les astuces de Système D."
                            },
                            {
                                "example_id": "7432b77e-f0b2-4aed-936d-68e5c1b90bd6",
                                "sense_id": "a20e0c16-26e1-30ce-86a4-8c308904ad55",
                                "text": "J’ai poncé et décloqué une bonne partie de la coque mais je n’ai pas enlevé en totalité le gel coat."
                            },
                            {
                                "example_id": "47ad8f5f-73c5-4200-8671-b9892500eb35",
                                "sense_id": "a20e0c16-26e1-30ce-86a4-8c308904ad55",
                                "text": "Le longeron posé est suivi, dans ce demi-moule, du bord de fuite en nid d’abeille en Nomex, tissus de nylon et de résine qui a, sur le nid d’abeille en alliage léger, l’avantage de se «décloquer» si, au cours des manipulations, on a plié localement les parois des cellules."
                            }
                        ]
                    },
                    {
                        "sense_id": "3810a588-29c6-3e6c-8c20-28c8b3c273c4",
                        "entry_id": "6d56b3c5-442e-3959-aa9f-5bf3f1a9d725",
                        "glosses": [
                            "Avorter."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "eab33a9b-d1e2-4112-aac1-1ca06dbcaef7",
                                "sense_id": "3810a588-29c6-3e6c-8c20-28c8b3c273c4",
                                "text": "Une fille qui veut se faire décloquer ne gardera pas sa grosse panse rien que pour tes mirettes."
                            }
                        ]
                    }
                ],
