                        "target_lang_word": "gentle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gentle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53567bf0-0333-3fec-b61b-b47dbf211164",
                                        "entry_id": "617f076d-82e7-3731-a388-8386206c3605",
                                        "glosses": [
                                            "Tender and amiable; of a considerate or kindly disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bad30659-adf3-4baa-82ae-97d617dc2882",
                                                "sense_id": "53567bf0-0333-3fec-b61b-b47dbf211164",
                                                "text": "Stuart is a gentle man; he would never hurt you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0924e58f-cf88-3418-8d36-7cba9cce1186",
                                        "entry_id": "617f076d-82e7-3731-a388-8386206c3605",
                                        "glosses": [
                                            "Soft and mild rather than hard or severe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8879340e-3d23-4791-a92d-d7f9977920a1",
                                                "sense_id": "0924e58f-cf88-3418-8d36-7cba9cce1186",
                                                "text": "I felt something touch my shoulder; it was gentle and a little slimy."
                                            },
                                            {
                                                "example_id": "5638f800-6c0c-447a-9e56-76cbbe07fa2d",
                                                "sense_id": "0924e58f-cf88-3418-8d36-7cba9cce1186",
                                                "text": "Here the stripped panelling was warmly gold and the pictures, mostly of the English school, were mellow and gentle in the afternoon light."
                                            },
                                            {
                                                "example_id": "0714dbff-d680-4d8e-9905-75e0e836a671",
                                                "sense_id": "0924e58f-cf88-3418-8d36-7cba9cce1186",
                                                "text": "Raj took a deep breath, and reached out to give Armitage the gentlest little stroke. “It’s nippy out. Let’s take him inside.”"
                                            },
                                            {
                                                "example_id": "170afbe3-2855-40f4-af8b-f102c7baeceb",
                                                "sense_id": "0924e58f-cf88-3418-8d36-7cba9cce1186",
                                                "text": "As for daytime sun protection, Dr. Bowe said mineral sunscreens made with zinc oxide may be gentler on sensitized skin than chemical formulas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e442bc9-bef0-3a74-9271-2651514c77c5",
                                        "entry_id": "617f076d-82e7-3731-a388-8386206c3605",
                                        "glosses": [
                                            "Docile and easily managed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baebe37b-b06e-462e-b642-1e8da8958b68",
                                                "sense_id": "5e442bc9-bef0-3a74-9271-2651514c77c5",
                                                "text": "We had a gentle swim in the lake."
                                            },
                                            {
                                                "example_id": "0fc8868a-4a8e-4c4c-aafd-50568e01c20b",
                                                "sense_id": "5e442bc9-bef0-3a74-9271-2651514c77c5",
                                                "text": "a gentle horse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe94b97-f093-3746-97ba-37f236885e2f",
                                        "entry_id": "617f076d-82e7-3731-a388-8386206c3605",
                                        "glosses": [
                                            "Gradual rather than steep or sudden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1807caf1-42ae-411f-a82d-75500f49a2ad",
                                                "sense_id": "8fe94b97-f093-3746-97ba-37f236885e2f",
                                                "text": "The walks in this area have a gentle incline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce8bfc8-8175-3815-930a-da8ab89f84cb",
                                        "entry_id": "617f076d-82e7-3731-a388-8386206c3605",
                                        "glosses": [
                                            "Polite and respectful rather than rude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc52ba1-9500-477a-8c75-0bef904561c4",
                                                "sense_id": "8ce8bfc8-8175-3815-930a-da8ab89f84cb",
                                                "text": "He gave me a gentle reminder that we had to hurry up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ae2008-33ab-343d-89c6-d7e3d6ca1f53",
                                        "entry_id": "617f076d-82e7-3731-a388-8386206c3605",
                                        "glosses": [
                                            "Well-born; of a good family or respectable birth, though not noble."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a56514-84b3-4e39-94c7-dbb1552c7e5e",
                                                "sense_id": "d9ae2008-33ab-343d-89c6-d7e3d6ca1f53",
                                                "text": "\"You are of gentle blood,\" she said […]"
                                            },
                                            {
                                                "example_id": "e1f8df29-c398-4df3-9c40-7b7dba797579",
                                                "sense_id": "d9ae2008-33ab-343d-89c6-d7e3d6ca1f53",
                                                "text": "1893-1897, Charles Kendall Adams (editor), Johnson's Universal Encyclopedia\nBritish society is divided into nobility, gentry, and yeomanry, and families are either noble, gentle, or simple."
                                            },
                                            {
                                                "example_id": "659aafdb-483c-4700-80d5-68e061677a9a",
                                                "sense_id": "d9ae2008-33ab-343d-89c6-d7e3d6ca1f53",
                                                "text": "the studies wherein our noble and gentle youth ought to bestow their time"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gentle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cae6d431-b982-32b0-ba6f-05cb4260570b",
                                        "entry_id": "ae2d41b5-9142-3c6c-a807-1f8362eced7c",
                                        "glosses": [
                                            "To become gentle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa2931d9-d061-4a9d-95ac-6c4c24d8612d",
                                                "sense_id": "cae6d431-b982-32b0-ba6f-05cb4260570b",
                                                "text": "“She's experienced a horrific and nasty scare and is in a state of shock, but otherwise she's relatively okay.” Conrad replied, his tone at first grim (as he recalled what he'd seen in the family room) and then it gentled to a more doctorial tone as he directed his next comments to his patient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b7bb76-a624-3941-bbbc-dc5a74336711",
                                        "entry_id": "ae2d41b5-9142-3c6c-a807-1f8362eced7c",
                                        "glosses": [
                                            "To ennoble."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0030c40b-4ac2-4760-91c6-d516e9a83c3e",
                                                "sense_id": "25b7bb76-a624-3941-bbbc-dc5a74336711",
                                                "text": "[…] For he to-day that sheds his blood with me / Shall be my brother; be he ne'er so vile, / This day shall gentle his condition […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d4c0da-19d7-3ae7-b62d-ff870efd6192",
                                        "entry_id": "ae2d41b5-9142-3c6c-a807-1f8362eced7c",
                                        "glosses": [
                                            "To break; to tame; to domesticate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0844ce90-ca01-4b98-ae2d-b37b9ab5d0c7",
                                                "sense_id": "54d4c0da-19d7-3ae7-b62d-ff870efd6192",
                                                "text": "Yakima could have tried to catch him, gentle him as Wolf had been gentled, but having two stallions in his cavvy would lead to a different kind of trouble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20931dc-8bbd-3f7b-b829-6d8c5bba902e",
                                        "entry_id": "ae2d41b5-9142-3c6c-a807-1f8362eced7c",
                                        "glosses": [
                                            "To soothe; to calm; to make gentle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a791795-9d97-44e6-bf8a-af2e305dfe85",
                                                "sense_id": "c20931dc-8bbd-3f7b-b829-6d8c5bba902e",
                                                "text": "A hornist, his playing gentled by perspective, is out of sight within the woods, but his notes are heard through or over the murmuring mix of bird song and breeze in leaves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gentle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "078cc305-670d-3bc3-adf6-75631592f2d4",
                                        "entry_id": "636489c5-b2e6-3641-b677-bb6c2addecb8",
                                        "glosses": [
                                            "A person of high birth."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "337e18a1-5634-4c2c-852f-a0c2c88468c6",
                                                "sense_id": "078cc305-670d-3bc3-adf6-75631592f2d4",
                                                "text": "Gentles, methinks you frown."
                                            },
                                            {
                                                "example_id": "71c80c17-b10e-4d38-912e-9fec8af44a81",
                                                "sense_id": "078cc305-670d-3bc3-adf6-75631592f2d4",
                                                "text": "While actual medieval societies were full of lots of peasants and a few rich and noble gentles, SCA personas tend to be nobles rather than commoners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "183cd504-d34a-375e-991a-40e262926193",
                                        "entry_id": "636489c5-b2e6-3641-b677-bb6c2addecb8",
                                        "glosses": [
                                            "A maggot used as bait by anglers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e4fa7f0-5026-4d52-8d14-2ef0d0db44d3",
                                                "sense_id": "183cd504-d34a-375e-991a-40e262926193",
                                                "text": "Pooh! the whole thing is as alive and wrigging as an angler's box of gentles"
                                            },
                                            {
                                                "example_id": "b2e9f77d-be55-40b4-b73c-19085bcfdf3b",
                                                "sense_id": "183cd504-d34a-375e-991a-40e262926193",
                                                "text": "Years ago, on Victoria's Port Phillip Bay, the recognised bait for garfish were `gentles', a genteel word for maggots, which were especially grown for gar fishermen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "910f3744-76c2-3a85-8508-068141947cfd",
                                        "entry_id": "636489c5-b2e6-3641-b677-bb6c2addecb8",
                                        "glosses": [
                                            "A trained falcon, or falcon-gentil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
