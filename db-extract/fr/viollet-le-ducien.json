                        "glosses": [
                            "Relatif à Eugène Viollet-le-Duc, à son style ou à ses réalisations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21ab107-9aaa-4e8e-9d28-867b5433c7df",
                                "sense_id": "ff29c5b0-9d90-3ec9-b615-406216e8e1b8",
                                "text": "À tout le moins les clercs et les fidèles de 1960 n’ont-ils pas mieux agi que leurs prédécesseurs viollet-le-duciens de 1860 face au mobilier baroque, ou que les chanoines du XVIIIᵉ siècle soucieux de dégothiciser leurs cathédrales."
                            },
                            {
                                "example_id": "79172ba5-1c2d-442f-88c3-5b3102d9e072",
                                "sense_id": "ff29c5b0-9d90-3ec9-b615-406216e8e1b8",
                                "text": "L’exaltation de la pierre est donc au cœur de l’esthétique viollet-le-ducienne."
                            },
                            {
                                "example_id": "63574c4c-fa43-438b-a95c-cbb1652f20ca",
                                "sense_id": "ff29c5b0-9d90-3ec9-b615-406216e8e1b8",
                                "text": "L’une d’entre elles a déjà été éclaircie, dans une certaine mesure, celle des relations des doctrines viollet-le-duciennes avec les écrits de Ludovic Vitet et de Daniel Ramée."
                            }
                        ]
                    }
