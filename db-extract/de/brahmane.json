                                        "glosses": [
                                            "kapłan hinduski, który posiada świętą wiedzę; najwyższy stan społeczny dawnych Indii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c17a07-4b67-4fbd-9976-5ff73168b703",
                                                "sense_id": "93091547-223a-3d1c-8801-daaa2374fb11",
                                                "text": "Wyróżniane są cztery warny: kapłanów (bramini), wojowników (kszatrija), chłopów (wajśja), sług (śudra)."
                                            }
