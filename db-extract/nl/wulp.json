                                "target_senses": [
                                    {
                                        "sense_id": "cb44c2fa-e784-3bdc-b8bf-fc96162a3484",
                                        "entry_id": "18bb9555-43b9-3924-80d0-04bdcc6ce935",
                                        "glosses": [
                                            "Espèce d’oiseau petit échassier limicole, grand courlis qui se reproduit dans toute l’Europe tempérée et l’Asie, d’un marron grisâtre, tacheté et blanc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d93ee18-9f95-4f61-becf-e35a39b24deb",
                                                "sense_id": "cb44c2fa-e784-3bdc-b8bf-fc96162a3484",
                                                "text": "Le courlis cendré (Numenius arquata) est le plus grand des limicoles présents sur le territoire français."
                                            },
                                            {
                                                "example_id": "3d205bc8-3a4b-4718-9eaf-2884e6a344ab",
                                                "sense_id": "cb44c2fa-e784-3bdc-b8bf-fc96162a3484",
                                                "text": "« Elles ont été plutôt épargnées. Pour les courlis cendrés et Saint-Martin, la période de reproduction était achevée, on pense que les familles ont pu fuir », décrit Yves-Marie Le Guen."
                                            },
                                            {
                                                "example_id": "ef760fb3-73ae-4a4c-b3c0-795b5bb76a0e",
                                                "sense_id": "cb44c2fa-e784-3bdc-b8bf-fc96162a3484",
                                                "text": "Espèce commune dans les plaines d’Alsace et le ried il y a quelques années encore, le courlis cendré a pratiquement disparu, et cela dans l’indifférence générale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
