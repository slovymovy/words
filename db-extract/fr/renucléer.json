                "senses": [
                    {
                        "sense_id": "8d3b2ee5-952c-3400-b469-d6893721a5a0",
                        "entry_id": "50f20276-4259-30f0-ab5d-379438056167",
                        "glosses": [
                            "Remplacer le noyau d’une cellule (ou, par extension, d’autre chose) par un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebd3d882-30ee-46f0-b0bb-dfb2573178bb",
                                "sense_id": "8d3b2ee5-952c-3400-b469-d6893721a5a0",
                                "text": "J’ai réussi à provoquer en bocal la genèse d’un batracien normal à partir d’un œuf énucléé, puis renucléé par le noyau d’une cellule banale prise sur un être adulte."
                            },
                            {
                                "example_id": "e18aef94-3ac7-4332-95d4-8107f9f9cf43",
                                "sense_id": "8d3b2ee5-952c-3400-b469-d6893721a5a0",
                                "text": "Il fallait réorganiser, renucléer tous les éléments sociaux isolés, en tissus sociaux résistants et homogènes."
                            }
                        ]
                    }
                ],
