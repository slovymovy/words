                    "frequency": "VeryLow",
                    "semantic_group_id": "guidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à cette épreuve difficile, il s'est <w>conseillé</w> auprès des sages du village."
                        },
                        {
                            "text": "Le voyageur hésitant s'est <w>conseillé</w> auprès des habitants de la région avant de partir."
                        }
                    ],
