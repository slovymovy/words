                    {
                        "translation_id": "c9e8ba04-f2d3-4638-9e48-9b07c30362a3",
                        "source_entry_id": "2b980696-8933-3fcb-a76c-d18f99b3d10c",
                        "source_sense_description": "человек, едущий на велосипеде, использующий велосипед для перемещения или перевозки чего-либо",
                        "target_lang_word": "cycliste",
