            {
                "entry_id": "aa51627f-12df-3565-9ef6-bc85df04c9df",
                "word": "marbles",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5a6ca18-d223-3d7d-8fa6-341f623d2435",
                        "entry_id": "aa51627f-12df-3565-9ef6-bc85df04c9df",
                        "glosses": [
                            "Any of several children's games played with small balls (made of marble or more commonly glass)."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "5f294138-567b-4ce5-8543-0feddb0aac6f",
                                "sense_id": "a5a6ca18-d223-3d7d-8fa6-341f623d2435",
                                "text": "Egyptian boys played marbles before the days of Moses."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                        "entry_id": "aa51627f-12df-3565-9ef6-bc85df04c9df",
                        "glosses": [
                            "Sanity."
                        ],
                        "tags": [
                            "figuratively",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "dba43d1d-be03-45a4-a542-003a1ebb6d47",
                                "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                                "text": "His lack of marbles is becoming ever more apparent."
                            },
                            {
                                "example_id": "c7f9b58d-212a-4b94-ad0f-a66ebf9f896e",
                                "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                                "text": "Grandpa's lost his marbles, but at least he still recognizes us."
                            },
                            {
                                "example_id": "3ab88582-e2fd-435c-b590-1b90322039a1",
                                "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                                "text": "Granny's still got all her marbles."
                            },
                            {
                                "example_id": "028bea21-6e7a-4bc7-afdb-5b6539563cbe",
                                "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                                "text": "“A nice imbroglio you've landed me in. Thanks to you ...”\n“Yes, sir.”\n“Don't say ‘Yes, sir.’ Thanks to you I have been widely publicized as off my rocker.”\n“Not widely, sir. Merely to your immediate circle now resident at Brinkley Court.”\n“You have held me up at the bar of world opinion as a man who has not got all his marbles.”\n“It was not easy to think of an alternative scheme, sir.”"
                            },
                            {
                                "example_id": "e09f2b7f-ccce-4748-a22b-28a20878ca55",
                                "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                                "text": "There are times when you are certain that the person speaking to you has completely misplaced his marbles. As I leaned away in reaction I felt confident […] Ed had lost his."
                            },
                            {
                                "example_id": "8ed0d23b-35bb-4272-b8e8-e223379ed0bf",
                                "sense_id": "a1f91212-5089-3a93-9322-881e0293b25e",
                                "text": "—Her daddy's crazy. […] Think she's looking for something?\n—Treasure, I expect. That or maybe her daddy's marbles."
                            }
                        ]
                    },
                    {
                        "sense_id": "581aa5ca-0694-3c93-8155-700684ede99e",
                        "entry_id": "aa51627f-12df-3565-9ef6-bc85df04c9df",
                        "glosses": [
                            "Bits of rolled-up rubber shed by the tires of race cars that accumulate at the edges of the track, especially at the corners."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "f553734b-583d-4fb8-8944-f3fbd62eb7f8",
                                "sense_id": "581aa5ca-0694-3c93-8155-700684ede99e",
                                "text": "Some corners are littered with marbles, off the racing line."
                            }
                        ]
                    }
                ],
