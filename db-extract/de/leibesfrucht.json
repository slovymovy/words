                            "plural"
                        ],
                        "form": "die Leibesfrüchte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fc3c67e-9f7d-3af4-9cfc-83bb6f1962d2",
                        "entry_id": "565812cd-5a23-3869-8c32-6acff16eaf20",
                        "glosses": [
                            "das Ungeborene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a271a4f-2ca7-46a5-a5e3-37ed791b5c42",
                                "sense_id": "2fc3c67e-9f7d-3af4-9cfc-83bb6f1962d2",
                                "text": "„Eine Leibesfrucht erhält zur Wahrung ihrer künftigen Rechte, soweit diese einer Fürsorge bedürfen, einen Pfleger.“"
                            },
                            {
                                "example_id": "630e6735-dcfc-4ffa-8354-784f7cb6b206",
                                "sense_id": "2fc3c67e-9f7d-3af4-9cfc-83bb6f1962d2",
                                "text": "„Normalerweise war sie eine ruhige und besonnene Frau, und gerade diese Eigenschaft blühte mit jedem Gramm auf, das ihre Leibesfrucht zunahm.“"
                            },
                            {
                                "example_id": "a542148b-e19f-4ec4-be4f-a4b84ffada1b",
                                "sense_id": "2fc3c67e-9f7d-3af4-9cfc-83bb6f1962d2",
                                "text": "„Nach zwei Fehlgeburten im sechsten Monat stand fest, dass ihr schiefes Becken die Leibesfrucht nicht hielt.“"
                            },
                            {
                                "example_id": "8fe147f4-c7e6-48bb-8c86-19dce33b7bdd",
                                "sense_id": "2fc3c67e-9f7d-3af4-9cfc-83bb6f1962d2",
                                "text": "„Es war eine männliche, schon ziemlich entwickelte Leibesfrucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
