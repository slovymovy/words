                            },
                            {
                                "target_word": "moral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a9d1ed-c65e-36a4-aa41-10c48756ce9d",
                                        "entry_id": "e88a7887-4251-357c-b896-89aaeac6f522",
                                        "glosses": [
                                            "The ethical significance or practical lesson."
                                        ],
                                        "tags": [
                                            "of a narrative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b48092a-6b77-48bc-bc78-35bbc61c2eba",
                                                "sense_id": "a7a9d1ed-c65e-36a4-aa41-10c48756ce9d",
                                                "text": "The moral of The Boy Who Cried Wolf is that if you repeatedly lie, people won't believe you when you tell the truth."
                                            },
                                            {
                                                "example_id": "cf54531b-3bdf-42be-85de-ad34e3e66169",
                                                "sense_id": "a7a9d1ed-c65e-36a4-aa41-10c48756ce9d",
                                                "text": "We protest against the principle that the world of pure comedy is one into which no moral enters."
                                            }
