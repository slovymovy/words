                        "examples": [
                            {
                                "example_id": "81db01c0-b816-485b-a0c1-728385d3a549",
                                "sense_id": "5dcd27c4-c6d2-368a-b5b1-92364092b7da",
                                "text": "Quasimodo werd als vondeling op de eerste zondag na Pasen (Beloken Pasen, quasimodo) op de trappen van de Notre-Dame gevonden"
                            }
                        ]
                    },
                    {
                        "sense_id": "5616568e-4348-34ea-8e36-0b03d39dde31",
                        "entry_id": "67a1509a-a974-3942-bcad-b8655d5ae750",
                        "glosses": [
                            "iemand of iets met een grote bochel of een vergelijkbare afstotelijke vorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7ff24f-8a6d-4e9a-aed0-13ba04f4a677",
                                "sense_id": "5616568e-4348-34ea-8e36-0b03d39dde31",
                                "text": "Ze krijgt fibromyalgie, een aandoening waarbij de spieren aldoor gespannen zijn. „Ik kom als quasimodo m’n bed uit. ’s Avonds ontspan ik met een jointje.”"
                            },
                            {
                                "example_id": "73cc8d79-bd95-4623-a098-cbc5a06f783d",
                                "sense_id": "5616568e-4348-34ea-8e36-0b03d39dde31",
                                "text": "Die moordaanslag op de esthetica werd zo’n succes dat de concurrentie wel moest aanhaken. BMW komt de onsterfelijke verdienste toe dat het door plundering van Koreaans gedachtengoed [sic!] het monstrueuze salonfähig heeft gemaakt. Alleen daarom heeft nu ook Mercedes-Benz zo’n quasimodo in de aanbieding."
                            }
                        ]
                    }
