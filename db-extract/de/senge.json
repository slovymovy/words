                                        "entry_id": "a4e61a85-9504-32b9-8727-65bbec1076d0",
                                        "glosses": [
                                            "A heavy defeat or setback."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
