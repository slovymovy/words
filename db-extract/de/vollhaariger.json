                ],
                "senses": [
                    {
                        "sense_id": "dc35299c-5120-3cb1-b30e-1bb6e43164b4",
                        "entry_id": "32e99220-4a27-3429-be80-2e8d647b958a",
                        "glosses": [
                            "Person mit vollem Haupthaar"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "63689c26-7532-4b21-b91f-181ae9b88ef2",
                                "sense_id": "dc35299c-5120-3cb1-b30e-1bb6e43164b4",
                                "text": "„Das ist weil kahle Männer einfach im unklaren gegenüber den Vollhaarigen gelassen werden.“"
                            },
                            {
                                "example_id": "34b932d2-56cb-498f-83e2-91090973ecc8",
                                "sense_id": "dc35299c-5120-3cb1-b30e-1bb6e43164b4",
                                "text": "„Welches ist die Beschreibung des in der Erkenntnis Feststehenden und in der Meditation Beharrenden, o Vollhaariger, was wird der reden, der in seinem Geiste fest ist, wie wird er sitzen und wie wird er wandeln?“"
                            },
                            {
                                "example_id": "6cf560ae-a288-405a-9d94-4b81c3777209",
                                "sense_id": "dc35299c-5120-3cb1-b30e-1bb6e43164b4",
                                "text": "„Auch ihre Verwandlungskünste sind eine Eigenheit, die den Glatzkopf (Holger, den Jüngeren) und den Vollhaarigen (Thomas, den Älteren) auszeichnen.“"
                            },
                            {
                                "example_id": "128dcd7e-5726-4267-99fa-f11f2fe05542",
                                "sense_id": "dc35299c-5120-3cb1-b30e-1bb6e43164b4",
                                "text": "„Es gesellten sich auch viele ‚Anwärter‘ und ‚Vollhaarige‘ dazu, doch mussten diese bis zum Abend alle ihre Haare lassen, denn nur so durften sie mit den ‚Kahlköpfigen‘ frönen.“"
                            },
                            {
                                "example_id": "e5d04698-c962-4818-924f-b70d28a69910",
                                "sense_id": "dc35299c-5120-3cb1-b30e-1bb6e43164b4",
                                "text": "„Glatzköpfe sind nicht potenter als Vollhaarige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
