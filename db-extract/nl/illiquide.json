                                        "glosses": [
                                            "Lacking liquidity; unable to be converted into cash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392454d5-dfb8-4a6a-b8a8-a7739315ebdd",
                                                "sense_id": "647963fe-af69-3364-9bc7-dbc072bac9ba",
                                                "text": "Investment in illiquid assets may prove to be a mistake if the market turns down."
                                            },
                                            {
                                                "example_id": "e3cdfbd3-58cb-4468-b2c9-f1d1d0b9e455",
                                                "sense_id": "647963fe-af69-3364-9bc7-dbc072bac9ba",
                                                "text": "Aside from the $5.5 billion, FTX also holds sizable positions in 20 digital assets that the lawyers described as “illiquid tokens” that are difficult to convert into cash."
                                            },
                                            {
                                                "example_id": "4646ae33-fd69-4e4d-a5fa-d7cea8ff2228",
                                                "sense_id": "647963fe-af69-3364-9bc7-dbc072bac9ba",
                                                "text": "“While I was co-CEO and then CEO, I understood that Alameda had made numerous large illiquid venture investments and had lent money to Mr Bankman-Fried and other FTX executives,” Ellison said."
                                            }
                                        ]
