{
    "word_family": [
        "pour"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                    "sense_definition": "A heavy and sudden fall of rain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "heavy_rain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They got caught in a sudden <w>downpour</w> without an umbrella and arrived home completely soaked.",
                            "target_lang_translations": {
                                "ru": "Они попали под внезапный <w>ливень</w> без зонта и пришли домой насквозь промокшими.",
                                "es": "Les pilló un <w>aguacero</w> repentino sin paraguas y llegaron a casa completamente empapados."
                            }
                        },
                        {
                            "text": "We waited inside the café until the heavy <w>downpour</w> finally stopped.",
                            "target_lang_translations": {
                                "ru": "Мы переждали в кафе, пока сильный <w>проливной дождь</w> наконец не прекратился.",
                                "es": "Esperamos dentro de la cafetería hasta que el fuerte <w>chaparrón</w> por fin paró."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloudburst",
                        "rainstorm",
                        "pourdown"
                    ],
                    "common_phrases": [
                        "sudden downpour",
                        "heavy downpour",
                        "torrential downpour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, обильный и внезапный дождь.",
                        "es": "Caída repentina, abundante y fuerte de lluvia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ливень",
                                "target_lang_sense_clarification": "сильный дождь"
                            },
                            {
                                "target_lang_word": "проливной дождь",
                                "target_lang_sense_clarification": "очень сильный дождь"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aguacero",
                                "target_lang_sense_clarification": "lluvia repentina y muy fuerte"
                            },
                            {
                                "target_lang_word": "chaparrón",
                                "target_lang_sense_clarification": "lluvia intensa y de corta duración"
                            },
                            {
                                "target_lang_word": "chubasco",
                                "target_lang_sense_clarification": "lluvia fuerte y repentina"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                    "sense_definition": "To rain heavily or intensely.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "heavy_rain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It started to <w>downpour</w> just as we were walking back to our house.",
                            "target_lang_translations": {
                                "ru": "Дождь начал <w>лить как из ведра</w>, как раз когда мы возвращались домой.",
                                "es": "Empezó a <w>llover a cántaros</w> justo cuando volvíamos caminando a casa."
                            }
                        },
                        {
                            "text": "The sky turned dark and it began to <w>downpour</w> over the whole city.",
                            "target_lang_translations": {
                                "ru": "Небо потемнело, и над всем городом <w>хлынул ливень</w>.",
                                "es": "El cielo se oscureció y comenzó a <w>diluviar</w> sobre toda la ciudad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start to downpour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти сплошным потоком, лить как из ведра (о дожде).",
                        "es": "Llover de manera muy intensa o torrencial."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лить как из ведра",
                                "target_lang_sense_clarification": "очень сильно идти (о дожде)"
                            },
                            {
                                "target_lang_word": "хлынуть",
                                "target_lang_sense_clarification": "внезапно сильно пойти (о дожде)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "llover a cántaros",
                                "target_lang_sense_clarification": "llover de forma torrencial"
                            },
                            {
                                "target_lang_word": "jarrear",
                                "target_lang_sense_clarification": "llover copiosamente"
                            },
                            {
                                "target_lang_word": "diluviar",
                                "target_lang_sense_clarification": "llover con gran intensidad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}