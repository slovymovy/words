                "senses": [
                    {
                        "sense_id": "1c1660bd-dd4a-35a8-bcd8-f83895edeb90",
                        "entry_id": "86aa987d-ce56-3752-b49d-a72a05c9edd0",
                        "glosses": [
                            "Angehöriger der gleichnamigen Dynastie im Frankenreich"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c0840c9c-f7a3-4540-88b4-1b0cc8dda3ec",
                                "sense_id": "1c1660bd-dd4a-35a8-bcd8-f83895edeb90",
                                "text": "„Die Karolinger haben diese Grundlagen geschmälert.“"
                            },
                            {
                                "example_id": "ca58f743-6990-4496-9d37-3ee80170aacf",
                                "sense_id": "1c1660bd-dd4a-35a8-bcd8-f83895edeb90",
                                "text": "„Der Weg der Karolinger auf den Thron war lang und steinig, nicht frei von Um- und Irrwegen, und an manchen Stellen lag das Scheitern näher als der Erfolg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28298fd0-f716-43f7-ba7a-eb1e04bd8b85",
                        "source_entry_id": "86aa987d-ce56-3752-b49d-a72a05c9edd0",
                        "source_sense_id": "1c1660bd-dd4a-35a8-bcd8-f83895edeb90",
                        "source_sense_description": "historisch: Angehöriger der gleichnamigen Dynastie im Frankenreich",
                        "target_lang_word": "Carolingien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Carolingien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "118d44b9-7b43-388d-b8e3-2c49f4573717",
                                        "entry_id": "2aa4db34-a35b-3a37-b400-d9b8bc1b4c7d",
                                        "glosses": [
                                            "Descendant de Pépin le Bref ou personne vivant sous cette dynastie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cffebb4e-fa65-4865-83be-7a086773065c",
                                                "sense_id": "118d44b9-7b43-388d-b8e3-2c49f4573717",
                                                "text": "Sous les Carolingiens et les Mérovingiens."
                                            },
                                            {
                                                "example_id": "b46b3779-7d19-41c1-83e6-5d45084bb289",
                                                "sense_id": "118d44b9-7b43-388d-b8e3-2c49f4573717",
                                                "text": "Les Carolingiens forment une dynastie fondée par Pépin de Landen, elle régne jusqu’à Louis V."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe012b6b-4a73-3bad-b739-440849c44dca",
                                        "entry_id": "2aa4db34-a35b-3a37-b400-d9b8bc1b4c7d",
                                        "glosses": [
                                            "Surnom donné aux élèves du lycée Charlemagne, à Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91105376-6c37-4462-9541-e5a332087363",
                                                "sense_id": "fe012b6b-4a73-3bad-b739-440849c44dca",
                                                "text": "Ce jour-là il ne brilla guère et les Carolingiens encaissèrent plus de buts qu’ils ne nous en marquèrent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
