                "senses": [
                    {
                        "sense_id": "bb770dc7-c570-3b65-8215-e1009c811d6b",
                        "entry_id": "12698896-bc21-3087-aa59-e64090c79840",
                        "glosses": [
                            "to harrow"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d83363b7-2672-4a52-b466-d0f18fe8dc3d",
                                "sense_id": "bb770dc7-c570-3b65-8215-e1009c811d6b",
                                "text": "Вспа́ханное поле бы́ло поме́щичье, о́чень большо́е, так что с обе́их сторо́н дороги и вперед в го́ру ничего́ не бы́ло ви́дно, кро́ме черного, ро́вно взборожденного, ещё не скоро́женного па́ра.",
                                "translation": "The plowed field was the landowner's, very big, so that from both sides of the road nothing could be seen but the black, evenly furrowed, still unharrowed fallow.",
                                "english": "The plowed field was the landowner's, very big, so that from both sides of the road nothing could be seen but the black, evenly furrowed, still unharrowed fallow."
                            }
                        ]
                    }
