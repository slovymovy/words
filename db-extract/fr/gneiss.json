                                        "entry_id": "07f9e8a1-e532-316d-9f29-58d23a536b0c",
                                        "glosses": [
                                            "A common and widely-distributed metamorphic rock having bands or veins, but not schistose."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef79ad4-6636-47c8-92d9-c78d19c65124",
                                                "sense_id": "759e0fec-b773-36db-af27-b0d8b8b8b674",
                                                "text": "The old towns along the route are as solidly built from the gneiss of the region as you might expect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
