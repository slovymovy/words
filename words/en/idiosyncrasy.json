            "senses": [
                {
                    "sense_id": "ba5a9d87-0f3f-371e-86e2-b008f4bfc849",
                    "sense_definition": "A behavior, habit, or way of thinking that is peculiar or characteristic of an individual.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personal_peculiarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One of his personal <w>idiosyncrasies</w> was that he always had to wear mismatched socks."
                        },
                        {
                            "text": "She tolerated her husband's little <w>idiosyncrasies</w> because she loved him dearly."
                        }
                    ],
                    "synonyms": [
                        "eccentricity",
                        "foible",
                        "mannerism",
                        "quirk",
                        "oddity"
                    ],
                    "common_phrases": [
                        "personal idiosyncrasies",
                        "charming idiosyncrasy"
                    ]
                },
                {
                    "sense_id": "44e0b795-2dfe-3157-be1a-e5dfa20f98d9",
                    "sense_definition": "A distinctive or peculiar feature of a system, language, or thing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "system_peculiarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He mastered the <w>idiosyncrasies</w> of English spelling and speech after years of study."
                        },
                        {
                            "text": "Every programming language has its own <w>idiosyncrasies</w> that developers must learn to navigate."
                        }
                    ],
                    "synonyms": [
                        "quirk",
                        "oddity"
                    ],
                    "common_phrases": [
