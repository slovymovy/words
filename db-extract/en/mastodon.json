    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "df592795-0e64-3dcf-ac11-bd831baad823",
                "word": "Mastodon",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05c9d80a-cae4-3540-9128-555a816f98da",
                        "entry_id": "df592795-0e64-3dcf-ac11-bd831baad823",
                        "glosses": [
                            "A decentralized microblogging platform, part of the Fediverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a212414-55d5-499e-976d-4c84e5e917a8",
                                "sense_id": "05c9d80a-cae4-3540-9128-555a816f98da",
                                "text": "However, the underlying design of platforms within [The Free Network] such as Mastodon, Diaspora and others ... opens the door to security and harassment problems."
                            },
                            {
                                "example_id": "c5416eba-6596-44b8-99ec-91e8e162f58b",
                                "sense_id": "05c9d80a-cae4-3540-9128-555a816f98da",
                                "text": "Since Musk bought the bird app last month, users are looking for ways to access Mastodon, the open source microblogging platform that isn’t quite Twitter but seems to be the closest thing to it, and they’re signing up for its many servers in droves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355b9ccb-c815-4999-87d5-2b03ef0e23aa",
                        "source_entry_id": "df592795-0e64-3dcf-ac11-bd831baad823",
                        "source_sense_id": "05c9d80a-cae4-3540-9128-555a816f98da",
                        "source_sense_description": "decentralized online microblogging platform",
                        "target_lang_word": "Mastodon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "932967c9-7cc9-4a56-9e08-618a4e3710a0",
                        "source_entry_id": "df592795-0e64-3dcf-ac11-bd831baad823",
                        "source_sense_id": "05c9d80a-cae4-3540-9128-555a816f98da",
                        "source_sense_description": "decentralized online microblogging platform",
                        "target_lang_word": "Mastodon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mastodon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ebc21ea-4439-31bf-b051-622640e74dce",
                                        "entry_id": "4064d295-69fb-3f78-903a-fbf39c150dda",
                                        "glosses": [
                                            "Réseau social et logiciel de microblog auto-hébergé, libre, distribué et décentralisé via ActivityPub au sein du Fediverse."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee14928-b7e8-47d3-8a41-d7cfc1341659",
                                                "sense_id": "9ebc21ea-4439-31bf-b051-622640e74dce",
                                                "text": "Parmi elles, Mastodon, qui aurait aujourd’hui plus de 670 000 inscrits, selon le Guardian, gagnerait des milliers d’utilisateurs chaque jour."
                                            },
                                            {
                                                "example_id": "7a3db90b-6b8e-4508-a39f-f6256b977931",
                                                "sense_id": "9ebc21ea-4439-31bf-b051-622640e74dce",
                                                "text": "Mastodon est un réseau social créé en 2016 par Eugen Rochko, un jeune informaticien allemand."
                                            },
                                            {
                                                "example_id": "7d27919d-3a7e-4aa4-8b29-4b460e2e8fdb",
                                                "sense_id": "9ebc21ea-4439-31bf-b051-622640e74dce",
                                                "text": "Grâce à Mastodon, tout le monde peut constituer son réseau social en remplacement de Twitter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea47e6a6-5bd0-4295-9fb9-ef2cfc7668cc",
                        "source_entry_id": "df592795-0e64-3dcf-ac11-bd831baad823",
                        "source_sense_id": "05c9d80a-cae4-3540-9128-555a816f98da",
                        "source_sense_description": "decentralized online microblogging platform",
                        "target_lang_word": "Mastodon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mastodon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                        "entry_id": "60546c31-a186-3773-bb93-24a0d2240ee6",
                                        "glosses": [
                                            "ausgestorbene, tertiäre Elefantenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aceee29f-9505-410b-8976-4900c99c075c",
                                                "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                                "text": "Mastodonten kennt man nur als Fossilien."
                                            },
                                            {
                                                "example_id": "14edde81-40dc-4928-8175-c08d56822e52",
                                                "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                                "text": "„Binnen weniger Jahrhunderte waren Mammut, Mastodon und Säbelzahntiger ausgetilgt.“"
                                            },
                                            {
                                                "example_id": "20d94f13-1ed0-47e0-8481-49d066915c13",
                                                "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                                "text": "„Das Dunkel, das über dem Mastodon lag, reizte Pécuchets Begierde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                "word": "mastodon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3f39f695-1429-43b1-b8bf-25048e1c9961",
                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                        "tags": [
                            "plural"
                        ],
                        "form": "mastodons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5e391cb-a625-3ace-80b2-f2a05472f07a",
                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                        "glosses": [
                            "Extinct elephant-like mammal of the genus †Mammut that flourished worldwide from Miocene through Pleistocene times; differs from elephants and mammoths in the form of the molar teeth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e25794e-8d41-4d58-8563-4ffef4af58ed",
                                "sense_id": "e5e391cb-a625-3ace-80b2-f2a05472f07a",
                                "text": "When, exactly, Europeans first stumbled upon the bones of an American mastodon is unclear. An isolated molar unearthed in a field in upstate New York was sent off to London in 1705; it was labeled the “tooth of a Giant”."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                        "glosses": [
                            "Anything awkwardly large or unwieldy."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "266300bf-d949-401c-9c2b-4c64d59f6c95",
                                "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                "text": "The battery is dying, and Natalia's iPhone charger doesn't fit my mastodon of a phone anyway."
                            },
                            {
                                "example_id": "cc8f2d08-7aeb-433a-a0b2-2a36b1b99d6c",
                                "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                "text": "Nor does it work for governance: the policy has become such a mastodon that we can't adapt it quickly enough to different regions or different circumstances."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5baa4876-e705-45ac-8e31-15aa2e3bc6ed",
                        "source_entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                        "source_sense_description": "extinct elephant-like mammal of the genus Mammut",
                        "target_lang_word": "mastodonte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastodonte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                                        "glosses": [
                                            "Grand quadrupède à dents mamelonnées, qui a beaucoup de rapport avec l’éléphant et qu’on ne connaît que par ses ossements trouvés en terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f47cc2-1c0f-4e3a-96a5-0d7baa8a12cb",
                                                "sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                                                "text": "Allez voir au cabinet d’histoire naturelle le mastodonte ou dinothérium gigantœum, merveilleux fossile avec des os et des barres d’airain, qui doit être pour le moins le behemot de la Bible."
                                            },
                                            {
                                                "example_id": "f5674a05-ab59-4784-a3ea-9356ecbd97b8",
                                                "sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                                                "text": "Lorsqu'on est aux abois,\npas mieux qu'un mastodonte\nPour cacher son émoi\net étouffer sa honte !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d8a751-c9bc-3fe7-8ac8-f583ebbf352e",
                                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                                        "glosses": [
                                            "Personne d’un fort embonpoint ou chose de taille énorme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b5b058-2595-4e29-8261-e4a65952243c",
                                                "sense_id": "90d8a751-c9bc-3fe7-8ac8-f583ebbf352e",
                                                "text": "Quel mastodonte !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                                        "glosses": [
                                            "Entreprise, société, personne physique ou morale extrêmement importante dans sa spécialité."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb77775-1f0d-4ba8-86d1-f4a542a2ba41",
                                                "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                                "text": "Une compétition de grande envergure s’est engagée entre les mastodontes des réseaux et tous les acteurs de la chaîne numérique pour savoir qui captera à la fois les nouveaux abonnés mobiles et les consommateurs des services qui y seront proposés."
                                            },
                                            {
                                                "example_id": "6d965c69-cb5c-4b76-83d3-161793f27eeb",
                                                "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                                "text": "Sur Twitch, il y a les mastodontes du streaming."
                                            },
                                            {
                                                "example_id": "7bae54db-d71f-4aab-9d60-daca1c357885",
                                                "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                                "text": "Pas de front antioccidental non plus sur le plan géopolitique. Ni même un front uni du tout : les deux mastodontes du groupe, l’Inde et la Chine, s’affrontent régulièrement sur la frontière himalayenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
