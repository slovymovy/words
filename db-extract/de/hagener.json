                ],
                "senses": [
                    {
                        "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                        "entry_id": "df89e329-5f21-3c48-912e-cc924487a708",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "009a66b4-66ff-482f-9b57-28aee6ced945",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Frau Hagener ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c08f2946-c160-47de-b654-8b78c1f0d6af",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Herr Hagener wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "35b322b7-f636-41d3-b459-97f4cb9709fe",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Die Hageners fahren heute ins Rheinland."
                            },
                            {
                                "example_id": "201ef6ed-c581-477f-ba5d-05e58bd5ba7d",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Der Hagener trägt nie die Schals, die die Hagener ihm strickt."
                            },
                            {
                                "example_id": "528f9f19-80d5-4513-aec4-2045822bf48a",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hagener kommt, geht der Herr Hagener.“"
                            },
                            {
                                "example_id": "bc42b3c4-a416-4aad-ad2c-1411a79775af",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Hagener kommt und geht."
                            },
                            {
                                "example_id": "35bd02ac-8f00-469d-8c9e-1ad7d1fd1d6f",
                                "sense_id": "d3888009-8bb3-394a-abe1-d92b3201353a",
                                "text": "Hageners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
