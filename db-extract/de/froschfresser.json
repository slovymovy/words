                "senses": [
                    {
                        "sense_id": "ddad89ae-31d7-3171-bd6b-5b696476bd53",
                        "entry_id": "8ed86ca4-bc9d-3cdd-963d-fa4a419ccd94",
                        "glosses": [
                            "Person französischer Abstammung"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "cd501829-5d9a-4507-8543-37fec11857e6",
                                "sense_id": "ddad89ae-31d7-3171-bd6b-5b696476bd53",
                                "text": "„Warum nennen sie Franzosen \"Froschfresser\", Politiker \"Volksverarscher\" und Sigmar Gabriel im Speziellen einen \"Ochsenfrosch\"?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8053d3bc-caae-4205-84a7-8b5281d1bb6b",
                        "source_entry_id": "8ed86ca4-bc9d-3cdd-963d-fa4a419ccd94",
                        "source_sense_id": "ddad89ae-31d7-3171-bd6b-5b696476bd53",
                        "source_sense_description": "abwertend, umgangssprachlich: Person französischer Abstammung",
                        "target_lang_word": "frogeater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frogeater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66eb31c5-9ad2-3291-9750-93a4b7a43453",
                                        "entry_id": "f90c4326-e5b1-3fec-8e30-c4853886cf13",
                                        "glosses": [
                                            "A French person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa1ee5e-213d-4fa2-a25d-2b8e21e77801",
                                                "sense_id": "66eb31c5-9ad2-3291-9750-93a4b7a43453",
                                                "text": "Of a great Institution like Smithfield, [the French] are unable to form the least conception. A Beast Market in the heart of Paris would be regarded an impossible nuisance. Nor have they any notion of slaughter-houses in the midst of a city. One of these benighted frog-eaters would scarcely understand your meaning, if you told him of the existence of such a British bulwark."
                                            },
                                            {
                                                "example_id": "344b369e-cc1a-4a3b-bc1b-e96732a854a5",
                                                "sense_id": "66eb31c5-9ad2-3291-9750-93a4b7a43453",
                                                "text": "Sir Andrew Ffoulkes is a gallant gentleman, you may take your Bible oath on that, but he that fights the murdering frogeaters single-handed is he whom they call The Scarlet Pimpernel: the bravest gentleman in all the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b4e12f0-b545-4820-82c8-266dc54104c0",
                        "source_entry_id": "8ed86ca4-bc9d-3cdd-963d-fa4a419ccd94",
                        "source_sense_id": "ddad89ae-31d7-3171-bd6b-5b696476bd53",
