                            {
                                "example_id": "384a5f16-bd29-4fc2-9df6-07125a77ed4e",
                                "sense_id": "3b9677d8-34fc-309e-9873-f5d6a961d6f8",
                                "text": "Corneille wordt op 3 juli 1922 als Guillaume Cornelis van Beverloo uit Nederlandse ouders in het Belgische Luik geboren. Als 17-jarige verhuist hij naar Haarlem. Later, in 1940, gaat hij naar Amsterdam, waar hij tot 1943 studeert aan de Kunstnijverheidsschool en een cursus tekenen en etsen volgt aan de Rijksacademie voor Beeldende Kunsten. Op die academie leert hij ook de latere schilder en beeldhouwer Karel Appel kennen."
                            },
                            {
                                "example_id": "785ff22c-101a-49c6-8d98-bde98f689bc7",
                                "sense_id": "3b9677d8-34fc-309e-9873-f5d6a961d6f8",
                                "text": "De tekenaar werd in 1935 geboren in Arnhem. In 1954 verhuisde hij naar Amsterdam, waar hij de opleiding Illustratie volgde aan de Kunstnijverheidsschool."
                            }
                        ]
