        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "255c3b3f-f1e7-312c-9301-fc340082eb67",
                    "sense_definition": "Participe présent de <w>ignorer</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout en <w>ignorant</w> les détails du plan, elle a accepté de participer au projet.",
                            "target_lang_translations": {
                                "en": "Despite <w>not knowing</w> the details of the plan, she agreed to take part in the project.",
                                "ru": "Не <w>зная</w> деталей плана, она согласилась участвовать в проекте.",
                                "de": "Obwohl sie die Einzelheiten des Plans nicht <w>kannte</w>, erklärte sie sich bereit, am Projekt teilzunehmen.",
                                "es": "<w>Ignorando</w> los detalles del plan, aceptó participar en el proyecto.",
                                "zh": "尽管<w>不了解</w>计划的细节，她还是答应参加了这个项目。"
                            }
                        },
                        {
                            "text": "C'est en <w>ignorant</w> les avertissements qu'il a fini par commettre cette grave erreur.",
                            "target_lang_translations": {
                                "en": "It was by <w>ignoring</w> the warnings that he ended up making this serious mistake.",
                                "ru": "Именно <w>игнорируя</w> предупреждения, он в конце концов допустил эту серьёзную ошибку.",
                                "de": "Weil er die Warnungen <w>ignorierte</w>, beging er schließlich diesen schweren Fehler.",
                                "es": "Fue <w>ignorando</w> las advertencias como acabó cometiendo este grave error.",
                                "zh": "他正是因为<w>无视</w>警告，才最终犯下了这个严重的错误。"
                            }
                        }
