                "senses": [
                    {
                        "sense_id": "d0a4a5dd-78cb-324d-a258-44b740e7c74b",
                        "entry_id": "ae28622d-19f0-32fb-9247-9706cfc52df0",
                        "glosses": [
                            "Qui échappe, qui a peu de durée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d675a0-a1c2-48fd-8c12-eb69fc6a456e",
                                "sense_id": "d0a4a5dd-78cb-324d-a258-44b740e7c74b",
                                "text": "Une sensation fugace."
                            },
                            {
                                "example_id": "719c1b92-fbc3-41aa-bed1-7738201f443d",
                                "sense_id": "d0a4a5dd-78cb-324d-a258-44b740e7c74b",
                                "text": "Je suis toujours debout avant le jour, et le vois lentement paraître. À cette heure où le parc et la maison n’existent que pour moi j’éprouve, plus que jamais, le sentiment qui m’est ici familier de vivre quelque chose d’éternel, mais aussi d’étonnamment fugace."
                            },
                            {
                                "example_id": "cb0ebc8c-6002-496f-992a-2f6b8214553f",
                                "sense_id": "d0a4a5dd-78cb-324d-a258-44b740e7c74b",
                                "text": "Un fugace moment d’union entre les deux voisins, techniquement toujours en guerre puisque le conflit qui les a opposés de 1950 à 1953 s’est soldé par un armistice et non un traité de paix."
                            }
                        ]
                    },
                    {
                        "sense_id": "971e084c-ab24-33b2-b472-e4c3d2f345de",
                        "entry_id": "ae28622d-19f0-32fb-9247-9706cfc52df0",
                        "glosses": [
                            "Qui laisse échapper."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d7a473dc-25e8-4bff-a27b-4eef1a3e54a9",
                                "sense_id": "971e084c-ab24-33b2-b472-e4c3d2f345de",
                                "text": "Une mémoire fugace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c739c9fb-1e92-454e-bd22-2c4b61c984e1",
                        "source_entry_id": "ae28622d-19f0-32fb-9247-9706cfc52df0",
                        "source_sense_description": "Qui échappe, qui a peu de durée",
                        "target_lang_word": "fleeting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleeting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a731de82-e212-37d7-a728-b8e4d10ecefc",
                                        "entry_id": "0bd075b0-9766-3833-8866-019f3cbe6437",
                                        "glosses": [
                                            "Passing quickly; of short duration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebe08cbf-e0a9-4ad2-8972-22c421627764",
                                                "sense_id": "a731de82-e212-37d7-a728-b8e4d10ecefc",
                                                "text": "Architecture, sculpture, painting are static arts. Even in literature \"our flying minds,\" as George Meredith says, cannot contain protracted description. It is so; for from sequences of words they must assemble all the details in one simultaneous impression. But moments of fleeting beauty too transient to be caught by any means less swift than light itself are registered on the screen."
                                            },
                                            {
                                                "example_id": "5629589f-9fa8-4de4-ab09-9380f0bf68b2",
                                                "sense_id": "a731de82-e212-37d7-a728-b8e4d10ecefc",
                                                "text": "As they passed, accelerating, on to the bridge and felt the first bite of the incline beyond, one had a fleeting glimpse of driver and fireman, illumined as by the fires of hell, the one tugging at the regulator handle, the other shovelling for dear life."
                                            },
                                            {
                                                "example_id": "1a0515ed-f794-461d-bb20-9552939df349",
                                                "sense_id": "a731de82-e212-37d7-a728-b8e4d10ecefc",
                                                "text": "During the fleeting summer months of his field season, when the outer vestiges of winter melted briefly, there were ponds and pools and lakes of water everywhere."
                                            },
                                            {
                                                "example_id": "63f12d1f-071b-4fd9-9c2a-efe658a76a4f",
                                                "sense_id": "a731de82-e212-37d7-a728-b8e4d10ecefc",
                                                "text": "For starters, we see examples all the time of some middle-aged men trying to hang onto their own fleeting youth by sporting younger women on their arms."
                                            },
                                            {
                                                "example_id": "4b168f99-767a-4ad1-ae2f-f0db03de48d4",
                                                "sense_id": "a731de82-e212-37d7-a728-b8e4d10ecefc",
                                                "text": "And I am inspired afresh to pursue the stunning beauty of Christ rather than the fleeting beauty of this world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fleeting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63d1733e-cc1a-3bfa-a81f-4e7153f7aa0a",
                                        "entry_id": "c2b81809-1f15-3a0c-8927-c3ac31fe14f1",
                                        "glosses": [
                                            "An automatic operation mode of an absolute signal that reserves a route for several trains following one another, without the need for dispatcher to re-set the route for each train."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fleeting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b7bc23-0ab3-3165-80dd-5ca12e8f7316",
                                        "entry_id": "1c82bb67-a1ef-3bad-b2dd-40917414bceb",
                                        "glosses": [
                                            "present participle and gerund of fleet"
