                    {
                        "sense_id": "d9dcae7f-5571-3e8c-b333-3dce35221a94",
                        "entry_id": "71fd671d-e027-373d-bd9d-4659f0da84b9",
                        "glosses": [
                            "Ergebnis, das durch Einsatz von geistiger/körperlicher Tätigkeit erreicht werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63f5530a-4d40-42fc-8141-9fef137296a2",
                                "sense_id": "d9dcae7f-5571-3e8c-b333-3dce35221a94",
                                "text": "Das Arbeitsziel des heutigen Tages ist es, einige Artikel auf Richtigkeit zu überprüfen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0310c6e-af6b-4b27-ab7b-c223dc42345f",
                        "source_entry_id": "71fd671d-e027-373d-bd9d-4659f0da84b9",
