                    {
                        "sense_id": "86d4d71e-38b0-3a28-866a-22a0677c8296",
                        "entry_id": "57cea46d-e2d3-3d2c-9322-5a784a33e325",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94bbd95-baa3-4f7a-bb6a-784c53e933c8",
                                "sense_id": "86d4d71e-38b0-3a28-866a-22a0677c8296",
                                "text": "Auf Veits Bauernhof kann man vortrefflich Urlaub machen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "034a15a6-41b5-43cf-a572-5db2c8545bc2",
                        "source_entry_id": "57cea46d-e2d3-3d2c-9322-5a784a33e325",
                        "source_sense_id": "86d4d71e-38b0-3a28-866a-22a0677c8296",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Guy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "766187d2-2544-30af-b01f-966d083731eb",
                                        "entry_id": "c7a5ab26-3b37-36d3-913b-d5352800725f",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691ae758-8d1c-4b6c-9754-e61755e6c552",
                                                "sense_id": "766187d2-2544-30af-b01f-966d083731eb",
                                                "text": "I am not Samson, nor Sir Guy, nor Colbrand,\n To mow 'em down before me;"
                                            },
                                            {
                                                "example_id": "76f1dd94-593c-4d32-9caf-7fa3dbb039c3",
                                                "sense_id": "766187d2-2544-30af-b01f-966d083731eb",
                                                "text": "\"Guy,\" he said. He said it slowly and with a certain puzzlement. He said it again, thoughtfully, as if it were a name of someone he had known long ago but couldn't quite place. \"Guy. Yes - don't you find it difficult being called that? I mean, if Nora hadn't said, I'd have put you down as a Kevin, or a Barry. Yes, Barry would suit you.\"\nHe looked like an innocent child, smiling, wide-eyed, his cheeks plump and rosy, defying the object of his insults to take offence. For they were insults, Guy was in no doubt about that. Leonora's brother was implying that his name was far too upper-class for its possessor."
                                            },
                                            {
                                                "example_id": "5cba02a3-fb97-4b3d-bc6e-d2d96a1345b9",
                                                "sense_id": "766187d2-2544-30af-b01f-966d083731eb",
                                                "text": "“She was a new student. I was a counterculture hero. Back then I went by a different name. Sebastian. Sexy, right? And so much better than Guy. You can't be a counterculture hero and a Guy. That name is way too average. […]"
                                            },
                                            {
                                                "example_id": "21d4c1cb-0427-4105-982c-3b10d09b32cc",
                                                "sense_id": "766187d2-2544-30af-b01f-966d083731eb",
                                                "text": "Authorities say Guy Bartkus, who was 25, set off an explosion in a car outside American Reproductive Centers, injuring five people and killing himself as well as causing extensive damage to the building in an act of terrorism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8c3599-6c84-30e2-bc6e-8fdfc6ecef91",
                                        "entry_id": "c7a5ab26-3b37-36d3-913b-d5352800725f",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
