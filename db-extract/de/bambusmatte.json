                "senses": [
                    {
                        "sense_id": "09b16207-c9ae-3bfd-9a2d-2eb64b19452d",
                        "entry_id": "5fb772f5-e1f8-31d3-8bee-b7886d180d22",
                        "glosses": [
                            "Matte aus Bambus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c5f2b7-b53a-4cfe-8fe4-ed911b1e20c9",
                                "sense_id": "09b16207-c9ae-3bfd-9a2d-2eb64b19452d",
                                "text": "„Jetzt bot sich ihm ein zunehmend ländlicher Ausblick: Bauern mit Tragestangen auf den Schultern, mit Bambusmatten oder Hühnerkäfigen beladene Radfahrer lenkten durch den Verkehr - einer hatte sogar ein Schwein auf dem Gepäckträger, Kinder ritten auf Büffeln, trieben sie von der Straße weg zu den Reisfeldern.“"
                            },
                            {
                                "example_id": "15b06d59-045f-42f4-a385-7d982981f075",
                                "sense_id": "09b16207-c9ae-3bfd-9a2d-2eb64b19452d",
                                "text": "„Ob es euch gefällt oder nicht, der Weg zur Hölle ist mit nachhaltigen Bambusmatten gepflastert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
