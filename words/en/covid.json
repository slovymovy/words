{
    "word_family": [
        "COVID-19",
        "long COVID",
        "post-COVID",
        "pre-COVID"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69e76446-180b-32ac-80af-58f5a16a8909",
                    "sense_definition": "Short for <w>COVID-19</w>, a highly contagious respiratory disease caused by a coronavirus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many businesses had to close temporarily because of the <w>covid</w> pandemic.",
                            "target_lang_translations": {
                                "ru": "Многим предприятиям пришлось временно закрыться из-за пандемии <w>ковида</w>.",
                                "zh": "由于<w>新冠</w>疫情，许多企业不得不暂时关闭。"
                            }
                        },
                        {
                            "text": "He stayed home from school because he tested positive for <w>covid</w>.",
                            "target_lang_translations": {
                                "ru": "Он остался дома и не пошел в школу, так как получил положительный тест на <w>ковид</w>.",
                                "zh": "他因为<w>新冠</w>检测呈阳性而没去学校，待在家里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "COVID-19",
                        "coronavirus"
                    ],
                    "common_phrases": [
                        "catch covid",
                        "have covid",
                        "covid test",
                        "long covid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от COVID-19, высокозаразного респираторного заболевания, вызываемого коронавирусом.",
                        "zh": "指COVID-19，一种由冠状病毒引起的具有高度传染性的呼吸道疾病。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковид",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "коронавирус",
                                "target_lang_sense_clarification": "распространенный синоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新冠",
                                "target_lang_sense_clarification": "最常用的口语简称"
                            },
                            {
                                "target_lang_word": "新冠肺炎",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "700ec5ca-1cfa-3e46-8bcc-902c2e06b04d",
                    "sense_definition": "An old unit of length used historically in India and China, approximately equal to a cubit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant measured the length of the cloth in <w>covids</w>.",
                            "target_lang_translations": {
                                "ru": "Купец измерял длину ткани в <w>ковидах</w>.",
                                "zh": "商人用<w>肘</w>来测量布料的长度。"
                            }
                        },
                        {
                            "text": "Ancient records describe the height of the wall as fifty <w>covids</w>.",
                            "target_lang_translations": {
                                "ru": "В древних записях высота стены указана как пятьдесят <w>ковидов</w>.",
                                "zh": "古代记录中将墙的高度描述为五十<w>肘</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cubit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "historical usage in Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная единица измерения длины, использовавшаяся в Индии и Китае, примерно равная локтю.",
                        "zh": "一种历史上在印度和中国使用的长度单位，约等于一肘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковид",
                                "target_lang_sense_clarification": "старин. мера длины в Индии и Китае (≈ локоть)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肘",
                                "target_lang_sense_clarification": "古代长度单位，约等于前臂长度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
