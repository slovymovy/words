            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c9fad82-b070-32b9-b7c3-836cc3c7b8bb",
                    "sense_definition": "iemand of iets dwingen om een bepaalde plaats te verlaten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wegsturen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten <w>verjoegen</w> met schoten in de lucht de betogers.",
                            "target_lang_translations": {
                                "en": "The soldiers <w>drove away</w> the protesters with shots in the air."
                            }
                        },
                        {
                            "text": "Ik gooide eerst een aantal stenen de struiken in om eventuele slangen te <w>verjagen</w>.",
                            "target_lang_translations": {
                                "en": "I first threw a few stones into the bushes to <w>scare off</w> any snakes."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdrijven",
                        "wegjagen",
                        "verstoten"
                    ],
                    "antonyms": [
                        "aantrekken",
                        "uitnodigen",
                        "verwelkomen"
                    ],
                    "common_phrases": [
                        "vogels verjagen",
                        "de vijand verjagen",
                        "iemand uit huis verjagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone or something to leave a certain place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drive away",
                                "target_lang_sense_clarification": "to force someone or something to leave"
                            },
                            {
                                "target_lang_word": "chase away",
                                "target_lang_sense_clarification": "to make someone or something go away by pursuing them"
                            },
                            {
                                "target_lang_word": "scare off",
                                "target_lang_sense_clarification": "to make someone or something leave by frightening them"
                            },
                            {
                                "target_lang_word": "expel",
                                "target_lang_sense_clarification": "to officially force someone to leave a place or organization"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86a9c581-4ce7-3734-9c32-cfd0c622509e",
                    "sense_definition": "het doen verdwijnen van een onaangenaam gevoel of een abstracte toestand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wegsturen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een vrolijk liedje kan de sombere gedachten in je hoofd snel <w>verjagen</w>.",
                            "target_lang_translations": {
                                "en": "A cheerful song can quickly <w>dispel</w> the gloomy thoughts in your head."
                            }
                        },
                        {
                            "text": "De warme zon van de zomer <w>verjaagt</w> de kou van de afgelopen winter.",
                            "target_lang_translations": {
                                "en": "The warm summer sun <w>banishes</w> the cold of the past winter."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdrijven",
                        "wegnemen"
                    ],
                    "common_phrases": [
                        "de angst verjagen",
                        "de verveling verjagen",
                        "zorgen verjagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make an unpleasant feeling or an abstract state disappear."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dispel",
                                "target_lang_sense_clarification": "to make a feeling, belief, or doubt disappear"
                            },
                            {
                                "target_lang_word": "banish",
                                "target_lang_sense_clarification": "to get rid of a thought or feeling completely"
                            },
                            {
                                "target_lang_word": "drive away",
                                "target_lang_sense_clarification": "to make a negative state or feeling go away"
                            },
                            {
                                "target_lang_word": "chase away",
                                "target_lang_sense_clarification": "to get rid of a mood or feeling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
