{
    "word_family": [
        "mat",
        "matte",
        "matting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "29ebaa41-b148-3dc5-9d7a-002822f91868",
                    "sense_definition": "Forming a thick, tangled, or knotted mass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tangled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog's fur was <w>matted</w> after playing in the woods all afternoon.",
                            "target_lang_translations": {
                                "zh": "在树林里玩了一下午后，那只狗的毛都<w>纠结</w>在一起了。"
                            }
                        },
                        {
                            "text": "She tried to brush the <w>matted</w> hair away from her face.",
                            "target_lang_translations": {
                                "zh": "她试图梳理开脸上<w>打结</w>的头发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tangled",
                        "knotted",
                        "entangled"
                    ],
                    "common_phrases": [
                        "matted hair",
                        "matted fur"
                    ],
                    "target_lang_definitions": {
                        "zh": "指毛发或纤维纠结在一起，形成厚重、打结的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纠结的",
                                "target_lang_sense_clarification": "形容毛发或线团缠绕在一起。"
                            },
                            {
                                "target_lang_word": "打结的",
                                "target_lang_sense_clarification": "形容毛发因疏于打理而形成的结。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e507b8-f04f-3f2c-b85f-a6b48893ecfd",
                    "sense_definition": "Covered with mats or floor coverings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "covered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hallway was <w>matted</w> with thick, woven rugs to keep the floor warm.",
                            "target_lang_translations": {
                                "zh": "走廊里<w>铺满</w>了厚厚的编织地毯，以保持地面温暖。"
                            }
                        },
                        {
                            "text": "They walked across the <w>matted</w> floor of the traditional tea room.",
                            "target_lang_translations": {
                                "zh": "他们走过传统茶室那铺着垫子的地面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "matted floor"
                    ],
                    "target_lang_definitions": {
                        "zh": "指地面铺设了垫子或地毯。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "铺满垫子的",
                                "target_lang_sense_clarification": "形容地面覆盖着垫子或地毯。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a65ee1c-5710-3fca-a1ae-c2e74a5f6be2",
                    "sense_definition": "Simple past and past participle of <w>mat</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tangled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet leaves had <w>matted</w> together on the ground.",
                            "target_lang_translations": {
                                "zh": "湿树叶在地上<w>纠结</w>在了一起。"
                            }
                        },
                        {
                            "text": "The long grass <w>matted</w> under the heavy rain.",
                            "target_lang_translations": {
                                "zh": "长草在暴雨下<w>纠结</w>成了一团。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使纠结在一起（mat的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使纠结",
                                "target_lang_sense_clarification": "指物体因受潮或挤压而缠绕在一起。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f87a367-1ea0-3b59-a686-16a6a8286481",
                    "sense_definition": "Simple past and past participle of <w>matt</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>matted</w> the photograph to remove the glossy reflection.",
                            "target_lang_translations": {
                                "zh": "艺术家为照片<w>装上</w>了衬纸，以消除反光。"
                            }
                        },
                        {
                            "text": "He <w>matted</w> the surface of the metal to give it a dull appearance.",
                            "target_lang_translations": {
                                "zh": "他将金属表面<w>处理成</w>哑光，使其看起来不那么亮。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "给照片或画作装上衬纸（matt的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "装衬纸",
                                "target_lang_sense_clarification": "指在艺术品周围加装衬纸以保护或装饰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02cda6ab-067a-3921-a58d-fc5b2c3aee3c",
                    "sense_definition": "Simple past and past participle of <w>matte</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer <w>matted</w> the paint to avoid glare on the walls.",
                            "target_lang_translations": {
                                "zh": "设计师将油漆<w>处理成</w>哑光，以避免墙面反光。"
                            }
                        },
                        {
                            "text": "She <w>matted</w> the finish of the car to make it look modern.",
                            "target_lang_translations": {
                                "zh": "她将车身漆面<w>处理成</w>哑光，使其看起来更现代。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使表面呈现哑光效果（matte的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使呈哑光",
                                "target_lang_sense_clarification": "指处理表面以消除光泽。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}