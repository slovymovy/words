{
    "word_family": [
        "frambozenstruik"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b0235b2-fb60-32d3-92f5-10e4e320a5ef",
                    "sense_definition": "Een eetbare vrucht van de frambozenstruik.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vrucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik eet graag een verse <w>framboos</w> bij het ontbijt.",
                            "target_lang_translations": {
                                "ru": "Я люблю есть свежую <w>малину</w> на завтрак."
                            }
                        },
                        {
                            "text": "Deze <w>framboos</w> is erg zoet en rijp.",
                            "target_lang_translations": {
                                "ru": "Эта <w>малина</w> очень сладкая и спелая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verse framboos"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобная ягода малинового куста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малина",
                                "target_lang_sense_clarification": "ягода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e98d4892-1003-369b-ad39-0f487305d444",
                    "sense_definition": "De struik die frambozen draagt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de tuin staat een grote <w>framboos</w> vol met vruchten.",
                            "target_lang_translations": {
                                "ru": "В саду растет большой куст <w>малины</w>, полный ягод."
                            }
                        },
                        {
                            "text": "De <w>framboos</w> heeft veel zonlicht nodig om goed te groeien.",
                            "target_lang_translations": {
                                "ru": "<w>Малине</w> нужно много солнечного света, чтобы хорошо расти."
                            }
                        }
                    ],
                    "synonyms": [
                        "frambozenstruik"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кустарник, на котором растут ягоды малины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малина",
                                "target_lang_sense_clarification": "кустарник"
                            },
                            {
                                "target_lang_word": "малинник",
                                "target_lang_sense_clarification": "заросли малины или куст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbebb990-81e0-33c9-9e20-b47da43bfcc9",
                    "sense_definition": "De roodachtige kleur van een framboos.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt een jurk in een mooie kleur <w>framboos</w>.",
                            "target_lang_translations": {
                                "ru": "На ней платье красивого <w>малинового</w> цвета."
                            }
                        },
                        {
                            "text": "De muren in de kamer zijn geschilderd in <w>framboos</w>.",
                            "target_lang_translations": {
                                "ru": "Стены в комнате покрашены в <w>малиновый</w> цвет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красноватый оттенок, напоминающий цвет ягоды малины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малиновый цвет",
                                "target_lang_sense_clarification": "оттенок красного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}