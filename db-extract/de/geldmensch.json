                        "examples": [
                            {
                                "example_id": "23dd4acf-5b63-496f-8881-2a447ac011ec",
                                "sense_id": "1948bf6b-63cf-32ef-98ed-17f6e4dc2ebe",
                                "text": "„Die Dichtung aller Dichter kann unmöglich nur einem Geldmenschen gehören; sie gehört der ganzen Menschheit.“"
                            },
                            {
                                "example_id": "1ed86c4f-baa6-4437-b95a-3b236cba449f",
                                "sense_id": "1948bf6b-63cf-32ef-98ed-17f6e4dc2ebe",
                                "text": "„Als unser Freund eintraf, umarmte der weißhaarige, elegante Geldmensch ihn mit Tränen in den Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
