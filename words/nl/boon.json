                {
                    "sense_id": "38c460ee-dead-342d-b50c-f52d661be418",
                    "sense_definition": "Het eetbare zaad van verschillende vlinderbloemige planten, of de peulvrucht als geheel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik lust graag een verse <w>boon</w> bij mijn aardappels.",
                            "target_lang_translations": {
                                "en": "I like a fresh <w>bean</w> with my potatoes.",
                                "ru": "Я люблю свежую <w>фасоль</w> к картофелю."
                            }
                        },
                        {
                            "text": "Zij kookt vanavond een heerlijke soep met <w>bonen</w> en spek.",
                            "target_lang_translations": {
                                "en": "She is cooking a delicious soup with <w>beans</w> and bacon tonight.",
                                "ru": "Сегодня вечером она готовит вкусный суп с <w>фасолью</w> и беконом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verse boon",
                        "bruine bonen",
                        "bonen eten"
                    ],
                    "target_lang_definitions": {
                        "en": "The edible seed of various leguminous plants, or the legume as a whole.",
                        "ru": "Съедобное семя различных бобовых растений или сам плод (стручок)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bean",
                                "target_lang_sense_clarification": "the edible seed or seedpod"
                            },
                            {
                                "target_lang_word": "haricot",
                                "target_lang_sense_clarification": "specifically the common bean"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "фасоль",
                                "target_lang_sense_clarification": "как вид овоща или семена"
                            },
                            {
                                "target_lang_word": "боб",
                                "target_lang_sense_clarification": "отдельное семя или плод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "726c2330-8efc-3210-99a5-ae05a99061e0",
                    "sense_definition": "Een plantensoort uit de familie van de vlinderbloemigen die eetbare peulvruchten voortbrengt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>boon</w> groeit dit jaar erg snel in onze moestuin.",
                            "target_lang_translations": {
                                "en": "The <w>bean plant</w> is growing very fast in our vegetable garden this year.",
                                "ru": "В этом году <w>фасоль</w> в нашем огороде растет очень быстро."
                            }
                        },
                        {
                            "text": "In de zomer krijgt deze <w>boon</w> prachtige witte bloemen.",
                            "target_lang_translations": {
                                "en": "In the summer, this <w>bean</w> gets beautiful white flowers.",
                                "ru": "Летом у этой <w>фасоли</w> появляются красивые белые цветы."
                            }
                        }
                    ],
                    "synonyms": [
