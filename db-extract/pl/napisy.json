                        "entry_id": "dc32d9eb-9a09-362e-9f3a-8cc37b76faac",
                        "glosses": [
                            "tekst wyświetlany na ekranie podczas projekcji filmu lub nadawania programu telewizyjnego w celu przetłumaczenia dialogów lub udostępnienia ich osobom niedosłyszącym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8065335d-5ea0-4241-a152-aea717bfa3f7",
                                "sense_id": "24ad36af-7d9a-3eea-9ae1-af18ac7bb152",
                                "text": "Na płycie niestety nie ma polskich napisów do tego filmu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5c10e079-baf8-3aff-ac9f-591a86c8e922",
                        "entry_id": "dc32d9eb-9a09-362e-9f3a-8cc37b76faac",
                        "glosses": [
                            "lista twórców filmu wyświetlana zwykle na jego zakończenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e0ddf7b-8efb-4898-9ce3-ea1e83fbafe7",
                                "sense_id": "5c10e079-baf8-3aff-ac9f-591a86c8e922",
                                "text": "Lubię zostawać w kinie do końca napisów, choć sala już pustoszeje."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
