        "fr-extract.jsonl": [
            {
                "entry_id": "f340975e-8963-3b8b-bcfb-afe3ceb0bcdc",
                "word": "huitante",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55df6cc2-badd-3078-b553-aa7d3b13572a",
                        "entry_id": "f340975e-8963-3b8b-bcfb-afe3ceb0bcdc",
                        "glosses": [
                            "Huit fois dix, 80."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a38bcf-6c33-4120-81a2-5a27f9624770",
                                "sense_id": "55df6cc2-badd-3078-b553-aa7d3b13572a",
                                "text": "L'Amirale, nommée la Lavia, de sept cens vingt-huit tonneaux, deux cens dix Soldats, huitante Serviteurs, trente pièces."
                            },
                            {
                                "example_id": "e48e3182-39f0-4dfb-967e-27fbaaa4ddce",
                                "sense_id": "55df6cc2-badd-3078-b553-aa7d3b13572a",
                                "text": "Ce n’est pas proprement une biographie: c’est l’éloge d’Agésilas, roi de Sparte, qui mourut l’an 361, âgé de huitante-quatre ans."
                            },
                            {
                                "example_id": "e9a5556b-d97a-4daa-bfa2-6d15fe1ebc03",
                                "sense_id": "55df6cc2-badd-3078-b553-aa7d3b13572a",
                                "text": "Un poids plume, et pourtant je pesais huitante kilos. Les misses m’abandonnaient, une fois la supercherie découverte."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "c3a20483-622b-4893-b34f-e76edfefbe26",
