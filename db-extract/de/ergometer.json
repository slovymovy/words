                ],
                "senses": [
                    {
                        "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                        "entry_id": "55bb040a-3651-3aa5-ad43-5c2b6cf7dd65",
                        "glosses": [
                            "Fitnessgerät, auf dem körperliche Leistungen genau definiert vorgegeben, erbracht und gemessen werden können"
                        ],
                        "tags": [
                            "Rehabilitation"
                        ],
                        "examples": [
                            {
                                "example_id": "4055045a-6f5e-4470-9ee1-4d13ef74540f",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Wir nutzen in der Rehabilitation Ergometer, die den Widerstand beim Treten drosseln, wenn der Puls des Patienten zu hoch ist.“"
                            },
                            {
                                "example_id": "9cc03cac-d33e-4ac0-bf68-986f670e917c",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Während der Proband auf dem Ergometer ins Schwitzen kommt, werden Blutdruck, Pulsfrequenz und die Milchsäure im Blut bei steigender Belastung fortlaufend gemessen.“"
                            },
                            {
                                "example_id": "4ede0239-4860-4115-ba12-075589c1a0c8",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Forscher der Medizinischen Hochschule Hannover (MHH) wollten herausfinden, was im Körper passiert, wenn man anfängt, regelmäßig Sport zu treiben. 67 Mitarbeiter der MHH mussten deshalb täglich eine halbe Stunde auf dem Ergometer radeln.“"
                            },
                            {
                                "example_id": "78b94aca-134d-41fe-9404-69d26a1ee6fa",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Wir testen bei unseren Probanden Horst (68 Jahre) und Jonas (22 Jahre) Ausdauer und Muskelkraft. Auf dem Ergometer müssen beide mit zunehmender Kraft treten, bis sie nicht mehr können.“"
                            },
                            {
                                "example_id": "24d87fa5-f046-4297-887a-057cbbcaa7a2",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Niklas fährt einen Leistungsdiagnostik-Test auf dem Ergometer, um zu sehen, wo die Belastungsgrenzen eines Amateursportlers liegen und was ein Profifahrer im Gegensatz dazu leistet.“"
                            },
                            {
                                "example_id": "5d09ea0b-db58-4fdb-b328-4f33017d2066",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "[Schweizer 800m-Läufer Jan Hochstrasser:] „Eine Entzündung im Knie zwang den Aargauer, seine Trainings umzustrukturieren und vermehrt ausdauernde Einheiten auf dem Ergometer (Hometrainer) zu absolvieren.“"
                            },
                            {
                                "example_id": "5151ff59-5b2a-44f0-9614-e5b023175372",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "[Lauritz Schoof] „aus Rendsburg in Schleswig-Holstein fiel 2006 bei einem Schul-Wettkampf auf dem Ergometer auf, als er bessere Werte erreichte als einige teilnehmende Schüler aus Rudervereinen.“"
                            },
                            {
                                "example_id": "feab3146-f71d-4127-91dd-2de47eb77558",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Der Westschweizer Ruderer Barnabé Delarze hat in Paris an der Indoor-WM die Silbermedaille gewonnen. Auf dem Ergometer verlor der Waadtländer auf den Sieger, den Russen Alexander Wjasowkin, über die Distanz von 2000 Metern mit einer persönlichen Bestleistung von 5:45,2 Minuten 1,7 Sekunden.“"
                            },
                            {
                                "example_id": "01800089-c90d-4013-8944-803a9d6dc436",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Mit dabei [Anmerkung: bei der 1. virtuellen Rad-WM] ist Jason Osborne. Eigentlich ist er Ruderer - und im Leichtgewichtszweier auch für die Olympischen Spiele in Tokio qualifiziert. Osborne mag aber auch die Schinderei auf dem Ergometer. Im vergangenen Jahr wurde er Weltmeister im Ergo-Rudern.“"
                            },
                            {
                                "example_id": "5c6ef3ce-fb2a-4215-b9a4-56af5d14f57c",
                                "sense_id": "8f469440-82d4-379f-8e87-3efd64ba3a08",
                                "text": "„Bastian Schweinsteiger sitzt auch am Dienstagmorgen wieder auf dem Ergometer im Fitnesszelt. Er radelt locker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
