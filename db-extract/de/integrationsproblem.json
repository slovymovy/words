                "senses": [
                    {
                        "sense_id": "069f3298-f28b-3af4-84ff-0e85848136d9",
                        "entry_id": "8fe8d6c8-a15e-39e4-96bd-98ebaccc56d5",
                        "glosses": [
                            "Schwierigkeit, Integration erfolgreich zu bewerkstelligen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "577c1da6-f465-4d2b-9919-287c6ecbbacb",
                                "sense_id": "069f3298-f28b-3af4-84ff-0e85848136d9",
                                "text": "„In manchen Fällen lassen sich die wahren Ursachen für die Integrationsprobleme nur schwer aufdecken.“"
                            },
                            {
                                "example_id": "c361f88b-957f-48f3-bf0a-0d0de27de772",
                                "sense_id": "069f3298-f28b-3af4-84ff-0e85848136d9",
                                "text": "„Amouröse Integrationsprobleme, die hier nach dem Bestseller von Hatice Akyün für das Kino adaptiert wurden, wurden aber mit ‚Almanya – Willkommen in Deutschland‘ sehr viel überzeugender, weil weniger mainstreambehaftet, produziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d52f3257-1cd3-367f-a4cb-ad5cb0eb0be3",
                        "entry_id": "8fe8d6c8-a15e-39e4-96bd-98ebaccc56d5",
                        "glosses": [
                            "Aufgabe, eine Stammfunktion zu ermitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be460fc-f084-45aa-b938-25d920594ca7",
                                "sense_id": "d52f3257-1cd3-367f-a4cb-ad5cb0eb0be3",
                                "text": "„Das Integrationsproblem gehört zu den Problemen, die am einfachsten beschrieben werden können: Wir haben eine Funktion f gegeben und suchen eine Funktion F, so dass die Ableitung von F wieder f ergibt: …“"
                            },
                            {
                                "example_id": "675ee2ce-c889-4616-9b2f-15863fa6534a",
                                "sense_id": "d52f3257-1cd3-367f-a4cb-ad5cb0eb0be3",
                                "text": "„Der Beitrag stellt wesentliche Verfahren zur numerischen Bestimmung des d-dimensionalen Riemannschen Integrals (numerisches Integrationsproblem) vor.“"
                            },
                            {
                                "example_id": "9e434b70-fe6f-476c-951c-b5ac422cda8d",
                                "sense_id": "d52f3257-1cd3-367f-a4cb-ad5cb0eb0be3",
                                "text": "„Mit anderen Worten: Kennt man eine Darstellung A=PJP⁻¹ mit der komplexen jordanschen Normalform J, so kann man exp (tA) für jedes t∈ℝ explizit ausrechnen, so dass zum Bestimmen von y(x)=e^((x-x_0)A)·y_0+∫_(x_0)ˣe⁽ˣ⁻ᵗ⁾ᴬg(t)rm dt nur noch das Integrationsproblem zu lösen ist, welches im homogenen Fall g=0 völlig entfällt.“"
                            },
                            {
                                "example_id": "edec7e68-a1e4-44e7-b2cf-60639a738393",
                                "sense_id": "d52f3257-1cd3-367f-a4cb-ad5cb0eb0be3",
                                "text": "„Ein Monte–Carlo Verfahren mit N Punkten liefert für ein mehrdimensionales Integrationsproblem mit Dimension d …“"
                            },
                            {
                                "example_id": "372a515e-8971-4335-9098-19b385a8d679",
                                "sense_id": "d52f3257-1cd3-367f-a4cb-ad5cb0eb0be3",
                                "text": "„Ein klein geschriebenes ‚e‘ wird von Mathematica als Bezeichner für eine unbekannte Variable interpretiert, was zu einem völlig anderen Integrationsproblem führt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
