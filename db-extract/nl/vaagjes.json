                "senses": [
                    {
                        "sense_id": "ed503d03-3bfb-3273-94a3-b4b5a3027da4",
                        "entry_id": "39bd7a41-d978-3329-b76e-158d3226c268",
                        "glosses": [
                            "op een onduidelijke manier, niet precies"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac600853-3bfc-4b74-8691-124659bb3b23",
                                "sense_id": "ed503d03-3bfb-3273-94a3-b4b5a3027da4",
                                "text": "Wat na een paar jaar van de satire overblijft, is een foto van een man die we niet kennen die vaagjes op Wilders lijkt."
                            },
                            {
                                "example_id": "f4acb54e-89e4-419b-b367-ea853c302418",
                                "sense_id": "ed503d03-3bfb-3273-94a3-b4b5a3027da4",
                                "text": "Het is of die nieuwe belasting zoo op eens uit de lucht is komen vallen. Men herinnert zich nog wel vaagjes, dat de couranten indertijd eens iets geschreven hebben over zegelrecht en registratie; — maar wie leest en volgt den inhoud van een artikel, als er zulke woorden is voorkomen!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1dd26c40-757c-3140-8a43-d106573f50de",
                        "entry_id": "39bd7a41-d978-3329-b76e-158d3226c268",
                        "glosses": [
                            "op een ongeconcentreerde manier, op oppervlakkige wijze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10bbdb1c-53b1-4381-a5f3-573f031d6f68",
                                "sense_id": "1dd26c40-757c-3140-8a43-d106573f50de",
                                "text": "(…) ik bepaalde mijn aandacht tot die koekjes. Tante Lieke had mij aangemoedigd om vooral lekker te snoepen. Ik volgde het gesprek vaagjes en boog me op gezette tijden naar de stopfles om er een koekje uit te nemen."
                            }
                        ]
                    }
