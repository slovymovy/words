                "translations": [
                    {
                        "translation_id": "a7e053b2-3098-4749-bc5b-4853c9da3f80",
                        "source_entry_id": "ae5703b5-fccd-31a6-b45c-7ce0764ec155",
                        "source_sense_id": "9c64b866-11e0-3304-bab4-abadef74282b",
                        "source_sense_description": "Medizin: gestörte und meist schmerzhafte Entleerung der Harnblase",
                        "target_lang_word": "dysuria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysuria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2d5dcd-0ae9-3358-bf30-609f0bd29beb",
                                        "entry_id": "3494ab28-07cf-3370-bf75-b9dbd98d0742",
                                        "glosses": [
                                            "The experience or condition of experiencing pain while discharging urine, or (rarely) of having difficulty doing so."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9833651a-1537-434b-9964-099d23c4bd4d",
                                                "sense_id": "0f2d5dcd-0ae9-3358-bf30-609f0bd29beb",
                                                "text": "A cystometrogram differentiates \"active\" and \"passive\" types of normal bladders, accounting for some instances of enuresis and mild forms of dysurias and, as prolonged bladder distention can be maintained at any point for any period, it is possible occasionally to use the cystometric procedure as a therapeutic agent to relieve dysurias due to a spastic bladder musculature."
                                            },
                                            {
                                                "example_id": "c9976e1f-ffe4-40b7-876e-c77fe835fa8b",
                                                "sense_id": "0f2d5dcd-0ae9-3358-bf30-609f0bd29beb",
                                                "text": "2009, Scott Kahan, Redonda Miller, Ellen G. Smith, Signs and Symptoms, 2nd Edition, Wolters Kluwer (Lippincott Williams & Wilkins), page 98,\nDysuria is a painful or burning sensation during or immediately after urination caused by irritation of the urothelium and its innervation. This is a common symptom in primary care: Nearly 20% of women aged 20–55 will have at least one episode of dysuria per year, resulting in more than 8 million physician office visits annually. Women have episodes of acute dysuria much more frequently than men."
                                            },
                                            {
                                                "example_id": "42cc29fb-eda9-4fc5-a87b-b114708c0f05",
                                                "sense_id": "0f2d5dcd-0ae9-3358-bf30-609f0bd29beb",
                                                "text": "Neurologic dysurias are among the most difficult to characterize and to treat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa22eb5d-2a80-41db-8648-6831109ba66f",
                        "source_entry_id": "ae5703b5-fccd-31a6-b45c-7ce0764ec155",
                        "source_sense_id": "9c64b866-11e0-3304-bab4-abadef74282b",
                        "source_sense_description": "Medizin: gestörte und meist schmerzhafte Entleerung der Harnblase",
                        "target_lang_word": "dysurie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysurie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "498e96ff-2782-31b5-82f1-e253c387a250",
                                        "entry_id": "a7e4dd30-adab-3e9f-a2da-17ee19b0397b",
                                        "glosses": [
                                            "Difficulté d’uriner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d576092c-d7a9-4702-94fe-2b1c23ad26d6",
                                                "sense_id": "498e96ff-2782-31b5-82f1-e253c387a250",
                                                "text": "La dysurie se définit comme une douleur à la miction provoquée par une irritation de l’urètre."
                                            },
                                            {
                                                "example_id": "4fda0430-7fb4-4aa3-8563-e7aa53159fb5",
                                                "sense_id": "498e96ff-2782-31b5-82f1-e253c387a250",
                                                "text": "Les plus fréquents symptômes sont les douleurs. Des douleurs (dysménorrhée) qui viennent pendant et après les règles, douleurs pendant les rapports sexuels (dyspareunie), douleurs pelviennes fréquentes, défécation douloureuse, difficulté pour uriner (dysurie), abdominales (ombilicales), douleurs pelviennes pouvant irradier jusque dans la jambe (cruralgie), etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
