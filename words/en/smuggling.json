{
    "word_family": [
        "smuggle",
        "smuggler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "422d2ce4-bb45-3ea4-afdb-9ea60167f52e",
                    "sense_definition": "The illegal movement of goods into or out of a country.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The border guards worked tirelessly to stop the illegal <w>smuggling</w> of goods across the border.",
                            "target_lang_translations": {
                                "ru": "Пограничники неустанно работали, чтобы остановить незаконную <w>контрабанду</w> товаров через границу."
                            }
                        },
                        {
                            "text": "He was arrested for drug <w>smuggling</w> at the airport yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в аэропорту его арестовали за <w>контрабанду</w> наркотиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "smugglery",
                        "contrabandism"
                    ],
                    "common_phrases": [
                        "drug smuggling",
                        "illegal smuggling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконное перемещение товаров через границу страны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контрабанда",
                                "target_lang_sense_clarification": "незаконный ввоз или вывоз товаров"
                            },
                            {
                                "target_lang_word": "контрабандный ввоз",
                                "target_lang_sense_clarification": "процесс ввоза нелегальных грузов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3645263-22d9-3792-92fc-8db8bd36b10e",
                    "sense_definition": "present participle and gerund of <w>smuggle</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She caught him <w>smuggling</w> food into the movie theater.",
                            "target_lang_translations": {
                                "ru": "Она поймала его на том, что он <w>тайком проносил</w> еду в кинотеатр."
                            }
                        },
                        {
                            "text": "They were caught <w>smuggling</w> contraband across the border.",
                            "target_lang_translations": {
                                "ru": " Их поймали при <w>провозе контрабанды</w> через границу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «проносить/провозить тайком» (smuggle)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провоз контрабандой",
                                "target_lang_sense_clarification": "действие по перемещению запрещенных вещей"
                            },
                            {
                                "target_lang_word": "тайный пронос",
                                "target_lang_sense_clarification": "пронос чего-либо сокрыто или нелегально"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}