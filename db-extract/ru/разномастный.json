                        "form": "разнома́стна"
                    },
                    {
                        "form_id": "a0745997-8e8f-4805-b826-0a5480ee93ba",
                        "entry_id": "37c7265c-9324-3bbd-aefa-2a00d96484fc",
                        "tags": [
                            "plural",
