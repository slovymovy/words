        "fr-extract.jsonl": [
            {
                "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                "word": "marcheuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "62a86051-3b66-4c53-bcf5-df28ac88bb2c",
                        "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                        "tags": [
                            "plural"
                        ],
                        "form": "marcheuses"
                    },
                    {
                        "form_id": "e8d689f0-57a3-4216-94fd-00b872d63e17",
                        "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                        "tags": [
                            "masculine"
                        ],
                        "form": "marcheur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35cf2a95-51f9-3ded-a970-7e24d8577fff",
                        "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                        "glosses": [
                            "Celle qui marche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440bec61-c8b6-4f14-9a5c-2d51fc979e4a",
                                "sense_id": "35cf2a95-51f9-3ded-a970-7e24d8577fff",
                                "text": "Il ressemblait encore moins au chasseur aimable et négligé qui avait été mon hôte aux Trembles, que Madeleine, avec la rosace étincelante de son corsage et sa magnifique chevelure étoilée de diamants, ne ressemblait à la modeste et intrépide marcheuse qui nous suivait, un mois auparavant, sous la pluie, les pieds dans la mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "c11e0f33-8119-32bd-ac1b-b143811c1159",
                        "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                        "glosses": [
                            "Prostituée qui marche en attendant les clients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82105431-5c33-46e7-a9f0-b493c0539e74",
                                "sense_id": "c11e0f33-8119-32bd-ac1b-b143811c1159",
                                "text": "Dans deux ans d’ici, cette créature vaudra soixante mille francs sur la place, elle sera rien ou tout, une grande danseuse ou une marcheuse, un nom célèbre ou une vulgaire courtisane."
                            },
                            {
                                "example_id": "9231ca63-12c4-4426-9a28-554e79cbbd19",
                                "sense_id": "c11e0f33-8119-32bd-ac1b-b143811c1159",
                                "text": "Tu vas surement rencontrer des étudiantes vénales occasionnelles, de celles qui bradent les prix bien en dessous de la marcheuse de belleville et de la fille de l’est séquestrée."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce2de245-098d-3d87-816b-a56fd4a4e8a6",
                        "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                        "glosses": [
                            "Dans un opéra ou une opérette, figurante qui évolue sur la scène sans chanter, sans parler ni danser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5abfaec3-212e-4fb8-ac73-9b03b93a1a08",
                                "sense_id": "ce2de245-098d-3d87-816b-a56fd4a4e8a6",
                                "text": "Artistes, machinistes, danseuses, marcheuses, figurants, choristes, abonnés, tout le monde interroge, crie, se bouscule."
                            }
                        ]
                    },
                    {
                        "sense_id": "192198c8-f561-367c-9788-ffd2592e778e",
                        "entry_id": "da5d5d82-b381-304f-811d-c12a864e8d81",
                        "glosses": [
                            "Athlète féminine spécialiste de la marche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619f7bfe-4a2a-445d-bd2e-8b119cb0a675",
                                "sense_id": "192198c8-f561-367c-9788-ffd2592e778e",
                                "text": "Malgré ce virage plutôt serré dans sa carrière et en attendant de voir comment les choses vont évoluer pour elle, Clémence Beretta vise toujours les JO de Paris en 2024. Avant cela, elle va chercher à se qualifier pour les prochains championnats du monde d’athlétisme (du 15 au 24 juillet à Eugène aux États-Unis), histoire de prouver qu’elle fait bien partie des meilleures marcheuses de la planète."
                            }
                        ]
                    }
