                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "054994b6-7c43-3ecc-81d9-8448af9bfcd8",
                        "entry_id": "b66107b1-fe45-3ece-9c36-92b371696f85",
                        "glosses": [
                            "schwach, kindlich, unreif wirkender junger Mann"
                        ],
                        "tags": [
                            "herablassend"
                        ],
                        "examples": [
                            {
                                "example_id": "491fb283-e785-4ef3-aae1-3e50b7b40798",
                                "sense_id": "054994b6-7c43-3ecc-81d9-8448af9bfcd8",
                                "text": "Diese halbe Portion will es mit mir aufnehmen? Den Bubi mach ich doch mit links fertig!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c124f78e-ca2f-44b9-8fd0-0dce1c7cf464",
                        "source_entry_id": "b66107b1-fe45-3ece-9c36-92b371696f85",
                        "source_sense_id": "0d7f257f-a5cb-3b1a-837f-523379fe7e02",
                        "source_sense_description": "verniedlichend: Junge, männliches Kind",
                        "target_lang_word": "freluquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freluquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e725260-3463-330a-93f0-e8c15eb45bfe",
                                        "entry_id": "f1a6bdd8-697c-3d3d-aeff-1a7bbe0134d2",
                                        "glosses": [
                                            "Petit poids en plomb qui sert, dans la fabrication des houppes, des glands, à retenir chaque brin pendant qu’on le passe et qu’on le fixe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31560971-49d1-39ae-a2ac-f4338a4358e8",
                                        "entry_id": "f1a6bdd8-697c-3d3d-aeff-1a7bbe0134d2",
                                        "glosses": [
                                            "Se dit d’un homme petit, mince, chétif, sans apparence. Il se dit aussi d’un homme frivole, prétentieux et sans mérite"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59e8330f-5627-4009-913a-b9a06061f9d5",
                                                "sense_id": "31560971-49d1-39ae-a2ac-f4338a4358e8",
                                                "text": "Ce n’est qu’un freluquet, un petit freluquet. Il est familier."
                                            },
                                            {
                                                "example_id": "6c0afb13-4bd1-4bb0-a183-274177c758d7",
                                                "sense_id": "31560971-49d1-39ae-a2ac-f4338a4358e8",
                                                "text": "C’est un homme de jugement. Il ne se croit pas obligé de suivre la mode comme les freluquets."
                                            },
                                            {
                                                "example_id": "f4c0f16c-43b6-4dac-ab69-6e720c2d8d1c",
                                                "sense_id": "31560971-49d1-39ae-a2ac-f4338a4358e8",
                                                "text": "Ce freluquet-là ! il en conte à toutes les femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a2a662-566f-35ec-b464-dba207fef486",
                                        "entry_id": "f1a6bdd8-697c-3d3d-aeff-1a7bbe0134d2",
                                        "glosses": [
                                            "Se dit aussi d'un animal, fluet, fragile, petit."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d97c8b5-4f24-4331-8804-1b61bedec792",
                                                "sense_id": "42a2a662-566f-35ec-b464-dba207fef486",
                                                "text": "« C'était vrai, cela ; elles devraient avoir un chien, quand ce ne serait que pour donner l'éveil. Pas un gros chien, Seigneur ! Que feraient-elles d'un gros chien ! Il les ruinerait en nourriture. Mais un petit chien (en Normandie, on prononce quin), un petit freluquet de quin qui jappe. »"
                                            },
                                            {
                                                "example_id": "76116479-58a4-4395-87fc-a7dccdaac863",
                                                "sense_id": "42a2a662-566f-35ec-b464-dba207fef486",
                                                "text": "Il eut bien lʼidée de se cacher à quatre pattes entre les fauteuils, voire de faire irruption juste devant eux en beuglant de toutes ses forces à ce freluquet ce quʼil pensait de son comportement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985a9528-35c9-3dca-a783-ac2f23c46dbb",
                                        "entry_id": "f1a6bdd8-697c-3d3d-aeff-1a7bbe0134d2",
                                        "glosses": [
                                            "Godelureau."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fc3c44-8987-43fe-80b8-6406076593d5",
                        "source_entry_id": "b66107b1-fe45-3ece-9c36-92b371696f85",
                        "source_sense_id": "0d7f257f-a5cb-3b1a-837f-523379fe7e02",
                        "source_sense_description": "verniedlichend: Junge, männliches Kind",
                        "target_lang_word": "jeunot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeunot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1adc55eb-d035-35a3-be30-77184dd51375",
                                        "entry_id": "720a7014-4873-374c-9d31-a0f1cd0c74da",
                                        "glosses": [
                                            "Jeune avec un trait affectueux ou péjoratif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6c4e2a-e5ce-4777-8626-af5b360e7497",
                                                "sense_id": "1adc55eb-d035-35a3-be30-77184dd51375",
                                                "text": "Elle est encore toute jeunotte et mais c'est une graine de star."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jeunot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db8b0675-9063-381f-ae00-e8a6a948f3ae",
                                        "entry_id": "edd2316e-8a6b-3884-a9e4-f4906f46db27",
                                        "glosses": [
                                            "Jeune."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93d6bca3-292a-48f7-82f2-7d50dba76d4e",
                                                "sense_id": "db8b0675-9063-381f-ae00-e8a6a948f3ae",
                                                "text": "Je suis d’une race où on n’a pas de sainte vierge et toi, compagnon, comme moi, tu ne vas pas souvent dans les églises, bien sûr, mais, tu sais, si tu te souviens de ton temps de jeunot, la belle figure qu’on y fait à la vierge de ces pays, comme regard et comme bras pliés pour tenir l’enfant, avec des courbes pareilles à celles des osiers quand on prépare la corbeille, comme épaules et comme tout, tu t’en souviens ?"
                                            },
                                            {
                                                "example_id": "e7254204-3b41-47e2-bbc8-f05280bdf75c",
                                                "sense_id": "db8b0675-9063-381f-ae00-e8a6a948f3ae",
                                                "text": "Et puis, avec ma nature de toujours m'attaquer aux fortiches, impossible de faire tomber un jeunot. À la boite, on rigolerait."
                                            },
                                            {
                                                "example_id": "c7a2127a-29a8-4f09-a4b4-7e89316247ac",
                                                "sense_id": "db8b0675-9063-381f-ae00-e8a6a948f3ae",
                                                "text": "Il appela un de ses copains, un jeunot coiffé d'une gapette américaine à viscope pointée vers le ciel."
                                            },
                                            {
                                                "example_id": "84b97043-5063-4785-a69f-f4060db7a4a7",
                                                "sense_id": "db8b0675-9063-381f-ae00-e8a6a948f3ae",
                                                "text": "Je m’introduisis dans l’établissement sans rien demander à quiconque et finis par dégotter un jeunot qui donnait furieusement l’impression de se barber à mille balles de l’heure, minimum garanti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10265111-7894-4bda-a006-176effd46108",
                        "source_entry_id": "b66107b1-fe45-3ece-9c36-92b371696f85",
                        "source_sense_id": "0d7f257f-a5cb-3b1a-837f-523379fe7e02",
