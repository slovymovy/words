                "senses": [
                    {
                        "sense_id": "066a9fc2-9854-38a4-b01e-2a4d17243030",
                        "entry_id": "c7a4b2dc-7c11-3ca0-a22e-f3fe7122b4ef",
                        "glosses": [
                            "Munir d’une crépine (filtre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0eddecb-04a9-4d20-a6fc-449ff39b3be1",
                                "sense_id": "066a9fc2-9854-38a4-b01e-2a4d17243030",
                                "text": "Or, on sait que l'usage est, dans la Marine, de crépiner les orifices à trois fois au moins la section normale du tuyau qui y aboutit ;"
                            },
                            {
                                "example_id": "4b7d05d3-5d60-402b-ae84-ecf8b85c8c45",
                                "sense_id": "066a9fc2-9854-38a4-b01e-2a4d17243030",
                                "text": "Les sondeurs, qui finissent de crépiner les derniers mètres décident de se retremper quelques jours « dans la civilisation », à Mopti."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8906286-7530-327c-bb4d-183c1fb863c7",
                        "entry_id": "c7a4b2dc-7c11-3ca0-a22e-f3fe7122b4ef",
                        "glosses": [
                            "Envelopper d'une crépine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d5039a-dff3-493f-bcf9-f5f2c5103c66",
                                "sense_id": "b8906286-7530-327c-bb4d-183c1fb863c7",
                                "text": "Crépiner et enfourner dans un four à 180°C pour colorer le dessus du pâté."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d613f82-7d2d-3915-8925-8517e5fb226e",
                        "entry_id": "c7a4b2dc-7c11-3ca0-a22e-f3fe7122b4ef",
                        "glosses": [
                            "Avoir l’apparence d’un réseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76588413-bb32-43b0-9962-051832fc919d",
                                "sense_id": "0d613f82-7d2d-3915-8925-8517e5fb226e",
                                "text": "Il lui tardait que les semences levassent pour recouvrir ces balafres qui jusqu’à l’horizon crépinaient la terre et jetaient sur l’âme pendant des semaines un filet tragique."
                            }
                        ]
                    }
                ],
