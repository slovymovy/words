                    {
                        "sense_id": "072bb0fc-91a9-387e-be2f-5c3fd681fbad",
                        "entry_id": "b6daabf5-fadf-39e2-9e75-02ee37c1ecce",
                        "glosses": [
                            "größerer Flugplatz, auf dem regelmäßig (kommerzieller) Flugverkehr stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd6ba5b-4111-423a-bf33-d2ef0ae6e9cc",
                                "sense_id": "072bb0fc-91a9-387e-be2f-5c3fd681fbad",
                                "text": "20 Millionen Passagiere wird der neue Airport zunächst bewältigen."
                            },
                            {
                                "example_id": "454de71e-e99a-444d-bd37-6ad63f0e543b",
                                "sense_id": "072bb0fc-91a9-387e-be2f-5c3fd681fbad",
                                "text": "„Ein Durchleuchten aller auf einem Airport oder Hafen ankommenden Container wird damit kaum möglich sein, denn es sind schlicht zu viele.“"
                            },
                            {
                                "example_id": "d2c42763-ed10-4223-8101-db4fe1f08f8e",
                                "sense_id": "072bb0fc-91a9-387e-be2f-5c3fd681fbad",
                                "text": "„Seine Gattin will ihn zum Airport begleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
