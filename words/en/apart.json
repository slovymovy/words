{
    "word_family": [
        "apartment",
        "apartness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ac66ecc3-972a-3378-bf9f-cf9b0808bacd",
                    "sense_definition": "Separated by a specific distance in time or space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two houses are about fifty meters <w>apart</w> on the same street.",
                            "target_lang_translations": {
                                "ru": "Эти два дома находятся примерно в пятидесяти метрах <w>друг от друга</w> на одной улице."
                            }
                        },
                        {
                            "text": "They were born only one year <w>apart</w> but look very different.",
                            "target_lang_translations": {
                                "ru": "Они родились с разницей всего в один год <w>друг от друга</w>, но выглядят очень по-разному."
                            }
                        }
                    ],
                    "synonyms": [
                        "separately"
                    ],
                    "antonyms": [
                        "together"
                    ],
                    "common_phrases": [
                        "years apart",
                        "miles apart",
                        "keep them apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "На определенном расстоянии друг от друга в пространстве или во времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "друг от друга",
                                "target_lang_sense_clarification": "о расстоянии или времени"
                            },
                            {
                                "target_lang_word": "отдельно",
                                "target_lang_sense_clarification": "в пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b32fe38d-3f2a-3381-8c9f-5383394dd55f",
                    "sense_definition": "Into several pieces or separate parts.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disassembly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to take the old clock <w>apart</w> to see how it worked.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>разобрать</w> старые часы, чтобы посмотреть, как они устроены."
                            }
                        },
                        {
                            "text": "The engine fell <w>apart</w> after years of neglect and poor maintenance.",
                            "target_lang_translations": {
                                "ru": "Двигатель <w>развалился на части</w> после многих лет небрежного обращения и плохого обслуживания."
                            }
                        }
                    ],
                    "synonyms": [
                        "asunder",
                        "piecemeal"
                    ],
                    "antonyms": [
                        "together"
                    ],
                    "common_phrases": [
                        "take it apart",
                        "fall apart",
                        "tear us apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "На несколько частей или отдельных фрагментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на части",
                                "target_lang_sense_clarification": "разобрать или развалиться"
                            },
                            {
                                "target_lang_word": "на куски",
                                "target_lang_sense_clarification": "физическое разделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f17437a4-e5ca-3fcb-9b0e-cd78ea7377cf",
                    "sense_definition": "Individually or separately rather than as a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to consider each of these issues <w>apart</w> from the others.",
                            "target_lang_translations": {
                                "ru": "Важно рассматривать каждый из этих вопросов <w>отдельно</w> от остальных."
                            }
                        },
                        {
                            "text": "The twins prefer to spend time <w>apart</w> to develop their own hobbies.",
                            "target_lang_translations": {
                                "ru": "Близнецы предпочитают проводить время <w>порознь</w>, чтобы развивать свои собственные хобби."
                            }
                        }
                    ],
                    "synonyms": [
                        "independently",
                        "separately",
                        "individually",
                        "singly"
                    ],
                    "antonyms": [
                        "together"
                    ],
                    "common_phrases": [
                        "living apart",
                        "standing apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Индивидуально или по отдельности, а не в группе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдельно",
                                "target_lang_sense_clarification": "не вместе"
                            },
                            {
                                "target_lang_word": "порознь",
                                "target_lang_sense_clarification": "каждый сам по себе"
                            },
                            {
                                "target_lang_word": "врозь",
                                "target_lang_sense_clarification": "не совместно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c915ed-b0dc-36ff-befe-42dcc666029b",
                    "sense_definition": "To one side; away from the main body or group.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood <w>apart</w> from the crowd, watching the parade in silence.",
                            "target_lang_translations": {
                                "ru": "Она стояла <w>в стороне</w> от толпы, молча наблюдая за парадом."
                            }
                        },
                        {
                            "text": "He set <w>apart</w> some money every month for his future travels.",
                            "target_lang_translations": {
                                "ru": "Он каждый месяц <w>откладывал</w> немного денег на свои будущие путешествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "aside"
                    ],
                    "common_phrases": [
                        "set apart",
                        "stand apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "В стороне; вдали от основной массы или группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в стороне",
                                "target_lang_sense_clarification": "отстраненно"
                            },
                            {
                                "target_lang_word": "особняком",
                                "target_lang_sense_clarification": "отдельно от других"
                            },
                            {
                                "target_lang_word": "обособленно",
                                "target_lang_sense_clarification": "в стороне от группы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6baefc49-85f1-38fb-94e0-575cd2e9a9bc",
                    "sense_definition": "Being in a state of disassembly or broken into pieces.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disassembly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toy was already <w>apart</w> when I found it on the floor.",
                            "target_lang_translations": {
                                "ru": "Игрушка была уже <w>разобрана</w>, когда я нашел ее на полу."
                            }
                        },
                        {
                            "text": "With the puzzle pieces <w>apart</w>, it was hard to see the picture.",
                            "target_lang_translations": {
                                "ru": "Когда детали пазла <w>разбросаны</w>, было трудно увидеть картинку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в разобранном состоянии или разломанный на части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в разобранном виде",
                                "target_lang_sense_clarification": "о механизмах или игрушках"
                            },
                            {
                                "target_lang_word": "разобранный",
                                "target_lang_sense_clarification": "не собранный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6355cbb9-c235-34a7-93b0-3cd3173db4e9",
                    "sense_definition": "Unique, distinct, or superior to others of the same kind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His incredible talent for music truly sets him in a class <w>apart</w>.",
                            "target_lang_translations": {
                                "ru": "Его невероятный музыкальный талант действительно ставит его <w>особняком</w>."
                            }
                        },
                        {
                            "text": "The quality of this handmade furniture is <w>apart</w> from mass-produced items.",
                            "target_lang_translations": {
                                "ru": "Качество этой мебели ручной работы стоит <w>отдельно</w> от товаров массового производства."
                            }
                        }
                    ],
                    "synonyms": [
                        "uniquely"
                    ],
                    "common_phrases": [
                        "class apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уникальный, отличный от других или превосходящий их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "особняком",
                                "target_lang_sense_clarification": "о выдающемся качестве"
                            },
                            {
                                "target_lang_word": "отдельно",
                                "target_lang_sense_clarification": "в плане категории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa9b0231-2dde-397f-b9ae-0c9e63023483",
                    "sense_definition": "Separate or kept to the side; private.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They shared an <w>apart</w> moment in the garden away from the guests.",
                            "target_lang_translations": {
                                "ru": "Они разделили <w>уединенный</w> момент в саду, вдали от гостей."
                            }
                        },
                        {
                            "text": "He whispered an <w>apart</w> comment that only she was meant to hear.",
                            "target_lang_translations": {
                                "ru": "Он прошептал <w>отдельное</w> замечание, которое должна была услышать только она."
                            }
                        }
                    ],
                    "synonyms": [
                        "aside"
                    ],
                    "common_phrases": [
                        "apart whisper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обособленный или отложенный в сторону; частный, личный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдельный",
                                "target_lang_sense_clarification": "обособленный"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "о моменте или комментарии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "f5101279-c3a8-3798-b3fd-01666d23308c",
                    "sense_definition": "Not including or considering something; aside from.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Joking <w>apart</w>, we really need to finish this project by tomorrow.",
                            "target_lang_translations": {
                                "ru": "Шутки <w>в сторону</w>, нам действительно нужно закончить этот проект к завтрашнему дню."
                            }
                        },
                        {
                            "text": "Cost <w>apart</w>, the location of the house is absolutely perfect for us.",
                            "target_lang_translations": {
                                "ru": "<w>Не считая</w> стоимости, расположение дома нам идеально подходит."
                            }
                        }
                    ],
                    "synonyms": [
                        "aside"
                    ],
                    "common_phrases": [
                        "joking apart",
                        "kidding apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не включая или не учитывая что-либо; помимо, не считая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не считая",
                                "target_lang_sense_clarification": "помимо чего-либо"
                            },
                            {
                                "target_lang_word": "помимо",
                                "target_lang_sense_clarification": "кроме этого"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}