                "senses": [
                    {
                        "sense_id": "23b4b8f3-4857-3681-bd78-2ec21524ef49",
                        "entry_id": "c4204292-0a2c-312f-a309-521d8c12b41e",
                        "glosses": [
                            "Schlüssel, der in allen Schlössern eines Schließsystems schließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d1e640-8027-4be7-9dc3-0305f5e0bf9c",
                                "sense_id": "23b4b8f3-4857-3681-bd78-2ec21524ef49",
                                "text": "Der Hausmeister hat einen Generalschlüssel."
                            },
                            {
                                "example_id": "980d298f-350d-4dd9-96f0-01ac85ff929e",
                                "sense_id": "23b4b8f3-4857-3681-bd78-2ec21524ef49",
                                "text": "„Sie ging zu ihrem Schreibtisch, zog die Schublade auf und nahm den Generalschlüssel zu ihrem Laden und ihrer Wohnung heraus, den sie schon für den passenden Moment bereitgelegt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
