                        "entry_id": "6d34bdd3-5752-3e28-8e71-8a211f35afad",
                        "glosses": [
                            "Pratiquer le jeûne du ramadan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1707cfbb-c118-4fa8-8bf2-2f21ee8f2031",
                                "sense_id": "6bf09c6a-2ad4-33ba-8686-61026a980192",
                                "text": "On ne saurait ramadaniser ailleurs que dans un pays musulman."
                            },
                            {
                                "example_id": "920c3451-a3d3-4dd9-8480-05382d0f1c9b",
                                "sense_id": "6bf09c6a-2ad4-33ba-8686-61026a980192",
                                "text": "Musulman, tu dois ramadaniser, c'est la règle absolue primitive."
                            },
                            {
                                "example_id": "c530cc17-6111-4c4a-bad1-a044fd67d12f",
                                "sense_id": "6bf09c6a-2ad4-33ba-8686-61026a980192",
                                "text": "T'as l'habitude de ramadaniser ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0d6f5f1a-82ee-3bfe-a3a1-4800753e907d",
