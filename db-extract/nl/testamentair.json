                                    {
                                        "sense_id": "2098de03-7759-391b-b3d9-8f780945d234",
                                        "entry_id": "9c28c827-2c72-30dd-96ef-40bf21198218",
                                        "glosses": [
                                            "of or pertaining to a will or testament"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54452486-1b60-467c-955b-910772df9ab2",
                                                "sense_id": "2098de03-7759-391b-b3d9-8f780945d234",
                                                "text": "Although such letter shall not be interpreted as a testamentary writing, I request that my beneficiaries and executor carry out the requests made in the letter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80aeb1c7-72cf-4bd5-b5c0-2bdbf3de3b63",
                        "source_entry_id": "b0711608-0623-3a7b-b599-d4101adbc1b7",
                        "source_sense_id": "5b04857f-15ac-3c28-a35c-ab4cba80493d",
                        "target_lang_word": "testamentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testamentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "621535b9-ace9-3573-a08b-ae5bb49fe4f2",
                                        "entry_id": "785d240d-1478-3748-8f19-287bb4775170",
                                        "glosses": [
                                            "Qui concerne un testament, qui a rapport à un testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "473e6560-bd00-4882-af63-b7bd2b6874c7",
                                                "sense_id": "621535b9-ace9-3573-a08b-ae5bb49fe4f2",
                                                "text": "Mon ami, dit-il tristement en revenant au malade, si vous avez quelques dispositions testamentaires à faire, faites-les."
                                            },
                                            {
                                                "example_id": "6ffc6bb4-9dfb-4446-a40f-b833803fe2f0",
                                                "sense_id": "621535b9-ace9-3573-a08b-ae5bb49fe4f2",
                                                "text": "Il s’allongea de nouveau, s’ingéniant à rédiger des clauses testamentaires en faveur d’Edna, pour la plupart, […] et à stipuler divers menus legs, avec des codicilles de plus en plus fantasques et extravagants…."
                                            },
                                            {
                                                "example_id": "4f549c1c-1fce-4d41-ac0f-c63793e078b1",
                                                "sense_id": "621535b9-ace9-3573-a08b-ae5bb49fe4f2",
                                                "text": "Le conjoint ne pourra exercer son droit que sur les biens dont le prédécédé n'aura disposé ni par acte entre vifs, ni par acte testamentaire, et sans préjudicier aux droits de réserve ni aux droits de retour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
