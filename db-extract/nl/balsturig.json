                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intractable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abdee0e9-926d-3908-8013-60ea6ef3b01f",
                                        "entry_id": "baf31fbe-a7c6-3852-9049-b013ad4c391d",
                                        "glosses": [
                                            "Not tractable; not able to be managed, controlled, governed or directed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f4be93b-b83d-4693-9ebc-903b5d21b81e",
                                                "sense_id": "abdee0e9-926d-3908-8013-60ea6ef3b01f",
                                                "text": "And I cannot but expect that this will repeatedly lead to the discovery that an initially intractable problem can be factored after all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1683455-cddd-3ab6-8792-fd30fe83526a",
                                        "entry_id": "baf31fbe-a7c6-3852-9049-b013ad4c391d",
                                        "glosses": [
                                            "(of a mathematical problem) Not able to be solved in polynomial time; too difficult to attempt to solve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77fdfd8d-4d56-3b12-99e7-9106c5d33691",
                                        "entry_id": "baf31fbe-a7c6-3852-9049-b013ad4c391d",
                                        "glosses": [
                                            "Difficult to deal with, solve, or manage. (of a problem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d40353d-a77c-4405-8808-3df202c35486",
                                                "sense_id": "77fdfd8d-4d56-3b12-99e7-9106c5d33691",
                                                "text": "Work—bureaucratic work in particular—poses a series of intractable dilemmas that often demand compromises with traditional moral beliefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afed8327-1822-3d09-b63a-b73b23f5bde0",
                                        "entry_id": "baf31fbe-a7c6-3852-9049-b013ad4c391d",
                                        "glosses": [
                                            "Stubborn; obstinate. (of a person)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f77f73e7-f6db-39a4-afd5-aed3caf25356",
                                        "entry_id": "baf31fbe-a7c6-3852-9049-b013ad4c391d",
                                        "glosses": [
                                            "Difficult to treat (of a medical condition)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78eb35ef-7750-438a-b559-270151fd9929",
                        "source_entry_id": "db32f266-7d36-3b9d-b243-fc26f907883c",
                        "source_sense_id": "5e35ec5c-70dd-3898-8254-0569e362d799",
                        "target_lang_word": "obstinate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Stubbornly adhering to an opinion, purpose, or course, usually with implied unreasonableness; persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e6830f-826b-4744-84cc-275678b29c99",
                                                "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                                "text": "From this consideration it is that we have derived the custom, in times of war, to punish […] those who are obstinate to defend a place that by the rules of war is not tenable […]"
                                            },
                                            {
                                                "example_id": "d6102396-742f-42ff-8d83-f9bfb9a11b8c",
                                                "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                                "text": "[…] the junior Osborne was quite as obstinate as the senior: when he wanted a thing, quite as firm in his resolution to get it; and quite as violent when angered, as his father in his most stern moments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b7564f-9761-30cc-93ec-c6843feef7ab",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Not easily subdued or removed."
                                        ],
                                        "tags": [
                                            "of inanimate things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2adf9b9-04f1-4b39-9225-860a03d9759f",
                                                "sense_id": "77b7564f-9761-30cc-93ec-c6843feef7ab",
                                                "text": "1925-29, Mahadev Desai (translator), M.K. Gandhi, The Story of My Experiments with Truth, Part IV, Chapter XXIX,\nNow it happened that Kasturbai […] had again begun getting haemorrhage, and the malady seemed to be obstinate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae82ed82-bce8-3b94-8180-94591f857740",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Typical of an obstinate person; fixed and unmoving."
                                        ],
                                        "tags": [
                                            "of a facial feature"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df7acbd-e454-4714-8817-688fc5029a15",
                                                "sense_id": "ae82ed82-bce8-3b94-8180-94591f857740",
                                                "text": "He had the same pile of curly hair, but he was clean-shaven with a heavy, obstinate jowl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "023b7b3b-12a6-487c-980f-f7110cff8630",
                        "source_entry_id": "db32f266-7d36-3b9d-b243-fc26f907883c",
                        "source_sense_id": "5e35ec5c-70dd-3898-8254-0569e362d799",
                        "target_lang_word": "refractory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refractory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "844aece0-5a41-3a4a-940e-62780309271b",
                                        "entry_id": "533dad95-3bd0-37ac-8d11-88207c0f1e2c",
                                        "glosses": [
                                            "Obstinate and unruly; strongly opposed to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a5ec18-a374-4762-8115-38274fa23474",
                                                "sense_id": "844aece0-5a41-3a4a-940e-62780309271b",
                                                "text": "[…] in most instances attempts to coerce the refractory and disobedient have been the signals of bloody wars, […]"
                                            },
                                            {
                                                "example_id": "fbbeb308-9b96-449b-8c9c-d9aa7b3633df",
                                                "sense_id": "844aece0-5a41-3a4a-940e-62780309271b",
                                                "text": "Mr. Weller knocked at the door, and after a pretty long interval—occupied by the party without, in whistling a tune, and by the party within, in persuading a refractory flat candle to allow itself to be lighted […]"
                                            },
                                            {
                                                "example_id": "6479a508-3061-4bd7-9f2d-bb2f2415a3a9",
                                                "sense_id": "844aece0-5a41-3a4a-940e-62780309271b",
                                                "text": "For five minutes Pollyanna worked swiftly, deftly, combing a refractory curl into fluffiness, perking up a drooping ruffle at the neck, or shaking a pillow into plumpness so that the head might have a better pose. Meanwhile the sick woman, frowning prodigiously, and openly scoffing at the whole procedure, was, in spite of herself, beginning to tingle with a feeling perilously near to excitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d197fda7-81ee-37e2-9508-b2f8e6493aeb",
                                        "entry_id": "533dad95-3bd0-37ac-8d11-88207c0f1e2c",
                                        "glosses": [
                                            "Not affected by great heat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57677023-621b-47e1-aa2f-e187d844e41e",
                                                "sense_id": "d197fda7-81ee-37e2-9508-b2f8e6493aeb",
                                                "text": "Pure lime is extremely refractory, but readily fusible if any silex is brought in contact with it; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "662ef9a2-3c69-3780-973f-61fc83274533",
                                        "entry_id": "533dad95-3bd0-37ac-8d11-88207c0f1e2c",
                                        "glosses": [
                                            "Resistant to treatment; not responding adequately to therapy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0dd4bef-7dae-4bc1-b428-e580ae8cea9c",
                                                "sense_id": "662ef9a2-3c69-3780-973f-61fc83274533",
                                                "text": "Many of the vague and refractory cases of neck and shoulder pain and of migraine may be due to cervical disc disease."
                                            },
                                            {
                                                "example_id": "57bc18aa-fa67-4cb8-ba4a-addc6a1fb9e8",
                                                "sense_id": "662ef9a2-3c69-3780-973f-61fc83274533",
                                                "text": "In 33 adult patients with long standing refractory epilepsy on treatment with one or two standard anti-convulsant drugs,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d73d435-1624-345c-b72f-db207b805662",
                                        "entry_id": "533dad95-3bd0-37ac-8d11-88207c0f1e2c",
                                        "glosses": [
                                            "Incapable of registering a reaction or stimulus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca957fcf-db2c-4477-9693-7898eee5fe66",
                                                "sense_id": "9d73d435-1624-345c-b72f-db207b805662",
                                                "text": "The production of a generator potential leaves a refractory state in the receptor membrane […]"
                                            },
                                            {
                                                "example_id": "75f3f727-71a6-4cc3-a647-990404f86471",
                                                "sense_id": "9d73d435-1624-345c-b72f-db207b805662",
                                                "text": "The […] delivery of external stimuli […] delineates the pacemaker refractory period after the emission of a pacing stimulus and after the sensing of a spontaneous beat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
