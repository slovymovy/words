                    },
                    {
                        "translation_id": "79e7af4f-b0b7-489c-ae4e-4cf6bac152d7",
                        "source_entry_id": "6296970d-2c20-3d67-b599-2e592f9026eb",
                        "target_lang_word": "Epikureer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epikureer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa933c76-fbdf-399f-9437-55ad1c2cb5eb",
                                        "entry_id": "85249ea9-1eee-3825-9835-d9bfb638035d",
                                        "glosses": [
                                            "ein Vertreter des Epikureismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f88ec6-e684-4b1b-a974-c2cbf098bd4e",
                                                "sense_id": "aa933c76-fbdf-399f-9437-55ad1c2cb5eb",
                                                "text": "Aus Sicht der Epikureer ist die Lust das höchste Gut."
                                            },
                                            {
                                                "example_id": "ccc4a653-09c5-47da-bf9a-3995c7a3c630",
                                                "sense_id": "aa933c76-fbdf-399f-9437-55ad1c2cb5eb",
                                                "text": "„Im Gegensatz zu den Stoikern interessierten sich die Epikureer nur wenig für Politik und Gesellschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c428f348-7723-3f46-bf0a-be74beaf2ee0",
                                        "entry_id": "85249ea9-1eee-3825-9835-d9bfb638035d",
                                        "glosses": [
                                            "jemand, der die Freuden des Daseins unbedenklich genießt; Genussmensch"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849a49b3-0e45-40a5-9578-a2f3ff5831b5",
                                                "sense_id": "c428f348-7723-3f46-bf0a-be74beaf2ee0",
                                                "text": "„Er war Epikureer und Christ, in dieser Reihenfolge, ein Mann des Glaubens, der an die Gastronomie und an Gott, an seine Frau und seine Kinder glaubte, und an die Franzosen und Amerikaner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "734347be-8dd6-4307-97a8-0c0d87083cc0",
                        "source_entry_id": "6296970d-2c20-3d67-b599-2e592f9026eb",
                        "target_lang_word": "epicurist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epicurist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5885098e-a22d-3154-98af-01c4555ab878",
                                        "entry_id": "c786e904-88f7-3609-999f-8683ed37d405",
                                        "glosses": [
                                            "volgeling van Epicurus, die leerde dat het geluk van personen het hoogste goed in het menselijk leven is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d6fff5-fbc2-4ecb-a403-0d2675640412",
                                                "sense_id": "5885098e-a22d-3154-98af-01c4555ab878",
                                                "text": "Ik zou meer in het verborgene willen gaan leven. ‘Lathe biosas’, zeiden de epicuristen. Leef onopvallend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad987e95-0b1b-35f9-bd5a-e73f7ab5bb9b",
                                        "entry_id": "c786e904-88f7-3609-999f-8683ed37d405",
                                        "glosses": [
                                            "genotzuchtig persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d79e95-0f7b-4bb4-8d48-0b9835e005e7",
                                                "sense_id": "ad987e95-0b1b-35f9-bd5a-e73f7ab5bb9b",
                                                "text": "De naam van Oskar Lafontaine - sociaal-democraat en bovendien epicurist - kwam natuurlijk ook voor. Want die houdt zeer van dames, hij is ook al voor de derde keer getrouwd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
