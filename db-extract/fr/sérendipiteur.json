                        "glosses": [
                            "Personne qui sait à un certain moment tirer profit de circonstances imprévues , et qui ne se laisse pas dominer par le hasard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef74c8f-250c-4ebd-9954-3a168138252f",
                                "sense_id": "0338a8a4-f4d3-3b0a-983d-7461ab5ade64",
                                "text": "Christophe Colomb constitue un parfait « sérendipiteur », mais pas Isaac Newton dont l’histoire de pomme est une légende. Le sérendipiteur est la personne qui sait « à un certain moment tirer profit de circonstances imprévues », et surtout ne se laisse pas dominer par le hasard (faux synonyme), énonce Danièle Bourcier, directrice de recherches au CNRS,"
                            }
                        ]
                    }
