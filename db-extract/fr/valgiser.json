                ],
                "senses": [
                    {
                        "sense_id": "b10ff47a-ff90-30c0-a516-4a0af22dd8ab",
                        "entry_id": "153ab578-7576-3300-8ad1-4053da1787c2",
                        "glosses": [
                            "Dévier vers l’extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3baa0e8-d534-4c8e-9c11-8f5e0bb75520",
                                "sense_id": "b10ff47a-ff90-30c0-a516-4a0af22dd8ab",
                                "text": "Le traitement de ces anomalies est délicat et consiste à stabiliser la hanche, à valgiser le fémur et l’allonger autant que faire se peut."
                            },
                            {
                                "example_id": "86252929-45b5-49c2-b642-ff3273258e42",
                                "sense_id": "b10ff47a-ff90-30c0-a516-4a0af22dd8ab",
                                "text": "Les problèmes rotationnels comme dans la scoliose ou l’insuffisance de rotation externe obligent le pied à valgiser pour passer le pas."
                            },
                            {
                                "example_id": "86fb15c1-4df2-42b6-b887-0de0d1bd67e9",
                                "sense_id": "b10ff47a-ff90-30c0-a516-4a0af22dd8ab",
                                "text": "Les modifications débutent au niveau du pied où l’articulation sous-talienne permet non seulement au calcanéum de se valgiser ou de se variser, mais, grâce au couplage fonctionnel avec le médiopied (symbolisé par l’axe de Henke), il entraîne une chute ou une élévation de ce dernier dont la clef de voûte est l’os naviculaire (scaphoïde tarsien)."
                            }
                        ]
                    }
                ],
