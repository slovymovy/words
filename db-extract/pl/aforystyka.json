                    {
                        "translation_id": "66cd3ce6-db59-4756-a98f-1fc1e6f98692",
                        "source_entry_id": "1e0e7a28-3945-3831-8c52-db214ec399ad",
                        "source_sense_id": "976e8a42-ab32-3e24-99f8-0a8901b3019d",
                        "source_sense_description": "Literatur: aphoristischer Stil",
                        "target_lang_word": "Stil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e58cdcfd-0e41-3c3b-9cd5-725b287f8d39",
                                        "entry_id": "788069cc-bd73-3980-8bd7-8ed6cda25980",
                                        "glosses": [
                                            "besondere Gestaltungsweise (in Kunst, Leben, Sport und so weiter)"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b877bfb-ad24-4fee-bb87-4d903d79cab4",
                                                "sense_id": "e58cdcfd-0e41-3c3b-9cd5-725b287f8d39",
                                                "text": "Zum guten Stil beim Verfassen von Werken gehören Einleitung und Ausklang."
                                            },
                                            {
                                                "example_id": "2acf18ea-946b-4293-a8dc-9c46d04788f4",
                                                "sense_id": "e58cdcfd-0e41-3c3b-9cd5-725b287f8d39",
                                                "text": "Viele berühmte Maler entwickeln ihren eigenen Stil."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03d346e5-fc1d-353a-a195-d21e2acdd53f",
                                        "entry_id": "788069cc-bd73-3980-8bd7-8ed6cda25980",
                                        "glosses": [
                                            "spezielle Auswahl sprachlicher Mittel bei der Gestaltung eines Textes"
                                        ],
                                        "tags": [
                                            "insbesondere",
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5773ba-45e4-4021-b659-da1206c96b4b",
                                                "sense_id": "03d346e5-fc1d-353a-a195-d21e2acdd53f",
                                                "text": "Jeder Text weist seinen eigenen Stil auf."
                                            },
                                            {
                                                "example_id": "7b604da5-400b-49e0-9491-a68515a38d87",
                                                "sense_id": "03d346e5-fc1d-353a-a195-d21e2acdd53f",
                                                "text": "„Stil ist eine Sache der Erfahrung. Das heißt aber: Stil ist ein Prozess und kein Zustand.“"
                                            },
                                            {
                                                "example_id": "73f6c45c-0783-425e-8f25-72712780a765",
                                                "sense_id": "03d346e5-fc1d-353a-a195-d21e2acdd53f",
                                                "text": "„Oben wurde die Varietät der Umgangssprache als Stil des Alltagsverkehrs gekennzeichnet.“"
