                                        "entry_id": "bb9c58f3-bba3-3787-927a-7038f7a2c1a9",
                                        "glosses": [
                                            "Zapfen, mit dem die Öffnung eines Fasses (Spundloch) verschlossen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16728dd-64fc-45e9-af5d-ae6de21d848b",
                                                "sense_id": "c9715438-dcc4-3f18-b4e5-61bc7f92635f",
                                                "text": "Nun kommt die Hefe ins Spiel, die den Zucker in Alkohol verwandelt. Bei vier Litern Bier reichen ein paar Gramm. Theresa hat dafür ein Gärgefäß aus Glas; ein Spund als Flaschenverschluss sorgt dafür, dass Kohlendioxid entweichen kann, ohne dass Schmutz ins Bier kommt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4dc98bc9-f885-3945-b323-a19e5fa16c39",
                                        "entry_id": "bb9c58f3-bba3-3787-927a-7038f7a2c1a9",
                                        "glosses": [
                                            "dünne Leiste an einem Brett, die in eine Vertiefung (Nut) eines anderen Bretts geführt wird und so die Bretter verbindet"
                                        ],
                                        "tags": [
                                            "Holzverarbeitung"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Spund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e54b44e6-b8d1-3599-b370-d0a1f4779353",
                                        "entry_id": "0add2c35-487a-30c9-b015-edca3fd36a7d",
                                        "glosses": [
                                            "junger, noch unreifer, unerfahrener Mann"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4db88a9-5653-48c2-9d61-41ab4a30b2b9",
                                                "sense_id": "e54b44e6-b8d1-3599-b370-d0a1f4779353",
                                                "text": "„Also als ich so ein junger Spund war, da hab ich Morgen für Morgen kalt gebadet, Winter wie Sommer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
