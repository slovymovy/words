                "senses": [
                    {
                        "sense_id": "8cfa5e00-f557-385f-9f12-17eaf7251895",
                        "entry_id": "a3b7cf1a-af14-3a4f-8502-a37246e01f92",
                        "glosses": [
                            "связанный с первым апреля, происходящий первого апреля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee612412-4f22-4a3b-8992-d61bc7a7adcc",
                                "sense_id": "8cfa5e00-f557-385f-9f12-17eaf7251895",
                                "text": "Ветерок перелистывал валявшийся на подоконнике первоапрельский (уже старый) номер журнала с фотографией найденных рук Милосской Венеры."
                            },
                            {
                                "example_id": "d737aea9-1e45-4acd-ac55-97ff59b8f1e1",
                                "sense_id": "8cfa5e00-f557-385f-9f12-17eaf7251895",
                                "text": "Жуткое дело: сегодня что ни напиши, вы всё сочтете первоапрельской шуточкой."
                            }
                        ]
                    }
