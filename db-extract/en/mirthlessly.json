                        "glosses": [
                            "In a mirthless manner; sadly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47dcdbd2-aff3-4a22-b1f5-9b6a82ea4d7c",
                                "sense_id": "bf2a8482-06a4-3e01-88e5-eeb76ab561e1",
                                "text": "Miriam laughed again, but mirthlessly, to hear him thus mix her up with women in a general way."
                            },
                            {
                                "example_id": "d77408c1-475a-4d58-9399-fbdeda9d3a32",
                                "sense_id": "bf2a8482-06a4-3e01-88e5-eeb76ab561e1",
                                "text": "And presently he grew conscious that the gods had played a very good practical joke on him, and he laughed at himself mirthlessly."
                            }
                        ]
                    }
                ],
