                    {
                        "sense_id": "0b3f4cb8-e4ca-3fd4-9e1b-444f5ff40354",
                        "entry_id": "db889b1b-8fbe-310d-9823-b32d4b6d78af",
                        "glosses": [
                            "Person, die an einer Kunstakademie oder Hochschule Kunst studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0f82e9-9128-4b2e-a5db-70a57f88cbb9",
                                "sense_id": "0b3f4cb8-e4ca-3fd4-9e1b-444f5ff40354",
                                "text": "„Der als Christo Vladimirov Javacheff am 13. Juni 1935 im bulgarischen Gabrovo geborene Künstler floh bereits als junger Kunststudent aus der sozialistischen Volksrepublik in den Westen und lebte in Wien, Paris und schließlich in New York.“"
                            },
                            {
                                "example_id": "d9dcf78f-f6a0-4dd6-a592-4a238317156f",
                                "sense_id": "0b3f4cb8-e4ca-3fd4-9e1b-444f5ff40354",
                                "text": "„Doch was dem alten Mann nur noch ein ironisches Lächeln wert war, hatte dem jungen Kunststudenten damals eine große Enttäuschung bereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
