                "senses": [
                    {
                        "sense_id": "627b9368-c37e-364f-a93e-f8d68b15c0c2",
                        "entry_id": "00a953ee-439b-318b-8f9e-fc5c0254d09a",
                        "glosses": [
                            "A person who practices a profession or art, especially law or medicine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343245a8-b860-4067-ab9d-671338165aff",
                                "sense_id": "627b9368-c37e-364f-a93e-f8d68b15c0c2",
                                "text": "The [Isaac] Newton that emerges from the [unpublished] manuscripts is far from the popular image of a rational practitioner of cold and pure reason. The architect of modern science was himself not very modern. He was obsessed with alchemy."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b8d136b-225e-35bd-9db9-ee03a7053e7a",
                        "entry_id": "00a953ee-439b-318b-8f9e-fc5c0254d09a",
                        "glosses": [
                            "One who does anything customarily or habitually."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaae166f-8990-46ff-b384-8d903b2dd5cd",
                                "sense_id": "0b8d136b-225e-35bd-9db9-ee03a7053e7a",
                                "text": "On January 31, 2023, four Falun Gong practitioners in Songbu Town, Macheng City, Hubei Province were arrested. Two of the arrested are still detained as of February 25, 2023."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cd5037a-7998-3973-8b59-ea5ccf3e36ea",
                        "entry_id": "00a953ee-439b-318b-8f9e-fc5c0254d09a",
                        "glosses": [
                            "A sly or artful person."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "64267864-753c-4132-81ef-d4b6b64929aa",
                                "sense_id": "2cd5037a-7998-3973-8b59-ea5ccf3e36ea",
                                "text": "[…] the men of St. John's were cunning practitioners, in shaking off their Masters and Heads."
                            }
                        ]
                    }
                ],
