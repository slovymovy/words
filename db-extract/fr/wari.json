                ],
                "senses": [
                    {
                        "sense_id": "5cd1eef9-8ce7-39da-b253-182a4b0b0e33",
                        "entry_id": "e64b5b22-7a7c-39af-9ef0-9f44932d9ab2",
                        "glosses": [
                            "Hybride obtenu entre un lama et un alpaga. C’est un animal stérile et de stature plus faible que ses parents."
                        ],
                        "tags": [
                            "Camélologie",
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dd33fc81-e90e-47ec-b226-52ca0394de47",
                                "sense_id": "5cd1eef9-8ce7-39da-b253-182a4b0b0e33",
                                "text": "On appelle wari le croisement de l’alpaca et du lama. En général il s’agit d’un lama mâle et d’un alpaca femelle."
                            },
                            {
                                "example_id": "29641c31-b54e-4327-aed3-563a19f17c2b",
                                "sense_id": "5cd1eef9-8ce7-39da-b253-182a4b0b0e33",
                                "text": "Toujours selon des sources coloniales, le wari est un camélidé qui résulte du croisement de la paqocha (alpaca) avec le lama."
                            }
                        ]
                    }
                ],
