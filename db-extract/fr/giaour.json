                                                "sense_id": "65346ff5-f0ab-33e4-b771-e07d0871a47a",
                                                "text": "Gâvurun bana bir at parası vermeden kalkıp gidecek mi?"
                                            },
                                            {
                                                "example_id": "0b797e4c-d261-4638-9057-598fbaf8940e",
                                                "sense_id": "65346ff5-f0ab-33e4-b771-e07d0871a47a",
                                                "text": "Onca yıl gurbetin kahrını, gâvurun ağzının kokusunu çekmiştik."
                                            }
                                        ]
                                    }
