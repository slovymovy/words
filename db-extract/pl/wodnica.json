                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waterline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13acdc05-cccd-3744-b6c9-841d3a3ac74d",
                                        "entry_id": "e3be59a9-5521-3fa9-b1f7-c75beaa47d40",
                                        "glosses": [
                                            "A line formed by the surface of the water on the hull of a ship when she is afloat; any of a series of short lines marked on the hull to show where the waterline would be under different loadings"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be890600-cb7e-3f3b-aeec-0124c8c1e656",
                                        "entry_id": "e3be59a9-5521-3fa9-b1f7-c75beaa47d40",
                                        "glosses": [
                                            "A horizontal line indicating the shape of an airfoil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45f48528-82e6-39d6-9ef7-30312419c089",
                                        "entry_id": "e3be59a9-5521-3fa9-b1f7-c75beaa47d40",
                                        "glosses": [
                                            "A line showing where the water has been, usually a line separating dry land and wet areas; a watermark or tidemark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420b82e8-e84a-489d-a946-6e424e583e64",
                                                "sense_id": "45f48528-82e6-39d6-9ef7-30312419c089",
                                                "text": "Down here along the waterline, the Enterprise has a belt of thick antitorpedo armor. It's not too promising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89014ce3-11fe-3fb9-9ccd-fa38b455cce9",
                                        "entry_id": "e3be59a9-5521-3fa9-b1f7-c75beaa47d40",
                                        "glosses": [
                                            "The inner rim of the eyelid, just behind the lash line; primarily used in reference to the application of eyeliner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "722f25ca-ae80-4358-b9d7-8347222871ec",
                        "source_entry_id": "037b7d70-009c-39a6-b7cd-cbce32050d7c",
                        "source_sense_id": "3c7f1408-c250-33e2-8959-baf18fa8181e",
                        "target_lang_word": "Wasserlinie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserlinie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                        "entry_id": "b0731447-85ce-3e37-a377-fad48bbbfb5f",
                                        "glosses": [
                                            "Linie, bis zu der ein Schiffsrumpf ins Wasser einsinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22776537-c6b4-4194-ab31-87a31293e81b",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "Das Schiff wurde durch einen Torpedo direkt unter der Wasserlinie getroffen."
                                            },
                                            {
                                                "example_id": "c03fafed-14d3-494e-8fa4-9b7b7a220ad3",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Der erste Torpedo traf tief unter der Wasserlinie den Bug des Schiffes dort, wo die Mannschaftsräume lagen.“"
                                            },
                                            {
                                                "example_id": "2e90bc7b-b76d-4af9-8671-e443dafaf866",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Dieser sollte als Rammsporn dienen, feindliche Schiffe unter der Wasserlinie leck schlagen und versenken.“"
                                            },
                                            {
                                                "example_id": "3a63d4bf-6f6e-42b9-8cac-843080cc8a69",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Das Fenster liegt einen knappen Meter über der Wasserlinie.“"
                                            },
                                            {
                                                "example_id": "ebc2089e-2a41-4fc6-819c-e9a278c3a218",
                                                "sense_id": "57943589-c299-3c18-af67-a013b189b5ce",
                                                "text": "„Der Reporter erklärte, dass die Staumauer am oberen Ende beschädigt sei und der Schaden sich glücklicherweise nur bis etwa zwei Meter unter die Wasserlinie erstrecke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
