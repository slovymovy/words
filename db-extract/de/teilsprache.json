                ],
                "senses": [
                    {
                        "sense_id": "03e2580a-d820-395a-93bf-10c852f8d369",
                        "entry_id": "67f69567-078d-3db9-8a01-de0c2c9a1dca",
                        "glosses": [
                            "spezifische Ausprägung einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dba01ec-cf71-40b4-a026-5893595e9981",
                                "sense_id": "03e2580a-d820-395a-93bf-10c852f8d369",
                                "text": "„Die deutsche Sprache besteht aus vielen unterschiedlichen Teilsprachen.“"
                            },
                            {
                                "example_id": "46994498-fd4d-4d97-bc3c-ebdb1839c06a",
                                "sense_id": "03e2580a-d820-395a-93bf-10c852f8d369",
                                "text": "„Sie ist eine Teilsprache, die nur einem jeweils begrenzten Kreis der Sprachgemeinschaft geläufig und verständlich ist.“"
                            },
                            {
                                "example_id": "25956b51-2607-400a-87b1-248bc5882d74",
                                "sense_id": "03e2580a-d820-395a-93bf-10c852f8d369",
                                "text": "„In der deutschen sprachwissenschaftlichen Forschung erscheinen noch teilweise Benennungen wie Arbeitssprache, Berufssprache, Gruppensprache, Handwerkersprache, Sekundärsprache, Sondersprache, Standessprache oder Teilsprache, die Fachsprachen bezeichnen.“"
                            },
                            {
                                "example_id": "d58a9072-e19b-429c-9532-ed75fada0cd9",
                                "sense_id": "03e2580a-d820-395a-93bf-10c852f8d369",
                                "text": "„Auch diese Teilsprache ist kein völlig isoliertes Subsystem einer natürlichen Sprache – die meisten Worter einer natürlichen Sprache werden dann und wann gebraucht, wenn man moralische Urteile fällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c23d0263-1579-3a8c-9659-4e1767e5117f",
                        "entry_id": "67f69567-078d-3db9-8a01-de0c2c9a1dca",
                        "glosses": [
                            "bestimmte Sprache als Vertreterin einer Sprachgruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23cc1d7-54a1-48ca-82d7-fb41f9a89868",
                                "sense_id": "c23d0263-1579-3a8c-9659-4e1767e5117f",
                                "text": "„Als Hebräisch gilt die kanaanäische Teilsprache des nordwestlichen Zweigs der semitischen Sprache.“"
                            },
                            {
                                "example_id": "6a5e895f-7dc6-40c2-bece-a7e973c7bcbb",
                                "sense_id": "c23d0263-1579-3a8c-9659-4e1767e5117f",
                                "text": "„In dieses Gesamtbild fügt sich auch das Verbalsystem der drei rätoromanischen Teilsprachen: ...“"
                            },
                            {
                                "example_id": "f4f1167d-4c39-4290-9800-6d3c7321ae83",
                                "sense_id": "c23d0263-1579-3a8c-9659-4e1767e5117f",
                                "text": "„Die nordostkaukasischen Sprachen (auch nachisch-dagestanische Sprachen) sind eine Sprachfamilie, deren Teilsprachen vor allem in den autonomen Republiken Tschetschenien, Inguschetien, Dagestan (Russische Föderation) sowie in geringer Zahl in Aserbaidschan und Georgien gesprochen werden.“"
                            },
                            {
                                "example_id": "cd3bf1e4-02de-4267-9dd5-72f848ea18b6",
                                "sense_id": "c23d0263-1579-3a8c-9659-4e1767e5117f",
                                "text": "„Pro Teilsprache belaufen sich diese auf rund 500.000 Euro pro Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
