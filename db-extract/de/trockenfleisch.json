                "senses": [
                    {
                        "sense_id": "bdaf9985-42d1-3c4c-b64d-d20bc9ca207e",
                        "entry_id": "32bb20de-1406-3dbc-8513-eb9eb5746795",
                        "glosses": [
                            "durch Trocknung haltbar gemachtes Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d947234-2e0e-4734-8cf4-842fbc7fb6f3",
                                "sense_id": "bdaf9985-42d1-3c4c-b64d-d20bc9ca207e",
                                "text": "„Und sie verkaufte Trockenfleisch an den Widder, der kein Fleisch aß.“"
                            },
                            {
                                "example_id": "cd8a67db-85df-47ca-95af-4e36fe3da069",
                                "sense_id": "bdaf9985-42d1-3c4c-b64d-d20bc9ca207e",
                                "text": "„In der Vertiefung lagen eine Plastiktüte mit Murmeln, wie Kinder sie zum Spielen benutzten, eine aufgerollte Wäscheleine, eine Schachtel mit beideseitig geschliffenen Rasierklingen und eine große Tüte Trockenfleisch.“"
                            },
                            {
                                "example_id": "86f2b708-5712-4bbd-a04e-78e123f0cbfe",
                                "sense_id": "bdaf9985-42d1-3c4c-b64d-d20bc9ca207e",
                                "text": "„Das Wasser und das Trockenfleisch hatten mich erfrischt, und ich stand auf.“"
                            },
                            {
                                "example_id": "8f775a83-3783-4134-bca6-e93839f756de",
                                "sense_id": "bdaf9985-42d1-3c4c-b64d-d20bc9ca207e",
                                "text": "„Stuart gab zwei Schüsse ab, beides Fehlschüsse, Jay zerschoss einen Ameisenhügel, der von Weitem irgendwie nach einem Wildschwein ausgesehen hatte, und Meat verschwendete zwar eine Menge Munition, vernichtete aber an diesem Tag nur drei einzeln verpackte Stückchen Marmorkuchen und zwei Portionspäckchen Trockenfleisch aus dem Militärproviantpaket in seinem Rucksack.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
