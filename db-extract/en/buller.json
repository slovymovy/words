                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0a8133d1-849d-4408-89cf-11d17ea8aa2a",
                                "sense_id": "021b841e-2a68-3b1e-b19c-c1927b161731",
                                "text": "Osborne is said to have been ragged by fellow Bullers over having attended St Paul's, the top London day school, which is, apparently, not posh enough."
                            }
                        ]
                    }
                ],
