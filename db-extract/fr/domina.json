                                    {
                                        "sense_id": "335b72ce-fd3f-3e57-a859-1ed6169ca5ec",
                                        "entry_id": "0ebfc616-773b-3bfc-bf26-8f851ae64eaf",
                                        "glosses": [
                                            "Prostituierte, die einem Kunden Befriedigung verschafft, indem sie ihn wunschgemäß quält"
