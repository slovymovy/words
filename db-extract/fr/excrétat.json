                ],
                "senses": [
                    {
                        "sense_id": "53d02d17-e375-35aa-b50e-d1321361c7e5",
                        "entry_id": "2d2e39f9-9779-35b5-8da7-5ee59dca1441",
                        "glosses": [
                            "Substance excrétée par un organisme vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c777674-2435-4b50-bb0f-10462856b881",
                                "sense_id": "53d02d17-e375-35aa-b50e-d1321361c7e5",
                                "text": "Pour ce faire, il convient de ne pas perdre de vue le modèle empirique de l’abeille qui produit un excrétat nourricier, le miel, mais qui sécrète également du venin, substance toxique."
                            },
                            {
                                "example_id": "93895fc5-21e6-422d-bab3-64af09c5c498",
                                "sense_id": "53d02d17-e375-35aa-b50e-d1321361c7e5",
                                "text": "La lutte contre la maladie impose une stratégie globale comprenant la lutte contre les mollusques, le traitement des sujets parasités, l'amélioration des conditions sanitaires dans l'élimination des excrétats humains."
                            },
                            {
                                "example_id": "d1ad1062-3c49-4622-928d-a129e401f12f",
                                "sense_id": "53d02d17-e375-35aa-b50e-d1321361c7e5",
                                "text": "Les ions en solution ne sont pas nécessairement libres et certains peuvent être complexés en totalité ou en partie par des molécules provenant des biotransformations de la matière organique et des excrétats racinaires."
                            },
                            {
                                "example_id": "e4cf00f8-e438-496b-9fb5-f7b9bcab2884",
                                "sense_id": "53d02d17-e375-35aa-b50e-d1321361c7e5",
                                "text": "Ce sont les excrétats virulents, en particulier les urines aérosolisées qui assurent la contamination des animaux et de l'homme."
                            }
                        ]
                    }
                ],
