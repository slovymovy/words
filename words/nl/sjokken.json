    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e992d8b2-40a3-3d2d-b828-bec318eb962c",
                    "sense_definition": "langzaam en vermoeid of lusteloos lopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op het laatst werd er meer <w>gesjokt</w> dan gewandeld.",
                            "target_lang_translations": {
                                "en": "In the end, there was more <w>trudging</w> than walking."
                            }
                        },
                        {
                            "text": "De vermoeide wandelaars <w>sjokten</w> langzaam over het zandpad.",
                            "target_lang_translations": {
                                "en": "The tired hikers <w>plodded</w> slowly along the sandy path."
                            }
                        }
                    ],
                    "synonyms": [
                        "sloffen"
                    ],
                    "common_phrases": [
                        "langzaam sjokken",
                        "vermoeid sjokken"
                    ],
                    "target_lang_definitions": {
                        "en": "to walk slowly and tiredly or listlessly, often dragging one's feet"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to trudge",
                                "target_lang_sense_clarification": "walking slowly with heavy steps"
                            },
                            {
                                "target_lang_word": "to plod",
                                "target_lang_sense_clarification": "walking slowly and heavily"
                            },
                            {
                                "target_lang_word": "to shuffle",
                                "target_lang_sense_clarification": "walking without lifting the feet properly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f7be42e-92e5-3bff-89bb-cd68aa9313fe",
                    "sense_definition": "langzaam en vermoeid of lusteloos ergens heen lopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was in mineurstemming naar huis <w>gesjokt</w>.",
                            "target_lang_translations": {
                                "en": "He had <w>shuffled</w> home in a gloomy mood."
                            }
                        },
                        {
                            "text": "Na de nederlaag <w>sjokte</w> de speler naar de kleedkamer.",
                            "target_lang_translations": {
                                "en": "After the defeat, the player <w>trudged</w> to the dressing room."
                            }
                        }
                    ],
                    "synonyms": [
                        "sloffen"
                    ],
                    "common_phrases": [
                        "naar huis sjokken"
                    ],
                    "target_lang_definitions": {
                        "en": "to walk slowly and tiredly or listlessly towards a specific destination"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to trudge",
                                "target_lang_sense_clarification": "walking laboriously towards a place"
                            },
                            {
                                "target_lang_word": "to shuffle",
                                "target_lang_sense_clarification": "moving listlessly towards a destination"
                            },
                            {
                                "target_lang_word": "to lumber",
                                "target_lang_sense_clarification": "moving in a slow, heavy, awkward way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}