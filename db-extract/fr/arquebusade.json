                "entry_id": "398090e5-37de-387c-b7bf-89cbc5e8789c",
                "word": "arquebusade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a19548e-6c68-4f84-a2ce-72e6c0660c6c",
                        "entry_id": "398090e5-37de-387c-b7bf-89cbc5e8789c",
                        "tags": [
                            "plural"
