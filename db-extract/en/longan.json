                        "entry_id": "d96a3147-b07b-3338-bbf4-af7a36eef016",
                        "glosses": [
                            "An evergreen tree, Dimocarpus longan, of the Sapindaceae family, native to southern China."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "44b78221-ac7d-3504-9244-62af4aac5bcb",
                        "entry_id": "d96a3147-b07b-3338-bbf4-af7a36eef016",
                        "glosses": [
                            "The fruit from the longan tree."
                        ],
                        "tags": [],
                        "examples": []
