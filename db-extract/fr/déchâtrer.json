                "senses": [
                    {
                        "sense_id": "9acc7ad2-d457-3630-b548-6413a1d79d1c",
                        "entry_id": "50d02490-85b3-3949-8326-7dc674ea829d",
                        "glosses": [
                            "Annuler la castration de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a16c3250-4d7d-42d0-9ce2-322b1be8773e",
                                "sense_id": "9acc7ad2-d457-3630-b548-6413a1d79d1c",
                                "text": "Il faut déchâtrer les êtres, leur donner la liberté dans tous les sens."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d838775-ad0f-3ab1-8485-9af2fd731fe4",
                        "entry_id": "50d02490-85b3-3949-8326-7dc674ea829d",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3f7303-891e-445b-a592-9752be69c1bb",
                                "sense_id": "5d838775-ad0f-3ab1-8485-9af2fd731fe4",
                                "text": "Nous venons de dire que sans l’équanteur les rais seraient bientôt déchâtrés sur un terrain incliné : mais pour que le point d’appui ne soit pas hors du centre de gravité, il faut donner au moyeu une certaine longueur."
                            },
                            {
                                "example_id": "6156cb00-5979-4e3a-ad8a-84c57e5f7395",
                                "sense_id": "5d838775-ad0f-3ab1-8485-9af2fd731fe4",
                                "text": "Bien sûr, disait-il, les roues seront plus légères avec des rayons, mais si elles se déchâtrent, c’est bien ennuyeux ; le char sera complètement foutu."
                            }
                        ]
                    }
