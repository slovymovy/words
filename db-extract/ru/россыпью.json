        "ru-extract.jsonl": [
            {
                "entry_id": "35327dab-3596-3d76-89d1-516c2fb665be",
                "word": "россыпью",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1447a9c2-ff05-3cc1-8ee1-093c1ed7e4ff",
                        "entry_id": "35327dab-3596-3d76-89d1-516c2fb665be",
                        "glosses": [
                            "в рассыпанном состоянии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382c45ac-5249-4d79-86ff-ab65baaece35",
                                "sense_id": "1447a9c2-ff05-3cc1-8ee1-093c1ed7e4ff",
                                "text": "А ещё отдельной россыпью подушечки кофейные, а ещё стоял джем."
                            },
                            {
                                "example_id": "1318ed9c-cf1e-4fdf-a71a-ad6a74aeda2f",
                                "sense_id": "1447a9c2-ff05-3cc1-8ee1-093c1ed7e4ff",
                                "text": "Пейзаж после битвы: пустые бутылки и бокалы, целые и битые, окурки и сигареты россыпью, чулки, мусор .."
                            },
                            {
                                "example_id": "ee63409d-3473-4594-98cc-b843b1f631c1",
                                "sense_id": "1447a9c2-ff05-3cc1-8ee1-093c1ed7e4ff",
                                "text": "Конечно, можно замораживать россыпью (ягоды, например), на листе, который ставят в морозильник."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc31f620-9a5f-31e4-a2d1-3272511ffdf9",
                        "entry_id": "35327dab-3596-3d76-89d1-516c2fb665be",
                        "glosses": [
                            "разг. вразброд, не вместе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc3b12f-23e4-44a7-8d4e-42baab0cdfae",
                                "sense_id": "cc31f620-9a5f-31e4-a2d1-3272511ffdf9",
                                "text": "Молодёжь весёлой россыпью вбегала в камеры, кидалась к окну; в одну минуту расхватывала ломти хлеба .."
                            },
                            {
                                "example_id": "47f809c3-63a1-41fb-a3ca-68716cbe335c",
                                "sense_id": "cc31f620-9a5f-31e4-a2d1-3272511ffdf9",
                                "text": "Пробовали закрепиться на слабо, наспех кем-то подготовленных оборонительных рубежах, но тут же настигало людей это проклятое слово «окружение» — и они снова кучами, толпами, табунами и россыпью бежали, спешили неизвестно куда, к кому и зачем. ❬…❭ Первая и вторая роты возвращались в казарму россыпью, разбродно, не строем."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f6e1a71-4686-37a1-8711-c3f9dd87a5b8",
                        "entry_id": "35327dab-3596-3d76-89d1-516c2fb665be",
                        "glosses": [
                            "проф. и разг. без тары, упаковки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99fd22f-7ab2-4d15-96cd-d5ca0c7bfa7b",
                                "sense_id": "0f6e1a71-4686-37a1-8711-c3f9dd87a5b8",
                                "text": ".. около 10 миллионов 3-линейных патронов россыпью ❬…❭ .. 5 миллионов ружейных патронов россыпью .."
                            },
                            {
                                "example_id": "88aa3fad-8fdf-4fdf-9e36-658a96368741",
                                "sense_id": "0f6e1a71-4686-37a1-8711-c3f9dd87a5b8",
                                "text": "С переходом от загрузки судов пиломатериалами россыпью к загрузке пакетами плотность укладки стала значительно меньше."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6447772-9a84-31ab-9293-60fd5613bafc",
                        "entry_id": "35327dab-3596-3d76-89d1-516c2fb665be",
                        "glosses": [
                            "проф. в несвязанном виде (о сплавляемом лесе, дровах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49beb5e9-df6a-46d3-b509-17f2c6735a0c",
                                "sense_id": "c6447772-9a84-31ab-9293-60fd5613bafc",
                                "text": "Для этого вяжут плоты, а дрова пускают «вольницей», «россыпью»."
                            },
                            {
                                "example_id": "3337a390-0e07-4541-a4a0-2f89e7da92ea",
                                "sense_id": "c6447772-9a84-31ab-9293-60fd5613bafc",
                                "text": "Самая удалённая от завода доставка леса идёт из Каргопольского уезда по рекам Моше и Онеге россыпью; у села Корельского поставлен затон, ниже — другой, подле Анды, откуда лес, связанный плотами брёвен в 600, спускается до Онеги."
                            },
                            {
                                "example_id": "dd28cd7d-e003-4daf-aec6-974fd1e0a358",
                                "sense_id": "c6447772-9a84-31ab-9293-60fd5613bafc",
                                "text": "Там рубят деревья, подвозят их к берегу реки и россыпью — «молем» — сплавляют по её порогам."
                            }
                        ]
                    },
                    {
                        "sense_id": "73d32f4b-5e39-3f18-b8d0-eb290c105710",
                        "entry_id": "35327dab-3596-3d76-89d1-516c2fb665be",
                        "glosses": [
                            "употребляется как несогласованное определение"
                        ],
                        "tags": [],
                        "examples": []
                    }
