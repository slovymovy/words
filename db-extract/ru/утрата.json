                                                "sense_id": "e2ea8635-72e8-328e-a096-d891e3992054",
                                                "text": "The match ended in their first loss of the season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The death of a person or animal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10023171-7a90-4880-9486-dfcd9d0318aa",
                                                "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                                "text": "We mourn his loss."
                                            },
                                            {
                                                "example_id": "d8f77a94-fa16-4222-a736-b6860e192fb1",
                                                "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                                "text": "The battle was won, but losses were great."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "351b781c-ca22-38b0-b482-d66f64937f9e",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The condition of grief caused by losing someone or something, especially someone who has died."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3e35a8-06cc-48ee-a567-81157c5308fd",
                                                "sense_id": "351b781c-ca22-38b0-b482-d66f64937f9e",
                                                "text": "Her daughter's sense of loss eventually led to depression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dedf55-63f9-305f-ad4b-41f036c9b7ff",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
