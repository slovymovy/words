                                        "entry_id": "450ee425-71b7-3868-acab-a58b9650bf3b",
                                        "glosses": [
                                            "Qui tient de la nature du cancer, qui appartient au cancer."
                                        ],
                                        "tags": [
                                            "En parlant notamment d’une tumeur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0764129-18ca-47d3-b554-5ce0699677bb",
                                                "sense_id": "1837a477-88e2-334c-98ef-58fa0f4dadda",
                                                "text": "Le principe consiste à réinjecter au patient certaines de ses cellules immunitaires préalablement prélevées et transformées en laboratoire, de façon à leur donner la faculté d’agir contre les cellules cancéreuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ead446-b311-3cc1-b561-82afad63b75a",
