                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das monatliche <w>Einkommen</w> reicht aus, um die Miete und die Lebenshaltungskosten zu decken."
                        },
                        {
                            "text": "Viele Familien müssen heute mit einem vergleichsweise geringen <w>Einkommen</w> ihren Alltag bestreiten."
                        }
                    ],
                    "synonyms": [
                        "Gehalt",
                        "Lohn"
                    ],
                    "common_phrases": [
                        "monatliches Einkommen",
                        "festes Einkommen",
                        "steuerpflichtiges Einkommen"
                    ]
                }
