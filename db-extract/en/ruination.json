    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                "word": "ruination",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4f60e052-561b-4b8e-90dc-5c1f6f7ca57a",
                        "entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "ruinations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "792b2365-c6bb-3899-85e1-70243ae545a4",
                        "entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "glosses": [
                            "The state of being ruined, a state of devastation or destruction."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9bf271d0-8b8c-4f0e-a717-c37a618121c0",
                                "sense_id": "792b2365-c6bb-3899-85e1-70243ae545a4",
                                "text": "As our tour has shown, the state of ruination of castle sites was a key factor in their fate when the railways came through."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4f54b66-4f4b-34b0-9276-a22266851df9",
                        "entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "glosses": [
                            "The act of ruining or wrecking."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4d24f67c-0fb3-3d74-917c-5123ee3bc68f",
                        "entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "glosses": [
                            "The cause of being ruined, destroyed or lost."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf2d1625-3013-36d9-a81d-b618fc9d7b7e",
                        "entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "glosses": [
                            "A loss of reputation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "85a6e8f1-d513-4aed-aaae-576a76f8a972",
                                "sense_id": "cf2d1625-3013-36d9-a81d-b618fc9d7b7e",
                                "text": "Yet also thanks largely to Trump, a parallel disaster is unfolding across the world: the ruination of America’s reputation as a safe, trustworthy, competent international leader and partner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53ae9568-91f8-4491-8a97-e3deba818ec1",
                        "source_entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "source_sense_description": "state of being ruined",
                        "target_lang_word": "ruination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3ea56f56-6f01-4a0b-a9da-2a057cc19ecf",
                        "source_entry_id": "b4f8f42c-fc2d-3da9-a682-248785bea2e9",
                        "source_sense_description": "state of being ruined",
                        "target_lang_word": "Verderben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verderben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0aebebc6-40e6-3de0-91bc-55af9d890208",
                                        "entry_id": "bafd3eac-884e-3a53-a85c-b6516da524d9",
                                        "glosses": [
                                            "Vorgang, bei dem Lebensmittel mit der Zeit ungenießbar werden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0fb6b9f-1bc9-4322-b523-8a27c8e9ef39",
                                                "sense_id": "0aebebc6-40e6-3de0-91bc-55af9d890208",
                                                "text": "Dem Verderben von Lebensmitteln kann vielfach durch Kühlung entgegengewirkt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef62d256-dc8f-3fc9-9308-161d382a09d0",
                                        "entry_id": "bafd3eac-884e-3a53-a85c-b6516da524d9",
                                        "glosses": [
                                            "Vorfall, Entwicklung, die Unheil bedeuten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1abccbd7-c8a2-4929-8aa4-cec74cf706fb",
                                                "sense_id": "ef62d256-dc8f-3fc9-9308-161d382a09d0",
                                                "text": "Die Pest brachte Verderben und Tod über das Land."
                                            },
                                            {
                                                "example_id": "1d1222a1-c3d1-4a80-b528-2f72fd0b2714",
                                                "sense_id": "ef62d256-dc8f-3fc9-9308-161d382a09d0",
                                                "text": "War es ein blind machender Spieltrieb, der die Banken ins Verderben getrieben hat?"
                                            },
                                            {
                                                "example_id": "514caccb-db6f-42ab-9377-877b16425502",
                                                "sense_id": "ef62d256-dc8f-3fc9-9308-161d382a09d0",
                                                "text": "„Und so beginnt nur Tage nach der Unabhängigkeitsfeier eine verhängnisvolle Entwicklung, die den Kongo ins Verderben reißen wird.“"
                                            },
                                            {
                                                "example_id": "9751cbc9-efca-4459-88ee-1c01badd5b76",
                                                "sense_id": "ef62d256-dc8f-3fc9-9308-161d382a09d0",
                                                "text": "„Die Inquisition mußte ihm Verderben geschworen haben, und jedermann sagte, in zwei oder drei Jahren werde Campomanes entweder die Bischofswürde erhalten oder für den Rest seines Lebens in den Gefängnissen der Inquisition eingekerkert sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
