                "senses": [
                    {
                        "sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                        "entry_id": "5f4b38cd-f020-3dd7-8652-ee445e6bace9",
                        "glosses": [
                            "fibröser, wenig dehnbarer Bindegewebsstrang, der zur Verbindung und Fixierung beweglicher Teile des Knochensystems dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b1bb29-988f-4b91-b82a-aa328cb2098c",
                                "sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                                "text": "Das Parodontale Ligament bezeichnet kleine Fasern, die den Zahn mit dem Knochen fest verbinden und Belastungen beim Kauen mit der grossen Kaukraft abfedern."
                            },
                            {
                                "example_id": "31d56dcf-94d7-46af-ba67-80e78a6a77ac",
                                "sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                                "text": "Das mediale patellofemorale Ligament (MPFL) ist der wichtigste und kräftigste Weichteilstabilisator der Patella."
                            },
                            {
                                "example_id": "542efdb8-7d1f-4eb7-9d88-8891776bbf56",
                                "sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                                "text": "Die beiden Schalenklappen der Muschel hängen mit einem elastischen Schlossband (Ligament) zusammen, das im entspannten Zustand die Schalenklappen öffnet."
                            },
                            {
                                "example_id": "f4a5a17e-d275-4631-bc08-c40295191ae6",
                                "sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                                "text": "Die Gelenke werden ebenfalls in mittlerer Stellung belastet, und die Ligamente haben ihre Ruhelängen."
                            },
                            {
                                "example_id": "7ba36e44-c17a-4a14-b7db-1f9f99578e03",
                                "sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                                "text": "Übungen zur Kräftigung dieser Muskeln stehen in der Regel an erster Stelle; ihre Stützwirkung ist neben der der Ligamente unbestritten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d933338-8864-47e1-8eda-a3a56a8fe45f",
                        "source_entry_id": "5f4b38cd-f020-3dd7-8652-ee445e6bace9",
                        "source_sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                        "target_lang_word": "ligament",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligament",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5a0b27b-338b-3451-8bf6-e0068e7725f9",
                                        "entry_id": "795d144e-4d17-3ce8-a738-30cc02f27a68",
                                        "glosses": [
                                            "A band of strong tissue that connects bones to other bones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a19c6579-2997-4404-bb37-334576d4d47e",
                                                "sense_id": "d5a0b27b-338b-3451-8bf6-e0068e7725f9",
                                                "text": "It so chanced that at this juncture the decayed ligaments of the skeleton gave way, and the dry bones fell together in a heap, thus causing the dusty wreath of cypress to drop upon the table."
                                            },
                                            {
                                                "example_id": "c307d6a0-4812-4137-9e28-8997b193e2fe",
                                                "sense_id": "d5a0b27b-338b-3451-8bf6-e0068e7725f9",
                                                "text": "Her anterior cruciate ligament (ACL) and medial collateral ligament (MCL) are torn and Vonn has a lateral fracture of the tibial plateau, the upper end of the tibia or shin bone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e111a0e-1f87-3d7d-be3c-491c5de539e8",
                                        "entry_id": "795d144e-4d17-3ce8-a738-30cc02f27a68",
                                        "glosses": [
                                            "That which binds or acts as a ligament."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75252287-1815-4df0-b5e9-44610291cab9",
                                                "sense_id": "9e111a0e-1f87-3d7d-be3c-491c5de539e8",
                                                "text": "It remains to mention one consideration which naturally occurred in the reflections upon the expediency of assuming the State Debts. This is its tendency to strengthen our infant Government by increasing the number of ligaments between the Government and the interests of Individuals."
                                            },
                                            {
                                                "example_id": "eed5959f-1fc9-416a-b9c3-79c67b0ea2c2",
                                                "sense_id": "9e111a0e-1f87-3d7d-be3c-491c5de539e8",
                                                "text": "1845, Daniel Webster, oration on Justice Joseph Story\nJustice is the ligament which holds civilized beings and civilized nations together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "463db3e1-5630-483b-a7f1-7ccc8c31ff83",
                        "source_entry_id": "5f4b38cd-f020-3dd7-8652-ee445e6bace9",
                        "source_sense_id": "a6902ea7-5f50-39b7-9d16-4eca447f5641",
                        "target_lang_word": "ligament",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligament",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2bdba70-152e-3f68-89ed-ecfe395812cc",
                                        "entry_id": "8c88b0f6-8839-3e8a-a7be-1e18e6cd8199",
                                        "glosses": [
                                            "Partie blanche et fibreuse qui sert à attacher des os ou des viscères et quelquefois à les soutenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "803c6047-7f3f-41e1-8ecc-79e719c8bc7f",
                                                "sense_id": "f2bdba70-152e-3f68-89ed-ecfe395812cc",
                                                "text": "Les ligaments de l’articulation du genou."
                                            },
                                            {
                                                "example_id": "4c34d550-1d86-4fc9-9a89-23ee9f67b0c4",
                                                "sense_id": "f2bdba70-152e-3f68-89ed-ecfe395812cc",
                                                "text": "Les ligaments du foie."
                                            },
                                            {
                                                "example_id": "d53a507f-6ab6-40f5-91b2-a7710134731d",
                                                "sense_id": "f2bdba70-152e-3f68-89ed-ecfe395812cc",
                                                "text": "Les ligaments des os de la cuisse."
                                            },
                                            {
                                                "example_id": "e1b867b8-d826-4e01-b976-4e0938b8a405",
                                                "sense_id": "f2bdba70-152e-3f68-89ed-ecfe395812cc",
                                                "text": "En attendant le retour de sa femme, il s’assit sur une souche, posa son outil à ses pieds et, serrant très fort son poignet droit dans sa main gauche, il se mit à plier et déplier ses doigts. Il sentait les ligaments courir dans leur gaine."
                                            },
                                            {
                                                "example_id": "a60b22af-cfeb-46cf-8527-0bac2f9c6db8",
                                                "sense_id": "f2bdba70-152e-3f68-89ed-ecfe395812cc",
                                                "text": "Le corps présente une facette articulaire antérieure pour l’atlas et une facette postérieure pour le ligament transverse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
