                                "target_senses": [
                                    {
                                        "sense_id": "8b62c5de-5c44-3ad4-a870-bd6541871828",
                                        "entry_id": "4d8069ec-fa77-3fe9-81e5-e5bdc3543825",
                                        "glosses": [
                                            "Qui regarde en arrière."
