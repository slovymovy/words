                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a19ec06b-0bd6-3fb9-9b77-ef5b7e667052",
                                        "entry_id": "76469c0b-0069-322e-b381-c05988a53890",
                                        "glosses": [
                                            "A feeling of fear and reverence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755df7f9-b5a1-4bd8-a3b1-74bffea8f84b",
                                                "sense_id": "a19ec06b-0bd6-3fb9-9b77-ef5b7e667052",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eeba279-3abe-3984-8891-8fdcf39c2da1",
                                        "entry_id": "76469c0b-0069-322e-b381-c05988a53890",
                                        "glosses": [
                                            "A feeling of amazement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed2d5908-89e7-431c-a23f-ad79f6dbb3f0",
                                                "sense_id": "6eeba279-3abe-3984-8891-8fdcf39c2da1",
                                                "text": "For several minutes no one spoke; I think they must each have been as overcome by awe as was I. All about us was a flora and fauna as strange and wonderful to us as might have been those upon a distant planet had we suddenly been miraculously transported through ether to an unknown world."
                                            },
                                            {
                                                "example_id": "cf64fab7-0d8d-4d87-a7a5-f207ac792467",
                                                "sense_id": "6eeba279-3abe-3984-8891-8fdcf39c2da1",
                                                "text": "In 1825, the first public railway carried passengers across the English countryside, setting in motion not just an engineering revolution, but an industrial one too. Imagine the awe and excitement of those first passengers as they boarded the train, unaware that they were witnessing the dawn of a new era."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c358c4-91d6-3c26-95e9-e6e3b9cd4bdd",
                                        "entry_id": "76469c0b-0069-322e-b381-c05988a53890",
                                        "glosses": [
                                            "Power to inspire awe."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "awe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a3bb28-fe8d-3968-9b89-1d1a4b52f187",
                                        "entry_id": "a09a3877-127f-3718-b21f-7ff53e6d4fc3",
                                        "glosses": [
                                            "To inspire fear and reverence in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee92da13-34b2-4098-ab50-540c529783d7",
                                                "sense_id": "c9a3bb28-fe8d-3968-9b89-1d1a4b52f187",
                                                "text": "That large room had always awed Ivor: even as a child he had never wanted to play in it, for all that it was so limitless, the parquet floor so vast and shiny and unencumbered, the windows so wide and light with the fairy expanse of Kensington Gardens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bf7b06-af6b-3eb2-9534-9bdcf43d8793",
                                        "entry_id": "a09a3877-127f-3718-b21f-7ff53e6d4fc3",
                                        "glosses": [
                                            "To control by inspiring dread."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c22fe1c8-7272-4b05-94f1-0ed834417e60",
                                                "sense_id": "69bf7b06-af6b-3eb2-9534-9bdcf43d8793",
                                                "text": "While a sense of outrage is the only rational response to atrocity, if that outrage is maintained at too high a level over too long a time it can generate feelings of impotence, as we permit ourselves to be awed by this irrational act of violence."
                                            }
                                        ]
                                    }
                                ]
