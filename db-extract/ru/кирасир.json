                        "target_lang_word": "Kürassier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kürassier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0f4db4e-5c33-3798-a25d-56f8f485a3d8",
                                        "entry_id": "0213cbde-167f-34c9-84f7-f44d7d4514df",
                                        "glosses": [
                                            "im 15. bis 19. Jahrhundert ein Soldat der schweren Reiterei der einen Kürass (Brustpanzer) trägt; neben den Lanzierern die älteste Gattung der frühneuzeitlichen Kavallerie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a5de71-0044-4ec8-a8c0-18b25b959c4c",
                                                "sense_id": "b0f4db4e-5c33-3798-a25d-56f8f485a3d8",
                                                "text": "„Die Kürassiere sind die älteste Reitergattung und wohl bekannteste der K.u.K. Kavallerie.“"
                                            },
                                            {
                                                "example_id": "dca09e6e-f763-45c5-87fc-3c06baca82a7",
                                                "sense_id": "b0f4db4e-5c33-3798-a25d-56f8f485a3d8",
                                                "text": "„Westfälische Kürassiere verfolgten die russischen Reiter.“"
                                            },
                                            {
                                                "example_id": "0b835f6a-9a5f-476c-82ae-b7887801bbee",
                                                "sense_id": "b0f4db4e-5c33-3798-a25d-56f8f485a3d8",
                                                "text": "„Seine Jahre bei den Kürassieren waren im wesentlichen Friedensjahre gewesen;“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e99098a-42c6-358d-893e-ec05e66745d2",
                                        "entry_id": "0213cbde-167f-34c9-84f7-f44d7d4514df",
                                        "glosses": [
                                            "österreichischer Jagdpanzer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3f22670-c06c-405c-b4b3-6fed574d4854",
                                                "sense_id": "7e99098a-42c6-358d-893e-ec05e66745d2",
                                                "text": "„Inzwischen ist der Kürassier mit einer rechnergestützten Feuerleitanlage mit integriertem Laser-Entfernungsmesser und einem Wärmebildgerät ausgestattet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
