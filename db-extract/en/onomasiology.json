                                            {
                                                "example_id": "12b35f4b-542a-4c97-926e-1ca6cbb8f9ba",
                                                "sense_id": "bc4e0dac-650b-370b-9869-01318fe1b1e7",
                                                "text": "En d’autres termes, la différence entre sémasiologie et onomasiologie est basée sur la différence entre signification et nomination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76ac59a8-2f06-4c7e-8126-91912299c356",
                        "source_entry_id": "9031939b-729b-3ea8-bd47-30ee9a34b774",
                        "source_sense_id": "033fac2a-382a-306e-91f1-2ecbde76d5b6",
                        "source_sense_description": "branch of lexicology",
                        "target_lang_word": "Onomasiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onomasiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                        "entry_id": "3feacf09-eb2f-3be9-b1e2-cc54aa4e8cba",
                                        "glosses": [
                                            "Forschungsrichtung der Semantik, die danach fragt, welche Bezeichnungen für bestimmte Sachverhalte, Gegenstände etc. in einer Sprache oder einem Dialekt verwendet werden. Man geht also von den zu bezeichnenden Sachverhalten aus und fragt nach den Ausdrücken dafür."
                                        ],
                                        "tags": [
                                            "speziell Semantik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c408cb-1146-4c8f-adcf-4811020a1885",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "Die Onomasiologie fragt z.B. danach, welche Bezeichnungen für die \"Kartoffel\" in verschiedenen Regionen Deutschlands verwendet werden."
                                            },
                                            {
                                                "example_id": "907f648b-d8cb-4da7-acf2-53dc730ae7e8",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "„Onomasiologie und Semasiologie untersuchen die lexikalischen Einheiten und Beziehungen sowohl unter synchronischem als auch unter diachronischem Aspekt, also sowohl den Zustand als auch die Veränderungen des Systems der Benennungen und der Wortbedeutungen.“"
                                            },
                                            {
                                                "example_id": "8014dd56-5871-43ac-980e-4b7f6666e847",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "„Im Bereich der Wortsemantik wird dieser Komplementarität durch die Unterscheidung von Onomasiologie (Bezeichnungslehre) und Semasiologie (Bedeutungslehre) Rechnung getragen.“"
                                            },
                                            {
                                                "example_id": "4cd80061-2388-4779-b5a9-c87f138f7e08",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "„Die Darstellungsfunktion des Wortschatzes ist am differenziertesten von der Semasiologie und Onomasiologie beschrieben worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
