                        "glosses": [
                            "Volksfest in München"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "73030e8d-636f-4394-b298-5d51bbcf3859",
                                "sense_id": "2fc96732-2650-3ede-9c39-e557adf6083d",
                                "text": "Vom 20. September bis 5. Oktober 2014 heißt es in München wieder: Auf geht's zur Wiesn!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3346e070-89f4-3d77-944c-84a1bc0ba99f",
                        "entry_id": "9ec94eab-c787-34ab-a6f7-a1482c38eb31",
                        "glosses": [
