                        "examples": [
                            {
                                "example_id": "2c2a2b5d-6540-4207-8003-ebb8f8eda864",
                                "sense_id": "50233484-7a3d-3cf4-9c90-a16fdb4c5652",
                                "text": "Now give me my cable, fast food, four-by's, tats, right away I want it now."
                            },
                            {
                                "example_id": "6cf61287-8b23-4ad4-8284-d104ff94d265",
                                "sense_id": "50233484-7a3d-3cf4-9c90-a16fdb4c5652",
                                "text": "I'm diplomatic playing pen and pad. Rat-a-tat, you're a scaredy-catcause I have a tat put you up like that. You can't stand that cause you've got to scat."
                            },
                            {
                                "example_id": "b62190b6-bdc9-4219-bf8a-431d317d04da",
                                "sense_id": "50233484-7a3d-3cf4-9c90-a16fdb4c5652",
                                "text": "Me and my thugs clock G's, sippin' naughty thangs. Real as these tats on my body, and it's Killuminati."
                            }
                        ]
                    }
                ],
