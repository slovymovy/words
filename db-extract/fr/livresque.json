                                    {
                                        "sense_id": "fac44b2b-7eff-35ed-b4a7-f05ec8c1a6e7",
                                        "entry_id": "7df4273d-9059-3787-a42f-a72450d239c1",
                                        "glosses": [
                                            "Que pertenece o concierne al libro o a los libros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "060f7f9f-6a66-4d59-b2b2-6732de61b6df",
                                                "sense_id": "fac44b2b-7eff-35ed-b4a7-f05ec8c1a6e7",
                                                "text": "Si nos atenemos a la definición que da B. Croce de la religión, como una concepción del mundo que llegaría a ser norma de vida [... no] en sentido libresco, sino realizada en la vida práctica"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "97c7b7d6-e137-3281-9ea0-c944586bade7",
                                        "entry_id": "7df4273d-9059-3787-a42f-a72450d239c1",
                                        "glosses": [
                                            "Que muestra mucha influencia de la lectura de libros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4448ed4-94cf-4f20-986e-06ba86dd19ca",
                                                "sense_id": "97c7b7d6-e137-3281-9ea0-c944586bade7",
                                                "text": "El filósofo libresco informa de lo que ha dicho un autor, de lo que quiso decir otro y de lo que replicó un tercero, etc."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
