                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a7a5f54-944e-3b7d-b290-5830ed409aa9",
                        "entry_id": "2bdca3e6-a245-38e1-9b9e-af760a2e9d2a",
                        "glosses": [
                            "углубление на поверхности, возникшее в результате удара (ударов), частой езды и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39385203-287c-4a0a-9587-2c0f38e82961",
                                "sense_id": "2a7a5f54-944e-3b7d-b290-5830ed409aa9",
                                "text": "На российских дорогах мы встретили много вы́боин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "810b5126-e8e9-4154-a987-96cd4d86ee66",
                        "source_entry_id": "2bdca3e6-a245-38e1-9b9e-af760a2e9d2a",
                        "source_sense_id": "2a7a5f54-944e-3b7d-b290-5830ed409aa9",
                        "target_lang_word": "pothole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pothole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A shallow pit or other edged depression in a road's surface, especially when caused by erosion by weather or traffic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0922244c-cef6-4987-98f4-b880e9d6b7be",
                                                "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                                                "text": "I was so tired that potholes, fumes and noise aside, I slept regardless, my head rag-dolling from side to side."
                                            },
                                            {
                                                "example_id": "a9cd7cf9-a252-4689-b993-d4b93559c902",
                                                "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                                                "text": "Labour's Shadow Transport Secretary Louise Haigh said: \"There is a cost-of-living crisis, and the Prime Minister blew nearly £1m of public money on an utterly infeasible vanity project. That's enough to fill 18,000 potholes. This shows the Tories' sheer disrespect for public money.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcbfe24-4e2d-396d-8a50-00af306e5e92",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A pit formed in the bed of a turbulent stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc596488-8351-4ea1-90e4-57233b681b8d",
                                                "sense_id": "9fcbfe24-4e2d-396d-8a50-00af306e5e92",
                                                "text": "2002, May-June, Grand River Conservation Authority (Canada) Newsletter\nThe earliest ideas on the creation of potholes are that they were associated with \"moulins de glacier\" (glacier mills) formed where surface streams on glaciers and ice sheets fall into holes in the ice. Water entering these surficial holes was believed to impact on the bedrock beneath creating a large pothole. The \"Moulin Hypothesis\", first suggested in 1874, continued to be accepted by many authors until the 1950s. However, commencing in the 1930s, other authors have suggested dissatisfaction with the moulin hypothesis, largely on the grounds that it failed to explain how ice could remain stable long enough for the \"giant\" potholes to form and why many potholes (like those at Rockwood) were present in large numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17705f5c-c7cf-3a86-9b76-6c6af99aa8ec",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A vertical cave system, often found in limestone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "597c3dea-dcbf-3fd4-9cb9-82ea64b79d0a",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A pit resulting from unauthorized excavation by treasure-hunters or vandals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5402d14-44b9-3a82-a75e-f31a3fdfbd94",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A shallow hole dug for the purpose of prospecting for opal or gold."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98b5dc3b-24cc-3d2c-955a-2e88804e64dc",
                                        "entry_id": "91e37f84-83a1-39e0-a7c6-597ce98a51e8",
                                        "glosses": [
                                            "A hyperlink with text displayed on a page that is different from the title of the page to which the text links; a piped link."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pothole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f83d561a-3ceb-3097-a46c-2a8474d9aba5",
                                        "entry_id": "a455715d-e8b3-32a3-beb2-38c927df58f6",
                                        "glosses": [
                                            "A hole or recess on the top of a stove into which a pot may be placed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372c5330-ce87-4b54-ae68-746876fce52a",
                                                "sense_id": "f83d561a-3ceb-3097-a46c-2a8474d9aba5",
                                                "text": "Stoves with two or more potholes\nThe normal single-pot stove in which the pot sits on top, rather than being sunk into the pothole, has a major limitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58f1a97c-63d8-42e9-afce-0f9708accd57",
                        "source_entry_id": "2bdca3e6-a245-38e1-9b9e-af760a2e9d2a",
                        "source_sense_id": "2a7a5f54-944e-3b7d-b290-5830ed409aa9",
                        "target_lang_word": "Schlagloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlagloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                        "entry_id": "f99f03bf-4359-37ff-bd36-fb6aea1d8d19",
                                        "glosses": [
                                            "Loch in der Straßenoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7827c42f-5107-4ed6-a59e-2e330c0e61b8",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "Das Schlagloch in unserer Einfahrt wird immer größer."
                                            },
                                            {
                                                "example_id": "f43cee7b-08a2-4d46-ae4e-70ffce9c355c",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "Nach dem harten Winter sind die Straßen wieder voller Schlaglöcher."
                                            },
                                            {
                                                "example_id": "460a2b25-ebc4-4754-b2ba-098380d74f9f",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "In den Schlaglöchern sammelt sich das Wasser."
                                            },
                                            {
                                                "example_id": "35695c47-295a-478d-98af-f945c4254cf0",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Über eine Schotterpiste mit tiefen Schlaglöchern fahren wir vorsichtig bis zum Ende einer Straße.“"
                                            },
                                            {
                                                "example_id": "3f5f9f4a-76dd-4097-b019-0a50445d6494",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Von den Bergen läuft klares Quellwasser über die Fahrbahn, auf der Schlaglöcher den Asphalt teilweise fast vollständig verdrängt haben.“"
                                            },
                                            {
                                                "example_id": "314d008d-aed5-4c11-9b45-7da2bb1a821c",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
                                                "text": "„Hier im Süden gehört das Schlagloch zur Straße wie das Blitzgerät.“"
                                            },
                                            {
                                                "example_id": "0fc98fbb-8a13-4636-955f-d8cbac495a9b",
                                                "sense_id": "281f1f88-b938-344d-9216-b141a3f563ef",
