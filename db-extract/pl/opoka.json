                        ],
                        "examples": [
                            {
                                "example_id": "09423ad3-71fb-4bd3-8865-27ae20aa4d58",
                                "sense_id": "8ba7e22c-acd9-3b1c-8739-93e5cbaf8c42",
                                "text": ", 2014-10-06, rudaslaska.pl."
