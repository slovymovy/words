                "senses": [
                    {
                        "sense_id": "8cc48ea4-c491-35ba-a209-ebafa489dae5",
                        "entry_id": "3fd91f86-2df3-3dcd-8813-534beb12cd76",
                        "glosses": [
                            "Qui correspond au prolongement des nerfs optiques, à partir de la rétine jusqu'au tronc cérébral."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "665fb665-91dc-4f31-8e67-879933c721df",
                                "sense_id": "8cc48ea4-c491-35ba-a209-ebafa489dae5",
                                "text": "L'étude du système visuel central réside dans l'observation du trajet des voies rétinofuges, des yeux jusqu'au tronc cérébral et le traitement effectué dans ces voies."
                            },
                            {
                                "example_id": "d03d6fdb-f48f-451c-a0ea-b8af05bbafb0",
                                "sense_id": "8cc48ea4-c491-35ba-a209-ebafa489dae5",
                                "text": "Le docteur Ptito a choisi une approche rétinofuge : il part de la rétine et tente de remonter jusqu'au cortex visuel opposé en injectant des colorants à l'intérieur des cellules. Ces colorants diffusent partout à l'intérieur du neurone, révélant ainsi où il envoie ses longs prolongements."
                            },
                            {
                                "example_id": "98eb662c-5b0c-4e23-b9f3-7792b395e145",
                                "sense_id": "8cc48ea4-c491-35ba-a209-ebafa489dae5",
                                "text": "Une projection rétinofuge."
                            },
                            {
                                "example_id": "05818c5b-0ee3-420a-bc75-149b1ba615a3",
                                "sense_id": "8cc48ea4-c491-35ba-a209-ebafa489dae5",
                                "text": "Les voies optiques rétinofuges."
                            },
                            {
                                "example_id": "0855655c-7c78-4427-a8ed-d017a9de2395",
                                "sense_id": "8cc48ea4-c491-35ba-a209-ebafa489dae5",
                                "text": "Des fibres rétinofuges."
                            }
                        ]
                    }
