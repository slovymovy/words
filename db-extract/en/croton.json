                    },
                    {
                        "sense_id": "7f1d3a38-26c9-3b21-ac96-781c0d2a9318",
                        "entry_id": "5ba4496f-f4ed-3de0-ad93-fd774837d226",
                        "glosses": [
                            "Ellipsis of Croton-on-Hudson: a village in southern New York, United States, located along the Croton and Hudson rivers."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ef67aeda-7e3d-3c8d-8357-3c424785b99f",
                        "entry_id": "5ba4496f-f4ed-3de0-ad93-fd774837d226",
                        "glosses": [
                            "The water supply of New York City."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2b5a28a8-d789-47d2-8773-9e180e0ffc98",
                                "sense_id": "ef67aeda-7e3d-3c8d-8357-3c424785b99f",
                                "text": "The pumps now draw water from this tank, instead of from the \"Croton main\" as formerly."
                            },
                            {
                                "example_id": "d4f6874d-39fa-4fdf-9981-2d515c36e7d9",
                                "sense_id": "ef67aeda-7e3d-3c8d-8357-3c424785b99f",
                                "text": "The water, supplied from the \"Croton\" main at the 68th Street side of the building, is connected by two pipes: one for direct service, and the other to supply a hot-air engine, which forces the water to the tank at the top of the house for a high or indirect service."
                            },
                            {
                                "example_id": "6b2c2cb5-3fe9-4dff-9502-62034d96b976",
                                "sense_id": "ef67aeda-7e3d-3c8d-8357-3c424785b99f",
                                "text": "New York Cotton Exchange - A pressure of about 14 pounds from the Croton main"
                            }
                        ]
                    }
