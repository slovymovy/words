        "fr-extract.jsonl": [
            {
                "entry_id": "9e224217-7568-34e7-8d17-a0288fe534ae",
                "word": "vanilline",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8106ce5-2b44-35af-80bf-3651e8da41b3",
                        "entry_id": "9e224217-7568-34e7-8d17-a0288fe534ae",
                        "glosses": [
                            "Aldéhyde aromatique naturel qui se développe dans les gousses de vanille, caractéristique de son arôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd825c8-772d-4fb6-b36f-b395dda0db62",
                                "sense_id": "c8106ce5-2b44-35af-80bf-3651e8da41b3",
                                "text": "J'ai d'abord fait réagir le réactif à la vanilline et au pipéronal sur une série d'huiles, et j'ai observé les colorations directement après mélange et également au bout d'un certain temps."
                            },
                            {
                                "example_id": "fd217905-b07f-4bd9-b66f-51d615c6a6f3",
                                "sense_id": "c8106ce5-2b44-35af-80bf-3651e8da41b3",
                                "text": "La vanilline est une substance qui se développe naturellement dans les gousses de vanille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b8f3bf4-95c8-490f-90a3-1ffc80a89953",
                        "source_entry_id": "9e224217-7568-34e7-8d17-a0288fe534ae",
                        "source_sense_id": "c8106ce5-2b44-35af-80bf-3651e8da41b3",
