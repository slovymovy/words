                                        "examples": [
                                            {
                                                "example_id": "23c9ff95-906b-42ca-878e-35500701570e",
                                                "sense_id": "35a02564-402f-34c0-8142-e09472270e1c",
                                                "text": "Bas Smit, de echtgenoot van Nicolette van Dam, verhandelt nog steeds T-shirts met daarop zijn grijnzende portret. Half bekend Nederland heeft ze al en nu hebben ook de meiden van kleuterpoptrio er een gescoord. De opbrengst gaat naar het Prinses Máxima Centrum voor kinderoncologie."
                                            },
                                            {
                                                "example_id": "59ae03ae-af02-4f95-b6cd-b5f75b779455",
                                                "sense_id": "35a02564-402f-34c0-8142-e09472270e1c",
                                                "text": "En kijk, daar zag ik ze al zitten in het lokaal, met hun ouders, in zondagse kleren, en ook een stuk of zes grijnzende collega’s die eens lekker gingen toekijken hoe ik dat zou aanpakken. Alle aanwezigen wisten ongetwijfeld wat een puinhoop het was geweest in die twee jaar."
                                            }
                                        ]
                                    }
                                ]
                            }
