                ],
                "senses": [
                    {
                        "sense_id": "6d39c303-be6b-3acc-b000-95e48437826f",
                        "entry_id": "7fa1a3fd-4e63-3f76-affc-ce6d9ea4c7c7",
                        "glosses": [
                            "einzelne Verbform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f1bccee-4b2d-40a3-9033-41e94fc47565",
                                "sense_id": "6d39c303-be6b-3acc-b000-95e48437826f",
                                "text": "„Auch Funktionsverbgefüge dienen der Exaktheit, wenn sie Begriffe hervorheben (in Rechnung stellen), ein Akkusativobjekt einsparen helfen (eine Genehmigung erteilen) oder Schattierungen ausdrücken, die das Einzelverb nicht ausdrücken kann (in Erfahrung bringen, zum Abschluss bringen, zur Unterzeichnung schreiten).“"
                            },
                            {
                                "example_id": "1ce06e80-2f0f-4a66-a566-90afc301abef",
                                "sense_id": "6d39c303-be6b-3acc-b000-95e48437826f",
                                "text": "„Absolute und totale Synonymie zwischen FVG und Einzelverb sind nicht immer gegeben (vgl. Piera/Varela 1999, 4416), weil die Paraphrasen anders lexikalisiert sein können…“"
                            },
                            {
                                "example_id": "9169ec34-344c-40ec-9c70-a844c3fa7ba8",
                                "sense_id": "6d39c303-be6b-3acc-b000-95e48437826f",
                                "text": "„Das gilt für die Ebene der Einzelverben und für die semantisch definierten Verbklassen.“"
                            },
                            {
                                "example_id": "e6a6d1b1-84f0-40d2-ab41-7b34227d29ca",
                                "sense_id": "6d39c303-be6b-3acc-b000-95e48437826f",
                                "text": "„Finite Einzelverben oder komplexe verbale Strukturen mit einem Verbum finitum kommen in geschriebener und gesprochener Sprache vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
