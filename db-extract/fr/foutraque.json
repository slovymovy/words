                    {
                        "translation_id": "062442a7-5b3a-4375-b121-82c52652c85b",
                        "source_entry_id": "078eb1c7-7ed7-32cd-a961-6befa5d21b15",
                        "source_sense_id": "6991a1ba-fb1d-3dd1-8e51-187dc4fd6810",
                        "target_lang_word": "oddball",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oddball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bda043e3-5c60-3f38-96a1-bfc76a08f4f9",
                                        "entry_id": "43b7ecd2-fcb3-36a0-aea6-56801c3eff4a",
                                        "glosses": [
                                            "An eccentric or unusual person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2d4186-00f9-4897-9c74-e35b31580792",
                                                "sense_id": "bda043e3-5c60-3f38-96a1-bfc76a08f4f9",
                                                "text": "Miss Quinn thought that Oswald spoke Russian well in view of his lack of formal training; she found the evening uninteresting. Donovan, with whom she had a date later, testified that she told him that Oswald was “kind of an oddball.”"
                                            },
                                            {
                                                "example_id": "cc552219-f0f6-408f-a8f1-c4c54dc872dd",
                                                "sense_id": "bda043e3-5c60-3f38-96a1-bfc76a08f4f9",
                                                "text": "\"She's different, mister. A real oddball, if you know what I mean. But your little girl would love her. All kids love the Doll Lady.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca1c5e6-fd8d-3744-bdbf-bb603a0b0bd3",
                                        "entry_id": "43b7ecd2-fcb3-36a0-aea6-56801c3eff4a",
                                        "glosses": [
                                            "A deviant stimulus that appears among repetitive stimuli during an experiment, to trigger an event-related potential in the participant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "oddball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "143e2c8c-3248-3323-abf8-4edd74a54e22",
                                        "entry_id": "c5958fda-c0d7-3d96-9c09-861b7e2e39d5",
                                        "glosses": [
                                            "Exotic, not mainstream."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c0c5ce-8612-4aca-b856-7c2783f02a9b",
                                                "sense_id": "143e2c8c-3248-3323-abf8-4edd74a54e22",
                                                "text": "An oddball word processor, for example, might never be supported by such helpful tools as spelling checkers, indexing programs, footnote utilities,..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df646cd9-0485-4083-b54f-7116a918df61",
                        "source_entry_id": "078eb1c7-7ed7-32cd-a961-6befa5d21b15",
                        "source_sense_id": "6991a1ba-fb1d-3dd1-8e51-187dc4fd6810",
                        "target_lang_word": "zany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                        "entry_id": "079340dd-4516-3c88-93f2-b8058055d771",
                                        "glosses": [
                                            "Unusual and awkward in a funny, comical manner; outlandish; clownish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12dd1329-88ab-4429-916c-cece2be055f2",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "And I will admit now but never then that, more than once, listening to the Viennese chattering their zany German on the pavements, or taking himself to one of the struggling small theatres that were cropping up in cellars and bombed houses..."
                                            },
                                            {
                                                "example_id": "69331169-2ad1-4dd8-81c4-1e103d313128",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "Press articles emphasized his [Dizzy Gillespie's] ambassadorial role and drew attention to the paradox that he was a shrewd musician and leader despite his zany image."
                                            },
                                            {
                                                "example_id": "1287dc13-a0c9-4038-8d64-1ab2e543556a",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "When playing for Connie Mack, Rube [Waddell]'s pattern after one of his zany outbursts usually involved promises of good behavior and a spurt of excellent pitching."
                                            },
                                            {
                                                "example_id": "d391d21f-86f6-4870-99c0-f529eb93db38",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "This runs counter to the play, where Grandpa is always benignly indulgent of all his zany progeny and their equally zany spouses, and is even somewhat zany himself."
                                            },
                                            {
                                                "example_id": "6f924c84-e138-4b59-b171-51653b980692",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "The montage goes on to show scenes of Carla singing, dancing, meditating, breaking the tension amongst her co-cheftestants with sing-a-longs and “hootie-hoo” lessons, and ultimately wooing the judges with a combination of her zany personality and solid cooking skills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1bb0b6-f375-3860-bf3d-da1ec59ce069",
                                        "entry_id": "079340dd-4516-3c88-93f2-b8058055d771",
                                        "glosses": [
                                            "Ludicrously or incongruously comical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "zany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                        "entry_id": "d72600c0-3241-39a8-b28c-549f098ebc76",
                                        "glosses": [
                                            "A fool or clown, especially one whose business on the stage is to imitate foolishly the actions of the principal clown."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e030596f-54a0-4579-86e7-1315aa4feef9",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "Then write that I may follow, and so be / Thy echo, thy debtor, thy foil, thy zany."
                                            },
                                            {
                                                "example_id": "3cdffa59-a6ff-4b8a-a132-0d6fae769141",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "O great restorer of the good old stage, / Preacher at once, and Zany of thy age!"
                                            },
                                            {
                                                "example_id": "16e487a3-d41a-4993-b17c-6a1645b150b5",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "So there he caught me lying like a zany on the ground. You may guess I stood at attention soon enough, but told him I was looking at the founds to see if they wanted underpinning from the floods."
                                            },
                                            {
                                                "example_id": "968df767-6d69-43bc-a75d-e10dbf6dd71f",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "Part of the illusory world is the 'quack' or mountebank who can be seen standing on his own special platform in the centre of the crowd[…]. Such a person travelled round to fairs and markets selling his nostrums or medicines. This character is dressed in a lace hat, long periwig and embroidered coat with lace cuffs, and is attended by his zany, who is wearing a chequered harlequin outfit and is 'quacking' or 'puffing' his master's wares. No seventeenth- or eighteenth-century mountebank was complete without his zany or 'Merry Andrew' – a term originally applied to Dr Andrew Boorde, physician to Henry VIII and noted for his ready wit and humour, who was the subject of many broadside ballads."
                                            }
                                        ]
                                    }
                                ]
                            },
