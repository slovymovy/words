                                            "Computergraphik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86591397-777f-42a8-af67-beb443de429a",
                                                "sense_id": "60858a15-02fb-30c9-b5c2-5162350b6f4d",
                                                "text": "„Pixel sind weder rechteckig noch quadratisch; vielmehr haben Pixel keinerlei räumliche Ausdehnung.“ (Quelle: Wikipedia, Artikel Pixel)"
                                            }
