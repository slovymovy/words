                        "examples": [
                            {
                                "example_id": "0c9526ce-ee74-4773-a0ec-5ddabd82158c",
                                "sense_id": "b8dcc9ce-e988-3ad5-b681-5e9f7b6fcd8a",
                                "text": "I just delete the porn before someone else uses the computer."
                            },
                            {
                                "example_id": "8a2b4237-f888-4158-9f7f-1840e64fdb29",
                                "sense_id": "b8dcc9ce-e988-3ad5-b681-5e9f7b6fcd8a",
                                "text": "Underground boards also carried handy programs for \"scanning\" telephone codes and raiding credit card companies, as well as the usual obnoxious galaxy of pirated software, cracked passwords, blue-box schematics, intrusion manuals, anarchy files, porn files, and so forth."
                            },
                            {
                                "example_id": "8fa478d3-627f-468d-8573-f6ea9efa6e3d",
                                "sense_id": "b8dcc9ce-e988-3ad5-b681-5e9f7b6fcd8a",
                                "text": "There're all kinds of ways to interact with our friends over the network: we can play hallucinogenic games, chat, send pictures, code, music, funny articles, metric fuckloads of porn… The interaction is high-quality!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c89ac958-b30a-38d8-9370-38728ed30b93",
                        "entry_id": "e4389ce8-5afd-30bc-8938-9338c95d2a65",
                        "glosses": [
                            "A pornographic work."
