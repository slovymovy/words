                                        "glosses": [
                                            "The distance from the left wingtip to the right wingtip (of a bird, airplane etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc0ac9e-4086-49eb-ae11-048729188348",
                                                "sense_id": "b0ce8134-d171-3f5e-883c-5ea1ffa17293",
                                                "text": "The wandering albatross has the largest wingspan of any living bird."
                                            },
                                            {
                                                "example_id": "56f02e59-bcde-4aa7-bd3f-b8e77251c4e7",
                                                "sense_id": "b0ce8134-d171-3f5e-883c-5ea1ffa17293",
                                                "text": "The Airbus A380 has one of the largest wingspans among aircraft; only a few surpass it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c494c4-e908-3992-92c2-56806a9a4b38",
