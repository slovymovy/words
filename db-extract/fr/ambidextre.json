                "senses": [
                    {
                        "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                        "entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
                        "glosses": [
                            "Qui se sert des deux mains avec une égale facilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46073278-1a53-46c0-9019-8bb168a1cb09",
                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                "text": "Homme ambidextre."
                            },
                            {
                                "example_id": "b10aa668-b195-4b3e-aec5-1f0e8039a24e",
                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                "text": "Femme ambidextre."
                            },
                            {
                                "example_id": "4465edb6-1e5a-4fd1-bd63-e585971d84f8",
                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                "text": "Après guerre, lʼutopie ambidextre est bel et bien passée de mode."
                            },
                            {
                                "example_id": "5d58533f-8e76-4a94-bc62-6c09a2aeeb81",
                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                "text": "La plupart des gens sont à moitié ambidextres"
                            }
                        ]
                    },
                    {
                        "sense_id": "5ae5fe52-f481-39fc-a730-73e0e6692ad4",
                        "entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
                        "glosses": [
                            "Bisexuel."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d91daf46-030f-4d57-b556-dedfcff22216",
                                "sense_id": "5ae5fe52-f481-39fc-a730-73e0e6692ad4",
                                "text": "Appelez-moi bisexuel ou, comme disaient les Anciens, ambidextre, je n’y vois pas d’inconvénient.' — (Claire Chartier, Le Viol et Nous, 2019)"
                            },
                            {
                                "example_id": "d5c03bc1-ce3e-49dd-a6c4-26b93abb665b",
                                "sense_id": "5ae5fe52-f481-39fc-a730-73e0e6692ad4",
                                "text": "Sujet : les ennuis de saint Sébastien à cause de son faible pour les garçons, et ç’aurait dû me mettre la puce à l’oreille, ça, parce que deux jours après la première de la pièce il m’a annoncé qu’il rompait et qu’il était « ambidextre », c’est-à-dire bisexuel, c’est-à-dire : Bravo, Margy, toujours ce pif pour les choisir !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a830aae3-7632-4bb1-aece-d129ae057edb",
                        "source_entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
                        "target_lang_word": "beidhändig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beidhändig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "161d9dad-858b-3893-b3df-6c6d2c4f2c18",
                                        "entry_id": "1c5181f3-9c13-3eea-9d45-1079e85cdabf",
                                        "glosses": [
                                            "Aktion mit zwei/allen Händen einer Person ausführend, selten auch, überwiegend medizinisch: an allen Händen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca0f5847-a819-4e3f-b989-087a71ebaef2",
                                                "sense_id": "161d9dad-858b-3893-b3df-6c6d2c4f2c18",
                                                "text": "Sie spielt die beidhändige Rückhand sehr kraftvoll."
                                            },
                                            {
                                                "example_id": "0e401cb2-cf89-4c01-855c-59c118ce251e",
                                                "sense_id": "161d9dad-858b-3893-b3df-6c6d2c4f2c18",
                                                "text": "Er hatte eine beidhändige Amputation zu überstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35fe16b7-25c3-3258-8590-222d5102e2ca",
                                        "entry_id": "1c5181f3-9c13-3eea-9d45-1079e85cdabf",
                                        "glosses": [
                                            "Aktion mit der einen dominanten Hand ebenso gut wie mit der anderen ausführend; auch: dazu in der Lage sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb385f9-9e42-4386-89d3-c46cac2bbb49",
                                                "sense_id": "35fe16b7-25c3-3258-8590-222d5102e2ca",
                                                "text": "Sie war in der Lage, beidhändig zu schreiben."
                                            },
                                            {
                                                "example_id": "f689eb0a-a4ec-4dcd-be41-d83a9c45aa21",
                                                "sense_id": "35fe16b7-25c3-3258-8590-222d5102e2ca",
                                                "text": "Er kann mit beiden Händen gleich gut schreiben oder einen Nagel in die Wand schlagen, also er ist beidhändig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7980c4ef-354d-41f2-8e03-f2108621f36c",
                        "source_entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
                        "target_lang_word": "zweihändig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweihändig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7267f113-115d-3735-8d2b-b11841bdbcb1",
                                        "entry_id": "1e2ca975-fce3-34ed-82a5-f4414607e5be",
                                        "glosses": [
                                            "mit beiden Händen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500cd127-cc37-400e-941e-ef19a3162ef0",
                                                "sense_id": "7267f113-115d-3735-8d2b-b11841bdbcb1",
                                                "text": "„Er saß an seinem Klavier, spielte zweihändig und, wenn er aus seinem Bierglas trank, auch mal einhändig.“"
                                            },
                                            {
                                                "example_id": "47d28fa6-b983-416d-b3dd-f646f06a323a",
                                                "sense_id": "7267f113-115d-3735-8d2b-b11841bdbcb1",
                                                "text": "„Vor einem Musikgeschäft steht ein zirka 18-jähriger Bursche mit nacktem Oberkörper und hält zweihändig ein kleines Gerät in Augenhöhe, vermutlich sein Handy. Er filmt eine Gruppe von drei Kollegen, die auf der andern Straßenseite […]“"
                                            },
                                            {
                                                "example_id": "9dde9e2a-8ec2-4ddb-a669-c89f115cdc2e",
                                                "sense_id": "7267f113-115d-3735-8d2b-b11841bdbcb1",
                                                "text": "„Schuberts zweihändige Tänze sind durchweg kurz und in ihrer formalen Beschaffenheit unkompliziert.“"
                                            },
                                            {
                                                "example_id": "f6aa4f81-8a47-4735-9ac7-e0571da37189",
                                                "sense_id": "7267f113-115d-3735-8d2b-b11841bdbcb1",
                                                "text": "„Über ihm stand ein Mann, ein wahrer Hüne in einer das Licht reflektierenden Rüstung, die seine Augen blendete, und drückte ihm die Spitze seines zweihändigen Schwertes auf die Brust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99892615-15cc-48a6-83c3-33895b2e4725",
                        "source_entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
