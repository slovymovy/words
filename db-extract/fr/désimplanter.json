                "senses": [
                    {
                        "sense_id": "b0c2650f-0ca3-3ca0-9c47-b0149fddce89",
                        "entry_id": "9fd3872b-fcff-36a5-a1c8-608e1fc753f4",
                        "glosses": [
                            "Enlever des marchandises qui avaient été implantées dans un rayon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc28d3ae-005d-4834-83e2-16ee2f54a9a1",
                                "sense_id": "b0c2650f-0ca3-3ca0-9c47-b0149fddce89",
                                "text": "Avant d'implanter, il nous faut d'abord désimplanter les produits."
                            }
                        ]
                    },
                    {
                        "sense_id": "b06e1c46-eef2-3829-bf1f-72e97ebe51b8",
                        "entry_id": "9fd3872b-fcff-36a5-a1c8-608e1fc753f4",
                        "glosses": [
                            "Retirer un implant à quelqu’un. Le complément est la personne à laquelle on retire des implants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410838f8-4de7-48d5-9061-4b50abd76775",
                                "sense_id": "b06e1c46-eef2-3829-bf1f-72e97ebe51b8",
                                "text": "Pourquoi a-t-il pris tant de risques pour désimplanter Lorenzo ? s'interrogea Laure."
                            },
                            {
                                "example_id": "1ad94202-f80d-4cc7-b101-76389c0ea00f",
                                "sense_id": "b06e1c46-eef2-3829-bf1f-72e97ebe51b8",
                                "text": "Doit-on désimplanter un patient à son décès?"
                            },
                            {
                                "example_id": "ced7a4cb-2a80-4e06-88a9-8677543375cb",
                                "sense_id": "b06e1c46-eef2-3829-bf1f-72e97ebe51b8",
                                "text": "Désimplanter une personne, c’est retirer ses implants à cette personne."
                            }
                        ]
                    }
