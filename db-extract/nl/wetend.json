                            {
                                "example_id": "3f15873c-1297-401c-8d12-f5bbe2a8ba9a",
                                "sense_id": "f5027058-4b26-3ed7-9155-4faf8d2e61a7",
                                "text": "Toen nog niet wetende dat ze zwanger was, stak ze een sigaret op."
                            },
                            {
                                "example_id": "f87df258-c650-4461-b429-73d22e901412",
                                "sense_id": "f5027058-4b26-3ed7-9155-4faf8d2e61a7",
                                "text": "Hij deed het even rustig aan, wetend dat het ergste nog moest komen."
                            },
                            {
                                "example_id": "6c4e7832-fac3-40c2-999a-8e501236099b",
                                "sense_id": "f5027058-4b26-3ed7-9155-4faf8d2e61a7",
                                "text": "De kansen zijn klein. Dat wetende, ga ik het toch proberen."
                            }
                        ]
