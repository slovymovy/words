                        "veilig naar binnen loodsen"
                    ],
                    "target_lang_definitions": {
                        "en": "to carefully guide someone or something to a destination or through a process",
                        "ru": "тщательно сопровождать кого-либо или что-либо к месту назначения или через процесс"
                    },
                    "translations": {
                        "en": [
