                "entry_id": "962685fa-62c5-3251-bd8b-08796249811c",
                "word": "returnless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cb7c474-e9d1-3f12-a2f7-371974efa369",
                        "entry_id": "962685fa-62c5-3251-bd8b-08796249811c",
                        "glosses": [
                            "from (or due to) which one will not, or cannot, return (of a journey, destination, situation, distance, etc.)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c1ff377-0971-418a-a6da-6be2ac6a915c",
                                "sense_id": "9cb7c474-e9d1-3f12-a2f7-371974efa369",
                                "text": "Seventeen years had rolled on their returnless flight since that night of withering sorrow."
                            },
                            {
                                "example_id": "07cd79fa-9725-49ac-bc8c-edc9e507b724",
                                "sense_id": "9cb7c474-e9d1-3f12-a2f7-371974efa369",
                                "text": "They would do an immensity of labor on their returnless journey to the ocean."
                            },
                            {
                                "example_id": "778da9a3-9373-4b99-a613-4a2de336f5e0",
                                "sense_id": "9cb7c474-e9d1-3f12-a2f7-371974efa369",
                                "text": "You must hear the judge's decision, remorselessly giving up the woman with her children born and unborn, into the hands of their claimants--by them to be carried to the slave prison, and thence to be sold to a returnless distance from the remaining but scattered fragments of her once happy family."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ff1b480-948d-356f-bb1a-8b8cc378d6ed",
                        "entry_id": "962685fa-62c5-3251-bd8b-08796249811c",
                        "glosses": [
                            "which will not return"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f20d626-b8ab-48ba-b7cc-16ada71c37a1",
                                "sense_id": "0ff1b480-948d-356f-bb1a-8b8cc378d6ed",
                                "text": "—but now false Memory loosed\nHer time-worn cable from the wilder'd mind,\nBlotting the chart whereon it loved to gaze\nMid the dim ocean of returnless years.—"
                            },
                            {
                                "example_id": "ff7c4976-193a-4823-b992-56e8f7d90b4f",
                                "sense_id": "0ff1b480-948d-356f-bb1a-8b8cc378d6ed",
                                "text": "Pass on, returnless year!"
                            }
                        ]
                    }
                ],
