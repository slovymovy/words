                "senses": [
                    {
                        "sense_id": "5891f9c2-72b6-3bbb-b4fc-f83fc3b99a18",
                        "entry_id": "0482f3a8-53a3-3880-adf5-c8724f3fa6a2",
                        "glosses": [
                            "A diesel-powered, four-wheel drive tactical military vehicle that can carry a wide variety of military hardware."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "50f1c3a5-ea7c-4d06-a62a-fd5c01ce8ccd",
                                "sense_id": "5891f9c2-72b6-3bbb-b4fc-f83fc3b99a18",
                                "text": "Stores, dealerships, galleries struggled to satisfy the skyrocketing demand for ever more recherché produce: limited-edition olive oils, three-hundred-dollar corkscrews, customized Humvees, the latest anti-virus software, escort services featuring contortionists and twins, video installations, outsider art, featherlight shawls made from the chin-fluff of extinct mountain goats."
                            },
                            {
                                "example_id": "481871e8-20bc-4d1a-86c8-d3dd0273317b",
                                "sense_id": "5891f9c2-72b6-3bbb-b4fc-f83fc3b99a18",
                                "text": "We went out into the streets of Zafaraniya, travelling in the usual two-Humvee convoy, complete with gunners."
                            },
                            {
                                "example_id": "0cb03fc3-28b6-44fc-a74c-a726490b79bd",
                                "sense_id": "5891f9c2-72b6-3bbb-b4fc-f83fc3b99a18",
                                "text": "Last week, I read 2,300 Humvees—these are big vehicles—were left behind for the enemy. 2,000? You would say maybe two, maybe four? 2,300 sophisticated vehicles, they ran, and the enemy took them."
                            }
                        ]
                    }
