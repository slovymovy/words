                {
                    "sense_id": "1db5f6a0-9a04-3ba5-a1d8-66078911245f",
                    "sense_definition": "in overeenstemming zijn met iets anders; kloppen of passen bij een bepaalde situatie of bewering",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenstemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn verklaring bleek later niet te <w>stroken</w> met de feiten.",
                            "target_lang_translations": {
                                "en": "His statement later turned out not to <w>agree</w> with the facts.",
                                "ru": "Его заявление, как выяснилось позже, не <w>соответствовало</w> фактам."
                            }
                        },
                        {
                            "text": "Deze nieuwe regels lijken niet te <w>stroken</w> met de eerdere afspraken.",
                            "target_lang_translations": {
                                "en": "These new rules do not seem to <w>be consistent</w> with the previous agreements.",
                                "ru": "Эти новые правила, кажется, не <w>согласуются</w> с прежними договоренностями."
                            }
                        }
                    ],
                    "synonyms": [
                        "overeenstemmen",
                        "kloppen",
                        "overeenkomen"
                    ],
                    "antonyms": [
                        "tegenspreken",
                        "afwijken",
                        "botsen"
                    ],
                    "common_phrases": [
                        "niet stroken met",
                        "stroken met de feiten",
                        "stroken met de werkelijkheid"
                    ],
                    "target_lang_definitions": {
                        "en": "to be in agreement or consistent with something else; to match a certain situation or statement",
                        "ru": "соответствовать чему-либо другому; совпадать или подходить к определенной ситуации или утверждению"
                    },
                    "translations": {
