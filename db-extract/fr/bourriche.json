                                        "entry_id": "34c3bcaf-85da-3087-ae54-5be2b31fdf19",
                                        "glosses": [
                                            "A net strung on wire hoops and sealed at one end, suspended in water by anglers to keep alive the fish they have caught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6794a141-e2c8-417f-9e70-5c23813caf8e",
                                                "sense_id": "cd642a05-8c73-3cef-ab8d-160b11071905",
                                                "text": "Once she'd hooked them, she'd free them and put them in a keep net."
                                            }
