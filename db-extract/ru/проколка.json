                "senses": [
                    {
                        "sense_id": "2733edaa-337d-3e6d-93d8-f67b45fb341b",
                        "entry_id": "602dbce9-4c90-3149-b94d-f7ac8df75ba8",
                        "glosses": [
                            "действие по значению гл. проколоть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4153d429-7f7b-47ea-894f-dcfd6c134894",
                                "sense_id": "2733edaa-337d-3e6d-93d8-f67b45fb341b",
                                "text": "Петр Акиндинович применил и целый ряд детальных усовершенствований в производстве работ, которые вели к большей их точности и тщательности, не только не повышая стоимости, но даже снижая её. Как пример, укажу на разметку и затем проколку дыр."
                            }
                        ]
                    },
                    {
                        "sense_id": "179f3e3b-e5fd-37ff-836b-adde1f1eac06",
                        "entry_id": "602dbce9-4c90-3149-b94d-f7ac8df75ba8",
                        "glosses": [
                            "заострённая палочка для прокалывания отверстий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106fc059-781f-4a93-ab05-22e979f2f659",
                                "sense_id": "179f3e3b-e5fd-37ff-836b-adde1f1eac06",
                                "text": "Костяных поделок много, но весьма знаменательно изменяется их состав ― это по преимуществу проколки, шилья, нарядные орнаментированные поделки почти исчезают."
                            }
                        ]
                    }
                ],
