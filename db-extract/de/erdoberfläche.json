                ],
                "senses": [
                    {
                        "sense_id": "428d8e47-069d-33b7-a1d6-cd3478c10ab0",
                        "entry_id": "80ed8daa-78f0-3e0c-8a17-53b72ceeabf0",
                        "glosses": [
                            "die Oberfläche der Erde, mit verschiedenen Definitionen"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8874a80-4083-3f97-bff4-34421508a5f0",
                        "entry_id": "80ed8daa-78f0-3e0c-8a17-53b72ceeabf0",
                        "glosses": [
                            "(gegenwärtige oder ehemalige) Oberfläche der festen Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed475213-a0ce-4f98-b3b6-aa6bf8610d23",
                                "sense_id": "f8874a80-4083-3f97-bff4-34421508a5f0",
                                "text": "Über 70 Prozent der Erdoberfläche sind von Wasser bedeckt."
                            },
                            {
                                "example_id": "0fa2f024-423a-4277-aed5-ba17dbaed485",
                                "sense_id": "f8874a80-4083-3f97-bff4-34421508a5f0",
                                "text": "„Die Biosphäre hört nicht am Boden auf, sondern setzt sich unter der Erdoberfläche fort.“"
                            },
                            {
                                "example_id": "22944d38-9803-414f-ba07-8fc64664d963",
                                "sense_id": "f8874a80-4083-3f97-bff4-34421508a5f0",
                                "text": "„Hat doch Cuvier ſchon 14 Erdoberflächen entdeckt, und wer weiß, wie viele andere er noch mit der Zeit entdecken wird!“"
                            },
                            {
                                "example_id": "9cd50dea-9527-4154-80cf-c3e05ebd4df1",
                                "sense_id": "f8874a80-4083-3f97-bff4-34421508a5f0",
                                "text": "„In der Zwischenzeit hatte der Ingenieur einen Steinkohlenflöz entdeckt, der nahe am Roten Fluß an die Erdoberfläche trat.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "61d687c8-f377-308c-bfad-4fe1b63a13b3",
                        "entry_id": "80ed8daa-78f0-3e0c-8a17-53b72ceeabf0",
                        "glosses": [
                            "Oberfläche des Geoids (oder eines daran angenähertes Rotationsellipsoids) auf Meereshöhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "567f7b78-521d-46dd-a295-b5a502671201",
                                "sense_id": "61d687c8-f377-308c-bfad-4fe1b63a13b3",
                                "text": "„Dann nimmt man als Annäherung dritten Grades eine ideale Erdoberfläche an, das sog. Geoid, die die wahren, beobachteten Lotrichtungen senkrecht schneidet.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "44301f6e-f2b4-3cd5-b650-5b475e25fb76",
                        "entry_id": "80ed8daa-78f0-3e0c-8a17-53b72ceeabf0",
                        "glosses": [
                            "Fläche von der Größe der gesamten Oberfläche der Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c693ace8-185f-411e-b80f-5b5a97fdc2a7",
                                "sense_id": "44301f6e-f2b4-3cd5-b650-5b475e25fb76",
                                "text": "„Die Fläche des grössern Flecks betrug 10—11 Erdoberflächen, die des kleinern 7—8 Erdoberflächen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d30f5897-601b-3de1-a9de-3c02ffab304d",
                        "entry_id": "80ed8daa-78f0-3e0c-8a17-53b72ceeabf0",
                        "glosses": [
                            "obere Seite einer Erdschicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af672f42-1485-4f09-9032-429c0ceb1d8b",
                                "sense_id": "d30f5897-601b-3de1-a9de-3c02ffab304d",
                                "text": "„Um endlich die Bedingungen der Verdunstung einer Wasseroberfläche mit verschiedenen Erdoberflächen absolut gleich herzustellen, wurde noch folgender Versuch ausgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
