                ],
                "senses": [
                    {
                        "sense_id": "440d9dda-a251-3a9a-aea3-732da2695034",
                        "entry_id": "457fe5a1-9089-35fd-879c-ac7a9b93af9b",
                        "glosses": [
                            "A soul patch, especially in a historical (pre-modern) context."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80658a7-8e20-4c8b-9376-c9d9ebf4fd1c",
                                "sense_id": "440d9dda-a251-3a9a-aea3-732da2695034",
                                "text": "They lent him a worn aspect which not even a fiercely erect little mustache and a tiny mouche beneath the lower lip could counteract."
                            },
                            {
                                "example_id": "4354685f-ffac-40f9-bf35-77a0bc018f81",
                                "sense_id": "440d9dda-a251-3a9a-aea3-732da2695034",
                                "text": "The hair and beard are represented by a plastic mass : the mouche under the lower lip radiates outward and the moustache consists of two separate strands ending in spirals."
                            },
                            {
                                "example_id": "bd5a0273-be30-40cc-ab68-618947a1d1b1",
                                "sense_id": "440d9dda-a251-3a9a-aea3-732da2695034",
                                "text": "In the colonial period, the taste for red lips and cheeks came and went, as did fashions for mouches and wigs."
                            },
                            {
                                "example_id": "34ed049e-ae9a-4b62-9ea2-86d0a76f1080",
                                "sense_id": "440d9dda-a251-3a9a-aea3-732da2695034",
                                "text": "LA is very thin, wears a thin mustache and a tiny beatnik mouche under his lower lip. His brown hair is shoulder length. Mike is surfer-blond, like Ricky in Germany; his hair is shorter, accentuating his somewhat pudgy countenance."
                            }
                        ]
                    },
                    {
                        "sense_id": "82cac309-1d9b-32a1-bd75-65618c0f06ac",
                        "entry_id": "457fe5a1-9089-35fd-879c-ac7a9b93af9b",
                        "glosses": [
                            "Small stickers or patches affixed to the face as a beauty mark."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
