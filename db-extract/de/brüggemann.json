                ],
                "senses": [
                    {
                        "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                        "entry_id": "9631a06d-3b00-36f4-b12f-852b0d8cf619",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43894a98-04cb-4521-88f8-b436c7f6b86e",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Die Brüggemanns fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "440acdf1-cff9-4c8b-a322-46bc2ebf2dfb",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Herr Brüggemann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "02c3dceb-c7ed-4fb0-987b-5f041bfa2d49",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Frau Brüggemann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "da7b90d4-1ed6-41c7-8959-340f7ca4753c",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Der Brüggemann trägt nie die Pullover, die die Brüggemann ihm strickt."
                            },
                            {
                                "example_id": "ddfd79e8-b721-4c3d-a020-0824def5191b",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brüggemann kommt, geht der Herr Brüggemann.“"
                            },
                            {
                                "example_id": "d71a3b11-10ac-437b-a750-8d2f2db16a94",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Brüggemann kommt und geht."
                            },
                            {
                                "example_id": "732ee034-8717-4d2c-8c19-86fd5d194c78",
                                "sense_id": "14119007-24e6-37fd-a342-f60aaf7269f2",
                                "text": "Brüggemanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
