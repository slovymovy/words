                                        "entry_id": "cc790458-b9ed-3649-bbc4-de39e78f0d00",
                                        "glosses": [
                                            "A region or sovereign nation headed by a prince or princess."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9d262b-8d4e-4366-9f2b-32cd7e1d12ac",
                                                "sense_id": "6402b41a-7e94-3744-bc24-df3912883863",
                                                "text": "At this time Russia consisted of a dozen or so principalities, which were frequently at war with one another."
                                            },
                                            {
                                                "example_id": "db353e61-ecd8-46f1-9670-88add953c5b5",
                                                "sense_id": "6402b41a-7e94-3744-bc24-df3912883863",
                                                "text": "The principality of Freedonia (www.freedonia.org), an earnest collective of secessionist superlibertarians based in Boston, falls into the first category."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0c35bd5-eb47-3143-adf6-385bedc36a31",
                                        "entry_id": "cc790458-b9ed-3649-bbc4-de39e78f0d00",
                                        "glosses": [
                                            "A spiritual being, specifically in Christian angelology, the third lowest level of angels, ranked above archangels and below powers."
