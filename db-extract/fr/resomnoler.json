                        "examples": [
                            {
                                "example_id": "0751d88f-8f55-4d94-a6cb-c78e5a7daf25",
                                "sense_id": "a0aabe6f-814d-3e4f-872e-59a519ad4919",
                                "text": "Moi réveillée par le chat qui ronronne, j’ai réussi à resomnoler un peu, après l’avoir viré dehors."
                            },
                            {
                                "example_id": "fae9473c-b560-4c85-9030-ef5fefc2d3c4",
                                "sense_id": "a0aabe6f-814d-3e4f-872e-59a519ad4919",
                                "text": "J’allume la télé, je somnole, puis je regarde la télé, je resomnole, j’écoute mon MP3, etc… ^([sic : etc.])"
                            },
                            {
                                "example_id": "e9e134e6-cb9e-47eb-8cce-56153b6301ef",
                                "sense_id": "a0aabe6f-814d-3e4f-872e-59a519ad4919",
                                "text": "Je commence à resomnoler et j’ai toujours du mal à émerger même si sa ^([sic : ça]) allait quand même mieux."
                            }
                        ]
                    }
