                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "b4c7311e-5154-44df-8bf1-71141d536089",
                                "sense_id": "7ed51610-25b1-3536-ba68-01fc07d1116b",
                                "text": "The white-bellied sea eagle is almost as big as a wedgie and handsomely marked in grey and white."
                            },
                            {
                                "example_id": "7219bb0e-66c5-40d2-bb07-7add1ff75f4c",
                                "sense_id": "7ed51610-25b1-3536-ba68-01fc07d1116b",
                                "text": "Well over a century later the ‘wedgie’ continues to be persecuted, with some rural Tasmanians taking a gun to it when they can."
                            }
                        ]
