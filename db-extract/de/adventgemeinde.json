                "senses": [
                    {
                        "sense_id": "329fcd58-4392-34cc-8a86-b3e0083ae573",
                        "entry_id": "5d365494-8d19-384d-b2ee-39f9fe665ddd",
                        "glosses": [
                            "Ortsgemeinde der adventistischen Religionsgemeinschaft; kleinste organisatorische Einheit der Adventisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e902b9-7ca4-418b-9454-a2b5bdc36fa9",
                                "sense_id": "329fcd58-4392-34cc-8a86-b3e0083ae573",
                                "text": "Sie sahen ihre Aufgabe darin, als »Wächter auf den Mauern Zions« mit dem »lauten Ruf« die Gerechten aus der zu Babylon gewordenen Adventgemeinde herauszurufen."
                            },
                            {
                                "example_id": "753599a6-54c5-4809-a857-7ea9d6203d4c",
                                "sense_id": "329fcd58-4392-34cc-8a86-b3e0083ae573",
                                "text": "Die Gefahr, dass die Adventgemeinde in den Fundamentalismus abgleitet, scheint jedoch in der Gegenwart nicht so aktuell zu sein, wie sie es in der Zeit vor den 1950er Jahren war."
                            },
                            {
                                "example_id": "48dc9437-63a7-4f09-b945-00bbfb4a15ab",
                                "sense_id": "329fcd58-4392-34cc-8a86-b3e0083ae573",
                                "text": "Ich bin momentan noch nicht soweit, zur Adventgemeinde zurückzukehren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
