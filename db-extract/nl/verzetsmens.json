                "senses": [
                    {
                        "sense_id": "cba46ca9-a826-3539-b972-53ca8bfa66c0",
                        "entry_id": "f36a2593-e55f-3198-8b4e-460c6b22053a",
                        "glosses": [
                            "iemand die tegenstand biedt aan gezag dat hij niet aanvaardt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7cd934-36b0-4e84-8a3a-2c97cf58f635",
                                "sense_id": "cba46ca9-a826-3539-b972-53ca8bfa66c0",
                                "text": "De mens, ooit dood en zonder hoop, kan verzetsmens en 'minnaar van het leven'/'Liebhaber des Lebens' (Deuterocanonieke boek Wijsheid 11: 26) worden."
                            },
                            {
                                "example_id": "a67b0980-bc50-47de-b80e-c2f1a817f5d3",
                                "sense_id": "cba46ca9-a826-3539-b972-53ca8bfa66c0",
                                "text": "Het moment waarop een geweldsbesluit wordt genomen, moet een waar verzetsmens zo lang mogelijk uitstellen, omdat de politieke en menselijke gevolgen daarvan absoluut onvoorzienbaar zijn."
                            },
                            {
                                "example_id": "d0fd656b-538e-496a-a672-7c5e3e09a10a",
                                "sense_id": "cba46ca9-a826-3539-b972-53ca8bfa66c0",
                                "text": "Ziehier de vergelijking: Croiset is een uiterst gespannen verzetsmens en Wegener is van een grotere en bredere menselijkheid."
                            },
                            {
                                "example_id": "4fb73ab2-80fb-4d04-9c69-46131eddca7f",
                                "sense_id": "cba46ca9-a826-3539-b972-53ca8bfa66c0",
                                "text": "⧖ Hij werd een verzetsmensch tegen wat de vorige generatie van het leven had gemaakt."
                            },
                            {
                                "example_id": "2d2eae0c-3b4a-497c-b001-0e4271a3b17f",
                                "sense_id": "cba46ca9-a826-3539-b972-53ca8bfa66c0",
                                "text": "⧖ Het wilde stelsellooze schieten en wanhopig uitvallen dienden den verzetsmenschen tot niets dan tot hun ondergang."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4eb06f-2056-3dbb-ae4c-0308b448c6f8",
                        "entry_id": "f36a2593-e55f-3198-8b4e-460c6b22053a",
                        "glosses": [
                            "burger die tijdens de Tweede Wereldoorlog georganiseerd tegenstand bood aan de nazi's"
                        ],
                        "tags": [
                            "pregnant"
                        ],
                        "examples": [
                            {
                                "example_id": "a8a2d68a-4936-41b2-b98a-fcf99f017191",
                                "sense_id": "5a4eb06f-2056-3dbb-ae4c-0308b448c6f8",
                                "text": "Hij slaat er onderzoeken op na, en ontdekt onder meer dat sommige onderzoekers meenden dat verzetsmensen vaak uit anti-autoritaire gezinnen kwamen, of juist een zeer gelovige achtergrond hadden."
                            },
                            {
                                "example_id": "56996257-38bf-4883-bd84-afa843340e4b",
                                "sense_id": "5a4eb06f-2056-3dbb-ae4c-0308b448c6f8",
                                "text": "Een getuige vertelde: “Onze gemeentesekretaris [sic!] was tegen de Duitsers. Hij was een echt verzetsmens en daarom kwam hij niet goed overeen met de burgemeester Engels. De zwarte burgemeester kwam niet goed overeen met een deel van het schepencollege.”"
                            },
                            {
                                "example_id": "d3152d84-03e6-46e3-96f9-3727d686f022",
                                "sense_id": "5a4eb06f-2056-3dbb-ae4c-0308b448c6f8",
                                "text": "⧖ Daarom werkte het personeel van het C.V.B, eensgezind en met volharding, en menigeen heeft hieraan te danken, dat hij dezen winter is doorgekomen, want elk waarachtig verzetsmensch had geen tijd om voor eigen fourageering te zorgen, hij werkte van 's morgens vroeg tot 's avonds laat en dacht niet aan eten halen."
                            }
                        ]
                    }
                ],
