                ],
                "senses": [
                    {
                        "sense_id": "afa785c6-13b2-3473-b84c-0a3acdc48cbe",
                        "entry_id": "240b951f-1d82-36e4-af88-ca19e24fe6b5",
                        "glosses": [
                            "Baver un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f86ea2-35ec-4070-b8b4-cba57b2bd254",
                                "sense_id": "afa785c6-13b2-3473-b84c-0a3acdc48cbe",
                                "text": "Ce pompeur de biberons commençait à bavoter des sons informes, auxquels elle répondait de vraies paroles pour nous faire croire qu’il avait dit quelque chose. C’était un spectacle navrant."
                            },
                            {
                                "example_id": "657f3a78-99ce-493c-b1b7-495f3b73d1e1",
                                "sense_id": "afa785c6-13b2-3473-b84c-0a3acdc48cbe",
                                "text": "La petite Bodil, couchée à plat ventre à côté de l’arbre de Noël, bavotait et gargouillait tandis qu’Asa Torell, accroupie par terre, jouait avec le bébé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bd81163-dabc-31b5-be51-ff54c6e2948a",
                        "entry_id": "240b951f-1d82-36e4-af88-ca19e24fe6b5",
