                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ae853fb-bdf2-48c3-a9ad-5a0eab7cd696",
                        "source_entry_id": "321019a8-3265-3e00-b6ac-625f53c0c2f3",
                        "source_sense_id": "19f962f6-2854-377d-a92a-1a04d8db5dcd",
                        "source_sense_description": "sluimerend",
                        "target_lang_word": "quiescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quiescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c5b0ad0-c77e-3589-ae22-2156a059faac",
                                        "entry_id": "7561597c-19fb-329f-a5da-1bc9fffe31ab",
                                        "glosses": [
                                            "Inactive, quiet, at rest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b09bb48-54d6-4447-a5e9-b90fe053c1e6",
                                                "sense_id": "6c5b0ad0-c77e-3589-ae22-2156a059faac",
                                                "text": "The bats were quiescent at that time of day, so we slowly entered the cave."
                                            },
                                            {
                                                "example_id": "a40cf566-0fb1-41cf-831e-20ff9a22c204",
                                                "sense_id": "6c5b0ad0-c77e-3589-ae22-2156a059faac",
                                                "text": "In times of national security, the feeling of Patriotism among the masses is so quiescent that it seems hardly to exist—in their case national glory or national danger awakens it, and it leaps up armed cap-a-pie."
                                            },
                                            {
                                                "example_id": "4a36f9c1-80ab-474f-872c-65f65b0ff45f",
                                                "sense_id": "6c5b0ad0-c77e-3589-ae22-2156a059faac",
                                                "text": "Movement was then observed in a part of the wall which had been quiescent, and another group of struts was therefore constructed, again during traffic hours as well as at night."
                                            },
                                            {
                                                "example_id": "e2932a96-4cff-4589-8bca-3fbb5c4be461",
                                                "sense_id": "6c5b0ad0-c77e-3589-ae22-2156a059faac",
                                                "text": "After all, nations are pouring massive resources into military applications of AI, and many citizens don’t know or don’t care. Yet that quiescent attitude may change over time, as the domestic use of AI surveillance ratchets up, and that technology is increasingly identified with shadowy apparatuses of control, rather than democratically accountable local powers."
                                            },
                                            {
                                                "example_id": "9b17825c-2d54-4765-9cf7-e1cd77a2a8b7",
                                                "sense_id": "6c5b0ad0-c77e-3589-ae22-2156a059faac",
                                                "text": "“It's like the opposite of punk, isn't it?” he said jokingly in 2016 while discussing his influence on other musicians. “I've subdued a generation.” But [James] Blake is not so quiescent after all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf76b77-fff0-35c8-afca-494428f8faa9",
                                        "entry_id": "7561597c-19fb-329f-a5da-1bc9fffe31ab",
                                        "glosses": [
                                            "Not sounded; silent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41d2a82-c262-49e7-a306-8436c8aba157",
                                                "sense_id": "4bf76b77-fff0-35c8-afca-494428f8faa9",
                                                "text": "The k is quiescent in \"knight\" and \"know\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff75a6ee-4a38-3941-861d-c15d36bb04f0",
                                        "entry_id": "7561597c-19fb-329f-a5da-1bc9fffe31ab",
                                        "glosses": [
                                            "Non-proliferating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "731be178-6260-4f4f-968f-4dfebf9fc46d",
                        "source_entry_id": "321019a8-3265-3e00-b6ac-625f53c0c2f3",
                        "source_sense_id": "19f962f6-2854-377d-a92a-1a04d8db5dcd",
                        "source_sense_description": "sluimerend",
                        "target_lang_word": "latent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b43ad61a-50da-34a5-94b0-79fc7bfc0e0a",
                                        "entry_id": "990357e4-7278-31d2-9899-fd0eb6873582",
                                        "glosses": [
                                            "Non apparent, qui ne se manifeste pas, sous-jacent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cedea966-c4f0-43c3-a311-3bb12539e680",
                                                "sense_id": "b43ad61a-50da-34a5-94b0-79fc7bfc0e0a",
                                                "text": "Ne peut-on pas admettre […], que les êtres exceptionnels qui apparaissent de loin en loin dans une famille, ne sont que le fait de l’éclosion spontanée de qualités supérieures restées latentes chez leurs prédécesseurs ?"
                                            },
                                            {
                                                "example_id": "5dae7b41-b6cd-4697-bd1a-8802402cfe9f",
                                                "sense_id": "b43ad61a-50da-34a5-94b0-79fc7bfc0e0a",
                                                "text": "Laissez-la [la branche] intacte si elle n’est pas trop longue, sinon taillez au-dessus de 5 à 6 groupes de fleurs. À la base, le repercement d’un œil latent est possible, ce qui assurera le remplacement de la chiffonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260ea83b-9523-3c92-aab1-94aec81ce42b",
                                        "entry_id": "990357e4-7278-31d2-9899-fd0eb6873582",
                                        "glosses": [
                                            "Caché."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7169ca44-f678-4348-9a31-58ea3f44dce3",
                                                "sense_id": "260ea83b-9523-3c92-aab1-94aec81ce42b",
                                                "text": "À en croire les informations de presse les plus fraîches, un compromis semble se dessiner sur un programme moins ambitieux, mais financé, au moins en partie, par une mesure fiscale plutôt inédite, et très populaire auprès des économistes progressistes: la taxation des plus-values dites « latentes ».\n […].\nEn clair, il s’agirait de taxer les gains dormant dans les épais portefeuilles d’actions des grandes fortunes américaines, après une période particulièrement faste sur les marchés."
                                            },
                                            {
                                                "example_id": "0720b21a-8bb8-4863-b31c-41ddd92a811e",
                                                "sense_id": "260ea83b-9523-3c92-aab1-94aec81ce42b",
                                                "text": "va jusqu’à l’innommé le vétuste l’insoupçonné – il gît latent au fond des profondeurs attend d’être cueilli comme on le dirait d’une fleur oubliée d’une pierre qui ne sait plus luire depuis son enfouissement qui ne veut pas quitter le creux des boues – nettoie la source du limon"
                                            }
