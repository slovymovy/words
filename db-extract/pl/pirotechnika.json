                                "target_senses": [
                                    {
                                        "sense_id": "16376291-708c-30f5-9011-200eab57b907",
                                        "entry_id": "72e8617d-c1f8-31f6-a96a-a8fd78b05bdc",
                                        "glosses": [
                                            "die Kunst der Herstellung und Verwendung von Feuerwerkskörpern und anderen Explosivstoffen"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4006e04-50c9-4b39-84cd-86a981ce69c0",
                                                "sense_id": "16376291-708c-30f5-9011-200eab57b907",
                                                "text": "„Auf den Dächern erscheinen Vermummte, die den Demozug mit Pyrotechnik empfangen.“"
                                            }
