                        "glosses": [
                            "von Komplexen belastet; voller Komplexe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0028ef20-4d0e-43ea-a78b-718203b77d57",
                                "sense_id": "3a361d1f-ae3c-31eb-a310-f95cebf777b8",
                                "text": "Das glamouröse Reich der Stars ist von komplexbeladenen Mobbingopfern bevölkert."
                            },
                            {
                                "example_id": "c405370d-aebe-4f5a-b2fd-9ef8d3c94e97",
                                "sense_id": "3a361d1f-ae3c-31eb-a310-f95cebf777b8",
                                "text": "In Verbindung mit einem komplexbeladenen Machtstreben oder Geltungssucht können sich die Minderwertigkeitsgefühle bis zur „Profilneurose“ steigern."
                            },
                            {
                                "example_id": "e6800142-86f4-4cca-933f-7e5e721ee8d7",
                                "sense_id": "3a361d1f-ae3c-31eb-a310-f95cebf777b8",
                                "text": "Komplexbeladen glaubt er seine Leistung nicht erbracht zu haben."
                            }
