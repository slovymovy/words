                    {
                        "translation_id": "c2f72b18-7353-4508-b8ad-cb1d39bbedb4",
                        "source_entry_id": "8f4cdaa2-0746-3707-b14e-c92a28a68808",
                        "target_lang_word": "scragginess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scragginess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9abf122-ee81-39e9-a232-6928077aa202",
                                        "entry_id": "f065ecaf-4e48-302c-a0dc-4d58c89d72c7",
                                        "glosses": [
                                            "Roughness; irregularity; jaggedness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38ed90e-5a29-49b8-9be5-b48947d48c19",
                                                "sense_id": "c9abf122-ee81-39e9-a232-6928077aa202",
                                                "text": "He wore the scragginess of an unshaven face like a lost man in pursuit of some safe harbor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93638aa5-0370-3d2e-aac8-0444c46a81a3",
                                        "entry_id": "f065ecaf-4e48-302c-a0dc-4d58c89d72c7",
                                        "glosses": [
                                            "Leanness or thinness, especially as tending toward haggardness; scrawniness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ea85e3-54ac-4256-a15f-5209fa38ef8e",
                                                "sense_id": "93638aa5-0370-3d2e-aac8-0444c46a81a3",
                                                "text": "[I]f Marian's girlish slimness showed faint, prophetic signs of degenerating into scragginess, George was still far too deeply in love to heed such evil and irreverent prophecies."
                                            },
                                            {
                                                "example_id": "01d82cfa-3ecf-48c6-98a8-1a7139ce8855",
                                                "sense_id": "93638aa5-0370-3d2e-aac8-0444c46a81a3",
                                                "text": "There is not the least look of scragginess about her, just extreme slenderness, a small-boned creature of perhaps five foot four or five."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "080686e1-3ad1-4cb2-af38-534de5190c11",
                        "source_entry_id": "8f4cdaa2-0746-3707-b14e-c92a28a68808",
                        "target_lang_word": "thinness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thinness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9040525a-282c-34ab-9d52-91a974f647d6",
                                        "entry_id": "77866b2d-4a68-3478-9a7b-6769cd43e7c7",
                                        "glosses": [
                                            "The state or quality of being thin."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bbf48c0-64fc-4cfb-afd4-e40c55d22168",
                                                "sense_id": "9040525a-282c-34ab-9d52-91a974f647d6",
                                                "text": "The beautiful prismatic colours seen on the Labrodore stone are owing to a similar cause, viz. the thinness of the laminæ of which it consists […]."
                                            },
                                            {
                                                "example_id": "ed267a84-7b98-4eff-8889-b5afaac2aace",
                                                "sense_id": "9040525a-282c-34ab-9d52-91a974f647d6",
                                                "text": "Beyond celebrating the aesthetic value of thinness, pro-anas claim that thinness is a reflection of excellence in other areas of one's life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b39adf1-8d58-4a35-933b-9e0daca08825",
                        "source_entry_id": "8f4cdaa2-0746-3707-b14e-c92a28a68808",
                        "target_lang_word": "delgadez",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delgadez",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec7a2be-6704-382f-a018-5630a150d6f0",
                                        "entry_id": "669abfb9-85bc-3a0c-b0a1-01e614e8285f",
                                        "glosses": [
                                            "Calidad de delgado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5d9732-3394-4cb8-8d05-e8a6c24d49ef",
                                                "sense_id": "8ec7a2be-6704-382f-a018-5630a150d6f0",
                                                "text": "«Desde hace unos años se ha ido estableciendo la extrema delgadez como el ideal de belleza, aceptado en muchas culturas»."
                                            },
                                            {
                                                "example_id": "9b3c6c97-2e69-4293-88d8-fc5836ca61e5",
                                                "sense_id": "8ec7a2be-6704-382f-a018-5630a150d6f0",
                                                "text": "«Porque las mujeres jóvenes están constantemente exigidas, a través de los medios masivos y la moda, a conseguir una imagen corporal estilizada. Esto lleva a la joven a buscar el patrón corporal de moda, sometiéndose a dietas estrictas y ayunos prolongados para conseguir la imagen de extrema delgadez de las modelos que presentan las revistas de moda femenina y la televisión. En muchos casos una dieta estricta puede desencadenar una anorexia nerviosa en una mujer psíquicamente predispuesta»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
