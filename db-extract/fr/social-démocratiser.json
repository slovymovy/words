                ],
                "senses": [
                    {
                        "sense_id": "85bfee9f-f388-3e5a-8455-0cd0921f2d7c",
                        "entry_id": "417f2418-f8f9-3919-bf81-6f27adfb99f5",
                        "glosses": [
                            "Donner un caractère social-démocrate à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b9e223-2e81-48c4-b773-c3eddc375c67",
                                "sense_id": "85bfee9f-f388-3e5a-8455-0cd0921f2d7c",
                                "text": "Il est dérisoire que les socialistes, frappés de myopie, cherchent à aggiornamenter, moderniser, social-démocratiser, alors que le monde, l’Europe, la France sont affrontés aux problèmes gigantesques de la fin des Temps modernes."
                            },
                            {
                                "example_id": "9d5a51eb-2374-4fa5-ad97-20f375af4c2a",
                                "sense_id": "85bfee9f-f388-3e5a-8455-0cd0921f2d7c",
                                "text": "Pourquoi certains partis ont-ils choisi de se « social-démocratiser » ou de devenir « verts », et d’autres de rester fidèle au marxisme-léninisme ?"
                            },
                            {
                                "example_id": "0a77c1ed-9d10-4906-9e96-1ab9a86c9a93",
                                "sense_id": "85bfee9f-f388-3e5a-8455-0cd0921f2d7c",
                                "text": "A partir de la fin des années 60, le « modèle allemand » se « social-démocratise » et « keynésianise » au moment où le SPD est aux affaires."
                            }
                        ]
                    }
                ],
