                ],
                "senses": [
                    {
                        "sense_id": "2221e331-2876-366f-a911-6829b946297b",
                        "entry_id": "2b30f5e2-967c-33e7-8a0e-21813ea64288",
                        "glosses": [
                            "aus dünnem, rundem, ovalen oder auch flachem Edelstahl Endlosdraht hergestelltes Geflecht, in Form von schlingenförmig ineinandergreifenden Maschen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "b70fa1e9-031b-42ca-9f36-c1a2af588431",
                                "sense_id": "2221e331-2876-366f-a911-6829b946297b",
                                "text": "„Diese wurde im Laufe der Zeit durch ein langlebiges, unempfindliches, weiches Edelstahlgestrick ersetzt, welches wartungsfrei ist. “"
                            },
                            {
                                "example_id": "9e569f1e-983d-42d2-9e38-8a7574007818",
                                "sense_id": "2221e331-2876-366f-a911-6829b946297b",
                                "text": "„Gummikabel und Schläuche können mit diesem stabilen Edelstahlgestrick geschützt werden.“"
                            },
                            {
                                "example_id": "e43061ed-42ea-4f98-a639-464fab65af5e",
                                "sense_id": "2221e331-2876-366f-a911-6829b946297b",
                                "text": "„Die Metallfilter […] bestehen aus sehr beständigem, mehrlagigem Aluminium- oder Edelstahlgestrick und sind mit einem robusten U-Profil-Rahmen aus Aluminium oder Edelstahl eingefasst.“"
                            },
                            {
                                "example_id": "9e9cf869-2a2d-488b-a86e-9bbebb9eab76",
                                "sense_id": "2221e331-2876-366f-a911-6829b946297b",
                                "text": "„Dieses Edelstahlgestrick eignet sich für Fein- und Vorfilterzwecke.“"
                            },
                            {
                                "example_id": "55f1339c-2708-4a74-bf7c-0cce6c7ba9f9",
                                "sense_id": "2221e331-2876-366f-a911-6829b946297b",
                                "text": "„Zum Einsatz kommen Aluminiumfilter, Edelstahlfilter sowie Filterkassetten aus Edelstahlgestrick kombiniert mit Kunststoffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
