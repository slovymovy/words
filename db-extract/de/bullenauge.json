                        "target_lang_word": "bull's",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "642131d7-b327-407f-bf1a-50e9dbd62732",
                        "source_entry_id": "5933f9be-90c6-3db7-9038-6e19e02a0cd1",
                        "source_sense_id": "96b53f4d-c9b1-3589-bb4f-d34c99dd16f9",
                        "source_sense_description": "Auge eines Bullen (Stieres)",
                        "target_lang_word": "eye",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85befff9-9257-30ce-af2e-86160143672e",
                                        "entry_id": "9e26f708-659e-3aa0-befb-9d7b9cfcf9ad",
                                        "glosses": [
                                            "The name of the Latin-script letter I/i."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6a202f-e2ae-4796-91a0-dfa273e21a57",
                                                "sense_id": "85befff9-9257-30ce-af2e-86160143672e",
                                                "text": "It said, in a whispering, buzzing voice, \"Gee-you-ess-ess-ay-dash-em-ee-ar-ar-wye-dash-em-eye-en-gee-oh-dash-pee-eye-pee-dash-pee-ee-ar-ar-wye-dash-pee-eye-en-gee-oh.\""
                                            },
                                            {
                                                "example_id": "54363869-032b-41b2-b60d-5d9ef07649bc",
                                                "sense_id": "85befff9-9257-30ce-af2e-86160143672e",
                                                "text": "IED [is spoken] as \"eye-ee-dee\" instead of \"I SPELL India Echo Delta Romeo\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c62135-7051-38f6-b57e-f45f96dd6d7f",
                                        "entry_id": "110ef060-0a99-3b9f-89d1-1e80810a3183",
                                        "glosses": [
                                            "A brood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c62d97-38c7-4ca5-bf4a-0416fe037ff3",
                                                "sense_id": "a3c62135-7051-38f6-b57e-f45f96dd6d7f",
                                                "text": "an eye of pheasants"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "An organ through which animals see (“perceive surroundings via light”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc05f32-7da7-4c83-89a6-9bb17999a62a",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "Bright lights really hurt my eyes."
                                            },
                                            {
                                                "example_id": "95399038-7e3c-4090-9465-2c00535546bb",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "To vvhat, my loue, ſhall I compare thine eyne? / Chriſtall is muddy."
                                            },
                                            {
                                                "example_id": "6afeb33f-775a-4240-ac63-7692507f7358",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "Were it to search the furthest Northern clime / Where frosty Hyems with an ycie Mace / Strikes dead all living things, Ide find it out, / And borrowing fire from those fayre sunny eyne / Thaw Winters frost and warme that dead cold clime: […]"
                                            },
                                            {
                                                "example_id": "3b3dab44-ccd1-49ac-a5f2-f79b2f6c2432",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "Now with a bitter smile, whose light did shine / Like a fiend’s hope upon his lips and eyne, / He said, and the persuasion of that sneer / Rallied his trembling comrades— […]"
                                            },
                                            {
                                                "example_id": "97c35d4b-341f-4db3-8517-d9d30c14c54d",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "It is scarcely possible to avoid comparing the eye to a telescope."
                                            },
                                            {
                                                "example_id": "12873d0f-087f-4228-9b96-4fe468c40b40",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry."
                                            },
                                            {
                                                "example_id": "dff075cd-e4cb-44c8-8488-aa9652cf86c1",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "[H]is eyes were narrow slits of dark in a tight bandage of tissue."
                                            },
                                            {
                                                "example_id": "d69ec455-dcbf-406c-9d3e-e632a8cc0da1",
                                                "sense_id": "64027b22-8251-3a0d-982c-2ee0db6217eb",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96bc11be-d077-3f96-89e9-57645226de47",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "The visual sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b8ce4fb-9391-473a-b05e-51a7bc342ac0",
                                                "sense_id": "96bc11be-d077-3f96-89e9-57645226de47",
                                                "text": "The car was quite pleasing to the eye, but impractical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9afb06d-78b3-3918-bf1d-53f26af29f65",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "The iris of the eye, being of a specified colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76cd947e-d02e-4053-a9db-6154e97a9f80",
                                                "sense_id": "c9afb06d-78b3-3918-bf1d-53f26af29f65",
                                                "text": "Brown, blue, green, hazel eyes."
                                            },
                                            {
                                                "example_id": "f4dd1b95-9430-4b2e-8ada-bcf701142e62",
                                                "sense_id": "c9afb06d-78b3-3918-bf1d-53f26af29f65",
                                                "text": "Natalie’s brown eyes looked into Jim’s blue eyes, and the girl and boy flirted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5508248-1b74-3eeb-be46-81fbf0771aa2",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "Attention, notice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f709e79d-c256-4209-8ef9-8e9e6a6ce4f9",
                                                "sense_id": "f5508248-1b74-3eeb-be46-81fbf0771aa2",
                                                "text": "That dress caught her eye."
                                            },
                                            {
                                                "example_id": "11f1dea1-c2bb-4c71-a598-9109becdd357",
                                                "sense_id": "f5508248-1b74-3eeb-be46-81fbf0771aa2",
                                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness. The Celebrity as a matter of course was master of ceremonies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a057ed-729f-3c4e-af5b-4958f3069b9a",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "The ability to notice what others might miss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca036f0-1ed2-46fd-9335-78bacf906a95",
                                                "sense_id": "85a057ed-729f-3c4e-af5b-4958f3069b9a",
                                                "text": "He has an eye for talent."
                                            },
                                            {
                                                "example_id": "0c92a221-af6c-497f-a8c8-7459fbf7e07f",
                                                "sense_id": "85a057ed-729f-3c4e-af5b-4958f3069b9a",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c7e584a-bafe-3076-b22f-c64797045eda",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A meaningful look or stare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba793c1-e03a-4a3c-980b-eb6247cbd596",
                                                "sense_id": "5c7e584a-bafe-3076-b22f-c64797045eda",
                                                "text": "She was giving him the eye at the bar."
                                            },
                                            {
                                                "example_id": "3f46a595-4446-4057-adf2-8c83367b51ea",
                                                "sense_id": "5c7e584a-bafe-3076-b22f-c64797045eda",
                                                "text": "When the car cut her off, she gave him the eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7b4f69c-2813-3314-ad74-dfbccdc25757",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "Ellipsis of private eye."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf9500e9-5c8d-408b-b1ca-b4fc06451a9b",
                                                "sense_id": "c7b4f69c-2813-3314-ad74-dfbccdc25757",
                                                "text": "Far more annoying were the letters from parents of missing daughters and the private detectives who had begun showing up at his door. Independently of each other, the Cigrand and Conner families had hired “eyes” to search for their missing daughters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5946aa11-ed93-3155-8f28-077220c7a062",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A hole at the blunt end of a needle through which thread is passed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "242273bc-2596-345c-b80f-623b06c78594",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "The oval hole of an axehead through which the axehandle is fitted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26b21cd-b206-4d7b-a249-8843990f6a36",
                                                "sense_id": "242273bc-2596-345c-b80f-623b06c78594",
                                                "text": "[H]e struck the Duffer a sharp blow on the back of the head with the eye of the axe, and left him stunned and senseless on the earth[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75cae664-ba24-3357-9a0c-7de7ea3b3d41",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A fitting consisting of a loop of metal or other material, suitable for receiving a hook or the passage of a cord or line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abb7434a-6a71-3ea8-86d4-3eb482ee292c",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A loop forming part of anything, or a hole through anything, to receive a hook, pin, rope, shaft, etc.; for example, at the end of a tie bar in a bridge truss, through a crank, at the end of a rope, or through a millstone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27f7a90d-6b60-3159-9489-f56abcc54ce1",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A burner on a kitchen stove."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96c2ad58-0103-3293-ab08-b6dabd2ce7ba",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "The relatively calm and clear centre of a hurricane or other cyclonic storm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5dfd588-64f5-38f1-a4de-afa27a420274",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A mark on an animal, such as a butterfly or peacock, resembling a human eye."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a60efe42-7761-3835-8fa7-9184b2af2a94",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
