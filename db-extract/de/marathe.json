                "senses": [
                    {
                        "sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                        "entry_id": "9802d126-508e-3a53-b8e8-e6453e63771c",
                        "glosses": [
                            "Angehöriger eines in Zentralindien lebenden Volkes, dessen Muttersprache Marathi ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38bcd72-9680-47dc-933f-d6398d1cf375",
                                "sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                                "text": "„Sikhs, Marathen und Rajputen schärften ihre Waffen für den Kampf gegen Delhi.“"
                            },
                            {
                                "example_id": "5aaa0ee2-1d03-45d3-95c4-6ee32a2e547a",
                                "sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                                "text": "„Aurangzebs ärgste Feinde waren die Marathen, ein Volksstamm des Hochlands, der mit seiner Guerrillastrategie erfolgreich gegen die schwerfällige Mogularmee antrat.“"
                            },
                            {
                                "example_id": "d53f20cd-00c6-492d-9a16-afb97cfcf983",
                                "sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                                "text": "„In ähnlicher Weise widersetzte sich seit Mitte des 17. Jahrhunderts die aufstrebende Macht der Marathen im südwestlichen Indien.“"
                            },
                            {
                                "example_id": "9d79e8d5-07d2-4d8d-850c-dc45ad9da5f2",
                                "sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                                "text": "„Onkel Bindley gegenüber ließ ich davon nichts verlauten, zeigte mich vielmehr sehr eifrig, als brannte ich darauf, mir im Kampf gegen die Marathen oder die Sikhs meine ersten Sporen zu verdienen.“"
                            },
                            {
                                "example_id": "9b0e60c9-e799-4d0a-bdf0-3f6073fa3be9",
                                "sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                                "text": "„Katekar traute den Brahmanen nicht, und die Marathen mochte er wegen ihrer Gier und ihrer Kshatriya-Arroganz nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "371b71cb-6d21-4efd-9014-4f55a79f1eba",
                        "source_entry_id": "9802d126-508e-3a53-b8e8-e6453e63771c",
                        "source_sense_id": "7b9becdf-998e-377a-aa5d-6f5d8ea51481",
                        "source_sense_description": "Angehöriger eines in Zentralindien lebenden Volkes, dessen Muttersprache Marathi ist",
                        "target_lang_word": "Marathi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marathi",
