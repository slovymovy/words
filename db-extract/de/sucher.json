                            {
                                "example_id": "9598bbde-7fe6-4e30-baa9-a270a694ff97",
                                "sense_id": "89ac8a09-9ec0-3d90-bcce-4895c9ef69ef",
                                "text": "Der Rufer in der Wüste traf den Sucher in der Wüste."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d14405c8-3084-3e28-a132-475a761cfb2c",
                        "entry_id": "d474ba6d-7540-3f70-952c-6ff3919cb1c4",
                        "glosses": [
                            "Vorrichtung bei einem Fernrohr oder Fotoapparat zur Fixierung/zum Anvisieren eines Objekts oder Motivs"
                        ],
                        "tags": [
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "b64e5d9c-076f-430f-9813-0d4c27d7b357",
                                "sense_id": "d14405c8-3084-3e28-a132-475a761cfb2c",
                                "text": "Hast du Leni nun endlich im Sucher?"
                            },
                            {
                                "example_id": "6a0bfe89-744f-4b4a-9021-dac92c872277",
                                "sense_id": "d14405c8-3084-3e28-a132-475a761cfb2c",
                                "text": "„Mein Blick im Sucher traf sich mit ihrem frechen Lächeln voller Schalk.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c079965-d0d8-4753-a27c-328d07e90ec7",
