{
    "word_family": [
        "бар",
        "барменша"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "182b29b6-ca23-3b4f-9afc-8c39a2b4d9ce",
                    "sense_definition": "работник, который готовит напитки и обслуживает посетителей за барной стойкой",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "профессия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вежливый <w>бармен</w> предложил мне попробовать новый коктейль с фруктами.",
                            "target_lang_translations": {
                                "pl": "Uprzejmy <w>barman</w> zaproponował mi spróbowanie nowego koktajlu z owocami."
                            }
                        },
                        {
                            "text": "В конце вечера <w>бармен</w> протер стойку и закрыл заведение.",
                            "target_lang_translations": {
                                "pl": "Pod koniec wieczoru <w>barman</w> przetarł ladę i zamknął lokal."
                            }
                        }
                    ],
                    "common_phrases": [
                        "опытный бармен",
                        "молодой бармен"
                    ],
                    "target_lang_definitions": {
                        "pl": "pracownik przygotowujący napoje i obsługujący klientów przy barze"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "barman",
                                "target_lang_sense_clarification": "osoba pracująca za barem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "783f6626-3c55-362c-afbe-423e3f00b3c4",
                    "sense_definition": "владелец или управляющий баром",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "профессия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Местный <w>бармен</w> лично следит за качеством всех напитков в своем заведении.",
                            "target_lang_translations": {
                                "pl": "Miejscowy <w>właściciel baru</w> osobiście dba o jakość wszystkich napojów w swoim lokalu."
                            }
                        },
                        {
                            "text": "Строгий <w>бармен</w> не разрешил шумной компании оставаться в баре после закрытия.",
                            "target_lang_translations": {
                                "pl": "Surowy <w>właściciel baru</w> nie pozwolił hałaśliwej grupie zostać w barze po zamknięciu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "właściciel lub zarządca baru"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "właściciel baru",
                                "target_lang_sense_clarification": "osoba zarządzająca lokalem"
                            },
                            {
                                "target_lang_word": "karczmarz",
                                "target_lang_sense_clarification": "przestarzałe określenie właściciela lokalu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}