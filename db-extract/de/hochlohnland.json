                    {
                        "sense_id": "014aeb6a-e792-36e5-8939-d562dc6e92c3",
                        "entry_id": "72a7587b-ac9a-31ad-be58-43b84e7697e0",
                        "glosses": [
                            "Land, in dem großteils überdurchschnittlich hohe Löhne gezahlt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8aaccca-521e-4003-a30c-9fd48d3aba56",
                                "sense_id": "014aeb6a-e792-36e5-8939-d562dc6e92c3",
                                "text": "Viele Unternehmen haben personalintensive Geschäftsbereiche von Hochlohnländern in Niedriglohnländer ausgelagert."
                            },
                            {
                                "example_id": "2c2731c1-7a2c-4fd7-b241-d2f5dc1cd9ae",
                                "sense_id": "014aeb6a-e792-36e5-8939-d562dc6e92c3",
                                "text": "„Österreich ist ein kleiner Markt und ein Hochlohnland.“"
                            },
                            {
                                "example_id": "f0eaeb9a-f680-41fc-b41b-7e281f83bfab",
                                "sense_id": "014aeb6a-e792-36e5-8939-d562dc6e92c3",
                                "text": "„Ein Hochlohnland muss, um wettbewerbsfähig zu bleiben, gegenüber Netz und Maschine einen Mehrwert schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
