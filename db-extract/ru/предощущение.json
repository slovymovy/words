                "senses": [
                    {
                        "sense_id": "f07e492d-65b6-365e-869a-599dded2c4a8",
                        "entry_id": "0a882f4e-195e-3f07-ae25-ffdc3911a4ff",
                        "glosses": [
                            "действие по значению гл. предощутить, предощущать; предчувствие, предвкушение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f37e8e2-9663-44cc-b886-e8d0724f56b7",
                                "sense_id": "f07e492d-65b6-365e-869a-599dded2c4a8",
                                "text": "Сорок четвёртый год ― радостный год предощущения победы."
                            },
                            {
                                "example_id": "e62e54e8-8dab-4994-9329-9ef78da24b5b",
                                "sense_id": "f07e492d-65b6-365e-869a-599dded2c4a8",
                                "text": "Ничто не показывало, что Иннокентий разгадан, но внутреннее предчувствие, недоведомо вложенное в нас, щемило Володина, в нём росло предощущение беды — от него-то никуда и не хотелось ехать веселиться."
                            }
                        ]
                    }
