                        "entry_id": "8d9fba7e-6e19-340e-ae05-9956878da5cf",
                        "glosses": [
                            "Membrane fibreuse qui tapisse la cavité intérieure du crâne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc69564-718a-435d-a41c-6e3e0ee8297a",
                                "sense_id": "bd2b7d2e-1a91-3575-aa39-7778900ab095",
                                "text": "La dure-mère est la plus externe des trois membranes constituant les méninges avec la pie-mère et l'arachnoïde."
                            },
                            {
                                "example_id": "6c9d33c4-f1b2-4a44-b68c-03053edef1ef",
                                "sense_id": "bd2b7d2e-1a91-3575-aa39-7778900ab095",
                                "text": "Les circonvolutions compactes étaient enveloppées de dure-mère, ornées d’un réseau de nerfs et alimentées par d’épaisses artères qui ressemblaient à des galeries dans du blanc-manger."
                            }
                        ]
                    }
