                                                "text": "Das Wahrzeichen Cuxhavens ist die Kugelbake an der Elbmündung."
                                            },
                                            {
                                                "example_id": "e93f1238-a075-429f-a0ab-2801b8c931ad",
                                                "sense_id": "3e078a3b-cfd6-3346-a85a-93cbf5f9f3e2",
                                                "text": "Ich bin in Cuxhaven geboren."
                                            },
                                            {
                                                "example_id": "1991de12-301e-4d71-9438-5332f7f6c39a",
                                                "sense_id": "3e078a3b-cfd6-3346-a85a-93cbf5f9f3e2",
                                                "text": "Wir haben in Cuxhaven unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "45e18eb8-0145-42f9-8b35-aff560aac68d",
                                                "sense_id": "3e078a3b-cfd6-3346-a85a-93cbf5f9f3e2",
                                                "text": "Nach Cuxhaven führen viele Wege."
                                            },
                                            {
                                                "example_id": "424cc663-8592-458b-9b48-db4fd2ac2501",
                                                "sense_id": "3e078a3b-cfd6-3346-a85a-93cbf5f9f3e2",
                                                "text": "Cuxhaven liegt auf der Nordhalbkugel."
                                            },
