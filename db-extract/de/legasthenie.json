                                        "entry_id": "4a2af222-9c11-321c-a59f-95bc01f563ef",
                                        "glosses": [
                                            "distúrbio neurobiológico do processamento da linguagem, que pode afetar a habilidade de uma pessoa em ler, escrever e compreender o significado de palavras e textos"
                                        ],
