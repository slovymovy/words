                "senses": [
                    {
                        "sense_id": "04d00baf-eac8-3306-8f07-9b5711b91997",
                        "entry_id": "fccae465-50cf-3476-a343-66a153d4daf5",
                        "glosses": [
                            "Beamter, der im Verwaltungswesen einer Regierung tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87051fc2-723d-4394-9810-62539b38b58c",
                                "sense_id": "04d00baf-eac8-3306-8f07-9b5711b91997",
                                "text": "„Die Besitzungen der großen deutschen Firmen wurden konfisziert, die deutschen Regierungsbeamten deportiert oder in Kriegsgefangenschaft genommen.“"
                            },
                            {
                                "example_id": "0fc80ec4-4df7-4d7f-a670-c744706b246c",
                                "sense_id": "04d00baf-eac8-3306-8f07-9b5711b91997",
                                "text": "„Duffering verfügte darauf, dass Regierungsbeamten die Teilnahme am Kongress künftig verboten sei.“"
                            },
                            {
                                "example_id": "ca329fef-177d-4fc1-a1d2-bfaa3f2c5fac",
                                "sense_id": "04d00baf-eac8-3306-8f07-9b5711b91997",
                                "text": "„Doch nicht nur konservative Regierungsbeamte nehmen Anstoß am Ausrufezeichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
