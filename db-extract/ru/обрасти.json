                    },
                    {
                        "translation_id": "3070e69f-fc34-416b-a91a-4837e897a7b9",
                        "source_entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
                        "source_sense_description": "увеличиться в размере, протяжённости в результате присоединения чего-либо",
                        "target_lang_word": "accumulate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accumulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f55f0cd0-41d4-32f6-861a-e31c2e405dd0",
                                        "entry_id": "df0c05a0-9738-3e44-a84b-4e28fe367727",
                                        "glosses": [
                                            "To heap up in a mass; to pile up; to collect or bring together (either literally or figuratively), often gradually and without active intent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a715ad72-bca7-4e79-89ee-22ad5687dc97",
                                                "sense_id": "f55f0cd0-41d4-32f6-861a-e31c2e405dd0",
                                                "text": "He wishes to accumulate a sum of money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                                        "entry_id": "df0c05a0-9738-3e44-a84b-4e28fe367727",
                                        "glosses": [
                                            "To gradually grow or increase in quantity or number."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eba773e-de06-4d8c-8a6f-ce787876f701",
                                                "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                                                "text": "With her company going bankrupt, her divorce, and a gambling habit, debts started to accumulate so she had to sell her house."
                                            },
                                            {
                                                "example_id": "fac19637-b315-4631-a088-b43beeeb3f87",
                                                "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                                                "text": "Ill fares the land, to hastening ills a prey, / Where wealth accumulates, and men decay."
                                            }
                                        ]
                                    },
