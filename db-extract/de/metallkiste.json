                            {
                                "example_id": "53cdb1ce-8526-4360-b6b9-8679d9f2145f",
                                "sense_id": "d05ac76b-1668-3376-97a7-b7f4f80fc51f",
                                "text": "„Die Akten musste er später in den freiheitlichen Klub bringen, wo sie in einer Metallkiste versperrt wurden und wieder später auf das Anwesen Dobernigs in Maria Saal gebracht und dort im Keller verstaut wurden.“"
                            },
                            {
                                "example_id": "60e9ed32-068e-4bde-a97f-71fb0a91be58",
                                "sense_id": "d05ac76b-1668-3376-97a7-b7f4f80fc51f",
                                "text": "„Vor dem geheimen Teil der Sitzung des NSA-Untersuchungsausschusses am Donnerstag wurde eine große Metallkiste aufgestellt.“"
                            }
                        ],
