                ],
                "senses": [
                    {
                        "sense_id": "50460cc2-ed0d-389e-87aa-e0afa88ca1a3",
                        "entry_id": "8e0f569f-d868-36f8-9be6-a79ebba7e5a1",
                        "glosses": [
                            "Faire perdre son caractère individuel, ou d’individu, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7adcd6-30d3-471b-a565-3d9d9762f8ee",
                                "sense_id": "50460cc2-ed0d-389e-87aa-e0afa88ca1a3",
                                "text": "On pourrait donc croire que le salut des âmes consisterait à se désindividualiser, afin de rentrer dans leur perfection primitive et unique."
                            },
                            {
                                "example_id": "facf07a4-f9dc-4490-aaec-ec1aaf97b978",
                                "sense_id": "50460cc2-ed0d-389e-87aa-e0afa88ca1a3",
                                "text": "Le vote familial est également propre à « désindividualiser » les corps représentatifs."
                            },
                            {
                                "example_id": "5bc12920-a009-420a-8d0b-3c1f23fbc5b5",
                                "sense_id": "50460cc2-ed0d-389e-87aa-e0afa88ca1a3",
                                "text": "Il y a là comme un souci de désindividualiser ou de désobjectiviser l’amour particulier qu’un chevalier peut avoir pour une femme réelle."
                            }
                        ]
                    }
                ],
