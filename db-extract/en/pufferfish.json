                "senses": [
                    {
                        "sense_id": "bc1de6b0-3e95-34f8-916d-cf2854f78e01",
                        "entry_id": "aabd5d79-fe8d-3939-94af-8eca833f7479",
                        "glosses": [
                            "Poisson-globe, poisson-ballon, poisson-boule, tétrodon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfa6b2c-c1e3-4cc8-a470-ee6719a80a3d",
                                "sense_id": "bc1de6b0-3e95-34f8-916d-cf2854f78e01",
                                "text": "Pufferfish inflate by ‘buccal pumping’: sucking water - or air if they’re out of the water - into their incredibly elastic stomachs. With specially modified gill muscles and a lack of ribs, the fish can swell to an almost spherical shape, three or four times their usual size.",
                                "translation": "Les poissons-globes se gonflent par « pompage buccal » : en aspirant l’eau ― ou l’air, s’ils se trouvent hors de l’eau ― dans leur estomac incroyablement élastique. Grâce à ses muscles operculaires spécialement adaptés et son absence de côtes, ces poissons peuvent enfler jusqu’à prendre une forme quasi sphérique, atteignant trois à quatre fois leur taille habituelle."
                            }
                        ]
                    }
                ],
                "translations": [],
