                ],
                "senses": [
                    {
                        "sense_id": "e04fe584-d9cb-35f7-aacc-bf73a08676d4",
                        "entry_id": "56e9e365-ec9a-3dee-87f2-5fd81c13a0d5",
                        "glosses": [
                            "eine Kreuzfahrt, auf der viel Luxus angeboten wird; eine Kreuzfahrt, die luxuriös ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d8c895-b3a8-452d-b91c-85f13ccfd6d8",
                                "sense_id": "e04fe584-d9cb-35f7-aacc-bf73a08676d4",
                                "text": "„Von dieser Reise können die meisten von uns wohl nur träumen: Eine Luxus-Kreuzfahrt in einer schicken Suite der ‚Silver Whisper,‘ 124 Tage rund um die Welt.“"
                            },
                            {
                                "example_id": "2d2fe380-d24a-49d7-b78f-649e856fb5b0",
                                "sense_id": "e04fe584-d9cb-35f7-aacc-bf73a08676d4",
                                "text": "„Diese Fotos müffeln fast schon – die Passagiere, die auf der „Carnival Triumph“ eine schnieke Luxus-Kreuzfahrt gebucht hatten, mussten wie im Flüchtlingslager an Deck hausen: kein Strom, verdorbenes Essen, kaputte Klos – und viel Gestank!“"
                            },
                            {
                                "example_id": "cd1aad46-9b1b-4f58-8740-815d193b018e",
                                "sense_id": "e04fe584-d9cb-35f7-aacc-bf73a08676d4",
                                "text": "„Die Concorde fliegt europäische Reisegruppen zu Luxus-Kreuzfahrten in der Karibik.“"
                            },
                            {
                                "example_id": "893dd2b3-c38f-47d4-8a5a-4ad187ec7715",
                                "sense_id": "e04fe584-d9cb-35f7-aacc-bf73a08676d4",
                                "text": "„Aus Dankbarkeit für die tollen Erlebnisse, so das Kalkül, werden sich die Mitarbeiter auch im nächsten Jahr voll reinhängen, selbst wenn keine Luxus-Kreuzfahrt lockt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
