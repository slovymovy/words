                    {
                        "sense_id": "d222c351-d00d-33cc-a24e-2fed467c8254",
                        "entry_id": "19ca767c-1e2e-3366-96aa-276c89cd8a6c",
                        "glosses": [
                            "A transparent olive green form of olivine, used as a gem."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "902c6bd3-05de-4e30-9e3a-05bfa265b2ca",
                                "sense_id": "d222c351-d00d-33cc-a24e-2fed467c8254",
                                "text": "Gem-quality olivine is known as peridot, which has a subtle green light all its own."
                            },
                            {
                                "example_id": "76df1723-d7e5-4ff2-b35c-8b1ce3aa6e2d",
                                "sense_id": "d222c351-d00d-33cc-a24e-2fed467c8254",
                                "text": "Although there are dozens of different types of gems, among the best known and most important are […]. (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8d6824b-695f-3099-9c95-540b1fed0603",
                        "entry_id": "19ca767c-1e2e-3366-96aa-276c89cd8a6c",
                        "glosses": [
                            "A yellow-green color, like that of the peridot."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
