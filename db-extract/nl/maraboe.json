                "senses": [
                    {
                        "sense_id": "8d07a82a-2918-3fc3-a7d3-c5ff756545aa",
                        "entry_id": "bc999a22-24ab-3382-aabb-e8aa9e97356a",
                        "glosses": [
                            "benaming voor vogels uit het geslacht Leptoptilos uit de familie van de ooievaars Ciconiidae, voorkomend in in Azië en Afrika"
                        ],
                        "tags": [
