                                        "entry_id": "2ed11604-f1d8-32cb-af05-1313bacaf735",
                                        "glosses": [
                                            "Relating to the direction to the side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
