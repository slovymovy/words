                ],
                "senses": [
                    {
                        "sense_id": "7e153b20-4463-31f4-a6b7-c4a686ba50ab",
                        "entry_id": "9cd8a2ea-891d-309e-b7be-cd34651ca222",
                        "glosses": [
                            "прост. часто, подолгу лающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c0ef96-3ebe-4155-95e0-7b2a5b7fcf44",
                                "sense_id": "7e153b20-4463-31f4-a6b7-c4a686ba50ab",
                                "text": "Брехливая собачка чаще всего только полает, а молчаливая тяпнет там, где и сама не думает…"
                            },
                            {
                                "example_id": "8b74d550-08b2-4d1d-8539-1e40ecce2a24",
                                "sense_id": "7e153b20-4463-31f4-a6b7-c4a686ba50ab",
                                "text": "Клава была невысокая, крепкая и домовитая женщина с норовом, которого побаивались все ближние и дальние соседи, взрослые и дети, самые брехливые собаки и самые драчливые петухи…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7fdb167a-96f7-3070-94f0-3874dace2d1e",
                        "entry_id": "9cd8a2ea-891d-309e-b7be-cd34651ca222",
                        "glosses": [
                            "прост. имеющий привычку лгать, болтать вздор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c36dc0-b1db-4079-a7bd-6e5a6d70b6ca",
                                "sense_id": "7fdb167a-96f7-3070-94f0-3874dace2d1e",
                                "text": "Капитана будто обожгло, так он этого брехливого пьяницу невзлюбил, который посмеялся над его горем…"
                            }
                        ]
                    },
                    {
                        "sense_id": "0cff2e2a-a5de-3501-a92c-d1de18bdd42c",
                        "entry_id": "9cd8a2ea-891d-309e-b7be-cd34651ca222",
                        "glosses": [
                            "прост. лживый, вздорный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb629f55-2113-45f9-8b39-60031d4892a3",
                                "sense_id": "0cff2e2a-a5de-3501-a92c-d1de18bdd42c",
                                "text": "…Гришины брехливые обещания и прожекты обе стороны раскусили и с довольствия агента-афериста сняли…"
                            },
                            {
                                "example_id": "b8ed3312-9773-461c-b093-032590ff0e79",
                                "sense_id": "0cff2e2a-a5de-3501-a92c-d1de18bdd42c",
                                "text": "Коляша ещё и ещё плевался, вспоминая самую брехливую на всём свете пропаганду о том, как в нищете погибали, обобранные панами, никем не призретые украинцы и белорусы."
                            }
                        ]
                    }
                ],
