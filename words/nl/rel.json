    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7904f534-0827-3043-be80-ead230eae84d",
                    "sense_definition": "een verstoring van de openbare orde door een menigte, meestal gepaard gaand met geweld en politieoptreden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de voetbalwedstrijd ontstond er een hevige <w>rel</w> in het centrum van de stad.",
                            "target_lang_translations": {
                                "en": "After the football match, a violent <w>riot</w> broke out in the city center."
                            }
                        },
                        {
                            "text": "De politie moest ingrijpen om de <w>rel</w> tussen de demonstranten te stoppen.",
                            "target_lang_translations": {
                                "en": "The police had to intervene to stop the <w>disturbance</w> between the protesters."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hevige rel",
                        "politie stopt rel"
                    ],
                    "target_lang_definitions": {
                        "en": "a disturbance of public order by a crowd, usually accompanied by violence and police action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "riot",
                                "target_lang_sense_clarification": "violent public disturbance"
                            },
                            {
                                "target_lang_word": "disturbance",
                                "target_lang_sense_clarification": "breach of peace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "953e9ef7-222b-3d52-9009-63f64c4abf2d",
                    "sense_definition": "een gebeurtenis of schandaal die maatschappelijke of politieke opschudding veroorzaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitspraken van de minister veroorzaakten een grote diplomatieke <w>rel</w>.",
                            "target_lang_translations": {
                                "en": "The minister's statements caused a major diplomatic <w>row</w>."
                            }
                        },
                        {
                            "text": "De kranten stonden vol over de politieke <w>rel</w> rondom het nieuwe wetsvoorstel.",
                            "target_lang_translations": {
                                "en": "The newspapers were full of the political <w>scandal</w> surrounding the new bill."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diplomatieke rel",
                        "politieke rel"
                    ],
                    "target_lang_definitions": {
                        "en": "an event or scandal that causes social or political upheaval"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scandal",
                                "target_lang_sense_clarification": "public outrage"
                            },
                            {
                                "target_lang_word": "row",
                                "target_lang_sense_clarification": "noisy argument or controversy"
                            },
                            {
                                "target_lang_word": "uproar",
                                "target_lang_sense_clarification": "state of commotion or excitement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81469ccb-1191-3100-9469-a1e9863f3fd0",
                    "sense_definition": "een ondiepe, gegraven geul in de duinen waarin zich kwelwater kan verzamelen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "landscape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze <w>rel</w> is ideaal voor salamanders, kikkers en padden in het duingebied.",
                            "target_lang_translations": {
                                "en": "This <w>dune slack</w> is ideal for salamanders, frogs, and toads in the dune area."
                            }
                        },
                        {
                            "text": "Langs de duinrand is een nieuwe <w>rel</w> gegraven om de biodiversiteit te bevorderen.",
                            "target_lang_translations": {
                                "en": "A new <w>trench</w> has been dug along the edge of the dunes to promote biodiversity."
                            }
                        }
                    ],
                    "synonyms": [
                        "duinrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specifiek voor duingebieden"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a shallow, dug trench in the dunes where seepage water can collect"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dune slack",
                                "target_lang_sense_clarification": "low-lying area in dunes"
                            },
                            {
                                "target_lang_word": "trench",
                                "target_lang_sense_clarification": "dug channel for water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8f0a401-9f43-39e5-9fe9-c9bb60987f68",
                    "sense_definition": "de gang of het spoor van een muis of andere kleine knaagdieren",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bioloog volgde de <w>rel</w> van de veldmuis door het hoge gras.",
                            "target_lang_translations": {
                                "en": "The biologist followed the field mouse's <w>run</w> through the tall grass."
                            }
                        },
                        {
                            "text": "In de schuur vonden we een duidelijke <w>rel</w> die naar een nest wees.",
                            "target_lang_translations": {
                                "en": "In the shed, we found a clear <w>trail</w> pointing to a nest."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the path or trail of a mouse or other small rodent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "animal track or path"
                            },
                            {
                                "target_lang_word": "trail",
                                "target_lang_sense_clarification": "scent or physical path"
                            }
                        ]
                    }
                }
            ]
        },
        {
