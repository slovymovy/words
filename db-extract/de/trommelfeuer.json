                ],
                "senses": [
                    {
                        "sense_id": "7ca3aca9-522c-3ad6-bb2d-e480a92764d7",
                        "entry_id": "79111437-a470-3bc2-b0c3-d504936485f6",
                        "glosses": [
                            "anhaltender, intensiver Beschuss mit schweren Waffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65dc2b24-ba7c-4f93-8af9-de14e65520bb",
                                "sense_id": "7ca3aca9-522c-3ad6-bb2d-e480a92764d7",
                                "text": "„Das erste Trommelfeuer zeigte uns unseren Irrtum, und unter ihm stürzte die Weltanschauung zusammen, die sie uns gelehrt hatten.“"
                            },
                            {
                                "example_id": "5d6c102d-c88c-4fc0-b6eb-9ef4b0febc5a",
                                "sense_id": "7ca3aca9-522c-3ad6-bb2d-e480a92764d7",
                                "text": "„Er schien vom gestrigen Trommelfeuer noch ganz verstört zu sein.“"
                            },
                            {
                                "example_id": "b44982c0-c693-476c-b643-f3ec72ebc590",
                                "sense_id": "7ca3aca9-522c-3ad6-bb2d-e480a92764d7",
                                "text": "„Die folgenden Monate war der Himmel über Freiburg, vom öfter zu vernehmenden Trommelfeuer der Artillerie abgesehen, ruhig geblieben.“"
                            },
                            {
                                "example_id": "69609fc4-bd4c-493e-901e-cb58365c3a5a",
                                "sense_id": "7ca3aca9-522c-3ad6-bb2d-e480a92764d7",
                                "text": "„Es ist 5 Uhr 15 Minuten: das Trommelfeuer der rings um Berlin in den Vororten aufgefahrenen russischen Artillerie hat begonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
