                "senses": [
                    {
                        "sense_id": "aa6da30a-46e9-3ac6-af96-98d09d16c14d",
                        "entry_id": "e95bef0f-0539-33f8-ae4d-7ea581e18fd3",
                        "glosses": [
                            "Maladie idiopathique où le sujet dort beaucoup et très profondément. Il éprouve des difficultés à se lever et une fatigue diurne fréquente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11af0e1c-cae8-45f1-b8de-8c535b98f32b",
                                "sense_id": "aa6da30a-46e9-3ac6-af96-98d09d16c14d",
                                "text": "En pathologie mentale, l’hypersomnie est beaucoup plus rare que l’insomnie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "846f6283-0c71-4f09-8a7e-19bc168d0f10",
                        "source_entry_id": "e95bef0f-0539-33f8-ae4d-7ea581e18fd3",
                        "source_sense_id": "aa6da30a-46e9-3ac6-af96-98d09d16c14d",
                        "target_lang_word": "Schlafsucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafsucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a3f6a5-2adf-3c0c-b406-16c4fe5f885d",
                                        "entry_id": "1eb14c8c-1bdd-3942-a561-4747747277c6",
                                        "glosses": [
                                            "krankhaftes Bedürfnis, sehr häufig und auch tagsüber zu schlafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab61c8cc-e669-4c8b-a97f-0274b0db019f",
                                                "sense_id": "c8a3f6a5-2adf-3c0c-b406-16c4fe5f885d",
                                                "text": "„Von Lessings Schlafsucht in seinen späten Jahren, seinem plötzlichen Wegnicken und seinen Absencen haben viele Zeitgenossen berichtet.“"
                                            },
                                            {
                                                "example_id": "32270789-3aef-4577-b871-8cd6ed579952",
                                                "sense_id": "c8a3f6a5-2adf-3c0c-b406-16c4fe5f885d",
                                                "text": "„Wer die Nächte durcharbeiten muss, nimmt Modafinil, ein Medikament gegen krankhafte Schlafsucht (Narkolepsie).“"
                                            },
                                            {
                                                "example_id": "a8161ece-ee1a-40c6-a86b-d80854f172f7",
                                                "sense_id": "c8a3f6a5-2adf-3c0c-b406-16c4fe5f885d",
                                                "text": "„Die ‚klassische‘ Narkolepsie […] gehört zur Gruppe der Schlafsüchte, da ihr eine Störung der Schlaf-Wach-Regulation zu Grunde liegt.“"
                                            },
                                            {
                                                "example_id": "cae6e924-3885-43c7-858b-236472e3cd8e",
                                                "sense_id": "c8a3f6a5-2adf-3c0c-b406-16c4fe5f885d",
                                                "text": "(1860:) „Die übrigen Schlafſuchten werden nach den ursächlichen Momenten eine verschiedene Behandlung erfordern;“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01ee27c2-a386-4efb-8638-a26487bf40db",
                        "source_entry_id": "e95bef0f-0539-33f8-ae4d-7ea581e18fd3",
