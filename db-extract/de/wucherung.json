                "senses": [
                    {
                        "sense_id": "00090ddf-299a-3320-a20f-a4a68a77c892",
                        "entry_id": "db65932d-3274-3d39-9f16-3a9f2637fe1f",
                        "glosses": [
                            "starke Zunahme der Bildung von Körpergewebe"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5fe6a44-3776-3beb-9291-cf82275c1cc4",
                        "entry_id": "db65932d-3274-3d39-9f16-3a9f2637fe1f",
                        "glosses": [
                            "aus dem Vorgang des Wucherns entstandene Geschwulst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8989845b-d4fc-4e4a-861b-93f05c6dc7c5",
                                "sense_id": "a5fe6a44-3776-3beb-9291-cf82275c1cc4",
                                "text": "„Bei der gegenwärtig üblichen Krebsvorsorge werden Darmpolypen, gutartige Wucherungen der Darmschleimhaut, gefunden und entfernt, bevor sie zu Darmkrebs werden können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "00a93ca8-a9ee-399e-8ead-6471d78208f3",
                        "entry_id": "db65932d-3274-3d39-9f16-3a9f2637fe1f",
                        "glosses": [
                            "starke unkontrollierbare Zunahme von etwas"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a2478f4-b65f-4b6e-b060-9f585674937e",
                        "source_entry_id": "db65932d-3274-3d39-9f16-3a9f2637fe1f",
                        "source_sense_id": "00090ddf-299a-3320-a20f-a4a68a77c892",
                        "source_sense_description": "kein Plural: starke Zunahme der Bildung von Körpergewebe",
                        "target_lang_word": "prolifération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolifération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                        "entry_id": "954a811a-81ab-37b3-aa34-95c95f81af91",
                                        "glosses": [
                                            "Multiplication par division des cellules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f91dd6-ca31-436a-81e0-98817065220a",
                                                "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                                "text": "La prolifération tuberculeuse."
                                            },
                                            {
                                                "example_id": "12cccdcb-92fd-4854-996e-c9ad8c7c9445",
                                                "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                                "text": "La prolifération des cellules cancéreuses."
                                            },
                                            {
                                                "example_id": "bc7b77a4-28e4-4d55-8f42-e9cd49d5fe8e",
                                                "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                                "text": "Le froid -- suffisant pour empêcher la prolifération bactérienne et fongique, mais pas assez important pour endommager les tissus -- a permis d’incroyablement bien conserver l’animal qui gardait des plumes, des ongles, de la peau et des tissus mous intacts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b040490e-ee60-3480-8b47-b3c36c0ba9c3",
                                        "entry_id": "954a811a-81ab-37b3-aa34-95c95f81af91",
                                        "glosses": [
                                            "Multiplication de choses indésirables."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fccae05-d3ba-4545-848f-770d418e0e78",
                                                "sense_id": "b040490e-ee60-3480-8b47-b3c36c0ba9c3",
                                                "text": "La renaissance d'un certain patriotisme de clocher se traduisit par la prolifération des sectes manichéennes et millénaristes."
                                            },
                                            {
                                                "example_id": "d8f83384-9a20-4596-8eda-6810bf31c752",
                                                "sense_id": "b040490e-ee60-3480-8b47-b3c36c0ba9c3",
                                                "text": "Le biotope favorisant la prolifération de ces moustiques associe l'eau, les sols hydromorphes et salés, et la végétation qui leur est associée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de7ef53-3275-3fb5-98e5-cd9b6f809e4f",
                                        "entry_id": "954a811a-81ab-37b3-aa34-95c95f81af91",
                                        "glosses": [
                                            "Multiplication de choses indésirables.",
                                            "Prolifération nucléaire : accroissement du nombre des pays disposant de l'arme atomique."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a5acb0d-6325-495c-aa48-b6babfec0280",
                                                "sense_id": "3de7ef53-3275-3fb5-98e5-cd9b6f809e4f",
                                                "text": "L’attitude de la France à l’égard de la prolifération nucléaire a été particulièrement complexe. Paris a été à la fois, mais pas toujours, la victime de politiques de non-prolifération, en particulier de la part des États-Unis, et par moments un proliférateur de première importance."
                                            },
                                            {
                                                "example_id": "1c0af60e-bb1a-487f-b5b6-0ad73caf7f4e",
                                                "sense_id": "3de7ef53-3275-3fb5-98e5-cd9b6f809e4f",
                                                "text": "En ce qui concerne les secteurs clés, tels que le nucléaire, le balistique et le chimique, les pays occidentaux ont pris progressivement conscience du risque de prolifération lié à un transfert de technologie, particulièrement dans un certain nombre de pays en voie de développement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef116a68-80b8-4afa-ae1b-8eb9698dd03f",
                        "source_entry_id": "db65932d-3274-3d39-9f16-3a9f2637fe1f",
                        "source_sense_id": "00090ddf-299a-3320-a20f-a4a68a77c892",
                        "source_sense_description": "kein Plural: starke Zunahme der Bildung von Körpergewebe",
                        "target_lang_word": "tumeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                        "entry_id": "ce529650-13ca-398a-a7e2-a62ade64478b",
                                        "glosses": [
                                            "Éminence, grosseur plus ou moins considérable, développée dans quelque partie du corps, soit par une maladie, soit par une autre cause."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb32eff8-e648-4887-a024-63aa0784cb90",
                                                "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                                "text": "On doit, sans perdre un instant, extirper la tumeur : opération qui exige la main d’un anatomiste, et qui. n’est pas sans danger pour celui qui la pratique, l’inoculation de l’ichor gangreneux pouvant causer la mort."
                                            },
                                            {
                                                "example_id": "87b09224-3f47-4ccc-b960-acb4a40cc559",
                                                "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                                "text": "Il y a huit jours il m’a donné un bon coup de bâton sur la tête. Pour cette fois j’espère que l’affaire est dans le sac ; j’ai la tête enflée ; vous voyez bien là cette grosse bosse blanche, il disait hier que c’était peut-être une tumeur ; je ne sais pas ce que c’est qu’une tumeur, mais à la façon dont il en parlait, je crois que c’est grave ; toujours est-il que je souffre beaucoup ; j’ai des élancements sous les cheveux plus douloureux que dans des crises de dents ; ma tête est lourde comme si elle pesait cent livres ; j’ai des éblouissements, des étourdissements, et la nuit, en dormant, je ne peux m’empêcher de gémir et de crier."
                                            },
                                            {
                                                "example_id": "89b52900-e4b3-4e97-a9ce-a1ea3bbb342d",
                                                "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                                "text": "On convoya, Dieu sait comme, au-dessus des gouffres, des caravanes d’infirmes et de moribonds qui burent de cette eau et les membres estropiés se redressèrent et les tumeurs fondirent au chant des psaumes."
                                            },
                                            {
                                                "example_id": "0191e96a-48ea-424a-ac93-49aeea713b6f",
                                                "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                                "text": "La fausse puberté précoce isosexuelle est secondaire à une sécrétion œstrogénique anormale par une tumeur de l’ovaire ou des surrénales sans maturation ovarienne."
                                            },
                                            {
                                                "example_id": "dbd25913-7269-4fe7-979f-1118a16eee3c",
                                                "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                                "text": "L’actinobacillose pharyngienne se traduit par des tumeurs plus ou moins volumineuses provoquant de la dysphagie et des difficultés respiratoires."
                                            },
                                            {
                                                "example_id": "ab7a2628-ff5d-4611-ad31-bf1abc510171",
                                                "sense_id": "b8b09d07-fc7c-34c0-9ac3-fb0f3d2e4278",
                                                "text": "Plus d’un millier de rats de laboratoire ont été enrôlés pendant deux ans, et soumis à différentes doses de glyphosate – toutes considérées comme sans effets par la réglementation européenne. Dans tous les groupes d’animaux ayant reçu ces petites doses quotidiennes de l’ herbicide, écrivent les chercheurs, « nous avons observé une augmentation statistiquement significative, dépendante de la dose reçue, de la tendance à développer des tumeurs bénignes ou malignes sur plusieurs tissus »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dba738a5-d1e6-3ce8-928b-1e3bc3f25f2f",
                                        "entry_id": "ce529650-13ca-398a-a7e2-a62ade64478b",
                                        "glosses": [
                                            "Gonflement d'un tissu végétal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28835ffe-6340-4a64-9ced-5732fe8f9012",
                                                "sense_id": "dba738a5-d1e6-3ce8-928b-1e3bc3f25f2f",
                                                "text": "Si je trouvais sur les pentes, hors des limites du Parc, des bédégars bien moussus, je posais sur la couverture d’Antoinette ces tumeurs de l’églantier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1a1035-4cff-34fe-a0e4-9d4f1d5cc351",
                                        "entry_id": "ce529650-13ca-398a-a7e2-a62ade64478b",
                                        "glosses": [
                                            "Un mal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b46b0e6b-230a-4e2d-8324-e96e18d4d437",
                                                "sense_id": "ea1a1035-4cff-34fe-a0e4-9d4f1d5cc351",
                                                "text": "En juin 2018, Ali Khamenei avait réaffirmé la \"position\" ancienne de Téhéran selon laquelle Israël est pour le Moyen-Orient \"une tumeur cancéreuse maligne qui doit être enlevée et éradiquée\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
