                        "glosses": [
                            "The state or characteristic of being incorporeal."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "710e617c-7eb3-44a4-8ee1-e747e33ec778",
                                "sense_id": "c78bf4c9-23cf-33a6-880d-f21ef3fe1850",
                                "text": "The tax payer does not know, and has no means of knowing, who the particular individuals are who compose \"the government.\" To him \"the government\" is a myth, an abstraction, an incorporeality, with which he can make no contract, and to which he can give no consent, and make no pledge."
                            },
                            {
                                "example_id": "98de6fcd-41ff-4682-9d1f-a26ba77064b8",
                                "sense_id": "c78bf4c9-23cf-33a6-880d-f21ef3fe1850",
                                "text": "God's immateriality entails the divine attribute of incorporeality, that God is neither a body nor embodied."
                            }
                        ]
                    }
                ],
