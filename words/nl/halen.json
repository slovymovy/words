                {
                    "sense_id": "ff82511b-af74-3061-ae4a-e0ed1fa60737",
                    "sense_definition": "op tijd aankomen bij een vervoermiddel of een specifieke bestemming bereiken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bereiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten rennen om de laatste trein naar Amsterdam te <w>halen</w>.",
