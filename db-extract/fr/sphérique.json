                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3a4751c-92ff-4c3c-a5f9-38d90a83aac8",
                        "source_entry_id": "3ae04c14-88e5-356b-947d-5867a61496ef",
                        "target_lang_word": "sphärisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphärisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66da3b6d-4dd5-310d-89fc-f10bcebead9a",
                                        "entry_id": "caff8e82-f260-3afc-9e3c-9e9587843b7c",
                                        "glosses": [
                                            "kugelbezogen, -förmig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f46b7184-3ae3-424e-872a-1c88f336393c",
                                                "sense_id": "66da3b6d-4dd5-310d-89fc-f10bcebead9a",
                                                "text": "„Diese andere Geometrie ist die sphärische Geometrie, d.h. die Geometrie auf der Kugeloberfläche, und dieser Geometrie wollen wir uns jetzt zuwenden.“"
                                            },
                                            {
                                                "example_id": "9b45a4fb-0e43-40de-bb9e-20e4848af673",
                                                "sense_id": "66da3b6d-4dd5-310d-89fc-f10bcebead9a",
                                                "text": "„Sphärische Aberration (Öffnungsfehler) ist ein Abbildungsfehler der bei einfachen Linsen auftritt, die mit sphärischer Krümmung geschliffen sind.“"
                                            },
                                            {
                                                "example_id": "b51b983f-fc08-442e-9a7b-11075c586ea6",
                                                "sense_id": "66da3b6d-4dd5-310d-89fc-f10bcebead9a",
                                                "text": "„Ein zu einer reellen reduktiven Gruppe G assoziierter homogener Raum Z=G/H heißt reell sphärisch, falls eine minimale parabolische Untergruppe P von G eine offene Bahn auf Z besitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51e0538d-64f2-396b-a3df-47400c802e2e",
                                        "entry_id": "caff8e82-f260-3afc-9e3c-9e9587843b7c",
                                        "glosses": [
                                            "(welt-)raumtönend, himmlisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182c1e8d-46b2-4eac-bc32-79e6fd83afbd",
                                                "sense_id": "51e0538d-64f2-396b-a3df-47400c802e2e",
                                                "text": "„Leaneaghs Stimme wird über ein sogenanntes Autotune-Programm verfremdet und macht die Musik sphärisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35b8c57c-678d-4624-9582-e3d674ed5baa",
                        "source_entry_id": "3ae04c14-88e5-356b-947d-5867a61496ef",
                        "target_lang_word": "spherical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
