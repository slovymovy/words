                "senses": [
                    {
                        "sense_id": "ac0afaea-4fa7-320f-9429-f7628df33a03",
                        "entry_id": "52eefb21-735f-35f2-a9aa-7e8db8a93082",
                        "glosses": [
                            "Erzeugnis, das aus Abfällen hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d47445a-2fb5-40da-8658-01ed4b215af5",
                                "sense_id": "ac0afaea-4fa7-320f-9429-f7628df33a03",
                                "text": "„In ihren riesigen Raffinerien produzierten die Mineralölfirmen Leichtbenzin als Abfallerzeugnis und boten es den Chemiekonzernen zu Preisen an, die noch unter den Kosten einer entsprechenden Menge Rohöl lagen.“"
                            },
                            {
                                "example_id": "dae03868-ebb0-4212-8255-2f2219a9c063",
                                "sense_id": "ac0afaea-4fa7-320f-9429-f7628df33a03",
                                "text": "„Die 70 Tonnen Gift waren, wie sich herausstellte, Abfallerzeugnisse zweier Fabriken in Czarny Bór und Jelenia Góra, die mindestens drei Jahre lang illegal 30 000 bis 50 000 Liter Heizöl täglich in Diesel verwandelt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
