                        "glosses": [
                            "A nitrate-producing factory in a Spanish-speaking country."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0de1638-7327-4369-98ba-fb7e021bcde6",
                                "sense_id": "42bc8222-8ceb-3bc6-abdf-abd113cc1a27",
                                "text": "The external aspect of the oficina was not unlike that of a north-country coal or iron mine—tall chimneys and machinery, corrugated iron buildings, offices and houses, the shanties of workmen, a high bank of refuse."
                            },
                            {
                                "example_id": "971c0cd9-d8fa-4e58-837b-409106cfe608",
                                "sense_id": "42bc8222-8ceb-3bc6-abdf-abd113cc1a27",
                                "text": "Neighbouring oficinas place nitrate f.o.b. at shipping ports at a cost of from 5s to 5s. 6d. a quintal."
                            },
                            {
                                "example_id": "0ccf1abb-e523-4972-ade7-8559e782c5c2",
                                "sense_id": "42bc8222-8ceb-3bc6-abdf-abd113cc1a27",
                                "text": "Fig. 9 shows an oficina that has derived its nitrate from one of the small “islands” or “peninsulas” rising above the playa which can be seen surrounding the workings on all sides but the left."
                            }
                        ]
                    }
