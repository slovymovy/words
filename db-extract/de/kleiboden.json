                        "examples": [
                            {
                                "example_id": "8d33db74-c3a1-4913-9468-439af23a103a",
                                "sense_id": "ddee2b35-3d13-394f-bd07-b1ea92c9f28c",
                                "text": "„Wo der Kleiboden eine besonders zähe, für Wasser und Pflanzenwurzeln schwer durchdringbare Schicht bildet, nennt man ihn ‚Knick‘.“"
                            },
                            {
                                "example_id": "bc4e846f-23db-423b-b606-498a8f88dcd3",
                                "sense_id": "ddee2b35-3d13-394f-bd07-b1ea92c9f28c",
                                "text": "„Beim Prozeß der Verlandung räumen Schwimmbagger den Kleiboden ab und ersetzen ihn mit tragfähigem Sand vom Grund der Weser.“"
                            }
                        ],
