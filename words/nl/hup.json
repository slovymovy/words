                        {
                            "text": "Kom op, <w>hup</w>, we moeten nu echt vertrekken.",
                            "target_lang_translations": {
                                "en": "Come on, <w>let's go</w>, we really have to leave now.",
                                "ru": "Ну же, <w>давай</w>, нам действительно пора уходить.",
                                "pl": "No dalej, <w>hop</w>, naprawdę musimy już wychodzić.",
                                "de": "Komm schon, <w>los</w>, wir müssen jetzt wirklich los.",
                                "fr": "Allez, <w>hop</w>, il faut vraiment qu'on parte maintenant.",
                                "it": "Dai, <w>forza</w>, dobbiamo davvero andare ora.",
                                "cs": "Tak pojď, <w>šup</w>, už opravdu musíme vyrazit.",
                                "tr": "Hadi, <w>haydi</w>, artık gerçekten gitmemiz gerekiyor.",
                                "es": "Vamos, <w>venga</w>, realmente tenemos que irnos ahora.",
                                "zh": "快点，<w>走吧</w>，我们真的得出发了。"
                            }
                        },
                        {
                            "text": "Pak je spullen en <w>hup</w>, naar school.",
                            "target_lang_translations": {
                                "en": "Grab your stuff and <w>off you go</w> to school.",
                                "ru": "Бери свои вещи и <w>марш</w> в школу.",
                                "pl": "Pak swoje rzeczy i <w>marsz</w> do szkoły.",
                                "de": "Pack deine Sachen und <w>ab</w> zur Schule.",
                                "fr": "Prends tes affaires et <w>hop</w>, à l'école.",
                                "it": "Prendi le tue cose e <w>via</w>, a scuola.",
                                "cs": "Vezmi si věci a <w>šup</w> do školy.",
                                "tr": "Eşyalarını al ve <w>hadi</w>, okula.",
                                "es": "Coge tus cosas y <w>marchando</w> a la escuela.",
                                "zh": "收拾好东西，<w>快</w>去学校。"
                            }
                        },
                        {
                            "text": "Hup Holland <w>hup</w>, laat de leeuw niet in zijn hempie staan!",
                            "target_lang_translations": {
                                "en": "Go Holland <w>go</w>, don't let the lion down!",
                                "ru": "Вперёд, Голландия, <w>вперёд</w>, не дай льву ударить в грязь лицом!",
                                "pl": "Naprzód Holandio, <w>naprzód</w>, nie dajmy lwu zostać w samej koszuli!",
                                "de": "<w>Hopp</w> Holland <w>hopp</w>, lass den Löwen nicht im Regen stehen!",
                                "fr": "Allez la Hollande, <w>allez</w>, ne laisse pas le lion tomber !",
                                "it": "<w>Forza</w> Olanda <w>forza</w>, non lasciare il leone in braghe di tela!",
                                "cs": "<w>Do toho</w> Holandsko, <w>do toho</w>, nenechte lva ve štychu!",
                                "tr": "Haydi Hollanda <w>haydi</w>, aslanı yarı yolda bırakma!",
                                "es": "¡<w>Vamos</w> Holanda, <w>vamos</w>, no dejes al león en ridículo!",
                                "zh": "加油荷兰，<w>加油</w>，别让狮子丢脸！"
                            }
