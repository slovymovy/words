                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9832fa4a-7d3a-4e15-88dd-ef22d0d490fd",
                                "sense_id": "259318d5-1dad-3b79-8a99-60fa6afb1563",
                                "text": "„Die technische Weiterentwicklung im Heizungsanlagenbau hat in den vergangenen Jahren enorme Fortschritte gemacht.“"
                            },
                            {
                                "example_id": "d5a6ff35-6795-4eb0-85a2-cb69271f531f",
                                "sense_id": "259318d5-1dad-3b79-8a99-60fa6afb1563",
                                "text": "„Zum Heizungsanlagenbau gehören alle Arbeiten, die mit der Konzeption und Installation von Heizungsanlagen unterschiedlichster Art in Verbindung stehen (Fußbodenheizung, Rohrleitungs-, Heizkessel- und Heizkörpermontage). “"
                            },
                            {
                                "example_id": "2978eff8-1205-46ef-a182-86e26eeab82e",
                                "sense_id": "259318d5-1dad-3b79-8a99-60fa6afb1563",
                                "text": "„Für die Maurer und den Heizungsanlagenbau übernahm der VEB Gebäudewirtschaft Leipzig die Kosten, er ließ auch die Schwingflügelfenster einbauen.“"
                            },
                            {
                                "example_id": "ee6a5ea2-26b4-491a-b51c-c1e40e5db5a8",
                                "sense_id": "259318d5-1dad-3b79-8a99-60fa6afb1563",
                                "text": "„Doch wie das in den Mittelstandsfamilien in den 50er, 60er Jahren so war: Die 1943 geborene Anne sollte im Büro der väterlichen Firma für Gewächshaus- und Heizungsanlagenbau arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
