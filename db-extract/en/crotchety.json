                "senses": [
                    {
                        "sense_id": "697723c1-736d-3529-ac15-80ee2c52fe0d",
                        "entry_id": "00486184-1b8e-37cf-9651-fe962662e562",
                        "glosses": [
                            "Cranky, disagreeable, or stubborn, especially if prone to odd whims or fancies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4daa32-0638-4537-80c9-d1281e364cdd",
                                "sense_id": "697723c1-736d-3529-ac15-80ee2c52fe0d",
                                "text": "He wouldnt even let old Wilkie touch it do you remember Gerald but always gathered it himself and made his own julep. He was as crochety about his julep as an old maid, measuring everything by a recipe in his head."
                            },
                            {
                                "example_id": "7b974cba-9d99-4a1e-a6f8-5b7126470b25",
                                "sense_id": "697723c1-736d-3529-ac15-80ee2c52fe0d",
                                "text": "He has a happy home life, two sitcoms on the go and a new book in the offing. So why is the comedian, actor and Observer columnist still so crotchety?"
                            }
                        ]
                    }
                ],
