                        "translation_id": "3ab52286-c6ef-4a74-9489-a4fbf810bb7b",
                        "source_entry_id": "d88da977-1c01-38b2-9c12-564729d037d6",
                        "source_sense_id": "ff9d8e03-21e5-39a8-997e-c9997b960ef4",
                        "target_lang_word": "sarin",
                        "target_lang_code": "en",
