                    "sense_id": "abe85c17-6765-3c06-b77e-7088d4006410",
                    "sense_definition": "Een kledingstuk dat je op je hoofd draagt, vaak met een rand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man zette zijn <w>hoed</w> af toen hij de kerk binnenkwam.",
                            "target_lang_translations": {
                                "en": "The man took off his <w>hat</w> when he entered the church.",
                                "ru": "Мужчина снял свою <w>шляпу</w>, когда вошел в церковь.",
                                "pl": "Mężczyzna zdjął swój <w>kapelusz</w>, gdy wszedł do kościoła.",
                                "de": "Der Mann nahm seinen <w>Hut</w> ab, als er die Kirche betrat.",
                                "fr": "L'homme a retiré son <w>chapeau</w> lorsqu'il est entré dans l'église.",
                                "it": "L'uomo si tolse il <w>cappello</w> quando entrò in chiesa.",
                                "cs": "Muž si sundal <w>klobouk</w>, když vstupoval do kostela.",
                                "tr": "Adam kiliseye girdiğinde <w>şapkasını</w> çıkardı.",
                                "es": "El hombre se quitó el <w>sombrero</w> al entrar en la iglesia."
                            }
                        },
                        {
                            "text": "Voor de bruiloft heeft zij een prachtige nieuwe <w>hoed</w> gekocht.",
                            "target_lang_translations": {
                                "en": "She bought a beautiful new <w>hat</w> for the wedding.",
                                "ru": "Для свадьбы она купила красивую новую <w>шляпу</w>.",
                                "pl": "Na wesele kupiła piękny nowy <w>kapelusz</w>.",
                                "de": "Für die Hochzeit hat sie einen wunderschönen neuen <w>Hut</w> gekauft.",
                                "fr": "Pour le mariage, elle s'est acheté un magnifique nouveau <w>chapeau</w>.",
                                "it": "Per il matrimonio ha comprato un bellissimo <w>cappello</w> nuovo.",
                                "cs": "Na svatbu si koupila krásný nový <w>klobouk</w>.",
                                "tr": "Düğün için kendine harika yeni bir <w>şapka</w> satın aldı.",
                                "es": "Ella compró un hermoso <w>sombrero</w> nuevo para la boda."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoofddeksel"
                    ],
                    "common_phrases": [
                        "hoed afzetten",
                        "hoge hoed",
                        "onder een hoedje spelen",
                        "van de hoed en de rand weten"
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of clothing worn on the head, often with a brim.",
                        "ru": "Предмет одежды, который носят на голове, часто с полями.",
                        "pl": "Nakrycie głowy, często z rondem.",
                        "de": "Ein Kleidungsstück, das man auf dem Kopf trägt, oft mit einer Krempe.",
                        "fr": "Un vêtement que l'on porte sur la tête, souvent avec des bords.",
                        "it": "Un capo d'abbigliamento che si indossa sulla testa, spesso dotato di tesa.",
                        "cs": "Kus oblečení, který se nosí na hlavě, často s krempou.",
                        "tr": "Genellikle kenarları olan, başa giyilen bir giysi.",
                        "es": "Prenda de vestir que se lleva en la cabeza, a menudo con ala."
