                "senses": [
                    {
                        "sense_id": "19331875-e474-3b41-8060-8e6b2c81833d",
                        "entry_id": "7bcfdc3e-88a5-3701-b752-bbab67cd60d1",
                        "glosses": [
                            "Pertaining to a style of dress common during this period, characterised by extravagant, Classically-inspired designs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09425533-b5d9-4e11-ad51-9934c6e5c9b1",
                                "sense_id": "19331875-e474-3b41-8060-8e6b2c81833d",
                                "text": "My great-grandmother wore a brief empire bodice, and close-fitting Directoire skirt made of cream silk with a golden stripe running through it."
                            },
                            {
                                "example_id": "cb164454-d7d4-4507-b53c-e9ae5bba984d",
                                "sense_id": "19331875-e474-3b41-8060-8e6b2c81833d",
                                "text": "Leafing through them now, I notice how orderly the early ones are: drawings of boxy Jasper Conran Chanel-esque jackets and gauzy Galliano directoire dresses, annotations on how \"Patsy Kensit showed her bum!\" at a Westwood show [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3b62a7b-d8a1-3e4a-92c8-a6fd8692cfeb",
                        "entry_id": "7bcfdc3e-88a5-3701-b752-bbab67cd60d1",
                        "glosses": [
                            "Pertaining to a style of furniture, decoration etc. prevalent during this period."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900ce322-42de-4190-b9c0-f691ad66dc28",
                                "sense_id": "c3b62a7b-d8a1-3e4a-92c8-a6fd8692cfeb",
                                "text": "They prefer concerts and auctions to canasta and golf, are likely to spend the time their mothers relegated to ladies' luncheons to tracking down a Directoire commode for the foyer, just the right bronze for the living-room mantle."
                            },
                            {
                                "example_id": "ae9d5534-612a-4c2f-9c83-320ab4fed700",
                                "sense_id": "c3b62a7b-d8a1-3e4a-92c8-a6fd8692cfeb",
                                "text": "The only change was in his hair which he was now wearing in the Directoire style, the points coming down over his forehead."
                            }
                        ]
                    }
                ],
