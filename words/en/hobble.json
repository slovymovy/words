                        "tr": "Düzensiz veya dengesiz yürüyüş biçimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковыляние",
                                "target_lang_sense_clarification": "неуклюжая ходьба"
                            },
                            {
                                "target_lang_word": "хромота",
                                "target_lang_sense_clarification": "дефект походки"
                            },
                            {
                                "target_lang_word": "прихрамывание",
                                "target_lang_sense_clarification": "легкая хромота"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aksama",
                                "target_lang_sense_clarification": "topallayarak yürüme durumu"
                            },
                            {
                                "target_lang_word": "topallama",
                                "target_lang_sense_clarification": "yürüyüşteki bozukluk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc90928-0f3b-35f3-a27c-55bd3dd0fb5f",
                    "sense_definition": "A strap or rope used to tie an animal's legs together to restrict movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cowboy reached for a leather <w>hobble</w> to secure the pony near the stream.",
                            "target_lang_translations": {
                                "ru": "Ковбой потянулся за кожаными <w>путами</w>, чтобы закрепить пони у ручья.",
                                "tr": "Kovboy, midilliyi dere kenarında sabitlemek için deri bir <w>köstek</w> uzattı."
                            }
                        },
                        {
                            "text": "Make sure the <w>hobble</w> is not too tight to avoid injuring the animal's skin.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>путы</w> не слишком тугие, чтобы не повредить кожу животного.",
                                "tr": "Hayvanın derisini yaralamamak için <w>kösteğin</w> çok sıkı olmadığından emin olun."
                            }
