                ],
                "senses": [
                    {
                        "sense_id": "6d9f2908-48a6-35ce-8d82-498d16123b36",
                        "entry_id": "44a126c1-087f-3f31-ab09-d71094727ef8",
                        "glosses": [
                            "Behältnis zum Einpflanzen von Blumen, welches zumeist auf Fensterbrettern, an Balkonbrüstungen oder Ähnlichem angebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f14fa0d-db4c-4bdc-a458-93243bcfd3b2",
                                "sense_id": "6d9f2908-48a6-35ce-8d82-498d16123b36",
                                "text": "Im Blumenkasten unserer Nachbarin blühen jedes Jahr Stiefmütterchen."
                            },
                            {
                                "example_id": "851ea90e-a9f6-49db-806a-e2099fe3d195",
                                "sense_id": "6d9f2908-48a6-35ce-8d82-498d16123b36",
                                "text": "„In vielen Blumenkästen wuchsen Tomaten, Bohnen und Erbsen.“"
                            },
                            {
                                "example_id": "b9e678b7-d929-44ce-8e61-b90d39bd83ac",
                                "sense_id": "6d9f2908-48a6-35ce-8d82-498d16123b36",
                                "text": "„Sylvia sah zu dem Blumenkasten, den sie erst vor zwei Wochen mit Geranien bepflanzt hatte und der bereits eine einzige Blütenwolke war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
