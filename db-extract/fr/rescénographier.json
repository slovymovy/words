                "senses": [
                    {
                        "sense_id": "ba8875de-038c-3c12-86be-27a8d094af4b",
                        "entry_id": "a182d5ae-8571-310d-b890-5155ce9c77c5",
                        "glosses": [
                            "Scénographier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4814ba0-ae2b-4d35-b5a3-f181240d69a7",
                                "sense_id": "ba8875de-038c-3c12-86be-27a8d094af4b",
                                "text": "Ce n’est plus de les représenter qui compte mais de les réinvestir, de les rescénographier et d’élargir tous les jours le champ de notre regard."
                            },
                            {
                                "example_id": "f1023ddc-775b-4b77-8576-f0dc9b953af9",
                                "sense_id": "ba8875de-038c-3c12-86be-27a8d094af4b",
                                "text": "Par le biais de cette réflexion menée tambours battant, on tente de redéfinir le vocabulaire des espaces : « rescénographier » les extensions de notre corps, transmutation qui s’apparentent aux révolutions apportées par les artistes et géographes de la Renaissance qui créèrent les premiers globes terrestres."
                            }
                        ]
                    }
