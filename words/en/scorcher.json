{
    "word_family": [
        "scorch",
        "scorched",
        "scorching",
        "scorchingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d232f038-cdb8-3802-b0a3-0bb3bf7f0d85",
                    "sense_definition": "An extremely hot day.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tomorrow will be a real <w>scorcher</w>, so be sure to drink plenty of water.",
                            "target_lang_translations": {
                                "ru": "Завтра будет настоящая <w>жарища</w>, так что обязательно пейте побольше воды."
                            }
                        },
                        {
                            "text": "We decided to stay indoors by the air conditioner during yesterday's <w>scorcher</w>.",
                            "target_lang_translations": {
                                "ru": "Вчера, в это <w>пекло</w>, мы решили остаться дома под кондиционером."
                            }
                        }
                    ],
                    "synonyms": [
                        "sizzler"
                    ],
                    "common_phrases": [
                        "real scorcher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal description of very hot weather."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно жаркий, знойный день."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жарища",
                                "target_lang_sense_clarification": "разг., о сильной жаре"
                            },
                            {
                                "target_lang_word": "знойный денёк",
                                "target_lang_sense_clarification": "очень жаркий день"
                            },
                            {
                                "target_lang_word": "пекло",
                                "target_lang_sense_clarification": "невыносимая жара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c58b15-2e9e-37f2-b583-2eff7279b715",
                    "sense_definition": "A remarkably fast or powerful shot, especially one resulting in a goal in sports.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker scored a <w>scorcher</w> from thirty yards out to win the match.",
                            "target_lang_translations": {
                                "ru": "Нападающий забил победный гол <w>пушечным ударом</w> с тридцати ярдов."
                            }
                        },
                        {
                            "text": "The goalkeeper stood no chance as the ball flew in like an absolute <w>scorcher</w>.",
                            "target_lang_translations": {
                                "ru": "У вратаря не было ни единого шанса — мяч влетел в сетку как сумасшедшая <w>пушка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolute scorcher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used predominantly in sports contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычайно мощный, стремительный удар по мячу (в спорте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушечный удар",
                                "target_lang_sense_clarification": "в спорте, мощный выстрел"
                            },
                            {
                                "target_lang_word": "пушка",
                                "target_lang_sense_clarification": "спорт. сленг, сильный удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3779611c-c934-3778-9f8d-dd3313cf20e2",
                    "sense_definition": "A person or thing that scorches or burns something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The faulty iron proved to be a fabric <w>scorcher</w> after ruining several shirts.",
                            "target_lang_translations": {
                                "ru": "Неисправный утюг оказался настоящим <w>губителем</w> тканей, испортив несколько рубашек."
                            }
                        },
                        {
                            "text": "The intense laser acted as a precise surface <w>scorcher</w> during the manufacturing process.",
                            "target_lang_translations": {
                                "ru": "В процессе производства мощный лазер использовался для точечного <w>прожигания</w> поверхности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто или то, что прожигает, опаляет или оставляет подпалины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прожигатель",
                                "target_lang_sense_clarification": "то, что прожигает материал"
                            },
                            {
                                "target_lang_word": "опаливатель",
                                "target_lang_sense_clarification": "то, что опаляет поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8b96c6d-4146-3605-8bc1-6b819ede0853",
                    "sense_definition": "A scathing or sharply caustic rebuke or criticism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reviewer published a <w>scorcher</w> criticizing every aspect of the new play.",
                            "target_lang_translations": {
                                "ru": "Критик опубликовал форменный <w>разнос</w>, раскритиковав каждый аспект новой пьесы."
                            }
                        },
                        {
                            "text": "She delivered a verbal <w>scorcher</w> that left the whole board in silence.",
                            "target_lang_translations": {
                                "ru": "Она устроила такую словесную <w>головомойку</w>, что всё правление онемело."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal use for harsh criticism."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Язвительная, уничтожающая критика или суровый нагоняй."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнос",
                                "target_lang_sense_clarification": "разг., резкая критика"
                            },
                            {
                                "target_lang_word": "нагоняй",
                                "target_lang_sense_clarification": "строгий выговор"
                            },
                            {
                                "target_lang_word": "уничтожающая критика",
                                "target_lang_sense_clarification": "беспощадный отзыв"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2957780d-88f1-339e-ba7d-e532bab7938f",
                    "sense_definition": "A wicked, formidable, or troublesome person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old clerk warned us that the foreman was a downright <w>scorcher</w>.",
                            "target_lang_translations": {
                                "ru": "Старый клерк предупредил нас, что бригадир — сущий <w>тиран</w>."
                            }
                        },
                        {
                            "text": "He proved to be a <w>scorcher</w> who made life miserable for his colleagues.",
                            "target_lang_translations": {
                                "ru": "Он оказался невыносимым <w>злыднем</w>, отравившим жизнь своим коллегам."
                            }
                        }
                    ],
                    "synonyms": [
                        "stinker"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in 19th and early 20th century vernacular."
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Old slang for a bad person."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злой, невыносимый или неприятный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злыдень",
                                "target_lang_sense_clarification": "устар., злой и неприятный человек"
                            },
                            {
                                "target_lang_word": "язва",
                                "target_lang_sense_clarification": "разг., невыносимый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7646b130-0984-392c-8a3d-9981a88857b7",
                    "sense_definition": "A cyclist who rides recklessly fast on a public road.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cyclist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pedestrians constantly complained about every reckless <w>scorcher</w> speeding down the boulevard.",
                            "target_lang_translations": {
                                "ru": "Пешеходы постоянно жаловались на каждого безрассудного <w>лихача</w>, гоняющего по бульвару."
                            }
                        },
                        {
                            "text": "In the late Victorian era, the police tried to arrest any bicycle <w>scorcher</w>.",
                            "target_lang_translations": {
                                "ru": "В позднюю викторианскую эпоху полиция старалась арестовывать любого велосипедного <w>гонщика-лихача</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Commonly used in late 19th-century cycling slang."
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Historical cycling slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Велосипедист, несущийся на опасной скорости по общественной дороге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихач",
                                "target_lang_sense_clarification": "велосипедист, гоняющий на огромной скорости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}