                                            {
                                                "example_id": "f26efdaa-6878-408a-bf7e-477487877c41",
                                                "sense_id": "434bd191-03ea-3f12-a807-dbb5b01c2a9e",
                                                "text": "Une aigle avec ses aiglons dans son aire."
                                            },
                                            {
                                                "example_id": "b6d4aaa6-7bc0-41c9-aeff-6dd524d40785",
                                                "sense_id": "434bd191-03ea-3f12-a807-dbb5b01c2a9e",
                                                "text": "Un jeune aiglon."
                                            },
                                            {
                                                "example_id": "a6cb7600-0fa7-41ff-b0a1-22e57615790a",
                                                "sense_id": "434bd191-03ea-3f12-a807-dbb5b01c2a9e",
                                                "text": "Philippe.– Depuis quand le vieil aigle reste-t-il dans le nid, quand ses aiglons vont à la curée ?"
                                            },
                                            {
                                                "example_id": "0a860596-7a6d-473a-bdd0-f32347dfc6f5",
                                                "sense_id": "434bd191-03ea-3f12-a807-dbb5b01c2a9e",
                                                "text": "Un aiglon l’occupe, mais il est difficile d’estimer sa taille et son âge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7072563e-6b4d-3466-a341-ae7dfdfa6e00",
                                        "entry_id": "1b278b43-c79a-30ff-8727-b64d14492f98",
                                        "glosses": [
                                            "Modèle de coiffure. Voir aussi coiffure à l’Aiglon."
                                        ],
