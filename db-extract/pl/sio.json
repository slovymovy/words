                "senses": [
                    {
                        "sense_id": "e00ee361-b75b-3553-bceb-d1fc4b111c71",
                        "entry_id": "9655c17e-33ad-31a9-a9e7-7ea5021868fa",
                        "glosses": [
                            "wykrzyknik o znaczeniu „oddalcie się!”, używany zwłaszcza wobec ptaków, także innych zwierząt, czasem wobec dzieci"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "89792b46-dd4c-4011-8e27-9c2ad259dcd7",
                                "sense_id": "e00ee361-b75b-3553-bceb-d1fc4b111c71",
                                "text": "Sio mi z kuchni, wy diabelskie huncwoty!"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c5d8194-d0bb-402d-b2c6-6c7cd8860455",
                        "source_entry_id": "9655c17e-33ad-31a9-a9e7-7ea5021868fa",
                        "source_sense_id": "e00ee361-b75b-3553-bceb-d1fc4b111c71",
                        "target_lang_word": "shoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7867acbd-424d-3cb8-b903-45370f0bc2ba",
                                        "entry_id": "e4646f74-864f-3f51-a7dd-93cef72101c1",
                                        "glosses": [
                                            "To induce someone or something to leave."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab0bc32-1536-4e49-964f-ce1d44ecc191",
                                                "sense_id": "7867acbd-424d-3cb8-b903-45370f0bc2ba",
                                                "text": "Don't just shoo away mosquitoes, kill them!"
                                            },
                                            {
                                                "example_id": "73e661c2-7c41-4d48-85cd-7e357c04b4a9",
                                                "sense_id": "7867acbd-424d-3cb8-b903-45370f0bc2ba",
                                                "text": "See if you can shoo off the insurance salesmen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13803084-90ed-340f-afb0-ac55a9e3972b",
                                        "entry_id": "e4646f74-864f-3f51-a7dd-93cef72101c1",
                                        "glosses": [
                                            "To leave under inducement."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7529a046-0d48-4662-bcda-e850bd23c001",
                                                "sense_id": "13803084-90ed-340f-afb0-ac55a9e3972b",
                                                "text": "You kids had better shoo before your parents get a call."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5300b326-133a-334a-b012-282771e64890",
                                        "entry_id": "e4646f74-864f-3f51-a7dd-93cef72101c1",
                                        "glosses": [
                                            "To usher someone."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9afe7ddf-b200-4486-8b45-41b0bc8c219f",
                                                "sense_id": "5300b326-133a-334a-b012-282771e64890",
                                                "text": "Shoo the visitor in."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "216143cb-107d-375a-b1dc-d46b7c1bfbbb",
                                        "entry_id": "db324f19-7197-3dac-8766-5030a7f5969d",
                                        "glosses": [
                                            "Go away! Clear off!"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69a79df-6d5f-44f1-bcae-aa8921df3b6a",
                                                "sense_id": "216143cb-107d-375a-b1dc-d46b7c1bfbbb",
                                                "text": "Shoo, fly, don't bother me!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoo",
                                "target_lang_code": "en",
                                "target_senses": [
