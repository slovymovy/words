                                        "sense_id": "126581bf-1c8b-382a-81ee-431e7713cecb",
                                        "entry_id": "ed2469ec-0635-3c3f-b924-83db5f3fd525",
                                        "glosses": [
                                            "Located or situated below or near a sea level."
