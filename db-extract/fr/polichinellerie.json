                        "glosses": [
                            "Acte évoquant le comportement d’un polichinelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90aa122c-4a80-4c74-afb7-e29194122970",
                                "sense_id": "774c0ece-aff8-35e0-bde9-846e13acdd6a",
                                "text": "J’y rabattrai son orgueil comme pour les autres filles et j’y ferai passer la polichinellerie de dégoualer des boniments."
                            },
                            {
                                "example_id": "3fcbccf7-68e7-4f58-b43a-6823a505dc03",
                                "sense_id": "774c0ece-aff8-35e0-bde9-846e13acdd6a",
                                "text": "Faites-y réflexion, Mesdames ! riez de mes polichinelleries, mais ne riez pas de moi ; vous m’enterreriez tout vif."
                            },
                            {
                                "example_id": "29621bf0-86a3-4f51-8f56-a15960fdf06f",
                                "sense_id": "774c0ece-aff8-35e0-bde9-846e13acdd6a",
                                "text": "Il y a dans Sous le dolman, sans que ce soit une œuvre de parti, le plus fier dédain pour les polichinelleries des politiciens de province."
                            }
                        ]
                    }
