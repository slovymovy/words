                "senses": [
                    {
                        "sense_id": "8d05b32f-f157-39ed-b03d-947c083c0eab",
                        "entry_id": "aa191c9a-c299-3d46-9cf1-32fdd79bc64c",
                        "glosses": [
                            "sehr ursprüngliche Steingeräte des altsteinzeitlichen Menschen von vor über zwei Millionen Jahren. Geeignete Gerölle wurden durch härtere Schlagsteine zerlegt."
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "82c0f1af-473a-4c58-b19d-e28d886cee30",
                                "sense_id": "8d05b32f-f157-39ed-b03d-947c083c0eab",
                                "text": "Die ältesten Werkzeuge des Menschen vor über zwei Millionen Jahren waren Geröllgeräte."
                            },
                            {
                                "example_id": "2b97c5f2-9205-4fe9-8fc7-0efe864222fa",
                                "sense_id": "8d05b32f-f157-39ed-b03d-947c083c0eab",
                                "text": "\"Geröllgeräte sind einfache Geräte aus angeschlagenen Geröllen, die mindestens ein durch Schlagen erzeugtes Negativ (Abschlag) aufweisen. Durch einen Schlag oder eine Reihe von gezielten Schlägen entsteht eine schneidende Arbeitskante.\""
                            },
                            {
                                "example_id": "a5988f68-8f2b-4d45-b3fb-da66b7aaeca5",
                                "sense_id": "8d05b32f-f157-39ed-b03d-947c083c0eab",
                                "text": "Geröllgeräte sind kennzeichnend für das Oldowan."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
