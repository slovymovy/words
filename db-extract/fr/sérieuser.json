                "senses": [
                    {
                        "sense_id": "d19dd64d-81ea-35cf-8851-905bc66cdee4",
                        "entry_id": "edf7ff0c-e991-372f-9758-d8ed99d39bf7",
                        "glosses": [
                            "Donner un caractère sérieux à."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c52f35a9-f3b0-4fb8-905c-e6805aa5704f",
                                "sense_id": "d19dd64d-81ea-35cf-8851-905bc66cdee4",
                                "text": "Il voit avec douleur que les François aiment à rire ; & ce sont des Pièces telles que la sienne qu’il croit propres à sérieuser le caractère national."
                            },
                            {
                                "example_id": "e52fe6ce-3833-48ef-979b-76e74a96e698",
                                "sense_id": "d19dd64d-81ea-35cf-8851-905bc66cdee4",
                                "text": "La politique, on peut décider de la sérieuser."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ea92a1e-e5c5-3e56-b85c-973de09b18ae",
                        "entry_id": "edf7ff0c-e991-372f-9758-d8ed99d39bf7",
                        "glosses": [
                            "Être sérieux."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "94c9803d-bf71-4608-8177-5a0cc2d24b5d",
                                "sense_id": "4ea92a1e-e5c5-3e56-b85c-973de09b18ae",
                                "text": "Eh bien, vous, vous faites plus mal encore ; vous perdrez votre vie en sérieusant, je fais mon expression aussi."
                            }
                        ]
                    }
