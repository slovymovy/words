                "senses": [
                    {
                        "sense_id": "f0fabde1-314f-3777-86c5-2b7c09201161",
                        "entry_id": "25e9ab1e-8011-3239-8a61-c37eb9100b01",
                        "glosses": [
                            "Donner un caractère tchadien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e12823-22c7-4bbe-a79f-614881d2b0bd",
                                "sense_id": "f0fabde1-314f-3777-86c5-2b7c09201161",
                                "text": "Le B.E.T. fut \"tchadianisé\" à la fin de 1964."
                            },
                            {
                                "example_id": "1f19d1e9-7b7e-44ca-9264-d5a0667be497",
                                "sense_id": "f0fabde1-314f-3777-86c5-2b7c09201161",
                                "text": "Le vocabulaire des médias utilise actuellement un nombre considérable de mots, empruntés au français ou à l’arabe littéraire, et qui sont naturellement « tchadianisés »."
                            },
                            {
                                "example_id": "ec043c55-ea08-46c0-b715-73bd04e90b1e",
                                "sense_id": "f0fabde1-314f-3777-86c5-2b7c09201161",
                                "text": "Un public qui correspond au combat artistique et musical que mène le jazzman tchadien depuis son retour sur la terre de Toumaï, celle de « noircir » et « tchadianiser » le jazz."
                            }
                        ]
                    }
