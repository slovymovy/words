                "senses": [
                    {
                        "sense_id": "5c14bbdc-91b9-39e2-8fee-74db4f6569cf",
                        "entry_id": "430e37e1-ab86-39fa-bf5b-a66baa955a21",
                        "glosses": [
                            "Qui a des rentes, du revenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89482772-4fef-4ce3-99f1-7bc99394cc38",
                                "sense_id": "5c14bbdc-91b9-39e2-8fee-74db4f6569cf",
                                "text": "Il y avait des moines rentés et des moines mendiants."
                            },
                            {
                                "example_id": "490bf87d-ba3b-4e30-b258-e540baf0efe7",
                                "sense_id": "5c14bbdc-91b9-39e2-8fee-74db4f6569cf",
                                "text": "Il faudrait être bien renté pour faire cette dépense."
                            },
                            {
                                "example_id": "63b7e04b-a026-47dc-90a0-44b15686ae4f",
                                "sense_id": "5c14bbdc-91b9-39e2-8fee-74db4f6569cf",
                                "text": "C’est moi, le membre de l’Institut, renté, décoré, qui suis le seul révolutionnaire."
                            },
                            {
                                "example_id": "b90997b5-3859-436d-bb92-bee3ebb667e1",
                                "sense_id": "5c14bbdc-91b9-39e2-8fee-74db4f6569cf",
                                "text": "Colbert, qui ne l’aimait guère, a pu songer légitimement qu’en des temps d’économies, on pouvait rayer des listes ce nom illustre et bien renté."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ff8f3db-9a74-3046-9ebe-63ed3b58e18f",
                        "entry_id": "430e37e1-ab86-39fa-bf5b-a66baa955a21",
                        "glosses": [
                            "Riche."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f6664115-cfbc-48a1-8a40-da84940e8f12",
                                "sense_id": "2ff8f3db-9a74-3046-9ebe-63ed3b58e18f",
                                "text": "Mais, diront certains bourgeois bien rentés, qui les pieds sur leurs chenets liront tranquillement ces lignes : […]."
                            },
                            {
                                "example_id": "f8302a74-78a1-4fea-bea1-ab774ae48abd",
                                "sense_id": "2ff8f3db-9a74-3046-9ebe-63ed3b58e18f",
                                "text": "Au poulailler perchaient les jeunes et les vieilles dames mal rentées."
                            }
                        ]
                    }
