                "senses": [
                    {
                        "sense_id": "b780194f-d13d-3358-9aa2-11c5985fb3a8",
                        "entry_id": "a0e24404-cecf-347c-b00f-9984d820bde1",
                        "glosses": [
                            "велосипед с мотором"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6440bfa-d0d0-47ba-8ea9-ec66814c0d38",
                                "sense_id": "b780194f-d13d-3358-9aa2-11c5985fb3a8",
                                "text": "Мотовелосипед — велосипед с двигателем. Двигатель не имеет коробки передач. Привод педальный. Скорость 20—40 км/ч. Ои предназначен для езды по хорошим дорогам. В случае неисправности двигателя можно продолжать езду, пользуясь педалями, как на обычном велосипеде."
                            }
                        ]
                    }
                ],
