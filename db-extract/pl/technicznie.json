                                            {
                                                "example_id": "60f748aa-91a9-4a5a-9046-9d75a276eb8d",
                                                "sense_id": "a82f3ca3-d904-3f1b-a98a-37a8f61ca842",
                                                "text": "L'agenzia nazionale della sicurezza ferroviaria ANSF è un soggetto tecnicamente indipendente rispetto a tutti gli operatori nel campo del trasporto ferroviario"
