        "fr-extract.jsonl": [
            {
                "entry_id": "2b2033b4-1f4d-36a2-8a42-c9d0febba188",
                "word": "Birmanie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bac19ff5-e83f-3b0d-9b28-2a98c441ad5b",
                        "entry_id": "2b2033b4-1f4d-36a2-8a42-c9d0febba188",
                        "glosses": [
                            "Pays d’Asie du Sud-Est bordé par le Bangladesh, l'Inde, la Chine, le Laos, la Thaïlande, la mer d’Andaman et le golfe du Bengale, et dont la capitale est Naypyidaw."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "38e0ec24-4481-4334-a049-7e949c08f9cb",
                                "sense_id": "bac19ff5-e83f-3b0d-9b28-2a98c441ad5b",
                                "text": "Le gros des forces aériennes indo-britanniques périt dans la Birmanie sur un bûcher d’antagonistes embrasés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "192c456e-0f29-4f8d-87a4-fcd4bdde6142",
                        "source_entry_id": "2b2033b4-1f4d-36a2-8a42-c9d0febba188",
                        "source_sense_id": "bac19ff5-e83f-3b0d-9b28-2a98c441ad5b",
                        "target_lang_word": "Birma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                        "entry_id": "864dbe38-af6d-3f6b-a0f2-614e7d2b8190",
                                        "glosses": [
                                            "ein Land in Südostasien"
                                        ],
                                        "tags": [
                                            "traditionelle Bezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5002158f-449b-4052-bdc0-0ca3f88fb091",
                                                "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                                "text": "Mit vielen berühmten buddhistischen Statuen und ist Birma ein faszinierendes Land."
                                            },
                                            {
                                                "example_id": "4d782d8f-31b8-48e9-a550-440e1b10e924",
                                                "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                                "text": "Nach einer kurzen demokratischen Phase bis 1962 wurde Birma von verschiedenen Militärregimen kontrolliert."
                                            },
                                            {
                                                "example_id": "b0a71f16-102f-49f2-8b5f-b1d8341aae53",
                                                "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                                "text": "„In Birma, das damals noch zu Britisch-Indien gehörte, brach Anfang 1931 ein solcher Aufstand aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ef5ece2-46f6-4cf0-8095-974fd995e6f9",
                        "source_entry_id": "2b2033b4-1f4d-36a2-8a42-c9d0febba188",
                        "source_sense_id": "bac19ff5-e83f-3b0d-9b28-2a98c441ad5b",
                        "target_lang_word": "Burma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
