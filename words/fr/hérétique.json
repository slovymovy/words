                    "frequency": "Middle",
                    "semantic_group_id": "hérésie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, l'Inquisition poursuivait tout <w>hérétique</w> refusant de se soumettre aux dogmes de l'Église."
                        },
                        {
                            "text": "Considéré comme un dangereux <w>hérétique</w>, le philosophe a été contraint de fuir précipitamment sa ville natale."
                        }
                    ],
                    "synonyms": [
                        "dissident",
                        "hétérodoxe",
                        "schismatique"
                    ],
                    "antonyms": [
                        "orthodoxe"
                    ],
                    "common_phrases": [
                        "procès d'hérétique",
                        "brûler les hérétiques"
                    ]
                }
            ]
        },
        {
