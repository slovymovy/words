                    {
                        "form_id": "9eab79c4-79e2-4811-a723-4a6864433706",
                        "entry_id": "77d3846c-0370-37de-a56e-05d2c838d20a",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "Ва́хах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6f78841-6f86-3cc2-895f-5863a02809f4",
                        "entry_id": "77d3846c-0370-37de-a56e-05d2c838d20a",
                        "glosses": [
                            "чеченское и ингушское мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86bec014-8ba5-4ab2-a61a-b36d2c4f687a",
                                "sense_id": "f6f78841-6f86-3cc2-895f-5863a02809f4",
                                "text": "Близкие соседи: Чоков да Юрий. Кума Шура да кум Павло по прозвищу Лис, у них дети ― в райцентре. Кравченко, Мишка Хука, чеченка Полина, чеченцы же Алик да Ваха."
                            },
                            {
                                "example_id": "8ed2d5af-aa86-4bb2-bcfa-fd1c9ff55adc",
                                "sense_id": "f6f78841-6f86-3cc2-895f-5863a02809f4",
                                "text": "Так, «вице-президент Ичкерии» Ваха Арсанов призвал чеченских сепаратистов прекратить нападения на промосковскую чеченскую милицию."
                            },
                            {
                                "example_id": "cbe91165-83ce-482d-b7ef-a0178adff994",
                                "sense_id": "f6f78841-6f86-3cc2-895f-5863a02809f4",
                                "text": "На Олимпиаде в Сеуле штангист Исраил Арсамаков завоевал золотую медаль; Ваха Евлоев с честью несет высокое звание чемпиона Европы по вольной борьбе."
                            }
                        ]
                    }
                ],
