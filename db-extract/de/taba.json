                        "glosses": [
                            "Ort auf der Sinaihalbinsel in Ägypten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7023c72-7157-4320-82a9-9c07e80f0212",
                                "sense_id": "59261feb-b62a-30e4-b88e-2a35d8b75377",
                                "text": "„Auf dieser Basis konnten die Konfliktparteien bei einer Fortführung der Verhandlungen im Januar 2001 im ägyptischen Taba eine Annäherung der Positionen erreichen.“"
                            },
                            {
                                "example_id": "c9b74682-d4b5-4b51-b139-46934ccf0a95",
                                "sense_id": "59261feb-b62a-30e4-b88e-2a35d8b75377",
                                "text": "„Baraks Unterhändler waren deshalb bis zuletzt - so auch bei den bilateralen Friedensgesprächen am 21. Januar im ägyptischen Taba - verzweifelt um eine Lösung in der Jerusalemfrage bemüht, die auch eine palästinensische Teilsouveränität nicht ausschloss.“"
                            }
