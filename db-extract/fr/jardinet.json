        "fr-extract.jsonl": [
            {
                "entry_id": "f8efc448-c08d-3b03-b853-25831ab56f17",
                "word": "jardinet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f794aa69-592b-41b9-8198-6d681bc57c7a",
                        "entry_id": "f8efc448-c08d-3b03-b853-25831ab56f17",
                        "tags": [
                            "plural"
                        ],
                        "form": "jardinets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5205f8a9-47be-35e2-9a9b-06f25bf1721b",
                        "entry_id": "f8efc448-c08d-3b03-b853-25831ab56f17",
                        "glosses": [
                            "Petit jardin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ab5c35-7fc8-43b3-9c04-809cb19b3591",
                                "sense_id": "5205f8a9-47be-35e2-9a9b-06f25bf1721b",
                                "text": "Le jardinet, d’une largeur égale à celle du fastueux boulingrin, était alors plein de fleurs, de roses, de dalhias, des plus belles, des plus rares productions de la Flore des serres."
                            },
                            {
                                "example_id": "843736cb-724b-46b6-aeb3-c29dc4f341ce",
                                "sense_id": "5205f8a9-47be-35e2-9a9b-06f25bf1721b",
                                "text": "Le maire ayant refusé de rendre le presbytère à sa primitive destination, le commune fut obligée d’acheter une maison de paysan située près de l’église ; il fallut dépenser cinq mille francs pour l’agrandir, la restaurer et y joindre un jardinet dont le mur était mitoyen avec la sacristie, en sorte que la communication fut établie comme autrefois entre la maison curiale et l’église."
                            },
                            {
                                "example_id": "f9c84c3a-66ae-4fd3-ac65-793a5251bb76",
                                "sense_id": "5205f8a9-47be-35e2-9a9b-06f25bf1721b",
                                "text": "Dans ma tente même, aux endroits qui ne sont pas constamment piétinés, sous mon lit, dans les coins, il y a maintenant tout un jardinet d'herbes vertes et de fleurettes multicolores."
                            },
                            {
                                "example_id": "886e3dfd-0922-4223-a9db-2239651fa72e",
                                "sense_id": "5205f8a9-47be-35e2-9a9b-06f25bf1721b",
                                "text": "Dans un coin, à l’ombre de deux marronniers, il y a une cabane. M. Hyacinthe la leur présente :\n— Mesdemoiselles, avant de visiter mon jardinet, vous allez connaître ma maisonnette…\nCes mots, rapetissant les choses, sont extrêmement comiques, prononcés par une voix formidablement grave."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11fbe9b1-2bb1-4e3c-a22b-39b24a033721",
                        "source_entry_id": "f8efc448-c08d-3b03-b853-25831ab56f17",
                        "source_sense_id": "5205f8a9-47be-35e2-9a9b-06f25bf1721b",
                        "target_lang_word": "Gärtchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gärtchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "804ab866-bece-304c-8f98-c21841b4a524",
                                        "entry_id": "ef2f6a8f-8014-3b93-a47f-d1bb09901ec2",
                                        "glosses": [
                                            "kleiner Garten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0c667d-c307-455a-b6b4-ac3642bfe4c0",
                                                "sense_id": "804ab866-bece-304c-8f98-c21841b4a524",
                                                "text": "Unser Gärtchen war zwar klein, verfügte aber über eine romantische Bank unter einer Laube."
                                            },
                                            {
                                                "example_id": "ef252aa6-93ac-4570-a2bc-1b8a54249472",
                                                "sense_id": "804ab866-bece-304c-8f98-c21841b4a524",
                                                "text": "„In den folgenden zwei Jahren hatte sich der Massenmörder Max Schulz einen kleinen Blumengarten angelegt, hatte auch Tomaten, Zwiebeln, Radieschen und Suppengrün im Gärtchen hinter seinem idyllischen Einfamilienhäuschen angepflanzt.“"
                                            },
                                            {
                                                "example_id": "4c93dc7c-43ff-420c-8336-5e5fde440055",
                                                "sense_id": "804ab866-bece-304c-8f98-c21841b4a524",
                                                "text": "„Das Gärtchen war etwa dreißig Fuß im Geviert groß, und es wuchs darin weiter nichts als Salat und ein sehr schöner Feigenbaum.“"
                                            },
                                            {
                                                "example_id": "76422ae5-5d1b-4f48-b6bc-e3b5b9be7334",
                                                "sense_id": "804ab866-bece-304c-8f98-c21841b4a524",
                                                "text": "„Ja, Ruhe, danach verlangte Cécile, die sich denn auch unverweilt in eine nach einem Gärtchen hinaus gelegene Hinterstube zurückzog, wo die Fenster aufstanden und die kleinen gelben Gardinen im Luftzuge wehten.“"
                                            },
                                            {
                                                "example_id": "0b5a4755-4bba-423f-86f8-281b7fed6cbd",
                                                "sense_id": "804ab866-bece-304c-8f98-c21841b4a524",
                                                "text": "„Über dem Viertel lag der Glanz eines vornehmen altertümlichen Gepräges, wenn auch das eine und andere Villenhaus verfallen in seinem verwilderten Gärtchen lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
