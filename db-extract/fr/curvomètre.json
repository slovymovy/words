                        "entry_id": "7b766722-4004-3e17-8d87-c95f5da4c798",
                        "glosses": [
                            "Banc d’essai portatif de mesure de la vitesse maximum atteignable par un engin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c0460d-acb5-477e-b98b-55bae15b8b96",
                                "sense_id": "19ed0187-a17f-3f03-aee9-b14b2462d112",
                                "text": "Le curvomètre est un banc d’essai portatif qui permet, en le reliant à une machine de mesurer la vitesse maximum que peuvent atteindre les engins."
                            },
                            {
                                "example_id": "abeb9c48-599d-406c-9b51-d6a30666074f",
                                "sense_id": "19ed0187-a17f-3f03-aee9-b14b2462d112",
                                "text": "un « curvomètre » permettant de vérifier si les vélos électriques sont bien bridés à 25 km/h,"
                            },
                            {
                                "example_id": "8e683837-00fa-425e-8f1a-dbb70aa1825c",
                                "sense_id": "19ed0187-a17f-3f03-aee9-b14b2462d112",
                                "text": "Récemment doté d'un engin de contrôle appelé curvomètre, permettant de contrôler la vitesse maximale des bolides trafiqués, le groupement de gendarmerie de Lot-et-Garonne entend multiplier les contrôles."
                            },
                            {
                                "example_id": "9f195ec4-eb0f-426e-b290-a3db87b8d3f7",
                                "sense_id": "19ed0187-a17f-3f03-aee9-b14b2462d112",
                                "text": "La vitesse est contrôlée à l'aide d'un curvomètre (qui n'est pas validé en France) ou de jumelles laser."
                            }
                        ]
                    }
