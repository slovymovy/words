                "senses": [
                    {
                        "sense_id": "181891df-f7cd-316c-9d02-9ed2046bd6d1",
                        "entry_id": "430cca77-02aa-3e09-b200-5e7da9f2b5f4",
                        "glosses": [
                            "Veranstaltung, bei der Stiere von Personen durch enge Gassen/Straßen bis zu einer Arena getrieben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c652ab22-fe3e-4c0a-b126-572767b2c3b0",
                                "sense_id": "181891df-f7cd-316c-9d02-9ed2046bd6d1",
                                "text": "„Indiz für den verbreiteten Wunsch, Wagemut zu demonstrieren und sich über das starke Tier zu profilieren, ist auch das Stiertreiben (Encierro), das am Morgen eines Stierkampftages im spanischen Pamplona […] die sogenannten Corredores auf die Straßen zieht.“"
                            },
                            {
                                "example_id": "9e1e84cd-1e46-47cb-83b1-42217f652276",
                                "sense_id": "181891df-f7cd-316c-9d02-9ed2046bd6d1",
                                "text": "„Das in Spanien nach wie vor sehr populäre Stiertreiben durch die engen Gassen der nordspanischen Stadt wird live im Fernsehen übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
