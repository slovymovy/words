{
    "word_family": [
        "opdracht",
        "opdrager",
        "dragen",
        "overdragen",
        "toedragen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1906732e-700b-3537-aca2-da33e5711681",
                    "sense_definition": "iemand de taak of plicht geven om iets te doen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "taken geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur zal de nieuwe medewerker een belangrijke taak <w>opdragen</w>.",
                            "target_lang_translations": {
                                "en": "The director will <w>assign</w> an important task to the new employee."
                            }
                        },
                        {
                            "text": "Zij heeft haar assistent <w>opgedragen</w> om alle documenten direct te archiveren.",
                            "target_lang_translations": {
                                "en": "She <w>instructed</w> her assistant to archive all documents immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "gelasten",
                        "instrueren",
                        "bevelen",
                        "toewijzen"
                    ],
                    "common_phrases": [
                        "een taak opdragen"
                    ],
                    "target_lang_definitions": {
                        "en": "to give someone the task or duty to do something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "instruct",
                                "target_lang_sense_clarification": "to tell someone what they must do"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to assign a duty or responsibility to"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "to command someone to perform a task"
                            },
                            {
                                "target_lang_word": "assign",
                                "target_lang_sense_clarification": "to give someone a specific job or task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "577ac073-6a56-3ec8-8254-bc8d80a2b7b0",
                    "sense_definition": "iets aan iemand wijden als teken van respect of eerbewijs",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auteur besloot zijn nieuwste roman aan zijn overleden grootvader <w>op te dragen</w>.",
                            "target_lang_translations": {
                                "en": "The author decided to <w>dedicate</w> his latest novel to his late grandfather."
                            }
                        },
                        {
                            "text": "Dit boek <w>dragen</w> wij <w>op</w> aan onze ouders voor hun onvoorwaardelijke steun.",
                            "target_lang_translations": {
                                "en": "We <w>dedicate</w> this book to our parents for their unconditional support."
                            }
                        }
                    ],
                    "synonyms": [
                        "toewijden",
                        "dediceren",
                        "wijden"
                    ],
                    "common_phrases": [
                        "een boek opdragen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to devote something to someone as a sign of respect or tribute"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dedicate",
                                "target_lang_sense_clarification": "to address a work to someone as a mark of respect"
                            },
                            {
                                "target_lang_word": "devote",
                                "target_lang_sense_clarification": "to give over or direct time or effort to a cause or person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4376473-7cef-387a-be99-d2a2ce3efc5f",
                    "sense_definition": "iets aan de zorg of verantwoordelijkheid van iemand anders overlaten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toevertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de zorg voor dit project gerust aan hem <w>opdragen</w>.",
                            "target_lang_translations": {
                                "en": "You can safely <w>entrust</w> the care of this project to him."
                            }
                        },
                        {
                            "text": "Zij <w>droeg</w> de verantwoordelijkheid voor de financiën <w>op</w> aan de penningmeester.",
                            "target_lang_translations": {
                                "en": "She <w>delegated</w> the responsibility for the finances to the treasurer."
                            }
                        }
                    ],
                    "synonyms": [
                        "toevertrouwen",
                        "overdragen"
                    ],
                    "target_lang_definitions": {
                        "en": "to leave something to the care or responsibility of someone else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entrust",
                                "target_lang_sense_clarification": "to assign the responsibility for doing something to someone"
                            },
                            {
                                "target_lang_word": "delegate",
                                "target_lang_sense_clarification": "to entrust a task or responsibility to another person"
                            },
                            {
                                "target_lang_word": "hand over",
                                "target_lang_sense_clarification": "to pass responsibility to someone else"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}