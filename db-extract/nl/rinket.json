                        "entry_id": "569e5cf0-7a1e-3a1a-990a-c7785fbb7451",
                        "glosses": [
                            "een klep in een stuw of sluisdeur in de vorm van een kleine deur of schuif, waarmee de waterpassage wordt geregeld"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
