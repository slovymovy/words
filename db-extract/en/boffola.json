                        "glosses": [
                            "A coarse or farcical gag; a joke provoking hearty laughter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a29122-a978-473b-955f-1ffe7f7124a0",
                                "sense_id": "f3580489-92c8-3e77-83d7-68dba512bdb6",
                                "text": "\"You're here to set off skyrockets for Barbara Anne, not to regale us with the steam-room boffolas of Beverly Hills.\" \"Well, I thought it was a cute story,\" Mr. Blakelee said."
                            },
                            {
                                "example_id": "3312f865-34b4-44ca-978f-45099655c9bf",
                                "sense_id": "f3580489-92c8-3e77-83d7-68dba512bdb6",
                                "text": "You laugh all the harder because the movie never winds up to hit you with a boffola."
                            },
                            {
                                "example_id": "a0a661f2-bc4b-4594-bed6-8f4439e5a1eb",
                                "sense_id": "f3580489-92c8-3e77-83d7-68dba512bdb6",
                                "text": "These are the people whose laughter you hear after the boffolas on shows that have been filmed without audiences. I don't suppose all these laughers are dead, but a lot of them must be by this time."
                            }
                        ]
                    }
