                                                "sense_id": "2c33ea29-dd19-3959-8570-2316dc25f67b",
                                                "text": "Ausgerechnet ihn hat man zum Nachfolger ernannt."
                                            },
                                            {
                                                "example_id": "b82dfefe-19de-43e9-a4bd-59ab9c02d73e",
                                                "sense_id": "2c33ea29-dd19-3959-8570-2316dc25f67b",
                                                "text": "[USA:] „Bundesrichter, zahlreiche hohe Richter der Einzelstaaten und Supreme Court-Richter werden von den Gouverneuren beziehungsweise dem Präsidenten ernannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba2a3fe4-9df3-4d25-88ae-ea347fa846cd",
                        "source_entry_id": "566e35dc-c5d9-303f-912e-5c6f0324e126",
