{
    "word_family": [
        "bestaan",
        "bestaanbaar",
        "bestaanbaarheid",
        "onbestaanbaarheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0abfe2f-9493-3374-bd58-4af020ebf4eb",
                    "sense_definition": "wat niet kan bestaan of voorkomen; volstrekt onmogelijk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onmogelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder water is leven op deze dorre planeet volkomen <w>onbestaanbaar</w>.",
                            "target_lang_translations": {
                                "en": "Without water, life on this arid planet is completely <w>impossible</w>."
                            }
                        },
                        {
                            "text": "Een dergelijke situatie is in onze moderne samenleving vrijwel <w>onbestaanbaar</w>.",
                            "target_lang_translations": {
                                "en": "Such a situation is virtually <w>unthinkable</w> in our modern society."
                            }
                        }
                    ],
                    "synonyms": [
                        "onmogelijk",
                        "ondenkbaar"
                    ],
                    "antonyms": [
                        "bestaanbaar"
                    ],
                    "common_phrases": [
                        "vrijwel onbestaanbaar",
                        "volkomen onbestaanbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "that cannot exist or occur; totally impossible or unthinkable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible",
                                "target_lang_sense_clarification": "cannot exist or happen"
                            },
                            {
                                "target_lang_word": "unthinkable",
                                "target_lang_sense_clarification": "inconceivable, not capable of existing"
                            },
                            {
                                "target_lang_word": "non-existent",
                                "target_lang_sense_clarification": "incapable of existence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1524f369-4374-3d4d-90ce-1528ef6e6afc",
                    "sense_definition": "wat absoluut niet geaccepteerd of getolereerd kan worden; onaanvaardbaar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onaanvaardbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is volstrekt <w>onbestaanbaar</w> dat patiënten zo lang moeten wachten op noodzakelijke zorg.",
                            "target_lang_translations": {
                                "en": "It is completely <w>unacceptable</w> that patients have to wait so long for necessary care."
                            }
                        },
                        {
                            "text": "De oppositie noemde het gedrag van de minister volkomen <w>onbestaanbaar</w>.",
                            "target_lang_translations": {
                                "en": "The opposition called the minister's behavior utterly <w>intolerable</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onaanvaardbaar",
                        "ontoelaatbaar"
                    ],
                    "common_phrases": [
                        "volstrekt onbestaanbaar",
                        "onbestaanbaar achten"
                    ],
                    "target_lang_definitions": {
                        "en": "that absolutely cannot be accepted, tolerated, or permitted; unacceptable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unacceptable",
                                "target_lang_sense_clarification": "not capable of being tolerated or permitted"
                            },
                            {
                                "target_lang_word": "out of the question",
                                "target_lang_sense_clarification": "wholly unacceptable or intolerable"
                            },
                            {
                                "target_lang_word": "intolerable",
                                "target_lang_sense_clarification": "cannot be allowed or accepted"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba57496d-14c2-3900-8927-93269acf58b6",
                    "sense_definition": "zeer hinderlijk of onuitstaanbaar",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "onuitstaanbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn arrogante houding tijdens de vergadering maakte hem werkelijk <w>onbestaanbaar</w> voor zijn collega's.",
                            "target_lang_translations": {
                                "en": "His arrogant attitude during the meeting made him truly <w>insufferable</w> to his colleagues."
                            }
                        },
                        {
                            "text": "Zij vonden het grillige humeur van hun nieuwe leidinggevende volkomen <w>onbestaanbaar</w>.",
                            "target_lang_translations": {
                                "en": "They found their new supervisor's capricious mood completely <w>unbearable</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onuitstaanbaar",
                        "onverdragelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "extremely annoying, insufferable, or unbearable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insufferable",
                                "target_lang_sense_clarification": "intolerable or extremely annoying"
                            },
                            {
                                "target_lang_word": "unbearable",
                                "target_lang_sense_clarification": "incapable of being endured"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}