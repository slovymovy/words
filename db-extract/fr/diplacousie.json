                        "glosses": [
                            "Trouble de l'audition qui se traduit par la perception d’un son sous deux formes différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267a14a1-c68d-436f-9bab-853b7f7a6107",
                                "sense_id": "cf37a1f6-6097-3789-9a0e-9aed71d3917e",
                                "text": "Diplacousie dysharmonique, audition d’un même son sous forme de hauteur différente."
                            },
                            {
                                "example_id": "05f76ab5-b59f-4a8f-a72b-3cf3c708cbc7",
                                "sense_id": "cf37a1f6-6097-3789-9a0e-9aed71d3917e",
                                "text": "Diplacousie en écho, audition d’un même son séparé par un court intervalle de temps."
                            },
                            {
                                "example_id": "33a984e3-16ef-4c73-95f1-e21b9048090b",
                                "sense_id": "cf37a1f6-6097-3789-9a0e-9aed71d3917e",
                                "text": "Je ne suis pas le seul à penser ainsi, car Urbantschitsch admet que la diplacousie peut appartenir à l’oreille moyenne ou à l’oreille interne et qu’on en fait la distinction par la voie osseuse."
                            }
                        ]
