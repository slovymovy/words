                        "entry_id": "dd4b2bf2-5af6-3c26-8033-c2510058a777",
                        "glosses": [
                            "The introduction of an antigenic substance or vaccine into the body to produce immunity to a specific disease."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
