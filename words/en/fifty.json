    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "a5e49983-7457-3a2f-937f-44a31f6f9cd5",
                    "sense_definition": "The cardinal number 50; five times ten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are <w>fifty</w> states in the United States of America.",
                            "target_lang_translations": {
                                "ru": "В Соединенных Штатах Америки <w>пятьдесят</w> штатов.",
                                "zh": "美国有<w>五十</w>个州。"
                            }
                        },
                        {
                            "text": "She invited over <w>fifty</w> guests to her wedding reception.",
                            "target_lang_translations": {
                                "ru": "Она пригласила более <w>пятидесяти</w> гостей на свой свадебный прием.",
                                "zh": "她邀请了超过<w>五十</w>位客人参加她的婚礼招待会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "50",
                        "L"
                    ],
                    "common_phrases": [
                        "fifty-fifty",
                        "fifty percent",
                        "top fifty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количественное числительное 50; пять раз по десять.",
                        "zh": "基数词50；五乘以十。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятьдесят",
                                "target_lang_sense_clarification": "число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五十",
                                "target_lang_sense_clarification": "数字50"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "adc51130-968c-3483-bf17-3bb79e7f0b1a",
                    "sense_definition": "A banknote or coin with a value of 50 units of currency.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not have any small change, only a <w>fifty</w>.",
                            "target_lang_translations": {
                                "ru": "У меня нет мелочи, только <w>полтинник</w>.",
                                "zh": "我没有零钱，只有一张<w>五十元钞票</w>。"
                            }
                        },
                        {
                            "text": "Can you break a <w>fifty</w> for me so I can pay the driver?",
                            "target_lang_translations": {
                                "ru": "Можешь разменять мне <w>полтинник</w>, чтобы я мог расплатиться с водителем?",
                                "zh": "你能帮我把这张<w>五十元钞票</w>换开吗？这样我好付车费。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Банкнота или монета достоинством в 50 единиц валюты.",
                        "zh": "面值为50个货币单位的纸币或硬币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полтинник",
                                "target_lang_sense_clarification": "разг. банкнота или монета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五十元钞票",
                                "target_lang_sense_clarification": "面值50的纸币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68313a8d-4e8a-39fe-bc76-d30b94da4534",
                    "sense_definition": "A score of 50 runs or more achieved by a batsman in a game of cricket.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd cheered loudly when the captain reached his <w>fifty</w>.",
                            "target_lang_translations": {
                                "ru": "Толпа громко ликовала, когда капитан набрал свои <w>пятьдесят очков</w>.",
                                "zh": "当队长拿到<w>五十分</w>时，人群欢呼雀跃。"
                            }
                        },
                        {
                            "text": "He was disappointed to get out just moments after scoring a <w>fifty</w>.",
                            "target_lang_translations": {
                                "ru": "Он был разочарован тем, что выбыл из игры сразу после того, как набрал <w>пятьдесят очков</w>.",
                                "zh": "他刚拿到<w>五十分</w>没多久就被淘汰出局，感到很失望。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Счет в 50 пробежек или более, достигнутый бэтсменом в игре в крикет.",
                        "zh": "板球比赛中击球手获得50分或以上的得分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полусотня",
                                "target_lang_sense_clarification": "крикет: 50 и более ранов одного бэтсмена"
                            },
                            {
                                "target_lang_word": "пятьдесят очков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五十分",
                                "target_lang_sense_clarification": "板球术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}