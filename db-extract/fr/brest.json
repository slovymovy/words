        "fr-extract.jsonl": [
            {
                "entry_id": "27b7109c-083b-3439-a98b-7db75de1ccf7",
                "word": "Brest",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e17bfea0-c51a-3e38-8173-b032f34f1976",
                        "entry_id": "27b7109c-083b-3439-a98b-7db75de1ccf7",
                        "glosses": [
                            "Commune et ville française, située dans le département du Finistère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d32d77-0515-4078-99ec-f24ae70bbaf5",
                                "sense_id": "e17bfea0-c51a-3e38-8173-b032f34f1976",
                                "text": "Cette mer que je devais rencontrer sur tant de rivages baignait à Brest l’extrémité de la péninsule Armoricaine : après ce cap avancé, il n’y avait plus rien qu’un océan sans bornes et des mondes inconnus ; mon imagination se jouait dans ces espaces."
                            },
                            {
                                "example_id": "b5c45bd1-6d62-4588-b869-368c0e043195",
                                "sense_id": "e17bfea0-c51a-3e38-8173-b032f34f1976",
                                "text": "Toulon, en réalité, n’appartient, en propre, à aucune de nos provinces, c’est le Brest de la Méditerranée, à moins que Brest ne soit le Toulon de l’Océan."
                            },
                            {
                                "example_id": "c5e5b8bc-a2b2-4f8e-8832-4064bc26a065",
                                "sense_id": "e17bfea0-c51a-3e38-8173-b032f34f1976",
                                "text": "Rappelle-toi Barbara\nIl pleuvait sans cesse sur Brest ce jour-là."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddeb8f4d-725f-4f19-bf58-303e75f949b6",
                        "source_entry_id": "27b7109c-083b-3439-a98b-7db75de1ccf7",
