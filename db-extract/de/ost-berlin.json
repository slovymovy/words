                        "sense_id": "1ff68dd8-072e-3da8-a058-557467e549d9",
                        "entry_id": "654a0011-9225-34fc-9d7f-b81164d6ada7",
                        "glosses": [
                            "für die östlichen Stadtbezirke von Berlin; ehemalige Hauptstadt der DDR"
