{
    "word_family": [
        "приход",
        "приходный",
        "приходящий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d80a9ebd-e7e6-3127-9ac0-1154e1ff01d2",
                    "sense_definition": "Перемещаться пешком или прибывать в какое-либо место.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>прихожу</w> домой поздно вечером после работы.",
                            "target_lang_translations": {
                                "en": "I <w>come</w> home late in the evening after work."
                            }
                        },
                        {
                            "text": "Друзья <w>приходят</w> в гости на выходных.",
                            "target_lang_translations": {
                                "en": "Friends <w>come</w> over on the weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "подходи́ть",
                        "заходи́ть"
                    ],
                    "antonyms": [
                        "отходить"
                    ],
                    "common_phrases": [
                        "приходить домой",
                        "приходить в гости"
                    ],
                    "target_lang_definitions": {
                        "en": "To move on foot or arrive at a specific location."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "To move toward the speaker or a specific destination."
                            },
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "To reach a destination."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aac0ddfc-f41a-3244-ab03-88548a4ec581",
                    "sense_definition": "Наступать или начинаться (о времени, событии или периоде).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скоро <w>приходит</w> весна и становится тепло.",
                            "target_lang_translations": {
                                "en": "Spring will <w>come</w> soon and it will get warm."
                            }
                        },
                        {
                            "text": "Наконец <w>приходит</w> время для долгожданного отпуска.",
                            "target_lang_translations": {
                                "en": "Finally, the time <w>comes</w> for the long-awaited vacation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "приходит время",
                        "приходит пора"
                    ],
                    "target_lang_definitions": {
                        "en": "To happen or begin (referring to a time, event, or period)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "Used to indicate the arrival of a specific time or season."
                            },
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "To occur or happen (of time)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccf75147-f9bf-3b09-8205-414004370d37",
                    "sense_definition": "Возникать или появляться в сознании (о мыслях или идеях).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Интересная мысль <w>приходит</w> мне в голову во время прогулки.",
                            "target_lang_translations": {
                                "en": "An interesting thought <w>comes</w> to my mind during a walk."
                            }
                        },
                        {
                            "text": "Хорошие идеи часто <w>приходят</w> совершенно неожиданно.",
                            "target_lang_translations": {
                                "en": "Good ideas often <w>come</w> quite unexpectedly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "приходить в голову"
                    ],
                    "target_lang_definitions": {
                        "en": "To occur or appear in the mind (referring to thoughts or ideas)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come to mind",
                                "target_lang_sense_clarification": "To occur to someone."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5973c6b0-0727-321c-b5d9-8798e55a52b8",
                    "sense_definition": "Начинать испытывать какое-либо состояние или чувство.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все зрители <w>приходят</w> в восторг от этого выступления.",
                            "target_lang_translations": {
                                "en": "All the spectators <w>become</w> delighted by this performance."
                            }
                        },
                        {
                            "text": "Люди часто <w>приходят</w> в замешательство от сложных вопросов.",
                            "target_lang_translations": {
                                "en": "People often <w>become</w> confused by difficult questions."
                            }
                        }
                    ],
                    "common_phrases": [
                        "приходить в восторг",
                        "приходить в ужас"
                    ],
                    "target_lang_definitions": {
                        "en": "To begin to experience a certain state or feeling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "become",
                                "target_lang_sense_clarification": "To enter a state or condition."
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "To reach a state (e.g., get excited)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a908bfc9-24a7-3194-a047-5a8bf58e60de",
                    "sense_definition": "Прибывать в пункт назначения (о транспорте).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд <w>приходит</w> на вокзал точно по расписанию.",
                            "target_lang_translations": {
                                "en": "The train <w>arrives</w> at the station exactly on schedule."
                            }
                        },
                        {
                            "text": "Автобусы <w>приходят</w> на остановку каждые десять минут.",
                            "target_lang_translations": {
                                "en": "Buses <w>arrive</w> at the stop every ten minutes."
                            }
                        }
                    ],
                    "synonyms": [
                        "прибывать"
                    ],
                    "antonyms": [
                        "отходить"
                    ],
                    "common_phrases": [
                        "поезд приходит"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach a destination (referring to transport)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "To reach a destination."
                            },
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "To reach a point of perspective."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d77d972-e54d-3ae4-bfe7-b1ee4cc1be2f",
                    "sense_definition": "Оказываться в определенном состоянии, часто негативном.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый дом постепенно <w>приходит</w> в негодность без ремонта.",
                            "target_lang_translations": {
                                "en": "The old house is gradually <w>falling into</w> disrepair without maintenance."
                            }
                        },
                        {
                            "text": "Из-за отсутствия ухода сад <w>приходит</w> в запустение.",
                            "target_lang_translations": {
                                "en": "Due to lack of care, the garden is <w>falling into</w> neglect."
                            }
                        }
                    ],
                    "common_phrases": [
                        "приходить в негодность"
                    ],
                    "target_lang_definitions": {
                        "en": "To end up in a certain state, often negative."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall into",
                                "target_lang_sense_clarification": "To enter a state of disrepair or neglect."
                            },
                            {
                                "target_lang_word": "become",
                                "target_lang_sense_clarification": "To change into a state."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73bc07fd-d3d9-3d70-828f-74207ee6fb1c",
                    "sense_definition": "Достигать результата или вывода в процессе размышлений или действий.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученые <w>приходят</w> к важному выводу после долгих исследований.",
                            "target_lang_translations": {
                                "en": "Scientists <w>come to</w> an important conclusion after long research."
                            }
                        },
                        {
                            "text": "Мы <w>приходим</w> к согласию по всем спорным вопросам.",
                            "target_lang_translations": {
                                "en": "We <w>come to</w> an agreement on all controversial issues."
                            }
                        }
                    ],
                    "common_phrases": [
                        "приходить к выводу",
                        "приходить к согласию"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach a result or conclusion through thought or action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come to",
                                "target_lang_sense_clarification": "To reach a conclusion or agreement."
                            },
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "To arrive at a decision or conclusion."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}