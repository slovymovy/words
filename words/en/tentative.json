{
    "word_family": [
        "tentatively",
        "tentativeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "673291fe-a43b-3421-b862-a0b4ef5cbbbb",
                    "sense_definition": "Not fully worked out or certain; subject to future change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have a <w>tentative</w> plan for the weekend, but nothing is confirmed yet.",
                            "target_lang_translations": {
                                "ru": "У нас есть <w>предварительный</w> план на выходные, но пока ничего не подтверждено."
                            }
                        },
                        {
                            "text": "He gave a <w>tentative</w> answer because he was unsure of the final outcome.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>неопределённый</w> ответ, так как не был уверен в конечном исходе."
                            }
                        }
                    ],
                    "synonyms": [
                        "provisional",
                        "uncertain"
                    ],
                    "antonyms": [
                        "conclusive",
                        "definitive",
                        "certain"
                    ],
                    "common_phrases": [
                        "tentative plan",
                        "tentative agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не окончательный, предварительный или подлежащий изменению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительный",
                                "target_lang_sense_clarification": "не окончательный, подлежащий уточнению"
                            },
                            {
                                "target_lang_word": "ориентировочный",
                                "target_lang_sense_clarification": "примерный, примерный по времени или объёму"
                            },
                            {
                                "target_lang_word": "предположительный",
                                "target_lang_sense_clarification": "основанный на догадках, вероятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79e397c1-fcff-3b05-a268-2edaf9844ad0",
                    "sense_definition": "Showing hesitation or lack of confidence in one's actions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>tentative</w> steps showed her nervousness as she entered the room.",
                            "target_lang_translations": {
                                "ru": "Её <w>нерешительные</w> шаги выдавали волнение, когда она входила в комнату."
                            }
                        },
                        {
                            "text": "He made a <w>tentative</w> attempt to touch the cold water with his toe.",
                            "target_lang_translations": {
                                "ru": "Он предпринял <w>робкую</w> попытку коснуться холодной воды кончиком пальца."
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitant",
                        "cautious"
                    ],
                    "common_phrases": [
                        "tentative step",
                        "tentative smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий нерешительность, неуверенность или осторожность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерешительный",
                                "target_lang_sense_clarification": "неуверенный в действиях"
                            },
                            {
                                "target_lang_word": "робкий",
                                "target_lang_sense_clarification": "пугливый, осторожный"
                            },
                            {
                                "target_lang_word": "осторожный",
                                "target_lang_sense_clarification": "проявляющий осмотрительность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d9e7750-f529-32f1-9bd0-36a53edd1fad",
                    "sense_definition": "Relating to a trial or experimental process.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "experimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists conducted a <w>tentative</w> study to see if the theory held any merit.",
                            "target_lang_translations": {
                                "ru": "Учёные провели <w>пробное</w> исследование, чтобы выяснить, имеет ли теория под собой основания."
                            }
                        },
                        {
                            "text": "This was merely a <w>tentative</w> exploration of the new market before investing heavily.",
                            "target_lang_translations": {
                                "ru": "Это была лишь <w>пробная</w> разведка нового рынка перед крупными инвестициями."
                            }
                        }
                    ],
                    "synonyms": [
                        "experimental",
                        "exploratory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий пробой, экспериментом; пробный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробный",
                                "target_lang_sense_clarification": "проводимый в качестве проверки"
                            },
                            {
                                "target_lang_word": "экспериментальный",
                                "target_lang_sense_clarification": "направленный на опытное исследование"
                            },
                            {
                                "target_lang_word": "опытный",
                                "target_lang_sense_clarification": "служащий для испытаний"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64a89cd1-3960-3974-ad04-10ca0120a5a9",
                    "sense_definition": "A trial or an attempt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "experimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first <w>tentative</w> was unsuccessful, but they learned from their mistakes.",
                            "target_lang_translations": {
                                "ru": "Первая <w>попытка</w> оказалась неудачной, но они извлекли урок из своих ошибок."
                            }
                        },
                        {
                            "text": "Every new <w>tentative</w> brings us closer to the final solution.",
                            "target_lang_translations": {
                                "ru": "Каждая новая <w>попытка</w> приближает нас к окончательному решению."
                            }
                        }
                    ],
                    "synonyms": [
                        "attempt",
                        "trial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка или проба сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "старание что-то осуществить"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "испытание или опыт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9521e614-07bb-36b1-a071-fc70ccfc8cb4",
                    "sense_definition": "A preliminary schedule for an event or program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organizers released a <w>tentative</w> for the conference, subject to speaker availability.",
                            "target_lang_translations": {
                                "ru": "Организаторы опубликовали <w>предварительное расписание</w> конференции, которое зависит от занятости спикеров."
                            }
                        },
                        {
                            "text": "Please review the <w>tentative</w> and let us know if you have any conflicts.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ознакомьтесь с <w>проектом программы</w> и сообщите нам, если у вас возникнут нестыковки."
                            }
                        }
                    ],
                    "synonyms": [
                        "draft",
                        "schedule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предварительное расписание, черновой проект программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительное расписание",
                                "target_lang_sense_clarification": "неокончательный график мероприятий"
                            },
                            {
                                "target_lang_word": "черновик",
                                "target_lang_sense_clarification": "набросок или проект плана"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}