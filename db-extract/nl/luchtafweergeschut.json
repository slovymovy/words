                "senses": [
                    {
                        "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                        "entry_id": "c10593f6-9858-3788-8dbc-762d34753c79",
                        "glosses": [
                            "een onderdeel van de luchtverdediging en kan bestaan uit grootkaliber-machinegeweren tot snelvuurkanonnen bestemd voor het bestoken van vliegtuigen en andere luchtdoelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ae31aa-8402-4531-81ad-f9155e897d8f",
                                "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                                "text": "Meer dan 10.000 oorlogswapens, luchtafweergeschut, granaatwerpers, revolvers. Dat is de buit van een internationale politieactie tegen georganiseerde wapenhandel in Europa. De bende verkocht ook in ons land wapens."
                            },
                            {
                                "example_id": "11fefe0e-e8b6-45b4-a862-be7dcce51a19",
                                "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                                "text": "De tank-biatlon is het populairste onderdeel van de Army Games. Verder zijn er luchtbombardementen, luchtafweergeschut, een sluipschutterwedstrijd en competitie voor de beste veldkeuken."
                            },
                            {
                                "example_id": "1baab41f-a41a-48de-81ce-83e069842ea0",
                                "sense_id": "2f4bbf77-c54f-3ad5-8682-70015dd0215e",
                                "text": "Het kabinet wist niet dat er zwaar luchtafweergeschut in het oosten van Oekraïne was ten tijde van het neerhalen van vlucht MH17 op 17 juli vorig jaar. Dat zei minister Koenders van Buitenlandse Zaken (PvdA) gisteren tijdens een debat in de Kamer over de ramp. Volgens Koenders is tijdens een briefing van de Oekraïense minister van Buitenlandse Zaken voor bevriende landen, waaronder Nederland - drie dagen voor de ramp - alleen melding gemaakt over de mogelijke aanwezigheid van luchtafweer."
                            }
                        ]
                    }
