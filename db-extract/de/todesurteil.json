                "senses": [
                    {
                        "sense_id": "1b988b8d-b9b2-31be-a67f-8dce6160eb6e",
                        "entry_id": "652bc625-bfc7-3ff0-88bf-b63ab3b392bc",
                        "glosses": [
                            "Urteil eines Gerichts, das als Strafe die Tötung des Delinquenten beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f59970-69d1-4e09-9454-3e5368e1cc69",
                                "sense_id": "1b988b8d-b9b2-31be-a67f-8dce6160eb6e",
                                "text": "„Er hätte sein eigenes Todesurteil unterschrieben.“"
                            },
                            {
                                "example_id": "aa568442-0d5b-450b-9586-39a0fa2165c6",
                                "sense_id": "1b988b8d-b9b2-31be-a67f-8dce6160eb6e",
                                "text": "„Der Soldat nahm den Revolver an sich, einige Minuten später wurde das Todesurteil vollstreckt.“"
                            },
                            {
                                "example_id": "4cc152ab-71fa-4dc4-9da0-1ab99b340383",
                                "sense_id": "1b988b8d-b9b2-31be-a67f-8dce6160eb6e",
                                "text": "„Ich glaubte mich zu erinnern, daß vor kurzem ein neues Gesetz verabschiedet worden war, auf Grund dessen die Krone die Möglichkeit hatte, ein Todesurteil in eine Deportation in die Kolonien umzuwandeln.“"
                            },
                            {
                                "example_id": "59b5f665-3d63-47ff-88a9-574035a3a67a",
                                "sense_id": "1b988b8d-b9b2-31be-a67f-8dce6160eb6e",
                                "text": "„Ein Minister verkündet Lumumba das Todesurteil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09689e36-ff14-4cd4-bc33-2314418dc941",
                        "source_entry_id": "652bc625-bfc7-3ff0-88bf-b63ab3b392bc",
                        "source_sense_id": "1b988b8d-b9b2-31be-a67f-8dce6160eb6e",
                        "source_sense_description": "Recht: Urteil eines Gerichts, das als Strafe die Tötung des Delinquenten beinhaltet",
                        "target_lang_word": "death sentence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death sentence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35666a9f-9be4-33ee-a29a-59f25ecd15ba",
                                        "entry_id": "438e9ba4-0d3e-333c-8548-2d3e7671deb7",
                                        "glosses": [
                                            "A decree that someone be put to death as a punishment for a crime; a sentence of execution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58aff0be-485b-4d00-9d63-a086decc4a9b",
                                                "sense_id": "35666a9f-9be4-33ee-a29a-59f25ecd15ba",
                                                "text": "Tyrion’s tears contain the symbolic weight of his whole life; he wouldn’t be here if not for Jaime, as he admits, and his last hope is to give the man who risked everything to help him survive the same chance. Tyrion knows it’s a death sentence from Daenerys to betray her in this way, but he no longer cares."
                                            },
                                            {
                                                "example_id": "d5c9111b-6bd5-47aa-9a5b-d989cc41f946",
                                                "sense_id": "35666a9f-9be4-33ee-a29a-59f25ecd15ba",
                                                "text": "Comrades, here and now I pronounce the death sentence upon Snowball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc84a81-5cb0-3f0a-932c-8fb77cb2445d",
                                        "entry_id": "438e9ba4-0d3e-333c-8548-2d3e7671deb7",
                                        "glosses": [
                                            "Anything that spells death."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fde7093-8032-40ec-aafc-a7264881c5ff",
                                                "sense_id": "acc84a81-5cb0-3f0a-932c-8fb77cb2445d",
                                                "text": "Having the Huntington's gene is a death sentence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
