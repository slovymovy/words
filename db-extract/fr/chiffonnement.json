                "senses": [
                    {
                        "sense_id": "8f791784-1c4f-35b8-9d80-bdcb89580a3d",
                        "entry_id": "4e404236-ab95-3345-931e-b919536dd230",
                        "glosses": [
                            "Action de chiffonner ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73a13a7-0092-4061-9525-cc69c2f8c22d",
                                "sense_id": "8f791784-1c4f-35b8-9d80-bdcb89580a3d",
                                "text": "Celui-ci paraissait moins préoccupé de sa blessure que du chiffonnement de ses manchettes."
                            },
                            {
                                "example_id": "f0cbdfbe-60cc-446a-934f-e2986477a22e",
                                "sense_id": "8f791784-1c4f-35b8-9d80-bdcb89580a3d",
                                "text": "À ce moment, la porte du cabinet s’ouvrit et dans un chiffonnement de soie et de dentelles, dans un parfum violent de femme et de fleur, j’aperçus une chevelure rousse, une bouche rouge, l’éclair bleu de deux yeux adorablement ardents, une apparition éblouissante, miraculeuse de beauté, de jeunesse et d’amour, qui, à peine apparue, disparut en jetant ce cri : « Pardon ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c9e889d-5fb1-4b01-a9e2-066ac3f55044",
                        "source_entry_id": "4e404236-ab95-3345-931e-b919536dd230",
                        "source_sense_id": "8f791784-1c4f-35b8-9d80-bdcb89580a3d",
                        "target_lang_word": "crumpling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crumpling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf8c4a1-6975-3d98-ac40-c5c1abdf1d71",
                                        "entry_id": "65647e0b-a53c-3290-ae6d-a7f9c53c6f80",
                                        "glosses": [
                                            "The act by which something crumples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07c4cb7-5a6b-400a-b19e-e50f2e94fcc0",
                                                "sense_id": "bcf8c4a1-6975-3d98-ac40-c5c1abdf1d71",
                                                "text": "Watt saw the little movements of the stuff, the little bulgings and crumplings, and the sudden indrawings, where it was nipped, between forefinger and thumb probably, for those are the nippers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0415c16d-0bc9-342a-905a-738398be0f92",
                                        "entry_id": "65647e0b-a53c-3290-ae6d-a7f9c53c6f80",
                                        "glosses": [
                                            "A crumpled shape or structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36549167-23bf-4f26-820e-6bc387b87cdb",
                                                "sense_id": "0415c16d-0bc9-342a-905a-738398be0f92",
                                                "text": "When strata are so unsymmetrically and abundantly folded that it becomes difficult or impossible to trace out the individual flexures and crumplings — the whole forming an irregular complex of folds — they are said to be contorted […]"
                                            }
                                        ]
                                    }
                                ]
                            },
