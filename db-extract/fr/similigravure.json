                        "glosses": [
                            "Technique d’impression qui permet de reproduire un document fait de demi-teintes, qui convertit une gradation s’étalant du blanc au noir en valeurs de points de taille variable qui déterminent la quantité d’encre déposée et restituent la gradation de l’image une fois imprimée."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": []
                    },
