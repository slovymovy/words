                                        "entry_id": "fa1dabb6-b6d0-3c2b-8bea-cb44243cb234",
                                        "glosses": [
                                            "Carte européenne d’assurance maladie, document permettant à un ressortissant de l’Union européenne de bénéficier des soins dans un autre État membre que le sien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56fac76c-932c-4c3e-83aa-dcb6dd1c8fb4",
                                                "sense_id": "69a213b1-cfcb-38cf-ba8f-da475a6f3395",
                                                "text": "Les voyageurs en partance pour l’Europe glisseront dans leur portefeuille leur carte européenne d’assurance maladie (CEAM)."
                                            },
                                            {
                                                "example_id": "305ddad3-8a3f-434d-bcb7-7cdc74267fbb",
                                                "sense_id": "69a213b1-cfcb-38cf-ba8f-da475a6f3395",
                                                "text": "Vous vous demandez à quoi sert la carte européenne d’assurance maladie (CEAM) ?"
                                            },
                                            {
                                                "example_id": "bff49057-81f6-4523-bb51-ec5bbd2627d2",
                                                "sense_id": "69a213b1-cfcb-38cf-ba8f-da475a6f3395",
                                                "text": "La CEAM permet le remboursement des soins de santé en Europe, lors d’un voyage ou d’un court séjour en Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
