                                    },
                                    {
                                        "sense_id": "bc8a8570-48d8-37fc-bc8c-626343fcc52f",
                                        "entry_id": "dba26757-5d95-3aee-a711-9fb87868610b",
                                        "glosses": [
                                            "etwas schlecht machen, verderben"
