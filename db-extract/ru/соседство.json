                "translations": [
                    {
                        "translation_id": "970c118b-2b72-4046-8f4c-b35acd5dc760",
                        "source_entry_id": "2075daee-bc6b-3746-acc9-54eaa761c65d",
                        "target_lang_word": "neighbourhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neighbourhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                        "entry_id": "e2357106-d76c-35f3-b6dd-55d898a80e72",
                                        "glosses": [
                                            "British standard spelling of neighborhood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1283b55a-5964-4bbb-8cfc-6f259d22f2ca",
                                                "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                                "text": "These developments, most of which have taken place during the past 30 years, are remarkable in view of the low traffic density, except in the neighbourhood of Oslo, and the very extensive undeveloped areas of mountain and virgin forest."
                                            },
                                            {
                                                "example_id": "afad74d3-f7f2-4dec-b649-f8783b8dc689",
                                                "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                                "text": "Camden motive power depot has been much criticised for its emission of smoke in a residential neighbourhood and its complete dieselisation is rapidly taking place."
                                            },
                                            {
                                                "example_id": "35ad8f00-b812-4955-b812-a61db5d0bf8b",
                                                "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                                "text": "Another key event was the spontaneous mobilization of the Tiantongyuan neighbourhood in greater Beijing in 2008, which was an effort to modify the route plan of line no.5 of the Beijing subway system so that the neighbourhood could be more conveniently connected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2d8d247-a4a5-405f-9694-bb43fe9e33f8",
                        "source_entry_id": "2075daee-bc6b-3746-acc9-54eaa761c65d",
                        "target_lang_word": "vicinity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicinity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39bdbd91-ce82-373f-8311-f6ce57cdc476",
                                        "entry_id": "80fb55f8-30dc-38bd-89af-1b81f38ef947",
                                        "glosses": [
                                            "Proximity; the state of being near."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ebfe863-36f3-4dd0-81ff-23d7e22972e3",
                                                "sense_id": "39bdbd91-ce82-373f-8311-f6ce57cdc476",
                                                "text": "There was a crackling sound in the vicinity of my right ear."
                                            },
                                            {
                                                "example_id": "9e40a6c3-90f3-4c76-93da-057db5af349b",
                                                "sense_id": "39bdbd91-ce82-373f-8311-f6ce57cdc476",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9ade2d-c49d-3565-a38c-a65be35ff61b",
                                        "entry_id": "80fb55f8-30dc-38bd-89af-1b81f38ef947",
                                        "glosses": [
                                            "Neighbourhood; nearby region; surrounding area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b09e03-47de-4a6c-8e1e-d127393c3caf",
                                                "sense_id": "9f9ade2d-c49d-3565-a38c-a65be35ff61b",
                                                "text": "There is a hurricane in the vicinity of the Bahamas."
                                            },
                                            {
                                                "example_id": "9b0041dd-8e0e-46dd-b0a5-d0ffd0d50a0d",
                                                "sense_id": "9f9ade2d-c49d-3565-a38c-a65be35ff61b",
                                                "text": "O suitably-attired-in-leather-boots\nHead of a traveller, wherefore seeking whom\nWhence by what way how purposed art thou come\nTo this well-nightingaled vicinity?"
                                            },
                                            {
                                                "example_id": "303a8a92-120b-497a-bcb9-986d03e95ee8",
                                                "sense_id": "9f9ade2d-c49d-3565-a38c-a65be35ff61b",
                                                "text": "Al Jazeera's Scott Heidler, reporting from Bangkok, said hundreds of Yingluck's supporters gathered outside the Bangkok Supreme Court to await the verdict but were not allowed in the vicinity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0311ced7-9304-31c1-8fb6-a8bea4277602",
                                        "entry_id": "80fb55f8-30dc-38bd-89af-1b81f38ef947",
                                        "glosses": [
                                            "Approximate size or amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5cc9c4-73e4-4c1b-a0b0-fc1db92553c4",
                                                "sense_id": "0311ced7-9304-31c1-8fb6-a8bea4277602",
                                                "text": "I weigh in the vicinity of 80kg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cfb80bb-69a9-487f-a141-7283b5a46fbd",
                        "source_entry_id": "2075daee-bc6b-3746-acc9-54eaa761c65d",
                        "target_lang_word": "Nachbarschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachbarschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9defd525-f495-352b-84cb-94537e276aae",
                                        "entry_id": "47e3d4e0-653e-3ea4-a8e7-541cada73c02",
                                        "glosses": [
                                            "umliegender, zusammengehöriger Wohnbereich und dessen Bewohner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6823e2-69c8-4028-bc7b-6774f59c7d27",
                                                "sense_id": "9defd525-f495-352b-84cb-94537e276aae",
                                                "text": "Er ist ein Junge aus der Nachbarschaft."
                                            },
                                            {
                                                "example_id": "63f025df-3d59-41f6-9dd8-1073bddf2b47",
                                                "sense_id": "9defd525-f495-352b-84cb-94537e276aae",
                                                "text": "„In der Kurfürstenstraße steht ein Haus, das sich von den anderen Häusern in seiner Nachbarschaft deutlich unterscheidet.“"
                                            },
                                            {
                                                "example_id": "c3c5cfc9-2bb1-47d9-be22-65f1c55e4f10",
                                                "sense_id": "9defd525-f495-352b-84cb-94537e276aae",
                                                "text": "„Die ganze Nachbarschaft war auf den Beinen, um zu löschen und zu helfen, wo Hilfe nottat.“"
                                            },
                                            {
                                                "example_id": "65594954-ffbf-4482-8ca4-54f1091c0ceb",
                                                "sense_id": "9defd525-f495-352b-84cb-94537e276aae",
                                                "text": "„In der Nachbarschaft und überhaupt wußte man, daß Itta in diesem Leben schon ihr Maß an Leid ausgeschöpft hatte.“"
                                            },
                                            {
                                                "example_id": "dc35e122-cc4b-4490-9a46-da597005fbcb",
                                                "sense_id": "9defd525-f495-352b-84cb-94537e276aae",
                                                "text": "„Er hat eine nette, hilfsbereite Nachbarschaft, trifft sich seit vierzig Jahren mit seinen Freunden sonntags zum Frühschoppen und wurde als Vorstandsmitglied des Turnvereins zur großen Europa-Kreisel-Eröffnung sogar persönlich eingeladen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52d62c01-e7ab-3dc1-9f71-bd8e30b75338",
                                        "entry_id": "47e3d4e0-653e-3ea4-a8e7-541cada73c02",
                                        "glosses": [
                                            "das Wohnverhältnis mehrerer Bewohner des gleichen Gebiets zueinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae91cb6-c794-4e8c-897b-1f5d279f6309",
                                                "sense_id": "52d62c01-e7ab-3dc1-9f71-bd8e30b75338",
                                                "text": "Trinken wir auf gute Nachbarschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c11a8b6d-93e8-3621-9a08-f591e87b9c9a",
                                        "entry_id": "47e3d4e0-653e-3ea4-a8e7-541cada73c02",
                                        "glosses": [
                                            "(Entfernungsverhältnis) meist dauerhafte Nähe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91de186f-00d1-4e5a-97e9-aab16bd4cee9",
                                                "sense_id": "c11a8b6d-93e8-3621-9a08-f591e87b9c9a",
                                                "text": "Die Nachbarschaft des Mondes beeinflusst die Erde."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cd8fe819-7c02-3db8-a026-19dc7e481f08",
                                        "entry_id": "47e3d4e0-653e-3ea4-a8e7-541cada73c02",
                                        "glosses": [
                                            "(Semantik) eine enge Bedeutungsbeziehung mehrerer Begriffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094b79e1-bcfc-4efd-a556-289220d80b08",
                                                "sense_id": "cd8fe819-7c02-3db8-a026-19dc7e481f08",
                                                "text": "Das Verhältnis der Ähnlichkeit liegt also in der Nachbarschaft der Begriffe begründet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
