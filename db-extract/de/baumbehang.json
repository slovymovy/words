                "senses": [
                    {
                        "sense_id": "f50dd2f4-ca00-3a02-932b-4873c447bef3",
                        "entry_id": "6872ff92-a0f0-384a-a8af-60da56e5a021",
                        "glosses": [
                            "Schmuck zum Aufhängen für den Weihnachtsbaum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5aec9a5-3779-469f-a731-7bcdd8cb6814",
                                "sense_id": "f50dd2f4-ca00-3a02-932b-4873c447bef3",
                                "text": "Für das kommende Weihnachten haben wir bereits im Sommer neuen Baumbehang bestellt, da die alten Figuren nicht mehr ansehnlich waren."
                            },
                            {
                                "example_id": "830eff4e-aa4d-4b1c-a504-3a05c29dfc06",
                                "sense_id": "f50dd2f4-ca00-3a02-932b-4873c447bef3",
                                "text": "Außer einer Christbaumspitze und dekorativen Ketten aus Goldfolie wird der Weihnachtsbaum auch stets mit erzgebirgischem Baumbehang dekoriert."
                            },
                            {
                                "example_id": "a475bf9f-cabd-49b9-9efe-77534471ba49",
                                "sense_id": "f50dd2f4-ca00-3a02-932b-4873c447bef3",
                                "text": "Dieses Unternehmen stellt Baumbehänge in unterschiedlichen Designs her, um sowohl den traditionellen als auch den progressiven Weihnachtsfreund anzusprechen."
                            },
                            {
                                "example_id": "78d33b1b-e94d-41e6-be71-8cbf5d281fda",
                                "sense_id": "f50dd2f4-ca00-3a02-932b-4873c447bef3",
                                "text": "Herr Schöller kauft gern skurrile Baumbehänge wie zum Beispiel Plumpsklos oder Astronauten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
