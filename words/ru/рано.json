{
    "word_family": [
        "ранний",
        "рань",
        "рановато"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f3e2d9b2-d4e8-3873-90f6-54d6265a7320",
                    "sense_definition": "В начале какого-либо периода времени (утра, года, жизни и т. п.).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Станции метрополитена открываются <w>рано</w> утром.",
                            "target_lang_translations": {
                                "en": "Metro stations open <w>early</w> in the morning.",
                                "zh": "地铁站<w>早</w>上开门。"
                            }
                        },
                        {
                            "text": "Летом солнце встаёт очень <w>рано</w>.",
                            "target_lang_translations": {
                                "en": "In summer, the sun rises very <w>early</w>.",
                                "zh": "夏天太阳升起得非常<w>早</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в начале"
                    ],
                    "antonyms": [
                        "поздно"
                    ],
                    "common_phrases": [
                        "рано утром",
                        "очень рано",
                        "вставать рано"
                    ],
                    "target_lang_definitions": {
                        "en": "At the beginning of a certain period of time (morning, year, life, etc.).",
                        "zh": "在某一段时间（如早晨、一年、一生等）的开始阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "early",
                                "target_lang_sense_clarification": "at the start of a period"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "早",
                                "target_lang_sense_clarification": "指时间靠前"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c6e125-12da-3e33-82d3-a5c9e4878883",
                    "sense_definition": "Раньше установленного времени или срока; преждевременно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он пришёл на встречу слишком <w>рано</w>.",
                            "target_lang_translations": {
                                "en": "He arrived at the meeting too <w>early</w>.",
                                "zh": "他去开会去得<w>太早</w>了。"
                            }
                        },
                        {
                            "text": "Вчера было <w>рано</w>, а завтра будет поздно.",
                            "target_lang_translations": {
                                "en": "Yesterday was too <w>early</w>, and tomorrow will be too late.",
                                "zh": "昨天还<w>早</w>，明天就晚了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "преждевременно",
                        "раньше времени",
                        "досрочно",
                        "загодя"
                    ],
                    "antonyms": [
                        "поздно"
                    ],
                    "common_phrases": [
                        "слишком рано",
                        "ещё рано",
                        "рано или поздно"
                    ],
                    "target_lang_definitions": {
                        "en": "Before the established time or deadline; prematurely.",
                        "zh": "在预定时间或期限之前；过早。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "early",
                                "target_lang_sense_clarification": "before expected time"
                            },
                            {
                                "target_lang_word": "too soon",
                                "target_lang_sense_clarification": "prematurely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "早",
                                "target_lang_sense_clarification": "指时间提前"
                            },
                            {
                                "target_lang_word": "太早",
                                "target_lang_sense_clarification": "指过早，不合时宜"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}