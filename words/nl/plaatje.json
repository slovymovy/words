            "senses": [
                {
                    "sense_id": "41c55d5a-0f82-32e8-a075-af8a6ab0c906",
                    "sense_definition": "Een afbeelding of illustratie in een boek, tijdschrift of ander geschrift.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "afbeelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op sommige bladzijden van dit kinderboek staat er een mooi <w>plaatje</w>.",
                            "target_lang_translations": {
                                "en": "On some pages of this children's book, there is a beautiful <w>picture</w>.",
                                "ru": "На некоторых страницах этой детской книги есть красивая <w>картинка</w>.",
                                "de": "Auf einigen Seiten dieses Kinderbuchs gibt es ein schönes <w>Bild</w>."
                            }
                        },
                        {
                            "text": "Kijk naar het <w>plaatje</w> en vertel wat je daarop ziet.",
                            "target_lang_translations": {
                                "en": "Look at the <w>illustration</w> and tell me what you see there.",
                                "ru": "Посмотри на <w>картинку</w> и расскажи, что ты на ней видишь.",
                                "de": "Schau dir das <w>Bild</w> an und erzähle, was du darauf siehst."
                            }
                        }
                    ],
                    "synonyms": [
                        "afbeelding",
                        "illustratie",
                        "foto"
                    ],
                    "common_phrases": [
                        "mooi plaatje",
                        "plaatje bij de tekst"
                    ],
                    "target_lang_definitions": {
                        "en": "An image or illustration in a book, magazine, or other written work.",
                        "ru": "Изображение или иллюстрация в книге, журнале или другом печатном издании.",
                        "de": "Ein Bild oder eine Illustration in einem Buch, einer Zeitschrift oder einem anderen Schriftstück."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "picture",
                                "target_lang_sense_clarification": "a general visual representation"
                            },
                            {
