                        "entry_id": "c0a089f8-871d-3d5a-a05a-374f04a4dc5b",
                        "glosses": [
                            "Two days later: the day after the next day",
                            "Relative to a day implied by the context."
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "d3a83bc2-58bb-456a-84ca-64d39dd62399",
                                "sense_id": "8bdee944-5a64-3ef0-a980-907bd71101ca",
                                "text": "Ne remets jamais à demain ce que tu peux faire le surlendemain.",
                                "translation": "Never put off till tomorrow what you can do the day after tomorrow.",
                                "english": "Never put off till tomorrow what you can do the day after tomorrow."
                            }
                        ]
                    },
                    {
                        "sense_id": "544713bb-8fbe-3e84-8522-6bb3ed141f05",
                        "entry_id": "c0a089f8-871d-3d5a-a05a-374f04a4dc5b",
                        "glosses": [
                            "Two days later: the day after the next day",
                            "Relative to a day indicated explicitly, introduced with de."
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "274cf518-2b03-4373-b9b9-3ff08d9e08f3",
                                "sense_id": "544713bb-8fbe-3e84-8522-6bb3ed141f05",
                                "text": "Il n'arriva qu'au surlendemain de l'enterrement.",
                                "translation": "He didn't arrive until two days after the funeral.",
                                "english": "He didn't arrive until two days after the funeral."
                            }
                        ]
