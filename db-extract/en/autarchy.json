                                    {
                                        "sense_id": "1e712d6a-c6d6-39d7-9f0e-91e8fe632581",
                                        "entry_id": "81e5aecf-aab8-3abc-bd75-d24cd39e26ed",
                                        "glosses": [
                                            "Poder y control sobre uno mismo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4839fed5-01ea-4957-8763-4484c07ebecd",
                                                "sense_id": "1e712d6a-c6d6-39d7-9f0e-91e8fe632581",
                                                "text": "Con la desaparición de la polis y la aparición del individualismo, el hombre busca una autarquía, una norma de conducta personal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
