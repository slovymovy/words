            "senses": [
                {
                    "sense_id": "d5bcb11b-ad72-3fc6-888e-56589cd5f3d5",
                    "sense_definition": "Zrobić coś nowego, czego wcześniej nie było; powołać kogoś lub coś do istnienia",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creation_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znany artysta <w>stworzył</w> ten piękny obraz w zeszłym roku.",
                            "target_lang_translations": {
                                "ru": "Известный художник <w>создал</w> эту прекрасную картину в прошлом году.",
                                "en": "A famous artist <w>created</w> this beautiful painting last year."
                            }
                        },
                        {
                            "text": "Młodzi ludzie chcą <w>stworzyć</w> własną firmę i być niezależni.",
                            "target_lang_translations": {
                                "ru": "Молодые люди хотят <w>создать</w> собственную фирму и быть независимыми.",
                                "en": "Young people want to <w>start</w> their own business and be independent."
                            }
                        },
                        {
                            "text": "Nasza klasa <w>stworzyła</w> własną gazetkę szkolną.",
                            "target_lang_translations": {
                                "ru": "Наш класс <w>создал</w> свою школьную газету.",
                                "en": "Our class <w>created</w> its own school newspaper."
                            }
                        }
                    ],
                    "synonyms": [
                        "utworzyć",
                        "zbudować",
                        "wykreować",
                        "zrobić",
                        "powołać"
                    ],
                    "antonyms": [
                        "zniszczyć",
                        "zburzyć"
                    ],
                    "common_phrases": [
                        "stworzyć rodzinę",
                        "stworzyć dzieło",
                        "stworzyć świat",
                        "stworzyć system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-то новое, чего раньше не было; дать начало существованию кого-либо или чего-либо",
                        "en": "To make something new that did not exist before; to bring someone or something into existence."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создать",
                                "target_lang_sense_clarification": "сделать существующим, сконструировать"
                            },
                            {
