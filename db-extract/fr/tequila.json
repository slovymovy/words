                    },
                    {
                        "form_id": "520a12be-82bd-47da-8319-da98ba8514c5",
                        "entry_id": "7f7a7f64-ef6e-3530-b54d-839976d3f137",
                        "tags": [
                            "orthographe rectifiée de 1990",
                            "Moins courant"
                        ],
                        "form": "téquila"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                        "entry_id": "7f7a7f64-ef6e-3530-b54d-839976d3f137",
                        "glosses": [
                            "Eau-de-vie distillée à partir du jus produit par la plante agave bleu (Agave tequilana F.A.C.Weber var. azul). Spécialité mexicaine produite uniquement dans certaines régions déterminées par la réglementation du pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54938ce2-f5be-4160-b924-122b1dcce4f5",
                                "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                "text": "Le célèbre cocktail margarita est préparé avec de la tequila, du Cointreau, du jus de citron vert et du sel."
                            },
                            {
                                "example_id": "2cd1182d-489d-41a5-bc34-2e597982f7e3",
                                "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                "text": "A une table près des fenêtres, sur la gauche, trois types, des Mexicains sans doute, font un brin de causette devant un tequila."
                            },
                            {
                                "example_id": "abfa7cd1-b579-4951-a2cc-8fce3b600a60",
                                "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                "text": "En France, elle n’est considérée que depuis peu comme un alcool de qualité, ce qui est surement dû au fait que jusque dans les années 90, les seules tequilas importées étaient de mauvaise qualité et ne contenaient notamment pas d’agave bleu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce11c6fe-8a1f-4790-a44e-c580561b5e70",
                        "source_entry_id": "7f7a7f64-ef6e-3530-b54d-839976d3f137",
                        "source_sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                        "target_lang_word": "Tequila",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tequila",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                        "entry_id": "17ea64ef-843f-3858-8d58-a6e35203b9d0",
                                        "glosses": [
                                            "hochprozentiger Branntwein aus Mexiko, der aus Pulque (dem vergorenen Saft der Blauen Agave (Agave tequilana)) gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e655e251-38f2-4a7f-b89c-582eedf01d57",
                                                "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                                "text": "„Tequila ist aber auch gemein: Tut farblich so, als wäre es Wasser, wirkt aber vollkommen anders.“"
                                            },
                                            {
                                                "example_id": "1f5b97bf-ca6f-4f93-a758-cce4ce187a3b",
                                                "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                                "text": "„Ich durfte Herrn Kilmister von da an noch ein paar Tequila servieren, war aber ansonsten abgemeldet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tequila",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b955f76-22fe-31a3-b79e-577bcd94a9d2",
                                        "entry_id": "1e635df0-ca50-3b00-a9cb-ef8360ca25ef",
                                        "glosses": [
                                            "mexikanische Stadt im Bundesstaat Jalisco, die für die gleichnamige Spirituose bekannt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468cf00b-0eff-49bb-a188-aac9f3376faf",
                                                "sense_id": "6b955f76-22fe-31a3-b79e-577bcd94a9d2",
                                                "text": "In unserem Mexiko-Urlaub besuchten wir auch Tequila."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
