                        "entry_id": "d1cc7a49-2fb3-3253-a303-3c8735d13bcd",
                        "glosses": [
                            "A Japanese dish made by deep-frying vegetables, seafood, or other foods in a light batter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f77cc2-aad2-4b03-9bae-ad4cbd69a874",
                                "sense_id": "4b2e47e1-a347-35ff-b900-52c56b369417",
                                "text": "The Chicken Big Mac is similar to its beefy sibling; however, it replaces the two burgers with two tempura chicken patties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d3b367c-8f56-44b5-bf33-ef2e994f21b9",
