                ],
                "senses": [
                    {
                        "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                        "entry_id": "b289e45c-1948-3f9c-b506-f08124726f8c",
                        "glosses": [
                            "Gremium bestehend aus einer Gruppe von Personen aus einem Parlament, das das Verteidigungsministerium und die Ausgaben für das Militär kontrolliert sowie weitere Fragen rund um das Militär (beispielsweise eine Wehrpflicht) klärt; sehr oft mit Bezug auf parlamentarische Gremien der USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9888b2cc-91a8-4696-973f-6e6b77964863",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Im Streitkräfteausschuss des Senats musste am Dienstag“ […] „der Nationale Geheimdienstdirektor Dan Coats Rede und Antwort stehen.“"
                            },
                            {
                                "example_id": "44aed1b9-5511-4306-a42e-1233bb21ffca",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Thornberry ist Vorsitzender des Streitkräfteausschusses im Repräsentantenhaus.“"
                            },
                            {
                                "example_id": "cb50d4ba-1b28-405c-a359-df9407e2f217",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "Die Demokratische Partei der USA will offenbar doch weitere Mittel für den Irak-Krieg bewilligen. Dies deutete der Vorsitzende des Streitkräfteausschusses Carl Levin vergangenen Sonntag an."
                            },
                            {
                                "example_id": "9a580735-43df-4785-956a-a25e603a2620",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Immer wieder musste der Vorsitzende des Streitkräfteausschusses, der Demokrat Carl Levin, einzelne Aktivisten der pazifistischen Gruppe „Code Pink“ bei der Anhörung zum Vorgehen gegen die IS-Miliz aus dem Saal führen lassen.“"
                            },
                            {
                                "example_id": "16aa002f-b763-4882-b19d-20bd66b12c45",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„US-Verteidigungsminister James Mattis verteidigte im Streitkräfteausschuss des Repräsentantenhauses die geplante Entwicklung von zwei neuen kleineren Atomwaffen.“"
                            },
                            {
                                "example_id": "fbd84dd5-a148-4a77-a0a9-6d338824d2e4",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Als Taguba Anfang der Woche vor dem Streitkräfteausschuss des Senats erschien, führte er die Misshandlungen auf Versagen der Militärführung zurück, vom Brigadekommandeur abwärts, auf Mangel an Disziplin sowie Fehlen jeglicher Ausbildung und Überwachung.“"
                            },
                            {
                                "example_id": "e8a5a129-bc46-4b27-8630-0d2f6859525f",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Als er vier Jahre nach seinem Ausscheiden aus dem Militärdienst in das Verteidigungsministerium zurückgekehrt sei, habe ihn der geringe Grad der Einsatzbereitschaft der Truppe schockiert, sagte der ehemalige General vor dem Streitkräfteausschuss des US-Repräsentantenhauses.“"
                            },
                            {
                                "example_id": "6d4d9f43-cc67-4e35-b42b-94715fdd99f1",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "Verteidigungsminister Carter erklärte auf einer Anhörung des Streitkräfteausschusses im Senat, die Rückeroberung Ramadis und Raqqas aus den Händen des IS habe jetzt Vorrang: „The changes we're pursuing can be described by what I call the three „R´s“ : Raqqa (dt. Rakka, Anm. d. Red.), Ramadi, and raids.“"
                            },
                            {
                                "example_id": "562f218f-7a26-4bf3-b972-29630ff1e394",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Pat Roberts, republikanischer Abgeordneter und Mitglied im Streitkräfteausschuss des US-Senats erklärt: »Ja, gegenwärtig ist dies unser nationales Interesse. Und die Frage, von wo uns die größte Gefahr droht, hat Priorität.«“"
                            },
                            {
                                "example_id": "e64f7801-41ca-4285-97af-c37bf7bd4cd4",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "„Senator Jim Inhofe, der ranghöchste Republikaner im Streitkräfteausschuss des Senats, sagte, die Maßnahme werde letztlich verabschiedet.“"
                            },
                            {
                                "example_id": "21ddf532-f4fd-48e1-841a-519c3dff57fb",
                                "sense_id": "2366634c-ac20-3c73-81a1-0d11c91f6d1d",
                                "text": "[Russische Hyperschallraketen:] „«Wir haben keine Verteidigung, die den Einsatz einer solchen Waffe gegen uns verhindern könnte», betonte John Hyten, Befehlshaber des Strategischen Kommandos der USA, bereits Ende März im Streitkräfteausschuss des US-Senats.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
