                    "sense_definition": "iemand iets doen geloven wat niet waar is, vaak door misleiding of zelfbedrog",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misleiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze hadden hem <w>wijsgemaakt</w> dat het allemaal per ongeluk gebeurd was.",
                            "target_lang_translations": {
                                "en": "They had <w>made</w> him <w>believe</w> that it had all happened by accident."
                            }
                        },
                        {
                            "text": "Je moet jezelf niet <w>wijsmaken</w> dat dit probleem vanzelf zal verdwijnen.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>delude</w> yourself that this problem will disappear on its own."
                            }
                        }
                    ],
