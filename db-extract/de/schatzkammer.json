                        ]
                    },
                    {
                        "translation_id": "ae0d4c98-04d3-41bd-aed0-006b0bcd0eeb",
                        "source_entry_id": "4fdef538-4164-3430-81bb-7b3e20bc36b8",
                        "target_lang_word": "salle du trésor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1f76d30a-f4c8-4077-8614-6e929d6c0120",
                        "source_entry_id": "4fdef538-4164-3430-81bb-7b3e20bc36b8",
                        "target_lang_word": "trésor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trésor",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5317bd8f-2c62-300d-8021-6e07e2b7b70d",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Amas d’or, d’argent, ou d’autres choses précieuses mises en réserve, cachées, enfouies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb63ea8c-a895-4d99-8c0d-c44f1849e120",
                                                "sense_id": "5317bd8f-2c62-300d-8021-6e07e2b7b70d",
                                                "text": "Âmes de boue! qui n'estimez que l'or, je ne veux point toucher à vos trésors, quelque impure qu'en soit la source."
                                            },
                                            {
                                                "example_id": "7ae4bdc3-fdca-4857-8cce-233738412105",
                                                "sense_id": "5317bd8f-2c62-300d-8021-6e07e2b7b70d",
                                                "text": "J’y cueille des fruits merveilleux que ne paierait point un trésor, et contre tout l’or de la terre je ne voudrais les échanger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d2e88e-da75-3bdf-a11a-228faa48b68c",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Lieu où le trésor est enfermé, comme dans les églises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cccbaa8-6d7a-4947-982b-a0a40b0bc76f",
                                                "sense_id": "d9d2e88e-da75-3bdf-a11a-228faa48b68c",
                                                "text": "Rosenbourg a cessé d’être habité : on en a fait le trésor historique des rois danois ; il renferme tous les objets précieux dont ils se sont servis."
                                            },
                                            {
                                                "example_id": "3bb6823f-f8ff-477f-a111-2f1a4826870f",
                                                "sense_id": "d9d2e88e-da75-3bdf-a11a-228faa48b68c",
                                                "text": "Ces sacraires sont munis d’armoires doubles, fortement ferrées […]. Ils servaient de trésors, car il était l’usage de placer, des deux côtés du maître autel des églises abbatiales ou cathédrales, des armoires destinées à renfermer les vases sacrés, les reliquaires et tous les objets précieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7cff98-f90f-3af7-8c3c-045d72befdd1",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Ces mêmes reliques et ornements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d04a90a-62c8-49e3-a3cc-7179dbcf9c19",
                                                "sense_id": "dd7cff98-f90f-3af7-8c3c-045d72befdd1",
                                                "text": "Le trésor de Reims. Le trésor de Chartres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c37c3f68-d68c-361e-b111-dfc23e95b951",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Ensemble des archives, titres, papiers d’une seigneurie, d’une communauté."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32efd475-ed6f-4686-a43d-e739a14d463b",
                                                "sense_id": "c37c3f68-d68c-361e-b111-dfc23e95b951",
                                                "text": "Le trésor des chartes des rois de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da77289-ae9e-3b89-8c51-35a1ba2a9e43",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Ensemble des ressources de l’État, des sommes destinées au service public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aab6b36-ce44-42f7-86e3-9aed1cecc8ef",
                                                "sense_id": "2da77289-ae9e-3b89-8c51-35a1ba2a9e43",
                                                "text": "Il se vit entouré d’individus qui trompèrent sa confiance, et ne cherchèrent, […], qu’à exploiter le trésor public à leur profit."
                                            },
                                            {
                                                "example_id": "8a49acda-fcc1-45a5-b152-d88d12d5a4b9",
                                                "sense_id": "2da77289-ae9e-3b89-8c51-35a1ba2a9e43",
                                                "text": "Son prestige religieux est compromis. Son trésor est vide. Son armée, […], est réduite à fort peu de chose par les licenciements forcés et les désertions."
                                            },
                                            {
                                                "example_id": "4b8309ad-a470-40ef-a8c6-9ea6b01108e5",
                                                "sense_id": "2da77289-ae9e-3b89-8c51-35a1ba2a9e43",
                                                "text": "A la mort d'un autre Gradis, l'intendant prétendit confisquer les biens du défunt au profit du Trésor, en vertu du droit d'aubaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834a7f2e-0f3f-3c78-ba3d-826cef9ac2f9",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Administration chargée de gérer ces ressources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e99491f-20d6-4b24-bfc0-1816dc468ab5",
                                                "sense_id": "834a7f2e-0f3f-3c78-ba3d-826cef9ac2f9",
                                                "text": "Son adjonction au ministre, avec le titre de directeur-général du trésor, fut accueillie comme une bonne nouvelle dans toutes les places de commerce du continent, …."
                                            },
                                            {
                                                "example_id": "9e8dab77-69ca-4bf1-9066-76d989fa55d2",
                                                "sense_id": "834a7f2e-0f3f-3c78-ba3d-826cef9ac2f9",
                                                "text": "Il est plus que certain que des transactions sont intervenues entre les deux parties, au grand dam du Trésor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1067028e-579f-3c15-8c87-8bd9b035ea2e",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Ce qui est d’une excellence, d’une utilité singulière."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ff1f352-a048-41b8-b41d-1c18711c0668",
                                                "sense_id": "1067028e-579f-3c15-8c87-8bd9b035ea2e",
                                                "text": "Un véritable ami est un grand trésor."
                                            },
                                            {
                                                "example_id": "e2a624ec-e0bf-4fd7-bf3f-5473b2d6285d",
                                                "sense_id": "1067028e-579f-3c15-8c87-8bd9b035ea2e",
                                                "text": "Un bon domestique est un trésor dans une maison."
                                            },
                                            {
                                                "example_id": "0f7bf4d9-0c87-4f01-9b2e-946bbf42b913",
                                                "sense_id": "1067028e-579f-3c15-8c87-8bd9b035ea2e",
                                                "text": "Les trésors d’érudition que cet ouvrage renferme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c37343-d742-3ae7-b9b6-0c582b2e2080",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Grands recueils d’érudition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd9ebaf-d31d-46cc-86d2-8f0c9391dcd6",
                                                "sense_id": "f1c37343-d742-3ae7-b9b6-0c582b2e2080",
                                                "text": "Le trésor de la Langue grecque, d’Henri Estienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e781bb5-d9d4-3e5c-960c-c4e2471c478b",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Êtres et choses pour lesquelles on a un grand attachement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8174bdd6-7649-4e24-bc8e-a99e2b9cdb92",
                                                "sense_id": "2e781bb5-d9d4-3e5c-960c-c4e2471c478b",
                                                "text": "Cet enfant est son trésor."
                                            },
                                            {
                                                "example_id": "4968ac90-810d-41d7-b049-42493c8874e4",
                                                "sense_id": "2e781bb5-d9d4-3e5c-960c-c4e2471c478b",
                                                "text": "Tu viens, trésor ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff597e42-a2b7-3599-b982-6d59eb8b78cc",
                                        "entry_id": "b3bfaa77-4273-3374-9e9b-61519ee40f6d",
                                        "glosses": [
                                            "Grandes richesses."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c8683e-7f34-44e6-adf8-99795e3db0eb",
                                                "sense_id": "ff597e42-a2b7-3599-b982-6d59eb8b78cc",
                                                "text": "Les trésors de Crésus sont passés en proverbe. Ces mines recèlent des trésors. Il a amassé des trésors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a19e693b-7c7c-496e-9dca-7fca0805e79a",
                        "source_entry_id": "4fdef538-4164-3430-81bb-7b3e20bc36b8",
                        "target_lang_word": "trésorerie",
