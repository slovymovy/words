                "senses": [
                    {
                        "sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                        "entry_id": "6dcd3dcd-1cc9-34f9-b721-1085bdc3aea2",
                        "glosses": [
                            "Person, die immer wieder Kleinigkeiten viel bedeutungsvoller/schlimmer darstellt, als sie sind (dramatisiert), um damit im Zentrum der Aufmerksamkeit zu stehen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b9a5cdfa-66ea-4c21-a46f-a23a31353dec",
                                "sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                                "text": "„Nehmen wir Lady Gaga als Beispiel, die sich im letzten Jahr mit ‚Fame‘ ein schwarzes Unisex-Eau-de-Parfum kreieren ließ, dessen Flakon aussieht, als halte eine goldene Alien-Kralle eine schwarze Perle. Darunter macht es die weltgrößte Dramaqueen nicht.“"
                            },
                            {
                                "example_id": "8e9617a3-a6d1-41d8-bd42-1d73247810b1",
                                "sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                                "text": "„Ich sei zu empfindlich, eine Dramaqueen, die ständig in die Luft gehe.“"
                            },
                            {
                                "example_id": "22d88395-bad6-4756-8636-ac93efa14f39",
                                "sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                                "text": "„Anders als DVF, die Erfinderin des Wickelkleides, ist die glamouröse Dramaqueen Donatella Versace stets perfekt gestylt.“"
                            },
                            {
                                "example_id": "c4cf4acd-1e65-4361-921b-fb4a740b96d9",
                                "sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                                "text": "„Bevor er die Fragen beantwortete, verglich er Scheraks Auftreten mit einer ‚Dramaqueen‘ und riet ihm, gemeinsam mit dem aus dem Parlament scheidenden Neos-Gründer Matthias Strolz ‚Bäume umarmen‘ zu gehen […].“"
                            },
                            {
                                "example_id": "862c907c-d010-4d80-bd5b-791b996fe105",
                                "sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                                "text": "„Nach ihrem Auftritt in der Kneipe hielten sie die anderen nun wahrscheinlich für die reinste Dramaqueen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8978b17c-1b40-4ef8-9d19-1dcd606d21e2",
                        "source_entry_id": "6dcd3dcd-1cc9-34f9-b721-1085bdc3aea2",
                        "source_sense_id": "eb9133e3-9e9f-3732-984b-323799345c20",
                        "source_sense_description": "Person, die immer wieder Kleinigkeiten viel bedeutungsvoller/schlimmer darstellt, als sie sind",
                        "target_lang_word": "drama queen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drama queen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "966bc16f-c3aa-3895-ae83-af67dacc8d8d",
                                        "entry_id": "28ddef8d-158e-3fe4-951e-a2e57df0b516",
                                        "glosses": [
                                            "An overly or exaggeratedly dramatic person, especially a woman or a girl."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb933c10-2734-4fa3-b102-bfaa82134a99",
                                                "sense_id": "966bc16f-c3aa-3895-ae83-af67dacc8d8d",
                                                "text": "If he is thwarted in his effort to enjoy them, he may either go to the dogs or the drama queens, become short-tempered, sullen, grouchy and eventually feel that, in a way he is a failure."
                                            },
                                            {
                                                "example_id": "15889b80-b100-4e70-ad30-64e72e4def01",
                                                "sense_id": "966bc16f-c3aa-3895-ae83-af67dacc8d8d",
                                                "text": "I’ve known quite a few drama queens in my time, and I always have the same thought: She reminds me of junior high. Most girls are drama queens at that age."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drama queen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "681b39cd-6d3a-31a2-b032-9f2f9ffe6306",
                                        "entry_id": "967a012a-15df-34d3-887d-b1c0d22fadb3",
                                        "glosses": [
                                            "To behave in an exaggerately dramatic fashion."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9217b6b3-9caf-4190-aa4d-5de6c21f7cdf",
                                                "sense_id": "681b39cd-6d3a-31a2-b032-9f2f9ffe6306",
                                                "text": "Stop the drama queening. Stop the pity parties. You've maxed out. Look, we all have trouble in our lives but most of us aren't hanging our dirty laundry out there for the whole world to see."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
