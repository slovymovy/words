                "senses": [
                    {
                        "sense_id": "add7144d-634e-307b-94bf-8461b9d3ffa9",
                        "entry_id": "c592063a-4479-3302-ada3-b4fe1f477eda",
                        "glosses": [
                            "het leeg en verlaten zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e7aaf7-a4fd-49fa-8f39-37073ca364eb",
                                "sense_id": "add7144d-634e-307b-94bf-8461b9d3ffa9",
                                "text": "De Vallei van Verlatenheid bij Graaff-Reinet is vooral indrukwekkend door het enorme gevoel van leegte die men er ervaart."
                            },
                            {
                                "example_id": "94b7930a-36fc-41e4-855d-bd17756156a9",
                                "sense_id": "add7144d-634e-307b-94bf-8461b9d3ffa9",
                                "text": "De beelden van de moordende Paul hadden haar naar de emotionele afgrond gedreven, waar ze net als tante Annie in de leegte van de dood was gesprongen."
                            },
                            {
                                "example_id": "5d53fd62-a810-485f-a5b1-7f70ba48eb33",
                                "sense_id": "add7144d-634e-307b-94bf-8461b9d3ffa9",
                                "text": "De beelden van de moordende Paul hadden haar naar de emotionele afgrond gedreven, waar ze net als tante Annie in de leegte van de dood was gesprongen."
                            },
                            {
                                "example_id": "4cba3a3a-7c01-4d35-93f0-0268b6c20ad4",
                                "sense_id": "add7144d-634e-307b-94bf-8461b9d3ffa9",
                                "text": "Zou zij dezelfde leegte voelen die ik nu ook voelde? Ik gaf de telefoon terug aan de barman, rekende af en liet de rest van mijn lunch staan."
                            }
                        ]
                    }
