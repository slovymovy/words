    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edc72730-3ab2-3f15-a04f-e32a8a7fb802",
                    "sense_definition": "to protect from danger, attack, or injury; to keep something or someone safe",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were ordered to <w>guard</w> the entrance to the palace at all times.",
                            "target_lang_translations": {
                                "ru": "Солдатам было приказано постоянно <w>охранять</w> вход во дворец."
                            }
                        },
                        {
                            "text": "It is important to <w>guard</w> your privacy when using social media.",
                            "target_lang_translations": {
                                "ru": "Важно <w>беречь</w> свою конфиденциальность при использовании социальных сетей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guard the entrance",
                        "guard your privacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "защищать от опасности, нападения или травм; обеспечивать безопасность чего-либо или кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "защищать от нападения или посягательств"
                            },
                            {
                                "target_lang_word": "беречь",
                                "target_lang_sense_clarification": "хранить в целости и сохранности"
                            },
                            {
                                "target_lang_word": "защищать",
                                "target_lang_sense_clarification": "обеспечивать безопасность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14d835d8-2ca7-3dec-aa6b-0b9d9d85ed17",
                    "sense_definition": "to watch over someone to prevent them from escaping or to control their actions",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "supervision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two officers were assigned to <w>guard</w> the prisoner during the trial.",
                            "target_lang_translations": {
                                "ru": "Двум офицерам было поручено <w>сторожить</w> заключенного во время суда."
                            }
                        },
                        {
                            "text": "The police had to <w>guard</w> the suspect until the transport arrived.",
                            "target_lang_translations": {
                                "ru": "Полиции пришлось <w>караулить</w> подозреваемого до прибытия транспорта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guard the prisoner"
                    ],
                    "target_lang_definitions": {
                        "ru": "следить за кем-либо, чтобы предотвратить побег или контролировать действия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "караулить",
                                "target_lang_sense_clarification": "нести дежурство, охраняя кого-либо"
                            },
                            {
                                "target_lang_word": "сторожить",
                                "target_lang_sense_clarification": "не давать уйти или убежать"
                            },
                            {
                                "target_lang_word": "конвоировать",
                                "target_lang_sense_clarification": "сопровождать под охраной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94a47b8f-96a0-3370-8e07-f01e8c6d64f2",
                    "sense_definition": "to be cautious or take precautions to prevent something bad from happening",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>guard</w> against infection by washing your hands regularly.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>предостерегаться</w> от инфекции, регулярно моя руки."
                            }
                        },
                        {
                            "text": "The company needs to <w>guard</w> against potential financial losses this year.",
                            "target_lang_translations": {
                                "ru": "Компании необходимо <w>остерегаться</w> потенциальных финансовых потерь в этом году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guard against infection",
                        "guard against mistakes"
                    ],
                    "target_lang_definitions": {
                        "ru": "быть осторожным или принимать меры предосторожности, чтобы предотвратить что-то плохое"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предостерегаться",
                                "target_lang_sense_clarification": "принимать меры против чего-либо"
                            },
                            {
                                "target_lang_word": "остерегаться",
                                "target_lang_sense_clarification": "быть осторожным в отношении чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                    "sense_definition": "a person whose job is to protect a place or person, or a device that provides protection",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protector",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security <w>guard</w> checked my identification before letting me into the building.",
                            "target_lang_translations": {
                                "ru": "<w>Охранник</w> проверил мое удостоверение личности, прежде чем впустить меня в здание."
                            }
                        },
                        {
                            "text": "He works as a prison <w>guard</w> at the local correctional facility.",
                            "target_lang_translations": {
                                "ru": "Он работает тюремным <w>надзирателем</w> в местном исправительном учреждении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "security guard",
                        "prison guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, чья работа заключается в защите места или человека, или устройство, обеспечивающее защиту"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охранник",
                                "target_lang_sense_clarification": "лицо, следящее за порядком и безопасностью"
                            },
                            {
                                "target_lang_word": "сторож",
                                "target_lang_sense_clarification": "лицо, охраняющее имущество"
                            },
                            {
                                "target_lang_word": "страж",
                                "target_lang_sense_clarification": "тот, кто осуществляет охрану (часто в переносном смысле)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ced73cb-0aab-3cf0-bf4f-fb7e368f3fda",
                    "sense_definition": "a state of being watchful and ready for possible danger or difficulties",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the scandal caught the politician with his <w>guard</w> down.",
                            "target_lang_translations": {
                                "ru": "Новости о скандале застали политика врасплох, когда его <w>бдительность</w> была ослаблена."
                            }
                        },
                        {
                            "text": "You should keep your <w>guard</w> up when dealing with people you do not trust.",
                            "target_lang_translations": {
                                "ru": "Вам следует сохранять <w>настороженность</w> при общении с людьми, которым вы не доверяете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep your guard up",
                        "catch off guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "состояние бдительности и готовности к возможной опасности или трудностям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительность",
                                "target_lang_sense_clarification": "состояние готовности к опасности"
                            },
                            {
                                "target_lang_word": "настороженность",
                                "target_lang_sense_clarification": "состояние ожидания подвоха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f24be898-5b39-3056-8972-d4e5c9b8aa76",
                    "sense_definition": "a group or squad of people responsible for protecting someone or something",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president was welcomed by a <w>guard</w> of honour at the airport.",
                            "target_lang_translations": {
                                "ru": "В аэропорту президента приветствовал почетный <w>караул</w>."
                            }
                        },
                        {
                            "text": "The royal <w>guard</w> stands outside the palace gates every day.",
                            "target_lang_translations": {
                                "ru": "Королевская <w>гвардия</w> стоит у ворот дворца каждый день."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guard of honour",
                        "royal guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "группа или отряд людей, ответственных за защиту кого-либо или чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гвардия",
                                "target_lang_sense_clarification": "отборная часть войск или почетная охрана"
                            },
                            {
                                "target_lang_word": "караул",
                                "target_lang_sense_clarification": "вооруженное подразделение для охраны"
                            },
                            {
                                "target_lang_word": "стража",
                                "target_lang_sense_clarification": "группа людей, несущих охрану"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5cef6f2-9ae4-3b9d-bcf7-6a8e8cf6c66d",
                    "sense_definition": "a piece of equipment worn to protect a specific part of the body from injury",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soccer player adjusted his shin <w>guard</w> before the match started.",
                            "target_lang_translations": {
                                "ru": "Футболист поправил <w>щиток</w> на голени перед началом матча."
                            }
                        },
                        {
                            "text": "You should wear a mouth <w>guard</w> when playing contact sports.",
                            "target_lang_translations": {
                                "ru": "Вам следует носить <w>капу</w> при занятиях контактными видами спорта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shin guard",
                        "mouth guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "элемент экипировки, надеваемый для защиты определенной части тела от травм"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щиток",
                                "target_lang_sense_clarification": "защита голени в спорте"
                            },
                            {
                                "target_lang_word": "капа",
                                "target_lang_sense_clarification": "защита зубов (mouth guard)"
                            },
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "общее название для предохранительных элементов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe6052b3-a9d0-3d49-a5aa-82d57b09f28b",
                    "sense_definition": "a player position in sports like basketball or American football",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The point <w>guard</w> passed the ball to the center for a layup.",
                            "target_lang_translations": {
                                "ru": "Разыгрывающий <w>защитник</w> отдал пас центровому для броска из-под кольца."
                            }
                        },
                        {
                            "text": "He plays as an offensive <w>guard</w> for his college football team.",
                            "target_lang_translations": {
                                "ru": "Он играет на позиции атакующего <w>гарда</w> за свою футбольную команду колледжа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "point guard",
                        "offensive guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "позиция игрока в таких видах спорта, как баскетбол или американский футбол"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защитник",
                                "target_lang_sense_clarification": "позиция игрока в командных видах спорта"
                            },
                            {
                                "target_lang_word": "гард",
                                "target_lang_sense_clarification": "специфический спортивный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f701235-1c14-39f5-8b53-6f0e7453efaa",
                    "sense_definition": "a protective covering on a machine to prevent accidents",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Never operate the saw without the safety <w>guard</w> in place.",
                            "target_lang_translations": {
                                "ru": "Никогда не работайте с пилой без установленного защитного <w>кожуха</w>."
                            }
                        },
                        {
                            "text": "The mechanic had to remove the chain <w>guard</w> to fix the bike.",
                            "target_lang_translations": {
                                "ru": "Механику пришлось снять <w>защиту</w> цепи, чтобы починить велосипед."
                            }
                        }
                    ],
                    "synonyms": [
                        "protection"
                    ],
                    "common_phrases": [
                        "safety guard",
                        "chain guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "защитное покрытие на станке или машине для предотвращения несчастных случаев"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кожух",
                                "target_lang_sense_clarification": "жесткая наружная оболочка для безопасности"
                            },
                            {
                                "target_lang_word": "предохранитель",
                                "target_lang_sense_clarification": "устройство для предотвращения поломок или травм"
                            },
                            {
                                "target_lang_word": "ограждение",
                                "target_lang_sense_clarification": "защитный барьер на оборудовании"
                            }
                        ]
