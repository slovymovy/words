                    {
                        "sense_id": "deb3aebb-1c6e-3357-8c54-3d3fb63efb53",
                        "entry_id": "7070e846-59d3-3989-8be4-108efc16b898",
                        "glosses": [
                            "mit Deckel verschließbares Behältnis aus Metall zur Mitnahme von Speisen an den Arbeitsplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f4a7e0-0472-4601-be94-21b65cb64495",
                                "sense_id": "deb3aebb-1c6e-3357-8c54-3d3fb63efb53",
                                "text": "„Hanni brachte Hühnersuppe in einem Henkelmann.“"
                            },
                            {
                                "example_id": "44c4f90f-68c4-466b-9686-6f707993339c",
                                "sense_id": "deb3aebb-1c6e-3357-8c54-3d3fb63efb53",
                                "text": "„Sie sahen mich schon mit Stullen und Henkelmann im Morgengrauen losziehen, eine Kußhand zu Maries Zimmer hinaufwerfen, sahen mich abends ›müde, aber befriedigt‹ heimkehren, Zeitung lesen und Marie beim Stricken zuschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
