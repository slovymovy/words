                        "glosses": [
                            "een sieraad dat wordt opgespeld om kleding te versieren, meestal door vrouwen gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f2d6f9-0cba-404d-a3c7-3bc16dbbaee7",
                                "sense_id": "e7606a44-31b0-368f-aabd-728dc3224331",
                                "text": "Ze werd beschuldigd van diefstal van een kostbare sierspeld van haar mevrouw."
                            },
                            {
                                "example_id": "6794ddb8-cf1a-491a-abc4-ebacacce37e5",
                                "sense_id": "e7606a44-31b0-368f-aabd-728dc3224331",
                                "text": "De vrouw bezocht maandag een filiaal in Toulouse om een sierspeld voor de hoed te kopen. De bewaker eiste dat zij hem afzette, ook nadat ze had laten zien dat ze geen haar meer had. Vernederd en in tranen verliet ze de winkel."
                            }
                        ]
