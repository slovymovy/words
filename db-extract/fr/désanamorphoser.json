                "senses": [
                    {
                        "sense_id": "4958655e-8a12-37a5-8ad3-6d963568a11c",
                        "entry_id": "fdefe317-06cc-3fba-8b19-71e9b206a8dd",
                        "glosses": [
                            "Faire revenir à l’état d’origine quelque chose qui avait été anamorphosé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e96fe21-08c9-4ec4-9f87-8c39fd369211",
                                "sense_id": "4958655e-8a12-37a5-8ad3-6d963568a11c",
                                "text": "Pour obtenir le rendu Scope auquel nous sommes habitués en salle, il faut désanamorphoser l’image."
                            },
                            {
                                "example_id": "7ab3d0bc-11bf-42d1-b36b-bd3e7e351dff",
                                "sense_id": "4958655e-8a12-37a5-8ad3-6d963568a11c",
                                "text": "On présente une technique permettant de désanamorphoser des images sans l’emploi de lentilles cylindriques."
                            }
                        ]
                    }
