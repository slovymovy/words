                "senses": [
                    {
                        "sense_id": "79e80348-a5e0-3b42-919f-108ba1d617db",
                        "entry_id": "0158742b-3b03-3568-a8bd-34184d47e61b",
                        "glosses": [
                            "Celle qui sauve ; libératrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7492e36c-cf0a-496b-b2fa-7e77f73d51c3",
                                "sense_id": "79e80348-a5e0-3b42-919f-108ba1d617db",
                                "text": "On pourrait voir en Tārā Sauveuse de l’Océan des Existences, la Traversière, par le truchement de la métaphore de l’océan, l’image d’une déesse dont l’activité ne se borne pas à protéger ses dévots des dangers qui menacent leur progrès spirituel et leur salut mais qui, par bonté, condescend à les protéger de dangers plus triviaux."
                            },
                            {
                                "example_id": "e2a80b80-99e0-431a-90f4-b6816c50224b",
                                "sense_id": "79e80348-a5e0-3b42-919f-108ba1d617db",
                                "text": "Maria est une couturière portugaise qui habite juste à côté de chez ma sauveuse."
                            },
                            {
                                "example_id": "13d4e5ec-06f7-4d8f-92cd-14070426b558",
                                "sense_id": "79e80348-a5e0-3b42-919f-108ba1d617db",
                                "text": "Les citoyens et citoyennes d’une ville ne devraient pas avoir à jouer les sauveurs et sauveuses des personnes en situation d’itinérance."
                            }
                        ]
                    }
                ],
