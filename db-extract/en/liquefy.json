                                                "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                                "text": "Saint Janvier dont le sang se liquéfie si solennellement à Naples."
                                            },
                                            {
                                                "example_id": "f1a1b6a2-5c32-403e-89dc-4ce35e0cd483",
                                                "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                                "text": "Les vapeurs contenant l'essence se liquéfient dans le serpentin; à l'extrémité de ce dernier, on recueille un liquide d'une apparence blanchâtre due à la présence de l'essence dans ce liquide."
                                            },
                                            {
                                                "example_id": "7d3be70a-75fb-44a6-90ae-762a9c77dca6",
                                                "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                                "text": "La cire se liquéfie' à la chaleur."
                                            }
                                        ]
                                    }
                                ]
                            }
