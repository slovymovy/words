                            {
                                "example_id": "2047312e-0bb0-4392-b810-95adcb33f2fb",
                                "sense_id": "5de4d277-6cb6-3396-b5d8-324f6b36b20c",
                                "text": "Diego Velázquez (1599-1660) werd op 24-jarige leeftijd hofschilder van Filips IV. Hij bleef dat tot zijn dood. In bijna 40 jaar heeft Velázquez ruim honderd schilderijen gemaakt, waaronder een groot aantal portretten van de Spaanse koning."
                            },
                            {
                                "example_id": "9986d8cd-3570-4d9a-a2b5-046c9ee7c588",
                                "sense_id": "5de4d277-6cb6-3396-b5d8-324f6b36b20c",
                                "text": "Anthony van Dyck was een van de beste portretschilders van de zeventiende eeuw. Hij werd geboren in Antwerpen en werd later de hofschilder van de Britse koning Karel I in Londen."
                            }
                        ]
                    }
