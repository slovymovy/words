                    {
                        "sense_id": "3b2ea140-c17e-37e6-b9fa-83d7efe3573e",
                        "entry_id": "a86e5eb7-9cb4-38a7-8a03-3c07920e6b64",
                        "glosses": [
                            "funicular"
                        ],
