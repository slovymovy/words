    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "287c13bf-177b-392d-9512-57b8b88e1fef",
                    "sense_definition": "Occurring or done once every hour.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency_interval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hourly</w> bus service is very reliable for commuters.",
                            "target_lang_translations": {
                                "ru": "<w>Ежечасное</w> автобусное сообщение очень надежно для пассажиров.",
                                "zh": "对于通勤者来说，<w>每小时一班</w>的公交服务非常可靠。"
                            }
                        },
                        {
                            "text": "We receive <w>hourly</w> weather updates during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма мы получаем <w>ежечасные</w> сводки погоды.",
                                "zh": "暴风雨期间，我们每小时都会收到<w>每小时更新</w>的天气预报。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hourly rate",
                        "hourly basis",
                        "hourly updates",
                        "hourly service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или совершаемый раз в час.",
                        "zh": "每小时发生或进行一次的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ежечасный",
                                "target_lang_sense_clarification": "происходящий каждый час"
                            },
                            {
                                "target_lang_word": "почасовой",
                                "target_lang_sense_clarification": "относящийся к расписанию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每小时的",
                                "target_lang_sense_clarification": "形容每小时发生一次的事件或服务"
                            },
                            {
                                "target_lang_word": "每小时一次的",
                                "target_lang_sense_clarification": "强调频率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7999314b-1a68-3942-a550-bf687dcd7175",
                    "sense_definition": "Calculated or paid based on the number of hours worked.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He prefers an <w>hourly</w> wage over a fixed monthly salary.",
                            "target_lang_translations": {
                                "ru": "Фиксированному месячному окладу он предпочитает <w>почасовую</w> оплату труда.",
                                "zh": "他更喜欢<w>按小时计酬</w>，而不是固定的月薪。"
                            }
                        },
                        {
                            "text": "Most <w>hourly</w> employees are eligible for overtime pay.",
                            "target_lang_translations": {
                                "ru": "Большинство сотрудников с <w>почасовой</w> оплатой имеют право на оплату сверхурочных.",
                                "zh": "大多数<w>按小时计酬</w>的员工都有资格获得加班费。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hourly wage",
                        "hourly pay",
                        "hourly employee",
                        "hourly worker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассчитанный или оплачиваемый исходя из количества отработанных часов.",
                        "zh": "根据工作小时数计算或支付的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почасовой",
                                "target_lang_sense_clarification": "об оплате или тарифе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按小时计酬的",
                                "target_lang_sense_clarification": "指工资计算方式"
                            },
                            {
                                "target_lang_word": "小时工资的",
                                "target_lang_sense_clarification": "指薪资类型"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "390c9345-a0e7-3ab2-b35e-3e203741faac",
                    "sense_definition": "At intervals of one hour; once every hour.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency_interval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard checks the perimeter <w>hourly</w>.",
                            "target_lang_translations": {
                                "ru": "Охранник проверяет периметр <w>ежечасно</w>.",
                                "zh": "保安<w>每小时</w>巡视一次周边区域。"
                            }
                        },
                        {
                            "text": "Trains to the city center run <w>hourly</w> throughout the day.",
                            "target_lang_translations": {
                                "ru": "Поезда в центр города ходят <w>ежечасно</w> в течение всего дня.",
                                "zh": "前往市中心的火车全天<w>每小时</w>发车一次。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "check hourly",
                        "update hourly",
                        "depart hourly"
                    ],
                    "target_lang_definitions": {
                        "ru": "С интервалом в один час; раз в час.",
                        "zh": "以一小时为间隔；每小时一次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ежечасно",
                                "target_lang_sense_clarification": "наречие частоты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每小时",
                                "target_lang_sense_clarification": "表示动作发生的频率"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c7c2bea-9eb5-3e29-b6f7-42b2d2df137c",
                    "sense_definition": "A report, publication, or task that is produced or done every hour.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor checked the <w>hourlies</w> for any breaking news stories.",
                            "target_lang_translations": {
                                "ru": "Редактор просматривал <w>ежечасные сводки</w> на предмет срочных новостей.",
                                "zh": "编辑查看了<w>每小时报告</w>，以寻找突发新闻。"
                            }
                        },
                        {
                            "text": "She printed the <w>hourlies</w> and placed them on the manager's desk.",
                            "target_lang_translations": {
                                "ru": "Она распечатала <w>ежечасные отчеты</w> и положила их на стол менеджера.",
                                "zh": "她打印了<w>每小时报告</w>并放在了经理的桌上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in professional contexts like journalism or administration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчет, публикация или задача, которые создаются или выполняются каждый час.",
                        "zh": "每小时制作或完成的报告、出版物或任务。"
                    },
                    "translations": {
