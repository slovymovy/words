                        "cross_references": [
                            {
                                "target_word": "tablespoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2c71960-fd52-3446-821b-eb125a152e08",
                                        "entry_id": "f28b4dc8-308a-3e54-be3f-932a6d3c66a8",
                                        "glosses": [
                                            "A large spoon, used for eating food from a bowl."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e63137d-7353-43b7-a4ac-5fb759de0090",
                                                "sense_id": "c2c71960-fd52-3446-821b-eb125a152e08",
                                                "text": "Their eggs were deposited on a few bits of straw, and great caution was necessary in attempting to procure them, as the slightest touch crumbled their frail tenement into dust. By means of a tablespoon, I was enabled to procure many of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598f29aa-3874-3ae2-9a82-da164268ed5e",
                                        "entry_id": "f28b4dc8-308a-3e54-be3f-932a6d3c66a8",
                                        "glosses": [
                                            "A spoon too large for eating, usually used for cooking or serving."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "Northern-UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                        "entry_id": "f28b4dc8-308a-3e54-be3f-932a6d3c66a8",
                                        "glosses": [
                                            "A unit of volume, the value of which varies regionally; in the US: three teaspoons or one half fluid ounce or roughly 15 ml; in Britain and Canada: exactly 15 ml; in Russia 18 ml; in Australia: four teaspoons or 20 ml."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5150827-2ebc-4122-9933-f86cd7d7f494",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "1995 May 22, Salad Recipes, New York, page 51,\nHeat 2 tablespoons olive oil in a nonstick skillet until hot and quickly saute the goat-cheese buttons on both sides until brown."
                                            },
                                            {
                                                "example_id": "df5f62a7-aac7-425a-b82a-49aa9f47f23a",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "In Australia, 1 tablespoon equals 20 ml, and there are 4 teaspoons in the Australian tablespoon."
                                            },
                                            {
                                                "example_id": "988d9d61-8e6d-4f5d-be34-85561260f376",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "2006, Tempted: 150 Very Wicked Desserts, Murdoch Books, UK, copyright page,\nIf you are using a 15 ml (3 teaspoon) tablespoon, for most recipes the difference will not be noticeable."
                                            },
                                            {
                                                "example_id": "9f09eee0-aa29-4fdb-88b2-c5b344fc28c6",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "2012, James Armstrong, Kellee Hollyman, General, Organic, and Biochemistry: An Applied Approach, Cengage Learning, US, page 27,\nThe problem gives us a number of tablespoons of cooking oil and asks us to convert this amount into milliliters. We are also told that one tablespoon equals 3 teaspoons, but this is a relationship between two units, not an actual measurement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7a639e3-1d28-4064-9a74-3568faabc476",
                        "source_entry_id": "78326a11-3aea-34f0-9ce9-58b35bef9537",
                        "source_sense_id": "01875f62-2963-3689-a4a4-95fbd0db644b",
                        "target_lang_word": "cuiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "323e108b-efd8-3bc4-a4da-74c711b4e5f5",
                                        "entry_id": "c2e1eac8-7a43-3f3d-9eec-71bba4e9df5f",
                                        "glosses": [
                                            "Autre orthographe possible pour cuillère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961d509b-acd6-4c98-b15d-9dd8847c995c",
                                                "sense_id": "323e108b-efd8-3bc4-a4da-74c711b4e5f5",
                                                "text": "Les écumoires en cuivre (fig. 140), une grande cuiller ronde, un cassin à bec (fig. 141) pour les gelées, un pochon avec son plat pour les marmelades, un grand versoir pour les calottes (fig. 142); voilà les ustensiles en cuivre."
                                            },
                                            {
                                                "example_id": "59ecfaf7-e00b-4500-8345-2f56ed4f7341",
                                                "sense_id": "323e108b-efd8-3bc4-a4da-74c711b4e5f5",
                                                "text": "Elle s’effondra et, ayant voulu s’accrocher à la table, elle l’entraîna dans sa chute. Soucoupes, tasses, cuillers, vases se renversèrent avec fracas sur elle et sur moi, […]"
                                            },
                                            {
                                                "example_id": "b9584041-5088-4abd-a52c-6cef645e1ddb",
                                                "sense_id": "323e108b-efd8-3bc4-a4da-74c711b4e5f5",
                                                "text": "Il le lança si violemment sur la jument du brigadier que celui-ci, en plein étonnement, vida les étriers, tomba comme un sac de cuillers et resta étendu à terre."
                                            },
                                            {
                                                "example_id": "688f1200-5aa9-46f0-970c-debfe1689e4c",
                                                "sense_id": "323e108b-efd8-3bc4-a4da-74c711b4e5f5",
                                                "text": "Marco nous a payé sa tournée, sa femme Gina, une ancienne sous-maquée est venue nous serrer la cuiller et on s'est tiré."
                                            },
                                            {
                                                "example_id": "51ae0414-66b7-411c-9163-29b810ce34af",
                                                "sense_id": "323e108b-efd8-3bc4-a4da-74c711b4e5f5",
                                                "text": "À côté du réchaud elle disposa la tasse Empire, la cuiller suédoise, un pain de seigle roulé dans la serviette turque brodée de soie floche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66cee0fc-12bf-32a2-b489-1ae97efe4aa5",
                                        "entry_id": "c2e1eac8-7a43-3f3d-9eec-71bba4e9df5f",
                                        "glosses": [
                                            "Partie creuse d'un joug, se positionnant sur le cou de l'animal."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e73f0c29-b5ad-49b2-a7b3-9c91b37d9cdc",
                                                "sense_id": "66cee0fc-12bf-32a2-b489-1ae97efe4aa5",
                                                "text": "La partie échancrée, concave, appelée cuiller, enfoncement ou écuelle, repose généralement sur la nuque en arrière du chignon,..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "820b0519-e232-3d85-a32f-9ba534e9ed5b",
                                        "entry_id": "c2e1eac8-7a43-3f3d-9eec-71bba4e9df5f",
                                        "glosses": [
                                            "Partie d'un lance-torpille qui dépassait de la coque du navire et servait à guider la torpille."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e3ebf6-eca3-46fb-8599-79959d204aa6",
                                                "sense_id": "820b0519-e232-3d85-a32f-9ba534e9ed5b",
                                                "text": "Les torpilles sont lancées dans des tubes spéciaux, dits à cuiller, au moyen d'une faible charge de poudre"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6db21a6a-2805-47f9-a6ee-bca30487fd72",
                        "source_entry_id": "78326a11-3aea-34f0-9ce9-58b35bef9537",
                        "source_sense_id": "01875f62-2963-3689-a4a4-95fbd0db644b",
