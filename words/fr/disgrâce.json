        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "509c019c-daa6-3e3a-b2de-2485f4c43798",
                    "sense_definition": "Perte de l'estime, de la considération ou du crédit dont jouissait une personne auprès d'un groupe ou du public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perte_estime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le scandale financier a entraîné la <w>disgrâce</w> publique de cet homme d'affaires influent."
                        },
                        {
                            "text": "Elle a vécu son renvoi comme une profonde <w>disgrâce</w> qui a brisé sa carrière."
                        }
                    ],
                    "synonyms": [
                        "déshonneur",
                        "discrédit",
                        "opprobre",
                        "honte"
                    ],
                    "antonyms": [
                        "gloire",
                        "estime",
                        "honneur"
                    ],
                    "common_phrases": [
                        "connaître la disgrâce"
                    ]
                },
                {
                    "sense_id": "300df23e-fc60-38d3-8081-3644133f89a5",
                    "sense_definition": "Perte de la faveur ou de la protection d'un souverain, d'un protecteur ou d'un supérieur puissant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perte_estime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la conspiration manquée, le ministre est tombé en <w>disgrâce</w> auprès du monarque."
                        },
                        {
                            "text": "Sa longue <w>disgrâce</w> s'est achevée par un rappel inattendu auprès du souverain."
                        }
                    ],
                    "synonyms": [
                        "déchéance",
                        "bannissement"
                    ],
                    "antonyms": [
                        "faveur",
                        "grâce"
                    ],
                    "common_phrases": [
                        "tomber en disgrâce",
                        "être en disgrâce"
                    ]
                },
                {
                    "sense_id": "e569462c-7b07-34bf-a6f3-744dab26eba6",
                    "sense_definition": "Événement malheureux, coup du sort ou mauvaise fortune qui frappe quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adversite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une cruelle <w>disgrâce</w> s'abattit sur cette famille déjà ruinée par des années de conflit."
                        },
                        {
                            "text": "Pour comble de <w>disgrâce</w>, un violent orage éclata pendant leur fuite à travers les bois."
                        }
                    ],
                    "synonyms": [
                        "infortune",
