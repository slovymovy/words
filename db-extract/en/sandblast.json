                ],
                "senses": [
                    {
                        "sense_id": "ef5792f9-f450-3045-ad04-dcd424ef9409",
                        "entry_id": "f22016e8-27f5-3ae8-a9b5-94af7a971290",
                        "glosses": [
                            "To spray with fast-moving solid grains (such as sand propelled by compressed air, although softer material like sodium bicarbonate used for delicate materials may also be so referred to). The process is used for stripping dirt, rust, paint etc. from the surface of objects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ecef8e-3464-4c0d-b74c-bb89650b6e2a",
                                "sense_id": "ef5792f9-f450-3045-ad04-dcd424ef9409",
                                "text": "The plane's large rear doors swallowed up my friend in superfast time, its departure sandblasting everyone in red prop wash as it vaporised down the main street and into the afternoon's dust-bowl sky."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26e1dd6a-6898-49b5-b576-81764fd341c5",
                        "source_entry_id": "f22016e8-27f5-3ae8-a9b5-94af7a971290",
                        "source_sense_id": "ef5792f9-f450-3045-ad04-dcd424ef9409",
                        "source_sense_description": "to spray with sand",
                        "target_lang_word": "sabler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sabler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "531653af-24aa-300d-8efb-c433ae6a01c4",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Couvrir de sable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4dabd9-7aaa-4a5f-9781-3cf4cf04c0ae",
                                                "sense_id": "531653af-24aa-300d-8efb-c433ae6a01c4",
                                                "text": "Les abords désobstrués et sablés étaient soignés par l’homme chargé d’entretenir les allées du parc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8caef8cd-44d2-3fc9-9721-ab9dbb60348b",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Couvrir de sable.",
                                            "Action qui consiste à déposer du sable sur les rails, au moyen d'une sablière, juste devant les roues motrices d'une locomotive pour augmenter adhérence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67beedfe-6e76-4b7b-ba1b-dc1df7adc759",
                                                "sense_id": "8caef8cd-44d2-3fc9-9721-ab9dbb60348b",
                                                "text": "L'opération de sabler les rails a donc augmenté l'usure et la déformation des rails"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c08546-2daa-3792-9cf4-5b347d472b4b",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Projeter du sable, avec une sableuse, sur un objet en vue de le décaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ed1405-5961-4bc0-a142-ca5fc74666e9",
                                                "sense_id": "54c08546-2daa-3792-9cf4-5b347d472b4b",
                                                "text": "Sabler une pièce de ferronnerie pour en ôter la rouille."
                                            },
                                            {
                                                "example_id": "dbb40beb-7f2c-425d-abc8-fe16fa974a5f",
                                                "sense_id": "54c08546-2daa-3792-9cf4-5b347d472b4b",
                                                "text": "Sabler une paroi pour en ôter la peinture."
                                            },
                                            {
                                                "example_id": "b9e216f2-abbf-4569-a818-93e22c1e15a2",
                                                "sense_id": "54c08546-2daa-3792-9cf4-5b347d472b4b",
                                                "text": "Sabler un pantalon en jeans pour le faire paraître usé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e644a5b-0ab6-3a58-ac7c-05f873076ca8",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Projeter du sable, avec une sableuse, sur un objet en vue de le décaper.",
                                            "Action qui consiste à projeter du sable sur du verre pour le dépolir, en particulier à des fins artistiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3257fb6-b010-4844-b488-e15e4f946ee5",
                                                "sense_id": "5e644a5b-0ab6-3a58-ac7c-05f873076ca8",
                                                "text": "Tailler, sabler, graver et peindre le verre sont des opérations qui se font encore suivant les techniques traditionnelles éprouvées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49b5981-3238-3638-9d8e-fdf040e10463",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Verser, couler d’un seul coup la fonte dans un moule de sable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a98a3785-78cb-338c-8a9c-972ebf0b011b",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Boire d’un seul trait."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fb01de-6232-48c3-8561-9a4614dc6a88",
                                                "sense_id": "a98a3785-78cb-338c-8a9c-972ebf0b011b",
                                                "text": "Et tout en balbutiant, Jacques, en chemise et pieds nus, avait sablé deux ou trois rasades sans ponctuation, comme il s’exprimait, c’est-à-dire de la bouteille au verre, du verre à la bouche."
                                            },
                                            {
                                                "example_id": "2a7b03e6-0f0f-4102-81e6-131a2b76acf9",
                                                "sense_id": "a98a3785-78cb-338c-8a9c-972ebf0b011b",
                                                "text": "Je l’ai vu sabler douze coups de son verre de Bohême, et il n’y paraissait même pas !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f5e24e-f329-3b71-8c01-07c5239b2462",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Fêter par des libations un événement, une distinction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43d4ccbb-f06a-4794-851d-e45dc0722cc8",
                                                "sense_id": "88f5e24e-f329-3b71-8c01-07c5239b2462",
                                                "text": "Il n’est pas plus absurde de se réjouir de l’obtention d’un parchemin qui le proclame chevalier que pour un Français de sabler sa Légion d’honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aef927e6-5970-3704-8025-996b49db3426",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Plus spécialement : « sabler le champagne » : boire du champagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cf88173-cee1-4f62-b5a2-9fc33539524f",
                                                "sense_id": "aef927e6-5970-3704-8025-996b49db3426",
                                                "text": "[…] En effet, l’heure me paraît venue de sabler le champagne sans attendre au dessert !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06643e7-89af-32d9-aaf2-15ffc749e407",
                                        "entry_id": "51b8655c-d04e-38f0-b7ad-d564da7d6822",
                                        "glosses": [
                                            "Poncer, polir, avec du papier sablé, papier de verre."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53678f36-b967-491f-95b5-d84ea43959f0",
