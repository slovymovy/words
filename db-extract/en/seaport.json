    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d92e1674-0659-3fcb-a9c6-6feb1d27c88e",
                "word": "seaport",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5b71279f-e943-4300-b8b0-ad780c266a67",
                        "entry_id": "d92e1674-0659-3fcb-a9c6-6feb1d27c88e",
                        "tags": [
                            "plural"
                        ],
                        "form": "seaports"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "487f179f-75da-375e-b155-c8b233aa8141",
                        "entry_id": "d92e1674-0659-3fcb-a9c6-6feb1d27c88e",
                        "glosses": [
                            "A town or harbour with facilities for seagoing ships to dock and take on or discharge cargo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "197a9043-d3f9-4d29-8121-243334704c83",
                                "sense_id": "487f179f-75da-375e-b155-c8b233aa8141",
                                "text": "For many years, Oslo had no railway communication with Bergen and Stavanger, the principal seaports on the south-west coast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3afa0f3-f643-4578-a631-80562ce76ec6",
                        "source_entry_id": "d92e1674-0659-3fcb-a9c6-6feb1d27c88e",
                        "source_sense_id": "487f179f-75da-375e-b155-c8b233aa8141",
                        "source_sense_description": "town or harbour for seagoing ships",
                        "target_lang_word": "zeehaven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeehaven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "664f8312-414b-3b12-aaf1-42aa86b08736",
                                        "entry_id": "96fa348f-b5c1-3f6e-b467-63e461ef1c29",
                                        "glosses": [
                                            "haven die in verbinding staat met de zee"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b549add-845b-40b4-820d-7e8dbf7e4fe0",
                        "source_entry_id": "d92e1674-0659-3fcb-a9c6-6feb1d27c88e",
                        "source_sense_id": "487f179f-75da-375e-b155-c8b233aa8141",
                        "source_sense_description": "town or harbour for seagoing ships",
                        "target_lang_word": "Seehafen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seehafen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c365c7e7-a052-3a89-9cc3-f75bd4ab3d2b",
                                        "entry_id": "512717d9-34ab-3846-8cf5-b14df30bab74",
                                        "glosses": [
                                            "für Seeschiffe zugänglicher Hafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43f70b3-45c8-4ec8-9222-762d32bcd00c",
                                                "sense_id": "c365c7e7-a052-3a89-9cc3-f75bd4ab3d2b",
                                                "text": "„Die deutschen Seehäfen erbringen vielfältige sonstige Dienstleistungen und sind bedeutende Standorte der Industrie, zum Beispiel der wenigen verbliebenen Werften, von Stahlwerken, Raffinerien, Getreidemühlen, Ölmühlen und Röstereien.“"
                                            },
                                            {
                                                "example_id": "b2d38358-25c7-496b-a0ac-aa311646d477",
                                                "sense_id": "c365c7e7-a052-3a89-9cc3-f75bd4ab3d2b",
                                                "text": "„Ich radelte durch den historischen Stadtkern vorbei am mächtigen Gewerkschaftshaus zum beeeindruckenden Seehafen, der wackligen Fischerbooten, Segeljachten, Kreuzfahrtschiffen und Containerriesen eine Heimat bot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fa60535-a51d-4df9-8df5-f7c76b19f710",
                        "source_entry_id": "d92e1674-0659-3fcb-a9c6-6feb1d27c88e",
                        "source_sense_id": "487f179f-75da-375e-b155-c8b233aa8141",
                        "source_sense_description": "town or harbour for seagoing ships",
                        "target_lang_word": "Hafenstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hafenstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                        "entry_id": "fb8cb9c5-6b98-32d2-8ea1-d8d4835a3bb0",
                                        "glosses": [
                                            "große Ansiedlung am Meer, einem See oder einem Fluss, die von Schiffen angelaufen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f7dd890-daf3-4a14-b158-d59ba689d52a",
                                                "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                                "text": "Marseille ist eine französische Hafenstadt."
                                            },
                                            {
                                                "example_id": "ea13834b-fa92-4676-8fbf-6bce3b8fb821",
                                                "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                                "text": "„Karthago war eine blühende Hafenstadt und Wirtschaftsmetropole.“"
                                            },
                                            {
                                                "example_id": "76525bde-571e-4bd8-a512-7e5fa04897c0",
                                                "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                                "text": "„Die Europäer erobern, plündern und zerstören etliche Hafenstädte, um den Handel an sich zu reißen.“"
                                            },
                                            {
                                                "example_id": "a4385ba8-f894-4250-93cf-7909bf3d1113",
                                                "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                                "text": "„Am 11. Juli eröffnen zwei belgische Marineschiffe das Feuer auf die von Europäern evakuierte Hafenstadt Matadi.“"
                                            },
                                            {
                                                "example_id": "ac5bba95-7589-49db-a341-fd639ba3fe87",
                                                "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                                "text": "„Die Heilsarmee hat ein großes Arbeitsfeld in den Hafenstädten, um der Trunksucht und anderen Lastern entgegenzutreten.“"
                                            },
                                            {
                                                "example_id": "cd70e217-e925-471b-8fa5-3634ca85c866",
                                                "sense_id": "2c2ed504-7066-36d3-ace6-7483d4218097",
                                                "text": "„Die Hafenstadt Karatschi gilt als das ökonomische Herz Pakistans.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71c1a6cc-bd1a-4571-abbc-2ab9cd8b2eb7",
