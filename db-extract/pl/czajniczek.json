                        "source_sense_id": "7f27c816-0c33-3029-a3c5-c265ffbf7ee4",
                        "target_lang_word": "teapot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teapot",
