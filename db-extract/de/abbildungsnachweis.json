                "senses": [
                    {
                        "sense_id": "b1126878-5ad8-3cb6-9aa3-5c01133f3d28",
                        "entry_id": "38d1c838-d20f-3bf8-b4f1-57b4da12583b",
                        "glosses": [
                            "Angabe oder Verweis (in einem Buch oder einer wissenschaftlichen Arbeit), der die Quellen oder Herkunft der enthaltenen Abbildungen dokumentiert oder belegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b2c61d-e572-4b5f-aa68-a6b5b083f9a6",
                                "sense_id": "b1126878-5ad8-3cb6-9aa3-5c01133f3d28",
                                "text": "„25 farbige Bildtafeln mit Ansichten des Rungholtwatts und Abbildungen der Funde sowie 308 Schwarz-Weiß-Abbildungen im Text ergänzen die Darstellung; Abbildungsnachweise fehlen.“"
                            },
                            {
                                "example_id": "67d0f6a0-12e0-4fae-b90b-f4eb80e7966a",
                                "sense_id": "b1126878-5ad8-3cb6-9aa3-5c01133f3d28",
                                "text": "„Am Übersichtlichsten ist der listenartige Abbildungsnachweis am Ende der Arbeit.“"
                            },
                            {
                                "example_id": "6fb7b93b-450f-4e4e-bd17-15131152c4de",
                                "sense_id": "b1126878-5ad8-3cb6-9aa3-5c01133f3d28",
                                "text": "„Bei Abbildungen wenden Sie sich bitte direkt an die jeweils in den ausführlichen Abbildungsnachweisen genannte (verwahrende) Institution oder Person.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
