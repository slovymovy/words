                        "sense_id": "ec1fd164-afe4-3223-ae76-89c4900d8d9b",
                        "entry_id": "29971ba1-301e-33f6-97a1-33cd4ab05cef",
                        "glosses": [
                            "Relatif à la romancière Agatha Christie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd611c77-51e9-48ae-8838-5edb214d2a60",
                                "sense_id": "ec1fd164-afe4-3223-ae76-89c4900d8d9b",
                                "text": "Depuis Victoria Station jusqu’à Porquerolles, un lieu qui, à l’époque, pouvait être, si l’on peut utiliser ces qualificatifs, « Agatha-christien » tout autant que « simenonien », dans la géographie mondaine comme dans celle du récit policier."
                            }
                        ]
                    }
