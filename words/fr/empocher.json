    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ee4e6a2-6f44-3901-8a38-ca5117d1942f",
                    "sense_definition": "Mettre dans sa poche, en particulier de l'argent ou un petit objet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mettre_en_poche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ramassa sa monnaie sur le comptoir avant de l'<w>empocher</w> rapidement."
                        },
                        {
                            "text": "Le voyageur <w>empoche</w> ses clés de voiture pour ne pas les égarer."
                        }
                    ],
                    "common_phrases": [
                        "empocher la monnaie"
                    ]
                },
                {
                    "sense_id": "e913a6fc-e520-35af-a952-426195c5dbc9",
                    "sense_definition": "Recevoir, percevoir ou s'approprier une somme d'argent, des gains ou des bénéfices.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a eu une chance incroyable et a <w>empoché</w> le pactole dès le premier tour."
                        },
                        {
                            "text": "L'entreprise espère <w>empocher</w> une prime importante à la fin de cette année."
                        }
                    ],
                    "synonyms": [
                        "encaisser",
                        "toucher",
                        "ramasser"
                    ],
                    "antonyms": [
                        "débourser",
                        "perdre"
                    ],
                    "common_phrases": [
                        "empocher la mise",
                        "empocher le pactole",
                        "empocher les bénéfices"
                    ]
                },
                {
                    "sense_id": "35ad35ca-b20d-348a-bb5a-26c4422cda87",
                    "sense_definition": "Supporter ou subir des paroles désagréables, des affronts ou des réprimandes sans pouvoir riposter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "subir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé dut <w>empocher</w> les critiques injustes de son supérieur sans dire un mot."
                        },
                        {
                            "text": "Après cette remarque humiliante, il a <w>empoché</w> l'affront en silence devant toute l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "encaisser",
                        "essuyer",
                        "avaler"
                    ],
                    "antonyms": [
                        "riposter"
                    ],
                    "common_phrases": [
                        "empocher un affront",
                        "empocher une injure"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou figuré"
                        }
                    ]
                }
