                        "entry_id": "bb490b22-26b3-3724-a800-023ce6738efd",
                        "glosses": [
                            "Pâtisserie créée par François Payard qui joint la forme et la texture des macarons français et des donuts américains."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "b0c56d52-25dd-492d-98c6-b6c225b7cde6",
                                "sense_id": "f99c00f8-4c57-372f-ba84-16d8440189c2",
                                "text": "Le macaronut, ce mi-donut, mi-macaron qui nous fait fantasmer."
                            },
                            {
                                "example_id": "e6792db8-35f1-4ea5-acf5-6ac708c87384",
                                "sense_id": "f99c00f8-4c57-372f-ba84-16d8440189c2",
                                "text": "Une coque de macaron sur le dessus, un petit doughnut en dessous, et de la ganache au milieu, voilà le principe du macaronut, la nouvelle invention culinaire venue de New York."
                            },
                            {
                                "example_id": "e5215d95-2662-47a5-ab2b-5c41e4343e20",
                                "sense_id": "f99c00f8-4c57-372f-ba84-16d8440189c2",
                                "text": "Après le cronut, le crumcake ou encore le brookie, voici le macaronut, la nouvelle pâtisserie hybride entre le macaron et le donut."
                            }
                        ]
                    }
