                        "glosses": [
                            "Expressing sympathy to someone, especially after learning of a close death."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0483a7ee-a254-4b33-bac1-7ea79ffdf551",
                                "sense_id": "e91273fb-2912-391b-b1b0-9a2ec8bdae42",
                                "text": "\"What were you doing at the cemetery?\"\n \"Burying my father.\"\n \"Oh.\" Rodionov grunted as if he had expected a more imaginative excuse. \"Condolences.\""
                            },
                            {
                                "example_id": "fb1c2291-dc19-4c31-b7b5-e8f3ed6c4649",
                                "sense_id": "e91273fb-2912-391b-b1b0-9a2ec8bdae42",
                                "text": "Let's get another caller on the line. This is Camille. Camille with us from Visalia in California.\n Visalia, California that's correct.\n Go ahead please.\n Hi. I'm an African-American woman and when I first saw the cover – let me preface this. I'm in central California, which is very conservative. And...\n Condolences."
                            }
                        ]
                    }
