                "senses": [
                    {
                        "sense_id": "c3292f4d-45f9-36ec-b45f-bb03dcd91580",
                        "entry_id": "5cb5ab9f-1576-3dc5-ae99-420df85fd535",
                        "glosses": [
                            "die Lehre der Energie, ihrer Erscheinungsform und Fähigkeit, Arbeit zu verrichten"
                        ],
                        "tags": [
                            "Teilgebiet der klassischen Physik"
                        ],
                        "examples": [
                            {
                                "example_id": "10a1c29e-5e97-4eef-b965-cce07e9b4495",
                                "sense_id": "c3292f4d-45f9-36ec-b45f-bb03dcd91580",
                                "text": "Im Gegensatz zur klassischen Mechanik stehen in der Wärmelehre nicht einzelne Körper im Vordergrund, sondern ein Ensemble aus vielen kleinsten Bausteinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3438f124-add5-4ef8-acce-fa0e64e11a48",
                        "source_entry_id": "5cb5ab9f-1576-3dc5-ae99-420df85fd535",
                        "source_sense_id": "c3292f4d-45f9-36ec-b45f-bb03dcd91580",
                        "target_lang_word": "thermodynamics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermodynamics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84cfbf47-fd3a-38f7-b3c3-7626a68ba1e3",
                                        "entry_id": "c20fa274-d3ad-319a-9d85-f43f7cb9b707",
                                        "glosses": [
                                            "The science of the conversions between heat and other forms of energy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b38a267a-6dbb-4a5f-b1d9-f853dbd6be3b",
                                                "sense_id": "84cfbf47-fd3a-38f7-b3c3-7626a68ba1e3",
                                                "text": "“3D photochemistry plays a huge role because it provides heating or cooling, which can affect the thermodynamics and perhaps the atmospheric composition of a planetary system,” Chen said."
                                            },
                                            {
                                                "example_id": "d42fdf9e-cbdf-4c40-9e82-fc32fcdb24d3",
                                                "sense_id": "84cfbf47-fd3a-38f7-b3c3-7626a68ba1e3",
                                                "text": "The top-hatted “drinking bird,” once a fixture in science classrooms for demonstrating the basics of thermodynamics, is making a surprising comeback — as the inspiration for a new clean-energy generator that could one day power your watch and phone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb69e152-2cbf-4ab8-9fea-a05c92f37467",
                        "source_entry_id": "5cb5ab9f-1576-3dc5-ae99-420df85fd535",
                        "source_sense_id": "c3292f4d-45f9-36ec-b45f-bb03dcd91580",
                        "target_lang_word": "thermodynamique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermodynamique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c414b975-a402-368e-836f-1494978efa07",
                                        "entry_id": "38bcfcfd-c7b4-3a97-82cf-ebc5b9608356",
                                        "glosses": [
                                            "Relatif à la force produite par la chaleur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fccb42af-106b-4ce9-9c74-5aa4f5d1f87e",
                                                "sense_id": "c414b975-a402-368e-836f-1494978efa07",
                                                "text": "Un équilibre thermodynamique."
                                            },
                                            {
                                                "example_id": "c5178a20-b103-4521-a83b-3ed1202a6d68",
                                                "sense_id": "c414b975-a402-368e-836f-1494978efa07",
                                                "text": "— recourir à des solutions qui utilisent une énergie gratuite, tels les chauffe-eaux thermodynamiques ou solaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thermodynamique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb4305c-ad32-3ac4-bb78-66aff4999e7f",
                                        "entry_id": "8a8ed5e1-09ab-3463-b2b8-927252021cc8",
                                        "glosses": [
                                            "Discipline étudiant l’énergie physique et les changements d’état de la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee36dd8c-4733-4453-95f3-b7a2bad26f65",
                                                "sense_id": "7cb4305c-ad32-3ac4-bb78-66aff4999e7f",
                                                "text": "Philippe Bourke, président du Bureau d’audiences publiques sur l’environnement (BAPE), en entrevue à Qub, hier, soulignait que l’expression « élimination des déchets » est « problématique ». Les règles de la thermodynamique demeurent…, souriait M. Bourke : « Rien ne se perd, rien ne se crée, tout se transforme »."
                                            },
                                            {
                                                "example_id": "635f2252-02a3-414f-b579-ecbde1ab3b35",
                                                "sense_id": "7cb4305c-ad32-3ac4-bb78-66aff4999e7f",
                                                "text": "La thermodynamique comprend l'étude des corps en tenant compte de l’influence de la température sur leurs caractéristiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
