                ],
                "senses": [
                    {
                        "sense_id": "c8f0780d-8753-331c-a86e-d0dbd8285992",
                        "entry_id": "3673e3fc-d478-3066-9953-b446bea1cc87",
                        "glosses": [
                            "стреляя, успешно защититься от нападения; отбиться стрельбой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ac8659b-52fb-4f81-b640-6fbe13dacad4",
                                "sense_id": "c8f0780d-8753-331c-a86e-d0dbd8285992",
                                "text": "А Старшов на окраине нарвался на солдат, кое-как отстрелялся последними патронами, но получил такой удар прикладом в плечо, что отлетел к изгороди и — как провалился."
                            }
                        ]
                    },
                    {
                        "sense_id": "436765b5-a715-34c3-a902-e0324001ed6e",
                        "entry_id": "3673e3fc-d478-3066-9953-b446bea1cc87",
                        "glosses": [
                            "разг. прекратить, завершить стрельбу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be929ad-8038-4882-8ec0-e72e398e958b",
                                "sense_id": "436765b5-a715-34c3-a902-e0324001ed6e",
                                "text": "К вечеру, как отстрелялся немец, пришло время заступить Сашке на ночной пост."
                            }
                        ]
                    },
                    {
                        "sense_id": "a99ab716-c65d-3bb2-844c-8dbc77297f02",
                        "entry_id": "3673e3fc-d478-3066-9953-b446bea1cc87",
                        "glosses": [
                            "перен., разг. завершить выполнение какой-либо обязанности, какого-либо дела; сдать проект, экзамен и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b88bfb5c-04ae-40ec-b5c0-881aa650d86e",
                                "sense_id": "a99ab716-c65d-3bb2-844c-8dbc77297f02",
                                "text": "Те, кто уже отстрелялся, спокойно занимались своими делами, остальные уткнулись в учебники, скорей всего процесс зазубривания стихотворения происходил прямо тут, в классе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fc3f7ae-1537-46be-b7ce-2c2920d4fc73",
                        "source_entry_id": "3673e3fc-d478-3066-9953-b446bea1cc87",
                        "source_sense_description": "прекратить стрельбу",
                        "target_lang_word": "cease fire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cease fire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
