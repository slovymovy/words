                        ],
                        "examples": [
                            {
                                "example_id": "34b24865-e6c3-45ba-89db-da3f4f2365ca",
                                "sense_id": "b0363b53-17d6-38f7-a4f6-878a72bc89bc",
                                "text": "Les sauces dans lesquelle entre [la crème] prend le nom générique de meurotte. (1936)."
                            },
                            {
                                "example_id": "e4f46650-604a-4c21-8f2a-d7d95af2c2d9",
                                "sense_id": "b0363b53-17d6-38f7-a4f6-878a72bc89bc",
                                "text": "Ce qui fait la tourte lorraine, c'est la migaine, la meurotte, analogue à celle de la quiche. (1936)."
                            }
                        ]
