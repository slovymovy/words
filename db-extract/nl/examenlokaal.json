                            {
                                "example_id": "f3438f30-ff20-4e81-95ac-5a7feb85e493",
                                "sense_id": "ef19658c-3246-34f9-a81e-c12e9c7fb4b7",
                                "text": "Kandidaten moeten altijd horloges en mobiele telefoons opbergen in een locker voordat ze het examenlokaal binnengaan. Ook hebben de beveiligers een handscanner waarmee ze kunnen controleren of iemand verboden apparatuur bij zich heeft."
                            },
