                        "entry_id": "77e0525d-0b8b-3fe3-9ca0-b8c72b4c8877",
                        "glosses": [
                            "Premier dimanche après Pâques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7322456d-6419-4b4f-95f7-ea378af7fbc4",
                                "sense_id": "a9ad70f6-03c1-3835-a39a-aeeddfc02ec6",
                                "text": "Le dimanche de la Quasimodo, de quasimodo."
                            },
                            {
                                "example_id": "a45aecf0-8906-400c-8361-df6a1cc7cc20",
                                "sense_id": "a9ad70f6-03c1-3835-a39a-aeeddfc02ec6",
                                "text": "Après quasimodo, après la quasimodo."
                            },
                            {
                                "example_id": "bcf4056f-214c-487e-8b1e-7ffc21d008d6",
                                "sense_id": "a9ad70f6-03c1-3835-a39a-aeeddfc02ec6",
                                "text": "[…] mon père attend Quasimodo pour aller à confesse et faire ses Pâques la mort dans l’âme, juste pour ne pas provoquer le drame à la maison."
                            }
                        ]
                    }
                ],
                "translations": [
