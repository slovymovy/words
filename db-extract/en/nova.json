                        "examples": [
                            {
                                "example_id": "769061a4-59a3-418a-9d54-d9539edd4a50",
                                "sense_id": "04138a26-22d5-340d-9935-b39ab16db1d1",
                                "text": "Did you notice the dog which in the winter sports scenes is clasped in the arms of the child-star, Nova Pilbeam?"
                            },
                            {
                                "example_id": "b1af0254-681d-49ad-8f0e-d506daa789a6",
                                "sense_id": "04138a26-22d5-340d-9935-b39ab16db1d1",
                                "text": "He murmurs to himself, \"Her body is twenty-two, but she is in the infancy of a second life. I will call her Nova, the New One.\""
                            }
                        ]
                    }
                ],
