{
    "word_family": [
        "afschieten",
        "schot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c5a7910-f81d-3255-b945-f155a62cadb9",
                    "sense_definition": "bewust aangebrachte lichte helling van een vlak, vloer of leiding om vloeistof te laten weglopen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "helling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was onvoldoende <w>afschot</w> waardoor het regenwater op het platte dak bleef staan.",
                            "target_lang_translations": {
                                "en": "There was insufficient <w>slope</w>, which caused rainwater to stay on the flat roof."
                            }
                        },
                        {
                            "text": "Bij de aanleg van het terras zorgde de stratenmaker voor het juiste <w>afschot</w>.",
                            "target_lang_translations": {
                                "en": "When constructing the patio, the paver ensured the correct <w>fall</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "helling"
                    ],
                    "common_phrases": [
                        "op afschot leggen",
                        "voldoende afschot"
                    ],
                    "target_lang_definitions": {
                        "en": "a deliberate slight incline or gradient of a surface, floor, or pipe to allow liquids to drain off"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slope",
                                "target_lang_sense_clarification": "deliberate incline for drainage"
                            },
                            {
                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "gradient or incline in building/pipework"
                            },
                            {
                                "target_lang_word": "gradient",
                                "target_lang_sense_clarification": "slope for drainage"
                            },
                            {
                                "target_lang_word": "pitch",
                                "target_lang_sense_clarification": "incline of a roof or surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7361e245-ce5d-3483-abb2-502a18f92ab9",
                    "sense_definition": "de hoeveelheid wild die geschoten is of volgens de vergunning geschoten mag worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boswachter controleert elk jaar nauwkeurig het <w>afschot</w> van de reeën in het natuurgebied.",
                            "target_lang_translations": {
                                "en": "The forester closely monitors the <w>cull</w> of roe deer in the nature reserve every year."
                            }
                        },
                        {
                            "text": "Vanwege de schade aan de gewassen werd een hoger <w>afschot</w> van wilde zwijnen toegestaan.",
                            "target_lang_translations": {
                                "en": "Due to crop damage, a higher <w>culling quota</w> of wild boars was permitted."
                            }
                        }
                    ],
                    "common_phrases": [
                        "afschot van wild"
                    ],
                    "target_lang_definitions": {
                        "en": "the number of wild animals shot or permitted to be shot according to hunting quotas or regulations"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cull",
                                "target_lang_sense_clarification": "quota or number of game animals killed"
                            },
                            {
                                "target_lang_word": "bag",
                                "target_lang_sense_clarification": "number of game animals shot"
                            },
                            {
                                "target_lang_word": "quota",
                                "target_lang_sense_clarification": "permitted number of game to shoot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4533d735-3a56-3da5-a665-ba692459d872",
                    "sense_definition": "de plaats of richting waar overtollig water naar weg kan stromen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "helling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sloot biedt een natuurlijk <w>afschot</w> voor het water van de omliggende akkers.",
                            "target_lang_translations": {
                                "en": "The ditch provides a natural <w>drainage</w> for the water from the surrounding fields."
                            }
                        },
                        {
                            "text": "Door de hevige modderstroom was het <w>afschot</w> van het water volledig geblokkeerd.",
                            "target_lang_translations": {
                                "en": "Due to the heavy mudslide, the water <w>outflow</w> was completely blocked."
                            }
                        }
                    ],
                    "synonyms": [
                        "afvoer"
                    ],
                    "target_lang_definitions": {
                        "en": "the outlet, runoff path, or direction through which surplus water can drain away"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drainage",
                                "target_lang_sense_clarification": "natural or artificial runoff outflow"
                            },
                            {
                                "target_lang_word": "runoff",
                                "target_lang_sense_clarification": "path or flow of excess water"
                            },
                            {
                                "target_lang_word": "outflow",
                                "target_lang_sense_clarification": "drainage outlet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}