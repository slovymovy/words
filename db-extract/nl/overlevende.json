                                        "sense_id": "86162393-dd95-3065-9f6a-48cee9ea7905",
                                        "entry_id": "bd81a6d2-ba31-3f3d-8762-9f4893543d41",
                                        "glosses": [
                                            "eine weibliche Person, die (nach einem Unglück) noch am Leben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9c9f3d-f759-4b2d-900d-021421611d07",
                                                "sense_id": "86162393-dd95-3065-9f6a-48cee9ea7905",
                                                "text": "Nach zwei Nächten wurde noch eine Überlebende aus den Trümmer geborgen."
                                            },
                                            {
                                                "example_id": "b87485f1-dc8d-4bcd-84af-b19e69412a92",
                                                "sense_id": "86162393-dd95-3065-9f6a-48cee9ea7905",
                                                "text": "Mehrere (weibliche) Überlebende eines Busunglücks gaben ein Interview."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
