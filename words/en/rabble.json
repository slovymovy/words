{
    "word_family": [
        "rabble-rouser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a5f949f-42a8-3b79-88b1-fb1845140bb9",
                    "sense_definition": "A disorderly, noisy, or unruly crowd of people; a mob.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police struggled to control the angry <w>rabble</w> that had gathered outside the city hall.",
                            "target_lang_translations": {
                                "ru": "Полиция изо всех сил пыталась сдержать разъяренную <w>толпу</w>, собравшуюся у здания ратуши."
                            }
                        },
                        {
                            "text": "An excited <w>rabble</w> of football fans marched down the street chanting victory songs.",
                            "target_lang_translations": {
                                "ru": "Возбужденная <w>гурьба</w> футбольных болельщиков шла по улице, скандируя победные песни."
                            }
                        }
                    ],
                    "synonyms": [
                        "mob",
                        "crowd"
                    ],
                    "common_phrases": [
                        "angry rabble",
                        "excited rabble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочная, шумная или неуправляемая толпа людей; сброд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпа",
                                "target_lang_sense_clarification": "беспорядочное скопление людей"
                            },
                            {
                                "target_lang_word": "сброд",
                                "target_lang_sense_clarification": "беспорядочная группа людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c70cad9a-2ac0-3fcb-b225-26855441c104",
                    "sense_definition": "The mass of common people, especially when viewed contemptuously as ignorant or low-class.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrogant aristocrat looked down on the <w>rabble</w> working in the fields.",
                            "target_lang_translations": {
                                "ru": "Высокомерный аристократ с презрением смотрел на <w>чернь</w>, работающую в полях."
                            }
                        },
                        {
                            "text": "He believed that political decisions should not be left to the uneducated <w>rabble</w>.",
                            "target_lang_translations": {
                                "ru": "Он считал, что политические решения не должны оставаться на усмотрение необразованного <w>быдла</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "riffraff",
                        "hoi polloi",
                        "masses",
                        "populace",
                        "unwashed"
                    ],
                    "common_phrases": [
                        "uneducated rabble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масса простых людей, особенно когда их презрительно рассматривают как невежественных или принадлежащих к низшему классу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернь",
                                "target_lang_sense_clarification": "презрительное обозначение простонародья"
                            },
                            {
                                "target_lang_word": "простонародье",
                                "target_lang_sense_clarification": "простые люди, низшие слои общества"
                            },
                            {
                                "target_lang_word": "быдло",
                                "target_lang_sense_clarification": "презрительное обозначение некультурной массы людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "612e992b-1733-3bd5-a97b-8ef31704216d",
                    "sense_definition": "A pack of animals, or any confused collection of things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A noisy <w>rabble</w> of stray dogs roamed the empty streets at night.",
                            "target_lang_translations": {
                                "ru": "Шумная <w>свора</w> бродячих собак бродила ночью по пустым улицам."
                            }
                        },
                        {
                            "text": "The attic was filled with a <w>rabble</w> of old books and broken furniture.",
                            "target_lang_translations": {
                                "ru": "Чердак был забит <w>хламом</w> из старых книг и сломанной мебели."
                            }
                        }
                    ],
                    "synonyms": [
                        "herd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стая животных или беспорядочное скопление вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свора",
                                "target_lang_sense_clarification": "о стае собак или животных"
                            },
                            {
                                "target_lang_word": "груда",
                                "target_lang_sense_clarification": "о беспорядочном скоплении вещей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c09085ee-7a3c-3d4a-bbe0-c2d637492933",
                    "sense_definition": "A bewildered or meaningless string of words.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His feverish speech degenerated into a mere <w>rabble</w> of syllables.",
                            "target_lang_translations": {
                                "ru": "Его лихорадочная речь превратилась в простое <w>бормотание</w> слогов."
                            }
                        },
                        {
                            "text": "I could make no sense of the strange <w>rabble</w> written on the ancient parchment.",
                            "target_lang_translations": {
                                "ru": "Я не мог разобрать ту странную <w>абракадабру</w>, что была написана на древнем пергаменте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессвязный или бессмысленный набор слов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абракадабра",
                                "target_lang_sense_clarification": "бессмысленный набор слов"
                            },
                            {
                                "target_lang_word": "бессвязная речь",
                                "target_lang_sense_clarification": "поток непонятных слов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29b88a48-72c2-3fea-9ad2-152a921b9dab",
                    "sense_definition": "An iron bar or tool used for stirring or scraping molten metal in a puddling furnace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metalworker used a heavy iron <w>rabble</w> to stir the molten iron.",
                            "target_lang_translations": {
                                "ru": "Металлург использовал тяжелый железный <w>гребок</w> для перемешивания расплавленного чугуна."
                            }
                        },
                        {
                            "text": "He carefully placed the hot <w>rabble</w> back onto the rack after clearing the furnace.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно положил горячую <w>мешалку</w> обратно на стеллаж после очистки печи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Железный лом или инструмент для перемешивания или соскабливания расплавленного металла в пудлинговой печи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребок",
                                "target_lang_sense_clarification": "инструмент для перемешивания металла"
                            },
                            {
                                "target_lang_word": "мешалка",
                                "target_lang_sense_clarification": "металлургический инструмент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53ae8389-bfb7-399e-ae6f-3b9383c81e23",
                    "sense_definition": "To speak in a confused, rapid, or incoherent manner; to utter nonsense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened witness began to <w>rabble</w> incoherently when questioned by the police.",
                            "target_lang_translations": {
                                "ru": "Испуганный свидетель начал бессвязно <w>лепетать</w>, когда его допрашивала полиция."
                            }
                        },
                        {
                            "text": "He would often <w>rabble</w> in his sleep when he was having a nightmare.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>бормотал</w> во сне, когда ему снился кошмар."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить сбивчиво, быстро или бессвязно; бормотать чепуху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "говорить невнятно и быстро"
                            },
                            {
                                "target_lang_word": "тараторить",
                                "target_lang_sense_clarification": "говорить быстро и бессвязно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba0dbc69-c6be-32eb-852a-5527f05f62d9",
                    "sense_definition": "To stir or scrape molten metal using a rabble tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metalworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The foundry workers had to <w>rabble</w> the charge continuously to ensure even heating.",
                            "target_lang_translations": {
                                "ru": "Рабочим литейного цеха приходилось непрерывно <w>перемешивать</w> шихту для обеспечения равномерного нагрева."
                            }
                        },
                        {
                            "text": "It requires great physical strength to <w>rabble</w> the molten ore in the furnace.",
                            "target_lang_translations": {
                                "ru": "Требуется большая физическая сила, чтобы <w>грести</w> расплавленную руду в печи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемешивать или соскабливать расплавленный металл с помощью специального инструмента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "мешать расплавленный металл в печи"
                            },
                            {
                                "target_lang_word": "грести",
                                "target_lang_sense_clarification": "сгребать шлак или металл"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}