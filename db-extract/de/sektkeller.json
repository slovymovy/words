                "senses": [
                    {
                        "sense_id": "e6756c20-3516-3171-914e-63494a802351",
                        "entry_id": "6a4f7f13-ef2d-34a5-b10b-6cdf4ec7633b",
                        "glosses": [
                            "Keller, in dem Sekt hergestellt oder gelagert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f5e055-58aa-428e-9f5c-31a8945d1c6f",
                                "sense_id": "e6756c20-3516-3171-914e-63494a802351",
                                "text": "„Die Tour führt in den Sektkeller und bietet einen Einblick in das Handwerk der traditionellen Flaschengärung.“"
                            },
                            {
                                "example_id": "8903ae11-5514-45ad-90b2-5ec537c7057d",
                                "sense_id": "e6756c20-3516-3171-914e-63494a802351",
                                "text": "„Bereits bei Ihrer Anreise erleben Sie eine köstliche Sektverkostung in der bekannten Mainzer Sektkellerei Kupferberg, nachdem Sie einen Blick in die beeindruckenden Sektkeller werfen durften.“"
                            },
                            {
                                "example_id": "563a0e60-518a-43ec-b613-70537a96f4d3",
                                "sense_id": "e6756c20-3516-3171-914e-63494a802351",
                                "text": "„So gab der Betrieb unter anderem Geld aus, um die Strukturen im Großgebinde- und im Sektkeller zu optimieren.“"
                            },
                            {
                                "example_id": "f87a54e0-a417-4be6-820e-41ae82b001ec",
                                "sense_id": "e6756c20-3516-3171-914e-63494a802351",
                                "text": "„Es gibt kleine Fluchtkeller für die bis ins 19. Jahrhundert im Ghetto lebenden Binger Juden, Keller zur Lagerung von Handelswaren, ehemalige Luftschutzkeller, und sogar einen dreistöckigen Sektkeller gibt es noch unter der ehemaligen Sektkellerei Scharlachberg.“"
                            },
                            {
                                "example_id": "88d8a1e1-eb6f-4e8b-8650-5186ea327040",
                                "sense_id": "e6756c20-3516-3171-914e-63494a802351",
                                "text": "„In den tiefsten Sektkellern der Welt, die bis unter den Rheinspiegel reichen, lagern in fast fünf Kilometer langen unterirdischen Gängen rund eine Million Flaschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
