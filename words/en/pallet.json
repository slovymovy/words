{
    "word_family": [
        "palleting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0388f55f-2ea4-39ce-bd42-e7b499753043",
                    "sense_definition": "A portable platform, usually designed to be easily moved by a forklift, on which goods can be stacked, for transport or storage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "platform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warehouse worker loaded the heavy boxes onto a wooden <w>pallet</w>.",
                            "target_lang_translations": {
                                "zh": "仓库工人把沉重的箱子装到了木制<w>托盘</w>上。"
                            }
                        },
                        {
                            "text": "We need to move the <w>pallet</w> of goods to the loading dock.",
                            "target_lang_translations": {
                                "zh": "我们需要把这<w>托盘</w>货物移到装卸码头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden pallet",
                        "load a pallet"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通常用于叉车搬运的便携式平台，用于堆放货物以便运输或储存。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "托盘",
                                "target_lang_sense_clarification": "物流和仓储中用于堆放货物的标准平台。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80cb9df9-b019-3fad-bacf-9f5bb36bc701",
                    "sense_definition": "A simple or makeshift bed, often made of straw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler slept on a thin <w>pallet</w> on the cold floor.",
                            "target_lang_translations": {
                                "zh": "旅行者睡在冰冷地板上的一张薄<w>草垫床</w>上。"
                            }
                        },
                        {
                            "text": "He rested his weary body on a straw <w>pallet</w> in the corner.",
                            "target_lang_translations": {
                                "zh": "他疲惫地躺在角落里的稻<w>草垫床</w>上休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cot",
                        "bed"
                    ],
                    "common_phrases": [
                        "straw pallet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种简陋的床铺，通常由稻草制成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "草垫床",
                                "target_lang_sense_clarification": "文学或历史语境中指代简陋的临时床铺。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70f5f5a5-2845-3b01-9d31-c4e037fccab5",
                    "sense_definition": "An archaic form of <w>palette</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist held his <w>pallet</w> while mixing colors for the portrait.",
                            "target_lang_translations": {
                                "zh": "艺术家在为肖像画调色时手里拿着<w>调色板</w>。"
                            }
                        },
                        {
                            "text": "He cleaned his <w>pallet</w> after finishing the painting.",
                            "target_lang_translations": {
                                "zh": "画完画后，他清理了自己的<w>调色板</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "palette"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the spelling variant of palette."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "调色板的古旧拼写形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "调色板",
                                "target_lang_sense_clarification": "画家调配颜料的工具。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31a3c21d-c2b1-398f-8c39-5af7ca14ef22",
                    "sense_definition": "To load or stack goods onto pallets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team will <w>pallet</w> the inventory before shipping it out.",
                            "target_lang_translations": {
                                "zh": "团队会在发货前将库存<w>装托盘</w>。"
                            }
                        },
                        {
                            "text": "It is easier to <w>pallet</w> these items for efficient transport.",
                            "target_lang_translations": {
                                "zh": "为了高效运输，将这些物品<w>装托盘</w>会更容易。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pallet goods"
                    ],
                    "target_lang_definitions": {
                        "zh": "将货物装载或堆叠到托盘上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "装托盘",
                                "target_lang_sense_clarification": "物流作业中将货物码放至托盘上的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}