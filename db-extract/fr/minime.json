                "forms": [
                    {
                        "form_id": "bcb6203e-01ba-4d5b-8849-11f226d3da1c",
                        "entry_id": "50414414-2ea0-3405-86ee-20ba63104cea",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "minimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a58890c9-a266-35ef-a3c7-5af9df4f5e86",
                        "entry_id": "50414414-2ea0-3405-86ee-20ba63104cea",
                        "glosses": [
                            "Qui est très petit, très peu considérable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a56719-dabb-4ffa-9ddc-d492b239afc3",
                                "sense_id": "a58890c9-a266-35ef-a3c7-5af9df4f5e86",
                                "text": "Aussi, dès qu'un paysan a réalisé une minime aisance , fait-il badigeonner d’ocre la façade et les murs intérieurs de son réduit : […]."
                            },
                            {
                                "example_id": "9a3a1b01-d092-41a6-8d8e-5005077cb4c4",
                                "sense_id": "a58890c9-a266-35ef-a3c7-5af9df4f5e86",
                                "text": "Ce dernier conservera toujours sa valeur pour la culture intensive ; les scories Thomas, grâce au bon marché de leur acide phosphorique, doivent servir seulement à l'amélioration des grandes étendues des sols de minime valeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba9517a2-e7d2-3e03-af28-1e2d918fa7b5",
                        "entry_id": "50414414-2ea0-3405-86ee-20ba63104cea",
                        "glosses": [
                            "Qui concerne, qui se rapporte à l’ordre religieux des Minimes fondé par François de Paule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41ca0d2-16be-4ddc-8348-4556906d1247",
                                "sense_id": "ba9517a2-e7d2-3e03-af28-1e2d918fa7b5",
                                "text": "Pédagogue et maître spirituel, le religieux minime Nicolas Barré (1621-1686) œuvra pour l’éducation de nombreux enfants défavorisés du \"grand siècle\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ffd80a4-ecb5-49c0-8bd4-9a8d7fd7633d",
                        "source_entry_id": "50414414-2ea0-3405-86ee-20ba63104cea",
                        "target_lang_word": "minimal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "823318a2-cd69-3e66-8ea3-108ad2d89c8e",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "The smallest possible amount, quantity, or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fc2eb5-abf4-4571-a4e9-3be8dca5152d",
                                                "sense_id": "823318a2-cd69-3e66-8ea3-108ad2d89c8e",
                                                "text": "With minimal effort, you won't be able to achieve all your dreams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d12106e-453c-3919-b4ee-c07f4ae50469",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "The smallest possible amount, quantity, or degree.",
                                            "Among elements of some collection, such that no other element is greater (with respect to some given partial order)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bb7921-b96c-4650-a87d-d09bad1bc054",
                                                "sense_id": "6d12106e-453c-3919-b4ee-c07f4ae50469",
                                                "text": "With respect to the ordering induced by set-theoretic inclusion, the power set of the set of natural numbers has a unique minimal element: the empty set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f901ccb6-0c0a-3c17-8e51-402edec0274c",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "Characterised by the use of simple form or structures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efce4a22-e73e-3f55-abe8-f061b3ee68dd",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "Characterised by the repetition and gradual alteration of short phrases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "minimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "504a6ea9-c63a-3304-96b9-78dd2b2bc03f",
                                        "entry_id": "ad306f45-a6da-35ad-bedd-5a0698ca6c24",
                                        "glosses": [
                                            "Something very small; a tiny part or fragment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9288d79-520d-4f98-afe5-66c331fbf84e",
                                                "sense_id": "504a6ea9-c63a-3304-96b9-78dd2b2bc03f",
                                                "text": "[…] we seek in explaining mental phenomena and behavior always the \"minimals,\" the little fragments of association, on which the mind is (passively) supposed to be based."
                                            },
                                            {
                                                "example_id": "92528e40-ec28-4440-b2c8-0f4042cc6be4",
                                                "sense_id": "504a6ea9-c63a-3304-96b9-78dd2b2bc03f",
                                                "text": "[…] identifications with birds, fish, trees, and flowers (and occasionally as relief, with the stillness of rocks, clam shells, driftwood, and nature's minimals); […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
