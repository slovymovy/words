                "senses": [
                    {
                        "sense_id": "72b30529-3534-39df-9f86-ed36bd251318",
                        "entry_id": "09e30bdd-5292-3f0c-a1db-bf03392cebf4",
                        "glosses": [
                            "alternative Form des Wehrdienstes (an der Waffe)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb801cb-1172-4f76-a087-7e6d0195d6d5",
                                "sense_id": "72b30529-3534-39df-9f86-ed36bd251318",
                                "text": "„Nach dem Gesetz über den zivilen Ersatzdienst werden vom zivilen Ersatzdienst Aufgaben durchgeführt, die dem Allgemeinwohl dienen.“"
                            },
                            {
                                "example_id": "b0a7d70a-38b4-4492-9219-4e3c88fb5f4a",
                                "sense_id": "72b30529-3534-39df-9f86-ed36bd251318",
                                "text": "„In Art. 12 Abs. 2 heißt es u. a. : Wer aus Gewissensgründen den Kriegsdienst mit der Waffe verweigert, kann zu einem Ersatzdienst verpflichtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
