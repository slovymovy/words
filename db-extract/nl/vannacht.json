                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06232047-e395-3479-9d99-0b07f27439b6",
                        "entry_id": "b272e8f7-bfec-33c7-b911-f21cc7cea06c",
                        "glosses": [
                            "de komende nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6fa5ae-df96-44f6-be13-eec91dc72b6b",
                                "sense_id": "06232047-e395-3479-9d99-0b07f27439b6",
                                "text": "Ze verwachten voor vannacht zware vorst."
                            },
                            {
                                "example_id": "73a784d7-941a-43d9-b2ef-a3c86bc231bf",
                                "sense_id": "06232047-e395-3479-9d99-0b07f27439b6",
                                "text": "‘Storm? Vannacht? Nee, maak je geen zorgen.’ Na deze geruststellende woorden trokken we ons ieder terug in onze eigen tent."
                            },
                            {
                                "example_id": "bf40f8d8-816c-4787-97b7-9a4b89ff3335",
                                "sense_id": "06232047-e395-3479-9d99-0b07f27439b6",
                                "text": "De ongeveer 18.000 supporters die terugkwamen vanuit De Kuip zorgden vannacht nog wel voor grote drukte op de wegen richting Deventer. Volgens De Stentor stond het op en rondom een bedrijventerrein langs de A1 om 01.00 uur nog muurvast."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3e3e2d2-669d-3fde-9c00-3f7afae81798",
                        "entry_id": "b272e8f7-bfec-33c7-b911-f21cc7cea06c",
                        "glosses": [
                            "de afgelopen nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768c014c-2712-4a84-89f6-40457f5afa86",
                                "sense_id": "e3e3e2d2-669d-3fde-9c00-3f7afae81798",
                                "text": "Er is vannacht ingebroken bij de buren."
                            }
                        ]
                    }
                ],
