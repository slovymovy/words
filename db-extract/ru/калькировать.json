                    {
                        "translation_id": "51897f82-6fae-49cb-a9ea-14603ca0e17e",
                        "source_entry_id": "066a7946-e18a-38ef-ab73-e5440540530a",
                        "source_sense_description": "делать (сделать) копию",
                        "target_lang_word": "durchpausen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchpausen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a896afd8-2100-39d8-8c39-d1553eedd568",
                                        "entry_id": "bbd61aa0-ad90-3f4f-a454-02de4cc9f88a",
                                        "glosses": [
                                            "ein Abbild (eine Pause) schaffen, indem auf einem drüberliegenden, durchsichtigen Stück Papier die drunterliegende Vorlage nachgezeichnet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a72464-1fd9-4dac-bf40-8db85977da90",
                                                "sense_id": "a896afd8-2100-39d8-8c39-d1553eedd568",
                                                "text": "Sie versuchte, die Unterschrift des Vaters durchzupausen."
                                            },
                                            {
                                                "example_id": "58016338-044e-488e-a1ff-22982b08c61c",
                                                "sense_id": "a896afd8-2100-39d8-8c39-d1553eedd568",
                                                "text": "„Zum Durchpausen wird das Stroh- oder Oel-Papier glatt auf das Original gelegt und an den Ecken mit etwas Mundleim oder Wachs befestigt.“"
                                            },
                                            {
                                                "example_id": "809a1ac7-fddb-4df1-8922-f7415d22b95e",
                                                "sense_id": "a896afd8-2100-39d8-8c39-d1553eedd568",
                                                "text": "„Natürlich schuf auch die Einbindung der Region in das zentralistisch-sozialistische Staats- und Wirtschaftsgefüge der polnischen Volksrepublik neue Konstituenten, die sich auch auf die Siedlungsgenese im Kleinen durchpausten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b7a0be3-ac93-4f66-aa90-3b6d0f9fd3b0",
                        "source_entry_id": "066a7946-e18a-38ef-ab73-e5440540530a",
                        "source_sense_description": "делать (сделать) копию",
                        "target_lang_word": "calquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d14d64aa-9e19-38d9-acaf-37f2237a9ba6",
                                        "entry_id": "935b5c86-5336-3933-a1e0-625b890823c0",
                                        "glosses": [
                                            "Relever par transparence, ou en suivant le relief d'une gravure, les traits d’un dessin en suivant exactement ses contours avec une pointe, une plume ou un crayon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3eb6168-d34e-4359-9fe0-c1f342afd2f1",
                                                "sense_id": "d14d64aa-9e19-38d9-acaf-37f2237a9ba6",
                                                "text": "Calquer à la pointe, à la vitre, à la gélatine."
                                            },
                                            {
                                                "example_id": "8c0c31bc-ed45-4147-8f88-371133cecb64",
                                                "sense_id": "d14d64aa-9e19-38d9-acaf-37f2237a9ba6",
                                                "text": "Calquer une estampe, un plan."
                                            },
                                            {
                                                "example_id": "9bfcb3d1-ec48-4fa8-84e3-edf75fc25c9b",
                                                "sense_id": "d14d64aa-9e19-38d9-acaf-37f2237a9ba6",
                                                "text": "Calquer une lettre pour en faire le fac-similé, etc."
                                            },
                                            {
                                                "example_id": "d51dd9b1-e8f2-4570-8139-b19caae553b6",
                                                "sense_id": "d14d64aa-9e19-38d9-acaf-37f2237a9ba6",
                                                "text": "Tu te mets sur la vitre de la fenêtre, par transparence tu calques ton dessin sur l’autre page. Tu fais gaffe à calquer juste au poil, sans ça ça va trembler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb04ad0-2f88-31d4-95b4-e6454e76e249",
                                        "entry_id": "935b5c86-5336-3933-a1e0-625b890823c0",
                                        "glosses": [
                                            "Imiter avec une exactitude servile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c3bc90-504d-45df-8954-487c02891c5e",
                                                "sense_id": "0cb04ad0-2f88-31d4-95b4-e6454e76e249",
                                                "text": "Tout dans cet ouvrage est calqué."
                                            },
                                            {
                                                "example_id": "17f6e3d8-8403-46ad-83ff-ab22d194ca92",
                                                "sense_id": "0cb04ad0-2f88-31d4-95b4-e6454e76e249",
                                                "text": "Cet auteur calque et ne crée pas."
                                            },
                                            {
                                                "example_id": "9c9d01b1-de4d-4d59-9616-af7bf5a9cc6c",
                                                "sense_id": "0cb04ad0-2f88-31d4-95b4-e6454e76e249",
                                                "text": "Elle nourrit les passions de personnes généralement peu éduquées, et au jugement vacillant, qui viennent jusque dans ces pages tenter de défendre l’indéfendable, avec une assurance qu’ils calquent sur les poses théâtrales de Trump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ef912d-37a1-3ff9-a448-b9a9b794fb3d",
                                        "entry_id": "935b5c86-5336-3933-a1e0-625b890823c0",
                                        "glosses": [
                                            "Emprunter comme un calque par traduire littéralement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52df0bd0-1c77-474c-8bcf-7364ebd7b44e",
                                                "sense_id": "f6ef912d-37a1-3ff9-a448-b9a9b794fb3d",
                                                "text": "Si le terme année fiscale, calqué sur l’anglais fiscal year, a longtemps été utilisé dans la langue administrative, il est remplacé depuis deux décennies par le terme année financière aussi bien dans la documentation du gouvernement du Québec que dans celle d’Ottawa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95840322-7048-4cb7-98a9-6bab440135f8",
                        "source_entry_id": "066a7946-e18a-38ef-ab73-e5440540530a",
                        "source_sense_description": "создавать (создать) кальку иноязычного слова или выражения",
                        "target_lang_word": "calque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd7dcc1-0692-3a75-be12-8f6499b7eee4",
                                        "entry_id": "ba13fc45-cc69-3bd2-8cec-336bd461d1b3",
                                        "glosses": [
                                            "A word or phrase in a language formed by word-for-word or morpheme-by-morpheme translation of a word in another language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6930a94d-cf11-4e15-ae8a-7025ea675b7d",
                                                "sense_id": "1fd7dcc1-0692-3a75-be12-8f6499b7eee4",
                                                "text": "David S. Powers, professor of Islamic history and law at Cornell, says he thinks that the word as used today is in the nature of what linguists call a calque, a borrowing from another language in literal translation […]"
                                            },
                                            {
                                                "example_id": "7420839a-aa29-43b1-87f8-175876c50794",
                                                "sense_id": "1fd7dcc1-0692-3a75-be12-8f6499b7eee4",
                                                "text": "Those phrases, translated from Spanish, are known as calques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "450ea817-4129-373e-ac73-4735cbafa30e",
                                        "entry_id": "f2776b1f-9659-34f6-90d0-b5096add74e0",
                                        "glosses": [
                                            "To adopt (a word or phrase) from one language to another by semantic translation of its parts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db6c554-48fe-4123-9ff7-012af8d2fdd5",
                                                "sense_id": "450ea817-4129-373e-ac73-4735cbafa30e",
                                                "text": "Terms like \"cloud computing\" have been calqued into multiple languages, making it easier for global audiences to grasp complex technological concepts. […] For example, translating Shakespeare's works into other languages often involves calquing phrases to maintain the rhythm and metaphorical richness of the original."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
