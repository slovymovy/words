                {
                    "sense_id": "6b5221e9-0243-3dc8-9d93-eaf75649ae6f",
                    "sense_definition": "To pull sharply or repeatedly at something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little child began to <w>tug</w> at his mother's sleeve to get her attention.",
                            "target_lang_translations": {
                                "ru": "Маленький ребенок стал <w>дёргать</w> маму за рукав, чтобы привлечь её внимание.",
                                "zh": "小孩子开始<w>拽</w>妈妈的袖子以引起她的注意。",
                                "pl": "Małe dziecko zaczęło <w>szarpać</w> mamę za rękaw, żeby zwrócić na siebie uwagę.",
                                "cs": "Malé dítě začalo <w>škubat</w> matku za rukáv, aby upoutalo její pozornost."
                            }
                        },
                        {
                            "text": "She felt the dog <w>tug</w> at the leash during their evening walk.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как собака <w>потянула</w> за поводок во время вечерней прогулки.",
                                "zh": "晚间散步时，她感觉到狗在<w>扯</w>牵引绳。",
                                "pl": "Podczas wieczornego spaceru poczuła, jak pies <w>szarpie</w> smycz.",
                                "cs": "Během večerní procházky cítila, jak pes <w>tahá</w> za vodítko."
                            }
                        }
                    ],
                    "synonyms": [
                        "yank",
                        "pluck"
                    ],
                    "common_phrases": [
                        "tug at",
                        "tug on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко или неоднократно дёргать за что-либо.",
                        "zh": "反复或猛烈地拽动。",
                        "pl": "Szarpnąć lub pociągnąć coś gwałtownie lub wielokrotnie.",
                        "cs": "Cuknout nebo opakovaně za něco tahat."
                    },
                    "translations": {
