                ],
                "senses": [
                    {
                        "sense_id": "e7c2dbc0-997d-33d1-8a50-6bd134ba2f89",
                        "entry_id": "315337eb-8b42-334a-82b1-8159f941cefa",
                        "glosses": [
                            "Ordnungsschema, nach dem gleichartige Spiele klassifiziert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "362ca7bf-02f3-4a57-b3a8-5d5ce606c56f",
                                "sense_id": "e7c2dbc0-997d-33d1-8a50-6bd134ba2f89",
                                "text": "„Die meisten, die die Bühlerschen Spielkategorien übernahmen, haben die Rezeptionsspiele unterschlagen.“"
                            },
                            {
                                "example_id": "707b1eef-6cb8-40d4-9b9a-58f4021a417a",
                                "sense_id": "e7c2dbc0-997d-33d1-8a50-6bd134ba2f89",
                                "text": "„Übung, Symbol und Regel scheinen also die drei aufeinanderfolgenden Etappen zu sein, die die großen Kategorien der Spiele charakterisieren.“"
                            },
                            {
                                "example_id": "f34dde82-2c45-4fe4-b890-6007756a9e3b",
                                "sense_id": "e7c2dbc0-997d-33d1-8a50-6bd134ba2f89",
                                "text": "„Der nicht immer sichere Instinkt der Spielenden für das anderen Zumutbare […] machen diese Spielkategorie zu der umstrittensten überhaupt.“"
                            },
                            {
                                "example_id": "3f17ee53-64a7-4ece-835d-1d762708a444",
                                "sense_id": "e7c2dbc0-997d-33d1-8a50-6bd134ba2f89",
                                "text": "„Beide Spielkategorien betrifft der unverzeihliche Denkfehler, dass nicht zwischen den verschiedenen Deutungsebenen, zwischen der Realebene von Krieg oder Frieden und der Symbolebene des Spiels, auf der andere Regeln und Gesetze gelten, unterschieden wird.“"
                            },
                            {
                                "example_id": "c37c6b7a-d451-4472-8ed1-4f528c96f87c",
                                "sense_id": "e7c2dbc0-997d-33d1-8a50-6bd134ba2f89",
                                "text": "„Innerhalb der geregelten Spiele […] unterscheidet Chateau zwei weitere Spielkategorien, deren weitere Unterteilungen hier nur insoweit dargestellt werden sollen, als sie für die Entwicklung bis zum Übergang zum Vorschulalter von Bedeutung sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
