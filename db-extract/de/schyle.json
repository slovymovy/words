                ],
                "senses": [
                    {
                        "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                        "entry_id": "8a6118fa-26b1-3200-b7f2-06bc0db233d5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9759c40c-e304-4610-ac54-2e653f9faff1",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Frau Schyle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4e17f057-52eb-42ea-96e0-eaa9808f5207",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Herr Schyle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2ec7d72e-8016-4427-8594-651a2cf2bd80",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Die Schyles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2f46c918-730d-4930-ad4b-fef3ee651dde",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Der Schyle trägt nie die Schals, die die Schyle ihm strickt."
                            },
                            {
                                "example_id": "75f9d3b0-c51e-4256-b0fb-2bb07f5bba12",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schyle kommt, geht der Herr Schyle.“"
                            },
                            {
                                "example_id": "bdcc075d-b382-495f-b71c-229448784c90",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Schyle kommt und geht."
                            },
                            {
                                "example_id": "e7c178ee-bb2e-4d16-b69f-505fa6aa22eb",
                                "sense_id": "ab7fc31c-1346-3cbe-9604-57a7f3c308f6",
                                "text": "Schyles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
