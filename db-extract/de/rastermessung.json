                ],
                "senses": [
                    {
                        "sense_id": "40912239-64c4-3d47-81c4-28365e379f7c",
                        "entry_id": "39ee139c-45e6-3a54-b5c3-715167d28e09",
                        "glosses": [
                            "Messungen in einem Rastersystem"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "6db1a681-f268-42a3-a2c9-2e15b2682347",
                                "sense_id": "40912239-64c4-3d47-81c4-28365e379f7c",
                                "text": "„Die Rastermessung dient zur Ermittlung der Geruchsimmissionsbelastung in Gebieten, in denen Personen wohnen oder sich nicht nur vorübergehend aufhalten.“"
                            },
                            {
                                "example_id": "3127fe14-9d21-4221-8e08-50a236d381cc",
                                "sense_id": "40912239-64c4-3d47-81c4-28365e379f7c",
                                "text": "„Bei Rastermessungen werden die meteorologischen Daten außerdem benötigt, um die Bedingungen während der Begehungstermine mit den langfristigen aufgezeichneten Wetterdaten von Wetterdiensten vergleichen und auf Repräsentativität prüfen zu können.“"
                            },
                            {
                                "example_id": "684436c6-fc29-44f5-871d-32590d7883cc",
                                "sense_id": "40912239-64c4-3d47-81c4-28365e379f7c",
                                "text": "„Die Rastermessung ist ein statistisches Erhebungsverfahren, bei dem über einen bestimmten Zeitraum (z.B. sechs Monate) Prüfer an Rasterkreuzungspunkten im Beurteilungsgebiet nach bestimmten Verfahrensregeln Geruchswahrnehmungen aufzeichnen.“"
                            },
                            {
                                "example_id": "7ef64700-d0c5-40c8-b9a0-3348d6cb6c7f",
                                "sense_id": "40912239-64c4-3d47-81c4-28365e379f7c",
                                "text": "„Die Rastermessung und die Fahnenmessung sind in den VDI 3940 Bl. 2 und VDI 3940 Bl. 2 jeweils detailliert beschrieben.“"
                            },
                            {
                                "example_id": "5f919d87-24f4-46c9-b4f9-85de60418e87",
                                "sense_id": "40912239-64c4-3d47-81c4-28365e379f7c",
                                "text": "„Mit der Rasterfahnenmessung wurde eine Systematik entwickelt, mit der - gegenüber der Rastermessung - durch eine wesentlich geringere Zahl von Begehungen Geruchsimmissionen vor Ort gemessen und für Jahresprognosen verwendet werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
