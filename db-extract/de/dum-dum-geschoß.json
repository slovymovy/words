                "senses": [
                    {
                        "sense_id": "4fca173d-8f07-30d6-ab9b-070b625f0c97",
                        "entry_id": "b7eb9398-70a4-37b5-9098-750f0c7ec285",
                        "glosses": [
                            "Geschoß mit abgesägter Spitze und offen liegendem Bleikern, das fürchterliche Verletzungen verursacht"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "87e1f906-5c10-43e2-be70-953b4621fc34",
                                "sense_id": "4fca173d-8f07-30d6-ab9b-070b625f0c97",
                                "text": "„Ob Nader durch eine Spitzhacke oder ein sogenanntes Dum-Dum-Geschoß getötet wurde, ist bis heute unklar.“"
                            },
                            {
                                "example_id": "603a66fd-ba73-4d74-aaf5-8e4497d7b699",
                                "sense_id": "4fca173d-8f07-30d6-ab9b-070b625f0c97",
                                "text": "„Das Dum-Dum-Geschoß hatte das Rückgrat gestreift und das Fell handbreit weggerissen – das Fell war wertlos.“"
                            },
                            {
                                "example_id": "2e6f591a-b7b7-4602-b6a6-2c5c20c11d7f",
                                "sense_id": "4fca173d-8f07-30d6-ab9b-070b625f0c97",
                                "text": "„Sehen Sie nur: Genau in der Helmspitze sitzt ein Dum-Dum-Geschoß … Ne, – sitzen tut sie irgendwo dort im Humus.“"
                            },
                            {
                                "example_id": "3e897fd3-6a20-498b-b350-9c91f0b93b26",
                                "sense_id": "4fca173d-8f07-30d6-ab9b-070b625f0c97",
                                "text": "„Er schüttelt den Kopf: »Ein Dum-Dum-Geschoß offenbar. Wird lange dauern –« sagt er ganz leise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
