                ],
                "senses": [
                    {
                        "sense_id": "e072f296-e25d-3df7-ac0c-7573f2680c81",
                        "entry_id": "63cddd2e-c62d-3e4f-bbd5-422da07cc83b",
                        "glosses": [
                            "een noot met de lengte van 1 tel, een noot met een lengte die een vierde is van een hele noot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0e8785-1f3f-4ae8-83dd-d63875e915e6",
                                "sense_id": "e072f296-e25d-3df7-ac0c-7573f2680c81",
                                "text": "Asma was niet alleen royaal met aantekeningen, ook met het schrappen van noten in partituren van anderen. Zwart: „Hij streepte gerust een pedaalsolo in een toccata van Krebs weg of verving zestiendenoten in een orgelconcert van Händel door kwartnoten."
                            },
                            {
                                "example_id": "6c9b2d1d-6158-4be2-b236-8554dbdf461a",
                                "sense_id": "e072f296-e25d-3df7-ac0c-7573f2680c81",
                                "text": "Een van de ergste ontwikkelingen in de muziek is het vak solfège, waarin je leert om precies uit te voeren wat er staat. Maar niet elke kwartnoot is even lang, dat hangt maar net van de zinsbouw af. Vergelijk het met het reciteren van poëzie.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0eb82c1-93d8-4009-ab67-cfcac16fbe41",
                        "source_entry_id": "63cddd2e-c62d-3e4f-bbd5-422da07cc83b",
                        "source_sense_id": "e072f296-e25d-3df7-ac0c-7573f2680c81",
                        "target_lang_word": "crotchet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crotchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "330c42db-641e-3d38-be76-d354fefb4e00",
                                        "entry_id": "85631ffa-c12b-31c2-834b-ce2437e8c0f5",
                                        "glosses": [
                                            "A musical note one beat long in 4/4 time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0dabcf-6ba9-4731-80a2-64bb972d70f0",
                                                "sense_id": "330c42db-641e-3d38-be76-d354fefb4e00",
                                                "text": "The crotchets and quavers are dancing up and down the stave like little black boys on a fence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c78ff57f-2f26-3622-a2e7-3a173e7484e9",
                                        "entry_id": "85631ffa-c12b-31c2-834b-ce2437e8c0f5",
                                        "glosses": [
                                            "A sharp curve or crook; a shape resembling a hook"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "126cb7fc-6e31-334c-8422-14286bbc3057",
                                        "entry_id": "85631ffa-c12b-31c2-834b-ce2437e8c0f5",
                                        "glosses": [
                                            "A hook-shaped instrument, especially as used in obstetric surgery."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c87d9bed-6848-4898-835b-5f86cf31e9cc",
                                                "sense_id": "126cb7fc-6e31-334c-8422-14286bbc3057",
                                                "text": "Either Doctor Denman or an old Woman would have waited—but since the horrid death-doing Crotchet has been found out, & its use permitted—Oh! many & many a Life has been flung away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb48a61-7305-32f9-85c9-b12483ae18a4",
                                        "entry_id": "85631ffa-c12b-31c2-834b-ce2437e8c0f5",
                                        "glosses": [
                                            "A whim or a fancy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0620157e-2e8d-4f16-b8cc-1b937240ac70",
                                                "sense_id": "9eb48a61-7305-32f9-85c9-b12483ae18a4",
                                                "text": "Thou who walkest in a vain shew, looking out with ornamental dilettante sniff and serene supremacy at all Life and all Death; and amblest jauntily; perking up thy poor talk into crotchets, thy poor conduct into fatuous somnambulisms; [...] dost thou call that \"liberty!\""
                                            },
                                            {
                                                "example_id": "cf9bcd52-0632-4eef-b2da-90a5093630d6",
                                                "sense_id": "9eb48a61-7305-32f9-85c9-b12483ae18a4",
                                                "text": "He ruined himself and all that trusted in him by crotchets that he could never explain to any rational man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e73aae2-1a0d-3289-a306-f757ba46c310",
                                        "entry_id": "85631ffa-c12b-31c2-834b-ce2437e8c0f5",
                                        "glosses": [
                                            "A forked support; a crotch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02c11a5-c8cf-4b6d-b77b-87a540aa4dec",
                                                "sense_id": "4e73aae2-1a0d-3289-a306-f757ba46c310",
                                                "text": "Their little Shed, ſcarce large enough for Two, / Seems, from the Ground increas'd, in Height and Bulk to grow. / A ſtately Temple ſhoots within the Skies, / The Crotchets of their Cot in Columns riſe: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b91eb75-64c1-3f67-bf60-8b47455149a1",
                                        "entry_id": "85631ffa-c12b-31c2-834b-ce2437e8c0f5",
                                        "glosses": [
                                            "An indentation in the glacis of the covered way, at a point where a traverse is placed."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
