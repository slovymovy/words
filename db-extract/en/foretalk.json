                        "glosses": [
                            "A foreword; preface."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6a017533-aa85-4d0c-bf75-f4fc860c95d1",
                                "sense_id": "a65bedea-36e4-381e-aa92-c5158b4519af",
                                "text": "But before reading the poems, we look at the preface — it is rude to skip the preface, the little, private, confidential foretalk the author wishes to have with the reader […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "8d491b13-c4a0-3839-8ba9-1cbcabc6db72",
                        "entry_id": "12cefa6e-859e-3e98-8fdd-1ea11910705a",
                        "glosses": [
                            "Small talk used prior to more meaningful conversation."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d42ea86a-abf9-417b-b0f8-ff8adf40132e",
                                "sense_id": "8d491b13-c4a0-3839-8ba9-1cbcabc6db72",
                                "text": "He goes on, \"The most feminine error during the period of foretalk is to subject her partner to withering cross-examination.\""
                            },
                            {
                                "example_id": "696fd7ca-a9af-4927-b2c3-cbc508d299a2",
                                "sense_id": "8d491b13-c4a0-3839-8ba9-1cbcabc6db72",
                                "text": "In determining whether the male is ready for conversation, the woman should not hesitate to employ the delicate techniques of foretalk."
                            }
                        ]
                    }
