                ],
                "senses": [
                    {
                        "sense_id": "7944a28a-f58a-3722-84aa-6cbf61a0ac44",
                        "entry_id": "57e027c5-455c-3396-8916-b227218b0527",
                        "glosses": [
                            "Gerät zum Klingeln an einer Haus- oder Wohnungstür"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ea5c9351-4765-4863-88a6-31e01eb49a89",
                                "sense_id": "7944a28a-f58a-3722-84aa-6cbf61a0ac44",
                                "text": "„Der einschreitende Gendarmeriebeamte habe sodann an der Balkontüre und am südseitigen Fenster der Wohnung des Beschwerdeführers Blutspuren entdeckt und habe durch Läuten an der Türglocke, Klopfen und Rufen den Beschwerdeführer zum Aufmachen der Wohnungstüre zu bewegen versucht.“"
                            },
                            {
                                "example_id": "52091e87-13b6-43e0-98e8-e14140ab11fd",
                                "sense_id": "7944a28a-f58a-3722-84aa-6cbf61a0ac44",
                                "text": "„Ihr Auto hielt vor der Gitterpforte und war im nächsten Augenblick wieder verschwunden, und sie standen auf der Hausschwelle, den Finger an der Türglocke, und ich öffnete und ließ sie eintreten.“"
                            },
                            {
                                "example_id": "bb739896-bfb8-4f59-8666-65adee05d1f5",
                                "sense_id": "7944a28a-f58a-3722-84aa-6cbf61a0ac44",
                                "text": "„In diesem Moment schrillte die Türglocke.“"
                            },
                            {
                                "example_id": "b2c03df9-6e56-497a-96a3-694fad81c1f0",
                                "sense_id": "7944a28a-f58a-3722-84aa-6cbf61a0ac44",
                                "text": "„Mir ist nie so richtig klar geworden, warum Tante Amalia eine Türglocke mit dem Läuten von Big Ben installiert hatte, ein unseliges Gebimmel, wenn man es mehrmals die Woche hören muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
