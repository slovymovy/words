                        {
                            "text": "Veel mensen hebben <w>tegenwoordig</w> een mobiele telefoon.",
                            "target_lang_translations": {
                                "en": "Many people have a mobile phone <w>nowadays</w>.",
                                "ru": "У многих людей <w>в наши дни</w> есть мобильный телефон.",
                                "fr": "Beaucoup de gens ont <w>de nos jours</w> un téléphone portable.",
                                "pl": "Wiele osób ma <w>obecnie</w> telefon komórkowy.",
                                "de": "Viele Menschen haben <w>heutzutage</w> ein Mobiltelefon.",
                                "it": "Molte persone <w>al giorno d'oggi</w> hanno un telefono cellulare.",
                                "cs": "Mnoho lidí má <w>v dnešní době</w> mobilní telefon.",
                                "tr": "Birçok insanın <w>günümüzde</w> bir cep telefonu var.",
                                "es": "Muchas personas tienen <w>hoy en día</w> un teléfono móvil.",
                                "zh": "<w>如今</w>很多人都有手机。"
                            }
                        },
                        {
                            "text": "Ik begrijp al die haast van <w>tegenwoordig</w> niet.",
                            "target_lang_translations": {
                                "en": "I don't understand all this hurry of <w>today</w>.",
                                "ru": "Я не понимаю всей этой <w>нынешней</w> спешки.",
                                "fr": "Je ne comprends pas toute cette précipitation <w>actuelle</w>.",
                                "pl": "Nie rozumiem całego tego pośpiechu <w>dzisiejszych czasów</w>.",
                                "de": "Ich verstehe all diese Eile von <w>heute</w> nicht.",
                                "it": "Non capisco tutta questa fretta <w>di oggi</w>.",
                                "cs": "Nerozumím všemu tomu dnešnímu spěchu.",
                                "tr": "<w>Günümüzün</w> tüm bu aceleciliğini anlamıyorum.",
                                "es": "No entiendo toda esta prisa <w>actual</w>.",
                                "zh": "我不理解<w>当今</w>社会为什么总是这么匆忙。"
                            }
                        }
                    ],
