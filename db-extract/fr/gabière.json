                "senses": [
                    {
                        "sense_id": "55436c08-7c85-3fa1-9a30-c94d040340c3",
                        "entry_id": "a8fcded1-e801-35a5-b852-c01d84c11f41",
                        "glosses": [
                            "Matelote qui monte dans les hunes et qui est chargée spécialement de manœuvrer les voiles et d’entretenir le gréement."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "b9a4d431-0fa9-49ce-a5c1-13bd00eca8cd",
                                "sense_id": "55436c08-7c85-3fa1-9a30-c94d040340c3",
                                "text": "Sabine Leblond, 32 ans, responsable export rouennaise, s’apprête à vivre l’aventure de gabière sur l’Hermione."
                            },
                            {
                                "example_id": "ddb6ee4e-dbce-4e03-bce5-f44e0247c928",
                                "sense_id": "55436c08-7c85-3fa1-9a30-c94d040340c3",
                                "text": "Parmi la soixantaine de volontaires dans l’équipage de l’Hermione, certains sont très jeunes et n’avaient alors jamais navigué avant d’embarquer fin juin, comme Adèle Hedde, 21ans. Cette gabière volontaire revient sur son expérience."
                            },
                            {
                                "example_id": "380c06e2-f131-4b94-b02c-ae0b2bd88f59",
                                "sense_id": "55436c08-7c85-3fa1-9a30-c94d040340c3",
                                "text": "Accompagnés d’Arnaud Stahl, conseiller en insertion sociale et professionnelle, ils ont été pris en main par Pauline, jeune gabière sur le trois-mâts et intarissable guide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e67366d-969d-406d-aee8-bf602518dc93",
                        "source_entry_id": "a8fcded1-e801-35a5-b852-c01d84c11f41",
                        "source_sense_id": "55436c08-7c85-3fa1-9a30-c94d040340c3",
                        "target_lang_word": "topman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93352767-6c6d-389b-994e-5f13a512ac60",
                                        "entry_id": "81c056b5-f949-3cc2-94ce-9ba219a5a90d",
                                        "glosses": [
                                            "The man stationed in the top on a sailing vessel, responsible for the setting of the sails"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d2f4d9-b7d5-4ea9-ab13-383a335e0be9",
                                                "sense_id": "93352767-6c6d-389b-994e-5f13a512ac60",
                                                "text": "There, when not actually engaged on the yards yet higher aloft, the topmen, who as such had been picked out for youth and activity, constituted an aerial club lounging at ease against the smaller stun'sails rolled up into cushions, spinning yarns like the lazy gods, and frequently amused with what was going on in the busy world of the decks below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4bc8e0c-eb40-3e0e-9ed1-26c3b6462369",
                                        "entry_id": "81c056b5-f949-3cc2-94ce-9ba219a5a90d",
                                        "glosses": [
                                            "The uppermost sawyer in a sawpit; a topsman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "523c9d5b-49ee-3651-aab2-c48fc8401803",
                                        "entry_id": "81c056b5-f949-3cc2-94ce-9ba219a5a90d",
                                        "glosses": [
                                            "A top, dom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc7a6b9d-1367-4783-89fa-fc93e3abf0cb",
                                                "sense_id": "523c9d5b-49ee-3651-aab2-c48fc8401803",
                                                "text": "Back in the alcove I watched as a bearded daddy type whipped a guy who was bent over the sawhorse. The topman kept the tip of his tongue poked between his lips like a little kid hard at work in a coloring book."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
