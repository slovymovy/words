                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4970e79e-7a5f-4842-8f29-45c3b19c7d48",
                                "sense_id": "ebc73b5c-6cca-3cb9-90bd-00b2944af118",
                                "text": "„Die Mörtelart richtet sich nach der Art des Wandwerkstoffes.“"
                            },
                            {
                                "example_id": "5226e596-e277-46ae-8af1-7d86df4a4c78",
                                "sense_id": "ebc73b5c-6cca-3cb9-90bd-00b2944af118",
                                "text": "„Aus der Zeit der Bauentstehung stammte wohl die Mörtelart, die mit Stilatura versehen war.“"
                            },
                            {
                                "example_id": "431f5d86-8333-4fdd-b5f7-9c70aa325088",
                                "sense_id": "ebc73b5c-6cca-3cb9-90bd-00b2944af118",
                                "text": "„Die Mörtelart wird den Druck- und Wasserverhältnissen entsprechend gewählt; im Druckgebirge ist reiner Zementmörtel […] erforderlich.“"
                            },
                            {
                                "example_id": "96051777-0428-4ace-91e5-053d6aa4de26",
                                "sense_id": "ebc73b5c-6cca-3cb9-90bd-00b2944af118",
                                "text": "„In Tafel 2 sind die Mörtelarten und Mörtelgruppen mit den empfohlenen Mischungsverhältnissen nach Raumteilen zusammengestellt, wie sie in der Putznorm DIN 18550 angegeben sind.“"
                            },
                            {
                                "example_id": "5f946392-43e9-4476-a436-88b72b2d8b1f",
                                "sense_id": "ebc73b5c-6cca-3cb9-90bd-00b2944af118",
                                "text": "„Trotzdem wurde der Versuch unternommen, die Mörtelarten der verschiedenen Bauperioden zu analysieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
