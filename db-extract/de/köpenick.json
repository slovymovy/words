                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f428fa3c-21cf-4525-a5cb-af16af1636e3",
                                "sense_id": "a5db2f88-0910-32d3-af81-3f9a41814cc3",
                                "text": "Sie hat ihren neuen Blumenladen in Köpenick aufgemacht."
                            },
                            {
                                "example_id": "24de5e37-0ba2-4f08-a69e-42cd1b784446",
                                "sense_id": "a5db2f88-0910-32d3-af81-3f9a41814cc3",
                                "text": "„Kommm, komm, komm, komm mit mir nach Köpenick.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc64af57-6280-3537-aad6-726f884e13cf",
