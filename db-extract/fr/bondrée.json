                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f727ac5f-6713-42a7-acb9-1c1ea9a164a7",
                        "entry_id": "8b9ebdde-8baf-3aad-8dc5-06c9d4ca7294",
                        "tags": [
                            "plural"
                        ],
                        "form": "bondrées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8136921-def2-37c3-b0a6-1aa5fa3f8f7d",
                        "entry_id": "8b9ebdde-8baf-3aad-8dc5-06c9d4ca7294",
                        "glosses": [
                            "Oiseau de proie qui ressemble à la buse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5cf6a0-aea5-4726-9fe1-c465e41beef2",
                                "sense_id": "d8136921-def2-37c3-b0a6-1aa5fa3f8f7d",
                                "text": "Une pause séparait chacun des cris, que sans cela l'on eût pu confondre avec les ululations des orfraies, des bondrées et des chouettes, tant l'imitation était parfaite."
                            },
                            {
                                "example_id": "77cd36a4-d3dc-4a85-9792-d6c3992801ed",
                                "sense_id": "d8136921-def2-37c3-b0a6-1aa5fa3f8f7d",
                                "text": "Toutes les buses (la buse commune, Buteo vulgaris Ray, la buse pattue, B. lagopus Vieillot et la bondrée Pernis apivorus G. Cuv. font la guerre aux serpents."
                            },
                            {
                                "example_id": "430465ca-e2a6-4a37-9a03-e7869dd6c4a6",
                                "sense_id": "d8136921-def2-37c3-b0a6-1aa5fa3f8f7d",
                                "text": "Sa voix frappait-elle l’oiseau de la girouette, la bondrée planante, la dernière feuille du noyer, ou la lucarne qui avalait, au petit matin, les chouettes ?…"
                            },
                            {
                                "example_id": "ea27623d-dd7c-4aa8-a3c2-679aca711de5",
                                "sense_id": "d8136921-def2-37c3-b0a6-1aa5fa3f8f7d",
                                "text": "Ils sèment la désolation, je le devine au vol irrégulier de la bondrée, dit ma tante qui suivait des yeux un beau rapace dont le vol dessinait à l’azur d’étranges arabesques."
                            }
                        ]
                    }
                ],
