        "nl-extract.jsonl": [
            {
                "entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                "word": "technocraat",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "bf8b7049-ca7c-4bf5-99a4-2320ec348711",
                        "entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "technocraten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "073a1ec7-a963-3b43-bcd8-c9063d45929d",
                        "entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                        "glosses": [
                            "iemand die zijn beslissingen maakt op basis van zakelijke en wetenschappelijke inzichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6795f2f0-441a-4df6-887c-208d395dd25a",
                                "sense_id": "073a1ec7-a963-3b43-bcd8-c9063d45929d",
                                "text": "Nadat premier Rutte vorige week de aftrap van zijn derde kabinet heeft gegeven, is deze week de beurt aan minister van Financiën Wopke Hoekstra (CDA). Ontpopt hij zich als technocraat of toch vooral politicus?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d055551-fe66-3837-bf4c-c35dddcdd670",
                        "entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                        "glosses": [
                            "een ongevoelig iemand die geen rekening houdt met mensen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b482a4e6-fdb9-4a56-95a4-87ad70895c8c",
                                "sense_id": "3d055551-fe66-3837-bf4c-c35dddcdd670",
                                "text": "Er zijn niet veel schrijvers die over de techniek in romans en verhalen vertellen. — Ik ben zo'n barbaarse technocraat dat ik denk dat je ze kunt oplappen, alsof ze een Model T Ford zijn."
                            },
                            {
                                "example_id": "f47669dc-d44d-4f72-99b2-0a18bc16e7f3",
                                "sense_id": "3d055551-fe66-3837-bf4c-c35dddcdd670",
                                "text": "Decennia zijn ambtenaren beschimpt, weggezet als technocraten die niets doen óp kosten van mijn belastingcenten'. In werkelijkheid zijn topambtenaren nodig om te remmen dan wel te stimuleren, want de politici zelf zijn al te vaak slaven van de publieke opinie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccb90257-f23d-4e99-896d-191f89cf8bbe",
                        "source_entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                        "source_sense_id": "073a1ec7-a963-3b43-bcd8-c9063d45929d",
                        "source_sense_description": "iemand die zijn beslissingen maakt op basis van zakelijke en wetenschappelijke inzichten",
                        "target_lang_word": "technocrat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technocrat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a4c45d-ef95-3ecd-a622-029bf377734f",
                                        "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                                        "glosses": [
                                            "An advocate of technocracy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                        "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                                        "glosses": [
                                            "An expert in some technology, especially one in a managerial or administrative role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92ebdd3-2286-4daa-a04e-b308561234cf",
                                                "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                                "text": "Another by now trusted technocrat, d'Aguesseau, returned as Chancellor, initiating down to his death in 1751 landmark judicial reforms."
                                            },
                                            {
                                                "example_id": "fe70fb9c-a9d7-4129-932f-05a043c78f6d",
                                                "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                                "text": "Would the site’s community of decentralized, uncompensated editors continue to govern it according to its principles of openness, transparency, and neutrality, or would a handful of highly paid NGO technocrats re-orient Wikipedia toward endorsing and promoting the ever-shifting currents of the Western elite social justice regime?"
                                            },
                                            {
                                                "example_id": "1f42944b-e289-4f90-837f-b9980c7b4696",
                                                "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                                "text": "[Canadian Prime Minister Mark Carney]’s been able to sell himself as a no-nonsense technocrat who knows how to steer a crisis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c94723fe-0cd7-3d23-a599-a67f67d982ab",
                                        "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                                        "glosses": [
                                            "A person who makes decisions based solely on technical information and not personal or public opinion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
