                                                "sense_id": "8d082d86-b5b5-328d-846f-571dfc0cb925",
                                                "text": "The bear attacked with vengeance and vehemence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                                        "glosses": [
                                            "A wild or turbulent ferocity or fury."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e0bf65-b4ca-4e5a-af10-ffe47b0cb83b",
                                                "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                                "text": "His response was bursting with hatred and vehemence."
                                            },
                                            {
                                                "example_id": "56872890-7fb8-4781-8000-4dbcac724b39",
                                                "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                                "text": "This worrisome tendency was on display in recent weeks as Israelis reacted with striking vehemence to remarks by UN secretary general, Ban Ki-moon, and US ambassador to Israel, Daniel Shapiro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                                        "glosses": [
                                            "Eagerness, fervor, excessive strong feeling."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8764be-3dc6-4df4-87ab-1d8f4973d5c3",
                                                "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                                                "text": "I could not wonder at the vehemence of her care, her very soul was tenderness […]"
                                            }
                                        ]
