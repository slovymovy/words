                ],
                "senses": [
                    {
                        "sense_id": "25b22427-23e6-3342-8456-c3b63738c170",
                        "entry_id": "16fd87cf-2b48-322f-b77f-69b3df7f8ab7",
                        "glosses": [
                            "устар. то же, что щедрый во всех значениях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2f4cab-21ac-47ed-9902-0f050665d22f",
                                "sense_id": "25b22427-23e6-3342-8456-c3b63738c170",
                                "text": "Тороватый подарок."
                            },
                            {
                                "example_id": "22038b3b-cafa-444a-9b6b-facff55318ce",
                                "sense_id": "25b22427-23e6-3342-8456-c3b63738c170",
                                "text": "А церковный староста, мужик богатый и тороватый, нарочно подошёл к служивому осведомиться: кто он, откуда и куда путь-дорогу держит."
                            }
                        ]
                    },
                    {
                        "sense_id": "e31395d5-59cd-3cc5-bf57-10def7561010",
                        "entry_id": "16fd87cf-2b48-322f-b77f-69b3df7f8ab7",
                        "glosses": [
                            "перен. несдержанный, склонный к излишествам в проявлении чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7b4a37-81d0-4ce6-b2ff-0b0f4957ffc0",
                                "sense_id": "e31395d5-59cd-3cc5-bf57-10def7561010",
                                "text": "и отводила душу в бесконечных разговорах о пустяках, на которые Иудушка был тороват по природе, а она сделалась тороватою вследствие старости."
                            }
                        ]
                    },
                    {
                        "sense_id": "87d448bd-46ab-3ccd-a823-d0ac37addf34",
                        "entry_id": "16fd87cf-2b48-322f-b77f-69b3df7f8ab7",
                        "glosses": [
                            "перен. расторопный, ловкий, проворный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac7eb9c3-08ab-4ec2-b729-0d0699661ecb",
                                "sense_id": "87d448bd-46ab-3ccd-a823-d0ac37addf34",
                                "text": "Ведь немцы тороваты, // Им ведом мрак и свет, // Земля ж у нас богата, // Порядка в ней лишь нет."
                            }
                        ]
                    }
                ],
