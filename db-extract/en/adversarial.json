                    {
                        "translation_id": "099479bf-8d5e-448d-8e1d-746329707af5",
                        "source_entry_id": "d63016d4-abf7-359d-a72c-f8088caaafc8",
                        "source_sense_description": "characteristic of, or in the manner of, an adversary",
                        "target_lang_word": "feindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
