                "senses": [
                    {
                        "sense_id": "5c550e0b-ff67-3d20-bccf-1cdd1cea976b",
                        "entry_id": "f6c10550-7fb2-3a21-a1e4-2a20f5d2338d",
                        "glosses": [
                            "Gewinnung des Metalls Lithium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6e44ca-d336-454b-bd53-9b47dacd9abd",
                                "sense_id": "5c550e0b-ff67-3d20-bccf-1cdd1cea976b",
                                "text": "„Wer auf Lithiumabbau setzt, scheint derzeit also alles richtig zu machen.“"
                            },
                            {
                                "example_id": "74fd9be3-d3c5-454b-a683-70e01b71344e",
                                "sense_id": "5c550e0b-ff67-3d20-bccf-1cdd1cea976b",
                                "text": "„Außerdem setzt der Lithiumabbau Chemikalien frei und Chemieabfälle werden umweltschädlich entsorgt.“"
                            },
                            {
                                "example_id": "7461269e-3d06-41dc-bae0-b32a85d16a0b",
                                "sense_id": "5c550e0b-ff67-3d20-bccf-1cdd1cea976b",
                                "text": "„Fast der gesamte Lithiumabbau in Chile findet derzeit in der Atacama statt […].“"
                            },
                            {
                                "example_id": "cb489c5d-2e7d-4636-8db9-a8db9fb0ebb8",
                                "sense_id": "5c550e0b-ff67-3d20-bccf-1cdd1cea976b",
                                "text": "„Dass der Lithiumabbau in Südamerika zulasten der Umwelt rücksichtslos vorangetrieben wird, resultiert aus der Profitgier von Konzernen.“"
                            },
                            {
                                "example_id": "c1cedac3-23d1-48e6-9a79-02d5c965e540",
                                "sense_id": "5c550e0b-ff67-3d20-bccf-1cdd1cea976b",
                                "text": "„Der tschechische Energiekonzern CEZ erwägt einen Einstieg in den Lithiumabbau im Erzgebirge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
