                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dopamina",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e2362526-167f-30fe-8467-5d618dfc6c5a",
                                        "entry_id": "379b7963-a071-3dd0-ad91-8921b685ff73",
                                        "glosses": [
                                            "neurohormon, ważny neuroprzekaźnik syntezowany i uwalniany przez dopaminergiczne neurony ośrodkowego układu nerwowego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0860ee2a-bbe9-49ea-a465-2395546300e3",
                                                "sense_id": "e2362526-167f-30fe-8467-5d618dfc6c5a",
                                                "text": "Hipoteza, że osoby ze schizofrenią mają nadmiar dopaminy w mózgu pojawiła się już w latach 50. XX wieku"
                                            },
                                            {
                                                "example_id": "9c710068-a0cc-4689-a6a6-a9caee9ff0a1",
                                                "sense_id": "e2362526-167f-30fe-8467-5d618dfc6c5a",
                                                "text": "Niekiedy czytamy, że dopamina sama w sobie sprawia, że czujemy się szczęśliwi. W zasadzie zadanie dopaminy polega na czymś innym. Wzbudza w nas ochotę na coś nowego oraz wywołuje radość oczekiwania"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
