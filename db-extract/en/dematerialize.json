                "senses": [
                    {
                        "sense_id": "0e3c5caf-8e2a-3d19-b02a-d0928882b834",
                        "entry_id": "0f30b4ea-3157-3e50-9c67-e60d60dbac47",
                        "glosses": [
                            "To disappear by becoming immaterial."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ed8c8d22-7ea7-4855-b3db-25664370f3c1",
                                "sense_id": "0e3c5caf-8e2a-3d19-b02a-d0928882b834",
                                "text": "\"So, I'll need you to look at the nth field targeting so when the object dematerializes from here, we can rematerialize it there.\""
                            },
                            {
                                "example_id": "d286a41c-944d-4bf6-bd5d-29e569ed391a",
                                "sense_id": "0e3c5caf-8e2a-3d19-b02a-d0928882b834",
                                "text": "Nightmares were, after all, a type of demon; they could dematerialize in much the way Fiant did."
                            }
                        ]
                    },
                    {
                        "sense_id": "0126c533-0c29-396d-9f61-2e5358832bc3",
                        "entry_id": "0f30b4ea-3157-3e50-9c67-e60d60dbac47",
                        "glosses": [
                            "To cause something to disappear by making it immaterial."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8bf253c3-5676-4e77-86d4-624ef05b4e43",
                                "sense_id": "0126c533-0c29-396d-9f61-2e5358832bc3",
                                "text": "Some magicians claim they can dematerialize their bodies and re-materialize them in a different location."
                            }
                        ]
                    },
                    {
                        "sense_id": "378db29d-84c9-32f6-9511-9e80f21e8bfc",
                        "entry_id": "0f30b4ea-3157-3e50-9c67-e60d60dbac47",
                        "glosses": [
                            "To remove the physical materials from (a process, etc.)."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "278edbc7-eb25-4cbf-b750-d006a94bd534",
                                "sense_id": "378db29d-84c9-32f6-9511-9e80f21e8bfc",
                                "text": "Even though the book is still a difficult object to dematerialize and the paper books are not replaceable, the trend seems to be to prefer an e-book rather than a physical book […]"
                            }
                        ]
                    }
                ],
