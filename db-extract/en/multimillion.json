        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1993eef8-3e1e-3fd4-aee5-8d448f3b8bbf",
                "word": "multimillion",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e965baa-f68f-396f-b225-4b5cc8ad96c9",
                        "entry_id": "1993eef8-3e1e-3fd4-aee5-8d448f3b8bbf",
                        "glosses": [
                            "Having several millions; costing or worth many millions of dollars, pounds, euros or some other currency."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "989aeaa3-7a04-4384-b703-6e5b500804f1",
                                "sense_id": "0e965baa-f68f-396f-b225-4b5cc8ad96c9",
                                "text": "Edhi lived in a humble, ascetic way, even as his charity became a multimillion-pound enterprise."
                            },
                            {
                                "example_id": "0cce33e6-894b-40c0-ba09-fb3214d7adc2",
                                "sense_id": "0e965baa-f68f-396f-b225-4b5cc8ad96c9",
                                "text": "A project led by Annie Collier, a clinical psychologist at the University of Colorado Anschutz Medical Campus, to study vaccine hesitancy among Alaska Native and American Indian people and test strategies to promote vaccination was also cut short. Her multimillion NIH grant was terminated on 10 March."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3e8518e-8a0f-4e02-9435-04a91c234646",
                        "source_entry_id": "1993eef8-3e1e-3fd4-aee5-8d448f3b8bbf",
                        "source_sense_id": "0e965baa-f68f-396f-b225-4b5cc8ad96c9",
                        "source_sense_description": "having several millions",
                        "target_lang_word": "multimillionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multimillionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac83bae5-8644-35d5-a80b-75345895ada3",
                                        "entry_id": "0f8f486b-5983-3272-913a-ddce00702eb9",
                                        "glosses": [
                                            "Qui possède plusieurs millions (de dollars, d’euro, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd2eb02-30e1-43ea-aee2-4c8f8d464336",
                                                "sense_id": "ac83bae5-8644-35d5-a80b-75345895ada3",
                                                "text": "Le multimillionnaire armateur grec, faisant un bref déplacement sur la côte d’Azur, honorait ce soir-là de sa visite la Résidence de Bois-Joli."
                                            },
                                            {
                                                "example_id": "471693a4-59f2-4a9e-9b48-647fd1b4517a",
                                                "sense_id": "ac83bae5-8644-35d5-a80b-75345895ada3",
                                                "text": "Les gosses les plus riches de son lycée, dont les pères multimillionnaires fréquentaient des country-clubs ultra-sélects, considéraient qu’ils faisaient partie de la classe moyenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbbdfe84-c9c5-3c73-9f7e-85f148cf33f7",
                                        "entry_id": "0f8f486b-5983-3272-913a-ddce00702eb9",
                                        "glosses": [
                                            "Relatif à plusieurs millions (de dollars, d’euro, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5959ff-833e-4cba-96c3-53642f51a69e",
                                                "sense_id": "fbbdfe84-c9c5-3c73-9f7e-85f148cf33f7",
                                                "text": "Donc, la réponse à votre multimillionnaire proposition est : non."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multimillionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37918d81-0fd4-3162-a8d9-66aa37b7d715",
                                        "entry_id": "83cb39cb-6f91-3c73-80b7-799bb400ac45",
                                        "glosses": [
                                            "Personne plusieurs fois millionnaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611331a6-62d3-4953-ace4-62029b9d961d",
                                                "sense_id": "37918d81-0fd4-3162-a8d9-66aa37b7d715",
                                                "text": "Ce n’est pas un millionnaire en enfer parlant avec un pauvre au paradis ; c’est un petit millionnaire en enfer parlant avec un multimillionnaire au paradis."
                                            },
                                            {
                                                "example_id": "fb923806-9328-4eaf-a21d-805744ed2f06",
                                                "sense_id": "37918d81-0fd4-3162-a8d9-66aa37b7d715",
                                                "text": "Salut à toi, puisque tu as le succès, puisque tu fait de tes vignerons des multimillionnaires, ô Hérault rouge, ô Hérault vainqueur, source intarissable du vin populaire, métropole de ce pinard démocratique, devenu indispensable aux citoyens conscients."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71c94ce2-62a5-40d8-9283-a1c801de0af9",
                        "source_entry_id": "1993eef8-3e1e-3fd4-aee5-8d448f3b8bbf",
                        "source_sense_id": "0e965baa-f68f-396f-b225-4b5cc8ad96c9",
