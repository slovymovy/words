                ],
                "senses": [
                    {
                        "sense_id": "c2618d4c-899c-368a-8728-00dfa19eb26e",
                        "entry_id": "d0da8f7c-1c71-3480-bb6b-69efbaa033fa",
                        "glosses": [
                            "meist mit Marmelade gefülltes Hefegebäck"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "6563d018-e834-4250-89b7-c9b6a54e1ebf",
                                "sense_id": "c2618d4c-899c-368a-8728-00dfa19eb26e",
                                "text": "„Im Radio lief die Wunschsendung ‚Alte Liebe rostet nicht‘ und meine Großmutter servierte uns Rhabarberkuchen, Cremetorte oder Wuchteln.“"
                            },
                            {
                                "example_id": "5816dab0-b72f-4394-b9a1-e24388681cdb",
                                "sense_id": "c2618d4c-899c-368a-8728-00dfa19eb26e",
                                "text": "„Man schneide den ausgestochenen Teig glatt ab und fahre fort, solche kleine Wuchteln auf die angegebene Art zu machen, bis der Teig und die Farce verbraucht sind. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3bfe798-ff13-3a83-8813-68acd1b70993",
                        "entry_id": "d0da8f7c-1c71-3480-bb6b-69efbaa033fa",
                        "glosses": [
                            "Fußball (Sportgerät)"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ce61f467-8df3-4a00-a6c2-b012ac999916",
                                "sense_id": "a3bfe798-ff13-3a83-8813-68acd1b70993",
                                "text": "„Mit der Wuchtel am Fuß galoppiert ein Angreifer auf das Tor des Gegners zu.“"
                            },
                            {
                                "example_id": "49f574f9-a64e-4f4c-8ad7-5f84538225c1",
                                "sense_id": "a3bfe798-ff13-3a83-8813-68acd1b70993",
                                "text": "„Wie verbalisiert man ein Spiel, in dem nach wenigen Sekunden die Ballkünstler Klein, Baumgartlinger, Schiemer und Pogatetz derart in Hilflosigkeit verfielen, dass sie die Wuchtel nur noch ins Out retten konnten? “"
                            },
                            {
                                "example_id": "1531e10b-6186-4974-b448-f94c2d95ca27",
                                "sense_id": "a3bfe798-ff13-3a83-8813-68acd1b70993",
                                "text": "„Außerdem wird seit den beiden Spielen gegen Deutschland und die Niederlande heftig darüber diskutiert, warum wir sechzig Minuten lang angeblich grandios spielen (die das sagen, sind nicht unsere größten Experten), aber dann, in der letzten halben Stunde, eine Wuchtel nach der anderen kriegen, sodass der Endstand wirkt, als hätten sich unsere Spieler wirklich nur, wie Sie so boshaft schrieben, »das seidige Haar gekämmt«.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b70f0814-05ca-33ea-af15-b1907aa32f0b",
                        "entry_id": "d0da8f7c-1c71-3480-bb6b-69efbaa033fa",
                        "glosses": [
                            "lustige Bemerkung"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "8fca7963-37fe-481e-baa5-00e9de26b23a",
                                "sense_id": "b70f0814-05ca-33ea-af15-b1907aa32f0b",
                                "text": "„Vorbei die Zeiten, als Damen erröteten oder genervt die Augen rollten, wenn heitere (und angeheiterte) Männer ihre zotigen Wuchteln auspackten.“"
                            },
                            {
                                "example_id": "74b55c20-59da-46bd-82fd-c28717f33a13",
                                "sense_id": "b70f0814-05ca-33ea-af15-b1907aa32f0b",
                                "text": "„Sie verpacken Schmäh und Wuchteln in Melodien zum Mitsingen – und brechen damit alle Rekorde.“"
                            },
                            {
                                "example_id": "b9ba56cc-096f-4cff-8895-fbbc2f60cc24",
                                "sense_id": "b70f0814-05ca-33ea-af15-b1907aa32f0b",
                                "text": "„Unzertrennlich sind die beiden aber nur vor der Kamera, wenn sie sich gegenseitig necken und Wuchteln zuschieben.“"
                            },
                            {
                                "example_id": "5b1ac5b7-a397-43ce-98f9-a1315f695c58",
                                "sense_id": "b70f0814-05ca-33ea-af15-b1907aa32f0b",
                                "text": "„Aber ich glaub, jetzt ist es Zeit für die Wuchtel der Sendung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
