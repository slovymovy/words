                    {
                        "sense_id": "1bf058a8-338b-3832-9910-15596593cacd",
                        "entry_id": "9e61c3d6-c7ad-359d-b38c-584689ee5499",
                        "glosses": [
                            "To make spiritual; to invoke spirituality."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10077d22-2ae9-3e4c-8dc9-06f63388b211",
                        "entry_id": "9e61c3d6-c7ad-359d-b38c-584689ee5499",
                        "glosses": [
                            "To refine intellectually or morally; to purify from the corrupting influence of the world; to give a spiritual character or tendency to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4f3f98-308e-4c83-b760-7ce9d64401b6",
                                "sense_id": "10077d22-2ae9-3e4c-8dc9-06f63388b211",
                                "text": "This seen in the clear air, and the whole spiritualized by endless recollections, fills the eye and the heart more forcibly than I can find words to say."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfadbe98-f01a-3d9c-942f-2693c600bb75",
                        "entry_id": "9e61c3d6-c7ad-359d-b38c-584689ee5499",
                        "glosses": [
                            "To give a spiritual meaning to; to take in a spiritual sense; opposed to literalize."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b1f7d2d5-4402-3f74-8744-783bf7dbef5e",
                        "entry_id": "9e61c3d6-c7ad-359d-b38c-584689ee5499",
                        "glosses": [
                            "To extract spirit."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fa553530-4bf4-39be-badc-9e07af1e15fc",
                        "entry_id": "9e61c3d6-c7ad-359d-b38c-584689ee5499",
                        "glosses": [
                            "To convert into, or impregnate with, spirit."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1964e65d-10ab-4376-b690-008e36ba103b",
                        "source_entry_id": "9e61c3d6-c7ad-359d-b38c-584689ee5499",
                        "source_sense_description": "to make spiritual",
                        "target_lang_word": "spiritualiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiritualiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39892951-f18e-34d4-8c2a-4067facba24e",
                                        "entry_id": "09e6b14f-5e48-37ef-893b-0f8353522bce",
                                        "glosses": [
                                            "Dégager le caractère de spiritualité, imprimer le caractère de la spiritualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e18517-6399-44a9-a5c8-ac66e0878a72",
                                                "sense_id": "39892951-f18e-34d4-8c2a-4067facba24e",
                                                "text": "Un nez grec, comme dessiné par Phidias et réuni par un double arc à des lèvres élégamment sinueuses, spiritualisait son visage de forme ovale, et dont le teint, comparable au tissu des camélias blancs, se rougissait aux joues par de jolis tons roses."
                                            },
                                            {
                                                "example_id": "bd9bfd30-d5db-469a-8579-9c1b18d2d0ef",
                                                "sense_id": "39892951-f18e-34d4-8c2a-4067facba24e",
                                                "text": "Déjà, Jacques aimait Yasmina, follement, avec toute l'intensité débordante d'un premier amour chez un homme à la fois très sensuel et très rêveur en qui l'amour de la chair se spiritualisait, revêtait la forme d'une tendresse vraie..."
                                            },
                                            {
                                                "example_id": "228eee16-9a55-4def-b002-109677b5404c",
                                                "sense_id": "39892951-f18e-34d4-8c2a-4067facba24e",
                                                "text": "La capacité de l'islam à spiritualiser l'existence est suffisamment forte pour qu'il n'ait pas peur de la liberté de conscience, de l'égalité des sexes, du droit à la critique, du droit de chacun à changer de religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd3af7d-ef78-31f4-8789-0d1460269027",
                                        "entry_id": "09e6b14f-5e48-37ef-893b-0f8353522bce",
                                        "glosses": [
                                            "Rendre spiritueux, extraire les esprits, les parties subtiles d'un solide, d'un liquide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
