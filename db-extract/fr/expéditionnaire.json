                "senses": [
                    {
                        "sense_id": "64e13dde-6101-3368-8eb3-d8bf45376665",
                        "entry_id": "7c5f27ec-c1cb-3686-9867-dc1d626f2ed1",
                        "glosses": [
                            "Qui est chargé d’écrire une expédition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2831c58e-3bcb-40cd-9018-30e776653e15",
                                "sense_id": "64e13dde-6101-3368-8eb3-d8bf45376665",
                                "text": "Commis expéditionnaire"
                            },
                            {
                                "example_id": "7e4b7980-7ab7-42d7-a085-35db6e017a68",
                                "sense_id": "64e13dde-6101-3368-8eb3-d8bf45376665",
                                "text": "Heureusement je sus recevoir à la figure, en fille qui a quelques motifs de honte, la supériorité ricanante des messieurs expéditionnaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9b416e5-2dc5-3824-8d26-231fef22a874",
                        "entry_id": "7c5f27ec-c1cb-3686-9867-dc1d626f2ed1",
                        "glosses": [
                            "Qui est envoyé en expédition militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b740d2c-a995-45c9-b0bf-23d86947085e",
                                "sense_id": "a9b416e5-2dc5-3824-8d26-231fef22a874",
                                "text": "Le génie est représenté dans l’armée marocaine par un petit corps d’ingénieurs (mohendisîn), dont la fonction principale et à peu près unique est de précéder les corps expéditionnaires et de choisir l’emplacement des campements."
                            },
                            {
                                "example_id": "3b1f8f16-d3de-4fd6-8226-c9ee50972cfe",
                                "sense_id": "a9b416e5-2dc5-3824-8d26-231fef22a874",
                                "text": "Le 4 octobre 1911, le Premier ministre Giolitti donne le coup d’envoi au départ d’un corps expéditionnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25031c8-55f4-419b-816a-b9927d0972f6",
                        "source_entry_id": "7c5f27ec-c1cb-3686-9867-dc1d626f2ed1",
