                ],
                "senses": [
                    {
                        "sense_id": "2f909063-c967-35c3-86cb-35d42ebee8e8",
                        "entry_id": "5a35ee5d-9d95-3f34-8878-fd9b7d394366",
                        "glosses": [
                            "Inscrire dans un espace plus ou moins concret, limiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8e1db9-a53c-4a9c-b394-9a1e77e68401",
                                "sense_id": "2f909063-c967-35c3-86cb-35d42ebee8e8",
                                "text": "Dans ce « vermouilleux » monde, la science est une vilaine qu'il faut conscrire afin qu'elle ne contamine pas les esprits naïfs des jeunes gens impressionnables."
                            },
                            {
                                "example_id": "4068e449-b0c0-4946-9fdb-3ed0569afeb2",
                                "sense_id": "2f909063-c967-35c3-86cb-35d42ebee8e8",
                                "text": "Là-dessus, les religieuses américaines refusent de se laisser conscrire par le mouvement provie."
                            },
                            {
                                "example_id": "16b1d107-b18d-4855-b3ff-e0095a5099fd",
                                "sense_id": "2f909063-c967-35c3-86cb-35d42ebee8e8",
                                "text": "Sans parler des millions perdus à essayer de conscrire les manifs de type anarchiste, n'importe où et n'importe comment."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb0ff92b-1c1e-30fb-8056-5a1b61a25a51",
                        "entry_id": "5a35ee5d-9d95-3f34-8878-fd9b7d394366",
                        "glosses": [
                            "Enregistrer, enrôler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fdf7e70-9ad7-41e8-aca1-86fdf4bdddb3",
                                "sense_id": "eb0ff92b-1c1e-30fb-8056-5a1b61a25a51",
                                "text": "Faudrait-il « conscrire » les francophones par des campagnes de sensibilisation et de fierté ?"
                            }
                        ]
                    }
                ],
