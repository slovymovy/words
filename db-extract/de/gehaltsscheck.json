                    {
                        "sense_id": "3ae1d2ae-4ea8-3e5d-8a38-e5a0f7be0d23",
                        "entry_id": "9f9b4441-5a90-3f98-b3ea-c24d54f7ba21",
                        "glosses": [
                            "Scheck, durch den das Arbeitsgehalt an jemanden überwiesen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd4248a-c767-48da-be4c-c5c5f28200c7",
                                "sense_id": "3ae1d2ae-4ea8-3e5d-8a38-e5a0f7be0d23",
                                "text": "„Sein patrón war ein Gläubiger, ein Götzenanbeter, und einen Götzenanbeter von seinem Götzen zu trennen war nie ratsam. Vor allem nicht, wenn der Götzenanbeter seine Gehaltsschecks unterschrieb und bewaffnet war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c1cd673-d9ec-4ce2-92b9-8ad7776ca0bb",
                        "source_entry_id": "9f9b4441-5a90-3f98-b3ea-c24d54f7ba21",
                        "source_sense_id": "3ae1d2ae-4ea8-3e5d-8a38-e5a0f7be0d23",
                        "source_sense_description": "Scheck mit Arbeitsgehalt",
                        "target_lang_word": "paycheck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paycheck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65e31825-08fc-3259-85fc-5d71a5c8b474",
                                        "entry_id": "5385731c-4496-3673-9179-a84b7a3bf0bd",
                                        "glosses": [
                                            "Money received on payday as payment for work performed."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f7d3cf1-8300-4ac1-9d43-976cb5e3e1b1",
                                                "sense_id": "65e31825-08fc-3259-85fc-5d71a5c8b474",
                                                "text": "He was delighted after getting his first paycheck, but subsequently blew it all on the horses."
                                            },
                                            {
                                                "example_id": "67310708-cc6e-4814-afed-318772e41984",
                                                "sense_id": "65e31825-08fc-3259-85fc-5d71a5c8b474",
                                                "text": "The teachers are not there to help you. Most oft them are still freelancers and the last thing they want is more competition. They are there because they need a steady paycheck and they hope to score some pussy!"
                                            },
                                            {
                                                "example_id": "961e33eb-1a9f-4ed8-a625-a0fff57b5450",
                                                "sense_id": "65e31825-08fc-3259-85fc-5d71a5c8b474",
                                                "text": "They took my whole paycheck and I know why / 'Cause I got high, 'cause I got high"
                                            },
                                            {
                                                "example_id": "bed69b67-9ef5-430a-96b6-cce2ed6b5974",
                                                "sense_id": "65e31825-08fc-3259-85fc-5d71a5c8b474",
                                                "text": "With the help of some low-end boosting, Dinklage musters a decent amount of kid-appropriate menace—although he never does explain his gift for finding chunks of ice shaped like pirate ships—but Romano and Leary mainly sound bored, droning through their lines as if they’re simultaneously texting the contractors building the additions on their houses funded by their fat sequel paychecks."
                                            },
                                            {
                                                "example_id": "da7b6a11-3eb7-48c8-a72f-683a60b8c6d6",
                                                "sense_id": "65e31825-08fc-3259-85fc-5d71a5c8b474",
                                                "text": "We're a super sad generation / Killing time and losing our paychecks"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
