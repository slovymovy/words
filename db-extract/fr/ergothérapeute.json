                    },
                    {
                        "translation_id": "642af0a7-4450-4aa4-bdcf-c2f84cde7243",
                        "source_entry_id": "4d72182d-b3f4-3bb0-80f3-0dc011a7a03d",
                        "source_sense_id": "d372aa1d-98c3-3d35-9b61-e591e910b9f9",
                        "source_sense_description": "Personne utilisant le travail manuel pour soigner",
                        "target_lang_word": "Ergotherapeut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ergotherapeut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad2f46b-5ec1-360c-8f23-0a880717b9ca",
                                        "entry_id": "14ebf089-11df-362a-9770-f4d7e8101526",
                                        "glosses": [
                                            "Mann, der sich beruflich mit der Ergotherapie beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c329e502-e828-45dc-bb7c-0bf744d5c628",
                                                "sense_id": "2ad2f46b-5ec1-360c-8f23-0a880717b9ca",
                                                "text": "„Ihre eigene Tochter ist jetzt anderthalb, und bei ihnen ist es der Mann, der in seinem Job als Ergotherapeut aussetzt, sie ernährt die Familie.“"
                                            },
                                            {
                                                "example_id": "4f3ce216-4925-44b3-9538-db649d7a26cb",
                                                "sense_id": "2ad2f46b-5ec1-360c-8f23-0a880717b9ca",
                                                "text": "„Seit 1983 bieten die Blindow-Schulen eine dreijährige Ausbildung zum Ergotherapeuten an.“"
                                            },
                                            {
                                                "example_id": "2c7e4376-9573-4564-bf7c-54b66eb5aa57",
                                                "sense_id": "2ad2f46b-5ec1-360c-8f23-0a880717b9ca",
                                                "text": "„Mit der Einführung von Bachelor und Master hat deshalb auch die Akademisierung von Berufen wie Physiotherapeut, Logopäde oder Ergotherapeut begonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7dddb6-368c-4630-afd3-681c43818b60",
                        "source_entry_id": "4d72182d-b3f4-3bb0-80f3-0dc011a7a03d",
                        "source_sense_id": "d372aa1d-98c3-3d35-9b61-e591e910b9f9",
                        "source_sense_description": "Personne utilisant le travail manuel pour soigner",
                        "target_lang_word": "Ergotherapeutin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ergotherapeutin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38412a11-ad6b-3494-a2f4-d99d86cee2b1",
                                        "entry_id": "ba1a897a-6d62-36b4-8969-6349602c7c1f",
                                        "glosses": [
                                            "Dame, die sich beruflich mit Ergotherapie beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e79f5855-f182-4a8d-a861-998504bb415d",
                                                "sense_id": "38412a11-ad6b-3494-a2f4-d99d86cee2b1",
                                                "text": "„Die 28-Jährige hat nach dem Abitur eine dreijährige Ausbildung zur Ergotherapeutin gemacht und ihre Berufswahl nicht einen Tag bereut.“"
                                            },
                                            {
                                                "example_id": "a6a556a4-f332-4ccc-a9f3-448d76cb013b",
                                                "sense_id": "38412a11-ad6b-3494-a2f4-d99d86cee2b1",
                                                "text": "Die Ergotherapeutin hat Spiele im Gepäck, mit denen die Wahrnehmung der Kinder im Hinblick auf Sehen, Hören und Fühlen getestet werden kann."
                                            },
                                            {
                                                "example_id": "73a68abe-6946-4dd1-bd2b-198c3e6a87dc",
                                                "sense_id": "38412a11-ad6b-3494-a2f4-d99d86cee2b1",
                                                "text": "„Meine Ergotherapeutin sah aus wie eine Erleuchtete, ein Medium in Adiletten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
