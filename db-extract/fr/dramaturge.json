                                            {
                                                "example_id": "b677e556-8ca3-4b8a-a938-f4d5ed04fb14",
                                                "sense_id": "81b40aa0-6bad-39c8-b4fa-e9de5d2a8d9d",
                                                "text": "Dichteres en toneelschrijfster Judith Herzberg is uit het comité van aanbeveling van het Verzetsmuseum in Amsterdam gestapt. Reden is de opening door de koning van de tentoonstelling over politieke gevangenen Geen nummers maar namen in april van dit jaar."
                                            }
                                        ]
                                    }
                                ]
                            }
