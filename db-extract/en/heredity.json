                    {
                        "sense_id": "bbc6395f-5026-36b0-a0d7-806f298e5d4b",
                        "entry_id": "b690bf47-0d47-3c0a-94b8-fb87562fe4da",
                        "glosses": [
                            "Hereditary transmission of the physical and genetic qualities of parents to their offspring; the biological law by which living beings tend to repeat their characteristics in their descendants."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4686a743-269d-4a3b-ac13-90623049d3d8",
                                "sense_id": "bbc6395f-5026-36b0-a0d7-806f298e5d4b",
                                "text": "laws of heredity"
                            },
                            {
                                "example_id": "3d2883cd-bd70-4172-b9ea-bf338a13d451",
                                "sense_id": "bbc6395f-5026-36b0-a0d7-806f298e5d4b",
                                "text": "genetics and heredity"
                            },
                            {
                                "example_id": "06846ebd-6916-4603-bcab-40837fc390a6",
                                "sense_id": "bbc6395f-5026-36b0-a0d7-806f298e5d4b",
                                "text": "influence of heredity"
                            },
                            {
                                "example_id": "a933e7a7-a439-4803-ba36-a8add6e03b66",
                                "sense_id": "bbc6395f-5026-36b0-a0d7-806f298e5d4b",
                                "text": "Eye color is often determined by heredity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48829ad4-5262-4413-a3a6-30ed2fef4ff1",
