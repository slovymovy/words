                    {
                        "sense_id": "6b972cc7-b2fc-37e3-b006-474bba1d6948",
                        "entry_id": "eb3567e6-fc96-3b7e-8e7b-402f92e678ea",
                        "glosses": [
                            "A curry meal."
                        ],
                        "tags": [
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff10cbe-d2cd-4e7d-9daf-5cfac536f077",
                                "sense_id": "6b972cc7-b2fc-37e3-b006-474bba1d6948",
                                "text": "Call me when you get in and invite me out for a tandoori — Oh, and by the way, Jude e-mailed to say she's still having a ball with Marcus and everything's as sweet as a nut."
                            },
                            {
                                "example_id": "267ccc40-9671-4ffd-921a-bd18b8068102",
                                "sense_id": "6b972cc7-b2fc-37e3-b006-474bba1d6948",
                                "text": "Having a relaxing stress-free pint with my fiancée, going for a tandoori afterwards and hoping that she'll come back to my place for B and B, or who knows, maybe even invite me to hers.'"
                            },
                            {
                                "example_id": "43e16f10-4383-4de8-ba28-e4edf95be79b",
                                "sense_id": "6b972cc7-b2fc-37e3-b006-474bba1d6948",
                                "text": "'Let's go down the Shahbag for a tandoori!'"
                            }
                        ]
                    },
                    {
                        "sense_id": "0b30905b-0dea-3097-a04b-d8920239b72e",
                        "entry_id": "eb3567e6-fc96-3b7e-8e7b-402f92e678ea",
                        "glosses": [
                            "An Indian restaurant, especially one with a tandoor."
                        ],
                        "tags": [
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "df68b253-51f9-4a0d-a8e2-959f862e844e",
                                "sense_id": "0b30905b-0dea-3097-a04b-d8920239b72e",
                                "text": "He's done those lads at a tandoori when they started giving him grief."
                            },
                            {
                                "example_id": "b93680bf-40cc-43df-812f-3ec3e829fdea",
                                "sense_id": "0b30905b-0dea-3097-a04b-d8920239b72e",
                                "text": "Now, of course, there is a tandoori in every high street (and a balti and a Thai takeaway as well); proving, if proof were needed, that people's tastes even in conservative Britain are nothing like so conservative as is often supposed."
                            },
                            {
                                "example_id": "2cb49d88-f229-4a89-81c1-1bd759715766",
                                "sense_id": "0b30905b-0dea-3097-a04b-d8920239b72e",
                                "text": "A sandwich at three, and dinner out at a tandoori this evening."
                            }
                        ]
                    }
