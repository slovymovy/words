                "senses": [
                    {
                        "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                        "entry_id": "1ed675a8-dba7-38d8-9e81-a923b41205fd",
                        "glosses": [
                            "einfach konstruierter Wurfbrandsatz, meist in Form einer mit Benzin gefüllten Glasflasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70be390a-cb4f-4dc6-835e-59619029d59f",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "Bei den Unruhen in Kairo kamen auch Molotowcocktails zum Einsatz."
                            },
                            {
                                "example_id": "e4b49578-9fee-4e62-8db1-c03053337307",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "Nachdem die Lage eskaliert ist, flogen Steine und sogar Molotowcocktails."
                            },
                            {
                                "example_id": "01fa1418-1b54-4e3e-bcad-a5c1887750d2",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "„Es ist völlig daneben, in Deutschland oder Frankreich Molotowcocktails auf Polizisten zu werfen."
                            },
                            {
                                "example_id": "3cae326c-5450-490e-a25b-e28fa5ae3c95",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "[Belfast:] „Jugendliche warfen im Westen der Stadt Steine, Feuerwerkskörper und Molotowcocktails auf Polizisten.“"
                            },
                            {
                                "example_id": "3e6fedaa-f2b1-485a-9afe-7d402b73c1b9",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "In Athen ging die Polizei mit Tränengas und Wasserwerfern gegen Demonstranten vor, nachdem aus deren Reihen Molotowcocktails auf die Einsatzkräfte geworfen worden waren.“"
                            },
                            {
                                "example_id": "73a5adcb-42b5-4791-9b2c-e5484ecf8b0b",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "„Manchmal stehen Demonstranten mit Molotowcocktails vor dem Heim.“"
                            },
                            {
                                "example_id": "2f2907b2-a4d8-45f0-a2d9-589c5596920b",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "„Unter meinem provisorischen Friseursessel liegen Molotowcocktails.“"
                            },
                            {
                                "example_id": "a77b5ab5-c21b-44ac-9ff0-99f2932963d2",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "„Nach einem Angriff mit Molotowcocktails und einer Messerattacke töteten israelische Sicherheitskräfte im Westjordanland und in Ostjerusalem zwei junge Palästinenser.“"
                            },
                            {
                                "example_id": "93d70c46-05d2-4203-95e0-33cac2fee5b5",
                                "sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                                "text": "[Skinheads hatten] „unter Applaus in Rostock-Lichtenhagen ein Asylbewerberheim mit Molotowcocktails in Brand gesteckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6bdce68-4036-4187-8055-f7a2ef67ac60",
                        "source_entry_id": "1ed675a8-dba7-38d8-9e81-a923b41205fd",
                        "source_sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                        "source_sense_description": "einfach konstruierter Wurfbrandsatz, meist in Form einer mit Benzin gefüllten Glasflasche",
                        "target_lang_word": "Molotov cocktail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molotov cocktail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "580512f0-36a2-3d92-b35d-70d66ff51f0c",
                                        "entry_id": "7639535c-b94f-3a2d-95f6-0634a1830481",
                                        "glosses": [
                                            "A crude incendiary bomb made from a glass bottle, either filled with a flammable liquid such as petroleum and supplied with a rag for a fuse that is lit just before being hurled, or filled with such a mix of flammable liquids that it ignites itself when it is smashed and its contents are exposed to air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d612632d-7236-467f-bda3-258c89ee7dd9",
                                                "sense_id": "580512f0-36a2-3d92-b35d-70d66ff51f0c",
                                                "text": "The site, which appears in the wake of anti-Elon Musk protests across the country, displays names, addresses, and phone numbers of Tesla owners on an interactive map and uses an image of a Molotov cocktail as its cursor. […] In one incident in Las Vegas, an individual dressed in black used Molotov cocktails to ignite five Tesla vehicles at a service center."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7564d027-b2d5-432a-b052-10db2b63d573",
                        "source_entry_id": "1ed675a8-dba7-38d8-9e81-a923b41205fd",
                        "source_sense_id": "d46cd471-c473-392a-a411-05f29ef9df03",
                        "source_sense_description": "einfach konstruierter Wurfbrandsatz, meist in Form einer mit Benzin gefüllten Glasflasche",
                        "target_lang_word": "cocktail Molotov",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocktail Molotov",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                        "entry_id": "2d7ae946-9067-3027-8c08-f5451160e6a5",
                                        "glosses": [
                                            "Arme incendiaire artisanale dont le composant principal est une bouteille en verre en partie remplie de liquide inflammable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715f4eb7-2c30-40ef-a43a-c8cb8cc63c56",
                                                "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                                "text": "Pour pallier le manque d’armes antichars, ils inventent également une bombe de fortune, le « cocktail Molotov », baptisée du nom de l’homme qu’ils détestaient le plus : le Premier ministre soviétique."
                                            },
                                            {
                                                "example_id": "df82a103-33da-4c90-8526-89ea46be3664",
                                                "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                                "text": "Le juge à qui est confiée l’affaire est également chargé d’instruire une information contre X pour « provocation publique, non suivie d’effet, à incendie volontaire » ; il s’agit du bulletin donnant la recette du cocktail Molotov."
                                            },
                                            {
                                                "example_id": "f6f00d00-a379-428d-bdf8-0a5a31b111db",
                                                "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                                "text": "Car la chanson a été importante dans le dispositif d’une subversion politique qui, tout compte fait, a peut-être plus avancé par le 45 tours que par le tract, par le mange-disques que par le cocktail Molotov."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d7535bc-5608-4aa4-b0a3-0d9692555249",
                        "source_entry_id": "1ed675a8-dba7-38d8-9e81-a923b41205fd",
