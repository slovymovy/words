                        ],
                        "examples": [
                            {
                                "example_id": "e539b06a-5bef-4214-b077-ec622baba657",
                                "sense_id": "4fcef967-20c5-3897-adfc-9244b72c17b5",
                                "text": "Als voorbeeld noemt de hotelhoudster rederijen. Die zijn in Griekenland vrijgesteld van belastingen. Mogelijk gaat de regering nu de wet aanpassen, zodat de reders ook belasting moeten gaan betalen."
                            },
                            {
                                "example_id": "5abc9d6d-16c1-4d22-b426-6cf258375ca7",
                                "sense_id": "4fcef967-20c5-3897-adfc-9244b72c17b5",
                                "text": "Een Nederlandse hotelhoudster in het gebied vreest ook dat het landschap vol draaiende molens voor bezoekers die rust zoeken niet echt aantrekkelijk is. \"Het helpt het toerisme in ieder geval niet\", zegt ze. \"Juist in een land dat enorm investeert in toerisme is de de logica van dit beleid ver te zoeken.\""
                            }
                        ]
                    }
