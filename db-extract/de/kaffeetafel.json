                ],
                "senses": [
                    {
                        "sense_id": "ec7f3c56-ddb7-30c0-81ca-50b7df93b3d5",
                        "entry_id": "c446f823-a03a-3518-8bdd-1218c8adbb90",
                        "glosses": [
                            "aufwendig/festlich zusammengestellte Tafel zum Kaffee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a50fe7b-e9d4-47d1-bfee-9d85b6e6ac28",
                                "sense_id": "ec7f3c56-ddb7-30c0-81ca-50b7df93b3d5",
                                "text": "„Wenn wir gutes Wetter haben, möchte ich im Garten eine Kaffeetafel decken.“"
                            },
                            {
                                "example_id": "7079f945-b63a-474e-9be4-561b85cbc5a2",
                                "sense_id": "ec7f3c56-ddb7-30c0-81ca-50b7df93b3d5",
                                "text": "„Gestalten Sie deshalb eine Kaffeetafel mit weißer, möglichst gestärkter Tischdecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d423daa-70c2-3a57-9b60-f791e40fe2a7",
                        "entry_id": "c446f823-a03a-3518-8bdd-1218c8adbb90",
                        "glosses": [
                            "Veranstaltung, bei der sich Personen zum Kaffee treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85605030-b553-4360-9094-26e400c1cf7f",
                                "sense_id": "4d423daa-70c2-3a57-9b60-f791e40fe2a7",
                                "text": "„Nach ihrer Beendigung erkundigte ich mich nach der Möglichkeit, in den letzten beiden Stunden eines Diensttages eine Kaffeetafel für das zuarbeitende Personal stattfinden zu lassen.“"
                            },
                            {
                                "example_id": "017f4a29-dfb7-41cc-992e-6faf6a119929",
                                "sense_id": "4d423daa-70c2-3a57-9b60-f791e40fe2a7",
                                "text": "„Einem Sektimbiß schließt sich die Kaffeetafel an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
