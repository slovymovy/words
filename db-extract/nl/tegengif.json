                    }
                ],
                "senses": [
                    {
                        "sense_id": "e43122e6-cd0b-37e0-8b04-4c414d3e8e07",
                        "entry_id": "bc530422-9a8a-3a63-875f-3d9abd90ec9a",
                        "glosses": [
                            "een middel dat de werking van een gif neutraliseert of afzwakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc2e17e-8b96-45e2-8238-77c1a9a74690",
                                "sense_id": "e43122e6-cd0b-37e0-8b04-4c414d3e8e07",
                                "text": "Een tegengif tegen cyanidevergiftiging."
                            },
                            {
                                "example_id": "b509a998-99df-4c87-b974-8785f7f5f838",
                                "sense_id": "e43122e6-cd0b-37e0-8b04-4c414d3e8e07",
                                "text": "Vermoorde halfbroer Kim Jong-un had tegengif zenuwgas VX in tas"
                            }
                        ]
                    },
                    {
                        "sense_id": "664287b0-4970-3a91-b2f8-762e26aaa9b3",
                        "entry_id": "bc530422-9a8a-3a63-875f-3d9abd90ec9a",
                        "glosses": [
                            "iets waardoor iets anders teniet wordt gedaan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5a7513e2-040c-4c82-bc1e-d7985b857fde",
                                "sense_id": "664287b0-4970-3a91-b2f8-762e26aaa9b3",
                                "text": "Zuiver kunnen waarnemen is een tegengif tegen dit soort eenzijdig, stereotiep denken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0eef523-b1ec-4cc9-a535-99e6f18eb0b9",
                        "source_entry_id": "bc530422-9a8a-3a63-875f-3d9abd90ec9a",
                        "source_sense_id": "e43122e6-cd0b-37e0-8b04-4c414d3e8e07",
                        "source_sense_description": "een middel dat de werking van een gif neutraliseert of afzwakt",
                        "target_lang_word": "Gegengift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegengift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb5eb42e-18d5-3b3d-8288-ba6d9c14e81f",
                                        "entry_id": "e6631805-addb-3e7b-9ce0-6d0372261873",
                                        "glosses": [
                                            "Mittel, das gegen unerwünschte Wirkungen einer Vergiftung eingesetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae59d6c-4d88-4a8f-b743-6d73b2d54490",
                                                "sense_id": "bb5eb42e-18d5-3b3d-8288-ba6d9c14e81f",
                                                "text": "„Bitte senden Sie mir eine Liste aller Ärzte in Australien, die Gegengift gegen den Biss von Klapperschlangen vorrätig haben.“"
                                            },
                                            {
                                                "example_id": "edc10fe7-49aa-4bd0-abf2-fa2b447e3e79",
                                                "sense_id": "bb5eb42e-18d5-3b3d-8288-ba6d9c14e81f",
                                                "text": "Bei manchen Vergiftungen helfen auch Gegengifte nicht mehr."
                                            },
                                            {
                                                "example_id": "1e810b3d-2230-40ec-8eb4-475b4d4059ae",
                                                "sense_id": "bb5eb42e-18d5-3b3d-8288-ba6d9c14e81f",
                                                "text": "„Nur das Gift blieb – ohne Hoffnung auf das Gegengift.“"
                                            },
                                            {
                                                "example_id": "adfbdd45-e314-438a-9b36-f9ab9ed8d27d",
                                                "sense_id": "bb5eb42e-18d5-3b3d-8288-ba6d9c14e81f",
                                                "text": "„Da gibt es Falltüren im Fußboden, Gegengifte, Verkleidungen, und alles geht wild durcheinander, rennt und entwirrt sich, ohne dem Leser eine Minute Zeit zum Nachdenken zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad6b2819-2835-4239-a254-ebea96601ecd",
                        "source_entry_id": "bc530422-9a8a-3a63-875f-3d9abd90ec9a",
                        "source_sense_id": "e43122e6-cd0b-37e0-8b04-4c414d3e8e07",
                        "source_sense_description": "een middel dat de werking van een gif neutraliseert of afzwakt",
                        "target_lang_word": "antidote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "A remedy to counteract the effects of poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b7735c-1257-4918-9383-3c93a9d7d028",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "She reached the hospital in time to receive the antidote for the snake venom."
                                            },
                                            {
                                                "example_id": "5aac5a50-1006-4105-9e7a-2e3f1ad27857",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "Can'ſt thou not Miniſter to a minde diſeas'd, / Plucke from the Memory a rooted Sorrow, / Raze out the written troubles of the Braine, / And with ſome ſweet Obliuious Antidote / Cleanſe the ſtufft boſome, of that perillous ſtuffe / Which weighes vpon the heart?"
                                            },
                                            {
                                                "example_id": "cdf4ea79-5fc4-4469-b790-6be4dc7f2024",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "The druids […] believed that mistletoe could make barren animals fecund, and that it was an antidote to all poisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "Something that counteracts or prevents something harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2f5e10-8245-404b-ba50-51fbf1181644",
                                                "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                                "text": "We need an antidote for this misinformation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                        "entry_id": "cae26b1b-59de-3f2f-b169-165bfb9a4c1d",
                                        "glosses": [
                                            "To counteract as an antidote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e55f23-4124-4643-963c-6d68923f9409",
                                                "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                                "text": "For his part, the patient must avoid some commonplace substances in order to avoid antidoting or stopping the action of the homeopathic remedy[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "464a012a-5318-4858-800e-f85a1e5e7767",
                        "source_entry_id": "bc530422-9a8a-3a63-875f-3d9abd90ec9a",
                        "source_sense_id": "e43122e6-cd0b-37e0-8b04-4c414d3e8e07",
                        "source_sense_description": "een middel dat de werking van een gif neutraliseert of afzwakt",
                        "target_lang_word": "antidote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "803e47c3-9d60-3461-913e-5828a1869ff8",
                                        "entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                                        "glosses": [
                                            "Médicament auquel on attribue la propriété de prévenir ou de combattre les effets d’un poison, d’un venin, d’une maladie contagieuse."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2d2c93c-9f21-4f25-8717-173e98cc8066",
                                                "sense_id": "803e47c3-9d60-3461-913e-5828a1869ff8",
                                                "text": "Il n’en fallait pas plus pour encourager Raoult et les raoultistes à entrer en résistance. Bravant le confinement dicté par un Etat français failli, le professeur propose à tous les malades qui se massent devant l’IHU de Marseille de leur administrer son antidote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                        "entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                                        "glosses": [
                                            "Remède à ce qu’on veut combattre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cebd20f-b101-497e-8fb8-c5ff5e25b5c1",
                                                "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                                "text": "La conversation franche et vive du comte de Morvelle était pour madame Necker comme une espèce d’antidote contre les nouvelles flatteuses du marquis."
                                            },
                                            {
                                                "example_id": "d4c95bbb-57d2-41a1-9e87-e8136924910e",
                                                "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                                "text": "Je me souviens d'une cheffe de service dans un hôpital psychiatrique parisien qui avait raconté comment elle avait découvert, médusée, qu'un des antidotes possibles de la mélancolie (appelée aujourd'hui la dépression sévère), ce sont les jeux BDSM. Dit comme ça, cela peut faire sourire ou choquer."
                                            },
                                            {
                                                "example_id": "ce3285ca-8a45-46a7-8418-4a20a679e0d2",
                                                "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                                "text": "L'ascèse s'avère donc l’antidote au diable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
