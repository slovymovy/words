                        "examples": [
                            {
                                "example_id": "13f3163b-6f83-4604-9ae7-b21faa98645b",
                                "sense_id": "74078705-1ec1-327c-9566-d5a4fbdd49f3",
                                "text": "„Kinderen hebben wettelijk het recht op te groeien met hun eigen ouders, dus wij zullen onderzoeken of dat mogelijk is.” Na drie maanden zal de Raad aan de rechter een advies uitbrengen. Dan kan of hereniging plaatsvinden, of toewijzing aan iemand in de directe omgeving, of toewijzing aan een „neutrale” voogd."
                            }
                        ]
                    },
                    {
                        "sense_id": "133f7f9f-a6c2-381b-9997-e9e4dfb7d69c",
                        "entry_id": "a24a567c-b9e9-3139-bef3-0f5a476b91a5",
                        "glosses": [
                            "rechterlijke uitspraak waarbij de eiser gelijk krijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c95a70b-9b06-4b05-8e79-a002861e8bdd",
                                "sense_id": "133f7f9f-a6c2-381b-9997-e9e4dfb7d69c",
                                "text": "Volgens de wrakingskamer is dat enkele feit onvoldoende voor toewijzing van het wrakingsverzoek."
                            }
                        ]
                    }
