                    {
                        "translation_id": "7c800e90-6131-406c-b3b0-98dc36d815de",
                        "source_entry_id": "03152330-25b7-3509-9dc3-8ff48ff6e13e",
                        "source_sense_description": "A shop with women's hats",
                        "target_lang_word": "Boutique",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boutique",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4db382-10da-3ea5-b046-aa607a8b8613",
                                        "entry_id": "d5859394-bfef-31ba-9d12-7ca6f40da84e",
                                        "glosses": [
                                            "kleines Geschäft, vor allem für modische Bekleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da0b3b90-ec90-4f62-aeaf-68987f86724f",
                                                "sense_id": "ca4db382-10da-3ea5-b046-aa607a8b8613",
                                                "text": "„‚Impulse shopping‘, der Gang zur Boutique in der Mittagspause, ist still gestorben.“"
                                            },
                                            {
                                                "example_id": "321dbea4-324c-4108-808d-304aeb6438b4",
                                                "sense_id": "ca4db382-10da-3ea5-b046-aa607a8b8613",
                                                "text": "„Als Martin vor Johannas Boutique eintraf, war es zehn vor zehn.“"
                                            },
                                            {
                                                "example_id": "fceebff1-d439-4e8d-9de9-d9d2453f550f",
                                                "sense_id": "ca4db382-10da-3ea5-b046-aa607a8b8613",
                                                "text": "„Wir stiegen wieder in unser Fun Car und fuhren vorbei an eleganten Boutiquen, Juweliergeschäften, die schwarze Perlen feilboten, und umzäunten Hotelanlagen.“"
                                            },
                                            {
                                                "example_id": "ebd14555-3831-4090-b55a-4183bfb6a082",
                                                "sense_id": "ca4db382-10da-3ea5-b046-aa607a8b8613",
                                                "text": "„Ihnen gehörte eine Boutique im Ort, und sie waren gerade aus Teneriffa zurückgekommen, wo sie oft am Anfang des Winters Urlaub machten, bevor im Geschäft der Weihnachtsrummel begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ea5db0c-52b1-3019-9df9-776ff3a4e3d2",
                                        "entry_id": "d5859394-bfef-31ba-9d12-7ca6f40da84e",
                                        "glosses": [
                                            "kleine Rechtsanwaltskanzlei, die sich auf wenige Rechtsgebiete spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdb6c07-4471-4cf3-aba7-f195270c8cc5",
                                                "sense_id": "9ea5db0c-52b1-3019-9df9-776ff3a4e3d2",
                                                "text": "„Wenn Anwaltskanzlei: (österreichische oder globale) Großkanzlei oder besser mal Boutique?“"
                                            },
                                            {
                                                "example_id": "6d6f0dcd-0873-4389-be1b-b094e1fdc107",
                                                "sense_id": "9ea5db0c-52b1-3019-9df9-776ff3a4e3d2",
                                                "text": "„‚Die Studenten denken um‘, sagt Markus Schmitt, 30, zugelassener Anwalt und Unternehmensjurist in Frankfurt. ‚Wer sich auf Medizin-, IT- oder Presserecht spezialisiert, kommt nach ein paar Jahren auch so in Großkanzleien und hat dazu die Option auf den Einstieg in eine Boutique.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
