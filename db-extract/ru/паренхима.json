                            {
                                "example_id": "ee7687eb-796b-4f79-b509-0f2f7779aeb7",
                                "sense_id": "a656e0c0-ecdf-3449-a013-074b7f396559",
                                "text": "Губчатая паренхима очень рыхлая и немногослойная."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31362a36-b985-41fc-afaf-eac8f6faaf66",
                        "source_entry_id": "99eab4af-878c-3085-aaf5-dbce0733e302",
