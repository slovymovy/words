                "senses": [
                    {
                        "sense_id": "428cac0d-6e71-3ca2-8127-047ca8e72d87",
                        "entry_id": "7845ae38-60e6-3d8a-aeaa-ca3c77b0d781",
                        "glosses": [
                            "weibliche Person, die Neuem mit grundsätzlichem Zweifel begegnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f080987-dc91-46e4-bc2f-ad9e4615fd63",
                                "sense_id": "428cac0d-6e71-3ca2-8127-047ca8e72d87",
                                "text": "Alma war als Skeptikerin bekannt. Bei ihr hieß das aber ‚Was der Bauer nicht kennt, frisst der Bauer nicht.‘"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9283b5ba-6fa6-301b-9add-34f4efd7893e",
                        "entry_id": "7845ae38-60e6-3d8a-aeaa-ca3c77b0d781",
                        "glosses": [
                            "Anhängerin der Philosophie des Skeptizismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2337389-ce24-456d-b16e-9afd211c5ce5",
                                "sense_id": "9283b5ba-6fa6-301b-9add-34f4efd7893e",
                                "text": "Die Skeptikerin sieht jede Wahrheit als relativ an, was heute wahr ist, ist es morgen nicht mehr, Erkenntnis ist vom Erkenntnisprozess und dem konkreten Umfeld abhängig, echte, ewig geltende Erkenntnisse sind nicht möglich."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
