    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "192d7ec5-33dd-3ed6-abaa-6cfdf3749338",
                    "sense_definition": "naar buiten stromen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stromen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water <w>stroomde</w> uit de kapotte leiding de kelder in.",
                            "target_lang_translations": {
                                "fr": "L'eau <w>s'écoulait</w> de la canalisation cassée dans la cave."
                            }
                        },
                        {
                            "text": "Het badwater bedekte het tapijt en <w>stroomde</w> onder de deur door de kamer <w>uit</w>.",
                            "target_lang_translations": {
                                "fr": "L'eau du bain a recouvert le tapis et <w>s'est écoulée</w> sous la porte hors de la pièce."
                            }
                        }
                    ],
                    "synonyms": [
                        "vloeien"
                    ],
                    "common_phrases": [
                        "water stroomt uit"
                    ],
                    "target_lang_definitions": {
                        "fr": "S'écouler vers l'extérieur d'un contenant ou d'un conduit."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "s'écouler",
                                "target_lang_sense_clarification": "se dit d'un liquide qui sort d'un endroit"
                            },
                            {
                                "target_lang_word": "se déverser",
                                "target_lang_sense_clarification": "se dit d'un liquide qui sort en grande quantité"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d54994f-6aae-3d7f-b9ae-cd0177993bfd",
                    "sense_definition": "leegstromen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stromen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rivier <w>stroomt</w> uiteindelijk <w>uit</w> in de grote oceaan.",
                            "target_lang_translations": {
                                "fr": "La rivière <w>se jette</w> finalement dans le grand océan."
                            }
                        },
                        {
                            "text": "Zo heette de watervlakte waarin de Grote Aqua tenslotte <w>uitstroomde</w>.",
                            "target_lang_translations": {
                                "fr": "C'était le nom de l'étendue d'eau dans laquelle la Grande Aqua <w>se déversait</w> finalement."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitmonden"
                    ],
                    "common_phrases": [
                        "rivier stroomt uit"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se vider ou se jeter dans un autre cours d'eau ou une étendue d'eau."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se jeter",
                                "target_lang_sense_clarification": "se dit d'un cours d'eau qui finit dans une mer ou un lac"
                            },
                            {
                                "target_lang_word": "se déverser",
                                "target_lang_sense_clarification": "se dit d'un cours d'eau qui finit dans un autre"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}