                ],
                "senses": [
                    {
                        "sense_id": "3f82fa2f-1fb4-3b08-852b-4538f3bf4fbc",
                        "entry_id": "00fcd11d-59e2-30a2-b290-8ffb8ed6c7ef",
                        "glosses": [
                            "уменьш.-ласк. к друг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "477e1b34-2747-4ff7-889e-cb5e54b87791",
                                "sense_id": "3f82fa2f-1fb4-3b08-852b-4538f3bf4fbc",
                                "text": "Муж мирно сидел за общим столом с дружком жены."
                            }
                        ]
                    },
                    {
                        "sense_id": "66dc1340-bc25-31c1-97ad-971250e3604f",
                        "entry_id": "00fcd11d-59e2-30a2-b290-8ffb8ed6c7ef",
                        "glosses": [
                            "разг. употребляется как ласковое или фамильярное обращение к кому-либо (обычно к лицу мужского или женского пола)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1768ddf3-41c2-4502-911c-ca828d5c6f47",
                                "sense_id": "66dc1340-bc25-31c1-97ad-971250e3604f",
                                "text": "Это только говорить, дружок, легко, что убью."
                            }
                        ]
                    },
                    {
                        "sense_id": "865d7c97-56a1-3064-8d00-2468223c8f48",
                        "entry_id": "00fcd11d-59e2-30a2-b290-8ffb8ed6c7ef",
                        "glosses": [
                            "разг. возлюбленный, милый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59038f38-ee8b-4011-86c6-8e107e7e193f",
                                "sense_id": "865d7c97-56a1-3064-8d00-2468223c8f48",
                                "text": "У меня ли у младой // В сердце миленький дружок."
                            },
                            {
                                "example_id": "f9213e6e-10a0-4130-911f-31921312c207",
                                "sense_id": "865d7c97-56a1-3064-8d00-2468223c8f48",
                                "text": "От дружка дары // Принесу с собой: // На лице ― печаль, // На душе ― тоску."
                            }
                        ]
                    },
                    {
                        "sense_id": "87926a3b-4884-3fb8-9ac8-3f3be8c000a7",
                        "entry_id": "00fcd11d-59e2-30a2-b290-8ffb8ed6c7ef",
                        "glosses": [
                            "неодобр. или уничиж. к друг"
                        ],
                        "tags": [],
                        "examples": []
                    },
