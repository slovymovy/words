{
    "word_family": [
        "brew",
        "brewer",
        "brewery",
        "brewage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee1a1dfb-b099-3080-9e8a-846406b5ae97",
                    "sense_definition": "Present participle and gerund of <w>brew</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can smell fresh coffee <w>brewing</w> in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Я чувствую запах свежего кофе, который <w>варится</w> на кухне.",
                                "zh": "我能闻到厨房里正在<w>冲泡</w>的新鲜咖啡味。"
                            }
                        },
                        {
                            "text": "Dark clouds are gathering, and a storm is <w>brewing</w>.",
                            "target_lang_translations": {
                                "ru": "Темные тучи сгущаются, и <w>назревает</w> буря.",
                                "zh": "乌云密布，一场风暴正在<w>酝酿</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trouble is brewing",
                        "storm is brewing",
                        "brewing tea"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола brew (заваривать, назревать).",
                        "zh": "动词 brew 的现在分词和动名词形式，指正在冲泡或酝酿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назревающий",
                                "target_lang_sense_clarification": "о событиях, шторме"
                            },
                            {
                                "target_lang_word": "заваривающийся",
                                "target_lang_sense_clarification": "о чае или кофе"
                            },
                            {
                                "target_lang_word": "назревание",
                                "target_lang_sense_clarification": "процесс возникновения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲泡",
                                "target_lang_sense_clarification": "指咖啡或茶的制作过程"
                            },
                            {
                                "target_lang_word": "酝酿",
                                "target_lang_sense_clarification": "指风暴或事态的形成"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdab8fd0-27f2-39b7-8cf5-1087256191c7",
                    "sense_definition": "The process of making beer or other alcoholic drinks by fermentation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a kit for home <w>brewing</w> to try making his own ale.",
                            "target_lang_translations": {
                                "ru": "Он купил набор для домашнего <w>пивоварения</w>, чтобы попробовать сделать свой собственный эль.",
                                "zh": "他买了一套家庭<w>酿酒</w>工具，想尝试自己做艾尔啤酒。"
                            }
                        },
                        {
                            "text": "The traditional method of <w>brewing</w> takes several weeks to complete.",
                            "target_lang_translations": {
                                "ru": "Традиционный метод <w>пивоварения</w> занимает несколько недель.",
                                "zh": "传统的<w>酿造</w>方法需要几周时间才能完成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beer making",
                        "fermentation"
                    ],
                    "common_phrases": [
                        "home brewing",
                        "craft brewing",
                        "brewing process"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс изготовления пива или других алкогольных напитков путем брожения.",
                        "zh": "通过发酵制作啤酒或其他酒精饮料的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пивоварение",
                                "target_lang_sense_clarification": "изготовление пива"
                            },
                            {
                                "target_lang_word": "варение",
                                "target_lang_sense_clarification": "общий процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酿造",
                                "target_lang_sense_clarification": "指酒类的制作工艺"
                            },
                            {
                                "target_lang_word": "酿酒",
                                "target_lang_sense_clarification": "指酿造酒类的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "838271f3-f4b7-3dd5-b7f6-716cccff94ac",
                    "sense_definition": "The business, trade, or occupation of a brewer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is famous for its long history of <w>brewing</w>.",
                            "target_lang_translations": {
                                "ru": "Город славится своей долгой историей <w>пивоварения</w>.",
                                "zh": "这座城市以其悠久的<w>酿酒</w>历史而闻名。"
                            }
                        },
                        {
                            "text": "She has worked in the <w>brewing</w> industry for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она проработала в <w>пивоваренной</w> промышленности более двадцати лет.",
                                "zh": "她在<w>酿造</w>行业工作了二十多年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brewing industry",
                        "brewing company"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бизнес, торговля или профессия пивовара.",
                        "zh": "酿酒行业、贸易或职业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пивоваренное дело",
                                "target_lang_sense_clarification": "ремесло или бизнес"
                            },
                            {
                                "target_lang_word": "пивоварение",
                                "target_lang_sense_clarification": "отрасль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酿造业",
                                "target_lang_sense_clarification": "指酿酒相关的产业"
                            },
                            {
                                "target_lang_word": "酿酒业",
                                "target_lang_sense_clarification": "指酿酒的商业领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d64caf06-6dae-3538-8e6f-8bcae88bc4a2",
                    "sense_definition": "The quantity of a drink, such as beer, produced in a single batch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>brewing</w> resulted in a darker ale than the previous one.",
                            "target_lang_translations": {
                                "ru": "Эта <w>варка</w> дала более темный эль, чем предыдущая.",
                                "zh": "这<w>一锅</w>酿出的艾尔啤酒比上一锅颜色更深。"
                            }
                        },
                        {
                            "text": "They compared samples from three different <w>brewings</w> to check for consistency.",
                            "target_lang_translations": {
                                "ru": "Они сравнили образцы из трех разных <w>варок</w>, чтобы проверить постоянство качества.",
                                "zh": "他们比较了来自三<w>批</w>不同酿造的样本，以检查其一致性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "batch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество напитка (например, пива), произведенное за один раз.",
                        "zh": "一次生产出的啤酒等饮料的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варка",
                                "target_lang_sense_clarification": "одна партия напитка"
                            },
                            {
                                "target_lang_word": "партия",
                                "target_lang_sense_clarification": "объем производства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一锅",
                                "target_lang_sense_clarification": "指单次酿造的量"
                            },
                            {
                                "target_lang_word": "一批",
                                "target_lang_sense_clarification": "指生产的批次"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ba0b0c9-64ca-3080-9808-cfc482c39590",
                    "sense_definition": "The formation or gathering of a storm or clouds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>brewing</w> of the storm caught the sailors by surprise.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>назревание</w> шторма застало моряков врасплох.",
                                "zh": "风暴的突然<w>酝酿</w>让水手们措手不及。"
                            }
                        },
                        {
                            "text": "We watched the slow <w>brewing</w> of dark clouds over the mountains.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за медленным <w>сгущением</w> темных туч над горами.",
                                "zh": "我们看着乌云在山顶缓慢地<w>聚集</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "formation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формирование или собирание шторма или облаков.",
                        "zh": "风暴或云层的形成或聚集。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назревание",
                                "target_lang_sense_clarification": "о шторме"
                            },
                            {
                                "target_lang_word": "сгущение",
                                "target_lang_sense_clarification": "об облаках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酝酿",
                                "target_lang_sense_clarification": "指风暴的形成"
                            },
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "指云层的积聚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
