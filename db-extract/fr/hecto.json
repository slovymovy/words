                        "examples": [
                            {
                                "example_id": "219d7411-2bd9-4995-8846-b570def3aa11",
                                "sense_id": "ea4defff-c3a7-3314-a9fc-5d9e58db1685",
                                "text": "Dans une bouillie bourguignonne alcaline, le même pouvoir mouillant peut être obtenu avec des quantités de savon variant de 100 à 1,000 grammes de savon par hecto, suivant la vitesse avec laquelle on a versé le carbonate de soude."
                            },
                            {
                                "example_id": "ff289ea9-acda-44f3-8b31-314decb79d6f",
                                "sense_id": "ea4defff-c3a7-3314-a9fc-5d9e58db1685",
                                "text": "Un lot vin rosé, 500 hectos, 8 degré, à 140 fr. l’hecto."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f726ae0-d28c-3ee2-ada9-98c152ef67b4",
                        "entry_id": "ab7cea1a-0e43-34cf-b588-59759348fbf2",
                        "glosses": [
                            "Hectogramme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5a5c2844-00e2-4a6f-a0db-0c5a634df3a0",
                                "sense_id": "7f726ae0-d28c-3ee2-ada9-98c152ef67b4",
                                "text": "Elle mange des bonbons toute la journée. Il lui en faut plus d'un hecto par jour."
                            }
                        ]
