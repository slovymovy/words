                "senses": [
                    {
                        "sense_id": "6d903429-9b78-390e-97ee-03e82513817a",
                        "entry_id": "11b2e24c-81dd-3b9f-9da8-f27b5ef528b6",
                        "glosses": [
                            "Vorgang, Maßnahme, etwas (ein Gebäude) umzunutzen, für einen anderen Zweck zu verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbda5620-8e5d-4b81-aedb-aba470b2fd8d",
                                "sense_id": "6d903429-9b78-390e-97ee-03e82513817a",
                                "text": "„Viele Industriebauten eignen sich bestens für Umnutzungen.“"
                            },
                            {
                                "example_id": "96de511d-c44d-42e5-a9a4-da12fd45402e",
                                "sense_id": "6d903429-9b78-390e-97ee-03e82513817a",
                                "text": "„Weitaus häufiger als der Abriss ist die Umnutzung der ehemaligen Synagogen bzw. der Grundstücke zu konstatieren.“"
                            },
                            {
                                "example_id": "181ae782-7fd0-4e78-80e0-4745411d806d",
                                "sense_id": "6d903429-9b78-390e-97ee-03e82513817a",
                                "text": "„Auch mehrere Diplomarbeiten wurden über die Möglichkeiten zur Umnutzung von denkmalgeschützten ehemaligen Abspannwerken verfasst.“"
                            }
                        ],
