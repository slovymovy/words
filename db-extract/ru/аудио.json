                                    },
                                    {
                                        "sense_id": "1599c7c0-67ce-3d6f-a29d-81386608c468",
                                        "entry_id": "0f77786b-755f-3c69-b322-50d5d3289341",
                                        "glosses": [
                                            "A piece of sound that is recorded electronically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4577fa1c-58c5-45ee-863e-493172f0d114",
                                                "sense_id": "1599c7c0-67ce-3d6f-a29d-81386608c468",
                                                "text": "I DMed him an audio of myself singing the South Park intro."
                                            },
                                            {
                                                "example_id": "3221cb90-8d15-40af-b8e7-d95500a1932f",
                                                "sense_id": "1599c7c0-67ce-3d6f-a29d-81386608c468",
                                                "text": "Others wryly illustrate appropriated audios, like instructions for quacking like a duck or a letter from an angry airline passenger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
