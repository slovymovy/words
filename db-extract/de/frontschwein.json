                        "examples": [
                            {
                                "example_id": "3b6042c7-0619-45f0-b884-70a50faeaf38",
                                "sense_id": "c6ca20d2-bacb-3c23-955d-cafe03a277d0",
                                "text": "Den Rest der Nacht brachte ich in dem überfüllten Betonklotz des Kompagnieführers, eines biederen Frontschweins, zu, der sich mit seinen Ordonnanzen die Zeit mittels einer Schnapsflasche und einer großen Dose Schweinefleisch vertrieb und öfters diese Beschäftigung unterbrach, um kopfschüttelnd dem ständig wachsenden Artilleriefeuer zu lauschen.",
                                "translation": "Storm of Steel",
                                "english": "Storm of Steel"
                            }
                        ]
                    }
