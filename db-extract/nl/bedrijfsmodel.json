                    {
                        "translation_id": "edd132db-82e9-4408-a00a-bcd8688c715f",
                        "source_entry_id": "f4988d4c-ba85-3c56-a9a7-dfd83b0cfb48",
                        "source_sense_id": "19134560-e9d6-3404-a243-0aaae2413b62",
