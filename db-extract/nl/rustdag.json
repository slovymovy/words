                "senses": [
                    {
                        "sense_id": "018f0fa8-5f86-3603-bd28-73ec9efdddd4",
                        "entry_id": "2b9742ea-057d-37ed-8947-f9a2ad71c60c",
                        "glosses": [
                            "een dag dat men niet werkt of sport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5bec2d-8ef1-4837-a691-de3c36de659d",
                                "sense_id": "018f0fa8-5f86-3603-bd28-73ec9efdddd4",
                                "text": "Voor christenen is zondag de rustdag, voor moslims is dat de vrijdag en voor de joden de zaterdag."
                            },
                            {
                                "example_id": "9f2b0447-215f-475a-98ea-321fd8b5f344",
                                "sense_id": "018f0fa8-5f86-3603-bd28-73ec9efdddd4",
                                "text": "Tijdens een tournooi zijn er altijd één of meer rustdagen tussen de wedstrijden in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0745cde2-a465-491b-8de9-583657ce555f",
                        "source_entry_id": "2b9742ea-057d-37ed-8947-f9a2ad71c60c",
                        "source_sense_id": "018f0fa8-5f86-3603-bd28-73ec9efdddd4",
                        "target_lang_word": "Ruhetag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruhetag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad6e72d-7c7c-30a0-bb56-297420712c8f",
                                        "entry_id": "37d248cd-7a50-39eb-9aff-663cbf76e7e0",
                                        "glosses": [
                                            "ein arbeitsfreier Tag, insbesondere der Sonntag"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955dc68d-26d4-408b-8999-2ac6a29cd819",
                                                "sense_id": "6ad6e72d-7c7c-30a0-bb56-297420712c8f",
                                                "text": "Nach dieser anstrengenden Woche kann ich den Ruhetag gebrauchen."
                                            },
                                            {
                                                "example_id": "4b9f20c7-8565-4e1a-b790-39c933a97ed9",
                                                "sense_id": "6ad6e72d-7c7c-30a0-bb56-297420712c8f",
                                                "text": "„Denn wenn auch der Sonntag auf Speranza Ruhetag ist, so wird er noch lange nicht sündhaftem Müßiggang überlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c8c588d-eac5-3de7-bdb8-1a4589f26e94",
                                        "entry_id": "37d248cd-7a50-39eb-9aff-663cbf76e7e0",
                                        "glosses": [
                                            "Wochentag, an dem ein bestimmtes Geschäft (besonders Gaststätten) geschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48281805-b2e5-4fa0-99f3-18ec7091c8fe",
                                                "sense_id": "3c8c588d-eac5-3de7-bdb8-1a4589f26e94",
                                                "text": "Wollen wir Pizza essen gehen? Nein, das Restaurant hat heute Ruhetag."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3e60d72d-3060-348e-9aec-7910f465bdeb",
                                        "entry_id": "37d248cd-7a50-39eb-9aff-663cbf76e7e0",
                                        "glosses": [
                                            "ein rennfreier Tag während eines Etappenrennens"
                                        ],
                                        "tags": [
                                            "Radrennsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0d2ab2-2c34-4b18-b67c-e72e3d374c28",
                                                "sense_id": "3e60d72d-3060-348e-9aec-7910f465bdeb",
                                                "text": "„Am Ruhetag bestreiten die meisten Fahrer ein lockeres Training, um im Wettkampfrhythmus zu bleiben.“"
                                            },
                                            {
                                                "example_id": "88ee0f55-7e22-4520-ba61-abe26387d0f3",
                                                "sense_id": "3e60d72d-3060-348e-9aec-7910f465bdeb",
                                                "text": "„Nach vier Tagen im Sattel hatte ich in der ungarischen Hauptstadt einen Ruhetag eingelegt und einen entspannten Aufenthalt genossen.“"
                                            },
                                            {
                                                "example_id": "7960717e-9838-4f8a-a85e-6df09a934b46",
                                                "sense_id": "3e60d72d-3060-348e-9aec-7910f465bdeb",
                                                "text": "„Nach einigen Ruhetagen, an denen wir auch ein bisschen an unseren Fahrzeugen herumgeschraubt hatten, waren wir bereit, die Reise Richtung Süden fortzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
