                        "glosses": [
                            "Succéder à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b6ef61-8cc2-421e-bd5c-804cc4cf1238",
                                "sense_id": "d6d6d0ab-7f77-3349-8325-092b3675f613",
                                "text": "Tout cela brodé légèrement sur l'âpre fond de mélancolie d'un pays de cendre auquel resuccède le granit rosé, d'un pays « où l'on pense avec résignation à à la mort »."
                            },
                            {
                                "example_id": "611cc594-34e8-40d1-b38b-5af137bc3b96",
                                "sense_id": "d6d6d0ab-7f77-3349-8325-092b3675f613",
                                "text": "Serait-ce impensable de simplement inverser les 2 états... et de faire resuccéder la mort à la vie par la suite... puis la vie à la mort."
                            }
                        ]
                    }
