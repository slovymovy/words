        "fr-extract.jsonl": [
            {
                "entry_id": "51d902d1-41d1-3c37-8046-8cd98de23418",
                "word": "binoculaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c00d3da0-8ef5-4c5e-b8bc-d5f2018a7ca1",
                        "entry_id": "51d902d1-41d1-3c37-8046-8cd98de23418",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "binoculaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf38ee39-8e47-3fd2-a60c-a71ce949ef81",
                        "entry_id": "51d902d1-41d1-3c37-8046-8cd98de23418",
                        "glosses": [
                            "Relatif aux deux yeux."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "efc51feb-27b6-4337-8f9f-cd6e495e2987",
                                "sense_id": "bf38ee39-8e47-3fd2-a60c-a71ce949ef81",
                                "text": "La connexion qui existe entre la myopie binoculaire et le strabisme divergent n'a pas non plus passé inaperçue autrefois."
                            },
                            {
                                "example_id": "c2d7eeca-18cc-4b84-ae03-a7f7574857d5",
                                "sense_id": "bf38ee39-8e47-3fd2-a60c-a71ce949ef81",
                                "text": "L'écart des chiffres pour les deux sexes est beaucoup moins considérable dans la cécité binoculaire que dans la cécité monoculaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed54f3af-fae9-343c-93c6-4fe0821dd28a",
                        "entry_id": "51d902d1-41d1-3c37-8046-8cd98de23418",
                        "glosses": [
                            "Qualifie la vision qui donne la formation simultanée sur la rétine des deux yeux de deux images d’un même objet, sous un angle différent, et ainsi qui donne la perception du relief."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "305bd0db-7fef-480e-bf3c-7713d0a07b5d",
                                "sense_id": "ed54f3af-fae9-343c-93c6-4fe0821dd28a",
                                "text": "L'acuité visuelle est plus élevée en vision binoculaire qu'en vision monoculaire. Dans la vision binoculaire, les deux axes optiques doivent converger sur l'objet à percevoir, de manière que son image tombe dans des régions correspondantes de la rétine de chaque œil."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e540f73-eaa0-3ef2-a886-9fc4571b4fb6",
                        "entry_id": "51d902d1-41d1-3c37-8046-8cd98de23418",
                        "glosses": [
                            "Qui comporte deux oculaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4305baff-ba96-48ac-85cd-22372cdf7a78",
                                "sense_id": "8e540f73-eaa0-3ef2-a886-9fc4571b4fb6",
                                "text": "Le microscope binoculaire peut être disposé de manière à permettre aux deux yeux d'un seul et même observateur de s'appliquer sur les deux tubes. […]. Nous avons, par ce moyen, le microscope stéréoscopique, seule application utile du microscope binoculaire."
                            },
                            {
                                "example_id": "9e36b8c1-16a7-4caf-8579-b256f38f78f6",
                                "sense_id": "8e540f73-eaa0-3ef2-a886-9fc4571b4fb6",
                                "text": "Je n’ai jamais vu un enfant regarder longtemps dans une visionneuse binoculaire View-Master. Moi-même, je n’ai jamais pu prendre vraiment au sérieux une de ces scènes qui se présentaient dans une espèce de fiche rectangulaire qu’on insérait dans le boîtier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15e28c52-9dd1-4dd5-8a25-a4cb0bda5c36",
                        "source_entry_id": "51d902d1-41d1-3c37-8046-8cd98de23418",
                        "source_sense_description": "(Optique) Relatif aux deux yeux.",
