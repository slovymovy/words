                "senses": [
                    {
                        "sense_id": "41ce57cb-745f-30e9-86d0-b4ed298ba6af",
                        "entry_id": "ba11b2dc-df16-3d26-bf29-a741ed87dc8e",
                        "glosses": [
                            "jemand, der einen Kahn oder ein Schiff treidelt, also von Land aus an einem Seil flussaufwärts zieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10cdea22-d868-4aa7-b295-3abca6d2ef2d",
                                "sense_id": "41ce57cb-745f-30e9-86d0-b4ed298ba6af",
                                "text": "„Seine Mutter hatte William Gutende weitergegeben, daß seine Familie nicht nur Nachkomme von Fischern, Treidlern und Flößern am Rhein war, sondern daß er auch mit dem Ritter Werner Gutende von Lurlinberg verwandt war.“"
                            },
                            {
                                "example_id": "74d8595a-6191-491f-b097-52ad1bf0064a",
                                "sense_id": "41ce57cb-745f-30e9-86d0-b4ed298ba6af",
                                "text": "„Wo früher Holzflöße flussabwärts getrieben waren, kamen nun Lastkähne, von Treidlern gezogen, den Fluss herauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
