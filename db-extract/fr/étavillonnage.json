                    },
                    {
                        "sense_id": "009c3ed6-f006-35fc-9290-2e9d7bed730e",
                        "entry_id": "a859363d-d445-3cef-a189-3860cf416669",
                        "glosses": [
                            "Opération qui consiste à couper grossièrement une peau de la forme désirée avant une coupe plus précise."
                        ],
                        "tags": [
                            "Ganterie"
                        ],
                        "examples": [
                            {
                                "example_id": "0ae4c4d8-eb6f-4cdf-ae2d-8b2e19a3a984",
                                "sense_id": "009c3ed6-f006-35fc-9290-2e9d7bed730e",
                                "text": "L'étavillonnage a pour objet de donner grossièrement aux étavillons la forme et surtout les dimensions de la main quand elle est ouverte . On l'appelle aussi dressage."
                            },
                            {
                                "example_id": "809a381e-8b29-41aa-be7d-e7d5d8989b17",
                                "sense_id": "009c3ed6-f006-35fc-9290-2e9d7bed730e",
                                "text": "L'opération de l'étavillonnage se pratique de la manière suivante l'ouvrier gantier ouvre la peau, l'étire avec la main, la tend et la fait passer plusieurs fois ainsi tendue sur le bord de la table ou de la plaque de marbre qui y est appliquée."
                            }
                        ]
                    }
