                        "cross_references": [
                            {
                                "target_word": "verfilzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d98bb46-2e9b-31d4-aabb-b49f3544df6b",
                                        "entry_id": "b5064cfb-0dad-38fc-853f-a76734684896",
                                        "glosses": [
                                            "unentwirrbar verwickeln"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d108c3b-d6f6-4d54-9a7d-75a055877773",
                                                "sense_id": "0d98bb46-2e9b-31d4-aabb-b49f3544df6b",
                                                "text": "Beim Waschvorgang bei zu hoher Temperatur kann die Wolle verfilzen."
                                            },
                                            {
                                                "example_id": "436c3d41-d8be-48c6-a234-83ffe21f06a3",
                                                "sense_id": "0d98bb46-2e9b-31d4-aabb-b49f3544df6b",
                                                "text": "Seit der Antike werden Tuche mit Füßen, Händen oder Stampfen zeit- und kraftraubend in warmem Laugenwasser gewalkt, damit das Gewebe verfilzt und sich verdichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6ec79f2-78f8-31fe-9413-557207df1ee6",
                                        "entry_id": "b5064cfb-0dad-38fc-853f-a76734684896",
                                        "glosses": [
                                            "sich unentwirrbar ineinander verwickeln"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "figurative",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba8c5c57-1f77-4142-88eb-836917f83c24",
                                                "sense_id": "c6ec79f2-78f8-31fe-9413-557207df1ee6",
                                                "text": "Aber das Buschwerk wucherte, die Lianen schlangen sich über die zerbröckelnden Mauern, die riesigen Baumkronen verfilzten sich ineinander, so daß hier eine Art mystische Dämmerung herrschte wie in einer Gruft."
                                            },
                                            {
                                                "example_id": "41d26935-e9b8-42c7-9bf8-3fdaba110795",
                                                "sense_id": "c6ec79f2-78f8-31fe-9413-557207df1ee6",
                                                "text": "An die 60 000 überladene Autos starteten und verfilzten sich in den Straßen binnen weniger Minuten zu laut hupenden Verkehrsknäueln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
