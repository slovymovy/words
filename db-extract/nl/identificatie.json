                        "cross_references": [
                            {
                                "target_word": "identification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb39b1be-088a-3f3a-85ae-8528b7283565",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "The act of identifying (i.e., which one, which thing)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dffde4fc-66bf-4a07-a1d3-12a6fdf53df4",
                                                "sense_id": "fb39b1be-088a-3f3a-85ae-8528b7283565",
                                                "text": "In many network protocols, identification is complemented by authentication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af23113c-6ede-3b54-90e0-1a029bd07d2d",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "The combination of identifying (which one, which thing) and validating the identity (proving or confirming it); identifying and authenticating viewed as a unitary concept in cognition."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5470e1-f9be-4d06-95dd-ecf7dc4015f5",
                                                "sense_id": "af23113c-6ede-3b54-90e0-1a029bd07d2d",
                                                "text": "Much education and experience is required for proper identification of bird species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89ee101-7829-3129-bc81-cb011128dd0e",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "The state of being identified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75d8d9c-4846-43f6-b777-c761d57588f4",
                                                "sense_id": "a89ee101-7829-3129-bc81-cb011128dd0e",
                                                "text": "The problem's identification was the first step toward dealing with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a53aa0-e896-317b-8850-7481446bd2fb",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "A particular instance of identifying something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b515e647-c760-4191-b5d0-46bd091f3c62",
                                                "sense_id": "a8a53aa0-e896-317b-8850-7481446bd2fb",
                                                "text": "information necessary to make a good identification"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c22eaa-3c40-3b0a-a02f-fa38f1531d57",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "A document or documents serving as evidence of a person's identity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a3f547-b71b-4e63-9dda-e721a6cc9b22",
                                                "sense_id": "06c22eaa-3c40-3b0a-a02f-fa38f1531d57",
                                                "text": "The authorities asked for his identification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "A feeling of support, sympathy, understanding, or belonging towards somebody or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e1ca7c-6d3e-4e7c-970f-5ac2b3535f14",
                                                "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                                "text": "identification with the tribe"
                                            },
                                            {
                                                "example_id": "44a6e274-94e9-4e56-a006-5aa057538b4b",
                                                "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                                "text": "In several actions where FagRaggers were personally involved […] Brill provided sensitive information about our activities to police. Such intervention revealed Brill's identification with authority and his inadequate understanding of how to change the condition of those without power."
                                            },
                                            {
                                                "example_id": "c728c3ac-ec12-47d6-8776-6d6bd6113f00",
                                                "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                                "text": "In the English South and Midlands, identification with Britain ran well ahead of identification with the region; in Yorkshire and the northern England, identification with the region ran about equal to identification with Britain; and in Scotland and Wales (but more especially in Scotland) identification with the region ('Scotland' or 'Wales') ran well ahead of identification with Britain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17fb488d-7a36-41eb-ac62-f22b96a9cf66",
                        "source_entry_id": "1b595c4e-756e-3ca9-b813-0942406bb8e3",
                        "target_lang_word": "identification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "518e1deb-2dab-35c6-a2fb-3b2cc2717955",
                                        "entry_id": "4662e156-783c-3efe-ae38-796ca596fe3d",
                                        "glosses": [
                                            "Action d’identifier, de reconnaître quelque chose ou quelqu’un comme correspondant à une définition ou une identité."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66e04ef3-649f-4567-b4a8-92cb68625226",
                                                "sense_id": "518e1deb-2dab-35c6-a2fb-3b2cc2717955",
                                                "text": "L’important, pour le moment, est de constater que l’identification des musulmans est passée, pour assurer leur sécurité totale, de la désignation vague d’appartenance à un groupe (ahl) à celle, beaucoup plus précise, d’une kabila, symbolisée par un nom qui l’individualise durablement."
                                            },
                                            {
                                                "example_id": "7eb925b9-9ca7-4fc4-9842-83dfdd75716f",
                                                "sense_id": "518e1deb-2dab-35c6-a2fb-3b2cc2717955",
                                                "text": "Ces progrès permettent d’offrir une série de nouveaux services comme le transfert d’appels, la messagerie vocale ou l’identification de la ligne appelante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70beffa0-add2-397a-b744-5e38066951ee",
                                        "entry_id": "4662e156-783c-3efe-ae38-796ca596fe3d",
                                        "glosses": [
                                            "Action de s’identifier, de se reconnaître légitimement ou abusivement dans une définition, une identité, un personnage fictif."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5436474e-3672-4f85-88af-9a310557541e",
                                                "sense_id": "70beffa0-add2-397a-b744-5e38066951ee",
                                                "text": "Mais si l’occidentalisation a provoqué une aliénation chez les musulmans, une aliénation parallèle est apparue dans la communauté avec ce que Laroui nomme médiévalisation, à savoir l’identification de l’Arabe avec le grande époque de l’âge d'or de l’histoire islamique."
                                            },
                                            {
                                                "example_id": "89cbaa07-0440-4c98-8f5d-dd5e0566aa71",
                                                "sense_id": "70beffa0-add2-397a-b744-5e38066951ee",
                                                "text": "Le livre de Gelber atteint le zénith du narcissisme occidental avec l’identification des mâles américains aux mâles néo-guinéens : « […] »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370cb155-42a6-3df2-a961-e016d5b6051c",
                                        "entry_id": "4662e156-783c-3efe-ae38-796ca596fe3d",
                                        "glosses": [
                                            "Amalgame aliénant de son identité propre et de ses intérêts avec ceux de quelqu’un d’autre, résultant d’une manipulation ou pour raisons de survie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5774818a-5f72-46a4-89c4-5e05be072890",
                                                "sense_id": "370cb155-42a6-3df2-a961-e016d5b6051c",
                                                "text": "Dans la conception de Ferenczi, l’aspect relationnel est mis au centre : l’identification à l’agresseur est le mécanisme psychique par lequel la victime annule sa propre subjectivité pour devenir exactement ce dont l’agresseur a besoin. La nécessité de l’adulte prévaut sur celle de l’enfant qui, pour préserver des marges de survie psychique, a recours à la scission du Soi victime du traumatisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
