                    "sense_definition": "Zwakke of gedempte verlichting binnen of buiten door een kleine lichtbron.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kamer werd verlicht door het warme <w>schemerlicht</w> van een kleine lamp. ",
                            "target_lang_translations": {
                                "en": "The room was illuminated by the warm <w>dim light</w> of a small lamp."
                            }
                        },
                        {
