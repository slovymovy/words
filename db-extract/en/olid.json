                        "examples": [
                            {
                                "example_id": "cdde6268-903d-4362-b17b-ccd6b7a54148",
                                "sense_id": "522075c1-2f6a-362d-a831-5c96d941222d",
                                "text": "The febrile attack is usually somewhat severe in all its stages, the pricking sensation occurs during the hot fit, and is like that of pin-points struck into the skin; the sweat is copious, but proves by its sour and olid smell that it is a morbid secretion, and hence affords no relief."
                            },
                            {
                                "example_id": "47528c23-ac5e-454a-81d0-a7c552721d40",
                                "sense_id": "522075c1-2f6a-362d-a831-5c96d941222d",
                                "text": "An olid smell made the boy catch his breath."
                            },
                            {
                                "example_id": "c3c20d85-e3d9-4a50-a5d4-ee8389ac331a",
                                "sense_id": "522075c1-2f6a-362d-a831-5c96d941222d",
                                "text": "It was dark and musty, the carpet giving off an olid smell of mildew."
                            }
                        ]
