                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see beer, coaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9679afb3-a6d1-4fa0-888d-73e80491beed",
                                                "sense_id": "920c808c-f326-323d-8e62-933d6707827f",
                                                "text": "In barrooms, sitting next to you, Whitey used his beer coaster to bulldoze the flakes that accumulated on the bar around him into tiny sand dunes. Fascinated, you might enquire about his tattoo."
                                            },
                                            {
                                                "example_id": "74a9214f-0112-4969-81a7-2a99eb5c6930",
                                                "sense_id": "920c808c-f326-323d-8e62-933d6707827f",
                                                "text": "Even though participants did not expect any benefit, they threw customized darts more accurately, they came up with more anagrams using a customized pen, and they played a beer-coaster flipping game better with customized coasters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d188a7f0-f2d8-35c5-b0cf-eed5db47ddfa",
                                        "entry_id": "7bb75563-74d0-3d8b-a28b-d94842eb84be",
                                        "glosses": [
                                            "Synonym of tramp stamp (“a tattoo on a woman's lower back”)."
                                        ],
