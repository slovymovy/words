                "senses": [
                    {
                        "sense_id": "1e08a6e1-bc14-36ec-ae79-6a2f671c6bf9",
                        "entry_id": "ae54d2ca-cf44-35de-917e-b55ecc107ac4",
                        "glosses": [
                            "Zeitabschnitt, in dem deutlich mehr Menschen als sonst ihr Land verlassen und in ein anderes übersiedeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85ad793-0db0-42b2-b16a-f7e8b09fa4c1",
                                "sense_id": "1e08a6e1-bc14-36ec-ae79-6a2f671c6bf9",
                                "text": "„Die enorme Auswanderungswelle, die Ende der 1960er, Anfang der 1970er Jahre auch Italien, vor allem den Süden des Landes, erfasst hatte, war eine Folge der katastrophalen Wirtschaftslage und der damit verbundenen Perspektivlosigkeit.“"
                            },
                            {
                                "example_id": "b66ea0d1-aada-474a-8989-f6bdb8bdbe3b",
                                "sense_id": "1e08a6e1-bc14-36ec-ae79-6a2f671c6bf9",
                                "text": "„In den 1870er Jahren setzte eine große Auswanderungswelle ein, die nach der Ermordung Zar Alexanders II. durch mehrere Pogrome und neu erlassene diskriminierende Gesetze zu Beginn der 1880er Jahre verstärkt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
