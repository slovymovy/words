                "senses": [
                    {
                        "sense_id": "a37b9376-f9be-366f-b431-663e9200f437",
                        "entry_id": "89844365-46ef-34a3-8237-cd45f4ad1c63",
                        "glosses": [
                            "ein im Mittelmeer oder Atlantik vorkommender, als Speisefisch geschätzter silbrig-grauer Edelfisch aus der Familie der Meerbrassen mit goldgelben Längsstreifen auf den Körperseiten"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ddfdc805-474f-4a36-a471-22d95582b306",
                                "sense_id": "a37b9376-f9be-366f-b431-663e9200f437",
                                "text": "„Die Goldbrassen sind Zwitter, also weiblich und männlich zugleich.“"
                            },
                            {
                                "example_id": "a084a75a-0050-41a6-be8e-4b3eed73f81b",
                                "sense_id": "a37b9376-f9be-366f-b431-663e9200f437",
                                "text": "„Die Goldbrasse zählt zu den wertvollsten Mittelmeerfischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
