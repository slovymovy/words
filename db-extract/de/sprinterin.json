                    {
                        "sense_id": "1b53e76d-e08f-3c75-a58a-462bc2a39378",
                        "entry_id": "c1d2d6f6-1cef-3cc5-b721-5653a322fe21",
                        "glosses": [
                            "Läuferin, die über kurze Distanzen maximale Geschwindigkeit erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63e4995-167a-484e-aaba-cf005f160da6",
                                "sense_id": "1b53e76d-e08f-3c75-a58a-462bc2a39378",
                                "text": "Fünf Monate nach ihrem EM-Gold von Barcelona stehen Weitspringer Christian Reif (Ludwigshafen) und Sprinterin Verena Sailer (Mannheim) als Deutschlands \"Leichtathleten des Jahres\" 2010 fest."
                            },
                            {
                                "example_id": "a4a2026b-b143-44ef-b3a0-9f5d3d582ea8",
                                "sense_id": "1b53e76d-e08f-3c75-a58a-462bc2a39378",
                                "text": "Immer wieder haben Sportler Clenbuterol verbotenerweise als Dopingmittel benutzt. Der bekannteste Fall im deutschen Sport ist der der Sprinterin Katrin Krabbe."
                            },
                            {
                                "example_id": "207fdbc4-bf46-473a-80a5-1f573b2711a0",
                                "sense_id": "1b53e76d-e08f-3c75-a58a-462bc2a39378",
                                "text": "Eine australische Sprinterin trennt sich von ihren Brustimplantaten, um bei den Olympischen Spielen bessere Chancen zu haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
