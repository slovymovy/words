                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "urazić",
                                "target_lang_sense_clarification": "aspekt dokonany od krenken"
                            },
                            {
                                "target_lang_word": "zranić",
                                "target_lang_sense_clarification": "urazić czyjeś uczucia lub dumę"
                            },
                            {
