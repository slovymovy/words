                    {
                        "translation_id": "7ab79885-a711-494f-8d8e-802964c7c793",
                        "source_entry_id": "92d730fe-7f8e-3046-88f9-49d8ee6c2062",
                        "source_sense_id": "173ff510-d1b3-331a-98db-b3ef214d75c4",
                        "target_lang_word": "phallus",
