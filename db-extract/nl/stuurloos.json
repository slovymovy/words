                                            {
                                                "example_id": "ff33e4fa-2a99-4514-af60-97b87bedb2ea",
                                                "sense_id": "45fcfc0b-2c23-38e3-8821-3f6c5a6a0f1e",
                                                "text": "„Zum ersten Mal begriff ich das ganze grandiose Ausmaß der Entfernungen zwischen den Sternen, zum ersten Mal wurde mir die wahre Tiefe des grenzen- und richtungslosen Abgrunds bewusst.“"
                                            }
