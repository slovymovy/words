                                "target_senses": [
                                    {
                                        "sense_id": "2ad0c7de-8189-3240-bb02-e2a1b939f8bd",
                                        "entry_id": "5d5d1714-d16b-323c-b920-a5acb4fba6a5",
                                        "glosses": [
                                            "un elemento sustentante que habitualmente se utiliza para transformar una planta octogonal en cuadrada, o lo que es lo mismo, para efectuar la transición desde una cúpula octogonal al espacio rectangular que ha de cubrir. Tiene forma abocinada y parece una bovedilla semicónica con el vértice en el ángulo de dos muros y la parte ancha hacia fuera. Cumple la misma función que las pechinas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "651c4575-c20d-46f6-a9da-13721e1103ea",
                        "source_entry_id": "e9521bb3-6914-3a90-b8f9-6de261ab72a2",
                        "source_sense_description": "вытянутый в трубку рот некоторых членистоногих",
                        "target_lang_word": "Saugrüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saugrüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7b9ab8-c883-362f-834f-07a2880bd50a",
                                        "entry_id": "f0da2701-f4b8-347d-bf21-ce95fefb4581",
                                        "glosses": [
                                            "Saugrohr bei stechenden oder saugenden Insekten, mit dem diese Tiere ihre flüssige Nahrung aufnehmen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb9acce-262e-41f9-8c23-cd3d565eb50c",
                                                "sense_id": "7a7b9ab8-c883-362f-834f-07a2880bd50a",
                                                "text": "„Was man von ihr sehen kann, Brüste, Hände und Gesicht, ist kalkweiß. Ihre offenen Augen klebrig trocken von den Saugrüsseln der Insekten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
