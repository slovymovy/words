                "senses": [
                    {
                        "sense_id": "490a9027-6ddd-3b72-aaa3-3e31e77a66b6",
                        "entry_id": "ae270e3b-1cfb-39f6-a009-219386a059c9",
                        "glosses": [
                            "mit einem Sprung in die Höhe ausgeführter erster Schlag, der den Ball ins Spiel bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d512da1-04ef-4b87-ab59-5988b9dd5a92",
                                "sense_id": "490a9027-6ddd-3b72-aaa3-3e31e77a66b6",
                                "text": "„Da es den Berlinern nicht gelang, die Sprungangaben des OFG-Schlagmannes Konprecht in den Griff zu bekommen, gelang es den Offenburgern, das Spiel zu drehen.“"
                            },
                            {
                                "example_id": "681fbf85-d800-4458-98fb-34ea29b99a16",
                                "sense_id": "490a9027-6ddd-3b72-aaa3-3e31e77a66b6",
                                "text": "„Beim Stand von 10:14 dann der entscheidende Punkt. Sprungangabe durch T. Dahms, Brandis parierte nicht, Punkt für Dommitzsch.“"
                            },
                            {
                                "example_id": "77cc242f-2e4f-43fa-be24-353587ad240c",
                                "sense_id": "490a9027-6ddd-3b72-aaa3-3e31e77a66b6",
                                "text": "„Im dritten Satz witterten die unverdrossen fightenden TVB-Damen noch einmal eine Chance, als Juliane Frühauf ihr Team mit gezielten Sprungangaben in Führung brachte, die man mit variablen, druckvollen Angriffen und großer Beweglichkeit in der Abwehr konsequent ausbaute.“"
                            },
                            {
                                "example_id": "04cc5bb5-5c8c-4269-b5ac-93d87af0d7a8",
                                "sense_id": "490a9027-6ddd-3b72-aaa3-3e31e77a66b6",
                                "text": "„Die Gäste hatten gravierende Probleme in der Annahme seiner knallharten Sprungangaben und mussten die TSG bis auf 16:10 davonziehen lassen.“"
                            },
                            {
                                "example_id": "fe8f341d-b2a9-4f29-8616-a6424fb6876f",
                                "sense_id": "490a9027-6ddd-3b72-aaa3-3e31e77a66b6",
                                "text": "„Eine gelungene Sprungangabe von Katharina Niklas, ein Block von Marina Griesbach und zwei vergebene Angaben des VC bescherten dem ATV drei Satzbälle, die aber allesamt vergeben wurden, sodass der VC Bottrop diesen Satz doch noch mit 27:25 für sich entscheiden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
