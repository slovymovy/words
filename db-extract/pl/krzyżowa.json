                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a13dd239-714c-3e9d-9def-52ffa663a89e",
                                        "entry_id": "f2c0c031-d2c9-3dac-8d45-947b9520c2d7",
                                        "glosses": [
                                            "The hindquarters of a four-legged mammal, not including its legs"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4925ea15-255c-35f3-bb9c-dd30549972bc",
                                        "entry_id": "f2c0c031-d2c9-3dac-8d45-947b9520c2d7",
                                        "glosses": [
                                            "A cut of meat from the rump of an animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb49506-c3fd-366a-a225-bb823f550bd5",
                                        "entry_id": "f2c0c031-d2c9-3dac-8d45-947b9520c2d7",
                                        "glosses": [
                                            "The buttocks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6256693e-a62a-36fe-b4fb-255b1d0085d0",
                                        "entry_id": "f2c0c031-d2c9-3dac-8d45-947b9520c2d7",
                                        "glosses": [
                                            "A remnant, as in Rump Parliament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f639882-2b86-4410-a45f-e39470e20fdd",
                                                "sense_id": "6256693e-a62a-36fe-b4fb-255b1d0085d0",
                                                "text": "This is the rump of the C.L.C. branch to Southport Lord Street, which lost its passenger services beyond Aintree from January 7, 1952, whereupon the timetable between Gateacre and Aintree was greatly curtailed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15c5dcaf-0661-3965-ab02-167d0f9598c6",
                                        "entry_id": "49301e94-c1f0-312c-8d8c-9de416c14c40",
                                        "glosses": [
                                            "To turn one's back on, to show one's (clothed) backside to, as a sign of disrespect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75b2a07c-42d9-4731-a8dd-e5aae26be3df",
                                                "sense_id": "15c5dcaf-0661-3965-ab02-167d0f9598c6",
                                                "text": "And when they succeeded in forcing themselves back upon the King, who loathed them, and had rumped them, they put the Great Seal into Commission, and omitted Lord Brougham's name in the list of the Cabinet."
                                            },
                                            {
                                                "example_id": "d7c5d92e-e446-44be-bc39-175cb2335d95",
                                                "sense_id": "15c5dcaf-0661-3965-ab02-167d0f9598c6",
                                                "text": "Soon afterwards, meeting the lecturer, whom he had been previously in the habit of greeting with great courtesy, the Duke looked him fairly down, and then rumped him without mercy."
                                            },
                                            {
                                                "example_id": "c5a0c308-7b75-4b30-a9e8-71fc7ff425d7",
                                                "sense_id": "15c5dcaf-0661-3965-ab02-167d0f9598c6",
                                                "text": "When Lord Carteret and the Earl of Sunderland went to court in 1734 to pay their respects after the marriage of Carteret's daughter to Sunderland's brother, John Spencer, MP, the king turned his back upon them ('rumped' them […])."
                                            },
                                            {
                                                "example_id": "eba4cbcb-7c9f-48da-8844-e523882299fe",
                                                "sense_id": "15c5dcaf-0661-3965-ab02-167d0f9598c6",
                                                "text": "Next day he walked to St James's Palace to be presented to his godfather, the famously rude King George II, who 'rumped' him (turned his back on him) without a word. Hervey's successes at sea had not dispelled the displeasure caused by ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e69035-45c5-3d2f-a4bc-b2a0e51fb5a7",
                                        "entry_id": "49301e94-c1f0-312c-8d8c-9de416c14c40",
                                        "glosses": [
