                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d15d452e-5b6f-4088-be83-8195f13ba69b",
                                                "sense_id": "9d913d15-8456-3052-9934-da94ac8d204e",
                                                "text": "Und du altes Trampeltier hast die Sache wieder vermasselt!"
