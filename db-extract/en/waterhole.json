                "senses": [
                    {
                        "sense_id": "581e8fa6-a7c4-3e66-b1fd-efdb0924e5af",
                        "entry_id": "9733836d-dd36-37ae-a2ed-21940b343b14",
                        "glosses": [
                            "A depression in which water collects, especially one where wild animals come to drink."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ebf7ed-df75-49d9-b6a3-9799560a54b6",
                                "sense_id": "581e8fa6-a7c4-3e66-b1fd-efdb0924e5af",
                                "text": "From habit the sheep would head for the river, but, though it was early spring, the winter had been droughty, and the river was only a string of dangerous water-holes."
                            }
                        ]
                    },
                    {
                        "sense_id": "25598b14-fc15-3a4c-8b92-debc6f746ebe",
                        "entry_id": "9733836d-dd36-37ae-a2ed-21940b343b14",
                        "glosses": [
                            "A watering hole; a place where people meet to drink and talk."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1378ad99-abb3-3c30-917d-f04be448ffbf",
                        "entry_id": "9733836d-dd36-37ae-a2ed-21940b343b14",
                        "glosses": [
                            "A part of the electromagnetic spectrum, between the regions where hydrogen and hydroxyl radiate, that is relatively quiet in terms of radio astronomy."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e71a1f44-0d3b-44f6-99aa-b780d2dfccea",
