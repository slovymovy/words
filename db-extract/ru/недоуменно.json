                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5d6df2c-90a7-3b0c-8d0e-25a0b1b94297",
                        "entry_id": "ade0129f-d7ba-3457-8bb5-58d7dd7379f8",
                        "glosses": [
                            "выражая недоумение или свидетельствуя о нём"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a957c46a-eeae-4198-b5bf-949b71ae627b",
                                "sense_id": "e5d6df2c-90a7-3b0c-8d0e-25a0b1b94297",
                                "text": "Ты молчишь недоуменно, // Ты поверх меня глядишь, // И становится мгновенно // Очень страшной эта тишь."
                            }
                        ]
                    },
                    {
                        "sense_id": "90dfce66-7a0e-3f03-aec6-676d04ffbcf3",
                        "entry_id": "ade0129f-d7ba-3457-8bb5-58d7dd7379f8",
                        "glosses": [
                            "испытывая недоумение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036f571e-e854-439d-9d8d-ff73f5dfa314",
                                "sense_id": "90dfce66-7a0e-3f03-aec6-676d04ffbcf3",
                                "text": "Я слушал, как чайки плачут, // Как грохочет у берега пена. // Внезапно спросил он: «Что всё это значит?» // И руку поднял недоуменно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
