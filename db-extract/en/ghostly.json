    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                "word": "ghostly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a725a58-203c-438c-87ff-46b668e41857",
                        "entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                        "tags": [
                            "comparative"
                        ],
                        "form": "ghostlier"
                    },
                    {
                        "form_id": "c76967bd-dc74-4b5e-9ae5-8a560c66fce8",
                        "entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                        "tags": [
                            "superlative"
                        ],
                        "form": "ghostliest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5a1a794-61d8-3c64-86ea-cd80b635e9f3",
                        "entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                        "glosses": [
                            "Of or pertaining to ghosts or spirits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e546bc-86f7-46ca-a420-08001a576e69",
                                "sense_id": "c5a1a794-61d8-3c64-86ea-cd80b635e9f3",
                                "text": "a ghostly figure with a hood"
                            },
                            {
                                "example_id": "50cb1d08-a7ae-4675-b070-263f39d2bea2",
                                "sense_id": "c5a1a794-61d8-3c64-86ea-cd80b635e9f3",
                                "text": "The graveyard was haunted by a ghostly figure of a young girl."
                            },
                            {
                                "example_id": "6524425e-1b5b-4191-8618-24852e1c4a5e",
                                "sense_id": "c5a1a794-61d8-3c64-86ea-cd80b635e9f3",
                                "text": "The ghostly moaning was heard from upstairs."
                            }
                        ]
                    },
                    {
                        "sense_id": "c87d4b25-5925-39f4-88fb-b49947a946e3",
                        "entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                        "glosses": [
                            "Spooky; frightening."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9fda07-4a87-4e09-b4d6-33aa4df0c287",
                                "sense_id": "c87d4b25-5925-39f4-88fb-b49947a946e3",
                                "text": "His lips were chapped and lined with a ghostly purple fringe."
                            },
                            {
                                "example_id": "b18cdac3-a4f3-4477-b39c-f93b0d5028db",
                                "sense_id": "c87d4b25-5925-39f4-88fb-b49947a946e3",
                                "text": "A ghostly hush fell."
                            },
                            {
                                "example_id": "1eeb395f-959e-4cc0-a7b9-837961644df7",
                                "sense_id": "c87d4b25-5925-39f4-88fb-b49947a946e3",
                                "text": "Scores of coconut-shell fires blazed with their characteristic glaring white flame, throwing grotesque shadows on the brown thatched huts, dancing in fairylike shimmerings among the domes of coconut fronds, casting ghostly reaches of light through the adjacent graveyards, and silhouetting the forms of pareu-clad natives at work cleaning their fish or laying them on the live coals to broil."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb821040-95b8-3c26-888c-795dcf7f2ffd",
                        "entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                        "glosses": [
                            "Relating to the soul; not carnal or secular; spiritual."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "641472de-bacb-45a7-a413-3cd861bb4dbc",
                                "sense_id": "bb821040-95b8-3c26-888c-795dcf7f2ffd",
                                "text": "a ghostly confessor"
                            },
                            {
                                "example_id": "83b8ea1a-b01c-4a0c-b469-918c9eaeafbd",
                                "sense_id": "bb821040-95b8-3c26-888c-795dcf7f2ffd",
                                "text": "Save and defend us from our ghostly enemies."
                            },
                            {
                                "example_id": "154271eb-5cf6-40d8-84c1-e17e154d689c",
                                "sense_id": "bb821040-95b8-3c26-888c-795dcf7f2ffd",
                                "text": "one of the ghostly children of St. Jerome"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c27e4657-e0a8-4e1a-b330-1a86b20432ff",
                        "source_entry_id": "976fde12-3029-3718-b5e1-c731ff0a1a15",
                        "source_sense_description": "pertaining to ghosts",
                        "target_lang_word": "fantomatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5a80cc7-e3d6-363c-931c-b93118f34586",
                                        "entry_id": "016c9dbd-0025-378c-9bb2-24e3815f8cc2",
                                        "glosses": [
                                            "Qui a rapport aux fantômes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f37414b-b374-43ab-a117-92340e8139cb",
                                                "sense_id": "f5a80cc7-e3d6-363c-931c-b93118f34586",
                                                "text": "Il y avait quelque chose de fantomatique dans leur démarche, genre réveil des morts vivants."
                                            },
                                            {
                                                "example_id": "3e191041-9405-4c33-85c9-18a192fa06e4",
                                                "sense_id": "f5a80cc7-e3d6-363c-931c-b93118f34586",
                                                "text": "La lumière de la caméra jetait des ombres fantomatiques dans le boyau, éclairant par intermittence Chartrand et Langdon."
                                            },
                                            {
                                                "example_id": "ae54bf60-1657-4144-8bc7-1f4723f6f274",
                                                "sense_id": "f5a80cc7-e3d6-363c-931c-b93118f34586",
                                                "text": "Apparition fantomatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618e2038-ca6f-31c2-b05b-21b4f53c5faf",
                                        "entry_id": "016c9dbd-0025-378c-9bb2-24e3815f8cc2",
                                        "glosses": [
                                            "Qui s’apparente à un fantôme, en ce sens qu’on ne le voit jamais ou presque jamais."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9015386-0510-4e7c-97be-6c4c50613e7f",
                                                "sense_id": "618e2038-ca6f-31c2-b05b-21b4f53c5faf",
                                                "text": "Je pourrais diminuer ces dépenses de moitié en habitant en colocation ; les petites annonces d’appartement à partager abondent, et Amir lui-même me propose d’habiter avec lui : 1000 $ américains par mois pour reprendre la chambre de leur troisième (et actuellement fantomatique) colocataire."
                                            },
                                            {
                                                "example_id": "2f361691-320b-45f4-bb25-fcd20424853b",
                                                "sense_id": "618e2038-ca6f-31c2-b05b-21b4f53c5faf",
                                                "text": "À l’avalanche, Smoove ne répond que par des propos lénifiants, avant d’aiguiller les râleurs vers un service clients — aussi fantomatique que ses bécanes — où ils peuvent toujours tenter de demander la résiliation de leur abonnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
