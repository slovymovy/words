                                        "sense_id": "26caf61c-272b-3ff9-892a-698fcefdd18f",
                                        "entry_id": "26a1cfc3-9344-34c1-ad28-793cfdb93cf1",
                                        "glosses": [
                                            "A tall pole up which one or more flags may be raised and flown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flagpole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71dba76e-25fd-3e2d-a89f-682b7a6494d0",
                                        "entry_id": "571468e0-41af-316d-b715-41a9c0a34bde",
                                        "glosses": [
                                            "To exit a country momentarily and reenter, usually in order to satisfy immigration requirements."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa89cdce-bbf0-45d3-9c94-8bf70c3118a4",
                                                "sense_id": "71dba76e-25fd-3e2d-a89f-682b7a6494d0",
                                                "text": "I understand immigrating to Canada is getting harder and harder. [The difficulty of navigating bureaucracy] might be a way to let people fall between the cracks. I really don't know. The hoops immigrants have to go through, such as flagpoling. And I don't have any political representatives. I didn't vote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8313d141-8f1f-466d-a33c-53f207f1a6ef",
                        "source_entry_id": "9bc8e6c7-0ed5-396a-b668-e3da89f2943d",
                        "source_sense_id": "0020fb7b-c208-33c1-9d6b-8de4d5afc955",
