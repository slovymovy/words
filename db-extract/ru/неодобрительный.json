                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3beb6f6-edca-412d-be52-08776a9ab87b",
                        "source_entry_id": "b6d3ba63-c12a-3c36-833f-e8ffc7b28875",
                        "source_sense_id": "80821e1d-4de0-3db4-bed5-455edd53e4e3",
                        "target_lang_word": "désapprobateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désapprobateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2399f508-2fc5-31e5-b671-c3e77a9bdae6",
                                        "entry_id": "086d9a5d-b997-3dc1-8901-b81c3b893581",
                                        "glosses": [
                                            "Celui qui désapprouve par caractère, par habitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b61e60-811a-48ff-97fb-7125c7b8ae17",
                                                "sense_id": "2399f508-2fc5-31e5-b671-c3e77a9bdae6",
                                                "text": "De plus, un désapprobateur a indiqué que le requérant était le propriétaire antérieur au moment de la requête."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désapprobateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b191434-9980-31fb-b9cf-028ceb888e6e",
                                        "entry_id": "a90c9bc0-1fd6-3e46-ba5f-f745ba6548c1",
                                        "glosses": [
                                            "Qui désapprouve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21be313c-e88b-4318-899b-694512aa75d8",
                                                "sense_id": "8b191434-9980-31fb-b9cf-028ceb888e6e",
                                                "text": "Mais la peur trop forte finit pat l’emporter et je … cours dans les couloirs jusqu’aux bras de ma mère dans lesquels je me précipite, haletant, sous l’œil sec et désapprobateur des trois vieilles tantes dont deux en maugréant caressent leur menton poilu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
