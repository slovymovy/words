                                    {
                                        "sense_id": "612f7668-2387-3c23-87d1-9bf021520b67",
                                        "entry_id": "a5d72b4d-5b94-3c13-9f7a-1f6681a76747",
                                        "glosses": [
                                            "An extremely tough and strong athlete, especially one who competes in extreme athletic competitions or in a large number of games consecutively."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f5c3c74-0c57-3b97-bb0e-fbaae3a0200e",
                                        "entry_id": "a5d72b4d-5b94-3c13-9f7a-1f6681a76747",
                                        "glosses": [
                                            "A form of surf lifesaving competition which combines swimming, board paddling, ski paddling and running."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9474fb3-cc2d-46f8-bd91-1ab41c3e077b",
                                                "sense_id": "2f5c3c74-0c57-3b97-bb0e-fbaae3a0200e",
                                                "text": "The catalyst for this rift was the ironman, a multi-discipline sport combining swimming, running, surf-skis and paddle-boards.\nIntroduced to Australia in 1965 by touring American lifeguards, the ironman is a test of stamina, strength, and diverse skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e64dd9-9546-3e55-a268-a50cf0991e3f",
                                        "entry_id": "a5d72b4d-5b94-3c13-9f7a-1f6681a76747",
                                        "glosses": [
                                            "An extreme form of triathlon, expecially one organised by the World Triathlon Corporation that comprises a 2.4-mile swim, a 112-mile bike race and a marathon run."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d26404-ac35-44be-86e4-69363fb28a21",
                                                "sense_id": "59e64dd9-9546-3e55-a268-a50cf0991e3f",
                                                "text": "“Every sense of your body is taken over by the climate,” said the New York City native Christopher Bergland, who set a record at triple ironmans (7.2-mile swim, 336-mile bike, 78.6-mile run) but failed to finish one of his three Badwater races."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4283390-858c-3787-8bb2-bab64dbca359",
                                        "entry_id": "a5d72b4d-5b94-3c13-9f7a-1f6681a76747",
                                        "glosses": [
                                            "The winner of such a lifesaving event or triathlon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
