{
    "word_family": [
        "собственность",
        "собственник",
        "собственный",
        "обособить",
        "особый"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "478bcaa5-a4f9-3879-8b49-9abb1f616df2",
                    "sense_definition": "Вводное слово, употребляемое для уточнения, конкретизации или выражения сути дела; по существу, собственно говоря.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "вводное_слово",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "А ты, <w>собственно</w>, почему интересуешься этим вопросом?",
                            "target_lang_translations": {
                                "tr": "Peki sen <w>aslında</w> neden bu konuyla ilgileniyorsun?"
                            }
                        },
                        {
                            "text": "Мы, <w>собственно</w>, уже закончили обсуждение и готовы принять решение.",
                            "target_lang_translations": {
                                "tr": "Biz <w>aslına bakılırsa</w> tartışmayı çoktan bitirdik ve karar almaya hazırız."
                            }
                        }
                    ],
                    "synonyms": [
                        "собственно говоря",
                        "по сути",
                        "в сущности"
                    ],
                    "common_phrases": [
                        "собственно говоря"
                    ],
                    "target_lang_definitions": {
                        "tr": "Açıklama yapmak, somutlaştırmak veya konunun özünü belirtmek için kullanılan ara söz; aslında, aslına bakılırsa."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aslında",
                                "target_lang_sense_clarification": "gerçek durumu belirtirken"
                            },
                            {
                                "target_lang_word": "aslına bakılırsa",
                                "target_lang_sense_clarification": "doğrusunu söylemek gerekirse"
                            },
                            {
                                "target_lang_word": "doğrusu",
                                "target_lang_sense_clarification": "gerçeği söylemek gerekirse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "544f7748-0567-348a-94c9-79e84fc78123",
                    "sense_definition": "Наречие в значении «по сути дела», «в действительности».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "вводное_слово",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот проект, <w>собственно</w>, и был главной причиной нашей встречи.",
                            "target_lang_translations": {
                                "tr": "Bu proje <w>aslında</w> buluşmamızın da ana sebebiydi."
                            }
                        },
                        {
                            "text": "Она не знала, что, <w>собственно</w>, происходит в соседней комнате.",
                            "target_lang_translations": {
                                "tr": "Yan odada <w>gerçekte</w> ne olup bittiğini bilmiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "фактически",
                        "на самом деле"
                    ],
                    "target_lang_definitions": {
                        "tr": "İşin özünde, gerçekte anlamında kullanılan zarf."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aslında",
                                "target_lang_sense_clarification": "gerçekte, işin özünde"
                            },
                            {
                                "target_lang_word": "gerçekten",
                                "target_lang_sense_clarification": "hakikaten"
                            },
                            {
                                "target_lang_word": "özünde",
                                "target_lang_sense_clarification": "temelinde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af9aeba-ba76-354a-b2e5-34090596ac47",
                    "sense_definition": "Частица, употребляемая для выделения или ограничения; именно, только, исключительно.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "выделение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я пришёл сюда <w>собственно</w> ради встречи с вами.",
                            "target_lang_translations": {
                                "tr": "Buraya <w>sırf</w> sizinle görüşmek için geldim."
                            }
                        },
                        {
                            "text": "Евгений Константиныч! Скажу ещё несколько слов <w>собственно</w> вам.",
                            "target_lang_translations": {
                                "tr": "Yevgeniy Konstantinıç! <w>Özellikle</w> size birkaç söz daha söyleyeceğim."
                            }
                        }
                    ],
                    "synonyms": [
                        "именно",
                        "только",
                        "исключительно"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vurgulamak veya sınırlandırmak için kullanılan edat; özellikle, sırf, sadece."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sırf",
                                "target_lang_sense_clarification": "yalnızca, sadece"
                            },
                            {
                                "target_lang_word": "özellikle",
                                "target_lang_sense_clarification": "bilhassa"
                            },
                            {
                                "target_lang_word": "bizzat",
                                "target_lang_sense_clarification": "kendisi olarak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ae2f8d8-2a4e-3667-9567-9b0b4a88bc75",
                    "sense_definition": "В буквальном, строгом смысле слова.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "буквально",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта территория не относится к <w>собственно</w> городу, это пригород.",
                            "target_lang_translations": {
                                "tr": "Bu bölge <w>asıl</w> şehre ait değil, burası banliyö."
                            }
                        },
                        {
                            "text": "В <w>собственно</w> научном исследовании такие методы не применяются.",
                            "target_lang_translations": {
                                "tr": "<w>Dar anlamıyla</w> bilimsel bir araştırmada bu tür yöntemler uygulanmaz."
                            }
                        }
                    ],
                    "synonyms": [
                        "буквально",
                        "непосредственно"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kelimenin tam, dar veya asıl anlamıyla."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "asıl",
                                "target_lang_sense_clarification": "gerçek, temel olan"
                            },
                            {
                                "target_lang_word": "dar anlamıyla",
                                "target_lang_sense_clarification": "sınırlandırılmış anlamda"
                            },
                            {
                                "target_lang_word": "doğrudan",
                                "target_lang_sense_clarification": "aracısız olarak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0e7b81b-c03a-3b8e-bba3-946fd4f59022",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>собственный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всё его имущество было весьма скромно и <w>собственно</w> лишь ему одному.",
                            "target_lang_translations": {
                                "tr": "Tüm mal varlığı oldukça mütevazıydı ve yalnızca kendisine <w>aitti</w>."
                            }
                        },
                        {
                            "text": "Это мнение было глубоко <w>собственно</w> и не зависело от чужих взглядов.",
                            "target_lang_translations": {
                                "tr": "Bu görüş tamamen kendisine <w>özgüydü</w> ve başkalarının fikirlerinden bağımsızdı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "'Собственный' (kendi, öz) sıfatının nötr cins tekil kısa formu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "özgü",
                                "target_lang_sense_clarification": "kendine has"
                            },
                            {
                                "target_lang_word": "ait",
                                "target_lang_sense_clarification": "kendisine ait"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}