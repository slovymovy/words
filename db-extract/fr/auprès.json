        "fr-extract.jsonl": [
            {
                "entry_id": "ab085fb6-f288-3900-8639-a3fb7f1bca30",
                "word": "auprès",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f684ede4-4fd2-3a4d-b798-33743e32d9ba",
                        "entry_id": "ab085fb6-f288-3900-8639-a3fb7f1bca30",
                        "glosses": [
                            "Tout proche, tout contre, à côté…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed0b8f5-df63-4b7e-a41f-b3cecc71716f",
                                "sense_id": "f684ede4-4fd2-3a4d-b798-33743e32d9ba",
                                "text": "J’étais si plein de mon amour qu’à peine entendais-je, auprès, quelque autre expression que la sienne."
                            },
                            {
                                "example_id": "70c4c930-f205-41ad-a04e-53c3c668f069",
                                "sense_id": "f684ede4-4fd2-3a4d-b798-33743e32d9ba",
                                "text": "Sur le bord du fleuve, […], il rencontra un autre aéroplane qui lui parut à peine endommagé. […]. Aucun aviateur, mort ou vivant, ne se trouvait auprès."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "534d0971-2558-4c4a-bf75-2f896642c1c2",
                        "source_entry_id": "ab085fb6-f288-3900-8639-a3fb7f1bca30",
                        "source_sense_id": "f684ede4-4fd2-3a4d-b798-33743e32d9ba",
                        "target_lang_word": "nearby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nearby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "850d8a2d-d60b-3f09-9bf2-98135bee6593",
                                        "entry_id": "0c31ca09-9ee3-3017-8392-d0ad28e192b9",
                                        "glosses": [
                                            "Adjacent, near, close by."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e17ccc1e-7804-4c55-adab-c855e04d65e2",
                                                "sense_id": "850d8a2d-d60b-3f09-9bf2-98135bee6593",
                                                "text": "He stopped at a nearby store for some groceries."
                                            },
                                            {
                                                "example_id": "3b2ce7be-1c6b-4e61-8b88-5d487a696e52",
                                                "sense_id": "850d8a2d-d60b-3f09-9bf2-98135bee6593",
                                                "text": "Seals are flourishing about 50 miles farther south, too. In 2021, a group of grey seals established the first seal colony in nearby Suffolk and began breeding on a remote shingle beach at Orford Ness, now a National Trust site but once the location for cold war weapons-testing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nearby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3745bd7c-e937-3540-b42a-d08d4f9d1aa4",
                                        "entry_id": "0cfac4dc-aae3-3b64-ac3c-a27df00f7ade",
                                        "glosses": [
                                            "Next to, close to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a08d00-a1e2-47ea-a429-2a96a4c6d9c5",
                                                "sense_id": "3745bd7c-e937-3540-b42a-d08d4f9d1aa4",
                                                "text": "I'm glad my friends live nearby where I can visit them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nearby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b60aa709-31cf-3b91-8c7d-a0a609c44e43",
                                        "entry_id": "b0a3e601-a585-3b37-a0d2-9192602e87a9",
                                        "glosses": [
                                            "A futures contract, of a particular group, whose settlement date is the earliest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194031bb-3f36-4d06-945b-e210fdd99701",
                                                "sense_id": "b60aa709-31cf-3b91-8c7d-a0a609c44e43",
                                                "text": "In each of these markets the nearbys are almost invariably at a discount — a discount that tends to widen in bull markets and narrow in bear markets."
                                            },
                                            {
                                                "example_id": "1230291d-9d87-4e2e-b850-55b442367251",
                                                "sense_id": "b60aa709-31cf-3b91-8c7d-a0a609c44e43",
                                                "text": "The deferred contract should be expected to rise, and buying the deferred while selling the nearby is then profitable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
