                                        "sense_id": "7435181c-1439-3db9-aeb7-7e2090be7a93",
                                        "entry_id": "de73402a-aae9-3777-a1b8-8e2191b86c18",
                                        "glosses": [
                                            "An interconnection between any two channels, passages or vessels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f33de00b-a338-4655-977e-f07a98a6b949",
                                                "sense_id": "7435181c-1439-3db9-aeb7-7e2090be7a93",
                                                "text": "(...) our grandam, which we are linked up with by successive anastomosis of navelcords sold us all, seed, breed and generation, for a penny pippin."
                                            },
                                            {
                                                "example_id": "70dcc4ff-6d19-419b-b28a-383f01e9bd3a",
                                                "sense_id": "7435181c-1439-3db9-aeb7-7e2090be7a93",
                                                "text": "A dark purple fluid appeared to pulse in the tortuous anastomoses of channels which lay under the surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c232419c-340f-363a-8112-1c918814e50b",
                                        "entry_id": "de73402a-aae9-3777-a1b8-8e2191b86c18",
                                        "glosses": [
                                            "The surgical creation of a connecting passage between blood vessels, bowels or other channels."
