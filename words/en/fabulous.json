                        "fabulous dress",
                        "fabulous style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень модный, привлекательный и впечатляющий по стилю.",
                        "nl": "Zeer modieus, aantrekkelijk en indrukwekkend van stijl."
                    },
                    "translations": {
