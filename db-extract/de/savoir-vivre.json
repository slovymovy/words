                            {
                                "example_id": "191e8b3b-f486-4679-896f-208098767c54",
                                "sense_id": "d9d18199-c6be-3a30-a1ec-2d85459b251c",
                                "text": "„Ich dagegen komme aus dem Land der Revolution, der Menschenrechte und des Savoir-vivre, aus dem Land, in dem Gott selbst leben soll.“"
                            }
