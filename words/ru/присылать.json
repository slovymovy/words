            "senses": [
                {
                    "sense_id": "fdd5a55f-7b08-3fc5-b546-97fb09921b93",
                    "sense_definition": "Отправлять что-либо почтой, курьером или через кого-то в адрес получателя",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "отправка_вещей",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Друзья часто <w>присылают</w> мне открытки из разных стран.",
                            "target_lang_translations": {
                                "tr": "Arkadaşlarım bana sık sık farklı ülkelerden kartpostallar <w>gönderiyorlar</w>."
                            }
                        },
                        {
                            "text": "Пожалуйста, не забывайте регулярно <w>присылать</w> отчеты на мою электронную почту.",
                            "target_lang_translations": {
                                "tr": "Lütfen e-postama düzenli olarak rapor <w>göndermeyi</w> unutmayın."
                            }
                        }
                    ],
                    "synonyms": [
                        "присылать",
                        "отправлять",
                        "доставлять",
                        "высылать"
                    ],
                    "antonyms": [
                        "получать",
                        "забирать"
                    ],
                    "common_phrases": [
                        "присылать письма",
                        "присылать посылку",
                        "присылать отчет"
                    ],
                    "target_lang_definitions": {
                        "tr": "Posta, kurye veya bir başkası aracılığıyla alıcıya bir şey göndermek"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göndermek",
                                "target_lang_sense_clarification": "posta veya kurye ile bir şey yollamak"
                            },
                            {
                                "target_lang_word": "yollamak",
                                "target_lang_sense_clarification": "birine bir şey ulaştırmak amacıyla göndermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4af9c8ba-591e-3a24-aa93-789129e829aa",
                    "sense_definition": "Направлять кого-либо куда-либо с определённым поручением или целью",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "направление_людей",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор обещал <w>присылать</w> помощника каждый раз, когда нам нужна поддержка.",
                            "target_lang_translations": {
                                "tr": "Müdür, desteğe ihtiyacımız olduğu her an bir yardımcı <w>göndereceğine</w> söz verdi."
                            }
                        },
                        {
                            "text": "В эту больницу часто <w>присылают</w> молодых специалистов на практику.",
                            "target_lang_translations": {
                                "tr": "Bu hastaneye staj için sık sık genç uzmanlar <w>gönderilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "направлять",
                        "командировать",
                        "посылать"
                    ],
                    "antonyms": [
                        "отзывать",
                        "забирать"
                    ],
                    "common_phrases": [
                        "присылать специалиста",
                        "присылать помощника"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini belirli bir görev veya amaçla bir yere yönlendirmek, göndermek"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göndermek",
                                "target_lang_sense_clarification": "bir görevliyi veya kişiyi bir yere yollamak"
                            },
                            {
                                "target_lang_word": "yollamak",
                                "target_lang_sense_clarification": "birini bir amaçla bir yere sevk etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
