                "senses": [
                    {
                        "sense_id": "40070eee-aa00-3a7d-8b0d-6488439ebf3b",
                        "entry_id": "3bfeb11c-c6e2-3917-9b2c-1b4e65534406",
                        "glosses": [
                            "мифол. персонаж греческой мифологии, сын Зевса и Алкмены"
                        ],
                        "tags": [],
