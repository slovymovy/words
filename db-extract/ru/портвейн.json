                "senses": [
                    {
                        "sense_id": "ff87afb3-55ea-3032-984f-4e47592cb65e",
                        "entry_id": "19a54557-e1b7-3249-9971-5d0a11b35f1c",
                        "glosses": [
                            "port wine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c635269b-be44-43fc-919d-d90aa6085f3a",
                                "sense_id": "ff87afb3-55ea-3032-984f-4e47592cb65e",
                                "text": "В це́нтре ка́фельного хо́лла сиде́л на полу́ мужичо́нка с расква́шенной мо́рдой и че́рез ра́вные интерва́лы вре́мени плева́л кро́вью на зали́тый портве́йном ка́фель.",
                                "translation": "A young man with his face beaten to pulp was sitting in the middle of the floor, spitting out blood at regular intervals onto the tiles that were awash with fortified port wine.",
                                "english": "A young man with his face beaten to pulp was sitting in the middle of the floor, spitting out blood at regular intervals onto the tiles that were awash with fortified port wine."
                            }
                        ]
                    },
                    {
                        "sense_id": "54c5ee12-38cc-39b9-a146-a3db0662d478",
                        "entry_id": "19a54557-e1b7-3249-9971-5d0a11b35f1c",
                        "glosses": [
                            "tonic wine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa1b2190-20ad-4521-967c-d070435b7796",
                                "sense_id": "54c5ee12-38cc-39b9-a146-a3db0662d478",
                                "text": "Гря́зным ку́хонным ножо́м\nс за́пахом портве́йна\nя разре́жу ка́рту ми́ра\nот Оби́ до Ре́йна",
                                "translation": "With a dirty kitchen knife\nwhich smells tonic wine\nI will cut up a world map\nfrom Ob to Rhine",
                                "english": "With a dirty kitchen knife\nwhich smells tonic wine\nI will cut up a world map\nfrom Ob to Rhine"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
