                        ],
                        "form": "historici"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                        "entry_id": "fd7c5e85-3981-35b8-962d-62f2236d27cc",
                        "glosses": [
                            "deskundige op het terrein van de geschiedenis (eventueel in bezit van een academische graad)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "b33ec013-4e88-41a9-96e0-9f72ddf688c3",
                                "sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                                "text": "Historicus Timothy Snyder: 'Trump is uit op een dictatuur'"
                            },
                            {
                                "example_id": "01dcb34a-af9d-47d0-9b62-131cedb13030",
                                "sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                                "text": "Je schrijft een gedicht zo alsof je niets anders doet; je stelt je proza zo samen dat, hoewel je tot het verheven taalgebruik van een historicus opstijgt, toch niets de vrijheid van een dichter je in de weg staat."
                            },
                            {
                                "example_id": "d348e191-9f89-426f-8879-0c0c1a7848c4",
                                "sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                                "text": "\"De Guernica krijgt door de oorlog die we nu meemaken een enorme extra lading. Het schilderij is niet alleen een interessant kunsthistorisch object. Het leeft en de Oekraïners gebruiken dat\", zegt historicus Hartmans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cd5ce09-e7e4-4248-996a-02dd3ca4b5ab",
                        "source_entry_id": "fd7c5e85-3981-35b8-962d-62f2236d27cc",
                        "source_sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                        "target_lang_word": "Historiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Historiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed00778-354d-3db4-a0b0-236a3c9b7e13",
                                        "entry_id": "3ac19818-cd65-331b-828f-2ff8daab3439",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit der Erforschung und Darstellung der Geschichte beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c6a1a2-e390-498d-b7c3-e7332305229b",
                                                "sense_id": "5ed00778-354d-3db4-a0b0-236a3c9b7e13",
                                                "text": "„Der Historiker kann allerdings die Ebene wechseln und statt der unsicheren Fakten die Art, wie über das Ereignis geredet wird, betrachten.“"
                                            },
                                            {
                                                "example_id": "2c1eff0d-1c68-40a8-95e2-5977074753d1",
                                                "sense_id": "5ed00778-354d-3db4-a0b0-236a3c9b7e13",
                                                "text": "„Historiker haben Aufzeichnungen über 17108 Fahrten von Sklavenschiffen im 18. Jahrhundert zusammengetragen; nur in einer Hand voll dieser Berichte ist jedoch etwas über das alltägliche Geschehen an Bord der Schiffe festgehalten.“"
                                            },
                                            {
                                                "example_id": "61c52400-1101-4d9a-bdf7-2b167b0361fb",
                                                "sense_id": "5ed00778-354d-3db4-a0b0-236a3c9b7e13",
                                                "text": "„Nach Meinung von Historikern kamen die jüdischen Einwanderer vor allem aus Nordfrankreich.“"
                                            },
                                            {
                                                "example_id": "98793613-dfb1-4f60-a4f1-4ef3b7bd18cc",
                                                "sense_id": "5ed00778-354d-3db4-a0b0-236a3c9b7e13",
                                                "text": "„Alle Historiker schildern den Hergang folgendermassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9a82b46-6d3a-455c-b7cb-b7949e1e0d8b",
                        "source_entry_id": "fd7c5e85-3981-35b8-962d-62f2236d27cc",
                        "source_sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                        "target_lang_word": "historian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09fc899c-86fd-3508-a2bf-fd49ff316a5e",
                                        "entry_id": "67b35b7c-0304-33cb-8aaa-695a7c0b998f",
                                        "glosses": [
                                            "A writer of history."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e740cbda-48f7-330c-88f5-19245917e627",
                                        "entry_id": "67b35b7c-0304-33cb-8aaa-695a7c0b998f",
                                        "glosses": [
                                            "One who studies or researches history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd081f22-aab2-4f9a-8db6-591e3cda53fc",
                                                "sense_id": "e740cbda-48f7-330c-88f5-19245917e627",
                                                "text": "If this is what real people and societies are like, then it may be appropriate for historians to represent their subjects' lives in storylike form."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341240e6-9980-3300-a493-2aad38784be1",
                                        "entry_id": "67b35b7c-0304-33cb-8aaa-695a7c0b998f",
                                        "glosses": [
                                            "One who recounts their own medical history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9819001-ed75-4e34-81dd-1d10e215c7be",
                                                "sense_id": "341240e6-9980-3300-a493-2aad38784be1",
                                                "text": "The patient is unconscious when the syncopal event takes place and therefore is a poor historian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b4cc0d-1fb6-4dae-ad8b-3e19f830650f",
                        "source_entry_id": "fd7c5e85-3981-35b8-962d-62f2236d27cc",
                        "source_sense_id": "0a619371-ef13-3126-be3a-da33f585f544",
                        "target_lang_word": "historien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                                        "entry_id": "22e5ba2d-5f2f-37e0-887b-c4f3cfa06d9b",
                                        "glosses": [
                                            "Personne qui fait des recherches, des études historiques, qui écrit des ouvrages d'histoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf47368f-8041-44fd-91a0-3f29fbff329a",
                                                "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                                                "text": "Elle donne son nom au dernier ouvrage que l’historien Jean-Yves Guengant consacre au sujet."
                                            },
                                            {
                                                "example_id": "6fcf0cab-6324-4195-be31-fd41b0557f49",
                                                "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                                                "text": "L’historien n'a pas à délivrer des prix de vertu, à proposer des projets de statues, à établir un catéchisme quelconque ; son rôle est de comprendre ce qu'il y a de moins individuel dans les événements."
                                            },
                                            {
                                                "example_id": "fba21051-ee03-45d1-b068-433eaf107d95",
                                                "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                                                "text": "Viennent ensuite les historiens qui considèrent que leur premier devoir, c’est de détruire les légendes, et de rétablir la vérité. Il est certain que, sans eux, l’histoire des peuples ne serait qu’un vaste poème, où les faits agrandis et dramatisés par l’imagination des foules, grandement embellis ou inventés par les flatteurs des rois, brilleraient, couleur d’or et de sang, dans une lumineuse brume."
                                            },
                                            {
                                                "example_id": "abead109-0af4-40a6-bda6-833d930b7acf",
                                                "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                                                "text": "Il s’est inspiré de l’historien allemand Treitschke, maître du pangermanisme moderne et violent adversaire de la France."
                                            },
                                            {
                                                "example_id": "67c46df4-bac4-4f21-948a-1dea559f5726",
                                                "sense_id": "f9411a1c-33de-3fa5-b511-d7f1941ac9b2",
                                                "text": "Mais la méthode historique doit être implacable, car elle ne saurait être arrêtée ou limitée par aucun tabou. De plus, le véritable historien est curieux par nature ; il y a en lui un peu du juge d’instruction. Et, déformation professionnelle, tout silence lui est suspect, car c’est là un refus de répondre. Dès lors ce refus dissimule quelque chose de très important ; c’est donc là qu’il faut creuser. Au contraire, l’historien conformiste n’est alors qu’un banal historiographe, un compilateur docile, et son rôle est très différent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72521017-cd34-3622-aed4-8b471d142c74",
                                        "entry_id": "22e5ba2d-5f2f-37e0-887b-c4f3cfa06d9b",
                                        "glosses": [
                                            "Chroniqueur qui écrit ou qui a écrit une histoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f2ff811-beb6-4108-9924-d4247299bebb",
                                                "sense_id": "72521017-cd34-3622-aed4-8b471d142c74",
                                                "text": "Qu'un mot grec à l’état de flexion se soit conservé entier, inaltéré, dans les ouvrages des historiens chinois, c'est un fait inattendu qu'on est d'abord tenté de déclarer impossible ; […]."
                                            },
                                            {
                                                "example_id": "6d1eff06-57a9-4e65-a434-a5bc7171e6d1",
                                                "sense_id": "72521017-cd34-3622-aed4-8b471d142c74",
                                                "text": "Et, d'autre part, les historiens n’ont jamais raconté que Louis XIV ait songé à complimenter Louvois d'avoir réformé les mœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "574a1d89-57d7-3232-91e4-a78c5de0881b",
                                        "entry_id": "22e5ba2d-5f2f-37e0-887b-c4f3cfa06d9b",
                                        "glosses": [
                                            "Celui qui se borne à raconter des faits sans les accompagner d’engagement ou de réflexions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e732344-dfa1-4ac6-9d39-8f4dcad7fd76",
                                                "sense_id": "574a1d89-57d7-3232-91e4-a78c5de0881b",
                                                "text": "Je ne suis qu’historien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "historien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "280f4b97-36a1-36c5-a6fe-b8d261fb8ca9",
                                        "entry_id": "16d23feb-949d-363f-8310-43ffa649e10c",
                                        "glosses": [
                                            "Relatif à l’Histoire comme science historique."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85970fa-9499-4d55-8589-da82e2d8c4db",
                                                "sense_id": "280f4b97-36a1-36c5-a6fe-b8d261fb8ca9",
                                                "text": "Afin d’améliorer la compréhension, on s’est efforcé de distinguer systématiquement entre « histoire » (le passé) et « Histoire » (la science historique), avec pour adjectifs respectifs « historique » et « historien »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
