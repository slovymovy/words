        "fr-extract.jsonl": [
            {
                "entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                "word": "championne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f16fd474-d933-4300-975b-68cab8e14b41",
                        "entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                        "tags": [
                            "plural"
                        ],
                        "form": "championnes"
                    },
                    {
                        "form_id": "66e8e5d1-dbf7-43b4-b497-1fd355cce9ae",
                        "entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                        "tags": [
                            "masculine"
                        ],
                        "form": "champion"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "030061f1-0aca-3d5b-b10e-c2b72d9b9805",
                        "entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                        "glosses": [
                            "Celle qui soutient un combat comme quelqu’un ou quelque chose, qui défend une cause, défenseuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc3a9b31-cf64-48e8-8d68-70246d4907e3",
                                "sense_id": "030061f1-0aca-3d5b-b10e-c2b72d9b9805",
                                "text": "Tous viennent sur mes pas, hors les deux championnes,\nQui du combat encor remettent leurs personnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0beda8ee-e9fb-3283-8737-8e554bb6d856",
                        "entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                        "glosses": [
                            "Athlète qui, dans une compétition, a remporté la première place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92cb42ea-0667-4f18-984a-73320478eba6",
                                "sense_id": "0beda8ee-e9fb-3283-8737-8e554bb6d856",
                                "text": "Mais en 1922, de nouvelles championnes s'inscrivaient au palmarès américain : Hélène Wainwright enlevait le 100 yards, cependant que la future triomphatrice de la Manche, Gertrude Éderlé, alors âgée de 14 ans, en remportant, en bassin le 100 yards à Indianapolis, en 500 mètres en 7'22\" 2/10 (ce qui établissait le record du monde) battait au passage en 5'54\" 6/10 le record du 440 yards, […]."
                            },
                            {
                                "example_id": "84bbd500-ac9a-490c-b13e-a5d7c23d038c",
                                "sense_id": "0beda8ee-e9fb-3283-8737-8e554bb6d856",
                                "text": "Aujourd’hui un champion sur deux est une championne !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a2915b3a-5bfe-3804-b199-d001dcd349b3",
                        "entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                        "glosses": [
                            "Femme hardie."
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1defb252-0a9a-4a72-8ba9-5bf8a6f4c384",
                        "source_entry_id": "21e9f723-a7e3-3f10-94f9-8bd672224c1a",
                        "source_sense_id": "030061f1-0aca-3d5b-b10e-c2b72d9b9805",
                        "source_sense_description": "Celle qui défend une cause ou quelqu’un",
                        "target_lang_word": "champion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "champion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "An ongoing winner in a game or contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339cdd4d-9112-4630-9de5-d0416e0c8f0e",
                                                "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                                                "text": "The defending champion is expected to defeat his challenger."
                                            },
                                            {
                                                "example_id": "360557a7-6333-4790-8839-648d350cacc6",
                                                "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                                                "text": "Curry, a four-time NBA champion with the Warriors, played for the Wildcats for three seasons between 2006 and 2009, where he was twice named conference player of the year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd910e8d-c596-3dce-b78c-27b0c7df7e25",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "Someone who is chosen to represent a group of people in a contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14dc61a-e59d-4166-8faf-00a7e2b9e04c",
                                                "sense_id": "fd910e8d-c596-3dce-b78c-27b0c7df7e25",
                                                "text": "Barcelona is eligible to play in FIFA Club World Cup as the champion of Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "Someone who fights for a cause or status."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "023624be-c106-4bb8-b813-4cef7a0a26ef",
                                                "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                                                "text": "Emmeline Pankhurst was a champion of women's suffrage."
                                            },
                                            {
                                                "example_id": "8e606f8d-e797-4c9d-976b-822115772ac9",
                                                "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                                                "text": "Specific outcomes from this policy included the appointment of a Digital Champion to drive forward the efforts to get more of the excluded to be included."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f53516-6734-3544-927d-41156db17647",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "Someone who fights on another's behalf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d3850d-0801-4e37-a70c-46cb03b113a3",
                                                "sense_id": "92f53516-6734-3544-927d-41156db17647",
                                                "text": "champion of the poor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "A particularly notable member of a plant species, such as one of great size."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c8b876-e974-4005-9117-02fcf9035956",
                                                "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                                "text": "Pictured above is an actual photograph of a Regal Lily that famed all over the world. It's a champion plant—because in one season it produced a total of 89 blooms from one bulb, an amazing record among lilies."
                                            },
                                            {
                                                "example_id": "60b78624-4f1e-4d2b-a1df-f74624bf95ad",
                                                "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                                "text": "There was a news clipping there with a photo of a magnificent American elm, which had just been named the champion for its species, the largest of its kind."
                                            },
                                            {
                                                "example_id": "606346c1-788c-46f4-8e0f-d1934bee6f9c",
                                                "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                                "text": "He [Matthew Olson] was searching for red maple trees to be tapped for syrup as part of the Stockton Maple Project when he came across the new champion tree."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "champion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a00f6d5-e145-3b74-89d5-bc45b01d9b48",
                                        "entry_id": "ca17cf93-65cd-33c2-912b-9714a1a06e7a",
                                        "glosses": [
                                            "Acting as a champion; having defeated all one's competitors."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fc0502f-607b-4f91-bf96-0ed4764c06ee",
                                                "sense_id": "0a00f6d5-e145-3b74-89d5-bc45b01d9b48",
                                                "text": "a champion bodybuilder"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366788bc-d547-3575-88d8-fa47e4041741",
                                        "entry_id": "ca17cf93-65cd-33c2-912b-9714a1a06e7a",
                                        "glosses": [
                                            "Excellent; beyond compare."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c2a7c2b-03c4-3ae3-804b-01926bf98a7d",
                                        "entry_id": "ca17cf93-65cd-33c2-912b-9714a1a06e7a",
                                        "glosses": [
                                            "Excellent; brilliant; superb; deserving of high praise."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "dialectal",
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea81f2cd-f526-408a-9867-8a67c16be5ff",
                                                "sense_id": "5c2a7c2b-03c4-3ae3-804b-01926bf98a7d",
                                                "text": "\"That rollercoaster was champion,\" laughed Vinny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "champion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c39c91-44aa-3834-803d-8f9b64779f94",
                                        "entry_id": "4b8b61b6-c8b8-3f5f-8617-642a6f83d8e9",
                                        "glosses": [
                                            "To promote, advocate, or act as a champion for (a cause, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095a65c5-e710-4f8a-b86a-aa8d9d4b3020",
                                                "sense_id": "a2c39c91-44aa-3834-803d-8f9b64779f94",
                                                "text": "While obviously championing the Bluebell [Railway], Beardmore is keen for the 'big railway' to consider utilising what preserved railways can provide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e507decf-7818-3c41-b206-3dbdb6250ec3",
                                        "entry_id": "4b8b61b6-c8b8-3f5f-8617-642a6f83d8e9",
                                        "glosses": [
                                            "To challenge."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
