                "senses": [
                    {
                        "sense_id": "bc79a354-7f51-38ab-a821-82735ae6f1d1",
                        "entry_id": "1a287710-c5bc-3537-91e1-e9d71645b01a",
                        "glosses": [
                            "morderstwo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f412c074-96d0-4ce8-83a7-e540182b3c85",
                                "sense_id": "bc79a354-7f51-38ab-a821-82735ae6f1d1",
                                "text": "W Azerbejdżanie wskaźniki śmierci samobójczej są ponad sześćdziesięciokrotnie niższe niż spowodowanej zabójstwem, w Armenii ponad jedenastokrotnie, w Meksyku zaś - blisko siedmiokrotnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "108c4ec3-cad2-4422-b65d-dee222090638",
                        "source_entry_id": "1a287710-c5bc-3537-91e1-e9d71645b01a",
                        "source_sense_id": "bc79a354-7f51-38ab-a821-82735ae6f1d1",
                        "target_lang_word": "homicide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homicide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dba5c31d-8221-388d-8637-56ddc83ce9cd",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "The killing of one person by another, whether premeditated or unintentional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c905dfb-80e3-3355-bddc-be92693f5b37",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "A person who kills another."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19e11a5-a9d9-48f8-af74-00b812e1fda8",
                                                "sense_id": "1c905dfb-80e3-3355-bddc-be92693f5b37",
                                                "text": "Homicides in general and victorious warriors in particular are often obliged to perform a variety of ceremonies for the purpose of ridding them of the dangerous ghosts of their victims."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "A victim of homicide; a person who has been unlawfully killed by someone else."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5752aa1-125b-41a9-9c01-09c1465570e7",
                                                "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                                "text": "“She was a hippie kid. How hard would you work a case like that?”\n“As hard as anyone else,” said Goddard. There was an irritated note in his voice. “She was a homicide. She got what every homicide investigation gets.”"
                                            },
                                            {
                                                "example_id": "4ab5b429-b5ac-4ba0-8980-352e9210063b",
                                                "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                                "text": "We don't even know the woman was a homicide. Didn't they say it was possible they both jumped?"
                                            },
                                            {
                                                "example_id": "8f8d242c-d873-4eb6-8347-40b00588a86f",
                                                "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                                "text": "The medical examiner was behind on autopsies and cranky, so we didn't even know if the old guy in the pool was a homicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec15ab1-d100-3f2e-bb02-8e9647d9d153",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "The department within a police force that investigates cases of homicide."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
