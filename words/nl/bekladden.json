{
    "word_family": [
        "klad",
        "kladder",
        "kladblok",
        "kladpapier",
        "bekladding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0848d8c7-83f0-36b8-b1cf-e715c295d237",
                    "sense_definition": "op lelijke wijze iets met verf, modder of graffiti bedekken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_bekladden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muren van het oude stationsgebouw zijn door vandalen <w>beklad</w> met graffiti.",
                            "target_lang_translations": {
                                "en": "The walls of the old station building have been <w>daubed</w> with graffiti by vandals."
                            }
                        },
                        {
                            "text": "Het is verboden om monumenten te <w>bekladden</w> met verf.",
                            "target_lang_translations": {
                                "en": "It is forbidden to <w>deface</w> monuments with paint."
                            }
                        }
                    ],
                    "synonyms": [
                        "besmeuren",
                        "kladderen",
                        "bevuilen"
                    ],
                    "antonyms": [
                        "schoonmaken",
                        "reinigen"
                    ],
                    "common_phrases": [
                        "muren bekladden",
                        "met graffiti bekladden"
                    ],
                    "target_lang_definitions": {
                        "en": "to cover something in an ugly way with paint, mud, or graffiti"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "daub",
                                "target_lang_sense_clarification": "to smear or paint crudely"
                            },
                            {
                                "target_lang_word": "bedaub",
                                "target_lang_sense_clarification": "to soil or smear with a substance"
                            },
                            {
                                "target_lang_word": "deface",
                                "target_lang_sense_clarification": "to spoil the surface or appearance of something, e.g., with graffiti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b4d5984-2c55-3e22-8d94-ac32d3fdb0f4",
                    "sense_definition": "iemands goede naam schaden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk_bekladden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus werd tijdens de campagne flink <w>beklad</w> door zijn tegenstanders.",
                            "target_lang_translations": {
                                "en": "The politician was heavily <w>slandered</w> by his opponents during the campaign."
                            }
                        },
                        {
                            "text": "Zij probeerden zijn reputatie te <w>bekladden</w> met valse beschuldigingen.",
                            "target_lang_translations": {
                                "en": "They tried to <w>besmirch</w> his reputation with false accusations."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwartmaken",
                        "lasteren",
                        "besmeuren"
                    ],
                    "antonyms": [
                        "prijzen",
                        "verdedigen"
                    ],
                    "common_phrases": [
                        "iemands reputatie bekladden",
                        "iemands naam bekladden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to damage someone's good reputation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "besmirch",
                                "target_lang_sense_clarification": "to tarnish someone's reputation"
                            },
                            {
                                "target_lang_word": "defame",
                                "target_lang_sense_clarification": "to harm the reputation of someone by libel or slander"
                            },
                            {
                                "target_lang_word": "vilify",
                                "target_lang_sense_clarification": "to speak ill of or defame someone"
                            },
                            {
                                "target_lang_word": "slander",
                                "target_lang_sense_clarification": "to make false and damaging statements about someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}