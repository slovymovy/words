                ],
                "senses": [
                    {
                        "sense_id": "8dbf5689-4bac-3a27-bdec-e03ba91a2506",
                        "entry_id": "fff34a64-1b9d-38e0-a22e-57b9ec74443b",
                        "glosses": [
                            "Variante ancienne de japoniser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c42805-9304-4d1d-83be-6f54eed3cd1a",
                                "sense_id": "8dbf5689-4bac-3a27-bdec-e03ba91a2506",
                                "text": "Le premier soin de Passepartout, ainsi japonaisé, fut d'entrer dans une tea-house de modeste apparence, et là, d'un reste de volaille et de quelques poignées de riz, il déjeuna en homme pour qui le dîner serait encore un problème à résoudre."
                            },
                            {
                                "example_id": "00da2c8f-617b-4bd7-ba5a-36bb1e069253",
                                "sense_id": "8dbf5689-4bac-3a27-bdec-e03ba91a2506",
                                "text": "La Chine actuelle serait pour le Japon un poids mort rivé à sa jambe ; une Chine nouvelle, une Chine japonaisée, ce serait pour le Japon, non seulement tout de suite le plus redoutable des concurrents, mais même, du jour au lendemain, un maître omnipotent : que pourraient 40 millions de Japonais contre un peuple dix fois plus nombreux."
                            }
                        ]
                    }
                ],
