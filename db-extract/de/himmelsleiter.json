                    {
                        "form_id": "c1f7ceb0-eeb8-4ac9-b89f-5f1568982e1a",
                        "entry_id": "8a80af7c-91ae-3ae9-bfb2-5e7c18f23855",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Himmelsleitern"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "355c2813-448d-3fef-807d-366bb158927b",
                        "entry_id": "8a80af7c-91ae-3ae9-bfb2-5e7c18f23855",
                        "glosses": [
                            "in der Bibel an verschiedenen Stellen (Genesis 28.12; Johannes 1.51) vorkommende Vorstellung einer Leiter, die von der Erde bis in den Himmel reicht und auf der Engel herauf- und hinabschreiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7795e367-3632-4d4d-85a7-89cd00beffaa",
                                "sense_id": "355c2813-448d-3fef-807d-366bb158927b",
                                "text": "„Im Traum Jakobs kommt die aus Ägypten bekannte Himmelsleiter vor, aber Jakob selbst bleibt auf der Erde […].“"
                            },
                            {
                                "example_id": "b0a0e1a2-7e4b-4061-a1b8-4396b0b6e485",
                                "sense_id": "355c2813-448d-3fef-807d-366bb158927b",
                                "text": "„Die Himmelsleiter in Johannes 1.51, auf der Engel feierlich hinauf- und hinabschreiten, ist als Steintreppe gedacht.“"
                            },
                            {
                                "example_id": "4ad8f3e0-e203-4f18-903a-699681f3cc42",
                                "sense_id": "355c2813-448d-3fef-807d-366bb158927b",
                                "text": "„Ich hatte einen Fuß auf der Himmelsleiter und den anderen in einer Jauchegrube.“"
                            },
                            {
                                "example_id": "d1768c94-dae5-4f67-8de1-7da552ffeb7f",
                                "sense_id": "355c2813-448d-3fef-807d-366bb158927b",
                                "text": "„Er hat unruhig geschlafen, geträumt, er müsse auf der Himmelsleiter ununterbrochen das Dach erklimmen und wieder hinabsteigen, stets verfolgt von Divisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ca5cef-061f-49c7-8f7d-e9e585d6711b",
                        "source_entry_id": "8a80af7c-91ae-3ae9-bfb2-5e7c18f23855",
                        "source_sense_id": "355c2813-448d-3fef-807d-366bb158927b",
                        "target_lang_word": "Jacob's ladder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jacob's ladder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b43021fb-d363-3fda-8644-9d5308937aa3",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A ladder leading to heaven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db750a5-fbb6-4c4d-9452-d4a4c7e8783d",
                                                "sense_id": "b43021fb-d363-3fda-8644-9d5308937aa3",
                                                "text": "Jacob's ladder; Christ is Jacob's ladder that reacheth up to heaven; and he that refuseth to go by this ladder thither, will scarce by other means get up so high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937ef03a-d4eb-3e08-bbde-0393860d5b32",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A flowering plant of the genus Polemonium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3db1888-b71d-409d-8949-e859ea835a81",
                                                "sense_id": "937ef03a-d4eb-3e08-bbde-0393860d5b32",
                                                "text": "Hetty could have cast all her past life behind her and never cared to be reminded of it again. I think she had no feeling at all towards the old house, and did not like the Jacob's Ladder and the long row of hollyhocks in the garden better than other flowers—perhaps not so well."
                                            },
                                            {
                                                "example_id": "535da07c-8f5d-402b-a91c-11f6986eb266",
                                                "sense_id": "937ef03a-d4eb-3e08-bbde-0393860d5b32",
                                                "text": "Jacob’s Ladder doubtless receives its name from the ladder-like leaves. The flowers are delicately blue with white tubes and are clustered on graceful stems a foot tall or less. They may be found in spruce forests on the mountains at 8000-14000 ft. and bloom in summer, often so abundantly as to form a blue carpet on the forest floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f5f29ad-654c-3f50-a22f-41389e026455",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A rope ladder from the ratline to the upper mast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f928ff-8c66-4497-974c-23a4a85220e0",
                                                "sense_id": "1f5f29ad-654c-3f50-a22f-41389e026455",
                                                "text": "And this is one of the signs by which you can tell a man-of-war from a merchantman, for in war-ships the catch ratline is on the aftermost shroud instead of on the foremost. In a man-of-war, too, the topgallant-rigging is never rattled down, as a Jacob's ladder leads from the topgallantmast-head down to the crosstrees; but this Jacob's ladder arrangement is found in many clippers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ce75c4-9ce6-3ed8-adcf-38b6f30762ce",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A toy consisting of blocks of wood, held together by strings or ribbons, that appear to cascade downward as they flip over."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eed67aa-9be7-37ff-a08f-6bb6fbe8eacc",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A pocketknife consisting of two handle segments joined by a pivot, with a blade connected by a second pivot to the end of one handle segment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fa2a4a6-5360-387d-85be-2f9fb028459a",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A noncompact surface resembling a ladder made of handlebodies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716d4fcd-15f0-4c8a-b5c6-9762b16b1760",
                                                "sense_id": "4fa2a4a6-5360-387d-85be-2f9fb028459a",
                                                "text": "The infinite Loch Ness monster and Jacob's ladder (Figure 12.1.1) are diffeomorphic surfaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b51d401-15c1-3250-9282-1dcfc9ce83b0",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A high-voltage electrical device, often used as a visual effect in old movies, which has a pair of vertical electrodes that form an arc between them starting at the bottom, rising to the top, then repeating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee79bef-8d3f-4905-a698-824485c8d8af",
                                                "sense_id": "1b51d401-15c1-3250-9282-1dcfc9ce83b0",
                                                "text": "Jacob’s Ladder displays are sometimes found in science museums and centers. In demonstrations, an electric spark jumps between two parallel wires when electrons fed into one of the wires repel each other, heating up the surrounding air so the spark rises with the hot air before dying at the top of the wires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfdb57c9-5c6f-3c77-9b21-9dc5441a2326",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A serving of short ribs."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e76880ca-3fbd-379a-8875-be49f3fdab22",
                                        "entry_id": "744a5f9d-63cd-3c34-8cad-9593a6c4f928",
                                        "glosses": [
                                            "A ladder or run in a pair of tights."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdcca8d2-5332-4040-9986-12edc79289b3",
                                                "sense_id": "e76880ca-3fbd-379a-8875-be49f3fdab22",
                                                "text": "[…] because the left leg of her tights has exhibited symptoms of the defect in the warp known as a \"Jacob's ladder.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
