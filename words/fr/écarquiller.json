    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66e3ac57-af26-3f09-9fb4-e1b23edcbb9b",
                    "sense_definition": "Ouvrir tout grands les yeux sous l'effet de l'étonnement, de la peur ou de la curiosité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "yeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En apprenant cette surprenante nouvelle, l'enfant s'est arrêté net et a <w>écarquillé</w> les yeux."
                        },
                        {
                            "text": "Face à l'obscurité grandissante de la forêt, le promeneur <w>écarquillait</w> les yeux pour trouver son chemin."
                        }
                    ],
                    "synonyms": [
                        "dilater"
                    ],
                    "antonyms": [
                        "fermer",
                        "plisser"
                    ],
                    "common_phrases": [
                        "écarquiller les yeux"
                    ]
                },
                {
                    "sense_id": "71b344e9-e259-3e12-8f58-2519b110643c",
                    "sense_definition": "Écarter largement les membres du corps, en particulier les jambes ou les bras.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ecartement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier blessé marchait avec peine en <w>écarquillant</w> les jambes à chaque pas."
                        },
                        {
                            "text": "Pour garder son équilibre sur le pont glissant du navire, le marin <w>écarquille</w> largement les pieds."
                        }
                    ],
                    "synonyms": [
                        "écarter"
                    ],
                    "antonyms": [
                        "rapprocher",
                        "serrer"
                    ],
                    "common_phrases": [
                        "écarquiller les jambes"
                    ]
                },
                {
                    "sense_id": "7d237bb6-863f-3a02-bc7b-a33ea86efcde",
                    "sense_definition": "Déployer ou ouvrir largement en forme d'éventail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ecartement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant sa parade nuptiale, le grand tétras parade en <w>écarquillant</w> les plumes de sa queue."
                        },
                        {
                            "text": "L'oiseau effrayé a fui vers le bosquet en <w>écarquillant</w> brusquement ses ailes multicolores."
                        }
                    ],
                    "synonyms": [
                        "déployer",
                        "éployer"
                    ],
                    "antonyms": [
                        "replier"
                    ]
                },
                {
                    "sense_id": "e3fdb120-6cc8-300b-8177-71539a3ef3fc",
                    "sense_definition": "Tirailler ou étirer violemment une personne en maintenant ses quatre membres écartés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les brigands avaient attaché leur prisonnier contre deux arbres en l'<w>écarquillant</w> sans pitié."
                        },
                        {
                            "text": "Le supplicié poussait des gémissements terribles pendant que ses bourreaux l'<w>écarquillaient</w> au sol."
                        }
                    ],
                    "synonyms": [
                        "écarteler"
                    ],
