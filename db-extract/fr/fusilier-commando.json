                        "sense_id": "f5ae6866-5c25-34cc-b701-21d1184db973",
                        "entry_id": "f501cff4-415c-3bf0-9755-32eef41ca774",
                        "glosses": [
                            "Militaire dont la mission est la protection du personnel et des installations de l’armée de l’air, en France et en opérations extérieures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa979cc-a978-4bca-a888-66df130dafe7",
                                "sense_id": "f5ae6866-5c25-34cc-b701-21d1184db973",
                                "text": "Il y a dans les armées françaises des fusiliers-marins embarqués sur les navires et chargés d'opérations de débarquement à terre et des fusiliers-commandos de l'air chargés de la protection des bases."
                            },
                            {
                                "example_id": "d5d5efd6-a453-4654-83a4-1fe474d4f210",
                                "sense_id": "f5ae6866-5c25-34cc-b701-21d1184db973",
                                "text": "Dans l'armée de l'air, l'ensemble des spécialités militaires est accessible aux femmes, y compris celle de pilote de l'air, ou encore de fusilier-commando."
                            }
                        ]
                    }
