                "senses": [
                    {
                        "sense_id": "7c5770a1-829a-3ee7-b0f7-a8d4854aeee4",
                        "entry_id": "1745cd89-902a-3cb5-b88b-cd0a089538c4",
                        "glosses": [
                            "Trahir (dans un langage voulant évoquer le langage médiéval)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ba522a-663b-45e8-9424-5bcd6c9cf38e",
                                "sense_id": "7c5770a1-829a-3ee7-b0f7-a8d4854aeee4",
                                "text": "Il eut le temps de comprendre, avant de périr, qu’ils avaient été déconfiés."
                            },
                            {
                                "example_id": "5122551b-bdc5-4a99-a9e9-61acf70f17d0",
                                "sense_id": "7c5770a1-829a-3ee7-b0f7-a8d4854aeee4",
                                "text": "Voyons, mon bon Parfait, gémit Wilbert. Tu ne peux me déconfier ainsi."
                            },
                            {
                                "example_id": "4525cabe-ee78-416c-b8a5-a523d6ef5346",
                                "sense_id": "7c5770a1-829a-3ee7-b0f7-a8d4854aeee4",
                                "text": "Oyez mon beau-frère, tu es déconfié par Harold et son clan, et Édouard est mort le 5 janvier et le 6 janvier, soit le lendemain de la mort du roi Harold, il s’est proclamé roi d’Angleterre et cela a été approuvé par le Witan, le grand conseil parce qu’il a dit que tu lui avait cédé les droits s’il épousait ta fille aînée."
                            },
                            {
                                "example_id": "fab059ef-e609-4588-94e6-6396fb9e1040",
                                "sense_id": "7c5770a1-829a-3ee7-b0f7-a8d4854aeee4",
                                "text": "Tout ce tralala de perruques, poudre et beaux habits de soie m’échauffe. Derrière ces têtes combien ont déconfié leur classe."
                            }
                        ]
                    }
