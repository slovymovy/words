                "translations": [
                    {
                        "translation_id": "c86ad27b-a5ac-4ab6-bdf5-ec8dfe3b9bba",
                        "source_entry_id": "ee84c206-f1b4-3931-b3ac-f027abbac742",
                        "source_sense_id": "440c0202-3a2f-3d81-b09e-4f2bb63b0873",
                        "target_lang_word": "Walther",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walther",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6bef35-5ff6-3ee8-98a9-72cd963bde6b",
                                        "entry_id": "f5422a15-bdc8-3fbc-aebc-ffdd94846d98",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f20564-d88a-410a-bf9a-79338584db1a",
                                                "sense_id": "8e6bef35-5ff6-3ee8-98a9-72cd963bde6b",
                                                "text": "Walther Mustermann ist ein schöner Junge."
                                            },
                                            {
                                                "example_id": "e765b645-faa2-43bd-ac36-2ad044cc13eb",
                                                "sense_id": "8e6bef35-5ff6-3ee8-98a9-72cd963bde6b",
                                                "text": "Walther ist 20 Jahre alt."
                                            },
                                            {
                                                "example_id": "4cc5788a-8689-4746-9f29-1c3ae2f26840",
                                                "sense_id": "8e6bef35-5ff6-3ee8-98a9-72cd963bde6b",
                                                "text": "Grüß bitte Walther Mustermann herzlich von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Walther",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                        "entry_id": "4bbc3042-fc2a-3e91-8b63-9c850f6c17d1",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb9bf82-bac7-4f25-b40b-77f5d90008e7",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Frau Walther ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f8d80230-8fb3-40d0-bf4b-64a4c561f9de",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Herr Walther wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "eba7db7e-75e6-4242-aa32-2c3d3de10075",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Die Walthers kommen heute aus Duisburg."
                                            },
                                            {
                                                "example_id": "68f40bf9-efaf-4bd8-b989-4dcab142558b",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Der Walther trägt nie die Schals, die die Walther ihm strickt."
                                            },
                                            {
                                                "example_id": "10bc9e07-5073-4d45-88ac-d99bf862e92d",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Walther kommt, geht der Herr Walther.“"
                                            },
                                            {
                                                "example_id": "230581f9-c126-4385-b7d3-59a4bd4bc3c2",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Walther kommt und geht."
                                            },
                                            {
                                                "example_id": "9329262b-1240-44e9-94a0-aac26968dfe4",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "Walthers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "155ec4ed-8241-4377-b378-4bfb3e1f50b9",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "An verregneten Herbsttagen ist Familie Walthers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "d79d9dfa-94e3-4319-919e-f3d14175843e",
                                                "sense_id": "57951504-c7b6-3713-8ef6-baad6e0640cc",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Walther das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Walther",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7801150d-e378-3351-865e-ff1958fda0e4",
                                        "entry_id": "475c53d1-92e2-3964-b931-4237373cb843",
                                        "glosses": [
                                            "von der Firma Carl Walther GmbH hergestellte Handfeuerwaffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0fecf55-69a7-4aa5-ac5d-bb636725d3d6",
                                                "sense_id": "7801150d-e378-3351-865e-ff1958fda0e4",
                                                "text": "„Selbstbewusst legte Voland eine Hand an den Griff der Walther.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
