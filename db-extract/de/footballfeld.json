                "senses": [
                    {
                        "sense_id": "5058b20e-d671-3c16-8491-ea105a0a719e",
                        "entry_id": "ee89fc26-637d-3dd3-8ef7-e76b7beb6a0f",
                        "glosses": [
                            "Spielfeld für American Football"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dccb32a9-da93-40b6-a4a6-42797656c160",
                                "sense_id": "5058b20e-d671-3c16-8491-ea105a0a719e",
                                "text": "„The Black Sun ist so groß wie mehrere Footballfelder nebeneinander.“"
                            },
                            {
                                "example_id": "cc0c973d-3c1d-4333-9686-5998c35093df",
                                "sense_id": "5058b20e-d671-3c16-8491-ea105a0a719e",
                                "text": "„Darin verbarg sich ein Barrett M107, ein gigantisches Scharfschützengewehr, das Projektile so groß wie Bierflaschen abfeuerte, die mit Leichtigkeit innerhalb einer Sekunde die Distanz von neun Footballfeldern überwanden.“"
                            },
                            {
                                "example_id": "bbcb30da-dd50-4eec-9aa7-104a2ffd1eba",
                                "sense_id": "5058b20e-d671-3c16-8491-ea105a0a719e",
                                "text": "„Der Packard bog an der nächsten Ecke in die Muirfield Road ein und hielt vor einer riesigen Tudor-Villa mit einer Rasenfläche von der Größe eines Footballfeldes davor.“"
                            },
                            {
                                "example_id": "fbb76da4-a7fc-48e7-8dd9-9eaed6ee14df",
                                "sense_id": "5058b20e-d671-3c16-8491-ea105a0a719e",
                                "text": "„Ich blickte auf das unscheinbare Gelände, dass die Länge eines Footballfelds entfernt war, und griff auf unsichtbaren Saiten die Akkorde von ›Tequila Sunrise‹ während Frodos Handy weiterklingelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
