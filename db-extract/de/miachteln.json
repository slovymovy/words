                "senses": [
                    {
                        "sense_id": "a25e769a-b40e-3e33-9760-11c045380583",
                        "entry_id": "fa8e0a1b-1c3a-357f-aaea-19276cb3b075",
                        "glosses": [
                            "einen unangenehmen Geruch verbreiten"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8a3a50ba-05c8-4dd1-a61f-2a3a9f6b4fbe",
                                "sense_id": "a25e769a-b40e-3e33-9760-11c045380583",
                                "text": "„Dahinein also, wo das Menscheln vom Kopf her zu miachteln scheint“"
                            },
                            {
                                "example_id": "b21aea2e-cf4a-4633-8bdd-6ab356758e77",
                                "sense_id": "a25e769a-b40e-3e33-9760-11c045380583",
                                "text": "„Meteorologischer liegt über dem geistigen Nebel, Punschkranke sitzen im sportlich-utilitarem Kraftwagen, in der Bim und in der Uh, sie miachteln streng.“"
                            },
                            {
                                "example_id": "74282a6a-59df-49d8-8761-00c09ec71143",
                                "sense_id": "a25e769a-b40e-3e33-9760-11c045380583",
                                "text": "„Wie mies ein Thema auch miachteln mochte, die EAV gewann ihm frischen Wind ab.“"
                            },
                            {
                                "example_id": "ed44650a-2497-44e4-80c5-be567dca056f",
                                "sense_id": "a25e769a-b40e-3e33-9760-11c045380583",
                                "text": "„Wonach miachtelt es in Ihrem Auto?“"
                            },
                            {
                                "example_id": "d00dc412-bf96-4d94-bbfe-c5b64b278eea",
                                "sense_id": "a25e769a-b40e-3e33-9760-11c045380583",
                                "text": "„Ein bisschen grauslich war er, verfilzt und hat gemiachtelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
