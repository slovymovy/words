                                        "entry_id": "b36ab181-8930-3811-8086-1acfbde96332",
                                        "glosses": [
                                            "A smaller portion of an original sample, created by trimming, subdividing, splitting or discrete collection of the original sample."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fd04f51-b005-3869-b214-22bdc14b9e97",
                                        "entry_id": "b36ab181-8930-3811-8086-1acfbde96332",
                                        "glosses": [
                                            "A portion of the original sample that is representative in nature to that of the original sample, thereby assuring equivalency in results from tests and analysis either upon the subsample or the original material, independent of their size."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ef84aa-9fe9-4a9e-ba71-668f6b8b6737",
                                                "sense_id": "7fd04f51-b005-3869-b214-22bdc14b9e97",
                                                "text": "A second rater scored a subsample of copies ( n = 36 copies of both hands) and achieved high interrater reliability on the 2D and 4D measurements as well as the 2D:4D ratio with the initial rater (all intraclass r s > .97)."
                                            },
                                            {
                                                "example_id": "e87a232e-04e4-4319-9535-d6dd296c2c68",
                                                "sense_id": "7fd04f51-b005-3869-b214-22bdc14b9e97",
                                                "text": "In a statement, McDonald’s cited tests conducted in Colorado, the state that had the most cases reported in the outbreak. On its website, the state’s Agriculture Department said that tests were done on “dozens of subsamples from all the lots and all samples were found to be negative for E. coli.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subsample",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "478f4d54-6e86-3771-8fdb-f3a9630e9d4a",
                                        "entry_id": "94edd4b5-decd-3522-8838-ff873177fabf",
                                        "glosses": [
                                            "To take subsamples from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38930980-e51d-492e-b6a8-9b4e78f15c0f",
                                                "sense_id": "478f4d54-6e86-3771-8fdb-f3a9630e9d4a",
                                                "text": "The State Department of Social Services on April 11 released studies indicating statewide ineligibility of 2 to 4 per cent for federally aided cases and 5 per cent for home relief cases. The state's subsampling for New York City suggested that the rate there might be one percentage point higher."
                                            },
                                            {
                                                "example_id": "a32b415d-f907-4217-acca-66ba9e73de88",
                                                "sense_id": "478f4d54-6e86-3771-8fdb-f3a9630e9d4a",
                                                "text": "“Each sample, regardless of how I initially store it, is subsampled and dried in a food dehydrator for a few hours at about 100 degrees Fahrenheit, then vacuum sealed in plastic,” Ms. Gormezano said."
                                            }
                                        ]
                                    }
