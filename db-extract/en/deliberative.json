                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df039d32-6c9c-45ab-95db-e8676303b107",
                                "sense_id": "eac9040d-3861-397a-8a93-08212cb0f2fc",
                                "text": "[T]he court of jurisdiction is to be distinguished from the deliberative body, the advisers of the crown."
                            },
                            {
                                "example_id": "7bab2538-56e7-4fb1-ae6a-df4a949a7a5a",
                                "sense_id": "eac9040d-3861-397a-8a93-08212cb0f2fc",
                                "text": "A good system would have been a consummate work of deliberative wisdom"
                            },
                            {
                                "example_id": "c3d74f7c-748b-44c8-91c7-4f379df77289",
                                "sense_id": "eac9040d-3861-397a-8a93-08212cb0f2fc",
                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                            }
                        ]
