                        "glosses": [
                            "Formation d’une langue n’ayant qu’une seule origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbc8eb02-9a54-454d-a5df-6da1c09e2048",
                                "sense_id": "1edfaf33-cdae-3663-97d7-ab629fea0a3c",
                                "text": "Hébreu et monogenèse du langage."
                            },
                            {
                                "example_id": "1d11d058-f03e-40f0-b536-e1c717633b5d",
                                "sense_id": "1edfaf33-cdae-3663-97d7-ab629fea0a3c",
                                "text": "Le relativisme racial est à même de renforcer l’engagement du linguiste en faveur de la polygenèse des langues au détriment de leur monogenèse."
                            }
                        ]
                    }
