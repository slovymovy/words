                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fb5f42b-9b7c-3454-b81c-4e946d7b7c95",
                        "entry_id": "5eb9a864-adfb-3918-9d1f-6b5a5480f88e",
                        "glosses": [
                            "A weeklong period of formal mourning for a close relative."
                        ],
                        "tags": [
                            "Judaism",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70244ca2-2874-4bd2-93c8-603b105da352",
                                "sense_id": "4fb5f42b-9b7c-3454-b81c-4e946d7b7c95",
                                "text": "Did you know that some parents sit shiva […] for 30 days if their child is discovered to be gay?"
                            },
                            {
                                "example_id": "eb771875-dbf9-4308-b293-b6f5cecddc92",
                                "sense_id": "4fb5f42b-9b7c-3454-b81c-4e946d7b7c95",
                                "text": "Seymour: Audrey, quick! We've got to do an emergency [flower] arrangement.\n[…]\nMr. Mushnik: The Shivas are our most important funereal account. A big, enormous family, they're dropping off like flies!"
                            },
                            {
                                "example_id": "a72a740d-9f9f-48f8-84fd-ee4d34811338",
                                "sense_id": "4fb5f42b-9b7c-3454-b81c-4e946d7b7c95",
                                "text": "“Mo Kellman lost his wife ten years ago.” “Does that mean the shiva is over?”"
                            }
                        ]
                    }
