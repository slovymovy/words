                "senses": [
                    {
                        "sense_id": "b1ce7c68-d9af-3140-ad7e-3cf88637e264",
                        "entry_id": "ee0f703d-c2ef-30e1-8c8c-bdac48851294",
                        "glosses": [
                            "to philosophize"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a020ff-0752-4b89-af4a-3610b6663364",
                                "sense_id": "b1ce7c68-d9af-3140-ad7e-3cf88637e264",
                                "text": "Hij houdt ervan om te filosoferen over de diepere betekenis van het leven.",
                                "translation": "He enjoys philosophizing about the deeper meaning of life.",
                                "english": "He enjoys philosophizing about the deeper meaning of life."
                            },
                            {
                                "example_id": "481afc50-41e5-41d6-b09c-04a6a0db9500",
                                "sense_id": "b1ce7c68-d9af-3140-ad7e-3cf88637e264",
                                "text": "In de koffiepauze begonnen ze te filosoferen over de aard van de werkelijkheid.",
                                "translation": "During the coffee break, they started to philosophize about the nature of reality.",
                                "english": "During the coffee break, they started to philosophize about the nature of reality."
                            },
                            {
                                "example_id": "8e2b9a27-682f-4a74-bb3b-fcf8538e49b3",
                                "sense_id": "b1ce7c68-d9af-3140-ad7e-3cf88637e264",
                                "text": "Ze zitten vaak samen in de tuin te filosoferen over de toekomst.",
                                "translation": "They often sit together in the garden, philosophizing about the future.",
                                "english": "They often sit together in the garden, philosophizing about the future."
                            },
                            {
                                "example_id": "8f98db67-179e-48ce-9435-993959d5149e",
                                "sense_id": "b1ce7c68-d9af-3140-ad7e-3cf88637e264",
                                "text": "Het boek nodigt de lezer uit om te filosoferen over ethische dilemma's.",
                                "translation": "The book invites the reader to philosophize about ethical dilemmas.",
                                "english": "The book invites the reader to philosophize about ethical dilemmas."
                            }
                        ]
                    }
                ],
