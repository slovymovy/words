                        "glosses": [
                            "Bedachtsein auf den eigenen Vorteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d9fd95-4596-4023-a6f7-dab1278ea45a",
                                "sense_id": "dd2e9b93-2d91-3e9c-a6d1-2e216229d49c",
                                "text": "Er heiratete sie aus reinem Eigennutz."
                            }
                        ],
