                        "entry_id": "4c6e8446-b526-3101-a74e-f6dc75a1348c",
                        "glosses": [
                            "Libérer de sa cage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc55633f-9cdf-49f7-b65a-c35bd58c856d",
                                "sense_id": "22fdd46d-82ff-33ee-8c84-e5d919a60fcc",
                                "text": "Il se trouvait prisonnier dans une cage de fer. […] On décagea le prisonnier."
                            },
                            {
                                "example_id": "28fb2666-61be-4282-b835-1d25cccf912a",
                                "sense_id": "22fdd46d-82ff-33ee-8c84-e5d919a60fcc",
                                "text": "« Après le baiser il n’y a pas de plaisir plus doux que la morsure. Est-ce ma faute à moi s’il y a en moi une petite bête fauve que décagent l’injustice et l’indignation. »"
                            }
                        ]
                    }
