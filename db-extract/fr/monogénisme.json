                ],
                "senses": [
                    {
                        "sense_id": "49e59f4e-70d7-33b4-891f-0f0312e56de9",
                        "entry_id": "b7ca509a-b8a6-3abb-9f05-4c68de66fb94",
                        "glosses": [
                            "Système d’après lequel on admet que toutes les races humaines dérivent d’un seul couple, ou du moins d’une seule origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f2ca9a-60c6-4c2e-aa7e-02891c144640",
                                "sense_id": "49e59f4e-70d7-33b4-891f-0f0312e56de9",
                                "text": "Blumenbach est le champion du monogénisme contre certains de ses contemporains, en particulier l’anatomiste Samuel Thomas Sömmerring et l’historien et essayiste Christoph Meiners."
                            },
                            {
                                "example_id": "155f8144-4b6d-4410-a140-2971cba5c9ed",
                                "sense_id": "49e59f4e-70d7-33b4-891f-0f0312e56de9",
                                "text": "Quoiqu’il en soit, ces points -polygénisme ou monogénisme ; fécondité des métissages ou métissages eugénésiques – faisaient débat au sein de la société d’anthropologie."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f3a16aa-e3bb-316a-b3dd-a5684f676f4d",
                        "entry_id": "b7ca509a-b8a6-3abb-9f05-4c68de66fb94",
                        "glosses": [
                            "Théorie selon laquelle toutes les langues humaines dériveraient d’une langue commune, la langue originelle."
                        ],
                        "tags": [],
                        "examples": []
                    }
