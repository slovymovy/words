{
    "word_family": [
        "debase",
        "debasement",
        "debaser"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bc8a098-c00a-3c22-8d07-7104027325c4",
                    "sense_definition": "Reduced in quality, value, or moral character; degraded.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degraded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>debased</w> currency caused significant inflation throughout the country.",
                            "target_lang_translations": {
                                "nl": "De <w>ontwaarde</w> valuta veroorzaakte aanzienlijke inflatie in het hele land."
                            }
                        },
                        {
                            "text": "Critics argued that the film was a <w>debased</w> version of the original classic novel.",
                            "target_lang_translations": {
                                "nl": "Critici voerden aan dat de film een <w>gedegradeerde</w> versie van de oorspronkelijke klassieke roman was."
                            }
                        }
                    ],
                    "synonyms": [
                        "degraded",
                        "corrupted",
                        "devalued"
                    ],
                    "antonyms": [
                        "ennobled",
                        "elevated"
                    ],
                    "common_phrases": [
                        "debased currency",
                        "debased quality"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verminderd in kwaliteit, waarde of moreel karakter; gedegradeerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gedegradeerd",
                                "target_lang_sense_clarification": "verlaagd in rang of kwaliteit"
                            },
                            {
                                "target_lang_word": "ontwaard",
                                "target_lang_sense_clarification": "in waarde verminderd, vaak gebruikt voor valuta"
                            },
                            {
                                "target_lang_word": "verdorven",
                                "target_lang_sense_clarification": "moreel vervallen of corrupt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d117cf0-c760-3a09-a76f-f6621c70ba04",
                    "sense_definition": "Positioned lower than the standard or usual location on a shield in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion on the coat of arms is <w>debased</w> to make room for the crest above.",
                            "target_lang_translations": {
                                "nl": "De leeuw op het wapenschild is <w>verlaagd</w> om ruimte te maken voor het helmteken erboven."
                            }
                        },
                        {
                            "text": "In this specific design, the central charge appears <w>debased</w> compared to traditional layouts.",
                            "target_lang_translations": {
                                "nl": "In dit specifieke ontwerp lijkt het centrale symbool <w>verlaagd</w> in vergelijking met traditionele lay-outs."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "In de heraldiek: lager geplaatst dan de standaard of gebruikelijke positie op een schild."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verlaagd",
                                "target_lang_sense_clarification": "in een lagere positie geplaatst"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "735a7fda-2191-307a-b8ef-2c6ba30b7698",
                    "sense_definition": "Simple past and past participle of <w>debase</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "degraded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king <w>debased</w> the coinage by mixing in cheaper metals.",
                            "target_lang_translations": {
                                "nl": "De koning <w>verlaagde</w> de muntwaarde door er goedkopere metalen doorheen te mengen."
                            }
                        },
                        {
                            "text": "Critics said the cheap show had <w>debased</w> public taste.",
                            "target_lang_translations": {
                                "nl": "Critici zeiden dat de goedkope show de smaak van het publiek had <w>aangetast</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'debase' (in waarde of kwaliteit verlagen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verlaagde",
                                "target_lang_sense_clarification": "enkelvoud verleden tijd"
                            },
                            {
                                "target_lang_word": "ontwaard",
                                "target_lang_sense_clarification": "voltooid deelwoord, in waarde verminderd"
                            },
                            {
                                "target_lang_word": "aangetast",
                                "target_lang_sense_clarification": "voltooid deelwoord, in reputatie of kwaliteit geschaad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}