                "translations": [
                    {
                        "translation_id": "931baf11-62fb-42fa-98ad-4c84401ea4fa",
                        "source_entry_id": "d2de6e8d-768c-34e1-9a9f-49a2b6f1c620",
                        "source_sense_id": "3120c167-a249-3b3a-9829-113ae33f855b",
                        "target_lang_word": "coppice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coppice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ddf9ac-2490-346a-aeb6-93c9eaf23871",
                                        "entry_id": "f24ce7f8-dcc9-369b-a612-638da9801af7",
                                        "glosses": [
                                            "A grove of small growth; a thicket of brushwood; a wood cut at certain times for fuel or other purposes, typically managed to promote growth and ensure a reliable supply of timber. See copse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b3215f-e13b-4492-99cf-617b0df69f62",
                                                "sense_id": "04ddf9ac-2490-346a-aeb6-93c9eaf23871",
                                                "text": "[…]belts of thin white mist streaked the brown plough land in the hollow where Appleby could see the pale shine of a winding river. Across that in turn, meadow and coppice rolled away past the white walls of a village bowered in orchards,[…]"
                                            },
                                            {
                                                "example_id": "97641422-b0e2-45d1-8b5d-9ac7b907912f",
                                                "sense_id": "04ddf9ac-2490-346a-aeb6-93c9eaf23871",
                                                "text": "It was also enacted that all coppices or underwoods should be enclosed for periods from four to seven years after felling."
                                            },
                                            {
                                                "example_id": "f3b10025-c306-4a3f-8576-4d38dd2a301e",
                                                "sense_id": "04ddf9ac-2490-346a-aeb6-93c9eaf23871",
                                                "text": "At the time of the Norman Conquest, any village with woodland had one or more coppices of about 80 acres. […] Coppice trees are periodically cut to a level just above the ground. […] Hazel forms most English coppices, but there are also coppices of alder, oak, wych elm and willow."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coppice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85377782-348a-36be-b402-0b293b6da020",
                                        "entry_id": "a48718dc-8ead-378b-8ac7-09bb0497afd3",
                                        "glosses": [
                                            "To manage (a wooded area) sustainably, as a coppice, by periodically cutting back woody plants to promote new growth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f4ebc9-585d-48a2-b9b9-dfdee0c72363",
                                                "sense_id": "85377782-348a-36be-b402-0b293b6da020",
                                                "text": "Her plan to coppice the woods should keep her self-sufficient in fuel indefinitely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf376e4-39ff-39e8-b790-4d8bbf466928",
                                        "entry_id": "a48718dc-8ead-378b-8ac7-09bb0497afd3",
                                        "glosses": [
                                            "To sprout from the stump."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b4d1f07-a22d-4928-b5aa-e8bb3033334c",
                                                "sense_id": "cdf376e4-39ff-39e8-b790-4d8bbf466928",
                                                "text": "Few conifer species can coppice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "083a0c47-e41f-43fe-ae94-ea72667e2086",
                        "source_entry_id": "d2de6e8d-768c-34e1-9a9f-49a2b6f1c620",
