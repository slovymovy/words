            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8e527eb-5984-3992-b2d8-d47bbbdc055a",
                    "sense_definition": "voorzien van puntvormige markeringen of versieringen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "versieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar besloot om het hele oppervlak van de vaas te <w>stippen</w> met kleine verfspatten.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>покрыть всю поверхность вазы точками</w> из маленьких брызг краски.",
                                "fr": "L'artiste a décidé de <w>pointiller</w> toute la surface du vase avec de petites éclaboussures de peinture."
                            }
                        },
                        {
                            "text": "Zij leerde hoe ze het glas moest <w>stippen</w> om een uniek patroon te creëren.",
                            "target_lang_translations": {
                                "ru": "Она училась тому, как <w>украшать стекло точками</w>, чтобы создать уникальный узор.",
                                "fr": "Elle a appris à <w>décorer de points</w> le verre pour créer un motif unique."
                            }
                        }
                    ],
                    "synonyms": [
                        "stippelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "покрывать поверхность точечными узорами или отметками",
                        "fr": "Pourvoir de petits points ou marquer/décorer avec des points"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывать точками",
                                "target_lang_sense_clarification": "наносить множество точек на поверхность"
                            },
                            {
                                "target_lang_word": "украшать точками",
                                "target_lang_sense_clarification": "декорировать предмет с помощью точечного рисунка"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pointiller",
                                "target_lang_sense_clarification": "marquer ou recouvrir de points"
                            },
                            {
                                "target_lang_word": "moucheter",
                                "target_lang_sense_clarification": "parsemer de petites taches ou points"
                            },
                            {
                                "target_lang_word": "décorer de points",
                                "target_lang_sense_clarification": "peindre ou orner avec des points"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ea255ca-4ee9-3bad-b981-83c9501fce7d",
                    "sense_definition": "meervoud van <w>stip</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op het behang staan allemaal kleine <w>stippen</w>.",
                            "target_lang_translations": {
                                "ru": "На обоях повсюду маленькие <w>точки</w>.",
                                "fr": "Sur le papier peint, il y a plein de petits <w>points</w>."
                            }
                        },
                        {
                            "text": "De <w>stippen</w> op de dobbelsteen geven het aantal ogen aan.",
                            "target_lang_translations": {
                                "ru": "<w>Точки</w> на игральной кости обозначают количество очков.",
                                "fr": "Les <w>points</w> sur le dé indiquent le nombre de points."
                            }
                        }
                    ],
