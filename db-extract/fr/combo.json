                "forms": [
                    {
                        "form_id": "022ac669-ccbc-4e58-afbc-f8c025152acb",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "tags": [
                            "plural"
                        ],
                        "form": "combos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dd3018c-9f47-3f00-874c-ed4d63115c5a",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "glosses": [
                            "Deux ou plusieurs appareils, fonctions, combinés en un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5931a3f-c899-4a6e-91fe-8c52f6f3c8a2",
                                "sense_id": "9dd3018c-9f47-3f00-874c-ed4d63115c5a",
                                "text": "Le COMBO SMART est une nouvelle génération de scanner-détecteur de faux documents d’identité."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed35a577-8bb4-391b-8e93-12c8ff362816",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "glosses": [
                            "Deux ou plusieurs événements associés."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b0c95afa-7f53-4dbd-ae41-9ce9cd36edea",
                                "sense_id": "ed35a577-8bb4-391b-8e93-12c8ff362816",
                                "text": "Bac + canicule + travaux à la disqueuse + pas de rideaux = combo gagnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "e318d923-cd62-3d94-a2d7-3f1b6d6939ea",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "glosses": [
                            "Petit enregistreur (à bande ou disque dur) diffusant l'image et le son issu de la prise tournée via la reprise vidéo de la caméra principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74e49af-d7f1-4fd4-89f4-6c0e68e217fb",
                                "sense_id": "e318d923-cd62-3d94-a2d7-3f1b6d6939ea",
                                "text": "Au combo, ivre mort, le frère aîné de Karénine libère en martyrisant toute l’équipe, la frustration qui a brisé sa vie, celle d’être le frère raté d’un génie. Je l’avais rencontré pendant le tournage de Superstars, quelque part sur Mulholland Drive."
                            }
                        ]
                    },
                    {
                        "sense_id": "c80f787f-12d1-39ec-bf74-dcd00ab197d1",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "glosses": [
                            "Enchainement parfois complexe de plusieurs actions simples, en particulier pour désigner une attaque ou réussite suivie dans les jeux."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "086f6e95-ccef-3a2d-b336-4fb94341c060",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "glosses": [
                            "Petit orchestre, petite formation de jazz."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e0e2723a-c509-4460-99fb-b15bfc71ce7d",
                                "sense_id": "086f6e95-ccef-3a2d-b336-4fb94341c060",
                                "text": "[…] et pour ces frères, l’enjeu est vital, pendant une heure, ils vont pouvoir répéter avec leur combo, un petit orchestre, comme on dit dans le milieu du jazz."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a50b3d5-53cd-326c-8b3e-dcdff6ec3d83",
                        "entry_id": "15b9baa2-cecd-3861-a06c-ce954d4c3a6e",
                        "glosses": [
                            "Combinaison de plusieurs choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b330da8-e0c8-4168-9216-8df297ea496e",
                                "sense_id": "7a50b3d5-53cd-326c-8b3e-dcdff6ec3d83",
                                "text": "Fourchette à la main et vue sur mer, un combo souvent recherché par les touristes mais également apprécié par les locaux qui ne souhaitent pas trop dépenser."
                            },
                            {
                                "example_id": "1d992080-9b32-437b-9f15-f1b74e1d0080",
                                "sense_id": "7a50b3d5-53cd-326c-8b3e-dcdff6ec3d83",
                                "text": "Populaire dans la génération Z, ce look est de plus en plus adopté sur TikTok par une jeunesse qui s’approprie les codes de la mode modeste, sobre, élégante, tout en faisant écho aux années 2000, qui ont popularisé ce combo."
                            }
                        ]
                    }
                ],
