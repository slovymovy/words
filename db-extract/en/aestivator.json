                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcef9413-ec06-4f90-b596-eb896a66b6e6",
                                "sense_id": "c61bb0f5-af6f-3f09-b6c6-a5c3b5fd9e82",
                                "text": "It was a strictly aquatic animal, possibly an aestivator during its younger stages."
                            },
                            {
                                "example_id": "dc3b0aee-1be7-4a6f-b538-0726a5ead64f",
                                "sense_id": "c61bb0f5-af6f-3f09-b6c6-a5c3b5fd9e82",
                                "text": "This complements the large increase in Gnathorhiza, a known aestivator since Wichita-Albany time (Berman, 1976)."
                            },
                            {
                                "example_id": "936d9706-2034-457c-8fb0-a2471c4d6a1b",
                                "sense_id": "c61bb0f5-af6f-3f09-b6c6-a5c3b5fd9e82",
                                "text": "Biomphalaria sudanica is associated with the margins of lakes and papyrus swamps and was classified as a poor aestivator by Brown (1975, 1980)."
                            }
