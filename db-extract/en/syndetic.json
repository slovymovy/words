                "senses": [
                    {
                        "sense_id": "0ddc347c-3e1b-3834-853e-2f5e6c32b9f3",
                        "entry_id": "23b0e8fe-b810-3c83-8876-fcb37403c4ff",
                        "glosses": [
                            "Of or related to syndeton, the use of a conjunction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a738826b-a995-4c2e-9506-746e3c872fac",
                                "sense_id": "0ddc347c-3e1b-3834-853e-2f5e6c32b9f3",
                                "text": "Guns and butter is a syndetic phrase."
                            },
                            {
                                "example_id": "837d88d1-dabf-4257-9c3f-32bd5a3223a9",
                                "sense_id": "0ddc347c-3e1b-3834-853e-2f5e6c32b9f3",
                                "text": "Asymmetry in pronominal sequencing is a recurrent feature of syndetic coordination, though with considerable variation in relation to literary genre."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c862925-f103-3843-9e21-362af13af580",
                        "entry_id": "23b0e8fe-b810-3c83-8876-fcb37403c4ff",
                        "glosses": [
                            "Synonym of connective, serving to connect."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "35e03482-50de-4743-89a5-b4f51236b26c",
                                "sense_id": "9c862925-f103-3843-9e21-362af13af580",
                                "text": "With the syndetic juxtaposition of distinct members, the article is not often repeated."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fd60764-aec6-3156-aae0-fc1fe7640ad8",
                        "entry_id": "23b0e8fe-b810-3c83-8876-fcb37403c4ff",
                        "glosses": [
                            "Synonym of crossreferenced."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5d853814-6b00-4438-8194-301f1a59a819",
                                "sense_id": "4fd60764-aec6-3156-aae0-fc1fe7640ad8",
                                "text": "Syndetic, applied to an alphabetical subject catalogue or dictionary catalogue which includes cross-references as connecting links between subjects."
                            },
                            {
                                "example_id": "c74f817e-3525-4ffa-9741-553f78bd9000",
                                "sense_id": "4fd60764-aec6-3156-aae0-fc1fe7640ad8",
                                "text": "The dictionary includes syndetic references."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e0471ef-5624-30a3-bc2a-7dcb4ebe2cfb",
                        "entry_id": "23b0e8fe-b810-3c83-8876-fcb37403c4ff",
                        "glosses": [
                            "Having bounded gaps between its terms."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b72dd2dc-9c8e-4d52-b352-7286b8f4219d",
                                "sense_id": "5e0471ef-5624-30a3-bc2a-7dcb4ebe2cfb",
                                "text": "The gap between successive members of a syndetic set may vary but is always less than some specific value: i.e., there is an integer n such that {x,x+1,x+2,⋯,x+n}∩S≠∅ for any x∈N."
                            }
                        ]
                    }
