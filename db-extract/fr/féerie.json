                                        "sense_id": "b9814a0e-5435-32eb-a33b-e3ea96a218e9",
                                        "entry_id": "99de8236-83f6-3488-b327-acdacf3eb2d8",
                                        "glosses": [
                                            "Land eines Märchens, in einem Märchen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f374798c-d2e2-3fb3-8402-6bae2558e3aa",
                                        "entry_id": "99de8236-83f6-3488-b327-acdacf3eb2d8",
                                        "glosses": [
                                            "Land, das man als märchenhaft erfährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "274b72a4-5f9a-418d-a00a-de81625cd487",
                                                "sense_id": "f374798c-d2e2-3fb3-8402-6bae2558e3aa",
                                                "text": "„An Sommertagen, wenn die Sonne hoch stand, war die golden schimmernde Ebene ihr Märchenland gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "223ebae4-26b4-4c5b-b976-90617549810a",
                        "source_entry_id": "127f6e26-e4a2-3835-8820-314850484cf6",
                        "target_lang_word": "Feenland",
