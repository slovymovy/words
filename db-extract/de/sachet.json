                                    {
                                        "sense_id": "e5c17fa2-8826-3a36-a832-97a6d9ad92d9",
                                        "entry_id": "74586fa1-4280-3b16-a1eb-a72a586edca5",
                                        "glosses": [
                                            "A small scented cloth bag filled with fragrant material such as herbs or potpourri."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b54988d-cba0-3baa-be0a-8570c23175e5",
                                        "entry_id": "74586fa1-4280-3b16-a1eb-a72a586edca5",
                                        "glosses": [
                                            "A cheesecloth bag of herbs and/or spices added during cooking and then removed before serving."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7d1b4bc-356c-3ff1-9617-eae2a4ec052c",
                                        "entry_id": "74586fa1-4280-3b16-a1eb-a72a586edca5",
                                        "glosses": [
                                            "A small, sealed packet containing a single-use quantity of any material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9cb37cb-8be1-4bd1-8a0e-82ca1c25fb91",
                                                "sense_id": "d7d1b4bc-356c-3ff1-9617-eae2a4ec052c",
                                                "text": "My burger arrived with a plastic sachet of tomato ketchup."
                                            },
                                            {
                                                "example_id": "f8e9301c-099d-4704-9932-50c0331fa19c",
                                                "sense_id": "d7d1b4bc-356c-3ff1-9617-eae2a4ec052c",
                                                "text": "In the Philippines and other parts of Southeast Asia, the problem was compounded by a new kind of plastic packaging that took flight in the 1980s — the sachet. It was a plastic pouch but often bulked up with layers of aluminum or paper for shape or durability. […] Sachets are cheap, flashy and convenient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "573ff395-306f-4847-a1c5-0d13dab5e3cb",
                        "source_entry_id": "346543b8-2518-39bb-bf46-fa4d92349d9a",
                        "source_sense_id": "1ac2742d-2f4c-3ac5-a082-851b72ee6cae",
                        "source_sense_description": "kleine, gefüllte Verpackung oder Säckchen",
                        "target_lang_word": "sachet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sachet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ade835-a752-3fe7-937e-fb5d63a5773a",
                                        "entry_id": "2911389e-29d3-3104-b1f8-799fb8f5b6bc",
                                        "glosses": [
                                            "Petit sac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0ee05d-ebcb-4c41-98a0-7c292b7cb9ab",
                                                "sense_id": "e3ade835-a752-3fe7-937e-fb5d63a5773a",
                                                "text": "Tout le monde se servit, même Tauno, qui se leva laborieusement du canapé et prit toute une poignée de grignoteries dans le sachet d’Irma."
                                            },
                                            {
                                                "example_id": "6b15a234-58ad-43ea-977d-55f5d4355ee8",
                                                "sense_id": "e3ade835-a752-3fe7-937e-fb5d63a5773a",
                                                "text": "Porter sur soi du camphre dans un sachet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d92a28d-4e49-3a35-9d66-d6c60a9b1e36",
                                        "entry_id": "2911389e-29d3-3104-b1f8-799fb8f5b6bc",
                                        "glosses": [
                                            "Petit emballage de papier ou de film plastique, plat destiné à de petits objets ou une faible quantité de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308e640a-506b-4a82-8a9b-de575d5bd1b4",
                                                "sense_id": "7d92a28d-4e49-3a35-9d66-d6c60a9b1e36",
                                                "text": "Ian sortit de la poche intérieure de sa veste un sachet en plastique contenant une poudre blanche. « À partir de cette petite quantité, il est possible de préparer de deux à quatre portions d'œufs brouillés. »."
                                            },
                                            {
                                                "example_id": "6e171b34-6be0-448d-aa37-76b79b9ff231",
                                                "sense_id": "7d92a28d-4e49-3a35-9d66-d6c60a9b1e36",
                                                "text": "Je croule sous les sachets de compléments alimentaires, des boissons d’effort ultravitaminées, j’en ai emporté une quarantaine, un sachet par jour suffit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64bcbe7-c3f5-3a32-a809-883dc4303fb4",
                                        "entry_id": "2911389e-29d3-3104-b1f8-799fb8f5b6bc",
                                        "glosses": [
                                            "Petit coussin où l’on met des parfums, des senteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734216e2-aed6-4a72-a902-f6067a6dee8e",
                                                "sense_id": "b64bcbe7-c3f5-3a32-a809-883dc4303fb4",
                                                "text": "Des sachets parfumés."
                                            }
                                        ]
                                    }
