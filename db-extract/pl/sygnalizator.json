                                    {
                                        "sense_id": "02fd1689-8d40-3c14-95b3-47a50d158c4a",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "Any variation of a quantity or change in an entity over time that conveys information upon detection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20eddf08-28b8-3c77-b107-91c6de03fc30",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "A sign made to give notice of some occurrence, command, or danger, or to indicate the start of a concerted action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "938e1852-059e-4109-985e-cb51451fa8d9",
                                                "sense_id": "20eddf08-28b8-3c77-b107-91c6de03fc30",
                                                "text": "All obeyed / The wonted signal and superior voice / Of this great potentate."
                                            },
                                            {
                                                "example_id": "4208f84c-7b6f-4b9d-bd2a-5dec5d2dd3de",
                                                "sense_id": "20eddf08-28b8-3c77-b107-91c6de03fc30",
                                                "text": "Banner-Repeater signals tend to be provided in locations where drivers receive insufficient warning of the main signal, thereby effectively increasing the sighting distance for the main signal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fcdc0aa-22a7-3d73-bbea-90d002b8ed91",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "An on-off light, semaphore, or other device used to give an indication to another person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c278cddc-4371-3349-9ca3-a44df09aa50d",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "An electromagnetic action, normally a voltage that is a function of time, that conveys the information of the radio or TV program or of communication with another party."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "TV",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcb136f-a850-4cf7-b2d0-163603fb59e6",
                                                "sense_id": "c278cddc-4371-3349-9ca3-a44df09aa50d",
                                                "text": "My mobile phone can't get a signal in the railway station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c339ca-dacd-36e2-b605-c677f61d5cf3",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "An action, change or process done to convey information and thus reduce uncertainty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f3afb9c-83bc-3151-ac05-1a5b597409aa",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "A token; an indication; a foreshadowing; a sign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71e960c-5e49-40d9-8226-151d8e2d29f8",
                                                "sense_id": "9f3afb9c-83bc-3151-ac05-1a5b597409aa",
                                                "text": "The weary sun […] / Gives signal of a goodly day to-morrow."
                                            },
                                            {
                                                "example_id": "80e76a9f-0a53-4bd3-b2f3-e7607751cf0f",
                                                "sense_id": "9f3afb9c-83bc-3151-ac05-1a5b597409aa",
                                                "text": "There was not the least signal of the calamity to be seen."
                                            },
                                            {
                                                "example_id": "38cb8ce9-ea5a-426d-ae08-04bdae477f49",
                                                "sense_id": "9f3afb9c-83bc-3151-ac05-1a5b597409aa",
                                                "text": "Did I get it wrong all along? / You were sending signals / You sent certain signals to me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d34c3c2-df57-3753-8e18-be0457fd41e9",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "Useful information, as opposed to noise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8b7d534-1b0b-3953-ab20-36c84bb83e19",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "A simple interprocess communication used to notify a process or thread of an occurrence."
                                        ],
                                        "tags": [
                                            "Unix"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fee73eb8-f277-36f5-a98b-7c97ccba966e",
                                        "entry_id": "ac9100ca-886e-37c3-be82-a95528169020",
                                        "glosses": [
                                            "A signalling interaction between cells"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "signal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                        "entry_id": "fbee9b92-34d5-3180-a192-83404af074b6",
                                        "glosses": [
                                            "To indicate; to convey or communicate by a signal."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14007ad5-2020-4f46-add5-82474c1e7dab",
                                                "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                                "text": "It is the latest step towards an airline-style advance booking-only system, which rail users have denounced as signalling the end of affordable, immediate travel."
                                            },
                                            {
                                                "example_id": "2d3ef160-a147-4737-a8db-4f1b9aa81ead",
                                                "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                                "text": "I signalled my acquiescence with a nod."
                                            },
                                            {
                                                "example_id": "7a70d2c2-46a2-430b-86e2-fc140482657c",
                                                "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                                "text": "He whistled to signal that we should stop."
                                            },
                                            {
                                                "example_id": "4f7a7788-d15b-4b47-9e59-d9fce81e177e",
                                                "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                                "text": "In order to accommodate the new platform 4 and the reversibly signalled slow line, a deep cutting had to be cut back and held up in places with a concrete retaining wall."
                                            },
                                            {
                                                "example_id": "ad536aca-c9c9-4d49-83b5-7edb0fec86b2",
                                                "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                                "text": "I signaled for our waiter and ordered two Glenlivets, the only single malt they had behind the bar."
                                            },
                                            {
                                                "example_id": "2ccff03f-9b34-4849-b948-a2051c32d87b",
                                                "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                                                "text": "The break with tradition that Francis, who has died aged 88 after suffering from double pneumonia, represented even managed to trump the shock value of the resignation of Benedict, who was the first pope for 600 years to take that option rather than die in office. Immediately, Bergoglio signalled unambiguously that he intended to be a different kind of pope, one for the 21st century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b27204c-009c-3f02-a670-65a1dd79d5bc",
                                        "entry_id": "fbee9b92-34d5-3180-a192-83404af074b6",
                                        "glosses": [
                                            "To communicate with (a person or system) by a signal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798619df-94ce-44f0-9d19-92bb8af94a32",
                                                "sense_id": "5b27204c-009c-3f02-a670-65a1dd79d5bc",
                                                "text": "Seeing the flames, he ran to the control room and signalled headquarters."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "signal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3211c9-4bea-3677-8881-b70afa87ac20",
                                        "entry_id": "fbc76735-d62c-3b4e-a481-cead3e2802e8",
                                        "glosses": [
                                            "Standing above others in rank, importance, or achievement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d83a0b1a-1e57-481f-976d-dabfd0a7537b",
                                                "sense_id": "2c3211c9-4bea-3677-8881-b70afa87ac20",
                                                "text": "a signal exploit; a signal success; a signal act of benevolence"
                                            },
                                            {
                                                "example_id": "8a5f0217-36b6-4571-bd89-236324a2be68",
                                                "sense_id": "2c3211c9-4bea-3677-8881-b70afa87ac20",
                                                "text": "As ſignal now in low dejected ſtate, / As earſt in higheſt, behold him where he lies."
                                            },
                                            {
                                                "example_id": "ade05e30-0824-481a-ba1a-97bc55a69949",
                                                "sense_id": "2c3211c9-4bea-3677-8881-b70afa87ac20",
                                                "text": "But, setting this view aside, dishonorable would it be in the South were she willing to abandon to shame the memory of brave men who with signal personal disinterestedness warred in her behalf, though from motives, as we believe, so deplorably astray."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
