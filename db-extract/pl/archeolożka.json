                        "cross_references": []
                    },
                    {
                        "translation_id": "c88127ab-c4a8-4770-9f6e-3866492ec795",
                        "source_entry_id": "7787e131-3d68-3386-b977-ca728949bdaa",
                        "source_sense_id": "8ffc96a5-4e60-3f7a-aed3-e31062d55081",
                        "target_lang_word": "Archäologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archäologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39349763-c740-35d4-871a-c87f8fb7c1af",
                                        "entry_id": "1b597c64-0723-3b66-ba3e-84322c8ffe8f",
                                        "glosses": [
                                            "weibliche Person, die in der Archäologie ausgebildet und bewandert ist, sich also mit den materiellen Überresten vor allem alter Kulturen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6633ea99-f486-4ff2-9c06-f03375399744",
                                                "sense_id": "39349763-c740-35d4-871a-c87f8fb7c1af",
                                                "text": "Archäologinnen verschaffen uns Kenntnisse über die Kulturen, die in einer Zeit entstanden, als es noch keine Schrift gab."
                                            },
                                            {
                                                "example_id": "0e4fdb05-a442-4dd1-91f0-e302b49f9b56",
                                                "sense_id": "39349763-c740-35d4-871a-c87f8fb7c1af",
                                                "text": "„Ich werde eine berühmte Archäologin, da hält mich niemand von ab.“"
                                            },
                                            {
                                                "example_id": "539cc17e-182d-4fd2-80fd-84e058072a57",
                                                "sense_id": "39349763-c740-35d4-871a-c87f8fb7c1af",
                                                "text": "„Energisch hingegen widerspricht die Archäologin Historikern, die der altdeutschen Reichstagsstätte Worms eine burgundische Geschichte andichten.“"
                                            },
                                            {
                                                "example_id": "34079b94-2dd2-4fe9-8deb-350bf708f2df",
                                                "sense_id": "39349763-c740-35d4-871a-c87f8fb7c1af",
                                                "text": "„In der zweiten Woche bringen ein Grabungsingenieur und eine Archäologin schweres Gerät.“"
                                            },
                                            {
                                                "example_id": "6da7228b-bc2a-4af0-8258-d5621d6d5f3c",
                                                "sense_id": "39349763-c740-35d4-871a-c87f8fb7c1af",
                                                "text": "„Die Archäologin hat die Keltenstadt 34 Jahre lang untersucht – so lange wie niemand zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
