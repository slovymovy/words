                    }
                ],
                "senses": [
                    {
                        "sense_id": "0681422f-dbc7-3016-9ce0-7b77f4192538",
                        "entry_id": "3d654754-c12c-379f-8abd-2078111fd248",
                        "glosses": [
                            "православный монах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1458454b-8b09-4c9a-8f5e-3592b49a2a17",
                                "sense_id": "0681422f-dbc7-3016-9ce0-7b77f4192538",
                                "text": "У инока ни отца, ни матери, ни детей, ни сродников нет, кроме единого Бога."
                            },
                            {
                                "example_id": "b1998b12-45bd-45e0-85aa-a306ea25d76d",
                                "sense_id": "0681422f-dbc7-3016-9ce0-7b77f4192538",
                                "text": "Некоторые иноки печерские укрылись от меча Батыева и жили в лесах."
                            },
                            {
                                "example_id": "1044f22a-d56e-4c0e-9343-f07bb5a49842",
                                "sense_id": "0681422f-dbc7-3016-9ce0-7b77f4192538",
                                "text": "А я от отроческих лет // По келиям скитаюсь, бедный инок!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c442c84e-29c5-4e06-a25e-f32b283eee9f",
                        "source_entry_id": "3d654754-c12c-379f-8abd-2078111fd248",
                        "source_sense_id": "0681422f-dbc7-3016-9ce0-7b77f4192538",
                        "target_lang_word": "coenobite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coenobite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b644fa3-367c-3c3a-bb0d-978d1dec9b32",
                                        "entry_id": "0fed779d-b6a3-32c3-8f51-9a6fc589e166",
                                        "glosses": [
                                            "Alternative spelling of cenobite."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d9321ec-d9d4-44ec-9d1d-36d9ac126e0d",
                                                "sense_id": "0b644fa3-367c-3c3a-bb0d-978d1dec9b32",
                                                "text": "The killing resounded around the world but above all in St Petersburg and Paris: the aggressive confidence of the coenobite brawlers reflected not just the religions but the empires behind them."
                                            }
                                        ]
                                    }
                                ]
                            }
