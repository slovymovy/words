                                "sense_id": "3a8fae96-086d-3353-a4fa-78795dc08e77",
                                "text": "BCD non compacté : (00000001 00000111 00001000 00001001)₂,"
                            },
                            {
                                "example_id": "292fdb3e-a3f9-44cd-8c44-ee5c4822eec5",
                                "sense_id": "3a8fae96-086d-3353-a4fa-78795dc08e77",
                                "text": "BCD compacté : (0001 0111 1000 1001)₂,"
                            },
                            {
                                "example_id": "5c5e74fe-f7b7-4548-85d9-6c1e40f43cb8",
                                "sense_id": "3a8fae96-086d-3353-a4fa-78795dc08e77",
                                "text": "EBCDIC : (11110001 11110111 11111000 11111001)₂, etc."
                            }
                        ]
                    }
