                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc65593-6603-483c-a06c-103fc9614341",
                                                "sense_id": "9f99aadd-4cde-34f2-9251-cb81274f37fa",
                                                "text": "Wie viel Asche hast du dabei?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8c8187ef-ee10-32c9-96ce-fe75568f16f4",
                                        "entry_id": "37797175-b627-39f8-81c3-b85fb35dd988",
                                        "glosses": [
