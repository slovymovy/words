                "senses": [
                    {
                        "sense_id": "78c046c2-9387-304a-aab5-fb4d4d073366",
                        "entry_id": "42585327-e9de-3acf-90ea-d4c9e9c36422",
                        "glosses": [
                            "Donner un caractère infidèle à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dbb5d33-baf4-42ce-9472-89f9cd119a3b",
                                "sense_id": "78c046c2-9387-304a-aab5-fb4d4d073366",
                                "text": "Cette intimité avec notre unique Époux, — à la Charles de Foucauld! — on veut l'infidéliser."
                            },
                            {
                                "example_id": "803a3286-63a0-4031-9891-ca4451889e3e",
                                "sense_id": "78c046c2-9387-304a-aab5-fb4d4d073366",
                                "text": "Je suis un mec extrêmement fidèle mais je ne me dérange pas pour infidéliser les autres demoiselles."
                            },
                            {
                                "example_id": "6534a3da-e11b-47d4-bdc2-c8cbf06c37ba",
                                "sense_id": "78c046c2-9387-304a-aab5-fb4d4d073366",
                                "text": "Ouais ben va infidéliser ailleurs que sur mon mec !"
                            }
                        ]
                    }
                ],
