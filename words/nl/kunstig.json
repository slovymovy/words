                    }
                },
                {
                    "sense_id": "d2a058e8-8913-3385-9a59-3522c3c08358",
                    "sense_definition": "Betrekking hebbend op kunst of getuigend van artistiek talent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "artistiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft een zeer <w>kunstige</w> aanleg en schildert prachtige landschappen.",
                            "target_lang_translations": {
                                "en": "She has a very <w>artistic</w> talent and paints beautiful landscapes.",
                                "ru": "У неё очень выдающиеся <w>художественные</w> способности, и она пишет прекрасные пейзажи."
                            }
                        },
                        {
                            "text": "Zijn <w>kunstige</w> prestaties werden door de hele familie bewonderd.",
                            "target_lang_translations": {
                                "en": "His <w>artistic</w> achievements were admired by the whole family.",
                                "ru": "Вся семья восхищалась его <w>творческими</w> достижениями."
                            }
                        }
                    ],
                    "synonyms": [
