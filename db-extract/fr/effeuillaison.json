                ],
                "senses": [
                    {
                        "sense_id": "262ec5d1-14f9-34f3-9ec8-24d74f63f715",
                        "entry_id": "f83d4dcc-68f6-3015-9c53-36e485eb0202",
                        "glosses": [
                            "Chute naturelle des feuilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8014b176-60b0-462a-934b-212ed69307b7",
                                "sense_id": "262ec5d1-14f9-34f3-9ec8-24d74f63f715",
                                "text": "Suivant Linné, le dixième mois de l'année (vieux style) est celui de l’effeuillaison. Il est vrai que l’effeuillaison commence assez communément, dans le climat de Paris avec le mois d'octobre (vieux style), on pourroit dire à bien peu de chose près avec l'année nouvelle en vendémiaire."
                            },
                            {
                                "example_id": "3e56e824-21bf-4817-a244-e77c1d41d290",
                                "sense_id": "262ec5d1-14f9-34f3-9ec8-24d74f63f715",
                                "text": "L’EFFEUILLAISON, defoliatio, est la chute des feuilles, ordinairement annoncée par la floraison de la colchide. On ne la considère que dans les arbres et arbustes."
                            }
                        ]
                    },
                    {
                        "sense_id": "64c4c5ad-0b11-3e37-9350-96940a224ec0",
                        "entry_id": "f83d4dcc-68f6-3015-9c53-36e485eb0202",
                        "glosses": [
                            "Effeuillage, action d’effeuiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a33447e-b8e8-4d80-b820-bc90d572abf0",
                                "sense_id": "64c4c5ad-0b11-3e37-9350-96940a224ec0",
                                "text": "L’effeuillaison de la vigne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2033cb3-1f73-4c83-b02f-21e3ccb95290",
                        "source_entry_id": "f83d4dcc-68f6-3015-9c53-36e485eb0202",
                        "source_sense_description": "chute des feuilles",
                        "target_lang_word": "Blattfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blattfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                        "entry_id": "ea54dcd7-272d-3319-bb98-7e9e48e53e92",
                                        "glosses": [
                                            "der Abwurf der Blätter eines Gewächses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9868d65-129f-4133-9373-b8a28e286f27",
                                                "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                                "text": "„Denn sie können sich den Aufwand sparen, den grünen Blattfarbstoff (Chlorophyll) vor dem Blattfall abzubauen.“"
                                            },
                                            {
                                                "example_id": "d8353440-8d95-4c81-978b-1c68c0cc25fc",
                                                "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                                "text": "„Bei laubabwerfenden Pflanzen vollzieht sich der Blattfall nach der Bildung einer Abscissionszone im Blattstiel, typischerweise in der Nähe des Knotens.“"
                                            },
                                            {
                                                "example_id": "46c8d57c-4bad-4a03-9579-afb7eb0f29e0",
                                                "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                                "text": "„Hier kommt es zu einer Anreicherung dieser Säure und damit zum Blattfall und Schließung der Stomata (Spaltöffnungen).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5be73dd-7f5f-4971-b747-eafaecd2791f",
                        "source_entry_id": "f83d4dcc-68f6-3015-9c53-36e485eb0202",
