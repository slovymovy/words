                        "glosses": [
                            "A set of bangles traditionally worn by a bride on her wedding day and for some time after, especially in Punjab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315e18c0-b6c1-4f94-8ee7-ef60f96a6ad8",
                                "sense_id": "54e13441-28cf-3c38-bcb1-4f3047e84a97",
                                "text": "After a bath, the bride takes part in the choora ceremony. The maternal uncle gifts the bride chooras (traditional red and white bangles by which the newly-wed girl will be identified for as long as she wears them), and with it a natbh or nose-ring, a small gutka or prayer book, token money and mitbai. The usual number is eleven on each wrist."
                            }
                        ]
                    }
