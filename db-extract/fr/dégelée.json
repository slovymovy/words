                "senses": [
                    {
                        "sense_id": "e0ddc6db-7acc-3aef-a41b-e6729a6bc84e",
                        "entry_id": "aa7f1d4e-f39e-3969-b56b-a48ce321e4eb",
                        "glosses": [
                            "Volée de coups, raclée, trempe."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "03226ec2-861a-4389-bd38-77feec1c99f5",
                                "sense_id": "e0ddc6db-7acc-3aef-a41b-e6729a6bc84e",
                                "text": "Reconnu et signalé, j’avais été porté en avant. C’était beaucoup d’honneur, mais quelle dégelée ! Rien n’y a manqué : coups de bottes dans les reins, coups de pommeau de sabre dans les côtes… et allez donc, l’insurgé !"
                            },
                            {
                                "example_id": "d8ba03d1-408d-4d15-99c2-ef93f535e398",
                                "sense_id": "e0ddc6db-7acc-3aef-a41b-e6729a6bc84e",
                                "text": "Les Camelots de l’i grec te vous les coincent savamment, comme à la chasse à courre, leur collent une sévère dégelée devant les ferronneries obstinément closes et balancent les paquets de journaux à l’égout, à moins qu’ils n’allument un feu de joie."
                            },
                            {
                                "example_id": "63fb84a9-f73f-4ed4-944d-f6e70b560e02",
                                "sense_id": "e0ddc6db-7acc-3aef-a41b-e6729a6bc84e",
                                "text": "Pour sûr! On s'est pris une sacrée dégelée ! J'ai dû rester au lit tout l'hiver!"
                            },
                            {
                                "example_id": "4feba3e8-b86a-4ae0-9d1e-4c517063bc36",
                                "sense_id": "e0ddc6db-7acc-3aef-a41b-e6729a6bc84e",
                                "text": "Je ressemblais à un de ces boxeurs déchus et pitoyables qui ne savent plus sur quelle planète ils vivent, après avoir reçu une dégelée et compté jusqu’à dix."
                            },
                            {
                                "example_id": "c3f95709-f6ce-4fb4-9424-af89d528b8a0",
                                "sense_id": "e0ddc6db-7acc-3aef-a41b-e6729a6bc84e",
                                "text": "Ils se sont mis une bonne dégelée dès le début de la partie, l'arbitre a sorti deux joueurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8fb36c6-37d8-31bd-aeb6-2c59e6579a75",
                        "entry_id": "aa7f1d4e-f39e-3969-b56b-a48ce321e4eb",
                        "glosses": [
                            "Échec."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0d423dfb-01ab-44b9-ba21-2ca4064936ee",
                                "sense_id": "b8fb36c6-37d8-31bd-aeb6-2c59e6579a75",
                                "text": "Les Français ne le savent pas encore, protégés des soubresauts des marchés financiers par la planche à billets de la Banque centrale européenne (BCE) et par les déficits budgétaires français, mais le krach est là. Wall Street connaît une sérieuse dégelée et a vécu du 18 au 21 janvier sa pire semaine depuis le début de la pandémie."
                            },
                            {
                                "example_id": "f87805e7-da5a-470a-9299-1e0f867fd69f",
                                "sense_id": "b8fb36c6-37d8-31bd-aeb6-2c59e6579a75",
                                "text": "C’est de plus en plus clair que les démocrates se dirigent vers une solide dégelée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f469f234-8df6-4158-93ae-210fddef571f",
                        "source_entry_id": "aa7f1d4e-f39e-3969-b56b-a48ce321e4eb",
                        "target_lang_word": "Prügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65908046-ca71-3c7f-b8d2-97380ded8dae",
                                        "entry_id": "e021d34f-daa1-3455-b0e9-5dde17aa2bd5",
                                        "glosses": [
                                            "Schläge, die im Zuge einer körperlichen Auseinandersetzung ausgeteilt werden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101c18ee-40b2-42c9-9483-5e9ac5496725",
                                                "sense_id": "65908046-ca71-3c7f-b8d2-97380ded8dae",
                                                "text": "Aber den Arthur hat er jetzt erwischt, und er hat alle Prügel gekriegt."
                                            },
                                            {
                                                "example_id": "ff95f9b6-46c2-44b1-a930-d2669c3135bd",
                                                "sense_id": "65908046-ca71-3c7f-b8d2-97380ded8dae",
                                                "text": "»Zuerst habe ich geweint«, sagt Eren, »danach habe ich mich an die Prügel gewöhnt.«"
                                            },
                                            {
                                                "example_id": "d195118c-c44e-4edb-b09d-96c8dd35d2a0",
                                                "sense_id": "65908046-ca71-3c7f-b8d2-97380ded8dae",
                                                "text": "Sexueller Missbrauch, Gewaltanwendung in der Erziehung – von der „g'sunden Watschen“ bis zur Tracht Prügel, Gewalt im familiären Rahmen und schließlich ist auch Vernachlässigung eine Form von Gewalt."
                                            },
                                            {
                                                "example_id": "c7c6f094-0c04-4286-a5bf-9c02ce394df8",
                                                "sense_id": "65908046-ca71-3c7f-b8d2-97380ded8dae",
                                                "text": "Nun bezieht die Polizei für ihre Prügel selbst Prügel, die sie eigentlich nicht verdient."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Prügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0f7e62f-c1bf-3c65-a706-b988c4bdeb5a",
                                        "entry_id": "7df21461-9526-370c-9355-485fda5c383d",
                                        "glosses": [
                                            "ein Stock, der besonders zum Schlagen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e70cdbc-61b4-4502-b9b9-42a8e78077ee",
                                                "sense_id": "e0f7e62f-c1bf-3c65-a706-b988c4bdeb5a",
                                                "text": "Wie ich da über die Stiege herauf bin, ist mir einer mit einem Prügel nachgelaufen und da bin ich geschwinde in den Ofen hineingschlupft und bin nimmer heraus."
                                            },
                                            {
                                                "example_id": "6d461606-76f0-4e18-acb2-ac8064523041",
                                                "sense_id": "e0f7e62f-c1bf-3c65-a706-b988c4bdeb5a",
                                                "text": "„Wir legen den Europäern keine Prügel in den Weg“, meint dazu Sudans Staatsminister El-Samani."
                                            },
                                            {
                                                "example_id": "2ac38c71-da2c-4269-9d2e-2697181e488a",
                                                "sense_id": "e0f7e62f-c1bf-3c65-a706-b988c4bdeb5a",
                                                "text": "Schafft's das Beispiel nicht, so schafft's auch der Prügel nicht."
                                            },
                                            {
                                                "example_id": "9b9b5452-d72f-4fac-85e3-d457591c800e",
                                                "sense_id": "e0f7e62f-c1bf-3c65-a706-b988c4bdeb5a",
                                                "text": "„Damit rief er den rechts und links stehenden Schergen zu, Folter und Prügel zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cadc27f7-c062-3bc4-9039-8b37b3924826",
                                        "entry_id": "7df21461-9526-370c-9355-485fda5c383d",
                                        "glosses": [
                                            "derber Ausdruck für einen Penis"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc84e95-3e3b-4b17-8f7d-328ee5d4b211",
                                                "sense_id": "cadc27f7-c062-3bc4-9039-8b37b3924826",
                                                "text": "Er nahm seinen Prügel in die Hand und befriedigte sich selbst."
                                            },
                                            {
                                                "example_id": "f8769901-8121-4bf3-ae68-0162d53e3147",
                                                "sense_id": "cadc27f7-c062-3bc4-9039-8b37b3924826",
                                                "text": "„Und genau das machte Tritt Balls Conner dann auch, und als er fertig war, zog er ihn raus und wischte seinen dreckigen Prügel an ihren blonden Haaren ab und spuckte ’n fetten Rotzklumpen mitten auf ihren Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c81cd07-1dbf-452c-8455-207e80b178f8",
