                                        "glosses": [
                                            "die Menge, die eine Person mit oder in einem Arm halten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2dfb895-e149-4b56-a351-151810cf6eef",
                                                "sense_id": "1d75bd81-84ee-386d-b13b-0d94178af869",
                                                "text": "Zwei Armvoll Heu für das Pferd sollten genügen."
                                            }
