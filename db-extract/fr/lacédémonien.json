                    },
                    {
                        "form_id": "3294729d-1063-4719-8486-4b346f16a977",
                        "entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "lacédémonienne"
                    },
                    {
                        "form_id": "3da80a83-36cc-453a-951c-865276fe842b",
                        "entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "lacédémoniennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96d5f57a-c9ff-32da-b6bb-5a496fbf2ed5",
                        "entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
                        "glosses": [
                            "Relatif à Lacédémone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd6dce2-b7a3-4823-bcd5-c3820c47202a",
                                "sense_id": "96d5f57a-c9ff-32da-b6bb-5a496fbf2ed5",
                                "text": "La brièveté lacédémonienne, dite laconisme, est devenue proverbiale."
                            },
                            {
                                "example_id": "214e499e-1de2-499b-b748-a62fd64f33a8",
                                "sense_id": "96d5f57a-c9ff-32da-b6bb-5a496fbf2ed5",
                                "text": "— Isabelle ! nom charmant et romanesque, dit Vallombreuse ; mais n’use pas de cette sobriété lacédémonienne. Sois prolixe et raconte-moi par le menu tout ce que tu sais de cette infante."
                            },
                            {
                                "example_id": "30bfdb83-e97c-4d14-b136-ac2d11aae83a",
                                "sense_id": "96d5f57a-c9ff-32da-b6bb-5a496fbf2ed5",
                                "text": "Quand on a été, comme moi, élevé à la dure par un père spartiate et une mère lacédémonienne, on se fiche un peu du confortable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a213a8b8-b52f-4198-b628-2dbbdda3d006",
                        "source_entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
                        "source_sense_id": "96d5f57a-c9ff-32da-b6bb-5a496fbf2ed5",
                        "target_lang_word": "Lacedaemonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lacedaemonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7b2ffb-4108-305a-bac8-5c7f3dc73b25",
                                        "entry_id": "3e28144e-4ece-3045-a9c7-25f35bf23a32",
                                        "glosses": [
                                            "Of or pertaining to Lacedaemonia (Laconia) in Greece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8344bb8a-2da2-3c54-a50c-e4790fd26732",
                                        "entry_id": "3e28144e-4ece-3045-a9c7-25f35bf23a32",
                                        "glosses": [
                                            "spartan"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Lacedaemonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                                        "entry_id": "6575874a-4cbf-3416-87e4-70f21d373d43",
                                        "glosses": [
                                            "An inhabitant of Lacedaemonia (Laconia) in Greece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d93031-87cc-44b8-9d40-90b561ca7831",
                                                "sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                                                "text": "[…] yet if in temperance, thriftines, & noble mind (exceeding all their vanities) he could come to reſtore the Lacedæmonians againe vnto equalitie: that then in deede he ſhould be counted a noble king."
                                            },
                                            {
                                                "example_id": "425f139c-d90b-493d-80c5-a49edfa0e3c4",
                                                "sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                                                "text": "For Kallikrates died out of the battle, he came to the army the most beautiful man of the Greeks of that day - not only of the Lacedæmonians themselves, but of the other Greeks also."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "7b765082-88ac-45a8-9a3f-98d5f2132b75",
                        "source_entry_id": "8aac34ba-694e-3897-85e9-69710885bea6",
