                    {
                        "sense_id": "a27dd81f-c9c5-336c-8a2b-f33dfeb1794b",
                        "entry_id": "4da7d308-72fb-3cfb-ab0d-dd9967884890",
                        "glosses": [
                            "The quality or state of being plastic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "166a066f-aa94-43e2-98f3-a29eb5983621",
                                "sense_id": "a27dd81f-c9c5-336c-8a2b-f33dfeb1794b",
                                "text": "In place of a stinger, a male bee or wasp has hardened genitalia […] used for grasping the female during mating and transferring sperm. Male genitalia are a showcase of structural plasticity."
                            }
                        ]
                    },
                    {
                        "sense_id": "84ba9bf4-1b0f-33da-bd74-07d335a630e2",
                        "entry_id": "4da7d308-72fb-3cfb-ab0d-dd9967884890",
                        "glosses": [
                            "The property of a solid body whereby it undergoes a permanent change in shape or size when subjected to a stress exceeding a particular value (the yield value)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
