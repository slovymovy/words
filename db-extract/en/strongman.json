                                        "glosses": [
                                            "jemand, der seine Mitmenschen unterdrückt oder terrorisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a28e562c-0226-4bee-9299-00f721d9e55b",
                                                "sense_id": "f78ed89c-dee0-3528-8be7-97d302132bfb",
                                                "text": "Als Kind war mein Bruder ein richtiger Tyrann."
                                            },
                                            {
                                                "example_id": "081881f2-3a0d-4026-ac09-88592e550953",
                                                "sense_id": "f78ed89c-dee0-3528-8be7-97d302132bfb",
                                                "text": "„Dieser alte Tyrann mochte es sogar, wenn Käthe ihm widersprach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "11b5d165-1a0c-3238-8962-24a3c5ba46c2",
                                        "entry_id": "a64a87d8-98c4-348c-b191-2522fc146530",
                                        "glosses": [
                                            "amerikanischer Sperlingsvogel (Unterordnung Tyranni)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7de936f7-a605-472a-9b4d-de2479ec5780",
                                                "sense_id": "11b5d165-1a0c-3238-8962-24a3c5ba46c2",
                                                "text": "Tyrannen verteidigen ihr Revier mit lautem Rufen und gewagten Flugmanövern."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
