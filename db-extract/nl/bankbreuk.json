                    {
                        "translation_id": "b09ab151-fd31-460f-b96e-f6102a459a50",
                        "source_entry_id": "af3fa3aa-39e8-37f7-b35d-3ee2ce4eb310",
                        "source_sense_id": "a1d10c0a-61dd-3f2a-92d2-41ddb562f3b0",
                        "target_lang_word": "Bankrott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bankrott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "759d8a29-2ef8-35d4-8c92-097aa0dbc1c2",
                                        "entry_id": "1e425803-287f-3bfd-93cd-068416312ed9",
                                        "glosses": [
                                            "Unfähigkeit, seinen Zahlungsverpflichtungen nachzukommen, finanzieller Zusammenbruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab6802d2-c15a-474d-b85e-98c6b34b4a2e",
                                                "sense_id": "759d8a29-2ef8-35d4-8c92-097aa0dbc1c2",
                                                "text": "Seine junge, anspruchsvolle Frau hat ihn in den Bankrott getrieben."
                                            },
                                            {
                                                "example_id": "039cbe02-dbf1-4171-bf74-0b7a6df18256",
                                                "sense_id": "759d8a29-2ef8-35d4-8c92-097aa0dbc1c2",
                                                "text": "„Nach Eröffnung des Insolvenzverfahrens hat der Insolvenzverwalter bis zu drei Monate Zeit, das vom Bankrott bedrohte Unternehmen gründlich unter die Lupe zu nehmen.“"
                                            },
                                            {
                                                "example_id": "5fdc45b2-f1ce-4265-88ab-304897d27e51",
                                                "sense_id": "759d8a29-2ef8-35d4-8c92-097aa0dbc1c2",
                                                "text": "„Es drängt ihn, diese Stadt zu verlassen, wo eine Masse arbeitsloser Künstler vegetiert, die Theater vor dem Bankrott stehen und der Brotpreis täglich steigt.“"
                                            },
                                            {
                                                "example_id": "7ca4c06b-4360-48c5-bfe4-076256174f6f",
                                                "sense_id": "759d8a29-2ef8-35d4-8c92-097aa0dbc1c2",
                                                "text": "„Ich war gut bei Kasse; aber wenn ich so weitermachte, näherte ich mich dem Bankrott.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8bd49d-21d0-43b2-8ba5-014d48fc7dd5",
                        "source_entry_id": "af3fa3aa-39e8-37f7-b35d-3ee2ce4eb310",
                        "source_sense_id": "a1d10c0a-61dd-3f2a-92d2-41ddb562f3b0",
