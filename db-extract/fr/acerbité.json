        "fr-extract.jsonl": [
            {
                "entry_id": "62a39d1e-24bc-31e3-b77e-6f516a38ad63",
                "word": "acerbité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb536c82-2611-4005-9179-10cc4972ca61",
                        "entry_id": "62a39d1e-24bc-31e3-b77e-6f516a38ad63",
                        "tags": [
                            "plural"
                        ],
                        "form": "acerbités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                        "entry_id": "62a39d1e-24bc-31e3-b77e-6f516a38ad63",
                        "glosses": [
                            "Qualité de ce qui est acerbe."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c19c09f7-ceb3-42d7-8924-ac3767b2907f",
                                "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                                "text": "Il semble même, par l'exemple des fruits des diospyros, du sorbier et du néflier, qu'on ne peut manger que blets, que plus l’acerbité a été grande, plus le fruit est susceptible de blessir régulièrement."
                            },
                            {
                                "example_id": "603ac923-67ca-4966-a8f1-3e0282930eb8",
                                "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                                "text": "Deux moyens en général détruisent l’acerbité : la décoction et l'altération spontanée. Le coin perd son acerbité par la décoction , ou du moins n'en conserve pas assez pour être désagréable ; […]."
                            },
                            {
                                "example_id": "06f3e24d-92c1-458a-a3c6-57db04b1581d",
                                "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                                "text": "L’acerbité de cette plaisanterie ne peut être comprise que de ceux qui se souviennent du déluge de gravures, de paravents, de pendules, de bronzes et de plâtres auxquels donna lieu l’idée du Soldat Laboureur, grande image du sort de Napoléon et de ses braves qui a fini par engendrer plusieurs vaudevilles."
                            },
                            {
                                "example_id": "a03b829a-f317-4c18-8697-673256a6667c",
                                "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                                "text": "Charles Estienne, en 1540, écrit que les fruits de cette espèce causent à la bouche, par leur acerbité et leur âpreté, une astriction pénible du gosier, à moins qu'on ne les mange très mûres."
                            },
                            {
                                "example_id": "e9a88990-5f33-4d97-b05b-cab87374c70b",
                                "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                                "text": "Je me demande même si le contrôle de la fermentation malolactique, en atténuant l’acerbité habituelle, n'a pas aidé nos vins à conquérir le palais de nos compagnes."
                            },
                            {
                                "example_id": "be45a190-f5ee-4b2a-8d83-69f064789872",
                                "sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                                "text": "… et il porte parfois sur l'institution un regard pertinent, que l'on aurait tort de disqualifier du seul fait de son acerbité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6530f4df-d506-4124-967c-b42e62340c53",
                        "source_entry_id": "62a39d1e-24bc-31e3-b77e-6f516a38ad63",
                        "source_sense_id": "63a06d14-631a-30c0-af3a-c05f2187360e",
                        "target_lang_word": "acerbity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acerbity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc53eada-3da9-3dab-9758-1271c5578a09",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Sourness of taste, with bitterness and astringency, like that of unripe fruit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Harshness, bitterness, or severity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92e51c8-e32f-4df8-9733-9207d224593f",
                                                "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                                "text": "acerbity of temper, of language, of pain"
                                            },
                                            {
                                                "example_id": "a53e5f6d-9f0a-40d9-b5c6-2678de8ba287",
                                                "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                                "text": "“Well ?” I repeated with some acerbity. I had been wondering for the last ten minutes how many more knots he would manage to make in that same bit of string before he actually started undoing them again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Something harsh (e.g. a remark, act or experience)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0d67dd-2320-4e22-b4ac-c27d88597ce9",
                                                "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                                "text": "[…] the recollection of that yesterday […] made him bear with the meekness and patience of a true-hearted man all the worrying little acerbities of to-day;"
                                            },
                                            {
                                                "example_id": "57c4facd-f6c2-4413-9f39-c712c701f6aa",
                                                "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                                "text": "This opera was mainly in the style of late Puccini, with acerbities stolen from Stravinsky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
