                        "examples": [
                            {
                                "example_id": "1481f6ed-1847-45a7-91d6-76bdd4a45322",
                                "sense_id": "721ede28-1211-3bb8-9f64-c9e01bf72ba5",
                                "text": "I remember going to the pictures at the local flea pit and seeing Riders of Death Valley, a serial in which I avidly #followed the fortunes of my hero Jim . . ."
                            },
                            {
                                "example_id": "1ae91651-0ac7-4082-8e71-7149e78829f1",
                                "sense_id": "721ede28-1211-3bb8-9f64-c9e01bf72ba5",
                                "text": "In America, where classics like Monopoly dominate, Eurogames still have an avidly geeky following."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a7764f2-9a46-4161-a1d5-adad084d992c",
