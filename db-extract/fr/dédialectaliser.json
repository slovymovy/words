                ],
                "senses": [
                    {
                        "sense_id": "4abe888c-9c57-36c7-8862-5caaeb01631a",
                        "entry_id": "293c3857-2e31-3abf-b854-336f2de7a7aa",
                        "glosses": [
                            "Faire perdre son caractère dialectal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12c8792-e483-457b-ba89-81dac10be17d",
                                "sense_id": "4abe888c-9c57-36c7-8862-5caaeb01631a",
                                "text": "En quelques cas il semble que la correction vise à dédialectaliser le lexique français du Catholicon."
                            },
                            {
                                "example_id": "53407c69-d895-4d18-94d8-dfbb39b17f08",
                                "sense_id": "4abe888c-9c57-36c7-8862-5caaeb01631a",
                                "text": "Il est cependant plus probable, au vu des traces qu’en garde l’acadien, que le dialecte constituait leur usage linguistique premier et spontané, en même temps qu’ils connaissaient le français, et que leur émigration vers le Nouveau Monde les a conduits à dédialectaliser rapidement et quasi systématiquement leur usage linguistique."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa7953c7-f09c-3bf9-885a-fda0c2113258",
                        "entry_id": "293c3857-2e31-3abf-b854-336f2de7a7aa",
                        "glosses": [
                            "Perdre son caractère dialectal."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "f8f89542-ee4e-4a0a-9b2a-fee4fc30f366",
                                "sense_id": "fa7953c7-f09c-3bf9-885a-fda0c2113258",
                                "text": "Il peut se dialectaliser, se dédialectaliser ou se redialectaliser... au fil du temps, des modes et des interprètes."
                            },
                            {
                                "example_id": "008bead1-3e5e-4e30-8aea-5b3b267742bd",
                                "sense_id": "fa7953c7-f09c-3bf9-885a-fda0c2113258",
                                "text": "La prononciation québécoise s’est dédialectalisée très vite."
                            }
                        ]
                    }
                ],
