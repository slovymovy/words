                ],
                "senses": [
                    {
                        "sense_id": "c28767b4-bc48-35a4-bd57-ef4ed02a19cf",
                        "entry_id": "b8728535-984a-3ba4-b9a5-b71b4dc6507e",
                        "glosses": [
                            "изготовленный долблением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea4797fb-e482-4e9d-8fd7-43e5b704af84",
                                "sense_id": "c28767b4-bc48-35a4-bd57-ef4ed02a19cf",
                                "text": "На берегу множество лежит долблёных лодок, которые отгоняют к Макарью."
                            },
                            {
                                "example_id": "4dd4178c-4eed-4cf2-bb3d-939ab755b4a9",
                                "sense_id": "c28767b4-bc48-35a4-bd57-ef4ed02a19cf",
                                "text": "Стар уж я человек, а все-таки встосковались косточки по родимой землице, хочется им лечь на своем погосте возле родителей, хочется схорониться во гробу, что из нашей сосны долблён."
                            },
                            {
                                "example_id": "704ebae7-2e1b-488c-aec3-9cad1581bf98",
                                "sense_id": "c28767b4-bc48-35a4-bd57-ef4ed02a19cf",
                                "text": "Промеж ульев долблёных двинулся Лукич, тихонько губами вылинявшими беззвучно зашамкал, стал поодаль от гостей, наблюдая искоса."
                            }
                        ]
                    }
