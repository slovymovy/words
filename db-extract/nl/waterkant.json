                                "target_senses": [
                                    {
                                        "sense_id": "3bb8cb95-8819-3c16-9da4-d88620016382",
                                        "entry_id": "ded1ab2d-6ec6-30f8-ad97-d03f60479aaa",
                                        "glosses": [
                                            "The land bordering a body of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "waterside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfee53b6-1e2a-306c-aca0-e613eaf23f08",
                                        "entry_id": "2ed6a6c9-9e9e-3d13-97c9-5eac13e28255",
                                        "glosses": [
                                            "Of, pertaining to, or situated on a waterside."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755434d5-72c8-4cc8-b082-c7088a5d3d28",
                                                "sense_id": "cfee53b6-1e2a-306c-aca0-e613eaf23f08",
                                                "text": "Nearer the coast, the land becomes markedly more marshy, with long, winding channels striking inland from the sea, making access to some of the waterside villages rather difficult."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dea5758c-a65e-43e0-a9c4-20cb440adef0",
                        "source_entry_id": "aaa70a6a-52b0-39a9-b39a-58bb16515424",
                        "source_sense_id": "4a582963-e27e-3937-ab18-3c00d8b57540",
                        "source_sense_description": "daar waar land ophoudt en een water, zoals beek, rivier, meer of kanaal begint",
                        "target_lang_word": "berge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf58d18-3ff2-3232-8a53-8dfdc6457429",
                                        "entry_id": "e0d30aa9-fff1-3de6-b5d0-46252edb8230",
                                        "glosses": [
                                            "Talus naturel, bord élevé d’un cours d’eau, d’un canal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fe01354-e3d8-4242-90b5-50d636925046",
                                                "sense_id": "9bf58d18-3ff2-3232-8a53-8dfdc6457429",
                                                "text": "Il nous a fallu d’abord attendre plusieurs heures sur la berge vaseuse, sous un soleil de plomb."
                                            },
                                            {
                                                "example_id": "43ea3869-d435-4ec6-891b-14f4bbc9cf39",
                                                "sense_id": "9bf58d18-3ff2-3232-8a53-8dfdc6457429",
                                                "text": "Cette sédimentation organique, jointe aux apports de terre provenant de l’écroulement des berges sous les pieds des bestiaux, amène un asséchement progressif des noues."
                                            },
                                            {
                                                "example_id": "24f04ee4-c095-4d44-b558-1be149f7b199",
                                                "sense_id": "9bf58d18-3ff2-3232-8a53-8dfdc6457429",
                                                "text": "Le long des lisières stables, comme les berges des fleuves ou les pentes très fortes, on observe tout un ensemble de plantes particulier et très diversifié comptant aussi bien des lianes et des épiphytes, des arbustes ou des herbes terrestres."
                                            },
                                            {
                                                "example_id": "30b78a53-2d1c-426c-96a0-649ab3f1a8a6",
                                                "sense_id": "9bf58d18-3ff2-3232-8a53-8dfdc6457429",
                                                "text": "Discussion technique sur la confusion fréquente entre rive et berge : la berge est le talus incliné en contact direct avec la rivière ; la rive est la bande de terre qui commence au faîte de la berge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db11bf89-4e5f-32ed-87b2-2490e96f04b4",
                                        "entry_id": "e0d30aa9-fff1-3de6-b5d0-46252edb8230",
                                        "glosses": [
                                            "Route ou chemin aménagé sur un tel talus (on dit aussi berme)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bf82a32-f0ae-3437-b1a9-23b68777aa75",
                                        "entry_id": "e0d30aa9-fff1-3de6-b5d0-46252edb8230",
                                        "glosses": [
                                            "Talus bordant une route."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f085525-1daf-34de-ac1e-9354f9f1b55d",
                                        "entry_id": "e0d30aa9-fff1-3de6-b5d0-46252edb8230",
                                        "glosses": [
                                            "Certains rochers élevés à pic sur l'eau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "berge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "867302d7-1203-3956-a508-7f2d75b23514",
                                        "entry_id": "359cad38-335b-32d6-bbc2-99508bbf1b65",
                                        "glosses": [
                                            "Année."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "1431d219-f418-472b-aa3b-d33ea39b687d",
                                                "sense_id": "867302d7-1203-3956-a508-7f2d75b23514",
                                                "text": "— J’viens d’décarrer, Dussèche. J'ai tiré dix berges pour avoir refroidi ma belledoche."
                                            },
                                            {
                                                "example_id": "9cd7d1e7-f8fd-4279-a2ab-d907e281ac8a",
                                                "sense_id": "867302d7-1203-3956-a508-7f2d75b23514",
                                                "text": "Même quarante berges après que tu es parti brailler la Chanson de Craonne sur le Chemin de Saint-Pierre, on se demande toujours comment t’as survécu à tout ça, le Vieux."
                                            },
                                            {
                                                "example_id": "a885c274-6078-414d-b435-b31ccf93c530",
                                                "sense_id": "867302d7-1203-3956-a508-7f2d75b23514",
                                                "text": "Je suis entré à vingt berges et j’ai trente-huit ans de pénitentiaire dans le rétro… J’étais déjà là à l’époque de Buffet et de Bontems, vous imaginez…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
