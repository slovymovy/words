                        "examples": [
                            {
                                "example_id": "a91186f1-4119-4fc9-a2a8-d0b6144dc108",
                                "sense_id": "c27a3f61-a712-3e10-a637-47ed0520a50d",
                                "text": "Ce résinage ne s’opère encore que sur les arbres qu’il est nécessaire d’abattre pour l’aménagement progressif du pignadar qui exige des éclaircies continues jusqu’à l’âge de trente à quarante ans."
                            },
                            {
                                "example_id": "20e2d2ec-5bb4-48bf-b26d-5fdcbd562efe",
                                "sense_id": "c27a3f61-a712-3e10-a637-47ed0520a50d",
                                "text": "Un soir, comme il revenait à Dax par la route de Magescq, en compagnie de deux résiniers, il entra dans un petit pignadar où il s’était rendu acquéreur de sept pins."
                            },
                            {
                                "example_id": "7f72acba-27eb-4fd8-8587-617363ebb4aa",
                                "sense_id": "c27a3f61-a712-3e10-a637-47ed0520a50d",
                                "text": "Défigurant le paysage,\nUn plan de pignadar s'abat."
                            }
                        ]
