                        "glosses": [
                            "Any of very many small crustaceans of the subclass Copepoda; they are widely distributed and ecologically important."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "290ad1c9-6a81-4f68-a413-54724c4311f8",
                                "sense_id": "5a9c4ad5-b687-3e7c-8da5-a432e4881dd2",
                                "text": "To eat, the whale takes a wide-open gulp of water and closes its jaws to a slit so that as it pushes its tongue forwards and upwards, water is forced through the baleen while the copepods, krill and other animals it likes to eat remain in its mouth."
                            }
                        ]
                    }
