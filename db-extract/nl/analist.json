                        ],
                        "form": "analistje"
                    },
                    {
                        "form_id": "a4f618c9-5c55-458e-9119-58731cb5a349",
                        "entry_id": "d2115bd2-b316-3dbf-991a-c90deebdddc9",
                        "tags": [
                            "diminutive",
