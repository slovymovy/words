    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9115f91-daa4-325f-98e7-0dab97bbbadb",
                    "sense_definition": "in een gelijke hoeveelheid of aantal",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kwantiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb dit jaar <w>evenveel</w> geld verdiend als vorig jaar.",
                            "target_lang_translations": {
                                "en": "I earned <w>as much</w> money this year as last year.",
                                "ru": "В этом году я заработал <w>столько же</w> денег, сколько и в прошлом."
                            }
                        },
                        {
                            "text": "In dit recept moet je <w>evenveel</w> suiker als boter gebruiken.",
                            "target_lang_translations": {
                                "en": "In this recipe, you should use <w>the same amount</w> of sugar as butter.",
                                "ru": "В этом рецепте нужно использовать <w>одинаковое количество</w> сахара и масла."
                            }
                        }
                    ],
                    "synonyms": [
                        "evenzoveel",
                        "net zoveel"
                    ],
                    "common_phrases": [
                        "evenveel als",
                        "ongeveer evenveel"
                    ],
                    "target_lang_definitions": {
                        "en": "in an equal amount or number",
                        "ru": "в равном количестве или числе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as much",
                                "target_lang_sense_clarification": "for uncountable quantities"
                            },
                            {
                                "target_lang_word": "as many",
                                "target_lang_sense_clarification": "for countable numbers"
                            },
                            {
                                "target_lang_word": "the same amount",
                                "target_lang_sense_clarification": "general equality of quantity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "столько же",
                                "target_lang_sense_clarification": "равное количество"
                            },
                            {
                                "target_lang_word": "одинаковое количество",
                                "target_lang_sense_clarification": "такой же объем или число"
                            },
                            {
                                "target_lang_word": "поровну",
                                "target_lang_sense_clarification": "в равных долях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "eb050dd5-99bd-3f38-b140-0d3b1846709f",
                    "sense_definition": "een gelijk aantal of een gelijke hoeveelheid aanduidend",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kwantiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn <w>evenveel</w> jongens als meisjes in de klas.",
                            "target_lang_translations": {
                                "en": "There are <w>as many</w> boys as girls in the class.",
                                "ru": "В классе <w>столько же</w> мальчиков, сколько и девочек."
                            }
                        },
                        {
                            "text": "We hebben <w>evenveel</w> kansen om te winnen als zij.",
                            "target_lang_translations": {
                                "en": "We have <w>equal</w> chances of winning as they do.",
                                "ru": "У нас <w>столько же</w> шансов на победу, сколько и у них."
                            }
                        }
                    ],
                    "synonyms": [
                        "evenzoveel",
                        "net zoveel"
                    ],
                    "common_phrases": [
                        "evenveel tijd",
                        "evenveel mensen"
                    ],
                    "target_lang_definitions": {
                        "en": "indicating an equal number or an equal amount",
                        "ru": "указывает на равное число или равное количество"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as many",
                                "target_lang_sense_clarification": "referring to a count of items"
                            },
                            {
                                "target_lang_word": "as much",
                                "target_lang_sense_clarification": "referring to a volume or degree"
                            },
                            {
                                "target_lang_word": "equal",
                                "target_lang_sense_clarification": "having the same quantity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "столько же",
                                "target_lang_sense_clarification": "такое же число предметов или объем"
                            },
                            {
                                "target_lang_word": "одинаково",
                                "target_lang_sense_clarification": "в равной степени или количестве"
                            },
                            {
                                "target_lang_word": "равное количество",
                                "target_lang_sense_clarification": "одинаковое число"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "22c80627-165c-344e-9efe-acff9be56d04",
                    "sense_definition": "een gelijke hoeveelheid of een gelijk aantal personen of zaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kwantiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kregen drie appels en wij kregen er <w>evenveel</w>.",
                            "target_lang_translations": {
                                "en": "They got three apples and we got <w>the same number</w>.",
                                "ru": "Они получили три яблока, и мы получили <w>столько же</w>."
                            }
                        },
                        {
                            "text": "Hoewel de groepen verschilden, waren er <w>evenveel</w> die voor stemden.",
                            "target_lang_translations": {
                                "en": "Although the groups differed, there were <w>just as many</w> who voted in favor.",
                                "ru": "Хотя группы различались, проголосовавших «за» было <w>столько же</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "evenzoveel",
                        "net zoveel"
                    ],
                    "common_phrases": [
                        "net evenveel"
                    ],
                    "target_lang_definitions": {
                        "en": "an equal amount or an equal number of people or things",
                        "ru": "равное количество или равное число людей или вещей"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the same number",
                                "target_lang_sense_clarification": "referring to people or countable objects"
                            },
                            {
                                "target_lang_word": "just as many",
                                "target_lang_sense_clarification": "emphasizing equality in count"
                            },
                            {
                                "target_lang_word": "the same amount",
                                "target_lang_sense_clarification": "referring to an unspecified quantity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "столько же",
                                "target_lang_sense_clarification": "такое же количество (заменяет существительное)"
                            },
                            {
                                "target_lang_word": "такое же количество",
                                "target_lang_sense_clarification": "равное число людей или предметов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "689a7677-45bb-3825-94a5-bfc7b018b9b2",
                    "sense_definition": "van gelijke betekenis of op hetzelfde neerkomend",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gelijkwaardigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn zwijgen betekende in deze context <w>evenveel</w> als een bekentenis.",
                            "target_lang_translations": {
                                "en": "In this context, his silence meant <w>just as much</w> as a confession.",
                                "ru": "Его молчание в этом контексте значило <w>столько же</w>, сколько и признание."
                            }
                        },
                        {
                            "text": "Het maakt <w>evenveel</w> uit of we nu gaan of over een uur.",
                            "target_lang_translations": {
                                "en": "It matters <w>the same</w> whether we go now or in an hour.",
                                "ru": "Безразлично (<w>одно и то же</w>), пойдем ли мы сейчас или через час."
                            }
                        }
                    ],
                    "common_phrases": [
                        "evenveel betekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "of equal significance or amounting to the same thing",
                        "ru": "имеющий равное значение или означающий то же самое"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just as much",
                                "target_lang_sense_clarification": "having equal importance or effect"
                            },
                            {
                                "target_lang_word": "the same",
                                "target_lang_sense_clarification": "equivalent in meaning"
                            },
                            {
                                "target_lang_word": "tantamount to",
                                "target_lang_sense_clarification": "equivalent in seriousness to"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "столько же",
                                "target_lang_sense_clarification": "в значении 'так же много'"
                            },
                            {
                                "target_lang_word": "равносильно",
                                "target_lang_sense_clarification": "означает то же самое"
                            },
                            {
                                "target_lang_word": "одно и то же",
                                "target_lang_sense_clarification": "не имеет значения, какой вариант выбрать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}