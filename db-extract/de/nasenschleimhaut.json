                ],
                "senses": [
                    {
                        "sense_id": "2f411c3a-a7e8-3dc7-844e-1e32b00ff1cc",
                        "entry_id": "2aafb413-79ad-30c2-a6e5-9a6d35be646a",
                        "glosses": [
                            "Muqueuse nasale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95395466-6348-4a91-9659-d0c7e81ceed5",
                                "sense_id": "2f411c3a-a7e8-3dc7-844e-1e32b00ff1cc",
                                "text": "Der MNS kann verhindern, dass größere Speicheltropfen eines Infizierten auf der Mund- und Nasenschleimhaut des Trägers landen."
                            },
                            {
                                "example_id": "332a12fa-357e-458b-83d9-409e46b66f4d",
                                "sense_id": "2f411c3a-a7e8-3dc7-844e-1e32b00ff1cc",
                                "text": "Der MNS kann verhindern, dass größere Speicheltropfen eines Infizierten auf der Mund- und Nasenschleimhaut des Trägers landen.",
                                "translation": "La masque de protection peut empêcher que de grosses gouttes de salive d’une personne infectée ne se déposent sur la muqueuse buccale et nasale du porteur."
                            },
                            {
                                "example_id": "771c711c-2127-4bfb-b36e-f70ee7eedb49",
                                "sense_id": "2f411c3a-a7e8-3dc7-844e-1e32b00ff1cc",
                                "text": "Die Nasenschleimhaut übernimmt viele wichtige Funktionen. Sie erwärmt die Atemluft auf körpergerechte 32 bis 34 Grad Celsius.",
                                "translation": "La muqueuse nasale assume de nombreuses fonctions importantes. Elle réchauffe l’air que nous respirons à une température de 32 à 34 degrés Celsius, adaptée à notre corps."
                            }
                        ]
                    }
                ],
