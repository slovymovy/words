                ],
                "senses": [
                    {
                        "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                        "entry_id": "561570d1-56f8-3478-9400-38eb83d7817e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf23e4a-211f-43c6-b289-c6ffb186924d",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Frau Breier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6073e3f4-39f9-4bd6-b1bf-00c3319763cc",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Herr Breier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c34c73be-a6cc-405d-a9b6-73daf9d4f6cd",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Die Breiers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f828f7ec-5a38-4843-8dc0-a3d98694e560",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Der Breier trägt nie die Schals, die die Breier ihm strickt."
                            },
                            {
                                "example_id": "4512e25c-710f-4bee-ae65-34e7c57010e4",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breier kommt, geht der Herr Breier.“"
                            },
                            {
                                "example_id": "8c894398-73d4-4469-aa88-34a22553d7fb",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Breier kommt und geht."
                            },
                            {
                                "example_id": "86ec960d-4384-40dc-8225-16beb402ca46",
                                "sense_id": "20634352-8ae6-3cad-bce8-d2728a83ef3f",
                                "text": "Breiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
