                        "examples": [
                            {
                                "example_id": "9679e860-7a6d-42bc-9ee1-544973005632",
                                "sense_id": "5bfaf1fb-e9fb-3c15-a092-1f39c71b60d1",
                                "text": "Der Prozeß von Arras läßt die ganze Bandbreite menschlicher Infernalität aufleuchten."
                            },
                            {
                                "example_id": "00b7495a-8245-4c43-8145-6f8c4f6548f4",
                                "sense_id": "5bfaf1fb-e9fb-3c15-a092-1f39c71b60d1",
                                "text": "Das Glück der Selbstbegegnung wäre angesichts der Infernalität der Materialschlachten zu poetischem Hohn verkommen."
                            },
                            {
                                "example_id": "fef76299-bd10-41cd-9557-59774db229f2",
                                "sense_id": "5bfaf1fb-e9fb-3c15-a092-1f39c71b60d1",
                                "text": "Infernalität ist: Entstellung der Wahrheit, feindlicher Doppelsinn, geheimes Manövriren, versteckte Drohung, Furcht erweckende Undeutbarkeit, räthselhafte Verkündigung des Unglücks."
                            }
                        ],
