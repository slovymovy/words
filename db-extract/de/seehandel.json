                "senses": [
                    {
                        "sense_id": "11085071-e10a-3238-bc5a-5db587d9d17f",
                        "entry_id": "12084317-3cad-35e6-a99f-78b1f13c2267",
                        "glosses": [
                            "über den Seeweg abgewickelter Kauf und Verkauf von Waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48a96b5-7945-4b13-8817-5ef05566b20d",
                                "sense_id": "11085071-e10a-3238-bc5a-5db587d9d17f",
                                "text": "Seit der frühen Neuzeit betreiben niederländische Kaufleute einen schwunghaften Seehandel."
                            },
                            {
                                "example_id": "4c0c3525-7193-4182-96ea-7f29c297299d",
                                "sense_id": "11085071-e10a-3238-bc5a-5db587d9d17f",
                                "text": "„Die von Mahmud in Nordindien geraubten Schätze erreichten zu einem großen Teil den Persischen Golf und belebten den internationalen Seehandel, der bis nach China reichte, wo sich unter der Song-Dynastie der Schwerpunkt des Reiches nach Süden verlagerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
