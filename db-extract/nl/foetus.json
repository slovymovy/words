                "senses": [
                    {
                        "sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                        "entry_id": "827ce8ac-3852-3bf6-98c0-7bd5c5e37ec5",
                        "glosses": [
                            "een nog niet voldragen menselijke of dierlijke vrucht dat in de baarmoeder verblijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f93f37a5-5852-4346-ab47-cf7ccb80bd7c",
                                "sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                                "text": "In de eerste fase heet het een embryo en in de tweede fase heet het een foetus."
                            },
                            {
                                "example_id": "aa9f8ff4-7859-49d5-a782-7652df46e964",
                                "sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                                "text": "Zijn dikke hoofd is als het ware in de modder vastgezogen en zijn ledematen liggen alle kanten op. Vlak naast hem ziet Albert de ander liggen, Louis Thérieux. Ook hij zit voor een deel onder de modder, maar hij heeft zich opgerold en lijkt zo een beetje op een foetus. Het is aangrijpend dat hij zo jong en dan in die houding moest sterven..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0a5da49-5d5a-4013-8e13-de9774d20aca",
                        "source_entry_id": "827ce8ac-3852-3bf6-98c0-7bd5c5e37ec5",
                        "source_sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                        "source_sense_description": "een nog niet voldragen menselijke of dierlijke vrucht",
                        "target_lang_word": "Fetus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fetus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                        "entry_id": "2dd75a21-d580-3878-a916-630b5d553912",
                                        "glosses": [
                                            "das ungeborene Kind während der Schwangerschaft, nachdem es innere Organe gebildet hat (etwa nach dem dritten Monat einer Schwangerschaft)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b705a13-7edc-4322-8395-59b6aa1c2801",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "Bei einer Fehlgeburt stirbt der Fetus."
                                            },
                                            {
                                                "example_id": "314abd2b-39a6-4048-bd40-f6524f6c1276",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„In der Praxis wird die Diagnose oft gestellt, wenn beim Fetus pränatal Behinderungen diagnostiziert wurden.“"
                                            },
                                            {
                                                "example_id": "9613c2ae-d05f-4b6f-97fd-df6095779601",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Stresshormone beeinflussen unter anderem die Plazenta, stören dort den Blutfluss und somit die Versorgung des Fetus.“"
                                            },
                                            {
                                                "example_id": "edf622fd-7e2d-4670-93c3-44a2e3c79804",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Die Folgen für die Wachstumsvorgänge im Embryo und Fetus seien derzeit nicht abschätzbar.“"
                                            },
                                            {
                                                "example_id": "ea7b38f9-eb56-46fb-8875-630f6ee82f66",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Es gebe viel mehr Fragen als Antworten, beispielsweise wie genau die Übertragung des Virus in den Fetus erfolgt und warum sich das Virus gerade jetzt so rasch ausbreitet.“"
                                            },
                                            {
                                                "example_id": "1a4abd28-beb9-4ada-a644-97221a0b69fc",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Je näher der Geburtstermin rückt, desto wichtiger wird auch die Lagekontrolle des Feten […].“"
                                            },
                                            {
                                                "example_id": "0c427e15-8373-4d6b-a980-51c4f8f12195",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Eine aktuelle Studie zeigt allerdings, dass Reaktionen der Feten auf Lichtreize zu erfassen sind.“"
                                            },
                                            {
                                                "example_id": "ab7b7849-afa7-4b5d-90c3-eaa0e2c384b8",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Das gilt zum Beispiel häufig bei Schwangerschaft, weil Fetusse oft viel empfindlicher auf Medikamente reagieren als Erwachsene.“"
                                            },
                                            {
                                                "example_id": "6bd83659-1514-4726-85eb-09a26fed93c9",
                                                "sense_id": "1821a76b-fea7-3d55-b1e0-f2d4b873a88d",
                                                "text": "„Die mumifizierten und in mumienförmigen Miniatursarkophagen bestatteten Fetusse waren möglicherweise Kinder des jungen Pharaos und seiner Gemahlin Anchesenamun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a08078ca-18de-4957-abb1-bda0cb810dac",
                        "source_entry_id": "827ce8ac-3852-3bf6-98c0-7bd5c5e37ec5",
                        "source_sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                        "source_sense_description": "een nog niet voldragen menselijke of dierlijke vrucht",
                        "target_lang_word": "Fötus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fötus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a596f391-2339-3993-b51c-2893e3079876",
                                        "entry_id": "0fbb5473-2e90-301f-a52a-896fceda7996",
                                        "glosses": [
                                            "Embryo ab dem dritten Monat einer Schwangerschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bfd042-e3e0-48a3-9479-a66a67b52daa",
                                                "sense_id": "a596f391-2339-3993-b51c-2893e3079876",
                                                "text": "„Man glaubt allgemein, daß der Fötus ein unbeschwertes Dasein führe, doch gibt es Gründe, dies in Zweifel zu ziehen.“"
                                            },
                                            {
                                                "example_id": "963eb03c-3913-433d-bdb4-630632ad704f",
                                                "sense_id": "a596f391-2339-3993-b51c-2893e3079876",
                                                "text": "„Inzwischen behandle ich überwiegend Frauen, die sich ein Kind wünschen, die aber bei fortgeschrittener Schwangerschaft erfahren, dass der Fötus unter einer gravierenden Anomalie oder einem schweren Gendefekt leidet.“"
                                            },
                                            {
                                                "example_id": "393b5c4d-93c0-405e-b3d4-86682babee67",
                                                "sense_id": "a596f391-2339-3993-b51c-2893e3079876",
                                                "text": "„Der Autor behauptete, der Uterus sei zwar wirklich etwas Tierisches, er vermöge jedoch nichts über die Vernunft der Frau, weil die Anatomie noch nie den geringsten Verbindungsgang zwischen diesem Eingeweide, der Hülle des Fötus, und dem Gehirn entdeckt habe.“"
                                            },
                                            {
                                                "example_id": "faeb5b55-5327-46e9-ac2a-32cc5ae16c0a",
                                                "sense_id": "a596f391-2339-3993-b51c-2893e3079876",
                                                "text": "„Manche enthalten Skelette in jener Stellung, die der Fötus im Mutterleib einnimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b434481-2f2c-4dad-a563-7fbc698cc33a",
                        "source_entry_id": "827ce8ac-3852-3bf6-98c0-7bd5c5e37ec5",
                        "source_sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                        "source_sense_description": "een nog niet voldragen menselijke of dierlijke vrucht",
                        "target_lang_word": "fetus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fetus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa0938a-3def-34ff-ae91-bbbe03bcf106",
                                        "entry_id": "06dbe516-aebd-3b2b-8281-3807a9244869",
                                        "glosses": [
                                            "An unborn or unhatched vertebrate showing signs of the mature animal."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "also"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8ff129f-3080-4be6-9aa2-82e4019bec4b",
                                                "sense_id": "dfa0938a-3def-34ff-ae91-bbbe03bcf106",
                                                "text": "Several feti were removed from every rats' uterus, stripped of their membranes and allowed to lie in the peritoneal cavity connected to the placenta by the umbilical cord and with the placenta still attached to the uterine wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f32ff5-6daf-3ec0-9d5e-94b44d013d50",
                                        "entry_id": "06dbe516-aebd-3b2b-8281-3807a9244869",
                                        "glosses": [
                                            "A human embryo after the eighth week of gestation."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "also"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "814ef95c-2ef8-4148-a2a3-a3ab48b9d90f",
                                                "sense_id": "b2f32ff5-6daf-3ec0-9d5e-94b44d013d50",
                                                "text": "The sequence is: molecules in reproductive systems, then gametes, zygotes, morulas, blastocysts, and then fetuses."
                                            },
                                            {
                                                "example_id": "4332da95-ce80-416a-abbb-4bd2351cb094",
                                                "sense_id": "b2f32ff5-6daf-3ec0-9d5e-94b44d013d50",
                                                "text": "Though scientists do not know how stress affects gestation, Fukuda theorizes that the vulnerability of Y-bearing sperm cells, male embryos and/or male fetuses to stress is why “subtle significant changes in sex ratios” occur. […] The factors that filter out who “gets through” from conception to birth include chromosomal or genetic abnormalities of the fetus or the mother’s stress response to changes in her environment, Catalano said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "771a8717-a644-36a6-9271-93cf97767a0a",
                                        "entry_id": "06dbe516-aebd-3b2b-8281-3807a9244869",
                                        "glosses": [
                                            "A neonate."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "also",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b75509-f364-42ec-998b-c22899991ad7",
                                                "sense_id": "771a8717-a644-36a6-9271-93cf97767a0a",
                                                "text": "The real essence of that or any other sort of substances, it is evident, we know not; and therefore are so undetermined in our nominal essences, which we make ourselves, that, if several men were to be asked concerning some oddly-shaped fœtus, as soon as born, whether it were a man or no, it is past doubt one should meet with different answers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edbbf51d-49ca-4b5b-93c8-d881c28e1a28",
                        "source_entry_id": "827ce8ac-3852-3bf6-98c0-7bd5c5e37ec5",
                        "source_sense_id": "6cc09262-f0b4-3eb5-a5f5-84dbcb114d7f",
                        "source_sense_description": "een nog niet voldragen menselijke of dierlijke vrucht",
                        "target_lang_word": "fœtus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fœtus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3c90d3f-9f52-361f-9e5c-89a90e369765",
                                        "entry_id": "25350d5b-b0aa-3fdd-aa77-12dd1594a945",
                                        "glosses": [
                                            "Organisme en voie de développement, chez les animaux vivipares. Il a dépassé le stade d’embryon mais n’est pas encore né."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49d4675-474d-4c44-865b-37d4fca7c5fd",
                                                "sense_id": "b3c90d3f-9f52-361f-9e5c-89a90e369765",
                                                "text": "La face interne de l'amnios est libre, lisse, semblable à la face interne des séreuses ; c'est elle qui sécrète probablement les eaux de l’amnios, qui remplissent la poche que forme cette membrane et dans lesquelles nage le fœtus."
                                            },
                                            {
                                                "example_id": "696e6528-a646-44e1-bf39-beecb4eebb83",
                                                "sense_id": "b3c90d3f-9f52-361f-9e5c-89a90e369765",
                                                "text": "Ces principes posés, on peut sans s’éloigner de la vérité, considérer la formation du fœtus comme le résultat de deux forces émanées de chaque générateur."
                                            },
                                            {
                                                "example_id": "002ec745-3a81-4802-86f8-9e5250ba90b7",
                                                "sense_id": "b3c90d3f-9f52-361f-9e5c-89a90e369765",
                                                "text": "Fantasme du retour au sein maternel : nostalgie de l’état nirvanesque qui fut celui du fœtus dans le corps maternel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
