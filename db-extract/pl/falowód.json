                        "examples": [
                            {
                                "example_id": "c8123b59-9573-4b47-a155-0e079838bb3b",
                                "sense_id": "a40ba6cd-c7dd-3c34-bed0-15218a626be0",
                                "text": "Każdy z falowodów stanowi wiersz elementów promieniujących i jest pobudzany za pośrednictwem bardzo precyzyjnego przesuwnika fazy, dzięki czemu uzyskuje się elektroniczne sterowanie wiązką w płaszczyźnie elewacji.",
                                "translation": "Each waveguide constitutes a row of radiating elements and is excited via a high-precision phase shifter, providing electronic beam steering in the elevation plane.",
                                "english": "Each waveguide constitutes a row of radiating elements and is excited via a high-precision phase shifter, providing electronic beam steering in the elevation plane."
                            }
                        ]
