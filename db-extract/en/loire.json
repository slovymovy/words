                    {
                        "translation_id": "60d34257-13e4-489a-a908-a48d0f21f856",
                        "source_entry_id": "ffbe9b39-d142-3310-9938-e442190b52c0",
                        "source_sense_description": "river",
                        "target_lang_word": "Loire",
