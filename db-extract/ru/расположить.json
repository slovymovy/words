                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a93a40-2781-40b3-a41c-72af45420a65",
                                "sense_id": "1bef00b1-aa5b-3667-9739-0f24771d26a8",
                                "text": "Расположить книги на полках в новом порядке."
                            },
                            {
                                "example_id": "fb8d17c3-78e3-461b-bdfe-afa97ee70801",
                                "sense_id": "1bef00b1-aa5b-3667-9739-0f24771d26a8",
                                "text": "Расположить что-нибудь в шахматном порядке."
                            },
                            {
                                "example_id": "816967b2-37f3-4a07-9bac-05aca0ed2ed6",
                                "sense_id": "1bef00b1-aa5b-3667-9739-0f24771d26a8",
                                "text": "Расположить мебель в комнате иначе."
                            }
                        ]
                    },
                    {
                        "sense_id": "99c4751b-a476-301d-b92c-cc44e1359660",
                        "entry_id": "95f059b2-9b09-3669-a79d-ee5755b1762b",
                        "glosses": [
                            "заставить разместиться, занять где-нибудь место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3609f1-8ce7-405b-8e59-8e1ccc2bed6b",
                                "sense_id": "99c4751b-a476-301d-b92c-cc44e1359660",
                                "text": "Расположить полк на отдых в городе."
                            },
                            {
                                "example_id": "0c73fc4c-ca59-4f49-9087-72d4628fbe14",
                                "sense_id": "99c4751b-a476-301d-b92c-cc44e1359660",
                                "text": "Расположить отряд на позиции."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c95bc5e-7fdc-3737-b398-33416f1f959a",
                        "entry_id": "95f059b2-9b09-3669-a79d-ee5755b1762b",
                        "glosses": [
                            "распределить, распланировать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df15f882-4533-4a61-bffe-331e3d3efdb2",
                                "sense_id": "7c95bc5e-7fdc-3737-b398-33416f1f959a",
                                "text": "Удачно расположить свои занятия."
                            },
                            {
                                "example_id": "d2dbc12a-0216-461e-97a4-c5e8d95c0e5d",
                                "sense_id": "7c95bc5e-7fdc-3737-b398-33416f1f959a",
                                "text": "Правильно расположить главы в книге."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c7204c0-b256-3742-af3c-8ba11eb689db",
                        "entry_id": "95f059b2-9b09-3669-a79d-ee5755b1762b",
                        "glosses": [
                            "вызвать в ком-нибудь симпатию, благоприятное отношение к кому-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
