                ],
                "senses": [
                    {
                        "sense_id": "d4f0c22d-60eb-364e-8f42-f597bb43f1ed",
                        "entry_id": "393f4406-ed93-35e0-a8bd-c2b0aecbb2c2",
                        "glosses": [
                            "Ersetzen einer vorhandenen Wandbeschichtung aus einem dünnen und biegsamen Material (Tapete) durch eine neue"
                        ],
                        "tags": [
                            "Handwerk",
                            "eher selten"
                        ],
                        "examples": [
                            {
                                "example_id": "764270f8-d54d-4d4e-bad9-b3555d253265",
                                "sense_id": "d4f0c22d-60eb-364e-8f42-f597bb43f1ed",
                                "text": "Nach dem Umzug haben wir gleich einen Tapetenwechsel vorgenommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a88c99b8-bb33-3916-a6ff-a5bd2af788f0",
                        "entry_id": "393f4406-ed93-35e0-a8bd-c2b0aecbb2c2",
                        "glosses": [
                            "Änderung der gewohnten Umgebung oder auch Tätigkeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "db44dd9f-7ada-4293-a0a8-8530e41a9785",
                                "sense_id": "a88c99b8-bb33-3916-a6ff-a5bd2af788f0",
                                "text": "In der abgeschiedenen Welt an den Ufern des Peipussees im Grenzland zwischen Estland und Russland führen die Strenggläubigen ein Leben ohne Tapetenwechsel. „Die Menschen sind derart in der Vergangenheit verwurzelt, dass gelegentlich der Eindruck entsteht, als würden sie mehr in der Vergangenheit als für die Zukunft leben“, sagte Birgit Püve, die bei der Ausstellungseröffnung anwesend war."
                            },
                            {
                                "example_id": "a48e0162-00bd-4a5b-95bf-fd742b268f5c",
                                "sense_id": "a88c99b8-bb33-3916-a6ff-a5bd2af788f0",
                                "text": "Hier ist alles so eingefahren, immer die gleiche Routine. Ich glaube, ich brauche mal einen Tapetenwechsel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
