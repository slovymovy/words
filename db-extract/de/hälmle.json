                ],
                "senses": [
                    {
                        "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                        "entry_id": "0d8b3c99-1bf3-30f5-9474-ce6fad18f94c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668c397b-525d-4a6a-9171-663c8b669517",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Frau Hälmle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "43f9793c-389a-4de7-8eaa-904ae4a9e520",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Herr Hälmle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8f6076fe-11fd-49ea-b7b6-e76f3befac79",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Die Hälmles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "80166153-1275-4e33-8932-adb31cd26fc4",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Der Hälmle trägt nie die Pullover, die die Hälmle ihm strickt."
                            },
                            {
                                "example_id": "ccd3a0a6-37c8-4d1c-bbf4-9ffd2ab9207a",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hälmle kommt, geht der Herr Hälmle.“"
                            },
                            {
                                "example_id": "3c22b274-26d8-4092-9237-d422545ab22b",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Hälmle kommt und geht."
                            },
                            {
                                "example_id": "9d12a6d5-5570-4083-97ec-1de928f90186",
                                "sense_id": "999fc75c-100a-3e01-831a-a478407ccff6",
                                "text": "Hälmles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
