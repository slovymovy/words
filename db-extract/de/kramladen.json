                ],
                "senses": [
                    {
                        "sense_id": "89627ba5-c07e-3164-af1a-ca572630ed5c",
                        "entry_id": "8d8f821e-82b1-3f9b-a52f-a07f6e9caeba",
                        "glosses": [
                            "Geschäft, das allerlei Waren des täglichen Bedarfs führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dfc6ae8-3415-4c46-b71b-58a23589e923",
                                "sense_id": "89627ba5-c07e-3164-af1a-ca572630ed5c",
                                "text": "„Ja, bis auf diesen neuen Kramladen hatte sich hier nichts verändert.“"
                            },
                            {
                                "example_id": "5dbbfa23-24c0-4b85-9867-f1e5682738f4",
                                "sense_id": "89627ba5-c07e-3164-af1a-ca572630ed5c",
                                "text": "„An eben dieser Stelle findet sich denn auch die ganze Herrlichkeit von Dorf Stechlin zusammen; das Pfarrhaus, die Schule, das Schulzenamt, der Krug, dieser letztere zugleich ein Eck- und Kramladen mit einem kleinen Mohren und einer Guirlande von Schwefelfäden in seinem Schaufenster.“"
                            },
                            {
                                "example_id": "83d98266-d341-4304-9965-81afddcd7edd",
                                "sense_id": "89627ba5-c07e-3164-af1a-ca572630ed5c",
                                "text": "„Bei gelegentlichen Repressalien der antibolschewistischen Truppen war der Vater Loew auf der Schwelle seines Kramladens niedergeschlagen worden und spielte seitdem in der kleinen jüdischen Gemeinde von Lilienkron die interessante Rolle eines Märtyrers.“"
                            },
                            {
                                "example_id": "70cdc8ce-7053-410a-9f52-663e973c62f8",
                                "sense_id": "89627ba5-c07e-3164-af1a-ca572630ed5c",
                                "text": "„Doch Vater Busch war nicht nur der einfache, rührige Krämer, wie ihn sein Sohn Wilhelm später beschrieb; er war ein umsichtiger Geschäftsmann, der den kleinen, von der Schwiegermutter übernommenen Kramladen in ein gut gehendes, vielseitiges Unternehmen ausbaute und den Ertrag in Grundstücken anlegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
