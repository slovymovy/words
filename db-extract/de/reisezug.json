                "senses": [
                    {
                        "sense_id": "339752fa-5c87-3f4e-b1dc-af8edf0e4a1c",
                        "entry_id": "ae521304-fa6d-3133-8644-20bb25dcdc56",
                        "glosses": [
                            "Eisenbahnzug, der für die Personenbeförderung bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7552e996-e3e4-4719-a4fb-f3e9611ff224",
                                "sense_id": "339752fa-5c87-3f4e-b1dc-af8edf0e4a1c",
                                "text": "Dies ist der Reisezug nach Nürnberg."
                            },
                            {
                                "example_id": "29cb07e0-865d-4b9c-b953-a5babfce2930",
                                "sense_id": "339752fa-5c87-3f4e-b1dc-af8edf0e4a1c",
                                "text": "„Einem Sprecher der staatlichen Eisenbahn zufolge entgleiste der Reisezug in der Nacht zu Dienstag auf dem Weg von Pointe-Noire in die Hauptstadt Brazzaville.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0aec0bf4-c4a0-3cd4-b528-f60afce94db0",
                        "entry_id": "ae521304-fa6d-3133-8644-20bb25dcdc56",
                        "glosses": [
                            "Gruppe reisender Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484c4d60-225a-4c50-92ba-599f45e5d090",
                                "sense_id": "0aec0bf4-c4a0-3cd4-b528-f60afce94db0",
                                "text": "„In Nauplia harrte der königliche Hof von Griechenland und von hier aus bewegte sich der malerische Reisezug über Korinth, Eleusis, Megara nach Athen.“"
                            },
                            {
                                "example_id": "e7753331-0f26-4daf-a82f-999836daddd6",
                                "sense_id": "0aec0bf4-c4a0-3cd4-b528-f60afce94db0",
                                "text": "„Da stieg von den Bergen ein stattlicher Reisezug zu Pferde herab.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
