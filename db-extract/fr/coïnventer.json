                "senses": [
                    {
                        "sense_id": "2254e627-e2b6-33cd-b986-e82e563e60d9",
                        "entry_id": "0e735d7d-3fd2-395e-9e7b-903af3d34d2f",
                        "glosses": [
                            "Inventer en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b5a2e0-50c9-4b3d-b59e-dac783f41b44",
                                "sense_id": "2254e627-e2b6-33cd-b986-e82e563e60d9",
                                "text": "La réponse sera apportée par les travailleurs du monde aéronautique, confrontés à une informatisation très poussée de leur environnement quotidien: seules «réussissent» les technologies dont le sens social est «coïnventé» par les inventeurs et les utilisateurs."
                            },
                            {
                                "example_id": "7010361d-6f8c-47d1-813a-6133aa584386",
                                "sense_id": "2254e627-e2b6-33cd-b986-e82e563e60d9",
                                "text": "Renversons donc la vapeur, et permettons au client d'entrer dans l'intimité de l'entreprise pour y coïnventer sa future nouvelle offre."
                            }
                        ]
                    }
