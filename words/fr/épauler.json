    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e098a9b6-dcd0-3a22-8b69-8055bc965e4b",
                    "sense_definition": "Aider activement quelqu'un, lui apporter un soutien efficace dans ses projets ou ses difficultés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soutien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son collègue a accepté de l'<w>épauler</w> pour terminer ce projet complexe avant la fin du mois."
                        },
                        {
                            "text": "Dans cette période difficile, toute l'équipe l'<w>épaule</w> avec beaucoup de bienveillance."
                        }
                    ],
                    "synonyms": [
                        "aider",
                        "appuyer",
                        "seconder",
                        "soutenir"
                    ],
                    "antonyms": [
                        "abandonner",
                        "entraver"
                    ],
                    "common_phrases": [
                        "épauler un collègue"
                    ]
                },
                {
                    "sense_id": "703cd2d9-7774-3b74-9efc-e2c969b43dd4",
                    "sense_definition": "Appliquer contre son épaule la crosse d'une arme à feu pour viser et tirer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tireur s'arrêta un instant pour <w>épauler</w> calmement son fusil de chasse."
                        },
                        {
                            "text": "Dès qu'il a vu la cible, le soldat a <w>épaulé</w> sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "mettre en joue"
                    ],
                    "common_phrases": [
                        "épauler un fusil"
                    ]
                },
                {
                    "sense_id": "5e9261d2-bddb-36e7-8ae6-68bf620cf313",
                    "sense_definition": "Consolider ou soutenir une structure, un mur au moyen d'un appui ou d'un contrefort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des poutres massives ont été installées afin d'<w>épauler</w> le mur fragilisé par les inondations."
                        },
                        {
                            "text": "Cette vieille bâtisse est <w>épaulée</w> des deux côtés par de solides piliers en pierre."
                        }
                    ],
                    "synonyms": [
                        "contrebuter",
                        "étayer",
                        "soutenir"
                    ],
                    "common_phrases": [
                        "épauler un mur"
                    ]
                },
                {
                    "sense_id": "b3fda06d-e61c-3747-91d8-3e8ccd2023c6",
                    "sense_definition": "Amincir un tenon de bois pour qu'il puisse s'ajuster correctement dans une mortaise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "menuiserie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier prend soin d'<w>épauler</w> le tenon avec précision pour parfaire l'assemblage."
                        },
                        {
                            "text": "Il faut bien <w>épauler</w> cette pièce en chêne avant de l'emboîter définitivement."
                        }
                    ],
                    "common_phrases": [
                        "épauler un tenon"
                    ]
                },
                {
                    "sense_id": "bab21d29-ffb9-3dd0-876b-fd5c623671d1",
                    "sense_definition": "Mettre des troupes ou des pièces d'artillerie à couvert au moyen d'un épaulement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine ordonna aux soldats d'<w>épauler</w> la batterie pour la protéger des tirs ennemis."
                        },
                        {
                            "text": "Les troupes se sont <w>épaulées</w> le long du talus pour échapper aux bombardements."
                        }
                    ],
                    "synonyms": [
                        "abriter",
                        "retrancher"
                    ]
                },
                {
                    "sense_id": "ee685fd3-b7c0-3b35-8c17-d8f4dc3d774c",
                    "sense_definition": "Blesser un animal, en particulier un cheval, au niveau de l'épaule.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veterinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une chute violente dans le fossé, le cavalier a malheureusement <w>épaulé</w> sa monture."
                        },
                        {
                            "text": "Le vétérinaire a confirmé que ce jeune cheval s'était <w>épaulé</w> pendant la course."
                        }
                    ]
                }
            ]
        }
    ]
