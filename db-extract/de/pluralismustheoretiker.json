                        "examples": [
                            {
                                "example_id": "7939e1a0-9491-415e-ab39-7abc3c2f66db",
                                "sense_id": "14119d05-3e66-3e47-a0ed-dbf89202c487",
                                "text": "„Der Pluralismustheoretiker Ernst Fraenkel … ging ebenfalls historisch-empirisch vor, gelangte dabei aber zu einem schlankeren Katalog von jeweils vier Unterscheidungsmerkmalen der beiden Regierungssystemtypen.“"
                            },
                            {
                                "example_id": "1fd25048-86fb-4a55-96a0-848fe0692554",
                                "sense_id": "14119d05-3e66-3e47-a0ed-dbf89202c487",
                                "text": "„Es geht den Pluralismustheoretikern um den ‚Nachweis‘, dass Sozialismus und Demokratie unvereinbar seien.“"
                            },
                            {
                                "example_id": "384ea788-cf87-4702-895c-067ffbf6655e",
                                "sense_id": "14119d05-3e66-3e47-a0ed-dbf89202c487",
                                "text": "„Bis vor einiger Zeit hatten amerikanische und deutsche Pluralismustheoretiker erhebliche Verständigungsschwierigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
