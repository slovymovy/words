                    {
                        "translation_id": "30483e65-e19f-4230-9d25-f919d17bf4ff",
                        "source_entry_id": "648d563e-a8e7-34ae-8b3e-16e9f3eb0435",
                        "source_sense_description": "mouvement lent d’une couche",
                        "target_lang_word": "creep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88b093fb-fe3a-362f-aeb7-d8ce1184a4fe",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To move slowly with the abdomen close to the ground."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee63f5ed-af08-4913-8118-78596baea456",
                                                "sense_id": "88b093fb-fe3a-362f-aeb7-d8ce1184a4fe",
                                                "text": "Lizards and snakes crept over the ground."
                                            },
                                            {
                                                "example_id": "061fa805-f6a0-4e2a-bc87-35b6c2e90f62",
                                                "sense_id": "88b093fb-fe3a-362f-aeb7-d8ce1184a4fe",
                                                "text": "One evening, while the Rabbit was lying there alone, watching the ants that ran to and fro between his velvet paws in the grass, he saw two strange beings creep out of the tall bracken near him."
                                            },
                                            {
                                                "example_id": "ea6e0816-6d89-4c7d-9e51-146d60a8bedb",
                                                "sense_id": "88b093fb-fe3a-362f-aeb7-d8ce1184a4fe",
                                                "text": "Reed tips face the dawn\nshivering in the autumn wind\nAt P'u-k'ou the winter tide\nhas not yet come\nSunrise on the sandy bank\npocked with narrow caves\nPale frogs and dark crabs\ncreep without end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fba0bda-299b-31b5-8eac-e9d171d253dc",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To grow across a surface rather than upwards."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "daa379bf-2253-3fd3-9ebe-cb68e5e7ef2c",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To move slowly and quietly in a particular direction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb443fb1-6471-4783-89d4-efab98cb63e0",
                                                "sense_id": "daa379bf-2253-3fd3-9ebe-cb68e5e7ef2c",
                                                "text": "He tried to creep past the guard without being seen."
                                            },
                                            {
                                                "example_id": "0ebb3cdc-0dbc-4e87-89dc-8773dad510a0",
                                                "sense_id": "daa379bf-2253-3fd3-9ebe-cb68e5e7ef2c",
                                                "text": "Electrification of the Eastern Region main line from Strasbourg, incidentally, is steadily creeping nearer to Paris, and is now complete as far as Château Thierry, 59 miles away; [...]."
                                            },
                                            {
                                                "example_id": "ee0e5968-0375-4c9e-8f00-85bfc3c2e21f",
                                                "sense_id": "daa379bf-2253-3fd3-9ebe-cb68e5e7ef2c",
                                                "text": "She crept up the stairs, keeping well into the side because she knew they were less likely to creak this way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "783543e2-0c44-3940-8d6d-4f2e9c5406d5",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To make small gradual changes, usually in a particular direction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "670a83d8-0c42-46f6-82bd-b031dbe5f0d6",
                                                "sense_id": "783543e2-0c44-3940-8d6d-4f2e9c5406d5",
                                                "text": "Prices have been creeping up all year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff433036-82e6-31b8-823c-7216bd376ba5",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To move in a stealthy or secret manner; to move imperceptibly or clandestinely; to steal in; to insinuate itself or oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0d81ec-ff5a-4074-9a38-2a3351f59d34",
                                                "sense_id": "ff433036-82e6-31b8-823c-7216bd376ba5",
                                                "text": "Old age creeps upon us."
                                            },
                                            {
                                                "example_id": "8df5e1f8-aa5e-49ac-af04-0d0380585f34",
                                                "sense_id": "ff433036-82e6-31b8-823c-7216bd376ba5",
                                                "text": "[…]guard his understanding from being imposed on by the willful or at least undesigned sophistry which creeps into most of the books of argument."
                                            },
                                            {
                                                "example_id": "1495095c-205e-4123-91d4-110d0bcf567a",
                                                "sense_id": "ff433036-82e6-31b8-823c-7216bd376ba5",
                                                "text": "Paranoia strikes deep / Into your life it will creep / It starts when you're always afraid / Step out of line, the man come and take you away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ac8bfbe-e36c-3ac9-b554-d89a504949db",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To slip, or to become slightly displaced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5561c1f-c9f1-469c-aa52-de76a893cf96",
                                                "sense_id": "5ac8bfbe-e36c-3ac9-b554-d89a504949db",
                                                "text": "The collodion on a negative, or a coat of varnish, may creep in drying."
                                            },
                                            {
                                                "example_id": "b2211b6c-51ce-49e8-aff8-da6a7378ea12",
                                                "sense_id": "5ac8bfbe-e36c-3ac9-b554-d89a504949db",
                                                "text": "The quicksilver on a mirror may creep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5b574f-0e11-377d-9444-93deba88ec38",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To move or behave with servility or exaggerated humility; to fawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91e8132-b523-4c75-8487-52f2b537652a",
                                                "sense_id": "cb5b574f-0e11-377d-9444-93deba88ec38",
                                                "text": "A creeping sycophant."
                                            },
                                            {
                                                "example_id": "2ed89b9f-6a9d-43ca-9839-9226bcf22e30",
                                                "sense_id": "cb5b574f-0e11-377d-9444-93deba88ec38",
                                                "text": "To come as humbly as they used to creep / To holy altars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "282038cc-cb64-325f-9142-86abea0957ef",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To have a sensation as of insects creeping on the skin of the body; to crawl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d297334-7f57-4253-af80-48f92a39043c",
                                                "sense_id": "282038cc-cb64-325f-9142-86abea0957ef",
                                                "text": "The sight made my flesh creep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867d3b07-8fd6-3c01-aeab-e0bbf7228d01",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To drag in deep water with creepers, as for recovering a submarine cable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94712c22-13e9-3315-bd89-ac91c1a4b17a",
                                        "entry_id": "ae6a4eea-12ab-3bcb-9252-249bf11783ef",
                                        "glosses": [
                                            "To covertly have sex (with a person other than one's primary partner); to cheat with."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3782e8ac-7c31-41e4-b8af-ef1595f0f051",
                                                "sense_id": "94712c22-13e9-3315-bd89-ac91c1a4b17a",
                                                "text": "Honey came in and she caught me red-handed / Creeping with the girl next door / Picture this we were both butt naked / Banging on the bathroom floor"
                                            },
                                            {
                                                "example_id": "4c8dedbb-c6e6-47f0-8f21-7205afb1fe77",
                                                "sense_id": "94712c22-13e9-3315-bd89-ac91c1a4b17a",
                                                "text": "I don't wanna know / If you're playin' me, keep it on the low / 'Cause my heart can't take it anymore / And if you're creepin', please don't let it show"
                                            },
                                            {
                                                "example_id": "d130bb4d-dd3a-483c-857f-8f6fce8e7bec",
                                                "sense_id": "94712c22-13e9-3315-bd89-ac91c1a4b17a",
                                                "text": "\"Now you want the nigga out 'cause he creeping with his baby momma.\""
                                            }
                                        ]
