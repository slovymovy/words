                ],
                "senses": [
                    {
                        "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                        "entry_id": "d56c157c-70e7-3f51-9504-c76a88ea54bd",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ebc799f-a32c-4418-9f22-d00961f7e049",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Frau Füßle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "509a99b7-71e9-4a87-9e75-13516b9c82d0",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Herr Füßle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f0b792e3-a19c-4759-9d91-d7a88e69924d",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Die Füßles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "54cdf372-8bd3-4c01-9828-21488f8068d1",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Der Füßle trägt nie die Schals, die die Füßle ihm strickt."
                            },
                            {
                                "example_id": "7255680c-415f-48bd-b239-a5b5aa673e76",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Füßle kommt, geht der Herr Füßle.“"
                            },
                            {
                                "example_id": "4752bcf3-14a2-462e-8c45-8eb9713243c8",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Füßle kommt und geht."
                            },
                            {
                                "example_id": "7fc3bb94-babe-4d24-9dae-43026619de00",
                                "sense_id": "c63da2ef-006d-3175-9c4f-26ca047c0ed5",
                                "text": "Füßles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
