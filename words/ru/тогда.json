                    "sense_definition": "в то время, не теперь",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сейчас здесь стоят дома, а <w>тогда</w> шумел лес.",
                            "target_lang_translations": {
                                "en": "Now houses stand here, but <w>then</w> a forest rustled.",
                                "zh": "现在这里盖起了房子，而<w>当时</w>这里是一片森林。",
                                "nl": "Nu staan hier huizen, maar <w>toen</w> ruiste het bos.",
                                "pl": "Teraz stoją tu domy, a <w>wtedy</w> szumiał las.",
                                "de": "Heute stehen hier Häuser, aber <w>damals</w> rauschte hier ein Wald.",
                                "fr": "Il y a des maisons ici maintenant, mais <w>alors</w> une forêt bruissait.",
                                "it": "Ora qui ci sono delle case, ma <w>allora</w> c'era un bosco.",
                                "cs": "Dnes zde stojí domy, ale <w>tehdy</w> zde šuměl les.",
                                "tr": "Şimdi burada evler var, ama <w>o zaman</w> orman uğulduyordu.",
                                "es": "Ahora hay casas aquí, pero <w>entonces</w> había un bosque."
                            }
                        },
                        {
                            "text": "Мы <w>тогда</w> жили в маленьком городе.",
                            "target_lang_translations": {
                                "en": "We lived in a small town <w>then</w>.",
                                "zh": "我们<w>那时</w>住在一个小城市里。",
                                "nl": "Wij woonden <w>toen</w> in een kleine stad.",
                                "pl": "Mieszkaliśmy <w>wtedy</w> w małym mieście.",
                                "de": "Wir wohnten <w>damals</w> in einer kleinen Stadt.",
                                "fr": "Nous vivions <w>alors</w> dans une petite ville.",
                                "it": "Noi <w>allora</w> vivevamo in una piccola città.",
                                "cs": "My jsme <w>tehdy</w> žili v malém městě.",
                                "tr": "Biz <w>o zamanlar</w> küçük bir şehirde yaşıyorduk.",
                                "es": "Nosotros vivíamos en un pueblo pequeño <w>entonces</w>."
                            }
                        }
                    ],
                    "antonyms": [
