                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e2997a-5487-45e7-9bb3-ab9b6e5881b3",
                                                "sense_id": "7d4f05a1-346e-31b3-810f-150fd28b4a50",
                                                "text": "La rumeur publique va jusqu’à désigner le soi-disant coupable : une habitante du bourg de Noëllet."
                                            },
                                            {
                                                "example_id": "5411abee-c9ab-4cbd-aa6e-964afe8a8176",
                                                "sense_id": "7d4f05a1-346e-31b3-810f-150fd28b4a50",
                                                "text": "Les larmes aux yeux, Louba, habitante de Kiev, la capitale ukrainienne, qui est en week-end à Boutcha chez sa sœur, montre les photos de la cave où les membres de la famille ont vécu terrés."
                                            }
