                "senses": [
                    {
                        "sense_id": "1a069dd6-6bee-324b-8254-71011f541ef1",
                        "entry_id": "3c0b7627-fcc4-324a-b06c-f7f8818a26a1",
                        "glosses": [
                            "Relatif à la civilisation latine héritière des influences hellénistiques."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "5197eb33-ad81-468a-a352-1be436ef27c9",
                                "sense_id": "1a069dd6-6bee-324b-8254-71011f541ef1",
                                "text": "Ces textes funéraires sont tous d’une écriture négligée, maigre et anguleuse; et le papyrus trouvé sur la momie de Pétaménoph étant le plus récent, porte encore par cela même des traces plus marquées de la décadence de l’art graphique égyptien sous la domination gréco-romaine."
                            },
                            {
                                "example_id": "5d06195e-4f82-478b-8112-95abe4ef49bc",
                                "sense_id": "1a069dd6-6bee-324b-8254-71011f541ef1",
                                "text": "« Il a voulu émerveiller et inspirer son public européen en documentant somptueusement cette grande ville gréco-romaine perdue dans le désert. …. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7d60146-2297-42e1-b007-72aea72dae02",
                        "source_entry_id": "3c0b7627-fcc4-324a-b06c-f7f8818a26a1",
                        "source_sense_id": "1a069dd6-6bee-324b-8254-71011f541ef1",
                        "target_lang_word": "griechisch-römisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "griechisch-römisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd274fed-9d7b-38d4-908f-9be956edfaa8",
                                        "entry_id": "844e7480-0d4a-300c-abfb-a6da2e2bc8d7",
                                        "glosses": [
                                            "nur Griffe oberhalb der Gürtellinie gestattend"
                                        ],
                                        "tags": [
                                            "speziell Ringen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef45e7b6-ecfa-4806-a49a-df6db99c1e60",
                                                "sense_id": "cd274fed-9d7b-38d4-908f-9be956edfaa8",
                                                "text": "„Im griechisch-römischen Stil sind nur Griffe oberhalb der Gürtellinie erlaubt, während beim Freistilringen auch Angriffe mit den eigenen Beinen und gegen die Beine des Gegners gestattet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6192d394-4765-3b9f-b87f-ab6df27dd238",
                                        "entry_id": "844e7480-0d4a-300c-abfb-a6da2e2bc8d7",
                                        "glosses": [
                                            "einer orthodoxen Nationalkirche angehörend, die mit Rom uniert ist und in Lehre und Verfassung den Papst anerkennt"
                                        ],
                                        "tags": [
                                            "speziell Christentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a356b754-c771-4066-bb33-6773a9b9fb3b",
                                                "sense_id": "6192d394-4765-3b9f-b87f-ab6df27dd238",
                                                "text": "„Die Ablösung der griechisch-römischen Religion durch das Christentum und die bereits ab der frühchristlichen Zeit erfolgenden Piratenüberfälle haben den Verfall und die Zerstörung der archaischen Heiligtümer und Denkmäler zur Folge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7fecb404-849d-3c51-a58f-1927d14e4af9",
                                        "entry_id": "844e7480-0d4a-300c-abfb-a6da2e2bc8d7",
                                        "glosses": [
                                            "die griechische und römische Zivilisation in der Antike betreffend"
                                        ],
                                        "tags": [
                                            "Kultur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4818ab-b1e8-4053-a2a2-217f75b9b03e",
                                                "sense_id": "7fecb404-849d-3c51-a58f-1927d14e4af9",
                                                "text": "„Als Klassische Altertumswissenschaft oder Klassische Altertumskunde bezeichnet man seit Friedrich August Wolf die wissenschaftliche Beschäftigung mit der griechisch-römischen Antike, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
