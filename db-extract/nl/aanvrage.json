                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59429f0d-8278-42e1-a1ef-6951c3d18515",
                                                "sense_id": "fb54cf6d-0842-3fc7-a356-04f9d2039d38",
                                                "text": "C’est l’oncle du jeune homme qui a fait la demande."
                                            }
