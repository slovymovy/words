                                        "entry_id": "7ef04251-df8d-3927-9d30-1f48bc9a5e85",
                                        "glosses": [
                                            "Zone montagneuse approximativement comprise entre 1 000 et 2 000 mètres d'altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d0766c-4e78-4f1d-a185-0269a1715671",
                                                "sense_id": "2dd72b84-3c2a-3fb1-88cc-6986ce8f03ae",
                                                "text": "Nous sommes en moyenne montagne, entre 700 et 900 m d'altitude, c’est l’hiver, poursuit l’édile mendois."
                                            }
                                        ]
