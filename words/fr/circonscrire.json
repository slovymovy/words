    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81f39340-3a5d-3e0d-a3ae-250d00db49ef",
                    "sense_definition": "Limiter la propagation ou l'extension d'un phénomène dangereux ou destructeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitation_propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont lutté toute la nuit pour enfin réussir à <w>circonscrire</w> l'incendie de forêt."
                        },
                        {
                            "text": "Les autorités sanitaires mettent tout en œuvre pour <w>circonscrire</w> la propagation du virus dans la région."
                        }
                    ],
                    "synonyms": [
                        "endiguer",
                        "contenir",
                        "cantonner"
                    ],
                    "antonyms": [
                        "propager",
                        "étendre"
                    ],
                    "common_phrases": [
                        "circonscrire un incendie",
                        "circonscrire l'épidémie",
                        "circonscrire la crise"
                    ]
                },
                {
                    "sense_id": "5c37baea-b301-334d-aef4-a7d6092c745d",
                    "sense_definition": "Restreindre le champ d'une analyse ou déterminer avec exactitude les limites d'un domaine abstrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitation_notion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de commencer la rédaction du mémoire, il faut savoir bien <w>circonscrire</w> le sujet."
                        },
                        {
                            "text": "Cette étude préliminaire a permis de <w>circonscrire</w> clairement les difficultés majeures du projet."
                        }
                    ],
                    "synonyms": [
                        "délimiter",
                        "restreindre",
                        "borner",
                        "cadrer"
                    ],
                    "antonyms": [
                        "élargir",
                        "généraliser"
                    ],
                    "common_phrases": [
                        "circonscrire le sujet",
                        "circonscrire le problème",
                        "circonscrire le débat"
                    ]
                },
                {
                    "sense_id": "673fa9d8-2b54-3e32-955f-1100328f5066",
                    "sense_definition": "Délimiter matériellement un espace ou un terrain en lui fixant des limites visibles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "limitation_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une rangée de haies permet de <w>circonscrire</w> l'espace réservé aux enfants dans le jardin."
                        },
                        {
                            "text": "Des barrières métalliques ont été installées afin de <w>circonscrire</w> la zone des fouilles archéologiques."
                        }
                    ],
                    "synonyms": [
                        "délimiter",
                        "enclore",
                        "entourer"
                    ],
                    "antonyms": [
                        "décloisonner"
                    ],
                    "common_phrases": [
                        "circonscrire l'espace",
                        "circonscrire un territoire"
                    ]
                },
                {
                    "sense_id": "3e6b71e0-de68-3941-84c7-b27288ad8a6d",
                    "sense_definition": "Tracer une figure géométrique autour d'une autre de façon à en toucher tous les sommets ou les côtés sans la couper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous a demandé de <w>circonscrire</w> un cercle autour de ce triangle équilatéral."
                        },
                        {
                            "text": "Dans cet exercice, il faut apprendre à <w>circonscrire</w> un polygone régulier selon les règles géométriques."
                        }
                    ],
                    "antonyms": [
                        "inscrire"
                    ],
                    "common_phrases": [
                        "circonscrire un cercle",
                        "circonscrire un triangle"
                    ]
                }
            ]
        }
    ]
