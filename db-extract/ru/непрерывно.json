                    {
                        "translation_id": "c9fff275-3a41-46c4-8c3d-c4aab8412da7",
                        "source_entry_id": "53400fab-9118-352b-abaa-5f33f83a8ad9",
                        "target_lang_word": "ununterbrochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ununterbrochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                        "entry_id": "62cd82da-0169-3e3d-b3e5-444ef3908a79",
                                        "glosses": [
                                            "fortwährend, ohne zwischendurch auszusetzen oder aufzuhören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0fbbc4c-0ff6-4be9-b56f-bf33e21de6de",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "Seit zwei Tagen regnet es ununterbrochen."
                                            },
                                            {
                                                "example_id": "8e522347-0b26-4bc1-884c-a50ebcf5c72a",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "Ein 28-jähriger Südkoreaner ist nach 49 Stunden ununterbrochenen Spielens in einem Internetcafé gestorben."
                                            },
                                            {
                                                "example_id": "5a323ce0-35fc-4794-b9f1-151fa7bb22a6",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "„Publius Cornelius Scipio kommandierte zwischen 211 und 201 v.Chr. ununterbrochen große Armeen, ähnlich wie Titus Quinctius Flamininus, der zwischen 198 und 183 v.Chr. maßgeblich Einfluss auf die römische Ostpolitik ausübte.“"
                                            },
                                            {
                                                "example_id": "eaebcd8a-7e5d-4c52-b4a1-8d4906f7fa87",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "„Anders als fast alle männlichen Priester befanden sich die Vestalinnen ununterbrochen im Gottesdienst.“"
                                            },
                                            {
                                                "example_id": "bbc20272-d066-4a94-a26e-f32d8a91e2e9",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "[Anm.: Die jüdischen Ärztin Lilli Jahn in ihrem letzten Brief aus Auschwitz:] „»Meine Gedanken sind ununterbrochen immer bei Euch. Hoffentlich seid Ihr alle gesund. Ich grüße und küsse jeden einzelnen tausend Mal.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43cf64b6-3020-4e60-80e4-9ecfa37a168e",
                        "source_entry_id": "53400fab-9118-352b-abaa-5f33f83a8ad9",
                        "target_lang_word": "kontinuierlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kontinuierlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                        "entry_id": "1e0bd383-5f6a-318c-afaa-8958955c8259",
                                        "glosses": [
                                            "stetig, über einen langen Zeitraum fortlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229799c7-9187-49a2-a57e-e2427299fade",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "Ein Sonderausschuss des Aufsichtsrats wird schon ab Februar kontinuierlich die Zusammenarbeit zwischen Porsche und dem VW-Konzern überwachen. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "db95fb30-e9cd-488e-9ccf-19ff143e0a80",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "„Seit den 1970er Jahren nimmt die Wahlbeteiligung in Westdeutschland kontinuierlich ab, auch Ostdeutschland folgt nun diesem Trend.“"
                                            },
                                            {
                                                "example_id": "f6b1f0d8-5bd3-40d9-95ad-954675598e97",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "„Ob Reisfelder, Mais oder Tomaten – viele Anbauflächen brauchen eine kontinuierliche Bewässerung.“"
                                            },
                                            {
                                                "example_id": "445e3bf3-26a4-43bf-a70e-c9c7b1fee81b",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "„Trotz der anfänglich kritischen Haltung der britischen Regierung gegenüber den territorialen Ausweitungen der Ostindiengesellschaft verbuchte die Gesellschaft aufgrund des kontinuierlichen Machtverlustes der Moguln immer weitere Landgewinne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a22f4e72-4cf4-341e-8f9e-8f56e0695303",
