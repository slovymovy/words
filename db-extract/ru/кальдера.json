                "senses": [
                    {
                        "sense_id": "cd5f5fdf-b665-35ff-84e1-0b3ecdba6dd4",
                        "entry_id": "76c58421-18c9-3fa4-9343-f2d930da2afc",
                        "glosses": [
                            "геол. обширная котловина вулканического происхождения, округлой формы, часто с крутыми стенками и более или менее ровным дном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "addabee3-372f-43ec-b544-3b15c84cb4dc",
                                "sense_id": "cd5f5fdf-b665-35ff-84e1-0b3ecdba6dd4",
                                "text": "На дне кальдеры расположено оз. Бирюзовое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45ac4cf2-307a-4f60-a0c6-282510180c43",
                        "source_entry_id": "76c58421-18c9-3fa4-9343-f2d930da2afc",
                        "source_sense_id": "cd5f5fdf-b665-35ff-84e1-0b3ecdba6dd4",
                        "target_lang_word": "caldera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caldera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1df973d-e422-3ddb-b74c-ff36d0ce5068",
                                        "entry_id": "213da305-2522-3bab-91da-402833e022c0",
                                        "glosses": [
                                            "A large crater formed by collapse of the cone or edifice of a volcano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbdddd1e-56e8-4dee-bfb0-7336a4e586ac",
                                                "sense_id": "b1df973d-e422-3ddb-b74c-ff36d0ce5068",
                                                "text": "The lakes of both Rotorua and Taupo occupy calderas left from enormous prehistoric eruptions, and magma lies at shallow depths beneath a number of centres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e1ab86a-b8d7-400b-9ca5-b3487906072a",
