                        ],
                        "examples": [
                            {
                                "example_id": "dbe34c69-2b2a-42c3-a024-af098e7f94c4",
                                "sense_id": "ff0dc6d8-c7db-35b4-9c5a-152efc00284b",
                                "text": "Wir bogen in den Redder ein und spazierten dann mehrere Kilometer in gemäßigtem Tempo."
                            },
                            {
                                "example_id": "63cb6927-5a6b-48ef-a80e-1b95642d0d34",
                                "sense_id": "ff0dc6d8-c7db-35b4-9c5a-152efc00284b",
                                "text": "„Von Rastorf zurück über Rosenfelde nach Oppendorf, fahrt man beständig in einem Redder (so wird in Holstein ein Weg genannt, der an beiden Seiten einen Erdwall mit lebendigen Hecken hat).“"
                            }
                        ],
