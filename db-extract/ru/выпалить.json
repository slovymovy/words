                        ],
                        "examples": [
                            {
                                "example_id": "11b3c90c-447d-4196-b9b2-086dcb6fd574",
                                "sense_id": "36def7cb-560f-3bf2-aa07-8c1133e3c02e",
                                "text": "вы́палить из ружья́",
                                "translation": "to fire a gun",
                                "english": "to fire a gun"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a226035-2bd1-35dd-9759-ee76244129c7",
                        "entry_id": "357b6527-df24-32a9-ba3f-a14880694dc6",
                        "glosses": [
                            "to blurt out"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8d5998c8-bfd7-4ed3-b547-1e37b0ab1aa4",
                                "sense_id": "3a226035-2bd1-35dd-9759-ee76244129c7",
                                "text": "– Бежи́м! – вы́палила она́ ра́ньше, чем осозна́ла, что и́менно собира́ется сде́лать. – Они́ отвлекли́сь на дра́ку! Э́то наш шанс!"
                            }
                        ]
                    }
