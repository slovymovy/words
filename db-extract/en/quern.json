    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "19e995a0-2501-34e3-b579-a9280acec799",
                "word": "quern",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3a7813aa-3e83-4fe4-bd09-b1f71eb329c2",
                        "entry_id": "19e995a0-2501-34e3-b579-a9280acec799",
                        "tags": [
                            "plural"
                        ],
                        "form": "querns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87852537-04fb-327b-bfa1-6c9031dd46ec",
                        "entry_id": "19e995a0-2501-34e3-b579-a9280acec799",
                        "glosses": [
                            "A mill for grinding corn, especially a handmill made of two circular stones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf26974-0988-45aa-a322-9ac90ddc7762",
                                "sense_id": "87852537-04fb-327b-bfa1-6c9031dd46ec",
                                "text": "She is shaking in ingredients from various small bottles and querns produced from the pockets of her robes, and from the drawer in the wooden table."
                            },
                            {
                                "example_id": "b09ee0cc-1f7d-4f07-afee-340e873714c0",
                                "sense_id": "87852537-04fb-327b-bfa1-6c9031dd46ec",
                                "text": "MacKie has noted that querns that were in use in Scotland up to the present day were about 450mm—600mm in diameter and that the lower stone was completely perforated to make it adjustable (MacKie 1987, 5)."
                            },
                            {
                                "example_id": "76ee680b-d28c-4b16-b869-4b4cfa26a692",
                                "sense_id": "87852537-04fb-327b-bfa1-6c9031dd46ec",
                                "text": "Not surprisingly, different cultures discovered the suitability of various rock types for manufacturing querns and millstones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01583cd7-98d2-4816-873b-a6cdee611b1a",
                        "source_entry_id": "19e995a0-2501-34e3-b579-a9280acec799",
                        "source_sense_id": "87852537-04fb-327b-bfa1-6c9031dd46ec",
                        "source_sense_description": "mill",
                        "target_lang_word": "žernov",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "žernov",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "af9d5280-14af-3dfc-827c-781b09fa0c1f",
                                        "entry_id": "63fb3268-6801-3b56-813c-5f4d787ef3a0",
                                        "glosses": [
                                            "mlýnský kámen"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3972eb-e20a-4b69-9034-f6db78b89f6f",
                                                "sense_id": "af9d5280-14af-3dfc-827c-781b09fa0c1f",
                                                "text": "I odtáhl od Levého Hradce, protože musil, aby jako zrno mezi dva žernovy se nedostal."
                                            },
                                            {
                                                "example_id": "2d05af67-c380-488e-91c6-6eba1965877d",
                                                "sense_id": "af9d5280-14af-3dfc-827c-781b09fa0c1f",
                                                "text": "Kdo by pak pohoršil jednoho z maličkých těchto věřících ve mne, lépe by jemu bylo, aby zavěšen byl žernov osličí na hrdlo jeho, a pohřížen byl do hlubokosti mořské.",
                                                "translation": "Na kom by ztroskotala víra jednoho z těchto maličkých ve mne, tomu by bylo lépe, kdyby ho hodili do moře s mlýnským kamenem na krku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "710bb936-1e34-3829-b6c5-edfc0d5720d9",
                                        "entry_id": "63fb3268-6801-3b56-813c-5f4d787ef3a0",
                                        "glosses": [
                                            "pravěký ruční kamenný mlýnek na obilí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ee9bb0-3fc4-4c69-9662-0c2ed1dffb9b",
                                                "sense_id": "710bb936-1e34-3829-b6c5-edfc0d5720d9",
                                                "text": "Nebudu mít pokdy, dokud melouc žernov neomelu, tlouk o zrna neotluku, stoupu v třísky neroztluku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81214551-e574-49f4-bded-7b8103ab2ad1",
                        "source_entry_id": "19e995a0-2501-34e3-b579-a9280acec799",
