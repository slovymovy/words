                        ],
                        "examples": [
                            {
                                "example_id": "857511dc-7a3a-469f-90a5-8b1b0b90bacd",
                                "sense_id": "6867eda2-4ed0-3ffe-b936-1a94aff6326a",
                                "text": "Son scaphandre ne lui permettait pas la précision des gestes requise, elle essaya néanmoins de tendre doucement les bras et de prendre la tête du delphineau sans lui causer de mal."
                            },
                            {
                                "example_id": "491cd6ff-7c69-4079-b3ad-bb392e9a5fd9",
                                "sense_id": "6867eda2-4ed0-3ffe-b936-1a94aff6326a",
                                "text": "Naître en milieu marin est certainement une épreuve difficile pour le delphineau, animal doté de poumons."
                            },
                            {
                                "example_id": "2b3d9881-6fe8-4e88-adaa-324e1eb27c15",
                                "sense_id": "6867eda2-4ed0-3ffe-b936-1a94aff6326a",
                                "text": "Le delphineau commence à téter au bout de vingt-quatre heures, et jusqu’à l’âge de quatre ans nage aux côtés de sa mère."
                            }
                        ]
                    }
                ],
                "translations": [
