                    "sense_id": "65786295-acd1-3c86-a154-68610084a720",
                    "sense_definition": "In een omgekeerde richting, volgorde of positie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reversal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je hebt je trui per ongeluk <w>andersom</w> aangetrokken.",
                            "target_lang_translations": {
                                "en": "You accidentally put your sweater on <w>the wrong way round</w>.",
                                "ru": "Ты случайно надел свитер <w>наоборот</w>.",
                                "pl": "Przez przypadek założyłeś sweter <w>na odwrót</w>.",
                                "de": "Du hast deinen Pullover versehentlich <w>verkehrt herum</w> angezogen.",
                                "fr": "Tu as mis ton pull <w>à l'envers</w> par accident.",
                                "it": "Hai messo il maglione <w>alla rovescia</w> per sbaglio.",
                                "cs": "Omylem sis oblékl svetr <w>obráceně</w>.",
                                "tr": "Kazak yanlışlıkla <w>ters</w> giymişsin.",
                                "es": "Te has puesto el suéter <w>al revés</w> por accidente.",
                                "zh": "你一不小心把毛衣<w>反着</w>穿了。"
                            }
                        },
                        {
                            "text": "Normaal loop ik eerst naar de bakker en dan naar het park, maar vandaag doe ik het <w>andersom</w>.",
                            "target_lang_translations": {
                                "en": "Normally I walk to the bakery first and then to the park, but today I'm doing it <w>the other way around</w>.",
                                "ru": "Обычно я иду сначала в пекарню, а потом в парк, но сегодня я сделаю <w>наоборот</w>.",
                                "pl": "Zwykle idę najpierw do piekarni, a potem do parku, ale dzisiaj robię to <w>odwrotnie</w>.",
                                "de": "Normalerweise gehe ich erst zum Bäcker und dann in den Park, aber heute mache ich es <w>andersherum</w>.",
                                "fr": "Normalement, je vais d'abord à la boulangerie puis au parc, mais aujourd'hui je fais <w>dans l'autre sens</w>.",
                                "it": "Di solito vado prima dal panettiere e poi al parco, ma oggi faccio <w>al contrario</w>.",
                                "cs": "Normálně jdu nejdřív do pekárny a pak do parku, ale dnes to dělám <w>naopak</w>.",
                                "tr": "Normalde önce fırına sonra parka giderim ama bugün <w>tersten</w> yapıyorum.",
                                "es": "Normalmente voy primero a la panadería y luego al parque, pero hoy lo hago <w>al revés</w>.",
                                "zh": "平时我先去面包店再去公园，但今天我<w>反过来</w>做了。"
                            }
                        }
                    ],
                    "synonyms": [
