                        "glosses": [
                            "weibliche Angehörige eines indischen Stammes beziehungsweise einer Volksgruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf09e0f0-7485-4216-be65-5d41b5c75a9b",
                                "sense_id": "2a5175e1-fdc0-3347-9184-959923e4bd28",
                                "text": "„Und wer sich in den Palästen von Fatehpur Sikri oder Agra genau umschaut, entdeckt Tempel, errichtet für die Gebete dieser Rajputinnen.“"
                            },
                            {
                                "example_id": "43b6d160-2aa1-4043-87a7-c0485a727676",
                                "sense_id": "2a5175e1-fdc0-3347-9184-959923e4bd28",
                                "text": "„Als die Festung nicht mehr zu halten war, wählten 13 000 Rajputinnen den Freitod in den Flammen, 32 000 Rajputen fielen auf dem Schlachtfeld.“"
                            }
                        ],
