                "senses": [
                    {
                        "sense_id": "0a463760-202c-302d-ac8f-46f49644dc53",
                        "entry_id": "aff16845-6e96-3fd9-be65-3ccfee354aa9",
                        "glosses": [
                            "Enlever son caractère anarchiste à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400b6239-0b6c-4ff7-a0ea-59077ffd0892",
                                "sense_id": "0a463760-202c-302d-ac8f-46f49644dc53",
                                "text": "Il a fallu le désanarchiser sur bien des points et le monarchiser sur beaucoup d'autres."
                            },
                            {
                                "example_id": "ac8d4669-3aee-4f55-a037-8caca1a1c5e1",
                                "sense_id": "0a463760-202c-302d-ac8f-46f49644dc53",
                                "text": "Acrobatie pour rester dans le fil : faut-il désanarchiser l'anarchisme pour que ça s'arrange ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c6ec716-69b6-37ff-846f-8123a312245a",
                        "entry_id": "aff16845-6e96-3fd9-be65-3ccfee354aa9",
                        "glosses": [
                            "Enlever son caractère anarchique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24fdf70-e6b5-4373-add1-6494cb6941a5",
                                "sense_id": "1c6ec716-69b6-37ff-846f-8123a312245a",
                                "text": "Pour ce faire, pour “désanarchiser” l’amas de données, nous avons opté pour une présentation par strates."
                            }
                        ]
