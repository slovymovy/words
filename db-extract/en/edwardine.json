                "senses": [
                    {
                        "sense_id": "aecb76dd-83d7-30d6-9fea-f255c53d4829",
                        "entry_id": "aaa1f1a2-b6bd-346f-acb9-b311d7bf8573",
                        "glosses": [
                            "Pertaining to the ordinal written by Thomas Cranmer in 1552 and the clergy who were ordained using this ordinal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6e9e87-df09-4851-b8db-0556c11bcee7",
                                "sense_id": "aecb76dd-83d7-30d6-9fea-f255c53d4829",
                                "text": "As to the number of Edwardine clergy who were left in possession during the whole of Mary's reign, or till their death, and were not reordained, six such cases are given."
                            },
                            {
                                "example_id": "948c560a-3bf3-4fa9-82fa-0b8842f36ac9",
                                "sense_id": "aecb76dd-83d7-30d6-9fea-f255c53d4829",
                                "text": "And first of all it is necessary to remember that the main difference between the second Edwardine Ordinal and the Ordinal as we find it now in our Prayer-books lies in the wording of the imperative formula which is repeated by the ordaining bishop, or by the principal ordaining bishop, during the laying-on of hands."
                            },
                            {
                                "example_id": "aafce0ec-42a3-40fe-812e-5d7e3c578f15",
                                "sense_id": "aecb76dd-83d7-30d6-9fea-f255c53d4829",
                                "text": "He had been ordained Edwardine deacon and priest by Bishop King at Oxford, on March 22nd, 1550, and April 6th, 1550, respectively."
                            }
                        ]
                    }
                ],
