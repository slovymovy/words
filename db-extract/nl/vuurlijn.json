                    {
                        "sense_id": "b39a943b-1dcd-3309-97ae-193a7c090429",
                        "entry_id": "ddae0f96-2d55-34b6-9af8-f849f4ff2a43",
                        "glosses": [
                            "de (rechte) lijn waarin projectielen worden geschoten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfb5695-a59b-49cf-86e4-1281a27731ca",
                                "sense_id": "b39a943b-1dcd-3309-97ae-193a7c090429",
                                "text": "De wolk ligt in de ‘vuurlijn’ van een sterrenstelsel met een superzwaar zwart gat, ontdekte de Nederlands-Amerikaanse astronoom Wil van Breugel in 1985."
                            }
                        ]
                    },
                    {
                        "sense_id": "095b8849-3cde-3d66-b807-398c1a6e5223",
                        "entry_id": "ddae0f96-2d55-34b6-9af8-f849f4ff2a43",
                        "glosses": [
                            "de lijn tot waar het geschut reikt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85fd67b9-c52d-3a94-a2e1-fc19013ae87b",
                        "entry_id": "ddae0f96-2d55-34b6-9af8-f849f4ff2a43",
                        "glosses": [
                            "rand van een bosbrand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a0be533-75a1-48f2-a93e-4da4c090816e",
                                "sense_id": "85fd67b9-c52d-3a94-a2e1-fc19013ae87b",
                                "text": "Dankzij de minder krachtige wind en de lagere temperatuur, verwacht de brandweer grotere controle te krijgen over de vuurlijnen tussen de geïsoleerde brandhaarden en zo hun opmars te beletten."
                            },
                            {
                                "example_id": "bc3e3f9c-326f-47a6-acaa-d92d8f6d2df7",
                                "sense_id": "85fd67b9-c52d-3a94-a2e1-fc19013ae87b",
                                "text": "De groep hoopt snel op goed nieuws, en dat het vuur snel onder controle komt. Op het moment van ontruiming was de vuurlijn ongeveer twee kilometer vanaf de camping. “Maar de wind stond pal naar ons toe, dus uit voorzorg moesten we van de camping af. Verstandig.”"
                            }
                        ]
                    }
                ],
