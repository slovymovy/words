                    {
                        "sense_id": "55c85212-1f0e-32cd-b234-e1c0ae5da617",
                        "entry_id": "caeec874-4909-36da-94b2-4c25f2d048a5",
                        "glosses": [
                            "strukturierte Abfolge von Vorgängen und Prozessen, die bei der Gewinnung von Rohstoffen angewendet werden; Art und Weise, wie der Abbau und die Förderung von Rohstoffen organisiert sind"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "eebf7009-2725-4172-b0a0-e697f1cdb936",
                                "sense_id": "55c85212-1f0e-32cd-b234-e1c0ae5da617",
                                "text": "„Die kontinuierlich arbeitenden Abbausysteme ermöglichen aufgrund der Elektroantriebe einen hohen Grad an Automatisierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3527805d-8342-3946-a32f-022c02bdc7dc",
                        "entry_id": "caeec874-4909-36da-94b2-4c25f2d048a5",
                        "glosses": [
                            "Gesamtheit biochemischer Mechanismen (vor allem enzymatischer Reaktionen), die den Abbau von Fremdstoffen oder Toxinen im Organismus steuern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac15eb48-bda0-43af-8771-3523565b11cc",
                                "sense_id": "3527805d-8342-3946-a32f-022c02bdc7dc",
                                "text": "„Das Abbausystem von Ethanol und Acetaldehyd ist genetisch determiniert.“"
                            },
                            {
                                "example_id": "ddf25358-e9a7-4657-ba75-0bd62ae2a9fd",
                                "sense_id": "3527805d-8342-3946-a32f-022c02bdc7dc",
                                "text": "„Ein weiterer Forschungsschwerpunkt ist der Einsatz verschiedener salztoleranter Pflanzen (Halophyten) als Biofilter, als Nahrungsmittel, als Quelle wertvoller Pflanzeninhaltsstoffe, als biologisches Abbausystem von Xenobiotika etc.“"
                            }
                        ],
