    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25a54706-ecf7-3b50-8943-9bbeaf37320c",
                    "sense_definition": "Большое литературное произведение, обычно в прозе, с развернутым сюжетом и развитием характеров героев.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я люблю читать исторический <w>роман</w> перед сном.",
                            "target_lang_translations": {
                                "en": "I like reading a historical <w>novel</w> before bed.",
                                "zh": "我喜欢在睡前读历史<w>小说</w>。"
                            }
                        },
                        {
                            "text": "Этот известный <w>роман</w> был переведён на многие языки мира.",
                            "target_lang_translations": {
                                "en": "This famous <w>novel</w> was translated into many languages of the world.",
                                "zh": "这部著名<w>小说</w>已被翻译成世界上的多种语言。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "исторический роман",
                        "читать роман",
                        "писать роман",
                        "герой романа"
                    ],
                    "target_lang_definitions": {
                        "en": "A large literary work, usually in prose, with a developed plot and character development.",
                        "zh": "一种篇幅较长、通常为散文体，具有完整情节和人物发展的文学作品。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "novel",
                                "target_lang_sense_clarification": "literary work"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小说",
                                "target_lang_sense_clarification": "文学作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88644340-568f-3c07-a1b5-c647f3735ff6",
                    "sense_definition": "Любовные отношения между мужчиной и женщиной.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У них начался бурный <w>роман</w> во время летнего отпуска.",
                            "target_lang_translations": {
                                "en": "They started a whirlwind <w>romance</w> during their summer vacation.",
                                "zh": "他们在暑假期间开始了一段热烈的<w>恋情</w>。"
                            }
                        },
                        {
                            "text": "Служебный <w>роман</w> может помешать вашей карьере.",
                            "target_lang_translations": {
                                "en": "An office <w>romance</w> can hinder your career.",
                                "zh": "办公室<w>恋情</w>可能会影响你的职业生涯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "любовь"
                    ],
                    "common_phrases": [
                        "служебный роман",
                        "крутить роман",
                        "бурный роман",
                        "курортный роман"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in everyday conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A romantic relationship between two people.",
                        "zh": "指男女之间发生的恋爱关系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "romance",
                                "target_lang_sense_clarification": "relationship"
                            },
                            {
                                "target_lang_word": "love affair",
                                "target_lang_sense_clarification": "relationship"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恋情",
                                "target_lang_sense_clarification": "恋爱关系"
                            },
                            {
                                "target_lang_word": "风流韵事",
                                "target_lang_sense_clarification": "指男女私情"
                            }
                        ]
                    }
                }
            ]
        },
        {
