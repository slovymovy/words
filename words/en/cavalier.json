                },
                {
                    "sense_id": "d79c16e8-d6b7-39b9-8fc3-4025d943a34a",
                    "sense_definition": "a slang term for a man who is uncircumcised",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boys in the locker room joked about whether they were a <w>cavalier</w> or a roundhead.",
                            "target_lang_translations": {
                                "ru": "Мальчики в раздевалке шутили о том, <w>кавалер</w> он или круглоголовый."
                            }
                        },
                        {
                            "text": "He explained that being a <w>cavalier</w> simply meant he was not circumcised.",
                            "target_lang_translations": {
                                "ru": "Он объяснил, что быть <w>кавалером</w> просто означало, что он не был обрезан."
                            }
                        }
