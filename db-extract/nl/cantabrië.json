                                        "sense_id": "39cc6f6c-a372-3147-a254-70c97e57daf1",
                                        "entry_id": "81e781c1-53e4-3535-920c-4abdcff57ad8",
                                        "glosses": [
                                            "Province et communauté autonome d’Espagne."
                                        ],
