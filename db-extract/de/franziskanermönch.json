                ],
                "senses": [
                    {
                        "sense_id": "e856c9f1-53e3-33c6-b8d0-51d6eee6e64d",
                        "entry_id": "8696c4d3-6fc2-3859-b58d-20fff6efb566",
                        "glosses": [
                            "Angehöriger eines bettelnden Ordens, der im frühen 13. Jahrhundert durch Franziskus oder Franz von Assisi gegründet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa206d0d-a563-4409-9690-f0661c714dfe",
                                "sense_id": "e856c9f1-53e3-33c6-b8d0-51d6eee6e64d",
                                "text": "„Der Franziskanermönch Salimbene von Parma […] berichtet sogar von Menschenversuchen […].“"
                            },
                            {
                                "example_id": "38354e2a-9f66-4a1e-95b5-69e488173549",
                                "sense_id": "e856c9f1-53e3-33c6-b8d0-51d6eee6e64d",
                                "text": "„Erst 1769 ließen sich Franziskanermönche an der Bucht von San Diego nieder, bald folgten weitere Missionsstationen an der Küste.“"
                            },
                            {
                                "example_id": "79616b24-1563-4074-8a64-081f85ef588c",
                                "sense_id": "e856c9f1-53e3-33c6-b8d0-51d6eee6e64d",
                                "text": "„Ein atheistischer Franziskanermönch war der Mephisto, der ihm zuflüsterte, daß Colette Parangon auch nur ein Weib sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
