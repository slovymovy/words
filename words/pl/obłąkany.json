                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "неистовый, исступлённый"
                            },
                            {
                                "target_lang_word": "бредовый",
                                "target_lang_sense_clarification": "неадекватный, как в бреду"
