                ],
                "senses": [
                    {
                        "sense_id": "9269520f-b178-343c-a63b-c88cb7a29677",
                        "entry_id": "f3f76e80-8e7b-3670-8b96-a621c2eb6db9",
                        "glosses": [
                            "mały widelec (używany np. do jedzenia śledzi lub ciasta)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad8f9c7-8de1-4ebf-85f0-093f97cda4f1",
                                "sense_id": "9269520f-b178-343c-a63b-c88cb7a29677",
                                "text": "Proszę, porozkładaj jeszcze na stołach widelczyki deserowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "937643ac-1680-45d3-9954-a47d769c4b1f",
                        "source_entry_id": "f3f76e80-8e7b-3670-8b96-a621c2eb6db9",
                        "source_sense_id": "9269520f-b178-343c-a63b-c88cb7a29677",
                        "target_lang_word": "cocktail fork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocktail fork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                        "entry_id": "439210f3-4046-33a8-9cd7-7b38a549cad6",
                                        "glosses": [
                                            "A small fork usually with two or three tines, used for eating dishes served as appetizers (such as fruit cocktails and shrimp cocktails), and for picking up olives and other small snacks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf21d5c-a29e-4b8d-b4f0-2a92c6e83800",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "Oyster and cocktail forks are placed at the extreme right of the cover beyond the teaspoons, or they may be laid across the right side of the service plate underlining the cocktail glass or the oyster service."
                                            },
                                            {
                                                "example_id": "c5bcd9b7-aab2-47fe-8838-029366334653",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "No fairy tale this. Just the story of Soviet slave labor in icy camps, dumping millions of pounds of fish for your dainty cocktail forks each month—and so beginning to kill off a multi-million dollar American fishing industry, canneries, boatbuilding and gear production."
                                            },
                                            {
                                                "example_id": "c0b53410-76d4-48d6-b848-7c061e8a6a93",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "[page 944, column 1] Cocktail fork—used for sea foods. It is a short, slender fork about ½ inch wide at the prong end of the fork. […] [page 945, column 3] On the left are all the forks except the cocktail fork, which is laid to the extreme right of the knives when placed."
                                            },
                                            {
                                                "example_id": "721394ff-9c6b-404d-b5da-9e5092f1d97e",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "We just returned from a cruise where there were eleven pieces of flatware on the table for dinner: three knives and a soup spoon to the right of the plate, four forks to the left, and a cocktail fork, teaspoon, and demitasse spoon above the plate. Could you please explain the function of each?"
                                            },
                                            {
                                                "example_id": "de55b0fd-fece-49ca-b471-a1b0cb772528",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "Mock Meatballs […] Serve in a shallow serving dish with cocktail forks or toothpicks."
                                            },
                                            {
                                                "example_id": "d5dab117-b572-4b5f-94b6-e2202db186f3",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "[H]ow could you talk a raving lunatic out of drinking his own urine or stabbing his invalid grandmother a hundred times with a cocktail fork?"
                                            },
                                            {
                                                "example_id": "534a5939-9ae0-46dc-a801-67fbb2d11af7",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "To remove [crab] meat, twist off claws and legs; use a nutcracker to crack shells at the joints. Remove meat with a small cocktail fork or nutpick. Break the body; remove any remaining meat."
                                            },
                                            {
                                                "example_id": "8df40516-62ce-4fb5-8091-2bd1ad940a99",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "Remove the shrimp from the marinade and set them on a cutting board. Using a sharp, thin knife, cut each shrimp in half lengthwise, working from head to tail. Stick each halved shrimp onto the end of a cocktail fork."
                                            },
                                            {
                                                "example_id": "e3e499a8-31a5-48e0-a7c7-ac25288c22b4",
                                                "sense_id": "1930f526-2c9e-3a79-ba61-72975c24c258",
                                                "text": "My mother had always eaten straight out of jars and cans, with a cocktail fork as her sole utensil. It was one of her peculiarities. / \"Hi, Ma.\" / Her cocktail fork was balanced between her thumb and index finger, close to her mouth, as if a joint that had just been passed to her and she wasn't sure what to do with it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
