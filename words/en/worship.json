                        {
                            "text": "She is researching the genealogy of the <w>Worship</w> family in England.",
                            "target_lang_translations": {
                                "ru": "Она изучает генеалогию семьи <w>Уоршип</w> в Англии.",
                                "zh": "她正在研究英国<w>沃希普</w>家族的家谱。"
                            }
                        }
                    ],
                    "traits": [
