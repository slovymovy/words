                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f35e4d6-a3a1-4d74-9e7c-b3b2ad12338f",
                                                "sense_id": "a9c64145-0cbf-3109-ad66-e28ad1c16bd8",
                                                "text": "Des causes diverses : pression, volcanisme ont métamorphisé localement des sédiments de tous les âges."
                                            },
                                            {
                                                "example_id": "fdb63ac8-f533-4640-b399-89b5b9b2ae8f",
                                                "sense_id": "a9c64145-0cbf-3109-ad66-e28ad1c16bd8",
                                                "text": "Les structures du paysage se métamorphisaient en un motif unique."
                                            }
                                        ]
                                    }
                                ]
                            }
