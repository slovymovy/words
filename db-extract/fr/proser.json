                "senses": [
                    {
                        "sense_id": "79a821a2-bef1-3f79-8f97-ae6dcd898efb",
                        "entry_id": "5ab16a8b-3044-34a7-a60e-87bc89aee95f",
                        "glosses": [
                            "Mettre en prose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c64420b-a77c-413d-878f-8963812cf2aa",
                                "sense_id": "79a821a2-bef1-3f79-8f97-ae6dcd898efb",
                                "text": "Car s’ils font quelque chose, C’est proser de la rime et rimer de la prose"
                            }
                        ]
                    },
                    {
                        "sense_id": "3fe6bd5e-8686-3342-be0b-d434651ba3b7",
                        "entry_id": "5ab16a8b-3044-34a7-a60e-87bc89aee95f",
                        "glosses": [
                            "Écrire en prose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf61263c-f450-429a-b413-aedc98fb3297",
                                "sense_id": "3fe6bd5e-8686-3342-be0b-d434651ba3b7",
                                "text": "Je harangue et je prose assez facilement, Je n’ai jamais rêvé pour faire un compliment"
                            },
                            {
                                "example_id": "0ba15a8a-aca4-430c-a601-5ac9f0ac42b4",
                                "sense_id": "3fe6bd5e-8686-3342-be0b-d434651ba3b7",
                                "text": "Ah ! du moins, par pitié, s’ils cessaient d'imprimer, Dans le secret contents de proser, de rimer"
                            }
                        ]
                    }
