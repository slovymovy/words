                                "target_senses": [
                                    {
                                        "sense_id": "de5bcd9b-506e-3e4b-821e-24bdaef93c53",
                                        "entry_id": "369addfd-d055-383a-807a-bb79396ee549",
                                        "glosses": [
                                            "A thing that joins two separate items, e.g. software to connect video or music clips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43bae88a-14f8-4be7-8ec7-9b76f9a9beff",
                                                "sense_id": "de5bcd9b-506e-3e4b-821e-24bdaef93c53",
                                                "text": "The zero-width joiner (ZWJ) has a code point but no corresponding symbol. It is used to connect two or more other Unicode code points to create a new \"compound character\" with a unique glyph all its own. […] I'm making a point of mentioning Ninja Cat because it is another example of the use of zero-width joiners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf9b2922-4c78-3cfc-97b9-9031f362ccd6",
                                        "entry_id": "369addfd-d055-383a-807a-bb79396ee549",
                                        "glosses": [
                                            "A person who joins societies or organizations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0164eeb-d2c0-493a-bae5-8d52201814b5",
                                                "sense_id": "cf9b2922-4c78-3cfc-97b9-9031f362ccd6",
                                                "text": "I am not a joiner. I am reluctant to sign up as a member of any organization, because I generally can't find myself or my ideas in it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c76265-c965-34ae-b049-ead00023beb3",
                                        "entry_id": "369addfd-d055-383a-807a-bb79396ee549",
                                        "glosses": [
                                            "Synonym of hensopper."
                                        ],
