{
    "word_family": [
        "order",
        "orderly",
        "disorder",
        "reorder",
        "preorder",
        "suborder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4e2dc28-5d10-366d-9d22-6336d067b2a6",
                    "sense_definition": "Simple past and past participle of <w>order</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat down at the table and <w>ordered</w> our dinner.",
                            "target_lang_translations": {
                                "ru": "Мы сели за стол и <w>заказали</w> ужин.",
                                "zh": "我们坐到桌边，<w>点</w>了晚餐。"
                            }
                        },
                        {
                            "text": "The officer <w>ordered</w> the soldiers to return to the base immediately.",
                            "target_lang_translations": {
                                "ru": "Офицер <w>приказал</w> солдатам немедленно вернуться на базу.",
                                "zh": "军官<w>命令</w>士兵们立即返回基地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ordered online",
                        "ordered a taxi",
                        "ordered to leave"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола order.",
                        "zh": "动词 order 的过去式和过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заказал",
                                "target_lang_sense_clarification": "сделал заказ (еды, товаров)"
                            },
                            {
                                "target_lang_word": "приказал",
                                "target_lang_sense_clarification": "дал распоряжение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点",
                                "target_lang_sense_clarification": "指点餐或点菜"
                            },
                            {
                                "target_lang_word": "命令",
                                "target_lang_sense_clarification": "指下达指令或要求"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6671312-3335-3463-8976-fb8b7417c5e9",
                    "sense_definition": "Arranged in a neat, careful, and systematic way; not messy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers to live a calm and <w>ordered</w> life without any surprises.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает вести спокойную и <w>размеренную</w> жизнь без сюрпризов.",
                                "zh": "她更喜欢过一种平静而<w>有条理</w>的生活，不希望有任何意外。"
                            }
                        },
                        {
                            "text": "The files were kept in an <w>ordered</w> stack on the desk.",
                            "target_lang_translations": {
                                "ru": "Файлы лежали на столе в <w>упорядоченной</w> стопке.",
                                "zh": "文件在桌上堆放得整整齐齐，十分<w>有序</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "organized",
                        "tidy",
                        "neat",
                        "systematic",
                        "structured"
                    ],
                    "antonyms": [
                        "disordered",
                        "chaotic",
                        "messy",
                        "disorganized"
                    ],
                    "common_phrases": [
                        "ordered list",
                        "ordered society",
                        "ordered fashion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устроенный аккуратным и систематическим образом; не хаотичный.",
                        "zh": "以整洁、谨慎和系统的方式排列；不杂乱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упорядоченный",
                                "target_lang_sense_clarification": "систематизированный"
                            },
                            {
                                "target_lang_word": "организованный",
                                "target_lang_sense_clarification": "спланированный, аккуратный"
                            },
                            {
                                "target_lang_word": "размеренный",
                                "target_lang_sense_clarification": "о жизни или режиме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有序的",
                                "target_lang_sense_clarification": "指事物排列整齐"
                            },
                            {
                                "target_lang_word": "有条理的",
                                "target_lang_sense_clarification": "指生活或工作方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a120902c-60bd-3ea6-9c3b-1bed7b40dd9d",
                    "sense_definition": "Having a specific sequence or arrangement determined by a mathematical rule or property.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In an <w>ordered</w> pair, the position of each number matters.",
                            "target_lang_translations": {
                                "ru": "В <w>упорядоченной</w> паре порядок чисел имеет значение.",
                                "zh": "在<w>有序</w>对中，每个数字的位置都很重要。"
                            }
                        },
                        {
                            "text": "The set of real numbers is considered an <w>ordered</w> field.",
                            "target_lang_translations": {
                                "ru": "Множество действительных чисел считается <w>упорядоченным</w> полем.",
                                "zh": "实数集被认为是一个<w>有序</w>域。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ordered pair",
                        "ordered set",
                        "totally ordered"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенную последовательность согласно математическому правилу.",
                        "zh": "具有由数学规则或属性确定的特定序列或排列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упорядоченный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有序的",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}