                    {
                        "sense_id": "5fcac840-1559-3116-b1c1-3652154b686e",
                        "entry_id": "94bdf6d7-142e-3fbc-8199-67dd3b2b5844",
                        "glosses": [
                            "Féminin singulier de officiel."
