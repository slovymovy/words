                                                "sense_id": "8763fedf-6ab3-3724-b162-a96141095643",
                                                "text": "Het nieuws overdonderde de menigte."
                                            },
                                            {
                                                "example_id": "b2849ddf-8520-4f54-b036-47e86efec32c",
                                                "sense_id": "8763fedf-6ab3-3724-b162-a96141095643",
                                                "text": "Ik was overdonderd door alle toeristen in het bezoekerscentrum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b43fa75-5574-4906-833d-43d23a2d63c9",
