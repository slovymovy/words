                        "examples": [
                            {
                                "example_id": "7314ddbb-66de-4080-a45c-0de04eb102a0",
                                "sense_id": "d40902f5-6808-39cd-9743-9644fc3fec43",
                                "text": "Un échafaudage autoportant permet de ne pas fragiliser l’édifice à rénover."
                            },
