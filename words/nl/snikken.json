    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3704a0e6-2975-341f-819a-67ca962e6b84",
                    "sense_definition": "huilen met schokkende ademhalingen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "huilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind zat zachtjes te <w>snikken</w> in de hoek van de kamer.",
                            "target_lang_translations": {
                                "en": "The child was <w>sobbing</w> quietly in the corner of the room.",
                                "pl": "Dziecko siedziało w kącie pokoju, cicho <w>szlochając</w>."
                            }
                        },
                        {
                            "text": "Na het slechte nieuws begon ze onbedaarlijk te <w>snikken</w> van verdriet.",
                            "target_lang_translations": {
                                "en": "After the bad news, she began <w>sobbing</w> uncontrollably with grief.",
                                "pl": "Po usłyszeniu złych wieści zaczęła niepohamowanie <w>szlochać</w> z żalu."
                            }
                        }
                    ],
                    "synonyms": [
                        "huilen"
                    ],
                    "antonyms": [
                        "lachen"
                    ],
                    "common_phrases": [
                        "onbedaarlijk snikken",
                        "zachtjes snikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to cry with convulsive, gasping breaths",
                        "pl": "płakać, wydając urywane, drżące oddechy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sob",
                                "target_lang_sense_clarification": "to weep with convulsive gasps"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szlochać",
                                "target_lang_sense_clarification": "płakać urywanym głosem"
                            },
                            {
                                "target_lang_word": "łkać",
                                "target_lang_sense_clarification": "płakać cicho i z trudem łapać powietrze"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73291534-9cf8-3327-b1ce-f2856b7d4543",
                    "sense_definition": "meervoud van <w>snik</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "huilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen haar <w>snikken</w> door probeerde ze te vertellen wat er was gebeurd.",
                            "target_lang_translations": {
                                "en": "Between her <w>sobs</w>, she tried to tell what had happened.",
                                "pl": "Pomiędzy <w>szlochami</w> próbowała opowiedzieć, co się stało."
                            }
                        },
                        {
                            "text": "De luide <w>snikken</w> van de baby waren in het hele huis te horen.",
                            "target_lang_translations": {
                                "en": "The baby's loud <w>sobs</w> could be heard throughout the house.",
                                "pl": "Głośne <w>szlochy</w> niemowlęcia było słychać w całym domu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'sob'; the sounds or acts of sobbing",
                        "pl": "liczba mnoga od słowa 'snik'; urywane oddechy lub dźwięki wydawane podczas płaczu"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sobs",
                                "target_lang_sense_clarification": "plural of the sound made when crying convulsively"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szlochy",
                                "target_lang_sense_clarification": "dźwięki głośnego, urywanego płaczu"
                            },
                            {
                                "target_lang_word": "łkania",
                                "target_lang_sense_clarification": "dźwięki cichego, przerywanego płaczu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}