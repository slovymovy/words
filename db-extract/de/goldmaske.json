                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dbc4b3e-6411-4a8d-a460-87acacc473aa",
                                "sense_id": "4f448366-c960-3c19-82ba-23649252a567",
                                "text": "„Offen fiel sein langsträhniges Haar ihm auf die Hüften herab, sein Antlitz war durch eine Goldmaske verdeckt.“"
                            },
                            {
                                "example_id": "3f410a72-d7ba-4e8b-a05b-032f2409f354",
                                "sense_id": "4f448366-c960-3c19-82ba-23649252a567",
                                "text": "„Die in der Stadt Minja in Ägypten gefundene, über 2500 Jahre alte Nekropole enthalte 40 Steinsärge, etwa 1000 Statuen und eine Goldmaske, sagte Antikenminister Chaled al-Enani am Samstag am Ausgrabungsort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
