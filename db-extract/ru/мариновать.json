                                        "entry_id": "d372d0c4-22a9-3d5c-a407-e293ab70da60",
                                        "glosses": [
                                            "To allow a sauce or flavoring mixture to absorb into something; to steep or soak something in a marinade to flavor or prepare it for cooking."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f678db4-9ab8-47d0-8a7d-47231fd622ad",
                                                "sense_id": "90892c33-b3d5-3ae8-957a-7b73c0492cb1",
                                                "text": "You'll get a better flavour from the chicken if you marinate it first."
                                            },
                                            {
                                                "example_id": "d9388b15-418f-4c39-b7f5-21eeac957d55",
                                                "sense_id": "90892c33-b3d5-3ae8-957a-7b73c0492cb1",
                                                "text": "After the chicken has marinated for two hours, discard the remaining marinade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e282688-68f0-34cd-a353-e07d881ee2d8",
                                        "entry_id": "d372d0c4-22a9-3d5c-a407-e293ab70da60",
                                        "glosses": [
                                            "Of ideas or feelings, to mentally develop over time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
