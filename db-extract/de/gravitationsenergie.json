                ],
                "senses": [
                    {
                        "sense_id": "4b742a31-d8b4-3217-a132-18f6f24f87b1",
                        "entry_id": "a54b7831-6025-3274-8076-0bc0dfb23656",
                        "glosses": [
                            "Energie, die durch die Gravitation (Schwerkraft) aufgebracht werden kann"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a9f6bf30-8602-4425-8b9d-cfa721793fed",
                                "sense_id": "4b742a31-d8b4-3217-a132-18f6f24f87b1",
                                "text": "„Die bei Schrumpfung zu gewinnende Energie also ist gegeben durch die Differenz der Gravitationsenergien im Anfangs- und Endzustand.“"
                            },
                            {
                                "example_id": "88d259a0-1d49-46be-a4a0-29c27b28c3c9",
                                "sense_id": "4b742a31-d8b4-3217-a132-18f6f24f87b1",
                                "text": "„Das Schiff bewegte sich unter Ausnutzung von Gravitationsenergien vorwärts, und davon gab es genug im Universum, sodass sie keinerlei Antriebsprobleme zu befürchten hatten, solange die Grace-Triebwerke fehlerfrei funktionierten.“"
                            },
                            {
                                "example_id": "16377082-e219-4537-af4a-3daf7944f251",
                                "sense_id": "4b742a31-d8b4-3217-a132-18f6f24f87b1",
                                "text": "„Der Effekt der Zerstörung schien sich im geheimnisvollen Bereich der Gravitationsenergien zu vollziehen, für die seine Sinne nicht geschaffen waren.“"
                            },
                            {
                                "example_id": "a7530175-7f4b-4e03-b8d1-52038f4b4887",
                                "sense_id": "4b742a31-d8b4-3217-a132-18f6f24f87b1",
                                "text": "„Die Gravitationsenergien der Ley-Linien von Himmelskörpern beeinflussen die Erde umso mehr, je näher ihr diese Himmelskörper sind.“"
                            },
                            {
                                "example_id": "97a4d91d-a116-49ce-a718-be674a4809d8",
                                "sense_id": "4b742a31-d8b4-3217-a132-18f6f24f87b1",
                                "text": "„Elektronische Transporte von Bildern und Nachrichten erfolgen mittels unterschiedlich starker Gravitationsenergien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
