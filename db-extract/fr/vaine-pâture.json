                "senses": [
                    {
                        "sense_id": "515ff16f-a8f0-356d-a781-c2ac59b7f681",
                        "entry_id": "abdc0a91-7675-3819-a8bd-04dd6491df0a",
                        "glosses": [
                            "Ensemble des terres d’une commune dont la pâture est libre, où tous les habitants d’une commune peuvent conduire leurs bestiaux pour y paître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87661f8a-701e-4bd4-b57d-c957a88e5b1b",
                                "sense_id": "515ff16f-a8f0-356d-a781-c2ac59b7f681",
                                "text": "[…] ce serait une attention bien nécessaire, bien utile à l'État, que de faire un règlement à cet égard, par lequel on abolirait les vaines pâtures en permettant les enclos."
                            }
                        ]
                    },
                    {
                        "sense_id": "309b1627-11cf-335a-a28f-8abfb7b75710",
                        "entry_id": "abdc0a91-7675-3819-a8bd-04dd6491df0a",
                        "glosses": [
                            "Ensemble des terres où il n’y a ni semences, ni fruits."
                        ],
                        "tags": [
                            "Plus généralement"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7113ad65-078a-35c1-89c6-8f9ff7c652eb",
                        "entry_id": "abdc0a91-7675-3819-a8bd-04dd6491df0a",
                        "glosses": [
                            "Droit de mener paître ses bestiaux dans les terres qui sont en cet état."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1194a658-6e22-4707-8069-4d17a15d4e9b",
                                "sense_id": "7113ad65-078a-35c1-89c6-8f9ff7c652eb",
                                "text": "Le droit de vaine pâture appartenant à la généralité des habitants et s'appliquant en même temps à la généralité d'une commune ou d'une section de commune, en vertu d'une ancienne loi ou coutume, d'un usage immémorial ou d'un titre, n'est reconnu que s'il a fait l'objet avant le 9 juillet 1890 d'une demande de maintien non rejetée par le conseil général ou par un décret en Conseil d'État."
                            },
                            {
                                "example_id": "69a3a545-03eb-41bb-8fca-f65715ca0af4",
                                "sense_id": "7113ad65-078a-35c1-89c6-8f9ff7c652eb",
                                "text": "Habitude qui remonte à l’époque dont elle fut un des derniers témoins, où la forêt était le grenier du village, où les artisans y prélevaient le bois ou l’osier dont ils avaient besoin, où l’affouage était une nécessité pour tous les foyers, où la vaine pâture, peut-être, permit à Rose de joindre les deux bouts."
                            }
                        ]
                    }
