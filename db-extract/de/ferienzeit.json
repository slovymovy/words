                        "examples": [
                            {
                                "example_id": "7470d9b1-b0b3-438d-826c-e08e48adbc18",
                                "sense_id": "485be7bd-2857-379d-bc15-aa726c0640b1",
                                "text": "„Wer die Ferienzeit im heimischen Garten verbringt stellt gerne mal das Planschbecken für die Kleinen auf.“"
                            },
                            {
                                "example_id": "dc8fc417-446e-4f7d-9e60-52cfc6348536",
                                "sense_id": "485be7bd-2857-379d-bc15-aa726c0640b1",
                                "text": "„Bei Kindern, die in einigen Fächern Probleme haben, den Schulstoff zu bewältigen, liegt es natürlich nahe, die Ferienzeit zum Aufarbeiten zu nutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
