                    },
                    {
                        "translation_id": "e2c7d867-7ed1-4e0e-8bd6-477f4d72ef0e",
                        "source_entry_id": "6f0ff526-5339-318a-ac91-1ad23852034d",
                        "source_sense_id": "27ecba5c-b2d5-32da-87c1-800b2a3650f5",
                        "target_lang_word": "Knollenfrucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knollenfrucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d65f1669-ba0a-37b5-8ce1-0a4b30b47cfe",
                                        "entry_id": "c11ff583-9b25-3e8e-b1a9-1967d043b29d",
                                        "glosses": [
                                            "Kulturpflanze, die essbare Knollen ausbildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4972ab74-e3fc-4b86-a7b4-7f3e81326930",
                                                "sense_id": "d65f1669-ba0a-37b5-8ce1-0a4b30b47cfe",
                                                "text": "„Dank der Unterstützung von Slow Food werden in den nächsten Monaten 100 Männer und 60 Frauen geschult, um die für den Anbau bestimmten Gebiete von Plastikmüll zu reinigen, die Strukturen zum Schutz der frisch gepflanzten Knollenfrüchte anzufertigen und die verschiedenen Verwendungsmöglichkeiten kennenzulernen, die die organoleptischen Eigenschaften der Pflanze am besten zur Geltung bringen.”"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d64e44e0-c4a5-3ed5-9542-806a103208e3",
                                        "entry_id": "c11ff583-9b25-3e8e-b1a9-1967d043b29d",
                                        "glosses": [
                                            "Frucht, die als Knolle einer Pflanze wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa5cbfb-b8bc-49b6-9760-0c2909c6c1da",
                                                "sense_id": "d64e44e0-c4a5-3ed5-9542-806a103208e3",
                                                "text": "„Yams, eine Knollenfrucht und das Grundnahrungsmittel, das auch zu einer Art Brot gebacken wurde, und Hirse wuchsen reichlich; ebenso Bohnen, Bataten, eine Art Süßkartoffel, und andere Gemüsesorten sowie mehrere Bananenarten, Äpfel, Feigen, Orangen, Zitronen, Ananas und viele andere Obstsorten, und natürlich Pfeffer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b232a4f-8e04-4970-81c5-42f14c05fd25",
                        "source_entry_id": "6f0ff526-5339-318a-ac91-1ad23852034d",
                        "source_sense_id": "27ecba5c-b2d5-32da-87c1-800b2a3650f5",
                        "target_lang_word": "roślina bulwiasta",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fa630b18-b0c7-4e6c-a21e-50f6fbaebcff",
                        "source_entry_id": "6f0ff526-5339-318a-ac91-1ad23852034d",
                        "source_sense_id": "27ecba5c-b2d5-32da-87c1-800b2a3650f5",
                        "target_lang_word": "tubercule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tubercule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac7fcb0e-3f17-327f-b189-45dba8bf0110",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Excroissance en forme de bosse qui survient à une feuille, à une racine d’une plante → voir tuberculé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c50dd6-d260-4a4f-af7d-6d0027467faf",
                                                "sense_id": "ac7fcb0e-3f17-327f-b189-45dba8bf0110",
                                                "text": "Al[oes] radula. Le caractère distinctif de cette espèce étant d'avoir des feuilles très alongées, et chargées de tubercules très-petits, j’ai cru pouvoir y réunir les deux variétés dont je fais mention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88031c8-f71a-3827-a6b9-6491a78cea33",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Partie renflée d’un rhizome ou d’une racine riche en substances de réserve qui assurent la survie des plantes pendant la saison d’hiver et souvent leur multiplication par voie végétative → voir tubéreux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3820c95-7913-4fb3-8e86-3d5e6245e203",
                                                "sense_id": "a88031c8-f71a-3827-a6b9-6491a78cea33",
                                                "text": "Les tubercules de Dahlias que je vous ai envoyés appartiennent à des espèces souvent naines et à tige toujours grêle; elles ont ceci de particulier, c’est que, pour la plupart, elles possèdent des tubercules comestibles qui sont appréciés des indigènes, qui les consomment crus."
                                            },
                                            {
                                                "example_id": "804a50ea-29dd-4989-992e-825e9cd33f73",
                                                "sense_id": "a88031c8-f71a-3827-a6b9-6491a78cea33",
                                                "text": "Un tubercule est l’épaississement total ou partiel d’une racine ou d’une tige. Il y a donc des tubercules-tiges (pommes de terres, crosnes, souchets, etc) et des tubercules-racines (patates, maniocs, etc.)"
                                            },
                                            {
                                                "example_id": "d1398609-5ebf-470a-a222-ceb0f6d6d366",
                                                "sense_id": "a88031c8-f71a-3827-a6b9-6491a78cea33",
                                                "text": "[…]; quant à la faible proportion des Géophytes à tubercules, si abondants dans les pelouses calcaires à Festuca du Vexin français, elle semble due ici à des conditions exclusivement édaphiques :[…]."
                                            },
                                            {
                                                "example_id": "282bae79-8d93-4d82-a299-7a0fd76b6983",
                                                "sense_id": "a88031c8-f71a-3827-a6b9-6491a78cea33",
                                                "text": "… ma mère à l'ombre de son taudis, ployée sur son chaudron, remuant machinalement un bouillon à base de tubercules aux saveurs discutables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752ad3aa-8a58-3974-af28-e681150c9aa0",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Plante produisant des tubercules, et spécialement, pomme de terre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc73cb8a-1e34-4dd4-8b5f-fe866bc70de6",
                                                "sense_id": "752ad3aa-8a58-3974-af28-e681150c9aa0",
                                                "text": "La pomme de terre, ce tubercule si précieux pour l'alimentation du pauvre, est cultivée dans toutes les parties du département, mais sur une petite échelle ; […]."
                                            },
                                            {
                                                "example_id": "e745f452-26e3-46e2-a839-2fbde8bf76f7",
                                                "sense_id": "752ad3aa-8a58-3974-af28-e681150c9aa0",
                                                "text": "Eh bien! des pommes de terre il n'y en a plus. Vous avez bien lu, je veux dire on n'en vend plus, les détenteurs de ces précieux tubercules attendent que les prix montent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ac9104-b4b4-379c-af0b-59d76471e4d8",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Éminence qui se forme sur la peau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f364fe3-5f66-3afa-a91f-d4aaaffa8961",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Altération morbide et ulcéreuse qui apparaît surtout aux poumons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1bfeca-2925-49d0-b551-cf03c0040104",
                                                "sense_id": "9f364fe3-5f66-3afa-a91f-d4aaaffa8961",
                                                "text": "Mais il y a plus: lorsque la tuberculisation pulmonaire passe à guérison, l'on rencontre en général les tubercules à l'état d’obsolescence, enveloppés d'une espèce de capsule qui les isole des parties environnantes : c’est un tissu noir induré, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3388bcf0-f781-3424-b5c7-509844844437",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Tubérosité, renflement de certains os où s’attachent des muscles ou des ligaments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69253fd6-d546-3509-92b1-c608d3d65d4e",
                                        "entry_id": "9de36171-e1bb-3695-a71e-95a5bf6338b9",
                                        "glosses": [
                                            "Bosse présente sur le bec de certains oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76544d59-0784-4b78-91b2-20babc9b8972",
                                                "sense_id": "69253fd6-d546-3509-92b1-c608d3d65d4e",
                                                "text": "L’oie de Guinée ou oie à tubercule est grise avec la poitrine blanche, les ailes et la queue brunâtres, les pieds orange ; elle porte sur le bec, comme les cygnes, un petit tubercule rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
