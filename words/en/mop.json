                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor performed with many a <w>mop</w> and mow to entertain the children.",
                            "target_lang_translations": {
