                "senses": [
                    {
                        "sense_id": "b6d3c123-0d30-32ba-a118-2caf252a3f18",
                        "entry_id": "7518ca37-1f8e-336c-aa57-0b57fb7f987c",
                        "glosses": [
                            "Ne plus appesantir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ecd7f4e-17b9-4b43-b333-a4eebed743e6",
                                "sense_id": "b6d3c123-0d30-32ba-a118-2caf252a3f18",
                                "text": "Histoire de désappesantir, Renata propose à Iris de visiter l’appartement et d’aller découvrir sa chambre."
                            },
                            {
                                "example_id": "2b11f5af-bc20-4bc0-8a05-857cc06a9565",
                                "sense_id": "b6d3c123-0d30-32ba-a118-2caf252a3f18",
                                "text": "Je sens les chaînes des passions se désappesantir, les vues de l’éternité devenir plus consolantes de jour en jour, et les petites tracasseries de la vie humaine me paraissent tous les jours plus puériles."
                            }
                        ]
                    }
                ],
