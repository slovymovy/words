                            }
                        },
                        {
                            "text": "We found several people with the last name <w>Tingle</w> while researching our family history.",
                            "target_lang_translations": {
                                "ru": "Мы нашли несколько человек с фамилией <w>Тингл</w>, изучая историю нашей семьи.",
                                "zh": "在研究家族史时，我们发现了几个姓<w>廷格尔</w>的人。"
                            }
                        }
                    ],
                    "traits": [
