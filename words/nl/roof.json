                {
                    "sense_id": "74541920-ec03-3e8a-b157-065ecd0c0a5f",
                    "sense_definition": "de harde korst die zich op een genezende wond vormt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet niet aan de <w>roof</w> krabben, want dan gaat de wond weer bloeden.",
                            "target_lang_translations": {
                                "en": "You shouldn't scratch the <w>scab</w>, because then the wound will start bleeding again.",
                                "ru": "Не стоит ковырять <w>струп</w>, иначе рана снова начнет кровоточить."
                            }
                        },
                        {
                            "text": "Er zit een dikke <w>roof</w> op zijn knie nadat hij gisteren hard gevallen is.",
                            "target_lang_translations": {
                                "en": "There is a thick <w>scab</w> on his knee after he had a hard fall yesterday.",
                                "ru": "На его колене образовалась толстая <w>корочка</w> после того, как он вчера сильно упал."
                            }
                        }
