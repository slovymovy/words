                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4d011e4-8fef-3671-97db-4bf7d21353bd",
                                        "entry_id": "9f9a4a58-2d1d-3877-9a94-47ffffd263f1",
                                        "glosses": [
