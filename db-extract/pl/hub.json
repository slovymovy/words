                                    },
                                    {
                                        "sense_id": "db130989-cc30-327b-b12c-33c7891ee83e",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A rough protuberance or projecting obstruction."
