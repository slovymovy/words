                "senses": [
                    {
                        "sense_id": "4f4f7ac6-f9ad-3073-b5db-d22b79f08200",
                        "entry_id": "18e83630-05c7-387c-871a-92b31a7de6de",
                        "glosses": [
                            "übermäßiger, unkontrollierter, zwanghafter Konsum von Betäubungsmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49d61e7c-cd06-4309-9428-0e6044898662",
                                "sense_id": "4f4f7ac6-f9ad-3073-b5db-d22b79f08200",
                                "text": "„Die Zahl der wegen Morphin- und anderer Betäubungsmittelsuchten in den Heilanstalten für Geistes- und Nervenkranke behandelten Personen, die in der Vorkriegszeit jährlich rund 500 betrug, ist seit dem Jahre 1923 […] gestiegen."
                            },
                            {
                                "example_id": "0ddcb1b6-0494-4870-bdaf-a433e95a4eb9",
                                "sense_id": "4f4f7ac6-f9ad-3073-b5db-d22b79f08200",
                                "text": "„Dem Abkommen liegt die in der Präambel als „Erkenntnis“ bezeichnete Auffassung zugrunde, „dass die Betäubungsmittelsucht für den Einzelnen ein Übel und für die Menschheit eine wirtschaftliche und soziale Gefahr darstellt“."
                            },
                            {
                                "example_id": "60af62b6-ac61-4984-9bb3-8f2301c59acf",
                                "sense_id": "4f4f7ac6-f9ad-3073-b5db-d22b79f08200",
                                "text": "„Das Angebot der MSH 1 stützt sich auf das Bundesgesetz über die Betäubungsmittel und die psychotropen Stoffe vom 20. März 2008, in Kraft seit 1. Januar 2010. Die MSH 1 erfüllt die in der «Verordnung über Betäubungsmittelsucht und andere suchtbedingte Störungen» und ist im Besitz der erforderlichen Betriebsbewilligungen für die ärztliche Verschreibung von Diacetylmorphin (Heroin)."
                            },
                            {
                                "example_id": "9f239bdc-ee57-419b-abc7-47ba3f0734d2",
                                "sense_id": "4f4f7ac6-f9ad-3073-b5db-d22b79f08200",
                                "text": "„Er habe verstanden, dass er sich mit seiner Spielsucht und Betäubungsmittelsucht auseinandersetzen müsse.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
