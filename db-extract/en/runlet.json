                        "sense_id": "232c8b19-f6df-3b82-9e06-21a222441278",
                        "entry_id": "35636f99-7020-3d60-b928-5e4cb8330978",
                        "glosses": [
                            "A small brook or stream."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9782e510-718a-4d01-b873-7119a8cc5ab7",
                                "sense_id": "232c8b19-f6df-3b82-9e06-21a222441278",
                                "text": "The biographer, especially of a literary man, need only mark the main currents of tendency, without being officious to trace out to its marshy source every runlet that has cast in its tiny pitcherful with the rest."
                            },
                            {
                                "example_id": "8396176e-1fcf-4c11-8cae-18fe0d7259ef",
                                "sense_id": "232c8b19-f6df-3b82-9e06-21a222441278",
                                "text": "She followed the dry runlet to where a jutting shoulder formed a nook matted with briars."
                            }
                        ]
                    }
