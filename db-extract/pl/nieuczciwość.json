                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malhonnêteté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f428b64f-ce42-3b4f-b8ea-bc07bf9e3f3d",
                                        "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                                        "glosses": [
                                            "Défaut d’honnêteté, de probité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b285675-653a-44d9-a3aa-de3e515beb84",
                                                "sense_id": "f428b64f-ce42-3b4f-b8ea-bc07bf9e3f3d",
                                                "text": "Le groupe se doit d'être vigilant et de dénoncer sans réserve la supercherie, le charlatanisme et la malhonnêteté dont font preuves ceux dont le but est d'attirer des sympathisants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a335bea-688f-3801-94b3-f5ce70d7b9c4",
                                        "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                                        "glosses": [
                                            "Incivilité, manque de bienséance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c17711-2b6e-432f-a800-26b7a5e792f8",
                                                "sense_id": "2a335bea-688f-3801-94b3-f5ce70d7b9c4",
                                                "text": "Il est d’une malhonnêteté révoltante."
                                            },
