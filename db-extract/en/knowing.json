                    {
                        "sense_id": "d2828628-48d5-3b46-a4e6-802196aae3e3",
                        "entry_id": "a90a1422-c54c-392b-bc63-c7fd2b4b9819",
                        "glosses": [
                            "Shrewd or showing clever awareness; discerning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b1afe8-51fc-434a-bea6-ff58ecf1dba1",
                                "sense_id": "d2828628-48d5-3b46-a4e6-802196aae3e3",
                                "text": "a knowing rascal"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b9c3191-ba2f-3709-a83f-e586d1aa4e25",
                        "entry_id": "a90a1422-c54c-392b-bc63-c7fd2b4b9819",
                        "glosses": [
                            "Demonstrating knowledge of what is in fashion; stylish, chic."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "995743ba-352d-4c4b-ad8c-b6ef6866f162",
                                "sense_id": "9b9c3191-ba2f-3709-a83f-e586d1aa4e25",
                                "text": "‘I was a raw boy from College, and fancied it very knowing to marry a girl that all the young fellows of my acquaintance reckoned so confounded handsome.’"
                            },
                            {
                                "example_id": "b37f6336-b5fb-4203-93b7-ca0833c2ec96",
                                "sense_id": "9b9c3191-ba2f-3709-a83f-e586d1aa4e25",
                                "text": "Tom thought his cap a very knowing affair, but confessed that he had a hat in his hat-box; which was accordingly at once extracted from the hind-boot, and Tom equipped in his go-to-meeting roof, as his new friend called it."
                            }
                        ]
                    },
                    {
                        "sense_id": "c84fc7f4-8958-31a6-946e-1921cf0601e1",
                        "entry_id": "a90a1422-c54c-392b-bc63-c7fd2b4b9819",
                        "glosses": [
                            "Suggestive of private knowledge or understanding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f7dfff4-2d1c-46ad-965a-7f522b7b598f",
                                "sense_id": "c84fc7f4-8958-31a6-946e-1921cf0601e1",
                                "text": "Jon and Tyrion greet each other with the words that have been used against them as weapons, sharing a knowing smile."
                            }
                        ]
                    }
                ],
