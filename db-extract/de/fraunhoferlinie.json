                    {
                        "sense_id": "11edd67f-bd0a-3a2c-b600-913674d5e162",
                        "entry_id": "ace7a5ac-d71f-36b5-a042-88429bde1484",
                        "glosses": [
                            "Absorptionslinie im Sonnenspektrum"
