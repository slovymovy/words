    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c09a2f7f-00ed-3e98-90c1-08b70143dafe",
                    "sense_definition": "het verschil tussen de hogere actuele marktwaarde van een bezit (zoals een woning) en de resterende schuld of hypotheek daarop; meerwaarde",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de stijgende huizenprijzen heeft hun woning nu een aanzienlijke <w>overwaarde</w>.",
                            "target_lang_translations": {
                                "en": "Due to rising house prices, their home now has considerable <w>equity</w>."
                            }
                        },
                        {
                            "text": "Ze besloten de <w>overwaarde</w> van hun huis te benutten voor een verbouwing.",
                            "target_lang_translations": {
                                "en": "They decided to use the <w>home equity</w> from their house for a renovation."
                            }
                        }
                    ],
                    "synonyms": [
                        "meerwaarde"
                    ],
                    "antonyms": [
                        "onderwaarde"
                    ],
                    "common_phrases": [
                        "overwaarde op het huis",
                        "overwaarde gebruiken",
                        "overwaarde verzilveren"
                    ],
                    "target_lang_definitions": {
                        "en": "the difference between the higher current market value of a property (such as a home) and the remaining mortgage or debt secured against it; home equity or surplus value"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "equity",
                                "target_lang_sense_clarification": "the value of a property beyond the remaining debt or mortgage"
                            },
                            {
                                "target_lang_word": "home equity",
                                "target_lang_sense_clarification": "specifically the market value of a house minus the mortgage"
                            },
                            {
                                "target_lang_word": "surplus value",
                                "target_lang_sense_clarification": "excess or added financial value"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a9b13eee-548a-3054-85ba-5a83f3643fd7",
                    "sense_definition": "verbogen vorm van de stellende trap van <w>overwaard</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn grote inzet was deze <w>overwaarde</w> inspanning meer dan waard.",
                            "target_lang_translations": {
                                "en": "His great dedication was more than worth this <w>invaluable</w> effort."
                            }
                        },
                        {
                            "text": "Het betrof een <w>overwaarde</w> bijdrage aan het onderzoeksproject.",
                            "target_lang_translations": {
                                "en": "It was a <w>highly valued</w> contribution to the research project."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verbogen vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "inflected form of overwaard; of exceedingly great value or worth"
                    },
                    "translations": {
