                                        "entry_id": "4ac8b77a-922d-330c-ae1a-a1dbfe810e74",
                                        "glosses": [
                                            "To refuse, decline, or deny."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd379fc6-23eb-4d71-9f0e-7469c1662971",
                                                "sense_id": "ebfb63a5-84a3-3c79-866e-66a041df1eea",
                                                "text": "He turned down all our offers of help."
                                            },
                                            {
                                                "example_id": "8cac91d2-1809-4582-9762-4f07ca7bcccb",
                                                "sense_id": "ebfb63a5-84a3-3c79-866e-66a041df1eea",
                                                "text": "A local doctor had bought one canvas and but for that lucky chance he would have been out of pocket. Now he was muttering grumpily at Edmund, \"Have to get something better this trip, Edmund. Got to pull up somehow or buyers will be turnin' us down. Sales been gettin' worse and worse these last years.\""
                                            },
                                            {
                                                "example_id": "f8ad98c1-65b1-49c9-9acd-c7b2ed98ddaa",
                                                "sense_id": "ebfb63a5-84a3-3c79-866e-66a041df1eea",
                                                "text": "Govia Thameslink Railway declined to comment on the study and turned down our request for an interview to address the issues raised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cccb70f-b878-392c-9f45-7e54780590d4",
                                        "entry_id": "4ac8b77a-922d-330c-ae1a-a1dbfe810e74",
                                        "glosses": [
                                            "To reduce the power, etc. of something by means of a control, such as the volume, heat, or light."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f46c800-e45f-4598-a75d-d90969d1f2c1",
                                                "sense_id": "3cccb70f-b878-392c-9f45-7e54780590d4",
                                                "text": "Turn down the television so I can hear myself think."
                                            },
                                            {
                                                "example_id": "814dab59-c6ad-45ec-bfef-696db1d81057",
                                                "sense_id": "3cccb70f-b878-392c-9f45-7e54780590d4",
                                                "text": "When it starts to boil, turn down the heat to a simmer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae5ab255-ce16-39cf-87fa-d7bafc17fd56",
                                        "entry_id": "4ac8b77a-922d-330c-ae1a-a1dbfe810e74",
                                        "glosses": [
                                            "To reposition by turning, flipping, etc. in a downward direction; to double or fold down."
                                        ],
