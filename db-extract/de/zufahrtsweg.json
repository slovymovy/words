                "senses": [
                    {
                        "sense_id": "73ef1ec3-231f-375f-880a-76c4bebbdbb3",
                        "entry_id": "63c874db-9b3e-38c7-9888-004379f36994",
                        "glosses": [
                            "sogenannter Weg, der sicherstellt beziehungsweise die Möglichkeit bietet, dass eine bestimmten Sache (per fahren) erreichbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e60b6ed-3a03-494d-be3e-f7596b32b4c0",
                                "sense_id": "73ef1ec3-231f-375f-880a-76c4bebbdbb3",
                                "text": "„Im gesamten Land verhinderten Sicherheitskräfte Protestaktionen im Vorfeld, indem sie Zufahrtswege sperrten oder Menschen in Gewahrsam nahmen.“"
                            },
                            {
                                "example_id": "07f5d244-c952-41fd-9b57-8f7c5a6a8cce",
                                "sense_id": "73ef1ec3-231f-375f-880a-76c4bebbdbb3",
                                "text": "„Die Clubs und die Ferienhäuser sind fest verschlossen, ihre Zufahrtswege von Schranken versperrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
