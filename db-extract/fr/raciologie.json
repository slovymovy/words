                        "sense_id": "6d749809-da9a-3100-ab26-316211bf45a9",
                        "entry_id": "0ece70f9-a93f-3166-81f4-da8cab1272d4",
                        "glosses": [
                            "Anthropologie raciale."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "71ed4d17-b3c8-4753-8050-8e22f214f6cd",
                                "sense_id": "6d749809-da9a-3100-ab26-316211bf45a9",
                                "text": "La raciologie républicaine fin de siècle a donné naissance à un paradigme racial, vision du monde largement partagée par la communauté anthropologique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d305443b-9c41-4a84-a951-7625feccabcf",
                        "source_entry_id": "0ece70f9-a93f-3166-81f4-da8cab1272d4",
                        "source_sense_id": "6d749809-da9a-3100-ab26-316211bf45a9",
                        "target_lang_word": "Rassenkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rassenkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "177f03b3-2da5-32ff-846f-6ee1b5399eb0",
                                        "entry_id": "1cdd24c5-d486-3127-b094-173711ab084f",
                                        "glosses": [
                                            "Gebiet der Anthropologie, dessen Gegenstand die (vermeintlich) existierenden menschlichen Rassen, ethnischen Gruppen und ihre Entwicklung waren"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2165c547-61f2-4ff0-9f52-fbdfa0428889",
                                                "sense_id": "177f03b3-2da5-32ff-846f-6ee1b5399eb0",
                                                "text": "„Wie man weiß, wurde die Biologie, der die „Rassenkunde“ entsprang, selbst rücksichtslos zur politischen Zweckwissenschaft degradiert und nihilistischen Zielsetzungen geopfert;“"
                                            },
                                            {
                                                "example_id": "05312d85-cb49-4b35-acbe-07088d95b4de",
                                                "sense_id": "177f03b3-2da5-32ff-846f-6ee1b5399eb0",
                                                "text": "„In den Jahren nach dem Ersten Weltkrieg sollten dann Eugenik, Rassenhygiene und Rassenkunde unter dem angeblichen Eindruck der weiteren Schwächung des deutschen Volkskörpers (der deutschen Erbsubstanz) einen nachhaltigen konjunkturellen Aufschwung erfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
