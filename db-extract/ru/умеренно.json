                        "source_entry_id": "231ed400-7fd0-3ba8-8d0c-16b9e83ea913",
                        "target_lang_word": "reasonably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reasonably",
