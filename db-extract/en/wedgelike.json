                "senses": [
                    {
                        "sense_id": "0d3e8b45-c887-3944-af73-3d2821f9d962",
                        "entry_id": "d6f18353-8c69-32a2-b7de-602b25eed099",
                        "glosses": [
                            "Shaped like a wedge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4330ee-6c2b-4001-8293-8bee92b6c2d5",
                                "sense_id": "0d3e8b45-c887-3944-af73-3d2821f9d962",
                                "text": "He looks, he feels, and satisfies himself: the driving forward with fury, its prodigious stiffness, thus impacted, wedgelike, breaks the union of those parts, and gain'd him just the insertion of the tip of it, lip-deep; which being sensible of, he improved his advantage, and following well his stroke, in a straight line, forcibly deepens his penetration",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "535fa0ac-1c14-4333-b501-69c37f45edf1",
                        "source_entry_id": "d6f18353-8c69-32a2-b7de-602b25eed099",
                        "source_sense_id": "0d3e8b45-c887-3944-af73-3d2821f9d962",
                        "source_sense_description": "shaped like a wedge — see also cuneiform",
                        "target_lang_word": "keilförmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keilförmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                        "entry_id": "5d4c8d80-19a1-365f-8f62-d194f4c4b81d",
                                        "glosses": [
                                            "in Form eines Keils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc6434e-9c97-4c38-a33e-d85eb6c131e2",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Als Horn von Afrika wird umgangssprachlich der östlichste, keilförmige Teil Ost-Afrikas bezeichnet.“"
                                            },
                                            {
                                                "example_id": "d68486e0-39c7-4a34-bff1-dd80da241944",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Der Kopf der Siamkatze ist, je nach Unterscheidung in modernen oder traditionellen Typ, keilförmig bis leicht rundlich.“"
                                            },
                                            {
                                                "example_id": "3acc6086-d3fe-408d-a5d2-c6dd43f22f46",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Wildschweine haben einen keilförmigen Kopf; die Schnauze selbst ist stumpf und endet in einem Rüssel.“"
                                            },
                                            {
                                                "example_id": "438973ef-f312-4e51-a8cd-84bf55e142fb",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Ganz im Norden, wo die Berliner Stadtteile Hermsdorf und Frohnau an Glienicke grenzen,“ […] „ragte die DDR keilförmig in West-Berliner Gebiet hinein.“"
                                            },
                                            {
                                                "example_id": "d5b453b6-160b-4a65-ad56-88dbfdb28da1",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Seit Jahren zieht es George Smith, Lehrling in der angrenzenden Druckerei, in die archäologische Orient-Abteilung. Stur nutzt er jede Mittagspause, um in der Nähe der geheimnisvollen, eng beschrieben Täfelchen sein zu können. Die uralte, keilförmige Schrift lässt ihn nicht mehr los.“"
                                            },
                                            {
                                                "example_id": "24bc98d5-951f-4dce-bacf-78b5c915184d",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "[Hyperschallwaffen:] „Die beiden in Phase eins entwickelten keilförmigen Flugkörper, die Geschwindigkeiten von Mach 10 erreichen können, werden nun im Windkanal getestet.“"
                                            },
                                            {
                                                "example_id": "ffc30cdd-fd02-4f28-a1ea-48d419936265",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Vor der Zubereitung sollte man beim Chicorée in der Regel den Strunk entfernen, denn er schmeckt oft sehr bitter. Dazu das Gemüse am besten halbieren und den Stunk keilförmig herausschneiden.“"
                                            },
                                            {
                                                "example_id": "a4f3b1c2-2849-4f1b-830a-ba7f735ec0d6",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Biber haben die Wiesen an der Nahe erobert und nagen dort Bäume keilförmig ab,“ […]."
                                            },
                                            {
                                                "example_id": "2c55bb6a-dc8b-46f9-a24b-943914218cab",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "[Rückspiegel im Auto:] „Der Trick ist: Die Glasscheibe ist keilförmig. Das heißt, Vorder- und Rückseite der Glasplatte sind nicht parallel, sondern bilden einen kleinen Winkel von 3 bis 5°. Das ist der Winkel, um den man in der Dunkelheit den Spiegel nach oben klappen muss, um diesen Abdunkelungseffekt zu erzielen.“"
                                            },
                                            {
                                                "example_id": "f2f7c784-d5e3-4305-8060-ff13f7211752",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "Aus einer runden Torte schneidet man am besten keilförmige Stücke heraus."
                                            },
                                            {
                                                "example_id": "94809885-5c66-4eb5-ae65-a3bb7ca2667a",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "[Rundlingsdörfer im Wendland] „In kleinen Dorfgemeinschaften, den alten Bauernhäusern, die keilförmig um einen runden Platz gebaut sind, leben die unterschiedlichsten Menschen gemeinsam auf engstem Raum.“"
                                            },
                                            {
                                                "example_id": "b571a57c-acd0-4657-8841-aa070a939c9c",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Die Anden wachsen auf der regenreichen Ostseite weiter, während sie auf der weitgehend trockenen Westseite nahezu stationär sind und sich kaum weiter verändern. Das kommt daher, dass die West- und Ostflanken der Anden keilförmig aufgebaut sind.“"
                                            },
                                            {
                                                "example_id": "cf844e78-3119-4d4c-ae77-100805fbef6e",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Der Hüftzapfen (regional auch Hüftdeckel genannt) ist ein dünnes, keilförmiges Fleischstück, das zwischen der dicken und schmalen Hüfte liegt.“"
                                            },
                                            {
                                                "example_id": "bd4e2bd5-13c1-42d0-88c0-7745ecb5c0b1",
                                                "sense_id": "6630922f-c88d-3b0f-9e65-d7b02d10a07a",
                                                "text": "„Bei Frau Hertnagel, die schon mehrfach operiert worden war, wurden aus der unteren Wirbelsäule Knochen keilförmig entfernt, um der Verkrümmung der oberen Wirbelsäule entgegenzuwirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
