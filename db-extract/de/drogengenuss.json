                "senses": [
                    {
                        "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                        "entry_id": "f4f1534d-6c79-301c-a7a3-4bfd37b8d8c8",
                        "glosses": [
                            "Einnahme, Zufuhr von Drogen (was Freude und Wohlbefinden bereitet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ebc42fb-2ebe-4e7b-a886-b80a251f6695",
                                "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                                "text": "„Neben Drogengenuss und Prostitution sind auch Alkoholgenuss und Betteln in der Öffentlichkeit künftig in Tossa de Mar nicht mehr erlaubt.“"
                            },
                            {
                                "example_id": "6f079ee1-520d-402a-8f29-a5564dcde23d",
                                "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                                "text": "„Die Wohnung erweist sich als Höhle, in der Gassenjargon, Gewalt, Drogengenuss und das Vorzeigen von Emblemen der Neonazis die Normalität sind.“"
                            },
                            {
                                "example_id": "329c6ff6-1743-47b2-accc-6deb2b0fd6fb",
                                "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                                "text": "„Ist der tierische Alkohol- und Drogengenuss Absicht oder Versehen?“"
                            },
                            {
                                "example_id": "5a36a7f1-91e1-4ec6-8363-cc0f0267c1ef",
                                "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                                "text": "„Der lebe noch, 85 Jahre alt, in Hamburg, jedoch, nach lebenslangem exzessivem Drogengenuss, in anderen, unerreichbaren Geistessphären.“"
                            },
                            {
                                "example_id": "b930ad63-5f52-4b48-8039-255422042e1c",
                                "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                                "text": "„Übrigens, neben Corona sind auch Vereinsamung, Existenzangst, Depressionen, Alkohol- und Drogengenuss oder häusliche Gewalt ernstzunehmende Gesundheitsgefahren, die bei einer langen Rezession mit noch mehr Pleiten und Entlassungen noch verschärft werden.“"
                            },
                            {
                                "example_id": "4a05d677-0959-44a0-90c7-ce924dda4c19",
                                "sense_id": "acab6820-34d9-3fba-9777-806d6d058910",
                                "text": "„Die Linkspartei schlägt wiederum eine Entlastung der Polizei vor, indem sie ‚von der Verfolgung von Bagatelldelikten wie illegale Einreise, Schwarzfahren, Drogengenuss‘ befreit werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
