                "senses": [
                    {
                        "sense_id": "aa3aabcf-2471-3828-8d11-555780dffdd3",
                        "entry_id": "5678d13c-1adb-3597-8a33-f5be4255e3c4",
                        "glosses": [
                            "Anzahl der unterschiedlichen Einzelbilder pro Zeiteinheit, aus denen ein Film oder ein anderes bewegtes Bild besteht"
                        ],
                        "tags": [
                            "Filmtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4ad412-7ba0-414d-803b-8ae91a364c93",
                                "sense_id": "aa3aabcf-2471-3828-8d11-555780dffdd3",
                                "text": "„Die Übertragung von Gebärdensprache erfordert eine ausreichend hohe Bildrate und Auflösung, um gute Verständlichkeit zu gewährleisten.“"
                            },
                            {
                                "example_id": "3b612737-cdb8-4df7-aee9-a3210f14cfbe",
                                "sense_id": "aa3aabcf-2471-3828-8d11-555780dffdd3",
                                "text": "„Allerdings müssen die Kinofilme dafür auch mit einer höheren Bildrate gedreht worden sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
