                    },
                    {
                        "form_id": "a60b0003-65e5-41cc-bf8d-9a007540fbf0",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Formation"
                    },
                    {
                        "form_id": "5e427f8a-d630-4bce-823b-b1c587883ddc",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Formationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d641025-8430-3e48-8951-418aeb72eeee",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "Gruppe von Menschen gemeinsamer Absicht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab83683-e20d-4c7e-84db-77ff908d3a63",
                                "sense_id": "0d641025-8430-3e48-8951-418aeb72eeee",
                                "text": "„In unterschiedlichen Formationen tüfteln parteinahe und externe Experten an dem Papier, das (zufällig) ebenfalls Ende März, Anfang April aus der Taufe gehoben werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df80f1e6-0387-3224-b735-96eaa8acd8aa",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "Gruppe von Menschen gemeinsamer Absicht",
                            "Untergliederung eines militärischen Verbandes"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "38926b41-f0a2-405a-a55b-3b37376d4b86",
                                "sense_id": "df80f1e6-0387-3224-b735-96eaa8acd8aa",
                                "text": "„Sie marschierten in offener Formation, einige auf dem Gehsteig, die übrigen auf der Straße, schwitzend in ihren Uniformen und unter dem Gewicht der Waffen.“"
                            },
                            {
                                "example_id": "d0387c6e-b14b-4a82-bd7e-bc82002cb4d0",
                                "sense_id": "df80f1e6-0387-3224-b735-96eaa8acd8aa",
                                "text": "„Rechts und links von dem Pfahl standen geschlossene französische Formationen mit blauen Monturen, roten Epauletten, Stiefeletten und Tschakos.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "dabe0fd5-ddf8-3dcb-8825-6e4a181df551",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "Gruppe von Menschen gemeinsamer Absicht",
                            "Mannschaft beim Formationstanz und beim Boule-Spiel"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "755356a4-da2c-3645-a996-c56dd60b0d94",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "Gruppe von Menschen gemeinsamer Absicht",
                            "Gruppe aus mehreren Musikern"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "fae3c616-9f80-4ca8-aa57-ffbcf4a70936",
                                "sense_id": "755356a4-da2c-3645-a996-c56dd60b0d94",
                                "text": "„Fünf Formationen treten an, mit vielen seit Jahrzehnten bewährten Spezialisten des Genres.“"
                            }
                        ],
                        "sense_index_json": "\"1c\""
                    },
                    {
                        "sense_id": "d509f070-557f-3039-9f5b-cbddb70b2f22",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "geometrische Anordnung fliegender Objekte"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "37cc909f-2e4e-467b-8685-6c4ccf1c82a7",
                                "sense_id": "d509f070-557f-3039-9f5b-cbddb70b2f22",
                                "text": "„Wenn eine an der Spitze der Formation fliegende Wildgans müde wird, lässt sie sich an das Ende zurückfallen, während die unmittelbar hinter ihr fliegende Gans die Führung übernimmt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "71f27e33-87d8-3608-bf97-126cf4e76b3a",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "einheitliche Vegetationsdecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f8a8d5-7439-4b10-bed6-6670b1233d01",
                                "sense_id": "71f27e33-87d8-3608-bf97-126cf4e76b3a",
                                "text": "„Unter dem Typus der Tundren könnte man vielleicht alle vegetationsärmeren Formationen zusammenfassen, denen Lagerpflanzen, Moose und Flechten, unter Beimischung mancher anderen genügsamen Pflanzen den Charakter geben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "8e39786e-2501-3f9e-bc2c-8d0ca847100e",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "das Formen/Gestalten von etwas, die Formung/Bildung einer Sache/Person"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "02dfe13e-8923-4587-9763-5e819d97eadc",
                                "sense_id": "8e39786e-2501-3f9e-bc2c-8d0ca847100e",
                                "text": "„Zusätzlich zum Studium sieht man die Notwendigkeit, den Studierenden auch Angebote für ihre spirituelle und ‚ganzheitliche‘ Formation zu machen.“"
                            },
                            {
                                "example_id": "5a37c82f-dbd4-4e7f-a385-f0d7a6b0b9b2",
                                "sense_id": "8e39786e-2501-3f9e-bc2c-8d0ca847100e",
                                "text": "„Die Rekonstruktion eines Diskurses ist nach Foucault organisiert durch ein analytisches Wechselverhältnis zwischen der Ebene der Aussagen und der Ebene der diskursiven Formation.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "c8bfbc59-4d8b-36f2-95ac-50faac30f644",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "Erstladung von Akkumulatoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03c3132b-dcb8-4e46-aa5f-8c750f2b7969",
                                "sense_id": "c8bfbc59-4d8b-36f2-95ac-50faac30f644",
                                "text": "„Dem kommt entgegen, daß im Akkumulator bei der Formation die Leitfähigkeit stark erhöht wird.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "fa706abe-620a-3eaa-b68a-8cd55ae1c5f3",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "Blattbildung bei der Papierherstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "defdbad9-e1f0-42f0-8ac2-55f542d13c21",
                                "sense_id": "fa706abe-620a-3eaa-b68a-8cd55ae1c5f3",
                                "text": "„Zur optimalen Bedruckbarkeit erfordert das Papier eine besonders gute Formation, Glätte und Dimensionsstabilität.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "22146625-d651-380c-ab70-df4fa96a4798",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "deutlich unterscheidbare Gesteinseinheit"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"8\""
                    },
                    {
                        "sense_id": "235259ea-91dd-3f9d-ae14-ffc5afce7035",
                        "entry_id": "78960ccb-89e1-3781-8df2-f8d3f91c783c",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "c628e05a-5708-4b3b-bd6d-57a8035d0243",
                                "sense_id": "235259ea-91dd-3f9d-ae14-ffc5afce7035",
                                "text": "„Formationen der Art findet man übrigens, wenn man nach dem gegenwärtigen Becken des mittelländischen Meere» hin vorschreitet; […]“"
                            }
                        ],
                        "sense_index_json": "\"7\""
                    }
