                {
                    "sense_id": "097f6831-3f8f-3d32-9903-6ff24821c044",
                    "sense_definition": "the process of putting food into glass containers for preservation",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jarring</w> of peaches took place at the end of the harvest season to keep them for winter.",
                            "target_lang_translations": {
                                "ru": "<w>Консервирование</w> персиков происходило в конце сезона сбора урожая, чтобы сохранить их на зиму.",
                                "zh": "桃子的<w>装罐</w>工作在收获季节末期进行，以便留到冬天食用。",
                                "cs": "<w>Zavařování</w> broskví probíhalo na konci sklizně, aby se uchovaly na zimu."
                            }
                        },
                        {
                            "text": "She spent the whole afternoon in the kitchen busy with the <w>jarring</w> of homemade strawberry jam.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день на кухне, занимаясь <w>закаткой</w> домашнего клубничного варенья.",
                                "zh": "她整个下午都在厨房忙着制作自制草莓酱的<w>装罐</w>。",
                                "cs": "Strávila celé odpoledne v kuchyni, kde se věnovala <w>zavařování</w> domácí jahodové marmelády."
                            }
                        }
                    ],
                    "synonyms": [
                        "canning",
                        "bottling"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс помещения продуктов в стеклянные емкости для консервации",
                        "zh": "将食物装入玻璃容器中进行保存的过程",
                        "cs": "proces plnění potravin do skleněných nádob za účelem konzervace"
                    },
                    "translations": {
                        "ru": [
