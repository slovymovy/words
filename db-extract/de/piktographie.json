                ],
                "senses": [
                    {
                        "sense_id": "58cb0017-3fb6-3a37-85ad-429bf6cd18c3",
                        "entry_id": "662d860e-9b85-31d2-886f-41cd864fb6f4",
                        "glosses": [
                            "Wiedergabe von Wörtern durch Bildzeichen, das heißt einzelne graphische Zeichen (= Piktogramme), die für eine bestimmte Bedeutung stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5cb62b5-c983-42f7-a907-045a1b2f8d8d",
                                "sense_id": "58cb0017-3fb6-3a37-85ad-429bf6cd18c3",
                                "text": "„Piktographie liegt vor, wenn ein Bild nichts anderes als den Gegenstand versinnbildlichen soll, den es darstellt; wenn man also etwa einen Kreis mit Strahlenkranz für den Begriff und das Wort »Sonne« schreibt und so den Kreis mit Strahlenkranz als reines Bildzeichen (Piktogramm) verwendet.“"
                            },
                            {
                                "example_id": "3b553499-925d-4598-9e90-b91e41e1d3e1",
                                "sense_id": "58cb0017-3fb6-3a37-85ad-429bf6cd18c3",
                                "text": "„Die erste Art ist die älteste, archaische, die sogenannte „Piktographie“: man denke zum Beispiel an die altägyptischen Hieroglyphen, Gegenstände oder Lebewesen wurden abgemalt, wurden gezeichnet: die Sonne, ein stehender Vogel, ein fliegender Vogel, ein stehender Mensch, ein laufender Mensch, eine offene Blüte, ein Fisch, ein Boot, ein Haus undsoweiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
