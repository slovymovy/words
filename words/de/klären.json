                    "frequency": "High",
                    "semantic_group_id": "verstehen_loesen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen das Missverständnis in Ruhe <w>klären</w>, bevor wir eine endgültige Entscheidung treffen."
                        },
                        {
                            "text": "Die Polizei konnte den genauen Ablauf des Unfalls erst nach vielen Zeugenaussagen <w>klären</w>."
                        }
                    ],
                    "antonyms": [
