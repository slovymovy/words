                                "target_lang_sense_clarification": "to correspond or match up"
                            },
                            {
                                "target_lang_word": "be consistent (with)",
                                "target_lang_sense_clarification": "to not contradict something else"
                            },
                            {
                                "target_lang_word": "square (with)",
                                "target_lang_sense_clarification": "to match or be in harmony with"
