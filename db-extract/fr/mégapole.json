                ],
                "senses": [
                    {
                        "sense_id": "87d27093-939e-30d1-9098-d7e4217536b5",
                        "entry_id": "76328d26-2e88-38c0-b8eb-a1b10e155f3f",
                        "glosses": [
                            "Très grande agglomération, comportant plusieurs millions d’habitants."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "482d5fa7-f3e8-4004-837a-512f7f3bcd8d",
                                "sense_id": "87d27093-939e-30d1-9098-d7e4217536b5",
                                "text": "Ce patchwork est encore plus manifeste dans les mégapoles, l’archétype étant New York avec ses communautés irlandaise, italienne, chinoise…, leurs quartiers et leurs festivités."
                            },
                            {
                                "example_id": "2b94e9f5-df26-44cc-a9a3-585428e91a08",
                                "sense_id": "87d27093-939e-30d1-9098-d7e4217536b5",
                                "text": "Aujourd’hui, plus de la moitié de la population mondiale vit dans des mégapoles."
                            },
                            {
                                "example_id": "cd6611ae-6a42-4e1c-8b43-b85a308098d3",
                                "sense_id": "87d27093-939e-30d1-9098-d7e4217536b5",
                                "text": "NTT Docomo couvre pour le moment en LTE les trois mégapoles de Tokyo, Nagoya et Osaka."
                            },
                            {
                                "example_id": "45ba6936-ce94-418c-b36e-e65985f8669a",
                                "sense_id": "87d27093-939e-30d1-9098-d7e4217536b5",
                                "text": "Pour les pays les plus pauvres, les gouvernements vont être confrontés à la difficulté de trouver un travail à l’armada de jeunes qui arrivera sur le marché. Sans compter le réchauffement climatique, la sécheresse et l’explosion incontrôlée des mégapoles."
                            }
                        ]
                    }
                ],
                "translations": [
