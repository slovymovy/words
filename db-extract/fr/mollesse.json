        "fr-extract.jsonl": [
            {
                "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                "word": "mollesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf4c2da7-6794-47e0-999d-b0d495894170",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "tags": [
                            "plural"
                        ],
                        "form": "mollesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "État de ce qui est mou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76445d5e-f04b-4c7f-be5b-a7dbd601fd60",
                                "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                "text": "Mais le soufre qui a été chauffé à un certain degré, devient épais comme syrupeux, et conserve après avoir été coulé dans l'eau froide, une mollesse qui le rend précieux pour les empreintes de cachet."
                            },
                            {
                                "example_id": "56a42063-9a81-4a0c-98ad-abb88451704f",
                                "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                "text": "— Vous tenez sur vos jambes, au moins ? Levez-vous.\nElles avaient des mollesses de chaussettes, mais elles tenaient."
                            },
                            {
                                "example_id": "0254ec6b-9bf3-4d56-863d-8c5c47d293e8",
                                "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                "text": "La mollesse et la dureté des corps. - La mollesse des chairs est une marque d’une débile constitution."
                            }
                        ]
                    },
                    {
                        "sense_id": "c79372b4-6725-33da-9400-78dae72aa34a",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Température douce et molle, en parlant du climat."
                        ],
                        "tags": [
                            "Quelquefois"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "df644988-aa40-3e28-961b-3b92edd61dbd",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Complexion, tempérament mou, en parlant des personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f674792-47a3-47f6-8e08-6607554feb5c",
                                "sense_id": "df644988-aa40-3e28-961b-3b92edd61dbd",
                                "text": "La mollesse de sa complexion l’expose à beaucoup de maladies."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d9917fb-e1fb-3d3d-824c-944524ee8208",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "L’imitation vraie de la flexibilité, de la morbidesse des chairs."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1c70e46e-9bae-32f0-b743-5e0339750d04",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Défaut de fermeté dans le maniement du pinceau."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Manque de vigueur et de fermeté dans le caractère, dans la conduite, dans les mœurs."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "137e4170-b21b-446e-8b50-56be32f17b29",
                                "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                "text": "Babylone, si longtemps plongée dans une mollesse oisive, devint le théâtre d'une guerre civile affreuse."
                            },
                            {
                                "example_id": "4280ece7-39f0-42e4-8720-ce0501fa18a0",
                                "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                "text": "Les voilà qui m'entourent ; les voilà qui me contemplent ; les voilà qui me disent en leurs provocations : « Jeune dieu d'Amour, enseigne aux nymphes bocagères la mollesse et le désir, l'inconstance et la passion , le sourire et le sérieux. »"
                            },
                            {
                                "example_id": "d5845002-638c-408f-b4f1-86ff5b2a1a67",
                                "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                "text": "Eh! oui, il était grossier ce césarien. Il n'en toisait pas moins, non sans bonheur, les mollesses, les fluctuations du grand seigneur …."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Excès d’indulgence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b557de-d1f7-415b-b5ca-11432105c64b",
                                "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                "text": "La mollesse de ce père a perdu ses enfants."
                            },
                            {
                                "example_id": "4a1646de-4466-44b3-8d9c-d950f867d85b",
                                "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                "text": "Sa mollesse face aux brutalités policières envers les Noirs a laissé des traces indélébiles dans l'esprit des minorités noires."
                            },
                            {
                                "example_id": "0328e0aa-bdee-47b5-8c3d-7e1fe9f7eee6",
                                "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                "text": "À travers les témoignages émouvants de plusieurs « rescapés » de communautés religieuses, des jeunes courageux et inspirants qui ont tout laissé derrière eux (frères, sœurs, parents, amis) pour enfin vivre une vie normale, Marie-Claude Barrette montre à quel point nos gouvernements font preuve de mollesse, plient les genoux et renient leurs principes lorsque la religion se pointe le bout du nez."
                            }
                        ]
                    },
                    {
                        "sense_id": "f13877c3-8d74-3f49-a629-90eededbc912",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Délicatesse d’une vie efféminée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7326d0-e1a6-4d9a-bca5-d7e0b610a21e",
                                "sense_id": "f13877c3-8d74-3f49-a629-90eededbc912",
                                "text": "Vivre dans la mollesse. - La mollesse des sybarites."
                            },
                            {
                                "example_id": "edb64802-55d1-43a1-9502-d0ef204331b4",
                                "sense_id": "f13877c3-8d74-3f49-a629-90eededbc912",
                                "text": "J’aime le luxe, et même la mollesse,\nTous les plaisirs, les arts de toute espèce,\nLa propreté, le goût, les ornements :\nTout honnête homme a de tels sentiments."
                            }
                        ]
                    },
                    {
                        "sense_id": "752afe7b-6a97-3aa9-b4e5-232060d5dd78",
                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                        "glosses": [
                            "Manque de fermeté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b4b5b89-93e4-4f96-937b-7a853d6de0b9",
                                "sense_id": "752afe7b-6a97-3aa9-b4e5-232060d5dd78",
                                "text": "Mollesse du style."
                            }
                        ]
                    }
                ],
