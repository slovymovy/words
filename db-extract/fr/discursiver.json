                "senses": [
                    {
                        "sense_id": "1c3c2596-1d3d-3d03-9dfb-08ba1fb21d89",
                        "entry_id": "95da27ff-ded2-3f0e-a682-acc444b29d17",
                        "glosses": [
                            "Considérer les choses d’une façon discursive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704730c8-1280-4f11-befa-968d19aed003",
                                "sense_id": "1c3c2596-1d3d-3d03-9dfb-08ba1fb21d89",
                                "text": "On peut discernabiliser des choses sans pour autant discursiver ?"
                            },
                            {
                                "example_id": "98e74d12-0439-4c7c-900a-015f9f3aebc2",
                                "sense_id": "1c3c2596-1d3d-3d03-9dfb-08ba1fb21d89",
                                "text": "Or, dans tout ceci et à l’intérieur de cet épais réseau de contraintes — chacun imagine douloureusement les prolongements qu’elles ont —, il y a obligation de discursiver ce qu’on vit comme amour."
                            }
                        ]
                    }
