                            "superlative"
                        ],
                        "form": "most mentally"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                        "entry_id": "33c40f7b-d9f1-3b07-9b7f-1bb177d58844",
                        "glosses": [
                            "In a mental manner; an idea thought out in one's mind, as opposed to an idea spoken orally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be489d8c-91c9-4823-97a2-18d7111ebbf7",
                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                "text": "mentally capable"
                            },
                            {
                                "example_id": "da06589a-aa96-4e63-947f-fffd69f99c1a",
                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                "text": "mentally ill"
                            },
                            {
                                "example_id": "d795d4ed-f451-4604-8fed-c5c8883891f3",
                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                "text": "This is a problem that needs to be solved mentally, not with brute force."
                            },
                            {
                                "example_id": "62a271a4-a2ad-4abd-ba31-4ba5dbff6c8f",
                                "sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                                "text": "The novel he lends his name to is an account of that life, taking more or less the form of a memoir set down in the years immediately after World War II by an old man mentally preparing for death, not quite at home in the twentieth century (and a little proud of it, stubbornly clinging to his eartrumpet), whose significant memories reach back to the early 1890s and beyond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abfe0600-2134-468f-9506-88681354be72",
                        "source_entry_id": "33c40f7b-d9f1-3b07-9b7f-1bb177d58844",
                        "source_sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                        "source_sense_description": "in a mental manner",
                        "target_lang_word": "mentalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee66dc81-35ae-38b7-9cf6-5bc38067a45d",
                                        "entry_id": "39ada98d-61aa-3c90-afd2-8424476d10ae",
                                        "glosses": [
                                            "D’une manière mentale ; par l'effet de la pensée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00cf7a45-9912-48d3-88a9-7b306bf08658",
                                                "sense_id": "ee66dc81-35ae-38b7-9cf6-5bc38067a45d",
                                                "text": "Substituer mentalement la définition à la place du défini."
                                            },
                                            {
                                                "example_id": "09cf2da3-773a-4838-855e-da1f2673dd03",
                                                "sense_id": "ee66dc81-35ae-38b7-9cf6-5bc38067a45d",
                                                "text": "Seulement deux des prisonniers furent déclarés assez mentalement responsables pour être pendus, et on dispersa les autres dans diverses institutions."
                                            },
                                            {
                                                "example_id": "59bd9f85-ce38-4381-b889-1bac0f501a7a",
                                                "sense_id": "ee66dc81-35ae-38b7-9cf6-5bc38067a45d",
                                                "text": "Sans même le voir, Tommy pouvait parfaitement se représenter mentalement le large sourire qui devait s'étaler sur la face de John après cette énième blague dont la qualité restait douteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ddbb535-387f-3f41-b568-1e7aafac48b6",
                                        "entry_id": "39ada98d-61aa-3c90-afd2-8424476d10ae",
                                        "glosses": [
                                            "En le pensant sans le dire ; in petto."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "860304dd-569b-4664-9e94-8c045eb8ba0e",
                                                "sense_id": "2ddbb535-387f-3f41-b568-1e7aafac48b6",
                                                "text": "L'homme, qui était un garde-côte, comme le faisait voir sa cape d'uniforme, épiait toutes les manœuvres du trois-mâts et semblait en prendre note mentalement."
                                            },
                                            {
                                                "example_id": "5f9dcec5-4411-4734-abc5-a4f46ea00fd6",
                                                "sense_id": "2ddbb535-387f-3f41-b568-1e7aafac48b6",
                                                "text": "Mentalement, j’élève une dernière prière vers le Dieu des reporters, en le priant de ne pas m’épargner les aventures."
                                            },
                                            {
                                                "example_id": "465136ff-52a4-41b3-bb5c-4904fb325bed",
                                                "sense_id": "2ddbb535-387f-3f41-b568-1e7aafac48b6",
                                                "text": "Il se maudissait mentalement d’avoir eu la mauvaise idée d'amener là sa femme…"
                                            },
                                            {
                                                "example_id": "ce247198-dcb9-49ce-af71-b34f3cdadf47",
                                                "sense_id": "2ddbb535-387f-3f41-b568-1e7aafac48b6",
                                                "text": "[…] ; en voyant la douleur de sa femme un remords lui tordit le cœur dans la poitrine, il se demanda mentalement s’il avait réellement le droit d’agir comme il l’avait fait."
                                            },
                                            {
                                                "example_id": "27940d51-5c53-4436-a6ca-6b139800d1fb",
                                                "sense_id": "2ddbb535-387f-3f41-b568-1e7aafac48b6",
                                                "text": "Le capitaine Zondi préparait mentalement sa riposte. Il ne voulait surtout pas se retrouver avec cette casse-burnes dans les pattes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96c0b062-a437-4f1a-bc9d-edd4eac5da1a",
                        "source_entry_id": "33c40f7b-d9f1-3b07-9b7f-1bb177d58844",
                        "source_sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                        "source_sense_description": "in a mental manner",
                        "target_lang_word": "geistig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geistig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                        "entry_id": "e2197456-6984-3d80-98da-5ab71a0b20a9",
                                        "glosses": [
                                            "den menschlichen Geist, die Gedanken betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178ef854-d1f7-4b57-afdc-1a7d739a00a7",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "Man sollte sich nicht nur körperlich, sondern auch geistig anstrengen."
                                            },
                                            {
                                                "example_id": "5423c1c0-76e9-44f4-b688-39cdedfdc61a",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "Der alte Herr ist geistig noch topfit."
                                            },
                                            {
                                                "example_id": "74e0279d-dc6e-45d2-b09d-39316943d0ec",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "„Die Intelligenz, das geistige Leistungsvermögen, zeigt sich darin, inwieweit ein Lebewesen in der Lage ist, Probleme in einer gegebenen Umwelt situationsgerecht und rasch zu lösen.“"
                                            },
                                            {
                                                "example_id": "8b97da24-04aa-4f66-b3c3-4b8f49eece67",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                        "entry_id": "e2197456-6984-3d80-98da-5ab71a0b20a9",
                                        "glosses": [
                                            "Alkohol enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da19d14a-649e-4df0-879e-617c36e685a4",
                                                "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                                "text": "An diesem Abend flossen hauptsächlich geistige Getränke."
                                            },
                                            {
                                                "example_id": "82d64c8f-eea9-4cd5-84d1-0a5a4bdfdaeb",
                                                "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                                "text": "Eine dünne, klare, röhlich-gelbe, geistige Flüssigkeit, welche, besonders wenn sie in der flachen Hand gerieben oder auf einem erhitzten Bleche verdampft einen eigenen lieblichen Geruch äußert und einen süßlichen, zugleich etwas scharfen und gelind etwas balsamischen Geschmack besitzt. (1825)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "342c94eb-5b86-4f5e-9ad2-18967555da7f",
                        "source_entry_id": "33c40f7b-d9f1-3b07-9b7f-1bb177d58844",
                        "source_sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                        "source_sense_description": "in a mental manner",
                        "target_lang_word": "psychisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                        "entry_id": "f37e9526-6229-3ea3-a224-7189870b9b77",
                                        "glosses": [
                                            "die Psyche betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f67bef-be39-41b2-9315-a98042304791",
                                                "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                                "text": "Ich bin der Sache psychisch nicht gewachsen."
                                            },
                                            {
                                                "example_id": "99a5ee6a-f270-42f1-8657-2530e141d6b0",
                                                "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                                "text": "„Auf der anderen Seite aber sind psychische Volksleiden auf dem Vormarsch.“"
                                            },
                                            {
                                                "example_id": "b84ad514-201a-46be-8902-47310da4062b",
                                                "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                                "text": "„Die Landung, der technisch anspruchsvollste Teil eines Drachenflugs, wird nicht mehr geschildert, und der Leser fragt sich, wie der psychisch und wohl auch flugtechnisch total überforderte Mann wohl gelandet sein mag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d452f68f-6ed0-459d-83ef-5f6bad6c4448",
                        "source_entry_id": "33c40f7b-d9f1-3b07-9b7f-1bb177d58844",
                        "source_sense_id": "bbe36a7d-cdeb-300a-ab82-7d105d941933",
                        "source_sense_description": "in a mental manner",
                        "target_lang_word": "mental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mental",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94126736-da6d-3e6f-ab0f-07895c2d397e",
                                        "entry_id": "1a9e9a7d-c703-39cd-9c11-0691a77ac296",
                                        "glosses": [
                                            "geistig, den Geist oder das Denken betreffend, zum Geist gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8e11635-d25e-4fef-a265-5626a0b7a445",
                                                "sense_id": "94126736-da6d-3e6f-ab0f-07895c2d397e",
                                                "text": "Er ist mental vielen überlegen."
                                            },
                                            {
                                                "example_id": "590f2aad-fd2e-46a6-a930-87989aa781d1",
                                                "sense_id": "94126736-da6d-3e6f-ab0f-07895c2d397e",
                                                "text": "„Dieser Einwand kursierte, seit der Terror des Pariser Wohlfahrtsausschusses viele deutsche Schriftsteller und Gelehrte über ihre eigene Courage hatte so erschrecken lassen, dass sie auch mental wieder zu jener Ordnung zurückkehrten, die von ihnen politisch ohnehin nie infrage gestellt worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "581a7530-7bef-3c87-8349-5bcbd8a530b5",
