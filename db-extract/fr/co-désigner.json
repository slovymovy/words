                ],
                "senses": [
                    {
                        "sense_id": "e303bb4c-468a-3002-8991-59c7e5597b4c",
                        "entry_id": "703d76e2-e4ee-335b-9453-95dfe92ddd50",
                        "glosses": [
                            "Autre orthographe de codésigner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd1ecd91-6dca-4105-b56a-1e4194db2d34",
                                "sense_id": "e303bb4c-468a-3002-8991-59c7e5597b4c",
                                "text": "Sont également co-désignés : AG2R Prévoyance et l'Union nationale de la Mutualité française (UNPMF)."
                            },
                            {
                                "example_id": "5772560e-df9d-4ced-a020-4511da61c442",
                                "sense_id": "e303bb4c-468a-3002-8991-59c7e5597b4c",
                                "text": "Quant aux neuf autres membres du cabinet ministériel, qui partage avec le souverain le pouvoir exécutif, ils sont co-désignés par le roi et le chef du gouvernement."
                            },
                            {
                                "example_id": "6ea5b24f-6b7b-4d6f-a5b5-93759e6a3c1f",
                                "sense_id": "e303bb4c-468a-3002-8991-59c7e5597b4c",
                                "text": "Les trois juges-arbitres, co-désignés par Thales et la marine taïwanaise, avaient condamné le groupe d'électronique et de défense pour avoir rémunéré des intermédiaires en vue d'obtenir la vente de six frégates Horizon à l'île chinoise nationaliste en violation du contrat, baptisé \"Bravo\": son article 18 interdisait en effet de rémunérer des intermédiaires sous peine de restitution à Taïwan des fonds versés."
                            },
                            {
                                "example_id": "b5a897d2-386c-443b-a445-6221e2c5c554",
                                "sense_id": "e303bb4c-468a-3002-8991-59c7e5597b4c",
                                "text": "Malakoff Médéric (Malakoff Médéric Prévoyance) et APPRIONIS ont été co-désignés pour gérer le régime de Frais de santé de vos salariés."
                            }
                        ]
                    }
