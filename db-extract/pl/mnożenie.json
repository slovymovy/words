                                "sense_id": "3d939d88-b484-39cf-ade0-8b332f6f9f57",
                                "text": "Brzytwa Ockhama to zasada ekonomii myślenia zakazująca mnożenia bytów ponad potrzebę."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
