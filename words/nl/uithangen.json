{
    "word_family": [
        "ophangen",
        "uithangbord",
        "uithangplek"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e4801c8-a6fa-3eea-83a0-9548a9c57268",
                    "sense_definition": "iets ruim ophangen, vaak om te laten drogen of luchten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ophangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij bent vast vergeten de was <w>uit te hangen</w>.",
                            "target_lang_translations": {
                                "en": "You must have forgotten to <w>hang out</w> the laundry."
                            }
                        },
                        {
                            "text": "We moesten de natte was <w>uithangen</w> om deze in de zon te laten drogen.",
                            "target_lang_translations": {
                                "en": "We had to <w>hang out</w> the wet laundry to let it dry in the sun."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de was uithangen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hang something out in the open, often to dry or air out"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to hang out",
                                "target_lang_sense_clarification": "laundry or clothes to dry"
                            },
                            {
                                "target_lang_word": "to air out",
                                "target_lang_sense_clarification": "to expose to fresh air"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a05506-3b13-3985-af89-ddc73d6ce285",
                    "sense_definition": "ergens verblijven of tijd doorbrengen, vaak zonder specifiek doel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verblijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waar heb jij nu weer <w>uitgehangen</w> al die tijd?",
                            "target_lang_translations": {
                                "en": "Where have you <w>been</w> all this time?"
                            }
                        },
                        {
                            "text": "De jongeren houden ervan om de hele middag in het park <w>rond te hangen</w> en daar wat <w>uit te hangen</w>.",
                            "target_lang_translations": {
                                "en": "The youngsters love to loiter in the park all afternoon and <w>hang out</w> there."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondhangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak informeel gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spend time somewhere, often without a specific purpose or being unaccounted for"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to hang out",
                                "target_lang_sense_clarification": "spending time socially"
                            },
                            {
                                "target_lang_word": "to be up to",
                                "target_lang_sense_clarification": "referring to whereabouts or activities"
                            },
                            {
                                "target_lang_word": "to loiter",
                                "target_lang_sense_clarification": "lingering in a place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ba42e6b-d78e-3c62-bc1e-76a478b584d8",
                    "sense_definition": "zich op een bepaalde manier gedragen of een rol aannemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeert altijd de clown <w>uit te hangen</w> tijdens de saaie vergaderingen.",
                            "target_lang_translations": {
                                "en": "He always tries to <w>play</w> the clown during the boring meetings."
                            }
                        },
                        {
                            "text": "Je moet niet de baas <w>uithangen</w> als je hier zelf ook maar net werkt.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>act like</w> the boss when you've only just started working here yourself."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de clown uithangen",
                        "de held uithangen",
                        "de baas uithangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak met een negatieve of spottende ondertoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To behave in a certain way or to play a specific role, often annoyingly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to act like",
                                "target_lang_sense_clarification": "behaving as a certain character"
                            },
                            {
                                "target_lang_word": "to play the part of",
                                "target_lang_sense_clarification": "assuming a role"
                            },
                            {
                                "target_lang_word": "to pose as",
                                "target_lang_sense_clarification": "pretending to be something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}