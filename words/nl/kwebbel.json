                            }
                        },
                        {
                            "text": "Ga ergens anders heen en <w>kwebbel</w> daar maar verder.",
                            "target_lang_translations": {
                                "en": "Go somewhere else and <w>gab</w> away there."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
