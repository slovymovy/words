                "senses": [
                    {
                        "sense_id": "1d5380fc-9d7f-3479-b0e4-5c59540695cc",
                        "entry_id": "7e31fff5-f0cf-394e-af04-88985b616ab9",
                        "glosses": [
                            "État de ce qui est sordide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea77841e-9a76-445f-9e7a-1bdc8bf2d1ef",
                                "sense_id": "1d5380fc-9d7f-3479-b0e4-5c59540695cc",
                                "text": "Avec les sordidités entendues de l’autre côté de la frontière ces jours-ci, il me semble qu’il serait rafraîchissant d’entendre les politiciens aspirant à fonder un pays nous expliquer comment ils comptent l’habiter pleinement, ce pays-là."
                            },
                            {
                                "example_id": "616b5eb6-096b-40d0-8141-4fc61a703eef",
                                "sense_id": "1d5380fc-9d7f-3479-b0e4-5c59540695cc",
                                "text": "Il nous offre son regard sur la sordidité du monde moderne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff25d0d1-5ed2-4e6e-8eef-2a1b30805800",
                        "source_entry_id": "7e31fff5-f0cf-394e-af04-88985b616ab9",
                        "source_sense_id": "1d5380fc-9d7f-3479-b0e4-5c59540695cc",
                        "source_sense_description": "État de ce qui est sordide",
                        "target_lang_word": "sordidness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sordidness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6be3f706-3967-3e91-8a96-bbfed764f5c9",
                                        "entry_id": "2656a047-6988-3b20-b763-2bc473dfb821",
                                        "glosses": [
                                            "The quality or state of being sordid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fb20c7d-04eb-45af-98ea-da5e508bd0bb",
                                                "sense_id": "6be3f706-3967-3e91-8a96-bbfed764f5c9",
                                                "text": "[W]e muſt not take this mercifull indulgence given to our defectuoſities, as a diſpenſation for the ſordidnes of our loves, but rather in a holy effect and contention of gratitude, ſtrain to love God the more purely, and irreſpectively to our ſelves, in regard of the tranſcendent benignity of this diſpenſation."
                                            },
                                            {
                                                "example_id": "a3241ad6-7553-456c-894e-5dcc7fa83ebc",
                                                "sense_id": "6be3f706-3967-3e91-8a96-bbfed764f5c9",
                                                "text": "Every possible care was taken of him, and in a day or two he was able to walk into the study again, where he sat gazing at the sordidness and unneatness of the apartment, the strange festoons and drapery of spiders' webs, […]"
                                            },
                                            {
                                                "example_id": "288e1b84-92a1-48ac-9ba1-1b51fa25d32c",
                                                "sense_id": "6be3f706-3967-3e91-8a96-bbfed764f5c9",
                                                "text": "A brooding Northerner, Verhaeren sees the sorrow, the travail, the sordidness, going on all about him, and loves the world just the same, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e470ccab-799b-3105-815b-326017f1e961",
                                        "entry_id": "2656a047-6988-3b20-b763-2bc473dfb821",
                                        "glosses": [
                                            "The product or result of being sordid."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb97421e-6451-45f4-ae58-55e535cfa36d",
                                                "sense_id": "e470ccab-799b-3105-815b-326017f1e961",
                                                "text": "His was a nature—weak I own—that felt a sordidness in narrow means and their attendants; the ugliness of poverty pained his spirit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
