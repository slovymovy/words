{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6a373e6-c75a-3b85-a1a1-0af0e3d29012",
                    "sense_definition": "To make a harsh, shrill, offensive howling noise, like a cat in heat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray cats outside my window began to <w>caterwaul</w> in the middle of the night.",
                            "target_lang_translations": {
                                "de": "Die streunenden Katzen vor meinem Fenster fingen mitten in der Nacht an zu <w>jaulen</w>."
                            }
                        },
                        {
                            "text": "I could hear a strange animal <w>caterwaul</w> in the dark alley behind the house.",
                            "target_lang_translations": {
                                "de": "Ich konnte ein seltsames Tier in der dunklen Gasse hinter dem Haus <w>jaulen</w> hören."
                            }
                        }
                    ],
                    "synonyms": [
                        "yowl",
                        "howl",
                        "screech"
                    ],
                    "common_phrases": [
                        "loudly caterwaul"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein rauhes, schrilles, unangenehmes Heulen von sich geben, wie eine läufige Katze."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "jaulen",
                                "target_lang_sense_clarification": "einen schrillen, klagenden Laut ausstoßen"
                            },
                            {
                                "target_lang_word": "katzenjammern",
                                "target_lang_sense_clarification": "schreien oder heulen wie Katzen"
                            },
                            {
                                "target_lang_word": "kreischen",
                                "target_lang_sense_clarification": "hohe, schrille Töne von sich geben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77548765-860f-3b48-8432-900749d0f695",
                    "sense_definition": "To argue or complain in a harsh, noisy, and unpleasant manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politicians continue to <w>caterwaul</w> over minor policy details instead of taking action.",
                            "target_lang_translations": {
                                "de": "Die Politiker <w>keifen</w> weiterhin über unbedeutende Politikdetails, anstatt zu handeln."
                            }
                        },
                        {
                            "text": "Stop trying to <w>caterwaul</w> about the decision and focus on your work.",
                            "target_lang_translations": {
                                "de": "Hör auf, über die Entscheidung zu <w>jammern</w>, und konzentriere dich auf deine Arbeit."
                            }
                        }
                    ],
                    "synonyms": [
                        "bicker",
                        "squabble",
                        "wail"
                    ],
                    "common_phrases": [
                        "caterwaul about"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf eine lautstarke, raue und unangenehme Weise streiten oder sich beschweren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "keifen",
                                "target_lang_sense_clarification": "gehässig und lautstark nörgeln oder streiten"
                            },
                            {
                                "target_lang_word": "zanken",
                                "target_lang_sense_clarification": "sich lautstark streiten"
                            },
                            {
                                "target_lang_word": "jammern",
                                "target_lang_sense_clarification": "lautstark klagen oder sich beschweren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9212cda5-7eb4-3b3c-968c-b452818ab147",
                    "sense_definition": "A shrill, harsh, unpleasant howling or screeching sound, especially that made by a cat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>caterwaul</w> pierced the quiet night, scaring everyone in the house.",
                            "target_lang_translations": {
                                "de": "Ein plötzliches <w>Katzengejammer</w> durchdrang die Stille der Nacht und erschreckte alle im Haus."
                            }
                        },
                        {
                            "text": "The loud <w>caterwaul</w> came from the backyard where two cats were fighting.",
                            "target_lang_translations": {
                                "de": "Das laute <w>Gejaul</w> kam aus dem Hinterhof, wo zwei Katzen kämpften."
                            }
                        }
                    ],
                    "synonyms": [
                        "yowl",
                        "screech",
                        "shriek"
                    ],
                    "common_phrases": [
                        "loud caterwaul"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein schriller, rauer und unangenehmer Heul- oder Kreischlaut, besonders von einer Katze."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Katzengejammer",
                                "target_lang_sense_clarification": "gequältes oder schrilles Heulen von Katzen"
                            },
                            {
                                "target_lang_word": "das Gejaul",
                                "target_lang_sense_clarification": "anhaltendes, hohes Heulen"
                            },
                            {
                                "target_lang_word": "das Gekreisch",
                                "target_lang_sense_clarification": "schrille, unangenehme Laute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56341ed2-55e8-37d3-9a81-bb0fd462e340",
                    "sense_definition": "A noisy, harsh argument or quarrel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The debate degenerated into an annoying <w>caterwaul</w> between the opponents.",
                            "target_lang_translations": {
                                "de": "Die Debatte artete in ein nerviges <w>Gekeife</w> zwischen den Kontrahenten aus."
                            }
                        },
                        {
                            "text": "I left the room to avoid listening to their endless <w>caterwaul</w> over money.",
                            "target_lang_translations": {
                                "de": "Ich verließ den Raum, um mir ihr endloses <w>Gezänke</w> über Geld nicht anhören zu müssen."
                            }
                        }
                    ],
                    "synonyms": [
                        "quarrel",
                        "squabble",
                        "racket"
                    ],
                    "common_phrases": [
                        "endless caterwaul"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein lauter, rauer Streit oder eine unangenehme Auseinandersetzung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Gekeife",
                                "target_lang_sense_clarification": "anhaltender, schriller Streit"
                            },
                            {
                                "target_lang_word": "das Gezänke",
                                "target_lang_sense_clarification": "lästiger, dauerhafter Streit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}