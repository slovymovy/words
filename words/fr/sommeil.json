    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "818ba829-7620-318c-8714-ab18125e36e5",
                    "sense_definition": "État physiologique naturel et régulier de repos chez l'être humain et les animaux, caractérisé par la suspension temporaire de la conscience et de l'activité volontaire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sommeil_physiologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une journée de travail très fatigante, il a sombré dans un <w>sommeil</w> profond."
                        },
                        {
                            "text": "Malgré le grand silence de la nuit, je n'arrive pas à trouver le <w>sommeil</w>."
                        }
                    ],
                    "synonyms": [
                        "repos"
                    ],
                    "antonyms": [
                        "éveil",
                        "veille"
                    ],
                    "common_phrases": [
                        "sommeil profond",
                        "sommeil réparateur",
                        "trouver le sommeil",
                        "premier sommeil"
                    ]
                },
                {
                    "sense_id": "d89b58aa-b356-33c5-b6a8-2bf657281eb0",
                    "sense_definition": "Besoin ou envie de dormir.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sommeil_physiologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je travaille depuis l'aube et je commence à avoir <w>sommeil</w>."
                        },
                        {
                            "text": "Le petit enfant tombe de <w>sommeil</w> après cette longue promenade au parc."
                        }
                    ],
                    "common_phrases": [
                        "avoir sommeil",
                        "tomber de sommeil",
                        "manque de sommeil"
                    ]
                },
                {
                    "sense_id": "1afa9d44-9d3f-3cc3-9aa9-ada374fdef77",
                    "sense_definition": "État d'inactivité, d'engourdissement ou d'inertie temporaire dans lequel se trouvent des personnes, des choses ou des institutions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après dix années d'abandon, cette vieille association sort enfin de son long <w>sommeil</w>."
                        },
                        {
                            "text": "La campagne semble plongée dans un paisible <w>sommeil</w> sous cette neige d'hiver."
                        }
                    ],
                    "synonyms": [
                        "repos"
                    ],
                    "antonyms": [
                        "activité"
                    ],
                    "common_phrases": [
                        "en sommeil",
                        "mise en sommeil",
                        "sortir de son sommeil"
                    ]
                },
                {
                    "sense_id": "d482da3a-575e-330b-a900-d783377cdcee",
                    "sense_definition": "État de léthargie ou de vie ralentie qui saisit certains animaux durant l'hiver ou la saison sèche.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sommeil_physiologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ours s'aménage une tanière abritée avant d'entamer son long <w>sommeil</w> hivernal."
                        },
                        {
                            "text": "Durant la saison froide, ces petits rongeurs restent plongés dans un profond <w>sommeil</w>."
                        }
                    ],
                    "synonyms": [
                        "hibernation",
                        "léthargie"
                    ],
                    "antonyms": [
                        "activité",
                        "éveil"
                    ],
                    "common_phrases": [
                        "sommeil hivernal"
                    ]
                },
                {
                    "sense_id": "47bc41f7-af01-3d8b-800e-390d27c776ec",
                    "sense_definition": "Mort envisagée comme un repos sans fin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux poète repose désormais dans son dernier <w>sommeil</w> au cimetière marin."
                        },
                        {
                            "text": "Les soldats tombés au champ d'honneur sont entrés dans un <w>sommeil</w> éternel."
                        }
                    ],
                    "common_phrases": [
                        "sommeil éternel",
                        "dernier sommeil"
                    ]
                }
            ]
        }
    ]
