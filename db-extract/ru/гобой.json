                                    {
                                        "sense_id": "0710bb91-f504-37ea-b53f-3545a7062da9",
                                        "entry_id": "057072dc-d210-3ed3-a592-b904edf8b03d",
                                        "glosses": [
                                            "Instrumento de viento de la familia de viento madera, de taladro cónico, de 50 a 60 cm de largo, que produce sonido cuando vibra su lengüeta doble al soplarla."
                                        ],
                                        "tags": [
                                            "Instrumentos musicales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ff8bdf9-e038-462a-8980-52c89b514a35",
                                                "sense_id": "0710bb91-f504-37ea-b53f-3545a7062da9",
                                                "text": "Irrisoria lo que te parece historia no lo es\nAmistades del presente se evaporan entre oboes\nEncima de las tablas men, eso es lo que cuenta\nTus palabras vuelan si mi viento aumenta"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
