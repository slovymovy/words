                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bab8ab0-03e8-46e0-8261-eee608c9d6d4",
                                "sense_id": "8c63df30-0d60-386d-8cc9-d8f7049aa963",
                                "text": "„Die Bundesregierung hat dem ehemaligen NSA-Mitarbeiter Edward Snowden nach seinem Treffen mit dem Grünen-Abgeordneten Hans-Christian Ströbele in Moskau ihre Gesprächsbereitschaft signalisiert.“"
                            },
                            {
                                "example_id": "1598c7e0-7490-40f9-a14d-01e45198f369",
                                "sense_id": "8c63df30-0d60-386d-8cc9-d8f7049aa963",
                                "text": "„Über die endgültige Farbe signalisierte sie jedoch noch Gesprächsbereitschaft.“"
                            },
                            {
                                "example_id": "6de0a44c-8224-4346-abb8-525dfb7a8709",
                                "sense_id": "8c63df30-0d60-386d-8cc9-d8f7049aa963",
                                "text": "„Seine spätere Gesprächsbereitschaft und heimliche Verhandlungen mit Ian Smith in den 1970er Jahren bestätigten all diejenigen, die ihm nicht mehr vertrauten.“"
                            }
                        ],
