                        "examples": [
                            {
                                "example_id": "241bb797-b114-4690-b5e3-70c445971385",
                                "sense_id": "13b4f7c8-b5bb-3486-8fe5-bc546cd88ef3",
                                "text": "Durch Affigierung eines Derivationsaffixes entsteht ein neues Lexem."
                            },
                            {
                                "example_id": "01177695-0f64-4aec-a059-02c91707bc01",
                                "sense_id": "13b4f7c8-b5bb-3486-8fe5-bc546cd88ef3",
                                "text": "„Das Adjektiv vermehrt seinen Bestand einmal durch produktive Wortbildungsmuster, durch Affigierung ebenso wie durch Komposition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
