                "senses": [
                    {
                        "sense_id": "23bae611-731a-383b-a556-37aa778540c3",
                        "entry_id": "6f1abbfe-d3cc-39cc-a158-133748c03301",
                        "glosses": [
                            "Absorber plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be312f01-a6c0-4bca-b626-cb7328d5d8e3",
                                "sense_id": "23bae611-731a-383b-a556-37aa778540c3",
                                "text": "Si tu prends la pilule pas de souci pour le cuivre, la pilule fait sur-absorber le cuivre et moins absorber le zinc."
                            },
                            {
                                "example_id": "40da8b68-d24a-4ab3-bb40-c5320e83567e",
                                "sense_id": "23bae611-731a-383b-a556-37aa778540c3",
                                "text": "C’est surtout cette précision quoi rend clair les divers problèmes de salle car souvent les gens vont sur-absorber les hautes fréquences en ne sachant pas que leur traitement n’a pas d’effet en moyennes et basses fréquences."
                            }
                        ]
                    }
