                        "source_sense_id": "0aafd188-0f01-37d9-8c98-d1c809c2b031",
                        "target_lang_word": "черепа́ха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "черепа́ха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "10b83dec-7681-3c20-a5fb-0880128d4517",
                                        "entry_id": "1cf244b0-beca-3cdd-a824-44810891df0a",
                                        "glosses": [
                                            "зоол. холоднокровное позвоночное животное класса пресмыкающихся, как правило, покрытое естественным панцирем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38aa3acb-4eec-4295-a4c6-bcc5a9c7aa7b",
                                                "sense_id": "10b83dec-7681-3c20-a5fb-0880128d4517",
                                                "text": "Заметив белую одежду человека, к берегу устремились черепахи и огромные золотистые карпы; они засуетились у мостков, уже ссорясь за будущую добычу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b3a206-6529-36db-92c7-3962e2d01c56",
                                        "entry_id": "1cf244b0-beca-3cdd-a824-44810891df0a",
                                        "glosses": [
                                            "роговые пластинки панциря некоторых черепах, идущие на поделки"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "373f635a-4983-4f4f-b35d-f1d741f9f011",
                                                "sense_id": "52b3a206-6529-36db-92c7-3962e2d01c56",
                                                "text": "Изделия из черепахи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a7672c-c46f-3cac-b56d-4473d15a3349",
                                        "entry_id": "1cf244b0-beca-3cdd-a824-44810891df0a",
                                        "glosses": [
                                            "перен., воен., истор. деревянный, покрытый мокрыми шкурами навес для защиты нападающих при штурме городских стен"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0dc5eb5-0d6e-428e-97eb-954c84e5c1d0",
                                                "sense_id": "64a7672c-c46f-3cac-b56d-4473d15a3349",
                                                "text": "Дружинники ставили на колеса большой деревянный сруб, обтянутый сырой кожей — «черепаху». Сырые кожи должны были уберечь боевую машину от хазарских горячих стрел. Внутри «черепахи» висело на цепях тяжёлое дубовое бревно, окованное железом — таран."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88cf83b1-d099-3ee4-a823-b725fb89ac5d",
                                        "entry_id": "1cf244b0-beca-3cdd-a824-44810891df0a",
                                        "glosses": [
                                            "перен., воен., истор. ·построение римских солдат друг на друга в несколько рядов, прикрывшись щитами, для преодоления крепостной стены (testudo)"
                                        ],
                                        "tags": [
                                            "в древнем Риме"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ea293e1-123c-4c26-ba04-458bddd1c94d",
                                                "sense_id": "88cf83b1-d099-3ee4-a823-b725fb89ac5d",
                                                "text": "Затем Галл подступил к Иерусалиму и начал приготовления к приступу. Черепаха подкапывала стены. В городе началась невообразимая паника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26840954-2771-381f-8f72-5f897ebdcc72",
                                        "entry_id": "1cf244b0-beca-3cdd-a824-44810891df0a",
                                        "glosses": [
                                            "фибровый защитный шлем советских шахтёров, сталеваров 1930-1950-х годов. Другое название — \\\"стахановка\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
