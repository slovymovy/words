                "senses": [
                    {
                        "sense_id": "7b8d2757-070a-3171-b282-77819fe0f3b8",
                        "entry_id": "e616b93d-f49a-3c11-a0d7-58dfe231c55a",
                        "glosses": [
                            "osoba będąca członkiem świty arystokraty, należąca do dworu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5682ac5-8ade-448b-940f-963ba117dbcc",
                                "sense_id": "7b8d2757-070a-3171-b282-77819fe0f3b8",
                                "text": "Raz po raz jakiś pan, czy dworzanin z szeregu wyjedzie, do karocy królewskiej się zbliży, kilka słów zamieni i przystanie, żeby do nadjeżdżających dołączyć."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2eb4830a-d895-313e-9b5b-012851f48b2c",
                        "entry_id": "e616b93d-f49a-3c11-a0d7-58dfe231c55a",
                        "glosses": [
                            "osoba u władzy lub jej towarzysząca, członek ogólnie pojętego rządu"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21a01c7e-12a2-4ea7-b552-ea7cfa78b693",
                        "source_entry_id": "e616b93d-f49a-3c11-a0d7-58dfe231c55a",
                        "source_sense_id": "7b8d2757-070a-3171-b282-77819fe0f3b8",
                        "target_lang_word": "courtier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person in attendance at a royal court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a3d2814-dd7a-4361-81b8-a9f1b2e23413",
                                                "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                                "text": "By the Lord, Horatio, this three years I have taken note of it, the age is grown so picked that the toe of the peasant comes so near the heel of the courtier he galls his kibe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person who flatters in order to seek favour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7325b74b-79b5-452c-ac6c-e79c9f087bfc",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "People shouted cheerfully and flinched, but the Prime Minister didn't flinch, she fortified her voice with a firm diapason as if rising to the challenge of a rowdy Chamber. Around her her courtiers started like pheasants."
                                            },
                                            {
                                                "example_id": "6ab65732-a2ba-492e-96a1-0983138231d5",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "The world’s richest person, not known for his humility, is still learning the cutthroat courtier politics of Donald Trump’s inner circle — and his ultimate influence remains an open question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ff811f-55f9-311f-b6ac-94619565a68d",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the Asian genus Sephisa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d74cc974-b3d0-4598-a8f9-68678f35bb2c",
                        "source_entry_id": "e616b93d-f49a-3c11-a0d7-58dfe231c55a",
                        "source_sense_id": "7b8d2757-070a-3171-b282-77819fe0f3b8",
                        "target_lang_word": "dvořan",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dvořan",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3a77c0c6-68eb-37fc-b7af-d64231471b5c",
                                        "entry_id": "1fcc4e30-2694-313d-8bf4-6557f8636aaf",
