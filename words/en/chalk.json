                    "sense_definition": "A suburban village in Kent, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Chalk</w> during their trip to Kent.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшую деревню <w>Чок</w> во время поездки в Кент.",
                                "zh": "他们在去肯特郡旅行时参观了<w>查尔克</w>这个小村庄。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пригородная деревня в графстве Кент, Англия.",
                        "zh": "位于英国肯特郡的一个郊区村庄。"
                    },
                    "translations": {
