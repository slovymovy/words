                                        "glosses": [
                                            "The manoeuvre performed by looping the loop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79333998-4522-4214-9766-7c8942101b8a",
                                                "sense_id": "c155e219-3c73-3f5e-b106-9fcc9cf9701d",
                                                "text": "The men in the airplane waved, their white teeth flashing against their sun-baked faces. Then up they flew, did a loop-the-loop, and shot straight up again swinging and twisting, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2344b40-7cd8-3f55-8033-aee534653c0f",
                                        "entry_id": "f8468b24-67cc-3def-a094-b92350b06af2",
                                        "glosses": [
                                            "A looped section of track, etc., as on a rollercoaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543c3ee2-89bb-49fb-ad67-e57e94d29a7b",
                                                "sense_id": "e2344b40-7cd8-3f55-8033-aee534653c0f",
                                                "text": "You'll fly through the game's levels at super speed, running through loop-the-loops and bouncing off bumpers. With Sonic, you'll have the added advantage of spin attacks and the speedy Spin Dash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da5e12e5-f63e-315e-aac4-56f3e5135466",
                                        "entry_id": "f8468b24-67cc-3def-a094-b92350b06af2",
                                        "glosses": [
                                            "A yo-yo trick in which the yoyo is made to repeatedly swing around the hand in a looping fashion."
                                        ],
