                        "sense_id": "cada2dc1-f9d1-37c2-b35a-d6ef65f3cdb3",
                        "entry_id": "7e42d28a-c587-3caf-b1a4-ab826ceba460",
                        "glosses": [
                            "Initié, maître spirituel, titre honorifique de l'hindouisme et du théosophisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44f5b886-6359-4147-8f0d-a74b16923a74",
                                "sense_id": "cada2dc1-f9d1-37c2-b35a-d6ef65f3cdb3",
                                "text": "L'un des champions du syncrétisme avait été le Mahatma Gandhi, qui ne sortait pas sans ses trois livres sacrés."
                            },
                            {
                                "example_id": "a489dc1b-65d0-485f-9da3-aa830492a4e1",
                                "sense_id": "cada2dc1-f9d1-37c2-b35a-d6ef65f3cdb3",
                                "text": "Celui-ci est menaçant dans la mesure où il est vu encore comme un homme et non pas comme un mahatma protégé par sa robe ocre de swâmi et sa longue barbe blanche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c50261b8-9fae-4826-b762-bc23c663e230",
                        "source_entry_id": "7e42d28a-c587-3caf-b1a4-ab826ceba460",
                        "source_sense_id": "cada2dc1-f9d1-37c2-b35a-d6ef65f3cdb3",
