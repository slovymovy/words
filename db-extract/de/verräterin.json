                ],
                "senses": [
                    {
                        "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                        "entry_id": "ca8d4bf8-ade9-3bc8-98f8-ab4cccdcd9fb",
                        "glosses": [
                            "weibliche Person, die einen Verrat begangen hat bzw. immer noch begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e520dae-7294-4c33-bc65-029235a93e34",
                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                "text": "Die Verräterin wurde hingerichtet."
                            },
                            {
                                "example_id": "2e082c8d-4456-4040-8454-1475ea15eab6",
                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                "text": "„Am schlimmsten aber sind die Migranten, die mir daraufhin vorwerfen, eine Verräterin zu sein.“"
                            },
                            {
                                "example_id": "f201f50b-db65-4965-b2e6-751712337e17",
                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                "text": "„Wie eine Verräterin empfand ich Mariam, wie eine von den vielen, die ins Lager jener zurückgingen, die wir so vehement verspottet hatten.“"
                            },
                            {
                                "example_id": "78f953e4-cbeb-4130-b232-e55bd014ef25",
                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                "text": "„Sie fühlte sich wie eine Verräterin und ihr wild schlagendes Herz echote in ihrem Ohr.“"
                            },
                            {
                                "example_id": "96a4e947-dfde-4c91-bfd7-bf7a9120a25b",
                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                "text": "„Nichts, was ich mit ihr getan hatte, konnte sie doch mit ihm tun, ohne sich als Verräterin oder Hure vorzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
