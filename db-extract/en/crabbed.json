                ],
                "senses": [
                    {
                        "sense_id": "4e7fbb14-49f4-3532-8789-28a45a73bedb",
                        "entry_id": "34d071a8-db5c-31cb-a00a-a53c1431ec85",
                        "glosses": [
                            "Bad-tempered or cantankerous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c019376-67eb-4364-a37e-c81b4955b6db",
                                "sense_id": "4e7fbb14-49f4-3532-8789-28a45a73bedb",
                                "text": "[…]O, she is / Ten times more gentle than her father's crabb'd, / And he's composed of harshness."
                            }
                        ]
                    },
                    {
                        "sense_id": "85078f21-d311-3f64-96bc-8a9c854a29e0",
                        "entry_id": "34d071a8-db5c-31cb-a00a-a53c1431ec85",
                        "glosses": [
                            "Cramped, bent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a56f47-60dc-4286-b9eb-7a31c75e769f",
                                "sense_id": "85078f21-d311-3f64-96bc-8a9c854a29e0",
                                "text": "A wrinkled crabbed man they picture thee,\nOld Winter, with a rugged beard as grey\nAs the long moss upon the apple-tree; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "16480da1-c2b3-3f3f-bd8c-9bbce7d3769c",
                        "entry_id": "34d071a8-db5c-31cb-a00a-a53c1431ec85",
                        "glosses": [
                            "Crowded together and difficult to read."
                        ],
                        "tags": [
                            "of handwriting"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "14bdc69b-a2dc-3122-9785-3e4c6ff75f11",
                        "entry_id": "34d071a8-db5c-31cb-a00a-a53c1431ec85",
                        "glosses": [
                            "Pointed at an angle to the runway during approach and landing to compensate for a crosswind."
                        ],
                        "tags": [
                            "of an aircraft"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd20f83-e9ce-46e9-aac2-8983b7fe9113",
                                "sense_id": "14bdc69b-a2dc-3122-9785-3e4c6ff75f11",
                                "text": "Unlike most aircraft, the B-52's fully-steerable landing gear allows it to land crabbed and stay crabbed throughout rollout without destroying its tires."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd197ccc-6f7f-3839-a787-1aeede058ed5",
                        "entry_id": "34d071a8-db5c-31cb-a00a-a53c1431ec85",
                        "glosses": [
                            "Performed with one's aircraft pointed at an angle to the runway to compensate for a crosswind; performed with nonzero crab."
                        ],
                        "tags": [
                            "of an approach and landing"
                        ],
                        "examples": [
                            {
                                "example_id": "2a034412-d4c4-4de7-baa9-53debdc53217",
                                "sense_id": "fd197ccc-6f7f-3839-a787-1aeede058ed5",
                                "text": "The Ercoupe can't be cross-controlled, so it has to make a crabbed approach in a crosswind rather than using the sideslip technique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e85c6681-1f39-40fd-b35d-e9c8045b76e6",
                        "source_entry_id": "34d071a8-db5c-31cb-a00a-a53c1431ec85",
