                ],
                "senses": [
                    {
                        "sense_id": "7bd77790-3c2f-374e-99db-ca4fbb849f7c",
                        "entry_id": "a4a57486-518a-380a-a091-0a99099597fd",
                        "glosses": [
                            "einem Tier ähnelnd, wie ein Tier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628dd4cc-7059-4077-97f9-773aa9db50f6",
                                "sense_id": "7bd77790-3c2f-374e-99db-ca4fbb849f7c",
                                "text": "„Sie hielt das grässliche Bildnis fest mit den Armen umschlungen, ihre Lippen bewegten sich und brachten tierartige Laute hervor, und in der Art, wie die Statuette in schwindelerregendem Wirbel von einem Zustand in den nächsten überging, schien eine Art wahnwitziger Triumph zu liegen.“"
                            },
                            {
                                "example_id": "284e8792-88b9-4f0a-810b-49c5d585a587",
                                "sense_id": "7bd77790-3c2f-374e-99db-ca4fbb849f7c",
                                "text": "„Scheu und verstohlen, in einem tierartigen Galopp, hetzte er ihn entlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
