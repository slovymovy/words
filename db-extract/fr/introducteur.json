                "senses": [
                    {
                        "sense_id": "fd644fe8-89c6-3ebb-8c08-433a07b91b23",
                        "entry_id": "b905469b-525e-3089-b34f-5babb93ac3de",
                        "glosses": [
                            "Celui qui introduit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17820bd-92a4-4fb6-acda-47dee631e76a",
                                "sense_id": "fd644fe8-89c6-3ebb-8c08-433a07b91b23",
                                "text": "Il s'y trouva d'abord un peu dépaysé, mais son introducteur lui servit de guide à travers le dédale des portants et le conduisit derrière la toile de fond."
                            },
                            {
                                "example_id": "4708bb2b-2934-4948-9ed1-8d61d6fc0607",
                                "sense_id": "fd644fe8-89c6-3ebb-8c08-433a07b91b23",
                                "text": "Monsieur de Cinq-Mars, disait la jeune fille, puisque vous avez voulu être mon introducteur dans ce monde, révélez-le moi..."
                            },
                            {
                                "example_id": "25106588-ed65-48ed-ada0-e982e17a5893",
                                "sense_id": "fd644fe8-89c6-3ebb-8c08-433a07b91b23",
                                "text": "Il sonna. On vint lui ouvrir. Son introducteur était un petit garçon d’une dizaine d’années."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8762bad-f40a-30fe-80fe-3aaaffefa754",
                        "entry_id": "b905469b-525e-3089-b34f-5babb93ac3de",
                        "glosses": [
                            "Objet destiné à permettre l'introduction d'un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0bf077-def3-4c14-b081-cbd245de04f7",
                                "sense_id": "c8762bad-f40a-30fe-80fe-3aaaffefa754",
                                "text": "Le ballon de l’introducteur est gonflé pour empêcher toute fuite de gaz par l'anus (fig. 5a). Du CO2 est ensuite insufflé entre les deux ballons gonflés et la pression ainsi obtenue fait avancer le ballon propulseur."
                            }
                        ]
                    }
                ],
