                ],
                "translations": [
                    {
                        "translation_id": "029362dd-2b18-42a7-af86-48d762e78b86",
                        "source_entry_id": "3adc712f-08b1-31e7-91d5-5844efbed818",
                        "target_lang_word": "dompter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dompter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1fbb0d-61bf-3ca0-ab08-a0cb50124aca",
                                        "entry_id": "da35cb38-81d4-3cd0-87bb-c87f10e8353d",
                                        "glosses": [
                                            "Réduire sous son obéissance un animal sauvage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf116f0a-342a-4734-bc32-13137249da90",
                                                "sense_id": "0a1fbb0d-61bf-3ca0-ab08-a0cb50124aca",
                                                "text": "Dompter un cheval, un taureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "221d0383-ed78-3851-9cff-59fabb511249",
                                        "entry_id": "da35cb38-81d4-3cd0-87bb-c87f10e8353d",
                                        "glosses": [
                                            "Faire obéir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae20307-5826-4bd5-89d7-e8a307935df5",
                                                "sense_id": "221d0383-ed78-3851-9cff-59fabb511249",
                                                "text": "Dompter un enfant rebelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e528dbf6-da06-33f1-a4b5-5084d221e96f",
                                        "entry_id": "da35cb38-81d4-3cd0-87bb-c87f10e8353d",
                                        "glosses": [
                                            "Dominer, maitriser, soumettre ou vaincre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b4e5ae-15f1-4e95-98de-946553a73838",
                                                "sense_id": "e528dbf6-da06-33f1-a4b5-5084d221e96f",
                                                "text": "Mais il a vu, aussi, quelle force mentale habite le Maillot jaune, décramponné de deux longueurs, mais capable, sur les dix derniers mètres, de venir dompter son assaillant à l’arraché."
                                            },
                                            {
                                                "example_id": "0ec0a817-3ef9-4c8e-8dce-fd1158b16753",
                                                "sense_id": "e528dbf6-da06-33f1-a4b5-5084d221e96f",
                                                "text": "On sentait une puissante individualité, que la foi s’était assujettie, mais que la règle ecclésiastique n’avait pas domptée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bd9141f-02c3-4695-85b8-99957b537587",
                        "source_entry_id": "3adc712f-08b1-31e7-91d5-5844efbed818",
                        "target_lang_word": "soumettre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soumettre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52ac2f63-a979-327b-929d-8a2533b0140d",
                                        "entry_id": "09b5e9de-6df3-3908-92fc-cb8a64eb51fb",
                                        "glosses": [
                                            "Réduire, ranger sous la puissance, sous l’autorité, mettre dans un état de dépendance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "decefd13-993e-4683-bd51-e8e1f9acbb10",
                                                "sense_id": "52ac2f63-a979-327b-929d-8a2533b0140d",
                                                "text": "C'est ce qui permit à une minorité conquérante, politiquement et socialement dominante, de populations surtout chrétiennes, païennes et zoroastriennes, de consolider l'Islam et de soumettre rapidement les mondes sémitiques et iranien."
                                            },
                                            {
                                                "example_id": "651471d7-b273-47d2-b305-e8a6c6f4dbeb",
                                                "sense_id": "52ac2f63-a979-327b-929d-8a2533b0140d",
                                                "text": "Soumettre à l’obéissance d’un souverain, une province à ses lois, à son empire, tout un pays, les rebelles."
                                            },
                                            {
                                                "example_id": "e8432023-3297-4c86-9026-65f93f048984",
                                                "sense_id": "52ac2f63-a979-327b-929d-8a2533b0140d",
                                                "text": "Après une longue résistance, les provinces révoltées se soumirent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                        "entry_id": "09b5e9de-6df3-3908-92fc-cb8a64eb51fb",
                                        "glosses": [
                                            "Subordonner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd7aa07-8594-4aa4-9beb-5698ab354a2a",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Un projet qui reste soumis aux circonstances."
                                            },
                                            {
                                                "example_id": "790e396c-fed1-4f26-85b4-3d56cb2b0e50",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Je soumets cette proposition à votre agrément."
                                            },
                                            {
                                                "example_id": "7355bf5b-eca9-4e6f-9152-038065d59c5c",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "L’écriture oblige les hommes à soumettre leur esprit à Dieu."
                                            },
                                            {
                                                "example_id": "dfbb746a-dba5-4e3d-9ec5-127c0710ff0e",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Soumettre ses idées à celles de quelqu’un : subordonner ses idées à celles d’un autre, être prêt à s’en désister, s’il y est contraire."
                                            },
                                            {
                                                "example_id": "061c5b28-0255-4a3b-af3f-11dc69e1cfec",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Je soumets dans cette affaire mes idées aux vôtres."
                                            },
                                            {
                                                "example_id": "e94419e5-0fca-4ab4-bd2f-093629eede8a",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Soumettre ses lumières, ses opinions, ses sentiments à ceux d’autrui."
                                            },
                                            {
                                                "example_id": "1c245b91-4a86-4f06-808b-faa1fdae97a2",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Soumettre une chose au jugement, à la critique de quelqu’un : s’engager à déférer au jugement qu’il en portera."
                                            },
                                            {
                                                "example_id": "8d0a8a64-5911-4281-9e2d-62831939e24a",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Je vous prie de lire toute la pièce, je la soumets à votre jugement."
                                            },
                                            {
                                                "example_id": "9c88a5c7-90e3-4c58-a5f2-c504161968d8",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Se soumettre à un jugement arbitral."
                                            },
                                            {
                                                "example_id": "036dc36a-2ea7-4da8-896c-db31e0591643",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Se soumettre aux ordres, à la volonté de quelqu’un : conformer ses actions, ses sentiments."
                                            },
                                            {
                                                "example_id": "35d0f5bc-30ec-4175-8ce7-b7535ad84e79",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Nous devons nous soumettre entièrement à la volonté de Dieu."
                                            },
                                            {
                                                "example_id": "249f6935-cc50-4d95-8727-f1b06dc3ce8e",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Se soumettre à quelque chose, à souffrir quelque chose : s’engager, consentir à subir quelque chose."
                                            },
                                            {
                                                "example_id": "9fa2a50a-0bc2-4bdd-b023-3da99b35ff5d",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Je me soumets à tout ce qu’il vous plaira."
                                            },
                                            {
                                                "example_id": "6900a83c-8b41-4b88-ac87-903365d58ef0",
                                                "sense_id": "30c9724c-b01d-35c3-920a-70bcc02bf381",
                                                "text": "Se soumettre à une intervention chirurgicale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a755adc-151b-35b1-8b07-4d07827adf8c",
                                        "entry_id": "09b5e9de-6df3-3908-92fc-cb8a64eb51fb",
                                        "glosses": [
                                            "Remettre ou livrer à l’examen ou à la décision de quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7578b0ee-4d7d-46b6-9750-126fedf0415f",
                                                "sense_id": "6a755adc-151b-35b1-8b07-4d07827adf8c",
                                                "text": "À l’encontre des autres routes d’Europe, celles du Royaume Uni n’avaient jamais été soumises à aucun essai organisé de redressement et d’aplanissement, et c’est à cela sans doute qu’il faut attribuer leur caractère pittoresque."
                                            },
                                            {
                                                "example_id": "5576f17a-ce60-409e-a450-b20872cec922",
                                                "sense_id": "6a755adc-151b-35b1-8b07-4d07827adf8c",
                                                "text": "La France demande que soit soumise au Tribunal de La Haye la question de savoir si le pacte franco-soviétique est compatible avec Locarno."
                                            },
                                            {
                                                "example_id": "55c1891f-e262-4938-8fce-e582ca0b19bd",
                                                "sense_id": "6a755adc-151b-35b1-8b07-4d07827adf8c",
                                                "text": "Soumettez-lui votre article, votre manuscrit."
                                            },
                                            {
                                                "example_id": "54fa8bd1-4458-40d2-9d44-b5f97aa042b8",
                                                "sense_id": "6a755adc-151b-35b1-8b07-4d07827adf8c",
                                                "text": "Ce projet fut soumis à l’examen d’une commission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "097911f5-70bc-3b55-9644-4f297b148173",
                                        "entry_id": "09b5e9de-6df3-3908-92fc-cb8a64eb51fb",
                                        "glosses": [
                                            "Considérer en détail, pour juger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c6f73aa-1b5e-4cb5-9104-75ef9bf21e7e",
                                                "sense_id": "097911f5-70bc-3b55-9644-4f297b148173",
                                                "text": "Un travail conduit démocratiquement serait réglementé par des arrêtés, surveillé par une police et soumis à la sanction de tribunaux distribuant des amendes ou de la prison."
                                            },
                                            {
                                                "example_id": "ae8dd0e2-f665-4673-92ed-1e62f43817e7",
                                                "sense_id": "097911f5-70bc-3b55-9644-4f297b148173",
                                                "text": "Soumettre une chose à l’analyse : l’analyser, la décomposer, pour connaître de quels éléments elle est formée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac82362-18d2-378c-8a46-1e70cb4efbfd",
                                        "entry_id": "09b5e9de-6df3-3908-92fc-cb8a64eb51fb",
                                        "glosses": [
                                            "Appliquer un procédé ou une procédure sur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c152ffb-2d88-435f-af81-c4cad341ea7c",
                                                "sense_id": "3ac82362-18d2-378c-8a46-1e70cb4efbfd",
                                                "text": "Avant d'être envoyé au moulin, le blé est préalablement soumis chez les cultivateurs à un vannage qui en sépare une partie des corps les plus légers."
                                            },
                                            {
                                                "example_id": "8978c353-7ccb-4c0c-8bab-6312df3b325b",
                                                "sense_id": "3ac82362-18d2-378c-8a46-1e70cb4efbfd",
                                                "text": "Les insectes qui consomment du S. demissum, ou que l'on soumet au jeûne, n'arrivent pas à cette chitinisation et leurs élytres restent molles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1b9c455-efb7-3112-9fa7-3952d25f455f",
                                        "entry_id": "09b5e9de-6df3-3908-92fc-cb8a64eb51fb",
                                        "glosses": [
                                            "Faire acte de soumission d’une parcelle au régime forestier."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "818fe771-3759-4588-b57d-fe56b26d8821",
                                                "sense_id": "f1b9c455-efb7-3112-9fa7-3952d25f455f",
                                                "text": "En application des articles L.211-1 et R.214-1 du nouveau code forestier, les bois et forêts susceptibles d’aménagement, d’exploitation régulière ou de reconstitution, et les terrains à boiser des collectivités locales ou des établissements publics locaux peuvent être soumis au régime forestier […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d47b425-6724-4b5b-a590-7a675eca8cda",
                        "source_entry_id": "3adc712f-08b1-31e7-91d5-5844efbed818",
                        "target_lang_word": "apaiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apaiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                        "entry_id": "b07389ef-570f-35ea-95e5-94a5217c6bfa",
                                        "glosses": [
                                            "Ramener au calme, à un état paisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56d89f5-4652-4136-8b8a-e8bf9a216721",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "Le fracas de l’orchestre leur arrivait, assourdissant. Par instants, les violons dominaient le vacarme qu’ils semblaient apaiser, caresser, contenir, mais le saxo, le piston, la clarinette et surtout la trompette […] se mettaient ensemble à mugir et à pétarader de telle sorte que personne ne parlait plus."
                                            },
                                            {
                                                "example_id": "bdfd42c2-91d2-4188-ae78-1eea5a63e56c",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "Apaiser une personne furieuse. — Apaiser une sédition."
                                            },
                                            {
                                                "example_id": "7946b4d0-64d6-4798-8b22-6e194e701c87",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "Cet enfant ne cesse de crier, apaisez-le."
                                            },
                                            {
                                                "example_id": "1a21bb9f-cee0-4f74-9de0-83d71ded87a9",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "La mer s’apaise. — Sa douleur, sa colère commence à s’apaiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd95967-d8b4-3c69-a088-74c6e9691400",
                                        "entry_id": "b07389ef-570f-35ea-95e5-94a5217c6bfa",
                                        "glosses": [
                                            "Satisfaire ; assouvir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5aaa174-29ff-4e86-8bb9-246008944dae",
                                                "sense_id": "dfd95967-d8b4-3c69-a088-74c6e9691400",
                                                "text": "Scaër, il faut l'avouer, mangea comme quatre, et ce ne fut qu'après avoir apaisé sa faim qu'il se trouva en état de s'expliquer avec Mᵐᵉ de Mazatlan qui prenait plaisir à le voir satisfaire ce glorieux appétit, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db730683-f190-473b-a8ae-6bd38088e28b",
                        "source_entry_id": "3adc712f-08b1-31e7-91d5-5844efbed818",
                        "target_lang_word": "réprimer",
