                        "entry_id": "92bd30ad-59c1-365a-afbe-a6949597d388",
                        "glosses": [
                            "沒什麼（不定代詞ничто́ (ništó)的屬格；很少使用主格，而優先使用屬格）"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1b74dc-394e-4561-b26d-c52bf2ae8b10",
                                "sense_id": "bcb7f2f2-6368-3574-a6f8-e380491f8078",
                                "text": "Что с ним? — Ничего́.",
                                "translation": "他怎麼了？ — 沒什麼。"
                            },
                            {
                                "example_id": "fead4b2c-0bff-47a6-9f4e-687c02e90a6a",
                                "sense_id": "bcb7f2f2-6368-3574-a6f8-e380491f8078",
                                "text": "Ничего́ нет.",
                                "translation": "沒有什麼。"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2876b17-ca21-3aff-b1f7-ee2e0c45eb19",
                        "entry_id": "92bd30ad-59c1-365a-afbe-a6949597d388",
                        "glosses": [
                            "不錯，還好，普通，馬虎"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d63f196d-9553-4578-b3cd-5fbd0107edc9",
                                "sense_id": "e2876b17-ca21-3aff-b1f7-ee2e0c45eb19",
                                "text": "Как ва́ше здоро́вье? —— Ничего́.",
                                "translation": "你健康狀況如何？ — 普普通通。"
                            },
                            {
                                "example_id": "2e954987-f6aa-4bc1-9635-e334d57bf01e",
                                "sense_id": "e2876b17-ca21-3aff-b1f7-ee2e0c45eb19",
                                "text": "Как он поёт? — Ничего́.",
                                "translation": "他唱得怎麼樣？ — 不錯。"
                            }
                        ]
