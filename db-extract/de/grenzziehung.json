                "senses": [
                    {
                        "sense_id": "42657fdb-57d5-33d2-8b9f-41fda90dba0f",
                        "entry_id": "c77352da-ea53-3d56-ad49-993cad294728",
                        "glosses": [
                            "Festlegung des Verlaufs einer Grenze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7140055e-8729-4b1a-84dd-59e6b5dd0662",
                                "sense_id": "42657fdb-57d5-33d2-8b9f-41fda90dba0f",
                                "text": "„Mugabes Heimatland besaß aufgrund der kolonialen Grenzziehungen keinen Zugang zum Meer.“"
                            },
                            {
                                "example_id": "0b2f5cd8-d606-4c84-b79e-580f8b5a1414",
                                "sense_id": "42657fdb-57d5-33d2-8b9f-41fda90dba0f",
                                "text": "„Die genaue Grenzziehung zwischen den spanischen und den portugiesischen Territorien in Lateinamerika wurde 1750 durch den Vertrag von Madrid geregelt.“"
                            },
                            {
                                "example_id": "1d6479c8-d4e1-4580-820c-8151023029fe",
                                "sense_id": "42657fdb-57d5-33d2-8b9f-41fda90dba0f",
                                "text": "„Bei der Grenzziehung zwischen Territorien steht selten das Wohl der Bevölkerung im Mittelpunkt.“"
                            },
                            {
                                "example_id": "7028d49c-dbee-4d41-b427-76b56bba04e4",
                                "sense_id": "42657fdb-57d5-33d2-8b9f-41fda90dba0f",
                                "text": "„Bundeskanzler Konrad Adenauer machte stets deutlich, dass die Bundesrepublik die neue Grenzziehung nicht anerkenne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
