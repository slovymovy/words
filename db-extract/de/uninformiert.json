                "senses": [
                    {
                        "sense_id": "64370953-3289-3f90-90ba-37ba00b015d8",
                        "entry_id": "60987f41-3fd0-3079-bd8c-ee77201c9a68",
                        "glosses": [
                            "nicht informiert, über keine Informationen verfügend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ae2e9a-a4c5-465c-b6e7-e4b1307df4d2",
                                "sense_id": "64370953-3289-3f90-90ba-37ba00b015d8",
                                "text": "„Ich bin nicht ganz uninformiert, was die logistischen Erfordernisse einer militärischen Auseinandersetzung betrifft.“"
                            },
                            {
                                "example_id": "6174fd9a-f5f6-4422-a0a5-ef3a8f527dd4",
                                "sense_id": "64370953-3289-3f90-90ba-37ba00b015d8",
                                "text": "„Mit dieser Annahme hätte der uninformierte Beobachter nicht falscher liegen können.“"
                            }
                        ],
