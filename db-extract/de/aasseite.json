                "senses": [
                    {
                        "sense_id": "1b2af3ea-6da7-3294-ba54-a1aff708cb92",
                        "entry_id": "cf4846ea-4116-3c58-b1df-9378fae4a514",
                        "glosses": [
                            "diejenige Seite der Tierhaut, die auf dem Fleisch gelegen hat"
                        ],
                        "tags": [
                            "Gerbereiwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "4f0fdab2-8f9b-4339-8abe-d7cbef707439",
                                "sense_id": "1b2af3ea-6da7-3294-ba54-a1aff708cb92",
                                "text": "„Zum Anderen[] die Seite[,] die ursprünglich mit dem Fleisch verbunden war, diese wird Aasseite genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4785b4d-9f60-4178-a7d2-eef56b1900de",
                        "source_entry_id": "cf4846ea-4116-3c58-b1df-9378fae4a514",
                        "source_sense_id": "1b2af3ea-6da7-3294-ba54-a1aff708cb92",
                        "source_sense_description": "Gerbereiwesen: diejenige Seite der Tierhaut, die auf dem Fleisch gelegen hat",
                        "target_lang_word": "flesh side",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "faefff8b-4cf4-4f29-b181-23f6d34808ce",
                        "source_entry_id": "cf4846ea-4116-3c58-b1df-9378fae4a514",
                        "source_sense_id": "1b2af3ea-6da7-3294-ba54-a1aff708cb92",
                        "source_sense_description": "Gerbereiwesen: diejenige Seite der Tierhaut, die auf dem Fleisch gelegen hat",
                        "target_lang_word": "coté chair",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "840c1cc2-bdc7-4060-992b-8c15f26cae9d",
                        "source_entry_id": "cf4846ea-4116-3c58-b1df-9378fae4a514",
                        "source_sense_id": "1b2af3ea-6da7-3294-ba54-a1aff708cb92",
                        "source_sense_description": "Gerbereiwesen: diejenige Seite der Tierhaut, die auf dem Fleisch gelegen hat",
                        "target_lang_word": "chair",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d637c6-642e-3df7-8f6a-3147f103391d",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Toutes les parties molles du corps humain et des animaux, et plus particulièrement la partie rouge des muscles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb4ac7f5-ece9-4680-9d1d-65833ab58bde",
                                                "sense_id": "b7d637c6-642e-3df7-8f6a-3147f103391d",
                                                "text": "Mais je n’ai plus trouvé qu’un horrible mélange\nD’os et de chairs meurtris et traînés dans la fange,\nDes lambeaux pleins de sang, et des membres affreux\nQue des chiens dévorants se disputaient entre eux…"
                                            },
                                            {
                                                "example_id": "77ee9272-cfc7-4caa-a181-e9aa0bfa5226",
                                                "sense_id": "b7d637c6-642e-3df7-8f6a-3147f103391d",
                                                "text": "Les graisses animales sont contenues dans tous les tissus et organes des animaux. […]. Le chyle et le lait en renferment aussi une quantité importante. Les chairs musculaires, par contre, en sont complètement dépourvues."
                                            },
                                            {
                                                "example_id": "3df846f1-d40b-44a2-a33b-30e65dae65ec",
                                                "sense_id": "b7d637c6-642e-3df7-8f6a-3147f103391d",
                                                "text": "Les cordelettes m'entraient dans la chair, les mains me faisaient mal et la position dans laquelle mes bras étaient maintenus me brisait les épaules."
                                            },
                                            {
                                                "example_id": "0f3b2ea5-6951-4b80-99d8-c492cc4092f5",
                                                "sense_id": "b7d637c6-642e-3df7-8f6a-3147f103391d",
                                                "text": "Quand il se dresse face à quelque « vieille écorce », chêne, frêne, ou hêtre, […] Arsène André éprouve une virile volupté. Sa chair se durcit, son col se gonfle, le sang lui afflue aux tempes à coups précipités"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24784451-03bf-314f-b572-ceb3093c88f6",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Parties molles qu’on traverse avec l’instrument tranchant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "141f0e77-0214-3516-a936-2dfafa1ed584",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Substance molle qu’on observe dans les solutions de continuité, formée principalement par les bourgeons vasculaires."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf95225-3255-4e22-b0ac-5529a0b14d13",
                                                "sense_id": "141f0e77-0214-3516-a936-2dfafa1ed584",
                                                "text": "Chairs baveuses, excroissances de chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a586dd73-a68c-3d47-bac7-3f80bbbae0e1",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "La viande des animaux terrestres et des oiseaux, considérée comme aliment."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6490a9f-f8aa-4117-b6f6-bdc991b9a19d",
                                                "sense_id": "a586dd73-a68c-3d47-bac7-3f80bbbae0e1",
                                                "text": "Chair de bœuf, de mouton. Chair crue, cuite, dure, tendre, fine, courte, longue, salée, fraîche."
                                            },
                                            {
                                                "example_id": "8c0fa31d-ac51-4ab4-a2ec-08a68872ad7e",
                                                "sense_id": "a586dd73-a68c-3d47-bac7-3f80bbbae0e1",
                                                "text": "De cette double proie l’oiseau se donne au cœur joie, ayant de cette façon à souper chair et poisson."
                                            },
                                            {
                                                "example_id": "eb4bbe2d-b281-4daa-852b-ac7f71e03a63",
                                                "sense_id": "a586dd73-a68c-3d47-bac7-3f80bbbae0e1",
                                                "text": "Des vieux qui n’avaient jamais contenté leur faim se rassasiaient. Un journalier surtout, un homme tout cassé et tout blanc, remuait ses mâchoires édentées avec lenteur, comme un bœuf à sa crèche, et penché vers sa femme, il lui disait à voix basse : « Donne-moi de la chair, de la chair, de la chair. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59fc4eeb-6502-391f-b3e7-cdb39ccf9d05",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Partie blanche ou rougeâtre, mais de nature musculeuse, que l’on mange dans les poissons."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c733197-2371-4839-b4ba-e3338506aae3",
                                                "sense_id": "59fc4eeb-6502-391f-b3e7-cdb39ccf9d05",
                                                "text": "Le saumon a la chair fine et ferme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b811d52-7009-3a1a-b16b-8dff56e0ff93",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "L’apparence, la peau, la carnation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e40b2d2-536c-4b3b-8fed-fddb4bcba25b",
                                                "sense_id": "8b811d52-7009-3a1a-b16b-8dff56e0ff93",
                                                "text": "Et chacun de me plaisanter ; ma jeunesse à son lever, mon parfum de fille fraîche, ma chair toute neuve en son premier éclat éveillaient chez les hommes de sournoises concupiscences, aiguisaient leur regard."
                                            },
                                            {
                                                "example_id": "354eedc2-e5ff-4514-aa74-390f762ff782",
                                                "sense_id": "8b811d52-7009-3a1a-b16b-8dff56e0ff93",
                                                "text": "Ce fut un grand Vaisseau taillé dans l’or massif :\nSes mâts touchaient l’azur, sur des mers inconnues ;\nLa Cyprine d’amour, cheveux épars, chairs nues,\nS’étalait à sa proue, au soleil excessif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c298445d-4c43-3019-8536-4fb667ed62ce",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Partie succulente de certains fruits, aussi appelée sarcocarpe."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e19bbd-f5cc-464b-9573-664cda17a7f8",
                                                "sense_id": "c298445d-4c43-3019-8536-4fb667ed62ce",
                                                "text": "La chair de la pêche, du melon, de l’abricot."
                                            },
                                            {
                                                "example_id": "65d3a28e-70b5-4131-b60a-54b288e7b1d9",
                                                "sense_id": "c298445d-4c43-3019-8536-4fb667ed62ce",
                                                "text": "Ils ont trouvé que [deux des composants des pommes], en particulier, sont bienfaisants pour les neurones : la quercétine (un flavonoïde, abondant dans la peau du fruit) et l’acide dihydroxybenzoïque (DHBA, plutôt présent dans la chair)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a43479f-12d8-3379-81b0-0c72a784b03f",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Être vivant, humain ou animal."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c2f884-d526-406d-8c90-90bb7a449bf7",
                                                "sense_id": "5a43479f-12d8-3379-81b0-0c72a784b03f",
                                                "text": "Hors des heures de louange, toute chair est ici en silence devant le Seigneur."
                                            },
                                            {
                                                "example_id": "9c4a9029-f217-41a1-a680-e747dbdb6253",
                                                "sense_id": "5a43479f-12d8-3379-81b0-0c72a784b03f",
                                                "text": "La multitude l’empêchat-elle d’exterminer toute chair au temps du déluge ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Corps considéré en opposition à la nature spirituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd69b26a-e00e-4d58-8e82-61e51667de71",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "Et le Verbe s’est fait chair, et Il a habité parmi nous."
                                            },
                                            {
                                                "example_id": "b436228a-b8b7-479c-9993-939b861c8369",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "Fils de cette sainte veuve plus selon l’esprit que selon la chair."
                                            },
                                            {
                                                "example_id": "754aac1e-35a1-41df-b8f3-b8b76b9f41dc",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "La multitude adore des divinités de chair et de sang."
                                            },
                                            {
                                                "example_id": "207d6b8a-1b1a-4856-8bb2-93486b964803",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "Honteux attachements de la chair et du monde."
                                            },
                                            {
                                                "example_id": "6d294272-79cf-4878-b301-48d6329f93f5",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "De la chair corrompue éteindre en nous les feux."
                                            },
                                            {
                                                "example_id": "5ad0652a-bd76-4a49-b6a4-e2609e1b524d",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "Nous allons triompher de la chair et du démon."
                                            },
                                            {
                                                "example_id": "f5fd0096-5d94-4b47-9b22-d86d288b59e1",
                                                "sense_id": "e3539620-3b35-3993-a127-a5f2db9dcb92",
                                                "text": "Saint Jérôme charge ses épaules d’un lourd fardeau, pour dompter une chair révoltée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82043646-8006-308b-93b7-908381a831a7",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Chez saint Paul, ensemble des pulsions éloignant de Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321ea11a-eef8-46ee-9480-a516b3a52f83",
                                                "sense_id": "82043646-8006-308b-93b7-908381a831a7",
                                                "text": "Le risque de se laisser gouverner par ses pulsions, que Paul appelle « la chair » – qui n'a aucun rapport avec le sexe mais qui a partie liée avec le péché –, existe toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Concupiscence charnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2399d3b1-f961-41d0-93b4-26946cb180a4",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Le péché de la chair tentait l’humanité."
                                            },
                                            {
                                                "example_id": "3e527a43-37eb-4e6c-ba04-344aa6c0ed57",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Vous êtes donc bien tendre à la tentation ; Et la chair sur vos sens fait grande impression."
                                            },
                                            {
                                                "example_id": "2e2050fa-429d-43af-bb6a-00bdd7996436",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Mes tempes battent ; toute ma chair va à cette femme presque nue et charmante dans le matin et dans le transparent vêtement qui enferme la douce odeur d’elle…"
                                            },
                                            {
                                                "example_id": "65c31a4a-0d0f-4b41-aded-cfa478003e5f",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Où avait-il appris à classer tout ce qui touche à la chair – à distinguer les caresses de l’honnête homme de celles du sadique ?"
                                            },
                                            {
                                                "example_id": "5a8980f5-7e25-4b9f-a8fd-6b79a2cb1901",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Elle ignorait profondément la chair, comme toute jeune fille vraiment pure."
                                            },
                                            {
                                                "example_id": "a8a60ceb-df9b-4ad0-81ba-38149ad74bb4",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Et il voyait le pécheur, accablé, resserré par la triste peur, traversant Claquebue et semant parmi les villageois la sainte méfiance de la chair qui est la première marche du paradis."
                                            },
                                            {
                                                "example_id": "ffd7889c-36bd-4cf9-a517-642e77166c64",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "J’étais tellement ignorant des choses de la chair qu’une bonne sœur m’en eût remontré !"
                                            },
                                            {
                                                "example_id": "345cfa5a-81a1-4434-b56f-95094f6766dd",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Bien qu’ayant été, sans aucun doute, une jeune mariée heureuse, à peine distinguait-elle le vice de la sexualité : elle associa toujours étroitement l’idée de chair à celle de péché."
                                            },
                                            {
                                                "example_id": "5d19b1f6-09d3-4efa-b6dc-877243d0d91c",
                                                "sense_id": "d6e3a937-aba2-3c79-8bbe-b38b35fc85bd",
                                                "text": "Petitement préoccupé de son salut, il était hanté par l’obsession de la chair et péchait à tout bout de champ avec de misérables bergères plus cupides que passionnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f0c292-b1cb-3044-8989-d60c165581f7",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Corps senti du point de vue de la personne même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e0e308d-bf93-4ae3-a977-36a146411ad6",
                                                "sense_id": "f0f0c292-b1cb-3044-8989-d60c165581f7",
                                                "text": "Quand on a été atteint dans sa chair, quand des proches ont été touchés, quand on est soignant… évidemment que je comprends ces critiques."
                                            },
                                            {
                                                "example_id": "466f5b61-38c5-48b0-b7ce-625f29a4f503",
                                                "sense_id": "f0f0c292-b1cb-3044-8989-d60c165581f7",
                                                "text": "Une personne n'est pas seulement un corps, mais une chair – le corps vécu de l'intérieur – et une âme – l'esprit vécu de l'intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a839d3e-48dd-3d8d-9107-5b4b86f1cfe6",
                                        "entry_id": "2611d6a5-71ff-3cca-be66-8a640bf8059b",
                                        "glosses": [
                                            "Côté de la peau opposé à celui où se trouve le poil."
                                        ],
                                        "tags": [
                                            "Travail du cuir"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dccf1ea2-eee3-3cb5-add1-6e7239a8dc11",
                                        "entry_id": "47da739c-be17-3398-9862-886bd747417f",
                                        "glosses": [
                                            "Beige rosé, proche de la couleur de la chair de l’Européen. #ffe9d1 #ffcba4"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f9bf86-f124-48ef-8a4a-34c62dd94b94",
                                                "sense_id": "dccf1ea2-eee3-3cb5-add1-6e7239a8dc11",
                                                "text": "Une vieille jeune douairière, connue par ses mises excentriques et ses irréprochables dîners, fait son entrée dans une des loges ; elle porte une robe chair, dont la teinte pâle fait un singulier contraste avec les roses d’emprunt de son teint ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
