{
    "word_family": [
        "grondement",
        "grondeur",
        "gronderie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "120409df-ce9b-326c-a84d-b5feac3c2584",
                    "sense_definition": "Réprimander quelqu'un avec sévérité en lui faisant des reproches.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reprimande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le père a <w>grondé</w> son fils parce qu'il n'avait pas rangé sa chambre."
                        },
                        {
                            "text": "Elle avait peur de se faire <w>gronder</w> par la maîtresse après avoir oublié ses devoirs."
                        }
                    ],
                    "common_phrases": [
                        "se faire gronder"
                    ],
                    "synonyms": [
                        "réprimander",
                        "disputer"
                    ]
                },
                {
                    "sense_id": "be149c02-72f4-3aee-9e5e-93a7f5167bc6",
                    "sense_definition": "Émettre un son sourd, menaçant et continu, en parlant d'un animal ou d'éléments naturels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit_sourd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au loin, le tonnerre commence à <w>gronder</w> derrière les montagnes sombres."
                        },
                        {
                            "text": "Le chien s'est mis à <w>gronder</w> dès qu'un inconnu a franchi le portail."
                        }
                    ],
                    "synonyms": [
                        "tonner"
                    ],
                    "common_phrases": [
                        "orage qui gronde"
                    ]
                },
                {
                    "sense_id": "0a96a40b-45db-3722-b96b-50199b286faf",
                    "sense_definition": "Manifester son mécontentement en marmonnant à mi-voix ; grommeler.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protester",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme quitta la pièce en <w>grondant</w> quelques paroles incompréhensibles."
                        },
                        {
                            "text": "Il continue de <w>gronder</w> tout seul quand les choses ne se passent pas comme prévu."
                        }
                    ],
                    "synonyms": [
                        "parler dans sa barbe"
                    ]
                },
                {
                    "sense_id": "79b9c6f2-6c3e-39ef-a1c7-c1db903f1c58",
                    "sense_definition": "Menacer d'éclater de façon sourde et continue, en parlant d'un sentiment collectif ou d'une révolte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "menacer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les usines de la région, la colère ouvrière <w>gronde</w> depuis plusieurs semaines."
                        },
                        {
                            "text": "Une nouvelle crise politique <w>gronde</w> au sein du parlement après ce vote contesté."
                        }
                    ],
                    "common_phrases": [
                        "la colère gronde",
                        "la révolte gronde"
                    ]
                }
            ]
        }
    ]
}