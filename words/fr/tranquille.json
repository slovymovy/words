                        "soyez tranquille"
                    ]
                },
                {
                    "sense_id": "caba2710-e7cb-32aa-a9fd-67472a71a4f3",
                    "sense_definition": "Se dit d'un vin qui ne contient pas de gaz carbonique perceptible et qui ne pétille pas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oenologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La carte du restaurant propose aussi bien des vins effervescents que des vins <w>tranquilles</w>."
                        },
                        {
                            "text": "Ce vigneron produit un vin blanc <w>tranquille</w> très réputé dans la région."
