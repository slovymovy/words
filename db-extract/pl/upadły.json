                    {
                        "form_id": "5aa93252-2387-477b-a2c8-48b8f669f714",
                        "entry_id": "6957c07a-86ce-3176-8e0a-8b0404b1782f",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "upadłe"
