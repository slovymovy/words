                "senses": [
                    {
                        "sense_id": "057090f2-e89d-332d-ac37-18fa617004a1",
                        "entry_id": "fd221e8e-864a-3280-8561-f15b65a6bfca",
                        "glosses": [
                            "den Vorgang des Messens von Unterdruck betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77a9455-481c-4222-a611-4f4f28d05a5b",
                                "sense_id": "057090f2-e89d-332d-ac37-18fa617004a1",
                                "text": "„Die Druck- bzw. Vakuummessung definiert sich dadurch, dass man eine Flächeneinheit bestimmt und die Anzahl sowie die Intensität dieser Stöße auf dieser Fläche gemessen wird.“"
                            },
                            {
                                "example_id": "8b3472b2-12ca-4ea8-bad5-6a7b469a0d54",
                                "sense_id": "057090f2-e89d-332d-ac37-18fa617004a1",
                                "text": "„Die Kontrolle erfolgt dabei z. B. am Manometer, durch Vakuummessung bei vakuumisolierten Behältern oder durch schaumbildende Mittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0de2d475-eece-3403-9ddd-7d8f01424556",
                        "entry_id": "fd221e8e-864a-3280-8561-f15b65a6bfca",
                        "glosses": [
                            "Ergebnis und Auswertung des Messvorgangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e71ff5d-83d2-4fa1-a13f-ea37ee5690c0",
                                "sense_id": "0de2d475-eece-3403-9ddd-7d8f01424556",
                                "text": "„Die Kontrolle erfolgt dabei z. B. am Manometer, durch Vakuummessung bei vakuumisolierten Behältern oder durch schaumbildende Mittel.“"
                            },
                            {
                                "example_id": "26fc2f2d-33f2-4487-9596-6fbfbf6f580a",
                                "sense_id": "0de2d475-eece-3403-9ddd-7d8f01424556",
                                "text": "„Die Massedifferenz zwischen der ersten und der zweiten Vakuummessung beträgt -0,8 µg und zwischen der ersten und letzten Messung in Luft -1,7 µg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
