    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65585c41-1843-3cc4-b0b9-f4784265bd81",
                    "sense_definition": "kulisty, pomarańczowy owoc o miękkim miąższu i pojedynczej pestce",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "owoce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem na targu kilogram dojrzałych, słodkich <w>moreli</w>.",
                            "target_lang_translations": {
                                "ru": "Я купил на рынке килограмм спелых, сладких <w>абрикосов</w>."
                            }
                        },
                        {
                            "text": "Moja babcia przygotowuje pyszny dżem z soczystych <w>moreli</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка готовит вкусный джем из сочных <w>абрикосов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dojrzała morela",
                        "dżem z moreli",
                        "suszone morele"
                    ],
                    "target_lang_definitions": {
                        "ru": "округлый оранжевый плод с мягкой мякотью и одной косточкой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абрикос",
                                "target_lang_sense_clarification": "плод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd52a181-0edb-3543-bee4-c5c09cfc0e4f",
                    "sense_definition": "drzewo owocowe z rodziny różowatych, rodzące morele",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drzewa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiosną nasza <w>morela</w> pięknie zakwitła na biało i różowo.",
                            "target_lang_translations": {
                                "ru": "Весной наш <w>абрикос</w> красиво зацвёл белым и розовым."
                            }
                        },
                        {
                            "text": "Posadziliśmy młodą <w>morelę</w> w słonecznym zakątku ogrodu.",
                            "target_lang_translations": {
                                "ru": "Мы посадили молодой <w>абрикос</w> в солнечном уголке сада."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kwitnąca morela",
                        "posadzić morelę"
                    ],
                    "target_lang_definitions": {
                        "ru": "плодовое дерево семейства розовых, приносящее абрикосы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абрикос",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "абрикосовое дерево",
                                "target_lang_sense_clarification": "дерево"
                            }
                        ]
                    }
