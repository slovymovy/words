                        "entry_id": "123979f8-6671-3867-87bc-c48aad09ff23",
                        "glosses": [
                            "Any of various insects of the order Zygoptera; damselfly."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2233727-d77f-4f6f-b365-4f0bbb2e575a",
                        "source_entry_id": "123979f8-6671-3867-87bc-c48aad09ff23",
                        "source_sense_id": "20350bdb-a438-3d56-bebb-c4975ad84bb2",
                        "source_sense_description": "damselfly",
                        "target_lang_word": "zygoptère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zygoptère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09b6baf9-2ca5-39fb-9170-dcdfbc20341a",
                                        "entry_id": "2361ca42-6a1e-38ce-8a94-e62a45f1a4e8",
                                        "glosses": [
                                            "Individu appartenant à un sous-ordre d’insectes appelés couramment demoiselles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2878570-8c7a-435b-8d5b-0764de43ac27",
                                                "sense_id": "09b6baf9-2ca5-39fb-9170-dcdfbc20341a",
                                                "text": "Les odonates regroupent les anisoptères et les zygoptères qui présentent des morphologies très différentes aussi bien à l’état larvaire qu’adulte."
                                            },
                                            {
                                                "example_id": "1e450a8f-d5f9-435d-a030-1b1107ed0d89",
                                                "sense_id": "09b6baf9-2ca5-39fb-9170-dcdfbc20341a",
                                                "text": "De petite taille, au corps très fin et au vol mal assuré, les Zygoptères sont néanmoins des espèces prédatrices se nourrissant de petits insectes (moucherons, moustiques…)."
                                            },
                                            {
                                                "example_id": "b908e2ea-df7f-4dbe-b1ef-f291b0d5a00c",
                                                "sense_id": "09b6baf9-2ca5-39fb-9170-dcdfbc20341a",
                                                "text": "Les zygoptères ou demoiselles possèdent des ailes antérieures et postérieures identiques qu'elles replient au-dessus du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58f92162-4a3c-4369-83da-fb0b8fba586c",
                        "source_entry_id": "123979f8-6671-3867-87bc-c48aad09ff23",
                        "source_sense_id": "20350bdb-a438-3d56-bebb-c4975ad84bb2",
                        "source_sense_description": "damselfly",
                        "target_lang_word": "demoiselle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demoiselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92726f39-aea5-34ff-8f65-9e7788a282c9",
                                        "entry_id": "64f09e46-c18a-3bb4-925b-fbe0e29fe942",
                                        "glosses": [
                                            "Qualifie une fille qui n’est pas mariée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "834f4f44-38ca-48e4-a29e-790e7cbe812e",
                                                "sense_id": "92726f39-aea5-34ff-8f65-9e7788a282c9",
                                                "text": "Je ne suis pas mariée. Oui je suis demoiselle, et pourtant cet enfant, cet enfant, c’est à moi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demoiselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1a095b-7f35-3245-a09b-73aeffddfb38",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Terme de politesse, par lequel on désigne les jeunes filles et, par le passé, les femmes non mariées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe82a706-e4a2-41a5-b333-20b8dada40bf",
                                                "sense_id": "8f1a095b-7f35-3245-a09b-73aeffddfb38",
                                                "text": "Héloïse portait un tablier court si coquet, brodé de coton rouge […] qu’Arsène André ne pouvait la quitter des yeux, tant elle avait l’air « gent », une façon de demoiselle bien éduquée."
                                            },
                                            {
                                                "example_id": "533a9b30-ec1d-4e13-bad3-57337431753e",
                                                "sense_id": "8f1a095b-7f35-3245-a09b-73aeffddfb38",
                                                "text": "Nastia (riant et regardant la corneille) : - Loukeria, que fais-tu donc ? Allons à la maison.\nKol’ka (ayant bu et regardant la corneille) : - Pourquoi est-elle donc Loukeria ? Il est vrai qu’elle est encore une demoiselle. Que pour cette raison elle soit Lou."
                                            },
                                            {
                                                "example_id": "58dd4d5e-0e76-4896-832b-18229ae3d4e9",
                                                "sense_id": "8f1a095b-7f35-3245-a09b-73aeffddfb38",
                                                "text": "C’est une demoiselle bien née, bien élevée."
                                            },
                                            {
                                                "example_id": "bc08532b-816e-4ff4-b921-9720f73629e7",
                                                "sense_id": "8f1a095b-7f35-3245-a09b-73aeffddfb38",
                                                "text": "Elle est encore demoiselle."
                                            },
                                            {
                                                "example_id": "a398eb23-7d3a-4d6c-85c1-d60d24a12ab6",
                                                "sense_id": "8f1a095b-7f35-3245-a09b-73aeffddfb38",
                                                "text": "Institution de demoiselles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5109a6d-c445-300d-b9a6-a3f363e68717",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Terme de politesse, par lequel on désigne les jeunes filles et, par le passé, les femmes non mariées.",
                                            "Institutrice."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3223f94-ad03-3c34-8e7f-26c054e5d4ba",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Fille née de parents nobles ; le titre est l’équivalent féminin d’écuyer."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0389c7d4-870e-428a-b002-f0759c7d686d",
                                                "sense_id": "d3223f94-ad03-3c34-8e7f-26c054e5d4ba",
                                                "text": "Ce bourgeois a fait la folie d’épouser une demoiselle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19630546-fdcc-37b1-9b72-6acfd5bc5a64",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Femme mariée et bourgeoise née de parents nobles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "708171ca-3629-30c3-9a38-c74dbd8f3f5d",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Femme, mariée ou non, attachée à un établissement de commerce, à une administration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2282ddfe-eedc-4bd2-acec-e212740b40bc",
                                                "sense_id": "708171ca-3629-30c3-9a38-c74dbd8f3f5d",
                                                "text": "En 1811, la paysanne fut une assez gentille, une assez adroite et intelligente première demoiselle."
                                            },
                                            {
                                                "example_id": "4fb74260-b535-48c4-991d-79c9997fc02c",
                                                "sense_id": "708171ca-3629-30c3-9a38-c74dbd8f3f5d",
                                                "text": "Elle a réservé à son enfant une situation de demoiselle, c’est-à-dire qu’elle s’est saignée pour lui faire apprendre la sténo et la dactylographie."
                                            },
                                            {
                                                "example_id": "4822881e-ebfe-4558-aa56-f748c28a0288",
                                                "sense_id": "708171ca-3629-30c3-9a38-c74dbd8f3f5d",
                                                "text": "Notre esprit est toujours comme à la merci d’un téléphoniste farceur, —de préférence, il est vrai, une demoiselle du téléphone,— qui lui branche la communication avec n’importe qui, n’importe quoi […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3b83d0-7a4e-3e09-b686-6f5218837a71",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Insecte du sous-ordres des zygoptères, à quatre ailes membraneuses, souvent confondu avec les libellules et qui s’en distingue par un vol plus lent et un corps plus petit et plus frêle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9759aeff-05bf-4dbd-9df0-fb1dc40c3ea1",
                                                "sense_id": "9b3b83d0-7a4e-3e09-b686-6f5218837a71",
                                                "text": "Il y avait des jours où elle courait dans le jardin comme une fille de dix ans, après un papillon ou une demoiselle."
                                            },
                                            {
                                                "example_id": "41f1ff2e-1cd3-45bc-a3b5-4a4a32dc34da",
                                                "sense_id": "9b3b83d0-7a4e-3e09-b686-6f5218837a71",
                                                "text": "Les demoiselles se reproduisent en s’arrimant en vol, comme les libellules : le mâle saisit la femelle par la tête ou le thorax à l’aide d’une pince au bout de l’abdomen, la femelle pose l’extrémité de son abdomen sous le premier segment de l’abdomen du mâle. Vu de côté, le couple apparaît alors comme un cœur, les deux insectes restant attachés ainsi sans faire de bruit et venant souvent se poser sur la végétation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b390e29e-83f9-3e81-bf28-8737953789ed",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Variante de poisson-demoiselle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "429e9812-be40-3641-aba4-1b753fea83bb",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Synonyme de girelle commune femelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91d04c22-e8de-3d27-a508-d2af8aebb942",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Synonyme de cépole commune."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcef0c00-a3e9-330e-922b-3e9383e253d3",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Bloc vertical de pierre se trouvant sur les versants de certaines montagnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731d75d9-c92d-420d-be7b-efb06e702f91",
                                                "sense_id": "dcef0c00-a3e9-330e-922b-3e9383e253d3",
                                                "text": "Demoiselle coiffée, pilier surmonté d’un bloc de pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56901d7-902d-3b0c-83e6-f3bc0c67c8a9",
                                        "entry_id": "79d7a1c2-5ffe-3fc6-8f72-f702ea0b03bd",
                                        "glosses": [
                                            "Mesure de capacité utilisée pour le calvados, généralement égale à dix centilitres."
                                        ],
                                        "tags": [
                                            "Normandie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68041ef3-3c17-45f2-898b-f67a80f24e86",
                                                "sense_id": "d56901d7-902d-3b0c-83e6-f3bc0c67c8a9",
                                                "text": "[…] sous ce prétexte qu’ils n’avaient pas faim -d’une croûte de pain et d’une « demoiselle de calvados » , qu’ils m’ont dit payer quatre sous."
                                            },
                                            {
                                                "example_id": "eede9744-3bb5-4c6f-9e1c-91858a5f8f30",
                                                "sense_id": "d56901d7-902d-3b0c-83e6-f3bc0c67c8a9",
                                                "text": "Tous les moments forts de la vente des bestiaux ou des produits fermiers se passent au cabaret où les \"demoiselles de Calvados\" s’activent. Ces verres, joliment baptisés, contiennent la valeur de trois verres à liqueur ordinaires."
                                            },
                                            {
                                                "example_id": "f7979673-180e-4bcd-a91c-493a5d716e05",
                                                "sense_id": "d56901d7-902d-3b0c-83e6-f3bc0c67c8a9",
                                                "text": "Ainsi sa feinte impotence fonctionnelle à se relever, lors de la reconstitution de la découverte du corps : au cabaret, où il lui arrive de débrider sa fantaisie, quand il a quelques chopines, demoiselles, gloria et autres douceurs dans le nez, le bonhomme se complaît à faire étalage de sa souplesse et à la fois de sa résistance à l’alcool, en se plaçant en équilibre sur un pied, coude au genou levé, avec un verre plein à ras bord dans une main qui ne tremble pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demoiselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29e13fea-cea1-3dc6-998a-148e16badd67",
                                        "entry_id": "489bb790-8644-3c86-8664-97f1c5f0ae85",
                                        "glosses": [
                                            "Dame, hie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d740a6c8-ae85-4a9f-8dc8-c2d12d39a3bc",
                                                "sense_id": "29e13fea-cea1-3dc6-998a-148e16badd67",
                                                "text": "[Les ouvriers] frappent un coup sur leur bâtisse pour durcir leur pisé, avec un de ces lourds pilons de bois qu’on appelle des « demoiselles »."
                                            },
                                            {
                                                "example_id": "5102621a-1812-4fc2-86c6-9496d6d8669b",
                                                "sense_id": "29e13fea-cea1-3dc6-998a-148e16badd67",
                                                "text": "Nous fîmes quelques pas vers un point où se dressait une sorte d’instrument de pavage, rappelant par sa structure les demoiselles − ou hies − qu’on emploie au nivellement des chaussées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1260569-de57-339b-8e41-fd5321a18d27",
                                        "entry_id": "489bb790-8644-3c86-8664-97f1c5f0ae85",
                                        "glosses": [
                                            "Sorte de pince en bois servant à élargir les doigts de gants."
                                        ],
                                        "tags": [
                                            "Ganterie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36a2a566-3304-3ebb-96bf-fbb732e0e585",
                                        "entry_id": "489bb790-8644-3c86-8664-97f1c5f0ae85",
                                        "glosses": [
                                            "Jambier en cuir dont les scieurs se servent pour se protéger les genoux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb712ae4-52d3-3030-9812-c3fa5e198aad",
                                        "entry_id": "489bb790-8644-3c86-8664-97f1c5f0ae85",
                                        "glosses": [
                                            "Verge de métal utilisée dans les fonderies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60fb6673-6a2b-3e8e-8af5-e7e81b077b8b",
                                        "entry_id": "489bb790-8644-3c86-8664-97f1c5f0ae85",
                                        "glosses": [
                                            "Dispositif qui soutient le chevalet des scieurs de long."
                                        ],
                                        "tags": [],
