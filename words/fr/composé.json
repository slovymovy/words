                    ]
                },
                {
                    "sense_id": "f5d1f1d1-a212-3e0a-8723-e1c00161d494",
                    "sense_definition": "Qui affiche une attitude affectée, artificielle ou excessivement mesurée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il parlait d'un ton particulièrement <w>composé</w> qui masquait mal son agitation."
                        },
                        {
                            "text": "Son maintien toujours <w>composé</w> lui donnait un air étrangement distant."
                        }
                    ],
                    "common_phrases": [
