                "senses": [
                    {
                        "sense_id": "2a9d5855-8c2f-3206-80b4-486cf34bacb8",
                        "entry_id": "90ca3f5e-a88a-3318-acfe-3fc52752abcd",
                        "glosses": [
                            "Wohnung, die im Besitz eines Bundeslandes ist und seinen Beschäftigten zur Miete angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb6f570-0f2a-47a6-8d8d-f0abb0cb3b7a",
                                "sense_id": "2a9d5855-8c2f-3206-80b4-486cf34bacb8",
                                "text": "„Dass er wegen unbezahlter Reiserechnungen, nicht abgeführter Aufsichtsratsbezüge und mietfreier Nutzung einer Landeswohnung im Spätherbst 1999 als Niedersachsens Regierungschef zurücktreten musste, hat ihm zwar geschadet - aber sein Engagement für die Heimat kaum gebremst.“"
                            },
                            {
                                "example_id": "9f3a95a8-595b-4a24-990b-358643c7e41a",
                                "sense_id": "2a9d5855-8c2f-3206-80b4-486cf34bacb8",
                                "text": "„Was aber ist mit den Häuslbauern und mit jenen Menschen, die nicht in einer Landeswohnung wohnen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
