                                    },
                                    {
                                        "sense_id": "32ed9a48-3844-3c7f-aa17-a9c3e96d4078",
                                        "entry_id": "45af75c2-b32c-31b7-856b-f87e4f1004c2",
                                        "glosses": [
                                            "A messy, disorderly or confusing combination; a conglomeration; hodgepodge."
                                        ],
                                        "tags": [],
