                        ],
                        "examples": [
                            {
                                "example_id": "9fb04953-0dc0-4ec6-8f3f-2d750e976f2d",
                                "sense_id": "a28c3bde-0ef1-32b5-a0d6-a90ffe0ed914",
                                "text": "Cela a lieu dans l’échauboulure (sudamina-hydroa), maladie locale très légère, comme dans les plus graves, telles que la fièvre jaune, le typhus, la peste, le choléra, maladie qui affectent simultanément tout l’organisme, qui le frappe de sidération."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f42e18-faf4-31b5-8927-e333fecfb8df",
                        "entry_id": "ee0b06ba-1b92-31ab-943d-0e12c8061722",
                        "glosses": [
                            "Maladie de la peau qui apparaît subitement chez le cheval et chez le bœuf, sous la forme de bosselures."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d0c88ffc-c406-4d8d-96b5-b74ab26f662c",
                                "sense_id": "e7f42e18-faf4-31b5-8927-e333fecfb8df",
                                "text": "Une vache bretonne, de l’âge de sept ans, fut affectée de tumeurs, ressemblant à celles de l’échauboulure, et qui se montrèrent sur certaines parties du corps."
                            }
                        ]
                    }
