                                "target_senses": [
                                    {
                                        "sense_id": "899d0c25-e20d-3498-bbf7-f30adbfd0363",
                                        "entry_id": "2315dd5a-d13a-31db-b342-ecd8ab63f70a",
                                        "glosses": [
                                            "To beat, to strike."
