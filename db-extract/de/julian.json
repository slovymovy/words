                    {
                        "translation_id": "592df095-bb01-4825-80c0-6c11c51ed1f7",
                        "source_entry_id": "cb90d719-8052-3f2c-8e5a-71601418b31e",
                        "source_sense_id": "2bde4745-f530-32a5-8a72-53952e68929d",
