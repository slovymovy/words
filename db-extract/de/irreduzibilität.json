                ],
                "senses": [
                    {
                        "sense_id": "7b347146-2b32-3d61-9166-39f1eb432e9a",
                        "entry_id": "f397c88f-04c6-3e02-a05a-378e9faaaa30",
                        "glosses": [
                            "Eigenschaft, zum Beispiel einer Aussage, nicht aus Bestehendem ableitbar nicht auf eine Grundform zurückführbar (reduzibel, reduzierbar) zu sein"
                        ],
                        "tags": [
                            "oder aber"
                        ],
                        "examples": [
                            {
                                "example_id": "f92324c1-d2bc-49bc-907d-3d8735617da1",
                                "sense_id": "7b347146-2b32-3d61-9166-39f1eb432e9a",
                                "text": "„Denn die Überzeugung, dass Subjektivität im Bewusstsein eine Sonderstellung einnehme, speist sich vor allem aus der Entdeckung seiner epistemischen Irreduzibilität, die (zumindest) als ein Hinweis auf seine ontologische Irreduzibilität verstanden werden kann.“"
                            },
                            {
                                "example_id": "4a2572f7-e14b-40d6-ae45-115202e973ab",
                                "sense_id": "7b347146-2b32-3d61-9166-39f1eb432e9a",
                                "text": "„Dafür wollen wir zuerst definieren, was wir überhaupt unter einem Polynom und der Irreduzibilität von Polynomen verstehen. Am Ende wollen wir dann Kriterien kennenlernen, um Polynome auf Irreduzibilität zu überprüfen.“"
                            },
                            {
                                "example_id": "3dd2d2eb-6682-42fd-a5c8-1b29b4e0327f",
                                "sense_id": "7b347146-2b32-3d61-9166-39f1eb432e9a",
                                "text": "„Wir beginnen mit der Irreduzibilität, was salopp gesprochen bedeutet, dass jedes Element si des Ereignisraums S der Markovkette von jedem anderen Element sj aus erreicht werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
