                "senses": [
                    {
                        "sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
                        "entry_id": "853298f0-7d72-3f2e-aa65-1f16e5c9d579",
                        "glosses": [
                            "Partisan du créationnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b880fc4-d92c-41ef-a4eb-1e5f45dda9c9",
                                "sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
                                "text": "Tous les créationnistes s’accordent sur le fait que le monde tel que nous le connaissons est le produit d’une volonté divine."
                            },
                            {
                                "example_id": "37f09351-fd8a-428d-a3c8-1f862aa3d0c6",
                                "sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
                                "text": "Avec lui — autre force d’appoint à la Première ministre britannique —, des créationnistes qui exigent que leurs thèses figurent dans les musées et les programmes scolaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ece33097-a825-44ca-8398-cba9c084cac1",
                        "source_entry_id": "853298f0-7d72-3f2e-aa65-1f16e5c9d579",
                        "source_sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
