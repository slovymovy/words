{
    "word_family": [
        "scourer",
        "scouring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12e3a9e6-5687-38e4-b192-4e41bd680679",
                    "sense_definition": "To clean, polish, or wash something by rubbing it vigorously, often using an abrasive or detergent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>scour</w> the dirty pots to make them shine again.",
                            "target_lang_translations": {
                                "tr": "Kirli tencereleri tekrar parlatmak için <w>ovalamak</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "He used a rough sponge to <w>scour</w> grease off the stove.",
                            "target_lang_translations": {
                                "tr": "Ocağın üzerindeki yağı <w>kazıyıp ovalamak</w> için sert bir sünger kullandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrub",
                        "rub"
                    ],
                    "common_phrases": [
                        "scour the pan",
                        "scour clean"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi ovalayarak, aşındırıcı veya deterjan kullanarak iyice temizlemek, parlatmak veya yıkamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ovalamak",
                                "target_lang_sense_clarification": "sürterek temizlemek"
                            },
                            {
                                "target_lang_word": "ovup parlatmak",
                                "target_lang_sense_clarification": "sürterek parlatmak"
                            },
                            {
                                "target_lang_word": "bulaşık teliyle ovalamak",
                                "target_lang_sense_clarification": "sert bir cisimle ovarak yıkamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dedeca42-7ce6-3e0d-abd1-c1220efb603f",
                    "sense_definition": "To clear or sweep away debris or sediment from a channel or surface, usually by a strong current of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fast-flowing rivers <w>scour</w> the seabed and carry sediment downstream.",
                            "target_lang_translations": {
                                "tr": "Hızlı akan nehirler deniz yatağını <w>oyup süpürür</w> ve tortuyu akıntı yönünde taşır."
                            }
                        },
                        {
                            "text": "Heavy floodwaters <w>scour</w> the riverbed during the stormy season.",
                            "target_lang_translations": {
                                "tr": "Şiddetli sel suları fırtınalı sezonda nehir yatağını <w>aşındırır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "flush",
                        "purge"
                    ],
                    "common_phrases": [
                        "scour the riverbed",
                        "scour out"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güçlü bir su akıntısıyla bir kanal veya yüzeydeki tortu veya birikintileri söküp süpürmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aşındırıp süpürmek",
                                "target_lang_sense_clarification": "su akıntısıyla tortuları temizlemek"
                            },
                            {
                                "target_lang_word": "oymak",
                                "target_lang_sense_clarification": "akıntı sebebiyle oyarak temizlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dc2db4f-b518-36f3-839a-14d22b9b168f",
                    "sense_definition": "To cleanse something without using abrasive scrubbing, such as by chemical action or soaking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Special detergents help <w>scour</w> raw wool before it is spun.",
                            "target_lang_translations": {
                                "tr": "Özel deterjanlar, eğrilmeden önce ham yünün <w>temizlenmesine</w> yardımcı olur."
                            }
                        },
                        {
                            "text": "The chemical solution will <w>scour</w> the metal naturally without scratching it.",
                            "target_lang_translations": {
                                "tr": "Kimyasal çözelti metali çizmeden doğal olarak <w>arındıracaktır</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi ovmadan, kimyasal işlem veya suda bekletme yoluyla arındırmak ve temizlemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "arındırmak",
                                "target_lang_sense_clarification": "kimyasal yolla pisliğini/yağını temizlemek"
                            },
                            {
                                "target_lang_word": "yağını almak",
                                "target_lang_sense_clarification": "ham yün vb. maddelerin yağını yıkamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3579c0b-6fcc-3c0e-adb2-f0e826e78096",
                    "sense_definition": "To purge or empty the digestive tract of an animal, usually with medicine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian used a special mixture to <w>scour</w> the sick horse.",
                            "target_lang_translations": {
                                "tr": "Veteriner, hasta atın <w>bağırsaklarını temizlemek</w> için özel bir karışım kullandı."
                            }
                        },
                        {
                            "text": "Farmers sometimes treat livestock to <w>scour</w> their digestive systems.",
                            "target_lang_translations": {
                                "tr": "Çiftçiler bazen hayvanların sindirim sistemlerini <w>boşaltmak</w> için tedavi uygularlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "purge"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir hayvanın sindirim sistemini ilaç veya yöntemlerle temizlemek, boşaltmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "müshil vermek",
                                "target_lang_sense_clarification": "bağırsaklarını temizlemek"
                            },
                            {
                                "target_lang_word": "sindirim sistemini temizlemek",
                                "target_lang_sense_clarification": "hayvanın bağırsaklarını arındırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a9bfb97-5985-3781-a4a5-e7b4e5b3b99c",
                    "sense_definition": "To suffer from, or cause livestock to suffer from, severe diarrhoea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If young calves start to <w>scour</w>, they require immediate medical attention.",
                            "target_lang_translations": {
                                "tr": "Genç buzağılar <w>ishal olmaya</w> başlarsa acil tıbbi müdahale gerekir."
                            }
                        },
                        {
                            "text": "Contaminated water can cause farm animals to <w>scour</w> severely.",
                            "target_lang_translations": {
                                "tr": "Kirli su, çiftlik hayvanlarının şiddetli şekilde <w>ishal olmasına</w> neden olabilir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çiftlik hayvanlarında şiddetli ishale yakalanmak veya ishale yol açmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "amel olmak",
                                "target_lang_sense_clarification": "hayvanlarda şiddetli ishal olmak"
                            },
                            {
                                "target_lang_word": "ishal olmak",
                                "target_lang_sense_clarification": "şiddetli ishal geçirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d26f4c9-a11d-3a77-8b2e-87874bd68783",
                    "sense_definition": "To search a place or area thoroughly and carefully in order to find something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investigators will <w>scour</w> the area looking for evidence after the incident.",
                            "target_lang_translations": {
                                "tr": "Müfettişler olaydan sonra delil aramak için bölgeyi <w>didik didik edecekler</w>."
                            }
                        },
                        {
                            "text": "I had to <w>scour</w> the internet to find a rare replacement part.",
                            "target_lang_translations": {
                                "tr": "Nadir bulunan bir yedek parçayı bulmak için internetin <w>altını üstüne getirmek</w> zorunda kaldım."
                            }
                        }
                    ],
                    "synonyms": [
                        "search",
                        "comb",
                        "rummage"
                    ],
                    "common_phrases": [
                        "scour the area",
                        "scour the web",
                        "scour for clues"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi bulmak için bir yeri veya alanı çok dikkatli ve ayrıntılı bir şekilde aramak, altını üstüne getirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "didik didik etmek",
                                "target_lang_sense_clarification": "her yeri ayrıntısıyla aramak"
                            },
                            {
                                "target_lang_word": "altını üstüne getirmek",
                                "target_lang_sense_clarification": "kapsamlı bir şekilde aramak"
                            },
                            {
                                "target_lang_word": "taramak",
                                "target_lang_sense_clarification": "bir bölgeyi veya ortamı aramak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ecb894c-b6ad-37b2-9542-29818b8c0992",
                    "sense_definition": "To move quickly across or over an area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wild horses <w>scour</w> the plains in search of fresh pasture.",
                            "target_lang_translations": {
                                "tr": "Vahşi atlar taze otlak arayışıyla ovaları <w>dolanırlar</w>."
                            }
                        },
                        {
                            "text": "The wind seemed to <w>scour</w> the field as the storm approached.",
                            "target_lang_translations": {
                                "tr": "Fırtına yaklaşırken rüzgar tarlayı <w>süpürüp geçiyor</w> gibiydi."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweep"
                    ],
                    "common_phrases": [
                        "scour the plain"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary/dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir alanın üzerinden hızlıca geçmek veya süpürürcesine hareket etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "süpürüp geçmek",
                                "target_lang_sense_clarification": "hızla alan üzerinden geçmek"
                            },
                            {
                                "target_lang_word": "hızla katetmek",
                                "target_lang_sense_clarification": "arazi üstünde hızlı gitmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9da29c5c-b643-3a39-929e-b6432ddc7e26",
                    "sense_definition": "To run or move with great speed; to scurry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened animals began to <w>scour</w> across the open terrain.",
                            "target_lang_translations": {
                                "tr": "Ürkten hayvanlar açık arazide <w>seğirtmeye</w> başladılar."
                            }
                        },
                        {
                            "text": "They watched the messengers <w>scour</w> away toward the harbour.",
                            "target_lang_translations": {
                                "tr": "Elçilerin limana doğru <w>hızla seğirtmelerini</w> izlediler."
                            }
                        }
                    ],
                    "synonyms": [
                        "scurry",
                        "dash"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok büyük bir hızla koşmak veya hareket etmek; seğirtmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "seğirtmek",
                                "target_lang_sense_clarification": "hızla koşmak"
                            },
                            {
                                "target_lang_word": "fırlayıp kaçmak",
                                "target_lang_sense_clarification": "hızla uzaklaşmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f51e970-09bc-3f38-a4c1-aa9b7f4ed0fa",
                    "sense_definition": "The localized erosion or removal of soil or sediment caused by fast-moving water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers checked the bridge piers to prevent structural damage from water <w>scour</w>.",
                            "target_lang_translations": {
                                "tr": "Mühendisler, su <w>oyulmasından</w> kaynaklanan yapısal hasarı önlemek için köprü ayaklarını kontrol etti."
                            }
                        },
                        {
                            "text": "Heavy flooding increased the <w>scour</w> around the riverbanks.",
                            "target_lang_translations": {
                                "tr": "Şiddetli sel, nehir kıyılarındaki <w>aşınmayı</w> artırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "erosion"
                    ],
                    "common_phrases": [
                        "bridge scour"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı akan suyun neden olduğu yerel toprak veya tortu erozyonu/aşınması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "oyulma",
                                "target_lang_sense_clarification": "su akıntısının sebep olduğu erozyon"
                            },
                            {
                                "target_lang_word": "su erozyonu",
                                "target_lang_sense_clarification": "akıntı nedeniyle toprağın kaybolması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53d882a2-7de8-39d4-ab20-47503613bd5b",
                    "sense_definition": "A channel, hole, or depression carved out by running water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anglers often find trout resting in a deep <w>scour</w> beneath the waterfall.",
                            "target_lang_translations": {
                                "tr": "Olta balıkçıları, alabalıkları sık sık şelalenin altındaki derin bir <w>su oyuğunda</w> dinlenirken bulurlar."
                            }
                        },
                        {
                            "text": "Water carved a wide <w>scour</w> at the bottom of the dam.",
                            "target_lang_translations": {
                                "tr": "Su, barajın tabanında geniş bir <w>oyuk</w> açtı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Akan suyun oluşturduğu çukur, kanal veya oyuk."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "su oyuğu",
                                "target_lang_sense_clarification": "akıntının açtığı çukur"
                            },
                            {
                                "target_lang_word": "oyulmuş kanal",
                                "target_lang_sense_clarification": "akarsuyun oluşturduğu yarık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d53a173-aca5-3729-adef-2c34a7d26936",
                    "sense_definition": "An industrial facility or place where raw wool is washed to remove grease and dirt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local economy relies heavily on the wool <w>scour</w> in the region.",
                            "target_lang_translations": {
                                "tr": "Bölge ekonomisi büyük ölçüde bölgedeki <w>yün yıkama tesisine</w> dayanmaktadır."
                            }
                        },
                        {
                            "text": "Raw fleece is sent directly to a commercial <w>scour</w> before spinning.",
                            "target_lang_translations": {
                                "tr": "Ham yapağı, eğrilmeden önce doğrudan ticari bir <w>yıkama tesisine</w> gönderilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wool scour"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ham yünün yağ ve kirden arındırıldığı endüstriyel tesis veya yıkama tesisi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yün yıkama tesisi",
                                "target_lang_sense_clarification": "yün temizleme fabrikası"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03c5e975-6ae5-31b8-90fa-f03e8c49f445",
                    "sense_definition": "Diarrhoea affecting livestock, especially young farm animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer called the vet to treat an outbreak of calf <w>scour</w>.",
                            "target_lang_translations": {
                                "tr": "Çiftçi, buzağı <w>ishali</w> salgınını tedavi etmesi için veterineri çağırdı."
                            }
                        },
                        {
                            "text": "Proper nutrition helps prevent severe <w>scour</w> in young lambs.",
                            "target_lang_translations": {
                                "tr": "Doğru beslenme, genç kuzularda şiddetli <w>ishalin</w> önlenmesine yardımcı olur."
                            }
                        }
                    ],
                    "synonyms": [
                        "diarrhoea"
                    ],
                    "common_phrases": [
                        "calf scour"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle genç çiftlik hayvanlarını etkileyen şiddetli ishal hastalığı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hayvan ishali",
                                "target_lang_sense_clarification": "buzağı/kuzu ishali hastalığı"
                            },
                            {
                                "target_lang_word": "amel",
                                "target_lang_sense_clarification": "hayvanlarda görülen ishal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}