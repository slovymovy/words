                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "749c7586-af9b-4a4d-a511-f88a5e46d662",
                        "source_entry_id": "8dbd397a-620a-3822-825d-f1f07364d346",
                        "source_sense_id": "aba7c1cb-2e56-315b-bda0-f00efc471073",
                        "source_sense_description": "the capital city of Syria",
                        "target_lang_word": "Damaskus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Damaskus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                        "entry_id": "c8cc2dc3-ee8a-3d25-b484-c801db36aeac",
                                        "glosses": [
                                            "Hauptstadt Syriens"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852181b0-f3ec-4839-8e3c-021114d67d82",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "Damaskus ist die Hauptstadt Syriens."
                                            },
                                            {
                                                "example_id": "b88d610e-daea-4a1b-a50f-c6c38e34fade",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„In Damaskus und den meisten anderen Städten entstanden die muntadajat, private Diskussionsgruppen, die großen Zulauf hatten.“"
                                            },
                                            {
                                                "example_id": "c7bc0ec7-6191-41aa-bfbf-08df7afc9e9b",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Teeverkäufer auf der Straße, eine Bäckerei, die samunis - irakische Brötchen - herstellt, und regionale Spezialitäten aus dem Irak in den Auslagen der Restaurants - in den Vororten von Damaskus wie Jaramana oder Saida Zainab gehört all das inzwischen zum Stadtbild.“"
                                            },
                                            {
                                                "example_id": "31a465c6-2c91-44bd-bc22-9b149a6e394b",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Der Junior versucht nach den Einschätzungen der israelischen Agenten in Damaskus, seine Macht zu konsolidieren, indem er den Scharfmacher gibt.[…]Der Mossad hat keine Zweifel, dass es bei diesen Geheimgesprächen um eine weitere Aufrüstung Syriens geht - Pjöngjang hat schon in der Vergangenheit bei der Entwicklung von Mittelstreckenraketen und Chemiewaffen wie Sarin oder Senfgas Damaskus geholfen.“"
                                            },
                                            {
                                                "example_id": "a6aa4367-bfd3-4be6-b83e-66c9f2b193cf",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Gegen den ‚kleinen‘ Assad arbeiten die Israelis mit Nadelstichen. Mehrfach bombardiert die Luftwaffe 2003 Stellungen an der syrischen Grenze, im Oktober jagen Kampfbomber im Tiefflug über die Residenz Assads in Damaskus - eine arrogante Machtdemonstration, die auch beim Mossad viele den Kopf schütteln lässt: Wie wird der Gedemütigte reagieren?“"
                                            },
                                            {
                                                "example_id": "0aa9067e-0e53-48a6-ae94-9215248802c2",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Damaskus’ Hegemonie über den Zedernstaat war Riad schon lange ein Dorn im Auge gewesen.“"
                                            },
                                            {
                                                "example_id": "bcdf56d0-a33d-4f5d-97d4-910fd8439dfe",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Nach der israelischen Invasion im Südlibanon 1982, die auf die Zerstörung der Palästinensischen Befreiungsorganisation (PLO) und die Eingliederung des Zedernstaats in die israelische Einflusszone zielte, verbündete sich Damaskus auch noch mit dem schiitischen Widerstand im Nachbarland.“"
                                            },
                                            {
                                                "example_id": "f1fdecdf-5ceb-4efc-9c10-9ea63c3e6f0f",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Ich hatte gerade beschlossen, den Nachmittag mit einer in arabischer Sprache verfassten Sammlung von Kurzgeschichten zu verbringen, die in den Gassen der Altstadt von Damaskus spielten.“"
                                            },
                                            {
                                                "example_id": "0394b728-3dc6-4513-b408-d59b15a78952",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Syriens Regierungstruppen konzentrieren sich den Angaben zufolge inzwischen darauf, die Kontrolle über Großstädte wie Damaskus und Aleppo zu behalten.“"
                                            },
                                            {
                                                "example_id": "df333272-f0be-4a95-b73b-619f872e9aba",
                                                "sense_id": "2d435817-c99f-3463-89da-748821c3116d",
                                                "text": "„Auch nach 1946 zogen immer mehr Alawiten, um der Armut zu entkommen, nach Damaskus und Homs, wo sie zumeist ein Kleingewerbe aufnahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
