                "senses": [
                    {
                        "sense_id": "389e51df-f9d6-3e86-884d-386652fe201d",
                        "entry_id": "f62b89cb-7a3f-364d-b8a2-b96b39d662a8",
                        "glosses": [
                            "rodzaj ulicy w mieście zaprojektowanej w celu zwiększenia bezpieczeństwa przede wszystkim pieszych i rowerzystów, którzy mają priorytet przed samochodami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67284502-3d1f-4406-94b4-fe6a0a61ec97",
                                "sense_id": "389e51df-f9d6-3e86-884d-386652fe201d",
                                "text": "Na woonerfie bardzo ważną rolę pełnią bowiem meble miejskie, czyli ławki, stojaki na rowery, place zabaw oraz drzewa i trawniki"
                            },
                            {
                                "example_id": "328e1ec7-d36d-4012-b0d7-7ec559b584ce",
                                "sense_id": "389e51df-f9d6-3e86-884d-386652fe201d",
                                "text": "W artykule omówiony został rozwój koncepcji modernizacji ulic w polskich miastach zgodnie z zasadami woonerf"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bae58d65-b115-4589-bb34-ae0938122f65",
                        "source_entry_id": "f62b89cb-7a3f-364d-b8a2-b96b39d662a8",
