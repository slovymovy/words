                        "entry_id": "ee547f7a-972d-3f4e-9e9e-b483f2753751",
                        "glosses": [
                            "The quality or state of happening every day, or frequently."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ca1955e4-1b47-4914-9ee3-8cd0f74096fd",
                                "sense_id": "3320d305-850d-3119-a265-624ec3580faf",
                                "text": "Lily reaches into the everydayness of our lives to expose, not only the overall lack of consciousness in American society, but our personal faux-pas's in relating as human beings."
                            },
                            {
                                "example_id": "0a1570fa-440d-4103-9f12-1f67a3a9645f",
                                "sense_id": "3320d305-850d-3119-a265-624ec3580faf",
                                "text": "... brings tranquilized self-assurance... into the average everydayness of Dasein."
                            }
                        ]
                    },
                    {
                        "sense_id": "76bfea9b-9f41-3669-863e-0f29ac29529e",
                        "entry_id": "ee547f7a-972d-3f4e-9e9e-b483f2753751",
                        "glosses": [
                            "The product or result of happening every day, or frequently."
