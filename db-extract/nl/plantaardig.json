                            {
                                "target_word": "vegetable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693bd47c-9e3e-3317-bac5-b5c5917d52fd",
                                        "entry_id": "7df9ef67-50b2-3885-bfa3-a56846405bd6",
                                        "glosses": [
                                            "Of or relating to plants."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc7d7bf-44fe-4597-bdb5-9e73cad00be8",
                                                "sense_id": "693bd47c-9e3e-3317-bac5-b5c5917d52fd",
                                                "text": "This substance is vegetable not mineral."
                                            },
                                            {
                                                "example_id": "482bb700-34c9-4a1d-ab00-fbd036e92838",
                                                "sense_id": "693bd47c-9e3e-3317-bac5-b5c5917d52fd",
                                                "text": "On an early winter afternoon, clear but not cold, when the vegetable world was a weird multitude of skeletons through whose ribs the sun shone freely, a gleaming landau came to a pause on the crest of a hill in Wessex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d6374a-8b90-3112-9541-499fc31621c7",
                                        "entry_id": "7df9ef67-50b2-3885-bfa3-a56846405bd6",
