        "fr-extract.jsonl": [
            {
                "entry_id": "635c8fe1-6f9b-3437-870b-2ef84a858391",
                "word": "lumbago",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "194c5d37-6e72-49f6-a484-ba56b60a83c1",
                        "entry_id": "635c8fe1-6f9b-3437-870b-2ef84a858391",
                        "tags": [
                            "plural"
                        ],
                        "form": "lumbagos"
                    },
                    {
                        "form_id": "d834e418-f506-44bf-aff2-ca53a34e0ba0",
                        "entry_id": "635c8fe1-6f9b-3437-870b-2ef84a858391",
                        "tags": [],
                        "form": "lombago"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "295d0624-8ca4-344a-bef9-e9d4a75fe0a5",
                        "entry_id": "635c8fe1-6f9b-3437-870b-2ef84a858391",
                        "glosses": [
                            "Douleur d’origine rhumatismale, ou produite par un effort musculaire, dans la région lombaire."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c9d8b51f-ea9e-47d6-b2e3-7efad5882524",
                                "sense_id": "295d0624-8ca4-344a-bef9-e9d4a75fe0a5",
                                "text": "Julius sourit avec une accommodante condescendance et, pour changer de sujet, demande à son beau-frère des nouvelles de sa sciatique, qu’il appelle par erreur : son lumbago."
                            },
                            {
                                "example_id": "0e8378a8-97d0-428d-97ee-4411eca91641",
                                "sense_id": "295d0624-8ca4-344a-bef9-e9d4a75fe0a5",
                                "text": "Le mal de dos prend souvent pour noms : « lumbago » (ou « tour de reins »), lié à un début de détérioration du disque intervertébral qui se fissure et s’enflamme à certains endroits, « hernie discale », résultant d’une dégénérescence d’un disque intervertébral, et « sciatique », conséquence de la hernie qui vient comprimer le nerf sciatique, à la jonction entre les deux dernières vertèbres lombaires et le sacrum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b627dd15-25c1-48e1-88a4-e457378a49de",
                        "source_entry_id": "635c8fe1-6f9b-3437-870b-2ef84a858391",
                        "source_sense_id": "295d0624-8ca4-344a-bef9-e9d4a75fe0a5",
                        "target_lang_word": "Hexenschuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexenschuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                        "entry_id": "738b0db5-63a6-33de-a381-648ba554c4a8",
                                        "glosses": [
                                            "plötzlich auftretender Schmerz im Bereich des unteren Rückens, der Lendenwirbel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ccb77a-f5b0-4e92-93d1-f3f720da432c",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Sein Hexenschuss hinderte ihn daran, zum Volleyballtraining zu gehen."
                                            },
                                            {
                                                "example_id": "2d59fd96-296b-4238-a334-3aac8f20a9c4",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Ein Hexenschuss kann äußerst schmerzhaft sein."
                                            },
                                            {
                                                "example_id": "bea439ab-adb5-4037-9166-f073dc46309d",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Eine perfekte Sportart zur Stärkung der Rückenmuskulatur und Vorbeugung gegen den Hexenschuss ist Rudern."
                                            },
                                            {
                                                "example_id": "0a008e87-e795-43d9-910d-bcf02c879101",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "[Die Ärztin] setzt eine Spritze gegen den Hexenschuss."
                                            },
                                            {
                                                "example_id": "0123c7dc-6780-4f7b-aa54-e63470658fcd",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Ein unachtsames Aufrichten und schon ist es passiert: Wer einmal von einem Hexenschuss heimgesucht wurde, will das so schnell nicht wieder erleben."
                                            },
                                            {
                                                "example_id": "e341299f-62a4-4fbb-95c8-0c4f5c0c1df3",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "„Hans Werner Kettenbach kennt die Klischees des Erzählens und erfüllt sie zuweilen auch augenzwinkernd: Ein in die Jahre gekommener Playboy, kann eines Tages auf dem Parkplatz vor seinem Tennisklub nicht mehr aus seinem Porsche Carrera aussteigen. Der Grund: ein Hexenschuss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5374df01-5267-4229-bb7b-738ffd031a5a",
                        "source_entry_id": "635c8fe1-6f9b-3437-870b-2ef84a858391",
                        "source_sense_id": "295d0624-8ca4-344a-bef9-e9d4a75fe0a5",
                        "target_lang_word": "lumbago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumbago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb036885-cfeb-325f-8bf6-fd88ea201c9a",
                                        "entry_id": "9b4f0bd4-7bf5-3fad-a76f-1b92c3cdc539",
                                        "glosses": [
                                            "Backache of the lumbar region or lower back, which can be caused by muscle strain or a slipped disc."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12009875-8c08-45ab-bef6-f6d920aff329",
                                                "sense_id": "fb036885-cfeb-325f-8bf6-fd88ea201c9a",
                                                "text": "Sir Oswald Feiling winced as he turned to go home. He had felt a warning twinge of lumbago."
                                            },
                                            {
                                                "example_id": "882a7d5e-8b2e-4e29-bd9c-ec93c1e4817f",
                                                "sense_id": "fb036885-cfeb-325f-8bf6-fd88ea201c9a",
                                                "text": "We may imagine an athletics coach with a scientific training researching into the physiology and the psychology of runners. [...] He finds out the effects of fatigue, of alcohol, of tobacco, of lumbago and of depression upon their performances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b44ad2db-d7f6-36cf-9990-cb7276a0bf8f",
                                        "entry_id": "9b4f0bd4-7bf5-3fad-a76f-1b92c3cdc539",
                                        "glosses": [
                                            "An episode of such backache."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
