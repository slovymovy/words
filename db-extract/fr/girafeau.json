                        "glosses": [
                            "Petit de la girafe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f4245f6-ac85-4896-978a-a1ad713146dc",
                                "sense_id": "082e52b0-cc04-3752-a573-352182ad26c4",
                                "text": "Il faut attendre à l'affût une mère et son petit, et s'élancer à leur poursuite ; après de grands efforts, quand on s’est rendu maître du girafeau, on le lie au pied d'un arbre."
                            },
                            {
                                "example_id": "3bfead27-6c23-4e85-b95b-6022a3417ce1",
                                "sense_id": "082e52b0-cc04-3752-a573-352182ad26c4",
                                "text": "Elle plie les genoux comme un girafeau nouveau-né."
                            }
                        ]
                    }
