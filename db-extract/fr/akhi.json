                                                "example_id": "d9c1adb2-b6a8-4fb6-8e18-0c7d8b4d3197",
                                                "sense_id": "cd70f8be-a137-34a5-9ac9-c721c90294c6",
                                                "text": "Bro said he finna go off today!"
