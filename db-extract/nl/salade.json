                                            {
                                                "example_id": "2e2160a9-7f46-4b04-83a1-4437e6ea84a6",
                                                "sense_id": "87fce8ae-d0e8-3c9f-a2a0-7d9b45253832",
                                                "text": "Lafeu. ’Twas a good lady, ’twas a good lady: we may pick a thousand salads ere we light on such another herb.\nClown. Indeed, sir, she was the sweet marjoram of the salad, or rather, the herb of grace."
                                            },
