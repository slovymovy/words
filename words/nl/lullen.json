    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a9a6915-ab18-3e56-bf7e-9a76685f9f74",
                    "sense_definition": "onzinnige of onbelangrijke dingen zeggen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat zit je nou te <w>lullen</w> over dingen waar je niets van weet?",
                            "target_lang_translations": {
                                "en": "What are you <w>talking bullshit</w> about things you know nothing about?"
                            }
                        },
                        {
                            "text": "Stop met <w>lullen</w> en ga eindelijk eens aan het werk.",
                            "target_lang_translations": {
                                "en": "Stop <w>babbling</w> and finally get to work."
                            }
                        }
                    ],
                    "synonyms": [
                        "poep praten"
                    ],
                    "common_phrases": [
                        "slap lullen",
                        "uit je nek lullen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and can be perceived as slightly rude"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to talk nonsense or about unimportant things in an informal or annoying way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "talk bullshit",
                                "target_lang_sense_clarification": "to speak nonsense or lies"
                            },
                            {
                                "target_lang_word": "babble",
                                "target_lang_sense_clarification": "to talk foolishly or at length"
                            },
                            {
                                "target_lang_word": "chat",
                                "target_lang_sense_clarification": "to talk informally for a long time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cc45545-437c-3938-8a3c-a36c26db681f",
                    "sense_definition": "geheime informatie aan anderen doorgeven of iemand verraden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verraden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft tegen de politie zitten <w>lullen</w> over onze plannen.",
                            "target_lang_translations": {
                                "en": "He's been <w>snitching</w> to the police about our plans."
                            }
                        },
                        {
                            "text": "Als je gaat <w>lullen</w> tegen de leraar, krijg je grote problemen.",
                            "target_lang_translations": {
                                "en": "If you <w>blab</w> to the teacher, you'll be in big trouble."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tegen de politie lullen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in criminal or informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to pass on secret information to others or to betray someone by talking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snitch",
                                "target_lang_sense_clarification": "to inform on someone to an authority"
                            },
                            {
                                "target_lang_word": "blab",
                                "target_lang_sense_clarification": "to reveal secrets through talk"
                            },
                            {
                                "target_lang_word": "rat",
                                "target_lang_sense_clarification": "to betray someone by giving information"
                            }
                        ]
                    }
                }
            ]
        },
        {
