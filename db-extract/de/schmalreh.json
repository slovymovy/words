                "senses": [
                    {
                        "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                        "entry_id": "9d000803-e62a-3d6d-8fa1-3cdd7b6182d4",
                        "glosses": [
                            "weibliches Tier des Rehwildes im 2. Lebensjahr, das noch nicht gekalbt hat"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "581d937e-6c2b-42d8-ad45-dc6cc6faf08c",
                                "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                                "text": "Das weibliche Tier ist im zweiten Lebensjahr ein Schmalreh, danach eine Ricke, in Süddeutschland auch Geiß."
                            },
                            {
                                "example_id": "18abe9cc-03fb-4257-8040-8af692e245bf",
                                "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                                "text": "Die eigentliche Blattzeit beginnt jedoch erst Ende Juli. Dann ist der überwiegende Teil der Ricken und Schmalrehe „beschlagen“, von einem Rehbock befruchtet worden."
                            },
                            {
                                "example_id": "c0220f1a-59db-4348-badc-dcb059403336",
                                "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                                "text": "Mit dem 1. Mai beginnt neben der begehrten Jagd auf den Rehbock auch die Schusszeit auf Schmalrehe."
                            },
                            {
                                "example_id": "a791b1a2-a56f-411b-91c7-203adb2aa49f",
                                "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                                "text": "Ein Schmalreh zweifelsfrei zu identifizieren, ist nicht allein an Gesicht, Verfärbung oder Verhalten möglich."
                            },
                            {
                                "example_id": "e61b9f38-aa45-491c-854f-d429b746149f",
                                "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                                "text": "Bei einer Revierfahrt im Oktober sehen Sie ein Schmalreh in schussgerechter Entfernung. Wie dürfen Sie das Schmalreh erlegen? [Antwort: Aussteigen, auf dem Dach des Pkw auflegen und schießen]"
                            },
                            {
                                "example_id": "1f59dd20-97a6-4a75-8030-141e2384ef48",
                                "sense_id": "77722322-30e9-3e4b-beca-00a80ad7eab2",
                                "text": "Übrigens: Schon bei Tempo 100 prallt ein nur 20 kg schweres Schmalreh mit einer Wucht von einer halben Tonne auf das Fahrzeug."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
