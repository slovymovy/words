                "senses": [
                    {
                        "sense_id": "d946176d-67ff-35d5-8636-e8a70f105674",
                        "entry_id": "bcbc0084-81bc-3bab-adb1-e8ffddcb166a",
                        "glosses": [
                            "een aan de want vast gemaakte eenvoudige open kast voor het opbergen van zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf91926d-fba1-4891-b944-5aab823c8669",
                                "sense_id": "d946176d-67ff-35d5-8636-e8a70f105674",
                                "text": "Bij een huiszoeking stuitten de ambtenaren op de sensationele voorraad kunst. Maar liefst 1.400 schilderijen van grootmeesters als Picasso, Klee, Monet, Cézanne, Renoir en Matisse bleken te zijn opgeborgen in zijn flat. De toen 80-jarige Gurlitt had de waardevolle doeken verstopt in zelfgetimmerde wandrekken in een verduisterde kamer."
                            }
                        ]
                    },
                    {
                        "sense_id": "5abec6ad-7d50-3e89-be5c-6e5378fe31d9",
                        "entry_id": "bcbc0084-81bc-3bab-adb1-e8ffddcb166a",
                        "glosses": [
                            "een soort gymnastiek toestel dat is vastgemaakt aan de wand en bestaat uit horizontale ronde stangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377b77ab-4617-4ba7-8c46-cc6d7bc76542",
                                "sense_id": "5abec6ad-7d50-3e89-be5c-6e5378fe31d9",
                                "text": "Over opgerolde matten, kasten en via wandrekken springen de leerlingen van de Menno ter Braakschool van mat naar mat. Op uitnodiging van de Sportfederatie Berkelland komen de scholieren dinsdagmiddag een uurtje freerunnen in de Pickerhal."
                            },
                            {
                                "example_id": "1c25d2a7-17a9-4523-b18d-4af1cd0b4671",
                                "sense_id": "5abec6ad-7d50-3e89-be5c-6e5378fe31d9",
                                "text": "Hoewel het gymnastieklokaal aan de Wilhelminastraat in Wierden, naast zalencentrum Het Anker, op de nominatie staat voor sloop, worden de twee wandrekken in de zaal toch vervangen."
                            }
                        ]
                    }
