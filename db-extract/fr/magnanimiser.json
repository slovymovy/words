                        "glosses": [
                            "Donner un caractère magnanime à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b17004e-bcf8-4d64-9826-4ec42802aa88",
                                "sense_id": "6b5019f6-4204-36e2-ba10-ed9636c6f529",
                                "text": "Pour l’atteindre il faut envisager l’homme dans toute sa grandeur et sa misère sans essayer de le rapetisser pour l’entrer dans le cadre de telle science ou de le magnanimiser pour le rendre dieu."
                            },
                            {
                                "example_id": "8e99dca1-e831-424b-8a4e-a92723e8dd2c",
                                "sense_id": "6b5019f6-4204-36e2-ba10-ed9636c6f529",
                                "text": "Ainsi se forme l'image d'une révolution purifiée et, si je puis dire, magnanimisée ;"
                            },
                            {
                                "example_id": "e4cc7fe0-fbf8-46c9-b47a-d16cd9970dd2",
                                "sense_id": "6b5019f6-4204-36e2-ba10-ed9636c6f529",
                                "text": "Mais cessons de magnanimiser et passons à l'attraction principale: (…)"
                            }
                        ]
