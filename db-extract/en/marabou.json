                                "target_senses": [
                                    {
                                        "sense_id": "89dc1610-309c-3dc7-8b42-f993dfdeb72a",
                                        "entry_id": "7968661a-3135-3909-8a0e-c0f3388edf24",
                                        "glosses": [
                                            "die Vogelgattung Leptoptilos in der Familie der Störche"
                                        ],
                                        "tags": [
                                            "Zoologische Taxonomie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfa9e61c-0f64-460f-90e9-c68fa3782a40",
                                                "sense_id": "89dc1610-309c-3dc7-8b42-f993dfdeb72a",
                                                "text": "Marabus fliegen im Gegensatz zu anderen Störchen mit gebogenem Hals."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fad026f-283e-374a-9bd7-7fcc80b77dba",
                                        "entry_id": "7968661a-3135-3909-8a0e-c0f3388edf24",
                                        "glosses": [
                                            "ein Vertreter der Marabus, die mit drei Arten vertreten ist"
                                        ],
                                        "tags": [
                                            "im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d05a95-8aa9-492f-8f08-847f5234f1e7",
                                                "sense_id": "7fad026f-283e-374a-9bd7-7fcc80b77dba",
                                                "text": "Der Marabu ist zwar keine besonders hübsche, aber eine sehr interessante Vogelgestalt."
                                            },
                                            {
                                                "example_id": "aee54b35-105f-4e50-af84-928595281779",
                                                "sense_id": "7fad026f-283e-374a-9bd7-7fcc80b77dba",
                                                "text": "„Celeste hatte die Insel auf 99 Jahre gepachtet und brachte Besucher aus der Stadt mit dem Floß hinüber zu seinen Hirschkühen, Pelikanen und Marabus, zu den Mufflons aus dem Aïr und den Dorkas-Gazellen aus der Ténéré.“"
                                            },
                                            {
                                                "example_id": "4ee6e11d-a54b-46f0-9d1b-5a9c04572053",
                                                "sense_id": "7fad026f-283e-374a-9bd7-7fcc80b77dba",
                                                "text": "„Auf der Hotelwiese hüpfen Marabus, durch die plötzliche Unruhe irritiert.“"
                                            },
                                            {
                                                "example_id": "45af0708-f6c1-4cdd-b662-3ed64f6998a3",
                                                "sense_id": "7fad026f-283e-374a-9bd7-7fcc80b77dba",
                                                "text": "„Zu seiner Zeit kreisten Geier und Marabus über die Leichen der Aufständischen.“"
                                            },
                                            {
                                                "example_id": "00a8573c-afd3-4458-a91b-a52d02b29abe",
                                                "sense_id": "7fad026f-283e-374a-9bd7-7fcc80b77dba",
                                                "text": "„Sein Sinnbild ist der Marabu, ein langbeiniger schöner Storchenvogel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf024e3f-acad-3613-9083-800fc468db91",
                                        "entry_id": "7968661a-3135-3909-8a0e-c0f3388edf24",
                                        "glosses": [
                                            "speziell ein Vertreter der Art Marabu (Leptoptilos crumeniferus)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
