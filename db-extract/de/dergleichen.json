                                "sense_id": "32c228b8-8f23-3afd-90a7-f5710165df73",
                                "text": "Dergleichen Fälle gibt es hier zuhauf.",
                                "translation": "Such cases are numerous around here.",
                                "english": "Such cases are numerous around here."
                            },
                            {
                                "example_id": "a7f5c156-e9bd-4793-82cb-742fd7a8356a",
                                "sense_id": "32c228b8-8f23-3afd-90a7-f5710165df73",
                                "text": "Dergleichen Bier findet man sonst nirgends.",
                                "translation": "One won’t find such beer anywhere else.",
                                "english": "One won’t find such beer anywhere else."
                            },
                            {
                                "example_id": "c7288c2e-45c5-4793-bb3b-50c6b9f673ca",
                                "sense_id": "32c228b8-8f23-3afd-90a7-f5710165df73",
                                "text": "Dergleichen ist auch vorher schon vorgekommen.",
                                "translation": "Such a thing has already occurred before.",
                                "english": "Such a thing has already occurred before."
                            }
                        ]
                    },
                    {
                        "sense_id": "2478c808-72de-32c5-8a4b-ab37939d5864",
                        "entry_id": "d661cf4f-7da9-39d9-a782-681936e2a0cd",
