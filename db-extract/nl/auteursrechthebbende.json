                        "examples": [
                            {
                                "example_id": "059ecc38-09d8-47d9-98d5-15f465f79a51",
                                "sense_id": "732593ab-98d0-38ee-867c-090947db633b",
                                "text": "Via Popcorn Time kunnen mensen zonder te betalen films en tv-series bekijken. Tim Kuik, directeur van stichting Brein, zei eerder vandaag dat bij meerdere auteursrechthebbenden \"het water aan de lippen staat\", onder meer door de komst van Popcorn Time. Daardoor is er volgens Kuik behoefte om zaken te gaan starten. Brein is zelf voorlopig niet van plan om achter individuele gebruikers aan te gaan."
                            },
                            {
                                "example_id": "d19c39f5-60a0-44ce-b8c5-1949e4a6bbb9",
                                "sense_id": "732593ab-98d0-38ee-867c-090947db633b",
                                "text": "Sinds april 2014 is het illegaal in Nederland om te downloaden uit illegale bron, dus zonder toestemming van de auteursrechthebbende. Tot dan toe viel illegaal downloaden onder de uitzondering voor het maken van een thuiskopie, maar volgens het Europese Hof van Justitie was dat onterecht."
                            }
                        ]
                    }
