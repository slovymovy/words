{
    "word_family": [
        "perspectival",
        "perspectivism",
        "perspectively",
        "perspectivist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "813cc2de-64a5-30ab-987e-85e47f0e129e",
                    "sense_definition": "A particular attitude towards or way of regarding something; a point of view.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "viewpoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try to see the problem from my <w>perspective</w> before you judge.",
                            "target_lang_translations": {
                                "ru": "Постарайся взглянуть на проблему с моей <w>точки зрения</w>, прежде чем судить.",
                                "zh": "在你下判断之前，先试着从我的<w>角度</w>看这个问题。"
                            }
                        },
                        {
                            "text": "The author offers a unique <w>perspective</w> on the historical events of that era.",
                            "target_lang_translations": {
                                "ru": "Автор предлагает уникальный <w>взгляд</w> на исторические события той эпохи.",
                                "zh": "作者对那个时代的历史事件提出了独特的<w>视角</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "viewpoint",
                        "standpoint",
                        "outlook",
                        "angle",
                        "stance"
                    ],
                    "common_phrases": [
                        "from a perspective",
                        "different perspective",
                        "broader perspective",
                        "historical perspective",
                        "new perspective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое отношение к чему-либо или способ восприятия; точка зрения.",
                        "zh": "看待某事的特定态度或方式；观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка зрения",
                                "target_lang_sense_clarification": "мнение, определённый взгляд на что-либо"
                            },
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "мнение или суждение по какому-либо вопросу"
                            },
                            {
                                "target_lang_word": "ракурс",
                                "target_lang_sense_clarification": "способ рассмотрения ситуации, сторона дела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视角",
                                "target_lang_sense_clarification": "看待事物的角度，强调观察位置或切入点"
                            },
                            {
                                "target_lang_word": "观点",
                                "target_lang_sense_clarification": "对某事的意见或立场"
                            },
                            {
                                "target_lang_word": "角度",
                                "target_lang_sense_clarification": "从某一方面来看问题的方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6335c866-8fcb-3bc0-804f-4ac9fffa2b35",
                    "sense_definition": "The ability to understand the true importance of things relative to each other; a sensible view of the world.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to keep things in <w>perspective</w> and not worry about minor details.",
                            "target_lang_translations": {
                                "ru": "Важно сохранять <w>объективность</w> и не беспокоиться по пустякам.",
                                "zh": "保持<w>大局观</w>很重要，不要为细枝末节担心。"
                            }
                        },
                        {
                            "text": "The recent health scare put her career problems into <w>perspective</w>.",
                            "target_lang_translations": {
                                "ru": "Недавние проблемы со здоровьем показали истинный <w>масштаб</w> её карьерных неурядиц.",
                                "zh": "最近这次健康警讯让她更能看清自己职业问题的<w>轻重缓急</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proportion",
                        "context"
                    ],
                    "common_phrases": [
                        "keep in perspective",
                        "put into perspective",
                        "lose perspective",
                        "sense of perspective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность видеть вещи в их истинном соотношении и важности; объективная оценка ситуации.",
                        "zh": "理解事物彼此之间真实重要性和相对关系的能力；一种理性、审慎的看法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объективность",
                                "target_lang_sense_clarification": "способность оценивать вещи без предвзятости"
                            },
                            {
                                "target_lang_word": "масштаб",
                                "target_lang_sense_clarification": "истинное соотношение величин или важности событий"
                            },
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "видение ситуации в целом (в идиоматических выражениях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大局观",
                                "target_lang_sense_clarification": "从整体上判断事情轻重主次的能力"
                            },
                            {
                                "target_lang_word": "分寸感",
                                "target_lang_sense_clarification": "对事情分寸和真实重要性的把握"
                            },
                            {
                                "target_lang_word": "轻重缓急",
                                "target_lang_sense_clarification": "事情孰轻孰重、先后主次的整体判断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72a46550-58e1-3948-90a3-8be284436399",
                    "sense_definition": "The art or technique of drawing solid objects on a two-dimensional surface so as to give the right impression of their height, width, depth, and position in relation to each other.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "art_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used <w>perspective</w> to make the road look like it disappeared into the distance.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>перспективу</w>, чтобы дорога казалась уходящей вдаль.",
                                "zh": "画家运用<w>透视法</w>，让这条路看起来像是一直延伸到远方。"
                            }
                        },
                        {
                            "text": "Children often learn the basics of linear <w>perspective</w> in art class.",
                            "target_lang_translations": {
                                "ru": "Дети часто изучают основы линейной <w>перспективы</w> на уроках рисования.",
                                "zh": "孩子们常常在美术课上学习线性<w>透视</w>的基础知识。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in perspective",
                        "linear perspective",
                        "forced perspective",
                        "aerial perspective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или техника изображения объёмных тел на плоскости, передающая их глубину и положение в пространстве.",
                        "zh": "在二维平面上描绘立体物体，使其呈现高、宽、深以及彼此位置关系的艺术或技法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "способ изображения объёмных фигур на плоскости"
                            },
                            {
                                "target_lang_word": "проекция",
                                "target_lang_sense_clarification": "изображение пространственных фигур на плоскости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "透视法",
                                "target_lang_sense_clarification": "在平面上表现空间深度和远近关系的绘画技法"
                            },
                            {
                                "target_lang_word": "透视",
                                "target_lang_sense_clarification": "绘画或制图中表现立体空间关系的方法"
                            },
                            {
                                "target_lang_word": "远近法",
                                "target_lang_sense_clarification": "传统绘画术语，强调远近深浅的表现"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6069eb31-cb57-3334-9187-4194f1d1c897",
                    "sense_definition": "Relating to the art of representing three-dimensional depth and spatial relationships on a flat surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "art_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect presented a <w>perspective</w> drawing of the proposed building.",
                            "target_lang_translations": {
                                "ru": "Архитектор представил <w>перспективный</w> чертёж предлагаемого здания.",
                                "zh": "建筑师展示了拟建建筑的一张<w>透视的</w>图纸。"
                            }
                        },
                        {
                            "text": "We studied various <w>perspective</w> techniques during the design course.",
                            "target_lang_translations": {
                                "ru": "Мы изучали различные методы построения <w>перспективы</w> во время курса дизайна.",
                                "zh": "我们在设计课上学习了各种<w>透视的</w>技法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "perspective drawing",
                        "perspective view",
                        "perspective projection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к искусству изображения трёхмерного пространства на плоскости.",
                        "zh": "与在平面上表现三维深度和空间关系的艺术有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перспективный",
                                "target_lang_sense_clarification": "связанный с правилами перспективы в черчении или рисовании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "透视的",
                                "target_lang_sense_clarification": "与透视表现或透视法有关的"
                            },
                            {
                                "target_lang_word": "透视法的",
                                "target_lang_sense_clarification": "与在平面上表现空间深度有关的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}