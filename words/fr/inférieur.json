        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22e1a1cd-7d64-3268-a6b8-b159b7d920b9",
                    "sense_definition": "Personne qui est subordonnée à une autre dans une organisation ou une hiérarchie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hierarchie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce gestionnaire sait écouter ses <w>inférieurs</w> et tenir compte de leurs avis.",
                            "target_lang_translations": {
                                "en": "This manager knows how to listen to his <w>subordinates</w> and take their views into account.",
                                "ru": "Этот руководитель умеет выслушивать своих <w>подчинённых</w> и учитывать их мнения.",
                                "de": "Diese Führungskraft versteht es, ihren <w>Untergebenen</w> zuzuhören und deren Meinungen zu berücksichtigen.",
                                "es": "Este gerente sabe escuchar a sus <w>subordinados</w> y tener en cuenta sus opiniones.",
                                "zh": "这位经理懂得倾听<w>下属</w>的想法，并认真考虑他们的意见。"
                            }
                        },
                        {
                            "text": "Il n'est jamais acceptable de s'adresser à un <w>inférieur</w> avec mépris.",
                            "target_lang_translations": {
                                "en": "It is never acceptable to speak to a <w>subordinate</w> with contempt.",
                                "ru": "Никогда не допустимо обращаться к <w>подчинённому</w> с презрением.",
                                "de": "Es ist niemals akzeptabel, einen <w>Untergebenen</w> mit Verachtung anzusprechen.",
                                "es": "Nunca es aceptable dirigirse a un <w>subordinado</w> con desprecio.",
                                "zh": "用轻蔑的态度对待<w>下属</w>，绝对是不能接受的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subordonné"
                    ],
                    "antonyms": [
                        "supérieur"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is subordinate to another in an organization or hierarchy.",
                        "ru": "Человек, подчинённый другому в организации или иерархии.",
                        "de": "Person, die in einer Organisation oder Hierarchie einer anderen untergeordnet ist.",
                        "es": "Persona subordinada a otra en una organización o jerarquía.",
                        "zh": "在组织或等级体系中从属于另一人的人。"
                    },
