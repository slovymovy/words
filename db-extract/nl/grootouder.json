                    }
                ],
                "translations": [
                    {
                        "translation_id": "d125d801-5e5c-41b3-99d3-bb9d63d98268",
                        "source_entry_id": "d32c7001-f145-398f-9ebf-fd4bc3f40467",
                        "source_sense_id": "9bd11c2f-f52b-3fb6-80ab-8c12366aa8d6",
                        "source_sense_description": "de ouder van een ouder",
                        "target_lang_word": "Großeltern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großeltern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                        "entry_id": "fad866f7-cbc1-3590-a074-31cd93f47586",
                                        "glosses": [
                                            "die Eltern des Vaters oder der Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16f1c91-bdf9-4162-bc39-62ce29f3ad75",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "Ich verbringe meine Ferien immer bei meinen Großeltern."
                                            },
                                            {
                                                "example_id": "23f275d2-1999-4213-a63a-f67fa1bda9bb",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Die wurden von meinen Großeltern gut verpackt im Keller aufbewahrt.“"
                                            },
                                            {
                                                "example_id": "ef14df5c-4af4-4421-ad72-7e0fe3269f28",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Die belastenden Erlebnisse meiner mütterlichen und väterlichen Großeltern in Kriegs- und Nachkriegszeit wirken noch heute auf die Familie.“"
                                            },
                                            {
                                                "example_id": "24947223-11ee-4c66-ad87-2ac21b2b8e60",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Meine Großeltern und meine Urgroßmutter hatten schon 1930 ihre Heimat verlassen müssen, als immer mehr Muslime Opfer der Gewalt serbischer Nationalisten wurden.“"
                                            },
                                            {
                                                "example_id": "b0c446be-3c14-42fd-8171-c5fc45663649",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Während der Ferien fuhr er auch immer mit der Straßenbahn zu den irischen Großeltern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cdfa782-a901-4b9c-bd3a-6f55f3ffc590",
                        "source_entry_id": "d32c7001-f145-398f-9ebf-fd4bc3f40467",
