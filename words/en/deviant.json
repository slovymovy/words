{
    "word_family": [
        "deviance",
        "deviancy",
        "deviantize",
        "deviate",
        "deviation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96b91c1d-81b5-3400-aa05-16192ac75354",
                    "sense_definition": "Differing from what is considered normal or acceptable, especially in social behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At the trial, the extent of his <w>deviant</w> behavior became clear to the jury.",
                            "target_lang_translations": {
                                "ru": "На суде присяжным стала ясна степень его <w>девиантного</w> поведения."
                            }
                        },
                        {
                            "text": "The study examines how <w>deviant</w> subcultures form within large urban environments.",
                            "target_lang_translations": {
                                "ru": "В исследовании изучается, как формируются <w>отклоняющиеся</w> субкультуры в условиях крупных городов."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonconformist",
                        "maverick"
                    ],
                    "antonyms": [
                        "normal",
                        "standard",
                        "conventional"
                    ],
                    "common_phrases": [
                        "deviant behavior",
                        "deviant subculture",
                        "socially deviant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличающийся от того, что считается нормальным или приемлемым, особенно в социальном поведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девиантный",
                                "target_lang_sense_clarification": "отклоняющийся от нормы"
                            },
                            {
                                "target_lang_word": "отклоняющийся",
                                "target_lang_sense_clarification": "не соответствующий стандарту"
                            },
                            {
                                "target_lang_word": "ненормальный",
                                "target_lang_sense_clarification": "выходящий за рамки принятого"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "507a30a3-2a5e-33cc-9a2f-e3ab5168fbfc",
                    "sense_definition": "A person whose behavior or beliefs differ significantly from social norms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was branded as a <w>deviant</w> and ostracized by the rest of the community.",
                            "target_lang_translations": {
                                "ru": "Его заклеймили как <w>девианта</w> и изгнали из сообщества."
                            }
                        },
                        {
                            "text": "The local authorities often treated any political <w>deviant</w> with extreme suspicion.",
                            "target_lang_translations": {
                                "ru": "Местные власти часто относились к любому политическому <w>отщепенцу</w> с крайним подозрением."
                            }
                        }
                    ],
                    "synonyms": [
                        "heteroclite",
                        "nonconformist",
                        "maverick"
                    ],
                    "antonyms": [
                        "conformist"
                    ],
                    "common_phrases": [
                        "social deviant",
                        "sexual deviant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чье поведение или убеждения значительно отличаются от социальных норм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девиант",
                                "target_lang_sense_clarification": "лицо с отклоняющимся поведением"
                            },
                            {
                                "target_lang_word": "отщепенец",
                                "target_lang_sense_clarification": "человек, порвавший со своей средой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b43f276-be1c-39b7-bce8-77478801ebd2",
                    "sense_definition": "A thing, phenomenon, or data point that varies from an expected pattern or statistical norm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statistical_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the graph shows, the March sales trend is the <w>deviant</w> in this year's data.",
                            "target_lang_translations": {
                                "ru": "Как показывает график, мартовский тренд продаж является <w>отклонением</w> в данных за этот год."
                            }
                        },
                        {
                            "text": "Researchers must determine if the <w>deviant</w> is a result of error or a new discovery.",
                            "target_lang_translations": {
                                "ru": "Исследователи должны определить, является ли эта <w>аномалия</w> результатом ошибки или новым открытием."
                            }
                        }
                    ],
                    "synonyms": [
                        "abnormality",
                        "irregularity",
                        "outlier",
                        "anomaly"
                    ],
                    "antonyms": [
                        "norm",
                        "standard"
                    ],
                    "common_phrases": [
                        "statistical deviant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещь, явление или точка данных, которая отклоняется от ожидаемой закономерности или статистической нормы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "аномалия в данных"
                            },
                            {
                                "target_lang_word": "аномалия",
                                "target_lang_sense_clarification": "несоответствие общей закономерности"
                            },
                            {
                                "target_lang_word": "выброс",
                                "target_lang_sense_clarification": "статистически значимое отклонение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                    "sense_definition": "A registered user of the online art community known as DeviantArt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "internet_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>deviants</w> strongly criticized the new sharing features as facilitating art theft.",
                            "target_lang_translations": {
                                "ru": "Многие <w>девианты</w> резко раскритиковали новые функции обмена, посчитав, что они способствуют краже произведений искусства."
                            }
                        },
                        {
                            "text": "The site allows <w>deviants</w> to showcase their portfolios to a global audience.",
                            "target_lang_translations": {
                                "ru": "Сайт позволяет <w>девиантам</w> демонстрировать свои портфолио мировой аудитории."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specific to the DeviantArt community"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зарегистрированный пользователь онлайн-сообщества художников DeviantArt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девиант",
                                "target_lang_sense_clarification": "пользователь сайта DeviantArt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}