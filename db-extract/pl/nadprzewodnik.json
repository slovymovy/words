                                        "examples": [
                                            {
                                                "example_id": "e48433d9-cc65-4cec-81ed-bb6358f7dfa1",
                                                "sense_id": "8de18373-1222-3b13-aa74-c41f801f9b3e",
                                                "text": "Über Supraleiter kann man Strom verlustarm transportieren."
                                            },
                                            {
                                                "example_id": "b56ba4f9-29b9-4b1a-83a0-132b6ab914de",
                                                "sense_id": "8de18373-1222-3b13-aa74-c41f801f9b3e",
                                                "text": "„Kaum ein Stoff ist so sagenumwoben wie ein Supraleiter bei Raumtemperatur, auf kaum einem liegen so große Hoffnungen. “"
                                            }
                                        ],
