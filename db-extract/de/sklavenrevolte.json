                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1caae1f-d349-4a75-8f2e-4bf41ed8ae1d",
                                "sense_id": "bf069965-449d-39a9-9e54-dae76a46cac2",
                                "text": "„Während das Sklavendeck der Diligent sich allmählich füllte und schließlich gedrängt voll war, wurden die Männer der Besatzung immer nervöser, denn sie wussten, dass sich Sklavenrevolten meistens ereigneten, während das Land noch in Sicht war.“"
                            },
                            {
                                "example_id": "5252ba4b-8110-4f68-a3b5-32d9ecf52baf",
                                "sense_id": "bf069965-449d-39a9-9e54-dae76a46cac2",
                                "text": "„Die Treue dieser Sklaven zu ihrem Emir war dann selbst bei größeren Sklavenrevolten kaum in Frage gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
