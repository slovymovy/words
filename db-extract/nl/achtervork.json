                                "target_senses": [
                                    {
                                        "sense_id": "4274d798-1a14-3c85-be77-e45300a242b6",
                                        "entry_id": "d5159c10-09dc-364a-9559-fd62c3a60fe8",
                                        "glosses": [
                                            "Partie mobile du cadre d’une moto située à l’arrière et jouant un rôle dans la suspension des motos modernes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e38532-09ef-4f25-b5f6-05ffdd422b0c",
                                                "sense_id": "4274d798-1a14-3c85-be77-e45300a242b6",
                                                "text": "Le freinage mesuré (et non violent) de la roue arrière permet alors de reculer momentanément le centre de gravité vers le bras oscillant en aplatissant l’arrière de la moto, ce qui a pour effet de délester instantanément l’avant qui devient ainsi plus léger et plus manœuvrier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
