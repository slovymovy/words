                "senses": [
                    {
                        "sense_id": "055c306e-daec-30aa-8e26-241f33a63860",
                        "entry_id": "48013899-3eaf-350f-919c-1f1cfeb0b90a",
                        "glosses": [
                            "jemand, der professionell Hüte herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62341af4-4e01-4f96-b3d9-982c2bc7bbfd",
                                "sense_id": "055c306e-daec-30aa-8e26-241f33a63860",
                                "text": "Der Hutmacher stellt Hüte und andere Kopfbedeckungen aus Filz, Stoff, Leder, Pelz oder Stroh her."
                            },
                            {
                                "example_id": "dacd1cef-e1ae-4edd-a33e-39aac03d0d22",
                                "sense_id": "055c306e-daec-30aa-8e26-241f33a63860",
                                "text": "„Das galt nicht nur für Stickerinnen, sondern auch für Knopfgießer, Hutmacher, Schuhmacher, Goldschmiede und Strickerinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04e99b7f-d920-4a2b-a404-0fd24da2cab7",
                        "source_entry_id": "48013899-3eaf-350f-919c-1f1cfeb0b90a",
                        "source_sense_id": "055c306e-daec-30aa-8e26-241f33a63860",
