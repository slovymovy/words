                                                "sense_id": "3411d8af-3e26-362a-8a71-d628b7839389",
                                                "text": "Zanesete to, prosím, ihned na sedmičku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e09b35-6531-36e6-b774-3e9ce01887c1",
