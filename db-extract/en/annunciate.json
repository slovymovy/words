                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkünden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "032f2371-ea4b-3dd5-9bba-18286cc63300",
                                        "entry_id": "ffcf0250-df39-3590-9402-924fb06becf1",
                                        "glosses": [
                                            "öffentlich sagen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa49ce92-5c5e-4f98-b5b2-0603b6318491",
                                                "sense_id": "032f2371-ea4b-3dd5-9bba-18286cc63300",
                                                "text": "„Und Honecker war es auch, der 1952 die Einführung des Schießunterrichts, des Fallschirmspringens und des Motorfliegens bei der FDJ verkündete; der Popularisierung der Wiederbewaffnung bei der Jugend widmete er danach seine ganze Energie.“"
                                            },
                                            {
                                                "example_id": "d93fa798-ee04-435a-a55a-3b9f9d6b8e49",
                                                "sense_id": "032f2371-ea4b-3dd5-9bba-18286cc63300",
                                                "text": "Die Ergebnisse der Prüfung werden erst nächste Woche verkündet."
                                            },
                                            {
                                                "example_id": "5216a645-fea7-4cfe-a946-63a738a8a699",
                                                "sense_id": "032f2371-ea4b-3dd5-9bba-18286cc63300",
                                                "text": "Auf der Feier verkündet Sebastian stolz, dass er zum zweiten Mal Vater werden wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
