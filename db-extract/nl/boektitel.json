                "senses": [
                    {
                        "sense_id": "6bd4c88e-f8b1-3b25-a1d1-0d832e9c3e22",
                        "entry_id": "b32a8c8a-a4e2-38aa-a6df-641a33681431",
                        "glosses": [
                            "de naam, het opschrift en de aanduiding van een boek, meestal in de vorm van één enkel begrip of een zinsnede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea91867-a244-46a1-bbd6-c562bdd4be24",
                                "sense_id": "6bd4c88e-f8b1-3b25-a1d1-0d832e9c3e22",
                                "text": "Met zijn boektitel Het Einde van Online Winkelen wist Jongen de aandacht te trekken. Kern van zijn betoog is dat de consument het straks niet meer heeft over online winkelen, omdat er geen onderscheid meer wordt gemaakt tussen online en offline. „Die termen versmelten, en dus hoeven we het niet meer expliciet te benoemen. Winkelen is winkelen, maar zal digitaal worden gedomineerd.”"
                            },
                            {
                                "example_id": "b1c1cf8b-ca42-4154-9640-fd100570ab91",
                                "sense_id": "6bd4c88e-f8b1-3b25-a1d1-0d832e9c3e22",
                                "text": "Ebook-uitgever Kobo maakt een leuke kwinkslag door speciaal voor de koning een lijst boektitels te verzamelen, waarin de levens van grote leiders worden besproken. De boeken zijn niet alleen leerzaam voor de koning, maar ook voor ons interessant."
                            }
                        ]
                    }
                ],
