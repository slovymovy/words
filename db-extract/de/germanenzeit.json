                        ],
                        "examples": [
                            {
                                "example_id": "73dabc55-4bbd-4971-91a0-e19c3936718e",
                                "sense_id": "3ea52ad9-0919-3341-892b-4217bca47dd6",
                                "text": "„Eine Kultur, deren Wurzel bis in die Germanenzeit zurückreicht, hat schon längst mehr schöne Dinge verloren als behalten.“"
                            },
                            {
                                "example_id": "6cd8ea2f-7741-4daf-a2d7-79a38fae1c57",
                                "sense_id": "3ea52ad9-0919-3341-892b-4217bca47dd6",
                                "text": "„Ein Funken Heidentum schwält in uns allen. Er hat von alten Germanenzeiten her die Jahrtausende überdauert. Einmal im Jahre, da flammt es hoch auf und dann heißt er Johannisfeuer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
