                "translations": [
                    {
                        "translation_id": "adfdbecf-6602-4a39-a509-cd0c2fd0c737",
                        "source_entry_id": "21665b0e-bc11-3711-8d1e-bcba556b2a79",
                        "source_sense_id": "b025e851-3d60-37c1-8ea7-e9be710532b4",
                        "target_lang_word": "Vivian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vivian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edd3bde0-9ce5-3be7-b325-b569215bd56d",
                                        "entry_id": "9503f59d-5ed5-3bc7-ada1-729e00ce01d0",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e367e676-4185-490c-bce3-58a82358b920",
                                                "sense_id": "edd3bde0-9ce5-3be7-b325-b569215bd56d",
                                                "text": "Of the you're-going-to-get-it-anyway faction was a young Australian on board by the name, so help me, of Vivian Nankervis. - - - And he was beautiful, even with a name like Vivian; moreover, he had never been ill a day in his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7fa1cb9-dd13-302e-9deb-2414cf2ea67d",
                                        "entry_id": "9503f59d-5ed5-3bc7-ada1-729e00ce01d0",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e9ec14b-944d-4015-b557-f5db40a79291",
                                                "sense_id": "d7fa1cb9-dd13-302e-9deb-2414cf2ea67d",
                                                "text": "'What's your name?' 'Vivian.' 'Isn't that one of the names that mean something?' She said, 'It means my mother used to go to the movies.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2844223-bae5-3507-9722-361c2ae0fc79",
                                        "entry_id": "9503f59d-5ed5-3bc7-ada1-729e00ce01d0",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42b0b4a-8a23-49ad-a33a-eb2f8e31a8a7",
                                                "sense_id": "c2844223-bae5-3507-9722-361c2ae0fc79",
                                                "text": "\"Mr. Grey,\" asked her ladyship, \"are you of Dorsetshire?\" \"My mother is a Dorsetshire woman; her family name is Vivian, which name I also bear - Sir Hargrave Vivian, of Chester Grange.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40bc3ffe-cf06-434d-824e-e8f7617ffa15",
                        "source_entry_id": "21665b0e-bc11-3711-8d1e-bcba556b2a79",
                        "source_sense_id": "b025e851-3d60-37c1-8ea7-e9be710532b4",
                        "target_lang_word": "Vivien",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vivien",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef4d670-4fe3-3884-af0f-c7179ab2e54b",
                                        "entry_id": "3b663b06-4cac-3ec2-ae0e-b83e8b5bfe98",
                                        "glosses": [
                                            "A female given name from Latin, an exclusively feminine spelling variant of Vivian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6675c53f-4807-44eb-a8fa-af62af604661",
                                                "sense_id": "9ef4d670-4fe3-3884-af0f-c7179ab2e54b",
                                                "text": "\"This habit you have contracted of being a little boy,\" his mamma said to him, \"is most inconvenient. Your name was to be Vivien. Vivien is early English, and picturesque and full of color; Vivian, which is a boy's name, I don't think so much of. - - -"
                                            },
                                            {
                                                "example_id": "b6b3d97b-18a2-41db-bc7f-33d89589a9b6",
                                                "sense_id": "9ef4d670-4fe3-3884-af0f-c7179ab2e54b",
                                                "text": "He didn't like her first name. '\"Vivian\" - it's neither one thing nor the other. It'll confuse people. They won't know if you're a man or a woman. Will you agree to spelling it \"Vivien\"?'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81dcb50d-0f2b-4680-a10e-aab0aebd698a",
