            {
                "entry_id": "39268052-65de-39ac-9e0c-88f43bf17932",
                "word": "courtly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a81df7a2-cb47-425d-a666-f6fbae5ad0d3",
                        "entry_id": "39268052-65de-39ac-9e0c-88f43bf17932",
