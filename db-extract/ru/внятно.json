                "forms": [],
                "senses": [
                    {
                        "sense_id": "6adabc4f-3c70-3978-8249-543be189609e",
                        "entry_id": "8d34df65-b193-30c8-a902-28f8596d8939",
                        "glosses": [
                            "так, что можно ясно различить, отчётливо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92bf68ee-6aa3-3e50-8da6-0d1d4b2ba8cd",
                        "entry_id": "8d34df65-b193-30c8-a902-28f8596d8939",
                        "glosses": [
                            "перен. вразумительно, ясно, понятно"
                        ],
                        "tags": [],
