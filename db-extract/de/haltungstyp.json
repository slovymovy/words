                ],
                "senses": [
                    {
                        "sense_id": "3c2d6f11-52ff-3782-94bd-551a597b4d58",
                        "entry_id": "a74868cc-d46b-3540-a561-40f69b834a27",
                        "glosses": [
                            "Kategorie, die beschreibt, welche Einstellung eine Person üblicherweise einnimmt oder wie sie sich zu einer bestimmten Situation verhält"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "54175c11-63e9-4347-a815-2b41c9aa333c",
                                "sense_id": "3c2d6f11-52ff-3782-94bd-551a597b4d58",
                                "text": "„Der Haltungstyp hängt davon ab, ob genügend Geld vorhanden ist, um beschädigte Kleidungsstücke, Schuhe und Haushaltsgegenstände zu ersetzen oder zu reparieren und um ausreichendes Essen zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "57f2aa01-a32b-3c1b-84e5-cc697023be50",
                        "entry_id": "a74868cc-d46b-3540-a561-40f69b834a27",
                        "glosses": [
                            "spezifische Art der Haltung des Rückens, die eine Person üblicherweise einnimmt"
                        ],
                        "tags": [
                            "Physiotherapie"
                        ],
                        "examples": [
                            {
                                "example_id": "701fe6ff-64dd-4d94-8e07-c9164a02b9ba",
                                "sense_id": "57f2aa01-a32b-3c1b-84e5-cc697023be50",
                                "text": "„Wichtig für den guten Schlaf ist es, festzustellen, zu welchem Haltungstyp man zählt.“"
                            },
                            {
                                "example_id": "518a21ad-e29a-4d1b-b702-8045aa57ac60",
                                "sense_id": "57f2aa01-a32b-3c1b-84e5-cc697023be50",
                                "text": "„Beim Haltungstyp ‚Prinzessin‘ sollte darauf geachtet werden, dass die Festigung des Rückens zwischen den Schulterblättern gewährleistet ist (Gefahr des ‚Einsackens‘ zwischen den Schulterblättern).“"
                            },
                            {
                                "example_id": "05b6f3ba-e947-41ac-895c-d055f05f90bc",
                                "sense_id": "57f2aa01-a32b-3c1b-84e5-cc697023be50",
                                "text": "„Welcher Haltungstyp seid ihr, eher die freiheitsliebenden ‚Marlboro-Cowboys‚ oder doch die regelkonformen ‚Adrian Monk‘s‚?“"
                            },
                            {
                                "example_id": "63214bca-70dc-414b-abfd-6e4edafc7533",
                                "sense_id": "57f2aa01-a32b-3c1b-84e5-cc697023be50",
                                "text": "„Außerdem besteht bei diesem Haltungstyp eventuell die Gefahr, dass der/die Übende ins Hohlkreuz fällt, daher ist ein festes Anspannen der Bauchmuskulatur (‚Bauchnabel zur Wirbelsäule‘), kombiniert mit Uddiyana Bandha sehr empfehlenswert.“"
                            },
                            {
                                "example_id": "e05cd270-b1ed-44de-8e64-772842278704",
                                "sense_id": "57f2aa01-a32b-3c1b-84e5-cc697023be50",
                                "text": "„Der versierte Fachberater unterscheidet vier Hauptkriterien: Haltungstyp des Rückens (hohl, gerade oder rund), Hauptschlaflage (Seite, Rücken oder Bauch), Körperlängen (klein, mittel, groß) und eines der wichtigsten, da es viele Seitenschläfer gibt, unsere Kontur – also den Körperbautyp.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
