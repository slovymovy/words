                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "928e993a-b1d7-310d-a91b-38bf0166a105",
                                        "entry_id": "758b9712-2845-3010-9cd9-d07e83d07791",
                                        "glosses": [
                                            "A former Hebrew unit of dry volume, about equal to 230 L or 6+¹⁄₂ US bushels."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d56aca-662e-44fb-a861-a735600a53d7",
                                                "sense_id": "928e993a-b1d7-310d-a91b-38bf0166a105",
                                                "text": "The ephah and the bath shall be of one measure, that the bath may contain the tenth part of an homer, and the ephah the tenth part of an homer: the measure thereof shall be after the homer."
                                            },
                                            {
                                                "example_id": "74248b7f-a428-411a-bbab-f00870c1b059",
                                                "sense_id": "928e993a-b1d7-310d-a91b-38bf0166a105",
                                                "text": "Head up! For every newbegotten thou shalt gather thy homer of ripe wheat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58db6081-c14c-39d8-aa30-98588f5c9501",
                                        "entry_id": "758b9712-2845-3010-9cd9-d07e83d07791",
                                        "glosses": [
                                            "Synonym of cor: approximately the same volume as a liquid measure."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e89c294-09c0-4915-8e00-6b3d9378d169",
                                                "sense_id": "58db6081-c14c-39d8-aa30-98588f5c9501",
                                                "text": "The ephah and the bath shall be of one measure, that the bath may contain the tenth part of an homer, and the ephah the tenth part of an homer: the measure thereof shall be after the homer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a00f9178-df09-33e6-9047-f4bb337d1071",
                                        "entry_id": "ea7e309c-9bbb-3cf0-9e65-873f67cee0fd",
                                        "glosses": [
                                            "A home run."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df4d9f1-461e-4ba9-861c-4c53be8f5d86",
                                                "sense_id": "a00f9178-df09-33e6-9047-f4bb337d1071",
                                                "text": "The first baseman hit a homer to lead off the ninth."
                                            },
                                            {
                                                "example_id": "8101ad6b-7f48-46db-9d55-92b06b5b40b8",
                                                "sense_id": "a00f9178-df09-33e6-9047-f4bb337d1071",
                                                "text": "The Mets got that four-run cushion in the seventh when George Foster stepped in as a pinch-hitter and hit a two-run homer for the 5-1 final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d0b4f01-0012-3958-9e9a-90a0f81baf1d",
                                        "entry_id": "ea7e309c-9bbb-3cf0-9e65-873f67cee0fd",
                                        "glosses": [
                                            "Synonym of home run (“sexual intercourse”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b722be6b-95a3-4fc0-90af-955f2dedfe7a",
                                                "sense_id": "7d0b4f01-0012-3958-9e9a-90a0f81baf1d",
                                                "text": "Fast forward to Chase's base. Where Chase hit a homer, first at bat. Becca thrived off being sexy, having sex, watching sex."
                                            },
                                            {
                                                "example_id": "952427ce-407f-4525-aad9-6fe4b78e9eb2",
                                                "sense_id": "7d0b4f01-0012-3958-9e9a-90a0f81baf1d",
                                                "text": "“So you hit a homer, huh?” she asked, confused by his misery.\nColm nodded. “Best sex I've had in a long time. Maybe ever.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0f216f-7894-3097-8b4e-04d8d69b62c3",
                                        "entry_id": "ea7e309c-9bbb-3cf0-9e65-873f67cee0fd",
                                        "glosses": [
                                            "A homing pigeon."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ed0532-c480-46c4-9257-0733919b1552",
                                                "sense_id": "cc0f216f-7894-3097-8b4e-04d8d69b62c3",
                                                "text": "Each of the pigeon fanciers released a homer at the same time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dcc26e5-923f-3128-8185-c15811871be2",
                                        "entry_id": "ea7e309c-9bbb-3cf0-9e65-873f67cee0fd",
                                        "glosses": [
                                            "A person who is extremely devoted to a favorite team."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "448fc420-dfad-4812-b5a5-a5bed6f8e591",
                                                "sense_id": "5dcc26e5-923f-3128-8185-c15811871be2",
                                                "text": "Joe is such a homer that he would never boo the Hometown Hobos, even if they are in last place in the league."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe0095d-0cd3-3d02-a7fc-4469cf5ca440",
                                        "entry_id": "ea7e309c-9bbb-3cf0-9e65-873f67cee0fd",
                                        "glosses": [
                                            "A homing beacon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd4e1d0-4cf4-4c3d-9463-4e20059cfeef",
                                                "sense_id": "bfe0095d-0cd3-3d02-a7fc-4469cf5ca440",
                                                "text": "Two general types of homer systems are in use, active homers and passive homers. Active homers contain a transmitting device which emits energy that is directed towards the target."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49369022-12ec-3785-ae1b-4123ded1aa13",
                                        "entry_id": "ea7e309c-9bbb-3cf0-9e65-873f67cee0fd",
                                        "glosses": [
                                            "homework"
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4d390cf-ee05-40b6-9915-6d2a3cc876ae",
                                                "sense_id": "49369022-12ec-3785-ae1b-4123ded1aa13",
                                                "text": "'What's the good of talking?' said Cyril. 'What I want is for something to happen. It's awfully stuffy for a chap not to be allowed out in the evenings. There's simply nothing to do when you've got through your homers.' Jane finished the last of her home-lessons and shut the book with a bang."
                                            }
                                        ]
                                    }
                                ]
                            },
