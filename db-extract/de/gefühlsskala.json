                        "examples": [
                            {
                                "example_id": "710d77de-5fb2-46c4-89e3-cb02fe421fb3",
                                "sense_id": "66fb877e-c864-3cd0-810e-f0b047a7771c",
                                "text": "„Meine Gefühlsskala ist nach oben und unten offen, eine Balance unmöglich.“"
                            },
                            {
                                "example_id": "cd1d6848-caf5-451c-8ef8-f0ba13e03963",
                                "sense_id": "66fb877e-c864-3cd0-810e-f0b047a7771c",
                                "text": "„So ging es wohl weitere zwei Stunden, bis alle drei Kandidatinnen jede nur denkbare Regung auf der Gefühlsskala dargeboten hatten.“"
                            },
                            {
                                "example_id": "08a3e2a0-3921-4903-b710-09eedb571c59",
                                "sense_id": "66fb877e-c864-3cd0-810e-f0b047a7771c",
                                "text": "„Eine ganze Gefühlsskala spiegelte sich in ihren Augen.“"
                            }
                        ],
