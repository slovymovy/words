                                    {
                                        "sense_id": "75df7047-07be-3d9e-a54c-a1c674feea11",
                                        "entry_id": "b9c42630-272e-3aeb-895c-ed19aff1d1a6",
                                        "glosses": [
                                            "Willingly; without argument."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43705806-a8bc-4f3c-b531-ffec26ac9a98",
                                                "sense_id": "75df7047-07be-3d9e-a54c-a1c674feea11",
                                                "text": "Near-synonyms: (as a reply or otherwise adverbially) gladly, happily"
                                            },
                                            {
                                                "example_id": "56b07e72-1e31-43e4-a700-1cc837751ccc",
                                                "sense_id": "75df7047-07be-3d9e-a54c-a1c674feea11",
                                                "text": "A: Would you be willing to take a business trip to Toronto next month? B: With pleasure! I love Toronto."
                                            },
                                            {
                                                "example_id": "17bb2fea-ae15-45d3-a35e-65522f7d70d3",
                                                "sense_id": "75df7047-07be-3d9e-a54c-a1c674feea11",
                                                "text": "She accepted the offer with pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "708afd27-53a7-48b3-9901-c98ebb1814ac",
                        "source_entry_id": "7cdc7817-0b2e-3442-9333-ddbda659f70f",
                        "source_sense_id": "81306cbd-54a8-3436-8374-fde3a28b753c",
                        "target_lang_word": "willingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fb1b347-5a5d-301c-b818-746a8e68b6b7",
                                        "entry_id": "4184c491-cead-3b78-a4ac-07205b776db9",
                                        "glosses": [
                                            "Of one’s own free will; freely and spontaneously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f5f9c3-9a23-4b46-a7ae-767d1f75a0c0",
                                                "sense_id": "1fb1b347-5a5d-301c-b818-746a8e68b6b7",
                                                "text": "Now this is a process of the mind or thought, of which I would willingly know the foundation."
                                            },
                                            {
                                                "example_id": "4de0f344-c8f8-4305-88e6-0ac8c9199743",
                                                "sense_id": "1fb1b347-5a5d-301c-b818-746a8e68b6b7",
                                                "text": "In the first place, although many people wanted nationalisation and it became the will of Parliament, there were many other people who did not want it, have never willingly accepted it, and never will."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dd510ee-32b2-4605-9195-2e8a164d2936",
                        "source_entry_id": "7cdc7817-0b2e-3442-9333-ddbda659f70f",
                        "source_sense_id": "81306cbd-54a8-3436-8374-fde3a28b753c",
                        "target_lang_word": "readily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "readily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d87a6876-0902-381e-aecd-3656a92fa90e",
                                        "entry_id": "ba42b8fe-3b5d-3f12-af21-04b1b919c1ef",
                                        "glosses": [
                                            "Without unwillingness or hesitation; showing readiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018cedb4-62b1-4c77-b39b-4ca5f9498b56",
                                                "sense_id": "d87a6876-0902-381e-aecd-3656a92fa90e",
                                                "text": "The suspect readily answered all questions the police officers asked him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1ef2d9-24d2-309b-8985-bbf1673d3563",
                                        "entry_id": "ba42b8fe-3b5d-3f12-af21-04b1b919c1ef",
                                        "glosses": [
                                            "Without impediment, easily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cbbbe03-8173-4ccb-94e2-d7fea7cdaf12",
                                                "sense_id": "9a1ef2d9-24d2-309b-8985-bbf1673d3563",
                                                "text": "readily available; readily achievable"
                                            },
                                            {
                                                "example_id": "ff9b2a4f-9895-4f6c-874f-6b2a826134a1",
                                                "sense_id": "9a1ef2d9-24d2-309b-8985-bbf1673d3563",
                                                "text": "Cantharidin, although readily decomposed by chemical agents, is so permanent in the body that it has been detected in the corpse of a cat eighty-four days after death."
                                            },
                                            {
                                                "example_id": "8fb207d2-1ef3-47ba-b395-39d638eaa2f4",
                                                "sense_id": "9a1ef2d9-24d2-309b-8985-bbf1673d3563",
                                                "text": "Light does not pass through water nearly as readily as it passes through air, and in order to function efficiently, an animal that lives in the water must rely on other senses in addition to light."
                                            },
                                            {
                                                "example_id": "104dd0ce-5f44-4da1-82f2-ea03c81057b2",
                                                "sense_id": "9a1ef2d9-24d2-309b-8985-bbf1673d3563",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03036a0b-f2ab-4916-a1db-e457a9233b55",
                        "source_entry_id": "7cdc7817-0b2e-3442-9333-ddbda659f70f",
                        "source_sense_id": "81306cbd-54a8-3436-8374-fde3a28b753c",
                        "target_lang_word": "gladly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gladly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ae4bd9-cb00-31be-aac6-a2c8d3bfd0e2",
                                        "entry_id": "56c2fd31-9a53-3457-b71c-98d4ca47ef06",
                                        "glosses": [
                                            "In a glad manner; happily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6996ef15-2885-413f-ac56-9c41223d69ee",
                                                "sense_id": "b8ae4bd9-cb00-31be-aac6-a2c8d3bfd0e2",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            },
                                            {
                                                "example_id": "de0601b2-8bad-4819-80ff-1f5a7ca40318",
                                                "sense_id": "b8ae4bd9-cb00-31be-aac6-a2c8d3bfd0e2",
                                                "text": "'Find me a job and I'll gladly go to work.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52735fd8-a959-3594-b094-cb6e281ec9e2",
                                        "entry_id": "56c2fd31-9a53-3457-b71c-98d4ca47ef06",
                                        "glosses": [
                                            "Willingly; certainly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b7230b-6e73-4506-ba65-568cf18021f7",
                                                "sense_id": "52735fd8-a959-3594-b094-cb6e281ec9e2",
                                                "text": "Would you like a beer? ― Gladly, thank you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b61dd54-a4d4-49aa-8d0a-0e512e5a827d",
                        "source_entry_id": "7cdc7817-0b2e-3442-9333-ddbda659f70f",
                        "source_sense_id": "81306cbd-54a8-3436-8374-fde3a28b753c",
                        "target_lang_word": "gern",
                        "target_lang_code": "de",
