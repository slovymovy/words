                "senses": [
                    {
                        "sense_id": "a7cea6d8-8f02-3aa8-8127-765de3b78ab6",
                        "entry_id": "c49b4b4b-0fe7-3df2-9bf3-453067fcbfff",
                        "glosses": [
                            "Cross-country skiing."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b774eb8-3d4c-4e1b-8a24-eb26916e06c3",
                                "sense_id": "a7cea6d8-8f02-3aa8-8127-765de3b78ab6",
                                "text": "Horn's job was to push me down the steepest parts of the langlauf course in the pious hope that a few heavy falls would teach me more respect for Norwegian langlaufs."
                            },
                            {
                                "example_id": "4b14588b-7a8d-45b8-98fe-7cdc1fafc1da",
                                "sense_id": "a7cea6d8-8f02-3aa8-8127-765de3b78ab6",
                                "text": "I'm buying a rowing machine, an exercise bicycle, a langlauf podium, a bullworker."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d40bb5b-7963-3895-9caf-4c7935430b49",
                        "entry_id": "c49b4b4b-0fe7-3df2-9bf3-453067fcbfff",
                        "glosses": [
                            "A langlauf run; a trip cross-country skiing."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "05b1fe41-e60f-452d-8254-4c6bfd6092c4",
                                "sense_id": "9d40bb5b-7963-3895-9caf-4c7935430b49",
                                "text": "There, overcome by the view and a sense of pure delight, one loses the last vestige of human reason, binds planks to one's feet and rushes downward, over wind-crust and powdered snow, over icy ridges and drifted fences, with jumps, turns, traverses, langlaufs and schuss-runs into the valley."
                            },
                            {
                                "example_id": "697fda2e-eb27-46cb-995d-dc76d6d14173",
                                "sense_id": "9d40bb5b-7963-3895-9caf-4c7935430b49",
                                "text": "The winter of '98 saw the Sunset Mine kept open by means of what sounds like one of the toughest langlaufs of all time."
                            },
                            {
                                "example_id": "f0587c53-cda5-4deb-acb5-70e583500fcd",
                                "sense_id": "9d40bb5b-7963-3895-9caf-4c7935430b49",
                                "text": "Horn's job was to push me down the steepest parts of the langlauf course in the pious hope that a few heavy falls would teach me more respect for Norwegian langlaufs."
                            },
                            {
                                "example_id": "cd654c7a-24f1-4810-80e8-3519891378e4",
                                "sense_id": "9d40bb5b-7963-3895-9caf-4c7935430b49",
                                "text": "He went on langlaufs to develop endurance."
                            },
                            {
                                "example_id": "e90faf1d-0858-451f-bb25-f7795ff56f0d",
                                "sense_id": "9d40bb5b-7963-3895-9caf-4c7935430b49",
                                "text": "Those who were drinking \"sipped at long glasses of gluhwein, a delicious concoction of warmed burgundy, cinnamon and raisins, and chattered about the day's runs, about technical aspects of langlaufs, cornices, laniéres and christies."
                            }
                        ]
                    }
                ],
