                        "sense_id": "f9b502a8-6c63-37a5-8c99-532cbcb009e8",
                        "entry_id": "bdd0915d-4af4-30c0-ad48-238e87235851",
                        "glosses": [
                            "с.-х. сельскохозяйственная машина для равномерного посева семян в почву"
                        ],
                        "tags": [],
