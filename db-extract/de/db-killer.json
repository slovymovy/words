                        "entry_id": "5e600ed6-98dc-3d74-b59a-3e4bf60bdcb3",
                        "glosses": [
                            "Bauteil für den Schalldämpfer in Fahrzeugen, das die Lautstärke senken soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b18290-31a4-4094-b881-d4c771951be6",
                                "sense_id": "777c55cd-98ca-31d1-a961-d87809d4f32e",
                                "text": "„Der Betrieb eines Sportschalldämpfers im Bereich der Straßenverkehrsordnung ohne dB-Killer ist verboten.“"
                            },
                            {
                                "example_id": "c961ba15-660d-44bd-b950-c61a82530106",
                                "sense_id": "777c55cd-98ca-31d1-a961-d87809d4f32e",
                                "text": "„Am Motorrad war der eingebaute dB-Killer durch unzulässige Bohrungen und Kürzung verändert und unzulässige lichttechnische Einrichtungen in Form von blauen LEDs und gelbem Dauerlicht nach vorne montiert worden, wodurch die Betriebserlaubnis erlosch.“"
                            }
                        ],
