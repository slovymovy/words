{
    "word_family": [
        "révision",
        "réviseur",
        "révisable",
        "révisionnisme",
        "révisionniste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfef370c-f5d5-3b53-aa6f-5e2ed900b859",
                    "sense_definition": "Étudier de nouveau une leçon ou une matière pour préparer un examen ou consolider ses connaissances.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les soirs, les étudiants <w>révisent</w> leurs cours à la bibliothèque."
                        },
                        {
                            "text": "Je dois <w>réviser</w> pour un examen de mathématiques demain matin."
                        }
                    ],
                    "synonyms": [
                        "étudier"
                    ],
                    "common_phrases": [
                        "réviser ses leçons",
                        "réviser pour un examen"
                    ]
                },
                {
                    "sense_id": "e457877f-4cab-3c6d-b070-5ee612156928",
                    "sense_definition": "Examiner attentivement un appareil ou un véhicule pour vérifier son état et assurer son bon fonctionnement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en vacances, il est conseillé de faire <w>réviser</w> sa voiture chez le garagiste."
                        },
                        {
                            "text": "Le mécanicien a <w>révisé</w> tout le système de freinage avec beaucoup d'attention."
                        }
                    ],
                    "synonyms": [
                        "examiner"
                    ],
                    "common_phrases": [
                        "faire réviser sa voiture",
                        "faire réviser le moteur"
                    ]
                },
                {
                    "sense_id": "06271085-eb29-344c-9bf3-be19fb171c2f",
                    "sense_definition": "Examiner de nouveau un texte, un contrat ou une règle en vue d'y apporter des modifications.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité juridique va bientôt <w>réviser</w> ce règlement pour l'adapter aux normes actuelles."
                        },
                        {
                            "text": "Les deux parties ont convenu de <w>réviser</w> un contrat avant la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "examiner"
                    ],
                    "common_phrases": [
                        "réviser un contrat",
                        "réviser un texte"
                    ]
                },
                {
                    "sense_id": "78129dca-1050-39da-8539-3ca3a185adc6",
                    "sense_definition": "Modifier ou reconsidérer un point de vue, une opinion ou un jugement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux nouvelles informations, le directeur a dû <w>réviser</w> son jugement initial."
                        },
                        {
                            "text": "L'entreprise refuse de <w>réviser</w> sa position malgré les nombreuses critiques du public."
                        }
                    ],
                    "common_phrases": [
                        "réviser sa position",
                        "réviser son jugement"
                    ]
                },
                {
                    "sense_id": "be6e5a11-9095-38ac-ba00-eff43d2bed66",
                    "sense_definition": "Vérifier sur une épreuve d'imprimerie que les corrections demandées ont bien été effectuées.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "edition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éditeur a pris le temps de <w>réviser</w> les épreuves avant de lancer l'impression."
                        },
                        {
                            "text": "Le relecteur <w>révise</w> soigneusement chaque page pour éliminer les dernières erreurs typographiques."
                        }
                    ],
                    "common_phrases": [
                        "réviser les épreuves"
                    ]
                },
                {
                    "sense_id": "f6a8504d-ab56-3058-8978-b89e19477899",
                    "sense_definition": "Remettre en état un véhicule spatial après une mission afin de permettre sa réutilisation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs doivent entièrement <w>réviser</w> la navette spatiale avant son prochain décollage."
                        },
                        {
                            "text": "Après le vol orbital, l'équipe technique a <w>révisé</w> l'appareil pour tester son étanchéité."
                        }
                    ]
                }
            ]
        }
    ]
}