                "translations": [
                    {
                        "translation_id": "0010be35-284c-415e-b025-c186286589a0",
                        "source_entry_id": "440dfd45-7213-31a9-b123-4d81447c89a4",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Aaron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aaron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12940039-a9da-355e-a833-9826d805ba78",
                                        "entry_id": "89cd43f1-c107-393b-905a-a042429d94d4",
                                        "glosses": [
                                            "The elder brother of Moses in the Book of the Exodus, and in the Quran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71927ef8-0f72-404a-88f6-6fdd734d04e1",
                                                "sense_id": "12940039-a9da-355e-a833-9826d805ba78",
                                                "text": "And the anger of the Lord was kindled against Moses, and hee said, Is not Aaron the Leuite thy brother? I know that he can speake well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98dc8d5b-a4db-31b4-b011-9801d1292a34",
                                        "entry_id": "89cd43f1-c107-393b-905a-a042429d94d4",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871bb24c-85cb-40a0-add5-39596672b3a0",
                                                "sense_id": "98dc8d5b-a4db-31b4-b011-9801d1292a34",
                                                "text": "- - - the Junior Prom with boys whose names are right out of the grade-school reader, not Aaron and Arnold and Marvin, but Johnny and Billy and Jimmy and Tod. Not Portnoy or Pincus, but Smith and Jones and Brown!"
                                            },
                                            {
                                                "example_id": "40204e0a-9be3-4914-bcec-efc9946fb661",
                                                "sense_id": "98dc8d5b-a4db-31b4-b011-9801d1292a34",
                                                "text": "Superstar quarterback Aaron Rodgers, who ruptured his left Achilles tendon just four snaps into his New York Jets career, has written off this season as a “lost year,” though he feels he can “play more years” in the NFL."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51ad9cbe-393d-311d-8684-bf8995083c35",
                                        "entry_id": "89cd43f1-c107-393b-905a-a042429d94d4",
                                        "glosses": [
                                            "A surname transferred from the given name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Aaron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae08134-4e70-3a8a-bb3b-f799d09938ad",
                                        "entry_id": "213b1a5a-c511-3af5-b479-09715708168e",
                                        "glosses": [
                                            "The leader of a group of thieves."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26a9943a-5d25-42ed-bfa8-3b8523355d59",
                        "source_entry_id": "440dfd45-7213-31a9-b123-4d81447c89a4",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Aaron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aaron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23109946-0422-3b35-8829-03b3134c43bb",
                                        "entry_id": "7f5e7412-f946-3159-9fcb-bf1975d90cd4",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4deab6c-6ad9-453a-b9ed-78d941a8c011",
                                                "sense_id": "23109946-0422-3b35-8829-03b3134c43bb",
                                                "text": "Aaron geht noch in den Kindergarten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aaron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                        "entry_id": "501eb47c-2a9c-3bdf-88a3-342ebdc55fd6",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b97ac6-b715-479b-ba61-f091310454c7",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Frau Aaron ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "8be8d052-e742-4498-819e-963b2e3dd678",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Herr Aaron wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "ee40b947-9d33-43b4-9334-68c88f6602bc",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Die Aarons kommen heute aus Freiburg."
                                            },
                                            {
                                                "example_id": "9811f998-6d64-42b6-bb2c-b6d02dbc5945",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Der Aaron trägt nie die Schals, die die Aaron ihm strickt."
                                            },
                                            {
                                                "example_id": "59be2d29-067f-4955-b983-0585e1d7173a",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aaron kommt, geht der Herr Aaron.“"
                                            },
                                            {
                                                "example_id": "421ca78f-62c2-42e8-aee5-cd46e4a80a68",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Aaron kommt und geht."
                                            },
                                            {
                                                "example_id": "27cf5f31-2725-4a86-83a7-41d5f2a06b0a",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "Aarons kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "8be673e1-cece-42ed-ad9c-af12c2c2ce7b",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "An verregneten Herbsttagen ist Familie Aarons liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "0e4cefd7-2d53-4de6-800f-ef91261cda2f",
                                                "sense_id": "6e027239-cd3f-32eb-bbf2-4b564dc2a3f7",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Aaron das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
