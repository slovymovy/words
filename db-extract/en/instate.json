                                "target_senses": [
                                    {
                                        "sense_id": "e338a14d-a838-34de-bfc6-6d1f4f4700d4",
                                        "entry_id": "913c4b7e-c96d-36bf-8c54-4a65253fa557",
                                        "glosses": [
                                            "Établir, fonder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1442fa9b-ed42-4ce9-8b86-fbb64459cb25",
                                                "sense_id": "e338a14d-a838-34de-bfc6-6d1f4f4700d4",
                                                "text": "J’évoque alors en rafale les rumeurs courant les salles de rédaction sur Ze Plan, qui instaurerait dans certains quartiers une sharia soft, mais Serge s’esclaffe « tout cela provient de la fuite d’un scénario de type « ultra-accommodant » de la cellule Prospective du ministère de l’Intérieur, c’est payé pour ça les cellules Prospectives, gamberger sans tabou."
                                            },
                                            {
                                                "example_id": "a1571222-d263-4dfb-a4c7-03263577ab6c",
                                                "sense_id": "e338a14d-a838-34de-bfc6-6d1f4f4700d4",
                                                "text": "Partout elle avait trouvé bon accueil, prompt assentiment, mais elle se propose d'aller plus outre. Pourquoi ne pas instaurer une Adoration permanente du Saint Sacrement ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a709137d-b374-4960-956c-5a429c970ba3",
                        "source_entry_id": "73f9bf2d-2214-37d1-9a94-8ce663052d2b",
