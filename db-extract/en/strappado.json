                                                "sense_id": "e17644ac-abbf-31be-9032-8ff375ea46a6",
                                                "text": "Das Strappado wurde unter dem Namen Pfahlhängen auch an Gefangenen in Konzentrationslagern des Nationalsozialismus durchgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab81427d-54a2-35b1-9706-507a9f79b824",
                                        "entry_id": "fbd5394e-0c3a-399d-993d-a66bfa7d23b0",
                                        "glosses": [
                                            "Sexualpraktik, die sich von [1] ableitet, die aber in der Regel nicht so durchgeführt wird, das bleibende Verletzungen entstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3049317-fc78-4e23-94cf-d2029d7ed9cf",
                                                "sense_id": "ab81427d-54a2-35b1-9706-507a9f79b824",
                                                "text": "Durch High-Heels und Stangen zur Spreizung der Beine kann die unbequeme Haltung des Strappado noch verstärkt werden."
                                            }
                                        ],
