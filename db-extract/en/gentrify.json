                "senses": [
                    {
                        "sense_id": "c5301b81-04fe-3a83-a57b-8a9b8341771f",
                        "entry_id": "470ebfcc-a861-3f9f-ac0f-1fd9d0591576",
                        "glosses": [
                            "To renovate or improve something, especially housing or district, to make it more appealing to the middle classes (now often with the negative association of pricing out existing residents)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2c26ec45-83de-4378-bedc-79b850e30a0e",
                                "sense_id": "c5301b81-04fe-3a83-a57b-8a9b8341771f",
                                "text": "Club neighbor Joe Gegis told the board that he was concerned about the licenses due to the problem of drunk drivers and that he believed the bar would lower property values, which have been rising in the area as it becomes increasingly gentrified."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a5443b2-860a-488d-9524-f55cfebf1918",
                        "source_entry_id": "470ebfcc-a861-3f9f-ac0f-1fd9d0591576",
                        "source_sense_id": "c5301b81-04fe-3a83-a57b-8a9b8341771f",
                        "source_sense_description": "to renovate something, especially housing to make more appealing to the middle classes",
                        "target_lang_word": "gerestaureerd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gerestaureerd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                        "entry_id": "36448c47-b340-39dd-9cef-be0d702b9654",
                                        "glosses": [
                                            "voltooid deelwoord van restaureren"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe17562-9c13-434e-9ffe-8b42ad1baf10",
                                                "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                                "text": "Er zijn verschillende onderzoeken gaande hoe het gedenkteken het beste kan worden gerestaureerd."
                                            },
                                            {
                                                "example_id": "2ec9b897-34ce-4f62-ba59-564b21adb854",
                                                "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                                "text": "Alles heb ik met de hand gerestaureerd."
                                            },
                                            {
                                                "example_id": "529cbc30-e8d1-4f9d-8398-4a52b39be873",
                                                "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                                "text": "Het pand is totaal in stijl gerestaureerd."
                                            },
                                            {
                                                "example_id": "d8e4867a-caab-475d-a174-00a21d6c80fe",
                                                "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                                "text": "De Nationale 7 is verbonden met de opkomst van de auto in de jaren twintig en dertig. Destijds hadden auto's kleine brandstoftanks en gingen ze vaak kapot. Daarom barst het langs de route van de pompstations en garages, veelal opgetrokken in een betonnen art-decostijl, destijds het toppunt van moderniteit. Vele zijn vervallen, sommige zijn gerestaureerd, zoals een klassiek pompstation in Valence. Het mooiste voorbeeld van deze stijl ligt strikt genomen niet aan de Nationale 7: de Citroëngarage in Lyon."
                                            },
                                            {
                                                "example_id": "02de4f80-6f66-4a39-a557-5258e8337c09",
                                                "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                                "text": "De stad is rijk aan gerestaureerde huizen in de Wezerrenaissance-stijl."
                                            },
                                            {
                                                "example_id": "6079e258-c3b8-4988-93ed-5b7bd1287a5d",
                                                "sense_id": "9acf6716-92b8-360e-935b-fde873caebc5",
                                                "text": "Oostenrijk was een absolutistische staat met een centrale rol in het gerestaureerde Europa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
