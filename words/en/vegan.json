{
    "word_family": [
        "veganism",
        "veganize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ae72348-58fd-3626-943b-a6c8ab0a18aa",
                    "sense_definition": "Not containing any animal products (such as meat, eggs, milk, or leather) or inherently involving animal use.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dietary_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He eats a completely <w>vegan</w> diet for health reasons.",
                            "target_lang_translations": {
                                "ru": "Он придерживается полностью <w>веганской</w> диеты по состоянию здоровья.",
                                "zh": "出于健康原因，他完全采用<w>纯素</w>饮食。"
                            }
                        },
                        {
                            "text": "This chocolate cake is <w>vegan</w> and tastes delicious.",
                            "target_lang_translations": {
                                "ru": "Этот шоколадный торт — <w>веганский</w>, и он очень вкусный.",
                                "zh": "这款巧克力蛋糕是<w>纯素</w>的，味道很棒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plant-based"
                    ],
                    "antonyms": [
                        "animal-based"
                    ],
                    "common_phrases": [
                        "vegan diet",
                        "vegan food",
                        "vegan friendly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий продуктов животного происхождения (таких как мясо, яйца, молоко или кожа) или не связанный с эксплуатацией животных.",
                        "zh": "不含任何动物制品（如肉、蛋、奶或皮革）或不涉及动物使用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веганский",
                                "target_lang_sense_clarification": "о пище или продуктах"
                            },
                            {
                                "target_lang_word": "растительный",
                                "target_lang_sense_clarification": "о диете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纯素的",
                                "target_lang_sense_clarification": "形容食物或产品"
                            },
                            {
                                "target_lang_word": "植物性的",
                                "target_lang_sense_clarification": "形容饮食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02e6bf75-0682-34fd-8fa3-158a41fc4113",
                    "sense_definition": "Committed to avoiding any product or practice that inherently involves animal use.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dietary_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>vegan</w> because she cares deeply about animal welfare.",
                            "target_lang_translations": {
                                "ru": "Она <w>веган</w>, потому что её глубоко волнует благополучие животных.",
                                "zh": "她是一位<w>纯素食者</w>，因为她非常关心动物福利。"
                            }
                        },
                        {
                            "text": "My brother decided to go <w>vegan</w> last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году мой брат решил стать <w>веганом</w>.",
                                "zh": "我哥哥去年决定开始<w>纯素</w>生活。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go vegan",
                        "strict vegan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приверженный образу жизни, исключающему использование продуктов животного происхождения.",
                        "zh": "致力于避免任何涉及动物使用的产品或行为的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веган",
                                "target_lang_sense_clarification": "существительное, используемое для описания человека"
                            },
                            {
                                "target_lang_word": "строгий вегетарианец",
                                "target_lang_sense_clarification": "синоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纯素食主义的",
                                "target_lang_sense_clarification": "形容生活方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2d2c263-24a4-3bae-b4c6-55ea46647549",
                    "sense_definition": "Relating to vegans or the practice of veganism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dietary_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is very interested in <w>vegan</w> philosophy and ethics.",
                            "target_lang_translations": {
                                "ru": "Она очень интересуется <w>веганской</w> философией и этикой.",
                                "zh": "她对<w>纯素</w>哲学和伦理学非常感兴趣。"
                            }
                        },
                        {
                            "text": "There has been a rise in <w>vegan</w> activism recently.",
                            "target_lang_translations": {
                                "ru": "В последнее время наблюдается рост <w>веганского</w> активизма.",
                                "zh": "最近<w>纯素</w>主义运动有所兴起。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vegan movement",
                        "vegan philosophy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к веганам, веганству или соответствующей философии.",
                        "zh": "与纯素食者、纯素食主义或相关哲学有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веганский",
                                "target_lang_sense_clarification": "относящийся к движению или философии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纯素的",
                                "target_lang_sense_clarification": "形容运动或哲学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b4ea755-0ddd-3287-a870-83d9ae230a94",
                    "sense_definition": "A person who does not eat, drink, or use any animal products.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dietary_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>vegan</w>, he does not wear leather shoes or wool sweaters.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>веганом</w>, он не носит кожаную обувь или шерстяные свитера.",
                                "zh": "作为一名<w>纯素食者</w>，他不穿皮鞋，也不穿羊毛衫。"
                            }
                        },
                        {
                            "text": "Many <w>vegans</w> take vitamin B12 supplements to stay healthy.",
                            "target_lang_translations": {
                                "ru": "Многие <w>веганы</w> принимают добавки с витамином B12, чтобы оставаться здоровыми.",
                                "zh": "许多<w>纯素食者</w>通过服用维生素B12补充剂来保持健康。"
                            }
                        }
                    ],
                    "antonyms": [
                        "omnivore",
                        "meat-eater"
                    ],
                    "common_phrases": [
                        "strict vegan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который не употребляет в пищу и не использует продукты животного происхождения.",
                        "zh": "不食用、饮用或使用任何动物制品的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веган",
                                "target_lang_sense_clarification": "мужской род или общее"
                            },
                            {
                                "target_lang_word": "веганка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纯素食者",
                                "target_lang_sense_clarification": "指代人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2e02fcb7-ad13-3429-b943-4d4c4b343ae0",
                    "sense_definition": "An inhabitant of the star system Vega (often used in science fiction).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vega_demonym",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "The character in the story was a <w>Vegan</w> from a distant planet.",
                            "target_lang_translations": {
                                "ru": "Персонаж этой истории был <w>веганцем</w> с далекой планеты.",
                                "zh": "故事里的角色是一个来自遥远星球的<w>织女星人</w>。"
                            }
                        },
                        {
                            "text": "Are you a <w>Vegan</w> or from another star system?",
                            "target_lang_translations": {
                                "ru": "Ты <w>веганец</w> или из другой звездной системы?",
                                "zh": "你是<w>织女星人</w>还是来自其他星系？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "capitalized"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "science fiction context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель звездной системы Вега (в научной фантастике).",
                        "zh": "织女星系的居民（常用于科幻小说）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веганец",
                                "target_lang_sense_clarification": "житель Веги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "织女星人",
                                "target_lang_sense_clarification": "科幻语境下的外星居民"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f3baf4-9590-3006-917c-33296595d92c",
                    "sense_definition": "A native or resident of Las Vegas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vegas_demonym",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Many native <w>Vegans</w> work in the hospitality industry.",
                            "target_lang_translations": {
                                "ru": "Многие коренные <w>жители Лас-Вегаса</w> работают в индустрии гостеприимства.",
                                "zh": "许多土生土长的<w>拉斯维加斯人</w>在酒店业工作。"
                            }
                        },
                        {
                            "text": "He is a proud <w>Vegan</w> who has lived in Nevada all his life.",
                            "target_lang_translations": {
                                "ru": "Он гордый <w>житель Лас-Вегаса</w>, проживший в Неваде всю свою жизнь.",
                                "zh": "他是一位自豪的<w>拉斯维加斯人</w>，一生都住在内华达州。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for Las Vegan"
                        },
                        {
                            "trait_type": "form",
                            "comment": "capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец или житель Лас-Вегаса.",
                        "zh": "拉斯维加斯的本地人或居民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель Лас-Вегаса",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉斯维加斯人",
                                "target_lang_sense_clarification": "指代城市居民"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}