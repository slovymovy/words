    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "69f88c40-32ef-37ec-9709-57cd32afbc2d",
                "word": "horniness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf645fb6-21bb-3f21-939b-9d29bdebdc9c",
                        "entry_id": "69f88c40-32ef-37ec-9709-57cd32afbc2d",
                        "glosses": [
                            "Quality of being horny, of having a texture like horn."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "17ea2202-562d-46e0-9a6d-db144bd9d0c7",
                                "sense_id": "bf645fb6-21bb-3f21-939b-9d29bdebdc9c",
                                "text": "the horniness of a hoof"
                            }
                        ]
                    },
                    {
                        "sense_id": "d4615ead-e377-3fbc-b072-d25d74e37fef",
                        "entry_id": "69f88c40-32ef-37ec-9709-57cd32afbc2d",
                        "glosses": [
                            "The state, quality, or extent of being horny or sexually excited."
                        ],
                        "tags": [
                            "slang",
                            "uncountable",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "0f5cdc1c-a896-479f-b94b-9de8e6de37db",
                                "sense_id": "d4615ead-e377-3fbc-b072-d25d74e37fef",
                                "text": "He was visited on a lunar basis by these great unspecific waves of horniness, whereby all women within a certain age group and figure envelope became immediately and impossibly desirable."
                            },
                            {
                                "example_id": "87429f7a-55fc-4297-b9ac-8c5c027f92e0",
                                "sense_id": "d4615ead-e377-3fbc-b072-d25d74e37fef",
                                "text": "Horniness is just a mental state with a physical repercussion."
                            },
                            {
                                "example_id": "cf6d0c38-e040-463b-9a5d-10cbf6f0c99f",
                                "sense_id": "d4615ead-e377-3fbc-b072-d25d74e37fef",
                                "text": "I'm not thinking we're star-crossed lovers or anything. I've mistaken regular-ass horniness for the cosmic pull of destiny before. And I always ended up worse for it."
                            },
                            {
                                "example_id": "260fc85a-b86d-4b9d-b50a-7baec24fd257",
                                "sense_id": "d4615ead-e377-3fbc-b072-d25d74e37fef",
                                "text": "“Less Lonely,” Tom’s solo comedy show about their quest for love, sex and gender confirmation “at the end of the world,” swerves between self-deprecation, vulnerability and shameless horniness."
                            },
                            {
                                "example_id": "c216c181-28e9-42a1-a47a-1f1268c14977",
                                "sense_id": "d4615ead-e377-3fbc-b072-d25d74e37fef",
                                "text": "I was about to collapse into a ritual of frustrated horniness (fantasy, masturbation, snacks) when a friend urged me to join her and two other women for dinner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f9ad903-54dc-43f9-83b6-409185baded3",
                        "source_entry_id": "69f88c40-32ef-37ec-9709-57cd32afbc2d",
                        "source_sense_description": "sexual excitement",
                        "target_lang_word": "Geilheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geilheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                        "entry_id": "4d8c98f0-c6c0-3b59-a2e8-30c186f8d3a5",
                                        "glosses": [
                                            "Verfassung/Zustand, sexuell erregt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811680fd-7066-4df6-9915-893dd461dbf6",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "„Almuth hatte es auf die Schnelle haben wollen, sie war mit einer kühlen Geilheit dabei gewesen.“"
                                            },
                                            {
                                                "example_id": "beb4e094-6b4a-4d67-8042-764a9c596ee6",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "„Lust auf ein Bad hatte er nicht, aber er konnte seine Geilheit nicht mehr zügeln, und daher besorgte er es sich eben selbst.“"
                                            },
                                            {
                                                "example_id": "6fcbf0c0-948d-4061-9b02-7227d8eadbf9",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "Ohne diese derbe, rohe Redeweise, ohne den Soldatenjargon und diese schmucklos ausgebreitete Geilheit hätte die Erzählung nicht echt, sondern künstlich gewirkt, mit falschen Wörtern hätte er die dargestellten Menschen verraten."
                                            },
                                            {
                                                "example_id": "0c44a90f-016f-4db3-80a0-6facbffba356",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "„Folglich war meine Geilheit wichtiger als die so lang verabreichte Moralkotze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "443dada6-de6c-3007-b010-c275a1d2d9b9",
                                        "entry_id": "4d8c98f0-c6c0-3b59-a2e8-30c186f8d3a5",
                                        "glosses": [
                                            "übermäßiges Wachstum von Pflanzen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee64825d-e014-4eb3-8d01-5d72df017e33",
                                                "sense_id": "443dada6-de6c-3007-b010-c275a1d2d9b9",
                                                "text": "Praktische Versuche haben übrigens dargethan, daß das Vermögen der Cerealien, aus der Atmosphäre Stickstoffverbindungen zu absorbiren, höchst gering, daher bedeutungslos ist, und daß, alle übrigen zur Ausbildung unentbehrlichen mineralischen Nährstoffe im geeigneten Zustande vorausgesetzt, ihre Entwickelung dem Stickstoffzusatze proportional erfolgte und erst ein Überschuß an löslichen Stickstoffverbindungen ein übereiltes Wachsthum, Geilheit, endliche Lagerung und mangelhafte Ausbildung der Körner hervorrief."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
