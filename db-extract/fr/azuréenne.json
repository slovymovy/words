                        "sense_id": "9a631a7f-ca17-380f-8e4a-1fa18f2732e0",
                        "entry_id": "09b21c5b-47b8-3f23-8edd-57a6a27af661",
                        "glosses": [
                            "Féminin singulier de azuréen."
