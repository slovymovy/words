                    {
                        "sense_id": "4ebca5f1-e24e-3a0f-a152-38c44ba67799",
                        "entry_id": "6307f14c-d065-3a05-b786-b8925c332b78",
                        "glosses": [
                            "Action d’émorfiler, affûtage des dents d'une lame de scie, de couteau, en les meulant de façon à corriger la déviation de l’arête de coupe éventuellement provoquée par l’avoyage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2eded9-e6a7-444d-906c-d8a0f06ac8a9",
                                "sense_id": "4ebca5f1-e24e-3a0f-a152-38c44ba67799",
                                "text": "L’émorfilage doit être fait avec un très léger angle d'attaque afin d'éviter d’arrondir le canal intérieur (ou le dessous) du couteau."
                            },
                            {
                                "example_id": "d5aa5f01-b872-40c1-8c9d-62589ee2e566",
                                "sense_id": "4ebca5f1-e24e-3a0f-a152-38c44ba67799",
                                "text": "Après leur émorfilage au meulardeau, les outils étaient enduits de vaseline, d’huile claire ou d’encaustique, afin d’éliminer tout risque d’oxydation."
                            }
                        ]
                    }
                ],
