                    "frequency": "High",
                    "semantic_group_id": "recipientes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de verser de l'eau fraîche dans la <w>gamelle</w> du chien."
                        },
                        {
                            "text": "Le chat attend patiemment devant sa <w>gamelle</w> vide que quelqu'un vienne le nourrir."
                        }
                    ],
                    "synonyms": [
