                                        "entry_id": "f75c1ffe-7ac1-3be9-bd1e-d7ad34eaa370",
                                        "glosses": [
                                            "die Ausbreitung von Teilchen oder Wellen in eine bestimmte Richtung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d928db-f53c-4c5b-b2bc-8dcff6366ea3",
                                                "sense_id": "d017799a-aeaa-39f6-b851-b51f677c2ed3",
                                                "text": "Die radioaktive Strahlung ist für Menschen sehr gefährlich."
                                            },
                                            {
                                                "example_id": "25030aa4-8c53-47f3-8585-714c2b94baf2",
                                                "sense_id": "d017799a-aeaa-39f6-b851-b51f677c2ed3",
                                                "text": "„Ein fehlerhaftes Laborgerät und Mangel an Vorsicht bewirkten, daß seine linke Hand eine Überdosis von radioaktiver Strahlung abbekam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbbb1379-9d45-3678-9b71-deba2fce8eba",
                                        "entry_id": "f75c1ffe-7ac1-3be9-bd1e-d7ad34eaa370",
                                        "glosses": [
                                            "Wirkung oder Ausstrahlung eines Menschen"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb2edd9-a2ee-46b5-ad21-a60981b8805b",
                                                "sense_id": "cbbb1379-9d45-3678-9b71-deba2fce8eba",
                                                "text": "„… er war noch jung, es war noch weit vom Ende, noch ging Strahlung und Verlockung von ihm aus, noch liebten sie ihn, die guten ängstlichen Weibchen, noch zählten sie auf ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
