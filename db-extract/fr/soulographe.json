                        "sense_id": "24ec9a1a-85b1-33f4-9b14-7c66a4d3de8c",
                        "entry_id": "ddce1215-017f-3bd1-a2d3-67ea89e1fc83",
                        "glosses": [
                            "Ivrogne ; buveur excessif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1c75d5-ad1b-481e-8e24-6b386e797bba",
                                "sense_id": "24ec9a1a-85b1-33f4-9b14-7c66a4d3de8c",
                                "text": "Inquiets, certains clients quittent le café mais, à peine sortis, s'arrêtent derrière la vitre pour contempler une dernière fois le soulographe."
                            },
                            {
                                "example_id": "012fd309-0106-431e-af0c-abedf9caad1f",
                                "sense_id": "24ec9a1a-85b1-33f4-9b14-7c66a4d3de8c",
                                "text": "L’ivresse alcoolique est une expérience qui fait de l'ivrogne un poète et du soulographe un génie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7206c93-ddea-4cdd-b064-ab202a5b8333",
                        "source_entry_id": "ddce1215-017f-3bd1-a2d3-67ea89e1fc83",
                        "source_sense_id": "24ec9a1a-85b1-33f4-9b14-7c66a4d3de8c",
                        "target_lang_word": "drunk",
