                        "entry_id": "76fd47a6-ac7c-3492-94a7-bb4261e82efc",
                        "glosses": [
                            "Vorrichtung zum Abscheiden von Stoffen aus Flüssigkeiten, Gasen oder Dämpfen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "438f55f8-8a23-4f99-bd49-c30352e5c160",
                                "sense_id": "2d27b67b-3442-34ec-b8f9-98b42456d790",
                                "text": "Der Heizölabscheider ist ein Abscheider für Leichtflüssigkeiten."
                            },
                            {
                                "example_id": "b7b10565-30b2-4e63-9eab-71d81abad502",
                                "sense_id": "2d27b67b-3442-34ec-b8f9-98b42456d790",
                                "text": "„Um bestimmte Flüssigkeiten (wie z.B. Fette, Öle, Benzin) und feste Stoffe (wie z.B. Stärke, Schlamm, Sand) die nicht in die Kanalisation gelangen dürfen zurückzuhalten, müssen sogenannte Abscheider eingebaut werden.“"
                            }
                        ],
