                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20bea2b9-7021-40cf-a57c-4e08ed501ca3",
                                "sense_id": "8d05188b-9e45-3023-bcd6-ea0657360a8e",
                                "text": "— Чем я мог заслужить благоволение Анны Сергеевны?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ea31e81-5ca0-3274-86c7-c23ac8ef2661",
                        "entry_id": "e9124e20-1bbb-396f-ba0d-dba5077ba74e",
                        "glosses": [
                            "устар. благосклонность высшего лица"
                        ],
                        "tags": [],
