{
    "word_family": [
        "dispose",
        "disposable",
        "disposal",
        "predisposition",
        "predispose"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                    "sense_definition": "A person's inherent qualities of mind and character; their natural temperament or habitual mood.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a naturally sunny <w>disposition</w> and always looks on the bright side of things.",
                            "target_lang_translations": {
                                "ru": "У неё от природы жизнерадостный <w>нрав</w>, и она всегда смотрит на вещи оптимистично.",
                                "tr": "Doğuştan gelen neşeli bir <w>mizacı</w> var ve her zaman olayların iyi tarafına bakar.",
                                "zh": "她天生<w>性格</w>开朗，总是看到事物积极的一面。"
                            }
                        },
                        {
                            "text": "His cheerful <w>disposition</w> made him very popular among his colleagues at the office.",
                            "target_lang_translations": {
                                "ru": "Его весёлый <w>характер</w> сделал его очень популярным среди коллег в офисе.",
                                "tr": "Neşeli <w>huyu</w> onu ofisteki meslektaşları arasında çok popüler yaptı.",
                                "zh": "他那愉快的<w>性情</w>使他在办公室同事中非常受欢迎。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sunny disposition",
                        "cheerful disposition",
                        "nervous disposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Врожденные качества ума и характера человека; его естественный темперамент или привычное настроение.",
                        "tr": "Bir kişinin doğuştan gelen zihin ve karakter özellikleri; doğal mizacı veya alışılmış ruh hali.",
                        "zh": "指一个人的内在心理品质和性格；其天生的气质或习惯性的情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нрав",
                                "target_lang_sense_clarification": "совокупность душевных свойств"
                            },
                            {
                                "target_lang_word": "характер",
                                "target_lang_sense_clarification": "особенности поведения и личности"
                            },
                            {
                                "target_lang_word": "темперамент",
                                "target_lang_sense_clarification": "психические свойства личности"
                            },
                            {
                                "target_lang_word": "расположение духа",
                                "target_lang_sense_clarification": "настроение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mizaç",
                                "target_lang_sense_clarification": "bir kişinin doğuştan gelen karakter yapısı"
                            },
                            {
                                "target_lang_word": "huy",
                                "target_lang_sense_clarification": "kişinin alışılmış davranış biçimi"
                            },
                            {
                                "target_lang_word": "yaradılış",
                                "target_lang_sense_clarification": "doğuştan gelen özellikler"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "性格",
                                "target_lang_sense_clarification": "指人的个性特征"
                            },
                            {
                                "target_lang_word": "气质",
                                "target_lang_sense_clarification": "指人的天生风度或性情"
                            },
                            {
                                "target_lang_word": "性情",
                                "target_lang_sense_clarification": "指人的天性与情感倾向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bdbd1fc-2438-36d7-ab36-60f67e43893f",
                    "sense_definition": "A tendency or inclination to act in a particular way or to be affected by something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tendency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge noted the defendant's <w>disposition</w> to engage in risky behavior.",
                            "target_lang_translations": {
                                "ru": "Судья отметил <w>склонность</w> подсудимого к рискованному поведению.",
                                "tr": "Yargıç, sanığın riskli davranışlara girme <w>eğilimini</w> not etti.",
                                "zh": "法官指出了被告进行冒险行为的<w>倾向</w>。"
                            }
                        },
                        {
                            "text": "Some materials have a natural <w>disposition</w> to expand when they are heated.",
                            "target_lang_translations": {
                                "ru": "Некоторые материалы имеют природную <w>предрасположенность</w> к расширению при нагревании.",
                                "tr": "Bazı malzemelerin ısındıklarında genleşmeye karşı doğal bir <w>yatkınlığı</w> vardır.",
                                "zh": "有些材料在受热时有自然膨胀的<w>倾向</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "natural disposition",
                        "disposition to believe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тенденция или склонность действовать определенным образом или подвергаться какому-либо воздействию.",
                        "tr": "Belirli bir şekilde hareket etme veya bir şeyden etkilenme eğilimi.",
                        "zh": "以特定方式行事或易受某事物影响的倾向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонность",
                                "target_lang_sense_clarification": "влечение к чему-либо"
                            },
                            {
                                "target_lang_word": "предрасположение",
                                "target_lang_sense_clarification": "наличие задатков к чему-либо"
                            },
                            {
                                "target_lang_word": "предрасположенность",
                                "target_lang_sense_clarification": "склонность к состоянию или болезни"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eğilim",
                                "target_lang_sense_clarification": "bir şeye yönelik doğal yönelim"
                            },
                            {
                                "target_lang_word": "yatkınlık",
                                "target_lang_sense_clarification": "bir duruma veya hastalığa karşı doğal hazırlık"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾向",
                                "target_lang_sense_clarification": "指某种行为或发展的趋势"
                            },
                            {
                                "target_lang_word": "易感性",
                                "target_lang_sense_clarification": "指容易受到某种影响或患病的特质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab55c647-0cf4-3f28-9aa5-d096c4a160a8",
                    "sense_definition": "The way in which something is placed or arranged, especially in relation to other things.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general carefully planned the <w>disposition</w> of troops along the border.",
                            "target_lang_translations": {
                                "ru": "Генерал тщательно спланировал <w>расположение</w> войск вдоль границы.",
                                "tr": "General, sınır boyunca birliklerin <w>yerleşimini</w> dikkatlice planladı.",
                                "zh": "将军仔细规划了边境沿线的军队<w>部署</w>。"
                            }
                        },
                        {
                            "text": "The strategic <w>disposition</w> of the furniture made the small room feel much larger.",
                            "target_lang_translations": {
                                "ru": "Стратегическая <w>расстановка</w> мебели позволила маленькой комнате казаться намного больше.",
                                "tr": "Mobilyaların stratejik <w>düzeni</w>, küçük odanın çok daha geniş görünmesini sağladı.",
                                "zh": "家具的战略性<w>布局</w>让这个小房间看起来宽敞多了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "disposition of troops",
                        "strategic disposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ размещения или расстановки чего-либо, особенно по отношению к другим объектам.",
                        "tr": "Bir şeyin, özellikle diğer nesnelere göre yerleştirilme veya düzenlenme biçimi.",
                        "zh": "某物被放置或排列的方式，尤指与其他事物之间的相对位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "размещение в пространстве"
                            },
                            {
                                "target_lang_word": "расстановка",
                                "target_lang_sense_clarification": "порядок размещения"
                            },
                            {
                                "target_lang_word": "диспозиция",
                                "target_lang_sense_clarification": "военное или стратегическое расположение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerleşim",
                                "target_lang_sense_clarification": "bir şeyin bulunduğu konum"
                            },
                            {
                                "target_lang_word": "düzen",
                                "target_lang_sense_clarification": "nesnelerin birbirine göre sıralanışı"
                            },
                            {
                                "target_lang_word": "konumlandırma",
                                "target_lang_sense_clarification": "stratejik olarak yerleştirme"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布局",
                                "target_lang_sense_clarification": "指空间上的安排与配置"
                            },
                            {
                                "target_lang_word": "部署",
                                "target_lang_sense_clarification": "指军事或战略上的安排"
                            },
                            {
                                "target_lang_word": "排列",
                                "target_lang_sense_clarification": "指物体的摆放顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92104cc3-f801-33fe-8f13-1fff0d64ff54",
                    "sense_definition": "The act of getting rid of something, or the transfer of property or money to someone else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered the <w>disposition</w> of all assets to pay off the remaining debts.",
                            "target_lang_translations": {
                                "ru": "Суд распорядился об <w>отчуждении</w> всех активов для погашения оставшихся долгов.",
                                "tr": "Mahkeme, kalan borçları ödemek için tüm varlıkların <w>elden çıkarılmasına</w> karar verdi.",
                                "zh": "法院下令<w>处置</w>所有资产以偿还剩余债务。"
                            }
                        },
                        {
                            "text": "The final <w>disposition</w> of assets was handled by a specialized legal team.",
                            "target_lang_translations": {
                                "ru": "Окончательным <w>распоряжением</w> активами занималась специализированная группа юристов.",
                                "tr": "Varlıkların nihai <w>tasfiyesi</w> uzman bir hukuk ekibi tarafından yürütüldü.",
                                "zh": "资产的最终<w>处置</w>由专业的法律团队处理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assignment",
                        "conveyance"
                    ],
                    "common_phrases": [
                        "disposition of assets",
                        "final disposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт избавления от чего-либо или передача имущества или денег другому лицу.",
                        "tr": "Bir şeyden kurtulma eylemi veya mülkiyetin ya da paranın başka birine devredilmesi.",
                        "zh": "处理掉某物，或将财产、金钱转让给他人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждение",
                                "target_lang_sense_clarification": "передача прав собственности"
                            },
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "использование или передача имущества"
                            },
                            {
                                "target_lang_word": "реализация",
                                "target_lang_sense_clarification": "продажа или избавление от активов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "elden çıkarma",
                                "target_lang_sense_clarification": "bir varlığı satma veya devretme"
                            },
                            {
                                "target_lang_word": "tasfiye",
                                "target_lang_sense_clarification": "varlıkların nakde çevrilmesi veya kapatılması"
                            },
                            {
                                "target_lang_word": "devir",
                                "target_lang_sense_clarification": "mülkiyetin başkasına geçirilmesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处置",
                                "target_lang_sense_clarification": "指对财产或事务的安排与处理"
                            },
                            {
                                "target_lang_word": "转让",
                                "target_lang_sense_clarification": "指所有权的移交"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf4b512-83fd-3fea-be74-f3405ead34c1",
                    "sense_definition": "The final settlement of a matter, such as a court case or a business deal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disposition</w> of the case will be announced by the judge tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Окончательное <w>решение</w> по делу будет объявлено судьей завтра утром.",
                                "tr": "Davanın nihai <w>çözümü</w> yarın sabah yargıç tarafından açıklanacak.",
                                "zh": "该案件的最终<w>裁决</w>将于明早由法官宣布。"
                            }
                        },
                        {
                            "text": "We are still waiting for the final <w>disposition</w> of the legal dispute.",
                            "target_lang_translations": {
                                "ru": "Мы все еще ждем окончательного <w>урегулирования</w> этого правового спора.",
                                "tr": "Hukuki anlaşmazlığın nihai <w>karara bağlanmasını</w> hala bekliyoruz.",
                                "zh": "我们仍在等待法律纠纷的最终<w>解决</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "disposition of the case",
                        "final disposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончательное урегулирование вопроса, такого как судебное дело или деловая сделка.",
                        "tr": "Bir mahkeme davası veya iş anlaşması gibi bir konunun nihai çözümü.",
                        "zh": "对某事（如法庭案件或商业交易）的最终解决。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "урегулирование спора или дела"
                            },
                            {
                                "target_lang_word": "завершение",
                                "target_lang_sense_clarification": "окончательное решение"
                            },
                            {
                                "target_lang_word": "постановление",
                                "target_lang_sense_clarification": "судебное решение по делу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çözüm",
                                "target_lang_sense_clarification": "bir sorunun nihai olarak bitirilmesi"
                            },
                            {
                                "target_lang_word": "karar",
                                "target_lang_sense_clarification": "hukuki bir sürecin sonuçlanması"
                            },
                            {
                                "target_lang_word": "sonuçlandırma",
                                "target_lang_sense_clarification": "bir işin nihayete erdirilmesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解决",
                                "target_lang_sense_clarification": "指问题的最终处理"
                            },
                            {
                                "target_lang_word": "裁决",
                                "target_lang_sense_clarification": "指法律上的最终决定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb92e99d-9637-3f6d-b49e-4536b513738e",
                    "sense_definition": "A formal provision or clause in a legal document or law.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_clause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dispositions</w> of this Act shall not be applied in cases of emergency.",
                            "target_lang_translations": {
                                "ru": "<w>Положения</w> настоящего Акта не применяются в чрезвычайных ситуациях.",
                                "tr": "Bu Kanunun <w>hükümleri</w> acil durumlarda uygulanmayacaktır.",
                                "zh": "本法案的<w>条款</w>在紧急情况下不予适用。"
                            }
                        },
                        {
                            "text": "The lawyer examined the legal <w>dispositions</w> to find a loophole in the contract.",
                            "target_lang_translations": {
                                "ru": "Юрист изучил правовые <w>нормы</w>, чтобы найти лазейку в контракте.",
                                "tr": "Avukat, sözleşmedeki bir boşluğu bulmak için yasal <w>düzenlemeleri</w> inceledi.",
                                "zh": "律师研究了法律<w>规定</w>，试图在合同中寻找漏洞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal dispositions",
                        "statutory disposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное положение или пункт в юридическом документе или законе.",
                        "tr": "Hukuki bir belgedeki veya kanundaki resmi hüküm veya madde.",
                        "zh": "法律文件或法律中的正式规定或条款。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "пункт закона или акта"
                            },
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "предписание в документе"
                            },
                            {
                                "target_lang_word": "норма",
                                "target_lang_sense_clarification": "правовое предписание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hüküm",
                                "target_lang_sense_clarification": "yasal bir metindeki kural"
                            },
                            {
                                "target_lang_word": "madde",
                                "target_lang_sense_clarification": "yasal belgenin bölümleri"
                            },
                            {
                                "target_lang_word": "düzenleme",
                                "target_lang_sense_clarification": "yasal bir kural koyma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条款",
                                "target_lang_sense_clarification": "指法律文件中的具体规定"
                            },
                            {
                                "target_lang_word": "规定",
                                "target_lang_sense_clarification": "指法律或规章中的条文"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27681993-e9b6-3692-8170-69b2133c05d7",
                    "sense_definition": "To place or arrange something in a specific position or order.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician was <w>dispositioning</w> the equipment to ensure optimal signal strength.",
                            "target_lang_translations": {
                                "ru": "Техник <w>размещал</w> оборудование так, чтобы обеспечить оптимальную силу сигнала.",
                                "tr": "Teknisyen, optimum sinyal gücünü sağlamak için ekipmanı <w>konumlandırıyordu</w>.",
                                "zh": "技术人员正在<w>安置</w>设备，以确保最佳的信号强度。"
                            }
                        },
                        {
                            "text": "After the inspection, the items were <w>dispositioned</w> according to their quality grade.",
                            "target_lang_translations": {
                                "ru": "После проверки предметы были <w>распределены</w> в соответствии с их сортом качества.",
                                "tr": "İncelemeden sonra, ürünler kalite derecelerine göre <w>düzenlendi</w>.",
                                "zh": "检查后，这些物品根据质量等级进行了<w>分类</w>处理。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
