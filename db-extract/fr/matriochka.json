                        "examples": [
                            {
                                "example_id": "c877fce1-4329-454c-b376-b91778954dee",
                                "sense_id": "87221dd1-986d-328b-b931-ad2210c2e7a3",
                                "text": "Guéorgui Nicolaïévitch, vous vous rappelez ce tir où vous avez gagné une matriochka ? Je l’ai toujours sur mon buffet, figurez-vous, chère Clara. Une poupée géante : d’un demi-mètre au moins."
                            },
                            {
                                "example_id": "dd27131b-f6aa-4bb2-80f9-31d7677e46e9",
                                "sense_id": "87221dd1-986d-328b-b931-ad2210c2e7a3",
                                "text": "De même, une matriochka est une poupée russe dans laquelle est contenue une matriochka."
                            }
                        ]
                    },
                    {
                        "sense_id": "24429adb-216c-3d6b-9f22-f7574d9466e0",
                        "entry_id": "8eaeeea3-6b47-3cb0-b244-0e8b887d2892",
                        "glosses": [
                            "Femme plutôt imposante et d'un certain âge."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "d7e8702a-0633-405a-bd7d-ec46a9b9414f",
                                "sense_id": "24429adb-216c-3d6b-9f22-f7574d9466e0",
                                "text": "Emma retrouve Myriam au bout du wagon, grondée par la grosse matriochka qui surveille le samovar."
                            }
                        ]
                    }
