                        {
                            "text": "Lisy nie opuszczały swoich ciemnych <w>jam</w> aż do zapadnięcia zmroku.",
                            "target_lang_translations": {
                                "en": "The foxes did not leave their dark <w>dens</w> until nightfall."
                            }
