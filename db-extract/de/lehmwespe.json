                        "glosses": [
                            "Wespenart aus der Familie der Faltenwespen, die Nester aus Lehm baut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9648dd62-3d41-4db6-a6fb-fa345392de0a",
                                "sense_id": "ef07cac8-2968-3008-b209-b41900024d06",
                                "text": "„Die schmale Mündung hinauf, unter den niedrigen Bahnviadukt; er lag nun auf dem Rücken, über ihm Nester von Lehmwespen, Eidechsen glitten auf kleinen Haftzehen direkt vor seinem Gesicht vorbei, er schob sich gemächlich mit der Hand an der Wand entlang weiter.“"
                            }
