    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2adb6a73-c572-31b0-85d3-35ed1390e0b6",
                    "sense_definition": "Belonging to or relating to a particular individual rather than to anyone else.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "individual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone has their own <w>personal</w> opinion on how the project should be finished.",
                            "target_lang_translations": {
                                "ru": "У каждого есть свое <w>личное</w> мнение о том, как должен быть завершен проект."
                            }
                        },
                        {
                            "text": "She shared her <w>personal</w> experience of traveling alone through Europe for the first time.",
                            "target_lang_translations": {
                                "ru": "Она поделилась своим <w>личным</w> опытом первого одиночного путешествия по Европе."
                            }
                        }
                    ],
                    "synonyms": [
                        "individual",
                        "private",
                        "own"
                    ],
                    "antonyms": [
                        "public",
                        "general",
                        "common"
                    ],
                    "common_phrases": [
                        "personal opinion",
                        "personal experience",
                        "personal choice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий или относящийся к конкретному человеку, а не к кому-либо другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личный",
                                "target_lang_sense_clarification": "принадлежащий индивидууму"
                            },
                            {
                                "target_lang_word": "собственный",
                                "target_lang_sense_clarification": "свой собственный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d21a6c1-1b22-3e82-9d86-b0612d283e6d",
                    "sense_definition": "Done or made by a particular person themselves, rather than through someone else.",
