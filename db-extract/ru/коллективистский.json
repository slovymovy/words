                                "target_senses": [
                                    {
                                        "sense_id": "c485214d-8e15-3e82-b6fe-34fcec233643",
                                        "entry_id": "d3442f0b-f5a4-38d3-98a6-8247df81b373",
                                        "glosses": [
                                            "Of or pertaining to collectivism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "collectivist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf05248-2539-35b1-85ea-d473345993e1",
                                        "entry_id": "4c4e8281-57af-35d7-b1d9-8a725fa29f22",
                                        "glosses": [
                                            "An advocate of collectivism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1190ee5-b3fa-48e1-a826-d8a74158cb37",
                        "source_entry_id": "23f5e0c3-911a-3a54-904f-55284348f197",
                        "source_sense_id": "94ada3fc-5d64-3694-87b3-78410a4cce9b",
                        "target_lang_word": "collectivistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collectivistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa404761-fb1a-3fe4-91e0-3adf7864b888",
                                        "entry_id": "42b31bbf-ca67-33af-a233-8f0d1ca47191",
                                        "glosses": [
                                            "Of or pertaining to collectivism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e5faf3-aada-4b35-a540-4281255e1592",
                                                "sense_id": "aa404761-fb1a-3fe4-91e0-3adf7864b888",
                                                "text": "Public contributions, i.e. taxes, are only one form of value — collectivistic value."
                                            },
                                            {
                                                "example_id": "26b2846b-ea95-4bd5-a51a-9d48907afd6c",
                                                "sense_id": "aa404761-fb1a-3fe4-91e0-3adf7864b888",
                                                "text": "It is, then, as a treatise of social forces, individualistic and collectivistic, in German literature that Francke's work must be tested, not as a history of the artistic form and content of that literature."
                                            },
                                            {
                                                "example_id": "410898c1-7612-4429-a080-2701df7b20d3",
                                                "sense_id": "aa404761-fb1a-3fe4-91e0-3adf7864b888",
                                                "text": "People in individualistic cultures may be more concerned with distributive justice than people in collectivistic cultures because they have such clear-cut notions of individual equity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
