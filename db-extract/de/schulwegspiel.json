                "senses": [
                    {
                        "sense_id": "790f17fd-c240-3c51-b9ad-06f0d56866ed",
                        "entry_id": "80b526fa-7fef-3fcd-8356-0cb5a6685c70",
                        "glosses": [
                            "Spiel, das von Kindern auf dem Weg zur Schule betrieben wird beziehungsweise den Schulweg zum Lern- und Spielgegenstand hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1222665f-83c6-4fc6-a28a-215345c72a3f",
                                "sense_id": "790f17fd-c240-3c51-b9ad-06f0d56866ed",
                                "text": "„Daraus kann der Plan erwachsen, ein Schulwegspiel mit entsprechenden Ereignissen zu gestalten.“"
                            },
                            {
                                "example_id": "e0895bfd-50a9-419c-a83e-9df94d1f2e75",
                                "sense_id": "790f17fd-c240-3c51-b9ad-06f0d56866ed",
                                "text": "„Die Preise vom Glücksrad waren innert kurzer Zeit weg und auf dem grossen Teppich mit dem Schulwegspiel lösten die Kinder knifflige Fragen oder turnten sich mittels Bewegungsübungen zum Sieg.“"
                            },
                            {
                                "example_id": "5175122d-81be-4fbc-8658-92379ade726a",
                                "sense_id": "790f17fd-c240-3c51-b9ad-06f0d56866ed",
                                "text": "„Das Schulwegspiel soll Ihnen helfen, gemeinsam mit Ihrem Kind einen sicheren Schulweg zu finden und die Gefahrenpunkte zu verstehen.“"
                            },
                            {
                                "example_id": "1b250f18-b72d-44e5-93c0-2263de61e401",
                                "sense_id": "790f17fd-c240-3c51-b9ad-06f0d56866ed",
                                "text": "„Das Schulwegspiel ist ein Lernspiel in Form eines selbst erarbeiteten Brettspiels und gleichzeitig eine Methode der Verkehrserziehung.“"
                            },
                            {
                                "example_id": "10e9c83f-378b-42c2-83db-a9bdd37d1ac5",
                                "sense_id": "790f17fd-c240-3c51-b9ad-06f0d56866ed",
                                "text": "„Wir lassen die Kinder selbst ein Schulwegspiel entwerfen. Sie üben damit wie auch in unserem ‚Zwölf-Schritte-Programm’ spielerisch ihren eigenen Schulweg – und keinen abstrakten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
