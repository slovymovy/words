                                "target_senses": [
                                    {
                                        "sense_id": "f554d487-f634-3252-a379-62693f9d07d1",
                                        "entry_id": "d0a8c39e-9310-3404-a094-d696b47fb077",
                                        "glosses": [
                                            "Participe présent du verbe branler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29101349-bb01-47b6-b0a8-ff744fc85120",
                                                "sense_id": "f554d487-f634-3252-a379-62693f9d07d1",
                                                "text": "Mais, à la place d’un vaillant général, on ne vit qu’un vieillard à la voix enrouée branlant gâteusement la tête."
                                            }
                                        ]
