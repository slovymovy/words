                "senses": [
                    {
                        "sense_id": "3acb7720-e08a-3f92-bdc3-5cfc046fc45f",
                        "entry_id": "f4fb4a80-2b9e-3a1b-80e5-1a088f5d6fa6",
                        "glosses": [
                            "dachshund-shaped bobblehead"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "bf542e43-191a-4f09-b7ba-ab8b8ac80422",
                                "sense_id": "3acb7720-e08a-3f92-bdc3-5cfc046fc45f",
                                "text": "Die Fotografien sind dabei so beiläufig wie präzise, sie erfassen das Alltägliche, das unsere Blicke meist ausblenden, und sie erfassen die soziale Situation des Taxiverkehrs. Der Wackeldackel auf dem Armaturenbrett erzählt uns was über seinen unsichtbaren Fahrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "447d9b38-bd65-37d6-95ee-d643f831ce0e",
                        "entry_id": "f4fb4a80-2b9e-3a1b-80e5-1a088f5d6fa6",
                        "glosses": [
                            "yes-man"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "76321efd-b200-4a07-be76-73952b10adfe",
                                "sense_id": "447d9b38-bd65-37d6-95ee-d643f831ce0e",
                                "text": "Ein Bundespräsident ist kein Wackeldackel, der immer brav mit dem Kopf nickt, wenn ihn jemand anstupst."
                            }
                        ]
                    }
                ],
