                        "glosses": [
                            "het eindklassement bij een toernooi of serie wedstrijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dcb846b-849c-4259-8e0e-efbb1a10e73b",
                                "sense_id": "8c2c8d1b-b801-3236-96a1-6117e97e9885",
                                "text": "Engeland had in groep I nog één punt nodig om de eerste plaats in eindrangschikking veilig te stellen. Een opdracht die uit tegen San Marino, de hekkensluiter van de wereldranglijst, met gemak volbracht werd."
                            },
                            {
                                "example_id": "10a69ac0-a19f-4da5-bf21-456e5dc4ebfa",
                                "sense_id": "8c2c8d1b-b801-3236-96a1-6117e97e9885",
                                "text": "De B-finale werd daarna met overmacht gewonnen door Schulting, De Laat, Selma Poutsma en Jens van 't Wout, goed voor de vijfde plaats in de eindrangschikking in Nagoya."
                            },
                            {
                                "example_id": "59b129dc-e5ce-4549-a56c-95198d90710c",
                                "sense_id": "8c2c8d1b-b801-3236-96a1-6117e97e9885",
                                "text": "De Olympische Spelen in Tokio eindigden voor tafeltennisster Britt Eerland in de achtste finales. Ze moest haar meerdere erkennen in Doo Hoi Kem, de nummer vijftien van de wereld uit Hongkong. De negende plaats in de eindrangschikking stemde haar niettemin tevreden en trots."
                            }
                        ]
                    }
