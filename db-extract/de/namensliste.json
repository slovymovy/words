                ],
                "senses": [
                    {
                        "sense_id": "ffc79861-c8d0-3594-ae49-13b3dda8c274",
                        "entry_id": "84df2a8e-f3ea-3b58-abf5-582f53774452",
                        "glosses": [
                            "Liste, in der Namen aufgeführt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48a5274-8c2e-4eae-a5c0-af023a74a3f3",
                                "sense_id": "ffc79861-c8d0-3594-ae49-13b3dda8c274",
                                "text": "„Neben Kritzeleien finden sich Schreibübungen aus schulischem Kontext, Vorüberlegungen zu einer Handschrift, deren Seitengestaltung anscheinend zuerst auf Schiefer geplant wurde, der Entwurf eines Kaufvertrags, ein Bibelzitat (Zweck bisher ungeklärt) und Namenslisten.“"
                            },
                            {
                                "example_id": "3de440f6-d69c-463a-96ef-26743e596cce",
                                "sense_id": "ffc79861-c8d0-3594-ae49-13b3dda8c274",
                                "text": "„Heute gibt es eine Namensliste der Opfer von Nemmersdorf, die nicht ganz vollständig ist, jedoch einen ungefähren Eindruck vermittelt.“"
                            },
                            {
                                "example_id": "52aba450-e150-4af4-9a3f-627662779898",
                                "sense_id": "ffc79861-c8d0-3594-ae49-13b3dda8c274",
                                "text": "„Er stand dann vor der Tafel, setzte sich, griff das Klassenbuch und ging genüßlich die Namensliste durch, als wüsste er die Namen nicht.“"
                            },
                            {
                                "example_id": "3231e6ba-3162-44fd-9e61-cd909d19d32f",
                                "sense_id": "ffc79861-c8d0-3594-ae49-13b3dda8c274",
                                "text": "„Alphonse reichte ihm die Namensliste, die den Herren Journalisten täglich zur Verfügung stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
