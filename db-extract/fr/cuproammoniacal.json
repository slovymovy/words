                "senses": [
                    {
                        "sense_id": "a25d21ad-46fd-37da-871a-7421e918c7b7",
                        "entry_id": "f575820c-92b3-397a-ad27-ce70333e0487",
                        "glosses": [
                            "Qui contient à la fois des sels de cuivre et de l'ammoniac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e02fbb6b-1411-49f1-b453-8786f8ed815b",
                                "sense_id": "a25d21ad-46fd-37da-871a-7421e918c7b7",
                                "text": "Les soies au cuivre, ou mieux cuproammoniacales, utilisent comme on le sait, la réaction découverte par Schweitzer. Mercer observa également l'action de la liqueur cuproammoniacale sur la cellulose."
                            },
                            {
                                "example_id": "fb40f580-1eaa-431f-8456-906c4c6ffde3",
                                "sense_id": "a25d21ad-46fd-37da-871a-7421e918c7b7",
                                "text": "Les solutions cuproammoniacales attaquent donc les celluloses à froid, en présence d'un excès d'ammoniaque en formant des hydrocellulosates de cuivre qui se dissolvent."
                            }
                        ]
                    }
