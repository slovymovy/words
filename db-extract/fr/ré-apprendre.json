                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de réapprendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728cddd6-6570-4f70-8716-65820a41c7bc",
                                "sense_id": "a7a09458-7fd8-3ec8-902a-3f9b440d25ff",
                                "text": "Quelle sera ma mission précise ? - Ré-apprendre ce qu’avait appris Johnny, et qui a inquiété Pékin au point qu’on a dépêché Vong pour arrêter Johnny."
                            },
                            {
                                "example_id": "508c617e-2ae3-47d3-83e3-a51244e9be15",
                                "sense_id": "a7a09458-7fd8-3ec8-902a-3f9b440d25ff",
                                "text": "Forte leçon que les sociétés humaines et les individus qui les composent gagneraient à entendre, et à ré-apprendre."
                            }
                        ]
                    }
