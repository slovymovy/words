                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "12b27c99-c99c-389f-9d55-9186fddd0a31",
                                        "entry_id": "e1b25401-ba01-36a0-ad8d-7cb008310d2a",
                                        "glosses": [
                                            "vysoká teplota okolního prostředí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8118aa3-542e-49e4-aa77-d204a78681c9",
                                                "sense_id": "12b27c99-c99c-389f-9d55-9186fddd0a31",
                                                "text": "Bylo po celý den nesnesitelné vedro, i zde v oboře bylo dusno, ale pojednou, s nastávající tmou, počínají se stromy chvěti, jako by je mrazilo."
                                            },
                                            {
                                                "example_id": "5eac5b6e-2562-48a0-a7f2-03ff75a03154",
                                                "sense_id": "12b27c99-c99c-389f-9d55-9186fddd0a31",
                                                "text": "Jenže, co čert nechtěl, zachvátila Londýn v té době nebývalá vlna veder a teploměr se vyšplhal až na strašidelných třicet pět stupňů Celsia ve stínu."
                                            },
                                            {
                                                "example_id": "c61f241d-27b4-410c-b8ef-13189f522041",
                                                "sense_id": "12b27c99-c99c-389f-9d55-9186fddd0a31",
                                                "text": "Takže už půjdu do kanafasu. Brzy ráno vyrazíme směrem na sever do rezervace. Už i tady je zatracené vedro a naprosté sucho. Modlím se, aby pršelo!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vedro",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b79489-5317-32ef-b8f5-1f8451877310",
                                        "entry_id": "15b2061c-0092-3e9f-95d9-38cefa361545",
                                        "glosses": [
                                            "velmi horko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f45cc10-34fd-4648-a738-e4791fc2a0c9",
                                                "sense_id": "f5b79489-5317-32ef-b8f5-1f8451877310",
                                                "text": "Taky je vám dneska tak vedro? Mně tedy děsně! Brrr! Kdy už to sakra skončí?!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
