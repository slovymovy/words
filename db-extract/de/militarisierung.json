                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "06b04689-f3a4-4db9-b042-20641c579f91",
                                "sense_id": "c00b65cf-267a-312f-b8c4-67cac2537e4e",
                                "text": "Die Militarisierung des Gegners schreitet voran."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6634dbe8-6ad1-4481-b4ab-39c8fa1ca863",
                        "source_entry_id": "adc177cb-91c3-3316-b2a5-9aea891fdda0",
                        "target_lang_word": "militarization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militarization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb82a56d-7556-3b7d-b7dd-36e667ac3dae",
                                        "entry_id": "268ba235-e370-3d0c-8ef0-5b701744d7ef",
                                        "glosses": [
                                            "The process whereby some area, procedure, aspect of culture, etc., becomes controlled by the military or administered in a military fashion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2f6b46-7c00-4e85-a48f-5d9f16b42381",
                                                "sense_id": "bb82a56d-7556-3b7d-b7dd-36e667ac3dae",
                                                "text": "The masculine militarization of culture has led to a feminine eroticization."
                                            },
                                            {
                                                "example_id": "dc8846ed-5ac0-4404-92c2-ddfb1142287d",
                                                "sense_id": "bb82a56d-7556-3b7d-b7dd-36e667ac3dae",
                                                "text": "The 1990s saw a massive militarization of US police."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41730a9f-0cda-4852-9a46-16f9df6147e6",
                        "source_entry_id": "adc177cb-91c3-3316-b2a5-9aea891fdda0",
                        "target_lang_word": "militarisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militarisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e06cd48-e220-3a3b-a5e9-8f4fcaa29856",
                                        "entry_id": "10763ec6-d0dc-3b4b-bde3-0e38e1823372",
                                        "glosses": [
                                            "Action de militariser, processus de subordination aux forces armées ou à leurs valeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c6fadf-644d-4799-b545-eaae9fd8dab5",
                                                "sense_id": "5e06cd48-e220-3a3b-a5e9-8f4fcaa29856",
                                                "text": "La question soulevée par Hoffman est plutôt celle de l’effondrement des barrières entre les sphères économiques, politiques et culturelles avec la militarisation de la vie elle-même."
                                            },
                                            {
                                                "example_id": "e029280c-9e65-48e2-aa6f-d7041c4added",
                                                "sense_id": "5e06cd48-e220-3a3b-a5e9-8f4fcaa29856",
                                                "text": "La militarisation du maintien de l’ordre traduit l’échec des pouvoirs démocratiques à répondre aux nouvelles colères populaires."
                                            },
                                            {
                                                "example_id": "ad7493d8-9281-4e28-9fab-0a1a3706bcb3",
                                                "sense_id": "5e06cd48-e220-3a3b-a5e9-8f4fcaa29856",
                                                "text": "Pour les élèves plus âgés, la militarisation devient encore plus manifeste. En 2024, la Russie a introduit un nouveau module intitulé « Les fondamentaux de la sécurité et de la défense de la patrie »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
