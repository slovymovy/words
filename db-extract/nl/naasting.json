                                        "examples": [
                                            {
                                                "example_id": "c1c4d045-9d86-41c3-b545-d26017f30b45",
                                                "sense_id": "2b447df0-e5dc-373b-a942-86a617eb3a16",
                                                "text": "„Finanzminister Gernot Blümel hat sich auf den Standpunkt zurückgezogen, dass Verstaatlichungen derzeit nicht notwendig seien.“"
                                            },
                                            {
                                                "example_id": "e5518da2-b8b4-4290-8c60-48fdd49a0c9b",
                                                "sense_id": "2b447df0-e5dc-373b-a942-86a617eb3a16",
                                                "text": "Durch die Verstaatlichung wurde die Bank zum Staatseigentum."
                                            },
                                            {
                                                "example_id": "ff6e36d2-09f5-4928-8e16-21134c54f72b",
                                                "sense_id": "2b447df0-e5dc-373b-a942-86a617eb3a16",
                                                "text": "„Danach folgte die Verstaatlichung des Bodens, der Banken, der Industrieunternehmen und der Versorgungsnetze, und die sowjetische Gesetzgebung wurde eingeführt.“"
                                            },
                                            {
                                                "example_id": "e985abaa-0cd6-41d7-8ec6-c1867e36e371",
                                                "sense_id": "2b447df0-e5dc-373b-a942-86a617eb3a16",
                                                "text": "„Sie forderten deshalb eine höhere Besteuerung und eine Verstaatlichung des Abbaus.“"
