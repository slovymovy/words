                        "examples": [
                            {
                                "example_id": "15bb38e4-961d-44e3-b436-438f627f8efa",
                                "sense_id": "4631b975-ace7-3242-b88f-e9032ba4cc9c",
                                "text": "„Nachdem die ersten Ionen abgegeben sind, verbindet sich das Chloratom des ersten Moleküls mit dem Kaliumatom des zweiten Moleküls, das Chloratom des zweiten Moleküls mit dem Kaliumatom des dritten, und so fort.“"
                            },
                            {
                                "example_id": "a701d5ca-f36b-4ea9-9a2a-5c3582855fdb",
                                "sense_id": "4631b975-ace7-3242-b88f-e9032ba4cc9c",
                                "text": "„Die Kaliumatome lagern sich zwischen die Graphenschichten der Graphitstruktur ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
