                                        "entry_id": "eea95539-4d42-33b3-9bf0-7390ec6a908e",
                                        "glosses": [
                                            "A small sofa for two people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a201da66-d217-46da-9939-19cb7d4f03ad",
                                                "sense_id": "b6a93cf1-a891-34f0-92c4-7277fa61f458",
                                                "text": "A carafe of tea and a plate of oatmeal cookies were on a small mahogany table in front of a pink and lime green plaid loveseat."
                                            },
                                            {
                                                "example_id": "e71b0c83-f04c-4d05-b1ee-f9c626e2e69b",
                                                "sense_id": "b6a93cf1-a891-34f0-92c4-7277fa61f458",
                                                "text": "“Sit over there,” she added, pointing to a sage loveseat, matching chair and two chocolate-hued, cube-shaped ottomans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
