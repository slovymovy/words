                    {
                        "sense_id": "f91c59af-d0e5-3407-818f-fc7f29676e3f",
                        "entry_id": "97a55d70-01d7-3fc3-a238-672a9b22c059",
                        "glosses": [
                            "Offensive, causing an affront."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3b6166-ec6e-4f92-b2af-4c77fe99de3e",
                                "sense_id": "f91c59af-d0e5-3407-818f-fc7f29676e3f",
                                "text": "How much more affronting must it be to the Majefty of Heaven, the Great KING, to be thus treated?"
                            },
                            {
                                "example_id": "95c6e2a1-9638-45d2-94f1-0d4392d8ca31",
                                "sense_id": "f91c59af-d0e5-3407-818f-fc7f29676e3f",
                                "text": "There was afterwards one despatch from the Russian Minister to Earl Russell which in former times must have led to instant war, because it was of a very affronting character to the great nation which the noble Earl represented."
                            },
                            {
                                "example_id": "cacc8646-85ff-4de1-8b7d-d0e15feff907",
                                "sense_id": "f91c59af-d0e5-3407-818f-fc7f29676e3f",
                                "text": "The ladies tell me that there is no Adonis, which is very affronting —only old men (alias old women) , and boys like Thomas Thumb, with the legs of a starved spider."
                            }
                        ]
                    }
                ],
