                        "translation_id": "9b68063c-af74-4d5b-8c1e-c4994d51e368",
                        "source_entry_id": "07c2882a-f6cd-3222-82a3-2eb906ce82f1",
                        "source_sense_id": "2bf72935-866a-3e30-b396-c231b0ee8d59",
                        "target_lang_word": "Unbeschwertheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbeschwertheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                        "entry_id": "d42ec561-8392-3abc-8c06-ed44ada494c8",
                                        "glosses": [
                                            "psychischer Zustand, von nichts belastet/beschwert zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e414e372-db39-4842-a0b0-2fb9586ab234",
                                                "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                                "text": "„Unbeschwertheit würde es wohl nur noch in wenigen Sekunden des temporären Vergessens geben.“"
                                            },
                                            {
                                                "example_id": "251a9b2a-5d9c-4a08-83b2-62642f4356a1",
                                                "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                                "text": "„Er schnitt lustige Themen an; ich unterstützte ihn, aber bei weitem nicht mit der Unbeschwertheit, die uns im Wagen so herzlich lachen ließ.“"
                                            },
                                            {
                                                "example_id": "13030c85-b5a4-4e7b-9e1d-ceeb4b788757",
                                                "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                                "text": "„Mit Beginn des Ersten Weltkriegs endete die Unbeschwertheit im Hause Schmidt – jäh riss der heitere, um Babygewicht, erste Zähnchen und Schrittchen kreisende Ton im Tagebuch der Familie ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
