                "senses": [
                    {
                        "sense_id": "7973fa32-c59a-3d63-ba11-300491a803ad",
                        "entry_id": "a8a461e6-e85b-3678-b290-0001118afc0e",
                        "glosses": [
                            "Kind, das das zweite Lebensjahr nicht überschritten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3690ae-dcc1-4f25-822d-928bc750c74b",
                                "sense_id": "7973fa32-c59a-3d63-ba11-300491a803ad",
                                "text": "„Kleinstkinder spielen untereinander bevorzugt zu zweit (Dyade), erst im Kindergartenalter finden sich längere Szenen des Gruppenspiels (Polyade).“"
                            },
                            {
                                "example_id": "5ba69db4-523f-49e9-9e43-dae76463335d",
                                "sense_id": "7973fa32-c59a-3d63-ba11-300491a803ad",
                                "text": "„Ein Kleinstkind, dieses Wunderwerk, halt ich entzückt im Arme.“"
                            },
                            {
                                "example_id": "900cb451-74a0-4948-af3b-647775bb6324",
                                "sense_id": "7973fa32-c59a-3d63-ba11-300491a803ad",
                                "text": "„Bedeutend ist, wer für ein Baby und Kleinstkind die Bezugsperson ist.“"
                            },
                            {
                                "example_id": "00ca7622-1a69-48bc-b896-f500bc9e4455",
                                "sense_id": "7973fa32-c59a-3d63-ba11-300491a803ad",
                                "text": "„Die Haltung einer pädagogischen Fachkraft gegenüber Kleinstkindern offenbart sich besonders deutlich in der alltäglichen Konfliktbegleitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
