                                    {
                                        "sense_id": "c56df4a2-1029-36a9-bfba-03da0332473a",
                                        "entry_id": "3248c4ba-fef3-32ec-a255-6cd9184d2242",
                                        "glosses": [
                                            "das Depravieren, Verderben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a823810e-e962-4e2a-af02-085501474325",
                                                "sense_id": "c56df4a2-1029-36a9-bfba-03da0332473a",
                                                "text": "Mangelnde Investitionen können zur Depravierung von Bildungseinrichtungen führen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaeeb360-358f-4455-84ca-21a1648f6f0d",
                        "source_entry_id": "207f9d4c-4b3a-3efc-9d0c-51b41455404e",
                        "target_lang_word": "Depravation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Depravation",
