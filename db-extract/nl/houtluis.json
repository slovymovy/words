                ],
                "senses": [
                    {
                        "sense_id": "0915d66a-b32b-362c-9809-91c1e6b1b75b",
                        "entry_id": "c3ec5b35-ed5c-39d2-846a-2a1d014233ad",
                        "glosses": [
                            "benaming voor verschillende soorten insecten die hout eten, zoals Trogium pulsatorium, Liposcelis terricolis of de larven van Anobium punctatum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a09af5-e569-471c-84e7-8c9eabb1a10a",
                                "sense_id": "0915d66a-b32b-362c-9809-91c1e6b1b75b",
                                "text": "⧖ Wanneer des nachts bij een zieke gewaakt wordt en men de houtluis hoort, dan moet meestal 's anderen daags de geneesheer de verzekering vernemen dat patiënt niet weer herstellen zal; „want de doodsklopper heeft zich van nacht laten hooren”. In oude eikenhouten meubels vindt men dit insectje veel."
                            }
                        ]
                    },
                    {
                        "sense_id": "930cbfcd-9514-3292-8e80-e389cf3c438b",
                        "entry_id": "c3ec5b35-ed5c-39d2-846a-2a1d014233ad",
                        "glosses": [
                            "termiet, insect uit de orde Isoptera"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": [
                            {
                                "example_id": "06dd0d70-98b7-462c-8b54-0975ce1cb96f",
                                "sense_id": "930cbfcd-9514-3292-8e80-e389cf3c438b",
                                "text": "De eigenaar had verzuimd het gebouw te onderhouden en gaf daarmee de natuurelementen, houtluizen en ander ongedierte alle ruimte om een stukje koloniaal verleden te vernietigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c61f24c-7ca4-3ca1-a7c1-7d3ceb8d028d",
                        "entry_id": "c3ec5b35-ed5c-39d2-846a-2a1d014233ad",
                        "glosses": [
                            "bijnaam voor een timmerman"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1b7179db-02b9-4d2e-a982-473129b4ca6d",
                                "sense_id": "7c61f24c-7ca4-3ca1-a7c1-7d3ceb8d028d",
                                "text": "Ik hield vast aan de gedachte dat het een totaalboek moest worden. Alle materialen moesten aan de orde komen. Dat kostte mij hoofdbrekens, want ik ben smal opgeleid. Vroeger kende de technische opleiding twee richtingen: timmeren en metaalbewerken. Je was gewoon een houtluis of een roestkrabber. Nu moest ik mij zo breed mogelijk oriënteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb3151e-b563-4cce-a2c8-35e05216ee47",
                        "source_entry_id": "c3ec5b35-ed5c-39d2-846a-2a1d014233ad",
                        "source_sense_id": "0915d66a-b32b-362c-9809-91c1e6b1b75b",
                        "source_sense_description": "benaming voor verschillende soorten insecten die hout eten",
                        "target_lang_word": "deathwatch beetle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
