                                        "examples": [
                                            {
                                                "example_id": "578c2264-254b-4ad4-bd99-d215de2669aa",
                                                "sense_id": "391f87d3-37de-3a41-834a-94700ccd035d",
                                                "text": "Przy cmentarnej bramie ręce jałmużników wciąż wyciągnięte były ku przybywającym."
                                            }
                                        ],
