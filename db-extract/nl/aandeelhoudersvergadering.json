                ],
                "senses": [
                    {
                        "sense_id": "f3a4cae6-8f64-3156-9fcb-347241fe9faf",
                        "entry_id": "c1bde3b1-35d6-3f81-b9a7-5d8f33e6ba7a",
                        "glosses": [
                            "een formele vergadering van de houders van de aandelen van een vennootschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc0d22f2-1b2c-4b0f-8de9-f4824100fed3",
                                "sense_id": "f3a4cae6-8f64-3156-9fcb-347241fe9faf",
                                "text": "Op de aandeelhoudersvergadering werd het beleid van de directie goedgekeurd."
                            },
                            {
                                "example_id": "20dbd18f-59c6-4625-b1b8-3a3e5075c688",
                                "sense_id": "f3a4cae6-8f64-3156-9fcb-347241fe9faf",
                                "text": "Olie- en gasconcern ExxonMobil daagt de activistische beleggingsorganisatie Follow This voor de rechter. ExxonMobil wil niet dat beleggers op de aandeelhoudersvergadering in mei mogen stemmen over een klimaatresolutie van Follow This. Beleggersvereniging VEB veegt de vloer aan met ExxonMobil."
                            },
                            {
                                "example_id": "063eebe0-9d18-44cf-a833-87f974a9c2dd",
                                "sense_id": "f3a4cae6-8f64-3156-9fcb-347241fe9faf",
                                "text": "De bevoegdheden van de aandeelhoudersvergadering werden door de statuten sterk ingeperkt; bovendien werd de stemverdeling niet naar rato van de aandeelhouders, maar van de kapitaalaandelen bepaald."
                            },
                            {
                                "example_id": "ecb32673-b02d-4ec2-9e31-e330a7d519f8",
                                "sense_id": "f3a4cae6-8f64-3156-9fcb-347241fe9faf",
                                "text": "Dan trekt ze haar schouders nog wat verder naar achteren en begint op een toon te praten zoals ze de aandeelhoudersvergaderingen voorzit."
                            }
                        ]
                    }
                ],
