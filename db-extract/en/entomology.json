                    {
                        "translation_id": "89cde0fd-5181-4677-ae16-551585679690",
                        "source_entry_id": "78df7ae6-52d2-3a5d-89f4-eebf2ead56f9",
                        "source_sense_id": "9bb0aa43-2ffc-319f-93c7-6054f77f5d99",
