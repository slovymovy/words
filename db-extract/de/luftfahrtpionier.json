                "senses": [
                    {
                        "sense_id": "fd1780ce-b93e-38da-874c-621f7d97729f",
                        "entry_id": "c78440db-eaec-3eb0-bcfc-e64b1f47cbdc",
                        "glosses": [
                            "Person, die bahnbrechende Leistungen für die Entwicklung der Luftfahrt erbracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfcc87e-d1fb-4e7d-9dbb-b1dc643218e2",
                                "sense_id": "fd1780ce-b93e-38da-874c-621f7d97729f",
                                "text": "„Kein Luftfahrtpionier des vergangenen Jahrhunderts, so urteilen Experten, trug so viel zur Entwicklung von Nurflüglern bei wie die unermüdlich werkelnden Brüder aus Bonn.“"
                            },
                            {
                                "example_id": "d2ebfcb5-2fc6-4360-8af8-319075ccbe6f",
                                "sense_id": "fd1780ce-b93e-38da-874c-621f7d97729f",
                                "text": "„Der Luftfahrtpionier Bertrand Piccard will nur mit Solarenergie rund um die Welt fliegen.“"
                            },
                            {
                                "example_id": "3c787ec0-713d-4c9d-bc7e-2cad5bc9f2f7",
                                "sense_id": "fd1780ce-b93e-38da-874c-621f7d97729f",
                                "text": "„Er ist auch nicht so berühmt wie der Blériot XI, jener Tiefdecker aus Holz, Pergament und Klaviersaiten, mit dem der französische Luftfahrtpionier Louis Blériot 1909 den ersten Flug über den Ärmelkanal geschafft hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
