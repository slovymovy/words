                        "examples": [
                            {
                                "example_id": "36e10c0f-f319-48c8-961f-b05aab893b98",
                                "sense_id": "798d761c-77fa-3361-beac-56adf6ebef53",
                                "text": "Seit frühkirchlicher Zeit wird als Vorbereitung auf den Empfang eines Sakraments Katechese gehalten."
                            },
                            {
                                "example_id": "afcec998-0dc6-4e3a-8fcf-fc00717e7ba5",
                                "sense_id": "798d761c-77fa-3361-beac-56adf6ebef53",
                                "text": "„In entsprechender Weise wurden nun auch einzelne Berichte des Alten und Neuen Testaments in die Katechese einbezogen.“"
                            }
                        ],
