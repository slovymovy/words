{
    "word_family": [
        "intolerance",
        "intolerant",
        "intolerably",
        "tolerable",
        "tolerance",
        "tolerant",
        "tolerate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a142c9a-29df-3d72-978a-30f81bf6036b",
                    "sense_definition": "Too bad, harsh, or painful to be accepted, endured, or tolerated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unbearable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heat in the crowded train quickly became <w>intolerable</w> for the commuters.",
                            "target_lang_translations": {
                                "ru": "Жара в переполненном поезде быстро стала <w>невыносимой</w> для пассажиров."
                            }
                        },
                        {
                            "text": "The sudden delay caused <w>intolerable</w> strain on the delivery schedule.",
                            "target_lang_translations": {
                                "ru": "Внезапная задержка создала <w>невыносимую</w> нагрузку на график поставок."
                            }
                        }
                    ],
                    "synonyms": [
                        "insufferable",
                        "insupportable",
                        "unbearable"
                    ],
                    "antonyms": [
                        "tolerable",
                        "bearable"
                    ],
                    "common_phrases": [
                        "intolerable pain",
                        "intolerable burden",
                        "intolerable conditions",
                        "intolerable strain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слишком тяжёлый, суровый или болезненный, чтобы его можно было терпеть или выдерживать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "о боли, условиях, бремени"
                            },
                            {
                                "target_lang_word": "нестерпимый",
                                "target_lang_sense_clarification": "о сильной физической или душевной боли, жаре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ab5fd47-014c-3add-a585-88f4d4ae5706",
                    "sense_definition": "Extremely offensive, rude, or unacceptable in behavior or speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "offensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>intolerable</w> arrogance made it completely impossible to work with him.",
                            "target_lang_translations": {
                                "ru": "Его <w>несносное</w> высокомерие делало работу с ним совершенно невозможной."
                            }
                        },
                        {
                            "text": "The manager stated that such rude and <w>intolerable</w> insults would lead to immediate dismissal.",
                            "target_lang_translations": {
                                "ru": "Управляющий заявил, что столь грубые и <w>недопустимые</w> оскорбления приведут к немедленному увольнению."
                            }
                        }
                    ],
                    "synonyms": [
                        "insufferable"
                    ],
                    "antonyms": [
                        "acceptable"
                    ],
                    "common_phrases": [
                        "intolerable behavior",
                        "intolerable arrogance",
                        "intolerable insult"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне оскорбительный, грубый или неприемлемый по поведению или речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "о поведении или характере человека"
                            },
                            {
                                "target_lang_word": "несносный",
                                "target_lang_sense_clarification": "раздражающий, вызывающий сильное недовольство"
                            },
                            {
                                "target_lang_word": "недопустимый",
                                "target_lang_sense_clarification": "неприемлемый с точки зрения норм или правил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aba12c8-33e6-30e5-a00d-6ccf434de0c2",
                    "sense_definition": "Degraded, damaged, or worn to such an extent that it is no longer safe to use.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unsafe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inspectors decided to demolish the <w>intolerable</w> structure before it collapsed onto the street.",
                            "target_lang_translations": {
                                "ru": "Инспекторы решили снести это <w>аварийное</w> строение, пока оно не рухнуло на улицу."
                            }
                        },
                        {
                            "text": "The old bridge reached an <w>intolerable</w> state of decay after decades without repair.",
                            "target_lang_translations": {
                                "ru": "Старый мост пришёл в <w>непригодное</w> состояние из-за десятилетий отсутствия ремонта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intolerable state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушенный, повреждённый или изношенный до такой степени, что дальнейшее использование становится небезопасным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аварийный",
                                "target_lang_sense_clarification": "о строении или конструкции, грозящей обрушением"
                            },
                            {
                                "target_lang_word": "непригодный",
                                "target_lang_sense_clarification": "о состоянии здания, непригодном для безопасного использования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}