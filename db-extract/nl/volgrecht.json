                    {
                        "sense_id": "54dd8462-5170-3640-a3ed-6622652140ed",
                        "entry_id": "a7e45fec-695b-3676-a3b5-5bf96d782a8e",
                        "glosses": [
                            "vergoeding aan de maker van een kunstwerk bij doorverkoop van een kunstwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "226e8465-76d5-4a44-afe7-70049e793e48",
                                "sense_id": "54dd8462-5170-3640-a3ed-6622652140ed",
                                "text": "Hij verwees ook naar de Britse situatie waarin musea worden vrijgesteld van het volgrecht, een onderdeel van het auteursrecht."
                            },
                            {
                                "example_id": "fa4734e3-9ed4-4b7c-8959-1cedd8347779",
                                "sense_id": "54dd8462-5170-3640-a3ed-6622652140ed",
                                "text": "Het volgrecht is een uitbreiding van het auteursrecht, dat aan de maker van een kunstwerk een recht op vergoeding geeft bij doorverkoop van het kunstwerk."
                            },
                            {
                                "example_id": "6d477f04-bb8b-4d2c-add3-06e05c0b8e3d",
                                "sense_id": "54dd8462-5170-3640-a3ed-6622652140ed",
                                "text": "Borremans zelf wordt van de verkoop amper iets rijker. Hij profiteert wel van het Europese volgrecht, maar dat is geplafonneerd op 12.500 euro."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd8cae96-fdcd-3cc3-9ff5-bdfec81d058b",
                        "entry_id": "a7e45fec-695b-3676-a3b5-5bf96d782a8e",
                        "glosses": [
                            "recht waarover de titularis van een zakelijk recht beschikt, om het daaraan onderworpen goed te volgen ongeacht in wiens handen het goed overgaat"
                        ],
