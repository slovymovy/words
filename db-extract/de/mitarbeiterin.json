                                        "sense_id": "2b4ed43f-720d-3f4f-86d0-6a55e3cf4ba3",
                                        "entry_id": "9f10f9c5-6ead-3513-b945-8a760d2c8a0c",
                                        "glosses": [
                                            "Helping; lending aid or support; auxiliary."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9f02bb-abd0-4660-9c2e-f96c83026948",
                                                "sense_id": "2b4ed43f-720d-3f4f-86d0-6a55e3cf4ba3",
                                                "text": "Genius and learning […] are mutually and greatly assistant to each other."
                                            },
                                            {
                                                "example_id": "ddf0f04c-1841-4efd-827b-7a722e446c28",
                                                "sense_id": "2b4ed43f-720d-3f4f-86d0-6a55e3cf4ba3",
                                                "text": "The person principally assistant on this occasion, indeed the only one who did any service, or seemed likely to do any, was the landlady […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assistant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45308446-fa69-3285-8ed6-4e4d464158f2",
                                        "entry_id": "7f17e5a2-120c-3720-a163-a0cfd2151e79",
                                        "glosses": [
                                            "Someone who is present; a bystander, a witness."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd8db74a-ff64-4369-8a3b-3458ada7e5d9",
                                                "sense_id": "45308446-fa69-3285-8ed6-4e4d464158f2",
                                                "text": "a woman of great authority, having first yeelded an accompt unto her Citizens, and shewed good reasons why she was resolved to end her life, earnestly entreated Pompey to be an assistant at her death, that so it might be esteemed more honourable[…]."
                                            }
