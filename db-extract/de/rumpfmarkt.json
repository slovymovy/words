                "senses": [
                    {
                        "sense_id": "5ef79701-e4cd-31c3-aee8-347242b068aa",
                        "entry_id": "0926b551-9fb8-3c8d-8f5c-4d48f3da9dfa",
                        "glosses": [
                            "(kleine) Kerngruppe von Kunden (Absatzmarkt), die auch dann erhalten bleibt, wenn ein Produkt wesentliche Marktanteile verliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b62c70d-2989-4bd9-9ae7-6eaa230cddc3",
                                "sense_id": "5ef79701-e4cd-31c3-aee8-347242b068aa",
                                "text": "„Oft bleiben für das Erzeugnis zumindest einige Zeit lang noch Rumpfmärkte bestehen.“"
                            },
                            {
                                "example_id": "f5231cbc-f991-4a65-baa5-2299c0a0ae71",
                                "sense_id": "5ef79701-e4cd-31c3-aee8-347242b068aa",
                                "text": "„Ein Markt wird wie ein Produkt durch eine Innovation geschaffen (Einführungsphase), wächst (Wachstumsphase), reift aus und stagniert (Stagnationsphase) oder schrumpft schließlich (Schrumpfungsphase). Dabei bleibt offen, ob Märkte verschwinden, Rumpfmärkte erhalten bleiben oder Märkte neu belebt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
