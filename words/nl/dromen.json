        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94a812e3-24cf-3135-8eea-d1aee670c771",
                    "sense_definition": "Meervoud van <w>droom</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoop dat al je <w>dromen</w> uitkomen.",
                            "target_lang_translations": {
                                "en": "I hope that all your <w>dreams</w> come true.",
                                "ru": "Я надеюсь, что все твои <w>мечты</w> сбудутся.",
                                "pl": "Mam nadzieję, że wszystkie twoje <w>marzenia</w> się spełnią.",
                                "de": "Ich hoffe, dass all deine <w>Träume</w> in Erfüllung gehen.",
                                "fr": "J'espère que tous tes <w>rêves</w> se réaliseront.",
                                "it": "Spero che tutti i tuoi <w>sogni</w> si avverino.",
                                "cs": "Doufám, že se všechny tvé <w>sny</w> splní.",
                                "tr": "Umarım tüm <w>hayallerin</w> gerçek olur.",
                                "es": "Espero que todos tus <w>sueños</w> se hagan realidad."
                            }
                        },
                        {
                            "text": "In mijn <w>dromen</w> woon ik in een groot kasteel.",
                            "target_lang_translations": {
                                "en": "In my <w>dreams</w> I live in a big castle.",
                                "ru": "В своих <w>мечтах</w> я живу в большом замке.",
                                "pl": "W moich <w>snach</w> mieszkam w wielkim zamku.",
                                "de": "In meinen <w>Träumen</w> wohne ich in einem großen Schloss.",
                                "fr": "Dans mes <w>rêves</w>, j'habite dans un grand château.",
                                "it": "Nei miei <w>sogni</w> vivo in un grande castello.",
                                "cs": "Ve svých <w>snech</w> žiji ve velkém hradě.",
                                "tr": "<w>Hayallerimde</w> büyük bir şatoda yaşıyorum.",
                                "es": "En mis <w>sueños</w> vivo en un gran castillo."
                            }
                        }
                    ],
