                        "form": "глазу́ньях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3559e07b-6998-3aa1-8f65-926b101d20cb",
                        "entry_id": "dca86661-d470-34e1-ab0a-3129f4ec2a56",
                        "glosses": [
                            "яичница, при приготовлении которой желтки не размешиваются и остаются в виде жёлтых глаз на белом фоне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ed4c96-cbbf-4d60-8c8b-6877f3f543d2",
                                "sense_id": "3559e07b-6998-3aa1-8f65-926b101d20cb",
                                "text": "— А вот и глазунья, самая моя любимая яичница."
                            },
                            {
                                "example_id": "95aeee54-dca0-4da3-9f51-765aa6c941f9",
                                "sense_id": "3559e07b-6998-3aa1-8f65-926b101d20cb",
                                "text": "Там на большом белом липовом столе, накрытом простою, но ослепительной белизны скатертью, в изобилии подавались: .. яичницы разные, молочные, глазунья и прочее .."
                            },
                            {
                                "example_id": "b2f5ba9d-e4e2-45f8-981e-c8f70d53cab9",
                                "sense_id": "3559e07b-6998-3aa1-8f65-926b101d20cb",
                                "text": "А из землянки старшины и в самом деле тянет глазуньей. — Глазунья хороша с луком, — говорит Сашка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03222a04-14fc-4761-aef0-e85813d80ee9",
                        "source_entry_id": "dca86661-d470-34e1-ab0a-3129f4ec2a56",
                        "source_sense_id": "3559e07b-6998-3aa1-8f65-926b101d20cb",
                        "target_lang_word": "sunny side up egg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "82426476-ff83-4c58-9456-5ae3958b5b22",
                        "source_entry_id": "dca86661-d470-34e1-ab0a-3129f4ec2a56",
                        "source_sense_id": "3559e07b-6998-3aa1-8f65-926b101d20cb",
                        "target_lang_word": "Spiegelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spiegelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6b9039a-b623-3907-83a1-83a606043f99",
                                        "entry_id": "4ed6c353-1428-34b6-8de4-48a73374bade",
                                        "glosses": [
                                            "ein aufgeschlagenes, (meist in der Pfanne) gebratenes Ei, bei dem der Eidotter ganz in seiner Form erhalten bleibt"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab4a50c2-7559-4f89-ba37-59455b868025",
                                                "sense_id": "a6b9039a-b623-3907-83a1-83a606043f99",
                                                "text": "„Spiegeleier - Eines der populärsten Eierrezepte, aber fast immer werden Spiegeleier zu scharf gebraten.“"
                                            },
                                            {
                                                "example_id": "c3e6f7a1-399f-427e-9cd8-dcec7e955e39",
                                                "sense_id": "a6b9039a-b623-3907-83a1-83a606043f99",
                                                "text": "„Vom Spiegelei sparte ich mir das Dotter immer bis zuletzt auf.“"
                                            },
                                            {
                                                "example_id": "6eb82d77-1910-43ca-9cdb-77b6f2464cac",
                                                "sense_id": "a6b9039a-b623-3907-83a1-83a606043f99",
                                                "text": "„Man kriegt also nicht mal ein Spiegelei, wenn man im Bundesrat hungrig wird.“"
                                            },
                                            {
                                                "example_id": "79604dad-22e3-4b72-8d2d-d9aec68fa1b6",
                                                "sense_id": "a6b9039a-b623-3907-83a1-83a606043f99",
                                                "text": "„Ich bestellte mir Kaffee und Spiegeleier und begann langsam zu essen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
