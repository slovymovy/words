                                        "glosses": [
                                            "Bacille pathogène, commensal ou saprophyte, ubiquitaire. → voir Streptococcus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afe19ad0-a2fe-452d-9771-827c5e9c0b87",
                                                "sense_id": "4ca58768-8216-38af-9b4b-9b575f5595c2",
                                                "text": "Breese, en 1969, montre l'absence de portage de streptocoque A chez 100 enfants traités par la lincomycine, alors que 12/102 enfants traités par pénicilline en sont porteurs."
                                            },
                                            {
                                                "example_id": "f4b280dd-e503-49aa-a03f-beaf90f9a866",
                                                "sense_id": "4ca58768-8216-38af-9b4b-9b575f5595c2",
                                                "text": "Le streptocoque B est un cocci Gram positif aéro-anaérobie, souvent retrouvé au niveau de l'intestin, du vagin, du rhino-pharynx et des glandes mammaires."
                                            }
                                        ]
                                    }
                                ]
                            }
