        "nl-extract.jsonl": [
            {
                "entry_id": "374e4cae-db0a-3097-bbad-df751427a4f7",
                "word": "berekenend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e83a376-7c24-3a59-acdd-2b1d8ebaa012",
                        "entry_id": "374e4cae-db0a-3097-bbad-df751427a4f7",
                        "glosses": [
                            "zorgvuldig en goed nadenkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a52b259-6300-4955-b51f-6e5e9c1532f4",
                                "sense_id": "4e83a376-7c24-3a59-acdd-2b1d8ebaa012",
                                "text": "Een kramp in zijn linker hamstring, iedere keer dat hij wilde versnellen, maakte dat Nageeye vanaf 32 kilometer ‘berekenend’ had moeten lopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6e130a7-6d45-362a-a5ac-28b5a0a171ec",
                        "entry_id": "374e4cae-db0a-3097-bbad-df751427a4f7",
                        "glosses": [
                            "alleen maar denkend aan het eigenbelang"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8e47b068-7814-4dd1-bd61-119d665a6517",
                                "sense_id": "f6e130a7-6d45-362a-a5ac-28b5a0a171ec",
                                "text": "Het Openbaar Ministerie rekent het hem zwaar aan dat hij na de overval kleding en schoenen wisselde en alsnog drugs ging kopen. „Dat komt berekenend over”, zei de aanklaagster. Ze eiste een gevangenisstraf van 30 maanden waarvan tien voorwaardelijk en H. dient zich aan tal van voorwaarden te houden."
                            },
                            {
                                "example_id": "0815526d-d517-46c1-a2f2-23760cff94ee",
                                "sense_id": "f6e130a7-6d45-362a-a5ac-28b5a0a171ec",
                                "text": "S. deed dat onder meer met een camera die hij op de wc tussen de toiletrollen had verstopt. De slachtoffertjes waren 4 tot 10 jaar oud. De man, die volgens deskundigen een pedofiele en urofiele stoornis heeft, liet de meisjes gehurkt op de toiletbril plassen terwijl hij intussen stiekem opnames maakte. De rechtbank noemde dat ‘berekenend’."
                            },
                            {
                                "example_id": "0758cf40-1e4f-4487-8630-f864d9c159bc",
                                "sense_id": "f6e130a7-6d45-362a-a5ac-28b5a0a171ec",
                                "text": "Het was de kunst om koel en berekenend te werk te gaan, wisten ze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9673a0b5-996e-4294-88b9-f15d1b69f51d",
                        "source_entry_id": "374e4cae-db0a-3097-bbad-df751427a4f7",
                        "source_sense_id": "4e83a376-7c24-3a59-acdd-2b1d8ebaa012",
                        "source_sense_description": "alleen maar denkend aan het eigenbelang",
                        "target_lang_word": "shrewd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrewd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34b8c1b6-9308-3f0d-8e4f-52766ddd3d2a",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Showing clever resourcefulness in practical matters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec2c7299-5102-33d6-8c1d-fe37eb82a52f",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Artful, tricky or cunning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91f226ed-9926-3576-85d1-39a464b5a1a5",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "streetwise, street-smart."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62722619-93fa-4ad4-82d4-650fc8be7ed2",
                                                "sense_id": "91f226ed-9926-3576-85d1-39a464b5a1a5",
                                                "text": "Willie is very aware of this fact and lets Johnny Attell know that there is a fly in the ointment, and Johnny, who is a very shrewd article, has his chauffeur drive him to Bradford Street so he can change the kid's mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc2b550d-6183-3c99-8469-8237f3b1b506",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Knowledgeable, intelligent, keen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef1ccc6-00f2-43d5-b5e2-67a924c43331",
                                                "sense_id": "dc2b550d-6183-3c99-8469-8237f3b1b506",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3297b54c-a15c-3d6a-ad34-621086510786",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Nigh accurate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f592d059-460a-4f0e-a588-2f5771265cbc",
                                                "sense_id": "3297b54c-a15c-3d6a-ad34-621086510786",
                                                "text": "a shrewd guess"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1b5482-8623-3e5d-bb7a-82691935b28a",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Severe, intense, hard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8500f254-e3f8-4bdb-abdb-80b4ae1b0e6f",
                                                "sense_id": "0f1b5482-8623-3e5d-bb7a-82691935b28a",
                                                "text": "a shrewd blow, or assault"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10ec6d2-6812-361a-b91f-1c85c41a3f43",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Sharp, snithy, piercing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1c8242-c582-4ee0-92e9-67251c73359e",
                                                "sense_id": "e10ec6d2-6812-361a-b91f-1c85c41a3f43",
                                                "text": "a shrewd wind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3bd106f-6bcd-3be3-bf41-c44cf96cc075",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Bad, evil, threatening."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf3d645-4698-4f55-aff0-cc391d727afb",
                                                "sense_id": "b3bd106f-6bcd-3be3-bf41-c44cf96cc075",
                                                "text": "Portia:\nThere are some shrewd contents in yon same paper,\nThat steals the colours from Bassanio's cheek:\nSome dear friend dead; else nothing in the world\nCould turn so much the constitution\nOf any constant man. What, worse and worse!— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f058d742-99e4-3f6c-a287-2d3ebd26b722",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Portending, boding."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dd62696-494f-3884-8e7a-beca501fbd81",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Noxious, scatheful, mischievous."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d832d4a-1cc6-4fa3-b00a-8256aef54478",
                                                "sense_id": "3dd62696-494f-3884-8e7a-beca501fbd81",
                                                "text": "They were wont to please the Fairies, that they might doe them no shrewd turnes, by sweeping clean the Hearth and setting by it […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4a37a1-8004-3d9d-a941-4fb1ca18ee01",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Abusive, shrewish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "345cb796-7a4b-34a3-a71a-2a9f3e941069",
                                        "entry_id": "825a2da5-2e14-33b3-b0eb-e612e2255cef",
                                        "glosses": [
                                            "Scolding, satirical, sharp."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c83ab800-f155-4ed2-9449-ce88a64d49c7",
                                                "sense_id": "345cb796-7a4b-34a3-a71a-2a9f3e941069",
                                                "text": "Leonato: By my troth, niece, thou wilt never get thee a husband, if thou be so shrewd of thy tongue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
