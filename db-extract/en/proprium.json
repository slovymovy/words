                        "glosses": [
                            "A property that applies to all members of a species and only to them, serving to distinguish the species from other species within the same genus, yet is not part of the true definition or the essence of the species."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce00cf56-326f-491f-8b84-8f028ea66429",
                                "sense_id": "6ddb1b00-2b74-33af-ab35-0560288419e0",
                                "text": "(So you can use a proprium to pick out a species—for example, you could say: “a human is a risible mortal animal”—but, in that case, you aren’t picking out the species by its true definition.)"
                            }
                        ]
                    }
