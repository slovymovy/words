                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b346b360-bee0-48cf-a30e-e35d23416967",
                        "entry_id": "c59d9043-1049-3e4e-b803-b0df9104da68",
                        "tags": [
                            "plural"
                        ],
                        "form": "ostrogs"
