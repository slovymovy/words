                        "sense_id": "723370e6-ac02-3ba9-8a2d-39e8238976f5",
                        "entry_id": "c819a3cf-66fb-35b3-bc46-c90f32f00334",
                        "glosses": [
                            "weibliche Person, die eine Kreditkarte besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6714eaaa-b950-4256-976a-22a813915454",
                                "sense_id": "723370e6-ac02-3ba9-8a2d-39e8238976f5",
                                "text": "„\"Wir leben hier in der Lunge der Welt\", sagt Kreditkartenbesitzerin Alves da Costa, umschwirrt von bunten Vögeln und Schmetterlingen, die feuchte Hitze treibt den Schweiß wie im Gewächshaus.“"
                            },
                            {
                                "example_id": "283b3fa9-377d-4bbd-aced-8e9a0c2a4cd0",
                                "sense_id": "723370e6-ac02-3ba9-8a2d-39e8238976f5",
                                "text": "„Ein Kaufhausdetektiv vermutete eine betrügerische Verwendung der Karten und informierte die Polizei, die den Täter festnahm. Übrigens: Die Kreditkartenbesitzerin hatte bis zu diesem Zeitpunkt den Diebstahl ihres Eigentums noch gar nicht bemerkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
