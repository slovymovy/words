                    "sense_definition": "En nul temps, à aucun moment, généralement employé avec la négation « ne ».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation_temporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne bois <w>jamais</w> de café le soir pour pouvoir bien dormir.",
                            "target_lang_translations": {
                                "en": "I <w>never</w> drink coffee in the evening so that I can sleep well.",
                                "ru": "Я <w>никогда</w> не пью кофе по вечерам, чтобы хорошо спать.",
                                "nl": "Ik drink 's avonds <w>nooit</w> koffie, zodat ik goed kan slapen.",
                                "de": "Ich trinke abends <w>nie</w> Kaffee, damit ich gut schlafen kann.",
                                "pl": "Wieczorami <w>nigdy</w> nie piję kawy, żeby dobrze spać.",
                                "it": "La sera non bevo <w>mai</w> caffè per riuscire a dormire bene.",
                                "cs": "Večer kávu <w>nikdy</w> nepiju, abych mohl dobře spát.",
                                "tr": "Gece iyi uyuyabilmek için akşamları <w>asla</w> kahve içmem.",
                                "es": "No bebo <w>nunca</w> café por la noche para poder dormir bien.",
                                "zh": "我晚上<w>从不</w>喝咖啡，这样才能睡个好觉。"
                            }
                        },
                        {
                            "text": "Il n'est <w>jamais</w> venu visiter notre nouvelle maison à la campagne.",
                            "target_lang_translations": {
                                "en": "He has <w>never</w> come to visit our new house in the countryside.",
                                "ru": "Он <w>ни разу</w> не приезжал посмотреть наш новый дом за городом.",
                                "nl": "Hij is <w>nooit</w> langsgekomen om ons nieuwe huis op het platteland te bekijken.",
                                "de": "Er ist noch <w>nie</w> gekommen, um unser neues Haus auf dem Land zu besichtigen.",
                                "pl": "<w>Nigdy</w> nie przyjechał w odwiedziny do naszego nowego domu na wsi.",
                                "it": "Non è <w>mai</w> venuto a visitare la nostra nuova casa in campagna.",
                                "cs": "Ještě <w>nikdy</w> nepřijel prohlédnout náš nový dům na venkově.",
                                "tr": "Kırdaki yeni evimizi görmeye <w>hiçbir zaman</w> gelmedi.",
                                "es": "<w>Nunca</w> ha venido a visitar nuestra nueva casa en el campo.",
                                "zh": "他<w>从未</w>来乡下参观过我们的新房子。"
                            }
                        }
                    ],
                    "antonyms": [
                        "toujours"
