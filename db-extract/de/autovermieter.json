                        "examples": [
                            {
                                "example_id": "8ba8c0aa-1f07-4142-8c25-68b73bec1be7",
                                "sense_id": "88397662-b6eb-3beb-a475-ecaf80a8792a",
                                "text": "„Die wichtigsten Autovermieter haben in der Ankunftshalle einen Schalter.“"
                            },
                            {
                                "example_id": "7e75ebec-b2f5-44a9-8f9a-5111ae048dea",
                                "sense_id": "88397662-b6eb-3beb-a475-ecaf80a8792a",
                                "text": "„Hören Sie auf die Warnungen des Autovermieters, fahren Sie nicht mit einem Toyota Yaris die Kieswege entlang.“"
                            },
                            {
                                "example_id": "6d884883-4a86-48ee-8f09-bbf8f891171c",
                                "sense_id": "88397662-b6eb-3beb-a475-ecaf80a8792a",
                                "text": "„Drei Privatpersonen und der Autovermieter Sixt klagen gegen den Monatsbeitrag von 17,50 Euro, der seit 2013 pro Wohnung erhoben wird, egal, ob dort ein Fernseher steht oder nicht.“"
                            }
                        ],
