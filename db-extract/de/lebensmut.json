                "senses": [
                    {
                        "sense_id": "35e2a83d-9dec-3324-96dc-5ced893f8b43",
                        "entry_id": "aa6638bd-688a-304c-b4a8-6da4f9d998ea",
                        "glosses": [
                            "Hoffnung/Zuversicht, das eigene Leben bewältigen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1875a46-cf6b-4464-a2d3-4aa5c9f72801",
                                "sense_id": "35e2a83d-9dec-3324-96dc-5ced893f8b43",
                                "text": "„Sie ist untröstlich, und auch Sofia weiß nicht, wie sie ihrem Schützling wieder Lebensmut geben soll.“"
                            },
                            {
                                "example_id": "a03a8538-0025-4560-a7d7-554670d57010",
                                "sense_id": "35e2a83d-9dec-3324-96dc-5ced893f8b43",
                                "text": "„Mein Lebensmut wächst von Tag zu Tag.“"
                            },
                            {
                                "example_id": "e506de03-ac78-4870-8799-affe29bc9fb8",
                                "sense_id": "35e2a83d-9dec-3324-96dc-5ced893f8b43",
                                "text": "„Der dritte war den beiden Beschriebenen total unähnlich, und was jene an Wildheit und Lebensmut zuviel besaßen, schien dieser durch Sanftmut und Leutseligkeit wieder ausgleichen zu wollen.“"
                            },
                            {
                                "example_id": "5512f034-7a7a-4ab8-8f94-37698bfa52fc",
                                "sense_id": "35e2a83d-9dec-3324-96dc-5ced893f8b43",
                                "text": "„Tochter Heilwig ist mit vier Kindern überlastet, Schwiegersohn Ernst Schulte Strathaus, mittlerweile über siebzig Jahre alt, nach Gefängnis, Krieg und Entnazifizierung Gelegenheitsarbeiter ohne Lebensmut und der tüchtigen Ina ein Dorn im Auge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
