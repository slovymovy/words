                "translations": [
                    {
                        "translation_id": "774bdb9d-2b46-471e-8fff-ce084ad54c62",
                        "source_entry_id": "86ca7c66-1de1-3caf-99c8-53b8159ff2c2",
                        "source_sense_id": "69ad164a-c5b8-3e47-a70e-3ec737c473f4",
                        "source_sense_description": "Hausdurchsuchung",
                        "target_lang_word": "Hausdurchsuchung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausdurchsuchung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                        "entry_id": "1d3acfad-975c-3601-9850-e9601928d034",
                                        "glosses": [
                                            "amtlich angeordnete, polizeiliche Durchsuchung eines Gebäudes, einer Wohnung oder von Geschäftsräumen zur Sicherstellung von Gegenständen (zum Beispiel Beweismitteln) oder Auffinden von Tatverdächtigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa6ae33-a77e-4c29-9310-9ca9c008a453",
                                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                                "text": "Bei deiner Hausdurchsuchung wurde ein halbes Kilo Kokain sichergestellt."
                                            },
                                            {
                                                "example_id": "c11fc042-93e4-4fde-b396-d526ffb018b3",
                                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                                "text": "„Beide haben nach Hausdurchsuchungen in Klausen mit ihren Knechten, wie zwischen König Ferdinand dem Landesfürsten und Bischof Georg von Brixen vereinbart, noch das landesfürstliche Gufidaun durchsucht, sind dort in das Mesnerhaus eingedrungen und haben die drei festgenommen.“"
                                            },
                                            {
                                                "example_id": "5b48a625-f7b2-4453-b684-04447ae39036",
                                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                                "text": "„Nicht nur sorgte sie sich um das Leben ihres steckbrieflich gesuchten Mannes, sondern sie musste auch eine Hausdurchsuchung der Polizei über sich ergehen lassen.“"
                                            },
                                            {
                                                "example_id": "4ba56c3a-4c85-4a22-b9ab-bfe992e15aca",
                                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                                "text": "„Bei der Hausdurchsuchung fand ich nichts weiter als die erwartete Anzahl von Emailschüsseln, Nähmaschinen, antiseptischen Mitteln und einen Haufen zwei Jahre alter Berliner Modejournale.“"
                                            },
                                            {
                                                "example_id": "3a8ca529-0aad-455c-8451-d50b04acc4fa",
                                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                                "text": "„Es gab Hausdurchsuchungen und Anklagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
