                "senses": [
                    {
                        "sense_id": "119f4fa4-b7a7-34f2-a535-17345f23f939",
                        "entry_id": "3b0f63d6-e503-3bc0-a684-57ed27de3333",
                        "glosses": [
                            "vergleichsweise schwerer Edelstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad63e0bb-8479-4152-852a-5dd0913bb4f3",
                                "sense_id": "119f4fa4-b7a7-34f2-a535-17345f23f939",
                                "text": "„Sie galten als Tränen der Götter, als Sternensplitter, die vom Himmel fielen, oder als Zeichen für Unvergänglichkeit – seit Jahrtausenden ziehen Diamanten die Menschen in ihren Bann. Und auch heute noch gelten die Hochkaräter aus dem Inneren der Erde als kostbarste aller Edelsteine.“"
                            },
                            {
                                "example_id": "788a2104-c185-4e97-9bb0-772d8f571cd5",
                                "sense_id": "119f4fa4-b7a7-34f2-a535-17345f23f939",
                                "text": "„Den Hochkaräter hatte ein Angolaner im Gepäck, der aus Namibia nach Frankfurt geflogen war.“"
                            },
                            {
                                "example_id": "28b9e135-c624-40eb-b927-15c3565b27b1",
                                "sense_id": "119f4fa4-b7a7-34f2-a535-17345f23f939",
                                "text": "„Erfolglos verlief hingegen der Auktionsversuch für zwei andere Hochkaräter: Für einen gelben Diamant von 70,19 Karat wurden am Dienstag 2,8 Millionen Schweizer Franken geboten und damit weniger als der Mindestpreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6fbbd219-4a30-32d7-b100-12b126c43147",
                        "entry_id": "3b0f63d6-e503-3bc0-a684-57ed27de3333",
                        "glosses": [
                            "jemand oder etwas Bedeutsames, Gewichtiges"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a3b7fff4-e789-4176-a1ae-b55380c51138",
                                "sense_id": "6fbbd219-4a30-32d7-b100-12b126c43147",
                                "text": "„Die Gäste hatten schon in der dritten Minute durch Dominic Wagner einen Hochkaräter, aber er traf den Ball.“"
                            },
                            {
                                "example_id": "0bdb47b9-c781-4f1d-bdb6-7b34eaf80989",
                                "sense_id": "6fbbd219-4a30-32d7-b100-12b126c43147",
                                "text": "„An einem nasskalten Abend im Spätnovember war das Drittrunden-Hinspiel bei Feyenoord auch so etwas wie eine Nagelprobe für den Freiburger Fußball: Kann man sich gegen einen Hochkaräter behaupten, der gerade erst in der Champions League gespielt hat und dessen Ansprüche sich an einem 120-Millionen-Mark-Budget messen?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
