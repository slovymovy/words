                                    {
                                        "sense_id": "8cda4cf1-416d-3ef4-8ce8-63c7c1b39a54",
                                        "entry_id": "ddee74b9-9eca-3ed4-850a-e514fda2e61d",
                                        "glosses": [
                                            "Causing motion; having power to move, or tending to move"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea4f9225-440f-4d9f-932d-87804179cdeb",
                                                "sense_id": "8cda4cf1-416d-3ef4-8ce8-63c7c1b39a54",
                                                "text": "a motive argument"
                                            },
                                            {
                                                "example_id": "98cc7e77-c048-4672-944f-def7ddcb9ed0",
                                                "sense_id": "8cda4cf1-416d-3ef4-8ce8-63c7c1b39a54",
                                                "text": "motive power"
                                            },
                                            {
                                                "example_id": "d2951aac-7636-4c3d-a69f-1d523b51a728",
                                                "sense_id": "8cda4cf1-416d-3ef4-8ce8-63c7c1b39a54",
                                                "text": "In the motive parts of animals may be discovered mutuall proportions; not only in those of Quadrupeds, but in the thigh-bone, legge, foot-bone, and claws of Birds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9427e1e7-8b42-3e91-977f-df86235b985a",
                                        "entry_id": "ddee74b9-9eca-3ed4-850a-e514fda2e61d",
                                        "glosses": [
                                            "Relating to motion and/or to its cause"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e13cdfe-e869-4556-ba24-42563031732c",
                                                "sense_id": "9427e1e7-8b42-3e91-977f-df86235b985a",
                                                "text": "Debussy's melody is fractional, fragmentary. But at the core all his music is melodic and melody is its main motive force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
