                                            {
                                                "example_id": "d4730399-9bf7-48cb-81bb-df99d31d0c8e",
                                                "sense_id": "a4b7240e-09f5-37a3-b498-542b9528a90f",
                                                "text": "Koning Willem-Alexander heeft vrijdagmiddag een grote expositie over Jheronimus Bosch geopend in het Noordbrabants Museum in Den Bosch. Na een bijeenkomst in de Sint-Janskathedraal en een wandeling door de Brabantse stad schoof de koning een ‘hooibaal’ in een stellage."
                                            },
                                            {
                                                "example_id": "05f625ec-5c78-445c-ad1e-b615e23eba2c",
                                                "sense_id": "a4b7240e-09f5-37a3-b498-542b9528a90f",
                                                "text": "Het hoofd van de koninklijke Abraham is gemaakt van een roze hooibaal waarmee de bouwers aandacht willen vragen voor Pink Ribbon, de stichting die zich inzet voor de strijd tegen borstkanker."
                                            }
