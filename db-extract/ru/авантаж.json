                ],
                "senses": [
                    {
                        "sense_id": "dfc6bc62-7b81-386a-ad74-4a5d1ff318b9",
                        "entry_id": "8d385fd9-109d-3f52-b5aa-27d902dadc1b",
                        "glosses": [
                            "устар. выгода; преимущество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10b77dfb-c944-45f7-b3f4-a5fd3c18c70d",
                                "sense_id": "dfc6bc62-7b81-386a-ad74-4a5d1ff318b9",
                                "text": "Марья Николаевна в тот день принарядилась очень к своему «авантажу», как говаривали наши бабушки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67e34c4c-be53-4780-952d-084b50602dd7",
                        "source_entry_id": "8d385fd9-109d-3f52-b5aa-27d902dadc1b",
                        "source_sense_id": "dfc6bc62-7b81-386a-ad74-4a5d1ff318b9",
                        "target_lang_word": "advantage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Any condition, circumstance, opportunity or means, particularly favorable or chance to success, or to any desired end."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6117e9d-473d-46d2-ac55-79f9785dc9ef",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "The enemy had the advantage of a more elevated position."
                                            },
                                            {
                                                "example_id": "a4b0660a-86b5-4ebb-9e3f-2b9a520bc6b3",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "Give me advantage of some brief discourse."
                                            },
                                            {
                                                "example_id": "843dc575-c0fd-497f-9e42-3b81883a15fd",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "the advantages of a close alliance"
                                            },
                                            {
                                                "example_id": "d82fa7c1-24fa-4868-87db-5868daa8d6d4",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07b974a-d714-30d4-9abf-409d70f7c15b",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Superiority; mastery; — used with of to specify its nature or with over to specify the other party."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d0e1b0-3247-4ddc-a184-241fa201abb3",
                                                "sense_id": "a07b974a-d714-30d4-9abf-409d70f7c15b",
                                                "text": "Lest Satan should get an advantage of us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2175d6a8-9b0c-3bde-b127-ddc27198d58d",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Superiority of state, or that which gives it; benefit; gain; profit"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977d2df2-9d31-4c4d-b343-970cd1e2e063",
                                                "sense_id": "2175d6a8-9b0c-3bde-b127-ddc27198d58d",
                                                "text": "the advantage of a good constitution"
                                            },
                                            {
                                                "example_id": "4363f239-135e-4a06-8be9-1ea0289c3657",
                                                "sense_id": "2175d6a8-9b0c-3bde-b127-ddc27198d58d",
                                                "text": "Having the faster car is of little advantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08356c00-8691-3d3f-b75f-dcaf97f42d8f",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "The score where one player wins a point after deuce but needs the next to carry the game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73f70fdb-daef-3f26-b32c-9082c0497f73",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "The continuation of the game after a foul against the attacking team, because the attacking team are in an advantageous position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26559267-9297-4b60-9d7e-307b259fbc71",
                                                "sense_id": "73f70fdb-daef-3f26-b32c-9082c0497f73",
                                                "text": "Webb played an advantage that enabled Cazorla to supply a low cross from the left for Giroud to sweep home first time, despite Gallas and Vertonghen being in close attendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a40c87d-3e4e-35e0-a4d6-2fd8683b5320",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Interest of money; increase; overplus (as the thirteenth in the baker's dozen)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94664b2b-a3f1-4730-926b-61054d0b88e7",
                                                "sense_id": "3a40c87d-3e4e-35e0-a4d6-2fd8683b5320",
                                                "text": "And with advantage means to pay thy love."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3202a13c-f008-325d-9313-19251273639f",
                                        "entry_id": "14e542fd-66f2-33b1-bbf1-7ce99c568793",
                                        "glosses": [
                                            "to provide (someone) with an advantage, to give an edge to"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853c848d-e79f-485b-b91d-0ff0c3e2ffbc",
                                                "sense_id": "3202a13c-f008-325d-9313-19251273639f",
                                                "text": "I had almoſt forgotten to acquaint your honor, that one major Alford (who was in mr. Love's conſpiracy) was of the graund inqueſt at Saliſbury, and was very zealous in his highneſſe ſervice here, and his good affection and wiſe carriage here, did much advantage the buſſineſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f64b8d-6ec5-3229-bf6e-c4264356938e",
                                        "entry_id": "14e542fd-66f2-33b1-bbf1-7ce99c568793",
                                        "glosses": [
                                            "to do something for one's own benefit; to take advantage of"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857f1246-01ef-4c2c-85bb-d8f6cdb6d2df",
                                                "sense_id": "13f64b8d-6ec5-3229-bf6e-c4264356938e",
                                                "text": "No man of courage vouchsafeth to advantage himselfe [translating s'avantager] of that which is common unto many."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb7b1d77-344c-43d5-8fb6-35b5189fb691",
                        "source_entry_id": "8d385fd9-109d-3f52-b5aa-27d902dadc1b",
                        "source_sense_id": "dfc6bc62-7b81-386a-ad74-4a5d1ff318b9",
                        "target_lang_word": "avantage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avantage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5726ad58-51e1-3617-9590-2c23098cfea3",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Utilité ; profit ; faveur ; bénéfice. Conséquence positive que l'on peut subir d'un acte ou d'une situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce7818a-a8b5-4f66-b900-face91b4d447",
                                                "sense_id": "5726ad58-51e1-3617-9590-2c23098cfea3",
                                                "text": "En ce cas, la fille a sur le frère puiné un avantage qui consiste en ce qu’elle a la propriété de sa part, si elle se marie, tandis que le frère puîné n’a que l’usufruit de la sienne. (Art. 268 et 346)."
                                            },
                                            {
                                                "example_id": "2c9c21a6-a769-4ffb-976a-629db6c4f725",
                                                "sense_id": "5726ad58-51e1-3617-9590-2c23098cfea3",
                                                "text": "L’emploi de moulures a le grand avantage de permettre la suppression absolue des clous cavaliers ordinairement employés pour fixer les fils."
                                            },
                                            {
                                                "example_id": "ee64cf9d-4e60-49c2-a004-9028e3c03ac4",
                                                "sense_id": "5726ad58-51e1-3617-9590-2c23098cfea3",
                                                "text": "Un « muchacho » d’une dizaine d’années, […], essaya de me démontrer les inconvénients de voyager seul, les avantages incalculables de la vie à deux."
                                            },
                                            {
                                                "example_id": "1e55069d-e8ab-4ef4-b01d-7d2e591150b7",
                                                "sense_id": "5726ad58-51e1-3617-9590-2c23098cfea3",
                                                "text": "Les sulfatages précoces que beaucoup hésitaient à faire avaient pourtant l’avantage d’atteindre tous les organes de la vigne, notamment les mannes, c’est-à-dire les futurs raisins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da6a1154-65ef-3667-8d86-9bfc47169a3f",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Supériorité ; dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f712854-2fc6-4edc-96fc-b192db91cee0",
                                                "sense_id": "da6a1154-65ef-3667-8d86-9bfc47169a3f",
                                                "text": "Les lentilles simples anastigmatiques qui forment les éléments des anastigmats symétriques offrent le grand avantage de pouvoir s’associer pour constituer des objectifs à foyers multiples : […]."
                                            },
                                            {
                                                "example_id": "4095a9f5-9b08-4967-b91b-a92525cbe559",
                                                "sense_id": "da6a1154-65ef-3667-8d86-9bfc47169a3f",
                                                "text": "Les hommes continuent, en sont encore à comparer les avantages du pneu à clous et les inconvénients des chaînes pour les vacances de ski de l’hiver prochain…"
                                            },
                                            {
                                                "example_id": "0ebe6f5c-cd58-45d5-b5f7-3c50f7137e7b",
                                                "sense_id": "da6a1154-65ef-3667-8d86-9bfc47169a3f",
                                                "text": "Non, non, la constance n’est bonne que pour des ridicules ; toutes les belles ont droit de nous charmer, et l’avantage d’être rencontrée la première ne doit pas dérober aux autres les justes prétentions qu’elles ont toutes sur nos cœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91cbb459-ae78-3b15-9c9d-e343d5400dca",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Succès militaire, victoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a55949-ed99-43ee-b533-e68ef904f9a3",
                                                "sense_id": "91cbb459-ae78-3b15-9c9d-e343d5400dca",
                                                "text": "Nos troupes remportèrent de grands avantages."
                                            },
                                            {
                                                "example_id": "0b8a8d76-3bc6-4e05-93b9-a93c83a583de",
                                                "sense_id": "91cbb459-ae78-3b15-9c9d-e343d5400dca",
                                                "text": "Notre armée ne sut pas profiter de l’avantage qu’elle avait obtenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec6d51b-6c07-3141-b863-45daf485c942",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Gain, point que marque un joueur après avoir été, auparavant, à égalité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b447510-66d2-451a-a4cb-f22725bbe3e4",
                                                "sense_id": "7ec6d51b-6c07-3141-b863-45daf485c942",
                                                "text": "L’avantage du jeu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da34b924-459c-38a0-937f-b6de5d0272c7",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Gain, point que marque un joueur après avoir été, auparavant, à égalité.",
                                            "Score en faveur d'un des deux adversaires, immédiatement supérieur à 40 partout."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "454e37d3-870f-46f2-bc8e-be4828d51f54",
                                                "sense_id": "da34b924-459c-38a0-937f-b6de5d0272c7",
                                                "text": "Avantage service, avantage relance, ou avantage + « nom du joueur »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc06e3e-537b-3db2-8d5c-b233028c7851",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Handicap que donne le plus habile à celui qui l’est moins pour rendre la partie à peu près égale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a673f2c-12f8-4629-8526-184a6222dda4",
                                                "sense_id": "1bc06e3e-537b-3db2-8d5c-b233028c7851",
                                                "text": "Je ne jouerai point avec lui s’il ne me donne de l’avantage."
                                            },
                                            {
                                                "example_id": "0e60e5ad-5802-4611-983f-ac7b6d2191cc",
                                                "sense_id": "1bc06e3e-537b-3db2-8d5c-b233028c7851",
                                                "text": "Quel avantage vous donne-t-il, vous fait-il ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41194ded-a6c8-3429-97fa-fe0ee6248891",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c93420-6d02-4462-8073-708cad1ab09f",
                                                "sense_id": "41194ded-a6c8-3429-97fa-fe0ee6248891",
                                                "text": "Avoir l’avantage au vent, prendre l’avantage du vent : avoir, prendre le dessus du vent, relativement à un autre vaisseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6915bc5c-ae1b-32c2-a4de-c1ec4f02d17c",
                                        "entry_id": "ee3e95c8-f8a4-3da2-b975-63cc16862412",
                                        "glosses": [
                                            "Libéralité qui marque la prédilection pour celui à qui elle est faite. Ce que l’on donne à quelqu’un au-delà de ce qu’il pouvait exiger ou attendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dee3208-30d9-4cc9-b7cb-5e3e1f9b3198",
                                                "sense_id": "6915bc5c-ae1b-32c2-a4de-c1ec4f02d17c",
                                                "text": "Faire des avantages à l’un de ses enfants, de ses héritiers présomptifs."
                                            },
                                            {
                                                "example_id": "969905ff-ca5b-4128-9b75-ab0388266cf2",
                                                "sense_id": "6915bc5c-ae1b-32c2-a4de-c1ec4f02d17c",
                                                "text": "Il a fait des avantages à sa femme, au détriment de ses enfants."
                                            },
                                            {
                                                "example_id": "14e602a3-8ecd-4f6f-9c5e-d70629910842",
                                                "sense_id": "6915bc5c-ae1b-32c2-a4de-c1ec4f02d17c",
