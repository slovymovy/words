                ],
                "translations": [
                    {
                        "translation_id": "fec357d7-d491-48d3-baba-49392d59f512",
                        "source_entry_id": "898a8964-9fbf-3f08-84cf-bcb42e4c90ad",
                        "source_sense_description": "a young female; miss",
                        "target_lang_word": "Fräulein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fräulein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                        "entry_id": "bd05a187-04f5-3030-8572-d04d9255eb9a",
                                        "glosses": [
                                            "unverheiratete Frau"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da767f1d-5394-4f6c-951f-c0c8eebdf290",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "„Hallo, kleines Fräulein, haben Sie heut’ Zeit … ?“ – (Schlager „Gisela“)"
                                            },
                                            {
                                                "example_id": "d079b30b-794c-4f02-bcf7-3ddda0475827",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "„Bei der Ankunft einer jeden neuen Busladung machten sie untereinander aus, wer von ihnen welches der halbwegs verheißungsvoll aussehenden Fräuleins verführen durfte.“"
                                            },
                                            {
                                                "example_id": "94372da5-860c-404d-98d7-c9d18fa5a081",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "„Allerdings machten die Fräuleins hier einen anständigen Eindruck.“"
                                            },
                                            {
                                                "example_id": "9d64f557-9d04-49df-8566-129e6f7408ae",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "„Fräulein Oppermann hielt sich etwas vor die Augen, das ich nur aus alten Romanen kannte, ein Lorgnon, und musterte mich wie eine aufgespießte Spinne.“"
                                            },
                                            {
                                                "example_id": "aa0c2862-1d30-459c-a0be-39833e34df0e",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "„Tags darauf brach ich nach Preßburg auf, wohin mich Baron Weiß in Gesellschaft zweier Fräulein zu einem Ausflug eingeladen hatte.“"
                                            },
                                            {
                                                "example_id": "44e135cb-d7a7-4c03-bb54-103c4d67e392",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "Die Bezeichnung Fräulein ist heutzutage bei vielen Frauen verpönt; manche (besonders ältere) legen jedoch Wert auf sie."
                                            },
                                            {
                                                "example_id": "6e0b84ef-58b1-4097-a907-fc926378a80d",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "Ein Fräulein ist eine Frau, der zum Glück der Mann fehlt."
                                            },
                                            {
                                                "example_id": "8f5a19e7-aaf8-4c52-98ad-d317d7c1b887",
                                                "sense_id": "ef54ba71-4f61-3172-869b-25126ec916bd",
                                                "text": "„Fräulein Trautmann ist gewiß eine herzensgute Seele, doch, mit Verlaub, als späte und knöcherne Jungfer spukhäßlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                        "entry_id": "bd05a187-04f5-3030-8572-d04d9255eb9a",
                                        "glosses": [
                                            "Titel, Anrede, Namenszusatz für ein Fräulein^([1])"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f81e13-0b2a-429e-9d13-7913dd4f8c2f",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "Die Bezeichnung Fräulein ist heutzutage bei vielen Frauen verpönt; manche (besonders ältere) legen jedoch Wert auf sie."
                                            },
                                            {
                                                "example_id": "d9ada518-1b92-4a66-b127-d27f91c792d0",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "Ein Fräulein ist eine Frau, der zum Glück der Mann fehlt."
                                            },
                                            {
                                                "example_id": "a942af88-9f65-4f2e-9b8c-072d650bafed",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "„Fräulein Trautmann ist gewiß eine herzensgute Seele, doch, mit Verlaub, als späte und knöcherne Jungfer spukhäßlich.“"
                                            },
                                            {
                                                "example_id": "c617f146-76f3-4552-b8c0-3c0dd241cb3c",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "„Haben Sie den neuen Hut von Fräulein Molly schon geseh’n?“ – (Filmmusik aus „Es leuchten die Sterne“ (1938))"
                                            },
                                            {
                                                "example_id": "1462f763-3d13-4413-b920-c0dce4af5aaa",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "„Fräulein Paula blickt freundlich um sich und hat glühende Bäckchen: An welcher Seite, bitte, bekommt man mehr zu sehen, rechts oder links?“"
                                            },
                                            {
                                                "example_id": "3707eda5-cfb6-4cd7-a911-73a4c191b281",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "„Pinneberg macht einen Schritt gegen die Tür, Fräulein Semmler sieht Pinneberg an, gelb, böse und doch triumphierend.“"
                                            },
                                            {
                                                "example_id": "0a1fbe9f-f3a6-4e44-b8b8-e8c6a510af59",
                                                "sense_id": "1ade3283-752e-3abb-b1ce-1754b52a538f",
                                                "text": "„Fräulein Reber brachte die Lebensmittelkarten von Haus zu Haus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc9bb2e3-0e0c-338e-b685-31130d92cded",
                                        "entry_id": "bd05a187-04f5-3030-8572-d04d9255eb9a",
                                        "glosses": [
                                            "Mädchen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b393f9-76ff-413d-bbf6-79cb50b3497e",
                                                "sense_id": "cc9bb2e3-0e0c-338e-b685-31130d92cded",
                                                "text": "„Dieses Fräulein Maria-Theresia mochte wohl gut sechzig sein…“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cd30ff81-491f-3108-b627-d5d8a6432a31",
                                        "entry_id": "bd05a187-04f5-3030-8572-d04d9255eb9a",
                                        "glosses": [
                                            "ledige adlige Frau"
                                        ],
                                        "tags": [
                                            "in älteren neuhochdeutschen Texten auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bda650e-e52f-4d0f-ae88-f85bcd5b5e7f",
                                                "sense_id": "cd30ff81-491f-3108-b627-d5d8a6432a31",
                                                "text": "„Das Fräulein von Scuderi“ – (Novelle von E. T. A. Hoffmann (→Wikipedia))"
                                            },
                                            {
                                                "example_id": "66dee702-7544-429e-8977-e1f5e894e9fd",
                                                "sense_id": "cd30ff81-491f-3108-b627-d5d8a6432a31",
                                                "text": "„Danila war es im Zimmer ohnehin befangen und bedrückt zumut, aber es nun auch noch mit dem gnädigen Fräulein zu tun zu haben, das erschien ihm als ein Ding der Unmöglichkeit.“"
                                            },
                                            {
                                                "example_id": "b0322c2b-b27b-4050-8e96-17804de969ef",
                                                "sense_id": "cd30ff81-491f-3108-b627-d5d8a6432a31",
                                                "text": "„Endlich sah er die Königin von der Fährbrücke her auf sich zukommen, eine Hofdame mit ihr, allem Anscheine nach das jüngere Fräulein von Viereck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1dc326ea-dee2-318e-99b8-e996a0a3b496",
                                        "entry_id": "bd05a187-04f5-3030-8572-d04d9255eb9a",
                                        "glosses": [
                                            "weibliche Bedienung, weibliche Bedienstete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d6a130-16f9-4ad4-9e11-ef084cc94621",
                                                "sense_id": "1dc326ea-dee2-318e-99b8-e996a0a3b496",
                                                "text": "„Das Fräulein unterrichtet unsere Kinder nur vertretungsweise.“"
                                            },
                                            {
                                                "example_id": "b07bb3af-952b-476b-aed2-37133ecd8e25",
                                                "sense_id": "1dc326ea-dee2-318e-99b8-e996a0a3b496",
                                                "text": "„Fräulein, haben Sie noch eine andere Größe da, zum Anprobieren?“"
                                            },
                                            {
                                                "example_id": "49284c3e-789e-4821-bc05-188ef76993be",
                                                "sense_id": "1dc326ea-dee2-318e-99b8-e996a0a3b496",
                                                "text": "„Und kaum ist hinter Fräulein die Tür zu, wendet sich Frau von Anklam wieder ganz teilnahmsvoll an Frau Pagel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
