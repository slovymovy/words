                    },
                    {
                        "translation_id": "e580e59a-597d-4dca-a3f1-8bab0a60950d",
                        "source_entry_id": "f1130988-c95c-3745-b957-ceafd00b1913",
                        "source_sense_id": "7438a26e-b3b0-36b8-89dc-d6d018db327b",
                        "target_lang_word": "kreacionista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d1546c4-f234-4901-94f9-6e13a199e01b",
                        "source_entry_id": "f1130988-c95c-3745-b957-ceafd00b1913",
                        "source_sense_id": "7438a26e-b3b0-36b8-89dc-d6d018db327b",
                        "target_lang_word": "créationniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créationniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2c9b18-2dc1-3a14-9c5a-22a6a9c0f591",
                                        "entry_id": "6c82afa7-a17c-399c-9673-fb755ff2d71c",
                                        "glosses": [
                                            "Relatif au créationnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4fa89ee-5574-4a55-afe5-5100ec25f1cd",
                                                "sense_id": "fb2c9b18-2dc1-3a14-9c5a-22a6a9c0f591",
                                                "text": "C’est ainsi que naquit le mouvement dit science créationniste, avec l’espoir de pouvoir introduire dans les écoles cette science autoproclamée, à côté de l’enseignement de l’évolution."
                                            },
                                            {
                                                "example_id": "9448df66-a20a-452e-8990-d3fa16139ba4",
                                                "sense_id": "fb2c9b18-2dc1-3a14-9c5a-22a6a9c0f591",
                                                "text": "Le grand nombre d’espèces posait des problèmes aux biologistes qui étaient créationnistes. Pour eux il n’y avait qu’une seule apparition au début ce qui posait problème pour les extinctions trouvées par les paléontologues."
                                            },
                                            {
                                                "example_id": "ed85d75d-35ae-4c23-b778-d786f991bd6f",
                                                "sense_id": "fb2c9b18-2dc1-3a14-9c5a-22a6a9c0f591",
                                                "text": "Sonia Kebaïli et Atf Azzouna se sont inspirés des travaux de Foucault et d'Astolfi pour proposer une démarche mise à l'épreuve dans la pratique dans 3 classes de lycée. Le choix des lycées s'est fait sur un critère social en allant d'un lycée populaire où le fixisme créationniste était mobilisé au départ par un élève sur cinq à des lycées plus privilégiés où il était nul ou très faible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd3abd8d-1f6a-30cc-8568-0f9ec8a3e9d1",
                                        "entry_id": "6c82afa7-a17c-399c-9673-fb755ff2d71c",
                                        "glosses": [
                                            "Relatif au mouvement littéraire de poésie appelé créationnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3163e61-d990-49b3-902e-df5893f527fe",
                                                "sense_id": "dd3abd8d-1f6a-30cc-8568-0f9ec8a3e9d1",
                                                "text": "L’œuvre créationniste de G. Diego fut publiée assez tardivement, en 1974, sous le titre Poesía de creación, regroupant intégralement Imagen (1923), Limbo (1921), Manual de espumas (1924) et Biografía incompleta (1953), livre qui dénote un créationnisme plus dilué."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "créationniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
                                        "entry_id": "853298f0-7d72-3f2e-aa65-1f16e5c9d579",
                                        "glosses": [
                                            "Partisan du créationnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b880fc4-d92c-41ef-a4eb-1e5f45dda9c9",
                                                "sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
                                                "text": "Tous les créationnistes s’accordent sur le fait que le monde tel que nous le connaissons est le produit d’une volonté divine."
                                            },
                                            {
                                                "example_id": "37f09351-fd8a-428d-a3c8-1f862aa3d0c6",
                                                "sense_id": "f9691597-0e09-38ab-a204-2eb73720647c",
                                                "text": "Avec lui — autre force d’appoint à la Première ministre britannique —, des créationnistes qui exigent que leurs thèses figurent dans les musées et les programmes scolaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c08a95c2-bbf2-4abc-8e4d-e769de1bcaf8",
                        "source_entry_id": "f1130988-c95c-3745-b957-ceafd00b1913",
                        "source_sense_id": "7438a26e-b3b0-36b8-89dc-d6d018db327b",
                        "target_lang_word": "Kreationist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreationist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a07a3e-387f-36a7-8304-badf7e5217f6",
                                        "entry_id": "6848ab14-c584-3266-b923-59d32a958018",
                                        "glosses": [
                                            "Anhänger/Vertreter des Kreationismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78fd9e1-8d52-4797-81a4-a624a36176ab",
                                                "sense_id": "c2a07a3e-387f-36a7-8304-badf7e5217f6",
                                                "text": "„Gleichwohl bestreiten die Kreationisten nicht nur die Evolution, sondern auch die Grundzüge der Erdgeschichte, der Biologie, Zoologie, Paläontologie, Geschichte et cetera.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
