                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ed7b98-3038-4963-a743-1213e9ed2a3d",
                                                "sense_id": "1e93a771-e256-33c8-9ea1-a47b4d9e62c6",
                                                "text": "[…] il n'est pas permis, excepté sur le théâtre, d'avoir l'air aussi pittoresque que vous, avec vos flanelles blanches, votre chemise mauve et votre cravate violet foncé !"
                                            },
                                            {
                                                "example_id": "92b79511-bd4b-469c-915b-deb06e18408b",
                                                "sense_id": "1e93a771-e256-33c8-9ea1-a47b4d9e62c6",
                                                "text": "Le violet est une des couleurs extrêmes du spectre solaire."
                                            },
                                            {
                                                "example_id": "7188ae08-72ea-4f5e-aa2f-443f615a4e51",
                                                "sense_id": "1e93a771-e256-33c8-9ea1-a47b4d9e62c6",
                                                "text": "Être vêtu de violet."
                                            },
                                            {
                                                "example_id": "3d2439ab-1003-464c-adec-88eb84e11d9d",
                                                "sense_id": "1e93a771-e256-33c8-9ea1-a47b4d9e62c6",
                                                "text": "Les rois de France portaient le deuil en violet."
                                            },
                                            {
                                                "example_id": "b2901893-8168-4c31-a79f-1d41f915eeb7",
                                                "sense_id": "1e93a771-e256-33c8-9ea1-a47b4d9e62c6",
                                                "text": "À droite, la pyramide rocheuse du Ben Lomond se teintait à présent de violet épiscopal."
                                            }
                                        ]
                                    },
