                        "glosses": [
                            "gekristalliseerde, vaak bruine suiker in klontvorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ce5352-9f31-4b66-8c6e-71edbc4cf8d1",
                                "sense_id": "d97b4fee-8cfc-383a-9e19-117737ef3eab",
                                "text": "In Groningen gebruikt men vaak kandij in de koffie."
                            }
