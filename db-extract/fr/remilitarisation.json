                "senses": [
                    {
                        "sense_id": "a2d5a2ab-2bb2-3513-a557-c32406c6ed3a",
                        "entry_id": "7fada647-2689-3982-813a-771c0b71f734",
                        "glosses": [
                            "Action de remilitariser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6d79e2-92cb-49bd-8e4e-0560315fb7f1",
                                "sense_id": "a2d5a2ab-2bb2-3513-a557-c32406c6ed3a",
                                "text": "Depuis des mois on savait parfaitement à Paris que la dénonciation par Hitler des accords de Locarno et la remilitarisation de la Rhénanie pouvaient survenir d'un moment à l'autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cc1c608-2d1d-303e-95f9-c20aa6abb3d2",
                        "entry_id": "7fada647-2689-3982-813a-771c0b71f734",
                        "glosses": [
                            "Action de redonner à une arme à feu théoriquement « neutralisée » sa capacité de tuer."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f5d05678-9b49-4bbe-afb9-eca53e751241",
                                "sense_id": "2cc1c608-2d1d-303e-95f9-c20aa6abb3d2",
                                "text": "« Cette démarche est, en France, parfaitement illégale, mais matériellement facile », soulignait dans un rapport du 20 janvier 2015 le Laboratoire de la police scientifique de Paris, qui a analysé l’arsenal de Coulibaly. Seulement voilà, la remilitarisation, même artisanale, d’une arme d’alarme est un jeu d’enfant pour un connaisseur (voir notre infographie). D’inoffensive, elle devient ou redevient alors mortelle."
                            }
                        ]
                    }
