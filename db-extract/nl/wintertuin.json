                "senses": [
                    {
                        "sense_id": "cbd9c45b-24e0-3c14-857d-920bc12003f9",
                        "entry_id": "f0710823-6d9b-3348-aa79-b779336583ec",
                        "glosses": [
                            "overdekte tuin aangelegd in een kas of serre waar het in de winter warmer is dan in de omgeving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74220721-42d6-42c7-be66-bcd43f5122dc",
                                "sense_id": "cbd9c45b-24e0-3c14-857d-920bc12003f9",
                                "text": "Pierre kende die kamer goed, met de twee openslaande Italiaanse ramen, de toegang tot de wintertuin, een groot borstbeeld van Katharina en haar portret in volle lengte."
                            },
                            {
                                "example_id": "5552ba68-23a0-495f-a5f4-f7a4d88fe0c2",
                                "sense_id": "cbd9c45b-24e0-3c14-857d-920bc12003f9",
                                "text": "Op het moment dat het dak naar beneden kwam, werd er bovenop gewerkt aan een wintertuin. Daarvoor werden onder meer planten en bomen geplaatst. Mogelijk bezweek het dak onder het gewicht."
                            }
                        ]
                    }
                ],
