    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49c71932-1f0e-34da-a9fd-92a7555a8b40",
                    "sense_definition": "The joint connecting the foot with the leg.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slipped on the ice and twisted her <w>ankle</w>.",
                            "target_lang_translations": {
                                "ru": "Она поскользнулась на льду и подвернула <w>лодыжку</w>.",
                                "zh": "她在冰上滑倒，扭伤了<w>脚踝</w>。"
                            }
                        },
                        {
                            "text": "The water in the stream was only <w>ankle</w> deep.",
                            "target_lang_translations": {
                                "ru": "Воды в ручье было всего лишь по <w>щиколотку</w>.",
                                "zh": "溪水只有<w>脚踝</w>那么深。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sprained ankle",
                        "twisted ankle",
                        "broken ankle",
                        "ankle deep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сустав, соединяющий стопу с голенью",
                        "zh": "连接脚和腿的关节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лодыжка",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "щиколотка",
                                "target_lang_sense_clarification": "выступающая косточка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚踝",
                                "target_lang_sense_clarification": "解剖学通用术语"
                            },
                            {
                                "target_lang_word": "踝关节",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                    "sense_definition": "To walk or go somewhere on foot.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got bored and <w>ankled</w> over to the window to look outside.",
                            "target_lang_translations": {
                                "ru": "Ему стало скучно, и он <w>побрел</w> к окну, чтобы выглянуть на улицу.",
                                "zh": "他觉得无聊，便<w>溜达</w>到窗边向外看。"
                            }
                        },
                        {
                            "text": "They <w>ankled</w> down the road looking for a place to eat.",
                            "target_lang_translations": {
                                "ru": "Они <w>потопали</w> по дороге, высматривая, где бы поесть.",
                                "zh": "他们沿着路<w>溜达</w>，寻找吃饭的地方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "walk",
                        "stroll"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти или направляться куда-либо пешком",
                        "zh": "步行或徒步前往某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "топать",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溜达",
                                "target_lang_sense_clarification": "口语，指闲逛"
                            },
                            {
                                "target_lang_word": "步行",
                                "target_lang_sense_clarification": "正式用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62babd6f-1771-341b-888e-2b5799014630",
                    "sense_definition": "To angle the foot at the ankle while pedaling a bicycle to improve efficiency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Professional cyclists use <w>ankling</w> to maintain a smooth pedal stroke.",
                            "target_lang_translations": {
                                "ru": "Профессиональные велосипедисты используют <w>работу голеностопом</w> для поддержания плавного вращения педалей.",
                                "zh": "职业自行车手利用<w>踝关节发力</w>来保持踩踏平稳。"
                            }
                        },
                        {
                            "text": "He practiced <w>ankling</w> on the hills to get more power.",
                            "target_lang_translations": {
                                "ru": "Он тренировал <w>работу голеностопом</w> на подъемах, чтобы увеличить мощность.",
                                "zh": "他在爬坡时练习<w>踝关节发力</w>以获得更大的动力。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять угол наклона стопы при педалировании для повышения эффективности",
                        "zh": "骑自行车时通过调整脚踝角度来提高踩踏效率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать голеностопом",
                                "target_lang_sense_clarification": "велоспорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踝关节发力",
                                "target_lang_sense_clarification": "自行车运动术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}