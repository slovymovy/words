                "senses": [
                    {
                        "sense_id": "0241436c-0592-3e3c-9f82-42843a2d3edc",
                        "entry_id": "17bc765f-2339-31a7-b6d7-b82cd34d1c1e",
                        "glosses": [
                            "Bundesbehörde, die für die digitale Infrastruktur zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7524b38c-1b41-49cc-93b3-d5b54ff37298",
                                "sense_id": "0241436c-0592-3e3c-9f82-42843a2d3edc",
                                "text": "„Ein erster Entwurf der Verordnung kursierte bereits im August 2022. Doch das Bundesdigitalministerium unter Volker Wissing (FDP) benötigte zwei weitere Jahre, um eine beschlussfähige Fassung herbeizuführen.“"
                            },
                            {
                                "example_id": "3a6c87b8-ca8f-411b-a8b3-f4cabf2968fa",
                                "sense_id": "0241436c-0592-3e3c-9f82-42843a2d3edc",
                                "text": "„Wie das Bundesdigitalministerium auf Anfrage mitteilte, wurden seit 2015 in verschiedenen Förderprogrammen insgesamt rund 16 Milliarden Euro für den Breitbandausbau bewilligt.“"
                            },
                            {
                                "example_id": "c7604f98-3421-4f64-b628-60136fa6b6f9",
                                "sense_id": "0241436c-0592-3e3c-9f82-42843a2d3edc",
                                "text": "„Nach Angaben des Bundesdigitalministeriums vor rund einer Woche stieg innerhalb eines Jahres die Versorgung mit dem schnellen Mobilfunknetz der fünften Generation (5G) auf 87 Prozent der Fläche in Deutschland […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
