    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be8ca557-8e2c-3067-aeb5-b1a1d54eb49b",
                    "sense_definition": "A feeling of irritation or resentment caused by a social slight or injury.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She left the party in a sudden <w>fit</w> of <w>pique</w> after being ignored by the host.",
                            "target_lang_translations": {
                                "nl": "Ze verliet het feest in een plotselinge <w>bui van verontwaardiging</w> nadat ze door de gastheer was genegeerd."
                            }
                        },
                        {
                            "text": "His decision to resign was not just a <w>fit</w> of <w>pique</w> but a calculated move.",
                            "target_lang_translations": {
                                "nl": "Zijn besluit om ontslag te nemen was niet slechts een <w>bui van gekwetstheid</w>, maar een berekende zet."
                            }
                        }
                    ],
                    "synonyms": [
                        "resentment",
                        "irritation",
                        "annoyance"
                    ],
                    "common_phrases": [
                        "fit of pique"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gevoel van irritatie of wrok veroorzaakt door een sociale belediging of krenking."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gekwetstheid",
                                "target_lang_sense_clarification": "gevoel van beledigd zijn"
                            },
                            {
                                "target_lang_word": "verontwaardiging",
                                "target_lang_sense_clarification": "gevoel van irritatie door een miskenning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c73b168-1383-3a52-a1cd-19930e31b5e0",
                    "sense_definition": "A feeling of animosity or a dispute between people.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long-standing <w>pique</w> between the two families finally ended after the wedding.",
                            "target_lang_translations": {
                                "nl": "De langdurige <w>wrok</w> tussen de twee families eindigde eindelijk na de bruiloft."
                            }
                        },
                        {
                            "text": "They set aside their personal <w>pique</w> to work together on the project.",
                            "target_lang_translations": {
                                "nl": "Ze zetten hun persoonlijke <w>wrok</w> opzij om samen aan het project te werken."
                            }
                        }
                    ],
                    "synonyms": [
                        "enmity",
                        "animosity",
                        "grudge"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gevoel van vijandigheid of een geschil tussen mensen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wrok",
                                "target_lang_sense_clarification": "langdurige vijandigheid"
                            },
                            {
                                "target_lang_word": "bitterheid",
                                "target_lang_sense_clarification": "gevoel van animositeit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e1a6a55-9bac-3060-9b48-832ba23751f1",
                    "sense_definition": "To stimulate or excite curiosity or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious letter was enough to <w>pique</w> her curiosity.",
                            "target_lang_translations": {
                                "nl": "De mysterieuze brief was genoeg om haar nieuwsgierigheid te <w>prikkelen</w>."
                            }
                        },
                        {
                            "text": "The new exhibit is designed to <w>pique</w> the interest of young students.",
                            "target_lang_translations": {
                                "nl": "De nieuwe tentoonstelling is ontworpen om de interesse van jonge studenten te <w>prikkelen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulate",
                        "excite",
                        "arouse"
                    ],
                    "common_phrases": [
                        "pique interest"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het stimuleren of opwekken van nieuwsgierigheid of interesse."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "prikkelen",
                                "target_lang_sense_clarification": "interesse of nieuwsgierigheid opwekken"
                            },
                            {
                                "target_lang_word": "aanwakkeren",
                                "target_lang_sense_clarification": "interesse versterken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cedabf0-6ec8-37fc-8cc3-2ba968e8da68",
                    "sense_definition": "To wound someone's pride or cause them to feel irritated or offended.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>piqued</w> him that his younger brother was promoted before him.",
                            "target_lang_translations": {
                                "nl": "Het <w>kwetste</w> hem dat zijn jongere broer eerder promotie kreeg dan hij."
                            }
                        },
                        {
                            "text": "She was <w>piqued</w> by his dismissive attitude during the meeting.",
                            "target_lang_translations": {
                                "nl": "Ze was <w>geïrriteerd</w> door zijn afwijzende houding tijdens de vergadering."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritate",
                        "offend",
                        "annoy"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemands trots kwetsen of ervoor zorgen dat iemand zich geïrriteerd of beledigd voelt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kwetsen",
                                "target_lang_sense_clarification": "iemands trots of gevoelens raken"
                            },
                            {
                                "target_lang_word": "irriteren",
                                "target_lang_sense_clarification": "iemand tot ergernis brengen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab249d81-a29e-3db4-9f3e-477c27d1d79d",
                    "sense_definition": "To take pride in something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pride",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef <w>piques</w> himself on using only the freshest local ingredients.",
                            "target_lang_translations": {
                                "nl": "De chef <w>beroemt zich erop</w> alleen de meest verse lokale ingrediënten te gebruiken."
                            }
                        },
                        {
                            "text": "They <w>pique</w> themselves on their ability to solve complex problems quickly.",
                            "target_lang_translations": {
                                "nl": "Ze <w>beroemen zich op</w> hun vermogen om complexe problemen snel op te lossen."
                            }
                        }
                    ],
                    "synonyms": [
                        "pride"
                    ],
                    "common_phrases": [
                        "pique oneself"
                    ],
                    "target_lang_definitions": {
                        "nl": "Trots zijn op iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich beroemen op",
                                "target_lang_sense_clarification": "trots zijn op een bepaalde eigenschap"
                            },
                            {
                                "target_lang_word": "trots zijn op",
                                "target_lang_sense_clarification": "zichzelf prijzen om iets"
                            }
                        ]
                    }
                }
            ]
        }
