                        {
                            "text": "De hond slaapt elke nacht rustig in zijn <w>hok</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "The dog sleeps quietly in his <w>kennel</w> in the garden every night.",
                                "ru": "Собака каждую ночь спокойно спит в своей <w>будке</w> в саду.",
                                "pl": "Pies śpi spokojnie każdej nocy w swojej <w>budzie</w> w ogrodzie.",
                                "de": "Der Hund schläft jede Nacht ruhig in seiner <w>Hundehütte</w> im Garten.",
                                "fr": "Le chien dort tranquillement chaque nuit dans sa <w>niche</w> dans le jardin.",
                                "it": "Il cane dorme tranquillamente ogni notte nella sua <w>cuccia</w> in giardino.",
                                "cs": "Pes spí každou noc klidně ve své <w>boudě</w> na zahradě.",
                                "tr": "Köpek her gece bahçedeki <w>kulübesinde</w> sessizce uyur.",
                                "es": "El perro duerme tranquilamente en su <w>caseta</w> en el jardín todas las noches."
                            }
                        },
                        {
                            "text": "We moeten het <w>hok</w> van de konijnen schoonmaken omdat het vies is.",
                            "target_lang_translations": {
                                "en": "We need to clean the rabbit <w>hutch</w> because it is dirty.",
                                "ru": "Нам нужно почистить кроличью <w>клетку</w>, потому что она грязная.",
                                "pl": "Musimy wyczyścić <w>klatkę</w> królików, ponieważ jest brudna.",
                                "de": "Wir müssen den <w>Stall</w> der Kaninchen sauber machen, weil er schmutzig ist.",
                                "fr": "Nous devons nettoyer le <w>clapier</w> des lapins parce qu'il est sale.",
                                "it": "Dobbiamo pulire la <w>gabbia</w> dei conigli perché è sporca.",
                                "cs": "Musíme vyčistit <w>králíkárnu</w>, protože je špinavá.",
                                "tr": "Tavşanların <w>kümesini</w> temizlemeliyiz çünkü kirli.",
                                "es": "Tenemos que limpiar la <w>conejera</w> de los conejos porque está sucia."
                            }
