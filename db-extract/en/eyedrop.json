                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "7eed107f-1914-4101-9823-cb8b4c289b3c",
                                "sense_id": "cb2bc47c-c20f-37b9-b1d8-d4ef82012e0c",
                                "text": "My lord, I found the prince in the next room, / Washing with kindly tears his gentle cheeks, / With such a deep demeanour in great sorrow / That tyranny, which never quaff'd but blood, / Would, by beholding him, have wash'd his knife / With gentle eye-drops. He is coming hither."
                            }
                        ]
