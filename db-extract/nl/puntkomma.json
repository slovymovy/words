                "senses": [
                    {
                        "sense_id": "27d82b4e-c6b2-3ab2-adf5-dcfc79caf82a",
                        "entry_id": "433471fe-4d39-36d2-b1f3-179c75848a18",
                        "glosses": [
                            "een leesteken dat twee nauw aan elkaar gerelateerde zinnen tot een geheel verbindt (;)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f0a68a-a67a-4f83-8431-2dff07bf8028",
                                "sense_id": "27d82b4e-c6b2-3ab2-adf5-dcfc79caf82a",
                                "text": "Na een puntkomma volgt geen hoofdletter."
                            },
                            {
                                "example_id": "9026dc92-0b12-4d33-bf48-a90dd6da5b1e",
                                "sense_id": "27d82b4e-c6b2-3ab2-adf5-dcfc79caf82a",
                                "text": "Een puntkomma staat – net als een punt – in principe tussen twee complete (i.e. met een persoonsvorm) zinnen."
                            },
                            {
                                "example_id": "3d7fc403-5e7f-47bc-b627-88ee2425de75",
                                "sense_id": "27d82b4e-c6b2-3ab2-adf5-dcfc79caf82a",
                                "text": "Bij een puntkomma klinken de deelzinnen als zelfstandige zinnen met elk een eigen intonatie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce3df4d7-8e5d-4475-8276-f203d867f6eb",
                        "source_entry_id": "433471fe-4d39-36d2-b1f3-179c75848a18",
                        "source_sense_id": "27d82b4e-c6b2-3ab2-adf5-dcfc79caf82a",
                        "source_sense_description": "een leesteken dat twee nauw aan elkaar gerelateerde zinnen tot een geheel verbindt (;)",
                        "target_lang_word": "Semikolon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semikolon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "346915db-e92e-35f4-aea3-6fdbff6a1626",
                                        "entry_id": "37c30df0-b604-38f7-912a-d3e04ab20cb1",
                                        "glosses": [
                                            "Satzzeichen, das zwei selbstständige Sätze trennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66366599-a8ba-41f5-b39c-6a1f509b6391",
                                                "sense_id": "346915db-e92e-35f4-aea3-6fdbff6a1626",
                                                "text": "Ein Semikolon ist ein Satzzeichen: ;"
                                            },
                                            {
                                                "example_id": "1d30bb5e-11b5-479f-a85c-db1b48b134c5",
                                                "sense_id": "346915db-e92e-35f4-aea3-6fdbff6a1626",
                                                "text": "„Kommata und oft auch Semikola zwischen Äquivalenten einer Bedeutungsangabe sind für Wörterbuchbenutzer insofern tückisch, weil sie nicht das signalisieren, was sprachüblich ist.“"
                                            },
                                            {
                                                "example_id": "ea5ec84a-077e-4a69-88b8-6e941fb9fb34",
                                                "sense_id": "346915db-e92e-35f4-aea3-6fdbff6a1626",
                                                "text": "„Durch das Semikolon (Strichpunkt) zwischen den Herkunftsangaben wird deutlich gemacht, dass es sich bei dem Stichwort um eine Zusammensetzung aus Wörtern oder Wortteilen der angegebenen Sprachen handelt.“"
                                            },
                                            {
                                                "example_id": "1b9751eb-371a-426c-b8f3-981762a1b2e0",
                                                "sense_id": "346915db-e92e-35f4-aea3-6fdbff6a1626",
                                                "text": "„Es finden sich ruhige – man ist versucht, zu Wassermetaphern zu greifen – dahinfließende Perioden und solche, wo es durch kleine Stromschnellen geht mit Komma, Semikolon, Gedankenstrich, Innehalten, Pausen, Tempozugabe; wer das vorliest, hat sein Vergnügen daran.“"
                                            },
                                            {
                                                "example_id": "8f8ff10e-382b-4793-b42d-41fc3611486d",
                                                "sense_id": "346915db-e92e-35f4-aea3-6fdbff6a1626",
                                                "text": "„Und der Schriftsteller Christian Morgenstern verpasste dem Ausrufezeichen in seinem Humorgedicht »Im Reich der Interpunktionen«, das den Mord an den Semikolons beschreibt, die Rolle des empathischen Predigers bei dessen Beerdigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
