                "translations": [
                    {
                        "translation_id": "fb6aa48c-ed78-4404-bc57-d9ba4d832540",
                        "source_entry_id": "456b32d2-d31c-34ae-8162-c15633417cf9",
                        "source_sense_id": "ed67076b-66d7-3449-b38d-21889cee350b",
                        "source_sense_description": "een handelaar die gespecialiseerd is in de verkoop van vis",
                        "target_lang_word": "Fischhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "343de591-49cd-367b-a82a-77d41b62da84",
                                        "entry_id": "c869d44e-ec26-3276-82e3-e7bd63b49a0e",
                                        "glosses": [
                                            "eine Person, die Fisch verkauft"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d97e82-4ec2-47dc-b8da-1b4b5f8f3cee",
                                                "sense_id": "343de591-49cd-367b-a82a-77d41b62da84",
                                                "text": "Der Fischhändler muss seine Fische, solange sie frisch sind, schnellstmöglich verkaufen."
                                            },
                                            {
                                                "example_id": "244ec8d4-7d13-495a-8147-d0c0d6b3dbe6",
                                                "sense_id": "343de591-49cd-367b-a82a-77d41b62da84",
                                                "text": "„Ein Fischhändler wurde gefragt, wie viele Fische er an diesem Tag verkauft habe.",
                                                "translation": "Der zweite, dritte und vierte Kunde sagten das gleiche. Als ich alle vier bedient hatte, war ich ausverkauft und hatte keinen Fisch teilen müssen.\" Wie viele Fische hat der Fischhändler insgesamt verkauft?“ (Quelle: www.r-ene.de, Rätsel - Der eifrige Fischhändler)"
                                            },
                                            {
                                                "example_id": "1babadc6-c794-42b4-a861-10cd3d657498",
                                                "sense_id": "343de591-49cd-367b-a82a-77d41b62da84",
                                                "text": "„Unter all den durch den Untertitel angekündigten Figuren ist der Fischhändler womöglich die eindrücklichste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2dd1187-d070-47f2-80d1-f3bbf3601c9b",
                        "source_entry_id": "456b32d2-d31c-34ae-8162-c15633417cf9",
                        "source_sense_id": "ed67076b-66d7-3449-b38d-21889cee350b",
                        "source_sense_description": "een handelaar die gespecialiseerd is in de verkoop van vis",
                        "target_lang_word": "fishmonger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fishmonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "608bbb03-fb79-3661-8593-9618cfa574eb",
                                        "entry_id": "01c5c263-2ebf-334f-81e9-acedaa238d42",
                                        "glosses": [
                                            "A person who sells fish."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c3e2bc-0e97-4314-83a2-85770143d1b9",
                                                "sense_id": "608bbb03-fb79-3661-8593-9618cfa574eb",
                                                "text": "If he made transcendental distinctions, he fortified himself by drawing all his illustrations from sources disdained by orators and polite conversers; from mares and puppies; from pitchers and soup-ladles; from cooks and criers; the shops of potters, horse-doctors, butchers, and fishmongers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                        "entry_id": "01c5c263-2ebf-334f-81e9-acedaa238d42",
                                        "glosses": [
                                            "A shop that sells fish; a fishmonger's shop, a fishmonger's."
                                        ],
                                        "tags": [
                                            "British",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda8ef74-6073-438f-a51d-6e36cab9aa8b",
                                                "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                                "text": "And Susan, sure of this inevitable answer, would ask Cook to pop into the fishmonger for a nice bit of salmon, […]"
                                            },
                                            {
                                                "example_id": "e7f30582-ffd2-4c8b-931c-e8aa7be34f85",
                                                "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                                "text": "A nice woman at the fishmonger in Earl’s Court Road—she had to walk miles to find a fish shop—told her how to cook the fillets of plaice she bought."
                                            },
                                            {
                                                "example_id": "24692526-b9c8-4a22-8a7b-c48da31c4fc6",
                                                "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                                "text": "Cornish peppered mackerel, smoked haddock, Scottish herring and pearl-white skate wings are all laid on a bed of crushed ice at the fishmonger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598cf8ce-9895-3242-bc2e-50cd48a2c49f",
                                        "entry_id": "01c5c263-2ebf-334f-81e9-acedaa238d42",
                                        "glosses": [
                                            "A pimp."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61db51ac-4ed3-48f4-8e8a-e11d288bcabe",
                                                "sense_id": "598cf8ce-9895-3242-bc2e-50cd48a2c49f",
                                                "text": "Excellent well; you are a fishmonger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
