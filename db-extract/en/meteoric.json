                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbb3989-c37a-41b6-b344-be9486412104",
                                "sense_id": "c6b60c18-42c6-37b7-a83e-350f08b30332",
                                "text": "meteoric iron"
