                            {
                                "example_id": "7d2ddb07-33c6-4fe4-8be5-e8086d072fd0",
                                "sense_id": "fd0fd92f-88d8-33c6-93d0-48ea468079e4",
                                "text": "Maar wij hebben steeds meer energie gestoken in het rationeel doorgronden van natuurlijke gebeurtenissen: er zijn geen voortekenen of openbaringen meer, geen vloeken of profetieën; onze toekomst zal niet in godshuizen maar in laboratoria worden ontsluierd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd638759-f8df-4c00-b87f-afab25103a70",
                        "source_entry_id": "ddb81651-7795-3f57-9678-3ebaade307cf",
                        "source_sense_id": "fd0fd92f-88d8-33c6-93d0-48ea468079e4",
