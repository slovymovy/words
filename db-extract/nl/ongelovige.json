                "forms": [],
                "senses": [
                    {
                        "sense_id": "fe585e87-0a44-3299-a348-a85db7f2205f",
                        "entry_id": "cb9e26e8-b07f-31de-8942-331bd946d6ed",
                        "glosses": [
                            "iemand die niet (meer) gelooft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08a5607a-e101-438c-bef7-96696dd0fe8d",
                                "sense_id": "fe585e87-0a44-3299-a348-a85db7f2205f",
                                "text": "Heidenen, afvalligen en ketters zijn allen ongelovigen. De eerste groep heeft nooit kennis gemaakt met het ware geloof en kunnen nog bekeerd worden. De afvalligen zijn ooit gelovigen geweest maar hebben het geloof afgezworen. De ketters beweren nog steeds gelovigen te zijn maar doen het op een foute manier."
                            },
                            {
                                "example_id": "85960bfd-3593-4669-ab39-1fc3bbd90e2d",
                                "sense_id": "fe585e87-0a44-3299-a348-a85db7f2205f",
                                "text": "In Mexico is bijna iedereen gelovig. Ze kijken soms neer op ongelovigen. Dan verdedig ik Nederlanders vurig. Ze zijn zo lief, zeg ik dan. Maar niets is perfect."
                            }
                        ]
                    }
