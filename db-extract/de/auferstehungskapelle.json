                        "tags": [],
                        "examples": [
                            {
                                "example_id": "769b356f-c475-4340-b9e0-59858e91c1dd",
                                "sense_id": "c07aa562-0f04-3ac6-a969-8a385581be3c",
                                "text": "„Die Auferstehungskapelle gehört zum Gut Langenbrück.“"
                            },
                            {
                                "example_id": "4de9ef3d-4114-4f73-8025-4ffa60ee749a",
                                "sense_id": "c07aa562-0f04-3ac6-a969-8a385581be3c",
                                "text": "„Die großzügige Auferstehungskapelle bietet Platz für jede Trauergesellschaft, unabhängig von der Konfession.“"
                            },
                            {
                                "example_id": "5de80ad7-f47f-428a-ad3f-950619212fc6",
                                "sense_id": "c07aa562-0f04-3ac6-a969-8a385581be3c",
                                "text": "„Der Kerzenbaum, eine Darstellung des brennenden Dornbuschs, mit dem Blick zur Pieta oder zur Auferstehungskapelle prägen das Bild des Atriums.“"
                            }
                        ],
