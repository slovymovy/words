                "senses": [
                    {
                        "sense_id": "7064c2a3-8707-3aa2-8ca1-39294f026500",
                        "entry_id": "32425f11-c01e-3792-9aba-df5278922501",
                        "glosses": [
                            "Kraftwerk, das Wasser zur Stromgewinnung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867a12ad-c28b-4ea3-b94b-221358639144",
                                "sense_id": "7064c2a3-8707-3aa2-8ca1-39294f026500",
                                "text": "Wasserkraftwerke gehören zu den regenerativen Stromerzeugern."
                            },
                            {
                                "example_id": "21e14036-c844-4e77-ac4b-192e278dab51",
                                "sense_id": "7064c2a3-8707-3aa2-8ca1-39294f026500",
                                "text": "„Der Bauplaner des Wasserkraftwerks ist weitgehend unbekannt.“"
                            },
                            {
                                "example_id": "7a7ba6c0-0680-48c8-885b-bc41203d787b",
                                "sense_id": "7064c2a3-8707-3aa2-8ca1-39294f026500",
                                "text": "„Für Wasserkraftwerke werden Stauseen errichtet, die riesige Ökosysteme zerstören, und für Energiesparlampen muss in China hochgiftiges Quecksilber abgebaut werden.“"
                            },
                            {
                                "example_id": "26b3c512-0c27-4af2-8653-1ed48fe2feec",
                                "sense_id": "7064c2a3-8707-3aa2-8ca1-39294f026500",
                                "text": "„Schon seit längerem leiden die Wasserkraftwerke im Nahen Osten unter zunehmender Trockenheit,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
