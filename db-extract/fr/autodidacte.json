                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "650b3134-dc26-4a4f-9f8b-2743e7747869",
                        "entry_id": "2bbbfe2e-2b21-3493-a822-531329083949",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "autodidactes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e656644c-3fd6-3f7d-8cb1-d2105a32a529",
                        "entry_id": "2bbbfe2e-2b21-3493-a822-531329083949",
                        "glosses": [
                            "Qui s’est instruit soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49156ace-ce61-48a3-a7d6-3a987dffb564",
                                "sense_id": "e656644c-3fd6-3f7d-8cb1-d2105a32a529",
                                "text": "Auteur autodidacte."
                            },
                            {
                                "example_id": "2c268559-9c24-499c-a181-39e98520fee9",
                                "sense_id": "e656644c-3fd6-3f7d-8cb1-d2105a32a529",
                                "text": "(...) en présentant une lecture transversale – et nécessairement subjective – de la vie et de l’œuvre de Simenon en sa qualité de romancier autodidacte."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c080f6d-684f-3961-93fc-c39f107f1af7",
                        "entry_id": "2bbbfe2e-2b21-3493-a822-531329083949",
                        "glosses": [
                            "Qualifie une formation acquise sans directeur d’études."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e494ac4-e319-4ba8-bf95-4324904a1e21",
                                "sense_id": "7c080f6d-684f-3961-93fc-c39f107f1af7",
                                "text": "Il ne revint en Autriche que pour un épisode souvent commenté en mauvaise part, le conseil de révision. Il avait cherché à s’y dérober. Lâcheté ? Souci de ne pas interrompre une formation autodidacte d’architecte ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "eeefc89e-3302-32ea-96d0-fe4b410a16ab",
                        "entry_id": "2bbbfe2e-2b21-3493-a822-531329083949",
                        "glosses": [
                            "Se dit de ceux dont les actes résultent de l’instinct et non d’une connaissance acquise."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "da686129-2439-438c-8206-5c5fdbdfcd3e",
                                "sense_id": "eeefc89e-3302-32ea-96d0-fe4b410a16ab",
                                "text": "Les animaux tels que l’abeille, le castor, l’hirondelle, etc., sont autodidactes, parce que tous leurs actes, tous les mouvements qu’ils exécutent découlent de l’instinct dont la nature seule les a doués."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1aad184-16e8-491b-816f-cfda99da0ce0",
                        "source_entry_id": "2bbbfe2e-2b21-3493-a822-531329083949",
                        "target_lang_word": "autodidaktisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodidaktisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60b001fc-e0fa-3622-8b1a-720e70818213",
                                        "entry_id": "99841161-fd49-372e-a6d1-0b5ac33afbb0",
                                        "glosses": [
                                            "den Selbstunterricht betreffend, für Autodidakten geeignet und/oder konzipiert"
                                        ],
                                        "tags": [
                                            "Bildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ad223b3-b65d-4aaa-872d-3435cc68d98b",
                                                "sense_id": "60b001fc-e0fa-3622-8b1a-720e70818213",
                                                "text": "Er ist auf der Suche nach autodidaktischem Material für seine Kinder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98ebdbab-58a1-386b-91c6-669b7af1fab7",
                                        "entry_id": "99841161-fd49-372e-a6d1-0b5ac33afbb0",
                                        "glosses": [
                                            "durch Selbstunterricht, als Autodidakt"
                                        ],
                                        "tags": [
                                            "Bildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "523c69df-616a-414a-a1fe-e9c4b938fa01",
                                                "sense_id": "98ebdbab-58a1-386b-91c6-669b7af1fab7",
                                                "text": "Die nötigen Fertigkeiten für diese Tätigkeit hat er autodidaktisch erworben."
                                            },
                                            {
                                                "example_id": "2586fe4d-19a4-49da-8cbd-e95e9f0471ac",
                                                "sense_id": "98ebdbab-58a1-386b-91c6-669b7af1fab7",
                                                "text": "Seine Mutter bildet sich autodidaktisch weiter."
                                            },
                                            {
                                                "example_id": "b9b0ecb6-5140-4d34-8f8d-5f649dc603f3",
                                                "sense_id": "98ebdbab-58a1-386b-91c6-669b7af1fab7",
                                                "text": "Er möchte Finnisch autodidaktisch erlernen."
                                            },
                                            {
                                                "example_id": "61329c80-cb9b-4f66-8282-d1739d14cc83",
                                                "sense_id": "98ebdbab-58a1-386b-91c6-669b7af1fab7",
                                                "text": "Sie ist autodidaktische Schriftstellerin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4ba6afe-c0f6-4430-a2c8-ce10eb6b0cec",
