                "senses": [
                    {
                        "sense_id": "b92455a3-ce53-3847-98a3-9b35c5a333dd",
                        "entry_id": "b1889266-501f-300b-862d-b61e37d7dd9c",
                        "glosses": [
                            "een natuurlijk getal dat groter is dan 1 en alleen kan worden gedeeld door 1 of door het getal zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f6509b-8b07-4dac-ab6d-95968fa7cafd",
                                "sense_id": "b92455a3-ce53-3847-98a3-9b35c5a333dd",
                                "text": "Afgezien van 1 en 7, is er geen getal waardoor het getal 7 is te delen: 7 noemt men een priemgetal."
                            },
                            {
                                "example_id": "227d406c-9ad1-4cb7-8308-3b0df44c4d22",
                                "sense_id": "b92455a3-ce53-3847-98a3-9b35c5a333dd",
                                "text": "Grootste priemgetal ooit ontdekt"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99a03b65-9be5-4ad5-86c7-333b89508687",
                        "source_entry_id": "b1889266-501f-300b-862d-b61e37d7dd9c",
                        "source_sense_id": "b92455a3-ce53-3847-98a3-9b35c5a333dd",
                        "source_sense_description": "priemgetal",
                        "target_lang_word": "Primzahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Primzahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44124cf0-74e3-3673-a7f7-e1870a228269",
                                        "entry_id": "55786171-9568-3aab-a9e2-ec70a0a1e77d",
                                        "glosses": [
                                            "eine natürliche Zahl, die genau zwei natürliche Divisoren hat, 1 und die Zahl selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8c11dd-2a3f-4da4-a6f0-2bafaf21f6ec",
                                                "sense_id": "44124cf0-74e3-3673-a7f7-e1870a228269",
                                                "text": "23 hat genau zwei positive Teiler, nämlich 1 und 23, und ist damit eine Primzahl."
                                            },
                                            {
                                                "example_id": "8a1581bf-14a3-4c8b-b939-ba8aa5149d94",
                                                "sense_id": "44124cf0-74e3-3673-a7f7-e1870a228269",
                                                "text": "„Manchmal ist die Grenze auch eine Primzahl p, also eine Zahl, die nur durch 1 und sich selbst ohne Rest teilbar ist.“"
                                            },
                                            {
                                                "example_id": "4c71cf5f-6f6f-424d-b98d-a75e286510ce",
                                                "sense_id": "44124cf0-74e3-3673-a7f7-e1870a228269",
                                                "text": "Zwei ist die einzige gerade Primzahl."
                                            },
                                            {
                                                "example_id": "25438ad0-b11f-4240-a403-42753a92ff24",
                                                "sense_id": "44124cf0-74e3-3673-a7f7-e1870a228269",
                                                "text": "„Aus diesem Grund sind Pentagonalzahlen neben den Primzahlen auch meine Lieblingszahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ab3c858-1a31-4eb5-b34f-522f97cf39b0",
                        "source_entry_id": "b1889266-501f-300b-862d-b61e37d7dd9c",
                        "source_sense_id": "b92455a3-ce53-3847-98a3-9b35c5a333dd",
                        "source_sense_description": "priemgetal",
                        "target_lang_word": "prime number",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prime number",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95206158-844a-3b96-b24a-51bb02bca874",
                                        "entry_id": "c374e709-4570-3061-b152-3373ecb23d4a",
                                        "glosses": [
                                            "Any natural number greater than 1 that cannot be formed by multiplying two smaller natural numbers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01133ae-71a1-41ff-8717-8da9a7136fa5",
                                                "sense_id": "95206158-844a-3b96-b24a-51bb02bca874",
                                                "text": "The fundamental theorem of arithmetic states that every natural number greater than 1 can be factorized into prime numbers in a way that is unique up to the order in which the factors are written."
                                            },
                                            {
                                                "example_id": "93b3d6cd-b434-46f8-bbb9-76e8813910c5",
                                                "sense_id": "95206158-844a-3b96-b24a-51bb02bca874",
                                                "text": "2007, James Alfred Walker, Julian Francis Miller, Predicting Prime Numbers Using Cartesian Genetic Programming, Marc Ebner, Michael O'Neill, Anikó Ekárt, Anna Isabel Esparcia-Alcázar, Leonardo Vanneschi (editors), Genetic Programming: 10th European Conference, EuroGP 2007, Proceedings, Springer, LNCS 4445, page 215,\nAs the evolved solution for the first 16 prime numbers was capable of accepting inputs up to 31, we decided to extend the experiment to see how the solution generalised on 15 previously unseen inputs (just as we did with the integer-based approach). From the 15 unseen inputs, 7 of the predicted 15 outputs were prime numbers, which is just below 50%, indicating that the solution had learned something about \"primeness\" or favoured prime numbers."
                                            },
                                            {
                                                "example_id": "2f0b3eda-8414-4faf-9fb7-9e73ec5839b2",
                                                "sense_id": "95206158-844a-3b96-b24a-51bb02bca874",
                                                "text": "The most common definition of a prime number used in school seems to be 'an integer whose only factors are one and itself', which unfortunately leaves open the question of whether one is itself a prime number. Until the nineteenth century, most mathematicians regarded one as a prime number – Henri Lebesgue (1875–1941) is often said to be the last professional mathematician to call one prime – so it is a little unfair to regard learners as silly for thinking this today, or for questioning why we do not now regard one as a prime number – it is still a good question."
                                            },
                                            {
                                                "example_id": "81825316-1961-458d-8aba-b06cf599aa34",
                                                "sense_id": "95206158-844a-3b96-b24a-51bb02bca874",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "715c854c-f5d4-3602-809b-ef4c3d9cbf75",
                                        "entry_id": "c374e709-4570-3061-b152-3373ecb23d4a",
                                        "glosses": [
                                            "Any natural number (including 1) that is divisible only by itself and 1."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c7c01ce-19c3-43dc-85ba-09a66481fc0b",
                        "source_entry_id": "b1889266-501f-300b-862d-b61e37d7dd9c",
                        "source_sense_id": "b92455a3-ce53-3847-98a3-9b35c5a333dd",
                        "source_sense_description": "priemgetal",
                        "target_lang_word": "nombre premier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nombre premier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42ff667e-7d8d-3a08-9ae5-096ccfe05efc",
                                        "entry_id": "26da1243-b339-32cf-b49d-127115102c43",
                                        "glosses": [
                                            "Entier naturel possédant exactement deux diviseurs entiers positifs distincts, l’unité et lui-même."
                                        ],
                                        "tags": [],
                                        "note": "Cette définition ne comprend pas le nombre 1",
                                        "examples": [
                                            {
                                                "example_id": "4edbce0c-84e3-4bba-9ace-7faa60600f61",
                                                "sense_id": "42ff667e-7d8d-3a08-9ae5-096ccfe05efc",
                                                "text": "[…] ie di donc premierement que le nõbre premier n’a autre meſure que l'vnité, tel qu’eſt, 2, 3, 5 &c."
                                            },
                                            {
                                                "example_id": "e0c701f2-d8b8-4043-9d7d-4e24023f5a20",
                                                "sense_id": "42ff667e-7d8d-3a08-9ae5-096ccfe05efc",
                                                "text": "L’ensemble des nombres premiers est un ensemble infini."
                                            },
                                            {
                                                "example_id": "0255e558-29a8-4da5-ab9e-2439b53351cc",
                                                "sense_id": "42ff667e-7d8d-3a08-9ae5-096ccfe05efc",
                                                "text": "[La spirale d’Ulam] consiste à écrire les nombres entiers en suivant une spirale tournant dans le sens trigonométrique, et à signaler les nombres premiers par un point de couleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61ad6fa-13fc-3015-9d00-6d42ab7bd0ab",
                                        "entry_id": "26da1243-b339-32cf-b49d-127115102c43",
                                        "glosses": [
                                            "Entier naturel ne possédant comme diviseurs entiers positifs que l’unité et lui-même."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "note": "Cette définition comprend le nombre 1",
                                        "examples": [
                                            {
                                                "example_id": "63046623-3603-4c32-a1b4-cf4f60be53a5",
                                                "sense_id": "d61ad6fa-13fc-3015-9d00-6d42ab7bd0ab",
                                                "text": "Je nommerai nombres simples ou premiers, ceux qu’on ne peut diviser au juste ou sans reste par aucun autre entier que par eux-mêmes ou par l’unité; comme chacun des dix 1, 2, 3, 5, 7, 11, 13, 17, 19, 23."
                                            },
                                            {
                                                "example_id": "f56bbd76-741f-46ed-bf04-3f7d72cfa71a",
                                                "sense_id": "d61ad6fa-13fc-3015-9d00-6d42ab7bd0ab",
                                                "text": "Cela n’empêche pas qu’on ne puisse découvrir et démontrer un grand nombre de propriétés générales des nombres premiers , lesquelles répandent un grand jour sur leur nature."
                                            },
                                            {
                                                "example_id": "3b469c6d-1355-414b-8b8d-bf52830d431d",
                                                "sense_id": "d61ad6fa-13fc-3015-9d00-6d42ab7bd0ab",
                                                "text": "Les jeunes gens qui savent déjà extraire des racines carrées reconnaîtront sans peine, d’après la remarque précédente, que 113, 719, 977, 3329, 8123…, sont des nombres premiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
