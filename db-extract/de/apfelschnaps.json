                "senses": [
                    {
                        "sense_id": "7e3d52cb-f2fd-3899-9239-8b60cde01322",
                        "entry_id": "9fcbfe51-d1bd-39ca-9b56-e58f2c3fe1f3",
                        "glosses": [
                            "aus Apfelwein gebranntes, stark alkoholhaltiges Getränk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f67d6bd-cb99-4285-8a8d-fd0f35b9c498",
                                "sense_id": "7e3d52cb-f2fd-3899-9239-8b60cde01322",
                                "text": "„Die Gäste stürzen ihren Apfelschnaps hinunter, seufzen und torkeln hinaus.“"
                            },
                            {
                                "example_id": "4d81c3c9-69ee-4dc5-bffd-7ba280fc575f",
                                "sense_id": "7e3d52cb-f2fd-3899-9239-8b60cde01322",
                                "text": "„Hab auch noch einen Apfelschnaps, der wird dir guttun.“"
                            },
                            {
                                "example_id": "76f2f059-08c6-4bb2-9870-f8b2c1b1ed19",
                                "sense_id": "7e3d52cb-f2fd-3899-9239-8b60cde01322",
                                "text": "„Wenn er seinen Apfelschnaps trank, schwiegen alle und warteten.“"
                            },
                            {
                                "example_id": "935dd847-382f-4824-801c-83d1b9e119cc",
                                "sense_id": "7e3d52cb-f2fd-3899-9239-8b60cde01322",
                                "text": "„Stets stand ein Gläschen Apfelschnaps bereit, noch bei den Ärmsten.“"
                            },
                            {
                                "example_id": "583f908c-69c9-40cd-bab7-61a29bd20c5f",
                                "sense_id": "7e3d52cb-f2fd-3899-9239-8b60cde01322",
                                "text": "„Die Diebe haben lediglich einen Laptop, ein paar alte Handys und mehrere Flaschen selbstgebrannten Apfelschnaps entwendet, aber Ärger und Verunsicherung wiegen schwerer als der materielle Verlust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
