                        "glosses": [
                            "instelling van een mobiele telefoon waarbij de telefoon bij een oproep gaat trillen i.p.v. dat er een betoon wordt afgespeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4be6301-2cf2-4328-a216-4957497b1ddf",
                                "sense_id": "efc17986-bd41-3428-8d79-fd83da32db06",
                                "text": "Zet je mobiel op trilstand als je op kraambezoek bent, zodat je een en al oog en oor bent voor de ouders."
                            },
                            {
                                "example_id": "c7e6e64c-0937-401a-af9a-59d6c5200d55",
                                "sense_id": "efc17986-bd41-3428-8d79-fd83da32db06",
                                "text": "Sturris is onder de indruk van de vredige sfeer in het crematorium. Uit respect voor de stilte heeft ze haar gsm op de trilstand gezet."
                            },
                            {
                                "example_id": "582d17f2-9e82-4976-a07b-9b2be7027737",
                                "sense_id": "efc17986-bd41-3428-8d79-fd83da32db06",
                                "text": "Via een webinterface kunnen gebruikers die hun telefoon verloren zijn een ringtone afspelen, ook wanneer de telefoon op stil of de trilstand staat. Ze kunnen ook de locatie opzoeken via Google Maps. Blijft het toestel spoorloos, dan kan het volledig worden gewist, bijvoorbeeld bij een diefstal."
                            }
                        ]
                    }
