                        ],
                        "form": "more identifiable"
                    },
                    {
                        "form_id": "cda0351a-3f64-4e24-97a2-d49818577f04",
                        "entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most identifiable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "glosses": [
                            "Capable of being distinguished and named."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d014c97-b374-450d-a679-8becf23ff1e4",
                                "sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                                "text": "I don't know where he was from because he had no identifiable accent."
                            },
                            {
                                "example_id": "234239b1-25b4-4ac0-9d6d-8e6dd2f77982",
                                "sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                                "text": "We acknowledge that the tidal volume utilized for the SHVT group is far from the one utilized in the clinical setting, however, this choice was based on our previous studies supporting that 20 ml/kg was the minimal level of overdistention in healthy rats causing an identifiable injury comparable to that experienced by ALI patients."
                            },
                            {
                                "example_id": "108d540b-295e-45e4-b305-4a6dc5bccb9d",
                                "sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                                "text": "The only other identifiable plant macrofossil present was a nutlet of club-rush that was morphologically most similar to grey club-rush (Schoenoplectus cf tabernaemontani). This form of club-rush is most often found near the sea, although it also grows in marshes and dune-slacks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1531cf7-b480-436d-a840-389469d0d385",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "source_sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "source_sense_description": "capable of being distinguished and named",
                        "target_lang_word": "identifikovatelný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "21a78f7c-02b3-4951-aa69-dbf7707ac358",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "source_sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "source_sense_description": "capable of being distinguished and named",
                        "target_lang_word": "herkenbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herkenbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                                        "entry_id": "567cf4cf-1ffb-3108-adc2-145bc67ae466",
                                        "glosses": [
                                            "zichtbaar, iets of iemand kunnen herkennen, waarneembaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ecb488-7f8c-4010-aeee-e1c5f2d0d550",
                                                "sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                                                "text": "Dat heb ik vaker meegemaakt, het is een herkenbare situatie."
                                            },
                                            {
                                                "example_id": "2f7127c9-fcda-4ed9-a456-6d2e72bd2737",
                                                "sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                                                "text": "Zijn grote mond, iets te harde stem, irritante enthousiasme en overdreven positiviteit waren herkenbaar maar ook zijn ongepolijste bravoure, idealisme en romantische dromen om de wereld te verbeteren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "115615d4-3238-4d9a-8fdb-482f565b2fd5",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "source_sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "source_sense_description": "capable of being distinguished and named",
                        "target_lang_word": "identificeerbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identificeerbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2aede2a-c5d1-3511-a820-d6fb8011c5de",
                                        "entry_id": "ecf2cfa5-ca8c-3804-974c-60a869f008ee",
                                        "glosses": [
                                            "kunnen bepalen wie of wat iets of iemand is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "123a6239-ddf0-482f-b61d-f7a3f6bbcc30",
                                                "sense_id": "a2aede2a-c5d1-3511-a820-d6fb8011c5de",
                                                "text": "Dat ligt anders als er nadere gegevens worden meegestuurd, zoals het geslacht en de leeftijd van de patiënt. In dat geval zou hij of zij, dankzij de combinatie van alle gegevens, indirect identificeerbaar kunnen zijn. Wat ook zou kunnen, is dat er een unieke tatoeage te zien is, of dat de foto dankzij de metagegevens (datum, tijd, afzender, ontvanger) van het bericht toch herleid kan worden tot een persoon. Kortom, bij dergelijk appjes kan sprake zijn van de verwerking van medische persoonsgegevens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3613eebf-a7af-49cb-b0ea-c3d67f091392",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "source_sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "source_sense_description": "capable of being distinguished and named",
                        "target_lang_word": "identifiable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identifiable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd910b2d-bc4e-36a8-90dc-ba57b3b97c0d",
                                        "entry_id": "3cc7160a-5d4e-3f09-8b4e-352b1b07ac37",
                                        "glosses": [
                                            "Qu’il est possible d’identifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9808505d-e6a7-4212-96a5-4a94431debf5",
                                                "sense_id": "fd910b2d-bc4e-36a8-90dc-ba57b3b97c0d",
                                                "text": "À contre-lumière, elle était difficilement identifiable. Sa silhouette montrait les contours d'une longue robe descendant jusqu'aux chevilles, une écharpe autour du cou et une épaisse tignasse tombant sur les épaules."
                                            },
                                            {
                                                "example_id": "9958e403-6e5d-4d90-927d-b9ed165b08a7",
                                                "sense_id": "fd910b2d-bc4e-36a8-90dc-ba57b3b97c0d",
                                                "text": "Le délégué à ce morceau d’Éden en godet est aisément identifiable à son gilet en mailles polaires vert de gris pissouille et à sa gueule de six pieds de long."
                                            },
                                            {
                                                "example_id": "d9b9f89e-3515-4927-a84a-b04d675531e5",
                                                "sense_id": "fd910b2d-bc4e-36a8-90dc-ba57b3b97c0d",
                                                "text": "Ce mercredi soir vers 18 h 30, … la découverte d’une valise sans propriétaire identifiable a conduit à la mise en sécurité d’une centaine de mètres du Quai Vauban dans l’attente de l'intervention des secours."
                                            },
                                            {
                                                "example_id": "351d0efe-86b2-495a-ad22-4a40831dac66",
                                                "sense_id": "fd910b2d-bc4e-36a8-90dc-ba57b3b97c0d",
                                                "text": "Selon Rappel Conso, ces compotes présentent une date limite de consommation fixée en septembre 2024 et le lot concerné est identifiable sous le numéro LFK0002202012X."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "811d2851-63ef-47f9-a38b-c132b58e7095",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "source_sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "source_sense_description": "capable of being distinguished and named",
                        "target_lang_word": "identifizierbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identifizierbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "331805af-b4b4-3a1f-bc0f-c290606509b6",
                                        "entry_id": "6c45ff4d-8f9a-35d3-940a-cee8f70c689d",
                                        "glosses": [
                                            "so beschaffen, dass eine Identifizierung möglich ist; die Identität festgestellt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97bc4703-9248-4f96-90dd-e1d5b9524da2",
                                                "sense_id": "331805af-b4b4-3a1f-bc0f-c290606509b6",
                                                "text": "„Während die klassische Populationsgenetik anhand der Mendelschen Regeln die Vererbung vorwiegend leicht identifizierbarer, qualitativer Merkmale behandelt, stellt die quantitative Genetik eine Erweiterung der Mendelschen Genetik dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a55873d-b7c4-4bb4-a607-a21c6625cd26",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
                        "source_sense_id": "5baa5b04-8759-39b5-8c1e-b055dcb90854",
                        "source_sense_description": "capable of being distinguished and named",
                        "target_lang_word": "erkennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erkennbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b21e0bb9-62e4-33be-8a6c-a12b0df7104f",
                                        "entry_id": "3502a926-dcab-35f5-9263-f2a94af6018d",
                                        "glosses": [
                                            "so deutlich, dass man weiß, was man vor seinen Augen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde7cd95-0758-4bf5-b9fa-f6df21c673fa",
                                                "sense_id": "b21e0bb9-62e4-33be-8a6c-a12b0df7104f",
                                                "text": "„Der Noniusgrenzwinkel ist der kleinste Sehwinkel, unter dem eine gegenseitige Versetzung von Objekten in einer frontoparallelen Ebene erkennbar wird.“"
                                            },
                                            {
                                                "example_id": "494077f7-4b33-4c06-9293-672c22537d94",
                                                "sense_id": "b21e0bb9-62e4-33be-8a6c-a12b0df7104f",
                                                "text": "„Wer mit Sprache umzugehen versteht, bei Mathematik und Physik aber eher kein Talent hat, tut gut daran, den erkennbaren Intelligenz-Schwerpunkt mit seinen Interessen zusammenzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d70ddd9c-7680-4820-9513-f36b849f7930",
                        "source_entry_id": "d1bd0558-807e-3107-9975-77c3927d2d7f",
