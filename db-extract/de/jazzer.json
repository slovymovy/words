                        "examples": [
                            {
                                "example_id": "a013f247-ed0a-4e9a-a853-bda24603195d",
                                "sense_id": "7aafad05-aac0-36c1-9e7a-3d3b8a0c1ad5",
                                "text": "Miles Davis war ein weltbekannter Jazzer."
                            },
                            {
                                "example_id": "9491989b-f3be-4093-b287-66a775325663",
                                "sense_id": "7aafad05-aac0-36c1-9e7a-3d3b8a0c1ad5",
                                "text": "„Zdenek, damals König der Jazzer, lebte jetzt dort irgendwo auf einem gottverdammten Dorf am Arsch der Welt.“"
                            },
                            {
                                "example_id": "fff15bd6-83e8-4c72-b1b2-86b67a46f8cc",
                                "sense_id": "7aafad05-aac0-36c1-9e7a-3d3b8a0c1ad5",
                                "text": "„Gerd Schumann gehörte zu den Jazzern, die in den späten 40ern zu den »Bebop Kings« gehörten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
