{
    "word_family": [
        "socking",
        "sockless",
        "windsock",
        "unsock"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4120a4cc-b4d4-3451-9415-c1072a61ce6d",
                    "sense_definition": "A knitted or woven covering for the foot.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a new pair of <w>socks</w> because mine have holes in them.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новую пару <w>носков</w>, потому что в моих дырки."
                            }
                        },
                        {
                            "text": "He pulled on his thick wool <w>socks</w> before putting on his winter boots.",
                            "target_lang_translations": {
                                "ru": "Он натянул толстые шерстяные <w>носки</w>, прежде чем надеть зимние ботинки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of socks",
                        "wool socks",
                        "cotton socks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вязаное или тканое изделие, закрывающее стопу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носок",
                                "target_lang_sense_clarification": "предмет одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "490a0446-322c-369e-bea1-8ee2a9e3cc04",
                    "sense_definition": "A sock puppet; an additional online account used by one person to create the illusion of support or to deceive others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moderator banned the user for using a <w>sock</w> to bypass the previous suspension.",
                            "target_lang_translations": {
                                "ru": "Модератор забанил пользователя за использование <w>виртуала</w> для обхода предыдущей блокировки."
                            }
                        },
                        {
                            "text": "It was obvious that the positive comments were all written by the same person using a <w>sock</w> account.",
                            "target_lang_translations": {
                                "ru": "Было очевидно, что все положительные комментарии были написаны одним и тем же человеком с <w>фейкового</w> аккаунта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sock account"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительный аккаунт в интернете, используемый одним человеком для создания иллюзии поддержки или обмана других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виртуал",
                                "target_lang_sense_clarification": "подставной аккаунт"
                            },
                            {
                                "target_lang_word": "сокпаппет",
                                "target_lang_sense_clarification": "интернет-сленг"
                            },
                            {
                                "target_lang_word": "фейк",
                                "target_lang_sense_clarification": "поддельный профиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b6cf0b-5115-3900-b67f-88d4ca5fc3cb",
                    "sense_definition": "A violent blow or a punch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the bully a hard <w>sock</w> in the jaw to defend himself.",
                            "target_lang_translations": {
                                "ru": "Он нанес хулигану сильный <w>удар</w> в челюсть, чтобы защитить себя."
                            }
                        },
                        {
                            "text": "The boxer landed a powerful <w>sock</w> that ended the match instantly.",
                            "target_lang_translations": {
                                "ru": "Боксер нанес мощный <w>удар</w>, который мгновенно завершил поединок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sock in the jaw"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for a punch"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный удар или удар кулаком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "сильный толчок или затрещина"
                            },
                            {
                                "target_lang_word": "затрещина",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "тумак",
                                "target_lang_sense_clarification": "удар кулаком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4855333-a9b5-3a5a-8ba3-710aa5acac84",
                    "sense_definition": "A patch of differently colored fur, usually white, on the lower leg of a cat or dog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_markings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitten is mostly black but has four white <w>socks</w> on its paws.",
                            "target_lang_translations": {
                                "ru": "Котенок в основном черный, но у него четыре белых <w>носочка</w> на лапках."
                            }
                        },
                        {
                            "text": "We named the puppy Boots because of the white <w>sock</w> on his front leg.",
                            "target_lang_translations": {
                                "ru": "Мы назвали щенка Бутс из-за белого <w>носочка</w> на передней лапе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "white socks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятно шерсти другого цвета (обычно белого) на нижней части лапы кошки или собаки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носочек",
                                "target_lang_sense_clarification": "окрас лап животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1be1c323-379c-37d7-bab1-6b41f1126134",
                    "sense_definition": "A soft cylindrical cover or sleeve for a microphone used to reduce wind or breath noise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "audio_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound engineer told me to put the <w>sock</w> on the mic to stop the popping sounds.",
                            "target_lang_translations": {
                                "ru": "Звукорежиссер сказал мне надеть <w>ветрозащиту</w> на микрофон, чтобы убрать взрывные звуки."
                            }
                        },
                        {
                            "text": "Even with the <w>sock</w> on, the heavy wind made recording outdoors very difficult.",
                            "target_lang_translations": {
                                "ru": "Даже с <w>насадкой</w> сильный ветер очень мешал записи на улице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "microphone sock"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий цилиндрический чехол для микрофона, используемый для уменьшения шума ветра или дыхания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветрозащита",
                                "target_lang_sense_clarification": "для микрофона"
                            },
                            {
                                "target_lang_word": "насадка",
                                "target_lang_sense_clarification": "поролоновый чехол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97db7ea0-439a-3c64-9fda-02885c7dfc0b",
                    "sense_definition": "A windsock; a conical tube used to indicate wind direction and speed at an airfield.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot checked the <w>sock</w> to see if the tailwind was too strong for takeoff.",
                            "target_lang_translations": {
                                "ru": "Пилот проверил <w>ветроуказатель</w>, чтобы понять, не слишком ли силен попутный ветер для взлета."
                            }
                        },
                        {
                            "text": "The orange <w>sock</w> was limp, indicating there was almost no wind at the landing strip.",
                            "target_lang_translations": {
                                "ru": "Оранжевый <w>конус</w> висел неподвижно, что указывало на почти полное отсутствие ветра на посадочной полосе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "aviation jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конусообразная труба, используемая для указания направления и скорости ветра на аэродроме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветроуказатель",
                                "target_lang_sense_clarification": "авиационный конус"
                            },
                            {
                                "target_lang_word": "колдун",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c246539d-aab0-3053-abe8-2f5cf4f107eb",
                    "sense_definition": "To hit or strike someone or something violently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you keep insulting me, I am going to <w>sock</w> you in the face.",
                            "target_lang_translations": {
                                "ru": "Если ты продолжишь меня оскорблять, я <w>врежу</w> тебе по лицу."
                            }
                        },
                        {
                            "text": "He <w>socked</w> the punching bag with all his strength during the workout.",
                            "target_lang_translations": {
                                "ru": "Он со всей силы <w>бил</w> по боксерской груше во время тренировки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sock someone in the face",
                        "sock it to"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "нанести удар"
                            },
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "съездить",
                                "target_lang_sense_clarification": "ударить по лицу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "205cb3ca-88c8-3778-ae3e-ec57a6e92467",
                    "sense_definition": "Extremely successful or impressive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band gave a <w>sock</w> performance that left the entire audience cheering for more.",
                            "target_lang_translations": {
                                "ru": "Группа выдала <w>потрясающее</w> выступление, после которого все зрители требовали продолжения."
                            }
                        },
                        {
                            "text": "The reviewer described the new play as a <w>sock</w> hit for the season.",
                            "target_lang_translations": {
                                "ru": "Критик описал новую пьесу как главный <w>хит</w> сезона."
                            }
                        }
                    ],
                    "synonyms": [
                        "socko"
                    ],
                    "common_phrases": [
                        "sock performance"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mid-20th century slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно успешный или впечатляющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "очень успешный"
                            },
                            {
                                "target_lang_word": "хитовый",
                                "target_lang_sense_clarification": "популярный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fe4d3381-2ed8-38b5-bd79-842908d6948d",
                    "sense_definition": "The sound of a punch or a powerful blow hitting a target.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comic book panel showed the hero hitting the villain with a loud <w>Sock</w>!",
                            "target_lang_translations": {
                                "ru": "На панели комикса было показано, как герой бьет злодея с громким «<w>Бац</w>!»"
                            }
                        },
                        {
                            "text": "We heard a dull <w>sock</w> as the two players collided on the field.",
                            "target_lang_translations": {
                                "ru": "Мы услышали глухой <w>удар</w>, когда два игрока столкнулись на поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук удара кулаком или мощного удара по цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бац",
                                "target_lang_sense_clarification": "звукоподражание удару"
                            },
                            {
                                "target_lang_word": "хлоп",
                                "target_lang_sense_clarification": "звук удара"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}