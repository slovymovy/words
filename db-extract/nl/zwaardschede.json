                        "examples": [
                            {
                                "example_id": "e09e4730-35cb-48e6-9b27-307dec528d89",
                                "sense_id": "42bffe89-1ca1-3f19-98f3-a8dc8080631c",
                                "text": "Door de Russische inlijving van de Krim is juridisch getouwtrek ontstaan over de collectie, met onder meer een gouden zwaardschede en een pronkhelm en talloze juwelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a95dbbd7-4b50-34d9-8af3-b9bb9b0bfe8f",
                        "entry_id": "e02b7ab5-7d94-3b8b-9edd-d470e32f74e7",
                        "glosses": [
                            "Ensis soort weekdier dat leeft in een langwerpige schelp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6700f8-db73-4418-b22c-0a1770cd1fb4",
                                "sense_id": "a95dbbd7-4b50-34d9-8af3-b9bb9b0bfe8f",
                                "text": "Amerikaanse zwaardschedes, nonnetjes, witte dunschalen, fluwelen zeemuizen, zaagjes, muiltjes, slangsterren, zwemkrabben en platvissen. Mensen die graag het strand afschuimen op zoek naar iets bijzonders, konden na de zomerstorm van eind juli hun hart ophalen: vele duizenden, mogelijk miljoenen zeedieren spoelden aan op de Nederlandse stranden. Een „rijkgevulde schatkamer”, meldt Natuurbericht.nl zondag."
                            }
                        ]
                    }
