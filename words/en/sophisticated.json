{
    "word_family": [
        "sophistication",
        "sophisticate",
        "sophistry"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e9a9b37-3101-313f-bfc6-d983ad3bd5b0",
                    "sense_definition": "Having obtained worldly experience and knowledge of culture and fashion; not naive.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "worldly_cultured",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>sophisticated</w> traveler who knows how to behave in any country.",
                            "target_lang_translations": {
                                "ru": "Она <w>искушённая</w> путешественница, которая знает, как вести себя в любой стране.",
                                "zh": "她是一位<w>老练</w>的旅行者，知道在任何国家该如何表现。"
                            }
                        },
                        {
                            "text": "The party was full of <w>sophisticated</w> guests discussing art and politics.",
                            "target_lang_translations": {
                                "ru": "На вечеринке было много <w>искушённых</w> гостей, обсуждающих искусство и политику.",
                                "zh": "聚会上满是<w>世故</w>的宾客，他们正在讨论艺术和政治。"
                            }
                        }
                    ],
                    "synonyms": [
                        "worldly"
                    ],
                    "antonyms": [
                        "provincial"
                    ],
                    "common_phrases": [
                        "sophisticated lady",
                        "sophisticated audience",
                        "sophisticated traveler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий житейским опытом и знаниями в области культуры и моды; не наивный.",
                        "zh": "拥有丰富的社会阅历和文化知识；不天真。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искушённый",
                                "target_lang_sense_clarification": "обладающий большим опытом и знаниями"
                            },
                            {
                                "target_lang_word": "опытный",
                                "target_lang_sense_clarification": "знающий жизнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老练",
                                "target_lang_sense_clarification": "经验丰富，处事圆滑"
                            },
                            {
                                "target_lang_word": "世故",
                                "target_lang_sense_clarification": "阅历深，懂得人情世故"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc748a7d-49fe-3722-973e-0ef7090f7f90",
                    "sense_definition": "Highly developed and complicated, especially regarding technology or systems.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "complex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company uses <w>sophisticated</w> software to track customer orders.",
                            "target_lang_translations": {
                                "ru": "Компания использует <w>сложное</w> программное обеспечение для отслеживания заказов клиентов.",
                                "zh": "该公司使用<w>复杂</w>的软件来追踪客户订单。"
                            }
                        },
                        {
                            "text": "Modern cars are equipped with highly <w>sophisticated</w> safety systems.",
                            "target_lang_translations": {
                                "ru": "Современные автомобили оснащены высоко <w>технологичными</w> системами безопасности.",
                                "zh": "现代汽车配备了高度<w>先进</w>的安全系统。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sophisticated technology",
                        "sophisticated system",
                        "highly sophisticated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокоразвитый и сложный, особенно в отношении технологий или систем.",
                        "zh": "高度发达且复杂，尤指技术或系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "имеющий сложную структуру или устройство"
                            },
                            {
                                "target_lang_word": "высокотехнологичный",
                                "target_lang_sense_clarification": "основанный на передовых технологиях"
                            },
                            {
                                "target_lang_word": "продвинутый",
                                "target_lang_sense_clarification": "современный, развитый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "结构或系统精密"
                            },
                            {
                                "target_lang_word": "先进",
                                "target_lang_sense_clarification": "技术水平高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0857aa55-18f1-356a-9c34-50bf522df14b",
                    "sense_definition": "Showing or appealing to high-class taste, culture, and elegance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "worldly_cultured",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant offers a <w>sophisticated</w> menu that appeals to food lovers.",
                            "target_lang_translations": {
                                "ru": "Ресторан предлагает <w>изысканное</w> меню, которое нравится гурманам.",
                                "zh": "这家餐厅提供一份<w>精致</w>的菜单，深受美食爱好者的喜爱。"
                            }
                        },
                        {
                            "text": "Her apartment is decorated in a very <w>sophisticated</w> style.",
                            "target_lang_translations": {
                                "ru": "Её квартира оформлена в очень <w>утончённом</w> стиле.",
                                "zh": "她的公寓装修风格非常<w>高雅</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sophisticated taste",
                        "sophisticated style",
                        "sophisticated design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий или апеллирующий к высокому вкусу, культуре и элегантности.",
                        "zh": "展现或迎合高雅品味、文化和格调。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утончённый",
                                "target_lang_sense_clarification": "отличающийся тонким вкусом"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "изящный, элегантный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精致",
                                "target_lang_sense_clarification": "优美、考究"
                            },
                            {
                                "target_lang_word": "高雅",
                                "target_lang_sense_clarification": "有品位，有格调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f7283e-e22d-366e-ad4b-f12f179b164b",
                    "sense_definition": "Mixed with a foreign or inferior substance; not pure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inspector found that the <w>sophisticated</w> wine contained added sugar.",
                            "target_lang_translations": {
                                "ru": "Инспектор обнаружил, что <w>фальсифицированное</w> вино содержало добавленный сахар.",
                                "zh": "检查员发现这瓶<w>掺假</w>的葡萄酒里添加了糖。"
                            }
                        },
                        {
                            "text": "He refused to buy the <w>sophisticated</w> gold because it was not genuine.",
                            "target_lang_translations": {
                                "ru": "Он отказался покупать <w>поддельное</w> золото, потому что оно было ненастоящим.",
                                "zh": "他拒绝购买那块<w>伪造</w>的黄金，因为它不是真金。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешанный с посторонним или менее качественным веществом; нечистый.",
                        "zh": "掺杂了外来或劣质物质；不纯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальсифицированный",
                                "target_lang_sense_clarification": "поддельный"
                            },
                            {
                                "target_lang_word": "разбавленный",
                                "target_lang_sense_clarification": "с примесями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掺假",
                                "target_lang_sense_clarification": "混入杂质"
                            },
                            {
                                "target_lang_word": "伪造",
                                "target_lang_sense_clarification": "非原装，不纯正"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "339a38e0-6172-3322-8c97-82f084b835b4",
                    "sense_definition": "Having its meaning changed in a deceptive or misleading way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deceptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract relied on a <w>sophisticated</w> interpretation of the law.",
                            "target_lang_translations": {
                                "ru": "Контракт опирался на <w>изощрённое</w> толкование закона.",
                                "zh": "这份合同依赖于对法律的一种<w>诡辩</w>式解读。"
                            }
                        },
                        {
                            "text": "His <w>sophisticated</w> argument was designed to confuse the jury.",
                            "target_lang_translations": {
                                "ru": "Его <w>хитроумный</w> аргумент был рассчитан на то, чтобы запутать присяжных.",
                                "zh": "他那<w>狡黠</w>的论点旨在迷惑陪审团。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий искажённый смысл с целью ввести в заблуждение.",
                        "zh": "以欺骗或误导的方式改变其含义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изощрённый",
                                "target_lang_sense_clarification": "хитроумный, казуистический"
                            },
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "намеренно усложнённый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诡辩",
                                "target_lang_sense_clarification": "用似是而非的论点进行辩解"
                            },
                            {
                                "target_lang_word": "狡黠",
                                "target_lang_sense_clarification": "带有欺骗性的复杂"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38dd3f84-56bd-3d12-b4ac-5e2a4c5f226d",
                    "sense_definition": "The simple past and past participle of <w>sophisticate</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>sophisticated</w> the language to appeal to an academic audience.",
                            "target_lang_translations": {
                                "ru": "Автор <w>усложнил</w> язык, чтобы привлечь академическую аудиторию.",
                                "zh": "作者<w>使</w>语言<w>复杂化</w>，以吸引学术受众。"
                            }
                        },
                        {
                            "text": "They <w>sophisticated</w> the machinery to improve its efficiency.",
                            "target_lang_translations": {
                                "ru": "Они <w>усовершенствовали</w> оборудование, чтобы повысить его эффективность.",
                                "zh": "他们<w>使</w>机器<w>精巧化</w>以提高其效率。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола sophisticate.",
                        "zh": "动词 sophisticate 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усложнил",
                                "target_lang_sense_clarification": "сделал более сложным"
                            },
                            {
                                "target_lang_word": "усовершенствовал",
                                "target_lang_sense_clarification": "улучшил технически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使复杂化",
                                "target_lang_sense_clarification": "增加难度或复杂程度"
                            },
                            {
                                "target_lang_word": "使精巧",
                                "target_lang_sense_clarification": "通过技术手段改进"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}