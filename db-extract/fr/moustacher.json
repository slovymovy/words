                "senses": [
                    {
                        "sense_id": "9167f183-4d42-3283-98fe-cd9019c387f3",
                        "entry_id": "069954d1-1274-339f-a4f1-cbccf07205fc",
                        "glosses": [
                            "Ajouter une moustache à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d7f0a6-9619-4b8f-a1b5-7fdc52170f3e",
                                "sense_id": "9167f183-4d42-3283-98fe-cd9019c387f3",
                                "text": "Pas de coup de feutre pour moustacher madame ou rajouter des canines de Dracula à monsieur."
                            },
                            {
                                "example_id": "5d39522b-d24f-4cb5-82a0-2054b136ccb5",
                                "sense_id": "9167f183-4d42-3283-98fe-cd9019c387f3",
                                "text": "Le site Moustache me propose par exemple de commander ou de télécharger des autocollants pour moustacher la pub."
                            },
                            {
                                "example_id": "7b4b2914-e844-4213-8ac6-920ae2dbdb62",
                                "sense_id": "9167f183-4d42-3283-98fe-cd9019c387f3",
                                "text": "Tu peux pas le vieillir un peu, le rider et le moustacher ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "517a9d37-8c40-359c-a01c-2f38e7e6d964",
                        "entry_id": "069954d1-1274-339f-a4f1-cbccf07205fc",
                        "glosses": [
                            "Gêner les communications voisines en débordant de sa fréquence radio."
                        ],
