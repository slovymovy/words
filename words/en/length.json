{
    "word_family": [
        "lengthen",
        "lengthy",
        "lengthwise"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77fb67a8-1ab4-3e62-a980-1464dcd37337",
                    "sense_definition": "The distance measured along the longest dimension of an object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>length</w> of the table is exactly two meters.",
                            "target_lang_translations": {
                                "ru": "<w>Длина</w> стола составляет ровно два метра.",
                                "zh": "这张桌子的<w>长度</w>正好是两米。"
                            }
                        },
                        {
                            "text": "Please measure the <w>length</w> and width of the room before buying the carpet.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, измерьте <w>длину</w> и ширину комнаты перед покупкой ковра.",
                                "zh": "买地毯前请先测量房间的<w>长度</w>和宽度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distance",
                        "longness"
                    ],
                    "antonyms": [
                        "width"
                    ],
                    "common_phrases": [
                        "total length",
                        "measure the length"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстояние, измеренное вдоль самого длинного измерения объекта.",
                        "zh": "物体最长维度上的测量距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "длина",
                                "target_lang_sense_clarification": "физический размер"
                            },
                            {
                                "target_lang_word": "протяженность",
                                "target_lang_sense_clarification": "расстояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长度",
                                "target_lang_sense_clarification": "物理尺寸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d66321ae-33a9-304f-8b34-149fa1799af9",
                    "sense_definition": "The duration or extent of time that something lasts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>length</w> of the movie was nearly three hours.",
                            "target_lang_translations": {
                                "ru": "<w>Продолжительность</w> фильма составила почти три часа.",
                                "zh": "这部电影的<w>时长</w>将近三个小时。"
                            }
                        },
                        {
                            "text": "Happiness makes up in height for what it lacks in <w>length</w>.",
                            "target_lang_translations": {
                                "ru": "Счастье восполняет высотой то, чего ему не хватает в <w>длительности</w>.",
                                "zh": "幸福在高度上弥补了它在<w>持续时间</w>上的不足。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "length of time",
                        "average length"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжительность или протяженность времени, в течение которого что-либо длится.",
                        "zh": "某事持续的时间或范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продолжительность",
                                "target_lang_sense_clarification": "время"
                            },
                            {
                                "target_lang_word": "длительность",
                                "target_lang_sense_clarification": "время"
                            },
                            {
                                "target_lang_word": "длина",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时长",
                                "target_lang_sense_clarification": "时间长度"
                            },
                            {
                                "target_lang_word": "持续时间",
                                "target_lang_sense_clarification": "时间跨度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4bea238-4011-3278-858a-b63b6360c09c",
                    "sense_definition": "The total extent or size of a piece of writing or work.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>length</w> of a book often determines how long it takes to read.",
                            "target_lang_translations": {
                                "ru": "<w>Объем</w> книги часто определяет, сколько времени уйдет на ее чтение.",
                                "zh": "书的<w>篇幅</w>往往决定了阅读所需的时间。"
                            }
                        },
                        {
                            "text": "The editor asked me to reduce the <w>length</w> of my article by half.",
                            "target_lang_translations": {
                                "ru": "Редактор попросил меня сократить <w>длину</w> моей статьи вдвое.",
                                "zh": "编辑让我把文章的<w>篇幅</w>缩减一半。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lengthiness"
                    ],
                    "common_phrases": [
                        "book length",
                        "article length"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий объем или размер письменного текста или произведения.",
                        "zh": "书面作品或文章的总篇幅或大小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объем",
                                "target_lang_sense_clarification": "текста или работы"
                            },
                            {
                                "target_lang_word": "длина",
                                "target_lang_sense_clarification": "текста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "篇幅",
                                "target_lang_sense_clarification": "文章或书的长度"
                            },
                            {
                                "target_lang_word": "字数",
                                "target_lang_sense_clarification": "书面内容的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc5e2267-6aea-309d-a4ad-d3d84afb8b86",
                    "sense_definition": "A specific physical piece or portion of something long.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cut a <w>length</w> of rope to tie the boxes together.",
                            "target_lang_translations": {
                                "ru": "Он отрезал <w>кусок</w> веревки, чтобы связать коробки вместе.",
                                "zh": "他剪了<w>一段</w>绳子把箱子捆在一起。"
                            }
                        },
                        {
                            "text": "She bought a <w>length</w> of silk to make a new dress.",
                            "target_lang_translations": {
                                "ru": "Она купила <w>отрез</w> шелка, чтобы сшить новое платье.",
                                "zh": "她买了<w>一块</w>丝绸来做新裙子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "length of rope",
                        "length of fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный физический кусок или отрезок чего-то длинного.",
                        "zh": "长条状物体的一段或一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрезок",
                                "target_lang_sense_clarification": "веревки, ткани"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一段",
                                "target_lang_sense_clarification": "绳子或布料的量"
                            },
                            {
                                "target_lang_word": "一块",
                                "target_lang_sense_clarification": "材料的片段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ce3a562-02fa-3039-b0b0-e19813358e5a",
                    "sense_definition": "The measure of a horse's body used to indicate the distance between competitors in a race.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "racing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The favorite won the race by a single <w>length</w>.",
                            "target_lang_translations": {
                                "ru": "Фаворит выиграл скачку с преимуществом в один <w>корпус</w>.",
                                "zh": "夺冠热门以一个<w>马身</w>的优势赢得了比赛。"
                            }
                        },
                        {
                            "text": "It was a close finish, with the second horse trailing by half a <w>length</w>.",
                            "target_lang_translations": {
                                "ru": "Это был напряженный финиш: вторая лошадь отстала на пол-<w>корпуса</w>.",
                                "zh": "终点竞争非常激烈，第二匹马落后了半个<w>马身</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "win by a length",
                        "half a length"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мера длины корпуса лошади, используемая для обозначения расстояния между участниками скачек.",
                        "zh": "赛马中以马身长度作为衡量参赛者之间距离的单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпус",
                                "target_lang_sense_clarification": "в скачках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马身",
                                "target_lang_sense_clarification": "赛马距离单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b1297a6-8310-311f-85cc-a4ae4f64468b",
                    "sense_definition": "In card games, the number of cards held in a particular suit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An artificial bid doesn't necessarily show <w>length</w> in the suit being bid.",
                            "target_lang_translations": {
                                "ru": "Искусственная заявка не обязательно означает <w>длину</w> в называемой масти.",
                                "zh": "人工叫牌并不一定代表所叫花色的<w>张数</w>。"
                            }
                        },
                        {
                            "text": "He had significant <w>length</w> in spades, holding six of them in his hand.",
                            "target_lang_translations": {
                                "ru": "У него была значительная <w>длина</w> в пиках — шесть карт на руках.",
                                "zh": "他在黑桃上有明显的<w>张数</w>优势，手里握着六张黑桃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "length in a suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "В карточных играх: количество карт одной масти на руках.",
                        "zh": "在纸牌游戏中，指手中持有某一种花色的牌的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "длина",
                                "target_lang_sense_clarification": "в масти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张数",
                                "target_lang_sense_clarification": "特定花色的牌数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c993fe40-284b-3070-889c-8fd9e570d8b5",
                    "sense_definition": "The amount of time the taste of wine lingers on the palate after swallowing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vintage is praised for its incredible <w>length</w> and complex finish.",
                            "target_lang_translations": {
                                "ru": "Это вино ценится за невероятную <w>длительность</w> вкуса и сложное послевкусие.",
                                "zh": "这款年份酒因其极长的<w>余味</w>和复杂的口感而备受赞誉。"
                            }
                        },
                        {
                            "text": "A wine with good <w>length</w> is usually a sign of high quality.",
                            "target_lang_translations": {
                                "ru": "Вино с хорошей <w>продолжительностью</w> вкуса обычно является признаком высокого качества.",
                                "zh": "具有良好<w>余味</w>的葡萄酒通常是高品质的标志。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine length"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, в течение которого вкус вина сохраняется на нёбе после проглатывания.",
                        "zh": "葡萄酒咽下后，余味在口腔中停留的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "длительность",
                                "target_lang_sense_clarification": "послевкусия вина"
                            },
                            {
                                "target_lang_word": "продолжительность",
                                "target_lang_sense_clarification": "вкуса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "余味",
                                "target_lang_sense_clarification": "酒的口感持续时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75d48042-ea45-3262-bfef-d83904d3730e",
                    "sense_definition": "A slang or informal term referring to a penis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The romance novel described the character's <w>length</w> in explicit detail.",
                            "target_lang_translations": {
                                "ru": "В любовном романе <w>длина</w> героя описывалась в откровенных подробностях.",
                                "zh": "那本言情小说对角色的<w>尺寸</w>进行了露骨的描写。"
                            }
                        },
                        {
                            "text": "He felt a surge of pride regarding his <w>length</w>.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал прилив гордости за свою <w>длину</w>.",
                                "zh": "他对自己那方面的<w>尺寸</w>感到一阵自豪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar or informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговый или неформальный термин, относящийся к пенису.",
                        "zh": "指代阴茎的俚语或非正式用语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "длина",
                                "target_lang_sense_clarification": "эвфемизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尺寸",
                                "target_lang_sense_clarification": "委婉语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e5338f26-2d70-32cd-8707-18e1ed012f2a",
                    "sense_definition": "An archaic or poetic way to say <w>lengthen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Short night, to-night, and <w>length</w> thyself to-morrow.",
                            "target_lang_translations": {
                                "ru": "Будь краткой, ночь, а завтра <w>удлинись</w>.",
                                "zh": "今夜虽短，明日且<w>延长</w>吧。"
                            }
                        },
                        {
                            "text": "He knows full well that life doth but <w>length</w> his pain.",
                            "target_lang_translations": {
                                "ru": "Он прекрасно знает, что жизнь лишь <w>продлевает</w> его мучения.",
                                "zh": "他深知生命只会<w>延长</w>他的痛苦。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичный или поэтический способ сказать «удлинять».",
                        "zh": "“延长”的古语或诗意表达。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удлинять",
                                "target_lang_sense_clarification": "архаизм"
                            },
                            {
                                "target_lang_word": "продлевать",
                                "target_lang_sense_clarification": "поэтическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "延长",
                                "target_lang_sense_clarification": "使变长"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}