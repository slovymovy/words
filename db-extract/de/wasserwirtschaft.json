                "senses": [
                    {
                        "sense_id": "9679b5a6-3dc5-3399-8ffc-7ddf15a2e579",
                        "entry_id": "d3f09c68-bff9-367e-bf1b-90afb86d3910",
                        "glosses": [
                            "Gesamtheit aller Maßnahmen bezüglich der Bewirtschaftung des Wassers, der Gewinnung, Verteilung, Nutzung und so weiter von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054003aa-189e-4721-9a69-71907d2fedcc",
                                "sense_id": "9679b5a6-3dc5-3399-8ffc-7ddf15a2e579",
                                "text": "„Holger Schüttrumpf leitet das Institut für Wasserbau und Wasserwirtschaft der RWTH Aachen und ist Präsident des Bundes der Ingenieure für Wasserwirtschaft, Abfallwirtschaft und Kulturbau (BWK).“"
                            },
                            {
                                "example_id": "4d992b82-9a6f-4e9a-89cd-080e9c155b8b",
                                "sense_id": "9679b5a6-3dc5-3399-8ffc-7ddf15a2e579",
                                "text": "„Andrzej Raganowicz ist Regierungsbaumeister auf dem Gebiet Wasserwirtschaft und ist im Fachbereich Kanalsanierung bei einem Zweckverband zur Abwasserbeseitigung tätig.“"
                            },
                            {
                                "example_id": "8896412c-baac-4aad-b326-4cf0b9553b56",
                                "sense_id": "9679b5a6-3dc5-3399-8ffc-7ddf15a2e579",
                                "text": "„Die Technische Hydraulik stellt dem planenden Ingenieur die hydromechanischen Berechnungsverfahren zur Verfügung, die in Wasserbau, Wasserwirtschaft, Abwassertechnik und Wasserversorgung benötigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
