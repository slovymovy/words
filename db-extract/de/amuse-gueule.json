                        "cross_references": [
                            {
                                "target_word": "amuse",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f4c5cdc-8b9e-3fe5-882f-3cc10e83b773",
                                        "entry_id": "2e3906d6-ae5c-3e60-a473-db97c0f7dbcb",
                                        "glosses": [
                                            "heel klein gerechtje voor de maaltijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153026df-d623-4921-adf5-94e9029f3ba1",
                                                "sense_id": "9f4c5cdc-8b9e-3fe5-882f-3cc10e83b773",
                                                "text": "De amuse is een klein glaasje heldere gerooktebietensoep. Na een glas champagne zegt de ober: „We willen graag beginnen. Moeten we rekening houden met allergieën?” „Nee, eh, maar krijgen we geen kaart?” vraagt mijn vrouw. De ober: „Ik ben de kaart.” De kaart voorziet in een achtgangenverrassingsmenu (35 euro) dat kan worden uitgebreid met een wijnarrangement (acht halve glazen 23,50 euro) of de bob-versie daarvan (acht kwart glazen 15 euro)."
                                            },
                                            {
                                                "example_id": "d81231c1-3366-46e2-98e1-d22a96ca5aea",
                                                "sense_id": "9f4c5cdc-8b9e-3fe5-882f-3cc10e83b773",
                                                "text": "De amuse van een bolletje kruidenmayonaise op een rond stukje kruidkoek, afgewerkt met een takje rozemarijn, is een kunstwerkje en smaakt ook nog eens voortreffelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
