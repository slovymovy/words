                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fastnachtsdienstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                        "entry_id": "57d33ed3-05ef-3f7f-89cf-d54f8a0ce630",
                                        "glosses": [
                                            "der Tag vor dem Aschermittwoch (als letzter Tag der Fastnacht/des Karneval)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3d5ff8-b115-449b-b414-8e71b0d1ffec",
                                                "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                                "text": "Am Fastnachtsdienstag findet der letzte Fastnachtsumzug statt."
                                            },
                                            {
                                                "example_id": "b4e38039-2b9a-4d87-acac-9366fad94d90",
                                                "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                                "text": "Am Abend des Fastnachtsdienstag wird das Ende der fünften Jahreszeit mit einer symbolischen Beerdigung der Fastnacht begangen."
                                            },
                                            {
                                                "example_id": "fb3f208d-1611-462e-ad23-4beed1922577",
                                                "sense_id": "db95ec72-3d2d-311e-a2f6-0b7838ab1722",
                                                "text": "Der frühestmögliche Termin für den Fastnachtsdienstag ist der 3. Februar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86ff5b9-c96d-4a51-bc35-51952c67bd3e",
                        "source_entry_id": "87b40fe9-a109-370b-8e1c-7c58aa25f4b2",
                        "source_sense_id": "e1e00add-cf0b-3832-a1ad-bd3c182c656d",
                        "source_sense_description": "Dernier jour du carnaval.",
                        "target_lang_word": "Mardi Gras",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mardi Gras",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e0e8ed4-1100-3ddf-bf08-9f6123e1948f",
                                        "entry_id": "8e7e8281-2975-37dd-bff1-97523eb5eda7",
                                        "glosses": [
                                            "The day when traditionally all fat and meat in the house were finished up, before Christians were banned from eating them during Lent, which commenced the following day on Ash Wednesday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a01ff8-31b1-4a26-b257-dfe6d92d202a",
                                                "sense_id": "1e0e8ed4-1100-3ddf-bf08-9f6123e1948f",
                                                "text": "Mardi-gras was ushered in with various ceremonies, offering a strange mixture of devotion and profaneness."
                                            },
                                            {
                                                "example_id": "bb449768-6cbe-47c7-ae28-fdf550b44871",
                                                "sense_id": "1e0e8ed4-1100-3ddf-bf08-9f6123e1948f",
                                                "text": "Dancing, fiddling, and feasting at Christmas and on Mardi-gras, before Lent, and feasting at or after Easter, are among their amusements or indulgences."
                                            },
                                            {
                                                "example_id": "b1b734d2-d24e-47f4-b36c-ec3c2d782157",
                                                "sense_id": "1e0e8ed4-1100-3ddf-bf08-9f6123e1948f",
                                                "text": "Today's wild Mardi Gras parades are much different than the original, more religious events of the Middle Ages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60df2b54-8fd3-3e74-87ab-08f0285f516b",
                                        "entry_id": "8e7e8281-2975-37dd-bff1-97523eb5eda7",
                                        "glosses": [
                                            "The last day of a carnival, traditionally the celebration immediately before the start of Lent when joy would be out of place for Christians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ba735c-6d76-4c0a-8a4b-6edac5839dbf",
                                                "sense_id": "60df2b54-8fd3-3e74-87ab-08f0285f516b",
                                                "text": "1823, Thomas Tryatall, The Parisian Carnival, read in The New Monthly Magazine, and Literary Journal, Oliver Everett, p. 90,\n\"Masks!\" exclaimed I; \"why, it isn't carnival time, is it?\" \"To be sure 'tis,\" replied he, \"dis is Mardi gras, de gayest of de gay days. Noting but pleasure, and fun, and hosh-posh.\""
                                            },
                                            {
                                                "example_id": "1d9eea95-69f7-4a70-8485-c77e12497338",
                                                "sense_id": "60df2b54-8fd3-3e74-87ab-08f0285f516b",
                                                "text": "1825, Thomas Colley Grattan, The Vouée au Blanc read in High-Ways and By-Ways, or, Tales of the Roadside: Picked Up in the French Provinces by a Walking Gentleman: Second Series: Volume III, Henry Colburn, p. 80,\nEvery body knows what an important epoch Mardi Gras forms in the annual enjoyments of the French. It is the last day of the carnival gaieties, and that which precedes the gloominess of Lent."
                                            },
                                            {
                                                "example_id": "c85baba0-9885-41ac-afde-36f3dcbaa0d8",
                                                "sense_id": "60df2b54-8fd3-3e74-87ab-08f0285f516b",
                                                "text": "Who could have believed, that saw her on the night of the Mardi Gras amid the revels at the Palace, seemingly joyous and happy as youth and innocence could make her, far excelling in loveliness all the fair dames gathered round her, that envy and hatred, and hot desire of revenge, were all hid beneath that seemingly guileless smile and treacherous abandon?"
                                            },
                                            {
                                                "example_id": "4d353404-b960-4b2e-8041-59da50742c20",
                                                "sense_id": "60df2b54-8fd3-3e74-87ab-08f0285f516b",
                                                "text": "As a result, Mardi Gras, the culmination of the Carnival season pre-ceding Lent, is observed in Pensacola."
                                            },
                                            {
                                                "example_id": "691c6708-d9d2-493b-8348-96b05d4e4fc0",
                                                "sense_id": "60df2b54-8fd3-3e74-87ab-08f0285f516b",
                                                "text": "The carnival moves through raucous celebrations climaxing on Mardi Gras (Fat Tuesday), and is over on Ash Wednesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a55128-0034-3064-9943-166e261ea9a0",
                                        "entry_id": "8e7e8281-2975-37dd-bff1-97523eb5eda7",
                                        "glosses": [
                                            "A carnival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698ce1a6-3020-4ca7-ac46-20eb5c82e7ac",
                                                "sense_id": "f3a55128-0034-3064-9943-166e261ea9a0",
                                                "text": "Mardi Gras has been in operation here for the past two weeks, and on Monday last the Trudor sports should have commenced."
                                            },
                                            {
                                                "example_id": "5328e24c-da28-4e61-b5e2-5a13c2aa160a",
                                                "sense_id": "f3a55128-0034-3064-9943-166e261ea9a0",
                                                "text": "SYDNEY GAY & LESBIAN MARDI GRAS Not just a famously spectacular parade and an all-night dance party in Oxford Street, this is a month-long festival in February that also features theatre, art, photography and music in a celebration of gay and lesbian life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86e7e17d-0b3d-47de-b181-bab6520f81a9",
                        "source_entry_id": "87b40fe9-a109-370b-8e1c-7c58aa25f4b2",
                        "source_sense_id": "e1e00add-cf0b-3832-a1ad-bd3c182c656d",
                        "source_sense_description": "Dernier jour du carnaval.",
                        "target_lang_word": "Shrove Tuesday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shrove Tuesday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9697cfa7-0e43-330c-bc83-d619d852a9d6",
                                        "entry_id": "01336316-95b2-380b-b147-336ebc426c7f",
                                        "glosses": [
                                            "The day before the beginning of Lent on Ash Wednesday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3e5003-f901-40bd-aaf4-42651da4038b",
                                                "sense_id": "9697cfa7-0e43-330c-bc83-d619d852a9d6",
                                                "text": "Observe when the Moon is new in February, the next Tuesday after is Shrove-tuesday: but if it change on Tuesday, then the next Tuesday following is Shrove-tuesday"
                                            },
                                            {
                                                "example_id": "490fbe8b-e2e7-43f0-9283-a9513f935724",
                                                "sense_id": "9697cfa7-0e43-330c-bc83-d619d852a9d6",
                                                "text": "The day appointed for this extraordinary hunting-party was Shrove Tuesday. The Protestants of Paisley, in whose neighbourhood this story may be said to have originated, cannot discern the difference betwixt Shrove Tuesday and any other Tuesday; but if a Roman Catholic Princess, even in our free times, should be invited to a hunting-match on Shrove Tuesday, she would be shocked at the profane invitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
