                        "entry_id": "e99a2f61-194d-3849-a061-32f301a02d78",
                        "glosses": [
                            "weibliche Person, die einen Gewinn erhält; weibliche Person, die einen Kampf oder Wettkampf gewinnt oder gewonnen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dc25933-4d7f-4192-952d-71f02669365f",
                                "sense_id": "6d625de5-496d-3b3c-9655-ca0e7376de9b",
                                "text": "Die Gewinnerin erhielt einen Blumenstrauß."
                            },
                            {
                                "example_id": "2e729ce0-5538-42ac-9cb4-ebb80cc82e24",
                                "sense_id": "6d625de5-496d-3b3c-9655-ca0e7376de9b",
                                "text": "„Neugierig betrachteten Herren im Smoking und Damen mit kostbarsten Nerzstolen diese seltsame Gewinnerin, die bei jedem Gewinn aufschluchzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
