                        ]
                    },
                    {
                        "translation_id": "d9e48cdc-44d9-4a44-98d7-55fd468fb4bd",
                        "source_entry_id": "2ce24f0a-c761-33de-a837-bb55756b3bfe",
                        "source_sense_id": "c0eab752-d25f-37e4-bff9-453861b6abc5",
                        "source_sense_description": "weibliche Person, welche während des Tages auf die Kinder von berufstätigen Müttern aufpasst",
                        "target_lang_word": "nanny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1facbe-8c85-38e2-9b5f-fb85445ce1c5",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A child's nurse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a6722e-c032-4263-a1ac-5f5975a48afb",
                                                "sense_id": "ed1facbe-8c85-38e2-9b5f-fb85445ce1c5",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime. Their bases were on a level with the pavement outside, a narrow way which was several feet lower than the road behind the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d800a96a-5b42-31d1-a3ee-bac5aaaf915e",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A grandmother."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef24633a-8647-382e-8c6f-1a7c96dc2eb0",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A godmother."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A female goat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62bd591f-2731-4c42-8022-a9ccb5a517e8",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "Breeding is a consuming goal, and the ascendance of the sex drive is nearly as apparent in the behavior of a mountain goat billy. So given over is he to following and defending a succession of nannies as he searches for one in heat (estrus), he loses interest in food altogether; […]"
                                            },
                                            {
                                                "example_id": "180f85b6-5af6-44f9-a531-64c1308e88c4",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "Nannies and billies look very similar, both having dangerously sharp, curved black horns."
                                            },
                                            {
                                                "example_id": "db5af42b-6090-40a8-b7fa-0e3e61ea01da",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "A farmer friend keeps a video camera in the barn so she can turn on her goat cam and observe her animals at any time of the day or night. A baby monitor picks up the sounds of a nanny when she goes into labor—if the nanny is one who changes the usual pitch of her voice or nervously bleats during kidding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7301c6-1ab7-328d-9b65-c3531393e62b",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "Synonym of sylvester (“device for pulling out pit props”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nanny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82c8c326-9c61-36d6-a61c-ff0b1ffac308",
                                        "entry_id": "a9e3e118-f13f-3b25-80d8-4c811141b634",
                                        "glosses": [
                                            "To serve as a nanny."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                        "entry_id": "a9e3e118-f13f-3b25-80d8-4c811141b634",
                                        "glosses": [
                                            "To treat like a nanny's charges; to coddle."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6849c3a5-27a9-4513-904e-3b96e4c2974b",
                                                "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                                "text": "In real life, says a Democratic campaign aide, members of Congress are too nannied by staff to stride about hatching plots, one-on-one."
                                            },
                                            {
                                                "example_id": "379e9d60-c44d-4a06-848c-8a34b7650a43",
                                                "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                                "text": "All politicians seem worried. After 40-plus years of being nannied by the EU they are now faced with having to stand on their own two feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd218390-d240-4ab6-a505-bc0627a78d90",
                        "source_entry_id": "2ce24f0a-c761-33de-a837-bb55756b3bfe",
                        "source_sense_id": "c0eab752-d25f-37e4-bff9-453861b6abc5",
                        "source_sense_description": "weibliche Person, welche während des Tages auf die Kinder von berufstätigen Müttern aufpasst",
                        "target_lang_word": "nourrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nourrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8d1856-ed65-3be7-94e3-b334e2ffbb97",
                                        "entry_id": "75a1ba98-1468-3772-932e-79e456087041",
                                        "glosses": [
                                            "Femme qui allaite l’enfant d’une autre."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a302b8-9aaf-4e86-a6dd-c2713858e202",
                                                "sense_id": "dd8d1856-ed65-3be7-94e3-b334e2ffbb97",
                                                "text": "Cette fidèle berceuse, qui préside comme une sibylle aux premiers efforts de l’imagination, la première amie de l’homme, la bonne, ce personnage si bien nommé la nourrice, cette mère véritable dont l’autre est toujours condamnée à se sentir jalouse, vint se présenter à l’esprit de Guillaume comme un type vénérable, comme un être sacré qu’il se reprochait d’avoir oublié si longtemps."
                                            },
                                            {
                                                "example_id": "e05b1ccd-9a8f-4bd5-ba02-37ea75beed23",
                                                "sense_id": "dd8d1856-ed65-3be7-94e3-b334e2ffbb97",
                                                "text": "La nourrice (c’en était une) tira du panier un jeune chien café au lait, s’assit dans un coin, et donna fort gravement à téter à ce nourrisson d’un nouveau genre. C’était une pasiega qui se rendait à Madrid pour être nourrice sur place, et qui craignait de voir son lait se tarir."
                                            },
                                            {
                                                "example_id": "a1a36d8e-39a5-4a46-ad55-476980568001",
                                                "sense_id": "dd8d1856-ed65-3be7-94e3-b334e2ffbb97",
                                                "text": "Mounira était malade depuis quelques jours. Elle devait renoncer à nourrir son bébé. Gasbieha demandait anxieusement à son amie d’enfance de chercher une nourrice."
                                            },
                                            {
                                                "example_id": "a29e5a8d-06e1-4cef-97ae-51afd992ff88",
                                                "sense_id": "dd8d1856-ed65-3be7-94e3-b334e2ffbb97",
                                                "text": "Il s’indigne qu’une fille pauvre choisisse de se faire couvrir par un amant de passage, souvent de connivence avec sa propre mère, dans l’espoir de coiffer dans dix ou onze mois le bonnet enrubanné des nourrices et de trouver chez des riches une bonne place qu’elle gardera peut-être des années, si, plus tard, de nourrice elle est promue bonne d’enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a5b4f6-473a-3016-bfe7-6c81b06d00f9",
                                        "entry_id": "75a1ba98-1468-3772-932e-79e456087041",
                                        "glosses": [
                                            "Mère qui allaite son propre enfant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a6d3b42-1838-4dc1-b8f1-1ab224d1ba20",
                                                "sense_id": "c4a5b4f6-473a-3016-bfe7-6c81b06d00f9",
                                                "text": "Dans son numéro du 15 janvier 1899, le journal bimensuel parisien le Correspondant médical tirait la sonnette d’alarme en disant : « L’enfant boit ! […]. Les nourrices donnent du vin à leurs nourrissons et s’ébaudissent de leur exubérante gaîté. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385e6a5d-268e-3229-8646-83c8b98acbb0",
                                        "entry_id": "75a1ba98-1468-3772-932e-79e456087041",
                                        "glosses": [
                                            "Personne ou chose qui entretient, alimente, et en particulier femme qui a pour métier de garder des enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be8f7a0-5471-49ee-8654-93cb5aab8108",
                                                "sense_id": "385e6a5d-268e-3229-8646-83c8b98acbb0",
                                                "text": "Mon père n’avait eu pour famille que la nourrice qui l’avait recueilli."
                                            },
                                            {
                                                "example_id": "e21e5b9b-2783-476d-bf0c-57639342ff53",
                                                "sense_id": "385e6a5d-268e-3229-8646-83c8b98acbb0",
                                                "text": "Il la récupère une demi-heure plus tard à l’arrêt de Ville-sous-la-Ferté, avec le petit qu’il est allé chercher chez la nourrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c864bd-c302-3d07-9563-499e3482ccdb",
                                        "entry_id": "75a1ba98-1468-3772-932e-79e456087041",
                                        "glosses": [
                                            "Bidon à poignée utilisé pour la manutention et la distribution de liquides."
                                        ],
                                        "tags": [
                                            "Tous domaines"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e09c9c8f-9448-3386-8412-27804d38b5e0",
                                        "entry_id": "75a1ba98-1468-3772-932e-79e456087041",
                                        "glosses": [
                                            "Connecteur dans une tuyauterie où sont regroupés les robinets d’arrêt et de départ."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81d29650-58d0-3996-b796-b9b9a496b506",
                                        "entry_id": "75a1ba98-1468-3772-932e-79e456087041",
