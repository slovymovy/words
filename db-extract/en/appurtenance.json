                                        "sense_id": "f714cd02-b6ca-389e-aa92-a0911f541cd3",
                                        "entry_id": "78ed8b4e-9d41-38f6-bfcf-ffc3312284f7",
                                        "glosses": [
                                            "Ding, mit dem jemand ausgestattet ist; das zu jemandes Equipment gehört"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a67c4d1-89f5-4ca3-b2b9-454c03fbb027",
                                                "sense_id": "f714cd02-b6ca-389e-aa92-a0911f541cd3",
                                                "text": "„Im Juli 2012 wurde der Lebensunterhalt von etwa 800 Roma-Familien gefährdet, als die Polizei von Tirana einen Verwaltungsakt umsetzte, der das Sammeln von Abfall und anderen wiederverwendbaren Materialien verbot, und ihre Fahrzeuge und andere Ausrüstungsgegenstände beschlagnahmte.“"
                                            },
                                            {
                                                "example_id": "9effc29e-3358-4c0d-b260-fb68a6be7222",
                                                "sense_id": "f714cd02-b6ca-389e-aa92-a0911f541cd3",
                                                "text": "„Alles paßte vorzüglich zusammen, mit Ausnahme zweier Ausrüstungsgegenstände, von denen der eine, mit Rücksicht auf eine Harzreise, des Guten zu wenig, der andere aber entschieden zu viel tat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
