                "senses": [
                    {
                        "sense_id": "52870d17-a4d7-31a1-bc67-9ff7d7cea305",
                        "entry_id": "6674d0fa-ccb6-3e56-a48f-f90aec2a9975",
                        "glosses": [
                            "Enlever son label à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c79cf66-4e2a-4472-9c3d-90ada1832da8",
                                "sense_id": "52870d17-a4d7-31a1-bc67-9ff7d7cea305",
                                "text": "Vivement la publication des \"fonctionnalités pertinentes\" et des \"logiciels labellisés\", vu comme les internautes sont chauffés à blanc par l'Hadopi depuis 2 ans, cela revient à lancer un GRAND CONCOURS D'ETAT pour \"impertinentiser\" et \"délabelliser\" les publications Hadopi et les éditeurs professionnels avec un déluge de contres exemples, contournements, contradictions, etc."
                            },
                            {
                                "example_id": "571aa97b-aec0-4cbb-bca8-d25fd670b45e",
                                "sense_id": "52870d17-a4d7-31a1-bc67-9ff7d7cea305",
                                "text": "On ne va pas délabelliser. On réorganise, c'est différent."
                            },
                            {
                                "example_id": "30a6b14a-6d07-4028-aacd-ca707e2832d4",
                                "sense_id": "52870d17-a4d7-31a1-bc67-9ff7d7cea305",
                                "text": "Il faudrait labelliser ou délabelliser des centaines de sites par jour."
                            }
                        ]
                    }
