                    {
                        "sense_id": "9465774b-36e9-3cee-86ac-b1597e4d3f11",
                        "entry_id": "b642a359-f039-34f6-9547-ad1d7e05c52d",
                        "glosses": [
                            "To hire additional employees, thereby increasing the size of the workforce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be5dbeb-ada2-4aba-ab3a-e7d55605928a",
                                "sense_id": "9465774b-36e9-3cee-86ac-b1597e4d3f11",
                                "text": "Samsung is planning to upstaff and move its West Coast offices, currently located in Orange County, to Century City."
                            },
                            {
                                "example_id": "57b460f9-f829-4331-a4ae-33d960fc48a7",
                                "sense_id": "9465774b-36e9-3cee-86ac-b1597e4d3f11",
                                "text": "Mr. Armes said “a decision by the ministry to upstaff the service it operates in Brampton was a key factor” in the negotiators’ decision to recommend the new offer."
                            },
                            {
                                "example_id": "b9f138bf-0c5f-40f8-969c-c92558aa7397",
                                "sense_id": "9465774b-36e9-3cee-86ac-b1597e4d3f11",
                                "text": "“I see merit in upstaffing Thea,” Gideon said."
                            },
                            {
                                "example_id": "76d8a079-bd6d-4c21-a8bf-edd346558117",
                                "sense_id": "9465774b-36e9-3cee-86ac-b1597e4d3f11",
                                "text": "Meanwhile, David and I upstaffed the spare and pulled two people out of a rollover at the Minnewanka Interchange."
                            }
                        ]
                    }
