                                "sense_id": "f2026156-d5f8-3903-93f8-a816b206f6f6",
                                "text": "Im Verteidigungsfall bedeutet eigentlich „im Krieg“."
                            },
                            {
                                "example_id": "ccd20aa0-201f-4cff-bee4-2f9aed7209a1",
                                "sense_id": "f2026156-d5f8-3903-93f8-a816b206f6f6",
                                "text": "Gemäß 276 Art. 53a Abs. 2 GG muss die Bundesregierung ihn lediglich über ihre Planungen für den Verteidigungsfall unterrichten."
                            }
                        ],
