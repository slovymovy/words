                        "sense_id": "34024501-53d3-3072-95de-da2cab56bfa9",
                        "entry_id": "2ca93ee8-1d4d-3e88-9af9-bafed6543f3b",
                        "glosses": [
                            "Ermittlung von weiteren Personen, mit denen sich eine bestimmte Person getroffen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64aef795-9922-4e8c-a173-73ab019c7cf9",
                                "sense_id": "34024501-53d3-3072-95de-da2cab56bfa9",
                                "text": "„Die Gesundheitsämter in Deutschland sind derzeit intensiv mit Kontaktnachverfolgungen befasst.“"
                            },
                            {
                                "example_id": "1666a3ad-7a20-496b-bd97-bb0c27ee7be6",
                                "sense_id": "34024501-53d3-3072-95de-da2cab56bfa9",
                                "text": "„Seit Sommer nimmt die Stadt Geldern die Kontaktnachverfolgung in Geldern wahr - und entlastet so das Gesundheitsamt des Kreises Kleve.“"
                            },
                            {
                                "example_id": "a992d8db-4eaa-4d7f-a60f-cdd4139f40c3",
                                "sense_id": "34024501-53d3-3072-95de-da2cab56bfa9",
                                "text": "„Haftungsausschluss: Die Liste der Apps zur Kontaktnachverfolgung basiert auf den neuesten öffentlich verfügbaren Informationen. Die Kommission ist nicht für die Entwicklung oder Einführung der genannten Apps verantwortlich.“"
                            },
                            {
                                "example_id": "0b6e80ed-074b-420d-ae3b-0091be0ca427",
                                "sense_id": "34024501-53d3-3072-95de-da2cab56bfa9",
                                "text": "„Die Unterstützungs-Software für die Gesundheitsämter BaySIM („Bayerisches System für Infektionskettenmanagement“) unterstützt die personalintensive Kontaktermittlung, Kontaktnachverfolgung und Quarantäneüberwachung nun auch digital.“"
                            }
                        ],
