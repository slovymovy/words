                        "entry_id": "144595f7-a3a7-3132-889b-0fd6ab855bf0",
                        "glosses": [
                            "Instrument de mesure spécialisé dans la mesure des tensions électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d464a59-b186-467c-8afa-a1345ef1db10",
                                "sense_id": "74fb6368-32be-39b2-9c77-c240c8448031",
                                "text": "Dans ce cas, la tension mesurée par le voltmètre varie lorsqu’on inverse la polarité de la tension à mesurer et la mesure n’a plus de sens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "793c74e5-4c8e-42fc-a0ed-d234ab0f9675",
                        "source_entry_id": "144595f7-a3a7-3132-889b-0fd6ab855bf0",
                        "source_sense_id": "74fb6368-32be-39b2-9c77-c240c8448031",
