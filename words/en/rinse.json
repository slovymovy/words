{
    "word_family": [
        "rinsing",
        "unrinsed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "574241bf-02f4-3960-875c-7b8fa5f10d75",
                    "sense_definition": "To wash something quickly using water, often without soap, to remove dirt or impurities.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>rinse</w> the vegetables under cold water before you start cooking them.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>промыть</w> овощи под холодной водой перед тем, как начать их готовить."
                            }
                        },
                        {
                            "text": "I need to <w>rinse</w> out the cup because there is some dust inside it.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>сполоснуть</w> чашку, потому что внутри неё немного пыли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rinse out",
                        "rinse under water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро мыть что-либо водой, часто без мыла, чтобы удалить грязь или примеси."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "споласкивать",
                                "target_lang_sense_clarification": "слегка обмывать"
                            },
                            {
                                "target_lang_word": "промывать",
                                "target_lang_sense_clarification": "очищать водой"
                            },
                            {
                                "target_lang_word": "ополаскивать",
                                "target_lang_sense_clarification": "быстро мыть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b76dfee1-e349-351d-b181-5f2a8b77c8e1",
                    "sense_definition": "To remove soap or detergent from something using clean water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After you scrub the plates, make sure to <w>rinse</w> the dishes thoroughly.",
                            "target_lang_translations": {
                                "ru": "После того как вы потрете тарелки, обязательно тщательно <w>ополосните</w> посуду."
                            }
                        },
                        {
                            "text": "It is important to <w>rinse</w> your hair well after using shampoo.",
                            "target_lang_translations": {
                                "ru": "Важно хорошо <w>прополоскать</w> волосы после использования шампуня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rinse the dishes",
                        "rinse thoroughly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять мыло или моющее средство с чего-либо с помощью чистой воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоскать",
                                "target_lang_sense_clarification": "промывать в чистой воде"
                            },
                            {
                                "target_lang_word": "смывать",
                                "target_lang_sense_clarification": "удалять мыло водой"
                            },
                            {
                                "target_lang_word": "прополаскивать",
                                "target_lang_sense_clarification": "тщательно удалять остатки мыла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6f8c97c-46a9-37b2-8f7e-66af6245c7f5",
                    "sense_definition": "To swish a liquid around the inside of one's mouth or a container.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouth_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist told me to <w>rinse</w> my mouth with salt water twice a day.",
                            "target_lang_translations": {
                                "ru": "Стоматолог велел мне <w>полоскать</w> рот соленой водой дважды в день."
                            }
                        },
                        {
                            "text": "He <w>rinsed</w> the wine around his glass to check the color and aroma.",
                            "target_lang_translations": {
                                "ru": "Он <w>поболтал</w> вино в бокале, чтобы проверить цвет и аромат."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rinse your mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взбалтывать жидкость во рту или внутри емкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоскать",
                                "target_lang_sense_clarification": "рот или горло"
                            },
                            {
                                "target_lang_word": "ополаскивать",
                                "target_lang_sense_clarification": "внутреннюю часть сосуда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad55e7e4-e16f-3683-b5d4-36bf542df9a4",
                    "sense_definition": "To thoroughly defeat or humiliate someone in an argument, fight, or competition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team got <w>rinsed</w> in the final match of the tournament.",
                            "target_lang_translations": {
                                "ru": "Нашу команду <w>разнесли</w> в финальном матче турнира."
                            }
                        },
                        {
                            "text": "He really <w>rinsed</w> his opponent during the political debate last night.",
                            "target_lang_translations": {
                                "ru": "Он реально <w>уничтожил</w> своего оппонента во время политических дебатов вчера вечером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get rinsed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью победить или унизить кого-либо в споре, драке или соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделать",
                                "target_lang_sense_clarification": "под орех, разгромить"
                            },
                            {
                                "target_lang_word": "уничтожить",
                                "target_lang_sense_clarification": "в споре или игре"
                            },
                            {
                                "target_lang_word": "разнести",
                                "target_lang_sense_clarification": "в пух и прах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ebd9dbf-c51d-306c-85cc-34050aeeda13",
                    "sense_definition": "To drink alcohol and spend time socializing with friends.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "socializing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group decided to <w>rinse</w> all weekend at a cabin in the woods.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>бухать</w> все выходные в хижине в лесу."
                            }
                        },
                        {
                            "text": "They were <w>rinsing</w> until the early hours of the morning.",
                            "target_lang_translations": {
                                "ru": "Они <w>зависали</w> с выпивкой до раннего утра."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Very informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употреблять алкоголь и проводить время в компании друзей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бухать",
                                "target_lang_sense_clarification": "сленг, пить алкоголь"
                            },
                            {
                                "target_lang_word": "зависать",
                                "target_lang_sense_clarification": "проводить время с выпивкой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b168362-c0b8-333e-b1a0-dbc856330a1f",
                    "sense_definition": "The act or process of washing something quickly with water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'll just give this knife a <w>quick</w> <w>rinse</w> before I use it again.",
                            "target_lang_translations": {
                                "ru": "Я просто быстро <w>сполосну</w> этот нож, прежде чем использовать его снова."
                            }
                        },
                        {
                            "text": "The laundry needs one more <w>rinse</w> to get all the soap out.",
                            "target_lang_translations": {
                                "ru": "Белью нужно еще одно <w>полоскание</w>, чтобы полностью удалить мыло."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick rinse",
                        "final rinse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс быстрого мытья чего-либо водой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоскание",
                                "target_lang_sense_clarification": "процесс очистки водой"
                            },
                            {
                                "target_lang_word": "ополаскивание",
                                "target_lang_sense_clarification": "быстрое мытье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a27d952-cd82-31b6-87d4-6cc5ab4c70c9",
                    "sense_definition": "A liquid used for rinsing, especially a temporary hair dye or treatment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied a blue <w>rinse</w> to her hair to give it a subtle tint.",
                            "target_lang_translations": {
                                "ru": "Она нанесла на волосы синий <w>тоник</w>, чтобы придать им легкий оттенок."
                            }
                        },
                        {
                            "text": "The dentist provided a fluoride <w>rinse</w> to help protect my teeth.",
                            "target_lang_translations": {
                                "ru": "Стоматолог предоставил фторидный <w>ополаскиватель</w> для защиты зубов."
                            }
                        }
                    ],
                    "synonyms": [
                        "wash"
                    ],
                    "common_phrases": [
                        "hair rinse",
                        "blue rinse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкость, используемая для полоскания, особенно временная краска для волос или лечебное средство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ополаскиватель",
                                "target_lang_sense_clarification": "средство для волос или рта"
                            },
                            {
                                "target_lang_word": "тоник",
                                "target_lang_sense_clarification": "оттеночное средство для волос"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}