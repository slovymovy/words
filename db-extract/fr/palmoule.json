                        "examples": [
                            {
                                "example_id": "fb32f1fc-b8bc-4ab1-9611-c69fafe311ba",
                                "sense_id": "452e91d4-4f36-3977-bff1-61293f27cb52",
                                "text": "PALMOULE, orge à deux rangs qu’on cultive dans le département de la Haute-Garonne."
                            },
                            {
                                "example_id": "bc286df5-c36b-4fc4-ae36-cfd751cb49d4",
                                "sense_id": "452e91d4-4f36-3977-bff1-61293f27cb52",
                                "text": "Aux XIᵉ-XIIᵉ siècle, le relevé des céréales cultivées dans cette région est le suivant : orge d’hiver, froment, seigle, épeautre pour les blés d’hiver ; palmoule, l’orge de printemps dite paumelle, et avoine pour les semences de printemps."
                            }
                        ]
