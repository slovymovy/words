                        "sense_id": "1c090e03-bdf9-37cf-87d0-c60dc5c45587",
                        "entry_id": "0f66d92e-282f-33e1-86f8-3e534467f0cf",
                        "glosses": [
                            "dat je niet kunt gebruiken voor iets nuttigs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932c5830-2637-4218-901f-d3fdf6ff5bdc",
                                "sense_id": "1c090e03-bdf9-37cf-87d0-c60dc5c45587",
                                "text": "Het speelgoed gereedschap was volkomen onbruikbaar voor welk klusje dan ook."
                            },
                            {
                                "example_id": "6edf0a0d-4a4f-4e0c-b28e-72a8e2a224bf",
                                "sense_id": "1c090e03-bdf9-37cf-87d0-c60dc5c45587",
                                "text": "Niet alle fotoapparatuur heeft nu ingebouwde encryptie om bestanden onbruikbaar te maken bij verlies, terwijl steeds meer gegevens op mobiele apparaten en pc's wel versleuteld worden opgeslagen. Ook communicatieprogramma's als WhatsApp maken er standaard gebruik van."
                            }
                        ]
                    }
