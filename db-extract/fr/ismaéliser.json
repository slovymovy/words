                        "entry_id": "9251fa1e-5e0c-3f82-9a05-0fca257e83e3",
                        "glosses": [
                            "Donner un caractère ismaélien à ; conformer à l'ismaélisme"
                        ],
                        "tags": [
                            "Chiisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c442eed0-b25f-437f-a3df-e76d122d3bc1",
                                "sense_id": "e46ff8b0-13dc-32a2-9125-f95617b5f115",
                                "text": "Ce qui est certain en revanche, c’est que l’âghâ khân envoya des missionnaires pour les « ismaéliser »."
                            },
                            {
                                "example_id": "57522d90-2ee4-4be9-9f79-3d2374717a39",
                                "sense_id": "e46ff8b0-13dc-32a2-9125-f95617b5f115",
                                "text": "Ils auraient islamisé et « ismaélisé » une part importante de la doctrine des nombres."
                            },
                            {
                                "example_id": "fba79f0f-3c2a-4db8-8e5b-55456196de76",
                                "sense_id": "e46ff8b0-13dc-32a2-9125-f95617b5f115",
                                "text": "Diriez-vous que les Arabes ont été ismaélisés ?"
                            }
                        ]
                    }
