                    {
                        "translation_id": "83e4bd31-4104-4e19-9f4c-d45c7795d400",
                        "source_entry_id": "d0ca9366-1cf4-366e-8100-705c16358dbf",
                        "target_lang_word": "sans-culotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans-culotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                        "entry_id": "74c344c0-bc6f-329f-bb26-43092ff83100",
                                        "glosses": [
                                            "Nom que se donnaient les révolutionnaires de 1793, qui portaient le pantalon au lieu de la culotte courte."
                                        ],
                                        "tags": [
                                            "Histoire de France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ced95d01-3bb5-4e45-99d2-5d960155e42a",
                                                "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                                "text": "La Révolution ne convient qu’au peuple, aux hommes de toutes les conditions qui ont une âme pure et élevée, aux philosophes amis de l’humanité, aux sans-culottes, qui se sont, en France, parés avec fierté de ce titre, […]."
                                            },
                                            {
                                                "example_id": "8b85e212-e21f-4eb2-81cf-0d768eaf71d8",
                                                "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                                "text": "Je courus vers l’angle de la place où j’avais entendu le cri, et je vis, à la lueur de la lune sortant d’un nuage, une femme qui se débattait au milieu d’une patrouille de sans-culottes."
                                            },
                                            {
                                                "example_id": "112287c6-803f-4b1f-b704-0911bae7c1b0",
                                                "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                                "text": "— Citoyen substitut, dit-il, tu sais que depuis deux ans je conspire contre tes amis et que je suis l’auteur de l’écrit intitulé : Les Sans-culottes dévoilés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
