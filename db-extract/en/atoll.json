                        ]
                    },
                    {
                        "translation_id": "90444d83-7a45-432a-ad20-23139b0c0e65",
                        "source_entry_id": "bc7ced14-0af1-30b1-ac1c-037799325c10",
                        "source_sense_id": "c07f1bf4-e572-36a0-b636-ca0ad7ef4582",
