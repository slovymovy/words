{
    "word_family": [
        "poison",
        "empoisonnement",
        "empoisonneur",
        "empoisonneuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4e4ed00-be45-37d9-8fb3-000d9182d8c2",
                    "sense_definition": "Faire mourir ou rendre gravement malade au moyen d'un poison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'assassin a tenté d'<w>empoisonner</w> le roi en versant un liquide suspect dans son verre."
                        },
                        {
                            "text": "Le vétérinaire pense que quelqu'un a délibérément voulu <w>empoisonner</w> ce pauvre chien."
                        }
                    ],
                    "synonyms": [
                        "intoxiquer"
                    ]
                },
                {
                    "sense_id": "124005d0-550b-35da-91e3-1239959671e4",
                    "sense_definition": "Mettre du poison ou une substance toxique dans un lieu ou un élément naturel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une fuite de produits chimiques risque d'<w>empoisonner</w> toute la rivière voisine."
                        },
                        {
                            "text": "Les soldats ennemis avaient pris soin d'<w>empoisonner</w> l'eau du puits avant de fuir."
                        }
                    ],
                    "synonyms": [
                        "contaminer",
                        "infecter"
                    ],
                    "antonyms": [
                        "dépolluer",
                        "purifier"
                    ],
                    "common_phrases": [
                        "empoisonner l'eau",
                        "empoisonner les puits"
                    ]
                },
                {
                    "sense_id": "dc16a0e4-e3f5-3ac3-844b-08c81f3113e2",
                    "sense_definition": "Gâcher, troubler profondément ou remplir d'amertume l'existence ou les relations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nuisance_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces disputes quotidiennes finissent par <w>empoisonner</w> la vie de toute la famille."
                        },
                        {
                            "text": "Une jalousie excessive a fini par <w>empoisonner</w> leur relation au fil des mois."
                        }
                    ],
                    "synonyms": [
                        "gâcher",
                        "pourrir"
                    ],
                    "antonyms": [
                        "adoucir",
                        "embellir"
                    ],
                    "common_phrases": [
                        "empoisonner la vie",
                        "empoisonner l'existence"
                    ]
                },
                {
                    "sense_id": "c666cf05-e830-38ce-9b22-ffd0b5a32c58",
                    "sense_definition": "Tuer ou intoxiquer par ses propriétés vénéneuses naturelles, en parlant d'une substance ou d'une plante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette variété de champignon sauvage peut facilement <w>empoisonner</w> quiconque la consomme."
                        },
                        {
                            "text": "Certaines plantes toxiques du jardin risquent d'<w>empoisonner</w> les animaux domestiques."
                        }
                    ],
                    "synonyms": [
                        "intoxiquer"
                    ]
                },
                {
                    "sense_id": "87b0c8aa-bc06-3511-bfc9-52597a5eefce",
                    "sense_definition": "Corrompre moralement ou intellectuellement, exercer une influence néfaste sur les esprits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuisance_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette propagande mensongère cherche à <w>empoisonner</w> les esprits des plus jeunes."
                        },
                        {
                            "text": "Le dictateur utilisait des rumeurs pour <w>empoisonner</w> l'esprit de la population."
                        }
                    ],
                    "synonyms": [
                        "corrompre",
                        "pervertir"
                    ],
                    "common_phrases": [
                        "empoisonner l'esprit",
                        "empoisonner les esprits"
                    ]
                },
                {
                    "sense_id": "d90fc876-0e6c-3190-ad24-df483678bf7c",
                    "sense_definition": "Remplir un lieu d'une odeur particulièrement infecte et irrespirable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuisance_olfactive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les égouts à ciel ouvert <w>empoisonnent</w> tout le quartier dès les premières chaleurs."
                        },
                        {
                            "text": "L'odeur de poisson pourri a suffi pour <w>empoisonner</w> la pièce durant des heures."
                        }
                    ],
                    "synonyms": [
                        "empester",
                        "empuantir"
                    ],
                    "common_phrases": [
                        "empoisonner l'air"
                    ]
                },
                {
                    "sense_id": "043fbc16-b28b-3564-86c8-ad7e918b73f8",
                    "sense_definition": "Donner une interprétation malveillante ou perfide aux paroles ou aux actes d'autrui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interpretation_malveillante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par pure médisance, elle s'amuse à <w>empoisonner</w> les propos les plus innocents."
                        },
                        {
                            "text": "Ce critique malveillant passe ses journées à <w>empoisonner</w> les compliments sincères."
                        }
                    ],
                    "synonyms": [
                        "dénaturer"
                    ]
                }
            ]
        }
    ]
}