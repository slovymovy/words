                    {
                        "translation_id": "2cb69a6c-a632-48b3-99e0-29fdbdf30fa7",
                        "source_entry_id": "a7d6ed10-bf47-3225-8d72-f63ed8105a73",
                        "source_sense_description": "hybridize",
                        "target_lang_word": "kreuzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kreuzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42d49faa-fe8a-3f15-8f2d-2e5ee550f2c8",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "Tiere oder Pflanzen verschiedener Art, Rasse, Gattung oder Sorte zur Paarung beziehungsweise geschlechtlichen Vereinigung bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295ddbe8-1c88-4432-bc5d-fb3f183ef5be",
                                                "sense_id": "42d49faa-fe8a-3f15-8f2d-2e5ee550f2c8",
                                                "text": "Kölreuter kreuzte die beiden Tabakarten Nicotiana rustica und Nicotiana paniculata und gewann damit 1760 den Preis der Akademie."
                                            },
                                            {
                                                "example_id": "de17c8f2-eee3-4c72-b21a-b8799ca380c9",
                                                "sense_id": "42d49faa-fe8a-3f15-8f2d-2e5ee550f2c8",
                                                "text": "Die konventionelle Züchtung ist jedoch von der Natur beschränkt, da sich nur wenige Sorten untereinander kreuzen lassen."
                                            },
                                            {
                                                "example_id": "19f0bd43-a27f-4dd9-9a49-4ebf83d8f07f",
                                                "sense_id": "42d49faa-fe8a-3f15-8f2d-2e5ee550f2c8",
                                                "text": "„Allein im Mais haben wir fast 60.000 Gene. Wenn wir nur drei Sorten miteinander kreuzen, können wir 60.000 hoch drei Genkombinationen züchten – das sind mehr Möglichkeiten, als es Menschen auf dieser Erde gibt“, sagt Prof. Dr. Melchinger."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a6597b1-e862-33a2-92be-cd4717c1e722",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "sich begegnen, sich überschneiden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6507b1-0bde-45ec-9de8-c44c1f492557",
                                                "sense_id": "5a6597b1-e862-33a2-92be-cd4717c1e722",
                                                "text": "Er hatte eben die Lanze auf Aias geworfen, aber gerade die Stelle des Panzers getroffen, wo die Riemen des Degengehenks und des Schildes sich übereinander kreuzen; deshalb war der Wurf unschädlich geblieben."
                                            },
                                            {
                                                "example_id": "d45844fa-5ad1-4651-bbac-86619588ca97",
                                                "sense_id": "5a6597b1-e862-33a2-92be-cd4717c1e722",
                                                "text": "Da kreuzen sich nun zwei Gedanken, und wir wollen sehen, ob beide bewältigt sind, einer oder keiner."
                                            },
                                            {
                                                "example_id": "8fe37c10-5a29-4fc6-bdf2-a6625272d8b3",
                                                "sense_id": "5a6597b1-e862-33a2-92be-cd4717c1e722",
                                                "text": "Zwei Jubiläen kreuzen sich in diesem Jahr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1f8a2e15-bb50-3a35-8c64-6b708b99494b",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "Arme oder Beine kreuzförmig übereinanderlegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f819ad-033f-4755-8aae-f511f8e0e6b1",
                                                "sense_id": "1f8a2e15-bb50-3a35-8c64-6b708b99494b",
                                                "text": "Der Dorfschulmeister stieg hinauf / auf seines Blechschilds Messingknauf / und sprach zum Wolf, der seine Pfoten / geduldig kreuzte vor dem Toten: …"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "30a025de-1780-37df-a3a5-b91a667267b8",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "etwas queren, überqueren, überschneiden (Linie, Straße, Weg)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd20c524-f4ff-4838-a805-aebde7d62386",
                                                "sense_id": "30a025de-1780-37df-a3a5-b91a667267b8",
                                                "text": "Hier konnte niemand seinen Weg kreuzen, seinen Frieden stören."
                                            },
                                            {
                                                "example_id": "f0938e09-7ba4-4bc7-918c-0e88885615a3",
                                                "sense_id": "30a025de-1780-37df-a3a5-b91a667267b8",
                                                "text": "»Ha, du kommst mir recht,« rief Francesco bebend vor Wut bei Cosimos Anblick, »wenigstens sollst du es büßen, daß du es gewagt, meine Wege zu kreuzen.«"
                                            },
                                            {
                                                "example_id": "4f3bad25-aa27-448a-abdc-ea9ef1543895",
                                                "sense_id": "30a025de-1780-37df-a3a5-b91a667267b8",
                                                "text": "Die Aussicht, mit diesem unangenehm guten und unsympathisch langarmigen Friesenschläger die langen Messer zu kreuzen, verdüsterte Henrys Gemüt gewitterwolkenartig."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6f650203-62ae-32d7-b8f0-1b08711a8ea0",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "durch Wendemanöver im Zickzackkurs gegen den Wind segeln"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ca767f-3e68-4f0f-88e5-0569ff700c86",
                                                "sense_id": "6f650203-62ae-32d7-b8f0-1b08711a8ea0",
                                                "text": "Kreuzen gegen den Wind bedeutet doppelter Weg, dreifache Zeit und vierfacher Ärger. (Seglerspruch)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1af1f3c0-58fa-3b8c-a7ab-189fedb2de89",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "eine Kreuzfahrt oder Seereise machen, das Meer befahren"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "6aeb8edf-fcbb-36a3-a8ae-64576f73c586",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
                                            "am Himmel fliegen"
                                        ],
                                        "tags": [],
