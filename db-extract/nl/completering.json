                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7532f8a-5209-49c2-b583-dff100a14b2b",
                                "sense_id": "61198e60-b0da-3496-85a5-64e6b4d33a7a",
                                "text": "Ter completering van het team heeft coach McGinley nog drie wildcards ter beschikking. Bij de Amerikaanse ploeg krijgen de negen beste spelers op mondiale ranglijst een plek in het Ryder Cup-team en zijn er drie wildcards te vergeven."
                            },
                            {
                                "example_id": "261217f1-5689-4328-977b-fab43f9277c9",
                                "sense_id": "61198e60-b0da-3496-85a5-64e6b4d33a7a",
                                "text": "Ter completering: de tweede plaats ging zondag naar Denise Betsema, wereldkampioene Lucinda Brand eindigde na een ongelukje als vierde."
                            },
                            {
                                "example_id": "d6755396-bbe4-4477-8811-fedf44c3fc14",
                                "sense_id": "61198e60-b0da-3496-85a5-64e6b4d33a7a",
                                "text": "Wie écht alles van Reinhardt wil bezitten, kan beter wachten op de completering van 40-cd- serie Intégrale Django Reinhardt, die in drie boxen uitkomt."
                            }
                        ]
                    }
