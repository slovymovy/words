                ],
                "senses": [
                    {
                        "sense_id": "8e04a441-4c15-3594-bc19-a55529a986c6",
                        "entry_id": "02d1a7c8-7dc2-391f-aa91-a8011ca283eb",
                        "glosses": [
                            "Prozess, bei dem ein Gerät eine gewisse Wirkung bei der Beseitigung von Keimen erzielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1261fa55-0d6a-4786-8cf3-c0a615af7b56",
                                "sense_id": "8e04a441-4c15-3594-bc19-a55529a986c6",
                                "text": "„Die Entkeimungsleistung einer Strahlenquelle wird dadurch auf einen gewissen Bruchteil ihrer Leistungsfähigkeit gegenüber dem oben durchgerechneten Beispiel herabgesetzt.“"
                            },
                            {
                                "example_id": "e73cc69a-2af6-4420-88e7-a937a15dc1a1",
                                "sense_id": "8e04a441-4c15-3594-bc19-a55529a986c6",
                                "text": "„In den Werbeschriften der Firmen, die sie herstellen, wird guten Glaubens auf diese unbezweifelbaren Ergebnisse guter Entkeimungsleistung ihrer Produkte verwiesen.“"
                            },
                            {
                                "example_id": "53757674-9df1-442c-ad6a-adcafad3e402",
                                "sense_id": "8e04a441-4c15-3594-bc19-a55529a986c6",
                                "text": "„Zur Validierung der Entkeimungsleistung von Sterilisations- und Pasteurisationsanlagen können Challenge-Tests genutzt und beispielsweise die Absterberate der Keime ermittelt werden.“"
                            },
                            {
                                "example_id": "58787cb7-3978-4d45-8c1f-84246baf8de3",
                                "sense_id": "8e04a441-4c15-3594-bc19-a55529a986c6",
                                "text": "„Die Lampe strahlt UVC-Licht mit einer Wellenlänge von 253 Nanometer ab; ihre Entkeimungsleistung liegt bei 400 Joule je Quadratmeter.“"
                            },
                            {
                                "example_id": "90c58f8d-ec17-46db-8854-de65cce3abc0",
                                "sense_id": "8e04a441-4c15-3594-bc19-a55529a986c6",
                                "text": "„Entkeimungsleistungen von 99,99 % bis unterhalb von 10.000 KBE/m³ oder Geruchsminimierung von 95 % bis unterhalb von sicheren 300 GE/h wurden bereits realisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
