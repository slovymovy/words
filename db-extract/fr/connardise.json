                    {
                        "sense_id": "ff9a8e73-e9a9-34cf-8f6f-17f860234b42",
                        "entry_id": "7843bfa1-62d5-3f97-b919-c52d5043232d",
                        "glosses": [
                            "Comportement caractéristique de connard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae5e5b7-ddcd-458b-b831-ce00015ca6e4",
                                "sense_id": "ff9a8e73-e9a9-34cf-8f6f-17f860234b42",
                                "text": "Ils se sont tous foutus de ma gueule à cause de ma mauvaise humeur et de mon degré avancé de « connardise » de ces dernières semaines, mais je voyais qu'ils étaient tous soulagés et contents."
                            },
                            {
                                "example_id": "8623f4fb-c8e6-4471-a90d-e91ede29806f",
                                "sense_id": "ff9a8e73-e9a9-34cf-8f6f-17f860234b42",
                                "text": "Il savourait sa connardise. Il détestait les gamins. Il les traitait de larves. Il avait quatre nanas en même temps. Aucune n'était au courant pour les trois autres."
                            },
                            {
                                "example_id": "160b2c1f-86d9-4deb-86cc-41db5433854f",
                                "sense_id": "ff9a8e73-e9a9-34cf-8f6f-17f860234b42",
                                "text": "Moyennant quoi rien ne réfrénait sa connardise que le manque d'imagination. Il ne faisait de doute pour personne que le connard n’était pas réformable."
                            }
                        ]
                    },
                    {
                        "sense_id": "62728600-9253-30e0-98cd-85e6ae8bc2ef",
                        "entry_id": "7843bfa1-62d5-3f97-b919-c52d5043232d",
                        "glosses": [
                            "Action ou paroles caractéristiques de connard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b974fa6-7f0e-40c0-aff9-86c9317f024b",
                                "sense_id": "62728600-9253-30e0-98cd-85e6ae8bc2ef",
                                "text": "Et à ceux qui pronostiquent sa rentrée pour l'automne, Raymond Barre répond d'un superbe « ce ne sont que des connardises »."
                            }
                        ]
                    }
                ],
