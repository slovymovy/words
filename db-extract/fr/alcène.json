                        ],
                        "form": "alcènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80da1346-3000-35d4-9b5b-e59649b20e9a",
                        "entry_id": "e424a05d-8ccd-3db4-bbcb-2c996687b783",
                        "glosses": [
                            "Hydrocarbure insaturé comprenant au moins une double liaison covalente entre deux atomes de carbone."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "e401d4c7-38e1-4b6c-acf7-02aeac1cd044",
                                "sense_id": "80da1346-3000-35d4-9b5b-e59649b20e9a",
                                "text": "Lorsque la liaison bore-hydrogène s’approche de l’alcène, les interactions entre les substituants du borane et ceux de l’alcène deviennent importantes."
                            },
                            {
                                "example_id": "1304b59b-521d-428d-b3fb-cf5c47254585",
                                "sense_id": "80da1346-3000-35d4-9b5b-e59649b20e9a",
                                "text": "En principe, la thymine peut se tautomériser et se présenter également sous la forme d’énol (un alcène avec une fonction alcool), en plus de la forme plus courante de lactame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "715ddabc-5964-4e61-a872-eb0ef1c84e69",
                        "source_entry_id": "e424a05d-8ccd-3db4-bbcb-2c996687b783",
                        "source_sense_id": "80da1346-3000-35d4-9b5b-e59649b20e9a",
                        "target_lang_word": "Alken",
