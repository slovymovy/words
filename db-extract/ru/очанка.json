                    {
                        "translation_id": "0fd38087-3abc-4875-98f5-e7988d6121d6",
                        "source_entry_id": "f10d5c8f-e7df-3bea-bebf-af995ccf200f",
                        "source_sense_id": "eb4d081b-2155-3cd3-ac07-ef9e44b280bb",
