                "senses": [
                    {
                        "sense_id": "0b54d986-0d71-36c2-8460-bdf9480b3655",
                        "entry_id": "8fea5b6a-af42-3170-9a75-2f160ee9b06e",
                        "glosses": [
                            "General der Panzerwaffe"
                        ],
                        "tags": [
                            "Heer"
                        ],
                        "examples": [
                            {
                                "example_id": "1d0344e7-6097-4be5-9272-6c5d2929be88",
                                "sense_id": "0b54d986-0d71-36c2-8460-bdf9480b3655",
                                "text": "„Die Tochter eines Panzergenerals hat sich zu sehr durchkämpfen müssen.“"
                            },
                            {
                                "example_id": "8614a73a-7f5b-4e5a-850c-4cf1ffe81c82",
                                "sense_id": "0b54d986-0d71-36c2-8460-bdf9480b3655",
                                "text": "„Getreu seiner Devise ‚Nicht kleckern, sondern klotzen‘ betrieb auch der Panzergeneral Guderian seine eigene Dotation.“"
                            },
                            {
                                "example_id": "f191dadb-6383-4848-bc5b-ca254c518976",
                                "sense_id": "0b54d986-0d71-36c2-8460-bdf9480b3655",
                                "text": "„Dass der ehemalige Panzergeneral noch einmal zu solchen Ehren kommen würde, hätte er wohl auch nicht gedacht.“"
                            },
                            {
                                "example_id": "a1257dab-6e8d-4de7-b6bf-b2f08069a3f6",
                                "sense_id": "0b54d986-0d71-36c2-8460-bdf9480b3655",
                                "text": "„Er und sein Panzergeneral Guderian glaubten an Husarenritte auf Kampfwagen, an begrenzbare ‚Blitzfeldzüge‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
