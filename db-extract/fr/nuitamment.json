                    {
                        "translation_id": "4b83226f-a2bb-4cd1-ae19-a3d03efa14c0",
                        "source_entry_id": "8d57396a-6a1c-30ef-8646-416afe2022b8",
                        "source_sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
