                ],
                "senses": [
                    {
                        "sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                        "entry_id": "cc1b0f6b-7e88-3e78-9dc6-6d78e1c1f19b",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "046708ec-d065-4a8e-a2be-9b5433331b64",
                                "sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                                "text": "Mam na imię Monika i jestem zegarmistrzynią z Cieszyna."
                            },
                            {
                                "example_id": "2291d924-5b7b-4f79-95d0-7ff244e8a526",
                                "sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                                "text": "Matka Moniki chce jej kupić świnkę morską."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "755dd5bf-8c03-4382-ae2a-66e87c39bb27",
                        "source_entry_id": "cc1b0f6b-7e88-3e78-9dc6-6d78e1c1f19b",
                        "source_sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                        "target_lang_word": "Monica",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monica",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89ba6058-b5fb-3e6c-9b0e-6713f1d93de7",
                                        "entry_id": "5f5a6b44-33fa-3ec4-b5dc-415bb8302cd5",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa5bad38-86e9-4983-b212-cf28d85235df",
                                                "sense_id": "89ba6058-b5fb-3e6c-9b0e-6713f1d93de7",
                                                "text": "They named her Monica. Why the name was chosen I have never learnt; but I do not conceive that there was any reason for the choice other than the taste of her parents in the matter of sounds. It is a pleasing enough name, euphoniously considered, and beyond that — as is so commonly the case — no considerations were taken into account. To her, however, at once imaginative and of a feeble and dependent spirit, the name was fateful. St. Monica was made the special object of her devotions in her childhood, and reigned so later when she became a wife."
                                            },
                                            {
                                                "example_id": "f6513f1c-0a1c-48cf-b9be-06fc6e28b9d0",
                                                "sense_id": "89ba6058-b5fb-3e6c-9b0e-6713f1d93de7",
                                                "text": "Similarly, Alcoa (AA)CEO Klaus Kleinfeld has also dropped plans to attend, but the company will participate, said spokeswoman Monica Orbe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffd1683d-15df-40fc-9fcb-2a157a767e95",
                        "source_entry_id": "cc1b0f6b-7e88-3e78-9dc6-6d78e1c1f19b",
                        "source_sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                        "target_lang_word": "Monika",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monika",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6d8ad7-2eeb-3767-9537-6d7f47b23eed",
                                        "entry_id": "660e913c-6795-315a-b9c3-40c5376b3077",
                                        "glosses": [
                                            "ženské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9858342-84f8-4a21-9ab6-b82c904795be",
                        "source_entry_id": "cc1b0f6b-7e88-3e78-9dc6-6d78e1c1f19b",
                        "source_sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                        "target_lang_word": "Monique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f5dfbb3-53bb-355a-a4c8-ad1fb27f593c",
                                        "entry_id": "d3306816-ddd1-3c2d-a0d8-6211dbf07ffb",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca59a5e-8186-48ff-a2d5-e9b331e536e3",
                                                "sense_id": "7f5dfbb3-53bb-355a-a4c8-ad1fb27f593c",
                                                "text": "Il y avait aussi un endroit qui s’appelait Saint-Just, à côté de Bourges, où on était très connus des gadjé, la Monique de l’épicerie et le père René, le garde champêtre. On stationnait auprès de la petite rivière qui s’appelait l’Arnon."
                                            },
                                            {
                                                "example_id": "2def2d68-a4f7-43af-a7fd-a7869eeedd40",
                                                "sense_id": "7f5dfbb3-53bb-355a-a4c8-ad1fb27f593c",
                                                "text": "Guide conférencier attaché à exhumer les pièces retraçant l’histoire de ces demeures incluses dans la soixantaine d’îlots dénombrés, Frédéric Chasseboeuf poursuit ses recherches (notamment à travers les actes notariés) commencées voilà plusieurs années et qui s’inscrivent dans la trame des travaux précurseurs de Monique Moulin, dans les années 1970."
                                            },
                                            {
                                                "example_id": "67549730-00ae-436b-ac49-3ed636b3edfb",
                                                "sense_id": "7f5dfbb3-53bb-355a-a4c8-ad1fb27f593c",
                                                "text": "Il met l’accent sur la solidarité pour faciliter le passage difficile de sa loi, commente l’anthropologue Monique Selim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49508fce-ec78-4e98-bc71-91b2d8a441a2",
                        "source_entry_id": "cc1b0f6b-7e88-3e78-9dc6-6d78e1c1f19b",
                        "source_sense_id": "a444d9dc-5cfd-3511-82fa-5a84ce16d863",
                        "target_lang_word": "Monika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "121c7c7b-ed78-3e08-82ed-60f6e74ea8ac",
                                        "entry_id": "f99a46ed-69bf-363f-aa09-1650cd7b2a49",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7efaf5af-08e7-490f-92f3-8eee7e74360b",
                                                "sense_id": "121c7c7b-ed78-3e08-82ed-60f6e74ea8ac",
                                                "text": "„Die Erziehung der beiden jüngsten Kinder verlief anders als die der vier ›Großen‹; zwischen Monikas und Elisabeths Geburt lagen acht Jahre und der Erste Weltkrieg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
