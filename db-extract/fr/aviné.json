                        "form_id": "362f4d64-f01f-4d30-b685-e3e11dcc17d0",
                        "entry_id": "7f487698-fdc4-3dd5-ae8a-4388b79dfd60",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "avinées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2205f60c-4aab-3789-8166-9f79370c68c8",
                        "entry_id": "7f487698-fdc4-3dd5-ae8a-4388b79dfd60",
                        "glosses": [
                            "Qui boit beaucoup d’alcool ou de boisson alcoolisée."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a24042a6-cfef-4ee8-862e-210d14819990",
                                "sense_id": "2205f60c-4aab-3789-8166-9f79370c68c8",
                                "text": "Débraillés, avinés, écorchés, les mousquetaires du roi, ou plutôt ceux de M. de Tréville, s’épandaient dans les cabarets, dans les promenades, dans les jeux publics."
                            },
                            {
                                "example_id": "03651793-a642-48e6-bb7e-fca21e3e7f81",
                                "sense_id": "2205f60c-4aab-3789-8166-9f79370c68c8",
                                "text": "C’est sans doute que le beaujolais nouveau pue trop la sueur d’une populace avinée de nostalgie du vin de soif, contrairement à la noble modernité de ces flacons de pauillac et de saint-émilion, qui n’en sont d’ailleurs plus, tant la poussière de chêne neuf saturant leurs tanins laisse croire qu’ils ont été élevés dans des cercueils."
                            },
                            {
                                "example_id": "0c1eac10-0098-448e-8990-de828393362c",
                                "sense_id": "2205f60c-4aab-3789-8166-9f79370c68c8",
                                "text": "Véronique Nahoum-Grappe, qu’on ne peut soupçonner de complaisance envers les hommes et qui a fort bien dénoncé les violences des miliciens serbes avinés en Bosnie, lors des viols de guerre, a aussi évoqué « le violeur enivré (qui) s’endort avant de commettre son crime »."
                            }
                        ]
                    },
                    {
                        "sense_id": "f806f008-765b-32c2-a515-1fc09e683707",
                        "entry_id": "7f487698-fdc4-3dd5-ae8a-4388b79dfd60",
                        "glosses": [
                            "Qui est le produit de l'ivresse alcoolique ou de l'alcoolisme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ea0fd420-aee9-4b5f-9d25-8caffb9607cd",
                                "sense_id": "f806f008-765b-32c2-a515-1fc09e683707",
                                "text": "[…], et je vis, à cinquante pas devant moi, le colporteur Pinacle, […]. La lanterne pendue à la bretelle de la hotte éclairait sa figure avinée, son menton hérissé de poils jaunes, et son gros nez en forme d’éteignoir ; […]."
                            }
                        ]
                    }
