                        "examples": [
                            {
                                "example_id": "7894918f-831e-416a-939e-eba6542411b7",
                                "sense_id": "c50af02b-c9b2-334a-9b7f-9b0831e4dc06",
                                "text": "I translated a paper on them last year. Take uranophobia, for instance, which is a fear of heaven.\" \"Oh, a fear of heaven!\" She clapped her hands together."
                            },
                            {
                                "example_id": "b29544b0-3408-4e83-b939-a5be1f08942c",
                                "sense_id": "c50af02b-c9b2-334a-9b7f-9b0831e4dc06",
                                "text": "One phobia that intrigued me was Uranophobia, the fear of heaven. It occurred to me that I had a fear of heaven — the heaven of being happy."
                            },
                            {
                                "example_id": "b261ed26-af91-46a6-8bff-0b76cf97427a",
                                "sense_id": "c50af02b-c9b2-334a-9b7f-9b0831e4dc06",
                                "text": "'Madam, don't drive too fast. I fear speed.' 'I'm sorry, sir. Sir, do you have uranophobia, the fear of heaven?' 'Why?' 'Because you say you fear death. That's why you don't want me to speed.'"
                            }
                        ]
                    }
