{
    "word_family": [
        "exhaust",
        "exhaustive",
        "exhaustively",
        "exhaustible",
        "inexhaustible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                    "sense_definition": "A state of extreme physical or mental tiredness; the condition of having no energy left.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tiredness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After working double shifts for a week, she was suffering from total <w>exhaustion</w>.",
                            "target_lang_translations": {
                                "ru": "После работы в две смены в течение недели она страдала от полного <w>истощения</w>."
                            }
                        },
                        {
                            "text": "The marathon runner collapsed from <w>exhaustion</w> just a few meters before the finish line.",
                            "target_lang_translations": {
                                "ru": "Марафонец упал от <w>изнеможения</w> всего за несколько метров до финиша."
                            }
                        }
                    ],
                    "synonyms": [
                        "fatigue",
                        "tiredness",
                        "weariness"
                    ],
                    "antonyms": [
                        "energy",
                        "vigor",
                        "freshness"
                    ],
                    "common_phrases": [
                        "total exhaustion",
                        "physical exhaustion",
                        "mental exhaustion",
                        "point of exhaustion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние крайней физической или умственной усталости; отсутствие сил и энергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощение",
                                "target_lang_sense_clarification": "крайняя слабость, потеря сил"
                            },
                            {
                                "target_lang_word": "изнеможение",
                                "target_lang_sense_clarification": "состояние полного бессилия"
                            },
                            {
                                "target_lang_word": "изнурение",
                                "target_lang_sense_clarification": "крайняя степень утомления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                    "sense_definition": "The act of using something up completely, or the state of being completely depleted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "depletion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid <w>exhaustion</w> of natural resources is a major concern for environmentalists.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>истощение</w> природных ресурсов вызывает серьезную озабоченность у экологов."
                            }
                        },
                        {
                            "text": "We worked the gold mine to <w>exhaustion</w> until there was nothing left to extract.",
                            "target_lang_translations": {
                                "ru": "Мы вели <w>выработку</w> на золотом руднике до тех пор, пока не осталось ничего, что можно было бы добыть."
                            }
                        }
                    ],
                    "synonyms": [
                        "depletion",
                        "consumption",
                        "expenditure"
                    ],
                    "antonyms": [
                        "abundance",
                        "surplus",
                        "replenishment"
                    ],
                    "common_phrases": [
                        "resource exhaustion",
                        "exhaustion of supplies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт полного использования чего-либо или состояние полной исчерпанности запасов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчерпание",
                                "target_lang_sense_clarification": "использование в полном объеме"
                            },
                            {
                                "target_lang_word": "истощение",
                                "target_lang_sense_clarification": "уменьшение ресурсов из-за расходования"
                            },
                            {
                                "target_lang_word": "выработка",
                                "target_lang_sense_clarification": "полное извлечение ископаемых из месторождения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de9cc18b-7a27-3c62-a5c7-68139ca81829",
                    "sense_definition": "The process of examining or considering something completely and thoroughly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thoroughness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee reached its decision through a process of <w>exhaustion</w>, looking at every possible alternative.",
                            "target_lang_translations": {
                                "ru": "Комитет пришел к решению путем <w>исчерпания</w> всех возможностей, рассмотрев все возможные альтернативы."
                            }
                        },
                        {
                            "text": "By a method of <w>exhaustion</w>, the detective ruled out every suspect except for the butler.",
                            "target_lang_translations": {
                                "ru": "Методом <w>исключения</w> детектив отсеял всех подозреваемых, кроме дворецкого."
                            }
                        }
                    ],
                    "synonyms": [
                        "thoroughness",
                        "comprehensiveness"
                    ],
                    "common_phrases": [
                        "method of exhaustion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс полного и тщательного изучения или рассмотрения чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчерпание",
                                "target_lang_sense_clarification": "рассмотрение всех вариантов"
                            },
                            {
                                "target_lang_word": "метод исключения",
                                "target_lang_sense_clarification": "в контексте логического перебора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1acd3017-1c85-371e-8501-31544a8c3141",
                    "sense_definition": "The removal of all air or gas from a container to create a vacuum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_processes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory technician monitored the <w>exhaustion</w> of the glass chamber to ensure a perfect vacuum.",
                            "target_lang_translations": {
                                "ru": "Лаборант следил за <w>откачкой</w> воздуха из стеклянной камеры, чтобы обеспечить идеальный вакуум."
                            }
                        },
                        {
                            "text": "Complete <w>exhaustion</w> of the vessel is required before the chemical reaction can begin.",
                            "target_lang_translations": {
                                "ru": "Перед началом химической реакции требуется полное <w>удаление</w> воздуха из сосуда."
                            }
                        }
                    ],
                    "synonyms": [
                        "evacuation"
                    ],
                    "common_phrases": [
                        "air exhaustion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удаление всего воздуха или газа из контейнера для создания вакуума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откачка",
                                "target_lang_sense_clarification": "удаление газа или воздуха"
                            },
                            {
                                "target_lang_word": "эвакуация",
                                "target_lang_sense_clarification": "технический термин для разрежения среды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bfcc54a-22b5-3a62-afa7-44028aa37c60",
                    "sense_definition": "The extraction of medicinal or active ingredients from plant material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_processes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharmacist performed the <w>exhaustion</w> of the herbs to create a potent tincture.",
                            "target_lang_translations": {
                                "ru": "Фармацевт провел <w>экстракцию</w> трав для создания сильнодействующей настойки."
                            }
                        },
                        {
                            "text": "Through careful <w>exhaustion</w> of the roots, the chemists isolated the healing compound.",
                            "target_lang_translations": {
                                "ru": "Путем тщательного <w>извлечения</w> веществ из корней химики выделили целебное соединение."
                            }
                        }
                    ],
                    "synonyms": [
                        "extraction",
                        "percolation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Извлечение лекарственных или активных ингредиентов из растительного сырья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстракция",
                                "target_lang_sense_clarification": "извлечение активных веществ"
                            },
                            {
                                "target_lang_word": "истощение",
                                "target_lang_sense_clarification": "полное извлечение полезных компонентов из сырья"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}