                        "entry_id": "87e07fb5-f5ce-375d-87cc-f0568416edab",
                        "glosses": [
                            "wasserdichte und druckfeste Armbanduhr zur Messung der Tauchzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e2cf08-59b5-44ff-a937-3ca7d32ea157",
                                "sense_id": "0719bf70-352a-330f-8518-63961ec3f3d5",
                                "text": "Kein Taucher begibt sich ohne seine Taucheruhr auf einen Tauchgang."
                            },
                            {
                                "example_id": "0456e9f0-12e2-438e-b12d-bcafce9e49c2",
                                "sense_id": "0719bf70-352a-330f-8518-63961ec3f3d5",
                                "text": "„Während die Neuauflage dieser Taucheruhr ihrem ursprünglichen Design von 1970 im Wesentlichen treu bleibt, ist die Technologie der Seiko Prospex SLA033 komplett neu.“"
                            }
                        ],
