                "senses": [
                    {
                        "sense_id": "b8f892f8-c72f-3e91-98ef-901ce6a90a45",
                        "entry_id": "fd54b606-00a4-3b65-a982-df3fd6c50304",
                        "glosses": [
                            "verslag van een beleefde of verzonnen gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ebf2898-07ec-48ed-8864-2b87bcf747af",
                                "sense_id": "b8f892f8-c72f-3e91-98ef-901ce6a90a45",
                                "text": "Hoe ik bij de nationalisten terecht kwam? Dat is een lange tori."
                            },
                            {
                                "example_id": "0df1da0d-b2c8-4a30-8186-9815c5bc486b",
                                "sense_id": "b8f892f8-c72f-3e91-98ef-901ce6a90a45",
                                "text": "In Suriname worden er tori gevonden, welke verhalen waarom Anansi kakkerlakken en vliegen doodt (…); waarom hij in de naden en beslagruimten woont (…); waarom zijn lichaam in tweeën geleed is (…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "44726963-ab6a-35f4-a41b-7e97ce04e70d",
                        "entry_id": "fd54b606-00a4-3b65-a982-df3fd6c50304",
                        "glosses": [
                            "gepraat dat geen belangrijke informatie oplevert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5deb29f8-0020-4962-b7ab-f3a5a9fc220b",
                                "sense_id": "44726963-ab6a-35f4-a41b-7e97ce04e70d",
                                "text": "Wat ze ook zeggen, mensen denken: ach, laat die bakra's met hun tori's, zo gaat het toch al eeuwen. Terwijl ik daarentegen echt op mijn woorden moet letten. Want ik ben die blaka bakra, weet je?"
                            },
                            {
                                "example_id": "f80eb9c0-e96f-47b8-9693-d05f86da62d1",
                                "sense_id": "44726963-ab6a-35f4-a41b-7e97ce04e70d",
                                "text": "‘Is geen grapje wat je daar gepresteerd heb Trudi! Die man van je geeft geen tori! Wat een krasse kerel heb je, man!’ grapte Rudi."
                            }
                        ]
                    }
                ],
