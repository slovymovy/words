                        "glosses": [
                            "Redevance permettant le droit de pacage, notamment des cochons dans les bois seigneuriaux. On disait aussi autrefois vermullage."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "c0d2b689-b37d-44fd-a168-3a75b04224ba",
                                "sense_id": "8470d362-75b6-3a08-9f14-e2cd07d45d67",
                                "text": "Il s'exerce sur les hommes,les terres, les récoltes ( Dîmes, tasques, etc.) ou les droits d'usage (pêcheries, salines, vermillage, etc.), les uns maintenus en directe, les autres inféodés moyennant acapte, donnés en métayage ou cédés à bail."
                            }
                        ]
                    },
