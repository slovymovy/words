                                    {
                                        "sense_id": "caae1cdf-4f13-3901-871b-d684cc76129f",
                                        "entry_id": "a707e11e-4276-315a-8b08-75558b5624fc",
                                        "glosses": [
                                            "een fermion (met een spin van 1/2): een uiterst licht ongeladen elementair deeltje"
                                        ],
