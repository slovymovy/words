                    {
                        "translation_id": "ae1badfc-e100-4d56-bf84-cc709d860806",
                        "source_entry_id": "366ef733-0210-3f8f-82c2-7048d2532430",
                        "source_sense_description": "state of being an idiot",
                        "target_lang_word": "Idiotie",
