{
    "word_family": [
        "gewennen",
        "ontwenning",
        "wennen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df12a19d-c204-3423-a9f8-4e2d3f72c037",
                    "sense_definition": "Het lichamelijk en/of geestelijk losmaken van datgene waar men aan gewend geraakt is, zoals een verslaving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afkicken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jarenlang zwaar drugsgebruik moesten ze onder begeleiding <w>ontwennen</w>.",
                            "target_lang_translations": {
                                "en": "After years of heavy drug use, they had to <w>withdraw</w> under supervision."
                            }
                        },
                        {
                            "text": "Het is erg moeilijk om te <w>ontwennen</w> van een hardnekkige rookverslaving.",
                            "target_lang_translations": {
                                "en": "It is very difficult to <w>wean oneself off</w> a persistent smoking addiction."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkicken"
                    ],
                    "antonyms": [
                        "gewennen"
                    ],
                    "common_phrases": [
                        "moeten ontwennen",
                        "ontwennen van roken"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically and/or mentally break free from something one has become accustomed to, such as an addiction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "withdraw",
                                "target_lang_sense_clarification": "from an addictive substance"
                            },
                            {
                                "target_lang_word": "wean off",
                                "target_lang_sense_clarification": "gradually stop using a substance or habit"
                            },
                            {
                                "target_lang_word": "kick the habit",
                                "target_lang_sense_clarification": "stop an addiction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd793d8d-122b-3f16-9330-06fd12425d98",
                    "sense_definition": "Een bepaalde gewoonte of gewenning kwijtraken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gewoonte-verliezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was het vroege opstaan na de lange vakantie helemaal <w>ontwend</w>.",
                            "target_lang_translations": {
                                "en": "He had become completely <w>unaccustomed</w> to getting up early after the long vacation."
                            }
                        },
                        {
                            "text": "Als je stopt met trainen, raak je de dagelijkse routine snel <w>ontwend</w>.",
                            "target_lang_translations": {
                                "en": "If you stop training, you quickly <w>lose the habit of</w> the daily routine."
                            }
                        }
                    ],
                    "synonyms": [
                        "afleren"
                    ],
                    "antonyms": [
                        "aanwennen"
                    ],
                    "common_phrases": [
                        "een gewoonte ontwennen",
                        "helemaal ontwend zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose a certain habit or become unaccustomed to something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get out of the habit of",
                                "target_lang_sense_clarification": "lose a routine"
                            },
                            {
                                "target_lang_word": "become unaccustomed to",
                                "target_lang_sense_clarification": "no longer be used to something"
                            },
                            {
                                "target_lang_word": "lose the habit of",
                                "target_lang_sense_clarification": "stop doing something regularly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}