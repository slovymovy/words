{
    "word_family": [
        "command",
        "commander",
        "commanding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                    "sense_definition": "A divine rule or order, especially one of the fundamental religious laws such as the Ten Commandments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divine_rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained how each <w>commandment</w> shaped the culture of ancient societies."
                        },
                        {
                            "text": "Many faithful believers try to follow every religious <w>commandment</w> throughout their daily lives."
                        }
                    ],
                    "synonyms": [
                        "decree",
                        "precept"
                    ],
                    "common_phrases": [
                        "Ten Commandments"
                    ]
                },
                {
                    "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                    "sense_definition": "A strict rule, principle, or order that must be obeyed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Respecting personal space is the primary <w>commandment</w> among the members of this small team."
                        },
                        {
                            "text": "The company handbook sets down a clear <w>commandment</w> about reporting conflicts of interest."
                        }
                    ],
                    "synonyms": [
                        "command",
                        "dictate",
                        "edict",
                        "order",
                        "rule"
                    ]
                },
                {
                    "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                    "sense_definition": "The act of giving orders or exercising authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ruled the occupied territory by strict <w>commandment</w> of his officers."
                        },
                        {
                            "text": "He spoke with stern <w>commandment</w>, leaving no room for anyone to question him."
                        }
                    ],
                    "synonyms": [
                        "authority",
                        "command"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts to denote the exercise of command or authority."
                        }
                    ]
                },
                {
                    "sense_id": "57395324-d09c-3862-898e-e6473df73149",
                    "sense_definition": "The unlawful act of directing, ordering, or procuring another person to commit an offence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In old common law, an accessory was held guilty by reason of <w>commandment</w>."
                        },
                        {
                            "text": "The prosecutor alleged that the mastermind committed a serious crime through illegal <w>commandment</w>."
                        }
                    ],
                    "synonyms": [
                        "instigation",
                        "procurement"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Legal term formerly used for inciting or commanding a crime."
                        }
                    ]
                }
            ]
        }
    ]
}