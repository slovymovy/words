                        "glosses": [
                            "jemand, der berufsmäßig akrobatische Kunststücke auf dem Pferd darbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586a72f8-354d-4c60-993d-02af147b64e2",
                                "sense_id": "a8dabe87-c531-3dc4-a73f-90414c0a3d78",
                                "text": "„[…] Auch der beste Kunstreiter riskiert beim Salto von Pferd zu Pferd sein Genick.“"
