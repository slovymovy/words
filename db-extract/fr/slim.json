                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b91d5b3-2f30-3b83-b075-3c8e67abfec2",
                        "entry_id": "055a7a03-bb7c-31a9-a89d-4f19d2db1a82",
                        "glosses": [
                            "Module d’exploration lunaire, développée par l’agence spatiale japonaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54130610-2030-42a1-a1ce-2ac1b85c10b3",
                                "sense_id": "2b91d5b3-2f30-3b83-b075-3c8e67abfec2",
                                "text": "Dans un message posté sur X dimanche soir, l’agence spatiale nippone Jaxa s’est félicitée de la remise en route sur la Lune du module Slim (Smart Lander for Investigating Moon)."
                            },
                            {
                                "example_id": "490ced1f-9331-483b-b6fe-a14dbcf391f9",
                                "sense_id": "2b91d5b3-2f30-3b83-b075-3c8e67abfec2",
                                "text": "L’agence spatiale nippone a annoncé lundi que les communications avec le module Slim, qui a aluni le 20 janvier, avaient été rétablies."
                            },
                            {
                                "example_id": "b1f756a9-9e2e-425d-bc0c-2dfe13f9a601",
                                "sense_id": "2b91d5b3-2f30-3b83-b075-3c8e67abfec2",
                                "text": "Son module Slim, qui a aluni le 20 janvier, a «repris ses opérations», a annoncé lundi l’agence spatiale nippone (Jaxa), suggérant que le courant avait pu être rétabli à bord."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "255ae6e4-3df5-3aec-b10e-3541f211872a",
