                        ],
                        "form": "die Klartexte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8b66842-8943-30aa-89f3-7f027629255a",
                        "entry_id": "c1f16a20-8250-3184-ab5a-474ca876ee6f",
                        "glosses": [
                            "nicht verschlüsselter und deshalb unmittelbar verständlicher Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0eb12bc-271f-4b7a-b775-b53069a42c50",
                                "sense_id": "d8b66842-8943-30aa-89f3-7f027629255a",
                                "text": "„Die Nachricht wird offen übermittelt, aber so verändert, daß der Gegner keine Chance hat, den Klartext zu ermitteln - so hoffen jedenfalls Sender und Empfänger.“"
                            },
                            {
                                "example_id": "de1d0039-c2e8-49b4-a158-e05cea1a10b5",
                                "sense_id": "d8b66842-8943-30aa-89f3-7f027629255a",
                                "text": "„In der Europäischen Union sind zurzeit ca. 300 Zusatzstoffe zugelassen, die im Klartext auf der Packung aufgeführt oder durch Angabe der E-Nummern kenntlich gemacht werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b8e2d18d-1d3c-38da-988b-573aaabb02eb",
                        "entry_id": "c1f16a20-8250-3184-ab5a-474ca876ee6f",
                        "glosses": [
                            "Aussage, in der das Gemeinte direkt ausgedrückt und nicht durch Anspielung, Ironie oder dergleichen verschleiert wird"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "334d7e6f-c0b0-45c7-8cc5-12358ff3036e",
                                "sense_id": "b8e2d18d-1d3c-38da-988b-573aaabb02eb",
                                "text": "„Das heißt im Klartext: Dann war mit ihr nicht zu spaßen.“"
                            },
                            {
                                "example_id": "f1a91ced-a1f0-48d0-9293-0e99e7ce82ab",
                                "sense_id": "b8e2d18d-1d3c-38da-988b-573aaabb02eb",
                                "text": "„Inuit neigen sonst eigentlich nicht zum Klartext, aber diese Sprechstunde ist für Menschen gedacht, die mit Selbstmord in Berührung gekommen sind.“"
                            },
                            {
                                "example_id": "cf942977-ef4b-4063-a959-54b5bc1cd203",
                                "sense_id": "b8e2d18d-1d3c-38da-988b-573aaabb02eb",
                                "text": "„Im Klartext heißt das: Bürger und Bauern sollen sich nicht einmischen in die Angelegenheiten ds Gemeinwesens und sollen die Obrigkeit machen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
