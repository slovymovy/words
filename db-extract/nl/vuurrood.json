                                            {
                                                "example_id": "bec11a71-8b0e-4dee-83f4-b7e48c45d4e1",
                                                "sense_id": "8f999977-2eed-3bff-9fd2-97a828865e70",
                                                "text": "Le calice est vert et la corolle d’un rouge feu très vif, avec la lèvre supérieure légèrement velue."
                                            },
                                            {
                                                "example_id": "49fbb971-2d18-43f5-891b-81212b98942d",
                                                "sense_id": "8f999977-2eed-3bff-9fd2-97a828865e70",
                                                "text": "Le Dragster obtient également de nouvelles couleurs, en particulier pour la version RR, qui comprend désormais un coloris mêlant le rouge feu avec le noir intense et le gris foncé, et un autre intégrant le jaune métallisé nacré avec du noir profond et du gris foncé métallisé mat."
                                            },
                                            {
                                                "example_id": "768b6241-b9dd-4e79-9faa-d99284f49828",
                                                "sense_id": "8f999977-2eed-3bff-9fd2-97a828865e70",
                                                "text": "Optez également pour nuances plus claires comme le rouge anglais, le rouge feu et le nacarat."
                                            }
                                        ]
                                    }
                                ]
                            },
