                        "glosses": [
                            "Protéine constituant de la kératohyaline, elle-même constituant de l’épiderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d426feb3-e4c5-47d4-894f-df4b2b36d0b4",
                                "sense_id": "e95230c9-8703-35f8-9b77-fa4dc8b1c39d",
                                "text": "La filagrine, codée par le gène FLG, est une protéine essentielle de la barrière épidermique au niveau de la couche terminale de la peau, la couche cornée. Elle provient du clivage en 10-12 protéines d'une grande protéine (>400kDa), la profilagrine, constituant important des granules de kératohyaline présents dans la couche granuleuse de l'épiderme."
                            }
                        ]
                    }
