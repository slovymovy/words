                                            {
                                                "example_id": "5323c2ae-1079-4012-9f7f-e6de2c2e57e5",
                                                "sense_id": "00e66d21-e394-33b2-b4e9-85c9d2a6380d",
                                                "text": "Kaffer je?"
                                            }
                                        ]
