                        "entry_id": "a42482f8-a74b-3419-b3f8-69694d7337f2",
                        "glosses": [
                            "een strafbepaling waarbij iemand verboden wordt het eigen huis te verlaten of er onbeperkt mensen te ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f0a9aa-8861-40da-a3ef-77f43340ad45",
                                "sense_id": "1a544ab3-fdf7-34fd-8b00-6f3e4d697a98",
                                "text": "Hij kreeg huisarrest opgelegd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7458932-6cde-4964-8f8f-6d3515db9468",
                        "source_entry_id": "a42482f8-a74b-3419-b3f8-69694d7337f2",
                        "source_sense_id": "1a544ab3-fdf7-34fd-8b00-6f3e4d697a98",
                        "source_sense_description": "strafbepaling",
                        "target_lang_word": "Hausarrest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausarrest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                        "entry_id": "fdb93b94-b654-3d68-a974-6dd36dbeb59c",
                                        "glosses": [
                                            "Strafe, bei der der Bestrafte sein Haus oder seine Wohnung nicht verlassen darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c459b6-61f2-4b02-8e69-ef174f2bc3f1",
                                                "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                                "text": "Der führende Oppositionspolitiker des Landes steht seit Jahren unter Hausarrest."
                                            },
                                            {
                                                "example_id": "98222f46-a68d-4132-bd73-f9838e7d0656",
                                                "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                                "text": "Der Hausarrest wird auch gerne in der Kindererziehung angewandt."
                                            },
                                            {
                                                "example_id": "20fc278d-04c1-4f23-932a-c8eb3115c306",
                                                "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                                "text": "„Ich kriegte eine Woche Hausarrest, genau wie Ingo.“"
                                            },
                                            {
                                                "example_id": "236d02fe-b7a3-4cc6-9327-666b2fa31678",
                                                "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                                "text": "„Das Militär verschleppt Abd el-Kader und seine Entourage in ein Schloss und stellt ihn unter Hausarrest.“"
                                            },
                                            {
                                                "example_id": "a0d27abe-cb64-47d4-89dc-981627c750cf",
                                                "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                                "text": "„Das Regime stellte ihn unter Hausarrest und verweigerte ihm die Ausreise.“"
                                            },
                                            {
                                                "example_id": "44241707-fe4a-4a07-bef8-1016a1685afd",
                                                "sense_id": "b9fb559c-da98-3f21-bc93-4cbad9b311db",
                                                "text": "„Annie nahm ihren Hausarrest gelassen hin und wurde im Verlauf der Wochen sogar noch passiver.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
