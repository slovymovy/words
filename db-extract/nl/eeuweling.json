                            {
                                "example_id": "aa914e00-b9f2-4e16-b692-c582e4ea1e58",
                                "sense_id": "f1a06342-385b-31f3-b8f3-183907bd8153",
                                "text": "De oudste persoon in het verzorgingstehuis is een eeuweling van 102 jaar oud.",
                                "translation": "The oldest person in the nursing home is a centenarian of 102 years old.",
                                "english": "The oldest person in the nursing home is a centenarian of 102 years old."
                            },
                            {
                                "example_id": "0d0b8de3-5af6-49f4-ad1e-258141276f19",
                                "sense_id": "f1a06342-385b-31f3-b8f3-183907bd8153",
                                "text": "Op haar 100ste verjaardag werd ze officieel erkend als een eeuweling door de gemeente.",
                                "translation": "On her 100th birthday, she was officially recognized as a centenarian by the municipality.",
                                "english": "On her 100th birthday, she was officially recognized as a centenarian by the municipality."
                            },
                            {
                                "example_id": "70fa44ba-4693-4c3d-bf6b-f8be1b82b408",
                                "sense_id": "f1a06342-385b-31f3-b8f3-183907bd8153",
                                "text": "De verjaardag van de lokale eeuweling werd groots gevierd door de hele buurt.",
                                "translation": "The birthday of the local centenarian was celebrated grandly by the entire neighborhood.",
