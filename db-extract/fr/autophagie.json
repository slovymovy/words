        "fr-extract.jsonl": [
            {
                "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                "word": "autophagie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30296e7a-8b67-45cb-9206-848cc9dd3275",
                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                        "tags": [
                            "plural"
                        ],
                        "form": "autophagies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bc0c184-6c35-3e1c-84b8-feb40f275832",
                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                        "glosses": [
                            "Chez un organisme vivant soumis à l’inanition, particularité d’entretenir la vie aux dépens de sa propre substance."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0924bf14-13db-38e0-b789-54e556c0f873",
                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                        "glosses": [
                            "Capacité d’une cellule d’un organisme pluricellulaire à se manger elle-même."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8212fb86-a9bc-4619-9709-ec5d16052976",
                                "sense_id": "0924bf14-13db-38e0-b789-54e556c0f873",
                                "text": "« L'autophagie est un mécanisme d'autodigestion cellulaire qui, paradoxalement, peut soit conduire à la protection et donc à la survie de la cellule, soit mener à sa mort ». Explique Patrice Codogno, biologiste à l'Inserm-Hôpital Necker à Paris. « Toutefois chez l'homme, et les mammifères, l'autophagie intervient surtout en réponse à un stress »."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aaf2eea-a153-37c5-b612-d1d1ff0e8ae6",
                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                        "glosses": [
                            "Digestion intracellulaire de divers composants cytoplasmiques par des lysosomes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05aad68b-cccf-46ef-97ef-0907c3c04e8c",
                                "sense_id": "3aaf2eea-a153-37c5-b612-d1d1ff0e8ae6",
                                "text": "« L'autophagie consiste à enfermer des éléments cytoplasmiques et des organites devenus inutiles dans des vésicules à double membrane appelés autophagosomes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6ca98ac-8fac-4d57-9554-dad2c247a68f",
                        "source_entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                        "target_lang_word": "Autophagie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autophagie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddf69c9-3111-3fe4-9bc8-9be3daf9c993",
                                        "entry_id": "d0c15382-f551-3dd0-adfe-b804390a960b",
                                        "glosses": [
                                            "Verdauung zelleigner Strukturen durch Phagozyten, zum Beispiel Lysosomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a058a0-c03e-4859-b050-e7b8ff941600",
                                                "sense_id": "4ddf69c9-3111-3fe4-9bc8-9be3daf9c993",
                                                "text": "„Wenn manche Zellen ihren Tod vor Augen haben, dann fangen sie an, sich selbst aufzufressen. Autophagie heißt dieser Mechanismus, den der Japaner Yoshinori Ohsumi erforscht hat - und für den er jetzt den Nobelpreis bekommt.“"
                                            },
                                            {
                                                "example_id": "fcc94975-427f-4771-abd1-46bc9ae1d2d7",
                                                "sense_id": "4ddf69c9-3111-3fe4-9bc8-9be3daf9c993",
                                                "text": "Der Mechanismus der Autophagie spielt neuerdings in der Krebsforschung eine herausragende Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6d93a3e-15b4-4575-847e-f558b8d96930",
                        "source_entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                        "target_lang_word": "autophagy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
