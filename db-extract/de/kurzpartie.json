                    {
                        "sense_id": "4bc41330-da48-339f-8661-953a9febbfbb",
                        "entry_id": "660403f4-63c2-3856-b1d9-0e4f9975da92",
                        "glosses": [
                            "Schachpartie, die in nur wenigen Zügen entschieden wurde"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "ae810a1b-62df-4460-aaba-f8d5ad85f2af",
                                "sense_id": "4bc41330-da48-339f-8661-953a9febbfbb",
                                "text": "„In der folgenden Kurzpartie brachte Greco ein Läuferopfer auf h7 mit anschließender Öffnung der h-Linie, das heute zum Grundwissen des versierten Spielers zählt.“"
                            },
                            {
                                "example_id": "0b334191-5681-4c71-b128-f517154d795e",
                                "sense_id": "4bc41330-da48-339f-8661-953a9febbfbb",
                                "text": "„Zum Auftakt glückte ihm mit Schwarz eine Kurzpartie gegen Giri […].“"
                            },
                            {
                                "example_id": "eb3993c9-6d5f-40d3-8ae0-5381c9014ed4",
                                "sense_id": "4bc41330-da48-339f-8661-953a9febbfbb",
                                "text": "„Nichts ist schöner als der Sieg eines Underdogs gegen einen übermächtigen Gegner, zumal wenn dies noch unter Blitz und Donner in einer Kurzpartie geschieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
