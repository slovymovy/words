                    }
                ],
                "senses": [
                    {
                        "sense_id": "f103985c-947f-3d02-9cd5-05b8d653612c",
                        "entry_id": "7495ad67-e558-3496-9081-65bf0584933b",
                        "glosses": [
                            "tot rust brengend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "460a3372-ad1e-4301-a362-e5249cc16bd5",
                                "sense_id": "f103985c-947f-3d02-9cd5-05b8d653612c",
                                "text": "In plaats van een lekker relaxed peddeltochtje werd het een barre overlevingstocht."
                            },
                            {
                                "example_id": "00495b64-bf13-44e8-8511-c7e7ab4edc8a",
                                "sense_id": "f103985c-947f-3d02-9cd5-05b8d653612c",
                                "text": "Er heerst hier een relaxte sfeer."
                            },
                            {
                                "example_id": "48489b82-5ea9-4254-ab9e-986f3398d99f",
                                "sense_id": "f103985c-947f-3d02-9cd5-05b8d653612c",
                                "text": "Toch was het soms lastig om relaxt [sic!] te blijven en naarmate de werkstress terugkeerde kreeg ik het er steeds moeilijker mee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61eeb504-7307-416f-87a6-5e31ca4fe314",
                        "source_entry_id": "7495ad67-e558-3496-9081-65bf0584933b",
                        "source_sense_id": "f103985c-947f-3d02-9cd5-05b8d653612c",
                        "source_sense_description": "ontspannen",
                        "target_lang_word": "relaxed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relaxed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28dcb525-02c6-390f-a7fa-866feddb6703",
                                        "entry_id": "9088022e-7584-3de0-9d9d-ef5bd1bb7fa2",
                                        "glosses": [
                                            "Made slack or feeble; weak, soft."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba156e2e-665f-4838-a03c-5ef8957e6ff9",
                                                "sense_id": "28dcb525-02c6-390f-a7fa-866feddb6703",
                                                "text": "It was a very wet morning. I woke relaxed and melancholy as in the country, and walked about an hour under cover, in the middle of the town […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eeda6fc-ede3-33f2-92d1-f4c62e17790b",
                                        "entry_id": "9088022e-7584-3de0-9d9d-ef5bd1bb7fa2",
                                        "glosses": [
                                            "Made more lenient; less strict; lax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b217cbd0-4c6a-4528-9a85-599e6d391ae2",
                                                "sense_id": "7eeda6fc-ede3-33f2-92d1-f4c62e17790b",
                                                "text": "The relaxed rules were greatly tightened after the lawsuit."
                                            },
                                            {
                                                "example_id": "ac1b3736-88cc-4ed6-9d06-b5ba552d1bf7",
                                                "sense_id": "7eeda6fc-ede3-33f2-92d1-f4c62e17790b",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e441ce9-41ca-3b10-8521-e5568e14805f",
                                        "entry_id": "9088022e-7584-3de0-9d9d-ef5bd1bb7fa2",
                                        "glosses": [
                                            "Free from tension or anxiety; at ease; leisurely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2e309f-e307-4481-8cab-5e6f37722c68",
                                                "sense_id": "7e441ce9-41ca-3b10-8521-e5568e14805f",
                                                "text": "He's a relaxed kind of guy, he never lets himself get upset."
                                            },
                                            {
                                                "example_id": "5c540ffb-cefe-4c53-9f25-7c3945635d71",
                                                "sense_id": "7e441ce9-41ca-3b10-8521-e5568e14805f",
                                                "text": "Students and faculty members lunch at the cafeteria and naturally communicate freely with one another in a relaxed and informal setting."
                                            },
                                            {
                                                "example_id": "9d56f277-c5b8-4182-87bf-359d3d9750b2",
                                                "sense_id": "7e441ce9-41ca-3b10-8521-e5568e14805f",
                                                "text": "Even so, this delightful station is well worth a visit, - either to admire the architecture, sip a coffee from the shop, or just soak up the relaxed atmosphere of the area and watch the birds and other wildlife on the shores right outside the station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d700aa-b8fa-3740-9ea8-11a6a3d1d163",
                                        "entry_id": "9088022e-7584-3de0-9d9d-ef5bd1bb7fa2",
                                        "glosses": [
                                            "Without physical tension; in a state of equilibrium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "298bef3c-50b7-3a62-bc49-bbb489aaeff4",
                                        "entry_id": "9088022e-7584-3de0-9d9d-ef5bd1bb7fa2",
                                        "glosses": [
                                            "Of a muscle: soft, not tensed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
