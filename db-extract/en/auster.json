                "entry_id": "80c0fa90-c282-3ada-94c2-17c619901d63",
                "word": "Auster",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "780f1519-a783-35cf-8b17-fc3e6547ac0e",
                        "entry_id": "80c0fa90-c282-3ada-94c2-17c619901d63",
                        "glosses": [
                            "The god of the south wind."
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "174b0dbb-ad22-4472-85aa-1439ecdf56f3",
                                "sense_id": "780f1519-a783-35cf-8b17-fc3e6547ac0e",
                                "text": "For a Tempeſt. Take Eurus, Zephyr, Auſter and Boreas, and caſt them together in one Verſe. Add to theſe of Rain, Lightning, and of Thunder (the loudeſt you can) quantum ſufficit. Mix your Clouds and Billows well together till they foam, and thicken your Deſcription here and there with a Quickſand. Brew your Tempeſt well in your Head, before you ſet it a blowing."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d24760e-45a5-3815-a492-6c4899119e71",
                        "entry_id": "80c0fa90-c282-3ada-94c2-17c619901d63",
                        "glosses": [
                            "The south wind, especially when personified."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "c571d4cf-fc72-4055-852c-f8600d8bb682",
                                "sense_id": "3d24760e-45a5-3815-a492-6c4899119e71",
                                "text": "Auster and Aquilon with winged Steeds\nAll ſweating, tilt about the watery heauens,\nWith ſhiuering ſpeares enforcing thunderclaps,\nAnd from their ſhields ſtrike flames of lightening"
                            },
                            {
                                "example_id": "0e28e0a3-e1ae-4469-b9d9-a91812d0e895",
                                "sense_id": "3d24760e-45a5-3815-a492-6c4899119e71",
                                "text": "‘My homeland too,’ Aetius grinned. ‘I was born under the Auster.’"
                            }
                        ]
                    }
                ],
