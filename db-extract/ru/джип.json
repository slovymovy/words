                    {
                        "translation_id": "64d8150b-cf81-4d1c-943b-5612aa51b1bb",
                        "source_entry_id": "090ac890-3e61-3e2e-9359-e6a236d60bb8",
                        "source_sense_description": "американская машина",
                        "target_lang_word": "Jeep",
