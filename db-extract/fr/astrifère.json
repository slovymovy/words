                "senses": [
                    {
                        "sense_id": "a3df589d-9e3c-3046-a0b3-5f37f5e4ca2e",
                        "entry_id": "5b3cb76b-d22a-3eea-8ce6-9c9dd9a8174c",
                        "glosses": [
                            "Qualifie un support (pierre gravée, peinture, miniature,sculpture, etc.) où, un ou, des astres sont représentés. Qualifie parfois aussi le ciel étoilé, plein d'astres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281b052c-0c85-4e4c-8a16-1e7275ad7f46",
                                "sense_id": "a3df589d-9e3c-3046-a0b3-5f37f5e4ca2e",
                                "text": "On voit le même char du soleil sur des pierres astrifères avec le symbole isiaque, un astre dans un croissant."
                            },
                            {
                                "example_id": "b1df818a-08ee-4576-b4bd-2ac28327628f",
                                "sense_id": "a3df589d-9e3c-3046-a0b3-5f37f5e4ca2e",
                                "text": "Torse de Minerve astrifère trouvé en 1823 dans les ruines du palais des Césars à Rome, sur le mont Palatin. On donne à cette Minerve le nom d'astrifère, à cause de l'égide étoilée qui lui sert de cuirasse."
                            },
                            {
                                "example_id": "ba2c3550-323a-43e2-8ac0-b433512ec746",
                                "sense_id": "a3df589d-9e3c-3046-a0b3-5f37f5e4ca2e",
                                "text": "Des Terres dans notre monde solaire, qui sont appelées planètes, et des terres dans le ciel astrifère."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
