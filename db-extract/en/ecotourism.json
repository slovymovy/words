                "entry_id": "49e02808-76f2-31c0-a3f9-525070bd8873",
                "word": "ecotourism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1e81a12f-8dcf-4ef2-9603-8287923ba367",
                        "entry_id": "49e02808-76f2-31c0-a3f9-525070bd8873",
                        "tags": [
                            "plural"
                        ],
                        "form": "ecotourisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c93316a-2f58-3fe7-835a-9f1958e94c03",
                        "entry_id": "49e02808-76f2-31c0-a3f9-525070bd8873",
                        "glosses": [
                            "Responsible (sustainable) travel to natural areas supporting the fauna, flora, and local economy."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "869c5829-2c35-44a3-950d-afaf5436b9e7",
                                "sense_id": "6c93316a-2f58-3fe7-835a-9f1958e94c03",
                                "text": "Driven by a search for the perfectly \"grammable\" shot, ecotourism is everywhere on the rise, though it rarely delivers on the promise of its name, which is to reconcile the impulse to consume nature with the desire to conserve it."
                            }
                        ]
                    }
                ],
                "translations": [
