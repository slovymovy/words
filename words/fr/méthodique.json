                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est devenu tellement <w>méthodique</w> qu'il ne supporte plus le moindre changement imprévu."
