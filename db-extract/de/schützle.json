                ],
                "senses": [
                    {
                        "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                        "entry_id": "e2c83cd3-c8ee-3b5b-8d32-2a6502687c16",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec198c93-1472-4b32-a621-6d75c573407a",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Frau Schützle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b72ea7d8-8fb2-4d03-add9-a89e13205193",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Herr Schützle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f4887860-350a-4178-9d58-9d26c858df96",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Die Schützles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "fc5fdfc0-1d25-43e2-bb46-e45f05b8d591",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Der Schützle trägt nie die Pullover, die die Schützle ihm strickt."
                            },
                            {
                                "example_id": "f20b6b97-493f-4826-b6ac-d02c3f833907",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schützle kommt, geht der Herr Schützle.“"
                            },
                            {
                                "example_id": "93a6d2f0-3fae-4d06-a561-099a1033c1fb",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Schützle kommt und geht."
                            },
                            {
                                "example_id": "b96bd26d-28ce-45ea-a8fe-4fef20414781",
                                "sense_id": "43140a33-c3d6-37ca-ba92-86444c2b1cbc",
                                "text": "Schützles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
