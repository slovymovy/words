                                                "example_id": "a61668c8-acbc-4842-98b6-14e3f84c5c81",
                                                "sense_id": "06aa586b-5b63-3464-978d-c1d4b10dce6d",
                                                "text": "Then seemed him his Lady by him lay, / And to him playnd, how that false winged boy, / Her chast hart had subdewd, to learne Dame pleasures toy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21144e2-9ee0-3d8a-a094-1384e50d69f7",
                                        "entry_id": "68b32288-7051-3b28-a4e8-a4e7dbb01f04",
                                        "glosses": [
                                            "A vague fancy, a ridiculous idea or notion; a whim."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d625474c-fce4-4ff5-ad2f-c032938b8090",
                                                "sense_id": "a21144e2-9ee0-3d8a-a094-1384e50d69f7",
                                                "text": "Though they do talk with you, and seem to be otherwise employed, and to your thinking very intent and busy, still that toy runs in their mind, that fear, that suspicion, that abuse, that jealousy […]."
                                            },
                                            {
                                                "example_id": "1c5303dd-e925-4afc-a411-65558b655145",
                                                "sense_id": "a21144e2-9ee0-3d8a-a094-1384e50d69f7",
                                                "text": "To fly about playing their wanton toys."
                                            },
                                            {
                                                "example_id": "dc241f3d-6e94-4e7c-b384-e17044bfa523",
                                                "sense_id": "a21144e2-9ee0-3d8a-a094-1384e50d69f7",
                                                "text": "What if a toy take 'em i'th' heels now, and they all run away."
                                            },
                                            {
                                                "example_id": "caa9ed3f-54ad-4629-a77d-dc4be8d3be58",
                                                "sense_id": "a21144e2-9ee0-3d8a-a094-1384e50d69f7",
                                                "text": "Nor light and idle toys my lines may vainly swell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1501ae-f179-30ee-90bf-1f91ec61c46e",
                                        "entry_id": "68b32288-7051-3b28-a4e8-a4e7dbb01f04",
                                        "glosses": [
                                            "An old story; a silly tale."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed72277d-b1db-4200-abf0-d8fe155d3eb9",
                                                "sense_id": "2a1501ae-f179-30ee-90bf-1f91ec61c46e",
                                                "text": "More strange than true: I never may believe these antique fables, nor these fairy toys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38bc42e6-b023-39d7-913a-0c5c4eae5b4b",
                                        "entry_id": "68b32288-7051-3b28-a4e8-a4e7dbb01f04",
                                        "glosses": [
                                            "A headdress of linen or wool that hangs down over the shoulders, worn by elderly women of the lower classes."
                                        ],
