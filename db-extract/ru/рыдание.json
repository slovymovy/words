                "senses": [
                    {
                        "sense_id": "07f8236b-b443-3a02-8224-f0660cb0fce3",
                        "entry_id": "9dc689e9-78db-3e0e-90b2-46365434936c",
                        "glosses": [
                            "sobbing, weeping"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d417d4-2e75-49eb-b860-2bc8bedac05e",
                                "sense_id": "07f8236b-b443-3a02-8224-f0660cb0fce3",
                                "text": "Е́ли они́, как всегда́ по пра́здникам, утоми́тельно до́лго, мно́го, и каза́лось, что э́то не те лю́ди, кото́рые полчаса́ тому́ наза́д крича́ли друг на дру́га, гото́вые дра́ться, кипе́ли в слеза́х и рыда́ниях.",
                                "translation": "The meal, as usual on Sundays, was interminable and heavy, and my grandparents and mother didn’t seem the same people who half an hour before had been shouting at each other, were at each other’s throats and were all tears and sobbing.",
                                "english": "The meal, as usual on Sundays, was interminable and heavy, and my grandparents and mother didn’t seem the same people who half an hour before had been shouting at each other, were at each other’s throats and were all tears and sobbing."
                            }
                        ]
                    }
                ],
