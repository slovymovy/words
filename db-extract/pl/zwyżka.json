                "senses": [
                    {
                        "sense_id": "cee65f89-ab63-3a11-8cfb-f285cf906afb",
                        "entry_id": "c2ab0358-4396-3577-ad67-2a1c98120d80",
                        "glosses": [
                            "повышение, прирост, возрастание, прибавка, приращение, возвышение, увеличение, рост"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236823f2-1c24-4106-9093-3bccfe2c5f94",
                                "sense_id": "cee65f89-ab63-3a11-8cfb-f285cf906afb",
                                "text": "Zrozumiałem wkrótce, że najlepszym sposobem pozyskania łaski mego wuja będzie dokładne poznanie pieniężnych operacji i pilne baczenie na zwyżki i zniżki kursów.",
                                "translation": "Скоро я понял, что наилучший способ угодить дяде – в совершенстве овладеть денежными операциями и тщательно следить за повышением и понижением курса."
                            }
                        ]
                    }
                ],
