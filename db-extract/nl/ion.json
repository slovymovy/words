            {
                "entry_id": "44dc9295-7b1b-3b8b-aab9-600ca86ef58e",
                "word": "ion",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4582e8b3-8dad-4c08-b45f-053db570d342",
                        "entry_id": "44dc9295-7b1b-3b8b-aab9-600ca86ef58e",
                        "tags": [
