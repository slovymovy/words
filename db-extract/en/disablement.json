{
    "word": "disablement",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "93613516-fc3a-3f3b-b1a7-456c019c6fb2",
                "word": "disablement",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f2d13e3c-0251-428a-a41e-197f1062667c",
                        "entry_id": "93613516-fc3a-3f3b-b1a7-456c019c6fb2",
                        "tags": [
                            "plural"
                        ],
                        "form": "disablements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0973c92b-32ef-3682-a254-8db04495dd29",
                        "entry_id": "93613516-fc3a-3f3b-b1a7-456c019c6fb2",
                        "glosses": [
                            "The action of disabling or the state of being disabled."
                        ],
                        "tags": [
                            "countable",
                            "formal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3169c4c6-a6a0-4ef1-b180-5c761899b3a9",
                                "sense_id": "0973c92b-32ef-3682-a254-8db04495dd29",
                                "text": "The world would change if countries agreed to the disablement of all nuclear weapons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a35b359-f0b0-4c8c-96da-b60306a44dac",
                        "source_entry_id": "93613516-fc3a-3f3b-b1a7-456c019c6fb2",
                        "source_sense_id": "0973c92b-32ef-3682-a254-8db04495dd29",
                        "source_sense_description": "the action of disabling or the state of being disabled",
                        "target_lang_word": "Behinderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Behinderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                        "entry_id": "91cd3a52-5887-35c4-b5bd-28181c1aa182",
                                        "glosses": [
                                            "körperliche oder psychische Funktionsstörung einer Person, so dass sie von dem für das Lebensalter typischen Zustand abweicht und daher ihre Teilhabe am Leben der Gesellschaft beeinträchtigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b5b9c2-7e60-4ebe-bf81-2dfa7850a414",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "Behinderungen führen in vielen Fällen dazu, dass jemand seinen Alltag nicht allein bewältigen kann."
                                            },
                                            {
                                                "example_id": "900dd549-01eb-463d-95b0-560cf85f8bf1",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Die Inklusion an Schulen finden viele Menschen gut. Denn dann fühlen sich Kinder mit Behinderung weniger ausgeschlossen. Und Kinder ohne Behinderung lernen schon früh mit Menschen umzugehen, die eine Behinderung haben. Davon haben beide Seiten etwas.“"
                                            },
                                            {
                                                "example_id": "c3da7dbe-f5de-4379-a9ab-ecece3993b3e",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Seine Schwester Marie ist Lukas Rieger ganz besonders wichtig. […] Sie hat eine seltene Krankheit, die eine Behinderung zur Folge hat.“"
                                            },
                                            {
                                                "example_id": "b0f497a2-c072-40ac-ab8a-b4c6f991a103",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Bei einigen Patienten wird eine langfristige Behinderung zurückbleiben, andere werden sich gut erholen\", so Michael Zandi.“"
                                            },
                                            {
                                                "example_id": "12f03ccb-0c9d-4933-8a77-bf096340a61b",
                                                "sense_id": "8091c05c-c991-33dc-8bf1-6d6042ed0f9a",
                                                "text": "„Dieser Claus trug die Schellenkappe nicht aus Schlauheit, sondern wegen seiner geistigen Behinderung, wie wir heute sagen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                        "entry_id": "91cd3a52-5887-35c4-b5bd-28181c1aa182",
                                        "glosses": [
                                            "Maßnahme oder Ereignis, die dazu führt, dass etwas Beabsichtigtes nicht oder nur erschwert getan werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e835b2c-e73c-4874-9d20-3692fae60b39",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Baustellen führen oft zu starken Behinderungen im Reiseverkehr."
                                            },
                                            {
                                                "example_id": "831100cf-30a9-491d-9c2d-8f75f88ca2ae",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "[…] eine neue Aschewolke des Vulkans Eyjafjallajökull [sorgt] bereits am kommenden Montag, dem 17. Mai 2010, voraussichtlich für neue Behinderungen im europäischen Luftraum."
                                            },
                                            {
                                                "example_id": "ca53f8d7-96d7-481d-b51e-df059dc06c71",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Der öffentliche Nahverkehr wird weiträumig umgeleitet. […] Besonders Anwohner mussten deshalb Behinderungen hinnehmen."
                                            },
                                            {
                                                "example_id": "57be4bae-8c08-4d97-b6ac-d51dbcb17458",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Bei Verstößen [gegen die Winterreifenpflicht] droht ein Bußgeld von 20 Euro, bei Behinderung Anderer 40 Euro sowie ein Punkt in Flensburg."
                                            },
                                            {
                                                "example_id": "64caad04-ea27-4bca-af34-eeaf575b4068",
                                                "sense_id": "6e530fe5-8470-3e8c-86c9-f316a17d2601",
                                                "text": "Ein Kurzschluss führte zum Stromausfall der Schweizer Bahnen. Bis heute Morgen gab es noch immer Behinderungen im Schweizer Bahnverkehr (SBB)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
