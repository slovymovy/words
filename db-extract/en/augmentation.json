                        "examples": [
                            {
                                "example_id": "aa344c63-863f-4898-93ed-9f64c1bdc150",
                                "sense_id": "a2b8f0df-298d-3738-8881-a8ff9d3c4151",
                                "text": "A small tablet is fixt near the Altar, upon wᶜʰ the friends of yᵉ defunct lay their offerings in mony according to their own ability and the quality of the person deceased. This custom proves a very happy augmentation to some of the very poor vicars, and is often the best part of their maintenance."
                            }
                        ]
                    },
                    {
                        "sense_id": "16f8f5d7-847a-3508-8ba6-a1daa84b6577",
                        "entry_id": "c2142ca5-71a6-373a-896a-f546d0548a35",
                        "glosses": [
                            "A particular mark of honour, granted by the sovereign in consideration of some noble action, or by favour; and either quartered with the family arms, or on an escutcheon or canton."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
