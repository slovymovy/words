                "senses": [
                    {
                        "sense_id": "f39b677d-abea-39ec-9d72-1d7217289f8d",
                        "entry_id": "4ad802a2-4317-337e-9478-8cd851a30f48",
                        "glosses": [
                            "Relatif aux composants sympathiques du système nerveux autonome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7837adc5-122c-484f-b714-14fd7102ce2e",
                                "sense_id": "f39b677d-abea-39ec-9d72-1d7217289f8d",
                                "text": "La racine orthosympathique provient du plexus artériel péri-ophtalmique, lui-même des ganglions cervicaux par l’intermédiaire des fibres péricarotidiennes."
                            },
                            {
                                "example_id": "f13b99d6-85ea-4ff5-836f-c92b2771a902",
                                "sense_id": "f39b677d-abea-39ec-9d72-1d7217289f8d",
                                "text": "Tout ce qui concerne le système orthosympathique permet à l'homme de s'adapter aux contraintes du réel."
                            },
                            {
                                "example_id": "3b7289c6-3930-415c-971d-e665fba8fe41",
                                "sense_id": "f39b677d-abea-39ec-9d72-1d7217289f8d",
                                "text": "Le système sympathique autonome, — orthosympathique ou sympathique proprement dit et parasympathique ou vague, — en dépit des liaisons qu’il soutient avec le système neuro-cérébral, a cependant ses fonctions propres."
                            }
                        ]
                    }
                ],
