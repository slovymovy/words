                        "glosses": [
                            "Relatif à Noé, personnage de la Bible."
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "fd2fa8a8-7bbe-4aa7-bad3-6803e96e03b8",
                                "sense_id": "fe0fa5b7-21cf-38be-876b-9e6f4aca76d9",
                                "text": "C’était à peu près l’ensemble des préceptes noachiques, c’est-à-dire qu’on supposait avoir été révélés à Noé, et qui étaient imposés à tous les prosélytes."
                            },
                            {
                                "example_id": "30f70777-44c7-466f-80c0-ae2e9e9398c8",
                                "sense_id": "fe0fa5b7-21cf-38be-876b-9e6f4aca76d9",
                                "text": "La multitude des observances fut ramenée peu à peu à quatre ou cinq préceptes assez simples, dits noachiques, parce qu’ils avaient été, disait-on, imposés aux pères du genre humain sortis de l’arche avec Noé."
                            }
                        ]
                    }
