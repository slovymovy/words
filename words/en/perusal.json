            "senses": [
                {
                    "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                    "sense_definition": "The act of reading or examining something carefully and thoroughly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please find attached the relevant documents for your <w>perusal</w>. ",
                            "target_lang_translations": {
                                "ru": "В приложении направляю соответствующие документы для вашего <w>ознакомления</w>."
                            }
                        },
                        {
                            "text": "After a careful <w>perusal</w> of the contract, she decided not to sign it.",
                            "target_lang_translations": {
                                "ru": "После внимательного <w>изучения</w> контракта она решила его не подписывать."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrutiny",
                        "examination",
                        "inspection"
                    ],
                    "antonyms": [
