                "senses": [
                    {
                        "sense_id": "1df9db21-16f9-34c1-9643-d8348ff9cb80",
                        "entry_id": "43547dba-c589-37d3-9197-99c2da9ceb9a",
                        "glosses": [
                            "weibliche Person oder Firma/Institution, die einen Anteil von etwas besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "310ce5bf-d376-4b18-a8cb-8f262ab039e9",
                                "sense_id": "1df9db21-16f9-34c1-9643-d8348ff9cb80",
                                "text": "„Ein wenig erschöpft ist die Chefredakteurin schon, schließlich ist sie Anfang August plötzlich auch noch Verlagsleiterin und alleinige Anteilseignerin der Econy GmbH geworden.“"
                            }
                        ],
