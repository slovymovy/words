                "senses": [
                    {
                        "sense_id": "8ce42ca1-33f0-3896-8020-0264d365cda4",
                        "entry_id": "74508863-8f86-3797-9775-7b1dce8f791d",
                        "glosses": [
                            "Relatif à Socrate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b396043-048b-46e7-8f07-4743de495f60",
                                "sense_id": "8ce42ca1-33f0-3896-8020-0264d365cda4",
                                "text": "La célèbre inscription du temple de Delphes, \"connais-toi toi-même\", fut le point de départ de la morale socratique."
                            },
                            {
                                "example_id": "75079c5e-3f88-477a-8a97-0d400a69d33e",
                                "sense_id": "8ce42ca1-33f0-3896-8020-0264d365cda4",
                                "text": "Et Rocafort, vous savez qui c’est ? continua le père Milot, persévérant dans la méthode socratique."
                            },
                            {
                                "example_id": "5bb38b05-5368-4bb1-b2b7-3174900b7fd8",
                                "sense_id": "8ce42ca1-33f0-3896-8020-0264d365cda4",
                                "text": "Je trouvais à la figure de Knapwurst quelque chose de socratique, et, tout en me chauffant, en écoutant le feu pétiller, je réfléchissais au sort étrange de certains hommes :"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2b387e9-c9ae-4fe9-affd-d68083bd9ebc",
                        "source_entry_id": "74508863-8f86-3797-9775-7b1dce8f791d",
                        "source_sense_id": "8ce42ca1-33f0-3896-8020-0264d365cda4",
                        "target_lang_word": "Socratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
