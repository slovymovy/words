                        "cross_references": [
                            {
                                "target_word": "Gestapo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcc7f04-8098-3890-b472-9093c2d8c189",
                                        "entry_id": "cb4927f9-3d4b-3dcb-b29a-92828d4356da",
                                        "glosses": [
                                            "Police politique du nazisme."
                                        ],
                                        "tags": [
                                            "Nazism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325d8dac-7ceb-470f-b4ef-3590b2ff5082",
                                                "sense_id": "9dcc7f04-8098-3890-b472-9093c2d8c189",
                                                "text": "Il profite de sa carte de police pour contrôler l’identité de plusieurs suspects fraîchement débarqués à Guingamp, dont un Quinocéen, un sujet italien, un Espagnol, etc. Persuadé qu’il a affaire à des individus au service de la Gestapo, il avertit le lieutenant Louis Piriou, chef de maquis de Plouisy."
                                            },
                                            {
                                                "example_id": "c3ea1213-4122-40a8-b1a7-06ab22200475",
                                                "sense_id": "9dcc7f04-8098-3890-b472-9093c2d8c189",
                                                "text": "Le maréchal Pétain, chef du nouveau gouvernement, était soumis aux forces d’occupation, et la Gestapo agissait avec la collaboration pleine et entière de la gendarmerie française."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1c0125-39de-3761-908b-9d9ddd3da9f6",
                                        "entry_id": "cb4927f9-3d4b-3dcb-b29a-92828d4356da",
                                        "glosses": [
                                            "Police qui pratique la torture, les massacres individuels ou de masse, etc."
                                        ],
                                        "tags": [
                                            "hyperbole",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
