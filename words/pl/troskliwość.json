                    "sense_id": "ae89ea65-c83e-3a61-896c-e565e820c51a",
                    "sense_definition": "postawa charakteryzująca się dbałością o kogoś lub coś oraz chęcią zapewnienia bezpieczeństwa i komfortu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opieka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej <w>troskliwość</w> wobec chorych rodziców jest godna podziwu.",
                            "target_lang_translations": {
                                "ru": "Её <w>заботливость</w> по отношению к больным родителям достойна восхищения."
                            }
                        },
                        {
                            "text": "Okazywana przez matkę <w>troskliwość</w> sprawiała, że dziecko czuło się bezpiecznie.",
                            "target_lang_translations": {
                                "ru": "Проявляемая матерью <w>забота</w> помогала ребёнку чувствовать себя в безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "dbałość",
                        "opiekuńczość",
                        "pieczołowitość",
                        "staranność"
                    ],
                    "common_phrases": [
                        "wielka troskliwość",
                        "okazywać troskliwość"
                    ],
                    "target_lang_definitions": {
                        "ru": "отношение, характеризующееся заботой о ком-либо или чем-либо, а также желанием обеспечить безопасность и комфорт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заботливость",
                                "target_lang_sense_clarification": "проявление внимания и ухода за кем-то"
                            },
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "внимание и участие в чьих-либо делах или нуждах"
                            },
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "постоянное внимание и попечение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceea3a96-73f2-3c95-84a4-4d29ffc8c996",
                    "sense_definition": "stan silnego zmartwienia lub wewnętrznego niepokoju",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zmartwienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego twarz wyrażała głęboką <w>troskliwość</w> o losy przyszłego projektu.",
                            "target_lang_translations": {
                                "ru": "Его лицо выражало глубокую <w>тревогу</w> за судьбу будущего проекта."
                            }
                        },
                        {
                            "text": "W jej oczach malowała się <w>troskliwość</w> spowodowana nagłymi problemami w pracy.",
                            "target_lang_translations": {
                                "ru": "В её глазах читалось <w>беспокойство</w>, вызванное внезапными проблемами на работе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "состояние сильного беспокойства или внутренней тревоги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревога",
                                "target_lang_sense_clarification": "чувство беспокойства за исход дела"
