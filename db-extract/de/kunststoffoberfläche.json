                "senses": [
                    {
                        "sense_id": "9dc37685-b53d-370f-90af-a7bd8b96730f",
                        "entry_id": "55e76556-03a9-31e4-b650-73084425e855",
                        "glosses": [
                            "alle inneren oder äußeren Flächen, die ein Objekt durch Polymere oberflächlich begrenzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b1003e-98e7-42f1-b0ec-c9ff201699e9",
                                "sense_id": "9dc37685-b53d-370f-90af-a7bd8b96730f",
                                "text": "„Neben einer perfekten Oberflächen-, Design- und Farbabstimmung der einzelnen Kunststoffoberflächen sei eine möglichst angenehme Haptik für das elegante Erscheinungsbild ohne Kratzspuren entscheidend und prägend. “"
                            },
                            {
                                "example_id": "69a57cf3-927d-4b98-8227-58add575718d",
                                "sense_id": "9dc37685-b53d-370f-90af-a7bd8b96730f",
                                "text": "„In Küchen, Bädern, Schlaf- und Wohnzimmern haben längst Möbel mit einer Kunststoffoberfläche (z.B. aus Melamin) Einzug gehalten.“"
                            },
                            {
                                "example_id": "47b4f337-2684-43b3-9670-ea7712f92305",
                                "sense_id": "9dc37685-b53d-370f-90af-a7bd8b96730f",
                                "text": "„Durch die nanoskaligen Silberpartikel haben Bakterien in Kunststoffoberflächen keine Chance.“"
                            },
                            {
                                "example_id": "4ecdd2c2-2eed-4d53-8f58-df651fbe3c36",
                                "sense_id": "9dc37685-b53d-370f-90af-a7bd8b96730f",
                                "text": "„Mit Hilfe von Plasmaprozessen können Kunststoffoberflächen funktionell modifiziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
