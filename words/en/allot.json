                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many students write <w>allot</w> when they actually mean to write two separate words.",
                            "target_lang_translations": {
                                "ru": "Многие студенты пишут <w>allot</w>, хотя на самом деле имеют в виду два отдельных слова."
                            }
                        },
                        {
                            "text": "He made a mistake on his essay by spelling the phrase as <w>allot</w>.",
                            "target_lang_translations": {
                                "ru": "Он совершил ошибку в своем эссе, написав фразу как <w>allot</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common spelling error"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная орфографическая ошибка вместо словосочетания «a lot» (много)."
                    },
                    "translations": {
