                "senses": [
                    {
                        "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                        "entry_id": "e5085510-df51-3caa-9858-e0f0ed215fa8",
                        "glosses": [
                            "Having beautifully shaped buttocks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc015d3-a461-4eea-9784-ac0f5489eec1",
                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                "text": "[…]we soon once more were in a state to renew our delicious combat; and a second course was run in the delightful callipygian recesses of Venus’s second temple of lubricity."
                            },
                            {
                                "example_id": "389338c6-02b9-475f-b762-26b09ea33652",
                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                "text": "Suddenly the music grew fainter, as if drawing away, and the dancers, their feet together and limbs half opened, descended in a slow spiral, with gentle undulations, until they touched the floor; the instant their callipygian charms grazed the mosaic, they recoiled like suddenly awakened serpents, […]"
                            },
                            {
                                "example_id": "24dcffbe-d478-450a-ba73-c51a4f30287b",
                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                "text": "Her gown (perhaps as a result of the scorching winds coming off the ambas) clung damply to her body, clearly revealing her callipygian curves and the entire shapely length of her legs."
                            },
                            {
                                "example_id": "b7828ed3-7893-4ca0-a4b5-e6848f5c6c69",
                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                "text": "[T-Rex:] My lovely visage, callipygian frame, startlingly awesome calves and charming smile will yet go down in history!"
                            },
                            {
                                "example_id": "3e1fa17d-e0d6-4e18-b439-14bd91bbe01f",
                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                "text": "With trepidation, but not embarrassment, I offer the thought that Mrs. Obama, a formerly disadvantaged alumna of Princeton and Harvard, to judge from her well-strategized appearances on national television in exiguous dresses and trousers, is as callipygian as Jennifer Lopez."
                            }
                        ]
                    },
                    {
                        "sense_id": "21090433-865c-32d2-857a-235b28ebe3e0",
                        "entry_id": "e5085510-df51-3caa-9858-e0f0ed215fa8",
                        "glosses": [
                            "Specifically, describing a statue (often of a goddess such as Aphrodite) in a pose that shows off the figure's shapely buttocks."
