{
    "word_family": [
        "overgrow",
        "overgrowth"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a186a357-b221-3713-b2f6-588eab2841e0",
                    "sense_definition": "Covered with plants that have grown too large or wild.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>overgrown</w> garden was full of weeds and tangled bushes.",
                            "target_lang_translations": {
                                "zh": "那座<w>杂草丛生的</w>花园里长满了野草和纠缠在一起的灌木。"
                            }
                        },
                        {
                            "text": "We struggled to walk along the <w>overgrown</w> path behind the house.",
                            "target_lang_translations": {
                                "zh": "我们费力地走在屋后那条<w>蔓生的</w>小路上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tangled",
                        "wild"
                    ],
                    "antonyms": [
                        "manicured",
                        "pruned"
                    ],
                    "common_phrases": [
                        "overgrown garden",
                        "overgrown path"
                    ],
                    "target_lang_definitions": {
                        "zh": "指被生长得过于茂盛或杂乱的植物所覆盖。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "杂草丛生的",
                                "target_lang_sense_clarification": "形容被杂草或植物覆盖，显得荒芜。"
                            },
                            {
                                "target_lang_word": "蔓生的",
                                "target_lang_sense_clarification": "形容植物生长蔓延，覆盖了原本的区域。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82f9ea72-de0b-3138-a7e6-a1367452f0ab",
                    "sense_definition": "Having grown physically large while remaining immature in character or behavior.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acts like an <w>overgrown</w> child whenever he does not get his way.",
                            "target_lang_translations": {
                                "zh": "每当不如意时，他就像个<w>长不大的</w>孩子一样闹脾气。"
                            }
                        },
                        {
                            "text": "The team captain is just an <w>overgrown</w> schoolboy who refuses to take responsibility.",
                            "target_lang_translations": {
                                "zh": "队长不过是个拒绝承担责任的<w>幼稚的</w>学生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immature",
                        "childish"
                    ],
                    "antonyms": [
                        "mature",
                        "adult"
                    ],
                    "common_phrases": [
                        "overgrown child",
                        "overgrown schoolboy"
                    ],
                    "target_lang_definitions": {
                        "zh": "指身体已经长大成人，但心智或行为依然幼稚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长不大的",
                                "target_lang_sense_clarification": "形容人虽然成年但行为举止像孩子。"
                            },
                            {
                                "target_lang_word": "幼稚的",
                                "target_lang_sense_clarification": "形容成年人表现出与其年龄不符的幼稚行为。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a27de67-429d-3b19-9d1c-dd4a6c497538",
                    "sense_definition": "Past participle of <w>overgrow</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old ruins have been <w>overgrown</w> by thick ivy over the centuries.",
                            "target_lang_translations": {
                                "zh": "几个世纪以来，古老的遗迹已经被茂密的常春藤<w>覆盖</w>了。"
                            }
                        },
                        {
                            "text": "The fence was completely <w>overgrown</w> with climbing roses by mid-summer.",
                            "target_lang_translations": {
                                "zh": "到了仲夏，篱笆上已经完全<w>长满</w>了攀援玫瑰。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 overgrow 的过去分词，指被植物覆盖。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "被……覆盖",
                                "target_lang_sense_clarification": "指植物生长并遮盖了某物。"
                            },
                            {
                                "target_lang_word": "长满",
                                "target_lang_sense_clarification": "指某处长满了植物。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}