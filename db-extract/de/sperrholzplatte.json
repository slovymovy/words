                "senses": [
                    {
                        "sense_id": "8df67277-dbf5-3f0d-9429-37d2ed8fc1e4",
                        "entry_id": "3de4354e-1ac1-3e38-ac30-72bed1dd74c3",
                        "glosses": [
                            "Platte aus Sperrholz"
