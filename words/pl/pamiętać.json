{
    "word_family": [
        "pamięć",
        "pamiątka",
        "pamiętnik",
        "pamiętny",
        "pamięciowy",
        "pamiętliwy",
        "zapamiętać",
        "przypomnieć",
        "wypomnieć",
        "upamiętnić",
