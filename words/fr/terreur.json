                },
                {
                    "sense_id": "9833435e-ce11-3027-806e-e6fed60ecea1",
                    "sense_definition": "Personne particulièrement redoutable, agressive ou turbulente qui inspire la crainte à son entourage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_crainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune garçon bagarreur est devenu la véritable <w>terreur</w> de la cour de récréation."
                        },
                        {
                            "text": "Le chef de cette bande armée était une redoutable <w>terreur</w> pour les commerçants du quartier."
