                "senses": [
                    {
                        "sense_id": "c1ad7954-b8cb-32f7-a73b-5e4ef3cecf26",
                        "entry_id": "aab47b04-9c81-36d6-8e2b-bb19570d9573",
                        "glosses": [
                            "The smell of burning animals, especially of burning animal fat."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5260909-7679-4108-bda4-fa57e9101ef6",
                                "sense_id": "c1ad7954-b8cb-32f7-a73b-5e4ef3cecf26",
                                "text": "the material Demons do strangely gluttonize upon the Nidours and Bloud of Sacrifices"
                            },
                            {
                                "example_id": "9683e69c-731f-490a-8adc-7c9f0c4d66f2",
                                "sense_id": "c1ad7954-b8cb-32f7-a73b-5e4ef3cecf26",
                                "text": "The First-fruits were a common Oblation to their Deities; but the chief Part of their Worship consisted in sacrificiing Animals : And this they did out of a real Persuasion, that their Gods were pleased with their Blood, and were nourished with the Smoke, and Nidor of them; and therefore the more costly, they thought them the more acceptable, for which Reason, they stuck not sometimes to regale them with human Sacrifices."
                            },
                            {
                                "example_id": "19d6e122-ceb7-4af1-bf49-e9598358b5e4",
                                "sense_id": "c1ad7954-b8cb-32f7-a73b-5e4ef3cecf26",
                                "text": "Elsewhere to blood, smoke, and nidor, he opposes purity of thought, sincerity of affection, […]"
                            },
                            {
                                "example_id": "0bd066fa-aa61-4876-a7a8-ac5439ba501b",
                                "sense_id": "c1ad7954-b8cb-32f7-a73b-5e4ef3cecf26",
                                "text": "The smell, at some times of year sensible for Miles, of Sheep, and wool-fat, and that queasy Nidor of Lambs baking in ovens meant for bread […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "424037df-dc7c-38e1-ac87-70ea86e8b3eb",
                        "entry_id": "aab47b04-9c81-36d6-8e2b-bb19570d9573",
                        "glosses": [
                            "Any smell."
                        ],
                        "tags": [
                            "countable",
                            "nonstandard",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "34764663-c49b-422f-9a6b-73d931809573",
                                "sense_id": "424037df-dc7c-38e1-ac87-70ea86e8b3eb",
                                "text": "For her part Vicki smells little, not even the nidor of antifreeze at the stock car races at Lake Doucette."
                            },
                            {
                                "example_id": "35223ea6-1bb9-4b49-9a65-d0efea860eb0",
                                "sense_id": "424037df-dc7c-38e1-ac87-70ea86e8b3eb",
                                "text": "The long, yellow face was framed in side whiskers; there hung about him the nidor of stale cigar smoke."
                            }
                        ]
                    }
