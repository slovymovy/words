                                    {
                                        "sense_id": "e718f601-50e6-3548-8956-8968ae293e53",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "A blow, especially one given with the open hand, or with something broad and flat."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1f784b4-e3c6-424d-bd77-d63b0bc128b8",
                                                "sense_id": "e718f601-50e6-3548-8956-8968ae293e53",
                                                "text": "He gave me a friendly slap on the back as a sign of camaraderie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b89d040-999c-3e96-b5e0-826bb5f56d81",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "A sharp percussive sound like that produced by such a blow."
