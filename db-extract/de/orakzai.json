                "senses": [
                    {
                        "sense_id": "74b0da9a-4682-3403-9cb9-cd906926636b",
                        "entry_id": "cc4306af-0279-3e8c-80bf-db6d877c1731",
                        "glosses": [
                            "Angehöriger eines im Tirah-Tal lebenden paschtunischen Stammes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c7bd749-5f36-4caa-bcbb-3ebc221c7702",
                                "sense_id": "74b0da9a-4682-3403-9cb9-cd906926636b",
                                "text": "„Bei jedem Grüppchen, das vorbeikam, flüsterte er mir ins Ohr. »Die sind von einem Nachbarstamm, den Para Chamkanis«, sagte er dann beispielsweise. »Hast du die Beinkleider gesehen, die sie tragen?« Oder: »Schau, das sind Orakzais. Ich frage mich, was sie hier wollen. Sie haben doch ihr eigenes Bagh.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
