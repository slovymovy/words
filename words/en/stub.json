                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remnants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a short <w>stub</w> of the pencil remained after weeks of writing.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель письма от карандаша остался лишь маленький <w>огрызок</w>."
                            }
                        },
                        {
                            "text": "He tripped over a wooden <w>stub</w> sticking out of the forest floor.",
                            "target_lang_translations": {
                                "ru": "Он споткнулся о деревянный <w>обрубок</w>, торчащий из земли в лесу."
