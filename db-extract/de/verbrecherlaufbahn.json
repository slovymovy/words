                        "examples": [
                            {
                                "example_id": "0e6d778f-20a3-4e5c-99d2-de1d9a150540",
                                "sense_id": "81c5a6ac-a609-31e3-ade4-9d0ae5691ee0",
                                "text": "„Es war die traditionelle Verbrecherlaufbahn, und viele fielen schon in diesen Vorrunden durch.“"
                            },
                            {
                                "example_id": "95743f32-b049-45ce-8f27-7909019406c0",
                                "sense_id": "81c5a6ac-a609-31e3-ade4-9d0ae5691ee0",
                                "text": "„Berkowitz, der seine Verbrecherlaufbahn als Brandstifter begonnen hatte, erzählte uns, dass er jede Nacht auf die Jagd nach Opfern ging, die seinen Vorstellungen entsprachen.“"
                            }
                        ],
