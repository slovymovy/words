                    {
                        "translation_id": "5ef31799-bdfe-48b5-be6e-d6e67f0e3bb2",
                        "source_entry_id": "e34817c2-f5b5-3cea-bd73-386c80e29413",
                        "source_sense_id": "79cd5055-3770-3598-9dd2-515d9c5f254f",
                        "source_sense_description": "chemisches Element mit der Ordnungszahl 84",
