                                        "sense_id": "9a9c501c-f7fc-359c-b1ac-7c9206af64db",
                                        "entry_id": "31881dbd-fe04-31b7-b1ee-fc2167f5f025",
                                        "glosses": [
                                            "simple past and past participle of disuse"
                                        ],
