                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2356a6f-1fe9-4b18-9dfc-3b66e032637e",
                                "sense_id": "a9d5fc29-be64-3667-8fe1-f7747e41a4af",
                                "text": "Das ist halt eben eine Marke von Weltruf."
                            },
                            {
                                "example_id": "2a9f26d7-ece2-4d2c-8b97-6f8a8375dd5f",
                                "sense_id": "a9d5fc29-be64-3667-8fe1-f7747e41a4af",
                                "text": "„Einsteins Vortrag wohnten viele Gelehrte von Weltruf bei, so Madame Curie und der Philosoph Henri Bergson.“"
                            },
                            {
                                "example_id": "69209c46-295c-4812-9873-8c552833c590",
                                "sense_id": "a9d5fc29-be64-3667-8fe1-f7747e41a4af",
                                "text": "„Die Universität Padua aber hatte Weltruf.“"
                            }
                        ],
