                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся вредным или создающим проблемы для общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "вызывающий подозрения"
                            },
                            {
                                "target_lang_word": "криминальный",
                                "target_lang_sense_clarification": "связанный с преступным миром"
                            },
                            {
                                "target_lang_word": "неблагополучный",
                                "target_lang_sense_clarification": "о репутации или деятельности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
