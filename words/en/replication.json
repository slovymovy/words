                {
                    "sense_id": "4a02a808-af1f-3bc3-b0a0-d3d02bd6a6a6",
                    "sense_definition": "The frequent electronic copying of data from one database to another to ensure consistency.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system uses data <w>replication</w> to ensure that no information is lost during a crash.",
                            "target_lang_translations": {
                                "ru": "Система использует <w>репликацию</w> данных, чтобы гарантировать, что информация не будет потеряна при сбое."
