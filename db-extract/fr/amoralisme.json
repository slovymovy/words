                                        "entry_id": "92e1eed0-6fb5-30ba-98be-e63adc01eb61",
                                        "glosses": [
                                            "doctrine which advocates absence of, or indifference towards any morality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
