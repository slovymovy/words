                "senses": [
                    {
                        "sense_id": "a0e1b972-751b-3065-96e5-3e8e9f14288d",
                        "entry_id": "e73787a0-dcfa-3d98-b625-93ffc1b8bbb5",
                        "glosses": [
                            "Drojki."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a42065d-e06c-47e5-857a-a5b49e38bc52",
                                "sense_id": "a0e1b972-751b-3065-96e5-3e8e9f14288d",
                                "text": "La fatigue du Lout nous tenait encore bien. On s'endormait partout. Chez le barbier, appuyés au guichet de la poste, au trot des droshky jaunes qui remplacent ici les taxis ; […]"
                            },
                            {
                                "example_id": "d86e60c1-5ea5-42bd-aad6-b08c74008e70",
                                "sense_id": "a0e1b972-751b-3065-96e5-3e8e9f14288d",
                                "text": "Des droshkies allaient et venaient comme au XIXᵉ siècle, au rythme du trot de chevaux caparaçonnés. Rêveurs et anonymes, des passants déambulaient sur l’avenue Centrale (ex-rue Lénine) : des hommes aux yeux clairs en survêtement ou en jeans, des femmes en robes vagues."
                            }
                        ]
                    }
