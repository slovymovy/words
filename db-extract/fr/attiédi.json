                "senses": [
                    {
                        "sense_id": "1fe5307d-0a65-33ab-b8a6-ff659bf441a6",
                        "entry_id": "3f8e7cc8-f44f-3af0-b875-119bed5a417c",
                        "glosses": [
                            "Édulcoré ; adouci ; devenu tiède ou sans vigueur."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "3f7e13bc-c143-4764-9146-8a7291c0abdf",
                                "sense_id": "1fe5307d-0a65-33ab-b8a6-ff659bf441a6",
                                "text": "[…]; tous furent d'avis de capituler, à l'exception de Muza, dont les paroles courageuses demeurèrent sans effet sur des âmes attiédies et découragées."
                            },
                            {
                                "example_id": "a3010856-d471-49ee-a3fd-ee85bcefc2aa",
                                "sense_id": "1fe5307d-0a65-33ab-b8a6-ff659bf441a6",
                                "text": "Je m'étais ajusté à ce lit absolu, convexe, immatériel, frémissant de songes très doux et très cruels, où la faim, le désir, gardaient des contours incertains, des couleurs attiédies, des paroles mêlées, confuses."
                            },
                            {
                                "example_id": "1f2cbce8-188e-4aa1-a6b0-6cde427a930b",
                                "sense_id": "1fe5307d-0a65-33ab-b8a6-ff659bf441a6",
                                "text": "Un orchestre jouait-il dans une auberge des environs et en étaient-ce les sons attiédis, apportés par le vent ?"
                            }
                        ]
                    }
                ],
