{
    "word_family": [
        "louse"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba177537-356c-3605-90eb-44e1aa9fcda4",
                    "sense_definition": "Remarkably bad or of poor quality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The service at that restaurant was <w>lousy</w> and we waited an hour for our food.",
                            "target_lang_translations": {
                                "tr": "O restorandaki hizmet <w>berbattı</w> ve yemeğimiz için bir saat bekledik."
                            }
                        },
                        {
                            "text": "He had a <w>lousy</w> day at work because everything went wrong.",
                            "target_lang_translations": {
                                "tr": "İşte <w>berbat</w> bir gün geçirdi çünkü her şey ters gitti."
                            }
                        }
                    ],
                    "synonyms": [
                        "miserable"
                    ],
                    "common_phrases": [
                        "lousy service",
                        "lousy weather"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok kötü, kalitesiz veya berbat."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "berbat",
                                "target_lang_sense_clarification": "Bir şeyin kalitesinin çok düşük olduğunu belirtir."
                            },
                            {
                                "target_lang_word": "kötü",
                                "target_lang_sense_clarification": "Genel olarak olumsuz veya yetersiz durumlar için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fc6d577-9303-35bd-8322-e9f12a436a4b",
                    "sense_definition": "Feeling unwell or under the weather.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unwell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been feeling <w>lousy</w> all morning so I decided to stay home.",
                            "target_lang_translations": {
                                "tr": "Tüm sabah kendimi <w>keyifsiz</w> hissettim, bu yüzden evde kalmaya karar verdim."
                            }
                        },
                        {
                            "text": "After eating that expired food I felt <w>lousy</w> for the rest of the night.",
                            "target_lang_translations": {
                                "tr": "Son kullanma tarihi geçmiş o yemeği yedikten sonra gecenin geri kalanında kendimi <w>berbat</w> hissettim."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feeling lousy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kendini hasta veya keyifsiz hissetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "keyifsiz",
                                "target_lang_sense_clarification": "Sağlık durumu veya genel ruh hali iyi olmadığında."
                            },
                            {
                                "target_lang_word": "hasta gibi",
                                "target_lang_sense_clarification": "Kendini fiziksel olarak kötü hissetme durumu."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542866dc-e7cd-342f-9b7c-98ef889e65f3",
                    "sense_definition": "Filled or packed with something, usually something unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "filled_with",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old basement was <w>lousy</w> with spiders and dust.",
                            "target_lang_translations": {
                                "tr": "Eski bodrum örümcek ve tozdan <w>kaynıyordu</w>."
                            }
                        },
                        {
                            "text": "The city streets were <w>lousy</w> with tourists during the summer festival.",
                            "target_lang_translations": {
                                "tr": "Yaz festivali sırasında şehir sokakları turistten <w>geçilmiyordu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "teeming",
                        "riddled"
                    ],
                    "common_phrases": [
                        "lousy with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle istenmeyen bir şeyle dolu veya istila edilmiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kaynayan",
                                "target_lang_sense_clarification": "Bir yerin bir şeyle aşırı derecede dolu olduğunu belirtir."
                            },
                            {
                                "target_lang_word": "dolu",
                                "target_lang_sense_clarification": "Bir şeyin yoğun miktarda bulunması."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38d25fdb-e9f9-396c-bfdc-e827db972e83",
                    "sense_definition": "Underhanded, mean, or contemptible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bad_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>lousy</w> trick to play on your best friend.",
                            "target_lang_translations": {
                                "tr": "En yakın arkadaşına yapılmış <w>alçakça</w> bir şakaydı."
                            }
                        },
                        {
                            "text": "He made a <w>lousy</w> comment about her appearance during the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantı sırasında dış görünüşü hakkında <w>aşağılık</w> bir yorum yaptı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Alçakça, kaba veya aşağılık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alçakça",
                                "target_lang_sense_clarification": "Karaktersiz veya kötü niyetli davranışlar için."
                            },
                            {
                                "target_lang_word": "aşağılık",
                                "target_lang_sense_clarification": "Kötü niyetli veya saygısız tutumlar için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46639430-839d-3765-b3a8-b49936263a31",
                    "sense_definition": "Infested with lice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "infestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dog was <w>lousy</w> and needed immediate medical treatment.",
                            "target_lang_translations": {
                                "tr": "Sokak köpeği <w>bitliydi</w> ve acil tıbbi tedaviye ihtiyacı vardı."
                            }
                        },
                        {
                            "text": "Living in such poor conditions left the children <w>lousy</w> and sick.",
                            "target_lang_translations": {
                                "tr": "Böylesine kötü koşullarda yaşamak çocukları <w>bitli</w> ve hasta bıraktı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bitlenmiş, bitlerle dolu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bitli",
                                "target_lang_sense_clarification": "Üzerinde bit bulunan canlılar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dec749c-c4fe-30ed-b930-f9864f9734be",
                    "sense_definition": "Dirty or untidy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to sleep in the <w>lousy</w> room at the cheap motel.",
                            "target_lang_translations": {
                                "tr": "Ucuz moteldeki <w>pis</w> odada uyumayı reddetti."
                            }
                        },
                        {
                            "text": "The <w>lousy</w> apartment had not been cleaned in several months.",
                            "target_lang_translations": {
                                "tr": "<w>Bakımsız</w> daire aylardır temizlenmemişti."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kirli veya düzensiz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "pis",
                                "target_lang_sense_clarification": "Temiz olmayan yerler veya durumlar için."
                            },
                            {
                                "target_lang_word": "bakımsız",
                                "target_lang_sense_clarification": "Düzenli temizlenmemiş veya ilgilenilmemiş yerler için."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}