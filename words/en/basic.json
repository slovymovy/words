                            {
                                "target_lang_word": "азы́",
                                "target_lang_sense_clarification": "начальные сведения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temeller",
                                "target_lang_sense_clarification": "bir konunun esasları, başlangıç bilgileri"
                            },
                            {
                                "target_lang_word": "esaslar",
                                "target_lang_sense_clarification": "ana ilkeler"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "事物的根基或入门知识"
                            },
                            {
                                "target_lang_word": "入门",
                                "target_lang_sense_clarification": "初步的知识或技能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42096044-8e4e-3dbf-9704-62dc82b95f93",
                    "sense_definition": "A necessary commodity or staple requirement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_commodity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rice is a <w>basic</w> in the diet of many Asian villagers.",
                            "target_lang_translations": {
                                "ru": "Рис — это <w>осно́ва</w> рациона многих жителей азиатских деревень.",
                                "tr": "Pirinç, birçok Asyalı köylünün beslenmesinde <w>temel gıdadır</w>.",
                                "zh": "大米是许多亚洲村民饮食中的<w>必需品</w>。"
                            }
                        },
                        {
                            "text": "We need to go to the store to buy some <w>basics</w> like milk and bread.",
                            "target_lang_translations": {
                                "ru": "Нам нужно пойти в магазин, чтобы купить кое-какие <w>ба́зовые проду́кты</w>, такие как молоко и хлеб.",
                                "tr": "Süt ve ekmek gibi bazı <w>temel ihtiyaçları</w> almak için markete gitmemiz gerekiyor.",
                                "zh": "我们需要去商店买些牛奶和面包之类的<w>必需品</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
