        "fr-extract.jsonl": [
            {
                "entry_id": "7d4eaf64-4ca9-31db-953f-ff4467cb8923",
                "word": "contraception",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b014621b-0258-47b9-80ab-30663678fa84",
                        "entry_id": "7d4eaf64-4ca9-31db-953f-ff4467cb8923",
                        "tags": [
                            "plural"
                        ],
                        "form": "contraceptions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7da6fe6e-47e4-349c-8f81-435d54fdb8aa",
                        "entry_id": "7d4eaf64-4ca9-31db-953f-ff4467cb8923",
                        "glosses": [
                            "Moyen employé pour éviter que des rapports sexuels n’aboutissent à une grossesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ba5422c-86be-421b-bdf0-4df9623067bc",
                                "sense_id": "7da6fe6e-47e4-349c-8f81-435d54fdb8aa",
                                "text": "En raison de la connaissance limitée du système humain de reproduction, la distinction entre contraception et avortement demeura floue pendant des siècles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fdf7e68-14f0-4390-b57d-b71c65fdf42a",
                        "source_entry_id": "7d4eaf64-4ca9-31db-953f-ff4467cb8923",
                        "source_sense_id": "7da6fe6e-47e4-349c-8f81-435d54fdb8aa",
                        "target_lang_word": "Empfängnisverhütung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfängnisverhütung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                        "entry_id": "0b66100f-d7fe-3aa9-b878-b396fa3abf6a",
                                        "glosses": [
                                            "Verhinderung einer unerwünschte Schwangerschaft durch entsprechende Mittel und Methoden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bbe666-b652-49e6-af1b-b88a21a30b74",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Die Antibabypille ist das bekannteste Mittel zur Empfängnisverhütung."
                                            },
                                            {
                                                "example_id": "a45d1378-f81c-4cac-bf52-6fbc9430c6f8",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Für viele Mädchen ist die Empfängnisverhütung der Schutz vor einer ungewollten Schwangerschaft."
                                            },
                                            {
                                                "example_id": "08791e60-64fe-46de-8941-f4543f854fd4",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Die Empfängnisverhütung dient in erster Linie der Familienplanung."
                                            },
                                            {
                                                "example_id": "45e4a989-2c51-4a41-97d7-44d7134beb69",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Der sogenannte Coitus interruptus ist eine der unsichersten Arten der Empfängnisverhütung."
                                            },
                                            {
                                                "example_id": "21ff9d44-4742-4dd9-8a9f-84e3a58e4fd1",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "„Tabuiert sind natürlich auch alle möglichen Mittel und Wege der Empfängnisverhütung.“"
                                            },
                                            {
                                                "example_id": "fed9b2be-0287-4092-9b5d-b7cceb929b75",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "„Allerdings betreiben die Ägypter auch Maßnahmen zur Empfängnisverhütung (Diaphragma-Prinzip) und nehmen Abtreibungen vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
