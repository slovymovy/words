                        "entry_id": "4f6e617a-e64a-3d2c-b7d1-1cc332009165",
                        "glosses": [
                            "Maschine zur Zerkleinerung von großen Stücke in kleinere Stücke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04caa630-700e-4c49-94e7-8ec4cdb94744",
                                "sense_id": "e4c62bf8-7bcc-358d-b8f4-ae4dcef48d62",
