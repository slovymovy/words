                ],
                "senses": [
                    {
                        "sense_id": "3eaa3b88-1688-34f6-91ee-c1ec816d94eb",
                        "entry_id": "7f8a8181-62dc-3d4c-90ad-691deee614bb",
                        "glosses": [
                            "jemanden mit dem für Pferde typischen Geräusch des Wieherns begrüßen"
                        ],
                        "tags": [
                            "als Pferd oder selten auch als laut lachender Mensch"
                        ],
                        "examples": [
                            {
                                "example_id": "70c035f3-bc0c-4120-9a4e-25d23730cc1f",
                                "sense_id": "3eaa3b88-1688-34f6-91ee-c1ec816d94eb",
                                "text": "„Sätze wie: ‚Hör mal, wie mein Pferd mir zuwiehert, es liebt mich genauso, wie ich es auch liebe‘, machen mich nachdenklich. Ist es nicht eher möglich, dass das Pferd wiehert, weil seine gewohnte Fütterungszeit eingetreten ist?“"
                            },
                            {
                                "example_id": "83f61ba9-0ef2-49b7-95c0-2ca8dbec26bc",
                                "sense_id": "3eaa3b88-1688-34f6-91ee-c1ec816d94eb",
                                "text": "„Wittern jedoch die erstern Menschen oder sonstige Gefahr, so treiben sie die Heerde schnell zusammen, indem sie sich gegenseitig, wie Schildwachen, zuwiehern, um den andern nahen Heerden die Gefahr zu verkünden.“ (1839)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
