                    ]
                },
                {
                    "sense_id": "6c649b24-f033-3a86-a5b0-776890a3b7db",
                    "sense_definition": "Unité internationale de mesure du volume intérieur et de la capacité de transport d'un navire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux navire de commerce jaugeait près de deux cents <w>tonneaux</w> à l'époque coloniale."
                        },
                        {
                            "text": "Le port ne permet plus d'amarrer des bâtiments de plus de mille <w>tonneaux</w>."
                        }
                    ],
                    "common_phrases": [
                        "tonneau de jauge"
                    ]
                },
                {
                    "sense_id": "8dd344e5-ca0e-3369-8195-ddab9381ec36",
                    "sense_definition": "Personne qui boit excessivement d'alcool ; buveur invétéré.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet individu passe ses journées au comptoir, c'est un véritable <w>tonneau</w> sans fond."
