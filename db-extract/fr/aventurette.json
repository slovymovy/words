                        "glosses": [
                            "Adultère ; relation amoureuse sans lendemain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb4453f-9712-43d3-aece-710c4db8baa8",
                                "sense_id": "282e452c-9ace-35d3-a800-6d3d68180675",
                                "text": "J’eus cependant une aventurette avec une ouvrière de Céleste, sans la connaître pour telle : c’'est la petite Blanche, rencontrée à onze heures du soir."
                            }
                        ]
                    }
                ],
