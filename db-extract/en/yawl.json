                    },
                    {
                        "translation_id": "bb167c0f-8f49-4ed0-befc-fc9c77cadece",
                        "source_entry_id": "5bb9d05b-bbed-33ce-93f7-3bc8264870a5",
                        "source_sense_description": "sailing vessel",
                        "target_lang_word": "yole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                        "entry_id": "10270f4a-7c57-3e50-970f-721ff6136236",
                                        "glosses": [
                                            "Sorte de petit canot léger qui va à la voile et à l’aviron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a1bdce-c10b-44b7-9a8f-49e94620ab93",
                                                "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                                "text": "Je fis préparer la yole et j'y fis embarquer le cylindre de fer-blanc qui contenait les cartes déjà dressées, les quatre montres marines, un cercle de réflexion, les trois atlas…"
                                            },
                                            {
                                                "example_id": "7c43ac70-42aa-45c4-801e-082bb824af65",
                                                "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                                "text": "Chaque famille possède une yole, bateau léger, étroit et long, qui peut contenir six personnes, indispensable pour circuler dans cette contrée bizarre, et que dirige l’yoleur au moyen d’une longue perche qu'il manie avec adresse."
                                            },
                                            {
                                                "example_id": "80690c09-9082-4cfa-91e9-c79dbe44019e",
                                                "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                                "text": "Mon frère se jeta dans une yole avec le Lazariste et se rendit chez le gouverneur."
                                            },
                                            {
                                                "example_id": "aca4e588-e39d-46bd-9df1-73fc5d9e0ccd",
                                                "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                                "text": "Le prince chassait souvent le gibier de mer sur une yole, avec deux ou trois de la bande, les autres s’immobilisaient en d'interminables farnientes."
                                            },
                                            {
                                                "example_id": "9d330d4d-db23-499f-ab27-fe90e2f81ce1",
                                                "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                                "text": "Sous un petit hangar en bois étaient suspendues deux superbes yoles de canotiers, fines et travaillées comme des meubles de luxe."
                                            },
                                            {
                                                "example_id": "7e28d6d3-2e3e-4ee4-ae6e-544879daf8f5",
                                                "sense_id": "0ce81f3a-7424-3e31-aa53-9972b5efab19",
                                                "text": "En effet, il revint, dans la yole de son navire ; il revint pour trois heures lui faire ses adieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28d3f127-0453-3961-bb38-341683f6d2ae",
