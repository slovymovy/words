                                    {
                                        "sense_id": "5a5da4b0-07ad-3626-a7dc-3e905ec565e1",
                                        "entry_id": "b3d2e72a-1c4b-3f52-a010-91621a1b4cbf",
                                        "glosses": [
                                            "mit Dativ (seltener Genitiv,Der Dativ ist dem Genitiv sein Tod.Der Spiegelentgegen.Variantengrammatik des Standarddeutschen(aktualisierter Artikel. mit Verbreitungsgrafiken);\\n vergl.entgegen + Dativ/Genitiv. nicht im Einklang mit etwas; zuwider"
                                        ],
                                        "tags": [
                                            "] In",
                                            "online",
                                            "22. Oktober 2003;\\nandere nennen die Variante ausdrücklich",
                                            "In",
                                            "Uni Mannheim",
                                            "Christoph Vogt",
                                            "o.D. zumeist dem Substantiv vorgestellt)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4fd855-2d66-48fa-9e88-e830662b2b65",
                                                "sense_id": "5a5da4b0-07ad-3626-a7dc-3e905ec565e1",
                                                "text": "Er hatte entgegen dem Vertrag gehandelt."
                                            },
                                            {
                                                "example_id": "91612181-fc77-4806-b580-6701dc7399fe",
                                                "sense_id": "5a5da4b0-07ad-3626-a7dc-3e905ec565e1",
                                                "text": "Entgegen ihrer Vorstellung kamen nur fünf Leute zum Vortrag."
                                            },
                                            {
                                                "example_id": "03e4eff1-2440-4818-aaaa-f43a53fa9a01",
                                                "sense_id": "5a5da4b0-07ad-3626-a7dc-3e905ec565e1",
                                                "text": "Seinem Befehl entgegen hat er es nicht getan."
                                            },
                                            {
                                                "example_id": "0e99a7dd-67ab-445b-9374-5ae5f98f2fcb",
                                                "sense_id": "5a5da4b0-07ad-3626-a7dc-3e905ec565e1",
                                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                                            },
                                            {
                                                "example_id": "ed352478-f27d-4596-ac75-2b0b4a255253",
                                                "sense_id": "5a5da4b0-07ad-3626-a7dc-3e905ec565e1",
                                                "text": "(mit Genitiv) „Und die Preise seien, entgegen früherer Befürchtungen, derzeit stabil.“ (St. Galler Tagblatt)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "entgegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42ebe8c0-7458-37e8-971b-2209eb1a7897",
                                        "entry_id": "788c4de0-0a43-3bca-b989-0cf52c4d8db9",
                                        "glosses": [
                                            "auf etwas zu, zu etwas hin, in Richtung zu etwas"
                                        ],
                                        "tags": [
                                            "mit Dativ (dem Substantiv nachgestellt",
                                            "Postposition) gibt Bewegungsrichtung an"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "422d7cfe-9fda-41fe-abf1-dc72caa5555b",
                                                "sense_id": "42ebe8c0-7458-37e8-971b-2209eb1a7897",
                                                "text": "Nun brechen wir auf, neuen Ufern entgegen!"
                                            },
                                            {
                                                "example_id": "228b675f-3285-4807-af9d-079c8329ae8e",
                                                "sense_id": "42ebe8c0-7458-37e8-971b-2209eb1a7897",
                                                "text": "Das Grundstück liegt der Sonne entgegen."
                                            },
                                            {
                                                "example_id": "0ae08ae2-ac18-4511-ad78-d73d7f504b51",
                                                "sense_id": "42ebe8c0-7458-37e8-971b-2209eb1a7897",
                                                "text": "Wer recht in Freuden wandern will, der geh’ der Sonn’ entgegen."
                                            },
                                            {
                                                "example_id": "a37074a2-44a1-4217-b4f4-2b704e1b2e84",
                                                "sense_id": "42ebe8c0-7458-37e8-971b-2209eb1a7897",
                                                "text": "Der Hund läuft ihr entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32a8c0d5-2f9c-38e8-b847-554bf15f99e7",
                                        "entry_id": "788c4de0-0a43-3bca-b989-0cf52c4d8db9",
                                        "glosses": [
                                            "gegenan"
                                        ],
                                        "tags": [
                                            "beschreibt eine Gegenrichtung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3334e68d-ffd3-470c-a7a9-1396ccec5300",
                                                "sense_id": "32a8c0d5-2f9c-38e8-b847-554bf15f99e7",
                                                "text": "Wir schwammen entgegen der Strömung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0648536a-38b3-3729-9b0d-d4e656fb0987",
                                        "entry_id": "788c4de0-0a43-3bca-b989-0cf52c4d8db9",
                                        "glosses": [
                                            "konträr, zuwidergesetzt"
                                        ],
                                        "tags": [
                                            "beschreibt eine Gegenposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869ef6d4-7361-4756-939e-a64a3aa0dc4c",
                                                "sense_id": "0648536a-38b3-3729-9b0d-d4e656fb0987",
                                                "text": "Deine Vorstellungen sind meinen völlig entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
