                                                "sense_id": "6282ee25-3ae4-37f6-9d73-7c0b45e22d59",
                                                "text": "Mein Opa arbeitet in einem Supermarkt."
                                            },
                                            {
                                                "example_id": "98a4f296-fe17-4d48-8f42-39ac9f431e84",
                                                "sense_id": "6282ee25-3ae4-37f6-9d73-7c0b45e22d59",
                                                "text": "„Oma und Opa waren da, meine Eltern, mein Bruder Sebastian und Onkel Hugo.“"
                                            },
                                            {
                                                "example_id": "54fd8d7a-e0e8-40e1-afd5-e5beee414589",
                                                "sense_id": "6282ee25-3ae4-37f6-9d73-7c0b45e22d59",
                                                "text": "„Ich besitze die Tagebücher meines Opas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de2f2d47-c6e4-3f75-8549-6575d255bbf8",
