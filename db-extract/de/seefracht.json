                "senses": [
                    {
                        "sense_id": "91ac41e5-7e49-3b96-aa0f-a6b6fde16d0a",
                        "entry_id": "84659599-f47f-3394-840f-80ee3d8588c9",
                        "glosses": [
                            "über den Seeweg transportiertes Frachtgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d64715-21eb-4abd-998f-d6315b789d24",
                                "sense_id": "91ac41e5-7e49-3b96-aa0f-a6b6fde16d0a",
                                "text": "„Bis zu 88 Fahrzeuge passen auf einen Zug. In 18 Tagen – drei Wochen schneller als per Seefracht – erreichen sie das 11.000 Kilometer entfernte Chongqing in Südwestchina, meldete Xinhua.“"
                            },
                            {
                                "example_id": "53271860-ef10-4086-8001-d65522d2b95e",
                                "sense_id": "91ac41e5-7e49-3b96-aa0f-a6b6fde16d0a",
                                "text": "„Mehr Volumina erzielte der kurz vor dem Ende seiner Selbstständigkeit stehende Transportkonzern im Bereich Luftfracht. Dagegen waren die Seefracht und die Logistik rückläufig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
