                        "source_sense_description": "to revolve round a central point; to move spirally about an axis, as a tornado — see also revolve",
                        "target_lang_word": "draaien",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "draaien",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b0592eb1-28a5-3ac9-82b9-d176637902f2",
                                        "entry_id": "f36d8199-4d06-36f3-a4dd-b3b940402e66",
                                        "glosses": [
                                            "om een middelpunt bewegen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a8453f-76f3-4d43-b8ef-6b7a9a2c8b0c",
                                                "sense_id": "b0592eb1-28a5-3ac9-82b9-d176637902f2",
                                                "text": "De auto moest eerst draaien om de garage in te kunnen rijden."
                                            },
                                            {
                                                "example_id": "246b5180-2981-477d-bbc3-0a8391770b16",
                                                "sense_id": "b0592eb1-28a5-3ac9-82b9-d176637902f2",
                                                "text": "Martijn liet de tol hard draaien."
                                            },
                                            {
                                                "example_id": "6a382c5e-384e-4214-a42b-2b0302545f1f",
                                                "sense_id": "b0592eb1-28a5-3ac9-82b9-d176637902f2",
                                                "text": "De fles was gelukkig groot genoeg en uiteindelijk kon ik met een zucht van verlichting de dop erop draaien."
                                            },
                                            {
                                                "example_id": "579edee8-e916-4a3c-b98b-d7e493c46439",
                                                "sense_id": "b0592eb1-28a5-3ac9-82b9-d176637902f2",
                                                "text": "Ze moesten het materiaal dus verwarmen met vuur en bovendien een systeem bedenken om de stammen boven het vuur om te draaien op ongeveer dezelfde manier als zuiderlingen schapenlichamen boven open vuur roteerden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7fb566-82b7-3bf1-9221-1b587c834b72",
                                        "entry_id": "f36d8199-4d06-36f3-a4dd-b3b940402e66",
                                        "glosses": [
                                            "lopen [5], naar behoren werken of functioneren, voortgang maken"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dea341a-9290-4a07-a6dc-3134f9e9e539",
                                                "sense_id": "4d7fb566-82b7-3bf1-9221-1b587c834b72",
                                                "text": "Het bedrijf draait niet meer goed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cc292b-ed57-35d8-b335-b9760a7aea09",
                                        "entry_id": "f36d8199-4d06-36f3-a4dd-b3b940402e66",
                                        "glosses": [
                                            "manier van verspanen waarbij het te bewerken product op de draaibank ligt en ronddraait"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "320f9e3a-181a-42af-8207-b6e74685e3e2",
                                                "sense_id": "08cc292b-ed57-35d8-b335-b9760a7aea09",
                                                "text": "Boren, frezen, draaien en kotteren zijn allemaal vormen van verspaningstechniek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a28c4b-bdf5-399d-8f44-175949591fb3",
                                        "entry_id": "f36d8199-4d06-36f3-a4dd-b3b940402e66",
                                        "glosses": [
                                            "plotseling van richting veranderen"
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c9e6a5-6b4c-4ea1-84f5-b6fb9e382dbc",
                                                "sense_id": "52a28c4b-bdf5-399d-8f44-175949591fb3",
                                                "text": "Doordat de wind draaide, ontkwam het dorp aan de bosbrand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fe12a88-e692-3c12-90af-d57631dcf68a",
                                        "entry_id": "f36d8199-4d06-36f3-a4dd-b3b940402e66",
                                        "glosses": [
                                            "naar allerlei uitvluchten zoeken om maar niet de waarheid te hoeven vertellen"
                                        ],
                                        "tags": [
                                            "ergative",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5bfbcfc-0435-49db-9bdc-9bb2e00e30cf",
                                                "sense_id": "0fe12a88-e692-3c12-90af-d57631dcf68a",
                                                "text": "Hou nu op met draaien en vertel gewoon hoe het echt zit!"
                                            }
                                        ]
                                    }
                                ]
                            },
