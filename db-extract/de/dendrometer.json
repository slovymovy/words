                "senses": [
                    {
                        "sense_id": "b895dbe6-b59f-302b-a494-d62defe1c4e9",
                        "entry_id": "d574ef33-934a-30f7-a3b2-99f2d65e2de6",
                        "glosses": [
                            "Hilfsmittel zur Bestimmung der Höhe eines Baums oder des Durchmessers des Stammes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caae7a8c-0300-453c-9283-eeaa0795c803",
                                "sense_id": "b895dbe6-b59f-302b-a494-d62defe1c4e9",
                                "text": "„Ein junger Ökologe misst das Wachstum der Baumstämme mit Hilfe eines flexiblen Aluminiumrings, dem so genannten Dendrometer.“"
                            },
                            {
                                "example_id": "d1a8bf9d-0c85-4ddb-9e1c-49bdb8b8e5ac",
                                "sense_id": "b895dbe6-b59f-302b-a494-d62defe1c4e9",
                                "text": "„Boden- und Luftfeuchtigkeit werden erfasst, zugleich messen sogenannte Dendrometer das Stammwachstum bis auf Bruchteile von Mikrometern genau.“"
                            },
                            {
                                "example_id": "1f916559-3954-4ada-b1f7-291e2fb6250f",
                                "sense_id": "b895dbe6-b59f-302b-a494-d62defe1c4e9",
                                "text": "„Und ein sogenanntes Dendrometer misst im Mikrometerbereich den Umfang des Baumes: Tagsüber verliert der Stamm etwas an Umfang, weil er Wasser verbraucht, nachts schwillt er wieder an - und langfristig sollte er natürlich wachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
