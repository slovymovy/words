                "senses": [
                    {
                        "sense_id": "ca31075a-e744-35e1-a8c5-77ccf1728c37",
                        "entry_id": "59e574e8-377b-31ea-97cb-f60c1e71d023",
                        "glosses": [
                            "Rendre inodore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0b8bdc-f61c-4664-9ca3-9c63e11c88ab",
                                "sense_id": "ca31075a-e744-35e1-a8c5-77ccf1728c37",
                                "text": "Inutile de l'inodoriser !"
                            },
                            {
                                "example_id": "123bd999-7125-4c2b-8c84-b923ca4020a9",
                                "sense_id": "ca31075a-e744-35e1-a8c5-77ccf1728c37",
                                "text": "On s'est aperçu, mais ça, ça reste confidentiel, qu'à force de tout récurer, nettoyer, stériliser, inodoriser, on a des mômes incapables de lutter contre la moindre affection."
                            },
                            {
                                "example_id": "82b10704-7de3-4453-98f1-b58c8292c528",
                                "sense_id": "ca31075a-e744-35e1-a8c5-77ccf1728c37",
                                "text": "Les joints mal installés sur les raccords des deux câbles Teck ont plutôt laissé des petites quantités de gaz inodorisé pénétrer dans le bâtiment électricité et services sans être détectées, par l'entremise des câbles Teck."
                            }
                        ]
                    }
