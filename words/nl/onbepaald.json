                        "ru": "Не уверенный или не окончательный.",
                        "en": "Not certain, settled, or decided."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "incerto",
                                "target_lang_sense_clarification": "riferito a un esito o una situazione non sicura"
                            },
                            {
                                "target_lang_word": "indefinito",
                                "target_lang_sense_clarification": "riferito a uno sguardo o un'espressione vaga"
                            }
