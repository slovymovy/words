                        "examples": [
                            {
                                "example_id": "2e52c37e-79a3-4f38-9c8d-72d5556e903a",
                                "sense_id": "f4dabb77-e3a9-32ba-9620-e39cbf6ee64f",
                                "text": "Ze hoorden glasgerinkel gevolgd door een indringend gegil."
                            },
                            {
                                "example_id": "babd4f81-d563-4206-b9f8-6ea3335b2aa3",
                                "sense_id": "f4dabb77-e3a9-32ba-9620-e39cbf6ee64f",
                                "text": "Het is een buitengewoon indringende film."
