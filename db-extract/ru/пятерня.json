                                        "sense_id": "6931d808-862c-355f-8f94-e29b47d1d013",
                                        "entry_id": "34037026-c81c-332f-ad69-1b6dfe3cf740",
                                        "glosses": [
                                            "Any of various evergreen trees from the family Palmae or Arecaceae, which are mainly found in the tropics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c620c973-484e-3f87-bb60-f123b873ef1d",
                                        "entry_id": "34037026-c81c-332f-ad69-1b6dfe3cf740",
                                        "glosses": [
                                            "A branch or leaf of the palm, anciently borne or worn as a symbol of victory or rejoicing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eab9f33-abf8-49c4-bb18-9e45eac65417",
                                                "sense_id": "c620c973-484e-3f87-bb60-f123b873ef1d",
                                                "text": "A great multitude […] stood before the throne, and before the Lamb, clothed with white robes, and palmes in their hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62550c22-fb73-315d-884c-0a1d3b4ec3a1",
                                        "entry_id": "34037026-c81c-332f-ad69-1b6dfe3cf740",
                                        "glosses": [
                                            "Triumph; victory."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb51dfe1-ce24-3afb-a513-e446df33168f",
                                        "entry_id": "34037026-c81c-332f-ad69-1b6dfe3cf740",
                                        "glosses": [
                                            "Any of 23 awards that can be earned after obtaining the Eagle Scout rank, but generally only before turning 18 years old."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "palm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "441d66ae-aa64-379d-af0e-88c2f6b01d27",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "The inner and somewhat concave part of the human hand or other primate hand that extends from the wrist to the bases of the fingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a2d554-85d9-4bfd-a008-91e61db6153b",
                                                "sense_id": "441d66ae-aa64-379d-af0e-88c2f6b01d27",
                                                "text": "[She] flung herself / Down on the great King's couch, and writhed upon it, / And clench'd her fingers till they bit the palm, / And shriek'd out 'traitor' to the unhearing wall, […]"
                                            },
                                            {
                                                "example_id": "d2601ccf-fa68-4856-ae1f-4c212e4c92f0",
                                                "sense_id": "441d66ae-aa64-379d-af0e-88c2f6b01d27",
                                                "text": "The open palm of desire wants everything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461eef08-ecff-3376-a005-0a3d9dc347d9",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "The corresponding part of the forefoot of a nonprimate mammal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88a3d98e-b4a4-34fc-9d47-97acc5ee1bde",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "Synonym of hand, any of various units of length notionally derived from the breadth of the palm, formalized in England as 4 inches and now chiefly used for the height of horses"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0d2e1d-7afd-4277-bc47-4c5d1bc9dfc1",
                                                "sense_id": "88a3d98e-b4a4-34fc-9d47-97acc5ee1bde",
                                                "text": "He found it to be ninety-five fathoms wide, and five palms deep at a place of average depth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d918fd4b-384f-3f33-afa2-ce2b22705e40",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "Any of various units of length notionally derived from the length of the palm from the wrist to the base of the fingers."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f725db1f-2e8e-3486-8751-2a82252c3de7",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "A metallic disk attached to a strap and worn in the palm of the hand; used to push the needle through the canvas, in sewing sails, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01c7de6f-e965-3ab4-9b2c-ecec5c303946",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "The broad flattened part of an antler, as of a full-grown fallow deer; so called as resembling the palm of the hand with its protruding fingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eff455d-6f1f-414c-b29f-a650c93db88a",
                                                "sense_id": "01c7de6f-e965-3ab4-9b2c-ecec5c303946",
                                                "text": "They watched until the younger bull received a second cut, this one on his flank from a point on the brow palm that would have impaled him if he hadn't jumped out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f1b547e-10da-394b-8843-f70cbb2a1699",
                                        "entry_id": "fd4efe9b-74ff-3764-bd8c-1f283260db22",
                                        "glosses": [
                                            "The flat inner face of an anchor fluke."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "palm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92ce9c57-29cb-3eb5-be79-5fcd7816e989",
                                        "entry_id": "b92f411e-2b8e-3aff-8988-88d7685536cc",
                                        "glosses": [
                                            "To hold or conceal something in the palm of the hand, e.g., for an act of sleight of hand or to steal something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72b16151-ab4f-3406-90c9-d318c6ac149a",
                                        "entry_id": "b92f411e-2b8e-3aff-8988-88d7685536cc",
                                        "glosses": [
                                            "To hold something without bending the fingers significantly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73435feb-67f0-4be1-aeb0-acb6e333bf26",
                                                "sense_id": "72b16151-ab4f-3406-90c9-d318c6ac149a",
                                                "text": "John palmed the ball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc873f6a-b601-38f1-8bb6-bae887f61d7f",
                                        "entry_id": "b92f411e-2b8e-3aff-8988-88d7685536cc",
                                        "glosses": [
                                            "To move something with the palm of the hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b39dab26-808f-4730-81c9-57bca4835fb7",
                                                "sense_id": "cc873f6a-b601-38f1-8bb6-bae887f61d7f",
                                                "text": "The home side's goalkeeper Asmir Begovic managed to palm the drive on to the post but the sheer pace of the shot forced the ball into the net."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22769642-b432-3d5a-8c35-a336eb978b51",
                                        "entry_id": "b92f411e-2b8e-3aff-8988-88d7685536cc",
                                        "glosses": [
                                            "To use one's palm as identification to get through a door or security checkpoint."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99784263-7fdf-4a9a-9a34-6f03c1841b3e",
                                                "sense_id": "22769642-b432-3d5a-8c35-a336eb978b51",
                                                "text": "I palmed in to work."
                                            },
                                            {
                                                "example_id": "a00d2b6a-2814-420c-a696-78211980d068",
                                                "sense_id": "22769642-b432-3d5a-8c35-a336eb978b51",
                                                "text": "She palmed the door as she talked to the security guard."
