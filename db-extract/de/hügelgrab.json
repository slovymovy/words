                ],
                "senses": [
                    {
                        "sense_id": "db5d0465-19cc-3860-aed0-1fecec105dbe",
                        "entry_id": "a78327fd-d429-3674-bd3e-053f83f0a38c",
                        "glosses": [
                            "Archäologie/Frühgeschichte: Grab, mit einem Erdhügel überbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31745836-c17f-4e57-9f5b-ff277c3c10df",
                                "sense_id": "db5d0465-19cc-3860-aed0-1fecec105dbe",
                                "text": "„Für die Arraskultur im 4. und 3. Jahrhundert vor Christus im Osten von Yorkshire sind Erdbestattungen in Form von Hügelgräbern charakteristisch.“"
                            },
                            {
                                "example_id": "87d89402-4bec-4656-8cb9-febf22d535c8",
                                "sense_id": "db5d0465-19cc-3860-aed0-1fecec105dbe",
                                "text": "„In den 14 Ortsteilen Duderstadts treffen wir auf prächtige Bauernhäuser, stattliche Dorfkirchen mit kunstgeschichtlich wertvollen Ausstattungen, auf gepflegte Angeranlagen, zahlreiche Klusen, Wegkreuze und Bildstöcke, ja bei Werxhausen und Desinderode sogar auf eine Vielzahl vorgeschichtlicher Hügelgräber aus der Bronzezeit.“"
                            },
                            {
                                "example_id": "bf876a04-1120-4438-8419-b898bea62994",
                                "sense_id": "db5d0465-19cc-3860-aed0-1fecec105dbe",
                                "text": "„Sie haben Ringwälle und Hügelgräber hinterlassen, aber auch zahllose Stadt- und Ortsnamen, haben fast all unsere Flüsse benannt und unsere Gebirge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3a5dfc2-5730-4d45-849d-e1f4c7301847",
                        "source_entry_id": "a78327fd-d429-3674-bd3e-053f83f0a38c",
                        "source_sense_id": "db5d0465-19cc-3860-aed0-1fecec105dbe",
