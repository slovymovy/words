                ],
                "senses": [
                    {
                        "sense_id": "d4ca1bb7-a5b1-3895-ac1a-5c933b7a6219",
                        "entry_id": "216f2b49-1b2b-3bac-89e9-720be7e096ae",
                        "glosses": [
                            "A soft cry or whimper; an act of mewling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54529267-7a0b-4a9a-a118-23eb1d5c5a68",
                                "sense_id": "d4ca1bb7-a5b1-3895-ac1a-5c933b7a6219",
                                "text": "There would have been total silence if it hadn't been for the sea nearby, mewling. Indeed, that same mewl added to the sleepy image that filled the dormant house."
                            },
                            {
                                "example_id": "ac52260c-23c9-4fa8-8750-770f2f7f3c87",
                                "sense_id": "d4ca1bb7-a5b1-3895-ac1a-5c933b7a6219",
                                "text": "I let out another moaning mewl, biting my lip as I awaited whatever he planned."
                            },
                            {
                                "example_id": "7e2cc800-67aa-4edd-9ded-646f46e95a31",
                                "sense_id": "d4ca1bb7-a5b1-3895-ac1a-5c933b7a6219",
                                "text": "The scratching stopped, and there was another piteous mewl from behind the door."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08a272f5-14da-4f33-8611-eedee4183e92",
                        "source_entry_id": "216f2b49-1b2b-3bac-89e9-720be7e096ae",
                        "source_sense_id": "d4ca1bb7-a5b1-3895-ac1a-5c933b7a6219",
