                                    {
                                        "sense_id": "92a0f93b-91ad-3b41-abe6-6bd263b4688f",
                                        "entry_id": "ced5dbb2-8a7d-3be4-a265-1e28f8d509ae",
                                        "glosses": [
                                            "Directly overhead; vertically on top of."
