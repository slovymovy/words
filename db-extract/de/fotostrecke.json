                ],
                "senses": [
                    {
                        "sense_id": "8cf7261f-6225-3c0d-96da-d0f1a7f94190",
                        "entry_id": "d515b8e7-69ce-3ed7-97d3-46591f86120a",
                        "glosses": [
                            "mehrere zusammengestellte Bilder, die man sich anschauen kann"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d324bab6-061c-4b76-ae9d-6b2e497654c1",
                                "sense_id": "8cf7261f-6225-3c0d-96da-d0f1a7f94190",
                                "text": "„Wenn Sie einen ersten Einblick in die Welt des \"Nordmeers\" gewinnen wollen, schauen Sie sich die Fotostrecke mit Bildern aus dem mare-Bildband \"Nordmeer\" an.“"
                            },
                            {
                                "example_id": "c8f03531-c981-4e61-9be0-ca6e8f95d2e4",
                                "sense_id": "8cf7261f-6225-3c0d-96da-d0f1a7f94190",
                                "text": "„Die Gewinner des Fotowettbewerbs werden ab dem 19. Juli 2006 bekannt gegeben und die prämierten Werke in einer Fotostrecke auf wissen.de veröffentlicht.“"
                            },
                            {
                                "example_id": "ee7de0a1-0e8c-42e2-9d7a-2aba9a8a50c2",
                                "sense_id": "8cf7261f-6225-3c0d-96da-d0f1a7f94190",
                                "text": "„Ich hatte das Bild schon einmal gesehen, auf einer Fotostrecke, die wir damals bei der Zeitung zusammengestellt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
