{
    "word_family": [
        "afschaffing",
        "schaffen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0c0b80b-9720-3742-9b65-4c6d48628a5e",
                    "sense_definition": "het officieel ongeldig maken of beëindigen van een wet, regel of gebruik",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beëindigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was een lange strijd nodig om slavernij <w>af te schaffen</w>.",
                            "target_lang_translations": {
                                "en": "A long struggle was needed to <w>abolish</w> slavery.",
                                "ru": "Потребовалась долгая борьба, чтобы <w>отменить</w> рабство."
                            }
                        },
                        {
                            "text": "De regering wil de belasting op kleine spaartegoeden volgend jaar <w>afschaffen</w>.",
                            "target_lang_translations": {
                                "en": "The government wants to <w>repeal</w> the tax on small savings next year.",
                                "ru": "Правительство хочет <w>отменить</w> налог на небольшие сбережения в следующем году."
                            }
                        }
                    ],
                    "synonyms": [
                        "beëindigen",
                        "opheffen"
                    ],
                    "antonyms": [
                        "invoeren",
                        "instellen"
                    ],
                    "common_phrases": [
                        "een wet afschaffen",
                        "regels afschaffen"
                    ],
                    "target_lang_definitions": {
                        "en": "to officially invalidate or end a law, rule, or custom",
                        "ru": "официально отменять или прекращать действие закона, правила или обычая"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abolish",
                                "target_lang_sense_clarification": "to end a law, system, or custom"
                            },
                            {
                                "target_lang_word": "repeal",
                                "target_lang_sense_clarification": "to revoke or annul a law or act"
                            },
                            {
                                "target_lang_word": "do away with",
                                "target_lang_sense_clarification": "to get rid of something officially"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "аннулировать закон или правило"
                            },
                            {
                                "target_lang_word": "упразднять",
                                "target_lang_sense_clarification": "официально прекращать существование чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66778d90-44d5-3b77-9474-d7f5cf255b9a",
                    "sense_definition": "stoppen met een bepaalde gewoonte, regeling of faciliteit binnen een organisatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beëindigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rookpauze is in dit bedrijf vorig jaar <w>afgeschaft</w>.",
                            "target_lang_translations": {
                                "en": "The smoking break was <w>discontinued</w> in this company last year.",
                                "ru": "В этой компании в прошлом году <w>отменили</w> перерывы на курение."
                            }
                        },
                        {
                            "text": "Nadat de subsidie voor computers was <w>afgeschaft</w>, werden er veel minder toestellen verkocht.",
                            "target_lang_translations": {
                                "en": "After the subsidy for computers was <w>scrapped</w>, far fewer devices were sold.",
                                "ru": "После того как субсидии на компьютеры были <w>отменены</w>, продавалось гораздо меньше устройств."
                            }
                        }
                    ],
                    "synonyms": [
                        "beëindigen"
                    ],
                    "antonyms": [
                        "behouden"
                    ],
                    "common_phrases": [
                        "een subsidie afschaffen",
                        "een regeling afschaffen"
                    ],
                    "target_lang_definitions": {
                        "en": "to stop a specific habit, arrangement, or facility within an organization",
                        "ru": "прекращать использование определенной привычки, порядка или услуги в рамках организации"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abolish",
                                "target_lang_sense_clarification": "to end a system or practice"
                            },
                            {
                                "target_lang_word": "discontinue",
                                "target_lang_sense_clarification": "to stop providing or using a service or facility"
                            },
                            {
                                "target_lang_word": "scrap",
                                "target_lang_sense_clarification": "to discard or stop a plan or policy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "останавливать действие или предоставление услуги"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "аннулировать действие какой-либо договоренности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}