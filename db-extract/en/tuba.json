                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7f220a-1f80-4e8b-920c-ee87c38f9a8e",
                                                "sense_id": "df26f927-0c03-3ac9-92e3-9a62304f7bdd",
                                                "text": "Obratně vytlačila pastu z tuby."
                                            },
                                            {
                                                "example_id": "f5ce6d2f-4c00-4473-9bd5-05978e07efc6",
                                                "sense_id": "df26f927-0c03-3ac9-92e3-9a62304f7bdd",
                                                "text": "Až stvoří se poslední obraz a vyschnou barvy všech tub, až nejstarší zanikne malba i nejmladší kritik-hňup, my na krátkou zdřimnem si věčnost..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ccda43-0b47-3258-9472-43feb38bfcf4",
                                        "entry_id": "af3ebee2-2a9f-3793-94d4-5b3eab196adc",
                                        "glosses": [
                                            "žesťový dechový hudební nástroj"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78569ac-1243-4cbd-9518-23d382ac6c98",
                                                "sense_id": "72ccda43-0b47-3258-9472-43feb38bfcf4",
                                                "text": "Ve školní kapele hrál na tubu."
                                            },
                                            {
                                                "example_id": "ba853cc6-df86-41ce-8321-36f9e37c9ef6",
                                                "sense_id": "72ccda43-0b47-3258-9472-43feb38bfcf4",
                                                "text": "A jako tuby andělského kůru trub zlatolesklých rykot bojovný zval v zápas velký pod korouhev slávy"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
