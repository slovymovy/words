                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fee0909f-6708-4260-94b2-24f4a270a081",
                        "source_entry_id": "093447ea-077b-3849-99fb-6ccae7c79efb",
                        "source_sense_id": "7a80ffc7-523b-30aa-82e6-afdd9d1051fe",
                        "target_lang_word": "nocturnal emission",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nocturnal emission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "964f4d7e-e986-37d9-8750-069993655139",
                                        "entry_id": "11935681-73bd-319f-a565-f4174dffdf5b",
                                        "glosses": [
                                            "An ejaculation or orgasm while asleep, often accompanied by an erotic dream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e576baeb-a24f-455b-af39-e4881b8f5474",
                                                "sense_id": "964f4d7e-e986-37d9-8750-069993655139",
                                                "text": "In other stories of the midrashim, Adam, in penance for his fall, abstains from sexuality for 130 years, but he is not able to control his nocturnal emissions; in his dream state female spirits, the succubae, come and have intercourse with him, and with Adam's seed they give birth to demons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63a416d5-8692-4790-b940-7173858d5ef0",
                        "source_entry_id": "093447ea-077b-3849-99fb-6ccae7c79efb",
                        "source_sense_id": "7a80ffc7-523b-30aa-82e6-afdd9d1051fe",
                        "target_lang_word": "pollution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "Physical contamination, now especially the contamination of the environment by harmful substances, or by disruptive levels of noise, light etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b33aa9-28ea-423b-8307-f56a7119c294",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "Pollution levels are almost always higher in cities rather than the countryside, what with the cars, industry and so on."
                                            },
                                            {
                                                "example_id": "5e658696-7b36-45a8-92ca-fda8ce21fd61",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "If successful, Edison and Ford—in 1914—would move society away from the[…]hazards of gasoline cars: air and water pollution, noise and noxiousness, constant coughing and the undeniable rise in cancers caused by smoke exhaust particulates."
                                            },
                                            {
                                                "example_id": "f605ba7e-9a26-49b7-b516-2963687d21b2",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "Schools across the country are moving to ban the school run amid growing concern about the devastating impact of air pollution on young people’s health."
                                            },
                                            {
                                                "example_id": "efcdd7f3-2007-4c74-b35f-d899fc813919",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "Pollution now kills three times as many people worldwide as Aids, tuberculosis and malaria combined."
                                            },
                                            {
                                                "example_id": "eb8365ab-79e2-42e0-9941-7e124da1972c",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "\"Flying only looks like a bargain because the cost of pollution is so cheap.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59b07af-02dc-3df4-b5a1-9ab6792edbf9",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "Something that pollutes; a pollutant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "The desecration of something holy or sacred; defilement, profanation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0496b295-34f9-48b2-8aa6-9f98b36114cd",
                                                "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                                                "text": "Men who attend the Altar, and should most / Endevor Peace: thir strife pollution brings / Upon the Temple it self […]."
                                            },
                                            {
                                                "example_id": "97d5f985-c1b5-4db3-9267-dd4a516c27b5",
                                                "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                                                "text": "[T]he most gallant knights that ever wielded sword wasted their lives away in a struggle to seize it and hold it sacred from infidel pollution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "The ejaculation of semen outside of sexual intercourse, especially a nocturnal emission."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda54bca-526e-46dc-88af-c323197f0791",
                                                "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                                                "text": "When occasioned by a voluntary act it is called, simply, Pollution or Masturbation (q.v.); when excited, during sleep, by lascivious dreams, it takes the name Noctur'nal pollution, Exoneiro'sis, Oneirog'mos, Oneirog'onos, Gonorrhœ'a dormien'tium, G. oneirog'onos, G. Vera, G. libidino'sa, Proflu'vium Sem'inis, Spermatorrhœ'a, Paronir'ia salax, Night pollution."
                                            },
                                            {
                                                "example_id": "e942482d-2d26-40cf-924b-f3ae67989ce4",
                                                "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                                                "text": "According to Billuart and other theologians, pollution in sleep is not sin, unless voluntarily caused; if, however, it begins in sleep, and is completed in the half-waking state, with a sense of pleasure, it is a venial sin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a6b64ec-3957-3b81-a7b1-8db8979796e7",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "Moral or spiritual corruption; impurity, degradation, defilement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "224ffc88-94a2-41fc-8292-22149319b6e6",
                                                "sense_id": "2a6b64ec-3957-3b81-a7b1-8db8979796e7",
                                                "text": "She condescended to wait on them at Pemberley, in spite of that pollution which its woods had received."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e43d77db-400c-4b7f-9084-fb2952da4579",
                        "source_entry_id": "093447ea-077b-3849-99fb-6ccae7c79efb",
                        "source_sense_id": "7a80ffc7-523b-30aa-82e6-afdd9d1051fe",
                        "target_lang_word": "pollution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Diffusion dans l’environnement d’un produit potentiellement toxique ou de nature à perturber le fonctionnement d’un biotope."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32632ad-be89-4e57-bac7-0e504b6488dc",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Il résulte, en effet, des études sur les pollutions des rivières anglaises récemment résumées par M. Frankland (Comptes rendus, tome LXX, p. 1054), que lorsque la température ne dépasse pas 17°,8. le parcours de trois à quatre lieues n’influe que médiocrement sur la combustion des matières dissoutes, et que même, après un parcours beaucoup plus prolongé, l’eau n'est pas encore purifiée à 300 kilomètres, l’eau reste souillée."
                                            },
                                            {
                                                "example_id": "25f0c7b2-78d3-476f-97c9-d02f5423ee59",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "La maladie de Minamata, c’est ce terrible fléau dû à la pollution par le mercure qui fit des milliers de victimes au Japon en 1950 et en 1965 : le monde entier a pu voir ces images de corps tordus d’enfants monstrueux dans les bras de leurs mères. Il y avait des cinéastes et des photographes au Japon. Il n’y en avait guère en Irak en 1956, au Pakistan en 1961, au Guatemala en 1963, au Nouveau-Mexique en 1969, où le méthyl-mercure a fait aussi des ravages."
                                            },
                                            {
                                                "example_id": "a039d072-d4ec-49d8-a53d-313b77fac282",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Ville cuvette en quelque sorte, la capitale turque est surtout la victime de la pollution lors des jours sans vent."
                                            },
                                            {
                                                "example_id": "767a7242-96a7-4c6b-b5db-452fd2bbcb96",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Il se fichait même de savoir pourquoi De Lavarice préconisait un désherbement à la main plutôt que l’application de produit herbicide. Il se fichait de savoir si c’était par souci de pollution ou d'économie."
                                            },
                                            {
                                                "example_id": "06a70777-e441-4d72-906f-c9c5e24fb30f",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Et les muges ? Pauvres muges ! On leur a fait tellement de tort avec la pollution et le mazout que les amateurs de muges aux olives sont plutôt rares. C'est un grand vide dans les traditions que la disparition de ce poisson appelé « mulet » dans le reste de la France."
                                            },
                                            {
                                                "example_id": "6bf6377a-49dd-460c-9c59-744793dea0c9",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Hélas, l’impunité qui caractérise les pollutions et les scandales sanitaires de l’après-mine sur le sol français n’ont presque rien à envier à l’exemple brésilien. En France aujourd’hui, des cas de pollutions cachées attestent des mêmes logiques intrinsèques à une activité criminelle protégée (et donc alimentée) par les pouvoirs publics."
                                            },
                                            {
                                                "example_id": "4c493547-803e-480b-ad74-b95bdb2ac2e5",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "La raison pour laquelle lustrer sa voiture sur la voie publique est interdit, c’est parce que cette pratique contribue à la pollution de l’environnement. Les eaux savonneuses sont déversées dans la nature au lieu de rejoindre les évacuations des eaux usées. Elles peuvent par la suite se déverser dans le cours d’eau le plus proche par ruissellement ou par infiltration, entraînant ainsi l’infiltration de résidus d’hydrocarbures et d’huiles dans le sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a358e8ef-2ed4-3964-b145-458d3950f874",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Tout phénomène extérieur qui peut être nuisible, dangereux pour la santé, ou désagréable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c25ad-a42f-4f92-99e8-b566eff6574d",
                                                "sense_id": "a358e8ef-2ed4-3964-b145-458d3950f874",
                                                "text": "La pollution lumineuse empêche la bonne observation des étoiles."
                                            },
                                            {
                                                "example_id": "19af8223-3315-4f4f-ba1a-893614beba9a",
                                                "sense_id": "a358e8ef-2ed4-3964-b145-458d3950f874",
                                                "text": "La pollution acoustique est un fléau urbain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb789a0-5041-3306-825d-0568cf48ed47",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Émission involontaire de sperme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10de33c2-39b7-4e17-9331-733dfc906466",
                                                "sense_id": "2eb789a0-5041-3306-825d-0568cf48ed47",
                                                "text": "Je me réveillai vers cinq heures, constatai que les draps étaient largement tachés de sperme. Une pollution nocturne… c’était attendrissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0798f56-0ec1-331d-b412-44468fc29f87",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Profanation, souillure, péché d’impureté."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4afdd2dd-b287-4e04-ad57-60facc76bd74",
                                                "sense_id": "c0798f56-0ec1-331d-b412-44468fc29f87",
                                                "text": "La pollution d’une église dure jusqu’à ce qu’elle ait été bénite à nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
