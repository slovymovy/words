{
    "word_family": [
        "duister",
        "verduisteren",
        "verduistering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8fc2d246-fe82-3cdf-93c9-2b85101a6301",
                    "sense_definition": "De toestand waarin er weinig of geen licht is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We konden bijna niets zien in de <w>duisternis</w>.",
                            "target_lang_translations": {
                                "en": "We could see almost nothing in the <w>darkness</w>.",
                                "ru": "Мы почти ничего не могли разглядеть в <w>темноте</w>.",
                                "fr": "Nous ne pouvions presque rien voir dans l'<w>obscurité</w>."
                            }
                        },
                        {
                            "text": "Door de invallende <w>duisternis</w> moesten we stoppen met zoeken.",
                            "target_lang_translations": {
                                "en": "Due to the gathering <w>darkness</w>, we had to stop searching.",
                                "ru": "Из-за наступающей <w>темноты</w> нам пришлось прекратить поиски.",
                                "fr": "À cause de l'<w>obscurité</w> tombante, nous avons dû arrêter nos recherches."
                            }
                        }
                    ],
                    "synonyms": [
                        "donkerte"
                    ],
                    "antonyms": [
                        "licht"
                    ],
                    "common_phrases": [
                        "in de duisternis",
                        "totale duisternis",
                        "invallende duisternis"
                    ],
                    "target_lang_definitions": {
                        "en": "The state in which there is little or no light.",
                        "ru": "Состояние, при котором мало или совсем нет света.",
                        "fr": "L'état dans lequel il y a peu ou pas de lumière."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darkness",
                                "target_lang_sense_clarification": "absence of light"
                            },
                            {
                                "target_lang_word": "the dark",
                                "target_lang_sense_clarification": "absence of light (informal)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "темнота",
                                "target_lang_sense_clarification": "отсутствие света"
                            },
                            {
                                "target_lang_word": "мрак",
                                "target_lang_sense_clarification": "полная, густая темнота"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "obscurité",
                                "target_lang_sense_clarification": "absence partielle ou totale de lumière"
                            },
                            {
                                "target_lang_word": "ténèbres",
                                "target_lang_sense_clarification": "obscurité profonde, souvent utilisée au pluriel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a7925d3-9812-3acf-9f84-f06d1ef32e7d",
                    "sense_definition": "Een toestand van onwetendheid, somberheid of gebrek aan geestelijk inzicht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van <w>duisternis</w> kwam er eindelijk weer hoop in zijn leven.",
                            "target_lang_translations": {
                                "en": "After years of <w>darkness</w>, hope finally returned to his life.",
                                "ru": "После лет <w>мрака</w> в его жизнь наконец вернулась надежда.",
                                "fr": "Après des années de <w>ténèbres</w>, l'espoir est enfin revenu dans sa vie."
                            }
                        },
                        {
                            "text": "Het boek beschrijft de geestelijke <w>duisternis</w> van die periode.",
                            "target_lang_translations": {
                                "en": "The book describes the spiritual <w>darkness</w> of that period.",
                                "ru": "Книга описывает духовную <w>тьму</w> того периода.",
                                "fr": "Le livre décrit les <w>ténèbres</w> spirituelles de cette période."
                            }
                        }
                    ],
                    "antonyms": [
                        "licht"
                    ],
                    "common_phrases": [
                        "geestelijke duisternis",
                        "eeuwen van duisternis"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of ignorance, gloom, or lack of spiritual insight.",
                        "ru": "Состояние невежества, уныния или отсутствия духовного понимания.",
                        "fr": "Un état d'ignorance, de tristesse ou un manque de perspicacité spirituelle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darkness",
                                "target_lang_sense_clarification": "metaphorical state"
                            },
                            {
                                "target_lang_word": "gloom",
                                "target_lang_sense_clarification": "state of depression or sadness"
                            },
                            {
                                "target_lang_word": "obscurity",
                                "target_lang_sense_clarification": "lack of knowledge or clarity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тьма",
                                "target_lang_sense_clarification": "невежество, духовная пустота"
                            },
                            {
                                "target_lang_word": "мрак",
                                "target_lang_sense_clarification": "уныние, безнадежность"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ténèbres",
                                "target_lang_sense_clarification": "état d'ignorance ou de désespoir moral"
                            },
                            {
                                "target_lang_word": "obscurité",
                                "target_lang_sense_clarification": "manque de clarté ou de connaissance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}