                "senses": [
                    {
                        "sense_id": "31bb7fd0-7eb4-3528-93b8-2e0a8b44f167",
                        "entry_id": "2ca2d163-72f6-3a77-9a47-74bd6b5e23e1",
                        "glosses": [
                            "Gesamtheit der Aktivitäten, mit denen man Adressaten einen positiven Eindruck von sich vermitteln will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50813d3c-2eb3-4cf4-8810-58dcf6722e28",
                                "sense_id": "31bb7fd0-7eb4-3528-93b8-2e0a8b44f167",
                                "text": "„Vielmehr fühlte sie sich von der Lebensweise der Indigenen angezogen, verehrte Sitting Bull und hoffte, Öffentlichkeitsarbeit für ihn und sein Volk machen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f96ba3c0-8153-415b-b665-f00ba3a10f3d",
                        "source_entry_id": "2ca2d163-72f6-3a77-9a47-74bd6b5e23e1",
                        "source_sense_id": "31bb7fd0-7eb4-3528-93b8-2e0a8b44f167",
                        "source_sense_description": "Public Relations",
                        "target_lang_word": "relations publiques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relations publiques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97558c0b-0213-3b6f-87b7-3f240920bd0d",
                                        "entry_id": "b1d4833b-652a-35f4-ab48-c0324c05944e",
                                        "glosses": [
                                            "Ensemble de techniques de communication destinées à donner une image favorable à une personne, une organisation publique ou privée ou une idée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1962b406-36e4-4e6d-a866-7f0f9bbaeddd",
                                                "sense_id": "97558c0b-0213-3b6f-87b7-3f240920bd0d",
                                                "text": "Une question demeure entière : la récente activité diplomatique est-elle un engagement sérieux pour ouvrir les frontières du Caucase ou n’est-ce qu’une opération de relations publiques qui profite à tous les gouvernements concernés ?"
                                            },
                                            {
                                                "example_id": "db59df2a-7770-4ce8-98b6-949ec1620e40",
                                                "sense_id": "97558c0b-0213-3b6f-87b7-3f240920bd0d",
                                                "text": "Le travail des relations publiques est fait par des relationnistes, mais porté par des journalistes."
                                            },
                                            {
                                                "example_id": "2d1f7db9-04f2-4c6d-84b7-165fccc81c30",
                                                "sense_id": "97558c0b-0213-3b6f-87b7-3f240920bd0d",
                                                "text": "Malgré ce caractères indispensable, les relations publiques n'ont pas bonne presse dans nos sociétés. Les journalistes parlent souvent d'un « exercice de relations publiques » pour décrire une politique bidon, un maquillage ou même une tromperie. La chroniqueuse féministe Judith Lussier avait qualifié Mᵐᵉ Mélanie Joly de « professeure de cassettes » lors de son entrée en politique fédérale. À son avis, celle-ci « appartenait à la pire caste des bonimenteurs, … celle des relations publiques »."
                                            },
                                            {
                                                "example_id": "b68c0476-dfc1-4f34-841f-afb6b297e557",
                                                "sense_id": "97558c0b-0213-3b6f-87b7-3f240920bd0d",
                                                "text": "Comme toutes les firmes de Wall Street, les fonds vautours font appel à des cabinets de relations publiques et à des lobbies pour contrer les régulations contraires à leurs intérêts financiers. L'année dernière, une législation très contraignante contre la spéculation sur les dettes souveraines en défaut avait échoué à être votée, grâce à l'opposition de tout le secteur financier américain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
