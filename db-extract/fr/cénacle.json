                "senses": [
                    {
                        "sense_id": "a0993a84-d3a1-3d3a-a7f7-b5158c962463",
                        "entry_id": "bc695003-672d-36dc-8b3d-1f5c54f09834",
                        "glosses": [
                            "Salle où Jésus-Christ et ses disciples se rencontrèrent lors de la Cène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a0133fa-5a6a-4372-8be2-49daed6e08a3",
                                "sense_id": "a0993a84-d3a1-3d3a-a7f7-b5158c962463",
                                "text": "Le Christ lava les pieds des apôtres dans le cénacle."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6aaae66-5031-3275-9529-c6cd72e7cea8",
                        "entry_id": "bc695003-672d-36dc-8b3d-1f5c54f09834",
                        "glosses": [
                            "Réunion d’un petit nombre de personnes ayant les mêmes idées, les mêmes goûts, professant surtout les mêmes théories artistiques, littéraires, philosophiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512db8ee-808a-4ccb-8693-651d70c16ef2",
                                "sense_id": "c6aaae66-5031-3275-9529-c6cd72e7cea8",
                                "text": "Leur attitude nous montre que les anarchistes […] n’appliquèrent pas des théories qui avaient été fabriquées dans des cénacles philosophiques. Ils apprirent surtout aux ouvriers qu’il ne fallait pas rougir des actes violents."
                            },
                            {
                                "example_id": "c159f1dd-d023-40ff-8472-062e8be6e3bb",
                                "sense_id": "c6aaae66-5031-3275-9529-c6cd72e7cea8",
                                "text": "Ces diverses formes de tarabiscotage (telle serait peut-être la meilleure traduction de cette troublante locution) pouvaient passionner de petit cénacles, mais avaient peu de chances d’intéresser le public mondain qui était celui des troubadours."
                            },
                            {
                                "example_id": "b5bfada7-f138-4fe7-96bd-d8eca0f5db82",
                                "sense_id": "c6aaae66-5031-3275-9529-c6cd72e7cea8",
                                "text": "Ainsi Coitier s’est vite fait une place importante dans ce cénacle de médecins qui vivent dans l’entourage de Louis XI."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e85a6721-6ddc-4dc8-b59e-d1927b0d7c15",
                        "source_entry_id": "bc695003-672d-36dc-8b3d-1f5c54f09834",
