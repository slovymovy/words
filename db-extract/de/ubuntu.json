                "senses": [
                    {
                        "sense_id": "463cc9ff-2659-3ce5-b148-ebcfb50865b2",
                        "entry_id": "7fdb7f67-f56b-37c3-961a-540da9eeb850",
                        "glosses": [
                            "aus dem südlichen Afrika stammende Lebensphilosophie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1b4665-3aa6-428e-805b-088a2f895ffe",
                                "sense_id": "463cc9ff-2659-3ce5-b148-ebcfb50865b2",
                                "text": "„Tutu spielte auch eine Rolle darin, Südafrika aktuellen Strömungen zu öffnen - besonders im Kulturbereich - indem er seine Landsleute mit einer neuen Idee bekannt machte: Ubuntu.“"
                            },
                            {
                                "example_id": "1896ae64-7c00-4a3e-873d-9958f93ec956",
                                "sense_id": "463cc9ff-2659-3ce5-b148-ebcfb50865b2",
                                "text": "„Die Begrüßung, die unter den ChiShona sprechenden Menschen in Simbabwe üblich ist, enthält das Grundprinzip von Ubuntu.“"
                            },
                            {
                                "example_id": "46db158c-6518-4b54-8c71-78d12a350c38",
                                "sense_id": "463cc9ff-2659-3ce5-b148-ebcfb50865b2",
                                "text": "„Ubuntu beschreibt eine moralische Grundhaltung, die die Weltsicht der Afrikaner prägt.“"
                            },
                            {
                                "example_id": "010a5236-935a-4d08-b9bd-6dab89c16604",
                                "sense_id": "463cc9ff-2659-3ce5-b148-ebcfb50865b2",
                                "text": "„Denn Ubuntu bedeutet: gemeinsam zu Menschen werden, einander wechselseitig menschlich machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
