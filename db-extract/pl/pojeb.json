                            {
                                "example_id": "4f23375e-0c2b-40f3-9e27-4ce29fd37a66",
                                "sense_id": "cb35be53-28d4-3cf0-aa2c-8b8c8a283e6b",
                                "text": "Zrobiłaś się wściekła i rozgoryczona. Jak tak dalej pójdzie zmienisz się w niezłego pojeba"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
