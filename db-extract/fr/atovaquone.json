                "senses": [
                    {
                        "sense_id": "e09b1be1-7b8c-3ebd-8a15-fad33706b28c",
                        "entry_id": "1047e629-0f2e-3443-997c-aefd21de9398",
                        "glosses": [
                            "Substance chimique de la classe des naphtalènes, un hydroxy-1,4-naphthoquinone, un analogue de l’ubiquinone, qui, associé au proguanil, permet de lutter contre le paludisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9811ebca-9b2a-4547-9f73-6a9454fc1c91",
                                "sense_id": "e09b1be1-7b8c-3ebd-8a15-fad33706b28c",
                                "text": "L’atovaquone « seul » n’est disponible qu’en milieu hospitalier en France, contrairement au Malarone ® ou à son générique, vendus en pharmacie."
                            },
                            {
                                "example_id": "43adf4df-f91f-490b-8d89-79653f4e56ef",
                                "sense_id": "e09b1be1-7b8c-3ebd-8a15-fad33706b28c",
                                "text": "Parmi eux, l’ébastine, un antihistaminique (utilisé pour le traitement des rhinites ou de l’urticaire) et l’atovaquone (utilisée dans le traitement du paludisme)."
                            },
                            {
                                "example_id": "a6d57b2e-3c8f-42ff-b2c3-6e3668d6dee2",
                                "sense_id": "e09b1be1-7b8c-3ebd-8a15-fad33706b28c",
                                "text": "L’association atovaquone-proguanil comme le Malarone201 (GlaxoSmithKline) peut être conseillée en alternative à la méfloquine."
                            }
                        ]
                    }
                ],
