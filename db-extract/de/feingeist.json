                                "sense_id": "90527369-45ce-3709-92b9-c872c697bc5b",
                                "text": "Sie schätze ihn schon immer als Feingeist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "92972abe-9c2c-3596-9b8d-a58279ed8fb8",
                        "entry_id": "c4eeefe4-ef4b-3bd8-9c12-e023c2b84f6d",
                        "glosses": [
                            "Person, die auf schöne und schöngeistige Dinge besonderen Wert legt und besonders darauf anspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "375526f1-d1e7-4931-ac47-bd1ec685bf10",
                                "sense_id": "92972abe-9c2c-3596-9b8d-a58279ed8fb8",
                                "text": "Da er ein Feingeist ist, legte er schon immer Wert auf eine saubere Pinselführung."
                            },
                            {
                                "example_id": "92c6d625-3913-4a53-8403-1ef589bf096a",
                                "sense_id": "92972abe-9c2c-3596-9b8d-a58279ed8fb8",
                                "text": "„Die Wertungen bestätigten das Todesurteil der Nazis – freilich mit anderer Begründung, subtiler, man ist ja Feingeist und deutscher dazu.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
