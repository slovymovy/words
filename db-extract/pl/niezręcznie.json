                                        "glosses": [
                                            "In an awkward manner; with discomfort or lack of coordination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57754ca5-4305-4821-8d5f-77f5e3ff6acd",
                                                "sense_id": "83366d5c-2f2e-31ba-a00d-24443b934ad1",
                                                "text": "A poorly finished trunk has an awkwardly high liftover and no useful handhold on its lid."
