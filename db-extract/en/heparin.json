                        "sense_id": "c2e002e1-736f-387c-8b74-80a9e9c5f412",
                        "entry_id": "0e68b525-3361-3b01-b937-5a595ff9f532",
                        "glosses": [
                            "A compound occurring in the liver and other tissues which inhibits blood coagulation. A sulfur-containing polysaccharide, it is used as an anticoagulant in the treatment of thrombosis."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d545a0fe-d51f-4767-9052-f77e5b7376c6",
                        "source_entry_id": "0e68b525-3361-3b01-b937-5a595ff9f532",
                        "source_sense_id": "c2e002e1-736f-387c-8b74-80a9e9c5f412",
                        "source_sense_description": "a glycosaminoglycan",
                        "target_lang_word": "héparine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "héparine",
