                "senses": [
                    {
                        "sense_id": "0babe810-6031-3037-9b5a-d90eec359117",
                        "entry_id": "fe4b56f0-71c8-38b8-b64d-2d08530cbedf",
                        "glosses": [
                            "gemeinsamer Aufenthalt einer oder mehrerer Schulklassen in einem Wintersportgebiet, um dort dem gemeinsamen Skilaufen nachzugehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2e2c0e-373f-4cb4-9fd5-4ff59b60b01c",
                                "sense_id": "0babe810-6031-3037-9b5a-d90eec359117",
                                "text": "„Seine Empfehlung dagegen ist ein breites und günstiges Angebot von Schulskikursen in allen Alpenländern.“"
                            },
                            {
                                "example_id": "6fe6417e-f22a-49cb-ac9b-6bc79c8dc781",
                                "sense_id": "0babe810-6031-3037-9b5a-d90eec359117",
                                "text": "„Für einige Schüler ist der Schulskikurs die einzige Zeit in den Bergen und diese würden ohne ebendiesen Kurs wohl eher als zukünftige Wintersportler ausfallen und stattdessen in den kalten Urlaubstagen in die Karibik oder zumindest nach Ägypten entfliegen.“"
                            },
                            {
                                "example_id": "8aa817f4-83c7-49b1-9f22-7da25c46d210",
                                "sense_id": "0babe810-6031-3037-9b5a-d90eec359117",
                                "text": "„Vor 15, 20 Jahren hätten die Bergbahnen Schulskikurse ‚eher als Belastung‘ gesehen, sagt Berchtold, ‚heute denkt man zum Glück wieder anders‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
