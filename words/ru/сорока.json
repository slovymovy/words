{
    "word_family": [
        "сорочий",
        "сорочонок"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2da6d9ca-9b61-3f52-b69c-7f121192a78f",
                    "sense_definition": "Крупная птица семейства врановых с чёрно-белым оперением и длинным хвостом, издающая характерные резкие звуки.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ветке дерева сидела <w>сорока</w> и громко стрекотала.",
                            "target_lang_translations": {
                                "en": "A <w>magpie</w> sat on a tree branch and chattered loudly.",
                                "pl": "Na gałęzi drzewa siedziała <w>sroka</w> i głośno skrzeczała."
                            }
                        },
                        {
                            "text": "В парке мы видели чёрно-белую <w>сороку</w> с длинным хвостом.",
                            "target_lang_translations": {
                                "en": "In the park we saw a black-and-white <w>magpie</w> with a long tail.",
                                "pl": "W parku widzieliśmy czarno-białą <w>srokę</w> z długim ogonem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сорока на хвосте принесла",
                        "трещать как сорока",
                        "сорока-белобока"
                    ],
                    "target_lang_definitions": {
                        "en": "A large bird of the crow family with black and white plumage and a long tail, making characteristic harsh sounds.",
                        "pl": "Duży ptak z rodziny krukowatych o czarno-białym upierzeniu i długim ogonie, wydający charakterystyczne skrzeczące dźwięki."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "magpie",
                                "target_lang_sense_clarification": "bird"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sroka",
                                "target_lang_sense_clarification": "ptak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc50e9a4-9044-3bcb-9a9b-b7a3d8aec24e",
                    "sense_definition": "Болтливый человек, любитель сплетен (обычно о женщине).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя соседка — настоящая <w>сорока</w>, она знает всё про всех в нашем доме.",
                            "target_lang_translations": {
                                "en": "My neighbor is a real <w>gossip</w>; she knows everything about everyone in our building.",
                                "pl": "Moja sąsiadka to prawdziwa <w>plotkara</w>, wie wszystko o wszystkich w naszym bloku."
                            }
                        },
                        {
                            "text": "Хватит болтать, <w>сорока</w>, лучше займись делом.",
                            "target_lang_translations": {
                                "en": "Stop chatting, <w>chatterbox</w>, you'd better get busy.",
                                "pl": "Przestań gadać, <w>gaduło</w>, lepiej weź się do roboty."
                            }
                        }
                    ],
                    "synonyms": [
                        "сплетница",
                        "сплетник",
                        "трещотка",
                        "трепач"
                    ],
                    "common_phrases": [
                        "трещать как сорока"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "неодобрительно"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A talkative person, someone who loves gossip (usually referring to a woman).",
                        "pl": "Osoba gadatliwa, plotkara (zazwyczaj o kobiecie)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chatterbox",
                                "target_lang_sense_clarification": "talkative person"
                            },
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "person who spreads rumors"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sroka",
                                "target_lang_sense_clarification": "o gadatliwej osobie"
                            },
                            {
                                "target_lang_word": "plotkara",
                                "target_lang_sense_clarification": "kobieta roznosząca plotki"
                            },
                            {
                                "target_lang_word": "gaduła",
                                "target_lang_sense_clarification": "osoba dużo mówiąca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96f41e9-c026-3d20-ac5a-419b5137c7f3",
                    "sense_definition": "Старинный русский нарядный головной убор, который носили замужние женщины.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В музее мы увидели расшитую золотом праздничную <w>сороку</w>.",
                            "target_lang_translations": {
                                "en": "In the museum, we saw a festive <w>soroka</w> embroidered with gold.",
                                "pl": "W muzeum zobaczyliśmy haftowaną złotem odświętną <w>sorokę</w>."
                            }
                        },
                        {
                            "text": "Крестьянка повязала голову нарядной <w>сорокой</w> перед выходом в церковь.",
                            "target_lang_translations": {
                                "en": "The peasant woman tied a festive <w>soroka</w> on her head before going to church.",
                                "pl": "Chłopka przewiązała głowę stroją <w>soroką</w> przed wyjściem do cerkwi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "исторический термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An ancient Russian festive headdress worn by married women.",
                        "pl": "Dawne tradycyjne rosyjskie nakrycie głowy noszone przez mężatki."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soroka",
                                "target_lang_sense_clarification": "historical headdress"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "soroka",
                                "target_lang_sense_clarification": "historyczne nakrycie głowy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "a2ceaafb-5fe1-3ab6-93ea-0795f91c1207",
                    "sense_definition": "Форма родительного, дательного, творительного и предложного падежей числительного <w>сорок</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "numeral_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему уже больше <w>сорока</w> лет, но он выглядит молодо.",
                            "target_lang_translations": {
                                "en": "He is already over <w>forty</w> years old, but he looks young.",
                                "pl": "On ma już ponad <w>czterdzieści</w> lat, ale wygląda młodo."
                            }
                        },
                        {
                            "text": "Мы остановились в <w>сорока</w> километрах от города.",
                            "target_lang_translations": {
                                "en": "We stopped <w>forty</w> kilometers from the city.",
                                "pl": "Zatrzymaliśmy się <w>czterdzieści</w> kilometrów od miasta."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the genitive, dative, instrumental, and prepositional cases of the numeral 'forty'.",
                        "pl": "Forma dopełniacza, celownika, narzędnika i miejscownika liczebnika «сорок» (czterdzieści)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forty",
                                "target_lang_sense_clarification": "numeral"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "czterdzieści",
                                "target_lang_sense_clarification": "liczebnik (w przypadkach zależnych: czterdziestu/czterdziestoma)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "093207b7-1593-3d4e-8680-1fccf21ac36c",
                    "sense_definition": "Фамилия украинского происхождения.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "На собрании выступил господин <w>Сорока</w> с докладом.",
                            "target_lang_translations": {
                                "en": "Mr. <w>Soroka</w> spoke at the meeting with a report.",
                                "pl": "Na zebraniu wystąpił pan <w>Soroka</w> z referatem."
                            }
                        },
                        {
                            "text": "Мы познакомились с Анной <w>Сорокой</w> во время командировки.",
                            "target_lang_translations": {
                                "en": "We met Anna <w>Soroka</w> during a business trip.",
                                "pl": "Poznaliśmy Annę <w>Sorokę</w> podczas delegacji."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A surname of Ukrainian origin.",
                        "pl": "Nazwisko pochodzenia ukraińskiego."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Soroka",
                                "target_lang_sense_clarification": "surname"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Soroka",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9267ae2b-2e24-30cc-80b8-f5a354a698cf",
                    "sense_definition": "Название ряда населённых пунктов в России, Украине и Молдавии.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toponym",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Моя бабушка родилась в небольшом селе <w>Сорока</w>.",
                            "target_lang_translations": {
                                "en": "My grandmother was born in the small village of <w>Soroka</w>.",
                                "pl": "Moja babcia urodziła się w niewielkiej wsi <w>Soroka</w>."
                            }
                        },
                        {
                            "text": "Туристы посетили город <w>Сорока</w> и его знаменитую крепость.",
                            "target_lang_translations": {
                                "en": "Tourists visited the city of <w>Soroka</w> and its famous fortress.",
                                "pl": "Turyści odwiedzili miasto <w>Soroki</w> i jego słynną twierdzę."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Name of a number of settlements in Russia, Ukraine, and Moldova.",
                        "pl": "Nazwa miejscowości w Rosji, Ukrainie i Mołdawii (np. Soroki)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Soroka",
                                "target_lang_sense_clarification": "place name"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Soroka",
                                "target_lang_sense_clarification": "nazwa miejscowości"
                            },
                            {
                                "target_lang_word": "Soroki",
                                "target_lang_sense_clarification": "miasto w Mołdawii"
                            }
                        ]
                    }
                }
            ]
        }
    ]
