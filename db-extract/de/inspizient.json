                "senses": [
                    {
                        "sense_id": "d4c1e1e7-875b-3258-a200-0b95972531ed",
                        "entry_id": "6563e554-8960-35ca-bb82-5fa8e75a9315",
                        "glosses": [
                            "Person, die bei Theateraufführungen den technischen Ablauf koordiniert und überwacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac4431a-5e08-4699-a2ca-fbc1c59d0bbc",
                                "sense_id": "d4c1e1e7-875b-3258-a200-0b95972531ed",
                                "text": "„Der Inspizient, ein liebenswürdiger älterer Herr, stellte ihm einen Stuhl in die erste Gasse neben den Feuerwehrmann.“"
                            },
                            {
                                "example_id": "fc85178a-1fd0-44c2-beb4-3b5f03cc51f8",
                                "sense_id": "d4c1e1e7-875b-3258-a200-0b95972531ed",
                                "text": "„Als künstlerisch sind die Dienste der Schauspieler, Sänger, (…), sowie des szenischen Dienstes, das sind etwa Trainingsmeister, Repetitoren, Souffleure und Inspizienten, kurzum solche Tätigkeiten zu bezeichnen, die dem Ausführenden eine gewisse »schöpferische Persönlichkeitskräfte entfaltende Individualität« gestatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9018246-703f-33ee-bc07-6fd8d1955778",
                        "entry_id": "6563e554-8960-35ca-bb82-5fa8e75a9315",
                        "glosses": [
                            "Dienststellung oder besonderer Aufgabenbereich mit kontrollierendem, organisatorischem Schwerpunkt"
                        ],
                        "tags": [
                            "Bundeswehr",
                            "Orchester"
                        ],
                        "examples": [
                            {
                                "example_id": "5b4de554-0c2f-45f7-a4e8-2a2aede82266",
                                "sense_id": "a9018246-703f-33ee-bc07-6fd8d1955778",
                                "text": "Der Inspizient bereitet die Probe vor. Er verteilt die Noten, fährt die Bühne hoch und versucht auf alle Sonderwünsche und speziellen Anforderungen der Musiker einzugehen. Sei es ein etwas niedrigerer Stuhl hier oder ein Glas Wasser dort."
                            },
                            {
                                "example_id": "da43ddfe-fc2c-4858-b0de-0b8aa5716dde",
                                "sense_id": "a9018246-703f-33ee-bc07-6fd8d1955778",
                                "text": "Als aufmerksamer Beobachter verfolgte der Inspizint der Bundeswehr den Erfahrungs- und Meinungsaustausch der Anwesenden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
