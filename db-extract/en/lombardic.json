                                "target_senses": [
                                    {
                                        "sense_id": "5f02e67e-b239-37a7-8a6c-1a87fa05adc9",
                                        "entry_id": "dc14e6ba-fd10-3daf-af93-f63b0b45160b",
                                        "glosses": [
                                            "die Langobarden betreffend, nach Art der Langobarden, auf die Langobarden bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea75fcef-3d28-4ea1-9d4c-7160c9003d1e",
                                                "sense_id": "5f02e67e-b239-37a7-8a6c-1a87fa05adc9",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            },
                                            {
                                                "example_id": "e44b3392-d515-4282-bc97-cf83b336e38b",
                                                "sense_id": "5f02e67e-b239-37a7-8a6c-1a87fa05adc9",
                                                "text": "„Die langobardischen Städte erkämpften 1183 ihre Freiheit von Barbarossa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4336ed04-e720-33a7-bd2f-2f4d40251240",
                                        "entry_id": "dc14e6ba-fd10-3daf-af93-f63b0b45160b",
                                        "glosses": [
                                            "die langobardische Sprache betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7738346-bdad-4e8b-8353-d9ae9af346c4",
                                                "sense_id": "4336ed04-e720-33a7-bd2f-2f4d40251240",
                                                "text": "„Die germanische Sprache »verschwand zwar im Laufe des 7. Jahrhunderts allmählich als Folge eines Assimilationsprozesses«, wie der Althistoriker Bleckmann schreibt; »gleichwohl bildete sich unter den früheren Romanen, die viele langobardische Wörter in ihre Sprache übernahmen, und den beherrschenden Germanen allmählich ein langobardisches Staatsbewusstsein heraus«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
