                "senses": [
                    {
                        "sense_id": "0b34430f-c711-3ea9-ac1a-5924b0e0686d",
                        "entry_id": "7c2a4b20-9ad9-33f4-8bb7-bfb3d08399d6",
                        "glosses": [
                            "To twang repetitively."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7f61e5b6-a45f-4061-98d3-4098fd2c40ba",
                                "sense_id": "0b34430f-c711-3ea9-ac1a-5924b0e0686d",
                                "text": "Cal. Be not affeard, the Iſle is full of noyſes,\n Sounds, and ſweet aires, that giue delight and hurt not :\n Sometimes a thouſand twangling Inſtruments\n Will hum about mine eares ; and ſometime voices,\n That if I then had wak'd after long ſleepe,\n Will make me ſleepe againe, and then in dreaming,\n The clouds methought would open, and ſhew riches\n Ready to drop vpon me, that when I wak'd\n I cri'de to dreame againe."
                            },
                            {
                                "example_id": "6167ae77-0f12-436a-b6ce-794932c2f347",
                                "sense_id": "0b34430f-c711-3ea9-ac1a-5924b0e0686d",
                                "text": "While the twangling violin / Struck up with Soldier-laddie."
                            }
                        ]
                    }
