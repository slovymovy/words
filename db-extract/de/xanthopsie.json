                                        "glosses": [
                                            "A visual disorder in which things appear yellowish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aed65e4-f2d1-4091-bbf6-ea296ed4d09b",
                                                "sense_id": "06fb85e7-bd79-3fd8-909c-4954b51d20c9",
                                                "text": "An icteric discoloration of the sclerotic — a quite common symptom in xanthopia from arsenical poisoning — is very seldom observed."
                                            },
                                            {
                                                "example_id": "cf8def73-8fb6-4d0f-b51b-5b040e7781fa",
                                                "sense_id": "06fb85e7-bd79-3fd8-909c-4954b51d20c9",
                                                "text": "There is sensation of foreign body irritation, more or less photophobia and lacrimation, frequently persistent after images, and occasionally scotoma, erythema and xanthopia."
                                            }
                                        ]
                                    }
