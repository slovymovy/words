                "senses": [
                    {
                        "sense_id": "9f7ec334-e45a-3611-b6cb-980fe7588ab4",
                        "entry_id": "88b40abf-4d5f-3459-975c-c97e637ac91c",
                        "glosses": [
                            "Vorgabe/Regel, die man sich selbst auferlegt, ohne dass man dazu von außen gezwungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a52d760-cca8-4150-9cb5-e380acda92c4",
                                "sense_id": "9f7ec334-e45a-3611-b6cb-980fe7588ab4",
                                "text": "„Bei den eingehaltenen Selbstverpflichtungen gibt es allerdings auch einige Fälle, bei denen die Vermutung nahe liegt, dass die Ziele aufgrund ihres niedrigen Anspruchsgehaltes auch ohne Selbstverpflichtung erreicht worden wären.“"
                            },
                            {
                                "example_id": "72d57ac2-5c73-414a-a5d2-2a4dec8e10bf",
                                "sense_id": "9f7ec334-e45a-3611-b6cb-980fe7588ab4",
                                "text": "„Das ist ein moralisches Selbstbild mit dem Charakter einer Selbstverpflichtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
