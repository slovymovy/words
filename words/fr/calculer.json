{
    "word_family": [
        "calcul",
        "calculable",
        "incalculable",
        "calculateur",
        "calculatrice",
        "recalculer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c42cf22d-298e-377c-9c65-72a15171b214",
                    "sense_definition": "Déterminer une quantité ou un résultat par des opérations mathématiques.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathématiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant utilise une calculatrice pour <w>calculer</w> le résultat final."
                        },
                        {
                            "text": "Il faut <w>calculer</w> le montant exact des dépenses du mois."
                        }
                    ],
                    "synonyms": [
                        "compter",
                        "supputer"
                    ],
                    "common_phrases": [
                        "calculer le coût",
                        "calculer une moyenne"
                    ]
                },
                {
                    "sense_id": "bc683db6-eed3-3e01-9277-fd2badd9eed7",
                    "sense_definition": "Évaluer, combiner ou prévoir des éléments en vue d'une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur d'échecs prend le temps de <w>calculer</w> tous ses coups."
                        },
                        {
                            "text": "Elle a su <w>calculer</w> les conséquences de sa décision avant d'agir."
                        }
                    ],
                    "synonyms": [
                        "combiner",
                        "méditer",
                        "peser",
                        "prévoir"
                    ],
                    "common_phrases": [
                        "calculer les risques",
                        "calculer ses gestes"
                    ]
                },
                {
                    "sense_id": "0674352f-419a-3c57-9d11-7a3efe8ef904",
                    "sense_definition": "Prêter attention à quelqu'un, lui accorder de l'intérêt ou de la considération.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand je suis entré dans la pièce, il ne m'a même pas <w>calculé</w>."
                        },
                        {
                            "text": "Arrête d'essayer d'attirer son attention si elle ne te <w>calcule</w> pas."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre familier ou argotique des jeunes"
                        }
                    ]
                },
                {
                    "sense_id": "c2ffeba9-21a7-3dd7-bae3-a156d15fcca0",
                    "sense_definition": "Estimer, juger ou considérer selon son avis personnel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À voir la situation, je <w>calcule</w> que nous n'avons plus beaucoup d'options."
                        },
                        {
                            "text": "Moi, je <w>calcule</w> qu'il aurait dû attendre avant de prendre cette décision."
                        }
                    ],
                    "synonyms": [
                        "conjecturer",
                        "juger"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement au Québec et en Acadie"
                        }
                    ]
                }
            ]
        }
    ]
}