                "entry_id": "29fe7975-2f17-354b-9c5c-7813557bb817",
                "word": "tubéreuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "44913a97-e984-4af1-a4fb-42bdaa557e6a",
                        "entry_id": "29fe7975-2f17-354b-9c5c-7813557bb817",
                        "tags": [
                            "plural"
                        ],
