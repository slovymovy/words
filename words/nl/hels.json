{
    "word_family": [
        "hel",
        "hellehond",
        "hellevuur"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac163a42-d1b3-3d6b-94e4-8d6dba9ffafd",
                    "sense_definition": "heel erg boos of woedend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar werd <w>hels</w> toen niemand zijn huiswerk had gemaakt.",
                            "target_lang_translations": {
                                "en": "The teacher became <w>furious</w> when no one had done their homework."
                            }
                        },
                        {
                            "text": "Ze was werkelijk <w>hels</w> over de oneerlijke beslissing van de scheidsrechter.",
                            "target_lang_translations": {
                                "en": "She was truly <w>livid</w> about the referee's unfair decision."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hels worden"
                    ],
                    "target_lang_definitions": {
                        "en": "extremely angry or furious"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "furious",
                                "target_lang_sense_clarification": "extremely angry"
                            },
                            {
                                "target_lang_word": "livid",
                                "target_lang_sense_clarification": "enraged"
                            },
                            {
                                "target_lang_word": "mad",
                                "target_lang_sense_clarification": "very angry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4578784a-6563-356a-861c-30340e28a13b",
                    "sense_definition": "buitengewoon hevig, intens of extreem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buren maakten midden in de nacht een <w>hels</w> kabaal.",
                            "target_lang_translations": {
                                "en": "The neighbours made an <w>infernal</w> racket in the middle of the night."
                            }
                        },
                        {
                            "text": "Na de zware val had hij een <w>helse</w> pijn in zijn schouder.",
                            "target_lang_translations": {
                                "en": "After the bad fall, he had an <w>excruciating</w> pain in his shoulder."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hels kabaal",
                        "helse pijn",
                        "hels tempo"
                    ],
                    "target_lang_definitions": {
                        "en": "extraordinarily intense, severe, or extreme"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infernal",
                                "target_lang_sense_clarification": "extreme or unbearable"
                            },
                            {
                                "target_lang_word": "hellish",
                                "target_lang_sense_clarification": "intense or terrible"
                            },
                            {
                                "target_lang_word": "excruciating",
                                "target_lang_sense_clarification": "of severe pain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "374d30b6-153e-30fe-9bb5-ce6560ead719",
                    "sense_definition": "van de hel of betrekking hebbend op de hel",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze middeleeuwse schilder had een duidelijke voorliefde voor <w>helse</w> taferelen.",
                            "target_lang_translations": {
                                "en": "This medieval painter had a clear fondness for <w>hellish</w> scenes."
                            }
                        },
                        {
                            "text": "In het oude verhaal werd de zondaar verteerd door <w>helse</w> vlammen.",
                            "target_lang_translations": {
                                "en": "In the old story, the sinner was consumed by <w>infernal</w> flames."
                            }
                        }
                    ],
                    "synonyms": [
                        "infernaal"
                    ],
                    "common_phrases": [
                        "helse vlammen",
                        "helse taferelen"
                    ],
                    "target_lang_definitions": {
                        "en": "of or relating to hell"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infernal",
                                "target_lang_sense_clarification": "relating to hell"
                            },
                            {
                                "target_lang_word": "hellish",
                                "target_lang_sense_clarification": "resembling or belonging to hell"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "732cf79f-338f-3dfa-8143-f7974cf1be00",
                    "sense_definition": "afschuwelijk, gruwelijk en uiterst zwaar om te doorstaan",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten moesten een <w>helse</w> tocht door het bevroren gebergte doorstaan.",
                            "target_lang_translations": {
                                "en": "The soldiers had to endure a <w>hellish</w> journey through the frozen mountains."
                            }
                        },
                        {
                            "text": "Het overleven van de zware storm was een werkelijk <w>helse</w> beproeving.",
                            "target_lang_translations": {
                                "en": "Surviving the severe storm was a truly <w>grueling</w> ordeal."
                            }
                        }
                    ],
                    "synonyms": [
                        "infernaal"
                    ],
                    "common_phrases": [
                        "helse tocht",
                        "helse beproeving",
                        "helse klus"
                    ],
                    "target_lang_definitions": {
                        "en": "horrible, grueling, and extremely difficult to endure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hellish",
                                "target_lang_sense_clarification": "extremely difficult, grueling"
                            },
                            {
                                "target_lang_word": "infernal",
                                "target_lang_sense_clarification": "grueling or wretched"
                            },
                            {
                                "target_lang_word": "nightmarish",
                                "target_lang_sense_clarification": "terrible and harrowing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "197fe1f5-42ee-3c7d-9ff0-965d35db6e19",
                    "sense_definition": "chemisch zeer agressief of bijtend",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts behandelde het wratje voorzichtig met <w>helse</w> steen.",
                            "target_lang_translations": {
                                "en": "The doctor carefully treated the wart with <w>lunar</w> caustic."
                            }
                        },
                        {
                            "text": "Zilvernitraat staat in de volksmond ook wel bekend als <w>helse</w> steen.",
                            "target_lang_translations": {
                                "en": "Silver nitrate is also colloquially known as <w>lunar</w> caustic."
                            }
                        }
                    ],
                    "common_phrases": [
                        "helse steen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "hoofdzakelijk nog bekend uit de vaste verbinding 'helse steen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "chemically highly aggressive or caustic"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "caustic",
                                "target_lang_sense_clarification": "corrosive, burning"
                            },
                            {
                                "target_lang_word": "infernal",
                                "target_lang_sense_clarification": "in archaic mineral names (e.g., lunar caustic/lapis infernalis)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02b42ea0-67a6-3292-a284-934716cae89d",
                    "sense_definition": "partitief van de stellende trap van <w>hel</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was iets <w>hels</w> aan de manier waarop het licht over het water scheen.",
                            "target_lang_translations": {
                                "en": "There was something <w>bright</w> about the way the light shone across the water."
                            }
                        },
                        {
                            "text": "In die sombere kamer viel niets <w>hels</w> te ontdekken.",
                            "target_lang_translations": {
                                "en": "In that gloomy room, nothing <w>bright</w> could be detected."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iets hels"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "partitieve vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "partitive form of 'hel' (bright, clear)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bright",
                                "target_lang_sense_clarification": "partitive, of brightness or clarity"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "partitive, of clarity"
                            }
                        ]
                    }
                }
            ]
        }
