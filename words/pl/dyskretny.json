    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cbc5664f-f406-3eb0-ad6a-bf37c72e75db",
                    "sense_definition": "potrafiący zachować powierzoną tajemnicę, taktowny i nienaruszający cudzej prywatności",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ania jest wspaniałą przyjaciółką, <w>dyskretną</w> i zawsze lojalną wobec innych.",
                            "target_lang_translations": {
                                "ru": "Аня — прекрасная подруга, <w>тактичная</w> и всегда преданная другим."
                            }
                        },
                        {
                            "text": "Możesz mu o wszystkim powiedzieć, ponieważ to bardzo <w>dyskretny</w> człowiek.",
                            "target_lang_translations": {
                                "ru": "Ты можешь рассказать ему обо всём, потому что он очень <w>сдержанный</w> человек, умеющий хранить секреты."
                            }
                        }
                    ],
                    "synonyms": [
                        "taktowny"
                    ],
                    "common_phrases": [
                        "dyskretna osoba",
                        "dyskretne milczenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "умеющий хранить тайны, тактичный, деликатный и не нарушающий чужих границ"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "не разглашающий лишнего"
                            },
                            {
                                "target_lang_word": "тактичный",
                                "target_lang_sense_clarification": "деликатный, уважительный к границам"
                            },
                            {
                                "target_lang_word": "нескромный",
                                "target_lang_sense_clarification": ""
                            },
                            {
                                "target_lang_word": "скрытный",
                                "target_lang_sense_clarification": "умеющий молчать о чужих тайнах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b28c16-8538-336c-84ef-66c07079167b",
                    "sense_definition": "nierządzący się, nierzucający się w oczy, stonowany lub subtelny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warto wybrać bardziej <w>dyskretny</w> kolor na oficjalne spotkanie biznesowe.",
                            "target_lang_translations": {
                                "ru": "Стоит выбрать более <w>неброский</w> цвет для официальной деловой встречи."
                            }
                        },
                        {
                            "text": "W kawiarni grała <w>dyskretna</w> muzyka, która pozwalała na spokojną rozmowę.",
                            "target_lang_translations": {
                                "ru": "В кафе играла <w>ненавязчивая</w> музыка, которая позволяла спокойно поговорить."
                            }
                        }
                    ],
                    "synonyms": [
                        "subtelny",
                        "stonowany",
                        "niewidoczny"
                    ],
                    "common_phrases": [
                        "dyskretny urok",
                        "dyskretny makijaż",
                        "dyskretne oświetlenie",
                        "dyskretna elegancja"
                    ],
                    "target_lang_definitions": {
                        "ru": "не бросающийся в глаза, неброский, сдержанный или ненавязчивый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неброский",
                                "target_lang_sense_clarification": "не привлекающий лишнего внимания"
                            },
                            {
                                "target_lang_word": "ненавязчивый",
                                "target_lang_sense_clarification": "деликатный, тихий или мягкий"
                            },
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "о цвете, стиле, макияже"
                            },
                            {
                                "target_lang_word": "приглушённый",
                                "target_lang_sense_clarification": "о звуке, свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc55485-7dab-3e0a-a2e7-b5a9534e6d30",
                    "sense_definition": "o zmiennej lub zbiorze: składający się z oddzielnych, policzalnych elementów; nieciągły",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zajęciach badaliśmy, czy badany rozkład prawdopodobieństwa ma charakter <w>dyskretny</w>.",
                            "target_lang_translations": {
                                "ru": "На занятиях мы исследовали, имеет ли изучаемое распределение вероятностей <w>дискретный</w> характер."
                            }
                        },
                        {
                            "text": "W informatyce często stosuje się modele oparte o zmienne <w>dyskretne</w>.",
                            "target_lang_translations": {
                                "ru": "В информатике часто применяются модели, основанные на <w>дискретных</w> переменных."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieciągły",
                        "punktowy"
                    ],
                    "antonyms": [
                        "ciągły"
                    ],
                    "common_phrases": [
                        "matematyka dyskretna",
                        "zmienna dyskretna",
                        "rozkład dyskretny"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "matematyczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "состоящий из отдельных, прерывных элементов; не непрерывный (в математике, физике, информатике)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискретный",
                                "target_lang_sense_clarification": "матем., прерывный, состоящий из отдельных элементов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
