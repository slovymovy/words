                        "examples": [
                            {
                                "example_id": "a0cb20de-49d8-4157-bac1-24c3fdbf840e",
                                "sense_id": "2d37fbc6-8434-37a1-a284-2207257e0736",
                                "text": "Defined as a 'young, extrovert woman, slightly brainless and vulgar', the cagole is constructed not around cosmopolitan femininity but around a beach sculpted body."
                            },
                            {
                                "example_id": "224aa1cc-255a-4af8-8eaa-c44ba3c736ff",
                                "sense_id": "2d37fbc6-8434-37a1-a284-2207257e0736",
                                "text": "Les filles sortent apprêtées, pas « chagasses » pour un sou comme à Montpellier ni « cagoles » comme à Nice, mais très maquillées, sexy dans leur petite robe noire, sans trop en faire.",
                                "translation": "The girls come dressed up, not \"chagasses\" for a cent like in Montpellier nor \"cagoles\" like in Nice, but very made up, sexy in their little black dresses, without overdoing it.",
                                "english": "The girls come dressed up, not \"chagasses\" for a cent like in Montpellier nor \"cagoles\" like in Nice, but very made up, sexy in their little black dresses, without overdoing it."
                            }
