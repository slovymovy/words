                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a85cf9f6-b7e0-4287-9fe8-357fa138f4ea",
                                                "sense_id": "f6e59620-7684-35c6-8450-44e9f4d2fd12",
                                                "text": "Czy półtora jabłka i półtorej gruszki to razem trzy owoce?"
