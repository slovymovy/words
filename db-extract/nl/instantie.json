                        ],
                        "form": "instantietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41c43887-9381-3ed5-bd2d-2a13f9fe987e",
                        "entry_id": "06f7a8e7-41a1-3842-ad57-e34ec95b9b66",
                        "glosses": [
                            "instelling [2]"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": [
                            {
                                "example_id": "e8805622-ffcd-4b44-aafa-f30661a707f5",
                                "sense_id": "41c43887-9381-3ed5-bd2d-2a13f9fe987e",
                                "text": "Dit is een instantie die zich met de ruimtelijke ordening bezighoudt."
                            },
                            {
                                "example_id": "9250c63f-4d7f-4f5d-9aaf-b6e9e47170a2",
                                "sense_id": "41c43887-9381-3ed5-bd2d-2a13f9fe987e",
                                "text": "In Nederland zijn het RIVM en de GGD's begin juli gestart met de voorbereiding van een nieuwe vaccinatiecampagne voor na de zomer. Dat heeft minister Ernst Kuipers (Volksgezondheid) aan de instanties gevraagd."
                            }
                        ]
                    },
                    {
                        "sense_id": "c740605b-f1e6-3914-854a-a1e2d9b4aeee",
                        "entry_id": "06f7a8e7-41a1-3842-ad57-e34ec95b9b66",
                        "glosses": [
                            "voorkomend geval (m.n. in de vaste combinatie in eerste ~)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e9783e8-88ff-4dba-9951-9d87a7e6d201",
                                "sense_id": "c740605b-f1e6-3914-854a-a1e2d9b4aeee",
                                "text": "In eerste instantie werd er daarvan geen gewag gemaakt."
                            },
                            {
                                "example_id": "967e99ca-da19-4ad7-abcd-08efa3b6b4e0",
                                "sense_id": "c740605b-f1e6-3914-854a-a1e2d9b4aeee",
                                "text": "Het idee dat de werkkampen voor commerciële doelstelling worden omgebouwd en in eerste instantie geen onderwijzende functie zullen hebben, zou kunnen leiden tot 'pseudo-historische fictie' en 'een valse voorstelling van wat er echt gebeurd is'."
                            },
                            {
                                "example_id": "4a6e32fc-4203-4587-b010-a1979b60ccf1",
                                "sense_id": "c740605b-f1e6-3914-854a-a1e2d9b4aeee",
                                "text": "De trail zal je uitdagen en misschien ook veranderen. Je zult zien dat je fysiek en mentaal tot veel meer in staat bent dan je in eerste instantie had gedacht."
                            },
                            {
                                "example_id": "74a75592-cf3b-4801-9cd8-18dd1e9b4582",
                                "sense_id": "c740605b-f1e6-3914-854a-a1e2d9b4aeee",
                                "text": "De campagne richt zich in eerste instantie vooral op ouders van jonge kinderen, forenzen en ouderen. Mensen van 55 jaar en ouder vormen immers bijna de helft (41 procent) van alle fietsslachtoffers op de spoed. Vaak zijn dit mensen op een e-bike, ziet Baden. \"Dat heeft te maken met verminderde spierkracht, een verminderd reactievermogen en juist een sneller bewegend voertuig.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "0282bd40-58e3-3785-a8d2-fab548bbcbcc",
                        "entry_id": "06f7a8e7-41a1-3842-ad57-e34ec95b9b66",
                        "glosses": [
                            "een object van een bepaalde klasse (elke van een reeks acties)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157b8768-f1fc-4a8f-843e-192b585760cf",
                                "sense_id": "0282bd40-58e3-3785-a8d2-fab548bbcbcc",
                                "text": "We kunnen van een klasse een instantie maken. Deze instantie kunnen we opslaan in een variabele om deze later weer te gebruiken."
                            }
                        ]
                    }
                ],
