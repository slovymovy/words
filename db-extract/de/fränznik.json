                ],
                "senses": [
                    {
                        "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                        "entry_id": "e961d49e-45b8-3ea4-82ce-046d05094e80",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f97c23-d004-47bf-805a-5735be7c62da",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Frau Fränznik ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "607a5619-7e9b-4816-bf85-1eb1e777dd50",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Herr Fränznik wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a0769b6e-2be9-4bd9-bb47-9f19ab5a6561",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Die Fränzniks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5aaa751f-a2c1-4616-9f98-28fe0e0c7194",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Der Fränznik trägt nie die Schals, die die Fränznik ihm strickt."
                            },
                            {
                                "example_id": "feb32ee3-9768-4deb-a8dc-ffda959531dc",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fränznik kommt, geht der Herr Fränznik.“"
                            },
                            {
                                "example_id": "9c8996c7-f8c9-402e-a946-72605cd6745e",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Fränznik kommt und geht."
                            },
                            {
                                "example_id": "d3806845-aa9b-4793-89e2-aca46896c185",
                                "sense_id": "dc4e9182-1d95-33c9-90d1-f113d51bd043",
                                "text": "Fränzniks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
