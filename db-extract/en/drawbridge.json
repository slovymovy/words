                                    {
                                        "sense_id": "857c1c4e-e765-320f-8180-0c8a7ba14f30",
                                        "entry_id": "148a0ab3-75aa-3e59-90eb-b862fa1daaf2",
                                        "glosses": [
                                            "een brug die opgehaald wordt en voorzien is van een contragewicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de266d8b-8fd0-4e7b-834c-293d49adb139",
                                                "sense_id": "857c1c4e-e765-320f-8180-0c8a7ba14f30",
                                                "text": "Wat blijft is de vraag of er eigenlijk wel sprake is van een brug. 'Folly', een nutteloos bouwwerk, is wellicht een betere term voor deze ophaalbrug, die in werkelijkheid helemaal geen ophaalbrug is, maar een veredeld lichtobject. Duizenden ledlampjes verlichten van binnenuit de twee staanders en hefbomen die je van afstand al ziet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eda256b9-66e3-45c1-b274-5467129e913d",
                        "source_entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                        "source_sense_description": "bridge which can be raised",
                        "target_lang_word": "valbrug",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valbrug",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "29bea330-2eed-31df-8991-bd02b30b718c",
                                        "entry_id": "4eabc4ad-7c26-3f8f-8175-78e901c1326c",
                                        "glosses": [
                                            "een beweegbare brug waarbij deze om de y-as roterend naar beneden gelaten wordt of wordt opgehaald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0055be7-c0d5-4e7a-85df-35e2d6f60988",
                                                "sense_id": "29bea330-2eed-31df-8991-bd02b30b718c",
                                                "text": "De valbrug van het kasteel was neergelaten toen de koning arriveerde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd02779c-5ce1-487a-9d6f-108d6c8bedda",
                        "source_entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                        "source_sense_description": "bridge which can be raised",
                        "target_lang_word": "pont-levis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pont-levis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e38c20a8-5ff1-32f0-98bc-487434357704",
                                        "entry_id": "ef9115a6-bf68-3a1a-b2f0-61164cd2cbbd",
                                        "glosses": [
                                            "Pont qui peut s’élever ou s’abaisser à volonté."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens, on dit plutôt pont levant ou pont à travée levante",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83f70431-5597-349c-b170-2c4fdbdf53e9",
                                        "entry_id": "ef9115a6-bf68-3a1a-b2f0-61164cd2cbbd",
                                        "glosses": [
                                            "Petit pont établi sur le fossé, sur les douves d’un château et qu’on levait pour interdire l’entrée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fbad1fd-44b0-4e2f-8ce8-451d5d8671b1",
                                                "sense_id": "83f70431-5597-349c-b170-2c4fdbdf53e9",
                                                "text": "Du côté de l’occident, il y avait une entrée à travers la palissade, laquelle communiquait dans les défenses intérieures par un pont-levis et avec une entrée semblable."
                                            },
                                            {
                                                "example_id": "48882b12-7421-4b34-bcf7-9dfe8d06e404",
                                                "sense_id": "83f70431-5597-349c-b170-2c4fdbdf53e9",
                                                "text": "Qu’avez-vous donc ? demanda Coconnas à La Mole, qui, arrêté à la vue du vieux château, regardait avec un saint respect ces ponts-levis, ces fenêtres étroites et ces clochetons aigus qui se présentaient tout à coup à ses yeux."
                                            },
                                            {
                                                "example_id": "cdf38c60-779a-4af0-bb42-61e8fc7fdc32",
                                                "sense_id": "83f70431-5597-349c-b170-2c4fdbdf53e9",
                                                "text": "Sur un signe du lieutenant, et à l’instant même où les derniers zouaves passaient sur le tablier du pont-levis, je m'élançai avec cinq ou six camarades complètement en dehors et me suspendis aux chaînes du pont qu'il s'agissait de relever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "018a1ee7-1047-4f19-ac8b-eba15fad787a",
                        "source_entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                        "source_sense_description": "bridge which can be raised",
                        "target_lang_word": "Zugbrücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zugbrücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87e38010-3104-33ff-bb94-86546aed2b71",
                                        "entry_id": "2d11df9d-d41c-3631-8c60-eb2c45c02c6d",
                                        "glosses": [
                                            "eine an Ketten vom Endpunkt her hochziehbare Brücke über Burg- und Festungsgräben"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef8b6c37-d2ef-4c4d-aee8-0361c1cbdb70",
                                                "sense_id": "87e38010-3104-33ff-bb94-86546aed2b71",
                                                "text": "Diese Zugbrücke ist viele Jahre nicht hochgezogen worden."
                                            },
                                            {
                                                "example_id": "6fd9b900-f268-4c9a-a927-b2bda43c44c4",
                                                "sense_id": "87e38010-3104-33ff-bb94-86546aed2b71",
                                                "text": "„Wir traten ein, und die Zugbrücke wurde sogleich hinter uns hochgezogen.“"
                                            },
                                            {
                                                "example_id": "7947fe4a-07bc-43e9-bdbd-159f2dba8bfe",
                                                "sense_id": "87e38010-3104-33ff-bb94-86546aed2b71",
                                                "text": "„Die Brücke mit ihren beiderseitigen Begrenzungsmauern war eine Zugbrücke, die nach dem 30jährigen Kriege in oben gezeigter Form erneuert wurde.“"
                                            },
                                            {
                                                "example_id": "1a70d13d-b8b1-4f59-a5e2-61d7b978091c",
                                                "sense_id": "87e38010-3104-33ff-bb94-86546aed2b71",
                                                "text": "„Madame d'Urfé, durch mich von der Stunde unserer Ankunft unterrichtet, hatte die Zugbrücken des Schlosses senken lassen und stand aufrecht am Tor inmitten aller ihrer Leute, wie ein General, der uns die Festung mit allen kriegerischen Ehren zu übergeben beabsichtigte.“"
                                            },
                                            {
                                                "example_id": "8385ce01-46c8-4d94-a251-1ad11ae19e15",
                                                "sense_id": "87e38010-3104-33ff-bb94-86546aed2b71",
                                                "text": "„Die Zugbrücke wurde heruntergelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfad826a-688d-4144-9eee-3978dc8b38b0",
