                "senses": [
                    {
                        "sense_id": "57ea6f3a-48f8-36df-a33c-6b0971c743df",
                        "entry_id": "d57a3821-f75f-327d-b06e-d5cbc057bdf8",
                        "glosses": [
                            "Laufspiel, bei dem eine Reihe von Läufern im Wettspiel gegen eine andere Läufergruppe streckenweise sich gegenseitig einen Staffelstab weiterreicht, um mit ihm als erste ins Ziel zu gelangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91c0c531-fb7e-477e-84af-4a208ff1f239",
                                "sense_id": "57ea6f3a-48f8-36df-a33c-6b0971c743df",
                                "text": "„Es ist notwendig, möglichst viele Situationen zu schaffen, die ein schnelles und energisches Handeln erfordern (z. B. Hindernisläufe, Staffelspiele, Wanderklettern, schwierige Abgänge von den Geräten usw.).“"
                            },
                            {
                                "example_id": "ae92aaae-e5b5-433b-8805-7c948fdded56",
                                "sense_id": "57ea6f3a-48f8-36df-a33c-6b0971c743df",
                                "text": "„Lisa, die Pädagogikstudentin im letzten Studienjahr, saß an Olivers Schreibtisch und bereitete für ihre Hortgruppe Staffelspiele vor.“"
                            },
                            {
                                "example_id": "bf4db826-b60c-4814-a0f8-bbd50a83d5ea",
                                "sense_id": "57ea6f3a-48f8-36df-a33c-6b0971c743df",
                                "text": "„Der Bewegungstrieb verlangt nach Bewegungs- und Sportspielen: er beflügelt körperbezogene Aktivitäten und Interaktionsformen wie Fangspiele, Hüpfspiele, Laufspiele, Staffelspiele oder Ballspiele.“"
                            },
                            {
                                "example_id": "71c08c46-1e57-4dd6-bc5b-2393198d96f2",
                                "sense_id": "57ea6f3a-48f8-36df-a33c-6b0971c743df",
                                "text": "„Bei Wettkämpfen und Staffelspielen wird zuweilen gemogelt.“"
                            },
                            {
                                "example_id": "fb1d862d-3611-4979-8429-dd48ab284ca0",
                                "sense_id": "57ea6f3a-48f8-36df-a33c-6b0971c743df",
                                "text": "„Zu guter Letzt haben die Kinder auf der Bühne Sport und machen Staffelspiele mit der Berliner Zeitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
