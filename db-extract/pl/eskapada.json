                    },
                    {
                        "translation_id": "3f91f9f9-c1aa-4b6b-b199-e26b9b364da2",
                        "source_entry_id": "c53f62ba-ae5d-3d60-b87f-a1c58e25abf2",
                        "source_sense_id": "cf554a9e-31b9-3d21-93d1-128349968553",
                        "target_lang_word": "Eskapade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eskapade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee9984b1-8951-3eaf-ae8e-568e3afa3e23",
                                        "entry_id": "338054e6-d94a-3c26-95aa-c8c396570f2a",
                                        "glosses": [
                                            "Seitensprung, abenteuerliche Handlung, eigenwilliges Tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f99bd52-f30f-4a9f-9e48-d8241dc155db",
                                                "sense_id": "ee9984b1-8951-3eaf-ae8e-568e3afa3e23",
                                                "text": "Die wiederholten Eskapaden der Eheleute führten schließlich trotz aller Toleranz doch zur Scheidung."
                                            },
                                            {
                                                "example_id": "e17fea7a-14ee-4f05-aec9-90b6b03de034",
                                                "sense_id": "ee9984b1-8951-3eaf-ae8e-568e3afa3e23",
                                                "text": "„Er verbrachte dazu einige Tage im kleinen Holzhaus des Schmiedes Gerrit Kist, musste jedoch wegen einiger Eskapaden die Stadt nach acht Tagen verlassen.“"
                                            },
                                            {
                                                "example_id": "db6ec022-45a9-4436-9f18-67eb07747373",
                                                "sense_id": "ee9984b1-8951-3eaf-ae8e-568e3afa3e23",
                                                "text": "„Er bringt den Leser nie in Versuchung, die Eskapade für eine Vergnügungsreise zu halten, auch nicht für eine juvenile Erlebnisreise.“"
                                            },
                                            {
                                                "example_id": "2fc3502f-7fd9-4884-a185-03c463d16eae",
                                                "sense_id": "ee9984b1-8951-3eaf-ae8e-568e3afa3e23",
                                                "text": "„Er berichtete den beiden Frauen dann in gekonnt kurzweiliger Manier von den Eskapaden ihres damaligen Chemieprofessors und ließ die alten Zeiten wortreich wieder aufleben.“"
                                            },
                                            {
                                                "example_id": "e8106ebb-8dbb-4b98-8c86-3f419e64f6bd",
                                                "sense_id": "ee9984b1-8951-3eaf-ae8e-568e3afa3e23",
                                                "text": "„Pastor P. ist die Maske bei seinen Eskapaden immer wieder verrutscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59ca1fc8-20cc-39b0-9e7a-690863922ec4",
                                        "entry_id": "338054e6-d94a-3c26-95aa-c8c396570f2a",
                                        "glosses": [
                                            "mutwilliger Streich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df62469e-9dcc-44bd-a9fb-16e85003ccdf",
                                                "sense_id": "59ca1fc8-20cc-39b0-9e7a-690863922ec4",
                                                "text": "Seine ständigen Eskapaden während des Unternehmens erzürnten alle sehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
