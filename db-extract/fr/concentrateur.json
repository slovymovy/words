                                            {
                                                "example_id": "2ab19286-92b8-4fc0-a55c-8cb5330e6f26",
                                                "sense_id": "a89ed032-5978-3ed1-9563-4a814c2f8fa6",
                                                "text": "Beide Paletten wurde mit einem Hub auf das Dach gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8a63dd6-54f5-336b-8c15-ecd610903dd5",
                                        "entry_id": "dc8cccb5-f3a2-3349-8daa-580ca8be2603",
                                        "glosses": [
                                            "Strecke, die beim Hub^([1]) überwunden wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba391e09-8f97-4c43-a81f-df779d9e09b7",
                                                "sense_id": "b8a63dd6-54f5-336b-8c15-ecd610903dd5",
                                                "text": "Bei Kolbenmaschinen wird der Weg, den der Kolben zwischen dem oberen und dem unteren Totpunkt zurücklegt, als Hub oder Kolbenhub bezeichnet."
                                            },
                                            {
                                                "example_id": "a7dbcb3b-7a80-4602-b127-dadcdbfccd27",
                                                "sense_id": "b8a63dd6-54f5-336b-8c15-ecd610903dd5",
                                                "text": "Da bei vielen Motoren die Zylinder waagrecht statt senkrecht angeordnet sind, hat sich eingebürgert, waagrechte Bewegungen zwischen definierten Punkten als Hub zu bezeichnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hub",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e2bd4e-1b18-3d64-ab84-be6eaf5252ea",
                                        "entry_id": "63845489-39d5-3351-8438-bd6e8a5945a6",
                                        "glosses": [
                                            "ein elektronisches Gerät zur Verbindung mehrerer Computer beziehungsweise Netz-Segmente sowohl über Ethernet als auch über USB"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203b388c-df2c-4a3c-bfa3-c04c1a40d526",
                                                "sense_id": "b0e2bd4e-1b18-3d64-ab84-be6eaf5252ea",
                                                "text": "Der Hub ist kaputt."
                                            },
                                            {
                                                "example_id": "a94dbcf9-a6de-46ec-a0dd-03e4654f7ea2",
                                                "sense_id": "b0e2bd4e-1b18-3d64-ab84-be6eaf5252ea",
                                                "text": "ISDN-Verteiler sind auch Hubs, werden aber selten so bezeichnet."
