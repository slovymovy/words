                "senses": [
                    {
                        "sense_id": "934b80fb-3493-39ee-8f7a-d573735ab7ab",
                        "entry_id": "6533ee82-639e-38c9-86bf-6b4f54b24ce6",
                        "glosses": [
                            "zeitlicher Abschnitt, in dem jemand ein bestimmtes Lebensalter hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82d67fd-a39c-4ec8-befb-32c607263617",
                                "sense_id": "934b80fb-3493-39ee-8f7a-d573735ab7ab",
                                "text": "„Jede Zeile steht für den Lebensverlauf des jeweiligen Geburtsjahrgangs über die Altersspanne von 40 bis 90 Jahren.“"
                            },
                            {
                                "example_id": "414e9bca-e29f-4352-a7e1-db51cf239fdd",
                                "sense_id": "934b80fb-3493-39ee-8f7a-d573735ab7ab",
                                "text": "„Außerdem ist bei Männern die Altersspanne, in der sie potenziell Kinder kriegen können, länger als bei Frauen.“"
                            },
                            {
                                "example_id": "89f63676-7280-46bc-b670-99c62c00ae8d",
                                "sense_id": "934b80fb-3493-39ee-8f7a-d573735ab7ab",
                                "text": "„Insgesamt soll die Altersspanne von Jugendlichen und jungen Erwachsenen von 14 bis 25 Jahren erfasst werden.“"
                            },
                            {
                                "example_id": "3a8c7d52-6193-4b75-8a81-33bc202b3943",
                                "sense_id": "934b80fb-3493-39ee-8f7a-d573735ab7ab",
                                "text": "„Ein noch deutlicherer Unterschied ist in der Altersspanne der Kinder zwischen dem ersten und sechsten Lebensjahr zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
