                    {
                        "translation_id": "7ca0d2c9-7d88-4f87-907d-7bcfe81590d1",
                        "source_entry_id": "5ad9f049-155a-365e-b29a-4781ea0b2ec8",
                        "source_sense_description": "предательница",
                        "target_lang_word": "Verräterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verräterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                        "entry_id": "ca8d4bf8-ade9-3bc8-98f8-ab4cccdcd9fb",
                                        "glosses": [
                                            "weibliche Person, die einen Verrat begangen hat bzw. immer noch begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e520dae-7294-4c33-bc65-029235a93e34",
                                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                                "text": "Die Verräterin wurde hingerichtet."
                                            },
                                            {
                                                "example_id": "2e082c8d-4456-4040-8454-1475ea15eab6",
                                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                                "text": "„Am schlimmsten aber sind die Migranten, die mir daraufhin vorwerfen, eine Verräterin zu sein.“"
                                            },
                                            {
                                                "example_id": "f201f50b-db65-4965-b2e6-751712337e17",
                                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                                "text": "„Wie eine Verräterin empfand ich Mariam, wie eine von den vielen, die ins Lager jener zurückgingen, die wir so vehement verspottet hatten.“"
                                            },
                                            {
                                                "example_id": "78f953e4-cbeb-4130-b232-e55bd014ef25",
                                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                                "text": "„Sie fühlte sich wie eine Verräterin und ihr wild schlagendes Herz echote in ihrem Ohr.“"
                                            },
                                            {
                                                "example_id": "96a4e947-dfde-4c91-bfd7-bf7a9120a25b",
                                                "sense_id": "140673a9-73dd-3aa0-9b0e-f8a08c0f64de",
                                                "text": "„Nichts, was ich mit ihr getan hatte, konnte sie doch mit ihm tun, ohne sich als Verräterin oder Hure vorzukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3cbe85-ab36-483c-b634-dbc661be6f62",
                        "source_entry_id": "5ad9f049-155a-365e-b29a-4781ea0b2ec8",
                        "source_sense_description": "предательница",
                        "target_lang_word": "traîtresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traîtresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "291cd3bd-78ba-3803-89ab-7557a58b060f",
                                        "entry_id": "bd32c07a-6307-3755-ba69-d42081143614",
                                        "glosses": [
                                            "Féminin singulier de traître."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b23b0b8-3ae2-4ddd-97b2-8fd29f2bfd84",
                                                "sense_id": "291cd3bd-78ba-3803-89ab-7557a58b060f",
                                                "text": "Ahmed Abdou s’effrayait aussitôt, et craignait que la graine dure et traîtresse, cachée sous les fibres, ne blessât la fillette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traîtresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9f3bc3-1996-36a2-92ef-f2d725277d7c",
                                        "entry_id": "1b200713-79a4-3496-b139-535592295bfe",
                                        "glosses": [
                                            "Femme qui trahit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f699bbbe-e742-430e-8ea7-330c0690317e",
                                                "sense_id": "3c9f3bc3-1996-36a2-92ef-f2d725277d7c",
                                                "text": "» Jeanne, l’Église te déclare traîtresse, menteuse, cruelle, désireuse de l’effusion du sang humain, séditieuse, provocatrice de la tyrannie, blasphématrice de Dieu dans ses commandements et révélations ! »"
                                            },
                                            {
                                                "example_id": "6622a23e-2a7e-4870-8273-7459755094bd",
                                                "sense_id": "3c9f3bc3-1996-36a2-92ef-f2d725277d7c",
                                                "text": "Ainsi dans les Thesmophories, Mica se plaint du mal qu'Euripide fait aux femmes en les traitant de « cocufieuses, de coureuses, de pochardes, de traîtresses , de commères […], de grandes plaies des hommes »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
