                                                "sense_id": "ef090b3a-3fef-3519-a58c-01a836a2127e",
                                                "text": "The accident caused a mile-long backup on the highway."
                                            },
                                            {
                                                "example_id": "7b8dd99d-71e1-4aef-b4ff-fc256fb5cec7",
                                                "sense_id": "ef090b3a-3fef-3519-a58c-01a836a2127e",
                                                "text": "The blockage caused a backup in the plumbing."
                                            }
                                        ]
                                    },
                                    {
