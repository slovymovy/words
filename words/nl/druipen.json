    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b893dd0-5a85-3586-b950-d0c41515aec4",
                    "sense_definition": "het in druppels naar beneden vallen van een vloeistof",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vloeistofbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water bleef uit de kapotte kraan <w>druipen</w> de hele nacht.",
                            "target_lang_translations": {
                                "en": "The water kept <w>dripping</w> from the broken tap all night."
                            }
                        },
                        {
                            "text": "Deze hars is miljoenen jaren geleden uit de bomen <w>gedropen</w> en daarna versteend tot barnsteen.",
                            "target_lang_translations": {
                                "en": "This resin <w>dripped</w> from the trees millions of years ago and then fossilized into amber."
                            }
                        }
                    ],
                    "synonyms": [
                        "druppelen",
                        "lekken"
                    ],
                    "common_phrases": [
                        "uit de kraan druipen",
                        "langzaam naar beneden druipen"
                    ],
                    "target_lang_definitions": {
                        "en": "the falling of a liquid in drops"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drip",
                                "target_lang_sense_clarification": "to fall in drops"
                            },
                            {
                                "target_lang_word": "trickle",
                                "target_lang_sense_clarification": "to flow in a small stream"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "814e1a5d-d27d-3038-81a0-7f9f948843f1",
                    "sense_definition": "het afgeven of produceren van druppels vloeistof, vaak door nattigheid of zweet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistofbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de harde regen stond hij in de gang te <w>druipen</w> van de regen.",
                            "target_lang_translations": {
                                "en": "After the heavy rain, he stood in the hallway <w>dripping</w> with rain."
                            }
                        },
                        {
                            "text": "Ik geloof dat ik nog nooit zo hard <w>gedropen</w> heb van het zweet.",
                            "target_lang_translations": {
                                "en": "I don't think I've ever <w>dripped</w> with sweat so much."
                            }
                        }
                    ],
                    "synonyms": [
                        "lekken"
                    ],
                    "common_phrases": [
                        "druipen van de regen",
                        "druipen van het zweet"
                    ],
                    "target_lang_definitions": {
                        "en": "to give off or produce drops of liquid, often due to wetness or sweat"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drip",
                                "target_lang_sense_clarification": "to be so wet that drops fall"
                            },
                            {
                                "target_lang_word": "be soaking",
                                "target_lang_sense_clarification": "to be extremely wet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5ca3355-eee4-3164-9ac5-d05aaa2a98cb",
                    "sense_definition": "het aanbrengen van verf op een doek door het er in druppels op te laten vallen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kunsttechniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar besloot de verf op het doek te <w>druipen</w> voor een abstract effect.",
                            "target_lang_translations": {
                                "en": "The artist decided to <w>drip</w> the paint onto the canvas for an abstract effect."
                            }
                        },
                        {
                            "text": "Uiterst beheerst wordt de verf over het doek <w>gedropen</w>.",
                            "target_lang_translations": {
                                "en": "The paint is <w>dripped</w> over the canvas with extreme control."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verf op het doek druipen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de schilderkunst"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "applying paint to a canvas by letting it fall onto it in drops"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drip",
                                "target_lang_sense_clarification": "to let paint fall in drops"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}