                ],
                "senses": [
                    {
                        "sense_id": "f1f90a1b-185c-3df0-85e0-30f344bcddc3",
                        "entry_id": "9c043424-4c48-3469-a1b9-5de96968425e",
                        "glosses": [
                            "Lebewesen, das aus Zellen mit einem echten, durch eine Kernmembran vom Cytosol abgegrenzten Zellkern besteht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93f00712-f737-340a-966e-b508610df5e5",
                        "entry_id": "9c043424-4c48-3469-a1b9-5de96968425e",
                        "glosses": [
                            "diejenige Domäne, die alle Lebewesen umfasst, die aus Zellen mit einem echten Zellkern aufgebaut sind"
                        ],
                        "tags": [
                            "Biologische Taxonomie",
                            "im Plural (Eukaryoten",
                            "Eukaryota)"
                        ],
                        "examples": [
                            {
                                "example_id": "ffde7047-f55f-4043-bbb6-d4976e772727",
                                "sense_id": "93f00712-f737-340a-966e-b508610df5e5",
                                "text": "„Dabei werden die Ur-Bakterien (Archaebacteria), Bakterien, Blaualgen und Ur-Grünalgen (Prochlorophyta), welche (noch) keinen echten Zellkern besitzen, gewöhnlich als Prokaryota den übrigen, als Eukaryota bezeichneteten Gruppen vorangestellt.“"
                            },
                            {
                                "example_id": "80318ebe-1d76-444e-9099-a340ca519c52",
                                "sense_id": "93f00712-f737-340a-966e-b508610df5e5",
                                "text": "Die aktuelle biologische Taxonomie unterteilt alle Lebewesen in die drei Domänen der Eukaryoten, der Archaeen und der Bakterien."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d04374e-bb7d-4715-81ba-8e9c2b0555aa",
                        "source_entry_id": "9c043424-4c48-3469-a1b9-5de96968425e",
                        "source_sense_id": "f1f90a1b-185c-3df0-85e0-30f344bcddc3",
                        "target_lang_word": "eukaryote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eukaryote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9c5e176-494d-3146-b673-275460bdbf7f",
                                        "entry_id": "4d359f1b-4846-33ba-86e8-4acdc204ffa1",
                                        "glosses": [
                                            "Any of the single-celled or multicellular organisms of the taxonomic domain Eukaryota, whose cells contain at least one distinct nucleus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ac3683-42b0-4f14-b7a2-443b43301ce7",
                                                "sense_id": "c9c5e176-494d-3146-b673-275460bdbf7f",
                                                "text": "It is now clear that among organisms there are two different organizational patterns of cells, which Chatton (1937) called, with singuar prescience, the eucaryotic and procaryotic type."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7dccd35-ed6e-4ac3-82e2-cb4eb910a710",
                        "source_entry_id": "9c043424-4c48-3469-a1b9-5de96968425e",
                        "source_sense_id": "f1f90a1b-185c-3df0-85e0-30f344bcddc3",
                        "target_lang_word": "eucaryote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eucaryote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7c6ca8-287a-34d9-b5af-67d338dd3112",
                                        "entry_id": "476408e5-27f9-3ed6-b2e2-2fa955e36a35",
                                        "glosses": [
                                            "Se dit d’une cellule dont les chromosomes sont inclus dans un noyau séparé du cytoplasme par une membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b7a6cd-5618-4863-b0f4-831c56700907",
                                                "sense_id": "7a7c6ca8-287a-34d9-b5af-67d338dd3112",
                                                "text": "Les protistes eucaryotes."
                                            },
                                            {
                                                "example_id": "6efdac5b-81db-4b13-9544-a3ca6026b9b7",
                                                "sense_id": "7a7c6ca8-287a-34d9-b5af-67d338dd3112",
                                                "text": "Les gènes eucaryotes sont exprimés différemment de ceux des bactéries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eucaryote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                        "entry_id": "b7cec5cd-8280-3390-a8ef-7304e6831e65",
                                        "glosses": [
                                            "Organisme vivant caractérisé par le fait que la majorité du matériel génétique cellulaire est contenu dans un noyau constitué par une enveloppe nucléaire (un « vrai noyau »), par opposition aux procaryotes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd92961-6897-4b62-a561-ad4894abbf29",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Champignons et levures sont aussi des organismes pluricellulaires eucaryotes."
                                            },
                                            {
                                                "example_id": "e3e616b8-5a52-414f-823b-3062bed82b30",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Les eucaryotes apparaissent il y a 1 à 1,5 milliards d'années, pour bientôt se diviser en deux règnes : végétal et animal."
                                            },
                                            {
                                                "example_id": "f7351a27-306b-40a9-b5ea-67f4c72fd6e6",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Les algues vertes, donc, font partie, de par leur système de reproduction, du groupe des eucaryotes. Leurs organes reproducteurs sont formés de sporocystes et/ou de gamétocystes."
                                            },
                                            {
                                                "example_id": "fe0ed20f-bc09-4323-b20d-2f69cf66764f",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Sans compter que le modèle proposé par Patrick Forterre ne prétend pas que l’ancêtre tant recherché était exactement un eucaryote (ceux-ci ont évolués depuis), mais seulement qu’il avait un génome semblable."
                                            }
                                        ]
                                    }
                                ]
                            }
