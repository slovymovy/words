                ],
                "senses": [
                    {
                        "sense_id": "a76b78ed-c39f-3279-94a7-28339f4781e5",
                        "entry_id": "8f82690d-b0ea-3f9c-be9d-8eaaebf640d2",
                        "glosses": [
                            "E-Mail"
                        ],
                        "tags": [
                            "Kurzform für"
                        ],
                        "examples": [
                            {
                                "example_id": "a95bb16a-656f-41ad-98c2-3d967b39a1c8",
                                "sense_id": "a76b78ed-c39f-3279-94a7-28339f4781e5",
                                "text": "„Ermittler stießen auf dieses Datum, nachdem auch ihnen die Mails in Kopie anonym zugeschickt worden waren.“"
                            },
                            {
                                "example_id": "b545e57a-71ed-4d6e-a8ec-507ee324d211",
                                "sense_id": "a76b78ed-c39f-3279-94a7-28339f4781e5",
                                "text": "„Die Mail endet mit dem Angebot, eine merkwürdige Geschichte über die Liaison von Informant und Redaktion könne exklusiv erworben werden.“"
                            },
                            {
                                "example_id": "7c1603e0-bbc7-4b2d-85dd-f1bb8f05babd",
                                "sense_id": "a76b78ed-c39f-3279-94a7-28339f4781e5",
                                "text": "„Aus Wien erreichten mich Mails der Mutter meiner Töchter.“"
                            },
                            {
                                "example_id": "611a1ad5-0a3d-4aab-9f75-3ccdca866fb0",
                                "sense_id": "a76b78ed-c39f-3279-94a7-28339f4781e5",
                                "text": "„Sie lächelte beim Gedanken daran und las noch einmal die Mail auf ihrem Handy, wie um sich noch einmal zu versichern.“"
                            }
