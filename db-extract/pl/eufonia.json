                ],
                "senses": [
                    {
                        "sense_id": "ae4b54da-4eb9-36e5-86ed-aeacd484ba05",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "wyraz, fraza lub zdanie mające strukturę fonetyczną skutkującą w harmonijnym i przez to przyjemnym akustycznie jego brzmieniu, też: to przyjemne brzmienie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb746ec-9843-4b7c-96ea-065ba10dc451",
                                "sense_id": "ae4b54da-4eb9-36e5-86ed-aeacd484ba05",
                                "text": "Bo to piękno układa się także z brzmienia słów, z eufonii, z nich „bierze się mówienie”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e7458f38-72e0-3dd6-a0cc-1899171a8745",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "celowe rymowanie wyrazów występujących w tej samej wypowiedzi, zazwyczaj dla efektu komicznego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f17c5fc1-f4c6-31b7-ae8c-bfc90a29190f",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "unikanie i często za tym idąca redukcja trudnych w wymowie zbitek głoskowych, np. magistrowie > magistrzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8725f4-1c35-420d-8b3b-ad6e50d440df",
                                "sense_id": "f17c5fc1-f4c6-31b7-ae8c-bfc90a29190f",
                                "text": "Pojęcie eufonii odnosi się przede wszystkim do języka mówionego, jednak w pewnym ograniczonym stopniu dotyczy również tekstów pisanych"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "da4c2d60-78d5-3209-8652-fc0160910242",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "intencjonalne dobranie wyrazów w utworze tak, by tworzyły eufonię (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551344a7-a8b7-4783-9955-b1e940e438a4",
                                "sense_id": "da4c2d60-78d5-3209-8652-fc0160910242",
                                "text": "Eufonia to ta warstwa poetyki wiersza, która wydaje się niezbyt doceniana nawet przez profesjonalnych czytelników"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "ce94b511-9473-3b5d-835c-1a50f05c594f",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "dział poetyki zajmujący się eufonią (1.4)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "090f7496-d85a-35a0-b52a-e3de39f68cfe",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "zgodność i współbrzmienie tonów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "2c145d91-cb2b-3bc7-bfc2-c63ca5982dba",
                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                        "glosses": [
                            "w logopedii: czysta postać głosu ludzkiego"
                        ],
