                "senses": [
                    {
                        "sense_id": "6c05f69c-db8d-3f4c-97d3-43841e6db897",
                        "entry_id": "0668f34d-fec6-361a-9df9-696ae98dd381",
                        "glosses": [
                            "Halbinsel im hohen Norden Norwegens, auf der sich der nördlichste Punkt des europäischen Festlandes, Kinnarodden, befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d64fbd7-cd10-44b2-b763-856e97d3f5da",
                                "sense_id": "6c05f69c-db8d-3f4c-97d3-43841e6db897",
                                "text": "„Möchte man den nördlichsten Punkt in Europa ansteuern und dabei weder Tunnel (vielleicht deswegen der Nordkaptunnel, um es gegen alle Neider mit den Festland zu verbinden 😉 noch Fähre benutzen, dann müsste man nach Kinnarodden auf die Nordkinnhalbinsel fahren.“"
                            },
                            {
                                "example_id": "993819c2-76b4-454d-8485-aad7ccb7befc",
                                "sense_id": "6c05f69c-db8d-3f4c-97d3-43841e6db897",
                                "text": "„Der wirklich nördlichste Punkt des europäischen Festlandes liegt östlich des Nordkaps, auf der Nordkinnhalbinsel.“"
                            },
                            {
                                "example_id": "d2068949-1aa5-4137-8a4c-cc0ba3b81aec",
                                "sense_id": "6c05f69c-db8d-3f4c-97d3-43841e6db897",
                                "text": "„Erst im August 1989 wurde die Nordkinnhalbinsel überhaupt an das norwegische Straßennetz angeschlossen.“"
                            },
                            {
                                "example_id": "0e1b0e0e-2151-46fd-95af-8b0d81848d6b",
                                "sense_id": "6c05f69c-db8d-3f4c-97d3-43841e6db897",
                                "text": "„Am 18. Oktober 1944 entging das Schiff bei der Nordkinnhalbinsel einem Torpedoangriff des sowjetischen U-Boots V-4 \"Soviet Svanetia\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
