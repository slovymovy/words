                                                "example_id": "53a0eb6e-ebcf-4643-b104-eb0af3b9de33",
                                                "sense_id": "2f83b14b-416c-3494-b19f-59f804c94686",
                                                "text": "The children were soon lost in the forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233bda9f-fb86-34a4-9b7d-4a1e758ab622",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "In an unknown location; unable to be found."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9491cf-69b8-4b76-856d-765785a0dd62",
                                                "sense_id": "233bda9f-fb86-34a4-9b7d-4a1e758ab622",
                                                "text": "Deep beneath the ocean, the Titanic was lost to the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27480bd-3ca1-3026-b612-8ea5ce30f4a2",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Not perceptible to the senses; no longer visible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590e0e3e-3e68-43b3-b457-cf2f5282b205",
                                                "sense_id": "f27480bd-3ca1-3026-b612-8ea5ce30f4a2",
                                                "text": "an island lost in a fog; a person lost in a crowd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "001f70f0-b8d5-307b-bc94-e7783e02b1a9",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Parted with; no longer held or possessed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2166e05-2e15-4b84-8a58-58e27da51b4c",
                                                "sense_id": "001f70f0-b8d5-307b-bc94-e7783e02b1a9",
                                                "text": "a lost limb; lost honour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64434578-3dc2-3f9e-aa7b-5670853b7a4d",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Not employed or enjoyed; thrown away; employed ineffectually; wasted; squandered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8f3b89-a4c5-4620-b2b4-90bb1004e8e2",
                                                "sense_id": "64434578-3dc2-3f9e-aa7b-5670853b7a4d",
                                                "text": "a lost day; a lost opportunity or benefit; no time should be lost"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f1e548b-c0a6-3b34-b6b3-9259ed7cbcc4",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Ruined or destroyed, either physically or morally; past help or hope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290432a2-cd0a-4148-b989-f06f6edd1185",
                                                "sense_id": "4f1e548b-c0a6-3b34-b6b3-9259ed7cbcc4",
                                                "text": "a ship lost at sea; a woman lost to virtue; a lost soul"
                                            },
                                            {
                                                "example_id": "8218e261-a37d-40cc-b2f5-abb5a91610b0",
                                                "sense_id": "4f1e548b-c0a6-3b34-b6b3-9259ed7cbcc4",
                                                "text": "They struck me also as being of surpassing interest as representing, probably with studious accuracy, the last rites of the dead as practised among an utterly lost people, and even then I thought how envious some antiquarian friends of my own at Cambridge would be if ever I found an opportunity of describing these wonderful remains to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ab0248-ab12-312f-ac8a-7af038b49761",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Hardened beyond sensibility or recovery; alienated; insensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2903c2-a9c9-4c21-b84b-0bb0d2c3f686",
                                                "sense_id": "70ab0248-ab12-312f-ac8a-7af038b49761",
                                                "text": "lost to shame; lost to all sense of honour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a744d26-c883-356b-ac38-3cf97af039ca",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Occupied with, or under the influence of, something, so as not to notice external things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77cae537-a58b-40fd-85be-ceff71f7dd62",
                                                "sense_id": "2a744d26-c883-356b-ac38-3cf97af039ca",
                                                "text": "to be lost in thought"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
