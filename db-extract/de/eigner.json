                "senses": [
                    {
                        "sense_id": "9763b01c-ab28-30ab-b06e-61089496dfea",
                        "entry_id": "6d04bb81-9fab-3c1e-a896-c5b2c39206bc",
                        "glosses": [
                            "Person, die Eigentümer von etwas ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4565006d-05d2-4caa-87b9-c496878fe72e",
                                "sense_id": "9763b01c-ab28-30ab-b06e-61089496dfea",
                                "text": "Manfred ist Eigner eines großen Konzerns."
                            },
                            {
                                "example_id": "ea2dcfca-e1b5-45fc-b179-f005712348f9",
                                "sense_id": "9763b01c-ab28-30ab-b06e-61089496dfea",
                                "text": "„Die Eigner des Restaurants setzen sich zu uns, Michelle zuerst, sie kommt mit einem netten Lächeln herüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6295773-6ce1-3fb0-ade2-a985fa51d8c7",
                        "entry_id": "6d04bb81-9fab-3c1e-a896-c5b2c39206bc",
                        "glosses": [
                            "Person, die ein Schiff – oder mehrere – besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b544a3c3-01e6-403a-8dfa-77504acfd57d",
                                "sense_id": "b6295773-6ce1-3fb0-ade2-a985fa51d8c7",
                                "text": "„Die Eigner des Schiffes betrachteten die Todesfälle und die Tatsache, dass das Leben so vieler Menschen zerstört wurde, als normale Begleiterscheinung eines zugegebenermaßen schmutzigen Geschäfts.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
