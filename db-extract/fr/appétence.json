        "fr-extract.jsonl": [
            {
                "entry_id": "7a0df2b6-c47b-3234-8e32-0c9f12196390",
                "word": "appétence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f8424df-306b-46b9-b11c-964f3ac87817",
                        "entry_id": "7a0df2b6-c47b-3234-8e32-0c9f12196390",
                        "tags": [
                            "plural"
                        ],
                        "form": "appétences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94882f8c-1466-3fcf-92c3-ce34c51b1161",
                        "entry_id": "7a0df2b6-c47b-3234-8e32-0c9f12196390",
                        "glosses": [
                            "Tendance de tout être vers ce qui peut satisfaire ses instincts et ses besoins, surtout physiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74bb7b38-ffec-49d1-b54a-805d215d1b59",
                                "sense_id": "94882f8c-1466-3fcf-92c3-ce34c51b1161",
                                "text": "Un taux d’humidité élevé entraîne une trop grande production d’acide butyrique, ce qui risque de réduire l’appétence du fourrage, d’accroître les pertes et de provoquer une cétose subclinique chez les vaches laitières."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1c59c64-10fd-30ac-8f9d-0343022fb151",
                        "entry_id": "7a0df2b6-c47b-3234-8e32-0c9f12196390",
                        "glosses": [
                            "Attirance pour ce qui peut satisfaire un besoin ou une envie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "af601b55-bf3a-444c-adbe-83be4a29f3ae",
                                "sense_id": "e1c59c64-10fd-30ac-8f9d-0343022fb151",
                                "text": "… une femme bien plus jeune que lui, aux appétences bien au-delà de ses moyens."
                            },
                            {
                                "example_id": "243cee80-61b4-40f9-a0bc-f281cef425cb",
                                "sense_id": "e1c59c64-10fd-30ac-8f9d-0343022fb151",
                                "text": "Il sentait couler dans ses veines toute la sanie des rêves impuissants, des appétences infécondes, et sur son échine s'appesantissait le fardeau de la résignation et de la timidité."
                            },
                            {
                                "example_id": "72c337a4-8b98-446d-be48-2c2d6226bcf6",
                                "sense_id": "e1c59c64-10fd-30ac-8f9d-0343022fb151",
                                "text": "Ce faisant, plane la menace du psychologisme : les moins combatifs feraient preuve d’une moindre « appétence » pour la formation, se laisseraient porter par le fil de l’eau et récolteraient au final les fruits amers de leur désinvestissement.Aussi est-il nécessaire de bien cerner l’origine du « manque d’appétit » apparent de nombreux salariés pour la formation afin de dissiper tout malentendu."
                            },
                            {
                                "example_id": "364a33af-9324-4ae1-bdda-f5a7c3e515aa",
                                "sense_id": "e1c59c64-10fd-30ac-8f9d-0343022fb151",
                                "text": "Ayant passé d’une débauche presque infantile à la continence absolue datant du jour où il avait pensé au quai d’Orsay et voulu faire une grande carrière, il avait l’air d’une bête en cage, jetant dans tous les sens des regards qui exprimaient la peur, l’appétence et la stupidité."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e12197d-b1bc-3432-bc6e-aa7422d7f9ea",
                        "entry_id": "7a0df2b6-c47b-3234-8e32-0c9f12196390",
                        "glosses": [
                            "Désir d’usage ou d’achat ressenti par l’individu pour un produit ou une marque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ddad71-01ac-4d4e-90b6-5ebeb9980689",
                                "sense_id": "9e12197d-b1bc-3432-bc6e-aa7422d7f9ea",
                                "text": "Comment la connaissance client est-elle réellement exploitée par les forces de ventes du CCF dans leur action quotidienne? La création de scores d’attrition et de scores d’appétence client, associée aux alertes d’opportunités commerciales permet aujourd’hui de mieux cibler les contacts et d’optimiser l’efficacité des chargés de clientèle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfeab8a2-625a-401f-a5fc-e6a4a3c933a3",
                        "source_entry_id": "7a0df2b6-c47b-3234-8e32-0c9f12196390",
                        "target_lang_word": "appetite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appetite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                        "entry_id": "73d75e24-78e7-3c66-aaaf-0fa215845d58",
                                        "glosses": [
                                            "Desire to eat food or consume drink."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713dae7c-6ca6-4c37-9939-7b685d1de061",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite. There is something humiliating about it."
                                            },
                                            {
                                                "example_id": "53dc3eed-4fa1-40ca-a947-fce372f04cd0",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "And I return with an excellent appetite. There can be no question, my dear Watson, of the value of exercise before breakfast."
                                            },
                                            {
                                                "example_id": "6aaee191-cee1-4d07-9daf-6a51bceb3ede",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "Though the breweries were forced to shut down, the dry spell did little more than whet the public's appetite for beer: Records show that within the first 24 hours after Congress lifted the ban Prohibition] in 1933, Americans guzzled 1 million barrels of the stuff."
                                            },
                                            {
                                                "example_id": "b0b49a88-cf7b-4c81-a9dc-8261e076e043",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "Biotics possess extraordinary abilities, but they must live with minor inconveniences. The most obvious issue is getting adequate nutrition. Creating biotic mass effects takes such a toll on metabolism that active biotics develop ravenous appetites. The standard Alliance combat ration for a soldier is 3000 calories per day; biotics are given 4500, as well as a canteen of potent energy drink for quick refreshment after hard combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24217a58-2a8c-37d8-bb4f-c4dc4d5e80ad",
                                        "entry_id": "73d75e24-78e7-3c66-aaaf-0fa215845d58",
                                        "glosses": [
                                            "Any strong desire; an eagerness or longing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "743721bb-3c02-4c18-91aa-c53af1104956",
                                                "sense_id": "24217a58-2a8c-37d8-bb4f-c4dc4d5e80ad",
                                                "text": "If God had given to eagles an appetite to swim."
                                            },
                                            {
                                                "example_id": "faec1c13-99b8-443a-b590-06f16054473f",
                                                "sense_id": "24217a58-2a8c-37d8-bb4f-c4dc4d5e80ad",
                                                "text": "To gratify the vulgar appetite for the marvellous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c34691-b493-3e1b-bb0a-c14e67ed6e6d",
                                        "entry_id": "73d75e24-78e7-3c66-aaaf-0fa215845d58",
                                        "glosses": [
                                            "The desire for some personal gratification, either of the body or of the mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269f6782-9895-4b57-a11c-e47a8f4c24f6",
                                                "sense_id": "e9c34691-b493-3e1b-bb0a-c14e67ed6e6d",
                                                "text": "appetite for reading"
                                            },
                                            {
                                                "example_id": "f66513a5-697e-489f-a008-e25bbd0f5ea6",
                                                "sense_id": "e9c34691-b493-3e1b-bb0a-c14e67ed6e6d",
                                                "text": "The object of appetite is whatsoever sensible good may be wished for; the object of will is that good which reason does lead us to seek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
