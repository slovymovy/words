                "senses": [
                    {
                        "sense_id": "162ee8b2-8830-3d94-a883-7e3d369ff6cb",
                        "entry_id": "ec22a018-2014-3bdc-a750-ffe3ab548d73",
                        "glosses": [
                            "Holzbildhauer, Holzbildschnitzer, dessen Arbeiten religiöse Motive zeigen"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "9695515b-db47-4666-bcbe-c5da8ae0ed61",
                                "sense_id": "162ee8b2-8830-3d94-a883-7e3d369ff6cb",
                                "text": "In Oberammergau gibt es viele Herrgottsschnitzer."
                            },
                            {
                                "example_id": "f4da9a07-383e-4375-9657-6c3fdba42d77",
                                "sense_id": "162ee8b2-8830-3d94-a883-7e3d369ff6cb",
                                "text": "„»Er ist doch ein Ammergauer«, warf er auf den Ausruf des Malers ein, »und in Ammergau kommen die Buben schon als Herrgottsschnitzer auf d’ Welt.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3396fb8e-26cb-463b-83c4-817775da6a9f",
                        "source_entry_id": "ec22a018-2014-3bdc-a750-ffe3ab548d73",
                        "source_sense_id": "162ee8b2-8830-3d94-a883-7e3d369ff6cb",
                        "source_sense_description": "süddeutsch, österreichisch: Holzbildhauer, Holzbildschnitzer, dessen Arbeiten religiöse Motive zeigen",
                        "target_lang_word": "carver of crucifixes",
                        "target_lang_code": "en",
