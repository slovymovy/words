                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9de834-2915-4a27-89a3-13a3627fde7f",
                                "sense_id": "c5bf9e54-8b0d-383f-a789-f8ceb574abaa",
                                "text": "„Kaugummikauen ist gesellschaftsfähig geworden – und damit zum Problem für Stadtreinigungen allerorten.“"
                            },
                            {
                                "example_id": "b0481fdb-4680-41dc-b97e-d134e750b7a9",
                                "sense_id": "c5bf9e54-8b0d-383f-a789-f8ceb574abaa",
                                "text": "„Kaugummikauen für gesunde, weiße Zähne und einen frischen Atem – dieser Gedanke ist fast so alt wie der Kaugummi selbst.“"
                            },
                            {
                                "example_id": "a473eaf1-b1e6-4afa-a7f1-859f6d30a024",
                                "sense_id": "c5bf9e54-8b0d-383f-a789-f8ceb574abaa",
                                "text": "„Studien haben keinen nennenswerten Einfluss des Kaugummikauens auf die Entfernung von Plaque oder Speiseresten nachweisen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
