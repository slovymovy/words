                        "translation_id": "7f51b7bf-c3fe-49cc-8fd5-c1ade2a6de62",
                        "source_entry_id": "c68ee61c-e928-3a06-bc7f-fad18b5c1662",
                        "source_sense_id": "f5b4cc2f-c974-37e4-a4a3-9c4f7c213661",
