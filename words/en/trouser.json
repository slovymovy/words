{
    "word_family": [
        "trousers",
        "trousered",
        "trouserless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0917cbbe-b6e0-3ba1-8f75-07bb2161ba49",
                    "sense_definition": "A single pair of trousers, especially in commercial, fashion, or tailoring contexts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman recommended a lightweight linen <w>trouser</w> for the hot summer months.",
                            "target_lang_translations": {
                                "nl": "De verkoper raadde een lichte linnen <w>broek</w> aan voor de warme zomermaanden."
                            }
                        },
                        {
                            "text": "This elegant pleated <w>trouser</w> pairs nicely with a tailored blazer.",
                            "target_lang_translations": {
                                "nl": "Deze elegante <w>pantalon</w> met bandplooi past mooi bij een getailleerde blazer."
                            }
                        }
                    ],
                    "synonyms": [
                        "pants"
                    ],
                    "common_phrases": [
                        "linen trouser",
                        "wool trouser"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een enkele broek, vooral gebruikt in de mode- of kleermakerswereld."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "broek",
                                "target_lang_sense_clarification": "kledingstuk"
                            },
                            {
                                "target_lang_word": "pantalon",
                                "target_lang_sense_clarification": "nette broek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c76221bb-94e7-3d77-ba01-c0fba8cf87a4",
                    "sense_definition": "Used attributively to modify another noun, indicating an association with trousers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tore his <w>trouser</w> leg while climbing over the old wooden fence.",
                            "target_lang_translations": {
                                "nl": "Hij scheurde zijn <w>broekspijp</w> toen hij over het oude houten hek klom."
                            }
                        },
                        {
                            "text": "She kept a spare key inside her right <w>trouser</w> pocket.",
                            "target_lang_translations": {
                                "nl": "Ze bewaarde een reservesleutel in haar rechter <w>broekzak</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trouser leg",
                        "trouser pocket",
                        "trouser press",
                        "trouser suit"
                    ],
                    "target_lang_definitions": {
                        "nl": "Als bijvoeglijke bepaling gebruikt ter aanduiding van een relatie met een broek."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "broek-",
                                "target_lang_sense_clarification": "als voorvoegsel in samenstellingen zoals broekspijp of broekzak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f9b9cd5-8854-30a8-bd52-d68855befd80",
                    "sense_definition": "To receive, pocket, or keep an amount of money, especially a large sum or one viewed critically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "take_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The executive managed to <w>trouser</w> a massive bonus despite falling company profits.",
                            "target_lang_translations": {
                                "nl": "De directeur wist ondanks dalende bedrijfswinsten een enorme bonus <w>op te strijken</w>."
                            }
                        },
                        {
                            "text": "Several consultants <w>trousered</w> hefty fees for doing very little real work.",
                            "target_lang_translations": {
                                "nl": "Verscheidene consultants <w>streken</w> flinke vergoedingen <w>op</w> voor het doen van heel weinig echt werk."
                            }
                        }
                    ],
                    "synonyms": [
                        "pocket"
                    ],
                    "common_phrases": [
                        "trouser a bonus",
                        "trouser the cash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally, particularly in British English"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een (vaak aanzienlijk of twijfelachtig) bedrag aan geld opstrijken of incasseren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opstrijken",
                                "target_lang_sense_clarification": "geld ontvangen of binnenhalen"
                            },
                            {
                                "target_lang_word": "zakken",
                                "target_lang_sense_clarification": "in de zak steken"
                            },
                            {
                                "target_lang_word": "binnenrijven",
                                "target_lang_sense_clarification": "veel geld binnenhalen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91abce48-b39d-37cb-a646-281d4eab9d36",
                    "sense_definition": "To covertly take or steal an item or funds for oneself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "take_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest clerk secretly <w>trousered</w> the missing cash from the till.",
                            "target_lang_translations": {
                                "nl": "De oneerlijke bediende <w>drukte</w> het ontbrekende geld uit de kassa stiekem <w>achterover</w>."
                            }
                        },
                        {
                            "text": "He found an expensive watch in the changing room and decided to <w>trouser</w> it.",
                            "target_lang_translations": {
                                "nl": "Hij vond een duur horloge in de kleedkamer en besloot het <w>achterover te drukken</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "filch",
                        "pinch",
                        "swipe"
                    ],
                    "common_phrases": [
                        "trouser the money"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or slang usage"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Stiekem geld of voorwerpen achteroverdrukken of stelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achteroverdrukken",
                                "target_lang_sense_clarification": "stiekem ontvreemden"
                            },
                            {
                                "target_lang_word": "verdonkeremanen",
                                "target_lang_sense_clarification": "stiekem wegnemen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c701198-6e07-33ee-b760-e647b3d01ecc",
                    "sense_definition": "To physically put money or a small item into one's pocket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "take_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He collected his change from the counter and <w>trousered</w> the coins.",
                            "target_lang_translations": {
                                "nl": "Hij pakte zijn wisselgeld van de balie en <w>stak</w> de munten <w>in zijn zak</w>."
                            }
                        },
                        {
                            "text": "She took the folded bank note and quickly <w>trousered</w> it before boarding.",
                            "target_lang_translations": {
                                "nl": "Ze pakte het opgevouwen bankbiljet en <w>stopte</w> het snel <w>weg</w> voordat ze instapte."
                            }
                        }
                    ],
                    "synonyms": [
                        "pocket"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal phrasing"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Fysiek geld of een klein voorwerp in de zak steken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in zijn zak steken",
                                "target_lang_sense_clarification": "fysiek in de broekzak steken"
                            },
                            {
                                "target_lang_word": "wegstoppen",
                                "target_lang_sense_clarification": "in een zak steken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}