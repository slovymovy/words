                "senses": [
                    {
                        "sense_id": "43dd8cf0-7bc1-3d67-a11b-ff4cd48a688b",
                        "entry_id": "458b0e60-f339-345b-b652-3d6d4b45fd59",
                        "glosses": [
                            "покрыться гноем; начать гноиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063d2274-29a5-4b5f-bb6c-320f478ee6c5",
                                "sense_id": "43dd8cf0-7bc1-3d67-a11b-ff4cd48a688b",
                                "text": "Ежели ж загноится, то оторвать подкову и до живого мяса вычистить."
                            },
                            {
                                "example_id": "acd391f1-716f-49ed-8e19-caa77a0fb12e",
                                "sense_id": "43dd8cf0-7bc1-3d67-a11b-ff4cd48a688b",
                                "text": "Попала ли пуля в какое-нибудь нервное сплетение или рана так болезненно загноилась ― не знаю."
                            }
                        ]
                    },
                    {
                        "sense_id": "051d22c8-f198-395a-9e67-70721e350874",
                        "entry_id": "458b0e60-f339-345b-b652-3d6d4b45fd59",
                        "glosses": [
                            "перен., разг. начать морально разлагаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ba5d94-1f40-458d-94a5-14509f13437f",
                                "sense_id": "051d22c8-f198-395a-9e67-70721e350874",
                                "text": "Народ загноился от пьянства и не может уже отстать от него."
                            }
                        ]
                    }
                ],
