                "senses": [
                    {
                        "sense_id": "439e734f-5494-3bc4-b30b-50de7fb7ec1d",
                        "entry_id": "c732a438-e566-32f6-951a-139397ab82d3",
                        "glosses": [
                            "Revenir en arrière sur une capture, en analyse rétrograde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb79737d-e4a6-4649-9b5b-68a04cf1c98f",
                                "sense_id": "439e734f-5494-3bc4-b30b-50de7fb7ec1d",
                                "text": "L’échec du Fou blanc s’explique maintenant par la découverte de la Tour blanche 2.Tf6-b6+ et on note que les Blancs n’ont pas pu décapturer de pièce noire avec cette Tour car toutes les prises des pièces noires ont été faites avec les Pions blancs."
                            },
                            {
                                "example_id": "dd4e1085-640f-4475-841e-43e8f6975729",
                                "sense_id": "439e734f-5494-3bc4-b30b-50de7fb7ec1d",
                                "text": "Le pion recule en a6 puis doit décapturer 4 pièces noires pour aller en e2"
                            },
                            {
                                "example_id": "6757612a-fbd6-47b9-9e06-8c808ce4e260",
                                "sense_id": "439e734f-5494-3bc4-b30b-50de7fb7ec1d",
                                "text": "Il s'en différencie par l'impossibilité pour les deux camps de jouer des rétrocoups de décapture. L'interdiction de décapturer réduit l'arbre de rétrojeu."
                            }
                        ]
                    }
