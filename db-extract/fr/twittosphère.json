                                "target_senses": [
                                    {
                                        "sense_id": "f8971173-9365-3391-b2c2-9ee509a7fb0c",
                                        "entry_id": "2d380303-92b4-3168-90c3-5a66a0c61e30",
                                        "glosses": [
                                            "The totality of users and messages on the Twitter microblogging service."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd7c4129-b216-4b43-9f89-25917cb01a89",
                                                "sense_id": "f8971173-9365-3391-b2c2-9ee509a7fb0c",
                                                "text": "In news stories that had the Twittersphere absolutely buzzing (there's no better word for it), two of America's largest casual restaurant brands—Applebee's and Olive Garden—managed, in separate incidents, to serve alcoholic beverages to a fifteen-month-old and a two-year-old, respectively (alcoholic margarita mix in a sippy cup to the fifteen-month-old; sangria to the two-year-old), between late March and early April 2011."
                                            },
                                            {
                                                "example_id": "8d8b670b-129e-4c07-ad9a-a3c9eefe74e0",
                                                "sense_id": "f8971173-9365-3391-b2c2-9ee509a7fb0c",
                                                "text": "Following Benedict's departure, his successor, Francis, surged into the Twittersphere, sending several tweets weekly translated into nine different languages, even though he has admitted never having written anything but longhand and never having gotten used to writing on a computer."
                                            },
                                            {
                                                "example_id": "938d1ec7-f7f4-41b3-b318-477d3a400d34",
                                                "sense_id": "f8971173-9365-3391-b2c2-9ee509a7fb0c",
                                                "text": "I also expect their followers will be quick to pick up the activist causes, and spread these \"good causes\" widely across the Twittersphere, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
