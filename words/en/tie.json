                        {
                            "text": "They won their first round <w>tie</w> and moved to the next stage.",
                            "target_lang_translations": {
                                "ru": "Они выиграли <w>встречу</w> первого раунда и прошли на следующий этап."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup tie"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный матч или встреча между двумя командами в турнире."
                    },
                    "translations": {
                        "ru": [
