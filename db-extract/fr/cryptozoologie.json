        "fr-extract.jsonl": [
            {
                "entry_id": "c265d9d9-2bf8-3eb4-ad14-006708314666",
                "word": "cryptozoologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8292e29b-8834-40dc-b047-07274a0c4378",
                        "entry_id": "c265d9d9-2bf8-3eb4-ad14-006708314666",
                        "tags": [
                            "plural"
                        ],
                        "form": "cryptozoologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de7d4c8f-f570-3fb5-aefe-cf6e0b7684e4",
                        "entry_id": "c265d9d9-2bf8-3eb4-ad14-006708314666",
                        "glosses": [
                            "Science biologique spéculative consistant en l’étude d’animaux dont l’existence n’a pas été attestée scientifiquement, mais fait seulement l’objet de témoignages ou d’indices indirects, tel que le yéti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a104c1a-4f50-4622-b3c2-8205c815bd2e",
                                "sense_id": "de7d4c8f-f570-3fb5-aefe-cf6e0b7684e4",
                                "text": "La cryptolinguistique s’intéresse aux mots qui n’existent pas encore, comme la cryptozoologie est la science des animaux pas encore découverts."
                            },
                            {
                                "example_id": "def3df2a-6e19-4836-99fd-081e6d975463",
                                "sense_id": "de7d4c8f-f570-3fb5-aefe-cf6e0b7684e4",
                                "text": "Le zoologue belge Bernard Heuvelmans (1916-2001), père de la cryptozoologie, ou science des animaux ignorés, leur a consacré plusieurs études."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89361ebc-c5fd-4e60-ae10-bfca8fcd49e5",
                        "source_entry_id": "c265d9d9-2bf8-3eb4-ad14-006708314666",
                        "source_sense_id": "de7d4c8f-f570-3fb5-aefe-cf6e0b7684e4",
                        "target_lang_word": "Kryptozoologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryptozoologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69d7efbf-04b3-3fe3-8665-648a30b8321a",
                                        "entry_id": "8e622253-c95d-3914-8510-7047fd940bdb",
                                        "glosses": [
                                            "Pseudowissenschaft, die sich mit Tierarten, für deren Existenz es keine Belege gibt, befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd8c110-8832-40e2-a065-5a0531ec4898",
                                                "sense_id": "69d7efbf-04b3-3fe3-8665-648a30b8321a",
                                                "text": "„Wie hätte er jemandem Kryptozoologie erklären sollen, der Massachusetts nicht von Shangri-La unterscheiden konnte?“"
                                            },
                                            {
                                                "example_id": "db9ca5ab-89f4-4c6f-a425-62c39088fe3c",
                                                "sense_id": "69d7efbf-04b3-3fe3-8665-648a30b8321a",
                                                "text": "„Ihr Feld ist die Kryptozoologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05392a2-e09e-4391-94f9-b870ae144b7a",
                        "source_entry_id": "c265d9d9-2bf8-3eb4-ad14-006708314666",
                        "source_sense_id": "de7d4c8f-f570-3fb5-aefe-cf6e0b7684e4",
                        "target_lang_word": "cryptozoology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptozoology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3261f3c5-ae02-374e-aeb4-1c3bb464c868",
                                        "entry_id": "490b98c9-1ec8-3a47-be66-bfec7d30dd05",
                                        "glosses": [
                                            "Study of cryptids, animals whose existence has not been proven."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ebf5887-1bbb-4643-b95c-52a9a76d47ad",
                                                "sense_id": "3261f3c5-ae02-374e-aeb4-1c3bb464c868",
                                                "text": "The Loch Ness Monster is one of the mysteries of cryptozoology."
                                            },
                                            {
                                                "example_id": "f0630406-f1f9-42a3-a607-d1e299429632",
                                                "sense_id": "3261f3c5-ae02-374e-aeb4-1c3bb464c868",
                                                "text": "This peculiar situation amplifies the reluctance of conservative scientists to objectively consider the search for hidden animals, the field of cryptozoology. […] Indeed, cryptozoology has gained increasing legitimacy in recent years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
