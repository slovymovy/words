                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd1c06c-cc59-46a9-934d-0e94e311a217",
                                "sense_id": "70e1d3bb-9b6f-3c77-bbf7-e79710767d1a",
                                "text": "„Da der Olfaktus direkt auf die Amygdala projiziert (z.B. Cain, 1974; Dodd & Castellucci, 1991; Hatt, 1996; Macrides & Davis, 1983, Royet et al., 2003; Skrandies, 1996), werden mit der Wahl eines olfaktorischen UCS im Rahmen dieser Konditionierungsstudie aversive, emotionale Reaktionen unmittelbar unter Laborbedingungen induziert und untersucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34c55004-384a-496a-806f-2322740e3373",
                        "source_entry_id": "d144fbdd-c055-3ff7-98be-e8783aa1083e",
                        "source_sense_id": "70e1d3bb-9b6f-3c77-bbf7-e79710767d1a",
