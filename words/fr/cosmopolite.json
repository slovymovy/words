{
    "word_family": [
        "cosmopolitisme"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "93227234-9e2c-325c-8b5f-3bbb8c3e4ddb",
                    "sense_definition": "Composé de personnes de nationalités ou d'origines diverses, ou ouvert sur le monde entier.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "diversite_culturelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Londres est une métropole <w>cosmopolite</w> où se côtoient des personnes de toutes les cultures."
                        },
                        {
                            "text": "Ce quartier animé attire une population très <w>cosmopolite</w> venue des quatre coins de la planète."
                        }
                    ],
                    "synonyms": [
                        "international"
                    ],
                    "common_phrases": [
                        "ville cosmopolite",
                        "population cosmopolite"
                    ]
                },
                {
                    "sense_id": "c28c01d9-50be-3e75-af9a-50d91587b2ba",
                    "sense_definition": "Qui se réclame de la citoyenneté du monde et refuse d'être limité par des frontières nationales.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "philosophie_monde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a développé un esprit <w>cosmopolite</w> au fil de ses longs séjours à l'étranger."
                        },
                        {
                            "text": "Sa pensée <w>cosmopolite</w> s'oppose fermement aux discours identitaires et isolationnistes."
                        }
                    ],
                    "antonyms": [
                        "nationaliste"
                    ],
                    "common_phrases": [
                        "esprit cosmopolite"
                    ]
                },
                {
                    "sense_id": "94e469ae-6a67-3b7d-aeee-58fb13435e50",
                    "sense_definition": "Qui se rencontre dans la plupart des régions du globe, en parlant d'un être vivant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fougère aquatique est une plante <w>cosmopolite</w> capable de pousser sous de nombreux climats."
                        },
                        {
                            "text": "Certains insectes possèdent une aire de répartition <w>cosmopolite</w> grâce au commerce maritime mondial."
                        }
                    ],
                    "antonyms": [
                        "endémique"
                    ],
                    "common_phrases": [
                        "espèce cosmopolite"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e8de223-3ce4-36dd-a94f-0082b7333597",
                    "sense_definition": "Personne qui se considère comme un citoyen du monde et refuse l'attachement exclusif à une patrie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "philosophie_monde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand voyageur se définissait volontiers comme un <w>cosmopolite</w> sans patrie fixe."
                        },
                        {
                            "text": "Les <w>cosmopolites</w> de ce siècle espéraient voir disparaître toutes les barrières entre les nations."
                        }
                    ],
                    "antonyms": [
                        "nationaliste"
                    ]
                }
            ]
        }
    ]
}