                        ],
                        "examples": [
                            {
                                "example_id": "95f73a12-1f17-457e-b805-7b018e6da11f",
                                "sense_id": "afe21bfb-3dfc-33ce-9a85-dbf4c19cc37f",
                                "text": "„Diese lebten in der Sommersaison als Jäger und Fischer im Mündungsgebiet des Dnjepr und Dnjestr.“"
                            },
                            {
                                "example_id": "f969572d-8296-4dae-b67d-6f74b532b803",
                                "sense_id": "afe21bfb-3dfc-33ce-9a85-dbf4c19cc37f",
                                "text": "„Die Gebiete östlich des Dnjestr werden aus der Ukraine gelöst und erhalten den Namen Autonome Moldawische Sozialistische Sowjetrepublik (kurz: MASSR).“"
                            },
                            {
                                "example_id": "eff7ecfb-42aa-422b-9f12-e70452ea0fab",
                                "sense_id": "afe21bfb-3dfc-33ce-9a85-dbf4c19cc37f",
                                "text": "„Der dritte Sohn namens Asparuch schließlich habe den Dnjepr und Dnjestr überquert, Flüsse, die nördlich der Donau lägen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
