                                        "entry_id": "97934d1b-e13a-33e8-af75-eacdc984649d",
                                        "glosses": [
                                            "winzig klein, nur mit optischen Instrumenten unter starker Vergrößerung erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c4318e0-2589-40c5-880e-63ff20fa7368",
                                                "sense_id": "8a97a544-280f-393b-9be5-3f1ecb5119db",
                                                "text": "„Aber alle realen Gläser weisen mikroskopische Kerben und Fehlstellen auf.“"
                                            }
                                        ],
