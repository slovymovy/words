        "fr-extract.jsonl": [
            {
                "entry_id": "e64d135c-d2bd-3eb4-b63c-3a6331876f66",
                "word": "badinerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "653d0d39-9230-4322-8a9c-2b5a841ebfd1",
                        "entry_id": "e64d135c-d2bd-3eb4-b63c-3a6331876f66",
                        "tags": [
                            "plural"
                        ],
                        "form": "badineries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                        "entry_id": "e64d135c-d2bd-3eb4-b63c-3a6331876f66",
                        "glosses": [
                            "Ce qu’on fait ou ce qu’on dit dans l’intention de badiner."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "68e73151-464b-487a-94d5-20af5b70ae4e",
                                "sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                                "text": "Ce n’est qu’une badinerie, qu’une pure badinerie."
                            },
                            {
                                "example_id": "54db305d-686c-4a81-b39f-7f0e15053f78",
                                "sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                                "text": "Il ne s’amuse qu’à des badineries."
                            },
                            {
                                "example_id": "cca4948a-69e8-4b88-a3d8-82f7fd1a5a99",
                                "sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                                "text": "L'effet comique vient ici du jeu en lui- même, de ce mélange inattendu du sacré et du profane : la badinerie n'engage en rien les convictions de l'écrivain."
                            },
                            {
                                "example_id": "c005c043-0b33-4afe-90ef-28b3829aec70",
                                "sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                                "text": "Comme chaque fois qu’il avait la faiblesse de se plaindre, il se racheta sur-le-champ par un rire faussement insouciant et une docte badinerie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c212c1ba-275a-4251-943d-7bd4217db2be",
                        "source_entry_id": "e64d135c-d2bd-3eb4-b63c-3a6331876f66",
                        "source_sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                        "target_lang_word": "Scherz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                        "entry_id": "5db6a336-0fe2-370b-95f6-850337ff25be",
                                        "glosses": [
                                            "nicht ernst zu Nehmendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0ede18-2a98-4469-8ce2-f2b391a0a680",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "Er hält das Leben für einen einzigen Scherz."
                                            },
                                            {
                                                "example_id": "a38d316a-5cfd-4705-bfa0-0920fe7e9ea5",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "Das habe ich nur im Scherz gesagt."
                                            },
                                            {
                                                "example_id": "4847ecbc-010a-43e6-a6e6-c2c35d0f33d7",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "Mit so etwas treibt man keine Scherze!"
                                            },
                                            {
                                                "example_id": "4f5f3c60-254a-4f5f-ab6a-12d55ff7dca5",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "„Kein Scherz war in seiner Stimme.“"
                                            },
                                            {
                                                "example_id": "203c308b-dd88-4c49-952d-d6ea26381582",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "„Die alte Feng machte noch ein Weilchen Scherze und ging dann davon.“"
                                            },
                                            {
                                                "example_id": "cffc090b-ba17-4c62-947c-be48afeb342b",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "„Sie erfanden jede Mange Scherze und Wortspiele über Hündchen und andere Tiere sowie einige herrliche gotteslästerliche Spötteleien über ihren falschen Jesus.“"
                                            },
                                            {
                                                "example_id": "d30875fe-5689-46ee-8d3f-7bccc12a61af",
                                                "sense_id": "8f410656-589d-3d55-b49a-fa4a1ed49f0e",
                                                "text": "„Und dieser Scherz amüsierte sie dermaßen, daß sie ihn mehr als drei Wochen lang zwanzigmal am Tage wiederholten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                        "entry_id": "5db6a336-0fe2-370b-95f6-850337ff25be",
                                        "glosses": [
                                            "das Hereinlegen einer Person zum Zwecke der Belustigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a63ded8-e311-497d-b1b0-89574efd622c",
                                                "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                                "text": "Unser Lehrling muss sich wohl von dem Scherz mit dem „schweren Wasser“ erholen."
                                            },
                                            {
                                                "example_id": "0fc11bd6-87f8-4e8a-ba31-9f0a63a1e0d4",
                                                "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                                "text": "Der erste April ist ein beliebter Tag für Scherze."
                                            },
                                            {
                                                "example_id": "28b3e88e-a5f9-47b6-9c62-90759de056b1",
                                                "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                                "text": "„Pfitzners Scherze waren sehr gefürchtet, denn sein Witz war beißend und nicht selten verletzend.“"
                                            },
                                            {
                                                "example_id": "51edb489-2c89-479d-b845-b2e1818c17e0",
                                                "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                                "text": "„Diese Wunde, die Tichon nur mit äusserlicher und innerlicher Anwendung von Schnaps zum Heilen brachte, war für die ganze Abteilung ein Gegenstand der muntersten Scherze gewesen, auf die auch Tichon gern eingegangen war.“"
                                            },
                                            {
                                                "example_id": "2003317d-8fd4-498d-aa2a-a996dad6184c",
                                                "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                                "text": "„Ohne auf weitere Einwände zu warten, suchte ich Madame d'Urfé auf und erzählte ihr das nächtliche Erlebnis mit Scherzen verbrämt, so daß sie aus vollem Halse lachte.“"
                                            },
                                            {
                                                "example_id": "343391a7-f44f-47a9-91bf-4f470e4beeee",
                                                "sense_id": "45951b17-8c9c-31af-9189-03dccd4d0300",
                                                "text": "„Aus dem Dämmer solcher Scherze führte der Weg ins Abstruse der Valentiniaden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16345302-c297-4625-90cf-3b6a477e07a8",
                        "source_entry_id": "e64d135c-d2bd-3eb4-b63c-3a6331876f66",
                        "source_sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                        "target_lang_word": "Spielerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                        "entry_id": "82d680e2-9db6-3537-8ab2-2a22691129eb",
                                        "glosses": [
                                            "anhaltendes Spielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcda3585-dfdf-42c0-9c39-884ecc71c611",
                                                "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                                "text": "„Lange spannten sie mich nicht auf die Folter, und bald begann die Balgerei, Toberei und Spielerei von Neuem.“"
                                            },
                                            {
                                                "example_id": "76a7ee1c-f574-48dd-ace9-b450cfee7603",
                                                "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                                "text": "„Auch von den spielfreundlichsten Pädagogen wird das Phänomen der Spielerei durchaus gesehen, das sich in aller Vorläufigkeit charakterisieren läßt als ein Abgleiten des Spielenden in Schlaffheit, Gereiztheit, Übermut, Langeweile, Nervosität, blöde Lachanfälle u.s.w.: Problematisch bleibt sein Umfang und seine Grenzen.“"
                                            },
                                            {
                                                "example_id": "d90c033d-5367-454c-b5e1-31288242d9af",
                                                "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                                "text": "„Die englische Sprache zeigt einige Eigenschaften, die sie geradezu für sprachliche Spielereien prädestinieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                        "entry_id": "82d680e2-9db6-3537-8ab2-2a22691129eb",
                                        "glosses": [
                                            "etwas, das nicht wirklich ernst genommen werden muss/das nur aus einer Laune heraus entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846683b6-7a14-480f-a3c8-d2f1956753a5",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "Diese Plastik kommt vielen Betrachtern als reine Spielerei vor."
                                            },
                                            {
                                                "example_id": "7c2a33c2-5393-42fb-9e5d-9a6908191cf6",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Noch nicht einmal seine Frau, eine Besitzerstochter aus seiner Heimat, ist sich recht klar darüber, daß die Liebhaberei ihres Mannes mehr als eine bloße Spielerei ist.“"
                                            },
                                            {
                                                "example_id": "e931f3d8-02a1-4cd7-afca-165bfa2ca8ae",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Diese Spielereien lasse ich jetzt lieber sein.“"
                                            },
                                            {
                                                "example_id": "2fbce7f4-96fc-4173-b83e-df014f4c9588",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Damit werden Spielereien, aber auch Vermischungen mit anderen Lebensformen […] an den Randbereich des Spiels verwiesen.“"
                                            },
                                            {
                                                "example_id": "2b8537b8-8555-48ab-9994-7e4f42a813cb",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Als der Physiker Philipp Reis am 26. Oktober 1861 vor die Mitglieder des Frankfurter Physikalischen Vereins tritt und ihnen stolz das erste Telephon präsentiert, wird seine Erfindung abschätzig als Spielerei bezeichnet.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "983b257e-7495-3d56-b773-46a0804b326f",
                                        "entry_id": "82d680e2-9db6-3537-8ab2-2a22691129eb",
                                        "glosses": [
                                            "etwas, das leicht zu bewerkstelligen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18d8e55-b666-44e3-b84e-b10d0de8ae43",
                                                "sense_id": "983b257e-7495-3d56-b773-46a0804b326f",
                                                "text": "Die Montage des Schreibtischs ist mit dieser Anleitung doch nur eine Spielerei."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8167417e-4f7c-45f9-97e1-b0a0d754210e",
                        "source_entry_id": "e64d135c-d2bd-3eb4-b63c-3a6331876f66",
                        "source_sense_id": "26ee3800-5ce5-382e-acce-38c140c5caba",
                        "target_lang_word": "jest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69e2188d-5fa4-3e64-840e-afc17081b32d",
                                        "entry_id": "8178ba7f-75e4-3aa5-b1c8-cc312c436076",
                                        "glosses": [
                                            "An act performed for amusement; a joke."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2580bafb-2ae5-47d6-9a4b-7c221055d008",
                                                "sense_id": "69e2188d-5fa4-3e64-840e-afc17081b32d",
                                                "text": "I made that comment in jest; it wasn't serious."
                                            },
                                            {
                                                "example_id": "c9d4bc14-a1fb-41c3-b034-f6f6b82c591c",
                                                "sense_id": "69e2188d-5fa4-3e64-840e-afc17081b32d",
                                                "text": "Alas poore Yorick, I knew him Horatio, a fellow of infinite Ieſt; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ab7a20-e127-39c0-9667-0808d538666f",
                                        "entry_id": "8178ba7f-75e4-3aa5-b1c8-cc312c436076",
                                        "glosses": [
                                            "Someone or something that is ridiculed; the target of a joke."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc366e2d-ff2c-48e1-823b-78e1b8edc97e",
                                                "sense_id": "68ab7a20-e127-39c0-9667-0808d538666f",
                                                "text": "Your majesty, stop him before he makes you the jest of the court."
                                            },
                                            {
                                                "example_id": "009ce674-88c8-48ff-af79-636d28915996",
                                                "sense_id": "68ab7a20-e127-39c0-9667-0808d538666f",
                                                "text": "Why then make ſport at me, then let me be your ieſt, / I deſerue it[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f29b9cc3-cdba-3c84-9da1-e703f9339457",
                                        "entry_id": "8178ba7f-75e4-3aa5-b1c8-cc312c436076",
                                        "glosses": [
                                            "A deed; an action; a gest."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc7ce397-592f-443c-b5fe-1c5387a8cff7",
                                                "sense_id": "f29b9cc3-cdba-3c84-9da1-e703f9339457",
                                                "text": "the jests or actions of princes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac3745a8-1c20-31e6-8d8c-3e018a5c27cb",
                                        "entry_id": "8178ba7f-75e4-3aa5-b1c8-cc312c436076",
                                        "glosses": [
                                            "A mask; a pageant; an interlude."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9d3206-6361-423b-9cd4-b6750cd24309",
                                                "sense_id": "ac3745a8-1c20-31e6-8d8c-3e018a5c27cb",
                                                "text": "He promised us, in honour of our guest, / To grace our banquet with some pompous jest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a132d92-5bfa-314c-a073-a759b359c8a6",
                                        "entry_id": "fc2f622c-7a90-3a90-a681-f50919b57a71",
                                        "glosses": [
                                            "To tell a joke; to talk in a playful manner; to make fun of something or someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5836f48-fc1e-4878-9a7c-68d8f1bf8294",
                                                "sense_id": "2a132d92-5bfa-314c-a073-a759b359c8a6",
                                                "text": "Surely you jest!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6342f201-4d58-337e-b795-1c6781bca7b8",
                                        "entry_id": "915efb79-523c-3471-9f6e-30678251b17b",
                                        "glosses": [
                                            "Pronunciation spelling of just."
                                        ],
                                        "tags": [
                                            "Shropshire",
                                            "Southern-US",
                                            "alt-of",
                                            "not-comparable",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30c5152-7fa9-4844-9cef-b026862b9133",
                                                "sense_id": "6342f201-4d58-337e-b795-1c6781bca7b8",
                                                "text": "So I jest called out to know what was up, and found it was Miss Vanholte's cowboys, who had been forced into the store by them rascally ruffins."
                                            },
                                            {
                                                "example_id": "d7d64f58-7423-40d6-acdf-5b346a87c880",
                                                "sense_id": "6342f201-4d58-337e-b795-1c6781bca7b8",
                                                "text": "\"Jest like the Injian puzzle-boxes, ain't they?\" said Dan, as the one boat dropped into the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
