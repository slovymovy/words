                "senses": [
                    {
                        "sense_id": "bb24470c-968a-3007-9b39-e361a5ce2378",
                        "entry_id": "2118843c-9387-348e-a864-bc01ddf8d7b2",
                        "glosses": [
                            "Plante bulbeuse de la famille des Liliacées (classification classique) ou des Hyacinthacées (classification phylogénétique) ; il en existe plus de 200 espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81378c66-8637-4ed6-8d26-861c3be61784",
                                "sense_id": "bb24470c-968a-3007-9b39-e361a5ce2378",
                                "text": "L'ornithogale en ombelle (Ornithogalum umbellatum) est appelée communément dame d'onze heures car ses fleurs s'ouvrent au plein soleil et se referment le soir."
                            },
                            {
                                "example_id": "edd18232-5b7a-4747-9cf8-e742d0800ac6",
                                "sense_id": "bb24470c-968a-3007-9b39-e361a5ce2378",
                                "text": "Le muguet est proche parent de l’ornithogale ; il appartient à la famille des liliacées, à la tribu des asparagées."
                            },
                            {
                                "example_id": "04e99211-51aa-4ca8-b118-ca903efc0663",
                                "sense_id": "bb24470c-968a-3007-9b39-e361a5ce2378",
                                "text": "Les ériospermes diffèrent très peu des ornithogales."
                            }
                        ]
                    }
                ],
