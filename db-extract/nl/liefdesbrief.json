                "senses": [
                    {
                        "sense_id": "7d309d15-e9c4-3844-a834-b6d3bff24ce9",
                        "entry_id": "42729d9c-7948-3b6f-98be-6c080b402320",
                        "glosses": [
                            "brief die gestuurd wordt aan een geliefde en waarin men van zijn liefde blijk geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485033c0-e4c7-4adc-b1fe-8d32e2f98cbc",
                                "sense_id": "7d309d15-e9c4-3844-a834-b6d3bff24ce9",
                                "text": "Het nieuwe, alweer tiende seizoen van de KRO-NCRV kijkcijferhit Boer zoekt Vrouw begint op zondagavond 16 september. Tijdens de uitzending wordt duidelijk hoeveel liefdesbrieven de zeven, naar een relatie hunkerende boeren en drie vrijgezelle boerinnen die meedoen, hebben gekregen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24d12469-2b60-4a5a-bcc8-0f6e75ed5055",
                        "source_entry_id": "42729d9c-7948-3b6f-98be-6c080b402320",
                        "source_sense_id": "7d309d15-e9c4-3844-a834-b6d3bff24ce9",
                        "source_sense_description": "brief waarin men zijn liefde betuigt",
                        "target_lang_word": "Liebesbrief",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebesbrief",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                        "entry_id": "c447af60-3bf4-3561-ab7e-bf48639b1bcc",
                                        "glosses": [
                                            "ein sehr persönlicher Brief an eine geliebte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1642e1c2-cb3c-4701-9112-991eeac1f500",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "Ich habe meinem Schwarm einen Liebesbrief geschrieben."
                                            },
                                            {
                                                "example_id": "e3a4c352-77b4-4077-8e1c-cd6a7fc64a84",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "Sie verwahrte die mit einem roten Band umschlungenen Liebesbriefe in der hintersten Ecke des Schrankes."
                                            },
                                            {
                                                "example_id": "90c384cd-2888-4c48-94b3-066717c538c5",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "„Er las gerade seine Liebesbriefe und wollte nicht einmal aufsehen.“"
                                            },
                                            {
                                                "example_id": "93d98589-42e7-4f66-b74e-206f2e1a0298",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "„Oder ganz anders gesagt: Man könnte in den nächsten Tagen einen ganzen Haufen Liebesbriefe über unsere Gruppe hinwegschwirren lassen.“"
                                            },
                                            {
                                                "example_id": "bd2938f2-27dd-4c99-ae61-4a3f097fbd72",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "„Wotan wollte Vera Liebesbriefe schreiben.“"
                                            },
                                            {
                                                "example_id": "d61373f9-35ad-4748-a289-a1d2f2ed5b54",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "„Natascha hielt in zitternden Händen diesen leidenschaftlichen Liebesbrief, den Dolochow für Anatol verfasst hatte, und fand in ihm den Widerhall alles dessen, was sie selbst zu empfinden glaubte.“"
                                            },
                                            {
                                                "example_id": "ba71805c-7e20-4363-9043-a35dd423fa3d",
                                                "sense_id": "d8ada50f-f8d6-3850-8291-44152735273c",
                                                "text": "„Ferris hatte auch einen Liebesbrief in Erwägung gezogen, die Idee dann aber wieder verworfen, weil in Zeiten von E-Mail kein Mensch mehr Liebesbriefe schrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "468f1917-0488-4d02-b7b0-a3cc4dbdc68f",
                        "source_entry_id": "42729d9c-7948-3b6f-98be-6c080b402320",
                        "source_sense_id": "7d309d15-e9c4-3844-a834-b6d3bff24ce9",
                        "source_sense_description": "brief waarin men zijn liefde betuigt",
                        "target_lang_word": "love letter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "love letter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "066ade86-024f-32c1-a5cc-b8d3e196e794",
                                        "entry_id": "f9763950-0b1c-3b89-9904-cca19f2f1e9f",
                                        "glosses": [
                                            "A letter written to express the author's love for the intended reader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845c75bc-c3a3-41e3-a114-a5e82d507432",
                                                "sense_id": "066ade86-024f-32c1-a5cc-b8d3e196e794",
                                                "text": "We never see each other, but have been sending love letters every Valentine's Day for 10 years."
                                            },
                                            {
                                                "example_id": "ea3fcf2e-ce71-4d81-8230-936d6a320902",
                                                "sense_id": "066ade86-024f-32c1-a5cc-b8d3e196e794",
                                                "text": "Thus, when he drew up instructions in lawyer language[…]; his clerks, however, understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there. For his signature, however, that was different."
                                            },
                                            {
                                                "example_id": "7bff3d63-c9b7-4d08-babf-8a50fcd96b6e",
                                                "sense_id": "066ade86-024f-32c1-a5cc-b8d3e196e794",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30cb501d-bff6-37fb-970d-2507790fc68c",
                                        "entry_id": "f9763950-0b1c-3b89-9904-cca19f2f1e9f",
                                        "glosses": [
                                            "A work that shows great passion or enthusiasm for something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d72d25-12f4-419e-9a28-93f828a6e97e",
                                                "sense_id": "30cb501d-bff6-37fb-970d-2507790fc68c",
                                                "text": "This movie is a love letter to New York."
                                            },
                                            {
                                                "example_id": "43ab6acf-2356-41e2-a3cd-e57ae77ef7d8",
                                                "sense_id": "30cb501d-bff6-37fb-970d-2507790fc68c",
                                                "text": "The film is both a tip of the chapeau to The New Yorker, among other American magazines, and a love letter to expat life in France. But beyond that? There isn't much going on beneath its extraordinary bejewelled surface."
                                            },
                                            {
                                                "example_id": "b28e7602-ca9a-426f-8a00-1ab5f920471f",
                                                "sense_id": "30cb501d-bff6-37fb-970d-2507790fc68c",
                                                "text": "It was in this era, too, that author and Scotland the Brave songwriter Cliff Hanley penned The Glasgow Underground, a tongue-in-cheek love letter to the Subway in song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00040fb8-93f1-3397-b1c8-2c0f0228220d",
                                        "entry_id": "f9763950-0b1c-3b89-9904-cca19f2f1e9f",
                                        "glosses": [
                                            "A notice from the U.S. Customs and Border Protection informing about the seizure of a personal shipment as contraband."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "166d9ef1-1d7a-413e-bdbe-9c5f30e08920",
                                                "sense_id": "00040fb8-93f1-3397-b1c8-2c0f0228220d",
                                                "text": "Dr Martin says the address the package has been sent to will likely get a \"love letter\" in the post from Customs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8c5eaa-1571-3f93-80a3-33059d25d39b",
                                        "entry_id": "f9763950-0b1c-3b89-9904-cca19f2f1e9f",
                                        "glosses": [
                                            "A thin snack of crisp baked dough eaten at Chinese New Year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
