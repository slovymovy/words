                                                "example_id": "68ac05b9-fb71-4bdd-a26b-07560c926967",
                                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                                "text": "Doha ist die Hauptstadt von Katar."
