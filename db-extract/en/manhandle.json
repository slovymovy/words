                        "target_lang_word": "misshandeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misshandeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                        "entry_id": "eea974f1-6a87-3048-b5b4-2616420e1a40",
                                        "glosses": [
                                            "jemanden mutwillig seelisch oder körperlich heftig verletzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e14a2867-f490-4912-b03e-baff25a5ffa0",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "„Jeder kann in Ägypten ohne Grund verhaftet, misshandelt und beliebig lange hinter Gitter kommen.“"
                                            },
                                            {
                                                "example_id": "032166ce-ff76-41d2-9edd-a180c4c7265f",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "„Die beiden Pflegeeltern der toten Anna aus Bad Honnef haben gestanden, die Neunjährige misshandelt zu haben - als \"Erziehungsmaßnahme\".“"
                                            },
                                            {
                                                "example_id": "f2cb8d11-4d7f-46be-be7c-74db20433559",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "Doch auch angenommen, der Bauer hätte das Opossum über der That ertappt? dann spornt ihn sein Aerger an, das arme Thier mit Fußtritten zu mißhandeln."
                                            },
                                            {
                                                "example_id": "e354bd90-ac48-48cb-b206-005da0815472",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "„Er stellte sicher - oder auch nicht -, dass der Schiffsarzt seine Pflicht tat und dass Matrosen und Offiziere die Gefangenen nicht misshandelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
