{
    "word_family": [
        "assombrir",
        "assombrissement",
        "sombre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9119905a-743c-3d1f-b5da-ef3c62a4f5c9",
                    "sense_definition": "Couler et disparaître sous les eaux, en parlant d'un navire ou d'une embarcation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "naufrage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux chalutier a fini par <w>sombrer</w> au large des côtes bretonnes pendant la tempête nocturne."
                        },
                        {
                            "text": "Après avoir heurté un récif invisible, le bateau de pêche a commencé à <w>sombrer</w> rapidement."
                        }
                    ],
                    "synonyms": [
                        "couler",
                        "naufrager"
                    ],
                    "common_phrases": [
                        "sombrer corps et biens"
                    ]
                },
                {
                    "sense_id": "60138901-a058-3830-9376-fc170e235d5e",
                    "sense_definition": "Tomber progressivement dans un état moral, physique ou psychologique négatif ou destructeur.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decheance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la perte de son emploi, il a lentement commencé à <w>sombrer</w> dans une profonde dépression."
                        },
                        {
                            "text": "Ce vieil écrivain autrefois célèbre a vu son œuvre <w>sombrer</w> dans l'oubli avec le temps."
                        }
                    ],
                    "common_phrases": [
                        "sombrer dans le désespoir",
                        "sombrer dans l'oubli",
                        "sombrer dans la folie"
                    ]
                },
                {
                    "sense_id": "15fa28fa-d450-390e-ac46-96888bbd0ba9",
                    "sense_definition": "Être ruiné, s'effondrer ou disparaître complètement en parlant d'un projet, d'un système ou d'une entreprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effondrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans un soutien financier rapide de la part de l'État, cette grande société risque de <w>sombrer</w>."
                        },
                        {
                            "text": "Le pays tout entier a vu ses institutions <w>sombrer</w> après des mois de grave crise politique."
                        }
                    ],
                    "synonyms": [
                        "péricliter",
                        "s'écrouler"
                    ],
                    "common_phrases": [
                        "sombrer dans le chaos"
                    ]
                }
            ]
        }
    ]
}