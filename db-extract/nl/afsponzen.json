                                    },
                                    {
                                        "sense_id": "2988e377-db16-3a3b-be4e-39bab88ee8b2",
                                        "entry_id": "582255ee-8b9d-39db-a5c0-e68931b65c01",
                                        "glosses": [
                                            "A person who readily absorbs ideas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a73a57d6-0b0b-4889-af28-7d4578ffc457",
                                                "sense_id": "2988e377-db16-3a3b-be4e-39bab88ee8b2",
                                                "text": "For this reason, we need to think of our children as sponges of information and watch their sources carefully. We also need to always model appropriate behaviour, as we are a constant source of new information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58317ae8-3ac3-3732-b6d2-b7200f6d75f1",
