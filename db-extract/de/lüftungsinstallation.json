                    {
                        "sense_id": "7d98d4c8-d964-3f2d-8db8-f7db8a5faf21",
                        "entry_id": "b8540ab8-cdee-3bf1-b28b-980b5079c4e9",
                        "glosses": [
                            "montieren von Einzelteilen und Bezeichnung der fertig montierten Lüftungsanlage"
