                "translations": [
                    {
                        "translation_id": "1de16468-33e3-4d50-9b18-167cccf76922",
                        "source_entry_id": "62c5cce0-0d47-3807-9242-b2c8d20cdfeb",
                        "source_sense_id": "0a940059-be61-3839-af7e-317da33e8fa5",
                        "target_lang_word": "misandry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misandry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3007f58d-9d67-3c4d-be61-125a228d586f",
                                        "entry_id": "631d5db9-5553-3f28-a649-415f891d9dc7",
                                        "glosses": [
                                            "Hatred of, contempt for, or prejudice against men."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40adce99-edc1-410c-b419-50ca98a3adc5",
                                                "sense_id": "3007f58d-9d67-3c4d-be61-125a228d586f",
                                                "text": "“But this is a big issue. This boy was a product of this culture. And I think to talk about the culture is not misandry (the hatred of males), it’s not wrong and we do need to talk about it. If we want to know how to end this kind of violence we need to address the culture that created this kind of violence."
                                            },
                                            {
                                                "example_id": "8e80e0c0-88ac-45b5-b8d2-8642a5894663",
                                                "sense_id": "3007f58d-9d67-3c4d-be61-125a228d586f",
                                                "text": "The scenework proves unsuccessful when Carmichael recalls not the source of her misandry but another episode of overacting, that of castratively biting off the moustache of an amorous man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21f14d46-e937-4a53-a8a1-f786c883c23a",
                        "source_entry_id": "62c5cce0-0d47-3807-9242-b2c8d20cdfeb",
                        "source_sense_id": "0a940059-be61-3839-af7e-317da33e8fa5",
                        "target_lang_word": "misandrie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misandrie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28aff47c-a3c5-3e3e-9942-d3057b9a19f8",
                                        "entry_id": "f00010a4-0f9d-388d-b388-eef955df169b",
                                        "glosses": [
                                            "Doctrine ou attitude (d’une personne) exprimant la haine ou le mépris à l’égard du genre masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e116ba-e8d7-4f95-b55f-6f8ade2733a0",
                                                "sense_id": "28aff47c-a3c5-3e3e-9942-d3057b9a19f8",
                                                "text": "Je parlerai donc de misandrie comme d’un sentiment négatif à l’égard de la gent masculine dans son ensemble."
                                            },
                                            {
                                                "example_id": "513025ca-44ac-4bda-afe5-64bfd2241b99",
                                                "sense_id": "28aff47c-a3c5-3e3e-9942-d3057b9a19f8",
                                                "text": "Le Québec est aussi la société la plus féministe d’Amérique du Nord, au point même où une certaine misandrie s’est imposée dans les codes culturels depuis longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
