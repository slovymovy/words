                "senses": [
                    {
                        "sense_id": "515e66c2-a324-3276-90d1-dce96abfa730",
                        "entry_id": "dd449521-1f04-3eda-9235-8e2456f362e3",
                        "glosses": [
                            "von der International Air Transport Association (IATA) vergebener Code, mit denen Flughäfen, Fluggesellschaften und Flugzeugtypen abgekürzt werden"
                        ],
                        "tags": [
                            "Luftverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "7e514582-1d71-45d0-ba97-6bd1ae3c675f",
                                "sense_id": "515e66c2-a324-3276-90d1-dce96abfa730",
                                "text": "„Die Botschaft der Bundesrepublik Deutschland in Yangon rät ihren eigenen Beschäftigten seit Jahren, aus Sicherheitsgründen auf Flugreisen mit der staatlichen Inlandsfluggesellschaft Myanma Airways (IATA-Code: UB) zu verzichten.“"
                            },
                            {
                                "example_id": "97f4f994-f008-43ce-88b3-c37c510248c9",
                                "sense_id": "515e66c2-a324-3276-90d1-dce96abfa730",
                                "text": "„Im Einzugsbereich von FMO, wie der Airport im IATA-Code heißt, leben nach Betreiberangaben sieben Millionen Menschen.“"
                            },
                            {
                                "example_id": "9a7e16a2-410e-48ef-a0de-d641af9dfde4",
                                "sense_id": "515e66c2-a324-3276-90d1-dce96abfa730",
                                "text": "„Deutschlands zweitgrößte Fluggesellschaft Air Berlin bedient von Saarbrücken aus (IATA-Code SCN) unter anderem Strecken nach Luxemburg, Moskau, Hamburg, Oslo, München, Madrid oder Berlin.“"
                            },
                            {
                                "example_id": "f13ad91c-1511-4106-8577-442bff6527a4",
                                "sense_id": "515e66c2-a324-3276-90d1-dce96abfa730",
                                "text": "Der IATA-Code für den Flughafen München lautet 'MUC'."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
