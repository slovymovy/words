                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9eade9d-6bcc-39ec-89c9-f419131ccda0",
                        "entry_id": "1e5067e7-b576-3878-89fc-398709765dae",
                        "glosses": [
                            "Fait d’être juif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08aed453-e041-4d4f-94ec-9190169a3fd4",
                                "sense_id": "e9eade9d-6bcc-39ec-89c9-f419131ccda0",
                                "text": "Admis dans un camp de convalescence pour « displaced persons », il passe devant une commission de contrôle pour prouver sa judéité."
                            },
                            {
                                "example_id": "3f8cadc3-c102-4942-84b1-7c4029291dca",
                                "sense_id": "e9eade9d-6bcc-39ec-89c9-f419131ccda0",
                                "text": "Pourtant, l’Occupation venue, Charles Trenet va être l’un des rares chanteurs en vogue dont le répertoire est assimilé d’autorité aux « rythmes judéo-nègres » du jazz (il sera d’ailleurs sommé par les autorités d’apporter la preuve de sa non-judéité)."
                            },
                            {
                                "example_id": "4e6c7d66-571b-43fb-b50c-23c641f23052",
                                "sense_id": "e9eade9d-6bcc-39ec-89c9-f419131ccda0",
                                "text": "Le fait de croire ou non n’a aucun effet. Lorsqu’on cherche à évaluer la judéité de quelqu’un, on ne lui demande pas en quoi il croit, on lui demande comment il pratique : est-ce qu’il mange casher ? est-ce qu’il prend sa voiture pendant shabbat ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07e1af4c-7d00-419a-b865-1a19776a67cc",
                        "source_entry_id": "1e5067e7-b576-3878-89fc-398709765dae",
                        "source_sense_id": "e9eade9d-6bcc-39ec-89c9-f419131ccda0",
                        "target_lang_word": "Jüdischkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jüdischkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
                                        "entry_id": "8f4de380-ac54-3d55-84d9-0c6f780491b1",
                                        "glosses": [
                                            "Einstellung/Identität als Jude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c820bd-bd4b-4ff7-9694-80bd8b66af54",
                                                "sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
                                                "text": "„Wir müssen von einem Judentum Heines ausgehen, welches nach einer durchgemachten Assimilation nur noch als Gedächtnis an das Judentum, und zwar als ein Körpergedächtnis besteht, als Erinnerungen an die Jüdischkeit.“"
                                            },
                                            {
                                                "example_id": "547a4649-f4ea-4c7f-9ab6-dc4d026df5e0",
                                                "sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
                                                "text": "„Doch selbst der säkularste Israeli sei täglich mehr Jüdischkeit ausgesetzt als es ein Orthodoxer oder Reformer in den USA je sein wird.“"
                                            },
                                            {
                                                "example_id": "275c01d4-bf32-46fd-b6a5-26db88298438",
                                                "sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
                                                "text": "„Im Ausland hatte er sich im Lauf der Jahre von dieser altmodischen Jüdischkeit entfernt, die Juden hier aber dienten Gott noch so, wie damals die Leute in Roszkow.“"
                                            },
                                            {
                                                "example_id": "9ba1a13e-109c-4654-9a1d-07d1c3013739",
                                                "sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
                                                "text": "„Taucherts Studie selbst leistet hier einen wesentlichen Beitrag, auch ihre Untersuchungen bestätigen, dass jenseits einer religiösen Einbindung über die jüdischen Gemeinden die Jüdischkeit ein notwendiges Bindeglied zwischen privat empfundener Zugehörigkeit zum Judentum und einer Gruppenzugehörigkeit darstellt, innerhalb der die Anlehnung an die jüdische Kultur einen wesentlichen Faktor ausmacht, ohne allerdings genau bestimmt zu sein.“"
                                            },
                                            {
                                                "example_id": "a751eabd-54e7-4e32-a085-83a8f397894e",
                                                "sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
                                                "text": "„Andere begannen, sich ihrer Jüdischkeit wieder zuzuwenden mit einem Bekenntnis zur eigenen jüdischen Nation (Zionismus) oder als Mitglieder des „Centralvereins deutscher Staatsbürger jüdischen Glaubens”, der die jüdische Gleichberechtigung gegen den Antisemitismus verteidigte und gleichzeitig eine säkulare jüdische Volksgemeinschaft oder Schicksalsgemeinschaft vertrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18ceace5-a610-4fb7-8b49-8e7125ba3798",
                        "source_entry_id": "1e5067e7-b576-3878-89fc-398709765dae",
