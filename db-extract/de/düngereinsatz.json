                    {
                        "sense_id": "dfa6b405-74d4-3d5e-a8b9-2ce62232017d",
                        "entry_id": "b9737831-119f-3fc3-997f-6022c89f5c76",
                        "glosses": [
                            "Verwendung/Einsatz von Dünger zur Verbesserung des Pflanzenwachstums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "419d1a90-071c-4528-b70f-b6e6ba1f108e",
                                "sense_id": "dfa6b405-74d4-3d5e-a8b9-2ce62232017d",
                                "text": "„Der steigende Düngereinsatz in der Landwirtschaft führt zu Lachgasemissionen (N2O).“"
                            },
                            {
                                "example_id": "c743750f-b382-458e-bc9e-d8b8c2a91d57",
                                "sense_id": "dfa6b405-74d4-3d5e-a8b9-2ce62232017d",
                                "text": "„Darüber hinaus verlangt der Mais dem Boden viel ab und führt zu einer Degradation der Humusschicht und folglich erhöhtem Düngereinsatz.“"
                            },
                            {
                                "example_id": "858b647b-6505-40c1-8846-8aaaa5fc2da7",
                                "sense_id": "dfa6b405-74d4-3d5e-a8b9-2ce62232017d",
                                "text": "„Insgesamt wurde bei Zuckerrüben der Düngereinsatz in den vergangenen 10 Jahren deutlich reduziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
