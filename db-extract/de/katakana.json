                "senses": [
                    {
                        "sense_id": "2d3a8b94-6852-32e7-a859-74724f438299",
                        "entry_id": "17684d73-e8a1-3b4f-9d90-877f107b7bbf",
                        "glosses": [
                            "die zweite japanische Silbenschrift, welche meist für Fremdwörter verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5970796e-7c54-45fa-b894-7e0a4af7e540",
                                "sense_id": "2d3a8b94-6852-32e7-a859-74724f438299",
                                "text": "„Um zu vereindeutigen, welche der Lesarten zutreffend ist, sehen viele japanische Formulare seit langem ein Zusatzfeld vor, in dem der Name in der Silbenschrift Katakana zu transkribieren ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21daa17f-c047-45da-b11c-1d95f5fc0d2c",
                        "source_entry_id": "17684d73-e8a1-3b4f-9d90-877f107b7bbf",
                        "source_sense_id": "2d3a8b94-6852-32e7-a859-74724f438299",
                        "source_sense_description": "die zweite japanische Silbenschrift, welche meist für Fremdwörter verwendet wird",
                        "target_lang_word": "katakana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katakana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7847eb40-8cfb-34a3-8b57-ed5681f96f20",
                                        "entry_id": "080d65ef-2b2d-30ee-8f8d-d072a6d80380",
                                        "glosses": [
                                            "A Japanese syllabary used when writing words borrowed from foreign languages other than Chinese, specific names of plants and animals and other jargon, onomatopoeia, or to emphasize a word or phrase. Also used to write the Ainu language."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e571eb71-b4be-390a-8529-6a7df26c2f20",
                                        "entry_id": "080d65ef-2b2d-30ee-8f8d-d072a6d80380",
                                        "glosses": [
                                            "A character thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8257942d-c787-4ff9-8670-1e0a7ab0829c",
                        "source_entry_id": "17684d73-e8a1-3b4f-9d90-877f107b7bbf",
                        "source_sense_id": "2d3a8b94-6852-32e7-a859-74724f438299",
                        "source_sense_description": "die zweite japanische Silbenschrift, welche meist für Fremdwörter verwendet wird",
                        "target_lang_word": "katakana",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katakana",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4b1aed-7582-3d66-a23b-43dc8541f8d2",
                                        "entry_id": "f1b21e37-d29e-3834-bd57-37e839dc2d39",
                                        "glosses": [
                                            "Kana, caractère notant une more en japonais, dérivé de fragments d’un kanji dont il a hérité sa prononciation. Il en existe une cinquantaine, dont quelques désuets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe53d723-020e-4b6f-aa02-16fea0aaefe0",
                                                "sense_id": "4d4b1aed-7582-3d66-a23b-43dc8541f8d2",
                                                "text": "Il s’agit d’un double système d’écriture phonétique où chaque hiragana correspond à un katakana."
                                            },
                                            {
                                                "example_id": "d44436c8-1e4e-4674-99be-2835569fa511",
                                                "sense_id": "4d4b1aed-7582-3d66-a23b-43dc8541f8d2",
                                                "text": "Et au troisième étage, les mots Club Gaïa en rose fluo sur fond jaune. En caractères romains et en katakana, l’alphabet syllabaire utilisé pour la transcription des termes étrangers."
                                            },
                                            {
                                                "example_id": "0e832d14-4413-4ff4-8e57-6e02a117f6d9",
                                                "sense_id": "4d4b1aed-7582-3d66-a23b-43dc8541f8d2",
                                                "text": "Le nom LEGRAND était gravé en katakana, l’écriture phonétique employée pour écrire les noms d’origine étrangère..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03937a65-2d7d-3321-8ae7-c603a3c58497",
                                        "entry_id": "f1b21e37-d29e-3834-bd57-37e839dc2d39",
                                        "glosses": [
                                            "Syllabaire qui regroupe l’ensemble de ces caractères."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0cae7eb-16f4-4147-87e6-8f3eca53171f",
                                                "sense_id": "03937a65-2d7d-3321-8ae7-c603a3c58497",
                                                "text": "Le Katakana est composé de cinquante caractères représentant chacun une syllabe […]"
                                            },
                                            {
                                                "example_id": "17c5b6e0-fc00-4baa-a902-c3f96da05991",
                                                "sense_id": "03937a65-2d7d-3321-8ae7-c603a3c58497",
                                                "text": "Puis il y a le japonais écrit. En sorte que l’écolier nippon, avant toute chose, doit. d’abord apprendre à parler yamato, à écrire le Katakana […]"
                                            },
                                            {
                                                "example_id": "ccd36eea-a565-438b-a218-4e6a9e044391",
                                                "sense_id": "03937a65-2d7d-3321-8ae7-c603a3c58497",
                                                "text": "J’ai même appris à lire les deux alphabets syllabiques, le katakana et l’hiragana, mais pas les kanji qui sont les idéogrammes que maman connaît."
                                            },
                                            {
                                                "example_id": "824d7434-ae8d-4be7-a235-765481ea8ae2",
                                                "sense_id": "03937a65-2d7d-3321-8ae7-c603a3c58497",
                                                "text": "En même temps, les caractères idéographiques d’origine chinoise (kanji 漢字) pour le sino-japonais kango firent progressivement assimilés par le japonais et donnèrent naissance à deux syllabaires : katakana et hiragana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
