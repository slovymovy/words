                                                "example_id": "16c1de6f-db36-4c63-88d8-5a72a0bcc1d2",
                                                "sense_id": "c9fe4484-b34a-3712-a46d-d42f6ae84448",
                                                "text": "Früher nannte man die Zibbe \"Ramme\" und den Bock \"Ramm\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e1e525f-12ce-34f7-8305-c71aa5defadc",
                                        "entry_id": "ea47e1f4-b592-3fc9-b6a7-a4809c82cb74",
                                        "glosses": [
                                            "ein Werkzeug oder eine Maschine, das/die zum Feststampfen von Erde, Steinen, zum Verdichten von Böden und losem, weichem Untergrund, zum Einrammen von Pfählen, Pflöcken, Spundwänden, zum Aufbrechen von Asphaltdecken, Betonschichten und zum Schmieden bzw. Verformen von Metallen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c95e2de9-48af-4d71-a532-7be77aa7c8cf",
                                                "sense_id": "7e1e525f-12ce-34f7-8305-c71aa5defadc",
                                                "text": "Die Ramme trieb Pflöcke in den Grund."
                                            },
                                            {
                                                "example_id": "c9975151-0cca-41a3-8700-ef3f234ead94",
                                                "sense_id": "7e1e525f-12ce-34f7-8305-c71aa5defadc",
                                                "text": "„Rumm rumm ratscht die Ramme nieder, ich schlage alles, noch eine Schiene.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e555641f-0c48-3c64-8c5a-e14d7aab0a94",
                                        "entry_id": "ea47e1f4-b592-3fc9-b6a7-a4809c82cb74",
                                        "glosses": [
                                            "Rammbug"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d212cb2a-c00b-4d69-b655-7c9548061cd9",
                                                "sense_id": "e555641f-0c48-3c64-8c5a-e14d7aab0a94",
                                                "text": "Im Ersten Weltkrieg wurden die Kriegsschiffe ebenfalls mit Rammen ausgestattet."
                                            },
                                            {
                                                "example_id": "c078b24e-a8bf-469f-9368-d5fcc8587999",
                                                "sense_id": "e555641f-0c48-3c64-8c5a-e14d7aab0a94",
                                                "text": "„Die jungen »Ritter der Tiefe«, nunmehr geschlagen und mit verbundenen Augen, die auf Deutschlands »Wunderwaffe« gefahren waren, waren, bittere Ironie, von einer der ältesten Waffen, die das Arsenal der Marine zu bieten hat, verdroschen worden: der Ramme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ramme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11d87e3c-5489-3f3e-b679-de846834deb1",
                                        "entry_id": "e7becb6b-f3ac-3cc8-ad97-5735d60e9399",
                                        "glosses": [
                                            "männliches Zuchttier der Schafe oder seltener der Ziegen"
                                        ],
                                        "tags": [
                                            "Namibia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c712ed45-13e9-4759-8eb1-4c149d647df2",
                                                "sense_id": "11d87e3c-5489-3f3e-b679-de846834deb1",
                                                "text": "„Ein neuer namibischer Rekord wurde auf der Versteigerung von Philip Strauss erzielt. Insgesamt wurden 75 Ramme zu einem Durchschnittspreis von N$ 12144 verkauft. Ein weiterer Rekord wurde aufgestellt, als 19,,Typ-5-Ramme\" für durchschnittlich N$ 29219 den Besitzer wechselten.“"
                                            },
                                            {
                                                "example_id": "fb7c4689-669c-40c0-bb24-09129c6ea5a0",
                                                "sense_id": "11d87e3c-5489-3f3e-b679-de846834deb1",
                                                "text": "„Nach den Vorlesungen und Erläuterungen zum Thema Weidewirtschaft wurden je fünf gute Ramme der Kleinviehrassen Dorper-Schafe, Karakul-Schafe, Boerbok-Ziegen, Damara-Schafe und Van-Rooy-Schafe zur Auktion angeboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
