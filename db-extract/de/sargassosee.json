                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447ce7ac-bdf3-47a4-98f9-d6ce48d3205c",
                                "sense_id": "8bb65cda-7fd1-3d7f-8433-7746f2583456",
                                "text": "„Randall hatte noch nie das Meer gesehen, aber die Worte des Händlers ließen eine ganze Flotte von Jachten und Kajütbooten und Schnellbooten vor seinen Augen erscheinen. Die Träume und Sehnsüchte von Menschen, herrenlos davontreibend. Eine Sargassosee aufgegebener Wasserfahrzeuge, die sich in einer öden und leeren Meeresregion sammelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
