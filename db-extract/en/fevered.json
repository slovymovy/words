                "senses": [
                    {
                        "sense_id": "8e1e6c9d-5824-3b95-9f74-a53a6bbf6ffe",
                        "entry_id": "e3a8b91a-261a-3878-bdf5-9bf6fb58842d",
                        "glosses": [
                            "Affected by a fever; feverish."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88878474-1a31-34c9-8e17-0ed6c80b409c",
                        "entry_id": "e3a8b91a-261a-3878-bdf5-9bf6fb58842d",
                        "glosses": [
                            "Heated; impassioned; enthusiastic to the point of distraction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0294c2-6271-4fc5-b44c-87ac1d68e3a9",
                                "sense_id": "88878474-1a31-34c9-8e17-0ed6c80b409c",
                                "text": "Amid all the fevered anticipation of this fixture, few would have expected to witness an aesthetically pleasing example of the beautiful game."
                            },
                            {
                                "example_id": "796c001a-8555-4fc2-9840-2a5206cf7440",
                                "sense_id": "88878474-1a31-34c9-8e17-0ed6c80b409c",
                                "text": "To rephrase in less fevered rhetoric, a regional alliance might take shape independent of the U.S."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b423e972-ad5f-48e5-9319-32a8a626016b",
                        "source_entry_id": "e3a8b91a-261a-3878-bdf5-9bf6fb58842d",
                        "source_sense_description": "affected by fever",
                        "target_lang_word": "fiévreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiévreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0084a2-cde1-3626-9102-97e5381f4c13",
                                        "entry_id": "76673815-39dd-3d84-b7db-aa01f67e40a2",
                                        "glosses": [
                                            "Qui cause la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2fa7fe-fe41-426c-bd60-268e6894c117",
                                                "sense_id": "1d0084a2-cde1-3626-9102-97e5381f4c13",
                                                "text": "— Mais le diable a soufflé là-dessus, de son haleine fiévreuse et empestée, et les pires billevesées ont pris leur vol. L'homme a inventé les dieux et il a crée l'amour avec son cortège de sensibleries ridicules ou criminelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2332a7cf-fa83-3ad0-9f2e-857029b79109",
                                        "entry_id": "76673815-39dd-3d84-b7db-aa01f67e40a2",
                                        "glosses": [
                                            "Où les fièvres sont fréquentes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62630830-872f-434d-8d6a-8fd1f3d39ca2",
                                                "sense_id": "2332a7cf-fa83-3ad0-9f2e-857029b79109",
                                                "text": "Pays, climat fiévreux."
                                            },
                                            {
                                                "example_id": "9ed12e2a-f466-4fc2-acc2-9a4d4534d470",
                                                "sense_id": "2332a7cf-fa83-3ad0-9f2e-857029b79109",
                                                "text": "La poche mouillée d’un des garçons cachait le caleçon qu’il avait emporté aux étangs fiévreux […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4854f6d5-4158-3ab2-80f4-8d6e280f709b",
                                        "entry_id": "76673815-39dd-3d84-b7db-aa01f67e40a2",
                                        "glosses": [
                                            "Qui a tendance à avoir de la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5141e816-b013-4220-b303-507be9fa4385",
                                                "sense_id": "4854f6d5-4158-3ab2-80f4-8d6e280f709b",
                                                "text": "Tempérament fiévreux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de31e3b5-619e-340e-8988-af4e9a6d5da0",
                                        "entry_id": "76673815-39dd-3d84-b7db-aa01f67e40a2",
                                        "glosses": [
                                            "Fébrile, qui a de la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d321497d-69b9-4ffe-b144-000fc0dd9b30",
                                                "sense_id": "de31e3b5-619e-340e-8988-af4e9a6d5da0",
                                                "text": "Ainsi que cela se produisait chaque fois qu’il avait trop pompé le jour d’avant, il se sentait la tête un peu fiévreuse, le front chaud, les nerfs excités et la gorge sèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd45f7c-9a11-3a99-b3d6-ca3cb37783d9",
                                        "entry_id": "76673815-39dd-3d84-b7db-aa01f67e40a2",
                                        "glosses": [
                                            "Fébrile, soumis à une agitation intense et désordonnée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df60a00-5de1-4d5a-934d-83f999db2715",
                                                "sense_id": "dbd45f7c-9a11-3a99-b3d6-ca3cb37783d9",
                                                "text": "Les musiciens tirèrent de leurs instruments un air brutal et voluptueux qui, aussitôt, pénétra l’assistance d’une fiévreuse pâmoison."
                                            },
                                            {
                                                "example_id": "14222f02-410f-4d9c-a39b-6d28e8ebf579",
                                                "sense_id": "dbd45f7c-9a11-3a99-b3d6-ca3cb37783d9",
                                                "text": "La nuit s’écoula sans qu’aucun bruit répondît à sa fiévreuse attente."
                                            },
                                            {
                                                "example_id": "29b545c0-5fce-4148-aafe-1b5c0cb9d7af",
                                                "sense_id": "dbd45f7c-9a11-3a99-b3d6-ca3cb37783d9",
                                                "text": "Des scènes inouïes… La collision avec une baleine géante, les tempêtes épouvantables, les voiliers qui s’égarent, la recherche fiévreuse du minerai, les rencontres violentes avec les Inuits, dont l’un, que Frobisher kidnappe, par désespoir ou par défi, se mord la langue jusqu’à la sectionner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fiévreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dff24fae-6709-3acb-9d60-8c263f6ae692",
                                        "entry_id": "3abfc240-666c-3173-9afa-5e1060f2a7c5",
                                        "glosses": [
                                            "Personne ayant de la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b634a1b-6d72-44f7-ae47-a3807a358852",
                                                "sense_id": "dff24fae-6709-3acb-9d60-8c263f6ae692",
                                                "text": "Il y a beaucoup de fiévreux dans cette région."
                                            },
                                            {
                                                "example_id": "52a408db-9cf7-492f-99d4-23832831aec7",
                                                "sense_id": "dff24fae-6709-3acb-9d60-8c263f6ae692",
                                                "text": "J’avais l’impression d’être un médecin qui, tout en écoutant les discours hallucinés d’un fiévreux, contrôle son pouls trop rapide avec méfiance, parce qu’il est inquiet de voir dans cette fièvre la preuve clinique la plus flagrante d’un dérangement cérébral."
                                            },
                                            {
                                                "example_id": "7e298492-89ee-413f-b51b-308185e8c473",
                                                "sense_id": "dff24fae-6709-3acb-9d60-8c263f6ae692",
                                                "text": "Les anémiques, les fiévreux,\nEt les poitrinaires cireux,\nAutomates cadavéreux\nÀ la voix trouble,\nTous attendent avec effroi\nLe retour de ce frisson froid\nEt monotone qui décroît\nEt qui redouble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8f675e7-eb6a-4ad0-be17-f3f1732cccfa",
                        "source_entry_id": "e3a8b91a-261a-3878-bdf5-9bf6fb58842d",
                        "source_sense_description": "impassioned",
                        "target_lang_word": "enflammé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enflammé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8516aa78-426f-33f4-9870-6f54b144c777",
                                        "entry_id": "b83371c0-8ca0-37f8-ad7e-172a94460627",
                                        "glosses": [
                                            "Qui a pris feu."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52572504-ccd1-4578-9182-2ba0709a084c",
                                                "sense_id": "8516aa78-426f-33f4-9870-6f54b144c777",
                                                "text": "Elle prit son temps, elle calcula ses mouvements, et, avec une agilité de chatte, elle saisit les deux interrogatoires et les lança dans le feu ; mais Camusot les y reprit, la comtesse s’élança sur le juge et ressaisit les papiers enflammés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95cb4b8d-70f0-32d3-8c9a-678cbffc0f98",
                                        "entry_id": "b83371c0-8ca0-37f8-ad7e-172a94460627",
                                        "glosses": [
                                            "Qui éprouve une vive passion pour une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df07c06-97a8-4b14-af68-ffd869cfb206",
                                                "sense_id": "95cb4b8d-70f0-32d3-8c9a-678cbffc0f98",
                                                "text": "Tout-à-coup... un énorme lion surgit devant lui, la gueule ouverte, l'oeil enflammé..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1fb9e8-a133-376f-bef2-bcf6f14bec08",
                                        "entry_id": "b83371c0-8ca0-37f8-ad7e-172a94460627",
                                        "glosses": [
                                            "Plein d’amour, qui est inspiré par l’amour."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c311db9e-d883-4e6f-850e-879c03ad49b9",
                                                "sense_id": "4a1fb9e8-a133-376f-bef2-bcf6f14bec08",
                                                "text": "J’irai me baigner à la fontaine où croissent les lys rouges, enflammés comme tes baisers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enflammé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "289cfb75-6806-32ca-ae33-be572fa826cd",
                                        "entry_id": "e87fbaf2-782f-30f2-9425-a3853454317d",
                                        "glosses": [
                                            "Participe passé masculin singulier de enflammer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4870ccb2-50b3-422e-a110-abe2b48c4c71",
                                                "sense_id": "289cfb75-6806-32ca-ae33-be572fa826cd",
                                                "text": "Ton Rouge Baiser, Mélodie, a enflammé ma vie!"
                                            },
                                            {
                                                "example_id": "1e2ecb64-0af3-452b-b07c-b2e74c5365f0",
                                                "sense_id": "289cfb75-6806-32ca-ae33-be572fa826cd",
                                                "text": "Quoi qu’il en soit le capitaine Laurain a d’abord à juger de cette hypothèse « quasi officielle » d’une crémation accidentelle due à une bombe aérosol dont le gaz se serait enflammé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
