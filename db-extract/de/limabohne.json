                        "glosses": [
                            "aus Mittel- und Südamerika stammende Pflanzenart aus der Gattung Phaseolus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b95697d-b205-4b89-a362-85f92cc1e81d",
                                "sense_id": "18a1e9c3-20d2-3660-be6e-540e9c3f93b4",
                                "text": "„Alice bereitete das Steak, die Kartoffeln und die Limabohnen zu, die die Haushälterin vom Markt mitgebracht hatte.“"
                            },
                            {
                                "example_id": "6c152485-6472-4a57-b100-8dd9ac512196",
                                "sense_id": "18a1e9c3-20d2-3660-be6e-540e9c3f93b4",
                                "text": "„Limabohnen oder Tunfisch, später auf dem Klo seh ich das alles wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
