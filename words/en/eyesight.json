            "senses": [
                {
                    "sense_id": "03f63c79-bea5-3a3a-b97c-590d42053291",
                    "sense_definition": "The ability to see; the physical faculty of vision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has excellent <w>eyesight</w> and does not need to wear glasses.",
                            "target_lang_translations": {
                                "es": "Ella tiene una excelente <w>vista</w> y no necesita llevar gafas."
                            }
                        },
                        {
                            "text": "His <w>eyesight</w> began to deteriorate as he got older.",
                            "target_lang_translations": {
                                "es": "Su <w>visión</w> empezó a deteriorarse a medida que envejecía."
                            }
                        }
                    ],
                    "synonyms": [
                        "sight",
                        "vision"
                    ],
                    "antonyms": [
                        "blindness"
                    ],
                    "common_phrases": [
                        "good eyesight",
                        "poor eyesight",
                        "failing eyesight"
                    ],
                    "target_lang_definitions": {
                        "es": "Capacidad o sentido físico de ver; facultad visual."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vista",
                                "target_lang_sense_clarification": "sentido físico o agudeza visual"
                            },
                            {
                                "target_lang_word": "visión",
                                "target_lang_sense_clarification": "facultad de ver"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f76bccb-75aa-312c-b031-2a696c5205cc",
                    "sense_definition": "The distance or area over which one can see; field of view.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship slowly moved further away until it was completely out of <w>eyesight</w>.",
                            "target_lang_translations": {
                                "es": "El barco se alejó lentamente hasta quedar completamente fuera de la <w>vista</w>."
                            }
                        },
                        {
                            "text": "Keep the young children within your <w>eyesight</w> while playing in the park.",
                            "target_lang_translations": {
                                "es": "Mantén a los niños pequeños al alcance de tu <w>vista</w> mientras juegan en el parque."
                            }
                        }
                    ],
                    "synonyms": [
                        "field of vision",
                        "view"
                    ],
                    "common_phrases": [
                        "in eyesight",
                        "out of eyesight",
                        "within eyesight"
                    ],
                    "target_lang_definitions": {
                        "es": "Distancia o área en la que algo se puede ver; campo de visión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vista",
                                "target_lang_sense_clarification": "alcance visual o campo de visión"
                            },
                            {
                                "target_lang_word": "campo visual",
                                "target_lang_sense_clarification": "área visible"
                            }
                        ]
                    }
                }
            ]
        }
    ]
