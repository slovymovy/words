                            },
                            {
                                "target_word": "Leipziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65fd5c18-bb88-3a39-a4ec-245547a83a10",
                                        "entry_id": "21d9d4a5-1434-3c10-bcc1-c30957d073fa",
                                        "glosses": [
                                            "sich auf die Stadt Leipzig beziehend, in der Art und Weise dieses Ortes, aus Leipzig kommend, stammend, Leipzig betreffend, zu Leipzig gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf6037c-b78b-4c2b-a3eb-80ded829ec0a",
                                                "sense_id": "65fd5c18-bb88-3a39-a4ec-245547a83a10",
                                                "text": "Die Leipziger Universität wurde 1409 gegründet."
                                            },
                                            {
                                                "example_id": "10991b7b-9574-49dc-9de2-09a8d0da1389",
                                                "sense_id": "65fd5c18-bb88-3a39-a4ec-245547a83a10",
                                                "text": "„Die Leipziger Oberpostmeister forderten immer wieder, auch für die Oberlausitz die Verantwortung übertragen zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Leipziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                        "entry_id": "fbd85397-f00b-377f-8fac-7e752f525d8c",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da6c70b-b922-4868-8280-c3f106a47717",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Frau Leipziger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "424fb496-2e6a-4e3e-b703-b3f1ef93cad3",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Herr Leipziger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4f2a70eb-2e2f-46d3-b3ae-1e9b4be3219a",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Die Leipzigers fliegen heute nach Bali."
                                            },
                                            {
                                                "example_id": "c7440471-dfc1-4792-abda-f6af37c3192a",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Der Leipziger trägt nie die Pullover, die die Leipzigerihm strickt."
                                            },
                                            {
                                                "example_id": "01a83452-b3da-47fe-9d5c-c78f2d8ffc40",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leipziger kommt, geht der Herr Leipziger.“"
                                            },
                                            {
                                                "example_id": "bb814c47-eb97-490a-9dc5-2c7779bf3be2",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Leipziger kommt und geht."
                                            },
                                            {
                                                "example_id": "0e068f3f-41c7-436e-9290-b9826325266a",
                                                "sense_id": "58928298-2b23-325d-85e4-0ebd191b9e85",
                                                "text": "Leipzigers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
