                ],
                "senses": [
                    {
                        "sense_id": "5f52ff1b-f4bf-32f2-806a-790ea1db8e04",
                        "entry_id": "b9165729-a2e0-3e4e-b5fe-fbae320ab49f",
                        "glosses": [
                            "Titel des Regierungschefs zu verschiedenen Zeiten in unterschiedlichen Staatssystemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394a071f-2480-4531-ae71-d8f12a7c8353",
                                "sense_id": "5f52ff1b-f4bf-32f2-806a-790ea1db8e04",
                                "text": "„Am 13. März dankte in Wien der Reichskanzler Fürst von Metternich ab, das leibhaftige Symbol des Ancien Régime.“"
                            },
                            {
                                "example_id": "b0e81981-1eb3-4a20-93ad-8bb654cc23bc",
                                "sense_id": "5f52ff1b-f4bf-32f2-806a-790ea1db8e04",
                                "text": "„Die Eröffnungsrede hält der Reichskanzler.“"
                            },
                            {
                                "example_id": "224828ed-9593-447e-9917-21d652c38af7",
                                "sense_id": "5f52ff1b-f4bf-32f2-806a-790ea1db8e04",
                                "text": "„Der deutsche Reichskanzler Otto von Bismarck übernahm die Vermittlerrolle, und im Laufe des Sommers 1878 wurde im Berliner Kongress unter hohem Druck der europäischen Großmächte der Berliner Vertrag geschlossen, durch den Russlands Kriegsbeute drastisch beschnitten wurde.“"
                            },
                            {
                                "example_id": "a6255c3f-d6b1-49af-a246-c00666bfc450",
                                "sense_id": "5f52ff1b-f4bf-32f2-806a-790ea1db8e04",
                                "text": "„Allerdings stemmte sich der Reichskanzler auch nicht gegen den Zeitgeist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
