                        "examples": [
                            {
                                "example_id": "4443ede0-018c-4cb3-8ed6-5a6fdf43ce9c",
                                "sense_id": "d34d2d7b-3b5f-3836-a490-96d44b851428",
                                "text": "The Bones of the Fingers are articulated by Ginglymus, and are fifteen in each Hand."
                            },
                            {
                                "example_id": "6aa521a3-1e4b-4069-b905-61badd5b20a8",
                                "sense_id": "d34d2d7b-3b5f-3836-a490-96d44b851428",
                                "text": "The Ginglymus is, when a Bone receives and is received; and the Property of this Sort of Articulation is to admit only of the Motions of the Flexion and Extension: It is called by Tradesmen Charnall, and it is commonly used in Hinges."
                            }
                        ]
                    }
