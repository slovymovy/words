                                    {
                                        "sense_id": "91740238-424b-336d-9ba9-731d2f9cc2d4",
                                        "entry_id": "fcba3cfe-479a-37ea-ae7e-38d4cd34fea7",
                                        "glosses": [
                                            "Personne chargée de l'organisation d'un événement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ca2ba0-2eaf-46d6-be0a-5bd3dc2b7aa8",
                                                "sense_id": "91740238-424b-336d-9ba9-731d2f9cc2d4",
                                                "text": "Cet homme, c'est le grand, l'unique Pelletier, ancien tenancier de maisons closes, ancien organisateur de partouzes, ancien marchand de viande..."
                                            },
                                            {
                                                "example_id": "458ac4be-7a10-491a-99f3-af0bb9a983f2",
                                                "sense_id": "91740238-424b-336d-9ba9-731d2f9cc2d4",
                                                "text": "Artus de la Fontaine Solaro, baron d’Oignon était l’organisateur des fêtes et cérémonies sous le règne des rois de France Henri II, François II, Charles IX et Henri III."
                                            }
                                        ]
                                    }
                                ]
