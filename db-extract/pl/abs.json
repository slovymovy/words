                                "target_senses": [
                                    {
                                        "sense_id": "cffb3815-b7ef-3451-a8d5-7e2505d8b8f4",
                                        "entry_id": "2adffca3-39ad-351d-ac59-9426a031c6d5",
                                        "glosses": [
                                            "remsysteem waarbij de wielen blijven draaien en dus niet gaan slippen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57507edc-5a48-4fd0-842b-117b607ff6eb",
                                                "sense_id": "cffb3815-b7ef-3451-a8d5-7e2505d8b8f4",
                                                "text": "Basis van het systeem is een reeks sensoren die tientallen variabelen in het rijgedrag toetsen. Deze variabelen worden in een computer continu vergeleken met een model van ideaal rijgedrag. Aan de hand daarvan kunnen correcties worden uitgevoerd. Bijvoorbeeld: het antiblokkeersysteem, ABS, zorgt ervoor dat op de wielen precies zóveel remkracht wordt uitgeoefend dat ze nog nét niet slippen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312e673e-4809-3ed3-9862-be81b2a6d085",
                                        "entry_id": "2adffca3-39ad-351d-ac59-9426a031c6d5",
                                        "glosses": [
                                            "bepaalde harde, stevige kunststof, vaak gebruikt voor behuizingen van apparaten, voor legoblokjes en voor 3D-printen"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10588e4b-7adf-4bee-9c20-6b014176ad64",
                                                "sense_id": "312e673e-4809-3ed3-9862-be81b2a6d085",
                                                "text": "De fabrieken die DSM kwijt wil maken de slagvaste kunststof ABS, die onder meer wordt toegepast in auto-interieurs en voor omhulsels van stofzuigers, haardrogers en computers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
