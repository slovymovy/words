                        "glosses": [
                            "Boasting; blustering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35b24ad-306f-4457-84bd-5ec8a76d6810",
                                "sense_id": "7a7d08eb-2ff7-346e-88ac-e459575c34e6",
                                "text": "All these valorous vapourings had a considerable effect in convincing certain profound sages, many of whom began to think the general a hero of unutterable loftiness and magnanimity of soul, particularly as he was continually protesting on the honour of a soldier—a marvellously high sounding asseveration."
                            },
                            {
                                "example_id": "024a2b8f-a091-4f67-82c9-9a83e4840d91",
                                "sense_id": "7a7d08eb-2ff7-346e-88ac-e459575c34e6",
                                "text": "Here, take thy satin pincushion, with thy curious half-hundred of pins in it, that you made such a vapouring about yesterday; tell them carefully, there's not one wanting."
                            },
                            {
                                "example_id": "79bce170-b269-4a5d-afa0-14cf8cee7d47",
                                "sense_id": "7a7d08eb-2ff7-346e-88ac-e459575c34e6",
                                "text": "I see– but fie, thou brainish Muse! what mean These vapourings, and brags of what by thee is seen?"
                            }
                        ]
                    }
                ],
