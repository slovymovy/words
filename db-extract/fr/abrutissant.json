                        "glosses": [
                            "Qui abrutit, qui est propre à abrutir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7670ba50-689b-40da-be2c-2c36525502d4",
                                "sense_id": "9dd4e24b-abc2-3dfa-ad12-f10028be7b8b",
                                "text": "Un genre de vie abrutissant."
                            },
                            {
                                "example_id": "ccddb396-b611-469d-b133-a96b42b91875",
                                "sense_id": "9dd4e24b-abc2-3dfa-ad12-f10028be7b8b",
                                "text": "Des plaisirs abrutissants."
                            },
                            {
                                "example_id": "31e5811c-9ce9-4c36-bbd8-ac77d52e965e",
                                "sense_id": "9dd4e24b-abc2-3dfa-ad12-f10028be7b8b",
                                "text": "Cette occupation est abrutissante."
                            },
                            {
                                "example_id": "a6e34794-d7f5-4a27-8a7b-e915310b0d39",
                                "sense_id": "9dd4e24b-abc2-3dfa-ad12-f10028be7b8b",
                                "text": "On n’est pas faible, quand on reste maître de soi au sein des voluptés les plus abrutissantes."
                            },
                            {
                                "example_id": "472dc0bf-3087-4096-8bb4-78b31ede3254",
                                "sense_id": "9dd4e24b-abc2-3dfa-ad12-f10028be7b8b",
                                "text": "La proportion croissante de reporters dans le journal quotidien tend à accréditer l’image du journaliste sous-payé qui fait un travail abrutissant."
                            }
                        ]
                    }
                ],
