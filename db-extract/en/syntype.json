                        "glosses": [
                            "Any one of two or more specimens specified in the description of a species (or lower-order taxon), where no specimen has been designated as holotype."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9af6822-fd6f-4836-8590-b59bf8fe5e43",
                                "sense_id": "dae16cc3-fb31-3f88-bb48-b12df35935a4",
                                "text": "Noting two syntypes of hoplomystax with 1 instead of 2 midventral scales posterior to the origin of the pelvics, and the unusual color of S. abbotti, Dr. Bohlke kindly sent these fishes on loan."
                            },
                            {
                                "example_id": "e54c7512-6842-46d2-9992-61688d56ad1c",
                                "sense_id": "dae16cc3-fb31-3f88-bb48-b12df35935a4",
                                "text": "1999, Raina L. Takumi, A Systematic Review of the Ectemnius (Hymenoptera: Sphecidae) of Hawaii, University of California Publications in Entomology, Volume 118, University of California Press, page 49,\nOf the specimens examined, 38 (20♂, 18♀) were collected by Perkins prior to 1899 and are possible syntypes."
                            },
                            {
                                "example_id": "26d950fb-b9c0-4aaf-8028-82c14df983cb",
                                "sense_id": "dae16cc3-fb31-3f88-bb48-b12df35935a4",
                                "text": "One ♂ syntype is in the Zoological Museum, Berlin [ZMB 17714] – see Moritz & Fischer (1981)."
                            }
                        ]
                    }
