                "senses": [
                    {
                        "sense_id": "d1f890b9-3484-348d-a269-12da73c4be0b",
                        "entry_id": "b2e5e0c2-d188-30fb-b647-3a3e271fc49e",
                        "glosses": [
                            "An automobile."
                        ],
                        "tags": [
                            "US",
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5ac22641-a6e5-4803-9a5f-8b78c59ab041",
                                "sense_id": "d1f890b9-3484-348d-a269-12da73c4be0b",
                                "text": "\"Phoney\" Thorpe, '06, and \"Shorty\" Winchester, '01, have been driving their \"90 HP Gazumps\" through the wilds of New Jersey, but otherwise keeping on the job."
                            },
                            {
                                "example_id": "a51c8f22-40f6-495a-bce8-987caae8f69a",
                                "sense_id": "d1f890b9-3484-348d-a269-12da73c4be0b",
                                "text": "Go out and hire the finest gazump that ever burned benzine."
                            }
                        ]
                    },
                    {
                        "sense_id": "4aee604d-667c-3835-b98d-6c94da1ac17e",
                        "entry_id": "b2e5e0c2-d188-30fb-b647-3a3e271fc49e",
                        "glosses": [
                            "A politician who takes bribes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6aa8d7-e000-467b-abd9-f8523da4f992",
                                "sense_id": "4aee604d-667c-3835-b98d-6c94da1ac17e",
                                "text": "This year's crop of \"nite bloomin' wood-be mayors\" includes such famous gazumps as Mac Hoyne, Tom Carey, Barney Mullaney, possibly Carter H., Wilhelm Thompson, and the devil knows who else."
                            },
                            {
                                "example_id": "72c2b7f6-f5fd-45f2-b472-887d7a7fc2a3",
                                "sense_id": "4aee604d-667c-3835-b98d-6c94da1ac17e",
                                "text": "Go fifty-fifty. / If they nail you call in a mouthpiece. / Fix it, you gazump, you slant-head, fix it. / Feed 'em. …"
                            }
                        ]
                    }
                ],
