                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e2a8c2b-e102-3d73-8f65-3af493a10679",
                        "entry_id": "ee41fd30-d6a5-3af7-b80f-298e5291553d",
                        "glosses": [
                            "der Tadel, die Verunglimpfung, die Schmähung"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94c8f022-7dcc-4a41-af66-3767687a97cd",
                        "source_entry_id": "ee41fd30-d6a5-3af7-b80f-298e5291553d",
                        "source_sense_id": "1e2a8c2b-e102-3d73-8f65-3af493a10679",
                        "source_sense_description": "veraltet: der Tadel, die Verunglimpfung, die Schmähung",
                        "target_lang_word": "Tadel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tadel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80e299e8-fa27-3c49-90f6-67d021ea2496",
                                        "entry_id": "92806ef8-dd6b-3113-ba27-0ee6fdc5cf10",
                                        "glosses": [
                                            "Erziehungsmaßnahme mit verhaltenskorrigierender Funktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3375d82a-40ce-4ff3-97d3-8b91ff76c82d",
                                                "sense_id": "80e299e8-fa27-3c49-90f6-67d021ea2496",
                                                "text": "Der Lehrer sprach einen Tadel gegenüber den Schülern aus."
                                            },
                                            {
                                                "example_id": "67ccc7e3-fad9-4c64-9baa-f040b1a3337a",
                                                "sense_id": "80e299e8-fa27-3c49-90f6-67d021ea2496",
                                                "text": "„Goldlotos schwieg zu dem Tadel.“"
                                            },
                                            {
                                                "example_id": "b0457156-e1b2-4759-84ff-1e950cb91ab9",
                                                "sense_id": "80e299e8-fa27-3c49-90f6-67d021ea2496",
                                                "text": "„Sie lachte herzlich, denn der Ton, in dem St. Armaud dies sagte, klang durchaus liebenswürdig und jedenfalls ebenso frei von Gereiztheit wie Tadel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "464d7332-876f-4cca-9e80-4ea1f107bc8c",
                        "source_entry_id": "ee41fd30-d6a5-3af7-b80f-298e5291553d",
                        "source_sense_id": "1e2a8c2b-e102-3d73-8f65-3af493a10679",
                        "source_sense_description": "veraltet: der Tadel, die Verunglimpfung, die Schmähung",
                        "target_lang_word": "Verunglimpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verunglimpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                        "entry_id": "143c7379-3e0a-3471-90a8-cdd90e765236",
                                        "glosses": [
                                            "Herabsetzung, Verächtlichmachung von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63292ca3-ac82-4862-9a6d-3079ef3e7601",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Seit Mitte des 19. Jahrhunderts wurde es zur Verunglimpfung von Personen verwendet.“"
                                            },
                                            {
                                                "example_id": "78c92635-1df6-43ea-a677-5639c4d26389",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Der sogenannte Blasphemieartikel 295 a-c des pakistanischen Strafgesetzbuchs stellt die Schändung religiöser Texte jeder Religionsgruppe unter Strafe. Auf die Verunglimpfung des Korans steht lebenslange Haft, auf die des Propheten die Todesstrafe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cee11c7b-4392-4a17-b8ef-9d7f641aaf1d",
                        "source_entry_id": "ee41fd30-d6a5-3af7-b80f-298e5291553d",
                        "source_sense_id": "1e2a8c2b-e102-3d73-8f65-3af493a10679",
                        "source_sense_description": "veraltet: der Tadel, die Verunglimpfung, die Schmähung",
                        "target_lang_word": "Schmähung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmähung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a15c6835-fb82-3940-a722-54589fccb815",
                                        "entry_id": "ed47389e-864e-3596-ac28-6d02c30b990b",
                                        "glosses": [
                                            "Handlung, jemanden oder etwas zu beleidigen und verächtlich zu machen, beleidigende Worte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d266bccf-a949-418d-81d5-c1f4cb8aa5d0",
                                                "sense_id": "a15c6835-fb82-3940-a722-54589fccb815",
                                                "text": "Der Mann stieß laute Schmähungen aus."
                                            },
                                            {
                                                "example_id": "385c4f12-ba54-4f7e-8aed-12a85a6df6e4",
                                                "sense_id": "a15c6835-fb82-3940-a722-54589fccb815",
                                                "text": "„Meine Schmähungen endeten mit dem Dunkel der Nacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b1bb28b-fe93-3e99-8f36-57923e4ec4b9",
                                        "entry_id": "ed47389e-864e-3596-ac28-6d02c30b990b",
                                        "glosses": [
                                            "Ergebnis von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb45df16-22d9-4cf7-9604-e75f6a9fb095",
                                                "sense_id": "2b1bb28b-fe93-3e99-8f36-57923e4ec4b9",
                                                "text": "„Glücklich sollten sich diejenigen schätzen, die trotz dieser Schmähung nicht im Gulag landeten.“"
                                            },
                                            {
                                                "example_id": "da6f1875-55e9-4da2-8987-8c73f370d0ce",
                                                "sense_id": "2b1bb28b-fe93-3e99-8f36-57923e4ec4b9",
                                                "text": "„Als er dann einen seiner Knechte bemerkte, überschüttete er ihn mit Schmähungen, weil er ihn nicht benachrichtigt hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
