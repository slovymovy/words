                        "glosses": [
                            "het verzekeren van de risico's die een verzekeringsmaatschappij loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0288413-e745-416a-b3ad-121f9b06b2b8",
                                "sense_id": "f113f249-bf82-38fe-8098-2c147f0f0584",
                                "text": "Lloyd's of London is een zogenoemde markt voor verzekeringen. Tot de klanten behoren een groot aantal verzekeraars, die zich bij Lloyd's herverzekeren tegen risico's."
                            },
                            {
                                "example_id": "4400b680-e95b-4426-8c99-230f4ecd58d9",
                                "sense_id": "f113f249-bf82-38fe-8098-2c147f0f0584",
                                "text": "De desinvestering levert een eenmalige bate van 50 miljoen dollar op voor de kapitaalpositie van Aegon-dochter Transamerica. Er is verder afgesproken dat levensverzekeringsdochters van Transamerica voor een bedrag van 700 miljoen dollar aan aansprakelijkheden aan SCOR zullen herverzekeren."
                            },
                            {
                                "example_id": "065b4b4a-c7cf-4742-a35a-202244bd405b",
                                "sense_id": "f113f249-bf82-38fe-8098-2c147f0f0584",
                                "text": "IptiQ herverzekert risico’s op zorgpolissen bij Swiss Re. Zo verdient het moederbedrijf toch aan de stap in de Nederlandse zorgverzekeringsmarkt."
                            }
                        ]
                    }
