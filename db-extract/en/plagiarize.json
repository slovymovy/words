                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                        "entry_id": "84ad30f0-0539-316f-b0d4-42f4ed54eabe",
                        "glosses": [
                            "To use, and pass off as one's own, someone else's writing, speech, ideas, or other intellectual or creative work, especially in an academic context; to commit plagiarism."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bc6af919-1725-4eb4-a1b2-181d96203afe",
                                "sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                                "text": "It’s unethical to plagiarize someone else’s work for personal gain."
                            },
                            {
                                "example_id": "90efaaf1-7bcf-4230-ab8f-89cf64e1eaa3",
                                "sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                                "text": "Students should learn to write in their own words and avoid plagiarizing."
                            },
                            {
                                "example_id": "3533ac93-4d35-48ee-b4ea-632780ed5af3",
                                "sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                                "text": "She was caught trying to plagiarize an article for her thesis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0531acc7-0101-4cf8-975c-3addceb8b2c6",
                        "source_entry_id": "84ad30f0-0539-316f-b0d4-42f4ed54eabe",
                        "source_sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                        "source_sense_description": "use, and pass off as one's own, someone else's writing/speech",
                        "target_lang_word": "plagier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plagier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6f3d66-a5ed-38c1-9463-a336f5b50fc6",
                                        "entry_id": "9fcda831-eb59-37ba-8377-7b4b73f79dfb",
                                        "glosses": [
                                            "Emprunter à d’autres auteurs des passages de quelque importance en les donnant comme siens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2969cd91-d903-4128-8feb-00153cc1c0ab",
                                                "sense_id": "6f6f3d66-a5ed-38c1-9463-a336f5b50fc6",
                                                "text": "Il se souvint tout à coup d'une vieille chronique où il avait […] projeté le feu rouge des catachrèses les plus imprévues, des synecdoches les plus arbitraires, des antonomases les plus follement tirées par les cheveux, imitant et plagiant même, en ces débordements insensés, la phraséologie vitupérante et l'inouïssime du dénommé Léon Bloy, magicien de l'Expression, […]."
                                            },
                                            {
                                                "example_id": "7d324e0a-7967-4c5b-bd21-832b981df396",
                                                "sense_id": "6f6f3d66-a5ed-38c1-9463-a336f5b50fc6",
                                                "text": "Un an avant, le ministre de la Défense Karl-Theodor zu Guttenberg, jeune espoir de la CSU (Parti chrétien-social), démissionne pour avoir plagié une partie de sa thèse de doctorat en droit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66b8478a-97bc-4932-8160-ed80c226703d",
                        "source_entry_id": "84ad30f0-0539-316f-b0d4-42f4ed54eabe",
                        "source_sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                        "source_sense_description": "use, and pass off as one's own, someone else's writing/speech",
                        "target_lang_word": "plagiieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plagiieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84c6fb6b-e8c5-3876-8277-8cbd011bc3e8",
                                        "entry_id": "210b32c7-d341-3eca-ac95-5da8c73c699d",
                                        "glosses": [
                                            "ein Plagiat begehen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d959bd90-8747-4ba9-a94b-ca58d60bb49c",
                                                "sense_id": "84c6fb6b-e8c5-3876-8277-8cbd011bc3e8",
                                                "text": "Seine zeitweise beachtlichen Popularitätswerte litten, als bekannt wurde, dass er in seiner Dissertation plagiierte."
                                            },
                                            {
                                                "example_id": "0ba7b3bb-8513-4f02-84da-2ac3d4deff97",
                                                "sense_id": "84c6fb6b-e8c5-3876-8277-8cbd011bc3e8",
                                                "text": "Plagiieren ist einfacher als je zuvor. Die Leute geben sich nur mehr Mühe."
                                            },
                                            {
                                                "example_id": "1e61024e-a02b-4321-98fe-56dfcd525d32",
                                                "sense_id": "84c6fb6b-e8c5-3876-8277-8cbd011bc3e8",
                                                "text": "Schüler und Studenten plagiieren mitunter Texte, die in einer anderen Sprache geschrieben wurden."
                                            },
                                            {
                                                "example_id": "0966913d-515b-4864-9c2c-ee918ae55211",
                                                "sense_id": "84c6fb6b-e8c5-3876-8277-8cbd011bc3e8",
                                                "text": "Es muss Will Vesper wohl entgangen sein, dass diese Strophe aus einem Gedicht von Heinrich Heine stammt, den Gustav Wesen mit großem Erfolg für seine Tanten plagiierte."
                                            },
                                            {
                                                "example_id": "8f072d77-af3e-48da-b539-6a412d66d654",
                                                "sense_id": "84c6fb6b-e8c5-3876-8277-8cbd011bc3e8",
                                                "text": "Plagiieren ist kein Kavaliersdelikt, sondern kann erhebliche Rechtsfolgen nach sich ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eadb27f5-fad9-4631-abaf-e1c835e538d4",
                        "source_entry_id": "84ad30f0-0539-316f-b0d4-42f4ed54eabe",
                        "source_sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
