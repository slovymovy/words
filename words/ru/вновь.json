{
    "word_family": [
        "новый",
        "новизна",
        "новинка",
        "обновить",
        "возобновить",
        "новость"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "09bff91f-c802-368a-b028-1232f412251d",
                    "sense_definition": "Снова, ещё раз; повторение действия или события.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Правительство <w>вновь</w> призывает народ к спокойствию и порядку.",
                            "target_lang_translations": {
                                "en": "The government <w>once again</w> calls on the people for calm and order.",
                                "zh": "政府<w>再次</w>呼吁民众保持冷静和秩序。"
                            }
                        },
                        {
                            "text": "Для меня большая честь встретиться с вами <w>вновь</w>.",
                            "target_lang_translations": {
                                "en": "It is a great honor for me to meet with you <w>again</w>.",
                                "zh": "能与您<w>再次</w>见面，我深感荣幸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "снова",
                        "опять",
                        "ещё раз"
                    ],
                    "common_phrases": [
                        "вновь и вновь",
                        "увидеть вновь",
                        "вернуться вновь"
                    ],
                    "target_lang_definitions": {
                        "en": "Again, once more; a repetition of an action or event.",
                        "zh": "再次，又一次；表示动作或事件的重复。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "indicating a repeat of an action"
                            },
                            {
                                "target_lang_word": "once again",
                                "target_lang_sense_clarification": "one more time; emphatic"
                            },
                            {
                                "target_lang_word": "anew",
                                "target_lang_sense_clarification": "in a new or different way; formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再次",
                                "target_lang_sense_clarification": "表示动作的重复，较为正式"
                            },
                            {
                                "target_lang_word": "又",
                                "target_lang_sense_clarification": "表示动作的重复，口语中常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d95683c2-302f-3ae5-a069-07fb6bcdd389",
                    "sense_definition": "Только что, совсем недавно (обычно при причастиях).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recently",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В совет директоров <w>вновь</w> образованной компании вошли опытные специалисты.",
                            "target_lang_translations": {
                                "en": "Experienced specialists joined the board of directors of the <w>newly</w> formed company.",
                                "zh": "经验丰富的专家加入了这家<w>新</w>成立公司的董事会。"
                            }
                        },
                        {
                            "text": "Все <w>вновь</w> прибывшие гости сразу проходили в главный зал.",
                            "target_lang_translations": {
                                "en": "All <w>newly</w> arrived guests went straight to the main hall.",
                                "zh": "所有<w>新</w>到的客人都直接进入了主厅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "недавно"
                    ],
                    "common_phrases": [
                        "вновь созданный",
                        "вновь открывшийся",
                        "вновь избранный"
                    ],
                    "target_lang_definitions": {
                        "en": "Just now, very recently (usually used with participles).",
                        "zh": "刚刚，最近（通常与分词或形容词连用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "newly",
                                "target_lang_sense_clarification": "very recently; typically used with participles like 'formed' or 'arrived'"
                            },
                            {
                                "target_lang_word": "recently",
                                "target_lang_sense_clarification": "in the recent past"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新",
                                "target_lang_sense_clarification": "表示刚刚发生或形成的，常用于复合词"
                            },
                            {
                                "target_lang_word": "新近",
                                "target_lang_sense_clarification": "表示最近一段时间内"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}