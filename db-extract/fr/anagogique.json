                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c998285b-dc46-4dca-8328-9d338fed915c",
                                "sense_id": "437b0f8d-7286-3757-9523-b528d4bc215f",
                                "text": "Interprétation anagogique."
                            },
                            {
                                "example_id": "71b2c9ea-c5ad-47a2-9df0-78a7159c2508",
                                "sense_id": "437b0f8d-7286-3757-9523-b528d4bc215f",
                                "text": "Pour distinguer le sens anagogique des phrases hébraïques chez les prophètes."
                            },
                            {
                                "example_id": "67342050-f888-4dc2-8e07-810ea9fbfbdd",
                                "sense_id": "437b0f8d-7286-3757-9523-b528d4bc215f",
                                "text": "Les mélodies [du chant liturgique chrétien des Gaules] s'inscrivent dans des modes aux intonations justes (et non tempérées); (...) les intonations justes permettent de rendre à chaque mode son \"éthos\", sa sensibilité, et peut-être sa fonction anagogique."
                            }
                        ]
