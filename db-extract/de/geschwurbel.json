                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f4ec7f3-c23d-3c19-9f8f-17792a2d1a0a",
                        "entry_id": "21076c32-7e50-3a0e-bf77-e44bbcc45619",
                        "glosses": [
                            "unverständliche, realitätsferne oder ideologisch überfrachtete Aussagen, beispielsweise in Politik oder Werbung"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "bcc9647a-0dcb-49e7-bd3e-0773cb7cc065",
                                "sense_id": "2f4ec7f3-c23d-3c19-9f8f-17792a2d1a0a",
                                "text": "„Wenn man das Geschwurbel entfernt, strebt der Inhalt gegen unter Null. Weg damit.“"
                            },
                            {
                                "example_id": "487b838e-85e0-4ce7-96ad-222e3f905a25",
                                "sense_id": "2f4ec7f3-c23d-3c19-9f8f-17792a2d1a0a",
                                "text": "„Neben dem üblichen politischen Geschwurbel solcher Papiere (‚Ziel muss es sein, dass Deutschland Automobilland Nr. 1 bleibt‘), langt Schulz durchaus in die Wunden: Es müssen endlich die Verfahrenstricks gestoppt werden, die Abgasmanipulationen durch die Hersteller entscheidend erleichtert haben.“"
                            },
                            {
                                "example_id": "c53d9557-116b-4a50-9031-4529ccf47c28",
                                "sense_id": "2f4ec7f3-c23d-3c19-9f8f-17792a2d1a0a",
                                "text": "„Andrea Schurian meint, das ‚Geschwurbel der Documenta-Chefin Carolyn Christov-Bakargiev über Wahlrecht für Hunde, Emanzipation von Erdbeeren und Kunstverständnis von Meteoriten‘ wäre ‚bestens dazu angetan, zeitgenössische Kunst mit einem abschätzigen Lächeln und dem, Prädikat ›naturtrüb‹ abzutun‘ und zitiert den Quantenphysiker Anton Zeilinger, der die so beschriebene Position Christov-Bakargievs als ‚künstlerische Meinung‘ begreife, die er als Wissenschaftler lieber nicht kommentieren wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65bbb423-a518-4fe2-b28a-5ea53278963a",
                        "source_entry_id": "21076c32-7e50-3a0e-bf77-e44bbcc45619",
                        "source_sense_id": "2f4ec7f3-c23d-3c19-9f8f-17792a2d1a0a",
                        "source_sense_description": "unverständliche, realitätsferne oder ideologisch überfrachtete Aussagen",
                        "target_lang_word": "mumbo jumbo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mumbo jumbo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18539030-5415-3fed-9196-0d39717e80fc",
                                        "entry_id": "81c33cb5-7730-3cff-8aae-195f0e0008e0",
                                        "glosses": [
                                            "A deity or other supernatural being said to have been worshipped by certain West African peoples; an idol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d5abd6-d1e2-47ee-8934-7e55ed69c473",
                                                "sense_id": "18539030-5415-3fed-9196-0d39717e80fc",
                                                "text": "So likewise a day comes when the Runic Thor, with his Eddas, must withdraw into dimness; and many an African Mumbo-Jumbo and Indian Pawpaw be utterly abolished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6bff29-8d34-3c27-82cd-72c7ecafcc7e",
                                        "entry_id": "81c33cb5-7730-3cff-8aae-195f0e0008e0",
                                        "glosses": [
                                            "Any object of superstition; religious words and/or actions which are seen as superstitious or fraudulent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc331e3-ebf5-4ae2-9272-f55957a0d98d",
                                                "sense_id": "fe6bff29-8d34-3c27-82cd-72c7ecafcc7e",
                                                "text": "Rev. Quack's healing services are little more than mumbo jumbo."
                                            },
                                            {
                                                "example_id": "02919576-8768-4369-90b3-256950f81c30",
                                                "sense_id": "fe6bff29-8d34-3c27-82cd-72c7ecafcc7e",
                                                "text": "\"And what have you got to say? Another lot of mumbo-jumbo like your learned associates over there?\""
                                            },
                                            {
                                                "example_id": "3c45f9bc-3b3d-49dc-ac20-450b630815f0",
                                                "sense_id": "fe6bff29-8d34-3c27-82cd-72c7ecafcc7e",
                                                "text": "What is going on in all this religious mumbo-jumbo that is so foreign to the positivism of contemporary scholarship is a reenactment of the history of the soul before the beginning of terrestrial evolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c5461a-3697-3a45-aff2-e0ae62f2a52a",
                                        "entry_id": "81c33cb5-7730-3cff-8aae-195f0e0008e0",
                                        "glosses": [
                                            "Any confusing or meaningless speech; nonsense, gibberish."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079d26a4-6c2e-435c-9952-fa9cbe771540",
                                                "sense_id": "59c5461a-3697-3a45-aff2-e0ae62f2a52a",
                                                "text": "Football lingo is mumbo jumbo to me."
                                            },
                                            {
                                                "example_id": "1b5728e3-0861-454f-bd17-4f57a451b8bd",
                                                "sense_id": "59c5461a-3697-3a45-aff2-e0ae62f2a52a",
                                                "text": "He escaped from that experience confounded, horrified, and conscious of degradation. Those infernal bandogs of the law had treated him as a piece of insensate property to their drivelling mumbo-jumbo, as if mere contact with it had robbed him of all rights to the dignity and integrity of his own ego."
                                            },
                                            {
                                                "example_id": "9d6da6fe-75ef-4268-863b-65b61438bd08",
                                                "sense_id": "59c5461a-3697-3a45-aff2-e0ae62f2a52a",
                                                "text": "When it is truly instinct, brain matter, diastole, systole, / Reflex action; when it is finally won; when it is more / Than the gaudy mumbo jumbo of politicians:"
                                            },
                                            {
                                                "example_id": "6f639a1c-409f-4389-97ad-5e4736533351",
                                                "sense_id": "59c5461a-3697-3a45-aff2-e0ae62f2a52a",
                                                "text": "He also said Britain would be “governed by science, not mumbo-jumbo” when looking at whether imported food was acceptable for consumption in the UK."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87882318-9a8e-488d-836c-cff19b4a6079",
                        "source_entry_id": "21076c32-7e50-3a0e-bf77-e44bbcc45619",
                        "source_sense_id": "2f4ec7f3-c23d-3c19-9f8f-17792a2d1a0a",
                        "source_sense_description": "unverständliche, realitätsferne oder ideologisch überfrachtete Aussagen",
                        "target_lang_word": "verbiage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbiage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                        "entry_id": "49747462-2823-396c-b9d6-c0e86a3aa62d",
                                        "glosses": [
                                            "Abondance de paroles qui ne disent presque rien, qui contiennent peu de sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e0782c-a14f-4a65-a91b-ceb21d315127",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "Il n’y a que du verbiage dans ce livre, dans ce discours."
                                            },
                                            {
                                                "example_id": "22b40bf1-7563-4896-98ae-a34099568e6d",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "C’est un verbiage continuel."
                                            },
                                            {
                                                "example_id": "d4bcf06a-6085-4567-96c4-e7fe2e1de47a",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "L’intérieur du marchand de vin tirait mon attention ; une gamine y dormait, le front sur une table de marbre, je reconnus Léonie Gras et me rappelai qu’elle manquait l’école depuis un certain temps. Alors, j’obéis à mon stupide besoin de verbiage."
                                            },
                                            {
                                                "example_id": "83768e27-333e-4bc5-8e34-691f1ba8cb5f",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "Maître Mouche approuvait de la tête en cassant des noisettes. Puis, après tout ce verbiage, il demanda avec un agréable sourire ce que j’avais répondu."
                                            },
                                            {
                                                "example_id": "85f251a7-4f25-461d-a696-64a852a11737",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "Le verbiage ronronnant de Mme Bûche attelée aux maladies de son mari avant d’étaler les siennes propres empêchait Henri de penser."
                                            },
                                            {
                                                "example_id": "c670ffdd-c092-4318-b637-f71022d18136",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "Il n'est pas nécessaire d'écrire comme Victor Hugo, Marcel Proust ou Honoré de Balzac. Nos pouces risqueraient la tendinite, et en matière de textos, il est même de bon ton d'éviter le verbiage."
                                            },
                                            {
                                                "example_id": "ef1fffdf-23d7-4bda-885d-cf57552cf2a1",
                                                "sense_id": "ae3db0b1-507b-313f-b510-8f78fd79df47",
                                                "text": "Une réunion, organisée vendredi dernier, et à laquelle plus de deux cents personnes ont participé, à même failli tourner à la foire d’empoigne : « Ce n’est que du verbiage », « on nous mène en bateau », « ce sont des lanceurs de poudre aux yeux », s’insurgent des participants."
                                            }
                                        ]
                                    }
                                ]
                            },
