                    }
                ],
                "senses": [
                    {
                        "sense_id": "88251204-072b-347c-b335-63069f25cfc5",
                        "entry_id": "85accb47-13a9-3406-87ae-becbbbcc9d7c",
                        "glosses": [
                            "To make a soft neighing sound characteristic of a horse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dce1a42-ae65-44f6-a7b0-206a30680b13",
                                "sense_id": "88251204-072b-347c-b335-63069f25cfc5",
                                "text": "Behind him, old Akthoob was grumbling loudly, saying something about the midday meal, and Haral, the black Feridoon pony, snuffing in the old, familiar scent of the green meadows of the Chaya's banks, the warm sweet smells of home, was nickering eagerly."
                            },
                            {
                                "example_id": "4459d482-8b53-4268-a1ba-293904aa1d59",
                                "sense_id": "88251204-072b-347c-b335-63069f25cfc5",
                                "text": "\"Nasrullah's nickerin’, Mr. Arthur. Somethin's wrong.\"\n\"Hell, he's nickered before. He nickers all the time!\"\nRobinson and Snow looked at each other, saying nothing for a moment, and finally Snow told Hancock that Nasrullah never nickered in the paddock."
                            },
                            {
                                "example_id": "d94f7484-f53d-4549-8a5a-65f5ba99a0c3",
                                "sense_id": "88251204-072b-347c-b335-63069f25cfc5",
                                "text": "After a few minutes, the mare walked over and nickered loudly in his ear, and he immediately got to his feet and stripped the gear from the waiting horse."
                            }
                        ]
                    },
                    {
                        "sense_id": "08c1e971-0d23-3f8d-a29c-d4a25c0ff5ca",
                        "entry_id": "85accb47-13a9-3406-87ae-becbbbcc9d7c",
                        "glosses": [
                            "To produce a snigger or suppressed laugh."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f57dd21-1bd0-4cc2-93af-98a22cc7810e",
                        "source_entry_id": "85accb47-13a9-3406-87ae-becbbbcc9d7c",
                        "source_sense_description": "to neigh softly",
                        "target_lang_word": "ржа́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ржа́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5d92319a-230d-3861-b015-2a243aab6843",
                                        "entry_id": "dc87db33-690c-3a99-b739-bd326ad708d8",
                                        "glosses": [
                                            "издавать звуки, характерные для непарнокопытных жвачных животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9633a582-e5c1-4f05-a9df-06ec6c8eb1f5",
                                                "sense_id": "5d92319a-230d-3861-b015-2a243aab6843",
                                                "text": "Лошадь ржёт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6731d5-94cb-3e77-bc33-449efb73397f",
                                        "entry_id": "dc87db33-690c-3a99-b739-bd326ad708d8",
                                        "glosses": [
                                            "перен., разг. громко смеяться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cb8f2d6-386d-4dfb-b822-d4dc706d55be",
                                                "sense_id": "9a6731d5-94cb-3e77-bc33-449efb73397f",
                                                "text": "И ведь главное―совершенно уверены, что какой-нибудь еврей обязательно с перепугу попрется к восьми часам, а они на него будут глазеть и ржать, как жеребцы, и пальцами на него указывать…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
