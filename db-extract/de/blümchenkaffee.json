                        "examples": [
                            {
                                "example_id": "1cec3c0e-4ace-49bf-8469-19891c993692",
                                "sense_id": "09f638f1-1e6d-3e95-a345-3729a083346f",
                                "text": "Blümchenkaffee ist ein Heißgetränk aus Kaffee-Ersatz (um 1900 herum gibt es in Deutschland mehr als 400 eingetragene Sorten, die von über 250 Fabriken produziert werden), das aus mit Blumenmalerei versehenen Trinkgefäßen genossen […]",
                                "translation": "Flower coffee is a hot beverage made from a coffee substitute (around 1900 there are more than 400 registered varieties in Germany, which are produced by over 250 factories), which is enjoyed from drinking vessels decorated with flower paintings",
                                "english": "Flower coffee is a hot beverage made from a coffee substitute (around 1900 there are more than 400 registered varieties in Germany, which are produced by over 250 factories), which is enjoyed from drinking vessels decorated with flower paintings"
                            },
                            {
                                "example_id": "62234b22-5a3d-4253-9668-54552e88b5c8",
                                "sense_id": "09f638f1-1e6d-3e95-a345-3729a083346f",
                                "text": "Und wer hätte wohl gedacht, daß man beim Blümchenkaffee von Ländern reden würde, in denen wirklicher, echter Kaffee wächst und die deutsche Flagge weht?",
                                "translation": "And who would have thought that while drinking coffee substitute one would talk about countries where real, unadulterated coffee grows and the German flag flies?",
                                "english": "And who would have thought that while drinking coffee substitute one would talk about countries where real, unadulterated coffee grows and the German flag flies?"
                            }
                        ]
