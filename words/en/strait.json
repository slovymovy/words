                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A dark <w>strait</w> of barren land connected the peninsula to the mainland.",
                            "target_lang_translations": {
                                "tr": "Çorak araziden oluşan karanlık bir <w>berzah</w> yarımadayı karaya bağlıyordu."
                            }
                        },
                        {
                            "text": "They built a small fortress to guard the narrow <w>strait</w>.",
                            "target_lang_translations": {
                                "tr": "Dar <w>kıstayı</w> korumak için küçük bir kale inşa ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "isthmus",
                        "neck"
                    ],
                    "common_phrases": [
                        "strait of land"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İki büyük kara parçasını bağlayan dar kara şeridi; berzah."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "berzah",
                                "target_lang_sense_clarification": "kara kıstayı"
                            }
                        ]
                    }
                }
            ]
