                                "example_id": "843fbcb2-7f77-43f2-a12c-b63e42b0ea55",
                                "sense_id": "81971e0e-276c-33ad-926b-9ca960c32700",
                                "text": "Si jamais un jour, un homme te traite de cagole, n’hésite pas à le gansailler et lui foutre une bonne rouste."
                            },
