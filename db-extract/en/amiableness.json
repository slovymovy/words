                "forms": [],
                "senses": [
                    {
                        "sense_id": "52aa9c64-1bd3-38ba-9182-8291122d195d",
                        "entry_id": "676cdd36-4597-3be8-8076-5c5c6dd4129b",
                        "glosses": [
                            "Freundlichkeit, Liebenswürdigkeit, Umgänglichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a0401c-134c-4aee-a3ee-38839632acd5",
                                "sense_id": "52aa9c64-1bd3-38ba-9182-8291122d195d",
                                "text": "This hotel offers an unforgetable stay and a warm welcome, by the amiableness of the family who manage the Hotel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e129123-ed41-4a5e-a7ae-b8dad67d1193",
                        "source_entry_id": "676cdd36-4597-3be8-8076-5c5c6dd4129b",
                        "source_sense_id": "52aa9c64-1bd3-38ba-9182-8291122d195d",
                        "source_sense_description": "Freundlichkeit, Liebenswürdigkeit, Umgänglichkeit",
                        "target_lang_word": "Freundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                        "entry_id": "77fb2f66-647b-35a6-b64b-2dda0ca7688f",
                                        "glosses": [
                                            "Liebenswürdigkeit, wohlwollende Geneigtheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65268c1-8194-4a89-8472-f8aab1271292",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "Ich möchte Ihnen danken, denn soviel Freundlichkeit bin ich von Fremden nicht gewohnt."
                                            },
                                            {
                                                "example_id": "d26908f9-5d09-404e-97d5-ef24db5cf62b",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Bald verwandelte sich die Freundlichkeit zu meinem Erstaunen in überschwängliche Vertraulichkeit.“"
                                            },
                                            {
                                                "example_id": "e81d5d6f-a334-4ead-92aa-9525d0fa3e3c",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Er bat schnell den Bekannten, der nicht sehr beglückt schien, um die Freundlichkeit, bei seinem Koffer einen Augenblick zu warten, überblickte noch die Situation, um sich bei der Rückkehr zurechtzufinden, und eilte davon.“"
                                            },
                                            {
                                                "example_id": "88fdef06-b88b-4898-82d9-a2739a8fcf21",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„In ihn hatte ich größeres Vertrauen, und ich beschloss, auf seine Freundlichkeit zu zählen.“"
                                            },
                                            {
                                                "example_id": "1ad64ea1-33cb-4abb-8743-cf531a58353f",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Der Rektor empfing mich mit überströmender Freundlichkeit.“"
                                            },
                                            {
                                                "example_id": "6dcbf7a5-259d-4c4c-9542-75dca622d6b0",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Freundlichkeit heißt, auf andere zuzugehen, ohne ihnen hinterher zu laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "291fa649-ed67-4fc7-a821-d11b038425e0",
                        "source_entry_id": "676cdd36-4597-3be8-8076-5c5c6dd4129b",
                        "source_sense_id": "52aa9c64-1bd3-38ba-9182-8291122d195d",
                        "source_sense_description": "Freundlichkeit, Liebenswürdigkeit, Umgänglichkeit",
                        "target_lang_word": "Liebenswürdigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebenswürdigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf585f6-41ff-378b-ab2f-b7171daca539",
                                        "entry_id": "d2d9846b-4fc2-3b88-b570-ad41a824de06",
                                        "glosses": [
                                            "freundliche, zuvorkommende Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57bf6863-c5ca-4c37-be09-3497fa4caa72",
                                                "sense_id": "2cf585f6-41ff-378b-ab2f-b7171daca539",
                                                "text": "Sie empfingen uns wie früher mit all ihrer Liebenswürdigkeit."
                                            },
                                            {
                                                "example_id": "8ace01e9-4f34-4c7a-92f4-c0bf0dae85b0",
                                                "sense_id": "2cf585f6-41ff-378b-ab2f-b7171daca539",
                                                "text": "„Im Jahre 1810 lebte in Moskau ein schnell in die Mode gekommener Arzt, ein hochgewachsener, gut aussehender Mann von echt französischer Liebenswürdigkeit, der, wie es in Moskau hiess, in seinem Fach ungewöhnlich tüchtig sein sollte.“"
                                            },
                                            {
                                                "example_id": "d4f499ee-e10c-4f01-8a06-80c1ec127617",
                                                "sense_id": "2cf585f6-41ff-378b-ab2f-b7171daca539",
                                                "text": "„Der Gesandte Giovanni Donà, der ihn in Venedig gut gekannt hatte, trug mir auf, ihm viele Liebenswürdigkeiten zu sagen; und Cavaliere Venier war verstimmt darüber, daß er sich nicht das Vergnügen verschaffen konnte, ihn persönlich kennenzulernen.“"
                                            },
                                            {
                                                "example_id": "1fd8d31d-b9d7-4573-a754-a96bf2cd1a94",
                                                "sense_id": "2cf585f6-41ff-378b-ab2f-b7171daca539",
                                                "text": "„Der junge, charmante Koch riß sie alle hin mit seiner Eleganz und Frechheit, seiner Liebenswürdigkeit und Klugheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca40f955-3362-4df2-975d-b14c14a9be40",
