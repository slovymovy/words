                                                "example_id": "36626497-2bbc-4276-b488-ccf25103a12e",
                                                "sense_id": "d70f7941-06b6-35cc-ae85-1841c2216762",
                                                "text": "The news series served to spotlight corruption."
                                            }
                                        ]
                                    },
