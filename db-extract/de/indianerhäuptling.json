                ],
                "senses": [
                    {
                        "sense_id": "c7c89882-a733-3f16-85d0-789f178968a7",
                        "entry_id": "9ddc35f3-115a-3521-9a12-4c75c18b3f47",
                        "glosses": [
                            "Anführer eines Stammes der Ureinwohner Nordamerikas oder Vorsteher eines indianischen Dorfes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f69788bf-4a0e-456b-a911-fe314fcb8cd2",
                                "sense_id": "c7c89882-a733-3f16-85d0-789f178968a7",
                                "text": "„Gefragt, was sie als Kind gerne geworden wäre, antwortete Jarasch am letzten Samstag: ‚Indianerhäuptling‘. Das erregte die Missbilligung einiger Parteifreunde.“"
                            },
                            {
                                "example_id": "3692acbf-14fb-444b-96ea-3cb17eac9a14",
                                "sense_id": "c7c89882-a733-3f16-85d0-789f178968a7",
                                "text": "„Sie [Kopfläuse] zogen unter dem Federschmuck der Indianerhäuptlinge durch die weite Prärie, lange bevor Christoph Columbus seinen Fuß auf den amerikanischen Kontinent setzte.“"
                            },
                            {
                                "example_id": "bb529246-5ced-4564-9ed2-1fdbf1a509fd",
                                "sense_id": "c7c89882-a733-3f16-85d0-789f178968a7",
                                "text": "„Seit den Siebzigern führen Umweltschutzorganisationen Indianerhäuptlinge als fotogene Zeugen im Kampf gegen die Ausbeutung durch die Industrieländer vor.“"
                            },
                            {
                                "example_id": "d3ae98d6-a6c7-4cb3-b9b8-4bc604c1d08d",
                                "sense_id": "c7c89882-a733-3f16-85d0-789f178968a7",
                                "text": "„Ovide Mercedi, Führer der Nationalversammlung der Indianerhäuptlinge, beklagte unter anderem die fehlende wirtschaftliche Zukunft der Ureinwohner und ihre schlechte soziale Lage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
