                                                "sense_id": "9cdb6c44-53b4-3c8f-93a9-c4df89e9f601",
                                                "text": "On devra se soumettre à l’arbitrage."
                                            },
                                            {
                                                "example_id": "6cc5d705-da82-484a-b4c2-4044718d81b8",
                                                "sense_id": "9cdb6c44-53b4-3c8f-93a9-c4df89e9f601",
                                                "text": "Je vais demander un arbitrage."
                                            },
                                            {
                                                "example_id": "2d9269cb-64bd-4ec6-86f8-55dbd8802171",
                                                "sense_id": "9cdb6c44-53b4-3c8f-93a9-c4df89e9f601",
                                                "text": "Il devrait s’en tenir à l’arbitrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f794b32-34a8-3ab0-9618-b57361af9777",
                                        "entry_id": "afe639e1-421c-3814-a9f1-4f0c1f4f0ec7",
                                        "glosses": [
                                            "Démarche visant à veiller au bon déroulement des épreuves et au respect des règlements et autres lois du jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d257919-9083-4baf-be51-1793e59317a8",
                                                "sense_id": "5f794b32-34a8-3ab0-9618-b57361af9777",
                                                "text": "Sans arbitrage, la compétition ne peut avoir lieu."
                                            }
                                        ]
                                    },
