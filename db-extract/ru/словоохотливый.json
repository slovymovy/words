                        "sense_id": "5afc1b43-dfea-32fc-9644-ba9ff928874a",
                        "entry_id": "5ada4d50-126a-37e8-b9d1-f6b29b5adb98",
                        "glosses": [
                            "talkative, loquacious, garrulous"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec5e020-d421-4fb9-995e-d40715b0744a",
                                "sense_id": "5afc1b43-dfea-32fc-9644-ba9ff928874a",
                                "text": "Он был словоохо́тлив, каза́лся до́брым, весё́лым, но поро́ю глаза́ его́ налива́лись кро́вью, мутне́ли и остана́вливались, как у мё́ртвого.",
                                "translation": "He was very talkative, good-natured and cheerful, but at times his eyes turned bloodshot, clouded over and became as still as a dead man’s.",
                                "english": "He was very talkative, good-natured and cheerful, but at times his eyes turned bloodshot, clouded over and became as still as a dead man’s."
                            }
                        ]
