                ],
                "senses": [
                    {
                        "sense_id": "bd1c9dd7-d851-356b-ad59-20d0860ab9c2",
                        "entry_id": "8337d557-cec7-33b2-8190-5f9446fe6803",
                        "glosses": [
                            "Gerät, mit dem man Geräusche auf Musikkassetten aufnehmen und wiedergeben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa07c95-a037-4376-985e-b6ef5b9d8250",
                                "sense_id": "bd1c9dd7-d851-356b-ad59-20d0860ab9c2",
                                "text": "Ein Kassettenrekorder gehörte in den Siebzigern in jedes Jugendzimmer."
                            },
                            {
                                "example_id": "97030a38-cbef-4d46-a886-5d94347b1f3b",
                                "sense_id": "bd1c9dd7-d851-356b-ad59-20d0860ab9c2",
                                "text": "„Als ich vor einigen Wochen den Dachboden im alten Zechenhaus meiner Eltern aufräumte, fand ich meinen Kassettenrekorder wieder.“"
                            },
                            {
                                "example_id": "961714b4-b53a-407d-bd6d-cfa993416b88",
                                "sense_id": "bd1c9dd7-d851-356b-ad59-20d0860ab9c2",
                                "text": "„Er drückte das Band mit den Kinks noch einmal in den Kassettenrekorder, drehte die Lautstärke auf und beschleunigte.“"
                            },
                            {
                                "example_id": "a0265fe2-9bdf-44ce-a6b6-b02b7dde0ec7",
                                "sense_id": "bd1c9dd7-d851-356b-ad59-20d0860ab9c2",
                                "text": "„Ein Kassettenrekorder thronte auf dem Beistelltisch.“"
                            },
                            {
                                "example_id": "50840228-8475-4a04-b0aa-d1c733859401",
                                "sense_id": "bd1c9dd7-d851-356b-ad59-20d0860ab9c2",
                                "text": "„Unter dem Tisch hing ein Kassettenrekorder an einer Autobatterie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
