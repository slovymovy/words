                "entry_id": "60b80fc2-a7cd-3df4-b5e4-ad7d5a111ade",
                "word": "cladogramme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e1e7537-3734-4477-923a-e2d133d684e7",
                        "entry_id": "60b80fc2-a7cd-3df4-b5e4-ad7d5a111ade",
                        "tags": [
                            "plural"
                        ],
                        "form": "cladogrammes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dad4cb36-c223-3263-afb9-a0d8c34eaaaf",
                        "entry_id": "60b80fc2-a7cd-3df4-b5e4-ad7d5a111ade",
                        "glosses": [
                            "Schéma arborescent basé sur les caractères dérivés partagés (synapomorphies), représentant uniquement l’ordre des relations de parenté, sans indication du temps écoulé ni des distances évolutives."
                        ],
                        "tags": [
                            "Phylogénie",
                            "Cladistique"
                        ],
                        "examples": [
                            {
                                "example_id": "83f7f301-81bb-489b-90d9-99c764588778",
                                "sense_id": "dad4cb36-c223-3263-afb9-a0d8c34eaaaf",
                                "text": "Dans ce cas, le cladogramme décrivant les relations de parenté entre les taxons correspond également au cladogramme d’aire, et décrit exactement la succession des événements géographiques provoquant ces phénomènes."
                            },
                            {
                                "example_id": "e77457ff-7889-4bef-82f4-f5acaf314c7d",
                                "sense_id": "dad4cb36-c223-3263-afb9-a0d8c34eaaaf",
                                "text": "Les cladogrammes sont obtenus par analyse informatique des ressemblances et différences entre espèces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab904e77-42df-4ed4-ab35-5b001ddac1ea",
                        "source_entry_id": "60b80fc2-a7cd-3df4-b5e4-ad7d5a111ade",
                        "source_sense_id": "dad4cb36-c223-3263-afb9-a0d8c34eaaaf",
                        "target_lang_word": "cladogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cladogram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc3f900-fc5d-3dad-ba9c-b931f6b278e3",
                                        "entry_id": "0bf423b5-1f87-317f-96b2-d86f484eda9e",
                                        "glosses": [
                                            "A branching treelike graphical representation of the phylogenetic relationships between organisms showing which taxa have branched from common ancestors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75396d0-47b6-4111-9f91-9fbb721bf873",
                                                "sense_id": "6fc3f900-fc5d-3dad-ba9c-b931f6b278e3",
                                                "text": "Hard though it may seem to associate avian elegance with cumbersome and ferocious behemoths this was the story told by the cladograms, revealed by interpreting the bones of the famous old bird Archaeopteryx unfettered by preconceived notions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a670a63-e5b0-369c-9413-92a37da6d2bd",
                                        "entry_id": "0bf423b5-1f87-317f-96b2-d86f484eda9e",
                                        "glosses": [
                                            "A phylogenetic tree that is strictly the outcome of a cladistic analysis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
