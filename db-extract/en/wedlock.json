                "forms": [
                    {
                        "form_id": "9f4c57be-0c9e-469a-9cbb-8bc98283fd96",
                        "entry_id": "eeda73b7-20fc-30fb-9fbd-f71416f0c761",
                        "tags": [
                            "plural"
                        ],
                        "form": "wedlocks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04be39d9-a00f-39d4-8527-d32f90c61383",
                        "entry_id": "eeda73b7-20fc-30fb-9fbd-f71416f0c761",
                        "glosses": [
                            "The state of being married."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6177bc8b-e484-4597-aa7c-e1b88ca72496",
                                "sense_id": "04be39d9-a00f-39d4-8527-d32f90c61383",
                                "text": "If I were about to marry, I should try it; that is, if I were a student of girldom with a view to wedlock for in truth, I am a marrying man."
                            },
                            {
                                "example_id": "94af99aa-6830-456f-b6de-060e0173bd14",
                                "sense_id": "04be39d9-a00f-39d4-8527-d32f90c61383",
                                "text": "Nothing Jesus Christ more quemeth (pleaseth) Than love in wedlock where men it yemeth (keepeth);"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee6196a6-31a5-378b-9725-600ba0131a29",
                        "entry_id": "eeda73b7-20fc-30fb-9fbd-f71416f0c761",
                        "glosses": [
                            "A wife; a married woman."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0c211a91-a6d1-416d-81fc-60e145d7bd21",
                                "sense_id": "ee6196a6-31a5-378b-9725-600ba0131a29",
                                "text": "that lovely payre, / Enlincked fast in wedlockes loyall bond, / Bold Marinell with Florimell the fayre […]"
                            },
                            {
                                "example_id": "53dbc631-0298-411e-bdd1-70ba7f79b999",
                                "sense_id": "ee6196a6-31a5-378b-9725-600ba0131a29",
                                "text": "Which of these is thy Wedlock, Menelaus? thy Hellen? thy Lucrece? that we may do her Honour; mad Boy?"
                            },
                            {
                                "example_id": "5d953e3c-0d20-4f7a-afa6-7942646dee0b",
                                "sense_id": "ee6196a6-31a5-378b-9725-600ba0131a29",
                                "text": "What is it then but that desire which God put into Adam in Paradise before he knew the sin of incontinence; that desire which God saw it was not good that man should be left alone to burn in; the desire and longing to put off an unkindly solitarines by uniting another body, but not without a fit soule to his in the cheerfull society of wedlock."
                            }
                        ]
                    }
                ],
