            {
                "entry_id": "9df1e527-cf32-3bfc-bc04-f507866deee4",
                "word": "reel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c1899cc1-3501-407d-8700-c2680545b85d",
                        "entry_id": "9df1e527-cf32-3bfc-bc04-f507866deee4",
                        "tags": [
                            "singular"
                        ],
                        "form": "relen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea96725e-dcc6-3c7c-b3e0-419c937929f4",
                        "entry_id": "9df1e527-cf32-3bfc-bc04-f507866deee4",
                        "glosses": [
                            "vismolen van een werphengel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdf5ed2-2d8c-440c-9487-48f6269597bd",
                                "sense_id": "ea96725e-dcc6-3c7c-b3e0-419c937929f4",
                                "text": "Na nog enkele vergeefse pogingen om een vis te verschalken, besluiten we ons heil enkele honderden meters verderop te beproeven. Nu is het snel raak. Een grote vis laat de hengel flink doorbuigen. Stukje bij beetje lukt het om met de reel –een speciaal type vismolen– de vis richting boot te dirigeren. Enkele minuten later spartelt het dier in de grote groene bak in de boot. Het blijkt een doornhaai te zijn van zeker een meter lang. Na een fotosessie gaat de vis weer overboord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1ff1af0-9c21-463f-b1d9-453158509558",
                        "source_entry_id": "9df1e527-cf32-3bfc-bc04-f507866deee4",
                        "source_sense_id": "ea96725e-dcc6-3c7c-b3e0-419c937929f4",
                        "source_sense_description": "vismolen van een werphengel",
                        "target_lang_word": "reel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a26f800-32ed-316e-bd74-54edbe020b31",
                                        "entry_id": "d6b3d517-31ba-36ee-9f67-570f66e280da",
                                        "glosses": [
                                            "A shaky or unsteady gait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cebab45a-dcbf-4a44-a2c6-395bbe586aad",
                                                "sense_id": "8a26f800-32ed-316e-bd74-54edbe020b31",
                                                "text": "Doubtless the present game of chess was developed through just such fiddling; perhaps someone once thought that the drunken reel of the knight was hostile to the essence of Chess."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d41060f-f4f5-3c46-bc0e-fc100aa81efa",
                                        "entry_id": "d6b3d517-31ba-36ee-9f67-570f66e280da",
                                        "glosses": [
                                            "A lively dance originating in Scotland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5412097c-1ed3-4d3f-b362-1db7b6b90cb0",
                                                "sense_id": "1d41060f-f4f5-3c46-bc0e-fc100aa81efa",
                                                "text": "So strict is the kirk of Scotland, that one minister was unfrocked for writing a play (in former times); and another was sent about his business for being too fond of whiskey and of dancing the reel of Tullochgorum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05038e13-f2c9-39a4-94dd-87941c96fa37",
                                        "entry_id": "d6b3d517-31ba-36ee-9f67-570f66e280da",
                                        "glosses": [
                                            "The music of this dance; often called a Scottish (or Scotch) reel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56ce486-3b08-4c44-a451-25096109427e",
                                                "sense_id": "05038e13-f2c9-39a4-94dd-87941c96fa37",
                                                "text": "[…]sample the famed waters from the Scottish mountains like a native born, and last but not least, play a reel on the bagpipes in the big hall that set all the laddies and lassies dancing."
                                            },
                                            {
                                                "example_id": "207f75d2-b36c-460f-91dc-790403c90fa4",
                                                "sense_id": "05038e13-f2c9-39a4-94dd-87941c96fa37",
                                                "text": "The traditional reel Within a Mile of Dublin, for instance, distorts until it reaches something quasi-industrial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                                        "entry_id": "d6b3d517-31ba-36ee-9f67-570f66e280da",
                                        "glosses": [
                                            "A kind of spool, turning on an axis, on which yarn, threads, lines, or the like, are wound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ebf4d0-612e-45fa-bb9f-70806ea6de61",
                                                "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                                                "text": "a log reel"
                                            },
                                            {
                                                "example_id": "50179ddb-5704-4f85-b519-5cc477b0ad80",
                                                "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                                                "text": "an angler's reel"
                                            },
                                            {
                                                "example_id": "684e76c9-c5d2-4ffe-b24c-9c95fb59c2b2",
                                                "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                                                "text": "a garden reel"
                                            },
                                            {
                                                "example_id": "e092746a-737d-490d-9878-2fe692183ec5",
                                                "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                                                "text": "Nudge the fruit machine reel."
                                            },
                                            {
                                                "example_id": "6cb06c64-8b76-45ef-8ec2-bfb12143e248",
                                                "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                                                "text": "A hose reel forms part of a hose trolley or hose cart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f56132-e845-38f2-a585-229ed558d059",
                                        "entry_id": "d6b3d517-31ba-36ee-9f67-570f66e280da",
                                        "glosses": [
                                            "A device consisting of radial arms with horizontal stats, connected with a harvesting machine, for holding the stalks of grain in position to be cut by the knives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc04d036-0617-3825-9f7b-59ba781605ba",
                                        "entry_id": "d6b3d517-31ba-36ee-9f67-570f66e280da",
                                        "glosses": [
                                            "A short compilation of sample film work used as a demonstrative resume in the entertainment industry."
                                        ],
