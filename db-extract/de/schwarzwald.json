                        "sense_id": "17aaac81-262f-3d0f-81b3-c7b27d5b5c22",
                        "entry_id": "3051ece8-ef40-3efb-90c3-6883756be608",
                        "glosses": [
                            "Forêt-Noire, (massif montagneux situé dans le Sud-Ouest de l'Allemagne)."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "2242b288-ee7f-4e86-83bc-901e5d7a8447",
                                "sense_id": "17aaac81-262f-3d0f-81b3-c7b27d5b5c22",
                                "text": "Der Schwarzwald ist geprägt von jahrhundertealten Traditionen.",
                                "translation": "La Forêt-Noire est caractérisée par des traditions séculaires."
                            },
                            {
                                "example_id": "2ce17604-1a34-4087-b797-c23d2077646b",
                                "sense_id": "17aaac81-262f-3d0f-81b3-c7b27d5b5c22",
                                "text": "Der Schwarzwald ist schön. Kennen Sie ihn?",
                                "translation": "La Forêt-Noire est belle. La connaissez-vous ?"
                            }
                        ]
                    }
                ],
