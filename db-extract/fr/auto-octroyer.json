                                "example_id": "a2b713fb-526b-458d-a8c6-cbd16f7f6072",
                                "sense_id": "d32500ab-8be6-3c4a-946c-cfbc62fde0d7",
                                "text": "Cette association est au stade de s'auto-octroyer de petits crédits remboursables sans intérêt à côté d'une mutualité de santé déjà créée."
                            },
                            {
                                "example_id": "0bdbb29e-2e6c-4532-907d-5e92b8ad1b4c",
                                "sense_id": "d32500ab-8be6-3c4a-946c-cfbc62fde0d7",
                                "text": "C'est une des raisons qui les poussent à s'auto-octroyer des bonus dont stock options, retraites chapeau pour leur garantir le même train de vie après le départ quelque fois soudain de leur entreprise"
                            },
                            {
                                "example_id": "438e0a4b-ba87-4450-a80a-16f9c6ecc6cb",
                                "sense_id": "d32500ab-8be6-3c4a-946c-cfbc62fde0d7",
                                "text": "Mais personne ne peut s'auto-octroyer une nationalité."
