                    {
                        "translation_id": "5e6fee07-bfb7-4531-8cfc-e7a596d66a2e",
                        "source_entry_id": "8b2a20f9-4be7-3602-97fc-bfc2af45c87a",
                        "source_sense_id": "95f488bb-23ea-37cd-9b87-b4a675ca3e7a",
                        "source_sense_description": "substance qui recouvre la dent",
                        "target_lang_word": "cementum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cementum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef05559-a9f3-3ca5-98c2-f497a628de86",
                                        "entry_id": "4ea633fa-b37d-3232-8d75-d0f38caeb047",
                                        "glosses": [
                                            "A bony substance that covers the root of a tooth; cement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb62b74-4946-4deb-8669-15893e00234b",
                                                "sense_id": "bef05559-a9f3-3ca5-98c2-f497a628de86",
                                                "text": "From a purely anatomic standpoint, root cementum is part of the tooth, but also part of the periodontium."
                                            },
                                            {
                                                "example_id": "a26b1024-d618-4708-a013-a73bef4fc0d4",
                                                "sense_id": "bef05559-a9f3-3ca5-98c2-f497a628de86",
                                                "text": "Cementum is the least known calcified tissue in vertebrates (Bosshardt and Schroeder 1996) and several questions about cementogenesis have not yet been answered."
                                            },
                                            {
                                                "example_id": "4615604b-25df-4a75-8b80-d77f00393cfe",
                                                "sense_id": "bef05559-a9f3-3ca5-98c2-f497a628de86",
                                                "text": "Whether epithelial cells from Hertwig's sheath contribute to initial cementum formation is controversial as has already been discussed in Chap. 1."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
