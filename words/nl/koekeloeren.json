{
    "word_family": [
        "loeren",
        "gluren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfd2bc3a-3cdd-3f2e-904b-e2f34bd9f982",
                    "sense_definition": "aandachtig kijken of bespieden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze zaten in een vogelhut te <w>koekeloeren</w> naar een groepje kanoetstrandlopers.",
                            "target_lang_translations": {
                                "en": "They were sitting in a bird hide <w>peering</w> at a small group of red knots."
                            }
                        },
                        {
                            "text": "Wat sta je daar nu de hele middag naar de buren te <w>koekeloeren</w>?",
                            "target_lang_translations": {
                                "en": "Why have you been standing there <w>spying</w> on the neighbors all afternoon?"
                            }
                        }
                    ],
                    "synonyms": [
                        "loeren",
                        "staren"
                    ],
                    "common_phrases": [
                        "naar buiten koekeloeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal spoken Dutch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To look attentively, peer, or spy on someone or something, often in an informal or curious manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to peer",
                                "target_lang_sense_clarification": "to look closely or squintingly"
                            },
                            {
                                "target_lang_word": "to spy",
                                "target_lang_sense_clarification": "to watch secretly"
                            },
                            {
                                "target_lang_word": "to gawk",
                                "target_lang_sense_clarification": "to stare openly and stupidly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df6b2b8c-f040-3071-b80c-bc38c97a3892",
                    "sense_definition": "luieren of ergens zijn zonder veel uit te voeren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Staat 'm daar weer wa' te hangen, <w>koekeloeren</w> aan 't hoekske—niks beters te doen!",
                            "target_lang_translations": {
                                "en": "There he is hanging around again, <w>idling</w> on the corner—nothing better to do!"
                            }
                        },
                        {
                            "text": "In plaats van te werken, zat hij de hele dag maar wat te <w>koekeloeren</w> op zijn kamer.",
                            "target_lang_translations": {
                                "en": "Instead of working, he just sat <w>lounging around</w> in his room all day."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zitten te koekeloeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To idle, lounge around, or hang out somewhere without doing anything productive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to idle",
                                "target_lang_sense_clarification": "to spend time doing nothing"
                            },
                            {
                                "target_lang_word": "to lounge",
                                "target_lang_sense_clarification": "to lie or sit in a relaxed, lazy way"
                            },
                            {
                                "target_lang_word": "to hang around",
                                "target_lang_sense_clarification": "to loiter or spend time aimlessly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0978771e-819c-3b57-8ea1-636c46f8744f",
                    "sense_definition": "het geluid van een haan voortbrengen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de vroege ochtend hoorden we de haan luidkeels <w>koekeloeren</w> op de boerderij.",
                            "target_lang_translations": {
                                "en": "In the early morning, we heard the rooster <w>crowing</w> loudly on the farm."
                            }
                        },
                        {
                            "text": "Zodra de zon opkomt, begint het dier te <w>koekeloeren</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the sun rises, the animal starts <w>to crow</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kraaien"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage for crowing"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make the sound of a rooster; to crow (regional or archaic)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to crow",
                                "target_lang_sense_clarification": "of a rooster, to make its characteristic loud cry"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}