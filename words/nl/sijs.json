                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze exotische <w>sijs</w> komt oorspronkelijk alleen voor in bepaalde berggebieden van Zuid-Amerika."
                        },
                        {
                            "text": "In de volière hield hij verschillende soorten van de <w>sijs</w> bijeen."
                        }
                    ]
                },
                {
