                },
                {
                    "sense_id": "938be5af-3cfe-37ba-8ca0-acdd78eba7f0",
                    "sense_definition": "Iets of iemand die er heel mooi, schattig of perfect uitziet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "esthetiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat kleine meisje in haar nieuwe jurk is echt een <w>plaatje</w>.",
                            "target_lang_translations": {
                                "en": "That little girl in her new dress is a real <w>picture</w>.",
                                "ru": "Эта маленькая девочка в новом платье — просто <w>картинка</w>.",
                                "de": "Das kleine Mädchen in ihrem neuen Kleid ist wirklich eine <w>Augenweide</w>."
                            }
                        },
                        {
                            "text": "De tuin ziet er na de verbouwing uit als een <w>plaatje</w>.",
                            "target_lang_translations": {
                                "en": "The garden looks like a <w>picture</w> after the renovation.",
                                "ru": "После переделки сад выглядит как <w>картинка</w>.",
                                "de": "Der Garten sieht nach dem Umbau wie gemalt aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "juweeltje",
                        "schoonheid"
                    ],
                    "common_phrases": [
                        "een plaatje om te zien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt om bewondering uit te drukken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something or someone that looks very beautiful, cute, or perfect.",
                        "ru": "Кто-то или что-то, что выглядит очень красиво, мило или идеально.",
                        "de": "Etwas oder jemand, das oder der sehr schön, niedlich oder perfekt aussieht."
                    },
