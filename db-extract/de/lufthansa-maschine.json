                        "examples": [
                            {
                                "example_id": "cde5c35e-bc6a-40a1-ad57-1d0ba022b8e9",
                                "sense_id": "11d492f9-fdb0-3f6a-85d5-11951a1042a2",
                                "text": "„Als die Lufthansa-Maschine die niedere Wolkendecke durchbrach, die über London lagerte, gab der Passagier auf Platz Nr. 17 ein seltsames Geräusch von sich.“"
                            },
                            {
                                "example_id": "c5597a3b-df68-4c69-8a2f-cbfd416c97b1",
                                "sense_id": "11d492f9-fdb0-3f6a-85d5-11951a1042a2",
                                "text": "„Fünf Minuten vor dem angekündigten Abflug der Lufthansa-Maschine nach Frankfurt kam die Familie, umringt von den Leibwächtern, aus dem Raum und wurde eilends durch das Hauptgebäude zu der Maschine verfrachtet.“"
                            }
                        ],
