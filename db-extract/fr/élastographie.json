                        "sense_id": "5e26c261-fe44-31ae-8331-f58feecdd4a3",
                        "entry_id": "edcd9a99-e489-390e-bc44-af2799bb585f",
                        "glosses": [
                            "Technique d’imagerie médicale pour mesurer l’élasticité du tissu biologique dans un organe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8afa30d7-4a8a-46a2-afec-2f587fb6ea32",
                                "sense_id": "5e26c261-fe44-31ae-8331-f58feecdd4a3",
                                "text": "L’élastographie est une méthode récente d’échographie développée depuis ces cinq dernières années qui estime la dureté (ou élasticité) ou les déplacements relatifs des tissus entre eux et en fournit une image d’élasticité."
                            },
                            {
                                "example_id": "99ce9e32-49b4-4ffc-9255-1ffcff2c1b2a",
                                "sense_id": "5e26c261-fe44-31ae-8331-f58feecdd4a3",
                                "text": "L’élastographie consiste à mesurer quantitativement l’élasticité des tissus afin de remplacer le contrôle tactile souvent exercé par les médecins."
                            }
                        ]
                    }
                ],
