{
    "word_family": [
        "ability",
        "able",
        "disable",
        "enabler",
        "enabling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20cf81b3-0646-3cd5-88ff-deb5f77d59f2",
                    "sense_definition": "To provide the means, opportunity, or possibility for something to happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software will <w>enable</w> users to complete their tasks much faster than before.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение <w>позволит</w> пользователям выполнять свои задачи гораздо быстрее, чем раньше."
                            }
                        },
                        {
                            "text": "This investment will <w>enable</w> growth for the company over the next five years.",
                            "target_lang_translations": {
                                "ru": "Эти инвестиции <w>обеспечат</w> рост компании в течение следующих пяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "allow",
                        "permit",
                        "let"
                    ],
                    "common_phrases": [
                        "enable growth",
                        "enable access",
                        "enable communication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять средства, возможность или условия для того, чтобы что-то произошло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать возможность",
                                "target_lang_sense_clarification": "позволять чему-то случиться"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "делать возможным"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "создавать условия для процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e74292ab-4deb-3fad-a228-f8f79f176482",
                    "sense_definition": "To activate or make a specific function or device operational.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "activation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>enable</w> cookies in your browser settings to view this website.",
                            "target_lang_translations": {
                                "ru": "Вам необходимо <w>включить</w> куки в настройках браузера, чтобы просматривать этот сайт."
                            }
                        },
                        {
                            "text": "Please <w>enable</w> notifications so you do not miss any important updates from us.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>активируйте</w> уведомления, чтобы не пропустить важные обновления от нас."
                            }
                        }
                    ],
                    "synonyms": [
                        "activate",
                        "turn on"
                    ],
                    "antonyms": [
                        "disable"
                    ],
                    "common_phrases": [
                        "enable notifications",
                        "enable cookies",
                        "enable settings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Активировать или приводить в рабочее состояние определенную функцию или устройство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "приводить в действие устройство или настройку"
                            },
                            {
                                "target_lang_word": "активировать",
                                "target_lang_sense_clarification": "делать функцию активной"
                            },
                            {
                                "target_lang_word": "задействовать",
                                "target_lang_sense_clarification": "использовать опцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38657e7b-d180-3e96-bdb1-1448147afdb9",
                    "sense_definition": "To give someone the power, strength, or ability to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "empowerment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholarship will <w>enable</w> her to pursue a degree in medicine at a top university.",
                            "target_lang_translations": {
                                "ru": "Стипендия <w>даст ей возможность</w> получить медицинское образование в ведущем университете."
                            }
                        },
                        {
                            "text": "Education is a powerful tool that can <w>enable</w> individuals to change their lives.",
                            "target_lang_translations": {
                                "ru": "Образование — это мощный инструмент, который может <w>позволить</w> людям изменить свою жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "empower",
                        "endow"
                    ],
                    "common_phrases": [
                        "enable someone",
                        "enable success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо силы, полномочия или способность сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать возможность",
                                "target_lang_sense_clarification": "наделять способностью или ресурсами"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "давать шанс совершить действие"
                            },
                            {
                                "target_lang_word": "расширять возможности",
                                "target_lang_sense_clarification": "давать больше сил или прав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd839ed6-1572-3b4f-bb5e-f4532759c033",
                    "sense_definition": "To behave in a way that makes it possible for someone to continue a self-destructive or problematic behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By paying off his debts again, his parents continue to <w>enable</w> his gambling addiction.",
                            "target_lang_translations": {
                                "ru": "Снова выплачивая его долги, родители продолжают <w>потакать</w> его игровой зависимости."
                            }
                        },
                        {
                            "text": "Friends often <w>enable</w> bad habits without realizing the long-term harm they are causing.",
                            "target_lang_translations": {
                                "ru": "Друзья часто <w>потворствуют</w> вредным привычкам, не осознавая долгосрочного вреда, который они наносят."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enable addiction",
                        "enable behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя так, что это позволяет другому человеку продолжать саморазрушительное или проблемное поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потакать",
                                "target_lang_sense_clarification": "способствовать вредным привычкам другого"
                            },
                            {
                                "target_lang_word": "потворствовать",
                                "target_lang_sense_clarification": "создавать условия для продолжения зависимости"
                            },
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "невольно поддерживать плохое поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "625698f9-1ab7-3d6a-82aa-045b9d832e9c",
                    "sense_definition": "To give formal sanction or legal authorization to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government passed a law to <w>enable</w> the construction of the new highway system.",
                            "target_lang_translations": {
                                "ru": "Правительство приняло закон, чтобы <w>санкционировать</w> строительство новой системы автомагистралей."
                            }
                        },
                        {
                            "text": "Specific legislation was required to <w>enable</w> the local council to collect the new tax.",
                            "target_lang_translations": {
                                "ru": "Потребовалось специальное законодательство, чтобы <w>уполномочить</w> местный совет взимать новый налог."
                            }
                        }
                    ],
                    "synonyms": [
                        "authorize",
                        "permit"
                    ],
                    "common_phrases": [
                        "enabling legislation",
                        "enable authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать официальное одобрение или юридическое разрешение на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санкционировать",
                                "target_lang_sense_clarification": "давать официальное разрешение"
                            },
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "наделять законным правом"
                            },
                            {
                                "target_lang_word": "давать право",
                                "target_lang_sense_clarification": "юридически разрешать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}