                        "glosses": [
                            "Behaarung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44f0cacc-0647-4dc7-b48b-285300d02ec1",
                                "sense_id": "e5c76b8a-736f-3c0e-8587-807dcb80b416",
                                "text": "\"The fore-feet of the Yahoo differed from my hands in nothing else but the length of the nails, the coarseness and brownness of the palms, and the hairiness on the backs.\"",
                                "translation": "Die Vorderfüße des wilden Kerls unterschieden sich von meinen Händen in nichts anderem als der Länge der Nägel, der Grobheit und Bräune der Handflächen und der Behaarung auf dem Rücken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8fc6eae8-7a1b-358a-bbde-0071bbaaccca",
                        "entry_id": "2938b266-5833-3851-ad4a-4611d1b6dc7f",
                        "glosses": [
                            "Haarigkeit"
                        ],
                        "tags": [
                            "Textiltechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "a9282fba-e6dc-4e75-bcb5-ce999e74de4f",
                                "sense_id": "8fc6eae8-7a1b-358a-bbde-0071bbaaccca",
                                "text": "Yarn hairiness assumes a significance which should not be underestimated.",
                                "translation": "Die Haarigkeit von Garn nimmt eine Bedeutung an, die nicht unterschätzt werden sollte."
                            },
                            {
                                "example_id": "a1d82a1e-5e94-4ea9-83a8-a1ea58f7eb44",
                                "sense_id": "8fc6eae8-7a1b-358a-bbde-0071bbaaccca",
                                "text": "Due to the perfect bonding of fibers over their entire length, the hairiness is greatly reduced.",
                                "translation": "Aufgrund der perfekten Einbindung der Fasern über ihre gesamte Länge reduziert sich die Haarigkeit deutlich."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
