        "pl-extract.jsonl": [
            {
                "entry_id": "c1488921-1b35-3c48-b84a-b59f6950285b",
                "word": "Iris",
                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e04e50fe-490d-36aa-8ce8-bb75c5bf6d22",
                        "entry_id": "c1488921-1b35-3c48-b84a-b59f6950285b",
                        "glosses": [
                            "bogini i uosobienie tęczy, posłanka bogów do ludzi"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "c55d4133-4a58-4f2f-b5d0-7590dcfa0a0f",
                                "sense_id": "e04e50fe-490d-36aa-8ce8-bb75c5bf6d22",
                                "text": "Iris jako bogini tęczy rozpina ów cudny łuk siedmiobarwny, co ziemię łączy z niebem"
                            },
                            {
                                "example_id": "34bec16b-2954-488f-8585-4860e54b1781",
                                "sense_id": "e04e50fe-490d-36aa-8ce8-bb75c5bf6d22",
                                "text": "W sztukach plastycznych Iris bywa przedstawiana jako uskrzydlona kobieta w szacie o barwach tęczy, z kaduceuszem w ręce."
                            },
                            {
                                "example_id": "e2fe4912-1d07-4e36-af40-8042cc35799f",
                                "sense_id": "e04e50fe-490d-36aa-8ce8-bb75c5bf6d22",
                                "text": "Atrybutami skrzydlatej Iris były: kaduceusz oraz dzban do czerpania i rozlewania wody."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6352cf25-7c1a-3859-b46e-736b59bb34b2",
                        "entry_id": "c1488921-1b35-3c48-b84a-b59f6950285b",
                        "glosses": [
                            "planetoida o numerze katalogowym 7"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33bc408-2e51-4c21-b5a2-3bcd8f29e86a",
                                "sense_id": "6352cf25-7c1a-3859-b46e-736b59bb34b2",
                                "text": "Iris porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a674953-0aff-4a56-a41d-2cc244ec70f4",
                        "source_entry_id": "c1488921-1b35-3c48-b84a-b59f6950285b",
                        "source_sense_id": "e04e50fe-490d-36aa-8ce8-bb75c5bf6d22",
                        "target_lang_word": "Iris",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3faee780-47b4-34a6-9600-80e5c9bc712b",
                                        "entry_id": "b3a8a217-db5c-3efb-9f7b-b7191470fd61",
                                        "glosses": [
                                            "A messenger of the gods, and goddess of rainbows."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b529e2-e92e-461e-95b8-f194750498e6",
                                                "sense_id": "3faee780-47b4-34a6-9600-80e5c9bc712b",
                                                "text": "What's the matter,\n That this distemper'd messenger of wet,\n The many-colour'd Iris, rounds thine eye?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a677f65-e403-3761-9f06-6cfbdf7c96c0",
                                        "entry_id": "b3a8a217-db5c-3efb-9f7b-b7191470fd61",
                                        "glosses": [
                                            "A female given name from Ancient Greek; a flower name used since the end of the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59ce7a21-9cdc-42f8-b3f5-ac64896c1f34",
                                                "sense_id": "9a677f65-e403-3761-9f06-6cfbdf7c96c0",
                                                "text": "Persia tells Iris she is named for something special: the iris of the eye. \"I thought I was named for a flower,\" Iris says, disappointed. \"An iris is a flower, of course,\" Persia says, smiling, \"but it's this other, too. Our secret. 'The iris of the eye'.\" \"The eye?\" Persia snaps her fingers in Iris's eyes. The gesture is so rude and unexpected, Iris will remember it all her life. After this disclosure, Iris doesn't know whether she likes her name any more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d348321-9ddc-37e0-9bc5-9db1be44e822",
                                        "entry_id": "b3a8a217-db5c-3efb-9f7b-b7191470fd61",
                                        "glosses": [
                                            "7 Iris, a main belt asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
