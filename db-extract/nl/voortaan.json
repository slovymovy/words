                "entry_id": "da6cde18-d585-3e22-acb5-f2031a2578a2",
                "word": "voortaan",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                        "entry_id": "da6cde18-d585-3e22-acb5-f2031a2578a2",
                        "glosses": [
                            "van nu af aan, in het vervolg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7917534c-ed0c-4eb7-9076-9c53ca6659c3",
                                "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                                "text": "Wie tussen Nederland en de Verenigde Staten vliegt, kan voortaan in beide landen automatisch door de paspoortcontrole."
                            },
                            {
                                "example_id": "8400ed12-64d3-45a4-b28d-518cc2b8fbeb",
                                "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                                "text": "Het is veelzeggend dat Vincenzo Nibali, zonder twijfel behorend tot de laatste categorie, pas hierna bepaalt of hij vol voor het geel in Parijs gaat of dat hij voortaan mikt op ritwinst."
                            },
                            {
                                "example_id": "37fd8399-c929-4f79-ae10-2c266802052d",
                                "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                                "text": "Met mijn kleine Swiss Army schaartje knipte ik het zo kort als ik kon, in de hoop dat ik het voortaan minder heet zou hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9d24815-120a-43a5-a3c4-7dbde249a7f5",
                        "source_entry_id": "da6cde18-d585-3e22-acb5-f2031a2578a2",
                        "source_sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                        "source_sense_description": "van nu af aan, in het vervolg",
                        "target_lang_word": "in Zukunft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in Zukunft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8505cf2-81cb-33d4-a5c1-07a20bdbcee6",
                                        "entry_id": "58ec1767-f5f5-3c00-9d3a-0279748afb2b",
                                        "glosses": [
                                            "von nun an, in der kommenden Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c3bfd5-fdc6-4fed-81b4-9dc80ac613d3",
                                                "sense_id": "c8505cf2-81cb-33d4-a5c1-07a20bdbcee6",
                                                "text": "Das war ein Fehler. Du musst in Zukunft besser aufpassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f94bd394-b683-45ce-a5c4-1ac8b35b84be",
                        "source_entry_id": "da6cde18-d585-3e22-acb5-f2031a2578a2",
                        "source_sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                        "source_sense_description": "van nu af aan, in het vervolg",
                        "target_lang_word": "künftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "künftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86c7a89e-ceff-341f-9602-178c30dcc889",
                                        "entry_id": "4c5f53c6-d13f-3f98-b965-b806605ce39e",
                                        "glosses": [
                                            "zukünftig, bald eintretend oder vorhanden, in der Zukunft kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed60b8b-0b6a-43b2-a08b-ef5cb89530cc",
                                                "sense_id": "86c7a89e-ceff-341f-9602-178c30dcc889",
                                                "text": "Die künftige Nutzung des Gebäudes ist noch nicht geklärt."
                                            },
                                            {
                                                "example_id": "99b5a482-6130-47f5-b8eb-98184432ad16",
                                                "sense_id": "86c7a89e-ceff-341f-9602-178c30dcc889",
                                                "text": "„Auf gestickte Monogramme sollte man ebenfalls verzichten, denn künftige Lebensabschnittsgefährten schlafen nicht gerne in Bettbezügen mit den Initialen ihrer Vorgänger.“"
                                            },
                                            {
                                                "example_id": "9d8aed58-bedf-4b9d-b8c4-9bba4d35da84",
                                                "sense_id": "86c7a89e-ceff-341f-9602-178c30dcc889",
                                                "text": "„Mehr Crossover als SUV, spielt der künftige Q2, der eventuell doch nicht so heißen wird, in der Klasse von Mini Paceman und Range Rover Evoque.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "künftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1c41066-2f0e-39b2-9a64-05cc12416814",
                                        "entry_id": "fcddebcc-09e4-3f27-8ce8-487e1bd288d3",
                                        "glosses": [
                                            "zukünftig, in der Folgezeit, von jetzt an"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd634336-c695-4b0d-b10b-3e205f7ad5f9",
                                                "sense_id": "e1c41066-2f0e-39b2-9a64-05cc12416814",
                                                "text": "Das war ein Fehler. Ich werde künftig besser aufpassen."
                                            },
                                            {
                                                "example_id": "d0371bba-bc18-43f9-9636-de83aeaa6ca4",
                                                "sense_id": "e1c41066-2f0e-39b2-9a64-05cc12416814",
                                                "text": "„Die Universitäten wollen den Studierenden künftig wieder mehr Raum für Sinnfindung geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed8f1141-9b03-4893-a919-2c78fa136aa5",
                        "source_entry_id": "da6cde18-d585-3e22-acb5-f2031a2578a2",
                        "source_sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                        "source_sense_description": "van nu af aan, in het vervolg",
                        "target_lang_word": "désormais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désormais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "104f1023-6cde-34db-9de3-4268908b23fc",
                                        "entry_id": "76be3e2e-0948-3fba-a78a-0a254f69f4dc",
                                        "glosses": [
                                            "Dorénavant ; à l’avenir ; dès ce moment-ci ; à partir de maintenant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4ce3db-056a-4f0e-92b2-7991bec580b5",
                                                "sense_id": "104f1023-6cde-34db-9de3-4268908b23fc",
                                                "text": "La foule entend désormais jouir des raffinements réservés naguère à de peu nombreux privilégiés."
                                            },
                                            {
                                                "example_id": "147cd601-b7b5-4c62-9fbe-bb79c8b21bdb",
                                                "sense_id": "104f1023-6cde-34db-9de3-4268908b23fc",
                                                "text": "Si dans le passé l’idéologie soviétique opposait l’U.R.S.S. aux nations capitalistes, Staline substitue désormais les solidarités anti-hitlériennes aux solidarités de classe."
                                            },
                                            {
                                                "example_id": "9d0f01b7-cbe5-4c95-80e4-f8dc7339c384",
                                                "sense_id": "104f1023-6cde-34db-9de3-4268908b23fc",
                                                "text": "Au reste, même à ses yeux, ce n'est plus désormais qu'une solution de désespoir, un moyen de sauver, sinon l'armée, du moins son honneur."
                                            },
                                            {
                                                "example_id": "0f14fb3b-849b-4847-bb7c-9c816c9ec630",
                                                "sense_id": "104f1023-6cde-34db-9de3-4268908b23fc",
                                                "text": "Tout en vitupérant, elle ramasse le gallinacé et l'ausculte. Las ! poupoule ressemble plus désormais à une limande qu'à une Bresse blanche."
                                            },
                                            {
                                                "example_id": "334561db-48f4-43df-a604-721c909937be",
                                                "sense_id": "104f1023-6cde-34db-9de3-4268908b23fc",
                                                "text": "Le P2P est la nouvelle mine d'or du Web, remplaçant très avantageusement les désormais désuets serveurs FTP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db30e1fa-f8a1-467e-a1d8-5fa0a9c72200",
                        "source_entry_id": "da6cde18-d585-3e22-acb5-f2031a2578a2",
                        "source_sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                        "source_sense_description": "van nu af aan, in het vervolg",
                        "target_lang_word": "dorénavant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dorénavant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1608f3ea-5188-37b9-a22b-e10feb1727b1",
                                        "entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                                        "glosses": [
                                            "À l’avenir ; à partir du moment actuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db5a527-127e-451a-a5b0-264046d54183",
                                                "sense_id": "1608f3ea-5188-37b9-a22b-e10feb1727b1",
                                                "text": "Dorénavant, les réunions publiques qui n’ont pas de caractère politique sont affranchies de toute déclaration préalable, et les sociétés non politiques ne sont même plus tenues de déposer leurs statuts et la liste de leurs membres."
                                            },
                                            {
                                                "example_id": "21f21673-f16f-4c7b-a677-12e0d4b051ed",
                                                "sense_id": "1608f3ea-5188-37b9-a22b-e10feb1727b1",
                                                "text": "Un invité, pensant pouvoir parler dorénavant librement, s'est retrouvé à Oukacha, la prison voisine."
                                            },
                                            {
                                                "example_id": "784b2c0b-19b6-4f0f-b4e6-5bf8fb9ba1bd",
                                                "sense_id": "1608f3ea-5188-37b9-a22b-e10feb1727b1",
                                                "text": "Suite aux dernières réformes de la direction, l'établissement a décidé que c'est dorénavant aux élèves de décider comment j'allais m'appeler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3911fd3-9108-344c-8650-7323372ea2c3",
                                        "entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                                        "glosses": [
                                            "Dès maintenant, immédiatement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6bd021f-a766-4354-b30f-a0d0a2bb802e",
                                                "sense_id": "c3911fd3-9108-344c-8650-7323372ea2c3",
                                                "text": "… Aussi mon cœur, dores-en-avant, tournera-t-il vers les astres resplendissants de vos yeux adorables, ainsi que vers son pôle unique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
