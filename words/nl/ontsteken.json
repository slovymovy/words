                    "frequency": "Middle",
                    "semantic_group_id": "licht_en_vuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dorpelingen <w>ontstaken</w> een groot vreugdevuur op het centrale plein.",
                            "target_lang_translations": {
                                "en": "The villagers <w>lit</w> a large bonfire on the central square."
                            }
                        },
                        {
                            "text": "Het is traditie om het olympisch vuur plechtig te <w>ontsteken</w>.",
                            "target_lang_translations": {
                                "en": "It is a tradition to solemnly <w>ignite</w> the Olympic flame."
                            }
                        }
                    ],
                    "synonyms": [
