                ],
                "translations": [
                    {
                        "translation_id": "ea8cefb1-d285-4667-a3ab-574d975cb86f",
                        "source_entry_id": "af863218-8686-3038-8ba3-ace06f50f468",
                        "source_sense_id": "eb16173b-c78b-39b4-9377-22993cbdf966",
                        "target_lang_word": "flightless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flightless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                        "entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                                        "glosses": [
                                            "Unable to fly.",
                                            "Describing kinds of birds that normally cannot fly, such as the penguin, ostrich, and emu."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985cc6e8-5dcd-4b54-b915-08a244840ce1",
                                                "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                                "text": "Near-synonyms: apterous, wingless"
                                            },
                                            {
                                                "example_id": "1b390af0-907b-483f-907b-6407033a8e95",
                                                "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                                "text": "The indigenous fauna of Australia and New Zealand featured an especially interesting array of flightless birds."
                                            },
                                            {
                                                "example_id": "d79e5b44-566b-400a-b2d7-d81f9b483635",
                                                "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                                "text": "America has its bald eagle and New Zealand has its kiwi, a flightless brown bird."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "729f6d78-8912-336c-b8eb-2972a3ff22dd",
                                        "entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                                        "glosses": [
                                            "Unable to fly.",
                                            "Describing an individual bird that normally would be able to fly but in this case cannot, such as an injured sparrow."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4eb6c3-8cba-4374-a5c8-a364b84d3cd1",
                                                "sense_id": "729f6d78-8912-336c-b8eb-2972a3ff22dd",
                                                "text": "The animal shelter has a flightless sparrow named Shiny, who seems to make up for his disability by being an avid runner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49da9f56-4f3f-31e9-81c5-d09861547d45",
                                        "entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                                        "glosses": [
                                            "Unable to fly.",
                                            "Suddenly deprived of a scheduled (airline) flight by its cancellation."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba91d7a9-13cb-484e-b69c-9ed61467dcc4",
                                                "sense_id": "49da9f56-4f3f-31e9-81c5-d09861547d45",
                                                "text": "Oh great, some wind is blowing in Chicago, so now I'm flightless in Seattle, because this airline can't cope!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e236e71-6dfc-4b1c-866d-8edebda42d24",
                        "source_entry_id": "af863218-8686-3038-8ba3-ace06f50f468",
                        "source_sense_id": "eb16173b-c78b-39b4-9377-22993cbdf966",
                        "target_lang_word": "flugunfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flugunfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                        "entry_id": "abe5f49c-4305-3e8a-a929-194d72411104",
                                        "glosses": [
                                            "nicht fähig zu fliegen oder zum Fliegen gebracht zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "917887e8-f91b-4f52-a0bb-2584019b0743",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Die Anatomie und die Gehirnstruktur von flugunfähigen Vögeln deuten daraufhin, dass sie alle von Vorfahren abstammen, die fliegen konnten."
                                            },
                                            {
                                                "example_id": "7129fb53-9515-48d4-b157-0a3648504adb",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Zunächst einmal ist er flugunfähig, wobei sich die straußenähnlichen Laufvögel auf der ganzen Welt darin unterscheiden, dass einige noch kleine Stummelflügelchen haben, mit denen sie in der Luft wedeln können, und andere haben nicht einmal das."
                                            },
                                            {
                                                "example_id": "749ae566-b119-401d-8428-81720c947328",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Ein nicht fachmännisch behandelter Bruch heilt nicht richtig und der Vogel bleibt unter Umständen für den Rest seines Lebens flugunfähig."
                                            },
                                            {
                                                "example_id": "914ae002-c07b-4c83-bdfe-69fb510609f1",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Jährlich werden mehr als 5 000 Jagdhunde an lebenden, vorher flugunfähig gemachten Enten ausgebildet."
                                            },
                                            {
                                                "example_id": "b589ee09-40a6-4c4e-ae58-a927f6f28c26",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "§ 186 Abs 2 Z 1 begeht, wer ein im Einsatz befindliches Luftfahrzeug zerstört, also gänzlich vernichtet, oder es auf eine Weise beschädigt, dass es flugunfähig wird."
                                            },
                                            {
                                                "example_id": "3e1c1466-595d-477a-9ef8-bd410ffa710f",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
