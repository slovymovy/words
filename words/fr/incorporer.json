{
    "word_family": [
        "incorporation",
        "incorporable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d493fbca-94ce-3a7a-87b8-2aa1b9801d41",
                    "sense_definition": "Mêler ou introduire un élément ou une substance dans un ensemble pour former un tout homogène.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mélanger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pâtissier <w>incorpore</w> délicatement les blancs en neige à la préparation."
                        },
                        {
                            "text": "Il faut <w>incorporer</w> lentement la farine au mélange pour éviter les grumeaux."
                        }
                    ],
                    "synonyms": [
                        "intégrer",
                        "mélanger",
                        "joindre"
                    ],
                    "antonyms": [
                        "séparer",
                        "extraire"
                    ],
                    "common_phrases": [
                        "incorporer les ingrédients",
                        "incorporer à la pâte"
                    ]
                },
                {
                    "sense_id": "dea286cf-3bfc-3ac5-afb9-58d2119319e1",
                    "sense_definition": "Intégrer une personne ou une unité au sein d'un groupe constitué, notamment dans l'armée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enrôler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune conscrit a été <w>incorporé</w> dans un régiment d'infanterie."
                        },
                        {
                            "text": "L'association souhaite <w>incorporer</w> de nouveaux membres bénévoles à son équipe."
                        }
                    ],
                    "synonyms": [
                        "enrôler",
                        "intégrer",
                        "affecter"
                    ],
                    "antonyms": [
                        "démobiliser",
                        "exclure"
                    ],
                    "common_phrases": [
                        "incorporer une recrue",
                        "incorporer dans l'armée"
                    ]
                },
                {
                    "sense_id": "5dc42376-a74b-32bb-8862-103f810bc999",
                    "sense_definition": "Rattacher ou réunir un territoire, une propriété ou un droit à un ensemble plus vaste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annexer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le royaume a décidé d'<w>incorporer</w> cette province après plusieurs années de conflit."
                        },
                        {
                            "text": "Cette parcelle boisée a été <w>incorporée</w> au domaine public communal."
                        }
                    ],
                    "synonyms": [
                        "annexer",
                        "rattacher",
                        "adjoindre"
                    ],
                    "antonyms": [
                        "détacher",
                        "céder"
                    ],
                    "common_phrases": [
                        "incorporer au domaine",
                        "incorporer un territoire"
                    ]
                }
            ]
        }
    ]
}