                                        "sense_id": "c177be90-24d9-350a-be1e-4fad8c80c70d",
                                        "entry_id": "fe17480b-ee9c-3dae-8f38-9feec10fdd0b",
                                        "glosses": [
                                            "dodelijk vermoeid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009f8ba9-7300-4edd-b867-e114ecdbc705",
                                                "sense_id": "c177be90-24d9-350a-be1e-4fad8c80c70d",
                                                "text": "De uitgeputte drenkeling werd nog net op tijd uit het water gehaald."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6740c86-be3c-36f9-aabd-21562655ece6",
                                        "entry_id": "fe17480b-ee9c-3dae-8f38-9feec10fdd0b",
                                        "glosses": [
                                            "dusdanig leeggehaald dat er niets overblijft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5409e294-d2ad-498c-8fa0-a92210a06cd7",
                                                "sense_id": "d6740c86-be3c-36f9-aabd-21562655ece6",
                                                "text": "De uitgeputte goudmijn was al jaren gesloten, maar door nieuwe technologie werd het mogelijk het afval opnieuw te gaan bewerken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uitgeput",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "57259cd0-eef8-323a-afa2-91f108207d79",
                                        "entry_id": "22e74adb-544e-303b-abde-d9585faf453e",
                                        "glosses": [
                                            "zeer vermoeid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4adee00-34a9-4400-88f4-5ae0e1836a3f",
                                                "sense_id": "57259cd0-eef8-323a-afa2-91f108207d79",
                                                "text": "De rest gaf ik aan de jongens die uitgeput in de zon zaten."
                                            },
                                            {
                                                "example_id": "f424f905-987a-4e7e-a88c-52ee1f719eba",
                                                "sense_id": "57259cd0-eef8-323a-afa2-91f108207d79",
                                                "text": "Om drie uur 's nachts ging ze uitgeput op haar matras liggen en staarde naar de balken en het afbladderende plafond, waarvan de ruwe, hoge hoeken werden verlicht door het zwakke schijnsel van de kaars naast haar bed."
                                            },
                                            {
                                                "example_id": "e1c94c55-e0fa-4dc8-ad6f-34cf4b43c9e8",
                                                "sense_id": "57259cd0-eef8-323a-afa2-91f108207d79",
                                                "text": "Terwijl Hannah gaat douchen, ga ik uitgeput op de enige stoel zitten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
