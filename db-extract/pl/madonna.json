                    },
                    {
                        "sense_id": "8541d886-85db-3d1b-a8a7-0ecbf279e6f6",
                        "entry_id": "414ee220-ba01-3173-be6b-54a443a1728b",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
