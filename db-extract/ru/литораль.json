                    {
                        "translation_id": "07976073-ed1b-431e-8add-31dccbb1167e",
                        "source_entry_id": "b5831c29-a47e-3e7c-9190-6aa5cd9fe66a",
                        "source_sense_id": "4161eeba-3e2a-32a9-8cf1-d69ef8c6579d",
                        "target_lang_word": "littoral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "littoral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617a2912-bd8a-394b-80d2-ee16bc7cd44b",
                                        "entry_id": "942c41ed-970e-3272-9f18-ca4a27d83dc7",
                                        "glosses": [
                                            "Of or relating to the shore, especially the seashore."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce819148-6c36-4aae-a8eb-9634b17ed140",
                                                "sense_id": "617a2912-bd8a-394b-80d2-ee16bc7cd44b",
                                                "text": "The deep-sea fauna has probably been formed almost entirely from the littoral, not in the remotest antiquity, but only after food derived from the débris of the littoral and terrestrial faunas and floras became abundant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "littoral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a13af29-5581-330a-95dd-63532a86ecdf",
                                        "entry_id": "d2a82177-4ec3-3c92-8a6e-4fece4e6c2fa",
                                        "glosses": [
                                            "A shore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fcee9b3-e2ae-4cac-8705-bb9e0286033b",
                                                "sense_id": "3a13af29-5581-330a-95dd-63532a86ecdf",
                                                "text": "[…] these Chams belonged to the Malay-Polynesian group and their distribution along the littoral suggests that they were invaders from the sea […]"
                                            },
                                            {
                                                "example_id": "f3397190-0589-4c1c-9b40-be3fba8f0da9",
                                                "sense_id": "3a13af29-5581-330a-95dd-63532a86ecdf",
                                                "text": "The railway running along the littoral from Brighton westward to Portsmouth forms an important section of the L.B.S.C.R. (Central) secion of the Southern Railway."
                                            },
                                            {
                                                "example_id": "f6ac806b-29ce-4799-9c0f-a4db1a981dc0",
                                                "sense_id": "3a13af29-5581-330a-95dd-63532a86ecdf",
                                                "text": "Just beyond the locomotive depot is the junction of the Anecho line, which curves sharply eastwards. It runs for the whole way along the flat, sandy littoral among coconut plantations, usually a mile or so inland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b182fbf1-0b76-321d-a4cb-1f516ef0e24d",
                                        "entry_id": "d2a82177-4ec3-3c92-8a6e-4fece4e6c2fa",
                                        "glosses": [
                                            "The zone of a coast between high tide and low tide levels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f251a1-52bc-429d-8a26-3d77a486caf7",
                                                "sense_id": "b182fbf1-0b76-321d-a4cb-1f516ef0e24d",
                                                "text": "The night was considerably clearer than anybody on board her desired when the schooner Ventura headed for the land. It rose in places, black and sharp against the velvety indigo, over her dipping bow, though most of the low littoral was wrapped in obscurity."
                                            },
                                            {
                                                "example_id": "afd9b304-fe1d-42eb-90ef-b71dca539247",
                                                "sense_id": "b182fbf1-0b76-321d-a4cb-1f516ef0e24d",
                                                "text": "Buried within the Mediterranean littoral are some seventy to ninety million tons of slag from ancient smelting, about a third of it concentrated in Iberia. This ceaseless industrial fueling caused the deforestation of an estimated fifty to seventy million acres of woodlands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9a06cd6-b254-4b75-ae04-ff1ec678be99",
                        "source_entry_id": "b5831c29-a47e-3e7c-9190-6aa5cd9fe66a",
