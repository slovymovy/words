                "forms": [],
                "senses": [
                    {
                        "sense_id": "b9c80111-000b-3ff9-a029-19fa072a6184",
                        "entry_id": "d5b11853-764d-3baf-84df-d21dfb74f01c",
                        "glosses": [
                            "płacz, rozpaczanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff7600b-f672-4d39-8135-5939c126dad7",
                                "sense_id": "b9c80111-000b-3ff9-a029-19fa072a6184",
                                "text": "A cała wieś odprowadzała ich z płaczem i lamentem aż pod figurę Częstochowskiej, która stojała przy drodze na rozstajach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
