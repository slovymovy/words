                "senses": [
                    {
                        "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                        "entry_id": "cf7d7bdc-e9cd-3634-ab0c-8f1a198405bc",
                        "glosses": [
                            "αλλού, προς/για αλλού, σε κάποιον άλλον τόπο, προς κάποιον άλλον τόπο"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0c5aa0-8f90-45d8-8297-55a3039f08cd",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "You need to look for it elsewhere.",
                                "translation": "Αλλού πρέπει να την αναζητήσετε."
                            },
                            {
                                "example_id": "80852200-a782-438f-807c-47a0524c742b",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "Don’t look elsewhere!",
                                "translation": "Μην κοιτάς αλλού!"
                            },
                            {
                                "example_id": "bf31ebaa-aae7-436a-93e7-6dc9b106d5b1",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "Citrus fruits are produced in Crete, in Peloponnesus, and elsewhere.",
                                "translation": "Τα εσπεριδοειδή παράγονται στην Κρήτη, στην Πελοπόννησο και αλλού."
                            },
                            {
                                "example_id": "b98de719-58d7-4961-9a72-8f8a24aa1227",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "Not only in Attica but also elsewhere in Greece.",
                                "translation": "Όχι μόνο στην Αττική αλλά και αλλού στην Ελλάδα."
                            },
                            {
                                "example_id": "1f4616a9-9620-415b-bb8e-cc0b2561589d",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "She can’t concentrate, her thoughts wander elsewhere.",
                                "translation": "Δεν μπορεί να συγκεντρωθεί, η σκέψη της πετά αλλού."
                            },
                            {
                                "example_id": "a4d743ca-83c4-4d06-9c02-f0fc809ad024",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "His mind is elsewhere.",
                                "translation": "Έχει το μυαλό του αλλού."
                            },
                            {
                                "example_id": "a69a33ac-bc79-473a-b8dd-aca9aa230a2d",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "The solution to this problem lies elsewhere.",
                                "translation": "Αλλού βρίσκεται η λύση του προβλήματος."
                            },
                            {
                                "example_id": "5e7ad32d-384f-4a32-bac5-fba71209c344",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "I headed elsewhere.",
                                "translation": "Κατευθύνθηκα προς αλλού."
                            },
                            {
                                "example_id": "0a238b96-f9f5-4074-a398-e25fcd464b7e",
                                "sense_id": "aeecca26-7537-3149-844c-bd3d23be2a22",
                                "text": "They started elsewhere and eventually arrived somewhere else.",
                                "translation": "Για αλλού ξεκίνησαν και αλλού τελικά φτάσανε."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
