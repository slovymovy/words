        "nl-extract.jsonl": [
            {
                "entry_id": "4ca6f2ef-c6c1-395d-b3de-70191549d0e3",
                "word": "continuïteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ef7ea3d-c160-3e28-9757-ca0484e0a0a6",
                        "entry_id": "4ca6f2ef-c6c1-395d-b3de-70191549d0e3",
                        "glosses": [
                            "het continu zijn, de voortduring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e4029a-afb1-493b-8c80-a60b62de658e",
                                "sense_id": "6ef7ea3d-c160-3e28-9757-ca0484e0a0a6",
                                "text": "Continuïteit van zorg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74a8ca4e-2700-4a7e-8c48-01113584cee7",
                        "source_entry_id": "4ca6f2ef-c6c1-395d-b3de-70191549d0e3",
                        "source_sense_id": "6ef7ea3d-c160-3e28-9757-ca0484e0a0a6",
                        "target_lang_word": "Kontinuität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontinuität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "504819b4-f39e-3367-9cf0-d031bc8a101d",
                                        "entry_id": "851742d3-ba92-38b9-a572-87d6286951c4",
                                        "glosses": [
                                            "ununterbrochene Fortdauer, ununterbrochener Zusammenhang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1da9a8f8-d07a-464e-8996-7957351fecd0",
                                                "sense_id": "504819b4-f39e-3367-9cf0-d031bc8a101d",
                                                "text": "„Mit den sozialdemokratischen Ministerinnen Ulla Schmidt, Heidemarie Wieczorek-Zeul und Brigitte Zypries bleibt obendrein auch eine personelle Kontinuität zur Vorgängerregierung unter Bundeskanzler Gerhard Schröder gewahrt.“"
                                            },
                                            {
                                                "example_id": "0afa056e-86d3-42ab-9d76-16ad876f4d7a",
                                                "sense_id": "504819b4-f39e-3367-9cf0-d031bc8a101d",
                                                "text": "„Sein strukturell vereinheitlichtes Heer, die Kontinuität und die Ausschließlichkeit seines Oberkommandos und sein Informationsmonopol erlaubten ihm koordinierte und längerfristige Planungen sowie überhaupt rationalere Formen der Kriegsführung.“"
                                            },
                                            {
                                                "example_id": "5cc520c1-c236-42f7-bac5-12acf6659b9c",
                                                "sense_id": "504819b4-f39e-3367-9cf0-d031bc8a101d",
                                                "text": "„Anton Sittinger ist ein Beispiel für die Kontinuität deutscher Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b605b5f0-2afc-4a0a-8bf3-c0eaa2597936",
                        "source_entry_id": "4ca6f2ef-c6c1-395d-b3de-70191549d0e3",
                        "source_sense_id": "6ef7ea3d-c160-3e28-9757-ca0484e0a0a6",
                        "target_lang_word": "continuity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ef8856-288b-3469-8351-06dd1ebc46b2",
                                        "entry_id": "d025a3f0-10c0-3e6b-a11f-4506e7495bab",
                                        "glosses": [
                                            "Lack of interruption or disconnection; the quality of being continuous in space or time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038009fc-c615-43ee-9ed0-31bf8053faf2",
                                                "sense_id": "28ef8856-288b-3469-8351-06dd1ebc46b2",
                                                "text": "While troubleshooting the heating and cooling system, we found a lack of continuity in a circuit that is normally closed."
                                            },
                                            {
                                                "example_id": "1afa5ee1-27d6-4de7-b884-901a4d235e81",
                                                "sense_id": "28ef8856-288b-3469-8351-06dd1ebc46b2",
                                                "text": "Considerable continuity of attention is needed to read German philosophy."
                                            },
                                            {
                                                "example_id": "8c105459-b69a-4d5d-8603-4681c8d62d3a",
                                                "sense_id": "28ef8856-288b-3469-8351-06dd1ebc46b2",
                                                "text": "Vacuum-fitted wagons are provided with complete vacuum-brake equipment; \"piped\" wagons have through pipes, enabling them to be marshalled in vacuum-braked trains without interrupting the continuity of the vacuum brake connections, but are not provided themselves with vacuum brake gear."
                                            },
                                            {
                                                "example_id": "f0d81715-c70d-4be1-8d8e-d9330268e94b",
                                                "sense_id": "28ef8856-288b-3469-8351-06dd1ebc46b2",
                                                "text": "As on Nos. 20001-3, the motor and generator armature shafts of the new locomotive each carry a heavy flywheel to provide kinetic energy and help maintain the speed of the motor-generator set during interruptions of supply, as at breaks in the continuity of the conductor rail."
                                            },
                                            {
                                                "example_id": "2abfb9ec-821c-4812-9171-a47a04bf5e35",
                                                "sense_id": "28ef8856-288b-3469-8351-06dd1ebc46b2",
                                                "text": "With the election of Cardinal Robert Prevost as Pope Leo XIV, the College of Cardinals sent a clear message of continuity with the reformist agenda of his predecessor, Pope Francis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd6388e-f1cc-3e29-a0c8-e3ae99357035",
                                        "entry_id": "d025a3f0-10c0-3e6b-a11f-4506e7495bab",
                                        "glosses": [
                                            "A characteristic property of a continuous function."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866f5e56-57d6-4f3a-8517-3f32bf55d5e3",
                                                "sense_id": "1fd6388e-f1cc-3e29-a0c8-e3ae99357035",
                                                "text": "The definition of a continuous function assumes that the function is already defined for x = a. If this is not the case, however, it is sometimes possible to assign such a value to the function for x = a that the condition of continuity shall be satisfied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3184ca52-6e0d-392b-a545-d5d9a1183870",
                                        "entry_id": "d025a3f0-10c0-3e6b-a11f-4506e7495bab",
                                        "glosses": [
                                            "A narrative device in episodic fiction where previous and/or future events in a series of stories are accounted for in present stories."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e2320a-5e13-4dde-a8e2-0b515b779014",
                                                "sense_id": "3184ca52-6e0d-392b-a545-d5d9a1183870",
                                                "text": "In “Treehouse Of Horror” episodes, the rules aren’t just different—they don’t even exist. If writers want Homer to kill Flanders or for a segment to end with a marriage between a woman and a giant ape, they can do so without worrying about continuity or consistency or fans griping that the gang is behaving out of character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f40548-addc-3b31-8133-7a5d266c71c8",
                                        "entry_id": "d025a3f0-10c0-3e6b-a11f-4506e7495bab",
                                        "glosses": [
                                            "Consistency between multiple shots depicting the same scene but possibly filmed on different occasions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "215dc045-8199-3aba-910e-f4638a90f747",
                                        "entry_id": "d025a3f0-10c0-3e6b-a11f-4506e7495bab",
                                        "glosses": [
                                            "The announcements and messages inserted by the broadcaster between programmes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bce854e-b34d-4dd3-b373-497e9ba19269",
                        "source_entry_id": "4ca6f2ef-c6c1-395d-b3de-70191549d0e3",
                        "source_sense_id": "6ef7ea3d-c160-3e28-9757-ca0484e0a0a6",
                        "target_lang_word": "continuité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                        "entry_id": "47e9c69e-830a-3271-91f3-e97924b05b11",
                                        "glosses": [
                                            "Liaison non interrompue des parties d’un tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4674f729-9a1a-4cec-a00c-5677ac2b0491",
                                                "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                                "text": "La glande génitale est située dans le cœlome, et sans continuité avec les conduits génitaux ; une partie de la couronne pédieuse péribuccale est hectocotylisée, c'est-à-dire modifiée en organe d'accouplement, chez le mâle."
                                            },
                                            {
                                                "example_id": "a29e07fb-d9a2-4457-b7ee-55c765c8893b",
                                                "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                                "text": "Ah ! Littérature ! Quels tourments, quelles tortures ton sacro-saint amour de la continuité ne nous impose-t-il pas !"
                                            },
                                            {
                                                "example_id": "801a5fae-2556-44bb-b75a-2ebd742c51a4",
                                                "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                                "text": "Continuité territoriale."
                                            },
                                            {
                                                "example_id": "8aa8c1c1-2688-43b8-a589-ba92f2203841",
                                                "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                                "text": "Continuité du service public."
                                            },
                                            {
                                                "example_id": "9757eef5-2214-4af3-9646-656c6f771dab",
                                                "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                                "text": "Continuité des soins."
                                            },
                                            {
                                                "example_id": "5fe0bdc2-9c9f-468c-b683-d2001b1901dd",
                                                "sense_id": "d312247f-7d31-39dd-8f3a-57b62853094c",
                                                "text": "Continuité électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca939374-dee4-3ef6-b27b-a697505eecf2",
                                        "entry_id": "47e9c69e-830a-3271-91f3-e97924b05b11",
                                        "glosses": [
                                            "Durée continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb491f5-c226-4fc7-8a45-a3dab426743a",
                                                "sense_id": "ca939374-dee4-3ef6-b27b-a697505eecf2",
                                                "text": "La continuité des maux. - La continuité de ce bruit m’importune."
                                            },
                                            {
                                                "example_id": "ce668809-4ca2-46be-9b42-24277dcce0d7",
                                                "sense_id": "ca939374-dee4-3ef6-b27b-a697505eecf2",
                                                "text": "« C’est bien d’elle », me dis-je, avec ce sourire qu’on décerne aux très vieux amis pour montrer qu’on a pris sur leur caractère une assurance infaillible de continuité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553d3451-1ece-3d73-8018-526bda0678c4",
                                        "entry_id": "47e9c69e-830a-3271-91f3-e97924b05b11",
                                        "glosses": [
                                            "Propriété topologique d’une fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f4ebbf-d52c-4cd4-a421-023884012c1b",
                                                "sense_id": "553d3451-1ece-3d73-8018-526bda0678c4",
                                                "text": "Continuité en un point."
                                            },
                                            {
                                                "example_id": "2bc2ee63-e808-4db0-93b5-250c6dcc8d29",
                                                "sense_id": "553d3451-1ece-3d73-8018-526bda0678c4",
                                                "text": "Continuité à droite ou à gauche."
                                            },
                                            {
                                                "example_id": "75120d8a-cca5-4e4e-9dce-4eb12e4aece2",
                                                "sense_id": "553d3451-1ece-3d73-8018-526bda0678c4",
                                                "text": "Continuité sur un intervalle, un segment, une droite."
                                            },
                                            {
                                                "example_id": "6f39623b-1745-4e8e-9bbe-759e5e81cff1",
                                                "sense_id": "553d3451-1ece-3d73-8018-526bda0678c4",
                                                "text": "Continuité uniforme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081a93e6-698a-332c-be65-52850f493edb",
                                        "entry_id": "47e9c69e-830a-3271-91f3-e97924b05b11",
                                        "glosses": [
                                            "Capacité physique (ou type d’effort) s’apparentant à de l’endurance."
                                        ],
                                        "tags": [
                                            "Escalade"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd200877-ac25-46fc-aa26-f63046d93731",
                                                "sense_id": "081a93e6-698a-332c-be65-52850f493edb",
                                                "text": "La résistance se situe entre la force et la continuité, et lorsque l’on progresse dans ces domaines, on progresse également en résistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
