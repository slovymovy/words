                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I eat a bowl of <w>cereal</w> with milk every morning.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я съедаю тарелку <w>хлопьев</w> с молоком.",
                                "nl": "Ik eet elke ochtend een kom <w>ontbijtgranen</w> met melk.",
                                "pl": "Każdego ranka jem miskę <w>płatków</w> z mlekiem.",
                                "de": "Ich esse jeden Morgen eine Schüssel <w>Müsli</w> mit Milch.",
                                "fr": "Je mange un bol de <w>céréales</w> avec du lait chaque matin.",
                                "it": "Mangio una ciotola di <w>cereali</w> con il latte ogni mattina.",
                                "cs": "Každé ráno jím misku <w>cereálií</w> s mlékem.",
                                "tr": "Her sabah sütle bir kase <w>mısır gevreği</w> yerim.",
                                "es": "Como un tazón de <w>cereales</w> con leche todas las mañanas."
                            }
                        },
                        {
                            "text": "She poured some <w>cereal</w> into the bowl for breakfast.",
                            "target_lang_translations": {
                                "ru": "Она насыпала немного <w>сухого завтрака</w> в миску.",
                                "nl": "Ze goot wat <w>ontbijtgranen</w> in de kom voor het ontbijt.",
                                "pl": "Nasypała do miski trochę <w>płatków śniadaniowych</w> na śniadanie.",
                                "de": "Sie goss zum Frühstück etwas <w>Frühstücksflocken</w> in die Schüssel.",
                                "fr": "Elle a versé des <w>céréales</w> dans le bol pour le petit-déjeuner.",
                                "it": "Ha versato dei <w>cereali</w> nella ciotola per colazione.",
                                "cs": "Nasypala si do misky k snídani trochu <w>lupínků</w>.",
                                "tr": "Kahvaltı için kaseye biraz <w>gevrek</w> koydu.",
                                "es": "Ella sirvió un poco de <w>cereal</w> en el tazón para el desayuno."
                            }
