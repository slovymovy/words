                {
                    "sense_id": "118963e5-c8bd-39bb-953c-052fbf736ff9",
                    "sense_definition": "Mittelpunkt des Interesses oder der Aufmerksamkeit; Hauptaugenmerk",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "uebertragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei der Konferenz steht der Klimawandel im <w>Fokus</w> aller Diskussionen."
                        },
                        {
                            "text": "Das Thema erneuerbare Energien rückte schnell in den <w>Fokus</w> der Öffentlichkeit."
                        }
                    ],
                    "synonyms": [
                        "Brennpunkt",
                        "Mittelpunkt",
                        "Zentrum"
                    ],
                    "common_phrases": [
