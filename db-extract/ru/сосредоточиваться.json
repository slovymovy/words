                ],
                "senses": [
                    {
                        "sense_id": "8de1dabd-94a2-37b5-acf3-4fa3be21176d",
                        "entry_id": "9c608fdd-9e88-3a06-96cf-c401f35c88dc",
                        "glosses": [
                            "собираться, соединяться, накапливаться в каком-либо месте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e38b658-cbba-4d2a-b877-240d8bd51491",
                                "sense_id": "8de1dabd-94a2-37b5-acf3-4fa3be21176d",
                                "text": "Войска сосредоточиваются вокруг котла добивать противника, и тут уж никак без гаубичной бригады эргэка не обойтись."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ebe3061-1470-30e1-bbd6-a43bbb9e2c8e",
                        "entry_id": "9c608fdd-9e88-3a06-96cf-c401f35c88dc",
                        "glosses": [
                            "собирать свои мысли, напрягать внимание"
                        ],
                        "tags": [
                            "без дополн."
                        ],
                        "examples": [
                            {
                                "example_id": "d1863e10-8baf-4531-9bea-a5c2f0ad2357",
                                "sense_id": "2ebe3061-1470-30e1-bbd6-a43bbb9e2c8e",
                                "text": "Он должен сосредоточиваться всем своим существом на том, что его привлекает."
                            }
                        ]
                    },
                    {
                        "sense_id": "61fccb4d-0aa6-3712-afbd-32091012646f",
                        "entry_id": "9c608fdd-9e88-3a06-96cf-c401f35c88dc",
                        "glosses": [
                            "устремлять все свои мысли, всё своё внимание на что-либо, не отвлекаясь на остальное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ba5f09c-982e-4f6f-9da4-396ea57cf6b2",
                                "sense_id": "61fccb4d-0aa6-3712-afbd-32091012646f",
                                "text": "Они сосредоточиваются вокруг вопроса об условиях применимости центральной предельной теоремы теории вероятностей."
                            }
                        ]
                    },
                    {
                        "sense_id": "484f4894-536d-3c33-99a0-6f9fbe4dd179",
                        "entry_id": "9c608fdd-9e88-3a06-96cf-c401f35c88dc",
                        "glosses": [
                            "страд. к сосредоточивать"
                        ],
                        "tags": [],
                        "examples": []
                    }
