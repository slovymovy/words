                ],
                "senses": [
                    {
                        "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                        "entry_id": "9f7d8b33-c48e-38bb-b05c-98a7da4e2b66",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492aef0c-0908-4fd7-8992-20c18c88d058",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Frau Strasser ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d84a2efa-cb98-455b-9970-75a2558a5da9",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Herr Strasser wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "714f0ada-5a50-49d8-977a-2b8fcd70eb02",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Die Strassers fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "9660298b-0c57-4cbf-b91a-3593237b5d04",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Der Strasser trägt nie die Pullover, die die Strasser ihm strickt."
                            },
                            {
                                "example_id": "5bdaa820-eefd-44ee-bf7b-67f3e9a9f01d",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Strasser kommt, geht der Herr Strasser.“"
                            },
                            {
                                "example_id": "096153af-73ed-4004-aa68-17cbc78e33a9",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Strasser kommt und geht."
                            },
                            {
                                "example_id": "d55a3eb2-a684-411d-8e02-4f4a8abbf75e",
                                "sense_id": "0cb13b93-ef08-364f-9747-f7259d71dd8d",
                                "text": "Strassers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
