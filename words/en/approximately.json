{
    "word_family": [
        "approximate",
        "approximation"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                    "sense_definition": "Used to show that a number or amount is not exact, but is very close to the actual value.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flight to London will take <w>approximately</w> seven hours.",
                            "target_lang_translations": {
                                "ru": "Перелёт в Лондон займёт <w>приблизительно</w> семь часов.",
                                "pl": "Lot do Londynu potrwa <w>około</w> siedmiu godzin.",
                                "zh": "飞往伦敦的航班将耗时<w>大约</w>七个小时。"
                            }
                        },
                        {
                            "text": "In every box of matches there are <w>approximately</w> 40 matchsticks.",
                            "target_lang_translations": {
                                "ru": "В каждом коробке спичек находится <w>примерно</w> 40 спичек.",
                                "pl": "W każdym pudełku zapałek znajduje się <w>około</w> 40 sztuk.",
                                "zh": "每盒火柴里有<w>大约</w>40根火柴。"
                            }
                        },
                        {
                            "text": "The repair work on the car will cost <w>approximately</w> two hundred dollars.",
                            "target_lang_translations": {
                                "ru": "Ремонт автомобиля будет стоить <w>приблизительно</w> двести долларов.",
                                "pl": "Naprawa samochodu będzie kosztować <w>w przybliżeniu</w> dwieście dolarów.",
                                "zh": "汽车维修费用<w>大约</w>需要两百美元。"
                            }
                        }
                    ],
                    "synonyms": [
                        "about",
                        "around",
                        "roughly",
                        "nearly",
                        "more or less",
                        "close to"
                    ],
                    "antonyms": [
                        "exactly",
                        "precisely"
                    ],
                    "common_phrases": [
                        "approximately equal",
                        "approximately half",
                        "cost approximately",
                        "last approximately"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что число или количество не является точным, но очень близко к фактическому значению.",
                        "pl": "Używane do wskazania, że liczba lub ilość nie jest dokładna, ale jest bardzo zbliżona do rzeczywistej wartości.",
                        "zh": "用于表示数字或数量不完全精确，但非常接近实际数值。"
                    },
                    "translations": {
