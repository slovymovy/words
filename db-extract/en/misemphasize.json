                        "glosses": [
                            "To emphasize incorrectly or inappropriately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7913aabe-80a3-4ded-8a2d-960bc0b9673b",
                                "sense_id": "a2d4cd8b-50a7-305e-a803-c904a9183258",
                                "text": "But the widespread interest in intercollegiate debating and proper gratitude for what it has done to stimulate a study of the different forms of public discourse have led undergraduates, graduates, and even teachers, I think, greatly to misemphasize its importance in the field of study under discussion this morning — public discourse."
                            },
                            {
                                "example_id": "26018be8-9965-481f-97dd-a4bfaa8f09ac",
                                "sense_id": "a2d4cd8b-50a7-305e-a803-c904a9183258",
                                "text": "Instructions must accurately state the law, and must not mislead the jury or misemphasize some element."
                            },
                            {
                                "example_id": "cf2b1974-4f55-4596-a0ce-b5ff8bf32547",
                                "sense_id": "a2d4cd8b-50a7-305e-a803-c904a9183258",
                                "text": "Recent reformers like St. Dominic and St. Francis, he suggests, misemphasize certain aspects of the Christian religion: they emphasize the poverty and self-abnegation of Christ's life and preach the deferring of punishment for the wicked"
                            }
                        ]
                    }
