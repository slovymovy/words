                    {
                        "translation_id": "983df4e3-b4f8-41d7-a0f9-369d1a49ef88",
                        "source_entry_id": "5b6e83b6-b798-3bda-9ce5-8939b7c802f4",
                        "source_sense_description": "of or pertaining to postcolonialism",
                        "target_lang_word": "postcolonial",
