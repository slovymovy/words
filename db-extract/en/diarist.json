                        "examples": [
                            {
                                "example_id": "ca8dee34-6178-4298-a5a8-f0da8b981449",
                                "sense_id": "217ed692-e03b-32a6-be57-08a70fb306d4",
                                "text": "Two typical weeks (selected at random and separated by a long interval) are set out in the accompanying tables, and indicate the clear and concise method adopted by the diarist throughout his 42 working years."
                            }
                        ]
                    }
                ],
                "translations": [
