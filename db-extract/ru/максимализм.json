                                        "glosses": [
                                            "Doctrine ou comportement qui consiste à revendiquer le maximum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e20115-03de-46ad-88fd-f92bc66d308b",
                                                "sense_id": "7aa41617-efee-3be6-998a-cbbd678912f3",
                                                "text": "Leurs revendications font preuve d'un maximalisme inacceptable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e81a7c-46a3-3a23-9f71-bbabbf85f665",
                                        "entry_id": "535c6c64-c3ad-3526-a29b-64adb832a900",
                                        "glosses": [
                                            "Courant politique au sein du Parti socialiste italien créé par Giacinto Menotti Serrati en 1919, cherche à réaliser les objectifs anticapitalistes et révolutionnaires du socialisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99e874c-c311-483e-a62b-2654cab1cd7f",
                                                "sense_id": "f4e81a7c-46a3-3a23-9f71-bbabbf85f665",
                                                "text": "Bolchevisme et maximalisme formaient deux courants différents, mais par la suite, ils se sont souvent confondus."
                                            }
