                "senses": [
                    {
                        "sense_id": "0ff822cc-398c-31aa-95db-40bb55613918",
                        "entry_id": "4b9368f0-e18a-3ad1-ba77-73304cf08df4",
                        "glosses": [
                            "Kleidung, die anlässlich eines Trauerfalls getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb04132e-215e-485a-810d-5e7362ef6422",
                                "sense_id": "0ff822cc-398c-31aa-95db-40bb55613918",
                                "text": "„Goldlotos saß in Trauerkleidung in einer Sänfte.“"
                            },
                            {
                                "example_id": "93dcfe12-61a0-4104-821c-e02c81c95c73",
                                "sense_id": "0ff822cc-398c-31aa-95db-40bb55613918",
                                "text": "„Er wohnte seit zwei Tagen im gleichen Gasthof und trug Trauerkleidung, dazu ein Hemd mit ausgefransten Manschetten.“"
                            },
                            {
                                "example_id": "fb45f784-1c8b-4d0d-a35b-36df99f80fd9",
                                "sense_id": "0ff822cc-398c-31aa-95db-40bb55613918",
                                "text": "„Der Cowboy begegnet einem anderen, der in schwarzer Trauerkleidung auf seinem Pferd daherkommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
