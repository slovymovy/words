{
    "word_family": [
        "merry",
        "merrily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28754710-9ca8-3d5f-85a7-778068868d4d",
                    "sense_definition": "Playful fun and lighthearted activity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "joy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children filled the park with their <w>merriment</w> during the summer festival.",
                            "target_lang_translations": {
                                "es": "Los niños llenaron el parque con su <w>regocijo</w> durante el festival de verano."
                            }
                        },
                        {
                            "text": "The wedding reception was full of <w>merriment</w> and laughter among the guests.",
                            "target_lang_translations": {
                                "es": "La recepción de la boda estuvo llena de <w>alegría</w> y risas entre los invitados."
                            }
                        }
                    ],
                    "synonyms": [
                        "fun",
                        "gaiety",
                        "mirth"
                    ],
                    "common_phrases": [
                        "sounds of merriment",
                        "full of merriment"
                    ],
                    "target_lang_definitions": {
                        "es": "Diversión juguetona y actividad alegre."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "regocijo",
                                "target_lang_sense_clarification": "Gozo o alegría sentidos de forma intensa, a menudo en un contexto festivo."
                            },
                            {
                                "target_lang_word": "juguetoneo",
                                "target_lang_sense_clarification": "Actividad caracterizada por el juego y la diversión ligera."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5337a63e-bd7a-343d-bbcb-fdd0f9cbc697",
                    "sense_definition": "A state of lively, enjoyable exuberance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "joy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd erupted in <w>merriment</w> when the band started playing their favorite song.",
                            "target_lang_translations": {
                                "es": "La multitud estalló en <w>júbilo</w> cuando la banda empezó a tocar su canción favorita."
                            }
                        },
                        {
                            "text": "Despite the cold weather, the holiday <w>merriment</w> kept everyone in high spirits.",
                            "target_lang_translations": {
                                "es": "A pesar del clima frío, la <w>alegría</w> festiva mantuvo a todos con el ánimo en alto."
                            }
                        }
                    ],
                    "synonyms": [
                        "hilarity",
                        "glee",
                        "jollity"
                    ],
                    "common_phrases": [
                        "holiday merriment"
                    ],
                    "target_lang_definitions": {
                        "es": "Un estado de exuberancia viva y disfrutable."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "alegría",
                                "target_lang_sense_clarification": "Sensación de contento y felicidad, especialmente cuando se manifiesta en celebraciones."
                            },
                            {
                                "target_lang_word": "júbilo",
                                "target_lang_sense_clarification": "Sensación de contento intenso que se manifiesta de forma viva y vigorosa."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}