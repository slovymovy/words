                        "sense_id": "c5e78ce7-b81e-3a92-b6ac-f297bc8d9b0d",
                        "entry_id": "de45a3e5-f893-3dca-b615-bc9f52df83f6",
                        "glosses": [
                            "Nackenhebel, bei dem beide Arme unter den Achseln des Gegners hindurch geführt und die Hände hinter dessen Nacken verschränkt werden"
                        ],
                        "tags": [
                            "Ringen"
                        ],
                        "examples": [
                            {
                                "example_id": "6ed97a3b-ee31-4649-89d6-5f48bcea57e5",
                                "sense_id": "c5e78ce7-b81e-3a92-b6ac-f297bc8d9b0d",
                                "text": "„Ich packte Lee von hinten in einem Doppelnelson und drehte ihn zum Ausgang hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
