                ],
                "senses": [
                    {
                        "sense_id": "47b1b7f4-7c76-3662-8b78-a4d51fd2e36f",
                        "entry_id": "c1c23915-ce93-36dd-9e73-3214b09ba12e",
                        "glosses": [
                            "aanbieder van inlichtingen of kennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b1a4ce-4362-40d7-a4bf-94b1f00256a0",
                                "sense_id": "47b1b7f4-7c76-3662-8b78-a4d51fd2e36f",
                                "text": "Voor veel mensen is de tv nog altijd de belangrijkste informatiebron."
                            },
                            {
                                "example_id": "52605479-a97d-401a-bc13-a2d63c9372d0",
                                "sense_id": "47b1b7f4-7c76-3662-8b78-a4d51fd2e36f",
                                "text": "„De demissionaire regering spreekt zich uit voor een sterke lokale en streekgebonden journalistiek”, zegt Wijfjes. „Als deze kranten verdwijnen, moeten we ons ernstig zorgen maken over de informatievoorziening op lokaal niveau. Deze kranten zijn voor mensen zonder een abonnement vaak de enige onafhankelijke informatiebron, als gemeenten die taak overnemen krijg je informatiekrantjes zonder enige kritische noot.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f300b88-6d12-3928-a492-146aaaa45bea",
                        "entry_id": "c1c23915-ce93-36dd-9e73-3214b09ba12e",
                        "glosses": [
                            "herkomst van bepaalde inlichtingen of kennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb9e9f8-266b-495a-9b3b-906881fc889f",
                                "sense_id": "1f300b88-6d12-3928-a492-146aaaa45bea",
                                "text": "Bij haar eerste opname en ook later was ik voor de ggz-instelling een belangrijke informatiebron. Als moeder kende ik mijn dochter immers als geen ander?"
                            },
                            {
                                "example_id": "c1acd677-e168-4337-8c73-aee45d2775d7",
                                "sense_id": "1f300b88-6d12-3928-a492-146aaaa45bea",
                                "text": "De informatiebron voor alle roddels bleek een jaloerse collega te zijn."
                            },
                            {
                                "example_id": "b3ebb6c2-e8bc-413b-9456-203a8b7285df",
                                "sense_id": "1f300b88-6d12-3928-a492-146aaaa45bea",
                                "text": "Gestolen accountgegevens, afkomstig van eerdere datalekken, zijn ook een dankbare informatiebron: veel mensen hergebruiken hun wachtwoorden nog altijd – tegen beter weten in."
                            }
                        ]
                    }
