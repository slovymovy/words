                    }
                ],
                "senses": [
                    {
                        "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                        "entry_id": "da7e2838-4fe6-3dd6-9f90-760aa418a216",
                        "glosses": [
                            "jemand, der Urlaub macht; der sich im Urlaub befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c53dfc6-46d5-4e04-a784-88fe7e910e9d",
                                "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                "text": "Die Urlauber warteten auf den Reiseleiter."
                            },
                            {
                                "example_id": "0b8ad85d-00fd-4aac-a86c-d86a53a752d1",
                                "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                "text": "„Der letzte Schwung Urlauber der Saison war abgereist.“"
                            },
                            {
                                "example_id": "af8f7b75-b538-4a66-a0bc-2473d9b44597",
                                "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                "text": "„Am Straßenrand war ein Reisebus geparkt und eine Flut von Urlaubern überschwemmte nun das Dorf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
