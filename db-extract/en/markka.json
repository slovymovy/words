                                                "sense_id": "bbd2c590-316a-3a7d-ae60-aad848e26773",
                                                "text": "Wśród innych staroci po stryju pozostał podniszczony kajet ze zbiorem starannie powklejanych marek."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "946ce39d-2d51-32af-8d11-6e3a7b87d130",
                                        "entry_id": "256a12da-dace-3e70-bcb4-5ca3a66417da",
                                        "glosses": [
