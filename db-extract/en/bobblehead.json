                                    {
                                        "sense_id": "249e67d0-6e5b-37dd-a461-5345b8fcfd3b",
                                        "entry_id": "66d269b5-129a-36f5-8809-9b95ba8ec01b",
                                        "glosses": [
                                            "ein Ziergegenstand in Form einer Dackelnachbildung mit beweglichem Kopf, vor allem für Armaturenbrett oder Hutablage im Personenkraftwagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f329be08-3c45-47d5-ae2c-9d5670a0518c",
                                                "sense_id": "249e67d0-6e5b-37dd-a461-5345b8fcfd3b",
                                                "text": "Bei einer Kollision entstehen enorme Fliehkräfte. Da schafft es selbst der Wackeldackel auf der Hutablage mühelos, die Frontscheibe zu durchschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcf68455-7a47-32de-920c-b394c24174cf",
                                        "entry_id": "66d269b5-129a-36f5-8809-9b95ba8ec01b",
                                        "glosses": [
                                            "eine Person, die ausschließlich Zustimmung und/oder Beifall bekundet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d69e1d2-d839-48db-89c4-7ab5b09d4a5a",
                                                "sense_id": "fcf68455-7a47-32de-920c-b394c24174cf",
                                                "text": "Und die Kulturreferentin spielt den Wackeldackel, der brav nickt zu allem, was der Oberbürgermeister sagt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "840fc1b5-32b2-3156-97d1-f37183069ba2",
                                        "entry_id": "66d269b5-129a-36f5-8809-9b95ba8ec01b",
                                        "glosses": [
                                            "eine Person, die sich nicht festlegt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253c9558-149f-45f8-ad8a-df5205617a4f",
                                                "sense_id": "840fc1b5-32b2-3156-97d1-f37183069ba2",
                                                "text": "„Die Union ist in der Koalitionsfrage ein Wackeldackel. Die Union muss in der Koalitionsfrage endlich Klarheit schaffen.“ – Guido Westerwelle"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
