                        "glosses": [
                            "een reis die men maakt om een gebied of situatie te onderzoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cdec685-ed3e-416a-8d14-3a2f46cc19eb",
                                "sense_id": "d7988dab-8f97-3523-acb7-33d51c0ad65b",
                                "text": "Ik besloot op verkenningstocht te gaan om te kijken waar ik veilig de rivier kon oversteken om de trail te kunnen vervolgen."
                            },
                            {
                                "example_id": "182ba45b-6fd0-413c-9899-b2b99281be56",
                                "sense_id": "d7988dab-8f97-3523-acb7-33d51c0ad65b",
                                "text": "Terwijl heel China in de ban is van het coronavirus, was er in Tokio van stress weinig te merken, zo ervoer Sarina Wiegman tijdens haar olympische verkenningstocht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a49d010e-fc0d-4e94-9fc3-45efdb08b961",
                        "source_entry_id": "ed0f1703-2929-36fb-b1c4-8f835c90aea7",
                        "source_sense_id": "d7988dab-8f97-3523-acb7-33d51c0ad65b",
                        "source_sense_description": "een reis die men maakt om een gebied of situatie te onderzoeken",
                        "target_lang_word": "expedition",
                        "target_lang_code": "en",
