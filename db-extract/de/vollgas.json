                        "cross_references": [
                            {
                                "target_word": "à fond la caisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afe82b71-f3a0-32a5-adbb-07eec9b8b67f",
                                        "entry_id": "c1ec5cce-ad19-3b60-9010-84dcd358e717",
                                        "glosses": [
                                            "À toute allure, à grande vitesse, très vite, très fort avec un véhicule."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92bd1ac6-e6b1-4f5e-a359-6a599bad09e7",
                                                "sense_id": "afe82b71-f3a0-32a5-adbb-07eec9b8b67f",
                                                "text": "Le douchebag adore rouler à fond la caisse sur une petite route de campagne au son d’une musique techno sans âme."
                                            },
                                            {
                                                "example_id": "46074993-b70c-4863-b00a-2ba046961447",
                                                "sense_id": "afe82b71-f3a0-32a5-adbb-07eec9b8b67f",
                                                "text": "L’abbé Fennèque hélas, ne buvait ni vin ni bonne ; le vin dont il se saoulait, c’était sa moto, Peugeot rutilante qu’il enfourchait aux heures creuses quand tout M&mnoux était au turbin ou à l’école & l’aube retroussée jusqu’aux genoux, il parcourait champs & bois à fond la caisse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53793a0-127c-4b73-beb0-fb1a40c14539",
                        "source_entry_id": "27388224-37eb-3e75-8260-e1e2b3454d66",
                        "source_sense_id": "7acd68ae-8263-3efd-bea8-a7f9cd220f15",
