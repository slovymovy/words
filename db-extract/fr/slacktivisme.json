                                        "glosses": [
                                            "Half-hearted activism, usually in the form of posting badges, images, apps, or text on social media without taking further action."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
