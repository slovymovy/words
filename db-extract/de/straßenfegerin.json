                "translations": [
                    {
                        "translation_id": "c7595160-0ba4-4bc8-af07-4dcd3962e20d",
                        "source_entry_id": "ebdf8529-34f5-30e1-b644-5c5e83bac253",
                        "source_sense_id": "bd3b1b3a-e0d0-31f6-a7dd-7ee72ab2de1b",
                        "source_sense_description": "weibliche Person, deren Aufgabe die Reinigung der (öffentlichen) Straßen und Plätze ist",
                        "target_lang_word": "balayeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balayeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08afdfa5-619e-317c-a61e-6e0193680276",
                                        "entry_id": "43b07ed9-14ab-34bd-b967-463d234f5bdd",
                                        "glosses": [
                                            "Celle qui balaye."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3844f376-8bce-4667-8030-b6822eb6c595",
                                                "sense_id": "08afdfa5-619e-317c-a61e-6e0193680276",
                                                "text": "La balayeuse a interrompu son travail, et les deux mains appuyées sur son outil, dans une pose pleine de noblesse :\n— « Tu sais, toi, dit-elle à Clérice, quand chacune de nous aura repris sa vraie place, moi je serai très bien catin. Mais toi, faudra voir comme tu balayeras ! »"
                                            },
                                            {
                                                "example_id": "387e69b2-5565-45d1-b372-7ac30a0a7b01",
                                                "sense_id": "08afdfa5-619e-317c-a61e-6e0193680276",
                                                "text": "1905 : les dévideuses de Saint-Étienne, les décalqueuses de Limoges, les tisseuses de Satillieu, les cartonnières de Villeurbanne, les ouvrières voilières de Marseille, les balayeuses de Nantes ; mais aussi, en Algérie, les 800 cigarières d’Oran, puis celles d’Alger, font grève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16a57b0-460a-3612-b9b7-0ec2ab4df58d",
                                        "entry_id": "43b07ed9-14ab-34bd-b967-463d234f5bdd",
                                        "glosses": [
                                            "Véhicule muni d’un balai rotatif destiné à nettoyer les rues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2b73b5-d52b-4633-aabc-14107822582d",
                                                "sense_id": "c16a57b0-460a-3612-b9b7-0ec2ab4df58d",
                                                "text": "Réseau inextricable de ruelles dallées, que les balayeuses mécaniques s’useraient à nettoyer […]"
                                            },
                                            {
                                                "example_id": "90c283be-b683-4bad-b0a2-ac65fc39d66d",
                                                "sense_id": "c16a57b0-460a-3612-b9b7-0ec2ab4df58d",
                                                "text": "L’achat des balayeuses entraîne la suppression de deux cents balayeurs, c’est même en insistant sur cette économie que j’ai enlevé le vote du conseil municipal."
                                            },
                                            {
                                                "example_id": "48b5f033-daff-438f-94e0-2c5300135efb",
                                                "sense_id": "c16a57b0-460a-3612-b9b7-0ec2ab4df58d",
                                                "text": "Seules les balayeuses municipales circulaient, ainsi que quelques Anglais qui s’obstinaient à prendre de véritables bains de mer et qui, en peignoir, se dirigeaient à grands pas vers la plage."
                                            },
                                            {
                                                "example_id": "eed6f907-3e28-43a1-98bd-948fb0e4f2d8",
                                                "sense_id": "c16a57b0-460a-3612-b9b7-0ec2ab4df58d",
                                                "text": "L’on ne voit âme qui vive et l’on entend seulement par intervalles la trépidation sourd d’une balayeuse électrique qui fait des efforts désespérés pour déblayer la voie des tramways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "821ca2ca-206f-3d8e-9e01-03089fa7653b",
                                        "entry_id": "43b07ed9-14ab-34bd-b967-463d234f5bdd",
                                        "glosses": [
                                            "Tissu cousu sous la traîne d’une robe pour la rigidifier et la préserver de la poussière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb2a067-1def-4f14-b797-bdfc4991ddf9",
                                                "sense_id": "821ca2ca-206f-3d8e-9e01-03089fa7653b",
                                                "text": "Elle se donne du bon temps, détaille, épluche,\nNe juge pas assez fraîche certaine ruche,\nCondamne pour son trop d’empois certain volant,\nDésapprouve un corsage ajusté, trop collant,\nOu déniche le bout blanc d’une balayeuse\nQui dépasse ou qui pend peut-être."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e50ce03-023e-38dd-8510-8fd3c25ea8bd",
                                        "entry_id": "43b07ed9-14ab-34bd-b967-463d234f5bdd",
                                        "glosses": [
                                            "Aspirateur."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5750049-21c1-4542-8e0e-0f1384c8ce4c",
                                                "sense_id": "3e50ce03-023e-38dd-8510-8fd3c25ea8bd",
                                                "text": "Ne pas pouvoir balayer pendant que l’appareil est branché est frustrant, puisque cela réduit l’intérêt de la balayeuse à long terme et incite à son remplacement plus tôt que nécessaire. Pour un appareil vendu 949 $, on se serait attendu à mieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c92c6b5-e525-35ea-ba52-d93ea7e668d4",
                                        "entry_id": "43b07ed9-14ab-34bd-b967-463d234f5bdd",
                                        "glosses": [
                                            "Longue redingote balayant le sol."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d00c0d9-f486-4e28-80df-50c29fd3cbbf",
                                                "sense_id": "9c92c6b5-e525-35ea-ba52-d93ea7e668d4",
                                                "text": "Je portais … un habit couleur flamme-de-punch, la nuance en vogue, sur lequel s’épanouissait une redingote noisette, dite balayeuse, dont la jupe, drapant en tuyaux d’orgue, ondoyait à chaque mouvement, et figurait, quand je la relevais de chaque côté en manière d’éventail, une paire d’ailes de chauves-souris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
