                        "entry_id": "d59c049c-f3d5-3426-87f9-11884806b6d2",
                        "glosses": [
                            "Cigarette industrielle, déjà roulée, par opposition à celle que l’on roule soi-même."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "39a7e811-ef34-43c0-a347-08449dab54a1",
                                "sense_id": "08430f80-d576-347e-bac4-7fdd077787f0",
                                "text": "Mine de rien, j’allume une cousue."
                            },
                            {
                                "example_id": "fafa2132-6eed-42df-a252-bbcb92394bd8",
                                "sense_id": "08430f80-d576-347e-bac4-7fdd077787f0",
                                "text": "Quelqu’un le vit un jour en train de couper au rasoir une cousue, autre surnom de la chose, et de disposer les deux bouts devant lui. Il aurait ainsi l’impression, dit-il au visiteur, de fumer deux cigarettes au lieu d’une […]."
                            },
                            {
                                "example_id": "d07915f4-1aba-40f6-a4ec-925f6de5a2d4",
                                "sense_id": "08430f80-d576-347e-bac4-7fdd077787f0",
                                "text": "Certains ont offert aux copains et grillé à la hâte une “cousue” au dernier moment."
                            }
                        ]
                    }
