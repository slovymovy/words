                "senses": [
                    {
                        "sense_id": "16f021d9-7962-3e4a-bd0a-b144ae9bde88",
                        "entry_id": "eb3bc89e-1c3d-3427-b3b6-57a65a05d450",
                        "glosses": [
                            "Having, or pertaining to, a tendency to fidget; restless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d96147-d6dd-4042-a4b9-0bfb3416478b",
                                "sense_id": "16f021d9-7962-3e4a-bd0a-b144ae9bde88",
                                "text": "I did not feel sea-sick at all. But as the days passed, I became fidgety. I felt shy even in speaking to the steward. […]"
                            },
                            {
                                "example_id": "11aa6570-792d-4903-b127-6056c2ea960b",
                                "sense_id": "16f021d9-7962-3e4a-bd0a-b144ae9bde88",
                                "text": "A fidgety child can easily knock over the drink and burn the two of you."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee81c3c1-347d-4d74-b938-46d0d153fd63",
                        "source_entry_id": "eb3bc89e-1c3d-3427-b3b6-57a65a05d450",
                        "source_sense_id": "16f021d9-7962-3e4a-bd0a-b144ae9bde88",
                        "source_sense_description": "having, or pertaining to, a tendency to fidget",
                        "target_lang_word": "ongedurig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongedurig",
