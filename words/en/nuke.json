    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53abe94f-854b-329b-bafb-79be1c9f60eb",
                    "sense_definition": "To use a nuclear weapon on a target.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nuclear_warfare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general warned that the enemy might <w>nuke</w> the capital if the peace talks failed.",
                            "target_lang_translations": {
                                "ru": "Генерал предупредил, что враг может <w>нанести ядерный удар</w> по столице, если мирные переговоры провалятся."
                            }
                        },
                        {
                            "text": "In the movie, the heroes must stop a villain who wants to <w>nuke</w> the entire planet.",
                            "target_lang_translations": {
                                "ru": "В фильме герои должны остановить злодея, который хочет <w>уничтожить</w> всю планету ядерным оружием."
                            }
                        }
                    ],
                    "synonyms": [
                        "annihilate",
                        "obliterate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применить ядерное оружие против цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нанести ядерный удар",
                                "target_lang_sense_clarification": "атаковать ядерным оружием"
                            },
                            {
                                "target_lang_word": "сбросить атомную бомбу",
                                "target_lang_sense_clarification": "уничтожить с помощью бомбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70669e2a-2264-3766-95ef-6bdfd6f3899f",
                    "sense_definition": "To cook or heat food in a microwave oven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "microwave_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you are in a hurry, you can just <w>nuke</w> some pizza for dinner.",
                            "target_lang_translations": {
                                "ru": "Если ты торопишься, можешь просто <w>разогреть в микроволновке</w> пиццу на ужин."
                            }
                        },
                        {
                            "text": "I will <w>nuke</w> the leftovers for two minutes until they are hot.",
                            "target_lang_translations": {
                                "ru": "Я <w>поставлю</w> остатки еды <w>в микроволновку</w> на две минуты, пока они не станут горячими."
                            }
                        }
                    ],
                    "synonyms": [
                        "microwave",
                        "zap"
                    ],
                    "common_phrases": [
                        "nuke some pizza",
                        "nuke the leftovers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for microwaving"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить или разогревать еду в микроволновой печи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разогреть в микроволновке",
                                "target_lang_sense_clarification": "использовать СВЧ-печь"
                            },
                            {
                                "target_lang_word": "поставить в микроволновку",
                                "target_lang_sense_clarification": "быстро приготовить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7986986-08e8-31ed-ba59-59c0f9835112",
                    "sense_definition": "To destroy or erase something completely, often in a digital or metaphorical context.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administrator decided to <w>nuke</w> the entire thread because it was full of spam.",
                            "target_lang_translations": {
                                "ru": "Администратор решил <w>снести</w> всю ветку обсуждения, потому что она была забита спамом."
                            }
                        },
                        {
                            "text": "A single mistake in the code could <w>nuke</w> the whole database.",
                            "target_lang_translations": {
                                "ru": "Одна ошибка в коде может <w>грохнуть</w> всю базу данных."
                            }
                        }
                    ],
                    "synonyms": [
                        "wipe out",
                        "erase",
                        "delete"
                    ],
                    "common_phrases": [
                        "nuke the database",
                        "nuke the archives"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in tech and gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью уничтожить или стереть что-либо, часто в цифровом или метафорическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снести",
                                "target_lang_sense_clarification": "полностью удалить данные или контент"
                            },
                            {
                                "target_lang_word": "уничтожить",
                                "target_lang_sense_clarification": "стереть без возможности восстановления"
                            },
                            {
                                "target_lang_word": "грохнуть",
                                "target_lang_sense_clarification": "сленг: удалить базу или файл"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb092dea-b5c9-3cd6-8265-67b5f8994db3",
                    "sense_definition": "To carry out a denial-of-service attack against a user or system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cyber_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hacker tried to <w>nuke</w> the server to take the website offline.",
                            "target_lang_translations": {
                                "ru": "Хакер пытался <w>положить</w> сервер, чтобы отключить сайт."
                            }
                        },
                        {
                            "text": "He was banned from the chat after trying to <w>nuke</w> other users.",
                            "target_lang_translations": {
                                "ru": "Его забанили в чате после попытки <w>занюкать</w> других пользователей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specifically used in computing and IRC contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществить DoS-атаку против пользователя или системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положить",
                                "target_lang_sense_clarification": "вывести сервер из строя атакой"
                            },
                            {
                                "target_lang_word": "занюкать",
                                "target_lang_sense_clarification": "хакерский сленг: атаковать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56c3344e-8ac5-3610-b638-0c75cdfd9f07",
                    "sense_definition": "To overanalyze or despair unduly over something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "overthinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't <w>nuke</w> the situation; it is much simpler than you think.",
                            "target_lang_translations": {
                                "ru": "Не <w>накручивай себя</w>; ситуация гораздо проще, чем ты думаешь."
                            }
                        },
                        {
                            "text": "He started to <w>nuke</w> the project details until he was too stressed to work.",
                            "target_lang_translations": {
                                "ru": "Он начал так сильно <w>усложнять</w> детали проекта, что впал в стресс и не мог работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "overthink",
                        "obsess"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "rare metaphorical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно анализировать или неоправданно отчаиваться из-за чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накручивать себя",
                                "target_lang_sense_clarification": "слишком сильно переживать"
                            },
                            {
                                "target_lang_word": "усложнять",
                                "target_lang_sense_clarification": "чрезмерно анализировать ситуацию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbb82fd2-aba6-3ed6-8ad1-7bad12fbe4ae",
                    "sense_definition": "A nuclear weapon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nuclear_warfare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treaty was designed to reduce the number of <w>nukes</w> held by each country.",
                            "target_lang_translations": {
                                "ru": "Договор был направлен на сокращение количества <w>ядерных боеголовок</w>, имеющихся у каждой страны."
                            }
                        },
                        {
                            "text": "He claimed he could buy <w>nukes</w> on the black market for millions of dollars.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что может купить <w>ядерные бомбы</w> на черном рынке за миллионы долларов."
                            }
                        }
                    ],
                    "synonyms": [
