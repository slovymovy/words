                        "translation_id": "c19948d0-4160-486a-a8e5-4a692088480e",
                        "source_entry_id": "61f4ed00-5483-3e68-803c-fa7df6aa1124",
                        "source_sense_id": "e3f856bb-0466-3689-a706-84c6cca287e1",
                        "target_lang_word": "доверить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "доверить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f432d458-eec1-3285-9118-1c7fd1d01136",
                                        "entry_id": "b0b02b97-c3c0-300f-b286-209505ac9494",
                                        "glosses": [
                                            "оказывая доверие, поручить, передать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19021cbe-b5ef-4dfe-a48b-2bc2171adabc",
                                                "sense_id": "f432d458-eec1-3285-9118-1c7fd1d01136",
                                                "text": "Ведь я могу доверить эту роль только своему единомышленнику."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e72c7b-c7b2-3534-b781-cc21cfb1e0fd",
                                        "entry_id": "b0b02b97-c3c0-300f-b286-209505ac9494",
                                        "glosses": [
                                            "чувствуя доверие к кому-либо, сообщить ему что-либо сокровенное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881098a6-c560-40a0-a952-cc325b03c2aa",
                                                "sense_id": "e6e72c7b-c7b2-3534-b781-cc21cfb1e0fd",
                                                "text": "В Риме много англичан, напишите к одному из них, которому бы можно было доверить тайну; через него я буду ожидать ваших добрых советов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "2d46edbb-0c32-372c-8977-06282d511f2e",
