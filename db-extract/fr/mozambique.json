                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49988a7c-1a16-4be8-a52f-dffd977d1168",
                                                "sense_id": "376c760e-fe56-36bd-a32f-56170e80161f",
                                                "text": "In Mosambik werden über 40 verschiedene Sprachen gesprochen."
                                            },
                                            {
                                                "example_id": "94934ac3-77f1-4c9f-98fa-82090a5abdaf",
                                                "sense_id": "376c760e-fe56-36bd-a32f-56170e80161f",
                                                "text": "Maputo ist die Hauptstadt von Mosambik."
                                            },
                                            {
                                                "example_id": "1f7d086d-cc23-4a7d-82c2-a515eb638dc1",
                                                "sense_id": "376c760e-fe56-36bd-a32f-56170e80161f",
                                                "text": "„Die 1998 errichtete Aluminium-Hütte Mozal verarbeitet importiertes Bauxit zu Aluminium, dem mittlerweile wichtigsten Exportgut Mosambiks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
