                                        "entry_id": "428a34b6-7de2-365d-a087-3b3d47b13fdd",
                                        "glosses": [
                                            "Besetzung, Eroberung gegen Widerstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb2b3788-4ddc-4652-8ba9-8bf1f42cc0e4",
                                                "sense_id": "c3f91d3d-407e-3fae-994d-e3a54bba6882",
                                                "text": "Spätestens mit der Einnahme Ostpreußens kündigte sich das Ende des 3. Reiches an."
                                            },
                                            {
                                                "example_id": "1a710326-0071-4325-abcc-1d106767141f",
                                                "sense_id": "c3f91d3d-407e-3fae-994d-e3a54bba6882",
                                                "text": "„Hannibal, so lautet der häufig erhobene Vorwurf, hätte nach dem römischen Debakel den Krieg durch die Einnahme Roms beenden können.“"
                                            },
                                            {
                                                "example_id": "a7b595c6-cee4-4d63-be8a-c27d85e496e0",
                                                "sense_id": "c3f91d3d-407e-3fae-994d-e3a54bba6882",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage. Sie hatten den Kelten nun nichts mehr entgegenzusetzen und mußten die Einnahme und Plünderung ihrer Stadt hinnehmen.“"
                                            },
                                            {
                                                "example_id": "20b63b33-8f55-4497-890e-eb5624b67239",
                                                "sense_id": "c3f91d3d-407e-3fae-994d-e3a54bba6882",
                                                "text": "„Die schönsten Schreckensmeldungen häuften sich jetzt mit Blitzgeschwindigkeit: die Einnahme Frankreichs, die Kapitulation Italiens, die Rote Armee an den Grenzen Polens, die Befreiung Lublins.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "692056d0-6197-35c9-b45c-f696fed061b6",
                                        "entry_id": "428a34b6-7de2-365d-a087-3b3d47b13fdd",
                                        "glosses": [
                                            "Essen oder Trinken eines Medikaments"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd437cf-08c4-40fe-99bc-c4bb5014ec3c",
                                                "sense_id": "692056d0-6197-35c9-b45c-f696fed061b6",
                                                "text": "Mancher tut sich schwer mit der Einnahme von Medikamenten."
                                            },
                                            {
                                                "example_id": "8720b303-8433-499e-ae77-9dcce3774c1e",
                                                "sense_id": "692056d0-6197-35c9-b45c-f696fed061b6",
                                                "text": "„Nach der Einnahme von Mifygene wird der Gebärmutterhals weich und öffnet sich, Gebärmutterschleimhaut löst sich. Dabei stirbt der Embryo ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "63a845a1-6507-3e74-afb4-130d6ce6363f",
                                        "entry_id": "428a34b6-7de2-365d-a087-3b3d47b13fdd",
                                        "glosses": [
                                            "eingenommenes Geld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ab521b-6331-489d-a751-f886d1b4c4a0",
                                                "sense_id": "63a845a1-6507-3e74-afb4-130d6ce6363f",
                                                "text": "„Bei den Überweisungen handele es sich um berechtigte Einnahmen der Bahn, damit diese eine Rendite von 14 Prozent erzielen könne.“"
                                            },
                                            {
                                                "example_id": "bcfa91a9-a720-4460-98cb-326714dfcb13",
                                                "sense_id": "63a845a1-6507-3e74-afb4-130d6ce6363f",
                                                "text": "„Einnahmen kommen von einem Teil der Eintrittskarten und dem Buchverkauf, es könnte knapp werden, aber schließlich macht man so etwas auch für die Ehre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
