                    {
                        "sense_id": "6857eaef-8bb6-38f8-8c1f-45192f50c92c",
                        "entry_id": "490cd12e-b06b-39a3-8c90-94b1121cd244",
                        "glosses": [
                            "The state or quality of being amorous."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "587eb45d-c253-42ba-a61d-7dfda723dc81",
                                "sense_id": "6857eaef-8bb6-38f8-8c1f-45192f50c92c",
                                "text": "And in her soul, she was lonely, because even Vanessa, to whose strength she clung, and on whose courage she leaned, knew nothing of what Jack Ashton's vices and follies, his disgraceful infidelities, and yet more disgraceful amorousnesses had taught her, nothing of where her knowledge had brought her."
                            },
                            {
                                "example_id": "3155711f-6155-4ed6-80f0-875c9218b3e5",
                                "sense_id": "6857eaef-8bb6-38f8-8c1f-45192f50c92c",
                                "text": "There was a legend that Cleopatra was accustomed to dissolve pearls in vinegar and drink the fluid in order to promote her amorousness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf211b5d-c766-4e8a-ad81-c82e59040bd1",
                        "source_entry_id": "490cd12e-b06b-39a3-8c90-94b1121cd244",
                        "source_sense_id": "6857eaef-8bb6-38f8-8c1f-45192f50c92c",
                        "source_sense_description": "the state or quality of being amorous",
                        "target_lang_word": "Verliebtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verliebtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                        "entry_id": "baff6bf9-5867-36d2-8dc0-192ac06943ac",
                                        "glosses": [
                                            "der Zustand, verliebt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d082fb1-7c28-4e50-8d84-6bf4b6bbd192",
                                                "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                                "text": "„Im Rostowschen Hause hatte sich in jener Zeit eine ganz besondere Atmosphäre von Verliebtheit gebildet, wie das häufig in solchen Häusern geschieht, wo es besonders anmutige junge Mädchen gibt.“"
                                            },
                                            {
                                                "example_id": "c35bec07-df77-4c06-b11a-144f9d49c417",
                                                "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                                "text": "„Ich beugte mich ihren Wünschen und hoffte in meiner immer noch zunehmenden Verliebtheit auf die Natur, die auf die Dauer stets stärker ist als alle Vorurteile.“"
                                            },
                                            {
                                                "example_id": "4a07e00e-2e67-49ce-ae26-c6842396ef71",
                                                "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                                "text": "„Gewiß hatte auch bei ihm bei aller möglichen Verliebtheit die Tatsache eine Rolle gespielt, daß er Marie aus einer sündigen in eine sündlose Situation rettete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
