                    {
                        "translation_id": "619542de-dade-45cc-8d67-1d05719a2e99",
                        "source_entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                        "source_sense_description": "a process by which anything disintegrates",
                        "target_lang_word": "désintégration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désintégration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "416f042e-c2fe-3e9c-8cd3-2d39597eb699",
                                        "entry_id": "29df17d8-7c54-3582-ba49-1f9f25a7516e",
                                        "glosses": [
                                            "Action de se désintégrer ; le fait de se désintégrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a52bda0-ec90-48d0-a3eb-0a72945da8c0",
                                                "sense_id": "416f042e-c2fe-3e9c-8cd3-2d39597eb699",
                                                "text": "La désintégration des structures étatiques, en Autriche-Hongrie ou en Allemagne, produit les mêmes effets suicidigènes. Ces personnalités fragiles ont besoin de cadres sociaux rigides."
                                            },
                                            {
                                                "example_id": "c47851e1-e20a-4fac-bb1b-1e9a06144b55",
                                                "sense_id": "416f042e-c2fe-3e9c-8cd3-2d39597eb699",
                                                "text": "De plus, une ligne est restée connectée pendant 45 minutes après la désintégration complète de l’avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85302dc8-5bfc-32a1-ade6-288bb5033fd5",
                                        "entry_id": "29df17d8-7c54-3582-ba49-1f9f25a7516e",
                                        "glosses": [
                                            "Destruction spontanée ou provoquée du noyau atomique d’un élément chimique, qui se transforme en d’autres éléments de masse atomique plus faible, avec libération d’énergie sous forme de radiations."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7f8ec2e-c80d-4c10-98fb-8669a5da0b9e",
                        "source_entry_id": "47aa65f3-d0d8-3c12-8238-1ba3493a7a01",
                        "source_sense_description": "a process by which anything disintegrates",
                        "target_lang_word": "Zerfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zerfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85715d17-bee1-31ea-b56a-e3e819f57246",
                                        "entry_id": "a42c9305-fe38-370f-8a0e-c494c1f20d4a",
                                        "glosses": [
                                            "das Zerfallen; allmähliche Auflösung in die Bestandteile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0881dc7-efc5-4e2a-b8b9-ab8605ec1e62",
                                                "sense_id": "85715d17-bee1-31ea-b56a-e3e819f57246",
                                                "text": "„Ich benenne in diesem Zusammenhang nur das dringlichste Problem: Schon seit langem wird der Zerfall der Kastelle am großen Donaufluss beklagt, ein Übelstand, der den Barbaren ihr freches Vordringen leicht werden lässt.“"
                                            },
                                            {
                                                "example_id": "35643132-4dd6-4148-86d5-04ef38f88ae2",
                                                "sense_id": "85715d17-bee1-31ea-b56a-e3e819f57246",
                                                "text": "„Neben Feuchtigkeit und Luftverschmutzung haben Mikroorganismen einen bedeutenden Anteil am Zerfall alter Wandgemälde.“"
                                            },
                                            {
                                                "example_id": "a39c498f-6f90-454c-aa54-fd304025a87b",
                                                "sense_id": "85715d17-bee1-31ea-b56a-e3e819f57246",
                                                "text": "„Nur die Alte, um die sich alle drängten, saß regungslos, als sei sie mumifiziert, mit allen Zeichen ihres Zerfalls und nahen Endes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9eca9cd-691f-3f37-9e3f-79aa3a73aa0f",
                                        "entry_id": "a42c9305-fe38-370f-8a0e-c494c1f20d4a",
                                        "glosses": [
                                            "die spontane Spaltung eines Atomkerns"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1628d8d3-e0ec-4fb6-9b3b-1b9c4a539b9a",
                                                "sense_id": "a9eca9cd-691f-3f37-9e3f-79aa3a73aa0f",
                                                "text": "„Nicht nur der Zeitpunkt des Zerfalls ist zufällig, sondern unter Umständen auch die Art des Zerfalls.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4257f48f-0b76-3b9d-956d-e4381f4e3f07",
                                        "entry_id": "a42c9305-fe38-370f-8a0e-c494c1f20d4a",
                                        "glosses": [
                                            "das Zugrundegehen, der Untergang (einer Gesellschaft oder Gesellschaftsordnung)"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab0e045-2869-4426-a212-2a551848f57e",
                                                "sense_id": "4257f48f-0b76-3b9d-956d-e4381f4e3f07",
                                                "text": "„Obgleich der Putschversuch in nur drei Tagen scheiterte und Gorbatschow wieder eingesetzt wurde, beschleunigte das Ereignis den Zerfall der UdSSR.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
