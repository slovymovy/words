                ],
                "senses": [
                    {
                        "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                        "entry_id": "63dde0dd-207b-31b1-a76b-c3f094880f60",
                        "glosses": [
                            "amtlich oder institutsintern bestellte männliche Person, die als Verkehrsexperte Verkehrsfragen klären beziehungsweise als Multiplikator die Förderung der Verkehrserziehung betreiben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65de43f3-837f-4320-bcce-3ff1c710b599",
                                "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                                "text": "„Außerdem verlangt die SPD Mobilitäts-Beratungsstellen und Verkehrsbeauftragte in allen Bezirken.“"
                            },
                            {
                                "example_id": "a88a1a61-102d-49ae-859a-ba057f1df07c",
                                "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                                "text": "„Hier muss sich die Zusammenarbeit von Eltern, Polizeibeamten, Kindergärtnern, Lehrern, Kinderpsychologen und Verkehrsbeauftragten bewähren.“"
                            },
                            {
                                "example_id": "7a83a2f5-9cea-4257-9bdb-cf468aab25a6",
                                "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                                "text": "„Der Verkehrsbeauftragte der Stadt hat innerhalb von ein paar Stunden unsere E-Mails mit seinem Smartphone beantwortet.“"
                            },
                            {
                                "example_id": "a71af726-1633-41c8-a090-7499e533d219",
                                "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                                "text": "„Auch von der neuen Initiative verspricht sich der Verkehrsbeauftragte der Stadtverwaltung, Christophe Nadjovski, einen Beitrag im Kampf gegen die Luftverschmutzung.“"
                            },
                            {
                                "example_id": "b6a68a37-d7e3-4cf9-90f4-608d79ae6167",
                                "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                                "text": "„Konrektor Lothar Frommann, der mit dem Verkehrsbeauftragten der Schule, Hermann Krumm, die Betreuung übernommen hat, ließ zum Abschluss der Einführung das theoretisch Gelernte in der Praxis am Fußgängerüberweg unter den kritischen Augen der Prüfer in der Kirchstraße umsetzen.“"
                            },
                            {
                                "example_id": "127d810d-a1cd-4758-a512-bdd2d5de333c",
                                "sense_id": "acb01abe-306c-322a-8568-57493077df31",
                                "text": "„Wie heißt denn der Verkehrsbeauftragte des hiesigen Tourismusbüros, der angeblich mit allen behördlichen Vollmachten ausgestattet ist?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
