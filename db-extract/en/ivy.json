                        "sense_id": "c298cb56-4eb6-3c15-939a-8f69916df02d",
                        "entry_id": "08706b8e-86b8-3385-8883-4d9e544660fb",
                        "glosses": [
                            "A unisex given name from English.",
                            "A female given name from English; popular in the UK in the beginning of the 20th century."
                        ],
                        "tags": [],
                        "examples": []
                    },
