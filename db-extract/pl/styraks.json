                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dacba3b0-359c-4d2e-bd1c-8f6e66464181",
                        "source_entry_id": "76cec733-d64b-3ecd-9295-012d66134f44",
                        "source_sense_id": "88f1645e-8f08-370e-866c-d48e9dcdd96d",
                        "target_lang_word": "benzoin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benzoin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8c8e49b-f3de-38df-84f4-9ab957681a21",
                                        "entry_id": "5d2ae9e9-0c8c-3144-a652-97e164686b5a",
                                        "glosses": [
                                            "A resinous substance, dry and brittle, obtained from Styrax benzoin, a tree of Sumatra, Java, etc., having a fragrant odor, and slightly aromatic taste. It is used in the preparation of benzoic acid, in medicine, and as a perfume."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fbd415f-7db0-4fd0-a792-6e988bc5fbd2",
                                                "sense_id": "b8c8e49b-f3de-38df-84f4-9ab957681a21",
                                                "text": "These following bodies do not draw: smaragd, achates, corneolus, pearl, jaspis, chalcedonius, alabaster, porphyry, coral, marble, touchstone, haematites, or bloodstone; smyris, ivory, bones, ebontree, cedar, cypress, pitch, softer rosin, camphire, galbanum, ammoniac, storax, benzoin, loadstone, asphaltum."
                                            },
                                            {
                                                "example_id": "9ee0eb37-3952-466e-b05a-1823aecd2a1b",
                                                "sense_id": "b8c8e49b-f3de-38df-84f4-9ab957681a21",
                                                "text": "Aromatics were used, too, especially in necromancy, and an old recipe of that sort comprises Musk, Myrrh, Frankincense, Red Storax, Mastick, Olibanum, Saffron, Benzoin and Labdanum."
                                            },
                                            {
                                                "example_id": "9c7f9047-5298-41ff-841d-47217dad5aed",
                                                "sense_id": "b8c8e49b-f3de-38df-84f4-9ab957681a21",
                                                "text": "Nedde: In Arab countries, a mixture of various perfumes, with benzoin and amber predominating, is so called. This mixture, which is black in colour, is formed into a small cylinder and used aphrodisiacally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2360a98-f4d4-39cb-ad95-9d46066eb954",
                                        "entry_id": "5d2ae9e9-0c8c-3144-a652-97e164686b5a",
                                        "glosses": [
                                            "An aromatic hydroxy ketone, 2-hydroxy-1,2-di(phenyl)ethanone, synthesized from benzaldehyde; any derivative of this compound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3041512f-4598-3a8b-b02d-4dfc372a08b1",
                                        "entry_id": "5d2ae9e9-0c8c-3144-a652-97e164686b5a",
                                        "glosses": [
                                            "The spicebush, Lindera benzoin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0e860df-0114-4829-a16f-9fabf134ff36",
                        "source_entry_id": "76cec733-d64b-3ecd-9295-012d66134f44",
                        "source_sense_id": "88f1645e-8f08-370e-866c-d48e9dcdd96d",
                        "target_lang_word": "benjoin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benjoin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99b56f99-d486-3188-a0c4-5774618f77a7",
                                        "entry_id": "6577e166-df8f-3bd6-8ff1-86581119db00",
                                        "glosses": [
                                            "Sorte de baume, substance aromatique et résineuse qui découle des incisions faites au Styrax benjoin, arbre d’Extrême-Orient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88566a1d-3af0-4249-b74d-9044cd16ba07",
                                                "sense_id": "99b56f99-d486-3188-a0c4-5774618f77a7",
                                                "text": "Il est des parfums frais comme des chairs d’enfants,\nDoux comme les hautbois, verts comme les prairies,\n- Et d’autres, corrompus, riches et triomphants,\nAyant l’expansion des choses infinies,\nComme l’ambre, le musc, le benjoin et l’encens,\nQui chantent les transports de l’esprit et des sens."
                                            },
                                            {
                                                "example_id": "188469e5-771b-41d1-a3f0-3c84b5a4c583",
                                                "sense_id": "99b56f99-d486-3188-a0c4-5774618f77a7",
                                                "text": "Et voilà que tout à coup, parmi tant de barbes rondes, ovales, carrées, qui floconnaient, qui frisaient, qui exhalaient ambre et benjoin, fut remarquée une barbe taillée en pointe."
                                            },
                                            {
                                                "example_id": "2097ff1c-5216-4028-b2ea-4283bcacdb5c",
                                                "sense_id": "99b56f99-d486-3188-a0c4-5774618f77a7",
                                                "text": "Le vent éternel du Souf bruissait dans les décombres et, dans son souffle tiède, une senteur de benjoin glissa."
                                            },
                                            {
                                                "example_id": "b20504b0-13c1-4dd6-a9a5-7d688f776fc9",
                                                "sense_id": "99b56f99-d486-3188-a0c4-5774618f77a7",
                                                "text": "Ils échangent également du brésil contre de la cannelle, de l’encens et de l’alun, ainsi que des étoffes contre des clous de girofle et du benjoin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3edb6fa-1b1a-33f7-8d29-e70fe0d9cc83",
                                        "entry_id": "6577e166-df8f-3bd6-8ff1-86581119db00",
                                        "glosses": [
                                            "Nom français de la plante Imperatoria ostruthium L., de la famille des Apiacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7bf4471-0230-41c1-abf2-03a19fe8ff83",
                                                "sense_id": "e3edb6fa-1b1a-33f7-8d29-e70fe0d9cc83",
                                                "text": "On y introduit des substances diverses, des menthes pilées du benjoin de la sauge du styrax mêlés à du formol à du phénol à du permanganate à de l’eau oxygénée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
