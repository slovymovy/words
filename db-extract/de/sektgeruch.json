                ],
                "senses": [
                    {
                        "sense_id": "34641120-d1bc-30eb-82ad-388b3f7f8bf2",
                        "entry_id": "6f0100bb-e4a8-3fa5-a4f6-bdc05a585739",
                        "glosses": [
                            "Geruch von Sekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3b6c3e-7579-4f57-bbba-4f9e97632d6e",
                                "sense_id": "34641120-d1bc-30eb-82ad-388b3f7f8bf2",
                                "text": "„So vermischte sich bei dem besonderen City-Biathlon 2020 ganz am Ende bei zwölf Grad Außentemperatur aber gottlob trockener Strecke mit den Düften des Desinfektionsmittels und des Pulverdampfs noch der Sektgeruch.“"
                            },
                            {
                                "example_id": "47b525b4-5778-4349-bbc6-65f00bebd5b5",
                                "sense_id": "34641120-d1bc-30eb-82ad-388b3f7f8bf2",
                                "text": "„Bereits auf den ersten Stufen umfängt den Besucher betörender Sektgeruch.“"
                            },
                            {
                                "example_id": "db3d9c88-6cd6-4e22-a619-670555ab4323",
                                "sense_id": "34641120-d1bc-30eb-82ad-388b3f7f8bf2",
                                "text": "„In aufkommendes Fernweh und naturgewaltige Faszination allerdings mengt sich, anscheinend feindlich, eine Atmosphäre, gespeist aus Sektgeruch und über Farbkompositionen rätselnden, erröteten Köpfen.“"
                            },
                            {
                                "example_id": "a856bdcf-556b-4ca1-b9a8-001e918b859e",
                                "sense_id": "34641120-d1bc-30eb-82ad-388b3f7f8bf2",
                                "text": "„Zuhause ist mir dann aufgefallen, dass die Hälfte des Sekts in meiner Tasche schwimmt -.- Meine arme Michael Kors Tasche :(Hoffe, das hinterlässt keine Flecken oder dieses ekelhaften Sektgeruch.)“"
                            },
                            {
                                "example_id": "689c50c5-e88e-4b8b-8d9b-35ca20ad956a",
                                "sense_id": "34641120-d1bc-30eb-82ad-388b3f7f8bf2",
                                "text": "„Einstieg: Im Geruch ist es spritzig, ich rieche Zitrone, und auch ein leichter Sektgeruch ist vorhanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
