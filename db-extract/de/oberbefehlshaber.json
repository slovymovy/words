                    {
                        "form_id": "9f716e25-fa9a-4c67-86e9-23df091879c5",
                        "entry_id": "3e01fcb7-6670-325c-9708-185eca28617f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Oberbefehlshaber"
                    },
                    {
                        "form_id": "d941355d-740b-4d09-8101-ce0cc950a18a",
                        "entry_id": "3e01fcb7-6670-325c-9708-185eca28617f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Oberbefehlshaber"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34d90bc2-ea65-3fda-8711-68263617876f",
                        "entry_id": "3e01fcb7-6670-325c-9708-185eca28617f",
                        "glosses": [
                            "oberster Führer oder oberster Befehlshaber einzelner Teile der Truppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a97c2b3-d414-4780-a41b-3a7a57b0874d",
                                "sense_id": "34d90bc2-ea65-3fda-8711-68263617876f",
                                "text": "„Nur den Kriegsminister und Oberbefehlshaber belässt der Ras im Amt.“"
                            },
                            {
                                "example_id": "7683f33f-d687-4b5b-9db5-fc6c21e80e4c",
                                "sense_id": "34d90bc2-ea65-3fda-8711-68263617876f",
                                "text": "„Und der russische Oberbefehlshaber warf nun rücksichtslos seine letzten Reserven an die Front.“"
                            },
                            {
                                "example_id": "57a94294-a427-418e-b29c-6b5c6246cbd6",
                                "sense_id": "34d90bc2-ea65-3fda-8711-68263617876f",
                                "text": "„Er konnte nicht wissen, dass der Zar in seinem Sommerschloss nahe St. Petersburg weilte, wo er sich der Siegesmeldungen erfreute, die sein Oberbefehlshaber Kutusow ihm geschickt hatte.“"
                            },
                            {
                                "example_id": "84060733-82a2-4f29-8712-fc14e1590605",
                                "sense_id": "34d90bc2-ea65-3fda-8711-68263617876f",
                                "text": "„Kaum hatte das Schiff Anker geworfen, ließ der Gesandte seine Flagge als Oberbefehlshaber der Seestreitkräfte der Republik aufziehen, während der Oberkommandierende von Korfu seine einholen ließ.“"
                            },
                            {
                                "example_id": "65bc0f3e-34cc-48e7-9636-14c71d98f8b3",
                                "sense_id": "34d90bc2-ea65-3fda-8711-68263617876f",
                                "text": "„Im späten 17. Jahrhundert revoltierte der Oberbefehlshaber der Armee des mittlerweile stark geschwächten Mwene-Mutapa-Reiches gegen die Portugiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
