            {
                "entry_id": "a852b4de-b41e-3eb0-96e6-2f5b58e52a4f",
                "word": "armateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ace4d806-1fe6-4021-ad86-c880a40cc185",
                        "entry_id": "a852b4de-b41e-3eb0-96e6-2f5b58e52a4f",
                        "tags": [
                            "plural"
                        ],
                        "form": "armateurs"
                    },
                    {
                        "form_id": "eae96f13-0ade-4396-a60b-b0fcfa8e489a",
                        "entry_id": "a852b4de-b41e-3eb0-96e6-2f5b58e52a4f",
                        "tags": [
                            "feminine"
                        ],
                        "form": "armatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd913c41-805c-3216-9765-fbac20f5c0d8",
                        "entry_id": "a852b4de-b41e-3eb0-96e6-2f5b58e52a4f",
                        "glosses": [
                            "Personne ou société qui arme, qui équipe à ses frais un ou plusieurs bateaux pour commercer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a45fdba-4c2e-4c1a-a9fb-16b5737b001c",
                                "sense_id": "dd913c41-805c-3216-9765-fbac20f5c0d8",
                                "text": "L’Adonis, mon cher monsieur Gilbert, est un navire marchand dont je suis le principal armateur."
                            },
                            {
                                "example_id": "354d37b3-ec57-48d6-bf2b-e01e8fd54c6d",
                                "sense_id": "dd913c41-805c-3216-9765-fbac20f5c0d8",
                                "text": "On voit que la moralité des armateurs et des gros négociants n’était pas toujours irréprochable et que l’amour ancillaire avait, à Saint-Malo, de chauds pratiquants."
                            },
                            {
                                "example_id": "c0fc5ac0-9dc3-4531-9c97-4cf1f5277514",
                                "sense_id": "dd913c41-805c-3216-9765-fbac20f5c0d8",
                                "text": "C'est au capitaine de démonter le caractère injustifié de son congédiement. Toutefois, en l'espèce, la Cour de Douai avait considéré le congédiement par l’armateur injustifié, aucun élément ne démontrant les insuffisances de résultats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1194cd69-3dfb-4498-9a02-c092ea510ab6",
                        "source_entry_id": "a852b4de-b41e-3eb0-96e6-2f5b58e52a4f",
                        "source_sense_id": "dd913c41-805c-3216-9765-fbac20f5c0d8",
                        "target_lang_word": "Reeder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reeder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                        "entry_id": "3682a9d2-a059-36e4-801e-96fb54ce98df",
                                        "glosses": [
                                            "Transportunternehmer (Personen, Güter) zur See mit eigenen Schiffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0213746-00b9-4e1b-8704-7f489ef359e7",
                                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                                "text": "Als Reeder war er ein Überseekaufmann mit internationaler Erfahrung."
                                            },
                                            {
                                                "example_id": "af127273-d2e9-4473-b311-35489c205fbb",
                                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                                "text": "„Die Reeder müssten wieder dem Ideal des ehrbaren Kaufmanns folgen, wenn sie Hilfe vom Staat wollten, mahnte er.“"
                                            },
                                            {
                                                "example_id": "cd802b93-bbba-4905-b782-c3352a2aa81d",
                                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                                "text": "„Daheim in Norwegen zählten die Reeder das Geld.“"
                                            },
                                            {
                                                "example_id": "5cddf16e-76f9-4e6c-981c-844b11cc90ff",
                                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                                "text": "„Die Reeder gaben uns vorläufig je dreißig Dollar.“"
                                            },
                                            {
                                                "example_id": "3f5d1699-c878-4ba5-95da-6daecd19c49f",
                                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                                "text": "„Der Reeder ließ die Säcke zunähen und lieferte sie an den Kunden aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
