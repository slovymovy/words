                    {
                        "translation_id": "163073d0-c7d1-4ffc-bbad-03de06a6c7b0",
                        "source_entry_id": "d6ee8680-0d06-3fec-a518-05a40fc82fe6",
                        "source_sense_id": "17b211af-fcd9-342d-966d-b5f89d1b0564",
                        "source_sense_description": "Wettbewerb, bei dem die Skifahrer möglichst schnell eine Abfahrtsstrecke absolvieren müssen",
                        "target_lang_word": "descente",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "423e018b-5862-3fd9-832e-c3caca1ca60b",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Action de descendre, d’aller vers le bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930ef610-a45c-4626-a0ac-b398e43e01be",
                                                "sense_id": "423e018b-5862-3fd9-832e-c3caca1ca60b",
                                                "text": "Nous reprenons le raidillon ; il n'est guère plus drôle à descendre qu'à monter : tantôt nous étions courbés en avant, maintenant il faut, pour la descente, se rejeter en arrière..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf36067-8ec5-39a7-b50e-33aee2732144",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Action par laquelle on descend quelque chose."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b8c490-4ba0-4555-b0c5-d819612bc275",
                                                "sense_id": "9bf36067-8ec5-39a7-b50e-33aee2732144",
                                                "text": "La descente de la châsse de sainte Geneviève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87acb543-4cb0-3739-8f8e-30a46da5f7f3",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Pente par laquelle on descend."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c6e5b8-b262-4f7d-9314-ee8fe40dd437",
                                                "sense_id": "87acb543-4cb0-3739-8f8e-30a46da5f7f3",
                                                "text": "Le creusement d’un escalier en descente était une opération difficile et pénible, le mineur devant creuser plus bas que ses pieds au marteau et à la cisette, sous le faible éclairage des lampes à huile et avec une aération défectueuse."
                                            },
                                            {
                                                "example_id": "767163ee-8736-49bf-8c38-72ae9915a0e3",
                                                "sense_id": "87acb543-4cb0-3739-8f8e-30a46da5f7f3",
                                                "text": "Nous allons trouver une descente à quelque distance. - Cette montagne est très escarpée, cet escalier est trop raide, la descente en est pénible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34209c1a-98b8-3ac9-8ec7-d287d6b3691e",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Tuyau qui porte les eaux d’un chéneau ou d’une cuvette jusque sur le pavé ou par lequel descendent les eaux d’un réservoir."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe6b5594-5361-4c23-b3c7-45c598512255",
                                                "sense_id": "34209c1a-98b8-3ac9-8ec7-d287d6b3691e",
                                                "text": "Une descente de fer, de plomb. - Tuyau de descente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db8cd19c-4d2f-3312-8695-ebaed704a98b",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Discipline de course à ski."
                                        ],
                                        "tags": [
                                            "Ski alpin"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef71dfe1-daec-3f69-9cc6-760a5ecbf15d",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Discipline de course en canoë-kayak."
                                        ],
                                        "tags": [
                                            "Canoë-kayak"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64cc5e35-0966-3525-ac29-91987be0a5ff",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Discipline de VTT."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0664c25-5349-34d5-81b8-403301cdf13f",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Mouvement de haut en bas de quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb88822a-5860-4800-8133-6b0a13c5df60",
                                                "sense_id": "c0664c25-5349-34d5-81b8-403301cdf13f",
                                                "text": "La descente des eaux. - Hâter la descente d’un aérostat, en laissant échapper une partie du gaz qu’il contient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6c52f81-46cd-3825-8162-fae4e23cae89",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Hernie, ou autre incommodité, qui consiste dans le déplacement et la chute de quelque partie des intestins."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d31c6ecc-51a6-4e9a-a15b-01f49970452a",
                                                "sense_id": "f6c52f81-46cd-3825-8162-fae4e23cae89",
                                                "text": "Il a une descente qui l’empêche d’aller à cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53732120-0c49-38ce-8161-2ed1ed1f2f4a",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Action de se déplacer temporairement d’un endroit à un autre, pour un séjour."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "263bb257-ab9a-3ce5-ac11-521b01ca8bbc",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Irruption des ennemis par mer ou par terre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1b8c8d-9bdb-4272-a970-955564fff3f0",
                                                "sense_id": "263bb257-ab9a-3ce5-ac11-521b01ca8bbc",
                                                "text": "Enfin la prospérité croissante des finances permit de fournir, aux besoins de l’état et à ceux de l’armée, et de concentrer des forces imposantes dans la province de Vera-Cruz, qu’on croyait menacée d’une descente prochaine de 12,000 Espagnols réunis à la Havane, sous les ordres du général Moralès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f065261a-2914-3c6b-8ce6-e8796652f9f1",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Action de se transporter dans un lieu par autorité de justice, ou par action policière, pour en faire la visite, pour y procéder à une perquisition, etc."
                                        ],
                                        "tags": [
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aebf99f-0f81-4ddc-b8d3-8014f52251e7",
                                                "sense_id": "f065261a-2914-3c6b-8ce6-e8796652f9f1",
                                                "text": "Et la rue retomba dans le demi-silence, la torpeur, la résignation qu'une descente de police laisse toujours derrière elle."
                                            },
                                            {
                                                "example_id": "998ddd4d-a006-4d37-ac7d-c97847d6fc15",
                                                "sense_id": "f065261a-2914-3c6b-8ce6-e8796652f9f1",
                                                "text": "— Tout est fini dès maintenant, n’est-ce pas ?… Ne croyez-vous pas que votre place est là-haut, où il faudra bien faire une descente du Parquet ?"
                                            },
                                            {
                                                "example_id": "aa010fc2-2bb3-4d4a-bae1-a7592719b7ac",
                                                "sense_id": "f065261a-2914-3c6b-8ce6-e8796652f9f1",
                                                "text": "– On a pris Pierrot, chuchotait Marie Gérard, le petit métallo, le communiste. La Gestapo a fait une descente chez le bistrot où il logeait…"
                                            },
                                            {
                                                "example_id": "1f2108a4-246f-4245-9d6e-73fac34eaefe",
                                                "sense_id": "f065261a-2914-3c6b-8ce6-e8796652f9f1",
                                                "text": "Des descentes de police visent les « cayennes ». Pour éviter leur saisie, les compagnons détruisent eux-mêmes leurs documents régulièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e75664f-fb36-3be3-a0d9-1d33b4b770c8",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Soif, appétit démesuré."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eb60c7c-9c85-4b4f-9e12-6decae472d93",
                                                "sense_id": "6e75664f-fb36-3be3-a0d9-1d33b4b770c8",
                                                "text": "C’est Raoul mon pitbull\nQui l’a trouvée appétissante\nC’est Raoul mon pitbull\nIl est gentil mais quelle descente !\nIl aime jouer, il est cool\nMais s’il a un p’tit creux dans l’ventre\nIl te croque dès que tu rentres\nC’est Raoul mon pitbull"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f43f847-0324-3a7c-9d92-a0ce9862e5f4",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Fin de trip, retour à un état hors d’effet d’une drogue."
                                        ],
                                        "tags": [
                                            "Toxicomanie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4855fc4-accf-4eca-8cc8-ca4a49ac391c",
                                                "sense_id": "5f43f847-0324-3a7c-9d92-a0ce9862e5f4",
                                                "text": "En vrai, j’ai passé trois jours sous ecstasy dans une fête anarcho-syndicaliste organisée dans une maison du quartier de St Paul's. Ce sont les hallucinations, puis la descente, qui m’ont fait réaliser combien cette existence stérile, sans rime ni raison, me foutait en l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aea88a52-0619-3f1a-a91c-b8c776cedbc4",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Sorte de surprise-partie."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bcbf95d-904d-4a84-8b49-607b01dd6bb7",
                                                "sense_id": "aea88a52-0619-3f1a-a91c-b8c776cedbc4",
                                                "text": "Dès que j’avais tourné les talons, Geneviève et Hubert invitaient des amis, organisaient des « descentes », malgré mon interdiction formelle ; et tu étais complice de leur désobéissance « parce que, disais-tu, il faut bien rendre ses politesses…»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6121991d-41e7-3e69-b22b-585fffa68864",
                                        "entry_id": "ebeb7d13-ab3e-340b-a0ca-d543c3d691d2",
                                        "glosses": [
                                            "Ouverture dans le pont d’un navire munie d’une échelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
