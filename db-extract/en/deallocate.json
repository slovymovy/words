                        "entry_id": "82d52eea-4f69-3f1e-b70b-d841f99f1a2a",
                        "glosses": [
                            "To remove from the set of resources put aside for (allocated to) a particular user or purpose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad05a147-abca-4125-94e4-1e2b8bdcc571",
                                "sense_id": "831929fa-16e8-32ab-8898-cc461a8f4978",
                                "text": "Empty out your locker; it will be deallocated at the end of the day."
                            }
                        ]
                    },
                    {
                        "sense_id": "b49b7f0b-baf2-3376-9552-bbfbfaac6c8a",
                        "entry_id": "82d52eea-4f69-3f1e-b70b-d841f99f1a2a",
                        "glosses": [
                            "To return previously allocated memory."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fecac824-e0c7-461b-89ed-db867f789580",
                                "sense_id": "b49b7f0b-baf2-3376-9552-bbfbfaac6c8a",
                                "text": "Computer programs should deallocate memory they no longer need, releasing it back to the system."
                            },
                            {
                                "example_id": "196ab790-2558-443e-a253-d642c7774b4e",
                                "sense_id": "b49b7f0b-baf2-3376-9552-bbfbfaac6c8a",
                                "text": "Similarly, the program deallocates storage for automatic objects when the procedure returns to its caller."
                            }
                        ]
                    }
