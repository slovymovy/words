                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b79db3d-e30c-30d4-bd7c-618b36e823e2",
                        "entry_id": "5f92ff09-cd57-3ec2-9704-f9fe2dfcd61a",
                        "glosses": [
                            "drewniana, obciągnięta skórą tarcza o nerkowatym kształcie, używana zwłaszcza przez lekkozbrojnych żołnierzy greckich i macedońskich"
                        ],
