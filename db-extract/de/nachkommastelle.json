                "senses": [
                    {
                        "sense_id": "bb396919-bef6-3edb-8864-cf820ee77437",
                        "entry_id": "995c16b8-c02d-3e79-b0cc-08404d5869db",
                        "glosses": [
                            "eine Ziffer nach dem Komma einer (in einem bestimmten Stellenwertsystem als Kommazahl dargestellten) Zahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2735cb18-2813-4178-818a-860fb9e529cc",
                                "sense_id": "bb396919-bef6-3edb-8864-cf820ee77437",
                                "text": "„Wer also etwa Psychologie studieren möchte und eine Ausbildung als Arzthelfer oder Logopäde gemacht hat, bekommt einen Bonus, der einigen Nachkommastellen im Abi-Zeugnis entspricht.“"
                            },
                            {
                                "example_id": "61b1b020-2145-49d2-b185-d832722f4f0e",
                                "sense_id": "bb396919-bef6-3edb-8864-cf820ee77437",
                                "text": "„Je häufiger sich das Volumen sich drehen muss (Turbohandel, bis zur 6ten Nachkommastelle!) desto mehr tritt die Lenkungswirkung ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
