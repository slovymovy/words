                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee96f40-6143-4d97-a65e-995f056eb267",
                                                "sense_id": "5218a9cc-18ec-3147-9ffd-d1bfcf6aa5ae",
                                                "text": "„Dazu einen Rebhang, irgendwo eine alte Trotte mit einer Ehrfurcht erweckenden Jahreszahl.“"
                                            },
                                            {
                                                "example_id": "4cd4a592-1f13-4a11-a050-5e90e775694a",
                                                "sense_id": "5218a9cc-18ec-3147-9ffd-d1bfcf6aa5ae",
                                                "text": "„Die Besucher der Ostschweizer Weinstube werden an der Expo 64 eine 230jährige Trotte aus Eichenholz bewundern können. […] Der neun Meter lange Trottbaum wiegt vier Tonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b130643-5c24-3b2d-9dfc-c30ae5195fa6",
                                        "entry_id": "eb3f0a61-bf43-3486-96fc-58c5c92658be",
                                        "glosses": [
                                            "(historisches) landwirtschaftliches Gebäude, in dem eine Trotte oder Kelter (eine Saftpresse gem. [1]) steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe46e34f-44a2-44f4-819f-48a4894af92e",
                                                "sense_id": "7b130643-5c24-3b2d-9dfc-c30ae5195fa6",
                                                "text": "„Am ersten Tag in der neuen Mostsaison sind in der Oeschger Trotte bereits 3500 Liter Saft in Fässer und Flaschen abgefüllt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
