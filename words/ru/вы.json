                {
                    "sense_id": "608d7f4b-66d6-3c18-b1a2-83ae8bd31caf",
                    "sense_definition": "Форма вежливого, официального обращения к одному лицу (в отличие от «ты»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите, <w>вы</w> работаете в этом магазине?",
                            "target_lang_translations": {
                                "en": "Tell me, do <w>you</w> work in this shop?",
                                "nl": "Zegt u eens, werkt <w>u</w> in deze winkel?",
                                "pl": "Proszę powiedzieć, czy <w>pan</w> / <w>pani</w> pracuje w tym sklepie?",
                                "de": "Sagen Sie, arbeiten <w>Sie</w> in diesem Geschäft?",
                                "fr": "Dites-moi, <w>vous</w> travaillez dans ce magasin ?",
                                "it": "Mi dica, <w>Lei</w> lavora in questo negozio?",
                                "cs": "Řekněte mi, <w>vy</w> pracujete v tomto obchodě?",
                                "tr": "Söyleyin, <w>siz</w> bu mağazada mı çalışıyorsunuz?",
                                "es": "Dígame, ¿<w>usted</w> trabaja en esta tienda?",
                                "zh": "请问，<w>您</w>是在这家店工作吗？"
                            }
                        },
                        {
                            "text": "Как <w>вас</w> зовут, молодой человек?",
                            "target_lang_translations": {
                                "en": "What is <w>your</w> name, young man?",
                                "nl": "Hoe heet <w>u</w>, jongeman?",
                                "pl": "Jak <w>pan</w> ma na imię, młody człowieku?",
                                "de": "Wie heißen <w>Sie</w>, junger Mann?",
                                "fr": "Comment <w>vous</w> appelez-vous, jeune homme ?",
                                "it": "Come si chiama, giovanotto?",
                                "cs": "Jak se <w>vás</w> jmenuje, mladý muži?",
                                "tr": "Adınız ne, genç adam? (Size nasıl hitap etmeliyim?)",
                                "es": "¿Cómo se llama <w>usted</w>, joven?",
                                "zh": "年轻人，请问<w>您</w>叫什么名字？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "как вас зовут",
                        "можно вас",
                        "слушаю вас",
                        "что вы"
                    ],
                    "target_lang_definitions": {
