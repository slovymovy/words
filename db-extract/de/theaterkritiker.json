                ],
                "senses": [
                    {
                        "sense_id": "ffa62475-b207-369e-b087-f229b6d65c96",
                        "entry_id": "be2f9ae6-81dd-3562-b9a2-d92842ceeb93",
                        "glosses": [
                            "Person, die (meist beruflich) kritisch über Bühnenstücke berichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f05c33e-9999-4168-af88-d56fe7e375f4",
                                "sense_id": "ffa62475-b207-369e-b087-f229b6d65c96",
                                "text": "„Im Gastkommentar spricht sich Hellmut Butterweck, früherer Wissenschaftsredakteur und Theaterkritiker, dafür aus, das menschliche Gewinnstreben als treibende Kraft unserer Wirtschaft zu hinterfragen.“"
                            },
                            {
                                "example_id": "d3d1b6aa-ccaf-4617-b274-4ac67f6deb41",
                                "sense_id": "ffa62475-b207-369e-b087-f229b6d65c96",
                                "text": "„Der Sohn, nach nicht beendetem Studium in München und Breslau Theaterkritiker für eine Zeitung in Neisse, verließ die Heimatstadt und ging nach Berlin.“"
                            },
                            {
                                "example_id": "f987ea19-2276-4f99-adaa-637f26ff07b3",
                                "sense_id": "ffa62475-b207-369e-b087-f229b6d65c96",
                                "text": "„Frank Thies, zehn Jahre jünger als Walter von Molo, Theaterkritiker, Redakteur, seit den Zwanzigerjahren erfolgreicher Romanautor, nach 1933 unvermindert aktiv, 1936 mit dem Buch »Tsushima«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
