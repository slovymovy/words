                                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                                        "glosses": [
                                            "A light snowfall."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244007cf-583e-4fd9-a406-4e9dc7a09d08",
                                                "sense_id": "240ac5f6-3688-3061-9695-4592cd95c75b",
                                                "text": "The rooves are covered with a dusting of snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f1eb0a3-d01d-3e06-80c1-2531baeffa29",
                                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                                        "glosses": [
                                            "A light covering of something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5179ce5c-e3aa-46cb-bc0e-c159cb047d7b",
                                                "sense_id": "7f1eb0a3-d01d-3e06-80c1-2531baeffa29",
                                                "text": "Cover the cake with a dusting of confectioner's sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc5879d5-22f3-3d44-bb2e-c085deff67d5",
                                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                                        "glosses": [
                                            "The act of removing dust from the furniture, as a household chore."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39cfa074-c83f-470e-a4ef-f80b5aaea277",
                                                "sense_id": "fc5879d5-22f3-3d44-bb2e-c085deff67d5",
                                                "text": "Tuesday is the day when I do the dusting."
                                            },
                                            {
                                                "example_id": "5bf1f7eb-0ee2-486e-81f0-69915d217b6c",
                                                "sense_id": "fc5879d5-22f3-3d44-bb2e-c085deff67d5",
                                                "text": "Strict orders had been given by Mrs. Breen the night before that certain dustings and arrangings of furniture should take place, the spacious stairs swept, and the hectic hired palms in their great china pots watered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "897d9c01-ab52-3f20-a656-440bc00f088b",
                                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                                        "glosses": [
                                            "A beating."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67cb877c-0864-36e8-b5b9-39053c9dc95b",
                                        "entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                                        "glosses": [
                                            "A maintenance or comfort behaviour in which a bird flushes fine dirt through the feathers; dustbathing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e75cbc17-bac3-43f6-b9ab-08115662a52b",
                        "source_entry_id": "7507ea50-e289-3432-bb8d-7771bc0f926d",
                        "target_lang_word": "Staub",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staub",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                        "entry_id": "17f5f899-2b37-3d9e-bc45-9b656cfacd5f",
                                        "glosses": [
                                            "fein verteilte, kleine feste Partikel, die in der Luft schweben oder sich ablagern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb8aab0c-3492-443f-b81f-be55e3a6ac52",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "Es ist so viel Staub in meinem Regal, ich muss dringend wieder wischen."
                                            },
                                            {
                                                "example_id": "b8862e00-b786-4966-9494-1a772f5b10e6",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "Die Inhalation metallischer, mineralischer oder organischer Stäube kann Erkrankungen der Atemwege hervorrufen."
                                            },
                                            {
                                                "example_id": "b92a48d7-c751-4e5a-aa31-ef25753946ac",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "„Nun geraten wir in all ihren Staub, und es wird unmöglich, zu atmen.“"
                                            },
                                            {
                                                "example_id": "39a9a13a-2096-4f17-a389-8fd93233f076",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "„Staub wirbelte hoch.“"
                                            },
                                            {
                                                "example_id": "d3d2b673-8455-40d4-85d6-2247448ea302",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "„In dem sandigen Staube der viele Zoll tief aufgefurchten Strasse versickerte der Tau ohne jede Wirkung.“"
                                            },
                                            {
                                                "example_id": "8d25af74-b9a9-4291-b9e2-9d3b3508c0f1",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "„Der Staub wirbelte vom Tor her die Linden herauf, augenscheinlich war ein starkes Gewitter im Anzug, und die ersten großen Tropfen fielen bereits.“"
                                            },
                                            {
                                                "example_id": "12700ffc-e269-49d3-a657-01a957eec039",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "Aus Staub bist du gemacht, zu Staub sollst du werden."
                                            },
                                            {
                                                "example_id": "d39d7dc6-4244-4bee-942a-94ee36ae2336",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "„Staub ist ein Kulturfolger. Wo Menschen sind, tummelt sich der Staub.“"
                                            },
                                            {
                                                "example_id": "e7d16b29-07d3-4cab-a87c-40a9cd2f0bd0",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "„Staub aus der Sahara wehte in dieser Woche über Tausende von Kilometern hinweg nach Athen.“"
                                            },
                                            {
                                                "example_id": "cc4a6aa9-6e12-4f39-9b16-18f06bff78d4",
                                                "sense_id": "a173ea6a-ccbe-3d2d-b209-768b418d2423",
                                                "text": "Am Ende des Tages sind wir alle nur Staub."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ead96177-2cd5-3e2d-b94c-fef26080a60f",
                                        "entry_id": "17f5f899-2b37-3d9e-bc45-9b656cfacd5f",
                                        "glosses": [
                                            "Nichtigkeit/Wertlosigkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68a7c2ca-9ef7-4ffa-b94d-37f6bd6c40ca",
                                                "sense_id": "ead96177-2cd5-3e2d-b94c-fef26080a60f",
                                                "text": "Am Ende des Tages sind wir alle nur Staub."
                                            },
                                            {
                                                "example_id": "fecf25a4-f327-42fc-bf93-1ef04b6f0027",
                                                "sense_id": "ead96177-2cd5-3e2d-b94c-fef26080a60f",
                                                "text": "Meine eigenen Worte erschienen mir so fahl und nichtig wie Staub, gerade auch wenn ich an ihre wunderbaren Verse dachte."
                                            },
                                            {
                                                "example_id": "04169b30-79c1-4971-b712-b9600201ccc3",
                                                "sense_id": "ead96177-2cd5-3e2d-b94c-fef26080a60f",
                                                "text": "Du bist nichts weiter als Staub unter meinen Füßen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a37cdec-2b79-45d9-bf48-a5ef34870cb2",
                        "source_entry_id": "7507ea50-e289-3432-bb8d-7771bc0f926d",
                        "target_lang_word": "poussière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poussière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                        "entry_id": "729a4f7a-c396-3b85-8303-b04225aa9e0c",
                                        "glosses": [
                                            "Particules très fines de terre ou de toute autre matière réduite en poudre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56521d3a-0332-4663-9f69-e7d5cab3c6f2",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "Ces écouteurs résistent à la poussière et à l’eau, peuvent se connecter à un smartphone et à un ordinateur sans avoir à les repairer et revendiquent aussi jusqu’à 36 heures d'autonomie."
                                            },
                                            {
                                                "example_id": "b28f8ca6-a828-4cda-8274-fed2f7d0c05f",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "Dès qu'il fait beau, la moindre brise soulève une fine poussière basaltique qui noircit tous les objets et pénètre dans les habitations les mieux closes."
                                            },
                                            {
                                                "example_id": "27acae2b-b289-4089-af85-ca903d3367e4",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "Le battage a pour but d’enlever aux laines les poussières, les matières terreuses ou sableuses et les pailles qu’elles contiennent."
                                            },
                                            {
                                                "example_id": "c756f098-d30d-40b8-99fe-f92fb2a20fb3",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "La poussière du Vieux-Port, chargée de salures, éparpille un relent lointain de choses épicées."
                                            },
                                            {
                                                "example_id": "d23cff86-cfc8-4878-8e09-3e13c128d681",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "La poussière de craie donnait soif et cet automne était chaud. Je me souviens d’avoir bu un jour peut-être dix quarts de bouillon brûlant pris à la cuisine roulante."
                                            },
                                            {
                                                "example_id": "77d5083d-a98b-42b9-b3b8-430f951fff3f",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "Une bâche de 1000 m² qui la recouvre et un dispositif d'aspersion de gouttes d’eau contribuent à éviter les projections alentour et à limiter la diffusion des poussières."
                                            },
                                            {
                                                "example_id": "01a6389c-e4be-4958-be31-c7f7c0d9845b",
                                                "sense_id": "0e500f41-4839-3fde-9565-d5a6575b16f7",
                                                "text": "La poussière constitue un risque pour les voies respiratoires, d'autant qu'une majorité de salariés ne porte pas de masque ou porte un masque insuffisamment protecteur ou encombrant : […]."
                                            }
                                        ]
                                    }
                                ]
                            },
