            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6c0deca-446e-308a-a002-5ddf28d3e5b0",
                    "sense_definition": "Qui émet ou reflète une lumière vive, qui a des couleurs très vives ou brillantes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumineux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil d'été projetait une lumière <w>éclatante</w> sur les murs blancs de la maison.",
                            "target_lang_translations": {
                                "en": "The summer sun cast <w>bright</w> light across the white walls of the house.",
                                "de": "Die Sommersonne warf ein <w>strahlendes</w> Licht auf die weißen Wände des Hauses.",
                                "es": "El sol de verano proyectaba una luz <w>radiante</w> sobre las paredes blancas de la casa.",
                                "zh": "夏日的阳光把<w>明亮</w>的光洒在房子的白墙上。",
                                "ru": "Летнее солнце заливало белые стены дома <w>ярким</w> светом."
                            }
                        },
                        {
                            "text": "Elle portait une robe aux couleurs <w>éclatantes</w> qui attirait immédiatement le regard de tous les invités.",
                            "target_lang_translations": {
                                "en": "She wore a dress in <w>vivid</w> colours that immediately caught the eye of every guest.",
                                "de": "Sie trug ein Kleid in <w>leuchtenden</w> Farben, das sofort die Blicke aller Gäste auf sich zog.",
                                "es": "Llevaba un vestido de colores <w>vivos</w> que atraía de inmediato la mirada de todos los invitados.",
                                "zh": "她穿着一条颜色<w>鲜艳</w>的连衣裙，一下子就吸引了所有客人的目光。",
                                "ru": "На ней было платье <w>ярких</w> цветов, которое сразу привлекало взгляды всех гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "brillant",
                        "lumineux",
                        "éblouissant",
                        "étincelant"
                    ],
                    "antonyms": [
                        "sombre",
                        "terne",
