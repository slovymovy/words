                                "ru": "Я <w>передам</w> ваш запрос менеджеру.",
                                "pl": "<w>Przekażę</w> twoją prośbę menedżerowi."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass on",
                        "resend",
                        "redirect"
