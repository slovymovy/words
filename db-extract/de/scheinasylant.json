                "senses": [
                    {
                        "sense_id": "61b8a8a9-3bd0-3fa9-ac34-755de4cc414b",
                        "entry_id": "d15c35b3-899e-3a71-8125-74da14697845",
                        "glosses": [
                            "Person, die das Asylrecht für sich in Anspruch nimmt, dessen rechtliche Voraussetzungen aber nicht erfüllt"
                        ],
                        "tags": [
                            "abfällig"
                        ],
                        "examples": [
                            {
                                "example_id": "4ce974a5-59b1-45d5-b149-4b18e815f602",
                                "sense_id": "61b8a8a9-3bd0-3fa9-ac34-755de4cc414b",
                                "text": "„Dann nahm er in den achtziger Jahren die Gestalt des Scheinasylanten an, der sich unter Vorspiegelung falscher Tatsachen in unsere Sozialsysteme schlich.“"
                            },
                            {
                                "example_id": "4b51e1f0-de8f-414e-bdaa-07e8c717c1e8",
                                "sense_id": "61b8a8a9-3bd0-3fa9-ac34-755de4cc414b",
                                "text": "„Zugleich sollte der Kanzler die Chefs der Länder zwecks Herbeiführung eines schnelleren Verfahrens einladen, nach welchem Scheinasylanten zu trennen sind von denjenigen, die zu Hause politisch verfolgt werden; die ersteren sind zügig abzuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
