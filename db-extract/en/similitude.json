                "senses": [
                    {
                        "sense_id": "e5d6d733-c0a0-3ac4-8248-7485a948775d",
                        "entry_id": "5efa456c-bb9f-3187-9278-8118eb123cd6",
                        "glosses": [
                            "Similarity or resemblance to something else."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec363cc-b5f5-40f3-a8ab-152cda6b6055",
                                "sense_id": "e5d6d733-c0a0-3ac4-8248-7485a948775d",
                                "text": "So am I tossed on the ebbing tide of life—now in sunshine, now in shade—seemingly free, yet, in reality, fettered by the strong, though slight chain of circumstance. For a small sum, any passenger may enter that boat and direct its course; and here again is similitude. I am at the beck of others."
                            },
                            {
                                "example_id": "df285a76-b53a-4568-b59b-ed566e6919fe",
                                "sense_id": "e5d6d733-c0a0-3ac4-8248-7485a948775d",
                                "text": "Aemulation was similitude within distance: the sky resembled a face because it had “eyes” — the sun and moon."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfc2ffd5-b718-3980-be8f-664634531d89",
                        "entry_id": "5efa456c-bb9f-3187-9278-8118eb123cd6",
                        "glosses": [
                            "A way in which two people or things share similitude."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9abdfb27-b310-4710-bf37-1e183fe8482e",
                                "sense_id": "bfc2ffd5-b718-3980-be8f-664634531d89",
                                "text": "Aemulation was similitude within distance: the sky resembled a face because it had “eyes” — the sun and moon."
                            }
                        ]
                    },
                    {
                        "sense_id": "534c10f7-26b6-3ce9-b788-b5f841cb8cbd",
                        "entry_id": "5efa456c-bb9f-3187-9278-8118eb123cd6",
                        "glosses": [
                            "Someone or something that closely resembles another; a duplicate or twin."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "7397579c-91e3-4f1f-b364-24a04e620241",
                                "sense_id": "534c10f7-26b6-3ce9-b788-b5f841cb8cbd",
                                "text": "If I was certain of anything in the world, I was certain that I had seen my brother in the study — nay, more, had touched him, — and equally certain that I had seen his double — his exact similitude, in the garden."
                            }
                        ]
                    },
                    {
                        "sense_id": "216e207e-e771-3d79-9247-3f991584c2ad",
                        "entry_id": "5efa456c-bb9f-3187-9278-8118eb123cd6",
                        "glosses": [
                            "A parable or allegory."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "26a06b1e-0d48-4384-bd27-cea957e34db5",
                                "sense_id": "216e207e-e771-3d79-9247-3f991584c2ad",
                                "text": "And he spake many thynges to them in similitudes, sayinge: Beholde, the sower wentt forth to sowe, And as he sowed, some fell by the wayes side [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "604b4923-482e-3289-a2e1-0734399f241d",
                        "entry_id": "5efa456c-bb9f-3187-9278-8118eb123cd6",
                        "glosses": [
                            "A similarity: a transformation of Euclidean space that preserves angles and the ratios of distances."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fcc73bf-0976-4145-957c-391c6c936f20",
                        "source_entry_id": "5efa456c-bb9f-3187-9278-8118eb123cd6",
                        "source_sense_description": "similarity or resemblance to something else",
                        "target_lang_word": "similitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "similitude",
