                                    {
                                        "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                        "entry_id": "3f5aa939-93b6-3384-97c0-9eed342ae071",
                                        "glosses": [
                                            "Angehöriger eines Reitervolkes der Völkerwanderungszeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89fbbc7-f09c-40d7-8aef-334ec79f8bdf",
                                                "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                                "text": "Unter ihrem König Attila eroberten die Hunnen weite Teile Europas."
                                            },
                                            {
                                                "example_id": "a0d2af33-703a-4d99-b565-662e6647df65",
                                                "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                                "text": "„Die größte Unruhe entstand jedoch um die Mitte des 5. Jahrhunderts, als die Hunnen in Westeuropa erschienen.“"
                                            },
                                            {
                                                "example_id": "149a2560-79b6-41ab-9abb-6ece7637669b",
                                                "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                                "text": "„Als »Hunnen« bezeichneten die antiken Autoren wahllos alle, die sie nicht kannten.“"
                                            }
