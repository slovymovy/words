                        "glosses": [
                            "Véhicule blindé équipé de mitrailleuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edaefa71-10b0-4b68-9b1f-ebc5c0c4a288",
                                "sense_id": "f8071420-af5b-3524-9209-148f418ba8e2",
                                "text": "Sur la place, stationnaient des autos-canons de défense aérienne, des autos-mitrailleuses, des projecteurs gardés par des sentinelles et recouverts de bâches camouflées."
                            },
                            {
                                "example_id": "a82eb81b-4752-4d2f-bcd4-d66ccb231498",
                                "sense_id": "f8071420-af5b-3524-9209-148f418ba8e2",
                                "text": "Plus loin, les rideaux d’ormes s’ouvrirent, découvrant un carrefour surélevé où des auto-mitrailleuses anglaises avaient disposé leurs pièces en éventail."
                            }
                        ]
                    }
