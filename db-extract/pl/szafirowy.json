                                        "entry_id": "660a0ed0-574b-3e03-ae72-6108104afed9",
                                        "glosses": [
                                            "A clear deep blue variety of corundum, valued as a precious stone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
