                                        "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                        "entry_id": "8da229b6-c9ed-3fff-8243-721f4f75c45d",
                                        "glosses": [
                                            "een stoel die ontworpen is om in een kantooromgeving gebruikt te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778bd767-fca5-48a9-bba6-e4842b1c0121",
                                                "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                                "text": "De chique, ruime schrijftafel van ebbenhout, die stijlvol was ingelegd met lichtere houtsoorten, die voor het raam was geplaatst naast de openslaande deuren naar het terras en die gepaard was aan een sobere maar degelijke en comfortabele houten bureaustoel uit de jaren dertig, had ik al meteen bij binnenkomst opgemerkt."
                                            },
                                            {
                                                "example_id": "edb2e78b-f2fc-49b9-8e77-13c3d45ff66e",
                                                "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                                "text": "Toen ze eenmaal zaten, liet hij zich in de zwartleren bureaustoel zakken en zuchtte."
                                            },
                                            {
                                                "example_id": "fdacfa94-5331-423b-8dae-a2fabd00b689",
                                                "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                                "text": "Veel bureaustoelen hebben wieltjes om te kunnen rollen."
                                            }
                                        ]
                                    }
                                ]
                            }
