                "senses": [
                    {
                        "sense_id": "6c74b715-71d1-3ddf-97bf-64a06e33b8e4",
                        "entry_id": "a83d9789-f55d-305a-9a4f-9c480c8b18e9",
                        "glosses": [
                            "Chefin eines Puffs, Bordells"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "f315fb7e-ba10-41c5-8d56-78e797169758",
                                "sense_id": "6c74b715-71d1-3ddf-97bf-64a06e33b8e4",
                                "text": "„Am Heiligabend lockt ein gewisser Mister Dick, ein Nachbar, sie mit einer Lüge in ein Bordell, wo er sie mit Hilfe der Puffmutter vergewaltigt.“"
                            },
                            {
                                "example_id": "08f3cf0a-b062-41e2-8691-ac16489f6f69",
                                "sense_id": "6c74b715-71d1-3ddf-97bf-64a06e33b8e4",
                                "text": "„Der Lärm brachte die Puffmutter herbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caf606bd-5077-4228-9957-a2200ac03fa7",
                        "source_entry_id": "a83d9789-f55d-305a-9a4f-9c480c8b18e9",
                        "source_sense_id": "6c74b715-71d1-3ddf-97bf-64a06e33b8e4",
                        "source_sense_description": "salopp: Chefin eines Puffs, Bordells",
                        "target_lang_word": "mère maquerelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mère maquerelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33639a49-5a06-366b-a2f6-a1f1c06ab97e",
                                        "entry_id": "c5d76c88-db09-3409-a18f-cc16d890832b",
                                        "glosses": [
                                            "Tenancière d’une maison close."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa26db94-522c-44d0-a19e-0d5061fd726f",
                                                "sense_id": "33639a49-5a06-366b-a2f6-a1f1c06ab97e",
                                                "text": "Des mythes et fantasmes qui entourent le travail policier, ceux qui concernent la brigade de répression du proxénétisme, parfois appelée « la mondaine », sont parmi les plus endurants. Ils sont faits de grands flics rudoyant de beaux voyous, de mères maquerelles et de clients aux mœurs scabreuses."
                                            },
                                            {
                                                "example_id": "beea8b9c-0ff6-422d-9468-b2fe622b4438",
                                                "sense_id": "33639a49-5a06-366b-a2f6-a1f1c06ab97e",
                                                "text": "Madame Bertrand, en bonne mère maquerelle, a tout prévu pour que le client consomme à tous les étages. Les filles en haut, l’alcool en bas."
                                            },
                                            {
                                                "example_id": "63b2b0b4-e1f7-4797-bedd-9f5286fb5d89",
                                                "sense_id": "33639a49-5a06-366b-a2f6-a1f1c06ab97e",
                                                "text": "Il régla ce qu’il lui devait à la mère maquerelle, et poursuivit son chemin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
