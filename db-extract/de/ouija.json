                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ouija",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55e38c40-6711-3784-af8b-3b4f9f3af54d",
                                        "entry_id": "6a2aae87-e038-3b78-8e03-d5af653dc310",
                                        "glosses": [
                                            "A board, having letters of the alphabet and the words yes and no; used with a planchette during a seance to \\\"communicate\\\" with spirits."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b66b709-64b3-3252-9c88-f77aaeccc7bf",
                                        "entry_id": "6a2aae87-e038-3b78-8e03-d5af653dc310",
                                        "glosses": [
                                            "The use of such a board to attempt to communicate with spirits."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f704f2-ab61-4391-82db-fe9454254b41",
                                                "sense_id": "2b66b709-64b3-3252-9c88-f77aaeccc7bf",
                                                "text": "Soon after the departure of my brother to the better land, our spirit-band informed us very plainly through \"Ouija,\" that it was our duty to remove to Boston in order that our children might have better educational facilities, and be admitted to the \"musical swim\" of the \"Hub of the Universe.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
