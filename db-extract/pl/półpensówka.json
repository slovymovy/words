                        "source_entry_id": "dbfcf928-83cb-39a4-934a-fe1ea31d21cb",
                        "source_sense_id": "b7b15ba6-ff00-3daf-bb79-a6e1fab13e1e",
                        "target_lang_word": "halfpenny",
