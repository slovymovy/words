                        "entry_id": "7a7bf33f-df49-3af0-9857-d820d7fa91ee",
                        "glosses": [
                            "the name of a god; a divine name, particularly that of the Abrahamic God"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "54c043ee-f108-4953-b130-f07567596d5a",
                                "sense_id": "5b8688ac-bf6e-36a5-83f5-bb0a11af8298",
                                "text": "Op het hardop uitspreken van de godsnamen rust een taboe.",
                                "translation": "It is taboo to say the divine names out loud.",
                                "english": "It is taboo to say the divine names out loud."
                            },
                            {
                                "example_id": "0650260c-cb71-4ec0-9907-6313152beda2",
                                "sense_id": "5b8688ac-bf6e-36a5-83f5-bb0a11af8298",
                                "text": "In sommige religies wordt het uitspreken van de godsnaam als heilig beschouwd.",
                                "translation": "In some religions, uttering the name of God is considered sacred.",
                                "english": "In some religions, uttering the name of God is considered sacred."
                            },
                            {
                                "example_id": "fa811d9d-330e-4b0f-901f-08dd80e77702",
                                "sense_id": "5b8688ac-bf6e-36a5-83f5-bb0a11af8298",
                                "text": "De rabbijn sprak met groot respect over de heilige godsnamen in de joodse traditie.",
                                "translation": "The rabbi spoke with great respect about the sacred names of God in the Jewish tradition.",
                                "english": "The rabbi spoke with great respect about the sacred names of God in the Jewish tradition."
                            },
                            {
                                "example_id": "b12daa41-5f78-4738-9494-e4187f8a1542",
                                "sense_id": "5b8688ac-bf6e-36a5-83f5-bb0a11af8298",
                                "text": "Het gebruik van de godsnaam wordt in sommige culturen als een taboe beschouwd.",
                                "translation": "The use of the name of God is considered taboo in some cultures.",
                                "english": "The use of the name of God is considered taboo in some cultures."
                            }
                        ]
                    }
