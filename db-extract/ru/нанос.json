                ],
                "translations": [
                    {
                        "translation_id": "5117f891-a164-4255-8cfc-3426fce907a2",
                        "source_entry_id": "24701aff-d4ff-31b4-b55e-f72a9f58fc33",
                        "target_lang_word": "alluvion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alluvion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                        "entry_id": "e3d9341f-2f08-3ac8-8295-312bb6eac414",
                                        "glosses": [
                                            "Accroissement de terrain qui se fait insensiblement à l’un des bords d’une rivière, ou qui a lieu lorsque la rivière s’en retire, et qu’elle prend son cours d’un autre côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e1c12f-624f-4829-a952-f789de041b3f",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Les terres provenant du défrichement des prairies, les terres d’alluvion fumées et travaillées depuis long-temps, sont très-propres à la culture des betteraves."
                                            },
                                            {
                                                "example_id": "d17b8df6-9ff8-45a8-90f9-b3059e237f3f",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Au fond du val, des champs de blé, des carrés de betteraves, des pâturages d’herbe drue avaient poussé avec cette opulence lourde des végétations nourries par l’humus noir des terrains d’alluvion."
                                            },
                                            {
                                                "example_id": "3f95af86-87fd-4aab-a31a-780762753da5",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Les sols lourds (texture très fine) et rouges, appelés par les paysans hamri, se trouvent principalement sur les alluvions de l’Amirien et du Soltanien."
                                            },
                                            {
                                                "example_id": "516de47b-02dd-463b-b545-be21f8832810",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Le caractère essentiel de lʼalluvion, cʼest de sʼêtre formé successivement et imperceptiblement."
                                            },
                                            {
                                                "example_id": "9faa3fd4-b7b4-400c-bda8-2ec9ea4a5a9d",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Pour Napoléon, [la Hollande] est une alluvion de fleuves français : le Rhin, l'Escaut et la Meuse ; et sous ce prétexte, il la réunit à l'Empire."
                                            },
                                            {
                                                "example_id": "1509ffce-58d4-4088-9b6a-600df8e9727f",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Les marnes bleues qui constituent le substratum des alluvions avec des faciès sensiblement identiques, d’Épineau-Ies-Voves à Appoigny, méritent de retenir l’attention au point de vue stratigraphique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d265009-291d-4e69-93ae-dc6392353016",
                        "source_entry_id": "24701aff-d4ff-31b4-b55e-f72a9f58fc33",
                        "target_lang_word": "sédiment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sédiment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dffe6f43-1cae-3e0a-abf5-8a8aa0a8ada0",
                                        "entry_id": "39e40415-d63b-30fb-87f5-0768e4f2c321",
                                        "glosses": [
                                            "Dépôt ou suspension solide produit par la précipitation de matières dissoutes dans un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8985067-3a5e-41c3-87d9-5c98591a8f68",
                                                "sense_id": "dffe6f43-1cae-3e0a-abf5-8a8aa0a8ada0",
                                                "text": "Il y a d’ordinaire beaucoup de sédiment dans cette solution."
                                            },
                                            {
                                                "example_id": "bea95a71-1c19-40a5-b76d-68357a239ec0",
                                                "sense_id": "dffe6f43-1cae-3e0a-abf5-8a8aa0a8ada0",
                                                "text": "Une partie des sédiments amazoniens repris par le courant des Guyanes s’accumule en crème de vase plus ou moins fluide et forme des bancs larges de 10 à 20 km qui se déplacent le long de la côte ; le reste est surtout en suspension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0cbb953-f8c5-3e6f-8c9d-85b6419ff00f",
                                        "entry_id": "39e40415-d63b-30fb-87f5-0768e4f2c321",
                                        "glosses": [
                                            "Composés minéraux qui se déposent dans certains cas de lithiase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de8245a-8874-49db-a5a3-5b141df84535",
                                                "sense_id": "b0cbb953-f8c5-3e6f-8c9d-85b6419ff00f",
                                                "text": "Les œufs devront être recherchés dans les matières fécales, les crachats et les sédiments urinaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6e1920d-0be1-39e8-b2ad-248ceb761490",
                                        "entry_id": "39e40415-d63b-30fb-87f5-0768e4f2c321",
                                        "glosses": [
                                            "Couche solide, dépôt provenant de la désagrégation, de la dissolution de roches préexistantes, transportés et déposés par les eaux, le vent, ou de matières d'origine organique accumulées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203bcf93-883f-42b5-8fdd-883327ae2b80",
                                                "sense_id": "d6e1920d-0be1-39e8-b2ad-248ceb761490",
                                                "text": "C'est le géologue H. Heinrich, de Hambourg, qui, scrutant au binoculaire les carottes forées dans les sédiments de l'Atlantique nord, a montré dans les années 1990 que les couches formées d'éléments plus grossiers interstratifiés dans les dépôts plus fins devaient provenir des débris arrachés par les glaciers au substrat rocheux des inlandsis."
                                            },
                                            {
                                                "example_id": "7ad414c6-482c-494c-9c2b-ecfb55318c79",
                                                "sense_id": "d6e1920d-0be1-39e8-b2ad-248ceb761490",
                                                "text": "Il fait d’ores et déjà savoir que de nouveaux échantillonnages sont nécessaires pour mieux comprendre la richesse des sédiments en diamants et en or."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
