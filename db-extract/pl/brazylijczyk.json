                                    {
                                        "sense_id": "2629a58d-37a4-3801-97e1-ff7ac4c4f859",
                                        "entry_id": "9c2457ae-d124-3d75-a444-80da29b846bd",
                                        "glosses": [
                                            "Bürger von Brasilien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711f3bae-4a1d-40fd-a081-c44b957bb2d0",
                                                "sense_id": "2629a58d-37a4-3801-97e1-ff7ac4c4f859",
                                                "text": "„Zwei Jahre nach dem Amtsantritt von Präsident da Silva erfreut sich Brasilien einer stabilen Währung und steigender Investitionen. Doch noch immer leben etwa 58 Millionen Brasilianer von weniger als einem Dollar am Tag.“"
                                            },
                                            {
                                                "example_id": "83948e9c-23a4-445b-820a-7fafd83fcd17",
                                                "sense_id": "2629a58d-37a4-3801-97e1-ff7ac4c4f859",
                                                "text": "„Ich wollte dem jungen Brasilianer rasch auch meinen aufdrängen.“"
                                            }
                                        ],
