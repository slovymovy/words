                                                "example_id": "ae86cb22-0bef-4ae4-b121-c5c15d418c4a",
                                                "sense_id": "2b75cbfd-c9d0-3647-8b82-fc910e89003a",
                                                "text": "Meine Mutter wurde wütend, als ich ihr erzählt habe, dass ich das Fenster kaputt gemacht habe."
                                            },
                                            {
                                                "example_id": "6b4d4569-e41b-47f3-93fd-3b0eecdee26e",
                                                "sense_id": "2b75cbfd-c9d0-3647-8b82-fc910e89003a",
                                                "text": "„In Hallstadt in Oberfranken ist eine Frau in einer Zahnarztpraxis derart wütend geworden, dass die Polizei kommen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
