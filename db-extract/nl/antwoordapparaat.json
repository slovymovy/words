                "senses": [
                    {
                        "sense_id": "654b413c-7a22-3e7e-b85b-9b5b4f233717",
                        "entry_id": "56962b2d-2a1a-3b91-bf77-f76c8b83c4b8",
                        "glosses": [
                            "toestel dat automatisch een telefoongesprek opneemt en de beller de gelegenheid geeft een bericht achter te laten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102c17d9-c84f-48f6-ae87-e2ed3afe16a3",
                                "sense_id": "654b413c-7a22-3e7e-b85b-9b5b4f233717",
                                "text": "De functie van een antwoordapparaat is tegenwoordig overgenomen door de voicemail."
                            },
                            {
                                "example_id": "0364e876-c60f-4189-b097-879c0fda6c69",
                                "sense_id": "654b413c-7a22-3e7e-b85b-9b5b4f233717",
                                "text": "De hoge toon heeft inmiddels zijn betovering verloren - hij wacht geduldig totdat het antwoordapparaat Salma's afwezigheid verkondigt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81902fb4-dc9c-48a8-8be0-20d99d797840",
                        "source_entry_id": "56962b2d-2a1a-3b91-bf77-f76c8b83c4b8",
                        "source_sense_id": "654b413c-7a22-3e7e-b85b-9b5b4f233717",
                        "target_lang_word": "Anrufbeantworter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anrufbeantworter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                        "entry_id": "c64fd8ba-0d69-312f-ba28-85b9d4ae09c5",
                                        "glosses": [
                                            "Gerät, das Telefonanrufe annimmt und dem Anrufenden die Möglichkeit gibt, eine kurze Nachricht zu hinterlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e75cd1-3907-43e8-8b5d-9dda767bdad2",
                                                "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                                "text": "Bitte hinterlassen Sie eine Nachricht auf dem Anrufbeantworter."
                                            },
                                            {
                                                "example_id": "692979f2-a47f-443e-b8d9-a2a1ded2f095",
                                                "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                                "text": "Als Peter nach Hause gekommen war, hörte er als Erstes seinen Anrufbeantworter ab."
                                            },
                                            {
                                                "example_id": "477b1234-87f7-4f12-a27c-68aca7fb34ef",
                                                "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                                "text": "„Der Anrufbeantworter springt an.“"
                                            },
                                            {
                                                "example_id": "da06ecc9-884b-4dde-839b-d19f2c1aa21f",
                                                "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                                "text": "„Mein Anrufbeantworter war eingeschaltet – auch an anderen Tagen nehme ich, wenn das Telefon läutet, nicht den Hörer ab, sondern höre mir an, wer es ist.“"
                                            },
                                            {
                                                "example_id": "16f13704-28a4-4b32-b277-7ae031e99869",
                                                "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                                "text": "„Die meisten Leute sitzen zu Hause herum und freuen sich, wenn das Telefon nicht läutet; tut es das doch, dann lassen sie den Anrufbeantworter laufen.“"
                                            },
                                            {
                                                "example_id": "87ae326c-d683-4ee7-b996-0d31426fe324",
                                                "sense_id": "c0a20714-215e-3f09-8c2f-7147d166b156",
                                                "text": "„Abends gehe ich gar nicht mehr ran, sondern warte, bis sich der Anrufbeantworter anschaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0dd5bd5-774d-4278-ba52-ca810b593562",
                        "source_entry_id": "56962b2d-2a1a-3b91-bf77-f76c8b83c4b8",
