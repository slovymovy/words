                        "examples": [
                            {
                                "example_id": "d08e430a-e4b7-4bfa-8b91-588a5602a282",
                                "sense_id": "871acde1-a774-3bd1-9efa-8ce3d2db8541",
                                "text": "Ik bleef omdat de groepstherapeut op mijn tweede dag zei dat ik het beeld dat mijn dochter zich voor me schaamde uit mijn hoofd moest zien te krijgen."
                            },
                            {
                                "example_id": "1f9dbb9b-0329-4eb9-aae1-ae3fb62a8612",
                                "sense_id": "871acde1-a774-3bd1-9efa-8ce3d2db8541",
                                "text": "De rasechte Amsterdammer baalt er overduidelijk van; hij praat schor en de tranen staan hem in de ogen. De groepstherapeut probeert hem op te beuren. “Dit is een waarschuwing, jongen. Je was een beetje ingeslapen, maar het is en blijft een verslaving. Je hebt een chronische ziekte. Je kunt het onder controle houden, maar het zal nooit helemaal verdwijnen.”"
                            }
                        ]
                    }
