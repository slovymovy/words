    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cca4c16-7edf-3e25-b5fd-a73991b86cf1",
                    "sense_definition": "A medical procedure or technique that prevents sensation and eliminates pain during surgery or other procedures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_sensation_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was placed under general <w>anesthesia</w> before the surgery began."
                        },
                        {
                            "text": "The dentist used local <w>anesthesia</w> so that I would not feel any pain during the extraction."
                        }
                    ],
                    "common_phrases": [
                        "general anesthesia",
                        "local anesthesia",
                        "under anesthesia"
                    ]
                },
                {
                    "sense_id": "3b5682e9-76a3-3e73-b5be-1ac2a1f0a8a5",
                    "sense_definition": "A substance or drug that induces temporary loss of sensation or awareness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_sensation_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor administered the <w>anesthesia</w> right before the operation."
                        },
                        {
                            "text": "They monitored his heart rate carefully as the <w>anesthesia</w> took effect."
                        }
                    ],
                    "synonyms": [
                        "anesthetic"
                    ],
                    "common_phrases": [
                        "administer anesthesia"
                    ]
                },
                {
                    "sense_id": "87f8f3e7-ab4d-30c2-b69d-db752c068a5c",
                    "sense_definition": "A state of temporary or permanent loss of bodily sensation, caused by drugs, nerve damage, or illness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_sensation_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nerve damage in his leg resulted in complete <w>anesthesia</w> in his toes."
                        },
                        {
                            "text": "The rare condition causes congenital <w>anesthesia</w>, making individuals unable to perceive physical pain."
                        }
                    ],
                    "antonyms": [
                        "aesthesia"
                    ],
                    "common_phrases": [
