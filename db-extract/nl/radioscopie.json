                ],
                "translations": [
                    {
                        "translation_id": "154d6c3e-2fc1-4634-9d99-a992efa6202f",
                        "source_entry_id": "6552a3d1-cca2-3cc1-b591-fbce7889ceff",
                        "source_sense_id": "8ce2bf5a-84f9-30a6-a73d-6947f7b59240",
                        "target_lang_word": "Durchleuchtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchleuchtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                        "entry_id": "e7cbdd1b-05b9-39e9-9d8e-9bf5da5c2537",
                                        "glosses": [
                                            "Untersuchung mit Röntgenstrahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92959b7-d922-4bff-b7b3-49bfb411c88b",
                                                "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                                "text": "„Bei der Einreise in die Emirates folgt auf die Passkontrolle noch die Durchleuchtung sämtlicher Gepäckstücke.“"
                                            },
                                            {
                                                "example_id": "d4a47a08-a6e4-411b-abf6-eb6da5fd8879",
                                                "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                                "text": "„Durch gepulste Durchleuchtung kann die Strahlenexposition deutlich gesenkt werden.“"
                                            },
                                            {
                                                "example_id": "15666134-afcb-429f-9aba-4e53bae4d7f2",
                                                "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                                "text": "„Die Durchleuchtung mit der Bildverstärkertechnik hat die mit einer hohen Patientendosis verbundene und in Dunkelheit durchzuführende Fluoreszenzschirmdurchleuchtung abgelöst.“"
                                            },
                                            {
                                                "example_id": "4f4a034c-6b84-4ddb-95ab-8ba7a62b103b",
                                                "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                                "text": "„An zwei Standorten in den Stadtteilen Erbenheim und Nordenstadt werden Röntgenprüfsysteme hergestellt, die zum Beispiel an den Kontrollstellen auf Flughäfen oder an Grenzen der Durchleuchtung von Koffern dienen.“"
                                            },
                                            {
                                                "example_id": "58b79c45-dd47-4028-ad94-c0a0f6aefc56",
                                                "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                                "text": "„Reisegepäck soll stärker als bisher kontrolliert werden, nicht nur per Durchleuchtung, sondern von Hand.“"
                                            },
                                            {
                                                "example_id": "f8a646b3-01bd-4bf0-bdbb-13f83c8b27d2",
                                                "sense_id": "718d44ff-30d3-3ca9-9df6-a74af1b18d4c",
                                                "text": "„Es handelt sich um eine nahezu komplette genetische Durchleuchtung des Embryos schon in der neunten Schwangerschaftswoche - in einer Phase also, in der Abtreibungen nach der verpflichtenden Schwangerenberatung noch leicht möglich sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                        "entry_id": "e7cbdd1b-05b9-39e9-9d8e-9bf5da5c2537",
                                        "glosses": [
                                            "gründliche Betrachtung, Überprüfung von etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80fe46f1-464e-453a-8f6a-6376a1c84a04",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„Die gesamte Durchleuchtung der Bewerber dauert etwa acht Monate, und wer sie übersteht, wird zunächst als Angestellter in den öffentlichen Dienst übernommen.“"
                                            },
                                            {
                                                "example_id": "b6fb5abb-7f4b-4a45-a4fc-6848d77c827e",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„Die ironische Durchleuchtung der Charaktere zeigt Vladimir Nabokov bereits als einen frühen Meister delikater Psychologie.“"
                                            },
                                            {
                                                "example_id": "c3b2f22e-8fd6-4e4f-8b99-d3b015add9af",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„Mit dieser Durchleuchtung beginnt wohl ein nie zu erschöpfender Dialog zwischen den genannten Geistestraditionen.“"
                                            },
                                            {
                                                "example_id": "c2a383ad-e29a-4d9f-9222-f2881943dfda",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„Offenbar geht es nicht darum, die historische Distanz der auktorialen Stimme zugleich für die Durchleuchtung des Mythos oder genauere Bestimmung des großen Fiebers zu nutzen.“"
                                            },
                                            {
                                                "example_id": "fe250252-fef7-44b0-8616-59bf5391618b",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„Schließlich liefert die ‚Muqaddima‘ eine Bestandsaufnahme und Durchleuchtung des gesamten Wissens ihrer Zeit, von der Logik über die Landwirtschaft bis hin zur Traumdeutung.“"
                                            },
                                            {
                                                "example_id": "288a8ced-25b1-43ea-ba80-4a97d70330d2",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„So führte die Ausweitung der Tests zu einer besseren Durchleuchtung der Dunkelziffern, es seien mehr jüngere Menschen betroffen, außerdem sei aus ungeklärten Gründen das Auftreten schwerer Lungenentzündungen bei solchen Infektionskrankheiten im Sommer geringer als im Winter.“"
                                            },
                                            {
                                                "example_id": "783e219b-ad9e-417a-9559-093954d0c9a3",
                                                "sense_id": "346ad801-6806-392a-b69d-76e359f0cb4f",
                                                "text": "„An jenem Tag teilte er seiner langjährigen Vertrauten Beth Myers, die mit der gründlichen ‚Durchleuchtung‘ der möglichen Kandidaten beauftragt worden war, seine Wahl mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
