                "forms": [],
                "senses": [
                    {
                        "sense_id": "641ae0de-b112-3a00-a225-b2bc9d5572d1",
                        "entry_id": "4283af5f-4a15-3358-b62c-2119518b7046",
                        "glosses": [
                            "bezig met trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19ca1713-e06a-43df-8ce1-a2793a466f95",
                                "sense_id": "641ae0de-b112-3a00-a225-b2bc9d5572d1",
                                "text": "De gestroomlijnde vorm van de caravan leidt tot minder luchtweerstand en dus een lager brandstofverbruik van de trekkende auto."
                            },
                            {
                                "example_id": "9b29d856-71c0-4480-8ee0-21abd5e4df33",
                                "sense_id": "641ae0de-b112-3a00-a225-b2bc9d5572d1",
                                "text": "Die omlaag trekkende kracht valt eind dit jaar echter weg. 2019 kan wel eens het jaar worden waarin de langetermijnrentes in landen zoals Duitsland en Nederland een inhaalslag gaan maken. Daarom houden wij de duration in ons obligatiefonds op nul. Als de rentes gaan stijgen, krijgen wij geen slapeloze nachten."
                            }
                        ]
                    },
                    {
                        "sense_id": "d938faaa-4de5-3a85-a1ea-c4645f51c2bb",
                        "entry_id": "4283af5f-4a15-3358-b62c-2119518b7046",
                        "glosses": [
                            "bezig met reizen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aedf2944-6b96-4c48-9194-8b2c4c342f2b",
                                "sense_id": "d938faaa-4de5-3a85-a1ea-c4645f51c2bb",
                                "text": "Vermoedelijk gaat het hier om een trekkende wolf die afkomstig is uit Duitsland."
                            }
                        ]
                    }
                ],
