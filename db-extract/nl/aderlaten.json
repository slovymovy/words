                        ],
                        "examples": [
                            {
                                "example_id": "2346f411-76f3-4869-9419-bca56c1a1f5e",
                                "sense_id": "3f57d9f9-e0c7-378b-9b31-552b3462e9ff",
                                "text": "(…) terwijl Nederland nog van 1867 tot 1877 Indië aderliet voor 151 miljoen gulden (…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "795e4ec4-3b0e-4e01-a9c2-34a7b0ad58b4",
                        "source_entry_id": "1b005e0b-3734-3394-8b13-0fd48f39de45",
                        "target_lang_word": "bleed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "989e542b-d151-3740-9069-b62175c7b65b",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To shed blood through an injured blood vessel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80aa04e7-ecd4-4421-aa82-f15193d5f28a",
                                                "sense_id": "989e542b-d151-3740-9069-b62175c7b65b",
                                                "text": "If her nose bleeds, try to use ice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9fbf94e-09a9-39c4-8960-e28777e00bdd",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To let or draw blood from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "592e2cf1-3b5b-4ff9-9529-76b3048d0b47",
                                                "sense_id": "f9fbf94e-09a9-39c4-8960-e28777e00bdd",
                                                "text": "\"What did they die of?\" I asked.\n\"Fevers. The doctor came and bled them and purged them, but they still died.\"\n\"He bled and purged babies?\"\n\"They were two and three. He said it would break the fever. And it did. But they ... they died anyway.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2ff1861-3eab-330b-a5a8-ac9a50f092b6",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To take large amounts of money from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90ca3a26-d352-3e5f-a9ac-72a014988271",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To steadily lose (something vital)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3034dd36-b247-40ee-8a3c-aca699743831",
                                                "sense_id": "90ca3a26-d352-3e5f-a9ac-72a014988271",
                                                "text": "The company was bleeding talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ab7ffb-55a5-30aa-97e6-b4d6a18f28f8",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To spread from the intended location and stain the surrounding cloth or paper."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa6ebf6f-d726-4f8c-8670-d24e923fb3eb",
                                                "sense_id": "79ab7ffb-55a5-30aa-97e6-b4d6a18f28f8",
                                                "text": "Ink traps counteract bleeding."
                                            },
                                            {
                                                "example_id": "157791a2-b1f5-41f9-9115-72804a10b861",
                                                "sense_id": "79ab7ffb-55a5-30aa-97e6-b4d6a18f28f8",
                                                "text": "The ink bled only a little; if one raised the index card to one’s eye, it was possible to see the microscopic wisps and flicks seep out from the intended lines and curves out into the paper’s grain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac44d9d-7d86-3724-abe5-0ea9da420043",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To remove air bubbles from a pipe containing other fluids."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3647c031-d813-38d5-b761-94c4d24168c6",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To tap off high-pressure gas (usually air) from a system that produces high-pressure gas primarily for another purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098f4f2f-2991-4a06-9c7e-0b77782454ca",
                                                "sense_id": "3647c031-d813-38d5-b761-94c4d24168c6",
                                                "text": "At low engine speeds, valves open to bleed some of the highly-compressed air from the later compressor stages, helping to prevent engine surging."
                                            },
                                            {
                                                "example_id": "a2b3670b-c945-48fc-8cc6-f18cc798e215",
                                                "sense_id": "3647c031-d813-38d5-b761-94c4d24168c6",
                                                "text": "High-pressure air bled from the APU is used to spin up the engines and run the APU generator and hydraulic pump, and can also be used to pressurise the cabin if necessary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb806f1-153e-31b8-a763-1118f9e29e29",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To bleed on; to make bloody."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58450f98-dc96-3c28-8dd7-25a28b65338c",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To show one's group loyalty by showing (its associated color) in one's blood."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92bc8161-7d45-4c5f-98b1-ae6384848178",
                                                "sense_id": "58450f98-dc96-3c28-8dd7-25a28b65338c",
                                                "text": "He was a devoted Vikings fan: he bled purple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c859aee-9294-3d60-a533-6e148087846c",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To lose sap, gum, or juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb113b3-48f4-4ab0-ace9-f6bad6c345cb",
                                                "sense_id": "6c859aee-9294-3d60-a533-6e148087846c",
                                                "text": "A tree or a vine bleeds when tapped or wounded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ed6552-c8b0-3913-b7a0-3771e6903470",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To issue forth, or drop, like blood from an incision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e005cb-b85c-46b9-aad5-899404cffb7e",
                                                "sense_id": "89ed6552-c8b0-3913-b7a0-3771e6903470",
                                                "text": "For me the balm shall bleed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e5d58ad-fe33-3159-a2a1-bfc20fc044f6",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To destroy the environment where another phonological rule would have applied."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cdbde4f-5deb-4870-b0b7-93bf01813a30",
                                                "sense_id": "1e5d58ad-fe33-3159-a2a1-bfc20fc044f6",
                                                "text": "Labialization bleeds palatalization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e60fd138-2005-3dd0-a833-b7f908c46cc9",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To (cause to) extend to the edge of the page, without leaving any margin."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99b6e748-c548-4784-a6ca-a5ad15f026be",
                                                "sense_id": "e60fd138-2005-3dd0-a833-b7f908c46cc9",
                                                "text": "Full-page and double-page colour advertisements in the Sunday colour magazines usually bleed off the page' (or are 'bled to the margin'), […]"
                                            },
                                            {
                                                "example_id": "38d7ead4-7118-46c2-bec3-2c0cffe1f862",
                                                "sense_id": "e60fd138-2005-3dd0-a833-b7f908c46cc9",
                                                "text": "Too, bleeding beyond margins provides editors with several picas of space for more layout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d1ab8d1-6d7a-3369-bc4e-2ad32396cb78",
                                        "entry_id": "9d0d659f-f240-36f3-9c8b-bb7fc9a0208f",
                                        "glosses": [
                                            "To lose money."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445e9925-03cc-4c8a-b511-b96871b48bdb",
                                                "sense_id": "5d1ab8d1-6d7a-3369-bc4e-2ad32396cb78",
                                                "text": "Most of the sectors are bleeding, particularly the resources sector."
                                            }
                                        ]
                                    }
                                ]
                            },
