                                "target_word": "dazzling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "119ba615-6a2f-3bd8-9c15-d9971f809e45",
                                        "entry_id": "bc2acf58-5715-3a05-9aa9-752bb96f6b8d",
                                        "glosses": [
                                            "The action of the verb to dazzle; dazzlement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc54242-67d4-4e51-b689-4ce3e072fc4a",
                                                "sense_id": "119ba615-6a2f-3bd8-9c15-d9971f809e45",
                                                "text": "Our organization secures the greatest amount of good unbalanced by accomplished evil of any known system, a good which resembles the sober hue of massive gold, rather than the splendid dazzlings of a baser metal."
                                            }
                                        ]
                                    }
                                ]
                            }
