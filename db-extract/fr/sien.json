                ],
                "senses": [
                    {
                        "sense_id": "c573e7ee-756a-3766-9e25-efb09db27db0",
                        "entry_id": "5c1b2e96-f474-3ab2-89c5-d243b31bb88c",
                        "glosses": [
                            "Qui appartient à lui ou à elle."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "04fd65ce-1aa7-42ce-a218-77ffadd591e6",
                                "sense_id": "c573e7ee-756a-3766-9e25-efb09db27db0",
                                "text": "A l'heure même, un sien ami, M. l'abbé Bourret, curé de Saint-Étienne-de-Lugdarès, en était informé d'une façon extraordinaire."
                            },
                            {
                                "example_id": "fdad5f75-5022-4ff3-b701-cf12ff4535ab",
                                "sense_id": "c573e7ee-756a-3766-9e25-efb09db27db0",
                                "text": "Ça avait commencé comme une voix de tout le monde, mais à mesure qu’il entrait dans le chaud-vif de son malheur elle devenait plus sienne, elle semblait faite exprès pour l’histoire."
                            },
                            {
                                "example_id": "297fa326-d675-4f7d-b68b-25676173a0ee",
                                "sense_id": "c573e7ee-756a-3766-9e25-efb09db27db0",
                                "text": "Il me conduisit dans un hôtel de Broummana, où un sien oncle, digne notable entarbouché et quelque peu ministre, arrangea mon affaire d'un coup de téléphone."
                            },
                            {
                                "example_id": "67424c31-defe-4f39-a4c4-f44c4a71c961",
                                "sense_id": "c573e7ee-756a-3766-9e25-efb09db27db0",
                                "text": "Toujours elle demeurait là, à l'envelopper de son haleine, à lui rappeler qu'il était sien."
                            }
                        ]
                    }
                ],
