                        "entry_id": "4e835c69-a10e-3511-82b9-29a51dc95db9",
                        "glosses": [
                            "Personne qui a subi une lobotomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a60319-1322-49bc-9b92-32f002fbeb53",
                                "sense_id": "1f81fced-2128-3b64-9828-b9830180a638",
                                "text": "Or, le lobotomisé montre une tendance à la désorientation dans le temps qui contraste avec l’intégrité relative de son orientation spatiale."
                            },
                            {
                                "example_id": "423f8b2d-2ae3-4793-9468-f09fb1e8182f",
                                "sense_id": "1f81fced-2128-3b64-9828-b9830180a638",
                                "text": "Ceci signifie que le lobotomisé ne dispose plus lui-même de la régulation de son affectivité."
                            },
                            {
                                "example_id": "493c8418-3954-4228-ad25-3fa0d4f262b8",
                                "sense_id": "1f81fced-2128-3b64-9828-b9830180a638",
                                "text": "Phinéas Gage, le premier lobotomisé connu, était un ouvrier ordonné et méticuleux, jusqu’au jour où une barre de fer lui a pénétré l’œil et a coupé ses deux lobes frontaux."
                            }
                        ]
                    }
