                    {
                        "form_id": "a5fafda0-81d9-4c0c-b9ea-d0a1fa307907",
                        "entry_id": "ffbf0e1b-4197-3e40-b016-7fe1e76fbbe6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Niederschriften"
