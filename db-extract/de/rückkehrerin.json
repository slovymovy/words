                "senses": [
                    {
                        "sense_id": "72bc85d1-281a-39f6-92a9-b4225e874b54",
                        "entry_id": "be8e3e1c-0314-3094-9a14-1e7d27feb4d0",
                        "glosses": [
                            "weibliche Person, die nach langer Abwesenheit in die Heimat zurückkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1859857-a7ed-40ff-9f7f-3ea73b27bee7",
                                "sense_id": "72bc85d1-281a-39f6-92a9-b4225e874b54",
                                "text": "Morgen erwarten wir die Rückkehrerinnen. Papa fährt zum Bahnhof, sie und das ganze Gepäck abholen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2053840d-8c35-36a5-bcf0-2ec64a31e233",
                        "entry_id": "be8e3e1c-0314-3094-9a14-1e7d27feb4d0",
                        "glosses": [
                            "weibliche Person, die nach langer Abwesenheit in ihrem Beruf aktiv wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d6d748-dbaa-4dd8-87df-5ac705b0e883",
                                "sense_id": "2053840d-8c35-36a5-bcf0-2ec64a31e233",
                                "text": "Die Weltranglistenfünfte hatte Schwierigkeiten mit der Rückkehrerin, die nach der Kinderpause nun ihre ersten Matches auf großer Bühne absolvierte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
