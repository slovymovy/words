                "senses": [
                    {
                        "sense_id": "93b2d976-1fad-34cd-b8ff-540c9eab0571",
                        "entry_id": "3c7b12b6-7534-34a8-9ef0-744603ae759b",
                        "glosses": [
                            "Entwicklung einer Eizelle (Oogenese), die durch das Eindringen von Spermien ausgelöst wird, ohne dass es zur Befruchtung kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2995bf2d-c549-49f3-a66e-da542890963a",
                                "sense_id": "93b2d976-1fad-34cd-b8ff-540c9eab0571",
                                "text": "„Doch möglicherweise handelt es sich um die Gynogenese, bei der sich das weibliche Tier mit einem artfremden Männchen paart.“"
                            },
                            {
                                "example_id": "e7e9e463-4cb5-4e09-87c0-6de98dbab47a",
                                "sense_id": "93b2d976-1fad-34cd-b8ff-540c9eab0571",
                                "text": "„Bei der Gynogenese entstehen die haploiden Zellen aus den Zellen des Embryosacks, die wiederum durch mitotische Teilung der haploiden Megaspore entstanden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
