                            {
                                "example_id": "85783503-59a3-4bac-b5c4-052db6075faa",
                                "sense_id": "6e50eabd-3c5d-3641-be5c-30ba2cb1e582",
                                "text": "Het houdt bewonderaars nog steeds bezig: is de kunst van Vincent van Gogh het werk van een genie of gek? Of was hij een geniale gek? De tentoonstelling 'De waanzin nabij' duikt in het gekwelde zielenleven van de schilder."
                            }
                        ]
                    },
                    {
                        "sense_id": "15b9acb1-6b8a-3ede-8bee-290960e7efc9",
                        "entry_id": "af62e9d1-d38f-33a5-acca-ced3a352ff70",
