                "word": "Syria",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fda47141-b818-35d9-8c13-d6bb02f7fe41",
                        "entry_id": "5faacb1d-5906-3872-baf2-458258f1e013",
                        "glosses": [
                            "A country in West Asia in the Middle East. Official name: Syrian Arab Republic. Capital: Damascus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "312a2cfc-12a5-4381-8450-483d1bc84853",
                                "sense_id": "fda47141-b818-35d9-8c13-d6bb02f7fe41",
                                "text": "Representatives of the Syrian National Council and the National Coordination Body for Democratic Change in Syria signed an agreement late Friday in Cairo for a transition in a post-Assad era, the NCB said on its Facebook page."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d3edd96-cb82-396e-b5df-c8621d2436f6",
                        "entry_id": "5faacb1d-5906-3872-baf2-458258f1e013",
                        "glosses": [
                            "A region in West Asia extending from modern-day southeast Turkey to the north, the Euphrates and Arabian Desert to the east, the Sinai Peninsula to the south, and the Mediterranean sea to the west; Greater Syria."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "201a95b4-3a58-4f70-b556-8c1fca1adf41",
                                "sense_id": "5d3edd96-cb82-396e-b5df-c8621d2436f6",
                                "text": "The belt which runs along the eastern frontier from north to south, traversing all Syria from the extreme limits of the Taurus to the Sinai desert, is not remarkable for any marked grandeur in its physical features, and is tolerably uniform in its characteristics, being made up to a considerable extent of a broad plateau of steppe land, rock and sand and debris being freely intermingled in its formation, and forming an immeasurable succession of high plains, whose effect is manifest in the course of the Euphrates, which has been driven to the eastward thereby, and removed from the immediate neighbourhood of the Mediterranean Sea."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeda85e9-664e-361e-93f6-6f99199e346d",
                        "entry_id": "5faacb1d-5906-3872-baf2-458258f1e013",
                        "glosses": [
                            "An ancient Roman province between 64 BCE and 135 CE."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
