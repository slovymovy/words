                "senses": [
                    {
                        "sense_id": "718c5510-5660-3f6f-a35b-037a1c296b8f",
                        "entry_id": "376895cb-b34c-3fa0-95e5-268bfafeed0b",
                        "glosses": [
                            "artysta, twórca, który tworzy w nurcie futuryzmu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a87a82d-2c76-4cac-afcf-51d221d98170",
                        "source_entry_id": "376895cb-b34c-3fa0-95e5-268bfafeed0b",
                        "source_sense_id": "718c5510-5660-3f6f-a35b-037a1c296b8f",
                        "target_lang_word": "futurist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futurist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e991570-a379-3bab-8ce5-34ddee45de6e",
                                        "entry_id": "5677da87-72ed-3e75-ad2d-a142231b04df",
                                        "glosses": [
                                            "An adherent to the principles of the artistic movement of futurism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5d1d8b-3a56-463f-886a-4bf4e599dc3e",
                                                "sense_id": "1e991570-a379-3bab-8ce5-34ddee45de6e",
                                                "text": "The distinction, however, seems to be that the warriors of the past went in for tournaments, which were at least dangerous for themselves, while the Futurists go in for motor-cars, which are mainly alarming for other people."
                                            },
                                            {
                                                "example_id": "1b444230-f3ad-425b-a7c7-5016f2e61dcf",
                                                "sense_id": "1e991570-a379-3bab-8ce5-34ddee45de6e",
                                                "text": "‘A passion for destruction is also a creative passion.’ This statement by the Russian revolutionary Mikhail Bakunin in 1842 could have been the rallying cry of the Italian Futurists around 1910."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada8045f-53ef-3722-8aa1-8b1db3db5efb",
                                        "entry_id": "5677da87-72ed-3e75-ad2d-a142231b04df",
                                        "glosses": [
                                            "One who studies and predicts possible futures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce35741b-bb4b-4db1-903a-cdd83067b6d8",
                                                "sense_id": "ada8045f-53ef-3722-8aa1-8b1db3db5efb",
                                                "text": "Two multibillion-dollar industries—the computer manufacturers and telephone companies—had each developed its technologies separately. But as futurist Howard Rheingold suggests in his book Virtual Communities, the industries inadvertently gave private consumers access to those billion of dollars by selling them a tiny device to link the two technologies together: a computer modem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "futurist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dea49d1e-f7ab-3612-a536-9c06a3197804",
                                        "entry_id": "6171ce71-f023-3e8f-9b5f-d86c7875c176",
                                        "glosses": [
                                            "In the style of futurism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065d6a12-011a-40b7-83c1-5093cb82c892",
                                                "sense_id": "dea49d1e-f7ab-3612-a536-9c06a3197804",
                                                "text": "Salvat took to heart what Marinetti was provocatively clamoring: “Futurist poetry, having already destroyed traditional metrics and created free verse, now destroys the Latin period and its syntax. Futurist poetry is a spontaneous uninterrupted flow of analogies, each synthesized in an essential noun”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14db55e3-5175-4c07-a0ed-b9802ba33d71",
                        "source_entry_id": "376895cb-b34c-3fa0-95e5-268bfafeed0b",
                        "source_sense_id": "718c5510-5660-3f6f-a35b-037a1c296b8f",
                        "target_lang_word": "futuriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futuriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c27157-2a67-382f-92a2-1808ce9a923b",
                                        "entry_id": "215f5ee1-f24a-33a6-b1b9-6768bffdc6dd",
                                        "glosses": [
                                            "Relatif au futurisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1ba38e-b75c-4e44-ab10-4f3149e55f4c",
                                                "sense_id": "e5c27157-2a67-382f-92a2-1808ce9a923b",
                                                "text": "Le nouveau système d’évaluation futuriste fait de l’universel le gnomon du particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                        "entry_id": "215f5ee1-f24a-33a6-b1b9-6768bffdc6dd",
                                        "glosses": [
                                            "Qui donne une impression d’entrer dans le futur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a72e6fc-d635-4307-8b00-4dc5d64f6d58",
                                                "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                                "text": "Cette déchetterie futuriste est installée sur une barge de 50 m de long ; cela permet d’optimiser l’espace qui manque dans les centres des grandes villes."
                                            },
                                            {
                                                "example_id": "109c2c76-bfc6-4a60-9e42-d688d3e06e99",
                                                "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                                "text": "L’Arabie saoudite organisera les Jeux asiatiques d’hiver de 2029. Ils auront lieu à Neom, une mégapole futuriste en construction dans le désert montagneux du riche État pétrolier, a annoncé, mardi, le Conseil olympique d’Asie."
                                            },
                                            {
                                                "example_id": "d9d66231-6e4f-4881-99c8-7515a902e96c",
                                                "sense_id": "541baff2-d506-3b7f-9e30-96bcb7b9811b",
                                                "text": "De quoi alimenter des péripéties futuristes, coécrites par Laurent Sarfati, avec lequel le réalisateur avait déjà signé la série Lastman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "futuriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                        "entry_id": "83e85aa4-4ffd-3a71-b0ca-6588417026d7",
                                        "glosses": [
                                            "Adepte du futurisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1120da72-056b-419a-8f87-213c74972fdd",
                                                "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                                "text": "Les futuristes les plus célèbres sont Filippo Tommaso Marinetti, Giacomo Balla, Umberto Boccioni, Carlo Carrà, Severini et Luigi Russolo."
                                            },
                                            {
                                                "example_id": "68886d2c-b015-4afb-ad28-5d4d1df9b37b",
                                                "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                                "text": "Les futuristes feront flèche de tout bois pour assurer leur révolution : l’urbanisme, soit, mais aussi la musique, le vêtement, le cinéma, le roman, autant de domaines oubliés par le surréalisme."
                                            },
                                            {
                                                "example_id": "bf976178-e06b-40a3-ac54-182db248cf88",
                                                "sense_id": "3f927651-12d8-3711-892f-e037e5f1d745",
                                                "text": "Les futuristes l’avaient senti en 1920. Ils avaient fait de la vitesse un art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
