                "senses": [
                    {
                        "sense_id": "08e400f1-2845-35ff-a51b-3e45e4718065",
                        "entry_id": "a8d43dfa-b3a0-3034-8557-1489c7250023",
                        "glosses": [
                            "Lied, das bei dem evangelischen Gottesdienst (Abendmahl) gesungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c575ac7c-c108-46ca-9c0b-06966cad00a3",
                                "sense_id": "08e400f1-2845-35ff-a51b-3e45e4718065",
                                "text": "„Jetzt wird das Abendmahlslied gesungen und das Abendmahl ausgeteilt.“"
                            },
                            {
                                "example_id": "be85d92c-f9c6-4156-955c-6acbaead73a4",
                                "sense_id": "08e400f1-2845-35ff-a51b-3e45e4718065",
                                "text": "„Bei der Feier des heiligen Abendmahls, die auf die Predigt zu folgen pflegte, blieb sie versammelt; stehend sang sie die Abendmahlslieder und nahm so an der Feier lebendigen Anteil.“"
                            },
                            {
                                "example_id": "8cce9418-f417-409f-96a4-c1de6661b712",
                                "sense_id": "08e400f1-2845-35ff-a51b-3e45e4718065",
                                "text": "„Zu den bekanntesten gehört das Abendmahlslied ‚Ach Gnad über alle Gnad‘ und ein Sonntagslied mit dem Titel ‚Wohl dem, der Jesum liebet und dessen Himmelswort‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
