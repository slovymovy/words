                            "singular"
                        ],
                        "form": "den Hausgang"
                    },
                    {
                        "form_id": "045afd92-e1d6-4bcf-b5d7-ec7264c8cd66",
                        "entry_id": "ed988776-764c-3846-abc8-c38255c47adf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hausgänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8386e84e-fbcd-3ae3-afc7-e257b1531d44",
                        "entry_id": "ed988776-764c-3846-abc8-c38255c47adf",
                        "glosses": [
                            "Gang eines Hauses"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "8cadbf78-16bd-4be2-82d3-9b8c01ec8a4b",
                                "sense_id": "8386e84e-fbcd-3ae3-afc7-e257b1531d44",
                                "text": "„Er jault und jammert, er zetert und mordiot, er schreit im Hausgang um Hilfe, und wenn keiner antwortet, ruft er seine Mutter an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e50ab9b-b4fc-4257-a417-3d2c2a0f49c8",
                        "source_entry_id": "ed988776-764c-3846-abc8-c38255c47adf",
                        "source_sense_id": "8386e84e-fbcd-3ae3-afc7-e257b1531d44",
                        "source_sense_description": "süddeutsch, österreichisch, schweizerisch: Gang eines Hauses",
                        "target_lang_word": "couloir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couloir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64782edd-ede1-3720-b2db-36b07616e23e",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Passage long et étroit allant d’un point à un autre, dans un bâtiment, un train, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cb0136-1f35-49a9-8ade-cff0ba2eef9f",
                                                "sense_id": "64782edd-ede1-3720-b2db-36b07616e23e",
                                                "text": "Par un manque de chance pervers, il apparut à l'autre bout du couloir à l’instant où elle s’y précipitait, et il s'en fallut de peu qu'elle le percutât."
                                            },
                                            {
                                                "example_id": "e0cb9e9c-84c6-4db1-9469-299aa8eac417",
                                                "sense_id": "64782edd-ede1-3720-b2db-36b07616e23e",
                                                "text": "Jour après jour, nous arpentons notre vie comme on arpente un couloir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc768145-4be9-3d07-bc64-2062eae19442",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Passage long et étroit"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bffd5bf-c1ee-4626-ad4e-f7fefe477efd",
                                                "sense_id": "dc768145-4be9-3d07-bc64-2062eae19442",
                                                "text": "Huguenin fit pénétrer son cheval au sein d'une épinaie. Le passage emprunté constituait une sorte d'étroit couloir dont on ne pouvait s'écarter sans se faire douloureusement griffer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "699fc4fb-8653-3bee-ac0a-b20f9b1d0276",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Bande étroite de territoire enclavé."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068ae835-5f37-41bf-8a9b-9a3848aee9c4",
                                                "sense_id": "699fc4fb-8653-3bee-ac0a-b20f9b1d0276",
                                                "text": "Nous laissons beaucoup trop les Alsaciens « cuire dans leur jus », nous les abandonnons trop à l'horizon confiné de ce couloir d'entre Vosges et Rhin où la fermentation d'un particularisme fanatique finit par exhaler une agressive odeur de renfermé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "438a71be-931a-361d-b2d3-91dfc67bb7cc",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Voie particulière, voire réservée."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9214ba9-67e6-43f7-b1a4-ab1fd74fb46e",
                                                "sense_id": "438a71be-931a-361d-b2d3-91dfc67bb7cc",
                                                "text": "Le couloir de bus est réservé au bus et au taxi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5336590b-81a2-3109-8b73-a4b9b96e419a",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Bande délimitée et réservée à un participant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51433e51-6654-4f3c-b9a5-0c6776f0bfd1",
                                                "sense_id": "5336590b-81a2-3109-8b73-a4b9b96e419a",
                                                "text": "Le couloir en natation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794edd7d-7670-3788-bfdd-6085f8a9e3dd",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Zone latérale d'un terrain de sports où évolue un joueur assigné à un poste tel que celui d'ailier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4461f82d-c11e-4c7c-8ad4-390918844042",
                                                "sense_id": "794edd7d-7670-3788-bfdd-6085f8a9e3dd",
                                                "text": "Des fenêtres de la cuisine, qui donnent sur le terrain de jeux de l’école, je peux le voir tenir le rôle d’ailier gauche. C’est à lui que je dois d’aimer, depuis, les joueurs de couloir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17564244-bdfa-3f4a-a7ac-5af972879a64",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Trajectoire possible pour un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af7bc940-d381-4d26-a60b-8b2576995e44",
                                                "sense_id": "17564244-bdfa-3f4a-a7ac-5af972879a64",
                                                "text": "Un couloir aérien."
                                            },
                                            {
                                                "example_id": "693bf25d-bfc1-4ba0-93a9-3dc5aa891229",
                                                "sense_id": "17564244-bdfa-3f4a-a7ac-5af972879a64",
                                                "text": "On me réveilla pour m'annoncer que la situation était sensiblement meilleure, que l'horizon s'était éclairci et que nous pourrions très probablement trouver un couloir entre Le Havre et Le Crotoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade817bf-855e-3fea-8a5b-fd26fdb18c93",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Petite pelle de pesée utilisée pour prélever."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f57043c-4d60-3026-9d4b-ae2b7d81c50c",
                                        "entry_id": "32a568f6-cde7-3744-a28e-a9b7d348711e",
                                        "glosses": [
                                            "Pièce de métal, servant à assurer l’étanchéité entre des tuiles et un mur ou le bord de la toiture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
