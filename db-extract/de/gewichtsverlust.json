                                        "glosses": [
                                            "The reduction of total body mass due to loss of fluid, fat, tissue, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bcce38b-3285-4a34-b255-e290ff3cf1dc",
                                                "sense_id": "49169bd9-a648-3346-86f6-48590c13cf2a",
                                                "text": "John achieved 25 pounds in weight loss after abstaining from soda and running two miles in the morning every day."
                                            },
