                "senses": [
                    {
                        "sense_id": "752f6b5d-a66a-3b7e-99f4-1621f5b47929",
                        "entry_id": "2a498f77-28d1-3c81-81f8-d4e71c515a5a",
                        "glosses": [
                            "Relatif aux Feuillants, cisterciens réformés aux XVIᵉ, XVIIᵉ et XVIIIᵉ siècles."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f6300503-b9e4-3946-bba2-70059a49f7be",
                        "entry_id": "2a498f77-28d1-3c81-81f8-d4e71c515a5a",
                        "glosses": [
                            "Relatif au feuillantisme, mouvement révolutionnaire à tendance monarchiste durant la Révolution française (installés dans le Couvent des Feuillants de Paris, d'où son nom)."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "8c80e6cf-fa37-426b-85b3-3c6dd7281bf7",
                                "sense_id": "f6300503-b9e4-3946-bba2-70059a49f7be",
                                "text": "L'Assemblée répondit à ces paroles prophétiques en forçant le roi à remplacer le ministère feuillant par un ministère girondin, […]."
                            },
                            {
                                "example_id": "b39f4b44-96f8-4bd2-9983-4e9275f2cc53",
                                "sense_id": "f6300503-b9e4-3946-bba2-70059a49f7be",
                                "text": "Ainsi Chassard, ex-vicaire de la paroisse... de Saint-Germain l'Auxerrois, d'abord feuillant, puis fayettiste, puis brissotin, puis hébertiste, puis robespierrot, et définitivement contre-révolutionnaire décidé."
                            }
                        ]
                    }
                ],
