                ],
                "senses": [
                    {
                        "sense_id": "c7f500eb-766e-3fdc-b5b7-4afb4ce74880",
                        "entry_id": "9d97b8eb-ba7a-3213-bc75-d6211e56d424",
                        "glosses": [
                            "Frist, vor deren Beendigung etwas nicht möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0888896-9f8e-487b-bc65-e0f76c73af1d",
                                "sense_id": "c7f500eb-766e-3fdc-b5b7-4afb4ce74880",
                                "text": "„Was haben Radsport, Sex und die Bundesregierung gemeinsam? Richtig, sie alle kennen eine Karenzzeit. Will ein Politiker aus der Regierung in die Wirtschaft wechseln, soll er also 18 Monate lang mit der Idee schwanger gehen – eine durchaus übliche Tragzeit für Dickhäuter.“"
                            },
                            {
                                "example_id": "3893683f-b0a8-42ee-8de9-ebda027e3b70",
                                "sense_id": "c7f500eb-766e-3fdc-b5b7-4afb4ce74880",
                                "text": "„[Die Grünen] verwiesen dabei auf Forderungen von LobbyControl und Transparency International nach einer Karenzzeit von drei Jahren.“"
                            },
                            {
                                "example_id": "02f8289f-86da-4dfb-b227-877ad237ad50",
                                "sense_id": "c7f500eb-766e-3fdc-b5b7-4afb4ce74880",
                                "text": "„Pötsch, von 2003 bis 2015 Finanzvorstand bei VW, wechselte ohne Karenzzeit in die Position des Chefaufsehers.“"
                            },
                            {
                                "example_id": "cd8f44f9-609c-4412-ab27-28b97dc1ed9a",
                                "sense_id": "c7f500eb-766e-3fdc-b5b7-4afb4ce74880",
                                "text": "„In der Wirtschaft sind Karenzzeiten beim Wechsel vom Vorstand in den Aufsichtsrat schon vorgeschrieben.“"
                            },
                            {
                                "example_id": "9bcf4111-2622-49c6-8afd-0df1d1b4ec80",
                                "sense_id": "c7f500eb-766e-3fdc-b5b7-4afb4ce74880",
                                "text": "„Aber wenigstens sollte alsbald eine Karenzzeit für den Wechsel von Politikern in die Wirtschaft eingeführt werden, um schon den Anschein von Korruption zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa93ed27-da78-3395-bb35-a84e2d302cc4",
                        "entry_id": "9d97b8eb-ba7a-3213-bc75-d6211e56d424",
                        "glosses": [
                            "Sperrfrist"
                        ],
                        "tags": [
                            "Rechtssprache",
                            "Versicherungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "56444c33-d075-460c-99d1-6ee3cb8911ae",
                                "sense_id": "aa93ed27-da78-3395-bb35-a84e2d302cc4",
                                "text": "In der privaten Krankenversicherung ist die Karenzzeit der Zeitraum zwischen dem Beginn des Versicherungsfalls und dem Einsetzen der Leistungspflicht."
                            },
                            {
                                "example_id": "d72f5606-316b-48d9-af3a-2c9bf0b447bf",
                                "sense_id": "aa93ed27-da78-3395-bb35-a84e2d302cc4",
                                "text": "Diese Renten wurden vor 1956 nach einer Karenzzeit von sechs Monaten nach Beginn der Arbeitsunfähigkeit des Versicherten gewährt."
                            },
                            {
                                "example_id": "57f5873d-3a8e-49e3-ab1a-ebe4506542ae",
                                "sense_id": "aa93ed27-da78-3395-bb35-a84e2d302cc4",
                                "text": "„Bei Austritten während dieser Karenzzeit wird ein Teil des Bonus einbehalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                        "entry_id": "9d97b8eb-ba7a-3213-bc75-d6211e56d424",
                        "glosses": [
                            "an den Mutterschutz anschließende Elternzeit bei aufrechtem Arbeitsverhältnis"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "92dbbd00-67ef-4ce6-90cc-98558bfb4444",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Es können zusätzlich 1000 Euro für die Betreuung des Kindes bezogen werden, wenn sich die Eltern die Karenzzeit 50:50 aufteilen, mit einer Toleranz von zehn Prozent.“"
                            },
                            {
                                "example_id": "4b1b9a8a-9c2d-406e-9918-6c59923f952e",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Helene Dearing: […] In Kombination mit der Tatsache, dass Eltern in Slowenien mit Ablaufen ihrer Karenzzeit automatisch einen Rechtsanspruch auf einen Vollzeit-Kinderbetreuungsplatz erwerben, ist das slowenische Modell in Hinblick auf die Förderung von Gleichstellung als vorbildlich zu sehen.“"
                            },
                            {
                                "example_id": "41cbe8dc-02c6-4f44-b44a-9fcb8639269a",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Der Gesamtbetrag kann nur ausgeschöpft werden, wenn der Vater zumindest 20 Prozent der Karenzzeit übernimmt.“"
                            },
                            {
                                "example_id": "6482e82c-4f59-43e1-9fe4-8bbdfa20a8fc",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Ist nicht das ganze Kalenderjahr auch Karenzzeit, dann muss dieser Anteil entsprechend reduziert werden.“"
                            },
                            {
                                "example_id": "30eec755-d082-4ca9-aab1-44c09a593ad4",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Immer noch stellt die Geburt eines Kindes und die damit verbundene Karenzzeit eine Zäsur für viele Berufstätige dar.“"
                            },
                            {
                                "example_id": "fbb522e7-e868-478c-92d6-48a6b144948f",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Sie nahm in der Folge Karenzurlaub in Anspruch und wurde in der Karenzzeit neuerlich schwanger.“"
                            },
                            {
                                "example_id": "ab644d83-7ddb-4105-83d3-7ec819c45ccf",
                                "sense_id": "666d1935-120e-39e3-a58d-97f2a658b2d4",
                                "text": "„Auch Frauen, die Kinder bekommen haben, orientieren sich nach der Karenzzeit oftmals neu – nicht alle freiwillig.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
