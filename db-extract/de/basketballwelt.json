                        "glosses": [
                            "Gesamtheit derjenigen, die Basketball spielen und/oder in dieser Sportart zu tun haben oder sich dafür interessieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6864c022-f60d-4d39-9330-55c929c917c4",
                                "sense_id": "f002850e-796d-3139-97a2-28147f88c80a",
                                "text": "„Die Basketballwelt trauert um einen ihrer besten Spieler: Der frühere NBA-Superstar Kobe Bryant kommt bei einem Hubschrauberabsturz ums Leben.“"
                            },
                            {
                                "example_id": "b6442fc2-0756-447e-b040-d722cebe4dfa",
                                "sense_id": "f002850e-796d-3139-97a2-28147f88c80a",
                                "text": "„Bryant, James und Wade sind die Cristiano Ronaldos der Basketballwelt.“"
                            },
                            {
                                "example_id": "dccc5f3a-2d80-410a-a2b4-34233ac42aad",
                                "sense_id": "f002850e-796d-3139-97a2-28147f88c80a",
                                "text": "„20 Punkte, 12 Rebounds, 2 Korbvorlagen und 3,5 Blocks pro Spiel – das sind die in der Basketballwelt so wichtigen Kennzahlen von Hartensteins abgelaufener Saison.“"
                            },
                            {
                                "example_id": "6bf80baf-58f3-464b-abc5-6b76fab9ca32",
                                "sense_id": "f002850e-796d-3139-97a2-28147f88c80a",
                                "text": "„Die nordamerikanische Basketballwelt steht vor einer Zeitenwende.“"
                            },
                            {
