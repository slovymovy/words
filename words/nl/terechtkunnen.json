{
    "word_family": [
        "terecht",
        "kunnen",
        "terechtkomen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "500b42bd-ff8f-3fae-96f1-72bca0133fe4",
                    "sense_definition": "de mogelijkheid hebben om hulp, advies of informatie te vragen bij een persoon of instantie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hulp zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor al uw vragen over de nieuwe regels <w>kunt</w> u bij de balie <w>terecht</w>.",
                            "target_lang_translations": {
                                "en": "For all your questions about the new rules, you can <w>go to</w> the desk."
                            }
                        },
                        {
                            "text": "Het is fijn dat studenten met hun problemen bij een mentor <w>kunnen terecht</w>.",
                            "target_lang_translations": {
                                "en": "It is nice that students can <w>turn to</w> a mentor with their problems."
                            }
                        }
                    ],
                    "synonyms": [
                        "aankloppen",
                        "zich wenden tot"
                    ],
                    "common_phrases": [
                        "bij iemand terechtkunnen",
                        "voor hulp terechtkunnen"
                    ],
                    "target_lang_definitions": {
                        "en": "To have the possibility to ask a person or organization for help, advice, or information."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to go to",
                                "target_lang_sense_clarification": "for help or information"
                            },
                            {
                                "target_lang_word": "to turn to",
                                "target_lang_sense_clarification": "someone for assistance"
                            },
                            {
                                "target_lang_word": "to be able to see",
                                "target_lang_sense_clarification": "someone for a consultation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92c88982-3f3f-30fb-a3f7-ea1bfa63cba2",
                    "sense_definition": "de mogelijkheid hebben om een bepaalde plaats te gebruiken of ergens binnen te gaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toegang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onze sportclub moet in het buurthuis <w>terechtkunnen</w> als we een plek voor de bijeenkomsten nodig hebben.",
                            "target_lang_translations": {
                                "en": "Our sports club needs to <w>be able to use</w> the community center if we need a place for meetings."
                            }
                        },
                        {
                            "text": "Omdat het hotel volgeboekt was, <w>konden</w> we nergens anders meer <w>terecht</w>.",
                            "target_lang_translations": {
                                "en": "Because the hotel was fully booked, we couldn't <w>find a place</w> anywhere else."
                            }
                        }
                    ],
                    "synonyms": [
                        "toegang hebben"
                    ],
                    "common_phrases": [
                        "ergens terechtkunnen"
                    ],
                    "target_lang_definitions": {
                        "en": "To have the possibility to use a certain place or to enter somewhere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to find a place",
                                "target_lang_sense_clarification": "to stay or meet"
                            },
                            {
                                "target_lang_word": "to be accommodated",
                                "target_lang_sense_clarification": "to have space available"
                            },
                            {
                                "target_lang_word": "to get in",
                                "target_lang_sense_clarification": "to have access to a location"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}