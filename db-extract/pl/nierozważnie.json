                    {
                        "translation_id": "d60900da-4324-4fc3-9295-3958662ffcbf",
                        "source_entry_id": "e430db18-2e56-3099-8f06-9bd0a3c14e49",
                        "source_sense_id": "8f336f04-8a49-366a-afe7-c6b4ebfec430",
                        "target_lang_word": "inconsiderately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsiderately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55f8b284-7ffb-36cb-a3a0-dabdd7b8a97c",
                                        "entry_id": "d19e288b-cf22-349f-958b-0beca18b9f36",
                                        "glosses": [
                                            "In an inconsiderate manner; without consideration for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32843866-8b2e-43a6-a30b-56648ce6617d",
                                                "sense_id": "55f8b284-7ffb-36cb-a3a0-dabdd7b8a97c",
                                                "text": "He inconsiderately let the twig snap back at her."
                                            },
                                            {
                                                "example_id": "1d5a144b-7d41-4b7d-82ee-bbc5a822fa2b",
                                                "sense_id": "55f8b284-7ffb-36cb-a3a0-dabdd7b8a97c",
                                                "text": "Inconsiderately, he pressed on when she paused."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d217878-40a9-44f9-9231-3afcd4d4abd3",
                        "source_entry_id": "e430db18-2e56-3099-8f06-9bd0a3c14e49",
                        "source_sense_id": "8f336f04-8a49-366a-afe7-c6b4ebfec430",
                        "target_lang_word": "carelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Giving the appearance of carelessness; relaxedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8156b1-f80e-4106-a27e-65fb7b5b85c6",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "The papers were carelessly strewn on the table."
                                            },
                                            {
                                                "example_id": "c1542fe3-8aa4-46b6-abb7-4b3840f404e0",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "Let us try to imagine the qualms of some Fifth Avenue florist if he could but see so many potential boutonnières, at a dollar apiece, so carelessly heaped up in baskets, lining the dingy pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Done without care or attention; inattentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cd05c4-3647-4311-b5dc-962173fd5149",
                                                "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                                "text": "Distracted by the salesperson, he carelessly read the contract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ae2d0d9-50b7-4e95-9109-d521c5b55ece",
                        "source_entry_id": "e430db18-2e56-3099-8f06-9bd0a3c14e49",
                        "source_sense_id": "8f336f04-8a49-366a-afe7-c6b4ebfec430",
                        "target_lang_word": "inconsidérément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsidérément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                        "entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                                        "glosses": [
                                            "D’une manière inconsidérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff6d388-86ae-4f53-8c9a-1b7bacffa359",
                                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                                "text": "Robert Wells, animé du désir de venger la mort de son père, se précipita inconsidérément au milieu de l’armée du roi, où il fut enveloppé."
                                            },
                                            {
                                                "example_id": "171f43aa-0784-4d17-949b-7d5201c4e738",
                                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                                "text": "Il a parlé inconsidérément, et il ne paraît point de sagesse dans ses discours."
                                            },
                                            {
                                                "example_id": "f3910637-4f30-4766-b2f9-a2b83aefe1a2",
                                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                                "text": "L'abbé de Pont-carré me montra hier ce que vous lui écrivez sur le manteau donné inconsidérément [en cadeau à son valet]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f9af27f-02b7-46af-9907-f971dac5ed4d",
                        "source_entry_id": "e430db18-2e56-3099-8f06-9bd0a3c14e49",
                        "source_sense_id": "8f336f04-8a49-366a-afe7-c6b4ebfec430",
                        "target_lang_word": "à tort et à travers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à tort et à travers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c568e04-6f77-3c56-b298-72dc5e1adca4",
                                        "entry_id": "4c221be5-2606-33ab-9002-7be55de062a8",
                                        "glosses": [
                                            "Sans discernement ; inconsidérément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ad424d-0fa2-4f6f-9c07-617a79e2bad1",
                                                "sense_id": "8c568e04-6f77-3c56-b298-72dc5e1adca4",
                                                "text": "Nous avons vu le chef de la secte, devenu ministre, tailler à tort et à travers, et pour tout résultat produire une émeute."
                                            },
                                            {
                                                "example_id": "27f3f611-8470-4765-988e-345c7767e601",
                                                "sense_id": "8c568e04-6f77-3c56-b298-72dc5e1adca4",
                                                "text": "Ce sont ces chemins qu'il s'agit de macadamiser; non pas au moyen de pierres jetées à tort et à travers, mais au moyen d'un macadam de 2m. 50 c. de large, avec fossés pour l'écoulement des eaux; un macadam bien fait, recouvert en matière dure, quoique tendre au fond."
                                            },
                                            {
                                                "example_id": "4bd58723-3b26-4c1c-9da8-a4f29ec78b0f",
                                                "sense_id": "8c568e04-6f77-3c56-b298-72dc5e1adca4",
                                                "text": "La mort fauche. Elle fauche à tort et à travers. Peu lui importe. Ceux qu’elle a visés, elle va les chercher là où ils semblent le plus en sécurité."
                                            },
                                            {
                                                "example_id": "10c324bb-8174-422b-974d-714c26316aae",
                                                "sense_id": "8c568e04-6f77-3c56-b298-72dc5e1adca4",
                                                "text": "Cela fait trois semaines qu’il parle à tort et à travers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
