                "senses": [
                    {
                        "sense_id": "cc7f64c7-e6fa-36f3-93c1-4b184dd81e50",
                        "entry_id": "8af5b8c5-8e03-3a2d-81dc-a07b0dc27d12",
                        "glosses": [
                            "mit Waldmeister gewürztes (eventuell gezuckertes) Mischgetränk aus Wein und Schaumwein mit charakteristischer grüner Farbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1b1aa5-f216-49e2-becd-05f52e84220a",
                                "sense_id": "cc7f64c7-e6fa-36f3-93c1-4b184dd81e50",
                                "text": "„Und trotz des giftgrünen Fußbodenbelags in der Eingangshalle, dessen Anblick an so magenzerstörende Dinge wie Waldmeisterbowle oder Wackelpeter denken läßt, gab es keine Bosheiten, dafür viel gute Laune […]“"
                            },
                            {
                                "example_id": "6decd2d9-342c-43c4-9aff-3d294ae0dcb8",
                                "sense_id": "cc7f64c7-e6fa-36f3-93c1-4b184dd81e50",
                                "text": "„Zum Mai-Aperitif Waldmeisterbowle gibt es an diesem Abend den schon obligatorischen großen Brötchenkorb, zu dem gesalzene Butter, Frischkäse und Paprikacreme gereicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
