                        "glosses": [
                            "To ask or query; used imperatively to introduce a question or signify doubt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a3860b8-adef-45be-b419-f4c4c2271ae6",
                                "sense_id": "43591c26-3d76-37f9-8ff9-e4e346ad8f43",
                                "text": "Suppose then the cube and sphere placed on a table, and the blind man be made to see: quaere, whether by his sight, before he touched them, he could now distinguish and tell which is the globe, which the cube?"
                            },
                            {
                                "example_id": "55236282-4bc6-4a4f-abfb-3e493e61138f",
                                "sense_id": "43591c26-3d76-37f9-8ff9-e4e346ad8f43",
                                "text": "Now, she cannot express her emotions fully: Quaere: will she feel them fully?"
                            }
                        ]
                    }
                ],
