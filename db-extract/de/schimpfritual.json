                ],
                "senses": [
                    {
                        "sense_id": "f919ba5b-2166-3cf4-8b0b-d5ad57090c48",
                        "entry_id": "53adadfe-47ba-3b5e-b451-08c085a8ee72",
                        "glosses": [
                            "Schimpfen gemäß konventionellen, ritualisierten Regeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f121e08a-7860-4539-a98e-8eefab12df5e",
                                "sense_id": "f919ba5b-2166-3cf4-8b0b-d5ad57090c48",
                                "text": "„Bei den Inuit dienen Schimpfrituale auch der Belustigung: Wortgefechte werden hier nur mit Witz und Spott ausgetragen.“"
                            },
                            {
                                "example_id": "2d6e1b6f-65a5-4f66-b523-b80c1e7de8d9",
                                "sense_id": "f919ba5b-2166-3cf4-8b0b-d5ad57090c48",
                                "text": "„Die beiden waren auf dem Radweg kollidiert und sich beim anschließenden Schimpfritual näher gekommen.“"
                            },
                            {
                                "example_id": "f0d6be82-ffac-4c82-8bf1-a94154e9939a",
                                "sense_id": "f919ba5b-2166-3cf4-8b0b-d5ad57090c48",
                                "text": "„Das Bonner Schimpfritual hätten sie doch nicht mitmachen wollen.“"
                            },
                            {
                                "example_id": "e3643994-f754-49f6-8cae-aae969128fe2",
                                "sense_id": "f919ba5b-2166-3cf4-8b0b-d5ad57090c48",
                                "text": "„Die ethnologische und volkskundliche Höflichkeits- und Konfliktforschung und die zahlreich in der ethnologischen Literatur erwähnten Schimpfrituale dienen weiterhin der Annäherung an den homo maledicens als Forschungsgegenstand.“"
                            },
                            {
                                "example_id": "37b0ab45-417c-4dc5-bf7b-f76f405ac49e",
                                "sense_id": "f919ba5b-2166-3cf4-8b0b-d5ad57090c48",
                                "text": "„Gleichzeitig belegen diese Kampf- und Schimpfrituale vor allem die zahlreichen alltäglichen Interaktionen, die trotz der vorhandenen antijüdischen Feindbilder bestanden haben und sind ein weiterer Hinweis auf die Verknüpfung der Lebenswelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
