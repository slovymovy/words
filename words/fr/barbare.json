            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4913a429-7e9a-3dc1-80df-cdb737cea9bd",
                    "sense_definition": "Qui fait preuve d'une extrême cruauté, qui est violent et dépourvu d'humanité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cruaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces soldats ont commis un acte particulièrement <w>barbare</w> envers la population civile."
                        },
                        {
                            "text": "Il refuse de cautionner un traitement aussi <w>barbare</w> infligé à des animaux domestiques."
                        }
                    ],
                    "synonyms": [
                        "cruel",
                        "inhumain",
                        "féroce",
                        "sauvage"
                    ],
                    "antonyms": [
                        "civilisé"
                    ],
                    "common_phrases": [
