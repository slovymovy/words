                    {
                        "translation_id": "fec04adf-f130-4157-af03-9c003501d05b",
                        "source_entry_id": "fcf25926-62af-336a-9f96-c1462deee951",
                        "target_lang_word": "несклоняемый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "несклоняемый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "385f0b94-97e3-3a31-8ef9-2e331070c614",
                                        "entry_id": "fcb942f9-3541-322c-830b-d1591d05374f",
                                        "glosses": [
                                            "лингв. не имеющий форм склонения, не изменяющийся по падежам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254edfa1-025e-44f0-ae63-16190f499e68",
                                                "sense_id": "385f0b94-97e3-3a31-8ef9-2e331070c614",
                                                "text": "[Е. А. Земская, жен, 74, 1926] [Смех] Но так как джакузи/ слово/ несклоняемое/ а она стремится выгнать из русского языка все несклоняемые слова/ она/ его именует кадкой."
                                            },
                                            {
                                                "example_id": "b94b302c-1983-482d-9c4c-a6bed9510362",
                                                "sense_id": "385f0b94-97e3-3a31-8ef9-2e331070c614",
                                                "text": "Почему же не склонять это слово [«пальто»], как склоняется, скажем, шило, коромысло, весло? Ведь оно принадлежит именно к этому ряду существительных среднего рода. Пуристы же хотят, чтобы оно оставалось в ряду таких несклоняемых слов, как домино, депо, трюмо, манто, метро, бюро и т. д. Между тем оно уже вырвалось из этого ряда, и нет никакого резона переносить его обратно в этот ряд. 〈…〉 Русский язык вообще тяготеет к склонению несклоняемых слов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c8d3fa3-6b6d-3e39-bb5d-b008fb676125",
                                        "entry_id": "fcb942f9-3541-322c-830b-d1591d05374f",
                                        "glosses": [
                                            "устар., поэт. то же, что непреклонный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e849e64-6715-4205-9ecd-57ca5a96bf74",
                                                "sense_id": "3c8d3fa3-6b6d-3e39-bb5d-b008fb676125",
                                                "text": "Была в ней нашей воли твёрдость, // Стремленье ввысь, в лазурь и свет, // И несклоняемая гордость — // Предвестье будущих побед."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
