                "senses": [
                    {
                        "sense_id": "685b3472-b3a3-36bf-9a0c-575a1505353d",
                        "entry_id": "5caf4c26-db5a-32ff-83d3-b7a602e14ae4",
                        "glosses": [
                            "A video camera whose output may be viewed in real time over a computer network, originally the World Wide Web."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906ba26f-2a3d-48ef-ad0a-adcfa6f3cd2d",
                                "sense_id": "685b3472-b3a3-36bf-9a0c-575a1505353d",
                                "text": "And while the Webcams focused on street scenes and other public gathering spots do seem to occupy an uncertain status as a new medium, they perhaps raise an ethical question: Is this the cinéma vérité of cyberspace or is it private surveillance?"
                            },
                            {
                                "example_id": "925278ba-d96d-471b-9036-b265a9afb702",
                                "sense_id": "685b3472-b3a3-36bf-9a0c-575a1505353d",
                                "text": "As Covid-19 lockdowns took effect around the world, millions turned to remote working and organising virtual hangouts with friends. Overnight, webcams went from mundane computer accessories to gold dust."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2282d97d-4e8b-4cbe-8cff-16563b5b3724",
