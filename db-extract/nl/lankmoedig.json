                "senses": [
                    {
                        "sense_id": "db8da584-97a9-3056-bea0-123e91428470",
                        "entry_id": "9b61df4c-a00d-3ef9-971c-078006e0a375",
                        "glosses": [
                            "blijk gevend van bereidheid om de voorkeur van anderen te volgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f10867cb-341f-45c2-8e05-3372ac46d3b6",
                                "sense_id": "db8da584-97a9-3056-bea0-123e91428470",
                                "text": "Zijn lankmoedige houding werd door profiteurs misbruikt."
                            },
                            {
                                "example_id": "8882ab5f-df47-4ee9-a0cc-3ee4637536a6",
                                "sense_id": "db8da584-97a9-3056-bea0-123e91428470",
                                "text": "Na decennia gesjacher door de staat, past voor een zo kleine groep resterende hoogbejaarde mensen een lankmoedig beleid."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c993019-0a7b-37c0-9ad2-53a02c1f1feb",
                        "entry_id": "9b61df4c-a00d-3ef9-971c-078006e0a375",
                        "glosses": [
                            "bereid te wachten en tegenslagen te verdragen, geduldig"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c7ce3940-e878-44e4-b85a-08c083f8eaae",
                                "sense_id": "4c993019-0a7b-37c0-9ad2-53a02c1f1feb",
                                "text": "Europese politici reageren lankmoedig op de escalerende gascrisis, alsof de gasmarkt nog normaal functioneert."
                            }
                        ]
                    }
                ],
                "translations": [
