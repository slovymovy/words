                "senses": [
                    {
                        "sense_id": "aee7752b-bb7f-36d4-9da8-8908802f4d7b",
                        "entry_id": "6295c8b1-6bcd-3ddb-9318-8a964c4854e5",
                        "glosses": [
                            "das Gasgemisch der frei beweglichen Atmosphäre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ed4db1-6289-4c23-bc05-439cd07d8e03",
                                "sense_id": "aee7752b-bb7f-36d4-9da8-8908802f4d7b",
                                "text": "„Mit der Bodenluft geht dauernd, zeitweise verstärkt durch Saugwirkung bei fallendem Luftdruck oder bei Wind, durch die sog. Bodenatmung auch Radon in die Freiluft über.“"
                            },
                            {
                                "example_id": "9befa15b-3fa3-46ba-8467-1b8129a7cdea",
                                "sense_id": "aee7752b-bb7f-36d4-9da8-8908802f4d7b",
                                "text": "„Die Differenz zwischen Wald- und Freiluft ist am Boden am stärksten, folglich ist es auch der untere Luftstrom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
