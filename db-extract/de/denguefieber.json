                "senses": [
                    {
                        "sense_id": "6b95a663-2707-33d9-99aa-ff6e390c33ff",
                        "entry_id": "c6e9108b-88cf-35ed-8356-d799f2d84b84",
                        "glosses": [
                            "ursprünglich in den Tropen vorkommende Viruserkrankung, die durch Mücken übertragen wird und zu deren Symptomen unter anderem eine erhöhte Körpertemperatur gehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf27058-a1aa-42b3-9bf5-9c894304b967",
                                "sense_id": "6b95a663-2707-33d9-99aa-ff6e390c33ff",
                                "text": "„Im Regenwald stiegen Moskitos, die Denguefieber, Gelbfieber, Chicungunyafieber und Malaria übertrugen, von der Abenddämmerung bis zur Morgenröte in dicken Wolken auf, so zahlreich wie die Sauerstoffatome in der Luft, durch die sie hindurchwirbelten – so fühlte es sich jedenfalls an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80a2e9c9-f626-4bf3-9315-d616c24dcb50",
                        "source_entry_id": "c6e9108b-88cf-35ed-8356-d799f2d84b84",
                        "source_sense_id": "6b95a663-2707-33d9-99aa-ff6e390c33ff",
                        "source_sense_description": "ursprünglich in den Tropen vorkommende Viruserkrankung, die durch Mücken übertragen wird",
                        "target_lang_word": "dengue fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dengue fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec56689-60f9-385a-aa42-3f316cad8dea",
                                        "entry_id": "b8dc6475-34e5-3ecb-95d8-ef4a9f6d271a",
                                        "glosses": [
                                            "An acute febrile and sometimes hemorrhagic disease endemic to the tropics, caused by varieties of the species Dengue virus, and primarily transmitted to humans from mosquitoes, though human-to-human transmission is also well documented."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93afdda4-7951-4b07-a10d-0b8f6d591897",
                        "source_entry_id": "c6e9108b-88cf-35ed-8356-d799f2d84b84",
                        "source_sense_id": "6b95a663-2707-33d9-99aa-ff6e390c33ff",
                        "source_sense_description": "ursprünglich in den Tropen vorkommende Viruserkrankung, die durch Mücken übertragen wird",
                        "target_lang_word": "dengue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dengue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cb4e64a-7010-3dae-bfb7-ffe38a3f13ae",
                                        "entry_id": "72fd190f-8134-3262-8be1-9336b3a6d89e",
                                        "glosses": [
                                            "Maladie virale endémique dans les pays tropicaux causée par les virus de type flavivirus."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbbeffbd-24f4-45f7-a2ae-43b29ec383b6",
                                                "sense_id": "3cb4e64a-7010-3dae-bfb7-ffe38a3f13ae",
                                                "text": "Je ne sais pas, mais je crois qu'il commence une crise de dengue, répliqua le jeune homme."
                                            },
                                            {
                                                "example_id": "545718fe-fea7-428f-ae8c-399442ead7ba",
                                                "sense_id": "3cb4e64a-7010-3dae-bfb7-ffe38a3f13ae",
                                                "text": "La dengue est une maladie endémique des zones tropicales qui provoque de fortes fièvres, des maux de tête, des nausées, des vomissements, des douleurs musculaires et, dans les cas les plus graves, des saignements pouvant entraîner la mort."
                                            },
                                            {
                                                "example_id": "39a062fe-65e3-4538-9b8f-c47cbdf55d11",
                                                "sense_id": "3cb4e64a-7010-3dae-bfb7-ffe38a3f13ae",
                                                "text": "– Papa m’a déshérité. Quand j’étais en Afrique, j’ai eu un moment de folie à cause de la fièvre dengue, et j’ai écrit au magazine des anciens de Harvard qui demandait des nouvelles des promotions passées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
