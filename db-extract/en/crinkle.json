                                                "sense_id": "1675d0aa-9fa0-3d59-8ee0-547b6588019f",
                                                "text": "Ich habe leider die Sender im Radio verstellt und jetzt rauscht es nur noch."
                                            },
                                            {
                                                "example_id": "bf62f16a-e36d-4bf0-b144-2adaee257fe1",
                                                "sense_id": "1675d0aa-9fa0-3d59-8ee0-547b6588019f",
                                                "text": "Kleiner Bach, du rauscht noch immer,",
                                                "translation": "aus meinem Kinderland."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7e8c39d-eaca-36b4-8f86-acf0ff6c367f",
                                        "entry_id": "0564d16d-dd12-3ec0-baf3-aabb525e05ca",
                                        "glosses": [
                                            "sich mit rauschendem Geräusch vorwärtsbewegen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35656717-7d1c-4d01-b43a-acdf8925467d",
                                                "sense_id": "b7e8c39d-eaca-36b4-8f86-acf0ff6c367f",
                                                "text": "Während das Wasser in die Wanne rauscht, freue ich mich bereits auf das Bad."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dec5cb38-f4e4-39c8-bd21-25675e99bb63",
