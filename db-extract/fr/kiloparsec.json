                "senses": [
                    {
                        "sense_id": "a272ea6b-7738-3fcb-addb-01b72143526f",
                        "entry_id": "25b786a7-eb4e-33eb-b948-adfd867becb9",
                        "glosses": [
                            "Unité de mesure de distance, de symbole kpc, équivalente à mille parsecs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8198561d-7ad0-4b23-b6c3-59fdf24f6dac",
                                "sense_id": "a272ea6b-7738-3fcb-addb-01b72143526f",
                                "text": "Les distances des autres objets célestes n’appartenant pas au système solaire sont bien plus grandes et se mesurent couramment en kiloparsecs."
                            },
                            {
                                "example_id": "265d20a5-f311-4b88-a452-9724865b8bf2",
                                "sense_id": "a272ea6b-7738-3fcb-addb-01b72143526f",
                                "text": "Pour les étoiles, et les galaxies, l’unité la plus utilisée est le parsec (pc) et ses multiples (kiloparsec et megaparsec)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aecedc97-1d8d-4d8f-8aaa-03c584ea44b5",
                        "source_entry_id": "25b786a7-eb4e-33eb-b948-adfd867becb9",
                        "source_sense_id": "a272ea6b-7738-3fcb-addb-01b72143526f",
                        "target_lang_word": "Kiloparsec",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiloparsec",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec75f6f1-6117-32b7-bf19-acc3a1d13e62",
                                        "entry_id": "3155b8d0-c040-32e5-b03a-212b2b6e2022",
                                        "glosses": [
                                            "Entfernung von Sternen im Ausmaß von tausend Parsec (entspricht etwa 3262 Lichtjahren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d18724d-b584-40e0-bcda-4bb71411da22",
                                                "sense_id": "ec75f6f1-6117-32b7-bf19-acc3a1d13e62",
                                                "text": "Die Weiten des Weltraums sprengen die irdischen Maße. Daher braucht es andere Maßeinheiten: Lichtjahre, Parsec und Kiloparsec geben neben der Astronomischen Einheit die Entfernungen an."
                                            },
                                            {
                                                "example_id": "2b3d3e51-f704-4854-8198-953981f4ebcc",
                                                "sense_id": "ec75f6f1-6117-32b7-bf19-acc3a1d13e62",
                                                "text": "Obwohl sie dreißig Kiloparsec Durchmesser aufweist und wir uns etwa zehn Kiloparsec vom Zentrum entfernt befinden, so sind nur sehr wenige der uns bekannten offenen Sternhaufen weiter als drei Kiloparsec von uns entfernt."
                                            },
                                            {
                                                "example_id": "4b554495-5d80-4f13-94c4-97984a5adc82",
                                                "sense_id": "ec75f6f1-6117-32b7-bf19-acc3a1d13e62",
                                                "text": "Observatorien mit Radioteleskopen haben gezeigt, daß in vielen Radiogalaxien die Emission über Gebiete vieler Hunderte von Kiloparsec verstreut ist."
                                            },
                                            {
                                                "example_id": "bcd0a428-75de-4fc2-a18e-61a6d7dc9cd7",
                                                "sense_id": "ec75f6f1-6117-32b7-bf19-acc3a1d13e62",
                                                "text": "Im galaktischen Zentrum, in 8 Kiloparsec Entfernung findet sich das nächste Supermassive Schwarze Loch."
                                            },
                                            {
                                                "example_id": "1da225d7-655e-40a3-a49d-50c7bf5886e1",
                                                "sense_id": "ec75f6f1-6117-32b7-bf19-acc3a1d13e62",
                                                "text": "Schon länger bekannt war der sogenannte Drei-Kiloparsec-Arm, eine Ansammlung von Wasserstoff-Gas, die von der Erde aus gesehen vor dem galaktischen Zentrum liegt, und zwar in einem Abstand von 10.000 Lichtjahren (das entspricht 3.000 Parsec)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
