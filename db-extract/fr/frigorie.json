                "senses": [
                    {
                        "sense_id": "d44a02aa-fd2a-3645-8eca-e3c09af105c2",
                        "entry_id": "0ae8998f-a178-3246-bb96-79c692778b58",
                        "glosses": [
                            "Unité de mesure équivalente à la calorie, autrefois utilisée pour mesurer une absorption de chaleur. Elle valait 4,185 x 10⁻³ Joules, son usage n'est plus autorisé."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2a09a314-b794-4c02-b636-5af0d91619de",
                                "sense_id": "d44a02aa-fd2a-3645-8eca-e3c09af105c2",
                                "text": "Ces deux éléments peuvent représenter 120 000 ou 130 000 kcal, le nombre de frigories nécessaires sera de l'ordre de 150 000. L'air devra passer un nombre suffisant de fois par heure pour absorber ces frigories."
                            },
                            {
                                "example_id": "a2985843-437d-4816-b4d2-2bbc99f3e5b1",
                                "sense_id": "d44a02aa-fd2a-3645-8eca-e3c09af105c2",
                                "text": "Une idée intéressante, qui pourrait améliorer très sensiblement le prix de revient total du transport, est celle de la récupération des frigories disponibles à la regazéification."
                            },
                            {
                                "example_id": "f5236d66-a223-43f3-b1f8-b7f4c74b66f2",
                                "sense_id": "d44a02aa-fd2a-3645-8eca-e3c09af105c2",
                                "text": "L'emploi de la frigorie devait cesser le 31 décembre 1977."
                            }
                        ]
                    }
                ],
