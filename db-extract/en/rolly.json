                        "examples": [
                            {
                                "example_id": "e2f2d53e-f910-4424-92d3-7329c3955fa4",
                                "sense_id": "e3a62947-d754-36c0-b011-37616cd97b76",
                                "text": "His rolly had gone out and he stuck his head down to light the doff off the gas and burnt his left eyebrow as the cooker had one of those rare spats,"
                            },
                            {
                                "example_id": "4472152e-cb09-4945-b000-b1710d5927f2",
                                "sense_id": "e3a62947-d754-36c0-b011-37616cd97b76",
                                "text": "He came and sat down and took a rolly from Julian.[…] ‘That way madness lies,’ said my father, flicking the end of the rolly into an empty mug."
                            }
                        ]
