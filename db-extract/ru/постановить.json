                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6634c38-862c-3691-9d2f-9450c1195788",
                        "entry_id": "847cbc19-bdaa-341e-9723-18222998cb1c",
                        "glosses": [
                            "принять решение о чём-нибудь, вынести резолюцию, решить"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5464e251-df6d-4be8-b380-32aac62d28cd",
                        "source_entry_id": "847cbc19-bdaa-341e-9723-18222998cb1c",
                        "source_sense_id": "f6634c38-862c-3691-9d2f-9450c1195788",
                        "target_lang_word": "décider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                        "entry_id": "45134c2a-2604-3028-a19a-167521515d15",
                                        "glosses": [
                                            "Résoudre après examen une chose douteuse et contestée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3951feb-e982-451a-8d55-5fe74fc2e0da",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Décider une affaire, une question, un point de droit."
                                            },
                                            {
                                                "example_id": "6821d530-e66b-46d6-aa76-ae0c06845589",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Il me semble que cela décide la question."
                                            },
                                            {
                                                "example_id": "a3204b2f-f1f4-4b06-aaa3-b43a41c7c496",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Le tribunal a décidé que la donation était nulle."
                                            },
                                            {
                                                "example_id": "2e868e5a-c32c-4d9d-88de-4235266cd24b",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Mon sort va bientôt se décider."
                                            },
                                            {
                                                "example_id": "09dc85de-758f-4d90-9d18-75a0b6cae993",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Une chose décidée."
                                            },
                                            {
                                                "example_id": "537e4be4-fccb-4d56-9d2b-e7cc9426603e",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Dans ces temps de barbarie, tout se décidait par la force."
                                            },
                                            {
                                                "example_id": "a3cb4a18-0ae2-4afb-8a6f-7e1c50b89e82",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "On n’a pas encore décidé, en Europe, si cette maladie est contagieuse ou non."
                                            },
                                            {
                                                "example_id": "7b4c5086-8f76-4fe6-9cd5-27d9ea79dc46",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "C’est un homme qui aime à décider, qui décide trop hardiment."
                                            },
                                            {
                                                "example_id": "b96ad21a-62f3-4f65-bd24-fa5c8d7de153",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Décider de tout, sur tout à tort et à travers."
                                            },
                                            {
                                                "example_id": "3e9473b2-df3c-433c-921e-06f832294dca",
                                                "sense_id": "1fb0164e-3681-3f78-9ca2-f0d8ad6c39b7",
                                                "text": "Décider en faveur de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa7d462-1587-30be-b41a-f8dc8dbe6775",
                                        "entry_id": "45134c2a-2604-3028-a19a-167521515d15",
                                        "glosses": [
                                            "Arrêter ou déterminer ce qu’on doit faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb30de3-18c8-4444-80a5-b00c0d53a59e",
                                                "sense_id": "1fa7d462-1587-30be-b41a-f8dc8dbe6775",
                                                "text": "Alors, qu'attendez-vous pour fixer la date de notre mariage ? Si vous continuez à la renvoyer aux calendes grecques, autant vaudrait décider qu'il ne se fera jamais."
                                            },
                                            {
                                                "example_id": "ae962028-8fc7-48fd-b9ec-b882057f0766",
                                                "sense_id": "1fa7d462-1587-30be-b41a-f8dc8dbe6775",
                                                "text": "Et à deux lieues, dans les hangars de la douane de Mazagan, les matériaux d’un pont en fer, dont la construction avait été décidée il y a une cinquantaine d'années par Sidi Mohammed, s’oxydent et s’écaillent."
                                            },
                                            {
                                                "example_id": "ffa19356-5ec3-47ff-87b8-0524f7a142c5",
                                                "sense_id": "1fa7d462-1587-30be-b41a-f8dc8dbe6775",
                                                "text": "Il est très rare, sauf peut-être dans les bas fonds, que ce soit le poing qui décide."
                                            },
                                            {
                                                "example_id": "472ee320-d800-404d-a1eb-380b86349e22",
                                                "sense_id": "1fa7d462-1587-30be-b41a-f8dc8dbe6775",
                                                "text": "La commission de permanence s’émut : elle décida de mander le ministre de la Guerre, le général d’HAUTPOUL qui minimisa l’affaire mais fit porter le chapeau si l'on peut dire au général CHANGARNlER qui de ce fait rompit toute relation avec le président, le 7 octobre 1850."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c32af687-5c6b-33fa-b5ce-f991633b03b6",
                                        "entry_id": "45134c2a-2604-3028-a19a-167521515d15",
                                        "glosses": [
                                            "Amener à une conclusion définitive ; rendre inévitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a90bd97d-4f06-4eff-a3a0-6b7c11e408c1",
                                                "sense_id": "c32af687-5c6b-33fa-b5ce-f991633b03b6",
                                                "text": "Le temps où l’infanterie décidait des batailles était révolu. La guerre se transformait en une question de matériel, d’entraînement et de connaissances spéciales très compliquées. Elle avait cessé d’être démocratique."
                                            },
                                            {
                                                "example_id": "cf3964f5-408b-4204-be23-10e18eebf5b4",
                                                "sense_id": "c32af687-5c6b-33fa-b5ce-f991633b03b6",
                                                "text": "Lorsque la bourgeoisie embryonnaire eut à affronter le Pérou et la Bolivie, en 1879, pour décider de la propriété des mines de nitrate (monopole naturel sur l’une des plus grandes richesses de l’époque), elle se heurta pourtant aux États-Unis."
                                            },
                                            {
                                                "example_id": "2f5d487d-8a84-40d2-b56e-846c9424529b",
                                                "sense_id": "c32af687-5c6b-33fa-b5ce-f991633b03b6",
                                                "text": "Le chevalier avait quitté brusquement la lice quand la victoire fut décidée, […]."
                                            },
                                            {
                                                "example_id": "6d5b0d75-c4dd-476f-ae16-079d32525c4f",
                                                "sense_id": "c32af687-5c6b-33fa-b5ce-f991633b03b6",
                                                "text": "Ils arrivèrent à la grotte, tout le monde se les gelait sérieusement. Ils décidèrent de faire un feu pour la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                        "entry_id": "45134c2a-2604-3028-a19a-167521515d15",
                                        "glosses": [
                                            "Déterminer quelqu’un à faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3054bcb8-6f7b-4a23-b18e-d5091d5583e5",
                                                "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                                "text": "Cette raison m’a décidé à partir."
                                            },
                                            {
                                                "example_id": "b5b4b5b9-f294-4c73-b482-56935c356fff",
                                                "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                                "text": "C’est lui qui m’a décidé à vous écrire."
                                            },
                                            {
                                                "example_id": "6fe900cc-e82e-4840-a53c-f8090b55d46b",
                                                "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                                "text": "Je suis décidé à tout entreprendre."
                                            },
                                            {
                                                "example_id": "4bcf28d5-ebb8-42d3-bc4f-ec7c6917b980",
                                                "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                                "text": "Allons, décidez-vous."
                                            },
                                            {
                                                "example_id": "56e4a168-75c7-46d7-90e9-a3a853ef38db",
                                                "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                                "text": "Il est bien lent à se décider."
                                            },
                                            {
                                                "example_id": "36dc8be3-1f22-485b-8ac7-ce9d6bd8bee1",
                                                "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                                                "text": "Il s’est décidé trop légèrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b0a3efb-872a-3c4a-be95-585b869535e8",
                                        "entry_id": "45134c2a-2604-3028-a19a-167521515d15",
                                        "glosses": [
                                            "Se prononcer, se déclarer pour quelque chose, pour quelqu’un, lui donner la préférence."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f471cf-c15b-40b0-9905-11378b54faa8",
                                                "sense_id": "5b0a3efb-872a-3c4a-be95-585b869535e8",
                                                "text": "Nous nous décidâmes pour ce parti."
                                            },
                                            {
                                                "example_id": "0934b108-0a43-418a-802c-726e76ef6dcd",
                                                "sense_id": "5b0a3efb-872a-3c4a-be95-585b869535e8",
                                                "text": "La victoire se décida pour eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dbab1f5-a583-4a98-a0b6-21d028e54950",
                        "source_entry_id": "847cbc19-bdaa-341e-9723-18222998cb1c",
                        "source_sense_id": "f6634c38-862c-3691-9d2f-9450c1195788",
                        "target_lang_word": "décréter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décréter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5cfa24d2-2206-35bb-913e-54422dce8bb9",
                                        "entry_id": "6168ac75-d54c-38ee-882b-65c08420a668",
                                        "glosses": [
                                            "Ordonner, régler par un décret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9336d0b4-674d-46ad-ba6a-c1d92ab138d7",
                                                "sense_id": "5cfa24d2-2206-35bb-913e-54422dce8bb9",
                                                "text": "La Commune décréta le 29 mars l'abolition de la conscription et l'enrôlement dans la garde nationale de tous les citoyens valides ; […]."
                                            },
                                            {
                                                "example_id": "ad93320d-552d-482b-96c0-8ce47d378a42",
                                                "sense_id": "5cfa24d2-2206-35bb-913e-54422dce8bb9",
                                                "text": "Décréter une levée en masse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f0e06e-d84a-3dcf-8c9b-1df460b09d9e",
                                        "entry_id": "6168ac75-d54c-38ee-882b-65c08420a668",
                                        "glosses": [
                                            "Lancer un décret contre quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deb594d0-e326-4fca-8d1c-d7a2f6a63fce",
                                                "sense_id": "f2f0e06e-d84a-3dcf-8c9b-1df460b09d9e",
                                                "text": "Et pourtant le ministre des affaires étrangères Le Brun, décrété d'arrestation au 2 juin, était alors prisonnier chez lui sous la garde d'un gendarme !"
                                            },
                                            {
                                                "example_id": "9b5fe46a-93b4-41c7-894e-9d0be742fee9",
                                                "sense_id": "f2f0e06e-d84a-3dcf-8c9b-1df460b09d9e",
                                                "text": "Les proscrits avaient le droit d'emporter leurs biens meubles. Mais leurs biens de mainmorte (immeubles, champs, vignobles, caves greniers) furent décrétés propriété royale et confisqués."
                                            },
                                            {
                                                "example_id": "e6fb58f6-759c-4200-bda9-199182b75a38",
                                                "sense_id": "f2f0e06e-d84a-3dcf-8c9b-1df460b09d9e",
                                                "text": "Décréter contre quelqu’un."
                                            },
                                            {
                                                "example_id": "4a7221e9-7696-4d01-b661-3c1ac4aeedae",
                                                "sense_id": "f2f0e06e-d84a-3dcf-8c9b-1df460b09d9e",
                                                "text": "Décréter une terre, une maison afin qu’elle soit vendue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5aa701-cfdd-3c6a-8a01-aaa7817147ff",
                                        "entry_id": "6168ac75-d54c-38ee-882b-65c08420a668",
                                        "glosses": [
                                            "Décider souverainement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b01f376e-eb6e-4ced-8e07-d9e896d221e6",
                                                "sense_id": "8c5aa701-cfdd-3c6a-8a01-aaa7817147ff",
                                                "text": "Et pourtant, par une belle journée d’été, Salbec se réveilla.\nQuelques habitants grouillèrent, se réunirent dans les cafés, nommèrent des présidents d’honneur et décrétèrent qu’il fallait faire quelque chose.\nQuelque chose ! Oui, mais quoi ?"
                                            },
                                            {
                                                "example_id": "b6be251b-5460-49ea-8c3d-5931fb33560e",
                                                "sense_id": "8c5aa701-cfdd-3c6a-8a01-aaa7817147ff",
                                                "text": "Le dernier jour des terriens était arrivé et Arcvad le puissant avait décrété leur mort pour minuit, heure de Mars, — 11 heures du matin à New-York."
                                            },
                                            {
                                                "example_id": "50777c78-a521-49e1-8132-052ad52e6b29",
                                                "sense_id": "8c5aa701-cfdd-3c6a-8a01-aaa7817147ff",
                                                "text": "Les gentils cons qui décrétaient le Bien et le Mal comprenaient qu'un garnement tirât les cheveux d'une fillette, pas qu'il lui roulât un patin ! Sœur Marie me le fit bien savoir ! Purification de ma bouche vilaine par la cascade d’ave au pied de saint Joseph."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8fff135-6571-4e7e-8226-892f135a2fe6",
                        "source_entry_id": "847cbc19-bdaa-341e-9723-18222998cb1c",
                        "source_sense_id": "f6634c38-862c-3691-9d2f-9450c1195788",
                        "target_lang_word": "statuer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "858b7d4a-e172-3abc-bd41-08003b2e0f34",
                                        "entry_id": "f80b8657-4dd6-331b-9a4d-c2393db1bd0a",
                                        "glosses": [
                                            "Décider ; régler ; établir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e7fc6c3-bdf2-46bf-9732-37ece07dbc83",
                                                "sense_id": "858b7d4a-e172-3abc-bd41-08003b2e0f34",
                                                "text": "C'est sur quoi on ne peut rien statuer parfaitement, quoiqu'on sache, en général, que la térébenthine et le soufre sont antipathiques aux insectes : cependant l'expérience contre les ravets doit faire croire avec fondement que le ricin y a la meilleure part."
                                            },
                                            {
                                                "example_id": "d98c2d0c-b399-465e-9a6c-0833a62f575b",
                                                "sense_id": "858b7d4a-e172-3abc-bd41-08003b2e0f34",
                                                "text": "En lecture définitive à l’Assemblée nationale, aucun amendement nouveau n’est recevable, y compris de la part du Gouvernement. L’Assemblée nationale statue soit sur le texte établi par la commission mixte paritaire, s’il y en a un, soit sur le texte qu’elle a adopté en nouvelle lecture."
                                            },
                                            {
                                                "example_id": "72f0b10c-909a-447b-b180-207c35a8c665",
                                                "sense_id": "858b7d4a-e172-3abc-bd41-08003b2e0f34",
                                                "text": "Il faut voir ce que la loi statue sur ce point."
                                            },
                                            {
                                                "example_id": "36bba716-b4ae-491c-beac-10ca143a0e8e",
                                                "sense_id": "858b7d4a-e172-3abc-bd41-08003b2e0f34",
                                                "text": "Le juge n’a rien statué sur ce chef, sur cette requête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
