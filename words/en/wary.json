{
    "word_family": [
        "wariness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0612c33b-a19d-319d-8507-b600c52f2ba2",
                    "sense_definition": "Cautious of danger; carefully watching and guarding against deception, trickery, and dangers; suspiciously prudent",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiker was <w>wary</w> of the steep path ahead.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者对前方陡峭的小路保持<w>警惕</w>。"
                            }
                        },
                        {
                            "text": "Investors remain <w>wary</w> of the current market volatility.",
                            "target_lang_translations": {
                                "zh": "投资者对当前的市场波动依然保持<w>谨慎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circumspect",
                        "scrupulous",
                        "careful",
                        "cautious",
                        "guarded",
                        "chary"
                    ],
                    "common_phrases": [
                        "wary of strangers",
                        "remain wary"
                    ],
                    "target_lang_definitions": {
                        "zh": "对危险保持警惕；小心提防欺骗、诡计和危险；疑虑而审慎的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "警惕",
                                "target_lang_sense_clarification": "对可能出现的危险或错误保持戒备"
                            },
                            {
                                "target_lang_word": "谨慎",
                                "target_lang_sense_clarification": "做事小心，防备周全"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ede3543-06e6-372e-86d2-55c0f321ea81",
                    "sense_definition": "Characterized by caution; guarded; careful; on one's guard",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>wary</w> glance at the dark alleyway.",
                            "target_lang_translations": {
                                "zh": "她<w>戒备</w>地看了一眼那条黑暗的小巷。"
                            }
                        },
                        {
                            "text": "He maintained a <w>wary</w> attitude during the negotiations.",
                            "target_lang_translations": {
                                "zh": "他在谈判期间一直保持着<w>谨慎</w>的态度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cautious",
                        "guarded",
                        "careful"
                    ],
                    "common_phrases": [
                        "wary eye"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出谨慎的；防备的；小心的；处于戒备状态的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "戒备",
                                "target_lang_sense_clarification": "防备，警惕"
                            },
                            {
                                "target_lang_word": "小心",
                                "target_lang_sense_clarification": "言行谨慎，防止出错"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ec801e6-d457-3da4-8c2e-2398ca15567e",
                    "sense_definition": "Thrifty or provident in the management of resources",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wary</w> farmer saved his grain for the harsh winter months.",
                            "target_lang_translations": {
                                "zh": "那位<w>节俭</w>的农夫把粮食留到了严冬。"
                            }
                        },
                        {
                            "text": "Being <w>wary</w> with money helped them survive the economic downturn.",
                            "target_lang_translations": {
                                "zh": "在金钱上<w>精打细算</w>帮助他们度过了经济低迷期。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic or dialectal in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在资源管理上节俭或有远见的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "节俭",
                                "target_lang_sense_clarification": "用钱财等有节制，不浪费"
                            },
                            {
                                "target_lang_word": "精打细算",
                                "target_lang_sense_clarification": "在使用财物上仔细计算"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "248b0597-e66b-3d1c-b99d-2b27c2d081a5",
                    "sense_definition": "To curse or revile someone or something",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man would <w>wary</w> his enemies whenever they passed by.",
                            "target_lang_translations": {
                                "zh": "每当敌人们经过时，那位老人就会<w>诅咒</w>他们。"
                            }
                        },
                        {
                            "text": "It is not right to <w>wary</w> those who have done you no harm.",
                            "target_lang_translations": {
                                "zh": "去<w>谩骂</w>那些没有伤害过你的人是不对的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is obsolete in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "诅咒或辱骂某人或某事"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "诅咒",
                                "target_lang_sense_clarification": "祈求鬼神降祸于人"
                            },
                            {
                                "target_lang_word": "谩骂",
                                "target_lang_sense_clarification": "用恶毒的话侮辱人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}