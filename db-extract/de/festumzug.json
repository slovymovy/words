                "senses": [
                    {
                        "sense_id": "638b391e-757d-39a3-a14f-93b5b4b653aa",
                        "entry_id": "1eb5ce8f-bb62-3235-a026-611a962dcc13",
                        "glosses": [
                            "der Umzug durch eine Stadt oder eine Gemeinde anlässlich eines großen Festes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed6374ae-4df4-4397-a8a6-e1b4b545c548",
                                "sense_id": "638b391e-757d-39a3-a14f-93b5b4b653aa",
                                "text": "Dieses Jahr ist der Festumzug besonders schön."
                            },
                            {
                                "example_id": "c51eb668-de95-4ec0-b609-0737844608fd",
                                "sense_id": "638b391e-757d-39a3-a14f-93b5b4b653aa",
                                "text": "„Weil mehrere Militärkapellen aufspielten, glich der Marsch durch Kowno einem Festumzug.“"
                            },
                            {
                                "example_id": "ca5ee6b4-4349-4e1c-84a5-d83a57d88167",
                                "sense_id": "638b391e-757d-39a3-a14f-93b5b4b653aa",
                                "text": "„Auf den Feldgottesdienst folgte der große Festumzug mit der Vereinsfahne als wichtigstem Vorzeigesymbol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
