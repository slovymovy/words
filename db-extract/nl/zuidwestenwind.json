                        "glosses": [
                            "wind die uit het zuiden en het westen komt, de meest voorkomende wind in Nederland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560ead9d-696d-4049-b57e-34b6a4a40be4",
                                "sense_id": "6d015823-2d12-3ef1-b1ec-e5827106a77c",
                                "text": "Er waait een matige tot harde zuidwestenwind. Met name in de open gebieden waait het fors."
                            },
                            {
                                "example_id": "402ff2a8-6ffd-4ecd-89ac-e79d70620f78",
                                "sense_id": "6d015823-2d12-3ef1-b1ec-e5827106a77c",
                                "text": "Oudjaarsdag lijkt te beginnen met wat bewolking en hier en daar wat regen, maar de dag zal waarschijnlijk droog eindigen. Omdat er een zwakke tot matige zuidwestenwind waait, is het naar alle waarschijnlijkheid overdag zacht met maxima rond 8 graden."
                            }
                        ]
                    }
