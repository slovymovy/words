                ],
                "senses": [
                    {
                        "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                        "entry_id": "77a6f30c-46b6-3c69-94d5-f71486af4a96",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b830312-ffbe-4cc2-a06a-0291a5e0f9aa",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Ottles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5ba494b0-365d-43dd-ba16-e80687415297",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Ottle kommt und geht."
                            },
                            {
                                "example_id": "b4a5c624-94b4-400e-a1a9-9e69e5725080",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Frau Ottle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "90c62feb-f615-4d7a-bc26-f82b0d918e71",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Herr Ottle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8ec3f730-41af-4b1a-8228-e197cd49060a",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Die Ottles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "adc55d41-bf8d-4249-b5db-03a5423599a5",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Der Ottle trägt nie die Schals, die die Ottle ihm strickt."
                            },
                            {
                                "example_id": "e224b33b-1ab1-40f8-987d-0cce92c4adc5",
                                "sense_id": "9173e160-33be-364e-a51c-484bd203305e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ottle kommt, geht der Herr Ottle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
