{
    "word_family": [
        "erroneous",
        "error",
        "err"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95778472-4f5d-31e1-9e4d-8154796cb392",
                    "sense_definition": "An error, especially one in a printed work.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author included an <w>erratum</w> at the end of the book to fix the typo.",
                            "target_lang_translations": {
                                "zh": "作者在书末附了一份<w>勘误表</w>以修正排版错误。"
                            }
                        },
                        {
                            "text": "Please check the <w>erratum</w> page for corrections to the original text.",
                            "target_lang_translations": {
                                "zh": "请查看<w>勘误</w>页面以获取对原文的修正。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指印刷品中的错误，尤指排版错误。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勘误",
                                "target_lang_sense_clarification": "指对印刷品中错误的更正。"
                            },
                            {
                                "target_lang_word": "印刷错误",
                                "target_lang_sense_clarification": "指书刊或文档中出现的排版或拼写错误。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa1e339-0d3c-3b71-ae48-35c3dadb5c14",
                    "sense_definition": "A published notice reporting an error belatedly discovered in a previous publication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The academic journal published an <w>erratum</w> to address the data discrepancy.",
                            "target_lang_translations": {
                                "zh": "该学术期刊发布了一份<w>更正启事</w>以说明数据差异。"
                            }
                        },
                        {
                            "text": "Editors issued an <w>erratum</w> after discovering the mistake in the article.",
                            "target_lang_translations": {
                                "zh": "编辑在发现文章中的错误后发布了<w>勘误表</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corrigendum"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在出版物发布后，针对之前发现的错误而专门刊登的更正说明。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勘误表",
                                "target_lang_sense_clarification": "指附在书刊末尾或单独发布的错误更正清单。"
                            },
                            {
                                "target_lang_word": "更正启事",
                                "target_lang_sense_clarification": "指正式发布的关于纠正先前出版物错误的声明。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}