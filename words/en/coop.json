{
    "word_family": [
        "cooper",
        "cooperage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5773cd4a-6cb4-30d7-bc90-7cac995fe3f7",
                    "sense_definition": "A cage, pen, or enclosed structure used for housing poultry or small animals.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every evening the farmer shuts the hens inside the chicken <w>coop</w>.",
                            "target_lang_translations": {
                                "zh": "每天傍晚，农夫都会把母鸡关进鸡<w>舍</w>里。"
                            }
                        },
                        {
                            "text": "They built a spacious wire <w>coop</w> in the garden for their pet rabbits.",
                            "target_lang_translations": {
                                "zh": "他们在花园里为宠物兔搭了一个宽敞的铁丝<w>笼子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cage",
                        "pen"
                    ],
                    "common_phrases": [
                        "chicken coop"
                    ],
                    "target_lang_definitions": {
                        "zh": "关家禽或小动物的笼子、鸡舍或棚圈"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸡舍",
                                "target_lang_sense_clarification": "家禽棚圈"
                            },
                            {
                                "target_lang_word": "笼子",
                                "target_lang_sense_clarification": "饲养小动物的网笼"
                            },
                            {
                                "target_lang_word": "禽笼",
                                "target_lang_sense_clarification": "关禽类的笼圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e403bf-3503-3c94-8405-f2e4b377a132",
                    "sense_definition": "Alternative spelling of <w>co-op</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She buys all her fresh organic vegetables from the local food <w>coop</w>.",
                            "target_lang_translations": {
                                "zh": "她所有的有机新鲜蔬菜都购自当地的食品<w>合作社</w>。"
                            }
                        },
                        {
                            "text": "They decided to purchase an apartment in a cooperative housing <w>coop</w>.",
                            "target_lang_translations": {
                                "zh": "他们决定在一个集资建房的<w>合作公寓</w>里买下一套单元。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cooperative"
                    ],
                    "common_phrases": [
                        "food coop",
                        "housing coop"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "variant of co-op"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "co-op（合作社、合作公寓）的变体拼写"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合作社",
                                "target_lang_sense_clarification": "合作经营组织"
                            },
                            {
                                "target_lang_word": "合作公寓",
                                "target_lang_sense_clarification": "共同产权公寓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a5cf086-07c9-3dff-957a-4af2d7cae52b",
                    "sense_definition": "A jail, prison, or cramped place of confinement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal spent three weeks locked inside the local <w>coop</w>.",
                            "target_lang_translations": {
                                "zh": "那名罪犯在当地的<w>班房</w>里被关了三个星期。"
                            }
                        },
                        {
                            "text": "He hated staying inside that tiny office that felt just like a <w>coop</w>.",
                            "target_lang_translations": {
                                "zh": "他讨厌呆在那间狭小的办公室里，感觉就像呆在<w>牢笼</w>一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jail",
                        "prison"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or slang for prison"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "监狱、看守所或狭窄幽闭的处所（俚语）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "班房",
                                "target_lang_sense_clarification": "监狱、牢房（口语/俚语）"
                            },
                            {
                                "target_lang_word": "牢房",
                                "target_lang_sense_clarification": "监牢"
                            },
                            {
                                "target_lang_word": "狭窄处所",
                                "target_lang_sense_clarification": "窄小的逼仄空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9712af4c-e50a-3a68-bfbc-2291ef572f1f",
                    "sense_definition": "An equestrian jumping obstacle shaped like an A-frame.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse cleared the wooden <w>coop</w> effortlessly during the jumping competition.",
                            "target_lang_translations": {
                                "zh": "在障碍跳跃比赛中，那匹马轻松跃过了木质<w>人字形障碍</w>。"
                            }
                        },
                        {
                            "text": "Riders must approach the <w>coop</w> at a controlled canter to clear it cleanly.",
                            "target_lang_translations": {
                                "zh": "骑手必须以受控的慢跑接近<w>障碍架</w>，才能干净利落地越过。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "马术比赛中的人字形木质障碍物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "人字形障碍",
                                "target_lang_sense_clarification": "马术障碍架"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39396b04-cb6a-36ea-b2b5-adb41b4a52b3",
                    "sense_definition": "A wicker basket or enclosed trap used for catching fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river was filled with traditional wooden traps including a salmon <w>coop</w>.",
                            "target_lang_translations": {
                                "zh": "这条河里布满了传统木质陷阱，其中包括用来捕捞鲑鱼的<w>鱼篓</w>。"
                            }
                        },
                        {
                            "text": "Fishermen constructed a large wicker <w>coop</w> to catch migrating fish.",
                            "target_lang_translations": {
                                "zh": "渔民们编织了一个巨大的柳条<w>捕鱼笼</w>来捕捉洄游鱼类。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in specific fishing regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于捕鱼的柳条筐或鱼篓"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鱼篓",
                                "target_lang_sense_clarification": "柳条编成的捕鱼陷阱"
                            },
                            {
                                "target_lang_word": "捕鱼笼",
                                "target_lang_sense_clarification": "捕鱼装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a162e15-8038-3844-8d17-d5d9f7a2cfec",
                    "sense_definition": "A small heap or mound, especially of dung or muck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener placed a fresh <w>coop</w> of manure over the vegetable patch.",
                            "target_lang_translations": {
                                "zh": "园丁在菜畦上覆上了一小<w>堆</w>新鲜的粪肥。"
                            }
                        },
                        {
                            "text": "Several sheep were grazing peacefully near a damp <w>coop</w> of compost.",
                            "target_lang_translations": {
                                "zh": "几只绵羊在潮湿的堆肥<w>堆</w>旁安静地吃草。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heap",
                        "mound"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指粪肥等的）小堆（苏格兰方言）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小堆",
                                "target_lang_sense_clarification": "堆积物，如粪堆"
                            },
                            {
                                "target_lang_word": "粪堆",
                                "target_lang_sense_clarification": "堆积的肥料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4924d68a-1ecd-376e-8652-5007adda6b60",
                    "sense_definition": "A cart with close-boarded sides used for hauling manure and other farm materials.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The draft horse pulled a loaded <w>coop</w> down the muddy track.",
                            "target_lang_translations": {
                                "zh": "挽马沿着泥泞的小道拉着满载的<w>板车</w>前行。"
                            }
                        },
                        {
                            "text": "Workers tipped the wooden <w>coop</w> to empty out the remaining fertilizer.",
                            "target_lang_translations": {
                                "zh": "工人们倾斜木制<w>运料车</w>，倒出了剩下的肥料。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional Scottish or historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "运送粪肥等农用物资的密闭板侧双轮车"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "板侧手推车",
                                "target_lang_sense_clarification": "密闭挡板运料车"
                            },
                            {
                                "target_lang_word": "运料车",
                                "target_lang_sense_clarification": "农用板车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df64d487-a352-3615-8fe9-1966f83c4cf6",
                    "sense_definition": "A cart that tilts or opens at the back to unload; a tumbril.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He unloaded gravel from the hinged <w>coop</w> without unhitching the horse.",
                            "target_lang_translations": {
                                "zh": "他无需解开马匹便从带铰链的<w>翻斗车</w>上卸下了碎石。"
                            }
                        },
                        {
                            "text": "The old <w>coop</w> could discharge its entire cargo in just a few minutes.",
                            "target_lang_translations": {
                                "zh": "那辆老式<w>倾卸车</w>仅需几分钟就能卸空全部货物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tumbril"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "可倾斜或从后方打开卸料的双轮翻斗车"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻斗车",
                                "target_lang_sense_clarification": "可倾卸的双轮车"
                            },
                            {
                                "target_lang_word": "倾卸车",
                                "target_lang_sense_clarification": "后方卸料的货车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d611ff66-5312-397a-ab5e-31fed20d9c79",
                    "sense_definition": "A barrel or cask for containing liquids.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cellar stored wine in an ancient wooden <w>coop</w> bound with iron.",
                            "target_lang_translations": {
                                "zh": "地窖里用箍着铁皮的古老木<w>桶</w>储藏葡萄酒。"
                            }
                        },
                        {
                            "text": "Water was kept in a sealed <w>coop</w> aboard the ship for long voyages.",
                            "target_lang_translations": {
                                "zh": "船上的饮用水装在密封的大木<w>桶</w>中，供长途航行使用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "barrel",
                        "cask"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "盛装液体的木桶或酒桶（古英语）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "木桶",
                                "target_lang_sense_clarification": "盛液体的桶"
                            },
                            {
                                "target_lang_word": "酒桶",
                                "target_lang_sense_clarification": "装酒的容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f10602-5efa-3ae5-b076-0f5031d80125",
                    "sense_definition": "Cross-origin opener policy, a web security mechanism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer configured <w>COOP</w> headers to safeguard user credentials on the site.",
                            "target_lang_translations": {
                                "zh": "开发者配置了<w>跨源开放者策略</w>响应头，以保护网站上的用户凭证。"
                            }
                        },
                        {
                            "text": "Implementing strict <w>COOP</w> prevents malicious scripts from accessing browsing contexts.",
                            "target_lang_translations": {
                                "zh": "实施严格的<w>跨源开放者策略</w>可防止恶意脚本访问浏览上下文。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "跨源开放者策略（一种网页安全机制）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跨源开放者策略",
                                "target_lang_sense_clarification": "Web安全机制（COOP）"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37fc9f26-1d27-34be-a32d-c59ce6d4ea4d",
                    "sense_definition": "To confine or restrict someone or something within a narrow space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bad weather had to <w>coop</w> the restless children up indoors all day.",
                            "target_lang_translations": {
                                "zh": "恶劣的天气不得不把好动的孩子们整天<w>关在</w>室内。"
                            }
                        },
                        {
                            "text": "I refuse to <w>coop</w> myself up in an office throughout the lovely weekend.",
                            "target_lang_translations": {
                                "zh": "我才不愿在这美好的周末里把自己<w>关在</w>办公室里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confine",
                        "cage"
                    ],
                    "antonyms": [
                        "free",
                        "release"
                    ],
                    "common_phrases": [
                        "coop up"
                    ],
                    "target_lang_definitions": {
                        "zh": "将（人或动物）禁锢或关在狭小的空间内"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "关在",
                                "target_lang_sense_clarification": "幽禁、限制活动空间"
                            },
                            {
                                "target_lang_word": "禁锢",
                                "target_lang_sense_clarification": "限制在狭小场所"
                            },
                            {
                                "target_lang_word": "困在",
                                "target_lang_sense_clarification": "拘束在有限空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b15557-fa80-30af-8fce-789d86c9565d",
                    "sense_definition": "To keep or shut poultry or small animals in a coop.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "confine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder decided to <w>coop</w> the hen until her chicks grew stronger.",
                            "target_lang_translations": {
                                "zh": "饲养员决定先将母鸡<w>关在笼里</w>，直到雏鸡长得更强壮一些。"
                            }
                        },
                        {
                            "text": "Farmers often <w>coop</w> sick birds to prevent diseases from spreading quickly.",
                            "target_lang_translations": {
                                "zh": "农户通常会把生病的禽鸟<w>圈禁隔离</w>，以防止疾病迅速蔓延。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cage",
                        "pen"
                    ],
                    "target_lang_definitions": {
                        "zh": "把家禽或小动物关进笼子或棚圈中"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "关进笼子",
                                "target_lang_sense_clarification": "圈养、关入禽舍"
                            },
                            {
                                "target_lang_word": "圈养",
                                "target_lang_sense_clarification": "关在圈里饲养"
                            },
                            {
                                "target_lang_word": "关在鸡舍",
                                "target_lang_sense_clarification": "关入禽圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3327d063-e9df-3b0d-8f1b-0be5b48960b9",
                    "sense_definition": "Of a police officer: to sleep, loaf, or rest while on duty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patrolmen preferred to <w>coop</w> in an empty parking lot overnight.",
                            "target_lang_translations": {
                                "zh": "巡警们更喜欢整夜躲在空旷的停车场里<w>偷懒睡觉</w>。"
                            }
                        },
                        {
                            "text": "He got caught trying to <w>coop</w> inside his squad car during patrol.",
                            "target_lang_translations": {
                                "zh": "他在巡逻期间试图躲在巡逻车里<w>打瞌睡</w>，结果被抓了个正着。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "police slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（警察）执勤时睡觉、偷懒或歇息（俚语）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偷懒睡觉",
                                "target_lang_sense_clarification": "警察执勤时摸鱼打盹"
                            },
                            {
                                "target_lang_word": "打瞌睡",
                                "target_lang_sense_clarification": "当班期间睡觉休息"
                            },
                            {
                                "target_lang_word": "摸鱼",
                                "target_lang_sense_clarification": "值勤偷懒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da7a499-15c2-3aae-b0d1-f6013bc5930d",
                    "sense_definition": "To unlawfully confine voters so as to prevent them from casting ballots in an election.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Corrupt politicians arranged to <w>coop</w> opposing voters until polls closed.",
                            "target_lang_translations": {
                                "zh": "腐败政客安排手下<w>非法拘禁</w>反对派选民，直到投票结束。"
                            }
                        },
                        {
                            "text": "Nineteenth-century gangs would often <w>coop</w> citizens and ply them with liquor.",
                            "target_lang_translations": {
                                "zh": "十九世纪的帮派经常会<w>软禁</w>市民并灌他们烈酒以操纵选举。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical electoral fraud"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "非法拘禁选民以阻止其在选举中投票（历史俚语）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "非法拘禁选民",
                                "target_lang_sense_clarification": "选举舞弊中拘禁投票者"
