        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                    "sense_definition": "One who has won or often wins.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>winner</w> of the race received a gold medal.",
                            "target_lang_translations": {
                                "ru": "<w>Победитель</w> гонки получил золотую медаль.",
                                "fr": "Le <w>gagnant</w> de la course a reçu une médaille d'or."
                            }
                        },
                        {
                            "text": "She is a born <w>winner</w> who works hard to succeed.",
                            "target_lang_translations": {
                                "ru": "Она прирождённый <w>победитель</w>, который усердно работает, чтобы добиться успеха.",
                                "fr": "C'est une <w>gagnante</w> née qui travaille dur pour réussir."
                            }
                        }
                    ],
                    "synonyms": [
                        "victor",
                        "champion"
                    ],
                    "antonyms": [
                        "loser"
                    ],
                    "common_phrases": [
                        "prize winner",
                        "lucky winner",
                        "clear winner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто одержал победу в соревновании, игре или конкурсе.",
                        "fr": "Personne qui a remporté une victoire dans une compétition, un jeu ou un concours."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "победитель",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "победительница",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "fr": [
