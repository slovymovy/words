                "senses": [
                    {
                        "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                        "entry_id": "90924986-92aa-36b7-b8c2-e49306b199d6",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b94d51-c7b0-477e-af17-f1d07a2d55cf",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Frau Ba ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3c7a0cad-b908-4416-a1d2-8758db1283c9",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Herr Ba wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "95103dba-04cb-43c8-8695-1bb0a83ab760",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Die Bas fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "6a229532-dc13-49fd-a2d1-bf90351e139b",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Der Ba trägt nie die Pullover, die die Ba ihm strickt."
                            },
                            {
                                "example_id": "4edb13d9-9fbd-4f95-b4ba-0e3c9f658e29",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ba kommt, geht der Herr Ba.“"
                            },
                            {
                                "example_id": "c9cdfb5f-ad1f-4543-8417-c8189293f80a",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Ba kommt und geht."
                            },
                            {
                                "example_id": "3692b7f9-b905-42fc-8c2c-219b1aa13ad5",
                                "sense_id": "d9df5430-42ba-317c-9158-b13508dca7c2",
                                "text": "Bas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
