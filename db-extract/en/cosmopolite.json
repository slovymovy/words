                                "target_senses": [
                                    {
                                        "sense_id": "2f2c3830-4700-3206-b19f-80f63ba25a0e",
                                        "entry_id": "2293ef15-6f39-3156-9c07-305353d853b5",
                                        "glosses": [
                                            "wereldburger die zich overal (en dus eigenlijk ook nergens) thuis voelt"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49971006-1bed-4dd5-b22a-c6da0e02c1a2",
                                                "sense_id": "2f2c3830-4700-3206-b19f-80f63ba25a0e",
                                                "text": "Kosmopoliet als hij was, had Heldring altijd gemopperd dat de koningin te weinig normale mensen ontmoette."
                                            },
                                            {
                                                "example_id": "49a9e3c1-f408-4be1-ba1b-39c8f3d83e95",
                                                "sense_id": "2f2c3830-4700-3206-b19f-80f63ba25a0e",
                                                "text": "Kosmopolieten houden er een dubbele culturele moraal op na, betoogt Ruud Koopmans. De culturele identiteit van minderheden willen zij beschermen, terwijl die van de meerderheid wordt weggezet als bedenkelijk nationalisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f80472-b665-323c-88bd-f7463340352d",
                                        "entry_id": "2293ef15-6f39-3156-9c07-305353d853b5",
                                        "glosses": [
                                            "bepaald soort nachtvlinder, Leucania loreyi"
                                        ],
                                        "tags": [
                                            "vlinders"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e850b952-9cdc-48dd-8e02-3d1cf3e2a55e",
                        "source_entry_id": "47ae8cdf-9edf-322f-9eea-1fb5edbe0ecf",
                        "source_sense_description": "cosmopolitan person",
                        "target_lang_word": "cosmopolite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmopolite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8de223-3ce4-36dd-a94f-0082b7333597",
                                        "entry_id": "46875887-1da9-3e4d-aa8d-860436f1df58",
                                        "glosses": [
                                            "Se dit de quelqu’un qui refuse l’existence des frontières, qui ne se considère pas comme citoyen d’un État particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4902957-4181-42ea-b191-f9ee42b4cf92",
                                                "sense_id": "5e8de223-3ce4-36dd-a94f-0082b7333597",
                                                "text": "Défiez-vous de ces cosmopolites qui vont chercher loin dans leurs livres des devoirs qu’ils dédaignent de remplir autour d’eux. Tel philosophe aime les Tartares, pour être dispensé d’aimer ses voisins."
                                            },
                                            {
                                                "example_id": "2952fb3c-d2be-4301-90fa-5e778545c0c8",
                                                "sense_id": "5e8de223-3ce4-36dd-a94f-0082b7333597",
                                                "text": "Dans une lettre à Louis-Philippe, son beau-père, il écrit les mots suivants : « Les seuls véritables Belges de cœur et d'âme sont nos bons catholiques, le reste est un salami de cosmopolites \"fit for nothing\"; eux peuvent donc exprimer leur allégresse au grand Opéra par des jeux et des danses […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70f53ef-aa43-3736-99f6-ab523626d4a1",
                                        "entry_id": "46875887-1da9-3e4d-aa8d-860436f1df58",
                                        "glosses": [
                                            "Celui qui parcourt tous les pays sans jamais avoir de demeure fixe, ou qui se prête aisément aux usages, aux mœurs des pays où il se trouve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cosmopolite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8cf67f5-50c3-3a73-a342-5381e92a0d52",
                                        "entry_id": "96d0f1d6-2321-37fd-ae45-1c913a52c367",
                                        "glosses": [
                                            "Qui s’inspire de nombreuses cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c119fc-3485-455c-9699-27ea8a6cbd24",
                                                "sense_id": "e8cf67f5-50c3-3a73-a342-5381e92a0d52",
                                                "text": "De toute manière, Marseille, en tant que ville, a un splendide avenir; de grandes choses s’y préparent, un aspect cosmopolite de la civilisation y est en genèse."
                                            },
                                            {
                                                "example_id": "b410116c-6b37-449d-b837-e94ead8df69f",
                                                "sense_id": "e8cf67f5-50c3-3a73-a342-5381e92a0d52",
                                                "text": "Les Abbassides encouragèrent plus encore une civilisation cosmopolite, dont Bagdad fut le centre et l’arabe la lingua franca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93227234-9e2c-325c-8b5f-3bbb8c3e4ddb",
                                        "entry_id": "96d0f1d6-2321-37fd-ae45-1c913a52c367",
                                        "glosses": [
                                            "Composé de, ou fréquenté par, des citoyens du monde entier, des personnes d'origines différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723aa974-f296-400d-9d24-612152b9734a",
                                                "sense_id": "93227234-9e2c-325c-8b5f-3bbb8c3e4ddb",
                                                "text": "Achevons de nous mêler aux soixante mille habitants que renferme actuellement la capitale géorgienne. Perdons-nous à travers le labyrinthe de ses rues, au milieu de sa population cosmopolite."
                                            },
                                            {
                                                "example_id": "74738ac7-35fc-45f8-a64d-d0d44d9560cd",
                                                "sense_id": "93227234-9e2c-325c-8b5f-3bbb8c3e4ddb",
                                                "text": "Châlette-sur-Loing a été pendant longtemps et reste la ville la plus cosmopolite de France ! Huit mille habitants : trois mille étrangers. Vingt-cinq nationalités recensées en 1927 par Monsieur le Maire et aujourd'hui rien moins que quatre églises orthodoxes et deux mosquées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e469ae-6a67-3b7d-aeee-58fb13435e50",
                                        "entry_id": "96d0f1d6-2321-37fd-ae45-1c913a52c367",
                                        "glosses": [
                                            "Qui est présent en de nombreux endroits du monde entier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5919a95a-08f8-43d2-a54c-8cf28f1af016",
                                                "sense_id": "94e469ae-6a67-3b7d-aeee-58fb13435e50",
                                                "text": "Le cheval qui est le compagnon fidèle de l’homme est aussi capable de le suivre dans toutes ses pérégrinations. […] Comme son maître, il est cosmopolite ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c28c01d9-50be-3e75-af9a-50d91587b2ba",
                                        "entry_id": "96d0f1d6-2321-37fd-ae45-1c913a52c367",
                                        "glosses": [
                                            "Qui se déclare citoyen du monde, qui refuse de se laisser enfermer dans l’appartenance à une nation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cc0fbb-072e-437e-a17f-f3f0748e898e",
                                                "sense_id": "c28c01d9-50be-3e75-af9a-50d91587b2ba",
                                                "text": "Esprit cosmopolite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dad24f8-a1fc-3b68-9d89-abb29e06f971",
                                        "entry_id": "96d0f1d6-2321-37fd-ae45-1c913a52c367",
                                        "glosses": [
                                            "Qui s’accommode aisément des mœurs et des usages des pays où il vit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e682b28-dbec-49c8-8757-714b9711f75e",
                                                "sense_id": "3dad24f8-a1fc-3b68-9d89-abb29e06f971",
                                                "text": "Mœurs cosmopolites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b8220ab-0a1e-4e8a-89c2-4cddfabc5e56",
                        "source_entry_id": "47ae8cdf-9edf-322f-9eea-1fb5edbe0ecf",
