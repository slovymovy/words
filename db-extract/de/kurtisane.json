                                                "example_id": "f5632476-2697-4076-98c5-48de0e5da21e",
                                                "sense_id": "5ac18785-9236-39ab-ba6b-e36fb7f332ab",
                                                "text": "male equivalent: master"
                                            },
                                            {
                                                "example_id": "73559445-6da8-4985-8331-11d23388b529",
                                                "sense_id": "5ac18785-9236-39ab-ba6b-e36fb7f332ab",
                                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                                            },
                                            {
                                                "example_id": "fb94646a-04d3-485f-bca0-90ef5b055a50",
                                                "sense_id": "5ac18785-9236-39ab-ba6b-e36fb7f332ab",
                                                "text": "She was the mistress of the estate-mansion, and owned the horses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f8372e-c19d-3fac-b373-d8b91189dedd",
