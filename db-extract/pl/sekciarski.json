                "entry_id": "b9acedfc-3197-32ac-a0df-8593b13bf725",
                "word": "sekciarski",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "191c9ed9-a044-396b-865d-c89431a6c0bb",
                        "entry_id": "b9acedfc-3197-32ac-a0df-8593b13bf725",
                        "glosses": [
                            "zasklepiający się w obrębie wąskiej grupy, najczęściej politycznej lub ideologicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b85d544-5b96-4c47-8e1a-67584debcdf0",
                                "sense_id": "191c9ed9-a044-396b-865d-c89431a6c0bb",
                                "text": "Jasieński wtedy był szalenie aktywny, okropnie sekciarski, był wśród tych najbardziej tępiących, nawet Majakowskiego, najbardziej fanatycznych."
                            },
                            {
                                "example_id": "0e637715-6e38-4668-ac63-ab5013a8801d",
                                "sense_id": "191c9ed9-a044-396b-865d-c89431a6c0bb",
                                "text": "Od 1981 r. kobiety w Tunezji mają zakaz noszenia islamskiego ubioru, włącznie z chustami, w szkołach i urzędach państwowych. (…) Policja zatrzymywała kobiety na ulicy i prosiła je o zdjęcie chusty; prezydent opisał chustę jako \"sekciarski rodzaj ubioru, który nieproszony przyszedł do Tunezji\"."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "057878b9-da84-3d37-88c3-7c1915424649",
                        "entry_id": "b9acedfc-3197-32ac-a0df-8593b13bf725",
                        "glosses": [
                            "dotyczący sekt religijnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413024a7-c1c3-4a1f-850a-b9e53181ec44",
                                "sense_id": "057878b9-da84-3d37-88c3-7c1915424649",
                                "text": "Od 1981 r. kobiety w Tunezji mają zakaz noszenia islamskiego ubioru, włącznie z chustami, w szkołach i urzędach państwowych. (…) Policja zatrzymywała kobiety na ulicy i prosiła je o zdjęcie chusty; prezydent opisał chustę jako \"sekciarski rodzaj ubioru, który nieproszony przyszedł do Tunezji\"."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
