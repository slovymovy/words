                                        "sense_id": "d66daaeb-7ba3-3841-8440-99306ff43ca7",
                                        "entry_id": "ca6338d8-f7fe-31b8-9c69-cee4f2a3ac12",
                                        "glosses": [
                                            "Textual material which surrounds a work but is not part of the text or its peritext, including published interviews, private correspondence, diary entries and the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "560e36dc-b4ad-483f-b0e6-2d93b2cf8a5f",
                                                "sense_id": "d66daaeb-7ba3-3841-8440-99306ff43ca7",
                                                "text": "It is the second category which I christen, for want of a better word, epitext and which will be the subject of the last two chapters."
                                            },
                                            {
                                                "example_id": "9df3382b-ee70-4c5b-9833-6edade530b79",
                                                "sense_id": "d66daaeb-7ba3-3841-8440-99306ff43ca7",
                                                "text": "The concepts of “epitext” and “peritext” continue to be useful for the analysis of digital literature on portable electronic devices but need expansion as categories."
                                            },
                                            {
                                                "example_id": "f79dd0e4-7a2e-49e7-baff-914a76ea8ac6",
                                                "sense_id": "d66daaeb-7ba3-3841-8440-99306ff43ca7",
                                                "text": "The concept of paratext was defined by Gérard Genette as common elements provided within a book (peritext) and elements outside of the book that refer to it (epitext); these elements can affect individual, as well as cultural, perceptions of a text (1997, 4–5)."
                                            }
                                        ]
                                    }
                                ]
