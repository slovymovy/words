                "senses": [
                    {
                        "sense_id": "5ea648f6-ac78-3e94-9345-f2eb4334effc",
                        "entry_id": "e4171764-479c-33ab-ab40-2f7e72267eed",
                        "glosses": [
                            "syntaktische Qualität der Ebenmäßigkeit"
                        ],
                        "tags": [
                            "Rhetorik",
                            "Satzbau"
                        ],
                        "examples": [
                            {
                                "example_id": "8a84dc0d-8a32-4174-9487-99210b9a3983",
                                "sense_id": "5ea648f6-ac78-3e94-9345-f2eb4334effc",
                                "text": "„Unter Konzinnität und Inkonzinnität wird hier die in syntaktischer Hinsicht symmetrische bzw. asymmetrische Gestaltung der koordinierten (parallelen) Sätze oder Satzglieder verstanden.“"
                            },
                            {
                                "example_id": "efab1d82-c24d-4544-8026-8af0a990b1aa",
                                "sense_id": "5ea648f6-ac78-3e94-9345-f2eb4334effc",
                                "text": "„Diese so genannte Konzinnität (von lateinisch concinnus: ebenmäßig und gefällig zusammengefügt) stellt seit der antiken Rhetorik eines der zentralen Wirkungsfelder der Überzeugungsrede dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "692e37b5-3523-33d9-9539-7c9ad269cdff",
                        "entry_id": "e4171764-479c-33ab-ab40-2f7e72267eed",
                        "glosses": [
                            "Gefälligsein"
                        ],
                        "tags": [
                            "archaic",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "778cdcd1-edb8-477b-ac21-f57068b6bbc8",
                                "sense_id": "692e37b5-3523-33d9-9539-7c9ad269cdff",
                                "text": "„Seine Arbeit mit der Bühne war nicht ganz so glatt, denn mal überdeckte das Orchester schwächeren Gesang, mal blieb dieser im übertriebenen Pathos von Steven Page (Pizarro) auf der Strecke, auch den Chorszenen fehlte es bisweilen an wünschenswerter Konzinnität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
