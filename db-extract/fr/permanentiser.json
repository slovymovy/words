                "senses": [
                    {
                        "sense_id": "d70d46e9-8e05-3d7d-a18b-d10ce5f458a8",
                        "entry_id": "c5a143d3-8431-3f8c-b57d-7ec7515483ea",
                        "glosses": [
                            "Donner un caractère permanent à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce710a0-04cd-43ba-b583-852af24f70a2",
                                "sense_id": "d70d46e9-8e05-3d7d-a18b-d10ce5f458a8",
                                "text": "Quelle estime des autres, et quelle estime de soi, quand tout concoure à « permanentiser » le statut de « temporaire non qualifié » ?"
                            },
                            {
                                "example_id": "6d1e36d6-e924-47dc-a98c-97bce4b45d07",
                                "sense_id": "d70d46e9-8e05-3d7d-a18b-d10ce5f458a8",
                                "text": "Il était inscrit dans le COM de France Télévisions que nous devions réduire l'intermittence et “permanentiser” les CDD."
                            },
                            {
                                "example_id": "683f8bd5-2e24-48aa-a44e-3c7f9bea77b3",
                                "sense_id": "d70d46e9-8e05-3d7d-a18b-d10ce5f458a8",
                                "text": "RMC a décidé de \"permanentiser\" ma chronique matinale."
                            }
                        ]
                    }
