                            {
                                "example_id": "54e89894-abfc-4895-9d1e-fca8a5816206",
                                "sense_id": "0c7f7c64-f550-3081-aae2-12f6e9e669fd",
                                "text": "Van de 72.340 Surinamers met een gemengde afkomst, hebben er vervolgens 14.651 een ‘volbloed’ Hindoestaanse vader of moeder. Mensen met gedeeltelijk Hindoestaans en gedeeltelijk Afro-Caraïbisch bloed worden ook wel Dogla genoemd in de volksmond."
                            },
                            {
                                "example_id": "cf506cea-2a84-4112-ae70-29b40d5bdb12",
                                "sense_id": "0c7f7c64-f550-3081-aae2-12f6e9e669fd",
                                "text": "Een ander woord is Dogla, waarmee de kinderen van de kruising tussen Hindostaans en Negerbloed worden aangeduid."
                            }
                        ]
                    }
