    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                "word": "ironwork",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8a8db702-fb14-4df4-8339-a8fcadaaa8e6",
                        "entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "ironworks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                        "entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                        "glosses": [
                            "Anything made wholly or largely of iron, especially when used for decoration."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03699289-21f3-4a1e-9fcb-cc15c0e0cd91",
                                "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                "text": "The weight of the wrought-ironwork in each of the trusses is 460 tons, inclusive of the longitudinal and cross girders weighing 130 tons."
                            },
                            {
                                "example_id": "bae93d13-7ad7-4dec-98b6-17e24b40676b",
                                "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                "text": "The gate itself has sideposts of rustic stonework, each topped by a large Baroque vase; these sideposts are joined by elaborate floral ironwork with a coat of arms and a coronet in the centre[…]"
                            },
                            {
                                "example_id": "337bb2b6-75d3-4e46-9a02-cc2252d0ccae",
                                "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                "text": "But instead, the distinctive ironwork and glass platform awnings have been carefully refurbished, while making them compatible with the overhead wiring. Kettering's island Platform 2/3 is especially noteworthy. Although it dates from 1879, when the station was enlarged to four platforms, the same original (1857) patterns for the delicate cast-ironwork seem to have been used - […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "565a2d6e-a4e4-3982-b42e-0524cc7ff88b",
                        "entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                        "glosses": [
                            "An ironworks."
                        ],
                        "tags": [
                            "countable",
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebdff9be-274a-49cf-a330-c282c28abb39",
                        "source_entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                        "source_sense_description": "anything made of iron",
                        "target_lang_word": "ijzerwerk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ijzerwerk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae283ca-1473-3718-b70f-4759ee9a22ff",
                                        "entry_id": "9962de87-a6ff-3a24-9a91-40eb5f53b036",
                                        "glosses": [
                                            "een voorwerp gemaakt van ijzer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a94f9b4f-0876-42a9-8416-b187effe81bc",
                                                "sense_id": "4ae283ca-1473-3718-b70f-4759ee9a22ff",
                                                "text": "Aan dit alles ligt één en hetzelfde beginsel ten grondslag: hoe compacter, hoe beter. Al het redelijk streven richt zich naar het zoveel mogelijk persen tot zakformaat. Zo heeft de dundrukzakbijbel de in leer gebonden en met ijzerwerk versterkte statenvertaling verdrongen. Aan het begin van de eeuw waren er al de pockets van Philipp Reclam, de Tauchnitz uitgaven, toen de Pelicans en de Penguins. De Verlichting na de Bezetting verscheen in de vorm van Amerikaanse pockets, het New World Writing. Daarna kwamen de Japanners met de miniaturisering, de eerste wapens van de hardware. Machientjes om alles op te nemen, en alles paste in de zak van je jasje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "413c1820-75a6-4ac2-9d99-defd7bebb98c",
                        "source_entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                        "source_sense_description": "anything made of iron",
                        "target_lang_word": "ferronnerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferronnerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da866e2d-910f-3035-9778-49a1d22abdc3",
                                        "entry_id": "42e6bcd8-9afb-3140-b5b9-3959c2f0c25b",
                                        "glosses": [
                                            "Lieu où l’on fabrique, où l’on vend les gros ouvrages de fer."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75f49044-f1ee-34e2-8872-0a750110cb6a",
                                        "entry_id": "42e6bcd8-9afb-3140-b5b9-3959c2f0c25b",
                                        "glosses": [
                                            "Art du ferronnier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c907e4fc-9584-44f7-8183-e357dfd79440",
                                                "sense_id": "75f49044-f1ee-34e2-8872-0a750110cb6a",
                                                "text": "À l’école, il a appris à lire et à écrire. Il a travaillé dans la ferronnerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad6ce70d-71a2-3ad0-9ac8-4c9499539641",
                                        "entry_id": "42e6bcd8-9afb-3140-b5b9-3959c2f0c25b",
                                        "glosses": [
                                            "Ces ouvrages de fer, fabriqués par le ferronnier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27808913-5bc0-4c95-ae6c-bdcc84a751a9",
                                                "sense_id": "ad6ce70d-71a2-3ad0-9ac8-4c9499539641",
                                                "text": "Combien de balcons en ferronnerie, de mascarons, de pilastres nous restituent l’image de ce que fut cette cité au XVIᵉ, au XVIIᵉ, au XVIIIᵉ siècle."
                                            },
                                            {
                                                "example_id": "a1bf30b6-bb71-4872-a07e-0987928a04e7",
                                                "sense_id": "ad6ce70d-71a2-3ad0-9ac8-4c9499539641",
                                                "text": "Deux rues plus loin, il ouvrit un lourd portail, garni de riches ferronneries, qui donnait sur une petite cour intérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
