                        "entry_id": "cba059de-78c5-3179-9b6a-c78c3a966e4b",
                        "glosses": [
                            "besonders starke Uneinsichtigkeit"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd0e3b5-1ae9-4188-a4ad-bb30f869633b",
                                "sense_id": "bcf9aa78-887a-3c9f-944c-40da33c838f0",
                                "text": "Hans vermutet hinter Arnes Verstocktheit ein tiefes Geheimnis."
                            },
                            {
                                "example_id": "3e5b37bf-efa6-481e-b885-d194ea443260",
                                "sense_id": "bcf9aa78-887a-3c9f-944c-40da33c838f0",
                                "text": "„Ihm wurde rasch klar, dass aus Not und Elend kein geistiger Aufbruch entstehen konnte, und dass nicht Verstocktheit die Deutschen hemmte, sich mit ihrer Vergangenheit zu beschäftigen, sondern die auslaugende Anstrengung des schieren Überlebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
