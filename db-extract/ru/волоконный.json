                        "form": "волоко́нна"
                    },
                    {
                        "form_id": "33e42705-57e2-49b1-b2b1-13a48c6af35b",
                        "entry_id": "2fc3ff72-dd6b-3edd-a0d0-8ec41be02c2b",
                        "tags": [
                            "plural",
