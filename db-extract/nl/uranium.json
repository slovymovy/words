                "forms": [],
                "senses": [
                    {
                        "sense_id": "84137aed-a74c-30d3-b2bb-30c764250c0c",
                        "entry_id": "b5ddfcb5-a545-38e3-b72c-e2c29a53ca27",
                        "glosses": [
                            "scheikundig element met symbool U en atoomnummer 92. Het is een metalliekgrijs actinide"
                        ],
