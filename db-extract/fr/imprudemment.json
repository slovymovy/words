        "fr-extract.jsonl": [
            {
                "entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                "word": "imprudemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                        "entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                        "glosses": [
                            "Avec imprudence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef01ddd-6712-4b23-a976-b8776ac071cd",
                                "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                "text": "De sorte que désormais il faut que je prenne soigneusement garde de ne prendre pas imprudemment quelque autre chose pour moi."
                            },
                            {
                                "example_id": "805d986a-d1fe-4011-8da8-3b948b221115",
                                "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                "text": "L'élevage des vers à soie « ne paie plus ». Voilà pourquoi, aujourd'hui, dans le Gard, on arrache les mûriers : on les remplace imprudemment par des vignes...."
                            },
                            {
                                "example_id": "3e0f05fd-108f-44cb-8d96-ca2f99134898",
                                "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                "text": "La cour d’appel partagea alors les dommages, selon les principes de la faute commune, constatant que la victime s’était imprudemment aventurée sur un boulevard passager, sans prendre les précautions nécessaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a29f8c86-8236-4b4b-8b0f-a1a0c58b98c1",
                        "source_entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                        "source_sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                        "target_lang_word": "leichtsinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leichtsinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05d5dc20-951a-3234-b41b-e8012f4c64e3",
                                        "entry_id": "725e6c2b-5cd8-3bf9-a279-2e31f39c58ae",
                                        "glosses": [
                                            "unvorsichtig Risiken eingehend, nicht an Gefahren und Verantwortung denkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de310ff-aaad-476b-adc9-093feb7f5407",
                                                "sense_id": "05d5dc20-951a-3234-b41b-e8012f4c64e3",
                                                "text": "Jugendliche sind oft leichtsinnig."
                                            },
                                            {
                                                "example_id": "3b5f8761-7dab-4acd-bdcd-76fe822256cd",
                                                "sense_id": "05d5dc20-951a-3234-b41b-e8012f4c64e3",
                                                "text": "„Wer den Weg zu seinem Ideale nicht zu finden weiss, lebt leichtsinniger und frecher, als der Mensch ohne Ideal.“"
                                            },
                                            {
                                                "example_id": "16e87b6c-befb-48a3-b1c9-be49707b6b85",
                                                "sense_id": "05d5dc20-951a-3234-b41b-e8012f4c64e3",
                                                "text": "„Der 17-Jährige räumte vor Gericht ein, im Umgang mit den Hunden leichtsinnig und unerfahren gewesen zu sein. Von einer Maulkorbpflicht habe er nicht gewusst, die Aufforderung seines älteren Bruders - dem Hundehalter - die Tiere anzuleinen, habe er ignoriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcca24ae-671c-46e5-8ee7-cbfc14f62d41",
                        "source_entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                        "source_sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                        "target_lang_word": "imprudently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                        "entry_id": "202019c9-1dfb-333b-aa93-7ac54565a607",
                                        "glosses": [
                                            "Without prudence; in an imprudent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8f03b2-632e-46fd-a2c7-b32dada80665",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "He imprudently invested all his savings into a shady scheme and lost."
                                            },
                                            {
                                                "example_id": "b7a3cd06-7ceb-4f32-bec6-27f437c19f8e",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "She spoke imprudently during the meeting, criticizing her boss without evidence."
                                            },
                                            {
                                                "example_id": "2be3f157-8479-44ff-b78a-9daaeaf209dd",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "The thinker imprudently dismissed the ontological premises of the argument without engaging in dialectical scrutiny, thereby undermining the epistemic integrity of the discourse."
                                            },
                                            {
                                                "example_id": "bf1e0bd7-a34e-4000-b624-50162b2bb447",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "The minister imprudently disclosed classified information, thereby compromising national security."
                                            },
                                            {
                                                "example_id": "ffe4579e-116b-4b9a-b1ab-664424c24a44",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "The executive imprudently authorized the capital reallocation without conducting a due diligence audit, thereby exposing the firm to significant fiduciary risk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1c18f62-5ff3-4d0b-ab1a-5e0f69314920",
                        "source_entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                        "source_sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                        "target_lang_word": "unwisely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwisely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40c856d8-7175-36b9-b068-d87bb1e99756",
                                        "entry_id": "fdac779d-157a-39e8-9f6b-f2b6d4e53ad7",
                                        "glosses": [
                                            "In an unwise manner; foolishly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "335eea1f-ca82-41bd-943d-5b060ef2387f",
                                                "sense_id": "40c856d8-7175-36b9-b068-d87bb1e99756",
                                                "text": "The scope of the new upgrade isn't just restricted to the station and junction. It has involved more than simply putting back what was unwisely taken away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4e35606-975a-457f-8086-7391d3006aaa",
                        "source_entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                        "source_sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                        "target_lang_word": "carelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Giving the appearance of carelessness; relaxedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8156b1-f80e-4106-a27e-65fb7b5b85c6",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "The papers were carelessly strewn on the table."
                                            },
                                            {
                                                "example_id": "c1542fe3-8aa4-46b6-abb7-4b3840f404e0",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "Let us try to imagine the qualms of some Fifth Avenue florist if he could but see so many potential boutonnières, at a dollar apiece, so carelessly heaped up in baskets, lining the dingy pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Done without care or attention; inattentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cd05c4-3647-4311-b5dc-962173fd5149",
                                                "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                                "text": "Distracted by the salesperson, he carelessly read the contract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46815142-d99a-46ad-b6bb-7e75d9cef296",
                        "source_entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                        "source_sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                        "target_lang_word": "incautiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incautiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8049a922-afaa-3e01-b26a-74ca6f29fcab",
                                        "entry_id": "00fcace8-3f31-3f44-a9bd-78a551fd0cd1",
                                        "glosses": [
                                            "In an incautious manner; with a lack of caution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5d46940-1cc0-4a26-8f4b-983284f8c92c",
                                                "sense_id": "8049a922-afaa-3e01-b26a-74ca6f29fcab",
                                                "text": "His behaviour to herself could now have had no tolerable motive; he had either been deceived with regard to her fortune, or had been gratifying his vanity by encouraging the preference which she believed she had most incautiously shewn."
                                            },
                                            {
                                                "example_id": "2463dc58-dfdf-492e-bcb7-6f7b9fa99f5c",
                                                "sense_id": "8049a922-afaa-3e01-b26a-74ca6f29fcab",
                                                "text": "[…] the piranhas habitually attack things much larger than themselves. They will snap a finger off a hand incautiously trailed in the water […]"
                                            },
                                            {
                                                "example_id": "1147b0fc-c0f6-43bd-82b9-a91ca1314041",
                                                "sense_id": "8049a922-afaa-3e01-b26a-74ca6f29fcab",
                                                "text": "The parson explained that the dissenters were insufficiently grounded in religious learning, inappropriately eager to administer the sacraments without his help or sanction, and incautiously emotional in their worship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
