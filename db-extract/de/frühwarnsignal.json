                "senses": [
                    {
                        "sense_id": "49abdfb3-4ed7-3e56-b681-700971af2f6f",
                        "entry_id": "209c205c-41a6-3a9d-a7b6-e51ac5c068b1",
                        "glosses": [
                            "Moment/Information/Botschaft/Ereignis, das zu einem zeitigen/frühen Zeitpunkt eine Warnung/Benachrichtigung auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6f3a79-3002-4517-acbe-f50f3100354e",
                                "sense_id": "49abdfb3-4ed7-3e56-b681-700971af2f6f",
                                "text": "„Typische Frühwarnsignale für ein drohendes Burnout sind der Verlust von Interessen (\"Soll ich mich heute wirklich noch mit Anne treffen?\"), vermehrtes Grübeln und Seufzen, Schwierigkeiten, abzuschalten, Gedanken wie: \"Ich habe noch so viel zu tun!\" oder \"Eigentlich bräuchte ich eine Pause!\", aber auch Vergesslichkeit.“"
                            },
                            {
                                "example_id": "4e3f740b-0d8a-4c4e-82b8-b93a2b50c1d1",
                                "sense_id": "49abdfb3-4ed7-3e56-b681-700971af2f6f",
                                "text": "„Britische Wissenschafter haben erstmals im Gehirn ein Frühwarnsignal registriert, das verhindern soll, dass frühere Fehler wiederholt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
