{
    "word_family": [
        "seclusion",
        "seclusive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "708e1352-14c8-3077-aa16-f4b2257f0c74",
                    "sense_definition": "To keep oneself apart from others or society to be alone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author decided to <w>seclude</w> himself in a remote cabin to finish his novel.",
                            "target_lang_translations": {
                                "es": "El autor decidió <w>recluirse</w> en una cabaña remota para terminar su novela."
                            }
                        },
                        {
                            "text": "She often <w>secludes</w> herself from the world when she needs to focus on her work.",
                            "target_lang_translations": {
                                "es": "A menudo <w>se aísla</w> del mundo cuando necesita concentrarse en su trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "isolate",
                        "withdraw",
                        "sequester"
                    ],
                    "antonyms": [
                        "socialize",
                        "mingle"
                    ],
                    "common_phrases": [
                        "seclude oneself"
                    ],
                    "target_lang_definitions": {
                        "es": "Apartarse o mantenerse alejado del trato con otras personas o de la sociedad para estar a solas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "aislarse",
                                "target_lang_sense_clarification": "apartarse del trato con los demás"
                            },
                            {
                                "target_lang_word": "recluirse",
                                "target_lang_sense_clarification": "encerrarse voluntariamente en un lugar apartado"
                            },
                            {
                                "target_lang_word": "apartarse",
                                "target_lang_sense_clarification": "retirarse de la sociedad o de la gente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "def07286-9bf2-341a-ae8c-ac793c5eebfe",
                    "sense_definition": "To prevent something from entering or being included.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy aims to <w>seclude</w> unauthorized personnel from the secure laboratory area.",
                            "target_lang_translations": {
                                "es": "La nueva política tiene como objetivo <w>excluir</w> al personal no autorizado de la zona segura del laboratorio."
                            }
                        },
                        {
                            "text": "Strict regulations <w>seclude</w> certain types of data from public access.",
                            "target_lang_translations": {
                                "es": "Normativas estrictas <w>apartan</w> ciertos tipos de datos del acceso público."
                            }
                        }
                    ],
                    "synonyms": [
                        "exclude",
                        "preclude",
                        "bar"
                    ],
                    "antonyms": [
                        "include",
                        "admit"
                    ],
                    "target_lang_definitions": {
                        "es": "Impedir que algo o alguien entre, acceda o sea incluido."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "excluir",
                                "target_lang_sense_clarification": "dejar fuera o impedir la entrada"
                            },
                            {
                                "target_lang_word": "apartar",
                                "target_lang_sense_clarification": "separar o alejar del acceso"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}