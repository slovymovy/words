                ],
                "senses": [
                    {
                        "sense_id": "040f4fda-19c3-33aa-bd23-b279ba58bda2",
                        "entry_id": "58dfec1f-a6f5-3cdd-88fc-31c7aa091380",
                        "glosses": [
                            "Staatsbürgerin von Bosnien und Herzegowina"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4f50e6-a966-49de-800b-19a1542a15f4",
                                "sense_id": "040f4fda-19c3-33aa-bd23-b279ba58bda2",
                                "text": "„Man findet den Kaftan-Chalat in ganz Zentral- und Vorderasien, in knapperer Förmbreite bei den Hindus in Indien, als Yelek durch Syrien und Palästina hindurch bis nach Ägypten und Nordafrika; an der ostafrikanischen Küste zeigt er stark indischen Einschlag; mit den osmanischen Türken ist er nach den Balkanländern gekommen, wo man ihn noch selbst in dem halblangen offenen Kittelrock der Serbinnen und Bosnierinnen erkennen kann; von den Tataren kam er zu den ukrainischen und polnischen Völkern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5f4e5a9-aec1-4937-af81-f5121416ee6a",
                        "source_entry_id": "58dfec1f-a6f5-3cdd-88fc-31c7aa091380",
                        "source_sense_id": "040f4fda-19c3-33aa-bd23-b279ba58bda2",
                        "source_sense_description": "Staatsbürgerin von Bosnien und Herzegowina",
                        "target_lang_word": "Bosnian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bosnian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00ab4d98-4ead-320f-a46f-b00373c20477",
                                        "entry_id": "47efa43c-94f5-3369-a4f9-b222adb2ed05",
                                        "glosses": [
                                            "Of or pertaining to Bosnia and Herzegovina, the Bosnian people or their culture and language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ef6f74-0fdb-4442-921b-814bfd0ba3bf",
                                                "sense_id": "00ab4d98-4ead-320f-a46f-b00373c20477",
                                                "text": "In his provocative essay, David Gibbs makes the following statement about diplomacy and the war in Bosnia. “There is also abundant evidence that diplomacy might have prevented the Bosnian war and thus prevented the Srebrenica massacre, but this option was blocked by prointerventionist forces in the United States, which demanded a military option instead.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c5c73bc-47fa-3801-bfaf-a08fad575cfd",
                                        "entry_id": "47efa43c-94f5-3369-a4f9-b222adb2ed05",
                                        "glosses": [
                                            "Of or pertaining to Bosnia"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "592b3180-df6a-3b21-a98c-c047b6b1e1b1",
                                        "entry_id": "47efa43c-94f5-3369-a4f9-b222adb2ed05",
                                        "glosses": [
                                            "Pertaining to Bosniaks"
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Bosnian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05729403-fe16-3c8b-b3f0-bd724ed2caa9",
                                        "entry_id": "f3e4c3ad-a273-3293-b1cf-b3af57d663d9",
                                        "glosses": [
                                            "A person from Bosnia and Herzegovina or of Bosnian descent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d39e43-dd00-43ac-bf9b-f11c06bb4326",
                                                "sense_id": "05729403-fe16-3c8b-b3f0-bd724ed2caa9",
                                                "text": "Ten days later, however, the deal was dead, largely because the United States opposed it and persuaded the Bosnians to do the same, or so Gibbs argues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5423ead8-fc37-3639-bdad-0c57e92a3129",
                                        "entry_id": "f3e4c3ad-a273-3293-b1cf-b3af57d663d9",
                                        "glosses": [
                                            "The standardized variety of Serbo-Croatian, a South Slavic language, spoken primarily by Bosniaks in Bosnia and Herzegovina."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
