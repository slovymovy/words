                            {
                                "example_id": "caa84140-e136-45e8-977b-45f9293ad871",
                                "sense_id": "be27bee0-f8a7-3284-a936-dc034e46bd74",
                                "text": "На опушке леса отряд негров был занят распиловкой брёвен"
                            }
                        ]
                    },
                    {
                        "sense_id": "a6f4bd95-415c-3850-a9e5-834e09d14c57",
