                ],
                "senses": [
                    {
                        "sense_id": "62e5316d-bf38-350b-ba69-9e06ab896e59",
                        "entry_id": "f02136d0-28a0-38f5-9db9-50c5f5486284",
                        "glosses": [
                            "allmähliches Abklingen eines Tons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae93f574-9c08-41f6-b9f2-0854e9033feb",
                                "sense_id": "62e5316d-bf38-350b-ba69-9e06ab896e59",
                                "text": "„Es blieb ein Nachhall in der Luft, als hätte jemand auf einen Gong geschlagen.“"
                            },
                            {
                                "example_id": "d5bca6ed-1ba6-43d9-bc77-b51a715a3a45",
                                "sense_id": "62e5316d-bf38-350b-ba69-9e06ab896e59",
                                "text": "„Ich rekonstruiere aus dem Nachhall in meinen Ohren das, was Dietrich gerade gesagt hat und wiederhole es: ...“"
                            },
                            {
                                "example_id": "da052aa2-5b8c-4588-9a11-31e43bfa9528",
                                "sense_id": "62e5316d-bf38-350b-ba69-9e06ab896e59",
                                "text": "„Gleichwohl ist Diogenes zu einer Figur mit bemerkenswertem literarischem Nachhall geworden, Hans Sachs ist nur einer von vielen, die sich seiner Figur bedienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
