                "senses": [
                    {
                        "sense_id": "b38e9be8-65c6-3789-a957-73f96c7aec49",
                        "entry_id": "93ca669b-d599-3d5a-9954-053bc7ccb999",
                        "glosses": [
                            "прибор, автоматически записывающий какую-либо информацию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ab1129-f0da-4de5-b9fd-390824768dbc",
                                "sense_id": "b38e9be8-65c6-3789-a957-73f96c7aec49",
                                "text": "Таким образом на ленте самописца записываются два пика — адсорбционный и десорбционный."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9ea1b73-6bf0-4586-b338-d402041840a5",
                        "source_entry_id": "93ca669b-d599-3d5a-9954-053bc7ccb999",
                        "source_sense_id": "b38e9be8-65c6-3789-a957-73f96c7aec49",
                        "target_lang_word": "Schreibgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15f7dff0-769d-3fb9-9229-d7bf371e5b6c",
                                        "entry_id": "2cca2c33-7613-3dfa-b66e-fa921a2d851f",
                                        "glosses": [
                                            "Gerät, mit dem man schriftliche Texte auf einer (beschreibbaren) Fläche anbringen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b9312e9-04b7-4d15-a8ee-039520c8f7cf",
                                                "sense_id": "15f7dff0-769d-3fb9-9229-d7bf371e5b6c",
                                                "text": "Schreibgeräte sind zum Schreiben von Schriftzeichen da."
                                            },
                                            {
                                                "example_id": "848234a0-0736-4c09-a935-5667565934c3",
                                                "sense_id": "15f7dff0-769d-3fb9-9229-d7bf371e5b6c",
                                                "text": "„Das älteste Schreibgerät der Ägypter war die Binse, welche schräg zugeschnitten wurde.“"
                                            },
                                            {
                                                "example_id": "c711c462-732e-4cec-8f8f-b14e5833b7a2",
                                                "sense_id": "15f7dff0-769d-3fb9-9229-d7bf371e5b6c",
                                                "text": "„Es ist in der Tat möglich, daß die Stahlfeder wirklich in all diesen Ländern erfunden wird, da man ein Schreibgerät braucht, das genauso biegsam wie eine Gänsefeder, aber wesentlich haltbarer ist.“"
                                            },
                                            {
                                                "example_id": "bb15f287-56f5-411d-987c-abd1a5d964fc",
                                                "sense_id": "15f7dff0-769d-3fb9-9229-d7bf371e5b6c",
                                                "text": "„Man führte mich in eine Flucht von drei Räumen; das Schlafzimmer war mit Damast tapeziert und enthielt ein Himmelbett und einen geöffneten Sekretär mit allem nötigen Schreibgerät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
