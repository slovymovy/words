                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7018005a-b110-45ff-bd51-87c43ea12dcb",
                                                "sense_id": "7e2f00e4-a87a-351d-bce0-e57dd65e93c7",
                                                "text": "He's got some decent wedge."
                                            },
                                            {
                                                "example_id": "9e0eca85-e3cb-45fc-a2a2-3d46d567d887",
                                                "sense_id": "7e2f00e4-a87a-351d-bce0-e57dd65e93c7",
                                                "text": "I made a big fat wedge from that job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ca482d6-df01-3c80-9596-eb1fc5ff5881",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "A sandwich made on a long, cylindrical roll."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "regional",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad7649f5-4051-45a3-a386-e65d1510d2a5",
                                                "sense_id": "7ca482d6-df01-3c80-9596-eb1fc5ff5881",
                                                "text": "I ordered a chicken parm wedge from the deli."
                                            },
                                            {
                                                "example_id": "549ce912-d2bd-4ddd-af45-f2c1fdc23b76",
                                                "sense_id": "7ca482d6-df01-3c80-9596-eb1fc5ff5881",
                                                "text": "She hoped it wasn't a meatball wedge, because there's so much garlic in school meatballs that it might make my breath smell and knock the agent out of his chair."
                                            },
                                            {
                                                "example_id": "0d34d5d2-3fb5-430d-83e5-0d00208bc2a2",
                                                "sense_id": "7ca482d6-df01-3c80-9596-eb1fc5ff5881",
                                                "text": "Most people realize there are a lot of different names for that type of sandwich, so Scalone wondered what was so funny about wedge?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff5489d-510d-3085-a953-f72101d918b8",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "One of the basic elements that make up cuneiform writing, a single triangular impression made with the corner of a reed stylus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aced47bc-0338-3575-90ff-e786dd6dc02f",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "Any symbol shaped like a V in some given orientation.",
                                            "A háček."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "137bbd87-f4d8-4794-995a-114ddc1d2129",
                                                "sense_id": "aced47bc-0338-3575-90ff-e786dd6dc02f",
                                                "text": "The wedge is used in Czech and is illustrated by the Czech name for the diacritic, haček."
                                            },
                                            {
                                                "example_id": "5435cd4f-7cef-409c-88dd-8b2d22ca2d29",
                                                "sense_id": "aced47bc-0338-3575-90ff-e786dd6dc02f",
                                                "text": "The tilde and the circumflex have a place in the ASCII scheme but the wedge and the umlaut do not."
                                            },
                                            {
                                                "example_id": "94d5ebd4-3c35-474a-a710-ddca399ea496",
                                                "sense_id": "aced47bc-0338-3575-90ff-e786dd6dc02f",
                                                "text": "The háček or ‘wedge’ ⟨ˇ⟩ is a diacritic commonly used in Slavic orthographies. […] As a tone mark the wedge is used iconically for a falling-rising tone as in Chinese Pinyin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac3ba07c-faee-360e-b64d-2373c2c62df9",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "Any symbol shaped like a V in some given orientation.",
                                            "The IPA character ʌ, which denotes an open-mid back unrounded vowel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30f1acb-30a8-43d3-88a7-15872aabd496",
                                                "sense_id": "ac3ba07c-faee-360e-b64d-2373c2c62df9",
                                                "text": "Turned V is referred to as “Wedge” by some phoneticians, but this seems inadvisable to us, because the haček accent (ˇ) is also called that in names like Wedge C for (č)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1bcd5db-6bd6-3597-b080-d6af7d00d7de",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "Any symbol shaped like a V in some given orientation.",
                                            "The symbol ∧, denoting a meet (infimum) operation or logical conjunction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55c7c125-110c-38b8-a415-a059d75b7a82",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "Any symbol shaped like a V in some given orientation.",
                                            "A hairpin, an elongated horizontal V-shaped sign indicating a crescendo or decrescendo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd9f4b35-98ef-3b90-84c5-05ac62f3f804",
