                        "examples": [
                            {
                                "example_id": "cd703ebe-be28-4382-8cd7-050e00af61fa",
                                "sense_id": "bb5874f2-2183-31c1-951d-f73becf3efd8",
                                "text": "Hij leidde als gastdirigent bijna alle beroemde orkesten van de wereld. Vooral zijn interpretaties van de muziek van Mozart, Berlioz, Sibelius, Britten en Stravinsky zijn geliefd bij de kenners. Colin Davis was ook een aantal jaren dirigent van de beroemde 'Last Night of the Proms'."
                            },
                            {
                                "example_id": "3d2db617-2e68-46a5-bb02-fbd96c93c0e5",
                                "sense_id": "bb5874f2-2183-31c1-951d-f73becf3efd8",
                                "text": "Rowe wordt ook aangesteld als chef-dirigent van Holland Symfonia/Het Orkest van Het Nationale Ballet. Florio blijft aan het gezelschap verbonden als gastdirigent voor minstens twee producties per seizoen."
                            },
                            {
                                "example_id": "3fd2ee42-c986-4803-a0c3-3150d1e3e4aa",
                                "sense_id": "bb5874f2-2183-31c1-951d-f73becf3efd8",
                                "text": "In de afgelopen decennia stond hij voor vrijwel alle Nederlandse symfonie-orkesten en trad hij als gastdirigent over heel de wereld op."
                            }
                        ]
                    }
