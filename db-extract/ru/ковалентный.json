                    },
                    {
                        "translation_id": "dccc7ed4-2dce-49fb-b757-10752f910334",
                        "source_entry_id": "d7306355-577c-3d7c-bbb0-86f2759a29a2",
                        "source_sense_id": "b8266d1c-53d2-3816-b62e-3054e2ab13d6",
                        "target_lang_word": "kovalent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kovalent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28ef862c-00ee-3cd1-a1de-264a563090ca",
                                        "entry_id": "82a98087-8260-3a32-8cab-a1dcb1336568",
                                        "glosses": [
                                            "beschreibt einen Typus von chemischer Bindung zwischen Atomen (gemeinsam genutzte, an der Bindung zweier Atome beteiligte Elektronenpaare auf der äußersten Schale (Valenzelektronen))"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e134c70-0f6b-48c7-8ffa-47061869446d",
                                                "sense_id": "28ef862c-00ee-3cd1-a1de-264a563090ca",
                                                "text": "Da Proteine durch die kovalente SDS-Bindung negativ geladen werden, wandern diese ebenfalls in Richtung Anode."
                                            },
                                            {
                                                "example_id": "d5fbea31-87e2-4e13-98c0-eb549c52655b",
                                                "sense_id": "28ef862c-00ee-3cd1-a1de-264a563090ca",
                                                "text": "So sind kovalente Feststoffe auf Grund des ausgedehnten Netzes kovalenter Bindungen außergewöhnlich hart und besitzen einen hohen Schmelzpunkt (Beispiel: Diamant). Die Entsteheung von Molekülen aus Atomen beruht auf der Bildung von gemeinsamen, bindenden Elektronenpaaren in dem Bestreben der Atome, eine energetisch stabile Anordnung der Elektronen zu erreichen (Edelgaskonfiguration). Kovalente Bindungen haben das Bestreben, eine (mit Elektronen) komplett befüllte Valenzschale zu haben. Diese Elektronen werden von den beiden Atomkernen angezogen und bilden dadurch die feste Bindung."
                                            },
                                            {
                                                "example_id": "60416bce-5200-49ce-bbc3-74be3843c38d",
                                                "sense_id": "28ef862c-00ee-3cd1-a1de-264a563090ca",
                                                "text": "Bei einer kovalenten Bindung herrscht ein Gleichgewicht zwischen anziehenden und abstoßenden Kräften zwischen den Atomen."
                                            },
                                            {
                                                "example_id": "c68fa5ca-28bd-4627-a8eb-f5aabb498447",
                                                "sense_id": "28ef862c-00ee-3cd1-a1de-264a563090ca",
                                                "text": "Elektronenpaare, die für die Ausbildung einer kovalenten Bindung verantwortlich sind, werden bindende Elektronenpaare oder Bindungselektronenpaare genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
