                "senses": [
                    {
                        "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                        "entry_id": "c92b19c9-99f6-3568-9a53-c638a7d5f657",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60081e46-adb8-40b2-80c6-97799111c855",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Frau Spöhrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "823a64d5-2993-4e35-a0bc-e5b48dbf0701",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Herr Spöhrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d730a24f-025c-43d8-a3f0-6e5d3a4d30a3",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Die Spöhrles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1d6372e5-aab6-443f-b0f5-c02b55c9f02d",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Der Spöhrle trägt nie die Schals, die die Spöhrle ihm strickt."
                            },
                            {
                                "example_id": "30f98334-d14b-4334-9096-8533ccc12191",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Spöhrle kommt, geht der Herr Spöhrle.“"
                            },
                            {
                                "example_id": "8a44323f-8782-4e75-973f-a60e305fa616",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Spöhrle kommt und geht."
                            },
                            {
                                "example_id": "7dda93f0-2c64-4406-b423-dd9f189ec98b",
                                "sense_id": "5b857cbf-07c3-3758-8d90-14372f5891b1",
                                "text": "Spöhrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
