{
    "word_family": [
        "flinch",
        "flincher",
        "unflinching",
        "unflinchingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0765ebb2-b5fc-3504-a165-543b0c5d2160",
                    "sense_definition": "present participle and gerund of <w>flinch</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flinch_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took the injection without <w>flinching</w> or showing any sign of pain.",
                            "target_lang_translations": {
                                "es": "Recibió la inyección sin <w>inmutarse</w> ni mostrar ningún signo de dolor."
                            }
                        },
                        {
                            "text": "She stood her ground, never once <w>flinching</w> as the angry dog ran toward her.",
                            "target_lang_translations": {
                                "es": "Se mantuvo firme, sin <w>acobardarse</w> ni una sola vez mientras el perro enfurecido corría hacia ella."
                            }
                        }
                    ],
                    "synonyms": [
                        "cringing",
                        "wincing",
                        "recoiling"
                    ],
                    "common_phrases": [
                        "without flinching"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente y gerundio de flinch; retroceder, estremecerse o vacilar por dolor o miedo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "estremecerse",
                                "target_lang_sense_clarification": "por miedo o dolor"
                            },
                            {
                                "target_lang_word": "inmutarse",
                                "target_lang_sense_clarification": "usado comúnmente en negativo (sin inmutarse)"
                            },
                            {
                                "target_lang_word": "acobardarse",
                                "target_lang_sense_clarification": "vacilar o dar un paso atrás"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9ed141b-e43b-37e8-80db-ebd4e1bcc261",
                    "sense_definition": "A sudden movement of hesitation, fear, or pain; a flinch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flinch_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a slight <w>flinching</w> of his shoulder, he prepared for the impact.",
                            "target_lang_translations": {
                                "es": "Con un ligero <w>estremecimiento</w> de hombro, se preparó para el impacto."
                            }
                        },
                        {
                            "text": "Her sudden <w>flinching</w> revealed just how terrified she truly was.",
                            "target_lang_translations": {
                                "es": "Su repentino <w>respingo</w> reveló lo aterrorizada que realmente estaba."
                            }
                        }
                    ],
                    "synonyms": [
                        "flinch",
                        "wince",
                        "recoil"
                    ],
                    "common_phrases": [
                        "slight flinching"
                    ],
                    "target_lang_definitions": {
                        "es": "Movimiento involuntario y repentino de retroceso, vacilación, miedo o dolor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "estremecimiento",
                                "target_lang_sense_clarification": "movimiento involuntario por dolor o temor"
                            },
                            {
                                "target_lang_word": "respingo",
                                "target_lang_sense_clarification": "sobresalto o movimiento brusco"
                            },
                            {
                                "target_lang_word": "amago",
                                "target_lang_sense_clarification": "gesto involuntario de retroceso o vacilación"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}