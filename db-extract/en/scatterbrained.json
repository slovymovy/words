                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcede114-1cfb-4ad9-bf75-6b3e66cc29b3",
                                                "sense_id": "d0cc4e4f-050b-3a09-a95c-0ed817fee22a",
                                                "text": "Seine Art zu sprechen hatte etwas Nachlässiges."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7addf92-cd64-3ff1-bf45-d1fda0a94eeb",
                                        "entry_id": "ec73fb22-de6e-3895-be81-2a5572b17e46",
                                        "glosses": [
