                                        "glosses": [
                                            "A crescent-shaped lake formed near a flat-valleyed river when one of its meanders becomes pinched off and isolated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433d0848-da92-440b-af95-b63c2edd0abf",
                                                "sense_id": "634a95a6-b3bf-323c-b3e7-a86cd8269781",
                                                "text": "Humans called this an oxbow lake—one that had originally been part of the river."
                                            }
                                        ]
