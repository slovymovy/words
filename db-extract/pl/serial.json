                                                "sense_id": "1865ebac-ef2c-3521-9604-3e97d8435a14",
                                                "text": "Nachdem der Prototyp erfolgreich getestet wurde, kann das Produkt in Serie gefertigt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
