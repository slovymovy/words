                        "examples": [
                            {
                                "example_id": "6c3c1f6e-f220-44f0-bd59-7a559f002fde",
                                "sense_id": "0183c101-d8ff-3f8b-82f9-8dc24ebe971c",
                                "text": "„Er holte eine Art Meterband aus seiner Jacke und machte sich daran, einen relativ deutlichen Schuhabdruck zu vermessen.“"
                            },
                            {
                                "example_id": "073bc0d4-7bfb-4cc1-a4ec-1ef82eb21cb6",
                                "sense_id": "0183c101-d8ff-3f8b-82f9-8dc24ebe971c",
                                "text": "„Julia holte aus ihrem Rucksack ein Meterband und legte es neben das Objekt auf den Boden.“"
                            },
                            {
                                "example_id": "db026fa6-8134-45d4-9b21-767ef01ed28a",
                                "sense_id": "0183c101-d8ff-3f8b-82f9-8dc24ebe971c",
                                "text": "„Ich brauchte dazu einen neuen Akku-Bohrer für 30 Euro, ein Meterband, Dübel und Schrauben.“"
                            }
