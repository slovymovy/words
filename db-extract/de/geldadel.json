                        "entry_id": "95741f5d-52f6-3575-87ba-447d5b88c983",
                        "glosses": [
                            "Besonderes Ansehen, welches einer Person aufgrund ihrer finanziellen Mittel zufällt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3c57a9-48c0-4379-aa78-711f124f2d14",
                                "sense_id": "4b310fa8-99f8-367b-b6cc-5b9616150d99",
                                "text": "Jeden Freitagabend prahlt er in der Dorfschenke mit seinem Geldadel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bbfc6e29-940d-3031-a141-f75d591dc445",
                        "entry_id": "95741f5d-52f6-3575-87ba-447d5b88c983",
                        "glosses": [
                            "Gesamtheit der Personen, die aufgrund ihres Vermögens in Sphären des gesellschaftlichen Lebens aufgerückt sind, die materiell denen des früheren Hochadels entsprechen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947dfc31-b8ae-4fc7-9947-1639c6b28147",
                                "sense_id": "bbfc6e29-940d-3031-a141-f75d591dc445",
                                "text": "Der Geldadel sucht vor Ort nach neuen Investitionsmöglichkeiten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
