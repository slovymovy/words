                "senses": [
                    {
                        "sense_id": "82a306cf-f305-33d3-a237-1bc55c1eb1ed",
                        "entry_id": "aae6ec5c-eb82-3fb4-826b-379c7c082230",
                        "glosses": [
                            "Deuxième période du Néogène, comprise entre -5,332 et -2,588 millions d’années."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ec6a82-2618-4c60-abc4-a44094f4bb26",
                                "sense_id": "82a306cf-f305-33d3-a237-1bc55c1eb1ed",
                                "text": "Superposition et succession chronologique des couches fossilifères\nQuaternaire :\n[…]\nTertiaire :\nPliocène supérieur.\nPliocène inférieur.\nMiocène supérieur.\n[…]"
                            },
                            {
                                "example_id": "b0c752e7-dc16-489e-821a-a5ac39573518",
                                "sense_id": "82a306cf-f305-33d3-a237-1bc55c1eb1ed",
                                "text": "La flore française contient aussi quelques plantes dont l’origine doit être recherchée dans une migration vers l’Ouest de plantes aralo-caspiennes au Miocène ou au Pliocène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20b985ea-e447-4f44-8fff-e60a0f79f30d",
