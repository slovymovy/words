                        "glosses": [
                            "A tool used primarily by coopers to bore holes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fbb860-11f2-45e2-ba26-618b95001b40",
                                "sense_id": "75d8b489-d121-36b0-9019-a43431acbfa6",
                                "text": "If the foreign body is so firmly fixed as to resist traction, or if it is impossible to seize it, we will find it useful, if its composition will permit, to employ a gimlet or turrel, the instrument being introduced by gliding it along the left index finger."
                            },
                            {
                                "example_id": "876b1687-d860-42df-84bf-8211842c2156",
                                "sense_id": "75d8b489-d121-36b0-9019-a43431acbfa6",
                                "text": "There were plenty of tools in the carpenter's chest, bags of nails, turrels, screws, and iron nuts and bands of all sorts for repairing the yacht."
                            },
                            {
                                "example_id": "d603d778-9aea-4a0d-a192-a250be867b77",
                                "sense_id": "75d8b489-d121-36b0-9019-a43431acbfa6",
                                "text": "Guyon (Fig. 145, a, b, c, d ) bores a turrel ( a cooper's tool ) into the vault of the cranium and trephines with the crown of the instrument set over this."
                            }
                        ]
                    }
