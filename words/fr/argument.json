                        "argument obligatoire"
                    ]
                },
                {
                    "sense_id": "71dd3467-533d-320a-a5c5-e2deda93ce96",
                    "sense_definition": "Bref résumé du sujet d'une pièce de théâtre, d'un opéra ou d'un ouvrage littéraire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "littérature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le programme distribué aux spectateurs contient un court <w>argument</w> détaillant l'intrigue."
                        },
                        {
                            "text": "Avant chaque acte de la pièce, le livret présentait un bref <w>argument</w> analytique."
