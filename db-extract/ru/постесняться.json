                "senses": [
                    {
                        "sense_id": "c336bc06-fab4-3ba7-abbc-7c3278f845a1",
                        "entry_id": "bc1291ee-501f-3730-b6e3-8a4cf3189ef4",
                        "glosses": [
                            "испытать чувство стеснительности, неловкости, смущения, робости"
                        ],
                        "tags": [
                            "кого-чего"
                        ],
                        "examples": [
                            {
                                "example_id": "415a666c-22fb-48e2-860a-a71781060834",
                                "sense_id": "c336bc06-fab4-3ba7-abbc-7c3278f845a1",
                                "text": "― Перестань, Агей, ― вздрогнув на прерванной мысли, сказала та. ― Постеснялся бы чужого человека."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef2b2ee4-6f69-363f-960d-d2cbd6f211ff",
                        "entry_id": "bc1291ee-501f-3730-b6e3-8a4cf3189ef4",
                        "glosses": [
                            "не решиться сделать что-либо из застенчивости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661307f5-f5ed-4a26-9559-81868e45c96e",
                                "sense_id": "ef2b2ee4-6f69-363f-960d-d2cbd6f211ff",
                                "text": "Я хотел спросить: долго ли надо сидеть, но постеснялся такого житейского вопроса на таком, в сущности, трагическом фоне."
                            }
                        ]
                    }
