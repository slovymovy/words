                                            {
                                                "example_id": "d459db6a-6f40-419a-ac7f-0b7496faf597",
                                                "sense_id": "475cd2c0-d05d-37a4-9126-f113931b8fa3",
                                                "text": "Who would excel, when few can make a test / Betwixt indifferent writing and the best?"
                                            }
