                    "sense_definition": "Plagier ou copier l'œuvre d'un autre auteur en y apportant seulement de légères modifications.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plagiat",
                    "name_type": "no",
                    "examples": [
