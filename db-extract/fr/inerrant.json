                        "sense_id": "98171103-cd42-3439-b38d-ddab3d3a8f7e",
                        "entry_id": "fe7cd186-7f0d-36d7-b2de-e27aa66c069c",
                        "glosses": [
                            "Sans erreur, qui n’a pas d’erreur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da73894c-6699-40f5-b1e0-942793a0c8d6",
                                "sense_id": "98171103-cd42-3439-b38d-ddab3d3a8f7e",
                                "text": "C’est par le témoignage inerrant des Écritures à l’œuvre parfaite et achevée d’Incarnation et d’Expiation du Fils de Dieu, que nous pouvons avoir accès, par l’Esprit Saint, au Père et ainsi participer à l’édification du Royaume de Dieu."
                            },
                            {
                                "example_id": "a619cc48-c733-4090-9e95-7a706ca70488",
                                "sense_id": "98171103-cd42-3439-b38d-ddab3d3a8f7e",
                                "text": "Fondamentalement, un texte inerrant ne s’impose pas seulement à la foi de manière absolue, mais aussi de façon nécessaire."
                            }
                        ]
                    }
                ],
