                "senses": [
                    {
                        "sense_id": "48641c38-97b8-3abd-a8af-a79b7773ea43",
                        "entry_id": "68aa964b-c07b-38df-b46d-9b8af4ee62b3",
                        "glosses": [
                            "iemand die vist voor zijn hobby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b1915c-1afb-4e57-918c-513cda45a670",
                                "sense_id": "48641c38-97b8-3abd-a8af-a79b7773ea43",
                                "text": "De sportvissers zien ook baat in een totaal meeneemverbod, iets waar de meeste zich ook nu al - zonder verplichting - aan houden."
                            },
                            {
                                "example_id": "1f9b3c00-b08e-43b7-aa67-36aa5dce1bac",
                                "sense_id": "48641c38-97b8-3abd-a8af-a79b7773ea43",
                                "text": "Met de hulp van een toevallig passerende collega-sportvisser hengelde hij zijn grootste vangst tot nut toe wel binnen. ,,Ik heb meteen mijn vriendin en de kinderen gebeld om ze het te laten zien. Dit moesten ze meemaken. Na een half uurtje fotograferen en meten liet hij de vis weer in het water. ,,De meerval zwom meteen weg. Een half uurtje op het droge; daar kunnen ze wel tegen."
                            },
                            {
                                "example_id": "d90667d7-f18a-4131-8e54-eda1cd1854b0",
                                "sense_id": "48641c38-97b8-3abd-a8af-a79b7773ea43",
                                "text": "Sportvissers hebben samen met het Hoogheemraadschap Hollands Noorderkwartier duizenden vissen gered die zaten opgesloten in een doodlopende gracht in Enkhuizen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99c8e755-4110-46d2-a0e6-08d951749254",
