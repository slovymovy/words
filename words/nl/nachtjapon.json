                    "frequency": "Middle",
                    "semantic_group_id": "nachtkleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze deed haar <w>nachtjapon</w> aan, wenste haar man een goede nacht en knipte het licht uit.",
                            "target_lang_translations": {
                                "en": "She put on her <w>nightgown</w>, wished her husband a good night and turned off the light."
                            }
                        },
                        {
                            "text": "Het meisje droeg een witte <w>nachtjapon</w> met kleine roze bloemetjes toen ze naar beneden kwam.",
                            "target_lang_translations": {
                                "en": "The girl was wearing a white <w>nightgown</w> with small pink flowers when she came downstairs."
                            }
                        },
                        {
                            "text": "In de winter draagt zij altijd een warme <w>nachtjapon</w> van katoen.",
                            "target_lang_translations": {
                                "en": "In the winter she always wears a warm cotton <w>nightgown</w>."
                            }
                        }
                    ],
