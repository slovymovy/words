                    },
                    {
                        "translation_id": "2ada11ef-4cd5-4987-aac0-78beaa0320be",
                        "source_entry_id": "ee32020f-8859-3714-a5ce-f2475b42420d",
                        "source_sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
