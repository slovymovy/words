                                        "glosses": [
                                            "Wand aus mehrere Meter langen, in den Boden gerammten Stahlbohlen, die Baugruben oder Fundamente gegen andrängendes Wasser abschließen oder die Uferränder sichern und befestigen"
                                        ],
                                        "tags": [
                                            "Wasserbau",
                                            "Tiefbau"
                                        ],
