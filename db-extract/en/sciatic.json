                "translations": [
                    {
                        "translation_id": "5cb71425-52bb-491f-96d6-6bd102830096",
                        "source_entry_id": "4288d6a5-74c2-3628-9aa4-07fb678eb757",
                        "source_sense_description": "of, or relating to the ischium",
                        "target_lang_word": "sciatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sciatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                        "entry_id": "619eb44e-a74e-3ca7-b14a-350d352ff9f5",
                                        "glosses": [
                                            "Qui a rapport à la hanche, à l’os ischion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f37e32e-4afe-4414-87f5-8113a85af59c",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Le sciatique est un nerf connu."
                                            },
                                            {
                                                "example_id": "220d1701-129e-4500-abd9-187328c0bf98",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Le mal de dos prend souvent pour noms : « lumbago » (ou « tour de reins »), lié à un début de détérioration du disque intervertébral qui se fissure et s’enflamme à certains endroits, « hernie discale », résultant d’une dégénérescence d’un disque intervertébral, et « sciatique », conséquence de la hernie qui vient comprimer le nerf sciatique, à la jonction entre les deux dernières vertèbres lombaires et le sacrum."
                                            },
                                            {
                                                "example_id": "18eaa6aa-2963-4f58-b42f-b19a970771e8",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Artères, veines sciatiques."
                                            },
                                            {
                                                "example_id": "8f203af4-2fc6-4e1a-9069-c6cb070567c3",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Névralgie sciatique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sciatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                        "entry_id": "07eb965c-f74b-38f9-aa2a-78c41b1d0809",
                                        "glosses": [
                                            "Douleur qui affecte le grand nerf sciatique et qui se fait sentir principalement à la hanche, à l’emboîture des cuisses."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1002d34e-8ecd-4625-924c-cd5e1c4dd4b2",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "Les maladies articulaires sont nommées ainsi en fonction de leur localisation aux différentes articulations du corps : podagre, aux pieds ; chiragre, aux mains ; omagre, à l'épaule ; péchyagre, aux coudes ; gonagre, aux genoux ; rachisagre, à la colonne vertébrale, ischiagre, à la hanche, sciatique, à la cuisse et dysarthrite lorsque la goutte est irrégulière."
                                            },
                                            {
                                                "example_id": "65c9b256-9237-4703-aeb9-b4707811521f",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "Julius sourit avec une accommodante condescendance et, pour changer de sujet, demande à son beau-frère des nouvelles de sa sciatique, qu’il appelle par erreur : son lumbago."
                                            },
                                            {
                                                "example_id": "47de86b5-e54e-4a06-87c9-ad30e5033c42",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "Le mal de dos prend souvent pour noms : « lumbago » (ou « tour de reins »), lié à un début de détérioration du disque intervertébral qui se fissure et s’enflamme à certains endroits, « hernie discale », résultant d’une dégénérescence d’un disque intervertébral, et « sciatique », conséquence de la hernie qui vient comprimer le nerf sciatique, à la jonction entre les deux dernières vertèbres lombaires et le sacrum."
                                            },
                                            {
                                                "example_id": "42547ae2-0e02-4cac-b121-6cc0dd46d6a2",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "[…] pour la sciatique, pour le rhumatisme, & pour semblables maladies, on fait froter la partie avec deux onces d’huile de Millepertuis & une once de bon esprit de vin ; ce meslange est fort resolutif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
