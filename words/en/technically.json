{
    "word_family": [
        "technique",
        "technician",
        "technology",
        "technical"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                    "sense_definition": "According to precise facts, even if they differ from common understanding.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Technically</w>, a tomato is a fruit, not a vegetable."
                        },
                        {
                            "text": "He is <w>technically</w> the owner, but his brother runs the business."
                        }
                    ],
                    "common_phrases": [
                        "technically speaking"
                    ]
                },
                {
                    "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                    "sense_definition": "Based on formal rules or legal status, often despite practical reality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract is <w>technically</w> correct, but it is unfair to the workers."
                        },
                        {
                            "text": "They are <w>technically</w> at war until the treaty is signed."
                        }
                    ],
                    "common_phrases": [
                        "technically correct"
                    ]
                },
                {
                    "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                    "sense_definition": "Regarding the skill or method used to perform a task.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painting is <w>technically</w> impressive, but it lacks emotional depth."
                        },
                        {
                            "text": "She is <w>technically</w> gifted at playing the violin."
                        }
                    ],
                    "synonyms": [
                        "techniquewise"
                    ],
                    "common_phrases": [
                        "technically gifted"
                    ]
                },
                {
                    "sense_id": "00edd874-3624-34f8-a939-6c43e76aedc9",
                    "sense_definition": "In relation to the current capabilities of technology.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>technically</w> impossible to travel faster than light."
                        },
                        {
                            "text": "The project is <w>technically</w> feasible with our new equipment."
                        }
                    ],
                    "synonyms": [
                        "technologically"
                    ],
                    "common_phrases": [
                        "technically impossible"
                    ]
                },
                {
                    "sense_id": "c5d13113-8353-3a61-b58c-7d697e834f58",
                    "sense_definition": "Using specialized or complex terminology.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers discussed the problem <w>technically</w> for several hours."
                        },
                        {
                            "text": "The report is written too <w>technically</w> for a general audience."
                        }
                    ]
                }
            ]
        }
    ]
}