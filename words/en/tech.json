                        "ru": "Техническая репетиция в театре, где отрабатываются свет, звук и смена декораций.",
                        "zh": "戏剧或表演艺术中的技术排练，用于练习灯光、音响和场景切换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техническая репетиция",
                                "target_lang_sense_clarification": "театр"
