                        ]
                    },
                    {
                        "translation_id": "cf980fca-6487-4cf0-9572-285708e8953b",
                        "source_entry_id": "250083f1-393e-34f6-8c76-d4423f4ef07d",
                        "source_sense_id": "dabac7ac-3eb4-371e-9aa9-e1f1219990ae",
                        "target_lang_word": "adiabatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adiabatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd22f29-f343-3b32-9bc7-ac568c8db5fa",
                                        "entry_id": "33a95e0f-4f8b-3a44-a6f6-819c51ef76eb",
                                        "glosses": [
                                            "Se dit d’une transformation d’un système thermodynamique qui se déroule sans aucun échange de chaleur avec l’extérieur, de sorte que l’énergie interne du système ne varie que par le travail échangé avec l’extérieur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a67cfbf-6075-4d93-8f01-07c203c79287",
                                                "sense_id": "7dd22f29-f343-3b32-9bc7-ac568c8db5fa",
                                                "text": "La compression adiabatique d’un gaz sollicite plus d’énergie que la compression plus lente du gaz. La lenteur permettant l’échange de chaleur avec les parois contenant le gaz et ainsi on tend vers la compression isotherme."
                                            },
                                            {
                                                "example_id": "a7d3076b-916c-460d-9fda-8ffe69797c82",
                                                "sense_id": "7dd22f29-f343-3b32-9bc7-ac568c8db5fa",
                                                "text": "Nous allons préciser dans quels cas on peut s’attendre à ce qu’une réaction soit ou non adiabatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb7eecf-090d-3aac-ba77-d1122d8f928f",
                                        "entry_id": "33a95e0f-4f8b-3a44-a6f6-819c51ef76eb",
                                        "glosses": [
                                            "Se dit d’un matériau ou de la frontière d’un système empêchant tout transfert de chaleur avec l’extérieur, que ce soit par conduction, convection ou rayonnement."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e9ee87-f22d-4b66-ba8f-03e035040c3d",
                                                "sense_id": "8fb7eecf-090d-3aac-ba77-d1122d8f928f",
                                                "text": "Des exemples classiques concernent l’isolation thermique (paroi adiabatique dans le cas idéal) ou les transferts de chaleur (parois diathermanes dans le cas idéal)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adiabatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f95d337c-d6a1-36bc-92a9-f03fdfebe9e0",
                                        "entry_id": "a18ab425-1c0b-381d-8a64-9433892800fa",
                                        "glosses": [
                                            "Courbe représentant une transformation adiabatique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6eea5af-c28b-4369-9e8b-3b19450c488b",
                                                "sense_id": "f95d337c-d6a1-36bc-92a9-f03fdfebe9e0",
                                                "text": "Le tracé de quelques isothermes superposées à la courbe précédente montre que les adiabatiques décroissent plus rapidement que les isothermes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
