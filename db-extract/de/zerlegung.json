                ],
                "senses": [
                    {
                        "sense_id": "120b213c-759b-3fab-82e9-8e9a6639c5c9",
                        "entry_id": "f2d051db-bb28-338a-82e4-de9c9f467716",
                        "glosses": [
                            "Aufteilung in meist vorher schon getrennt vorliegende Bestandteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed575484-2c45-4894-a89e-5d7692566fa8",
                                "sense_id": "120b213c-759b-3fab-82e9-8e9a6639c5c9",
                                "text": "„ Auch eine Zerlegung des Schiffs schloss der Geschäftsführer nicht aus.“"
                            },
                            {
                                "example_id": "dd966ecc-0ba3-4867-821f-df90918d97b0",
                                "sense_id": "120b213c-759b-3fab-82e9-8e9a6639c5c9",
                                "text": "„Experten befürchten sogar eine Zerlegung des Konzerns.“"
                            },
                            {
                                "example_id": "d283c3f7-ff05-4b15-a958-e082152d0bda",
                                "sense_id": "120b213c-759b-3fab-82e9-8e9a6639c5c9",
                                "text": "„Die Zerlegung der Rückstellungsansprüche nach Gegenstand und Art der Entziehung sowie die sukzessive Vorgangsweise der Gesetzgebung und die Ausweitung der Opferkreise bedingten für die Geltendmachung der Ansprüche verschiedene Verfahren bei verschiedenen Behörden, die auch zeitlich differenzieren konnten.“"
                            },
                            {
                                "example_id": "69f23eb7-2913-414a-9839-193bd4145330",
                                "sense_id": "120b213c-759b-3fab-82e9-8e9a6639c5c9",
                                "text": "„Wie etwa Peter Sandøe, Bioethiker an der Universität von Kopenhagen, dem britischen Guardian sagte, sei es ganz normal, dass man mit Schulkindern einer solchen Zerlegung beiwohne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
