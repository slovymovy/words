{
    "word_family": [
        "indent",
        "indentation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e396ed4c-f008-31c1-a54d-12c5d93e142b",
                    "sense_definition": "A contract which binds a person to work for another, under specified conditions, for a specified time, often as an apprentice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young apprentice signed the <w>indenture</w> to learn the trade of blacksmithing."
                        },
                        {
                            "text": "After five years of hard work, his <w>indenture</w> was finally cancelled and he was free."
                        }
                    ],
                    "synonyms": [
                        "contract",
                        "agreement",
                        "covenant"
                    ],
                    "common_phrases": [
                        "sign the indenture",
                        "apprentice indenture"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in historical contexts regarding apprenticeships or labor contracts."
                        }
                    ]
                },
                {
                    "sense_id": "1d20f719-d02c-3462-9a4e-2f67cacdc163",
                    "sense_definition": "A formal contract relating to lending, a real estate transaction, or a bankruptcy that imposes additional conditions on one or both parties.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corporate bond <w>indenture</w> contains several restrictive covenants to protect the lenders."
                        },
                        {
                            "text": "Before investing, they carefully reviewed the terms of the trust <w>indenture</w>."
                        }
                    ],
                    "synonyms": [
                        "agreement",
                        "contract"
                    ],
                    "common_phrases": [
                        "bond indenture",
                        "trust indenture"
                    ]
                },
                {
                    "sense_id": "7489edb5-bb86-36b9-9187-bbff723a2e46",
                    "sense_definition": "A physical document, written as duplicates separated by indentations, specifying a contract.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer kept the original <w>indenture</w> locked safely in the wooden desk."
                        },
                        {
                            "text": "They compared the jagged edges of the two copies of the <w>indenture</w> to prove their authenticity."
                        }
                    ],
                    "synonyms": [
                        "deed",
                        "document"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the historical physical format of duplicate documents."
                        }
                    ]
                },
                {
                    "sense_id": "4758d9c1-860c-37e8-86c6-d6cb338320ce",
                    "sense_definition": "An indentation, recess, or deep notch in a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow windows were flanked by deep <w>indentures</w> into the thick stone walls."
                        },
                        {
                            "text": "The coastline was marked by a deep <w>indenture</w> that formed a natural harbor."
                        }
                    ],
                    "synonyms": [
                        "indentation",
                        "recess",
                        "hollow",
                        "cavity"
                    ],
                    "antonyms": [
                        "bulge",
                        "protrusion"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More commonly expressed as 'indentation' in modern English."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfbcec9e-8eed-3372-bf86-9e2873140bfe",
                    "sense_definition": "To bind a person under a contract, especially as an apprentice or laborer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to <w>indenture</w> their son to a local carpenter to learn a trade."
                        },
                        {
                            "text": "Historically, many immigrants were <w>indentured</w> to pay for their passage across the ocean."
                        }
                    ],
                    "synonyms": [
                        "bind",
                        "apprentice"
                    ],
                    "antonyms": [
                        "free",
                        "liberate"
                    ],
                    "common_phrases": [
                        "indenture an apprentice"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in historical contexts."
                        }
                    ]
                },
                {
                    "sense_id": "9e28c871-b4e7-36d4-9d3a-472767abab90",
                    "sense_definition": "To indent; to make hollows, notches, or wrinkles in.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy cartwheels began to <w>indenture</w> the soft muddy path."
                        },
                        {
                            "text": "Time and worry will eventually <w>indenture</w> the smoothest brow with deep lines."
                        }
                    ],
                    "synonyms": [
                        "indent",
                        "furrow",
                        "wrinkle",
                        "groove"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English; 'indent' or 'furrow' is preferred."
                        }
                    ]
                }
            ]
        }
    ]
}