    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aaf3ef86-fdd4-3cc4-998a-2c5de80ec0fd",
                    "sense_definition": "Een uiting van onenigheid of afkeuring tegenover een bepaalde handeling of besluit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meningsuiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er klonk luid <w>protest</w> toen de nieuwe wetswijziging werd aangekondigd.",
                            "target_lang_translations": {
                                "en": "There was a loud <w>protest</w> when the new amendment to the law was announced."
                            }
                        },
                        {
                            "text": "Zonder enig <w>protest</w> accepteerde hij de beslissing van de scheidsrechter.",
                            "target_lang_translations": {
                                "en": "Without any <w>objection</w>, he accepted the referee's decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezwaar",
                        "tegenspraak"
                    ],
                    "antonyms": [
                        "instemming",
                        "goedkeuring"
                    ],
                    "common_phrases": [
                        "luid protest",
                        "teken van protest",
                        "zonder protest"
                    ],
                    "target_lang_definitions": {
                        "en": "An expression of disagreement or disapproval regarding a specific action or decision."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "protest",
                                "target_lang_sense_clarification": "formal objection"
                            },
                            {
                                "target_lang_word": "objection",
                                "target_lang_sense_clarification": "expression of disagreement"
                            },
                            {
                                "target_lang_word": "complaint",
                                "target_lang_sense_clarification": "expression of dissatisfaction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6b464ba-3620-33e0-9a15-44c50a523ca8",
                    "sense_definition": "Een georganiseerde bijeenkomst of actie waarbij mensen gezamenlijk hun ontevredenheid tonen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vreedzame <w>protest</w> op de Dam trok duizenden deelnemers uit het hele land.",
                            "target_lang_translations": {
                                "en": "The peaceful <w>protest</w> on Dam Square attracted thousands of participants from all over the country."
                            }
                        },
                        {
                            "text": "De politie hield toezicht tijdens het <w>protest</w> tegen de klimaatverandering.",
                            "target_lang_translations": {
                                "en": "The police provided supervision during the <w>demonstration</w> against climate change."
                            }
                        }
                    ],
                    "synonyms": [
                        "betoging",
                        "demonstratie"
                    ],
                    "common_phrases": [
                        "vreedzaam protest",
                        "landelijk protest",
                        "protest organiseren"
                    ],
                    "target_lang_definitions": {
                        "en": "An organized meeting or action where people collectively show their dissatisfaction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "protest",
                                "target_lang_sense_clarification": "collective demonstration"
                            },
                            {
                                "target_lang_word": "demonstration",
                                "target_lang_sense_clarification": "public gathering for a cause"
                            },
                            {
                                "target_lang_word": "rally",
                                "target_lang_sense_clarification": "mass meeting to support a cause"
                            }
                        ]
                    }
                }
            ]
        }
    ]
