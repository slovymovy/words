                ],
                "senses": [
                    {
                        "sense_id": "7476a4f1-6dab-3d8c-b3f3-60cfd8bdf49e",
                        "entry_id": "515d366f-7453-3118-a60f-2d4d7cb2efbc",
                        "glosses": [
                            "Qui zigzague."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76f93633-b356-41de-bd9f-27a049c85239",
                                "sense_id": "7476a4f1-6dab-3d8c-b3f3-60cfd8bdf49e",
                                "text": "Ils dépassèrent, sur la route jonchée de fleurs d’acacia, des carrioles zigzagantes, conduites par des drôles qui avaient bu."
                            },
                            {
                                "example_id": "97af43d0-d70f-485e-8977-7f451b698d72",
                                "sense_id": "7476a4f1-6dab-3d8c-b3f3-60cfd8bdf49e",
                                "text": "Déjà ils arrivaient d’un grand pas zigzagant, ils haletaient de fureur, ils cognaient à sa porte."
                            },
                            {
                                "example_id": "8193ee3c-795e-45f6-ac68-9a474b18935d",
                                "sense_id": "7476a4f1-6dab-3d8c-b3f3-60cfd8bdf49e",
                                "text": "Puis, à travers des ruelles grésillantes, nous tirions d’un musée à l’autre une bordée zigzagante pour porter au Titien le salut de Goya, notre copain."
                            },
                            {
                                "example_id": "29251717-b06b-4c05-a285-ba87e3f8185e",
                                "sense_id": "7476a4f1-6dab-3d8c-b3f3-60cfd8bdf49e",
                                "text": "Ils avaient des formes bizarres, un peu floues, zigzagantes et étirées ; des formes de mauvais rêve."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
