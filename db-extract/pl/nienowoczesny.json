                        ]
                    },
                    {
                        "translation_id": "edcd66f4-1b24-49cb-a58a-ac0118d092c8",
                        "source_entry_id": "fa1780d4-74b8-3a3f-b6fd-28692373116d",
                        "source_sense_id": "31280278-56e6-38d8-8177-d27bb343521e",
                        "target_lang_word": "passé",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27c6de78-c5ba-37af-9409-176b1682d415",
                                        "entry_id": "456f6a90-a0b6-3f9c-a805-32927a70f2b5",
                                        "glosses": [
                                            "Dated; out of style; old-fashioned."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd386e55-3265-4137-b08f-d7198dc4696d",
                                                "sense_id": "27c6de78-c5ba-37af-9409-176b1682d415",
                                                "text": "Then, like side fringes, Smirnoff Ice and tights under denim shorts, smoking was suddenly passé – distasteful, even gross."
                                            },
                                            {
                                                "example_id": "4fd011d7-a0d6-40a5-8c0b-fafd8c7ebc5d",
                                                "sense_id": "27c6de78-c5ba-37af-9409-176b1682d415",
                                                "text": "I never thought you'd be a junkie, because heroin is so passé."
                                            },
                                            {
                                                "example_id": "5cf364c3-3332-411a-980d-69e9c96f659c",
                                                "sense_id": "27c6de78-c5ba-37af-9409-176b1682d415",
                                                "text": "We'll paint the town blue 'cause, baby, red is so passé."
                                            },
                                            {
                                                "example_id": "c1dc3f7e-9be2-4469-8d99-c64b64cf2351",
                                                "sense_id": "27c6de78-c5ba-37af-9409-176b1682d415",
                                                "text": "It is perhaps inevitable that a movement that was the height of fashion in the last decade would start to seem passé in this one. That’s how style works; the young and innovative distinguish themselves by breaking with the conventions of their predecessors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb1e4652-3d4b-31d2-8ad7-5426eff1030e",
                                        "entry_id": "456f6a90-a0b6-3f9c-a805-32927a70f2b5",
                                        "glosses": [
                                            "Past one's prime; worn; faded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1340c23d-65cb-4504-9ebb-cc195fea71eb",
                                                "sense_id": "bb1e4652-3d4b-31d2-8ad7-5426eff1030e",
                                                "text": "The coaching stock is in general in a very passé condition, but the ex-royal saloon, though needing a coat of paint outside, as another photograph shows, is spotless inside."
                                            }
                                        ]
                                    }
                                ]
                            },
