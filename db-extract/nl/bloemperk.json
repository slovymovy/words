                            },
                            {
                                "example_id": "52ac5f0a-0ad3-4812-81de-95bd81a8c91a",
                                "sense_id": "582419c6-f1cc-3940-9823-7cca54821ed8",
                                "text": "Het bloemperk heeft regelmatig water nodig.",
