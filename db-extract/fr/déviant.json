                        "cross_references": [
                            {
                                "target_word": "afwijkend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb3b726-cd9e-37e1-9dd9-efc948e9bac1",
                                        "entry_id": "93a4f75b-069a-3542-9a5c-8f34fe833598",
                                        "glosses": [
                                            "niet normaal, meestal in negatieve betekenis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3fdbf94-aff3-47c9-a0b0-8d738c616eb4",
                                                "sense_id": "4cb3b726-cd9e-37e1-9dd9-efc948e9bac1",
                                                "text": "De jongen vertoonde afwijkend gedrag en werd door de meester uit de groep gehaald."
                                            },
                                            {
                                                "example_id": "8c00af96-eb65-4c98-ba5f-dbce5c310aa0",
                                                "sense_id": "4cb3b726-cd9e-37e1-9dd9-efc948e9bac1",
                                                "text": "Dan heeft deze auto ook nog het Style+ pakket (€426) dat bestaat uit chromen sierlijsten, vermoeidheidsherkenning, chromen sierlijsten op de portieren, gekleurde panelen in het dashboard en het dak én de voorste raamstijl en de spiegelkappen in een afwijkende kleur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afwijkend",
