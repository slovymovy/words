                "senses": [
                    {
                        "sense_id": "22b67c89-4b5b-317e-8194-a61c52e3384f",
                        "entry_id": "0efd0012-a840-33f0-b808-1d08e00f52d0",
                        "glosses": [
                            "Menge der Wörter deren sich jemand bedient oder eines bestimmten Fachbereichs; Sprachraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939a4363-ebac-4535-a125-0240d3ea634a",
                                "sense_id": "22b67c89-4b5b-317e-8194-a61c52e3384f",
                                "text": "„Denn ein Großteil der neuen Worte, die jedes Jahr das deutsche Vokabular bereichern, stammt von nörgelnden Politikern.“"
                            },
                            {
                                "example_id": "4c731b42-1594-4153-8dac-161d479ecbaf",
                                "sense_id": "22b67c89-4b5b-317e-8194-a61c52e3384f",
                                "text": "„Der Gebrauch von derbem Vokabular und Schimpfwörtern hatte wesentlichen Anteil an der vom Autor beabsichtigten Provokation:…“"
                            },
                            {
                                "example_id": "c77eded5-0ced-47b9-9e69-9ce5eab735b5",
                                "sense_id": "22b67c89-4b5b-317e-8194-a61c52e3384f",
                                "text": "„Ich hätte ein Reimlexikon benötigt, um dieser Hypothese nachzugehen - wobei ich mich auf jenes Vokabular beschränkt hätte, das bei Matrosen gebräuchlich war.“"
                            },
                            {
                                "example_id": "0743ffdb-971c-4beb-a48b-dcd970ef53f4",
                                "sense_id": "22b67c89-4b5b-317e-8194-a61c52e3384f",
                                "text": "„Das Vokabular der Feuerländer war so klein und ihre in Grunzlauten versunkene Grammatik so simpel und einfältig, dass dieses menschliche Unterscheidungsmerkmal aus Darwins Blickwinkel kaum noch als solches gelten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5501785c-cb39-3d7d-9982-63b071004421",
                        "entry_id": "0efd0012-a840-33f0-b808-1d08e00f52d0",
