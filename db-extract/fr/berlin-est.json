                        "cross_references": [
                            {
                                "target_word": "Восточный Берлин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ec496fc8-9ac0-3c09-b1a0-6e2effb5aaee",
                                        "entry_id": "eed0735a-005e-31ee-9d54-d3f9a8628484",
                                        "glosses": [
                                            "истор. восточная часть города Берлин; в 1949—1990 годах — столица ГДР"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b58da0d-7bf2-44bc-b45b-62a0571dbbd5",
                                                "sense_id": "ec496fc8-9ac0-3c09-b1a0-6e2effb5aaee",
                                                "text": "Мы, что называется, пошли по следу. И выяснили, что Ульбрихта обслуживали те, кто раньше с тем же рвением прислуживал Гитлеру! -Не может быть! Я работал в бюро АПН в Восточном Берлине и знал бы об этом."
                                            },
                                            {
                                                "example_id": "166a3576-6e73-4239-b4a1-2f1f7ee0617e",
                                                "sense_id": "ec496fc8-9ac0-3c09-b1a0-6e2effb5aaee",
                                                "text": "60 лет назад, 17 июня 1953 года советские танки подавили в Восточном Берлине массовые рабочие выступления против низкой зарплаты и высоких цен."
                                            },
                                            {
                                                "example_id": "cd33d56b-7801-48de-be92-337ac8899dd1",
                                                "sense_id": "ec496fc8-9ac0-3c09-b1a0-6e2effb5aaee",
                                                "text": "Но я никогда не жил там в гостиницах, не сиживал в ресторанах. Всё больше пасся на Фридрихштрассе, на Александерплац ― в Восточном Берлине, где чувствовал себя почти как в родном совке…"
                                            }
                                        ]
                                    }
                                ]
                            }
