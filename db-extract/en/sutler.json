                                        "entry_id": "70144278-8aa2-3b0a-8e6d-78cece0a9e61",
                                        "glosses": [
                                            "Marchand autorisé à suivre un corps de troupes et à lui vendre des vivres."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcbb5501-9795-4d41-a7dd-ef160b46e171",
                                                "sense_id": "9a8ba934-78ef-3cf9-81a6-f81d1a94459c",
                                                "text": "Charrette de vivandier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vivandier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c42a7ef5-1b66-3fb2-bbe7-01a7a9793519",
                                        "entry_id": "3e0c5441-03b6-3494-a58e-bab704dc1f00",
                                        "glosses": [
                                            "Qui se rapporte aux vivres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4008e6-1445-45e3-a068-58ad9fd6fe3b",
                                                "sense_id": "c42a7ef5-1b66-3fb2-bbe7-01a7a9793519",
                                                "text": "La grâce volatile des arts, des sciences, de la pensée, défendue avec toute la vigueur du chevalier, avait repoussé aisément les lourdes barriques, le reste du troupeau, tout le puant désordre vivandier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fe9b185-c764-4945-8011-5c1476899dcd",
                        "source_entry_id": "956aa2b7-b5c1-3eec-b886-ca2d07f45d84",
                        "source_sense_description": "a person who follows an army, selling provisions",
                        "target_lang_word": "Marketender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marketender",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb35ec68-2b0f-3894-98ed-ed8b77845eae",
                                        "entry_id": "ff88d997-9bf6-342f-8806-9aa7521808a8",
                                        "glosses": [
                                            "Händler, der eine Einsatztruppe begleitet und die Soldaten verpflegt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a292c42-a489-4630-bf88-f415450309da",
                                                "sense_id": "fb35ec68-2b0f-3894-98ed-ed8b77845eae",
                                                "text": "„Als wir weggetreten waren, stürmten alle zum Marketender, der auf unserem Hof hielt.“"
                                            },
                                            {
                                                "example_id": "1b3e7e53-4d87-45fe-b3c1-a24f76235dfd",
                                                "sense_id": "fb35ec68-2b0f-3894-98ed-ed8b77845eae",
                                                "text": "„Rostow konnte das Geld gerade jetzt besonders gut brauchen, wo die Truppen nach Beendigung des Feldzuges bei Olmütz in Ruhe lagen und wohlversehene Marketender und österreichische Juden, die allerhand verführerische Dinge anboten, das Lager erfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca56728-912c-4e50-a760-710ccbe695a5",
                        "source_entry_id": "956aa2b7-b5c1-3eec-b886-ca2d07f45d84",
                        "source_sense_description": "a person who follows an army, selling provisions",
                        "target_lang_word": "Marketenderin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marketenderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                        "entry_id": "f39e8ab4-33f7-3279-9780-87982aea438d",
                                        "glosses": [
                                            "weibliche Person, die im Gefolge einer Armee als Händlerin mitzieht"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8749bd6-d625-426f-8729-887a737b2735",
                                                "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                                "text": "„Händler und Marketenderinnen schlugen ihre Stände auf und verkauften den Soldaten, was sie begehrten.“"
                                            },
                                            {
                                                "example_id": "b52fbe85-a79b-42b5-9839-b271e36dbd46",
                                                "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                                "text": "„Man denkt beim Tross zuerst an die Marketenderin, die Mann küssen darf, wenn er den Kuss bezahlen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
