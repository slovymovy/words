                        "sense_id": "b332f686-0e07-3fa3-afbe-85931de67d84",
                        "entry_id": "189e296f-789e-343f-9ee1-c7ae4295546a",
                        "glosses": [
                            "The practice or act of dissent."
                        ],
                        "tags": [
                            "nonstandard",
