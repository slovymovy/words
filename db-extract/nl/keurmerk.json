                    },
                    {
                        "sense_id": "8c90e094-ca4b-32d1-be16-735355c5cde9",
                        "entry_id": "b6757660-441a-3974-b279-7df3fbb1327d",
                        "glosses": [
                            "merk dat een aanduiding is van een bepaalde kwaliteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85561a5a-1180-4200-8f34-fa4ba6f786fc",
                                "sense_id": "8c90e094-ca4b-32d1-be16-735355c5cde9",
                                "text": "Deze rookworst heeft het Beter Leven Vlees-keurmerk met 1 ster!!!"
                            },
                            {
                                "example_id": "0d8ca3e0-e87f-48b1-9f6e-dd1c2c592445",
                                "sense_id": "8c90e094-ca4b-32d1-be16-735355c5cde9",
                                "text": "Aan het eind van het jaar moet de nieuwe werkwijze leiden tot het Kangoeroe-keurmerk van de Vereniging van Ouders van Couveusekinderen (VOC). Schiff: \"Die procedure neemt een jaar in beslag, inclusief meerdere toetsmomenten. Het is een prestigieus keurmerk, door ouders toegekend en daardoor zo waardevol.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f608ef6-ea90-467b-b1c7-cedb24c67bad",
                        "source_entry_id": "b6757660-441a-3974-b279-7df3fbb1327d",
                        "source_sense_id": "7d75cb94-f6a3-343d-9c9e-f05300c1f94a",
                        "source_sense_description": "merkteken als bewijs van keuring",
                        "target_lang_word": "Gütesiegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gütesiegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fd7977d-cb6c-35c1-b6d5-005853a28f87",
                                        "entry_id": "64390c79-8728-3eb7-a6e6-0d1a9fc63e02",
                                        "glosses": [
                                            "Zeichen, das auf die Hochwertigkeit (Güte) einer bestimmten Ware hindeutet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d37324-3803-4fac-806e-a6b9356b2b2c",
                                                "sense_id": "4fd7977d-cb6c-35c1-b6d5-005853a28f87",
                                                "text": "„Umfragen von Splendid Research zeigen, dass es 84 % der Studienteilnehmer bei Lebensmitteln wichtig ist, dass diese mit einem Gütesiegel ausgezeichnet sind (Splendid Research, 2013).“"
                                            },
                                            {
                                                "example_id": "83937d24-f2c8-41eb-97d2-4f91f7c41a68",
                                                "sense_id": "4fd7977d-cb6c-35c1-b6d5-005853a28f87",
                                                "text": "„Zur Sicherung der Qualität wurde ein Gütesiegel für Leichte Sprache entwickelt: das Siegel Netzwerk Leichte Sprache.“"
                                            },
                                            {
                                                "example_id": "5bd646fa-d8c5-4e99-bfd6-7464a61130fc",
                                                "sense_id": "4fd7977d-cb6c-35c1-b6d5-005853a28f87",
                                                "text": "„Im Rahmen dieser Arbeit soll auf Basis einer Literaturanalyse die Frage beantwortet werden, ob der Blaue Engel als Gütesiegel positive Auswirkungen auf das umweltspezifische Verhalten von Unternehmen und Verbrauchern hat.“"
                                            },
                                            {
                                                "example_id": "0dab7a9f-92f6-42ae-aee3-eca4095f6d6f",
                                                "sense_id": "4fd7977d-cb6c-35c1-b6d5-005853a28f87",
                                                "text": "„Manche der Gütesiegel sind leicht zu erlangen, manche eher schwer.“"
                                            },
                                            {
                                                "example_id": "561d7c92-9f25-4e65-b5cc-308363f24995",
                                                "sense_id": "4fd7977d-cb6c-35c1-b6d5-005853a28f87",
                                                "text": "„Auch ein Gütesiegel kann helfen, einem Produkt und sogar einem ganzen Unternehmen zu einem umweltfreundlicheren oder fairen Image zu verhelfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
