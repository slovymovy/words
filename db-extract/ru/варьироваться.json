                                                "example_id": "a898e17d-f2d4-4c6c-b9b2-ef6a032393a7",
                                                "sense_id": "67ccaee1-a6b0-3fe3-aec9-40113f4d738a",
                                                "text": "God hath here / Varied his bounty so with new delights."
