                "senses": [
                    {
                        "sense_id": "b05e93c4-5d30-365c-bba6-39b87365c104",
                        "entry_id": "f4b38ad3-04a5-3531-bcd5-ff74c02e9fda",
                        "glosses": [
                            "Gesamtheit militärischer Maßnahmen zur Abwehr von Angriffen aus der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23569af5-c6aa-428e-8da2-b561c9757c94",
                                "sense_id": "b05e93c4-5d30-365c-bba6-39b87365c104",
                                "text": "„Die bodengestützte Luftverteidigung wird reorganisiert: 36 Staffeln Patriot und 24 Staffeln Hawk bleiben aktiv, 12 weitere Staffeln Hawk werden gekadert, drei Gruppen Roland teilgekadert.“"
                            },
                            {
                                "example_id": "fa267647-e5e1-4fad-b02c-e8b544f43aac",
                                "sense_id": "b05e93c4-5d30-365c-bba6-39b87365c104",
                                "text": "„Tage später sagte Admiral William Gortney, damals Chef des US Northern Command und damit auch der kontinentalen Luftverteidigung NORAD, man solle besser annehmen, dass Nordkorea Nordamerika mit Raketen treffen könne – wenngleich mit einer sehr schlechten Erfolgschance.“"
                            },
                            {
                                "example_id": "95c45a12-9f27-491f-b9ca-62ba7bc19463",
                                "sense_id": "b05e93c4-5d30-365c-bba6-39b87365c104",
                                "text": "„Bis Ende 1943 mussten die Alliierten gegen die kampfstarke deutsche Luftverteidigung schwerste Verluste hinnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
