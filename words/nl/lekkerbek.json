            "senses": [
                {
                    "sense_id": "5dcee6c7-0959-3174-abca-31f9b7f3d17e",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>lekkerbekken</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>lekkerbek</w> graag als ik langs de etalage van de banketbakker loop.",
                            "target_lang_translations": {
                                "en": "I love to <w>drool</w> when I walk past the pastry shop window."
                            }
                        },
                        {
                            "text": "Terwijl ik naar het kookprogramma kijk, <w>lekkerbek</w> ik alvast over het avondeten.",
                            "target_lang_translations": {
                                "en": "While watching the cooking show, I am already <w>drooling</w> over dinner."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'lekkerbekken' (to indulge in or anticipate delicious food)."
