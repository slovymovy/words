                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b806dd13-2214-4b8c-8f22-49ccb85691d4",
                        "source_entry_id": "b7502319-5089-3568-9029-2780e4d7c2b8",
                        "target_lang_word": "commutative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
