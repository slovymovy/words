                "senses": [
                    {
                        "sense_id": "4e8cc59b-5b55-3835-bbdb-38b65aa5f1b6",
                        "entry_id": "86dec36d-b58c-3466-a16c-980bd2056541",
                        "glosses": [
                            "een mannelijk persoon met een academische opleiding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6798a50a-b7d5-46a9-a406-f3cc88ffd5ac",
                                "sense_id": "4e8cc59b-5b55-3835-bbdb-38b65aa5f1b6",
                                "text": "Hij was een beroemde academicus op die universiteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44c95210-2a46-4de3-b16c-5b6785abb487",
                        "source_entry_id": "86dec36d-b58c-3466-a16c-980bd2056541",
                        "source_sense_id": "4e8cc59b-5b55-3835-bbdb-38b65aa5f1b6",
                        "source_sense_description": "een mannelijk persoon met een academische opleiding",
                        "target_lang_word": "Akademiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akademiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                        "entry_id": "3512a3fa-36f1-34be-9e45-40c09156c24b",
                                        "glosses": [
                                            "Person, die eine Hochschule erfolgreich besucht und mit Examen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc535cc0-5624-456e-9d48-508266693771",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "Akademiker kann man nur durch eine erfolgreiche Ausbildung an einer Hochschule werden."
                                            },
                                            {
                                                "example_id": "6f9e3b65-5951-4190-9af7-2ff347960087",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "„Ob Personen aus den oberen Strata der Gesellschaft oder Akademiker, mehr und mehr gingen nun dazu über, einander je nach ihrer Akzeptanz oder Ablehnung von Darwins großer Entdeckung geistig und gesellschaftlich einzuordnen.“"
                                            },
                                            {
                                                "example_id": "7e4bcfdb-cc23-417d-b075-f0aecbfc37be",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "„Wie die meisten jungen Akademiker seines Jahrgangs hatte er sich verpflichten lassen, um die Vorstöße der zweiten Welle des dritten Befreiungskriegs zurückzuschlagen.“"
                                            },
                                            {
                                                "example_id": "48b721a8-f78f-40bc-9d68-427bb08f0b86",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "„Die Gruppe junger Akademiker aber ist deshalb besonders interessant, weil sie Trendsetter sein könnte für die weitere Entwicklung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6d02809-eaab-3f0e-a871-4aff34d9ce65",
                                        "entry_id": "3512a3fa-36f1-34be-9e45-40c09156c24b",
                                        "glosses": [
                                            "Mitglied einer Akademie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f703ac-0d5d-4ca1-978f-5eb36635eb0d",
                                                "sense_id": "c6d02809-eaab-3f0e-a871-4aff34d9ce65",
                                                "text": "„Wie glücklich sind doch diese französischen Akademiker! Da sitzen sie im süßesten Seelenfrieden auf ihren sichern Bänken, und sie können ruhig sterben, denn sie wissen, wie bedenklich auch ihre Handlungen gewesen, so wird sie doch der gute Mignet nach ihrem Tode rühmen und preisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
