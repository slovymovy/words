                                                "sense_id": "f7b2f029-3aaa-3b3a-a058-3a61e1ce3fbf",
                                                "text": "Das finnische Wort „poikki“ (kaputt) zeigt durch die Gemination des Buchstabens an, dass dieser lang gesprochen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
