                        "examples": [
                            {
                                "example_id": "8d594473-73c8-4507-b71b-2897ab219b0a",
                                "sense_id": "427855d5-ace4-3ba3-9179-4e5d81844c27",
                                "text": "„Der Kalkgehalt der Böden ist für das Pflanzenwachstum sehr wichtig, da die meisten Pflanzen einen ausgeglichenen Boden-pH im Bereich 5 bis 7,5 benötigen, um ausreichend Nährstoffe aufnehmen zu können.“"
                            },
                            {
                                "example_id": "3ca0f2d6-f0a1-465f-8f23-736a4bf23e15",
                                "sense_id": "427855d5-ace4-3ba3-9179-4e5d81844c27",
                                "text": "„Um den Kalkgehalt von Gesteinen oder Bodenproben zu ermitteln, wird etwas verdünnte Salzsäure aufgetropft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
