                "senses": [
                    {
                        "sense_id": "08a43328-c760-30a1-8277-ddca340a374b",
                        "entry_id": "40a54609-9679-34d4-957f-2481884b61e9",
                        "glosses": [
                            "A computerized music file in the MIDI format."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "450e9abe-a686-435e-a26f-15415c356e8d",
                                "sense_id": "08a43328-c760-30a1-8277-ddca340a374b",
                                "text": "When you collect a group of MIDIs into an album, you can play them much like a CD, with repeat mode, random mode, and a programmed playlist."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
