                "senses": [
                    {
                        "sense_id": "15c2828f-d16e-3302-88d0-9bfcd8d50aef",
                        "entry_id": "e0ca47d1-cbdd-3d53-95ab-b0de0e6cfeb5",
                        "glosses": [
                            "Justesse, conformité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bad42fe-283b-4805-abf7-a555b962fb8c",
                                "sense_id": "15c2828f-d16e-3302-88d0-9bfcd8d50aef",
                                "text": "M. Briand reconnut le bien-fondé de ma demande."
                            },
                            {
                                "example_id": "b7215e0a-d08e-4468-b129-d98e33c6d1d5",
                                "sense_id": "15c2828f-d16e-3302-88d0-9bfcd8d50aef",
                                "text": "S’il y parvient, même partiellement, il fera la démonstration du bien-fondé de cette realpolitik, à laquelle tout autre à sa place se serait également résolu."
                            },
                            {
                                "example_id": "3b9194d0-6588-4e59-94fc-8335bdff85f5",
                                "sense_id": "15c2828f-d16e-3302-88d0-9bfcd8d50aef",
                                "text": "Cette demande doit donc être rejetée, sans qu’il soit besoin d’examiner le bien-fondé de la résiliation."
                            }
                        ]
                    }
                ],
