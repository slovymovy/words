                    "sense_definition": "Sudden, striking, or very noticeable in appearance or effect",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impactful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company saw a <w>dramatic</w> increase in sales after the new marketing campaign launched.",
                            "target_lang_translations": {
                                "ru": "Компания зафиксировала <w>драматический</w> рост продаж после запуска новой маркетинговой кампании."
                            }
                        },
                        {
                            "text": "There has been a <w>dramatic</w> change in the weather since this morning.",
                            "target_lang_translations": {
                                "ru": "С утра погода претерпела <w>резкие</w> изменения."
                            }
                        }
                    ],
