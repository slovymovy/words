                "senses": [
                    {
                        "sense_id": "4fed8b68-a01a-3d71-a43f-28abd8e80997",
                        "entry_id": "89e4bd5f-21b8-33af-b95f-3f9e8287a554",
                        "glosses": [
                            "Transiger à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e422371-2ebe-4f36-adb3-35afbd56fffc",
                                "sense_id": "4fed8b68-a01a-3d71-a43f-28abd8e80997",
                                "text": "La frontière à l'ouest immédiat de Mersin représentait déjà une transaction sur laquelle il ne serait pas équitable de retransiger une seconde fois."
                            },
                            {
                                "example_id": "8958fcc9-4f4c-4ff7-9451-b7c14b701f9a",
                                "sense_id": "4fed8b68-a01a-3d71-a43f-28abd8e80997",
                                "text": "À moins qu'il possède un joueur que Wadell convoite et qu'Ottawa retransige Hossa pour un défenseur et un gardien, une danse à trois équipes finalement. — (s rajouté à la fin de trois équipes)"
                            }
                        ]
                    }
