                        "glosses": [
                            "Action d’effleurer ; résultat, sensation d’être effleuré."
                        ],
                        "tags": [
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4067d7d7-27b6-405c-82a5-a2b721712ff4",
                                "sense_id": "0f5a22ee-ab9d-3297-add6-284200c534a8",
                                "text": "Et que ta bouche d’un effleur,\nSi léger qu’on le sente à peine\nSur ma tristesse se promène\nComme l’âme de quelque fleur."
                            },
                            {
                                "example_id": "46a046ad-d8a0-4c81-a57e-71adc1c993d2",
                                "sense_id": "0f5a22ee-ab9d-3297-add6-284200c534a8",
                                "text": "Nous te devons les monts où bondissent les chèvres,\nEt l’effleur caressant du Songe aux ailes d’or.\nEt le vol des chansons se posant sur nos lèvres."
                            }
                        ]
                    }
