                                    },
                                    {
                                        "sense_id": "983d70ef-ac67-3e8f-ac36-47b4f104dd3d",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "A gamer; a person of video games or similar."
