                                                "example_id": "096186bd-4c02-4464-bb85-0d5f225372bf",
                                                "sense_id": "c662c62d-6071-3a89-9f21-950f365bb0cb",
                                                "text": "medical ward"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d07ea3-b62a-3ba4-967e-5af7d91c4be4",
                                        "entry_id": "25e2fc61-8567-3742-90d5-36c0f1180026",
                                        "glosses": [
                                            "Pertaining to medication specifically (that is, pharmacotherapy), rather than to other aspects of medicine and surgery."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a48109-6deb-466f-994c-bb8b01a357bf",
                                                "sense_id": "09d07ea3-b62a-3ba4-967e-5af7d91c4be4",
                                                "text": "medical oncology, radiation oncology, and surgical oncology"
                                            },
                                            {
                                                "example_id": "50656020-55d9-43cc-9e09-3136ac92f9c9",
                                                "sense_id": "09d07ea3-b62a-3ba4-967e-5af7d91c4be4",
                                                "text": "surgical therapy only when medical therapy fails"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "medical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa47ba1a-be54-38f0-b14c-6cd0ccee08da",
                                        "entry_id": "c2f12408-4bba-3b87-8c75-92fca0952a88",
                                        "glosses": [
                                            "A medical examination."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "516f3b1b-7643-401e-a4fc-f9c42eb04de0",
                                                "sense_id": "fa47ba1a-be54-38f0-b14c-6cd0ccee08da",
                                                "text": "You'll have to get a medical before you apply for that job."
                                            },
                                            {
                                                "example_id": "0aa5327d-1ef9-41fc-be0c-0629259a992b",
                                                "sense_id": "fa47ba1a-be54-38f0-b14c-6cd0ccee08da",
                                                "text": "After completing a medical and the requisite paperwork on Tuesday to seal the deal, Di María said: “I am absolutely delighted to be joining Manchester United. I have thoroughly enjoyed my time in Spain and there were a lot of clubs interested in me, but United is the only club that I would have left Real Madrid for."
                                            },
                                            {
                                                "example_id": "7032e317-16bb-4787-b5cb-83b9a411f646",
                                                "sense_id": "fa47ba1a-be54-38f0-b14c-6cd0ccee08da",
                                                "text": "All UK train drivers must undergo a medical every three years up to the age of 54, and annually from then on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a88a7f-36e5-38b3-9cdd-5d5ac4ed2961",
                                        "entry_id": "c2f12408-4bba-3b87-8c75-92fca0952a88",
                                        "glosses": [
                                            "A medical practitioner."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "200b59e7-3c5f-413e-83b5-c4ec5100ea82",
                                                "sense_id": "96a88a7f-36e5-38b3-9cdd-5d5ac4ed2961",
                                                "text": "We medicals have a better way than that. When we dislike a friend of ours, we dissect him."
                                            },
                                            {
                                                "example_id": "28df03c5-bbe5-4e5c-8737-19dcd945259f",
                                                "sense_id": "96a88a7f-36e5-38b3-9cdd-5d5ac4ed2961",
                                                "text": "There was the school of simplicity, socialism, and universal love, the head of which was a Quixotic Diogenes called Mêh-tsz or Meccius (fifth century b.c.); the school of denominationalists, or pedantic adherents to the letter of absolutely defined principles; the legists, or partisans of a system of repression and punishment (on the Plehve-Pobyedonóschtschoff basis); the astrologists, or believers in occult influences; the medicals or elixirists; the sensualists; and many others, recalling to our minds the various divisions of Greek philosophy at the same period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68196289-426e-4374-80eb-655392ed7288",
