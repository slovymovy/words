                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "950940da-198d-4a6b-8aee-cce1c999c2b4",
                                "sense_id": "39482a59-cf8b-3e58-9cf9-d984a662dd2b",
                                "text": "„›Falls du es noch nicht bemerkt hast, Stolz und Schuld halten diese Scheißwelt am Laufen.‹“"
                            },
                            {
                                "example_id": "1b861e15-2849-4d5d-8965-ebe43b12cf16",
                                "sense_id": "39482a59-cf8b-3e58-9cf9-d984a662dd2b",
                                "text": "„›Die ganze Scheißwelt liebt dich, kleines totes Mädchen, weil du uns den verfickten rechten Weg gezeigt hast.‹“"
                            },
                            {
                                "example_id": "2f4f3cbb-bf5e-4e94-8846-1f4e86a0b697",
                                "sense_id": "39482a59-cf8b-3e58-9cf9-d984a662dd2b",
                                "text": "„Ein paar Antworten würden mir wirklich gut tun. Aber wer in dieser besten aller Scheißwelten könnte sie mir liefern, wenn ich mir selbst sogar einfache Fragen nicht beantworten konnte?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
