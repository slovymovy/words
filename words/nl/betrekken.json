                            {
                                "target_lang_word": "darken",
                                "target_lang_sense_clarification": "of a face or mood"
                            },
                            {
                                "target_lang_word": "become overcast",
                                "target_lang_sense_clarification": "weather condition"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se couvrir",
                                "target_lang_sense_clarification": "en parlant du ciel ou du temps"
                            },
                            {
                                "target_lang_word": "s'assombrir",
                                "target_lang_sense_clarification": "en parlant d'un visage ou du ciel"
