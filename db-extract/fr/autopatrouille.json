                "senses": [
                    {
                        "sense_id": "bc796612-2522-395b-88ab-126c4c4a659f",
                        "entry_id": "119f9ba0-920e-38d2-a54b-250405239db2",
                        "glosses": [
                            "Véhicule de police."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "d05a7619-8fcc-4873-9249-8a79327dde95",
                                "sense_id": "bc796612-2522-395b-88ab-126c4c4a659f",
                                "text": "C’est alors que, répondant à l’appel, leur autopatrouille s’est élancée en direction de ce nouveau point chaud."
                            },
                            {
                                "example_id": "c2cbf590-5c32-438d-bf15-6ddeb87ff868",
                                "sense_id": "bc796612-2522-395b-88ab-126c4c4a659f",
                                "text": "Kwadwo D. Yeboah affirme s’être retrouvé menotté pendant près de 20 minutes la semaine dernière dans une autopatrouille sans raison évidente. Persuadé d’avoir été victime de profilage racial, il entend poursuivre le Service de police de la Ville de Montréal (SPVM)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95a29c85-74ba-4f81-8653-62ef12d9f166",
                        "source_entry_id": "119f9ba0-920e-38d2-a54b-250405239db2",
                        "source_sense_id": "bc796612-2522-395b-88ab-126c4c4a659f",
                        "target_lang_word": "Streifenwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streifenwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                        "entry_id": "ead68c75-1cf4-3872-b4b1-7cbdede4a4d0",
                                        "glosses": [
                                            "Polizeiwagen, mit dem der Streifendienst versehen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a1da28e-ad5c-4fae-8d44-5bd935188559",
                                                "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                                "text": "Wenn ein Streifenwagen in der Nähe ist, fahren die Autofahrer meist besonders langsam."
                                            },
                                            {
                                                "example_id": "705aa5a2-cd8f-4859-9515-0f4b08b562fa",
                                                "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                                "text": "Nach dem Banküberfall wimmelte es rund um die Filiale vor Streifenwagen."
                                            },
                                            {
                                                "example_id": "022165ef-cf43-48fa-bc2b-e57c6f79f75e",
                                                "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                                "text": "„Sie rannte zurück zu dem Streifenwagen, immer noch schreiend, und warf die Tür hinter sich zu.“"
                                            },
                                            {
                                                "example_id": "0edd0745-6d5e-437d-981e-686b7c471c7f",
                                                "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                                "text": "„Der Streifenwagen stoppte fünf Längen hinter mir.“"
                                            },
                                            {
                                                "example_id": "480a47fe-7e25-4a71-bd41-e0501b4a18db",
                                                "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                                "text": "„Nach kurzer Zeit jedoch wurde er von einem Streifenwagen angehalten.“"
                                            },
                                            {
                                                "example_id": "6d271c1c-9b60-4ebb-aaf2-fdb10fa3338b",
                                                "sense_id": "2e486635-3fcb-34c6-992f-3c4661871b80",
                                                "text": "„Ich zog mit meiner Familie von einer Dachstube in die nächste, von denen man jedoch nicht auf die Seine, sondern auf einige der weniger appetitlichen Straßen von Bangor herunterblickte, diejenigen, in denen die Streifenwagen der Polizei immer Samstag nachts um zwei aufzutauchen scheinen“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
