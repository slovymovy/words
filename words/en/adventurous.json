    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e441d26e-bd54-3ba5-aea8-d321c3a204c2",
                    "sense_definition": "Willing to take risks or try new and exciting things.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>adventurous</w> traveler decided to explore the remote mountain village alone.",
                            "target_lang_translations": {
                                "tr": "<w>Maceraperest</w> gezgin, uzak dağ köyünü tek başına keşfetmeye karar verdi."
                            }
                        },
                        {
                            "text": "She has an <w>adventurous</w> spirit and loves trying exotic foods from around the world.",
                            "target_lang_translations": {
                                "tr": "<w>Maceraperest</w> bir ruha sahip ve dünyanın dört bir yanından egzotik yiyecekler denemeyi seviyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "daring",
                        "venturesome",
                        "enterprising"
                    ],
                    "antonyms": [
                        "timid",
                        "shy"
                    ],
                    "common_phrases": [
                        "adventurous spirit",
                        "adventurous traveler"
                    ],
                    "target_lang_definitions": {
                        "tr": "Risk almaya veya yeni ve heyecan verici şeyler denemeye istekli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "maceraperest",
                                "target_lang_sense_clarification": "Maceraya atılmayı seven, cesur kişiler için kullanılır."
                            },
                            {
                                "target_lang_word": "girişken",
                                "target_lang_sense_clarification": "Yeni şeyler denemeye istekli ve cesur anlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f796a03d-f340-3c89-a111-991f64c158e8",
                    "sense_definition": "Involving danger or requiring great courage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They embarked on an <w>adventurous</w> journey across the frozen tundra.",
                            "target_lang_translations": {
                                "tr": "Donmuş tundra boyunca <w>maceralı</w> bir yolculuğa çıktılar."
                            }
                        },
                        {
                            "text": "The climbers faced an <w>adventurous</w> path that required careful planning and skill.",
                            "target_lang_translations": {
                                "tr": "Dağcılar, dikkatli planlama ve beceri gerektiren <w>tehlikeli</w> bir yolla karşı karşıya kaldılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "hazardous",
                        "rash"
                    ],
                    "antonyms": [
                        "safe"
                    ],
                    "common_phrases": [
                        "adventurous journey",
                        "adventurous path"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tehlike içeren veya büyük cesaret gerektiren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "maceralı",
                                "target_lang_sense_clarification": "Serüven dolu, heyecanlı ve riskli durumlar için."
                            },
                            {
                                "target_lang_word": "tehlikeli",
                                "target_lang_sense_clarification": "Risk barındıran, güvenli olmayan durumlar için."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}