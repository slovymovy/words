        "nl-extract.jsonl": [
            {
                "entry_id": "98c87be4-4e6f-30a3-a9c6-2e772cefb76e",
                "word": "eindelijk",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                        "entry_id": "98c87be4-4e6f-30a3-a9c6-2e772cefb76e",
                        "glosses": [
                            "na een (te) lange tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0889e47d-ea7d-471e-9d54-554c8a8a162a",
                                "sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                                "text": "De onthulling van de foto is voor Falcke een grote opluchting. ‘We hebben hier 25 jaar op gewacht. En toen ik eindelijk wist wat eruit kwam, mocht ik er niet over praten. Nu is het openbaar en is deze foto niet meer van ons alleen, maar van iedereen’, laat hij aan de telefoon weten."
                            },
                            {
                                "example_id": "453d9ba0-0ad6-475c-b490-8922d470d3b8",
                                "sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                                "text": "Haar juwelen rinkelden terwijl ze haar zachte, warme armen spreidde voor een langverwachte omhelzing die noodlot was en bestemming, en heel even giechelde ze omdat alles eindelijk logisch was."
                            },
                            {
                                "example_id": "e05a6eda-ce11-42d5-81c5-5b8775f927d5",
                                "sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                                "text": "Hij bezwoer dat hij alleen maar verliefd was geraakt en dat dat helemaal losstond van de lengte van zijn verlof, maar dat er nieuwe verlofdagen kwamen, dat hij elke dag naar haar zou verlangen en zo verder. Toen hij eindelijk wegkwam, was hij even opgelucht als altijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7183e1ee-6ac6-4c72-b244-56fd1b35b751",
                        "source_entry_id": "98c87be4-4e6f-30a3-a9c6-2e772cefb76e",
                        "source_sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                        "source_sense_description": "na een (te) lange tijd.",
                        "target_lang_word": "endlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddc2f28-8165-3404-995b-5f4cd1e1c6b6",
                                        "entry_id": "69ce36dc-0766-3a17-8bf5-5f0aa0c5aeb5",
                                        "glosses": [
                                            "ein Ende habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c58f9d-f5bb-4b99-bd2c-834c85b4446b",
                                                "sense_id": "4ddc2f28-8165-3404-995b-5f4cd1e1c6b6",
                                                "text": "Das Universum ist sehr groß, aber endlich."
                                            },
                                            {
                                                "example_id": "83eb3800-4559-498f-a376-1a081679de57",
                                                "sense_id": "4ddc2f28-8165-3404-995b-5f4cd1e1c6b6",
                                                "text": "Dieser Nachbar zieht demnächst um, und dass bedeutet, wir haben hier ein endliches Problem. Das wird sich von alleine lösen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "endlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                        "entry_id": "5d80ad31-f1ab-3b0a-81fd-255ec5c90518",
                                        "glosses": [
                                            "am Ende, nach langer Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223fe09c-5b08-4858-be21-f49b84603f03",
                                                "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                                "text": "„Das 20. Jahrhundert brachte für Frauen erheblich verbesserte Bildungsmöglichkeiten; außerdem wurde im Jahr 1920 durch einen Zusatzartikel zur Verfassung endlich in allen Bundesstaaten das Frauenwahlrecht eingeführt.“"
                                            },
                                            {
                                                "example_id": "f09159c5-6c93-4dc0-a4c7-6befef4a6ab1",
                                                "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                                "text": "Nach vielen Jahren des Wartens war es endlich soweit."
                                            },
                                            {
                                                "example_id": "6c31fec5-f29a-4ce7-b19f-62f876fbee27",
                                                "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                        "entry_id": "5d80ad31-f1ab-3b0a-81fd-255ec5c90518",
                                        "glosses": [
                                            "doch noch (heiß ersehnt)"
                                        ],
                                        "tags": [
                                            "mit Nachdruck und Gefühlen verbunden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22dbfd52-4da1-4ad4-b982-34ecf17039e2",
                                                "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                                "text": "Na, endlich kommst Du!"
                                            },
                                            {
                                                "example_id": "7a49b80f-b2af-4b13-8e5b-b5714626c4ed",
                                                "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                                "text": "Na, endlich! Was dauert das denn hier so lange!"
                                            },
                                            {
                                                "example_id": "7eb6787b-2e4e-4fbd-b5ea-8f573b72e684",
                                                "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa465446-3d72-42dd-af19-8519d54efbb5",
                        "source_entry_id": "98c87be4-4e6f-30a3-a9c6-2e772cefb76e",
                        "source_sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                        "source_sense_description": "na een (te) lange tijd.",
                        "target_lang_word": "schließlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schließlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                        "entry_id": "d237f612-a5ba-3837-bf2a-2d771f2f1919",
                                        "glosses": [
                                            "endlich, in letzter Konsequenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ec58cd-65e4-4653-9398-76a935a92b73",
                                                "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                                "text": "Dazu konnte er sich schließlich doch noch durchringen."
                                            },
                                            {
                                                "example_id": "3acb7df9-9ebe-4c3b-8897-31993e2c207e",
                                                "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                                "text": "„Nach mehreren heftigen Streitigkeiten und Wortgefechten kam es dann schließlich zu Handgreiflichkeiten.“"
                                            },
                                            {
                                                "example_id": "4c58df77-c105-4b83-b144-8b7963e0d4ac",
                                                "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                                "text": "„Schließlich hatte er die Straßenbahn, die zu meiner Straße fuhr, genommen und war lächelnd und die deutsche Zivilisation bewundernd bei mir angekommen.“"
                                            },
                                            {
                                                "example_id": "efc911bf-e6ae-429d-9b52-5d13733f364e",
                                                "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                                "text": "„Schließlich war Mary Rose keine mittellose Dienstmagd, die nichts weiter als zwei Pence und einen Ersatzunterrock besaß.“"
                                            },
                                            {
                                                "example_id": "920d89cb-9430-4a15-bafc-8bab5537a224",
                                                "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                                "text": "„Die persönlichen Gegenstände waren es, die den Archäologen schließlich die entscheidenden Hinweise auf die Herkunft der Angreifer gaben.“"
                                            },
                                            {
                                                "example_id": "2f2e8c6e-50a1-4ceb-913a-6ada652e8317",
                                                "sense_id": "ee28e942-8796-311d-81b5-d607a9979736",
                                                "text": "„Doch schließlich war die Polymathesis in hundert Bänden abgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dbef9c5-640f-4a53-88ab-aa9022eb3bf8",
                        "source_entry_id": "98c87be4-4e6f-30a3-a9c6-2e772cefb76e",
                        "source_sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                        "source_sense_description": "na een (te) lange tijd.",
                        "target_lang_word": "finally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15585502-d934-3723-843e-72858195c54a",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "At the end or conclusion; ultimately."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4885f8-0eed-452f-a3aa-6f284a654ca1",
                                                "sense_id": "15585502-d934-3723-843e-72858195c54a",
                                                "text": "The contest was long, but the Romans finally conquered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "At bottom; ultimately; when all is considered."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df087c1d-5fbd-4fbb-8a4d-8d3b0a8a2390",
                                                "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                                "text": "In a world in which \"like singing,/ the next day's shriek for ease rises,\" in a world whose \"survivors\" are \"capable of any cry, never done/ clasping in the city's shaken places,\" it is perhaps not surprising to find a dehumanizing but finally protective system of alienation imposing itself."
                                            },
                                            {
                                                "example_id": "6f64760b-5409-406a-bd47-50839ce0edf1",
                                                "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                                "text": "Cyberneticism is, finally, a refined form of scientism, and therefore it is also more dangerous. This form of scientism is not based on linear causality, as mechanistic thought is; rather, it is based on circular causality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "To finish (with); lastly (in the present)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "sequence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "875b37ec-bba3-41ca-8867-2ffd6e05b11b",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            },
                                            {
                                                "example_id": "8df4194e-2089-4c1b-8b70-30bedc67125f",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "Finally, I washed my dog."
                                            },
                                            {
                                                "example_id": "2fad7140-79ff-4eb0-9a5f-6ac67fb4182a",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "Finally, I'd like to thanks all the people who helped to make it this far."
                                            },
                                            {
                                                "example_id": "477d690b-7350-4ee0-84a9-8a77f5d0780f",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "Definitively, comprehensively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4d0e58-62b6-421d-bdba-f19368c907f4",
                                                "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                                                "text": "The question of his long-term success has now been finally settled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e967b85-8afa-48c1-989c-41896142753e",
                        "source_entry_id": "98c87be4-4e6f-30a3-a9c6-2e772cefb76e",
                        "source_sense_id": "ec8c3f8e-7f6a-38c9-b044-37cbb124cd78",
                        "source_sense_description": "na een (te) lange tijd.",
                        "target_lang_word": "finalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                        "entry_id": "f4f6d6f2-dd9d-38d7-96bf-39b85adbd771",
                                        "glosses": [
                                            "Pour en finir ; en dernier résultat ; en dernier lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9b6a3b-89ab-446c-8935-19d67cda8f54",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "C'était la première fois qu'il se risquait au Montparnasse. Ses regards inspectèrent la salle et, finalement, se fixèrent sur la grosse nuque puissante de Feempje."
                                            },
                                            {
                                                "example_id": "7bcae689-8cf8-487a-8cc0-a1d50e89a7e0",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "Les groupes ukrainiens, mexicains, lettons et lituaniens, qui devaient y participer, n’ont finalement pas pu être présents pour entonner la Marseillaise."
                                            },
                                            {
                                                "example_id": "6b44bc53-c853-4b70-8e08-70bdd811a123",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "Le mystère des perturbations de l’orbite de Mercure n'a finalement été élucidé qu'avec la théorie de la relativité générale proposée par Albert Einstein au début du XX^(ème) siècle."
                                            },
                                            {
                                                "example_id": "4f40607c-d72e-4705-abdb-70e234d2e374",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "A Clervaux, les Allemands relancèrent l'assaut contre le château. Finalement les obus à charge creuse eurent raison des épaisses murailles, et des incendies éclatèrent."
                                            },
                                            {
                                                "example_id": "cb7f0848-e257-4684-9810-c858949112bb",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "Une carence en carnitine aboutit à un dysfonctionnement mitochondrial, provoquant finalement la faiblesse musculaire."
                                            },
                                            {
                                                "example_id": "0416a0ff-ccde-4999-b05a-a327c85df4cc",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "La crise du Covid-19 pourrait finalement faire de Bruno Le Maire le ministre de la nationalisation d’Air France et d’un déficit et d’une dette records, dans l’espoir de contenir, «quoi qu’il en coûte», l’incendie économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
