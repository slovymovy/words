                "senses": [
                    {
                        "sense_id": "9f441c1b-d0a7-3bb2-b994-c0144258be78",
                        "entry_id": "2e91c17d-eab5-3a1b-9e91-ac7107099e66",
                        "glosses": [
                            "Adverb, das einen Gegenstand oder Sachverhalt in einen Raum- oder Zeitbezug setzt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13734938-8cf4-4df7-9ec1-52ca83735024",
                                "sense_id": "9f441c1b-d0a7-3bb2-b994-c0144258be78",
                                "text": "Vor allem Lokal- und Temporaladverbien werden als Situierungsadverbien zusammengefasst, z.T. werden aber auch Kausal- und Modaladverbien dazugezählt."
                            },
                            {
                                "example_id": "cdeaf370-77d5-4023-a277-cab84c2e58cc",
                                "sense_id": "9f441c1b-d0a7-3bb2-b994-c0144258be78",
                                "text": "„Situierungsadverbien beziehen sich normalerweise auf den gesamten Satz und sind mit wo, wann, wie oder warum erfragbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
