                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4816fe6-925d-401d-a1c8-3021d1313d31",
                                                "sense_id": "6cb2d28b-dd03-362f-a934-424838d0e64b",
                                                "text": "You inflate a balloon by blowing air into it."
                                            },
                                            {
                                                "example_id": "cef72bde-049a-41cc-8fa3-012407c20a8a",
                                                "sense_id": "6cb2d28b-dd03-362f-a934-424838d0e64b",
                                                "text": "When passion's tumults in the bosom rise, / Inflate the features, and enrage the eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dd71a5c-11ef-3911-bd5d-40f356384d30",
                                        "entry_id": "75699047-44d2-3437-b2db-ae751d36cac0",
                                        "glosses": [
                                            "To enlarge by filling with air (or a gas)."
