                        "source_entry_id": "a6818005-b2be-3653-a2e7-1d27aa073822",
                        "source_sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                        "source_sense_description": "to cease to subscribe to (a feed of another user's activity)",
                        "target_lang_word": "entfolgen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entfolgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                        "entry_id": "963be5c9-7263-3ee9-bf2f-e869a080f914",
                                        "glosses": [
                                            "ein Abonnement eines Social Media-Kontos aufkündigen"
                                        ],
                                        "tags": [
                                            "Netzjargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb8c52b4-5ade-4184-ae4f-c4d803511f06",
                                                "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                                "text": "„Justin Bieber entfolgt Selena Gomez auf Instagram“"
                                            },
                                            {
                                                "example_id": "91274034-7b83-4ecd-9803-ec712811f5c8",
                                                "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                                "text": "„Phil Schiller entfolgt Tony Fadell von Nest auf Twitter“"
                                            },
                                            {
                                                "example_id": "cfb9c0e8-e212-4536-8a04-9fb03ae31fd8",
                                                "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                                "text": "„Das Netz wiederum hat eine ganze Reihe an Vokabeln für Kommunikationsabbruch hervorgebracht: entfolgen, entfreunden, blockieren, verstecken.“"
                                            },
                                            {
                                                "example_id": "2cb64b54-a6ef-44dd-a15e-bdf3c56b76e3",
                                                "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                                "text": "„Erster Schritt, da hat Scherzinger alles richtig gemacht: entfolgen (Message: \"Ich will nichts mehr mit dir zu tun haben!\").“"
                                            },
                                            {
                                                "example_id": "19b54965-2836-4c01-8fba-56609134c819",
                                                "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                                "text": "„Wir freuen uns aber natürlich, dass es bei der Drohung geblieben ist und nichts Schlimmeres passiert ist. Und entfolgen jetzt Steffi Giesinger bei Snapchat. Die geht uns nämlich auf den Sack.“"
                                            },
                                            {
                                                "example_id": "977f257f-150d-416e-a21f-9e33f87f1945",
                                                "sense_id": "362aaa9b-2ce2-3bba-9fd8-99b0c69b5c2d",
                                                "text": "„Du kannst jemanden vollständig entfolgen, indem du »Alle entfolgen« anklickst oder »Nicht mehr folgen«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
