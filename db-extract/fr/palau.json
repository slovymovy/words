                "translations": [
                    {
                        "translation_id": "c3e92e9a-0c3c-46aa-91ad-faf3fb3ce983",
                        "source_entry_id": "049611fd-9101-3f8f-85ed-cd322ed3d44a",
                        "source_sense_id": "6fecc1b5-36db-33ef-b62b-45a79e6de72d",
                        "target_lang_word": "Palau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palau",
