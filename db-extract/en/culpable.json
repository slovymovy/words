                                            {
                                                "example_id": "56a28ffb-2f2a-4cb2-95ed-a9d82fd63109",
                                                "sense_id": "1067eb5d-cfca-3ae2-8ee2-231645b83c5d",
                                                "text": "U blijft dat bedrag schuldig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b59312-6cfa-353e-9327-28ed62a63f9a",
                                        "entry_id": "c58f8a25-07b4-360b-a297-4e1caa5a2664",
                                        "glosses": [
                                            "verplicht"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc452fd3-7ed1-4509-b417-76a089a256f2",
                                                "sense_id": "f4b59312-6cfa-353e-9327-28ed62a63f9a",
                                                "text": "Dat een iegelijk schuldig is zich bij de ware Kerk te voegen"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "schuldig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6b43b6d6-645c-3153-8128-6f41df4b0f85",
                                        "entry_id": "8c8403a7-3f3a-3730-a188-8cb24d7db32f",
                                        "glosses": [
                                            "verantwoordelijk voor een laakbaar/strafbaar feit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e174acc-6672-40c7-a3ae-5bcd89afee60",
                                                "sense_id": "6b43b6d6-645c-3153-8128-6f41df4b0f85",
                                                "text": "Hoewel ik als vader niet veel had kunnen doen, aangezien ze dit proces vooral met haar vriendinnen verwerkte, voelde ik me toch schuldig dat ik er niet voor haar was op dit indrukwekkende moment in haar jonge leven."
                                            },
                                            {
                                                "example_id": "7d3e823b-76fc-4b8d-9405-515e6e9d3f7a",
                                                "sense_id": "6b43b6d6-645c-3153-8128-6f41df4b0f85",
                                                "text": "Daar voel ik me ook schuldig over, maar als er iets is belt hij zijn vader, niet mij."
                                            },
                                            {
                                                "example_id": "00e2c2ed-2107-4be6-91a8-d99a00329849",
                                                "sense_id": "6b43b6d6-645c-3153-8128-6f41df4b0f85",
                                                "text": "Heeft Hannah een punt? En wat als Jos wél wist wat hij deed en dacht dat het ooit zou uitkomen? Of erger nog: wat als ik dat stiekem ook onbewust heb geweten? Ben ik dan schuldig aan zijn schuld? En wat betekent dat? Dat het pact dat we ooit sloten ons allebei gevangen heeft gezet? En dat hij er wel uit móést breken? 'Lot, verraad is pas verraad als het moedwillig gebeurt."
                                            },
                                            {
                                                "example_id": "a6699825-e2cc-40d8-ae8b-64c5144b6678",
                                                "sense_id": "6b43b6d6-645c-3153-8128-6f41df4b0f85",
                                                "text": "Door zijn ontsnappingspoging zal hij bij voorbaat al schuldig lijken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9705a8a9-8399-44bd-822c-381911bf16af",
                        "source_entry_id": "3f4dd2d7-0982-3f37-9caf-9b81c78df2d1",
