                "senses": [
                    {
                        "sense_id": "fcb53f0a-32e9-3963-8357-decc2a64669a",
                        "entry_id": "7b0d4418-a92c-3ea2-a5b1-c12385085251",
                        "glosses": [
                            "endoskopowe badanie jelita grubego przez odbyt; może obejmować również niewielkie zabiegi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6fc988-45b1-43c2-a139-8af27a3ecd48",
                                "sense_id": "fcb53f0a-32e9-3963-8357-decc2a64669a",
                                "text": "Badania dowodzą, że kolonoskopia jest skuteczną metodą zapobiegania nowotworom bliższych i dalszych obszarów jelita grubego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8597f059-4508-4ab8-8e89-54df720e1137",
                        "source_entry_id": "7b0d4418-a92c-3ea2-a5b1-c12385085251",
                        "source_sense_id": "fcb53f0a-32e9-3963-8357-decc2a64669a",
                        "target_lang_word": "colonoscopy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonoscopy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f9f8f6-1b34-312a-8c9f-29646becb35e",
                                        "entry_id": "f80eb9e4-c8c5-343e-a506-64624dc13b2c",
                                        "glosses": [
                                            "The examination of the colon using a colonoscope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4269a5c6-1452-4968-9dd4-d0c6a36c81af",
                                                "sense_id": "e8f9f8f6-1b34-312a-8c9f-29646becb35e",
                                                "text": "Colonoscopy can be expected to identify lesions missed on barium enema, such as small polyps and angiodysplasia. […] Often the preparation of the colon is not ideal, and this can add to the difficulty of performing colonoscopy and interpreting the findings. Tedesco and colleagues reported the results of colonoscopy in 258 patients with rectal bleeding."
                                            },
                                            {
                                                "example_id": "ad524b2f-ce18-4857-9353-184411b7d617",
                                                "sense_id": "e8f9f8f6-1b34-312a-8c9f-29646becb35e",
                                                "text": "Although colonoscopy procedures for routine screenings are not included in that new requirement, surveillance and diagnostic procedures to detect cancer are.\nUnitedHealthCare said in a fact sheet that this change is due to colonoscopies being overutilized."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a7ef677-a9e1-45d0-9778-f95396c930dc",
                        "source_entry_id": "7b0d4418-a92c-3ea2-a5b1-c12385085251",
                        "source_sense_id": "fcb53f0a-32e9-3963-8357-decc2a64669a",
                        "target_lang_word": "koloskopie",
