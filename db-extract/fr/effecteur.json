                    }
                ],
                "senses": [
                    {
                        "sense_id": "36f7d7ea-f1af-329d-9515-b405034ff4bc",
                        "entry_id": "46cf88aa-e7b0-31c9-92d3-edd18458709b",
                        "glosses": [
                            "Efficient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f20048-70a4-4d03-91c8-10906bc3064f",
                                "sense_id": "36f7d7ea-f1af-329d-9515-b405034ff4bc",
                                "text": "Cause effectrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "0858b411-a88e-381e-a271-26ec9232cdd1",
                        "entry_id": "46cf88aa-e7b0-31c9-92d3-edd18458709b",
                        "glosses": [
                            "Qui produit un effet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe90656e-c3d8-44fb-8c3e-d08eb1372d6d",
                                "sense_id": "0858b411-a88e-381e-a271-26ec9232cdd1",
                                "text": "Les mouvements de réponse [à des stimuli] pouvant être confiés tantôt à un organe effecteur, tantôt à l'autre."
                            },
                            {
                                "example_id": "b847f01f-faef-4342-bf35-c4892290b051",
                                "sense_id": "0858b411-a88e-381e-a271-26ec9232cdd1",
                                "text": "Les cellules T naïves qui rencontrent l’antigène présent à la surface d'une CPA arrêtent leur migration, prolifèrent et se différencient en cellules effectrices activées."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                "word": "effecteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3db65cc3-723f-48eb-87e4-ad571c66fd67",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "tags": [
                            "plural"
                        ],
                        "form": "effecteurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1475e010-df48-36a8-a334-5e40ee8cb7bd",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Muscle participant à la motricité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21dcc60d-550b-4c9f-9329-cf7de1f61053",
                                "sense_id": "1475e010-df48-36a8-a334-5e40ee8cb7bd",
                                "text": "Le muscle strié squelettique est un effecteur (ou l’organe effecteur) de la motricité somatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b905399-093d-3c09-8805-cd509abdf8ba",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Substance capable d’activer ou d’inhiber une activité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b05ff51d-0cda-47bd-9409-9bcef5013587",
                                "sense_id": "0b905399-093d-3c09-8805-cd509abdf8ba",
                                "text": "Les molécules agissant sur les enzymes sont des effecteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d64bf74-30e2-31bd-83e3-c229319536ac",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Le gène codant cette substance."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "adc23ef9-63de-324d-af69-f6368a6caaba",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Appareil permettant d’effectuer une fonction."
                        ],
                        "tags": [
                            "Industrie",
                            "Électro-mécanique"
                        ],
                        "examples": [
                            {
                                "example_id": "71d7f26d-86a7-4d6f-8f27-3ed8f9362ce0",
                                "sense_id": "adc23ef9-63de-324d-af69-f6368a6caaba",
                                "text": "Sur une machine à mesurer, le palpeur est l’effecteur de la mesure ; pour les automaticiens, les moteurs d’axes sont les effecteurs du positionnement du palpeur."
                            },
                            {
                                "example_id": "fc34e416-e786-418a-b941-da1695e9e44e",
                                "sense_id": "adc23ef9-63de-324d-af69-f6368a6caaba",
                                "text": "Moteurs, pompes, vérins, vannes, sont des effecteurs si l’on considère uniquement les organes agissant sur l’objet principal (matière) traité par la machine."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe88997e-557e-3669-95be-a1574c471255",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Outils actionnés par les machines-outils qualifiées de « robots »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c7eddd-c894-4adb-9756-2b77c39a00f0",
                                "sense_id": "fe88997e-557e-3669-95be-a1574c471255",
                                "text": "Les effecteurs d’un robot sont les outils (par ex. une visseuse, un dispositif de soudure, un pistolet de peinture) et les organes de préhension (par ex. les pinces, les ventouses)."
                            },
                            {
                                "example_id": "08ae50ee-066b-4a1e-b29d-1385e6db257f",
                                "sense_id": "fe88997e-557e-3669-95be-a1574c471255",
                                "text": "Les robots tueurs sont des robots qui disposent d’effecteurs létaux, ils sont aptes à prendre des décisions en toute autonomie — notamment grâce aux techniques d’intelligence artificielle — comme par exemple déclencher un tir ou détruire une cible."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdbe0715-2571-3077-bb7b-8c9d03a34f1c",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Tout organe capable de produire un effet suite à des facteurs pouvant être modifiés par des rétroactions."
                        ],
                        "tags": [
                            "Cybernétique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2fe2dcc2-9599-3e30-a5ae-f79e2ca25166",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Dispositif d’entrée-sortie en réalité virtuelle permettant l’échange d’informations entre l’utilisateur et l’ordinateur."
                        ],
                        "tags": [
                            "Simulation",
                            "Multimédia"
                        ],
                        "examples": [
                            {
                                "example_id": "58eb2c4e-541d-4c63-9aaa-5c6e5bc9a414",
                                "sense_id": "2fe2dcc2-9599-3e30-a5ae-f79e2ca25166",
                                "text": "Les casques de visualisation, les gants de données sont des effecteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2de95a32-5619-3b9f-8855-4ac296e20dfd",
                        "entry_id": "aafa690e-9561-3197-b896-376eac4ac8d2",
                        "glosses": [
                            "Le médecin, l’organisme (le SAMU, par exemple), qui effectue une garde."
                        ],
                        "tags": [
                            "Jargon administratif médical"
                        ],
                        "examples": [
                            {
                                "example_id": "8bb8ad4d-efec-49ed-a4b0-d671697bba23",
                                "sense_id": "2de95a32-5619-3b9f-8855-4ac296e20dfd",
                                "text": "L’effecteur peut aussi être celui qui organise les gardes, nommé « régulateur »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
