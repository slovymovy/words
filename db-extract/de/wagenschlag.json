                "senses": [
                    {
                        "sense_id": "067a58d9-22b5-3d76-af37-5c12fe1dec90",
                        "entry_id": "b0e64bb7-ec47-373b-9ec3-2122d58586b1",
                        "glosses": [
                            "Tür eines Wagens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87958860-1bf8-4981-a73d-8b637fc78990",
                                "sense_id": "067a58d9-22b5-3d76-af37-5c12fe1dec90",
                                "text": "„Gerade als der Postillion zu Pferd stieg, erschien ein Kammerdiener am Wagenschlag und sagte mir, Seine Excellenz bitte mich hinaufzukommen.“"
                            },
                            {
                                "example_id": "54cec59d-1453-4324-9507-bce61d55db83",
                                "sense_id": "067a58d9-22b5-3d76-af37-5c12fe1dec90",
                                "text": "„Er hielt schließlich neben einer Kreuzung, stellte das Licht und den Motor ab, sprang aus dem Wagen, öffnete die Motorhaube und den Wagenschlag an Haakes Seite und horchte.“"
                            },
                            {
                                "example_id": "87009bdf-f4d8-4e59-aee6-33a6b15b1572",
                                "sense_id": "067a58d9-22b5-3d76-af37-5c12fe1dec90",
                                "text": "„Zufrieden klemmte er eine schwarze Tasche unter den Arm und warf den Wagenschlag zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
