{
    "word_family": [
        "neonicotinoid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37d54d1b-b097-343b-b567-011da6d22efb",
                    "sense_definition": "A chemical element with atomic number 10, which is a colorless and odorless noble gas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemical element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The periodic table lists <w>neon</w> as a noble gas with the symbol Ne.",
                            "target_lang_translations": {
                                "ru": "В периодической таблице <w>неон</w> указан как благородный газ с символом Ne."
                            }
                        },
                        {
                            "text": "Scientists use liquid <w>neon</w> as an efficient cryogenic refrigerant in specialized laboratories.",
                            "target_lang_translations": {
                                "ru": "Ученые используют жидкий <w>неон</w> в качестве эффективного криогенного хладагента в специализированных лабораториях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "liquid neon",
                        "neon gas"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химический элемент с атомным номером 10, представляющий собой благородный газ без цвета и запаха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неон",
                                "target_lang_sense_clarification": "химический элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c686cc9f-1c72-300b-87be-63dfc18cf628",
                    "sense_definition": "Lighting or signs that use glass tubes filled with neon or other gases to produce a bright glow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright <w>neon</w> of the city streets made the night feel like day.",
                            "target_lang_translations": {
                                "ru": "Яркий <w>неон</w> городских улиц заставлял чувствовать ночь как день."
                            }
                        },
                        {
                            "text": "The restaurant had a vintage <w>neon</w> sign hanging in the front window.",
                            "target_lang_translations": {
                                "ru": "В витрине ресторана висела винтажная <w>неоновая</w> вывеска."
                            }
                        }
                    ],
                    "common_phrases": [
                        "neon sign",
                        "neon lights",
                        "bright neon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещение или вывески, в которых используются стеклянные трубки, заполненные неоном или другими газами для создания яркого свечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неон",
                                "target_lang_sense_clarification": "свет или вывески"
                            },
                            {
                                "target_lang_word": "неоновая реклама",
                                "target_lang_sense_clarification": "вывески"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db92905-0f9b-38fc-935a-ee1fb9a61ae4",
                    "sense_definition": "A small, brightly colored freshwater fish often kept in aquariums.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He added a school of <w>neon</w> tetras to his new tropical fish tank.",
                            "target_lang_translations": {
                                "ru": "Он добавил стайку <w>неонов</w> в свой новый аквариум с тропическими рыбками."
                            }
                        },
                        {
                            "text": "The <w>neon</w> is a popular choice for beginners because of its vibrant colors.",
                            "target_lang_translations": {
                                "ru": "<w>Неон</w> — популярный выбор для новичков из-за его яркой окраски."
                            }
                        }
                    ],
                    "synonyms": [
                        "neon tetra"
                    ],
                    "common_phrases": [
                        "neon tetra"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used by aquarium hobbyists"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая ярко окрашенная пресноводная рыбка, которую часто содержат в аквариумах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неон",
                                "target_lang_sense_clarification": "аквариумная рыбка"
                            },
                            {
                                "target_lang_word": "неоновая тетра",
                                "target_lang_sense_clarification": "вид рыбки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "416e89ec-7baa-3030-86f2-79a47a72c428",
                    "sense_definition": "Extremely bright, fluorescent, or glowing in color, similar to the light from a neon sign.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>neon</w> pink jacket so that she would be visible while running.",
                            "target_lang_translations": {
                                "ru": "На ней была <w>неоново-розовая</w> куртка, чтобы её было видно во время пробежки."
                            }
                        },
                        {
                            "text": "The party was decorated with <w>neon</w> colors that glowed under the blacklight.",
                            "target_lang_translations": {
                                "ru": "Вечеринка была оформлена в <w>неоновых</w> тонах, которые светились в ультрафиолете."
                            }
                        }
                    ],
                    "synonyms": [
                        "fluorescent",
                        "luminous",
                        "dayglo"
                    ],
                    "antonyms": [
                        "dull",
                        "matte"
                    ],
                    "common_phrases": [
                        "neon pink",
                        "neon green",
                        "neon colors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно яркий, флуоресцентный или светящийся цвет, похожий на свет неоновой вывески."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неоновый",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "ярко-кислотный",
                                "target_lang_sense_clarification": "очень яркий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}