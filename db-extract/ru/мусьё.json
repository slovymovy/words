        "ru-extract.jsonl": [
            {
                "entry_id": "d51b89e6-dbe2-3398-818d-bac31a781b5c",
                "word": "мусьё",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "000d2b21-e798-30f7-a99d-db5be2711c49",
                        "entry_id": "d51b89e6-dbe2-3398-818d-bac31a781b5c",
                        "glosses": [
                            "устар., прост., то же, что господин ("
                        ],
                        "tags": [
                            "indeclinable"
                        ],
                        "examples": [
                            {
                                "example_id": "f82846b8-d030-4b27-b16d-7ed05ba046f8",
                                "sense_id": "000d2b21-e798-30f7-a99d-db5be2711c49",
                                "text": "Как ты ни зовись, мусьё Наполеон, чем ты ни прикидывайся, а не миновать тебе железной клетки, как Пугачеву: будешь в птичьем ряду в Москве на потеху ребятишкам!"
                            },
                            {
                                "example_id": "c1c1a44f-7f84-4fd3-b2df-4e033dea63a3",
                                "sense_id": "000d2b21-e798-30f7-a99d-db5be2711c49",
                                "text": "С некоторого времени, в Египте и Сирии, Европейцам в фирманах и буюрулды стали давать титул мусьё (monsieur), считаемый выше не совсем почтительного выражения хавага."
                            }
                        ]
                    },
                    {
                        "sense_id": "34bbdc65-4bee-3222-9d8c-b6dfb1187707",
                        "entry_id": "d51b89e6-dbe2-3398-818d-bac31a781b5c",
                        "glosses": [
                            "устар., ирон. вообще француз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e56abe-047c-487b-adb6-dfc998daeef0",
                                "sense_id": "34bbdc65-4bee-3222-9d8c-b6dfb1187707",
                                "text": "Ведь если бы светлейший князь Михайло Илларионович не выгнал Бонапартишки, ведь тебя бы теперь какой-нибудь мусьё палкой по маковке колотил."
                            },
                            {
                                "example_id": "353e1d26-8fc5-404f-a32d-b988ad533c1c",
                                "sense_id": "34bbdc65-4bee-3222-9d8c-b6dfb1187707",
                                "text": "Прачка Палашка, толстая и рябая девка, и кривая коровница Акулька как-то согласились в одно время кинуться матушке в ноги, винясь в преступной слабости и с плачем жалуясь на мусьё, обольстившего их неопытность."
                            }
                        ]
                    }
                ],
                "translations": [],
