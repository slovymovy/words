                        "glosses": [
                            "Wald, in dem die Steineiche der dominierende Baum ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb48c08-68d9-4498-bf3e-4ea53c318ef2",
                                "sense_id": "0e8d599a-9a80-38f0-a441-d2defca70342",
                                "text": "„Hoch und runter auf steinigen Wegen, bei denen jeder Tritt bedacht sein wollte, durch endlos scheinende Steineichenwälder, über Pässe mit wunderbaren Aussichten von 1 200 Metern Höhe bis weit hinaus zum Meer, über die Terrassen mit Olivenbäumen hinunter Richtung Meer, vorbei an duftenden Orangen- und Zitronengärten und zu guter Letzt war es der Küstenweg, der steil zum Meer abfiel und grandiose Fotomotive bot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
