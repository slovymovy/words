                ],
                "senses": [
                    {
                        "sense_id": "e621e746-b5b7-39f8-a625-815be3d8871d",
                        "entry_id": "eb783ea4-b064-35d9-8b67-8b8e803d821a",
                        "glosses": [
                            "sehr eifersüchtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11637174-700c-4193-b154-fdeaeab04e65",
                                "sense_id": "e621e746-b5b7-39f8-a625-815be3d8871d",
                                "text": "„In welchen Schichten ich meine Amouren suchen sollte, überließ er mir und vergraulte mir über Monate meine Freunde, bis ich endlich kapierte, daß der Großvater stockeifersüchtig war.“"
                            },
                            {
                                "example_id": "059d1309-1140-495e-9571-fe82c3a45f8f",
                                "sense_id": "e621e746-b5b7-39f8-a625-815be3d8871d",
                                "text": "„Außerdem hatte Klaus vormittags in der Gemeindeverwaltung zu arbeiten; allerdings war Klaus stockeifersüchtig und stets wachsam.“"
                            },
                            {
