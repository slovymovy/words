                        "examples": [
                            {
                                "example_id": "0f051349-e736-47a2-b76e-8c1ebb63dd20",
                                "sense_id": "28e4a71b-2a3e-328b-86ac-c0e4aa321bf4",
                                "text": "It is plaguily annoying to want a dinner, and have the appetite of a Dando — to be asked for a large debt, when your pockets cannot conceal a solitary shilling […]"
                            },
                            {
                                "example_id": "608c17da-5a29-489b-822e-6b5e4f36cc59",
                                "sense_id": "28e4a71b-2a3e-328b-86ac-c0e4aa321bf4",
                                "text": "[…] have we not made out our case that a Master requires the propensities of Bacchus, with the appetite of a Dando […]"
                            }
                        ]
                    }
                ],
