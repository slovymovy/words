                    "semantic_group_id": "assainissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les techniciens descendent régulièrement dans l'<w>égout</w> pour vérifier l'état des canalisations souterraines."
                        },
                        {
                            "text": "Les fortes pluies d'hier ont provoqué le débordement des <w>égouts</w> dans plusieurs rues du centre-ville."
                        }
                    ],
                    "synonyms": [
                        "collecteur"
                    ],
                    "common_phrases": [
