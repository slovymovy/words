                "senses": [
                    {
                        "sense_id": "5e6c0173-98d4-3534-9201-34b011148834",
                        "entry_id": "6324b871-0c2b-3e02-8f00-640a61191fdd",
                        "glosses": [
                            "Maß dafür, wie ökonomisch, kraftsparend und leistungsorientiert sich ein Läufer beim Laufen fortbewegt – also wie effektiv er die eingesetzte Energie in Vorwärtsbewegung umwandelt"
                        ],
                        "tags": [
                            "Laufsport",
                            "Sportwissenschaft",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "43e7faac-7ad7-40ba-9214-7003ff2943ab",
                                "sense_id": "5e6c0173-98d4-3534-9201-34b011148834",
                                "text": "„Trainieren Sie effizient: Trainieren Sie so effizient wie nie und profitieren Sie von Werten zu Laktatschwelle, VO2max und optional zu Ihrer Laufeffizienz; Dank der erweiterten Performance Analyse können Sie stets Ihren Leistungsfortschritt verfolgen“"
                            },
                            {
                                "example_id": "cc384524-d686-4792-9d91-07ee608d6bce",
                                "sense_id": "5e6c0173-98d4-3534-9201-34b011148834",
                                "text": "„Die Wirkung des Höhentrainings auf die Laufeffizienz kann durch verschiedene Methoden gemessen werden.“"
                            },
                            {
                                "example_id": "08e6e0cb-e9e7-40cd-9ef1-7b648dbdc1ab",
                                "sense_id": "5e6c0173-98d4-3534-9201-34b011148834",
                                "text": "„Ganz ohne Zubehör kann die Laufleistung und Laufeffizienz wie Schrittfrequenz, Schrittlänge und Bodenkontaktzeit ab sofort direkt auf der Smartwatch gemessen werden.“"
                            },
                            {
                                "example_id": "c7f9a6d9-2309-44e2-85aa-32bf0acc1b91",
                                "sense_id": "5e6c0173-98d4-3534-9201-34b011148834",
                                "text": "„Neben der Leistung in Watt gibt es Daten zur Laufeffizienz, dem Trainingsnutzen und der Stamina.“"
                            },
                            {
                                "example_id": "2709e89f-8aea-40f1-96fb-73ee7a6f23f7",
                                "sense_id": "5e6c0173-98d4-3534-9201-34b011148834",
                                "text": "„Trainings-, Planungs- und Analysefunktionen: Laufprofile, Laufeffizienz, Schrittlänge, Schrittfrequenz, Laufleistung, Leistungszustand, Lauftrainings, Laufzeitprognose u.v.m.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "044a5657-6227-369f-9389-4614644f94f1",
                        "entry_id": "6324b871-0c2b-3e02-8f00-640a61191fdd",
