                        "sense_id": "6cb0ef4a-1816-3752-842e-6ccae5605dba",
                        "entry_id": "24952026-d18e-3025-88cf-717e3f6e15ce",
                        "glosses": [
                            "ein Wort oder sonstiger sprachlicher Ausdruck der spanischen Sprache als Entlehnung (zum Beispiel als Fremd- oder Lehnwort) in einer anderen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ede7552-f895-49a8-a99b-a7feedc348d8",
                                "sense_id": "6cb0ef4a-1816-3752-842e-6ccae5605dba",
                                "text": "Hispanismen sind zum Beispiel Paella und Machete."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
