    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86a0af8e-420c-3980-8430-49cc3c41f439",
                    "sense_definition": "Simple past and past participle of <w>lumber</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The huge bear <w>lumbered</w> slowly out of the dark forest into the clearing.",
                            "target_lang_translations": {
                                "nl": "De enorme beer <w>sjokte</w> langzaam het donkere bos uit, de open plek op."
                            }
                        },
                        {
                            "text": "She had been <w>lumbered</w> with the tedious task of organizing the old filing cabinet.",
                            "target_lang_translations": {
                                "nl": "Ze was <w>opgezadeld</w> met de saaie taak om het oude archief te ordenen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lumbered along",
                        "lumbered with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'lumber' (zwaar/log voortbewegen, of opzadelen met iets)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sjouwde",
                                "target_lang_sense_clarification": "zich zwaar of log voortbewegen (verleden tijd)"
                            },
                            {
                                "target_lang_word": "opgezadeld",
                                "target_lang_sense_clarification": "belast met een ongewenste taak (voltooid deelwoord)"
                            },
                            {
                                "target_lang_word": "kloste",
                                "target_lang_sense_clarification": "zwaar en lomp stappen (verleden tijd)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dbac1f7d-4b6d-31cb-9983-4fd4b23aff53",
                    "sense_definition": "Stuck or burdened with an unwanted task, person, or responsibility.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt completely <w>lumbered</w> with extra work while everyone else went home early.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich compleet <w>opgezadeld</w> met extra werk, terwijl iedereen verder vroeg naar huis ging."
                            }
                        },
                        {
                            "text": "We were stuck and felt <w>lumbered</w> by all the confusing rules imposed on us.",
                            "target_lang_translations": {
                                "nl": "We zaten vast en voelden ons <w>belast</w> door alle verwarrende regels die ons waren opgelegd."
                            }
                        }
                    ],
                    "synonyms": [
                        "burdened",
                        "encumbered",
                        "saddled"
                    ],
                    "antonyms": [
                        "free",
                        "unburdened"
                    ],
                    "common_phrases": [
                        "feel lumbered",
                        "lumbered with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used casually to describe being burdened or stuck"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Opgescheept of opgezadeld met een ongewenste taak, verantwoordelijkheid of persoon."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opgezadeld",
                                "target_lang_sense_clarification": "belast met iets vervelends"
                            },
                            {
                                "target_lang_word": "opgescheept",
                                "target_lang_sense_clarification": "zittend met iets ongewensts"
                            },
                            {
                                "target_lang_word": "belast",
                                "target_lang_sense_clarification": "gebukt onder een last of verantwoordelijkheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44769e7e-7c0f-3f75-94b5-9bf96451903f",
                    "sense_definition": "Locked up or confined in prison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was finally caught and found himself regularly <w>lumbered</w> behind bars.",
                            "target_lang_translations": {
                                "nl": "De dief werd uiteindelijk gepakt en zat geregeld <w>achter de tralies</w>."
                            }
                        },
                        {
                            "text": "After the failed robbery attempt, several members of the gang ended up <w>lumbered</w>.",
                            "target_lang_translations": {
                                "nl": "Na de mislukte overvalpoging belandden meerdere bendeleden <w>in de bak</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "imprisoned",
                        "incarcerated",
                        "jailed"
                    ],
                    "antonyms": [
                        "liberated",
                        "released"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "underworld or criminal cant"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Opgesloten in de gevangenis (verouderde dieventaal/slang)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opgesloten",
                                "target_lang_sense_clarification": "in hechtenis gehouden"
                            },
                            {
                                "target_lang_word": "vastgezet",
                                "target_lang_sense_clarification": "in de cel gezet"
                            },
                            {
                                "target_lang_word": "in de bak",
                                "target_lang_sense_clarification": "gevangengezet (informeel)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
