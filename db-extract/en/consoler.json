                                        "sense_id": "0680a299-1607-3c9d-8a34-5a30170f5df2",
                                        "entry_id": "db1c3bc9-0f3e-3011-9fad-c7c2eb2948da",
                                        "glosses": [
                                            "Person, die andere Personen tröstet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8077bdda-ead1-4673-a22c-1ce23fd0ded7",
                                                "sense_id": "0680a299-1607-3c9d-8a34-5a30170f5df2",
                                                "text": "„In einer bestimmten Zeit galten Bartender als die Tröster, Beichtväter und Gesprächspartner der einsamen Trinker.“"
                                            },
                                            {
                                                "example_id": "39129ea5-4ba9-4aab-86e8-42137e8ae8e2",
                                                "sense_id": "0680a299-1607-3c9d-8a34-5a30170f5df2",
                                                "text": "„Die Jesuiten galten als Tröster junger reicher Witwen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34df30e6-5134-4bd0-9b34-ea2b729ede45",
                        "source_entry_id": "53813fdf-6441-3b4b-bc9e-df1dae012a2c",
                        "source_sense_id": "532a69ff-818c-3a0c-ac5f-f11fa38c0d69",
                        "source_sense_description": "one who gives consolation",
                        "target_lang_word": "Trösterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trösterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
