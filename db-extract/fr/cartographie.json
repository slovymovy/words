        "fr-extract.jsonl": [
            {
                "entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                "word": "cartographie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e9918f9-025b-4b5c-95a9-83788fc63c28",
                        "entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cartographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59ada2eb-4b12-3edb-a366-4995726174a1",
                        "entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "glosses": [
                            "Art de dresser les cartes de géographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5269a2a9-007a-4de2-8fac-b4a320466f0e",
                                "sense_id": "59ada2eb-4b12-3edb-a366-4995726174a1",
                                "text": "Ce n'était pas sans raison que Jasper Hobson, après avoir consciencieusement étudié la cartographie de ces terres boréales, s'était dirigé vers le cap Bathurst."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3c48f22-b4f7-3164-a98b-5cceaac39efc",
                        "entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "glosses": [
                            "Ensemble des études et des opérations scientifiques, artistiques et techniques, intervenant à partir des résultats d’observations directes ou de l’exploitation d’une documentation, en vue de l’élaboration et de l’établissement de cartes, plans et autres modes d’expression, ainsi que dans leur utilisation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6d01e3de-f9e8-3dab-83ae-755d445e560b",
                        "entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "glosses": [
                            "Réalisation ou amélioration des cartes géographiques, géologiques, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "49e3794b-0c8c-4991-a5fc-b68f0952a706",
                                "sense_id": "6d01e3de-f9e8-3dab-83ae-755d445e560b",
                                "text": "Nous venions de repartir et de regagner un peu d'altitude, quand on vint m' avertir qu'une chaîne de montagnes était signalée dans notre ouaiche. Je me rendis immédiatement au poste de cartographie, dans la tourelle arrière."
                            },
                            {
                                "example_id": "04ae69bd-d90f-4f55-8ba9-50cab5822def",
                                "sense_id": "6d01e3de-f9e8-3dab-83ae-755d445e560b",
                                "text": "L’observation et la cartographie des formes et des accumulations nous permettent de proposer plusieurs reconstitutions paléogéographiques nouvelles liées aux positions du glacier de l’Arve durant la déglaciation de l’ombilic de Sallanches."
                            },
                            {
                                "example_id": "a89fb69a-91d8-4890-b090-6af18123773d",
                                "sense_id": "6d01e3de-f9e8-3dab-83ae-755d445e560b",
                                "text": "La cartographie des flux migratoires à l’échelle de la planète confirme et illustre cette formule de Gildas Simon. Les flux majeurs se dirigent des Suds vers les Nords, des PVD vers les PID."
                            }
                        ]
                    },
                    {
                        "sense_id": "4602e8ba-81f8-3b1f-8871-e84e0d8a39fe",
                        "entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "glosses": [
                            "Représentation souvent schématique."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "d4fb5ab8-0500-44fd-8d41-f1d799d78dc2",
                                "sense_id": "4602e8ba-81f8-3b1f-8871-e84e0d8a39fe",
                                "text": "C’est dans ce cas qu’une uro-IRM ou un uro-scanner, examens permettant de visualiser les voies urinaires, sont réellement utiles, pour effectuer la cartographie la plus précise possible avant d’opérer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32194a59-51a7-437b-979a-ed4240319393",
                        "source_entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "target_lang_word": "Kartografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0ac224-2a30-3f7a-b22e-54f3686d9927",
                                        "entry_id": "ed1d232a-ec58-32d6-a40d-776b398cbc2f",
                                        "glosses": [
                                            "Wissenschaft und Technik zur Darstellung von topografischen und thematischen Karten, von Vermittlung und Veranschaulichung raumbezogener Informationen der Erde und anderer kosmischer Objekte sowie deren Herstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886a3766-af4c-46b2-867c-e6e9c9ada949",
                                                "sense_id": "8a0ac224-2a30-3f7a-b22e-54f3686d9927",
                                                "text": "Die Kartografie hat sich in den letzten Jahrzehnten stark gewandelt."
                                            },
                                            {
                                                "example_id": "bf74c853-a153-4c4b-91e1-86a3f800479b",
                                                "sense_id": "8a0ac224-2a30-3f7a-b22e-54f3686d9927",
                                                "text": "„Die Sache mit der Kartografie insgesamt ist, dass sie die Dinge in einem Maßstab darstellt, der natürlich nicht der Realität entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c54fef68-3026-4d27-b9ba-b750e5e40226",
                        "source_entry_id": "1a765e24-2953-313e-9388-7889dc7d8d8f",
                        "target_lang_word": "cartography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cartography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f777ff0-6042-3833-879b-30139702ddea",
                                        "entry_id": "84221afc-c1e8-3a50-91ae-f3f3ad541362",
                                        "glosses": [
                                            "The creation of charts and maps based on the layout of a territory's geography."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48750ed6-8bc4-3b9b-b51d-31398c4facc5",
                                        "entry_id": "84221afc-c1e8-3a50-91ae-f3f3ad541362",
                                        "glosses": [
                                            "An illustrative discussion of a topic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045ebb7d-049c-4005-8837-872e7329e631",
                                                "sense_id": "48750ed6-8bc4-3b9b-b51d-31398c4facc5",
                                                "text": "In the early years of my psychedelic research, I sketched a vastly expanded cartography of the psyche that seems to meet this challenge."
                                            },
                                            {
                                                "example_id": "2aed9af0-c5ba-4cab-b871-93a95821dd5f",
                                                "sense_id": "48750ed6-8bc4-3b9b-b51d-31398c4facc5",
                                                "text": "The Dalit feminist standpoint, and more specifically the national Federation of Dalit Women, provide in very clear terms a cartography of governance that forces an official reckoning of a new way of seeing."
                                            },
                                            {
                                                "example_id": "5950f318-296a-45dd-bc9c-b01d67e3bf9b",
                                                "sense_id": "48750ed6-8bc4-3b9b-b51d-31398c4facc5",
                                                "text": "Since this cartography is not a representation of already existing spaces or cinematic forms but is rather oriented towards the new, it could be described as a cartography of the virtual; however, since Ruiz's work makes a point of departing from the normative rules of cinematic construction as a first principle, this book will outline Ruiz's cartography of images as a cartography of the impossible."
                                            },
                                            {
                                                "example_id": "53e7907b-d18a-4d4a-b714-7d18e426ff20",
                                                "sense_id": "48750ed6-8bc4-3b9b-b51d-31398c4facc5",
                                                "text": "In short, the volume aims to provide the reader with the coordinates for current debates in global art and to develop a cartography of the various conceptual and methodological intersections that global art studies is addressing today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf5dc00b-232f-4262-a65e-bf104803549c",
