                    "frequency": "Middle",
                    "semantic_group_id": "units_of_information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот текстовый файл занимает всего один <w>килобайт</w> памяти.",
                            "target_lang_translations": {
                                "en": "This text file takes up only one <w>kilobyte</w> of memory."
                            }
                        },
                        {
                            "text": "Размер маленькой картинки составляет несколько <w>килобайт</w>.",
                            "target_lang_translations": {
                                "en": "The size of a small image is a few <w>kilobytes</w>."
