                "senses": [
                    {
                        "sense_id": "767d7910-f3c0-3f18-9f62-eabe638ab04e",
                        "entry_id": "629d9808-c228-351e-9981-23a8797ce070",
                        "glosses": [
                            "Person, welche Texte auf Rechtschreib- und Grammatikfehler überprüft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f1fbf8d-98a2-4caf-a2f1-ea8328c26242",
                                "sense_id": "767d7910-f3c0-3f18-9f62-eabe638ab04e",
                                "text": "Die Richter überraschten mit der Aussage, dass der Steuerzahler kein Korrekturleser des Finanzamts ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cda539fe-29cf-484b-ac57-2f37774c55d0",
                        "source_entry_id": "629d9808-c228-351e-9981-23a8797ce070",
                        "source_sense_id": "767d7910-f3c0-3f18-9f62-eabe638ab04e",
                        "source_sense_description": "Person, welche Texte auf Rechtschreib- und Grammatikfehler überprüft",
                        "target_lang_word": "correcteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correcteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f09e68ca-6f38-39ef-968a-b6e8f71541ad",
                                        "entry_id": "e53db7b2-06e0-3686-a30b-50f8c3815ae9",
                                        "glosses": [
                                            "Celui qui corrige les erreurs dans un texte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b51f4c-4970-4cd3-8503-3ac153ebde03",
                                                "sense_id": "f09e68ca-6f38-39ef-968a-b6e8f71541ad",
                                                "text": "Il a été désigné comme correcteur au concours de l’école centrale."
                                            },
                                            {
                                                "example_id": "d762f992-94a2-440a-ae5f-71ca21608716",
                                                "sense_id": "f09e68ca-6f38-39ef-968a-b6e8f71541ad",
                                                "text": "À cet examen les correcteurs se sont montrés fort sévères."
                                            },
                                            {
                                                "example_id": "b8581161-adb2-43a6-80c7-264841069a6c",
                                                "sense_id": "f09e68ca-6f38-39ef-968a-b6e8f71541ad",
                                                "text": "Celle-ci, que le correcteur affecte ou non d’en tenir compte, influe sur la note qu'il attribue à votre travail."
                                            },
                                            {
                                                "example_id": "e0cc1141-3945-4e8e-96d3-c0460f1df96e",
                                                "sense_id": "f09e68ca-6f38-39ef-968a-b6e8f71541ad",
                                                "text": "En 2005, il quitte son Nord pour intégrer l’école des correcteurs Formacom, à Pantin (Seine-Saint-Denis), et se consacrer enfin entièrement à ce qui lui plaît vraiment : les anacoluthes et les amphibologies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206dfd49-7b2d-32fd-b98d-45e457af82aa",
                                        "entry_id": "e53db7b2-06e0-3686-a30b-50f8c3815ae9",
                                        "glosses": [
                                            "Celui qui corrige les épreuves avant impression."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de5a6e2-2019-4ac7-9bfd-0ff092a1f5dc",
                                                "sense_id": "206dfd49-7b2d-32fd-b98d-45e457af82aa",
                                                "text": "– […] Et même il est plus que le directeur : c’est lui qui corrige les fautes de tous les autres.\n– C’est-à-dire, reprit l’oncle, en s’adressant à mon père, qu’il est correcteur à l’imprimerie du journal.\n– Ce qui signifie, dit Joseph, qu’il corrige les fautes des imprimeurs, et non pas celles des rédacteurs.\nIl me sembla que c’était encore plus difficile et en tout cas plus glorieux, […]"
                                            },
                                            {
                                                "example_id": "d7ed9d53-d094-447e-a111-aca54e56e778",
                                                "sense_id": "206dfd49-7b2d-32fd-b98d-45e457af82aa",
                                                "text": "Si les affiches et la fausse « une » ont depuis disparu, les correcteurs réviseurs restent partagés entre colère, sidération et incrédulité à l’idée d’être remplacés par l’intelligence artificielle. « S’assurer que le texte est clair et cohérent pour les lecteurs, que la grammaire et l’orthographe sont respectées et que les infos sont vérifiées, aucune machine ne saura faire ça », assure une rédactrice souhaitant conserver l’anonymat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "093fd0da-e60c-3924-bce8-fe48a05fd0cc",
                                        "entry_id": "e53db7b2-06e0-3686-a30b-50f8c3815ae9",
                                        "glosses": [
                                            "Produit de beauté qui cache les imperfections."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d947e0-a6de-436c-8752-de958a6fee72",
                                                "sense_id": "093fd0da-e60c-3924-bce8-fe48a05fd0cc",
                                                "text": "Correcteur de tonalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baffdbd9-0dee-39e0-aec9-31a879bb9b41",
                                        "entry_id": "e53db7b2-06e0-3686-a30b-50f8c3815ae9",
                                        "glosses": [
                                            "Logiciel de correction automatique de l’orthographe, de la grammaire des textes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "correcteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb1b1b8b-7994-3740-a7fd-42143943cf63",
                                        "entry_id": "1c744e41-0f69-3b44-b2cc-17d0f4d219a6",
                                        "glosses": [
                                            "Qui corrige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81214cfe-ec43-4c9e-89e7-fe5b91c00a2b",
                                                "sense_id": "bb1b1b8b-7994-3740-a7fd-42143943cf63",
                                                "text": "Dispositif correcteur."
                                            },
                                            {
                                                "example_id": "f1acc99e-a161-4694-a146-407d660f04bd",
                                                "sense_id": "bb1b1b8b-7994-3740-a7fd-42143943cf63",
                                                "text": "Liquide correcteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8bf454e-6556-40a5-887e-41fc7ee8f107",
                        "source_entry_id": "629d9808-c228-351e-9981-23a8797ce070",
                        "source_sense_id": "767d7910-f3c0-3f18-9f62-eabe638ab04e",
                        "source_sense_description": "Person, welche Texte auf Rechtschreib- und Grammatikfehler überprüft",
                        "target_lang_word": "relecteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc04dc7-d4db-3a8a-9701-501209b54ed1",
                                        "entry_id": "4637e6c6-843d-3a5e-b2bf-9e840fcbfd26",
                                        "glosses": [
                                            "Homme en charge de la relecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc77dbe-ba06-4c3a-86a1-91c97879b288",
                                                "sense_id": "6dc04dc7-d4db-3a8a-9701-501209b54ed1",
                                                "text": "Si l’auteur a une confiance extrême dans son relecteur, il peut accepter d’un seul coup toutes les modifications."
                                            },
                                            {
                                                "example_id": "b866fefb-774e-45ff-97be-8d26b3f1a4ab",
                                                "sense_id": "6dc04dc7-d4db-3a8a-9701-501209b54ed1",
                                                "text": "D'ordinaire, les correcteurs et relecteurs d'épreuves numériques doivent « rattraper » ces mots manqués par la modernité et les yeux électroniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e292730-3cc2-436b-b1b5-907e9efd118f",
                        "source_entry_id": "629d9808-c228-351e-9981-23a8797ce070",
                        "source_sense_id": "767d7910-f3c0-3f18-9f62-eabe638ab04e",
                        "source_sense_description": "Person, welche Texte auf Rechtschreib- und Grammatikfehler überprüft",
                        "target_lang_word": "lecteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Celui qui lit seul et silencieusement un texte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "382930bc-2fd0-4975-800e-1cc6d98c52c8",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "Le lecteur moyen, le lecteur ordinaire la personne normalement instruite qui cherche une information précise dans un domaine quelconque."
                                            },
                                            {
                                                "example_id": "e0592610-23b6-49c5-9361-f74cbf34fc85",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "(Familier) Le lecteur lambda lecteur ordinaire sans compétence particulière dans le domaine concerné, que le jargon rebute et que l’étalage indiscret d’érudition gratuite indispose."
                                            },
                                            {
                                                "example_id": "014fad9c-781c-44aa-a6ec-47b299764eb2",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "Dans un dictionnaire, les définitions sont rédigées dans une langue simple, accessible à tous les lecteurs."
                                            },
                                            {
                                                "example_id": "34ce192e-8e79-462a-9a82-4da5a955a0ef",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "– Hypocrite lecteur, – mon semblable, – mon frère !"
                                            },
                                            {
                                                "example_id": "006ace2d-fac3-461e-a845-e6e60bc57d8a",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "Relisez votre Lettre : il y règne un ordre qui vous décèle à chaque phrase. Je veux croire que votre Présidente est assez peu formée pour ne s’en pas apercevoir : mais qu’importe ? l’effet n'en est pas moins manqué. C’est le défaut des Romans ; l’Auteur se bat les flancs pour s’échauffer, et le Lecteur reste froid. Lettre XXXIII"
                                            },
                                            {
                                                "example_id": "e2133bdf-3c31-4072-8c63-bcdfef9cf49f",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "Diffusé chaque soir à 22 h 55 sur la Une, le programme permet à nos lectrices et à nos lecteurs de retrouver l’esprit des Nuls, le collectif découvert sur Canal+ dans les années 1990, composé d’Alain Chabat himself, de Dominique Farrugia, de Chantal Lauby et de Bruno Carette."
                                            },
                                            {
                                                "example_id": "64de192d-040d-4364-b908-4a5807223937",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "Je n’essaierai pas de donner ici une analyse complète de Faust. Assez d’auteurs l’ont jugé ; et il vaut mieux, d’ailleurs, laisser quelque chose à l’imagination des lecteurs, qui auront à la fin du livre de quoi l’exercer. [G. de N.] Observations."
                                            },
                                            {
                                                "example_id": "f5d7a451-12d2-42cd-b5a2-5eb8a88ab743",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "C’était un exercice à donner le vertige, mais pas autant certainement que se l’imagine le lecteur confortablement assis dans une chambre bien chaude, les pieds au feu et le ventre plein."
                                            },
                                            {
                                                "example_id": "c62a6949-52ff-4283-99e3-808376af21be",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "[…] mais comme j'écris ici un traité il est nécessaire que je mette le lecteur au courant des principes de la science phytosociologique."
                                            },
                                            {
                                                "example_id": "ea86117b-9194-4c80-84bb-07377b71e112",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "Le lecteur lui-même sera tenu dans l'incertitude, sachant de moins en moins au fur et à mesure qu’il avance dans le texte, si les événements qu'on lui rapporte sont réels ou illusoires."
                                            },
                                            {
                                                "example_id": "1287fb9d-091a-4dea-936b-d2f6b592b7bd",
                                                "sense_id": "7ca29596-165c-3a27-b720-4cf0f437f398",
                                                "text": "À quoi servent les faits divers ? […]. En règle générale, à faire du très mauvais journalisme, caressant le lecteur dans ses pulsions malsaines quitte à pulvériser les lignes jaunes du métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0005db7-98d1-36ed-8cb9-e78d1718caf9",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Personne qui lit à haute voix pour une ou plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4fb0a9-9453-4a08-bc59-16d02dceeafc",
                                                "sense_id": "e0005db7-98d1-36ed-8cb9-e78d1718caf9",
                                                "text": "C’est un lecteur médiocre, sa voix est monotone."
                                            },
                                            {
                                                "example_id": "2d171316-51df-4093-adcb-abb99ba4bfdf",
                                                "sense_id": "e0005db7-98d1-36ed-8cb9-e78d1718caf9",
                                                "text": "Dans les maisons d’éducation religieuses, il y a ordinairement un lecteur ou une lectrice de semaine pour lire au réfectoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a93878a-8550-31d5-a605-505bbc9a8a35",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Personne dont l’office, la fonction est de faire la lecture à un personnage important pour le distraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d03cbe00-59c8-4b52-9262-889fbb87a6f3",
                                                "sense_id": "3a93878a-8550-31d5-a605-505bbc9a8a35",
                                                "text": "Lecteur du Roi au Collège de France ; Mlle de Chantoiseau, lectrice de la reine."
                                            },
                                            {
                                                "example_id": "c2bc3e2d-3419-4716-a10e-02091acd79c0",
                                                "sense_id": "3a93878a-8550-31d5-a605-505bbc9a8a35",
                                                "text": "— A propos, dit-il en me rappelant, Marçais vous a-t-il prévenu que vous aurez peut-être l’occasion d'utiliser parfois votre talent de lecteur auprès de la grande-duchesse ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4234a16-6f05-3b40-9854-89f04971a1d6",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Professionnel, employé chargé de choisir les manuscrits que la maison d’édition publiera. Employé d’imprimerie, relecteur, correcteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d9e65e5-8d2e-4e41-974a-5db9dbf7323a",
                                                "sense_id": "e4234a16-6f05-3b40-9854-89f04971a1d6",
                                                "text": "Le lecteur dans une maison d’édition (dont la tâche était de choisir parmi les manuscrits qui lui parvenaient) disparaît au profit de l’initiateur et du concepteur : une très grande partie des livres sont aujourd’hui l’objet de commande."
                                            },
                                            {
                                                "example_id": "306649fb-9e70-48f1-a5a7-a8fb1f922434",
                                                "sense_id": "e4234a16-6f05-3b40-9854-89f04971a1d6",
                                                "text": "Dans l’imprimerie d’aujourd’hui, les lecteurs d’épreuves sont assimilés la plupart du temps à des correcteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad0ba80-8a54-3888-b027-644db490298d",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Régent ou docteur qui enseignait la philosophie, la théologie, dans certains ordres religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8824276-9452-42f4-a55b-1300edf19eae",
                                                "sense_id": "4ad0ba80-8a54-3888-b027-644db490298d",
                                                "text": "Un tel, lecteur en théologie, lecteur en philosophie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b046afa-6c68-38d0-a77a-582af015ad64",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Répétiteur auxiliaire, adjoint au professeur d’une langue ou d’une littérature étrangère, chargé spécialement de l’enseignement pratique de la langue parlée ou écrite, dans certaines universités de divers pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f408ef-2dc3-4b4e-a0da-ecd7717e16c0",
                                                "sense_id": "8b046afa-6c68-38d0-a77a-582af015ad64",
                                                "text": "Lecteur français, lecteur en langue française à l’Université d’Upsal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98485761-132a-3051-b566-28bef778308f",
                                        "entry_id": "03b08eb6-08db-35b5-b56a-1224d967a74c",
                                        "glosses": [
                                            "Celui qui occupe la charge de lectorat, ministère (jusqu’au concile Vatican II : ordre mineur) dans l’Église consistant en la mission de lire la parole divine devant l’assemblée lors des célébrations liturgiques"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c0d18b0-54ee-4f19-a981-79bf17ed0bfd",
                                                "sense_id": "98485761-132a-3051-b566-28bef778308f",
                                                "text": "Le lecteur est institué pour la fonction, qui lui est propre, de lire la parole de Dieu dans l’assemblée liturgique."
                                            },
                                            {
                                                "example_id": "3700252b-5779-4e9c-9daa-7fd2d7199596",
                                                "sense_id": "98485761-132a-3051-b566-28bef778308f",
                                                "text": "Tout aspirant à la prêtrise devait passer par les degrés antérieurs: portier, lecteur, exorciste, acolyte, sous-diacre et diacre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cca1f61-7792-343a-b741-075ef688c81b",
                                        "entry_id": "4c155bbd-bc00-3349-a1ec-c9fd90e595ba",
                                        "glosses": [
                                            "Appareil ou logiciel destiné à transcrire des données codées (texte, image, son, vidéo) en informations compréhensibles par son utilisateur."
                                        ],
                                        "tags": [],
                                        "examples": [
