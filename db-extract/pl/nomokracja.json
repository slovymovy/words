                                        "entry_id": "73ecba9f-8e15-3b5e-8d7b-7a3f727ca30c",
                                        "glosses": [
                                            "staatliche Herrschaft auf der Grundlage von und in Übereinstimmung mit geschriebenem Recht, die ein Recht auf Widerstand ausschließt"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaft",
