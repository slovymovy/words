                ],
                "senses": [
                    {
                        "sense_id": "676ee5ca-11d8-31fa-a6bd-7902f7fb821d",
                        "entry_id": "7e734b13-41d6-31ac-b0ac-940315e8c8e2",
                        "glosses": [
                            "fest installierte Einrichtung auf einem Spielplatz, in einer Sporthalle, einer Fußgängerzone oder dergleichen als Spielmöglichkeit für Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2715759e-641e-45ad-aee8-e07ad6d2fe25",
                                "sense_id": "676ee5ca-11d8-31fa-a6bd-7902f7fb821d",
                                "text": "„Die Frage beschäftige alle, sagt Maike Lohse und erzählt ein Beispiel aus dem Schulalltag: Jemand hatte Spielgeräte zerstört.“"
                            },
                            {
                                "example_id": "dbf573c4-fa52-4282-8669-c9d82eba1bdc",
                                "sense_id": "676ee5ca-11d8-31fa-a6bd-7902f7fb821d",
                                "text": "„Wir gingen auch in den großen und hellen Innenhof, wo es noch immer Spielgeräte für Kinder gab.“"
                            },
                            {
                                "example_id": "1e8a30f5-d88d-4a28-8bfd-a4b22b373f5a",
                                "sense_id": "676ee5ca-11d8-31fa-a6bd-7902f7fb821d",
                                "text": "„Wer sich jedoch eine Basiskompetenz im Spielen angeeignet hat, gerät auch an scheinbar spielfeindlichen, anregungsarmen Orten, auch ohne jegliches Spielgerät, auch ohne Mitspieler, nicht in Verlegenheit, zu sinnvollem Spiel zu finden.“"
                            },
                            {
                                "example_id": "bd90eabb-25c6-42f1-b425-0a5b52d57d4c",
                                "sense_id": "676ee5ca-11d8-31fa-a6bd-7902f7fb821d",
                                "text": "„An allen Wänden stehen und hängen Fernsehapparate, Musikautomaten und Spielgeräte.“"
                            },
                            {
                                "example_id": "83246acc-7b08-481a-91ad-a7f6ca5d3e9b",
                                "sense_id": "676ee5ca-11d8-31fa-a6bd-7902f7fb821d",
                                "text": "„Unbekannte hatten auf einem Spielgerät ein Hakenkreuz und die Worte ‚Los, Donald’ hinterlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "250b68b4-8283-3d46-a803-84cfa033e65e",
                        "entry_id": "7e734b13-41d6-31ac-b0ac-940315e8c8e2",
                        "glosses": [
                            "beweglicher Gegenstand, der für das Spielen bestimmter Sportarten benötigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "566daef6-d8a2-4820-a9c0-9a2a1107041b",
                                "sense_id": "250b68b4-8283-3d46-a803-84cfa033e65e",
                                "text": "„Mit Blick auf das Fußballspielen kann man die Vorstellung von der Spielidee etwa so umschreiben: Es gibt ein Spielgerät (den Ball), das mit dem Fuß oder mit anderen Körperteilen außer Armen und Händen in ein Ziel (das Tor) befördert werden soll.“"
                            },
                            {
                                "example_id": "1acc552d-056a-4eeb-aa75-84378e3d5a3d",
                                "sense_id": "250b68b4-8283-3d46-a803-84cfa033e65e",
                                "text": "„Die Wahl des Spielgeräts, der Spieltechnik, der Spielfeldgröße, der Spielerzahl, der Geräteanzahl, des Spielziels bestimmt wesentlich das Anspruchsniveau des Spiels.“"
                            },
                            {
                                "example_id": "387b5b2b-7e9b-4379-9cc6-dcef5ce154d1",
                                "sense_id": "250b68b4-8283-3d46-a803-84cfa033e65e",
                                "text": "„Das Spielgerät kam indes zurück zum überzeugenden Bentaleb, der Huntelaar vor dessen Treffer mit einem tollen Pass in den freien Raum mustergültig bediente.“"
                            },
                            {
                                "example_id": "f8fc8b59-778c-4320-81a3-cb91d466e40e",
                                "sense_id": "250b68b4-8283-3d46-a803-84cfa033e65e",
                                "text": "„Rollt etwa ein zweiter Ball aufs Spielfeld, helfen sie der Technik bei der Entscheidung, welches davon das eigentliche Spielgerät ist.“"
                            },
                            {
                                "example_id": "cd1cd38a-05a0-4dc6-98d8-8f69eb2768aa",
                                "sense_id": "250b68b4-8283-3d46-a803-84cfa033e65e",
                                "text": "„In der 28. Minute hatte Hannovers Kenan Karaman den Ball an die Unterkante der Latte geköpft, von dort war das Spielgerät auf den Boden, aber nicht hinter die Torlinie geprallt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
