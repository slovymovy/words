                "senses": [
                    {
                        "sense_id": "a8c1adf6-eb12-350e-8d9e-22d7eb2d7b40",
                        "entry_id": "652385ab-99dc-3a92-b6ae-df8a30f0786f",
                        "glosses": [
                            "Gesamtheit von wichtigen, oft als verbindlich oder grundlegend angesehenen Werten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80b657f-1f24-4e9a-929d-659609f0e69a",
                                "sense_id": "a8c1adf6-eb12-350e-8d9e-22d7eb2d7b40",
                                "text": "„Zum afrikaanse Kulturnationalismus gehörte die calvinistische Konfession, vor allem aber die Sprache, die im Mittelpunkt des Wertekanons stand.“"
                            },
                            {
                                "example_id": "2048b0c6-6d46-4e53-817d-fbbecf2f7bff",
                                "sense_id": "a8c1adf6-eb12-350e-8d9e-22d7eb2d7b40",
                                "text": "„Im Palast Heinrichs III. forderte der ›Garten der Lüste‹ die Betrachter auf, die eigene Moral und den höfischen Wertekanon zu den Gegenständen der Bilder in Beziehung zu setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
