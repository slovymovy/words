                        "examples": [
                            {
                                "example_id": "5d3e9a7a-2c1f-4a38-8fb5-7481349280e6",
                                "sense_id": "828c944b-ac5b-315d-8f91-bb0a7b9ffadd",
                                "text": "Ryanair wilde volgens de luchthaven al langer vanaf Eelde vliegen, maar verlangde wel zekerheid dat de start- en landingsbaan zou worden verlengd. Vorige maand werd duidelijk dat die baanverlenging doorgaat."
                            },
                            {
                                "example_id": "da4776cb-2eff-46cd-a341-4d0f437dd009",
                                "sense_id": "828c944b-ac5b-315d-8f91-bb0a7b9ffadd",
                                "text": "De vereniging vindt dat de politiek moet besluiten tot nieuwe steun aan de luchthaven, anders komt de baanverlenging neer op een besluit om de luchthaven over enige tijd te sluiten."
                            }
