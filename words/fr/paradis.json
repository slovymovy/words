                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette île sauvage est un véritable <w>paradis</w> pour les randonneurs."
                        },
                        {
                            "text": "Ils ont acheté une maison au calme, un vrai petit <w>paradis</w> au milieu des vignes."
