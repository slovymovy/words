                    {
                        "sense_id": "f2fe375a-d55c-3b86-a202-5f06bd1def22",
                        "entry_id": "fe2807a7-31cb-304a-bdb7-f4a343a19d1f",
                        "glosses": [
                            "a Nazi propaganda term from the final phase of World War Two referring to secret weapon designs claimed to be revolutionary and capable of winning the war for Germany (many of these were fictional and intended merely to strengthen morale, others were ineffective or not finalized)"
                        ],
                        "tags": [
                            "Nazism",
                            "feminine",
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0556cc22-d4da-3087-8864-4d1b8853ce32",
                        "entry_id": "fe2807a7-31cb-304a-bdb7-f4a343a19d1f",
                        "glosses": [
                            "magic bullet, panacea (a universal solution which solves all problems related to a particular issue)"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3e021e11-5771-4582-99dc-54bc0ddc4c8a",
                                "sense_id": "0556cc22-d4da-3087-8864-4d1b8853ce32",
                                "text": "Tatsächlich gab es 2021 in den USA einen Hype um Ivermectin. Eine Gruppe von Ärzten pries das Medikament als Wunderwaffe gegen Corona, es wirke auch präventiv.",
                                "translation": "In fact, there was hype about Ivermectin in the USA in 2021. A group of doctors praised the drug as a magic bullet against Corona, saying it also had a preventive effect.",
                                "english": "In fact, there was hype about Ivermectin in the USA in 2021. A group of doctors praised the drug as a magic bullet against Corona, saying it also had a preventive effect."
                            }
                        ]
                    }
