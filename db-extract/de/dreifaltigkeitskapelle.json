                "senses": [
                    {
                        "sense_id": "d11fc2fa-6f05-3d60-a15d-d2379c6d21e1",
                        "entry_id": "4036cd00-15de-3d43-89a3-296420e81e58",
                        "glosses": [
                            "Kapelle, die der Dreifaltigkeit von Gottvater, Jesus und dem heiligen Geist geweiht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6f3ac3-776e-44c3-a4fb-7b97238e4dda",
                                "sense_id": "d11fc2fa-6f05-3d60-a15d-d2379c6d21e1",
                                "text": "„Am Altenheim „St. Hildegard“ vorbei führt die Straße zur Dreifaltigkeitskapelle von 1712.“"
                            },
                            {
                                "example_id": "6de6ed10-d9e1-4497-9021-1ecf979e9767",
                                "sense_id": "d11fc2fa-6f05-3d60-a15d-d2379c6d21e1",
                                "text": "„Hettensberg besitzt eine Kapelle, die zur Schutzheiligen die allerheiligste Dreifaltigkeit hat, die deshalb den Namen \"Dreifaltigkeitskapelle\" trägt.“"
                            },
                            {
                                "example_id": "9ce56d0f-0a05-4acf-9c4e-04a228493d23",
                                "sense_id": "d11fc2fa-6f05-3d60-a15d-d2379c6d21e1",
                                "text": "„Das katholische Dekanat Pforzheim hat im Internet einen Kapellenrundweg veröffentlicht, worin man auch die Dreifaltigkeitskapelle findet.“"
                            },
                            {
                                "example_id": "ad121716-1335-4e9b-b845-3a1cf3f2c697",
                                "sense_id": "d11fc2fa-6f05-3d60-a15d-d2379c6d21e1",
                                "text": "„In Freyming findet man auch nennenswerte Kulturgüter wie die schlichte Dreifaltigkeitskapelle (Chapelle de la Trinité) mit einem schönen Kruzifix aus dem Jahr 1755.“"
                            },
                            {
                                "example_id": "497a5746-d3b4-4dcb-ac26-adb0d2b9108f",
                                "sense_id": "d11fc2fa-6f05-3d60-a15d-d2379c6d21e1",
                                "text": "„Die Dreifaltigkeitskapelle die jeden Barockliebhaber überrascht, gilt als Rokokojuwel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
