                "senses": [
                    {
                        "sense_id": "ce9b92c0-c1db-35bf-8f2c-903ce796de12",
                        "entry_id": "e0f7922b-80fc-3d36-b1a6-9eb8aef31d79",
                        "glosses": [
                            "Rivière de la région de Bruxelles en Belgique, affluent de la Dyle."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "4b99335f-0101-46a3-9c58-83ce54e6783b",
                                "sense_id": "ce9b92c0-c1db-35bf-8f2c-903ce796de12",
                                "text": "Le Pajottenland et la vallée de la Senne sont réputés pour le lambic, la gueuze et la kriek : trois bières à fermentation spontanée. Aucune levure n'est ajoutée au brassin."
                            },
                            {
                                "example_id": "201f6e0b-00f9-4ee7-875b-236c2fa90b51",
                                "sense_id": "ce9b92c0-c1db-35bf-8f2c-903ce796de12",
                                "text": "Joseph Delorme a découvert\n Un ruisseau si clair et si vert\n Qu’il donne aux malheureux l’envie\n D’y terminer leur triste vie.\n — Je sais un moyen de guérir\n De cette passion malsaine\n Ceux qui veulent ainsi périr :\n Menez-les aux bords de la Senne."
                            }
                        ]
                    },
                    {
                        "sense_id": "180eeb58-ce77-3e2e-8e44-d69ae26247ce",
                        "entry_id": "e0f7922b-80fc-3d36-b1a6-9eb8aef31d79",
                        "glosses": [
                            "Rivière des régions d’Ashanti et Brong-Ahafo au Ghana, se déversant dans le lac Volta."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    },
