                                        "sense_id": "fe67b1dc-cc94-3e2e-b7cf-e84b8261e6d7",
                                        "entry_id": "2593c676-a73e-3432-953c-d1b85e37670c",
                                        "glosses": [
                                            "narząd w postaci cienkiej wydłużonej rureczki, służący do składania jaj, występujący u samic wielu gatunków owadów, pajęczaków i niektórych ryb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14a18d55-91bd-4303-9fae-382ea3fecb7f",
                                                "sense_id": "fe67b1dc-cc94-3e2e-b7cf-e84b8261e6d7",
                                                "text": "U samców niektórych ryb występuje pokładełko służące do zapładniania ikry."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de7b9107-07e4-41ae-a075-ea41a776c76b",
                        "source_entry_id": "2cab1017-d17d-33bd-abcc-1b584e0019ce",
                        "source_sense_id": "d2aa2ceb-c011-3255-921b-df986795c7d4",
                        "target_lang_word": "ovipositeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovipositeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14f66b37-36c4-342e-8c08-40f2e9e3a0ca",
                                        "entry_id": "c68f5e56-99ba-39d4-8c6e-340f0a034a58",
                                        "glosses": [
                                            "Appareil des insectes ou poissons, destiné à déposer les œufs à l’endroit où ils vont éclore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77495a32-bf65-4335-99d1-c0b339157d30",
                                                "sense_id": "14f66b37-36c4-342e-8c08-40f2e9e3a0ca",
                                                "text": "Certains parasitoïdes ont un ovipositeur très long pour fouiller dans les profondeurs du support où s’est enfoui leur hôte."
                                            },
                                            {
                                                "example_id": "b1dc2ae8-a4a3-4029-8b3a-b3e0cee77859",
                                                "sense_id": "14f66b37-36c4-342e-8c08-40f2e9e3a0ca",
                                                "text": "Mais l’histoire se termine toujours de la même manière : la charançonne finit par percer le tégument. Elle se retourne, introduit l’ovipositeur qui pointe à l’extrémité de son abdomen et dépose un œuf au cœur du fruit, dans un des deux cotylédons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1f34c97-e07f-4e73-a41e-1504903bbde5",
                        "source_entry_id": "2cab1017-d17d-33bd-abcc-1b584e0019ce",
                        "source_sense_id": "d2aa2ceb-c011-3255-921b-df986795c7d4",
                        "target_lang_word": "oviscapte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oviscapte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "814b7986-a5e9-34d6-9059-65b50b1ef156",
                                        "entry_id": "36c48b86-8a6d-3cd2-bfa8-30899f84f5ae",
                                        "glosses": [
                                            "Prolongement de l’abdomen de certains insectes, à l’aide duquel les femelles font des trous pour loger leurs œufs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd82725d-298e-4ef7-a402-c996400142f2",
                                                "sense_id": "814b7986-a5e9-34d6-9059-65b50b1ef156",
                                                "text": "Tandem du leste à forceps (Lestes forcipatus) : à l’aide de son oviscapte, la femelle, retenue par le mâle, insère un à un ses œufs dans le tissu végétal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
