                ],
                "senses": [
                    {
                        "sense_id": "8e05be76-2da4-3b29-b800-fe0b6d6ae0d9",
                        "entry_id": "17045aec-bcd0-3fcd-897c-9ad3e8677ce5",
                        "glosses": [
                            "unterste Stufe einer deutschen Beamtenlaufbahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe755abc-41e8-410b-8118-503e6b9d7e54",
                                "sense_id": "8e05be76-2da4-3b29-b800-fe0b6d6ae0d9",
                                "text": "„Anmeldung und Teilnahme setzen die Betrauung mit den Aufgaben eines Dienstpostens voraus, der mindestens dem Eingangsamt der angestrebten Ämter entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                        "entry_id": "17045aec-bcd0-3fcd-897c-9ad3e8677ce5",
                        "glosses": [
                            "Stelle der Zollbehörde für eingehende Waren"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "34bbef75-43d1-4e03-a108-2605eefc821b",
                                "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                                "text": "Bei Zollangelegenheiten wurde die frühere Bezeichnung Eingangsamt durch den Begriff der Eingangszollstelle ersetzt."
                            },
                            {
                                "example_id": "2b539129-c233-4f63-96c8-455c31b673dc",
                                "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                                "text": "„Jeder der vertragschließenden Teile ist verpflichtet, Waren in das Gebiet des anderen Teiles nur auf einer Zollstraße nach einem mit ausreichenden Befugnissen versehenen Eingangsamt und nur zu solchen Tageszeiten austreten zu lassen, daß sie beim jenseitigen Amt voraussichtlich noch während der Amtsstunden eintreffen.“"
                            },
                            {
                                "example_id": "c36565de-1a12-4da2-83b4-afc4bda4ba13",
                                "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                                "text": "„Im Eingangsamt werden die Gegenstände unter Ueberreichung des Declarationsscheins angemeldet.“"
                            },
                            {
                                "example_id": "e4cef367-37dc-42ae-aea5-8d9a5fd52bb3",
                                "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                                "text": "„Im Eingangsamte wird die Waare zur Revision gestellt, nach der Quittung revidirt, diese, vor der Rückstellung an den Waarenführer, dann mit der Bescheinigung des Eingangs der Waare versehen, wenn sie ausdrücklich auf die Passage noch ein Mal durch das Inland gerichtet ist, und die Waare in das Notizbuch eingetragen.“"
                            },
                            {
                                "example_id": "1143bcbb-9546-44ea-8634-6e319fb68c0c",
                                "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                                "text": "„Jeder der vertragschließenden Theile ist verpflichtet: [bestimmte] Waaren, welche in dem Gebiete des anderen Theiles eingangsabgabenpflichtig und dahin bestimmt sind, […] nur in der Richtung nach einem dortigen mit ausreichenden Befugnissen versehenen Eingangsamt, […] unter Verhinderung jedes vermeidlichen Aufenthalts zwischen dem Ausgangsamt oder der Legitimationsstelle und der Grenze zoll- oder steueramtlich abzufertigen […].“"
                            },
                            {
                                "example_id": "cfcdf85e-1346-43fa-aa18-56ec32c44af5",
                                "sense_id": "0e76831a-35ec-32aa-b9be-3ccb9e393d1f",
                                "text": "„Bei der Einfuhr von Waren auf dem Landwege nach Rußland wird keine besondere Deklaration gefordert, sofern die Waren von Frachtbriefen begleitet sind. Es genügt in diesem Falle die Vorzeigung der Frachtbriefe bei dem Eingangsamte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
