                                                "example_id": "d787290b-1d99-4b16-a3a3-5f22ebf873c0",
                                                "sense_id": "d580d467-71e8-3350-b9a8-fd76bff8263c",
                                                "text": "Commencement of a two-hourly service pattern by GWR marked the return of regular services to Okehampton for the first time since their withdrawal in 1972. There are plans to extend this to hourly."
                                            }
                                        ]
