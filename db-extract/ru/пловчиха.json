                        "examples": [
                            {
                                "example_id": "4233d748-ccfa-4140-8bad-e0d13a848edc",
                                "sense_id": "3f2b460c-9e21-3666-9e40-d66078fcef01",
                                "text": "Прогрессивная пловчиха нашла выход из положения, пришив к купальнику рукава, чулки и воротник."
                            },
                            {
                                "example_id": "c935afa1-a6c3-4bc6-b6ef-9fa2a33944a5",
                                "sense_id": "3f2b460c-9e21-3666-9e40-d66078fcef01",
                                "text": "Она ― пловчиха, а тут ей предоставили целое озеро в распоряжение."
                            }
                        ]
                    }
                ],
