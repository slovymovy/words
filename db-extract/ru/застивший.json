                        "examples": [
                            {
                                "example_id": "f16f2bfb-acba-41f7-af09-0f4f151643bb",
                                "sense_id": "29571434-de19-3609-b796-016859fc24dc",
                                "text": "Мне запомнился туман, застивший там всё."
                            },
                            {
                                "example_id": "0af40437-5168-4d4b-b92b-e39d166b0ac9",
                                "sense_id": "29571434-de19-3609-b796-016859fc24dc",
                                "text": "Тетя Стюра, статная и дородная, застившая почти весь свет в дверях, с крыльца оглядела Руслана и осталась недовольна."
                            }
                        ]
                    }
