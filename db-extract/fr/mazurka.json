                                    {
                                        "sense_id": "d789153e-db57-3fe2-b712-d1a87b306f73",
                                        "entry_id": "1ec9492b-4f85-3b5d-8661-b2de73caaf40",
                                        "glosses": [
                                            "сладкое печенье продолговатой формы из миндаля"
