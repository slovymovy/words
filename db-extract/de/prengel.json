                                "sense_id": "c024b57f-aed5-3286-bda7-7faeb290b883",
                                "text": "Die Currywürste von der Pommesbude am Borsigplatz sind mal richtige Prengel!"
                            },
                            {
                                "example_id": "99e79237-ec36-4c9b-af03-3ca08f5652d7",
                                "sense_id": "c024b57f-aed5-3286-bda7-7faeb290b883",
                                "text": "Er wehrte sich mit Händen und Füßen, da zog ich ihm den Prengel über die Rübe!"
                            }
                        ],
