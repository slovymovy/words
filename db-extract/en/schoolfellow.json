                                "sense_id": "c28ce76f-1b49-3ef5-8589-3d751bdc1b2b",
                                "text": "My brothers were considerably younger than myself; but I had a friend in one of my schoolfellows, who compensated for this deficiency."
                            },
                            {
                                "example_id": "7832b35e-ded0-4082-b693-d2411827a3a4",
                                "sense_id": "c28ce76f-1b49-3ef5-8589-3d751bdc1b2b",
                                "text": "“You listened to what your two schoolfellows were saying about you.”"
                            }
                        ]
                    }
