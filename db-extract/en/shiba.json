                        "examples": [
                            {
                                "example_id": "844399b3-1121-47fa-96a9-d557992182fb",
                                "sense_id": "d0023de2-db4d-3fe8-8dfd-bd8c39703546",
                                "text": "The red Shibas are an orange color, like the setting sun."
                            },
                            {
                                "example_id": "32a49164-d299-4739-a81d-0c7eecaf7383",
                                "sense_id": "d0023de2-db4d-3fe8-8dfd-bd8c39703546",
                                "text": "Five Collies had a higher prevalence of slight arrhythmia than seven Shibas when given milbemycin D at 1, 2.5 or 5 mg/kg daily for 10 days."
                            },
                            {
                                "example_id": "b22ee80e-9bdf-4d86-9db2-3b2f6e0c8da2",
                                "sense_id": "d0023de2-db4d-3fe8-8dfd-bd8c39703546",
                                "text": "Interestingly, in this regard, Niimi and associates (1999) at Gifu University, Japan, have reported significant differences in genetic variants controlling the expression of dopamine D4 receptors in golden retrievers and Shibas."
                            }
                        ]
                    }
