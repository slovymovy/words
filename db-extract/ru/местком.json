                                    {
                                        "sense_id": "c055b38a-4109-3bf7-9182-786102a6b2e1",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "A person who lives in or near a given place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599f9799-6fa3-4d9e-8fda-3fcb6583b038",
                                                "sense_id": "c055b38a-4109-3bf7-9182-786102a6b2e1",
                                                "text": "It's easy to tell the locals from the tourists."
                                            },
                                            {
                                                "example_id": "c4333a2d-7c36-4cbf-90d0-b224e5b47fed",
                                                "sense_id": "c055b38a-4109-3bf7-9182-786102a6b2e1",
                                                "text": "Taunton station is busy - even more so when the inbound working of my Bristol train arrives, laden with the usual mix of 'staycationers' and locals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8874e101-d8c6-318b-a096-8d2daf9d3f36",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "A branch of a nationwide organization such as a trade union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c26092-de37-469f-badc-df18786dc706",
                                                "sense_id": "8874e101-d8c6-318b-a096-8d2daf9d3f36",
                                                "text": "I'm in the TWU, too. Local 6."
                                            },
                                            {
                                                "example_id": "7d8acd04-4ffd-41f6-806c-452976c27477",
                                                "sense_id": "8874e101-d8c6-318b-a096-8d2daf9d3f36",
                                                "text": "Citing the risk involved with being out as a gay person and a union activist while simultaneously dealing with racism, Susan notes that there are no out gays or lesbians of color in her local, though its membership is about 80 percent people of color."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfb3e671-6c62-31de-afa2-f581d7b549c6",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "Clipping of local train."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8b9face-3d6f-4fa9-8095-8b1b1fe7bdd6",
                                                "sense_id": "bfb3e671-6c62-31de-afa2-f581d7b549c6",
                                                "text": "The expresses skipped my station, so I had to take a local."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9296d1e-b5cb-369e-a5f4-18fc02deacc3",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "One's nearest or regularly frequented public house or bar."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1777fc1a-252f-49fe-8b00-56b90b7d484c",
                                                "sense_id": "e9296d1e-b5cb-369e-a5f4-18fc02deacc3",
                                                "text": "I got barred from my local, so I've started going all the way into town for a drink."
                                            },
                                            {
                                                "example_id": "2db9487f-411a-4186-a955-097846d426f8",
                                                "sense_id": "e9296d1e-b5cb-369e-a5f4-18fc02deacc3",
                                                "text": "As they take me to my local down the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e64b8f-3316-3faa-bf2a-72f4823224b0",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "A locally scoped identifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3c04ec-7d1f-4f8a-98f1-352491ab8b7a",
                                                "sense_id": "50e64b8f-3316-3faa-bf2a-72f4823224b0",
                                                "text": "Functional programming languages usually don't allow changing the immediate value of locals once they've been initialized, unless they're explicitly marked as being mutable."
                                            },
                                            {
                                                "example_id": "6bcc8113-7889-46b4-bdef-efd660a15ab5",
                                                "sense_id": "50e64b8f-3316-3faa-bf2a-72f4823224b0",
                                                "text": "Globals are visible anywhere in your application, whereas locals are visible only in the function in which they're declared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee8f5a7-e02d-3680-a297-8aefcc92e363",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "An item of news relating to the place where the newspaper is published."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01c08024-318e-3283-b5f4-4932a7d4b5f1",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "Clipping of local anesthetic."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f96639f3-a841-4329-b8d8-889a65d261a3",
                                                "sense_id": "01c08024-318e-3283-b5f4-4932a7d4b5f1",
                                                "text": "Well, Mr. Dalton, you may add nine staples to your dossier of thirty‐one broken bones, two bullet wounds, nine puncture wounds and four steel screws. That’s an estimate, of course. I’ll give you a local."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77fef5d-a5f2-35df-844c-0931cb59449d",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "An independent trader who acts for themselves rather than on behalf of investors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbbc7900-7b0c-46b3-b704-5e94388aafab",
                                                "sense_id": "c77fef5d-a5f2-35df-844c-0931cb59449d",
                                                "text": "On most futures exchanges, there are two major types of futures traders/members: commission brokers and locals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09ced9ec-d72e-32bc-bbc3-12bc44472f0f",
                                        "entry_id": "c27dab97-0c8c-3b6a-bf6a-2f33a1e40648",
                                        "glosses": [
                                            "A Twitter user who is not a part of Stan Twitter."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a20a37-24d7-42d0-b495-482878a37716",
                                                "sense_id": "09ced9ec-d72e-32bc-bbc3-12bc44472f0f",
                                                "text": "Her camera roll is filled with pictures and videos of her idol, she doesn't let any of her friends see her account because \"no locals allowed\", […]"
                                            },
                                            {
                                                "example_id": "cb73399f-62eb-4e06-8182-6694fed986d3",
                                                "sense_id": "09ced9ec-d72e-32bc-bbc3-12bc44472f0f",
                                                "text": "Locals are characterised by their seeming lack of involvement or ~expertise~ on the platform."
                                            },
                                            {
                                                "example_id": "f3abf998-a164-4871-af05-c132ad100ba5",
                                                "sense_id": "09ced9ec-d72e-32bc-bbc3-12bc44472f0f",
                                                "text": "Heck, even locals sometimes use GIFs of her when they feel like tweeting with taste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "local",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f2bff2-387e-3642-a12f-7ab99c88d469",
                                        "entry_id": "40b14c00-3b70-3eaf-ad40-509eaaa109c4",
                                        "glosses": [
                                            "In the local area; within a city, state, country, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c283b08-a991-4d2f-8203-77f7849d6389",
                                                "sense_id": "a3f2bff2-387e-3642-a12f-7ab99c88d469",
                                                "text": "It's never been more important to buy local."
                                            },
                                            {
                                                "example_id": "c4ed4632-6980-4f7a-8dbb-19516dfa162b",
                                                "sense_id": "a3f2bff2-387e-3642-a12f-7ab99c88d469",
                                                "text": "Coca-Cola, for example, shifted its stance, unsuccessfully, between “think global, act global” and “think local, act local” during the tenures of three different CEOs in the late 1990s and early 2000s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
