                        "entry_id": "e387e3ca-8354-3064-a5bd-033ec644f1b8",
                        "glosses": [
                            "die Stufe der Taxonomie der Pflanzen, die unterhalb der Gattung und oberhalb der Unterart eingeordnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d55dc1-87ea-474b-b0f9-5462fa7e08e4",
                                "sense_id": "535b1cf1-db93-37b3-8303-1306f5b6d483",
                                "text": "In der Schule bestimmten wir Pflanzenarten."
                            },
                            {
                                "example_id": "6beb5c2d-5047-4fa8-ab3d-b7fed1103e0a",
                                "sense_id": "535b1cf1-db93-37b3-8303-1306f5b6d483",
                                "text": "„Die Tiere fallen über Obstplantagen, Weinberge, Wälder, Grünanlagen und Gärten her und fressen bei mehr als 300 Pflanzenarten alles kahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
