                                        "entry_id": "27902554-1e17-3155-82f8-464c27adbacf",
                                        "glosses": [
                                            "Antérieurement dans l’ordre du temps."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
