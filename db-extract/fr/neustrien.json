                ],
                "senses": [
                    {
                        "sense_id": "f19fc2a8-289e-3f6f-935a-2cbbd37f33a3",
                        "entry_id": "be79081c-e137-3328-b40e-087ac825571b",
                        "glosses": [
                            "Relatif à la Neustrie et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb364b7-68cc-476c-af99-bda5b721a6e1",
                                "sense_id": "f19fc2a8-289e-3f6f-935a-2cbbd37f33a3",
                                "text": "Voyant l'armée neustrienne totalement détruite, Mummolus retourna en arrière, soit que telles fussent ses instructions, soit qu'il crût avoir assez fait."
                            },
                            {
                                "example_id": "e4ebd7b1-52fb-421e-9fff-c8d02ab0e54a",
                                "sense_id": "f19fc2a8-289e-3f6f-935a-2cbbd37f33a3",
                                "text": "N’as-tu pas rejeté tes premières bruines\nAvec la pomme de tes prés mouillés de mer,\nPour mordre de tes dents neustriennes la chair\nTragique, violente et rouge des sanguines ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c20ee9f9-cfa6-4397-ae61-e82ae0a51e75",
                        "source_entry_id": "be79081c-e137-3328-b40e-087ac825571b",
                        "source_sense_id": "f19fc2a8-289e-3f6f-935a-2cbbd37f33a3",
