            {
                "entry_id": "01b3c1cb-d29d-31c1-967d-b8c60d9ca46e",
                "word": "onusien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "486c6e96-55de-4b63-9c18-915228fc1460",
                        "entry_id": "01b3c1cb-d29d-31c1-967d-b8c60d9ca46e",
                        "tags": [
                            "plural",
