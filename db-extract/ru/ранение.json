                "senses": [
                    {
                        "sense_id": "4a758b95-a15c-336d-9d49-af269e80b86d",
                        "entry_id": "a244b9e8-499f-306a-8cc5-7dd849150eb0",
                        "glosses": [
                            "действие по значению гл. ранить; нанесение раны (ран)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9ccc9f-663a-47c2-ac96-cdb69b58e6b7",
                                "sense_id": "4a758b95-a15c-336d-9d49-af269e80b86d",
                                "text": "Как и при каких обстоятельствах произошло ранение в данное время производится дознание."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6098c45-5d8b-3384-bf9a-c4c63cab805a",
                        "entry_id": "a244b9e8-499f-306a-8cc5-7dd849150eb0",
                        "glosses": [
                            "мед. результат такого действия; открытое повреждение тканей организма от внешнего, как правило, механического воздействия; рана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a9990c-18d1-4d2c-9403-046660379533",
                                "sense_id": "b6098c45-5d8b-3384-bf9a-c4c63cab805a",
                                "text": "Тяжёлое ранение."
                            },
                            {
                                "example_id": "dcf49828-ad22-455d-8641-d7b9a5b2f34e",
                                "sense_id": "b6098c45-5d8b-3384-bf9a-c4c63cab805a",
                                "text": "Лёгкое ранение."
                            },
                            {
                                "example_id": "71a3fcb3-36c6-4e12-a0bf-99a9c4fcc774",
                                "sense_id": "b6098c45-5d8b-3384-bf9a-c4c63cab805a",
                                "text": "Он получил в бою три ранения, но все-таки остался жив и не покинул своего поста."
                            },
                            {
                                "example_id": "2225ef9b-d5b3-42f4-ba6f-756b427ad072",
                                "sense_id": "b6098c45-5d8b-3384-bf9a-c4c63cab805a",
                                "text": "Причиной этого была круглая пуля, которая летит недалеко, но вызывает тяжелое ранение."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caf085ff-4711-411c-aaa4-118c30848490",
                        "source_entry_id": "a244b9e8-499f-306a-8cc5-7dd849150eb0",
