                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00159aad-d8c4-4363-96b3-38962f0f9edc",
                                "sense_id": "c54bfadc-93c6-3a1e-800e-7e4f2ca3ef8d",
                                "text": "En effet,si la voie d'expression d'une souffrance psychologique est somatique, c'est que le sujet n'est pas dans la capacité de la mentaliser."
                            },
                            {
                                "example_id": "7c561c50-7845-486b-87bf-538b4235541f",
                                "sense_id": "c54bfadc-93c6-3a1e-800e-7e4f2ca3ef8d",
                                "text": "La crise servirait donc à mentaliser un espace entre quelque chose qui s'achève (car déséquilibré) et quelque chose qui peut commencer."
                            }
                        ]
                    }
