                "senses": [
                    {
                        "sense_id": "ebfab51f-f7a9-30c0-be5f-918fdaaeff88",
                        "entry_id": "905d68ef-ae3a-3f2f-823d-f6c6906b83c5",
                        "glosses": [
                            "Qui est en train de pourrir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4efcd6-f314-40cd-b746-e5c3e10eb8dc",
                                "sense_id": "ebfab51f-f7a9-30c0-be5f-918fdaaeff88",
                                "text": "Ce champignon pousse typiquement sur du bois pourrissant."
                            },
                            {
                                "example_id": "293e43f6-bbb9-482e-9f60-28ec96b731ff",
                                "sense_id": "ebfab51f-f7a9-30c0-be5f-918fdaaeff88",
                                "text": "Elle n’avait plus demandé de miroir : son visage de moribonde n’existait pas pour elle. Elle reposait et rêvait, à une distance infinie de sa chair pourrissante, les oreilles remplies du bruit de nos mensonges et tout entière ramassée dans un espoir passionné : guérir."
                            },
                            {
                                "example_id": "5504e4cc-9469-4bcc-8e9c-8f0cc658623a",
                                "sense_id": "ebfab51f-f7a9-30c0-be5f-918fdaaeff88",
                                "text": "C’était l’un de ces rares endroits à Paris où il pouvait arriver, certains jours d’automne, après la pluie, que montât du sol une odeur, presque puissante, de forêt, d’humus, de feuilles pourrissantes."
                            }
                        ]
                    }
                ],
