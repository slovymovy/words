                    {
                        "form_id": "43d3ea6c-d0bc-4a39-ae9c-71e6a8f7578f",
                        "entry_id": "3e0755b0-f913-3980-87f5-9161624c8a45",
                        "tags": [
                            "plural"
                        ],
                        "form": "bitterings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cdb870f-fb84-300b-96c3-471df85aeed5",
                        "entry_id": "3e0755b0-f913-3980-87f5-9161624c8a45",
                        "glosses": [
                            "A bitter compound, such as that used in adulterating beer or that removed from coffee."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11daabeb-485c-4762-a6c5-f6384aae35a2",
                                "sense_id": "2cdb870f-fb84-300b-96c3-471df85aeed5",
                                "text": "A patent was lately grantedd to David Dear, of the town of Salina, county of Onondaga, and state of New York, for an improved mode of separating the bitterings from, and cleaning hte same from salt kettles or boilers of any description used in the manufacture of salt."
                            },
                            {
                                "example_id": "05fdfd91-ec54-47ea-8dce-68586a7427ed",
                                "sense_id": "2cdb870f-fb84-300b-96c3-471df85aeed5",
                                "text": "It is used as a kettle addition in conjunction with other post-fermentation bitterings."
                            }
                        ]
                    },
                    {
                        "sense_id": "061780aa-34cc-35c6-b508-8096ee3941bd",
                        "entry_id": "3e0755b0-f913-3980-87f5-9161624c8a45",
                        "glosses": [
                            "The act of making or becoming bitter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb038f1-ed88-4b3e-845c-ae642d78c7ea",
                                "sense_id": "061780aa-34cc-35c6-b508-8096ee3941bd",
                                "text": "This observation would suffice to explain the fact mentioned at the commencement of this paragraph, that bittering is almost exclusively confined to red wines, these containing, as is well known, a somewhat large amount of tannin absorbed from the skins and kernels of the grape during the primary fermentation."
                            },
                            {
                                "example_id": "567ca991-6ab0-45f8-bf73-658fd85e1c16",
                                "sense_id": "061780aa-34cc-35c6-b508-8096ee3941bd",
                                "text": "Aroma hops can be used for bittering also, and many homebrewers swear by this, claiming a finer, cleaner overall hop profile."
                            }
                        ]
                    }
