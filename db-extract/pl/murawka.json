                                "target_senses": [
                                    {
                                        "sense_id": "25ba12ca-130a-3c6b-9ae2-f576f5169e72",
                                        "entry_id": "5d82aef7-66d2-3971-9af0-1a70b4faa9c2",
                                        "glosses": [
                                            "Ground (generally in front of or around a house) covered with grass kept closely mown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df44417-a078-4471-a59c-8720d29d6b7b",
                                                "sense_id": "25ba12ca-130a-3c6b-9ae2-f576f5169e72",
                                                "text": "Pretty soon I struck into a sort of path[…]. It twisted and turned,[…]and opened out into a big clear space like a lawn. And, back of the lawn, was a big, old-fashioned house, with piazzas stretching in front of it, and all blazing with lights. 'Twas the house I'd seen the roof of from the beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055ab9d1-d740-3ba6-96aa-8b18c1c8088b",
                                        "entry_id": "5d82aef7-66d2-3971-9af0-1a70b4faa9c2",
                                        "glosses": [
                                            "An open space between woods."
                                        ],
                                        "tags": [
                                            "England",
                                            "countable",
                                            "historical",
                                            "regional",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3baa909-1a6e-3f59-bab1-8c5e2ffc1b95",
                                        "entry_id": "5d82aef7-66d2-3971-9af0-1a70b4faa9c2",
                                        "glosses": [
                                            "An overgrown agar culture, such that no separation between single colonies exists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea2d4ff8-ec85-3f9e-b4c6-0f53a36006b7",
                                        "entry_id": "5f65e080-cd2a-3e88-b935-2d170de812c9",
                                        "glosses": [
                                            "To furnish with a lawn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a275637-3298-4fec-9226-92f8136cb0f7",
                                                "sense_id": "ea2d4ff8-ec85-3f9e-b4c6-0f53a36006b7",
                                                "text": "By opening all the arches of the several apartments […], by lawning the area within, and by a judicious use of ivy where any blank spaces require to be broken, or any deformities concealed, this might be made a beautiful and singular scene; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "704b5910-3db0-33fe-bc6c-e302d720ca7c",
                                        "entry_id": "3322b890-6b04-3520-977e-789219b1d9f5",
                                        "glosses": [
                                            "A type of thin linen or cotton."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1534213-3ed4-40d4-9f01-4090f31d703f",
                                                "sense_id": "704b5910-3db0-33fe-bc6c-e302d720ca7c",
                                                "text": "Two hundred Sempſtreſſes were employed to make me Shirts, and Linen for Bed and Table, all of the ſtrongeft and coarſeſt kind they could get; which, however, they were forced to quilt together in ſeveral Folds, for the thickeſt was ſome degrees finer than Lawn."
                                            },
                                            {
                                                "example_id": "6e1c62db-5d92-4830-89be-db93c4b1088a",
                                                "sense_id": "704b5910-3db0-33fe-bc6c-e302d720ca7c",
                                                "text": "The stream had trickled over her chin and stained the purity of her lawn death robe."
                                            },
                                            {
                                                "example_id": "c4e86b05-b739-4082-83b6-b03a815d8093",
                                                "sense_id": "704b5910-3db0-33fe-bc6c-e302d720ca7c",
                                                "text": "He looked through the glass at the fire, set it down on the end of the desk and wiped his lips with a sheer lawn handkerchief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecf14950-478a-339f-8e54-c396200d7a14",
                                        "entry_id": "3322b890-6b04-3520-977e-789219b1d9f5",
                                        "glosses": [
                                            "Pieces of this fabric, especially as used for the sleeves of a bishop."
                                        ],
