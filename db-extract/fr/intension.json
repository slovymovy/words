                        "entry_id": "5db6646e-bcbd-3632-bc04-343da2bc6ad3",
                        "glosses": [
                            "Désignation d’un ensemble d’éléments par un prédicat qu’ils vérifient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "707f53c0-3aa5-45c2-a35b-e8dcbda50bcf",
                                "sense_id": "59fb808c-ccd8-3436-bff0-af91fe9a957e",
                                "text": "L’ensemble 1,2,3 peut être défini en intension comme étant l’ensemble des entiers compris — au sens large — entre 1 et 3."
                            }
                        ]
                    }
                ],
                "translations": [
