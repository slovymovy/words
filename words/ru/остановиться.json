                    "target_lang_definitions": {
                        "en": "To stop moving, to cease walking or driving",
                        "es": "Dejar de moverse, dejar de caminar o conducir",
                        "fr": "Cesser de se déplacer, s'arrêter de marcher ou de rouler",
                        "nl": "Stoppen met bewegen, ophouden met lopen of rijden",
                        "pl": "Przestać się poruszać, zatrzymać się w miejscu podczas chodzenia lub jazdy",
                        "de": "Aufhören sich zu bewegen, nicht mehr gehen oder fahren",
                        "it": "Smettere di muoversi, cessare di camminare o guidare",
                        "cs": "Přestat se pohybovat, přestat jít nebo jet",
                        "tr": "Hareket etmeyi bırakmak, yürümeyi veya sürmeyi durdurmak",
                        "zh": "停止移动，不再行走或驾驶"
                    },
