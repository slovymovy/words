                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6e0392-d17f-4c55-b7c6-7b85b4268bec",
                                "sense_id": "0b578e3a-fe50-37ab-88d4-bd52aa9e8b55",
                                "text": "„‹Nächstes Mal geh bitte an dein Scheißtelefon.›“"
                            },
                            {
                                "example_id": "64d08022-3442-4259-9ee9-c90f8d468108",
                                "sense_id": "0b578e3a-fe50-37ab-88d4-bd52aa9e8b55",
                                "text": "„Er erinnerte sich wieder an das Chaos von heute Morgen, den Menschenauflauf auf der Straße und den militanten Willie Mouton, den Ritter in Schwarz, den glatzköpfigen Ohrringträger mit seinem Scheißtelefon.“"
                            },
                            {
                                "example_id": "d3efdbe8-ba5f-4fd6-b7e2-cb4973a77506",
                                "sense_id": "0b578e3a-fe50-37ab-88d4-bd52aa9e8b55",
                                "text": "„›Benutz dein Scheißtelefon, Koschka‹, hörte sie eine männliche Stimme verächtlich auf Russisch sagen.“"
                            },
                            {
                                "example_id": "30adb916-bc54-4fb3-86b3-7b94452b2a35",
                                "sense_id": "0b578e3a-fe50-37ab-88d4-bd52aa9e8b55",
                                "text": "„›Er ging nicht an sein Scheißtelefon‹, sagte James, nahm einen weißen Schaumstoffbecher vom Boden und spuckte einen Strahl Tabaksaft hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
