{
    "word_family": [
        "gripper",
        "gripping",
        "grippy",
        "handgrip"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b8be9e0-c553-30d9-9519-8ff9a567c8f6",
                    "sense_definition": "A hold or way of holding, particularly with the hand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_hold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to maintain a firm <w>grip</w> when you are climbing the ladder.",
                            "target_lang_translations": {
                                "ru": "Важно сохранять крепкую <w>хватку</w>, когда вы поднимаетесь по лестнице.",
                                "zh": "爬梯子时，保持稳固的<w>抓握</w>很重要。"
                            }
                        },
                        {
                            "text": "The tennis coach showed me the correct <w>grip</w> for a powerful serve.",
                            "target_lang_translations": {
                                "ru": "Теннисный тренер показал мне правильный <w>хват</w> для мощной подачи.",
                                "zh": "网球教练教我有力发球时正确的<w>握拍方法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clasp",
                        "grasp"
                    ],
                    "common_phrases": [
                        "firm grip",
                        "tighten your grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ удержания чего-либо, особенно рукой.",
                        "zh": "抓住某物的动作或方式，尤指用手抓。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "способ или сила удержания"
                            },
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "физическое удержание или прием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓握",
                                "target_lang_sense_clarification": "用手或手指抓住某物的动作或方式"
                            },
                            {
                                "target_lang_word": "握法",
                                "target_lang_sense_clarification": "手握住某物时的状态，常指牢固程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "853e8838-8b55-3b10-8120-958e160238f3",
                    "sense_definition": "The ability to resist slippage when pressed in contact with another object or surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These new winter tires provide excellent <w>grip</w> on icy roads.",
                            "target_lang_translations": {
                                "ru": "Эти новые зимние шины обеспечивают отличное <w>сцепление</w> на обледенелых дорогах.",
                                "zh": "这些新冬季轮胎在结冰路面上提供了极佳的<w>抓地力</w>。"
                            }
                        },
                        {
                            "text": "The mountain climber checked his boots to ensure they still had enough <w>grip</w>.",
                            "target_lang_translations": {
                                "ru": "Альпинист проверил свои ботинки, чтобы убедиться, что у них все еще достаточное <w>сцепление</w>.",
                                "zh": "登山者检查了自己的靴子，确保它们仍然有足够的<w>抓地力</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "slippage"
                    ],
                    "common_phrases": [
                        "lose grip",
                        "extra grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность предотвращать скольжение при контакте с поверхностью.",
                        "zh": "与另一物体或表面接触受压时防止滑动的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцепление",
                                "target_lang_sense_clarification": "с дорогой или поверхностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓地力",
                                "target_lang_sense_clarification": "物体与地面或表面接触时防滑、附着的能力"
                            },
                            {
                                "target_lang_word": "附着力",
                                "target_lang_sense_clarification": "与表面接触时不易打滑的性能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                    "sense_definition": "Control, power, or mastery over someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator tightened his <w>grip</w> on the country by silencing the media.",
                            "target_lang_translations": {
                                "ru": "Диктатор усилил свой <w>контроль</w> над страной, заставив СМИ замолчать.",
                                "zh": "独裁者通过压制媒体来加强对国家的<w>控制</w>。"
                            }
                        },
                        {
                            "text": "We need to get a <w>grip</w> on these rising costs before we go bankrupt.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>взять под контроль</w> эти растущие расходы, прежде чем мы обанкротимся.",
                                "zh": "我们得在破产之前把这些不断上涨的成本<w>控制住</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "clasp"
                    ],
                    "common_phrases": [
                        "tighten one's grip",
                        "get a grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контроль, власть или господство над кем-либо или чем-либо.",
                        "zh": "对某人或某事的控制、权力或支配。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контроль",
                                "target_lang_sense_clarification": "власть над ситуацией"
                            },
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "переносное значение контроля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "对人、国家、局面等的支配或掌控"
                            },
                            {
                                "target_lang_word": "掌控",
                                "target_lang_sense_clarification": "对局势、问题等的掌控能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "938dc31c-9cef-3eb4-a176-12bef128d01b",
                    "sense_definition": "Mental understanding or emotional self-control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seems to be losing his <w>grip</w> on reality lately.",
                            "target_lang_translations": {
                                "ru": "Кажется, в последнее время он теряет <w>связь</w> с реальностью.",
                                "zh": "他最近似乎正在失去对现实的<w>把握</w>。"
                            }
                        },
                        {
                            "text": "You need to get a <w>grip</w> of yourself and stop panicking.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>взять себя в руки</w> и перестать паниковать.",
                                "zh": "你得<w>控制住</w>自己，别再惊慌了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "clasp"
                    ],
                    "common_phrases": [
                        "get a grip",
                        "lose one's grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимание ситуации или эмоциональный самоконтроль.",
                        "zh": "对情况的心理理解，或情绪上的自我控制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самообладание",
                                "target_lang_sense_clarification": "контроль над собой"
                            },
                            {
                                "target_lang_word": "понимание",
                                "target_lang_sense_clarification": "связь с реальностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "把握",
                                "target_lang_sense_clarification": "对现实、情况等的理解和认识"
                            },
                            {
                                "target_lang_word": "自控",
                                "target_lang_sense_clarification": "情绪上的自我控制能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abbec2e4-b9c3-313b-b1dc-63b266b11b92",
                    "sense_definition": "A place to hold; a handle or the portion of a handle that the hand occupies.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_hold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rubber <w>grip</w> on the bicycle handle makes it much more comfortable.",
                            "target_lang_translations": {
                                "ru": "Резиновая <w>накладка</w> на руле велосипеда делает его гораздо удобнее.",
                                "zh": "自行车把手上的橡胶<w>握把</w>让骑起来舒服多了。"
                            }
                        },
                        {
                            "text": "There are several good <w>grips</w> on the northern face of this rock for climbers.",
                            "target_lang_translations": {
                                "ru": "На северном склоне этой скалы есть несколько хороших <w>зацепов</w> для альпинистов.",
                                "zh": "这块岩石的北面有好几个适合攀爬者抓住的<w>抓点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rubber grip",
                        "handle grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, за которое можно держаться; ручка или часть рукоятки.",
                        "zh": "可以抓住的部位；把手或手握住的那一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рукоятка",
                                "target_lang_sense_clarification": "часть инструмента или руля"
                            },
                            {
                                "target_lang_word": "ручка",
                                "target_lang_sense_clarification": "часть предмета для держания"
                            },
                            {
                                "target_lang_word": "зацеп",
                                "target_lang_sense_clarification": "в скалолазании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "握把",
                                "target_lang_sense_clarification": "手握着的把手部分，如自行车把上的套"
                            },
                            {
                                "target_lang_word": "抓点",
                                "target_lang_sense_clarification": "攀岩时可供手抓住的部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "576cffc8-bc41-3d59-ae96-e6d5908f4c86",
                    "sense_definition": "A person responsible for handling equipment, such as lighting and rigging, on a film or television set.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The key <w>grip</w> coordinated the movement of the heavy camera cranes.",
                            "target_lang_translations": {
                                "ru": "Старший <w>осветитель</w> координировал перемещение тяжелых операторских кранов.",
                                "zh": "首席<w>器材师</w>协调了大型摄影吊臂的移动。"
                            }
                        },
                        {
                            "text": "He found work as a <w>grip</w> on a major Hollywood production.",
                            "target_lang_translations": {
                                "ru": "Он нашел работу в качестве <w>техника</w> в крупном голливудском проекте.",
                                "zh": "他在一部大型好莱坞作品中找到了一份<w>器材师</w>的工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "key grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист по установке осветительного и съемочного оборудования на киноплощадке.",
                        "zh": "在电影或电视拍摄现场负责灯光支撑、吊装等器材工作的人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грип",
                                "target_lang_sense_clarification": "профессия в киноиндустрии"
                            },
                            {
                                "target_lang_word": "осветитель",
                                "target_lang_sense_clarification": "техник по свету и оборудованию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "器材师",
                                "target_lang_sense_clarification": "影视拍摄现场负责器材安装、支撑和移动的工作人员"
                            },
                            {
                                "target_lang_word": "格里普",
                                "target_lang_sense_clarification": "电影行业中 grip 的音译说法，较专业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc51a7c6-eed5-33e1-97b3-4a6e967eaa3a",
                    "sense_definition": "A medium-sized bag or holdall for one's belongings, usually with two handles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "luggage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He packed his few belongings into a small leather <w>grip</w> and left.",
                            "target_lang_translations": {
                                "ru": "Он сложил свои немногочисленные вещи в небольшой кожаный <w>саквояж</w> и ушел.",
                                "zh": "他把自己不多的东西装进一个小皮<w>手提包</w>里就走了。"
                            }
                        },
                        {
                            "text": "She carried a heavy <w>grip</w> as she boarded the train.",
                            "target_lang_translations": {
                                "ru": "Она несла тяжелую <w>сумку</w>, когда садилась в поезд.",
                                "zh": "她上火车时提着一个沉重的<w>旅行包</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумка среднего размера или саквояж для вещей.",
                        "zh": "一种中等大小、通常有两个提手的旅行袋或手提包。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "саквояж",
                                "target_lang_sense_clarification": "дорожная сумка"
                            },
                            {
                                "target_lang_word": "дорожная сумка",
                                "target_lang_sense_clarification": "небольшой багаж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手提包",
                                "target_lang_sense_clarification": "旧式中等大小的手提旅行包"
                            },
                            {
                                "target_lang_word": "旅行包",
                                "target_lang_sense_clarification": "用于出行装随身物品的包"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70ae7cd4-e425-3a9e-b751-33fdde1a70b3",
                    "sense_definition": "An archaic spelling of <w>grippe</w>, referring to influenza.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was bedridden for a week with a severe case of the <w>grip</w>.",
                            "target_lang_translations": {
                                "ru": "Старик был прикован к постели на неделю с тяжелой формой <w>гриппа</w>.",
                                "zh": "那位老人因严重的<w>流感</w>卧床了一周。"
                            }
                        },
                        {
                            "text": "During the winter of 1890, many citizens fell ill with the <w>grip</w>.",
                            "target_lang_translations": {
                                "ru": "Зимой 1890 года многие горожане заболели <w>инфлюэнцей</w>.",
                                "zh": "在1890年的冬天，许多市民都患上了<w>流感</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова «грипп».",
                        "zh": "grippe 的古旧拼写，指流感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грипп",
                                "target_lang_sense_clarification": "инфекционное заболевание"
                            },
                            {
                                "target_lang_word": "инфлюэнца",
                                "target_lang_sense_clarification": "устаревшее название гриппа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流感",
                                "target_lang_sense_clarification": "旧时对 influenza 的说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                    "sense_definition": "To take hold of something firmly, particularly with the hand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>grip</w> the handle firmly so you do not drop the heavy bag.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, крепко <w>схватитесь</w> за ручку, чтобы не уронить тяжелую сумку.",
                                "zh": "请牢牢<w>抓住</w>把手，这样你才不会把重包掉下去。"
                            }
                        },
                        {
                            "text": "The tires began to <w>grip</w> the road as the car accelerated.",
                            "target_lang_translations": {
                                "ru": "Шины начали <w>цепляться</w> за дорогу, когда машина ускорилась.",
                                "zh": "汽车加速时，轮胎开始<w>咬住</w>路面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clasp",
                        "grasp"
                    ],
                    "antonyms": [
                        "release"
                    ],
                    "common_phrases": [
                        "grip firmly",
                        "grip tightly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко схватить что-либо, обычно рукой.",
                        "zh": "牢牢抓住某物，尤指用手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "крепко держать в руке"
                            },
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "взять крепко или быстро"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓住",
                                "target_lang_sense_clarification": "用手牢牢抓着某物"
                            },
                            {
                                "target_lang_word": "紧握",
                                "target_lang_sense_clarification": "紧紧握住，不松开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31ecde3f-2de3-30c8-9b50-00861bd1b021",
                    "sense_definition": "To firmly hold the attention or interest of someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspenseful novel <w>gripped</w> me from the very first page.",
                            "target_lang_translations": {
                                "ru": "Этот остросюжетный роман <w>захватил</w> меня с самой первой страницы.",
                                "zh": "这本悬疑小说从第一页起就<w>吸引住了</w>我。"
                            }
                        },
                        {
                            "text": "The audience was <w>gripped</w> by the speaker's powerful story.",
                            "target_lang_translations": {
                                "ru": "Аудитория была <w>поглощена</w> мощной историей оратора.",
                                "zh": "观众被演讲者那扣人心弦的故事<w>吸引住了</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grip the audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать внимание или интерес человека.",
                        "zh": "牢牢吸引住某人的注意力或兴趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывать",
                                "target_lang_sense_clarification": "о внимании или интересе"
                            },
                            {
                                "target_lang_word": "увлекать",
                                "target_lang_sense_clarification": "сильно заинтересовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引住",
                                "target_lang_sense_clarification": "牢牢吸引住某人的注意力或兴趣"
                            },
                            {
                                "target_lang_word": "牢牢抓住",
                                "target_lang_sense_clarification": "使人非常投入、不能移开注意力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18a97818-8eb7-3fd2-810d-8e2721db811e",
