                        {
                            "text": "Door de werkdruk begon de controle op de veiligheidsvoorschriften langzaam te <w>verslappen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the workload, the monitoring of safety regulations slowly began to <w>loosen</w>."
                            }
