                    },
                    {
                        "sense_id": "875a4fb5-632a-3474-a80a-1802d7fbeeea",
                        "entry_id": "daa6ac90-0ef9-3a2e-a275-69aa19b262e7",
                        "glosses": [
                            "Qui n’est pas courtois, pas aimable, pas très poli, pas très respectueux…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a799e7f-616b-4e5f-8f2c-328e1b324c09",
                                "sense_id": "875a4fb5-632a-3474-a80a-1802d7fbeeea",
                                "text": "Les Prussiens décampèrent à huit heures du matin, laissant leurs crottes, quelques maisons incendiées et brûlant encore, quelques habitants discourtois estropiés ou massacrés, soixante-dix-sept femmes ou filles excessivement violées, et l’annonce délicieuse d’une seconde multitude qui n’attendait que leur départ pour les remplacer."
                            },
                            {
                                "example_id": "26c099eb-d8ce-44d3-9ffe-7eaa9d08006f",
                                "sense_id": "875a4fb5-632a-3474-a80a-1802d7fbeeea",
                                "text": "…rien ne suscita l’intérêt de notre auguste et discourtois interlocuteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a09fb7f9-46bc-477a-bef0-9503044b24a9",
                        "source_entry_id": "daa6ac90-0ef9-3a2e-a275-69aa19b262e7",
                        "target_lang_word": "discourteous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discourteous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15aeba22-8813-3056-afbb-7a8daab188bf",
                                        "entry_id": "0535657f-d204-3992-99d9-93fb3cb98231",
                                        "glosses": [
                                            "impolite; lacking consideration for others"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608d223f-3d0b-4849-b9f7-e382514ef1d1",
                                                "sense_id": "15aeba22-8813-3056-afbb-7a8daab188bf",
                                                "text": "Kirk, who succeeded Drumright, had an unusually short tour of duty in Taipei—only about a year. Despite the shortness of his duty, he left the impression of being an old sea captain who would have felt more at home barking his orders from the bridge than heading an important diplomatic mission. There was nothing civil or gentle about him, and even in talking to President Chiang, he sounded gruff and blunt. I could see that the President really didn't enjoy the envoy's company, but he remained unperturbed and discussed in a calm and friendly manner whatever had prompted the Ambassador to seek the audience. Once I heard him remark half to himself: \"How could anyone be so discourteous?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b665a92-afd8-45fd-a6b3-67dfe34397c8",
                        "source_entry_id": "daa6ac90-0ef9-3a2e-a275-69aa19b262e7",
                        "target_lang_word": "αγενής",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
