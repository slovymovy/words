                {
                    "sense_id": "95fb1786-3f32-3aa0-93bb-10308c621319",
                    "sense_definition": "Ощущение холода или дрожи по телу от сильного страха, ужаса или волнения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От его страшного рассказа у меня <w>мороз</w> по коже пробежал.",
                            "target_lang_translations": {
                                "en": "His scary story sent a <w>chill</w> down my spine.",
                                "nl": "Van zijn enge verhaal liepen de <w>rillingen</w> over mijn lijf.",
                                "pl": "Od jego strasznej opowieści przeszły mnie <w>ciarki</w> po plecach.",
                                "de": "Bei seiner schrecklichen Geschichte lief mir ein <w>Schauer</w> über den Rücken.",
                                "fr": "Son histoire effrayante m'a donné des <w>frissons</w> dans le dos.",
                                "it": "La sua storia spaventosa mi ha fatto venire i <w>brividi</w> lungo la schiena.",
                                "cs": "Z jeho strašidelného vyprávění mi přeběhl <w>mráz</w> po zádech.",
                                "tr": "Onun korkunç hikayesinden dolayı tüylerim <w>ürperdi</w>.",
                                "es": "Su terrible historia me dio un <w>escalofrío</w> por todo el cuerpo."
                            }
                        },
                        {
                            "text": "Когда я увидел эту сцену, <w>мороз</w> по спине пошёл.",
                            "target_lang_translations": {
                                "en": "When I saw that scene, a <w>chill</w> went down my back.",
                                "nl": "Toen ik die scène zag, kreeg ik koude <w>rillingen</w> over mijn rug.",
                                "pl": "Kiedy zobaczyłem tę scenę, <w>dreszcz</w> przeszedł mi po plecach.",
                                "de": "Als ich diese Szene sah, lief es mir <w>kalt</w> den Rücken hinunter.",
                                "fr": "Quand j'ai vu cette scène, un <w>frisson</w> m'a parcouru l'échine.",
                                "it": "Quando ho visto quella scena, un <w>brivido</w> mi è corso lungo la schiena.",
                                "cs": "Když jsem tu scénu uviděl, přeběhl mi po zádech <w>mráz</w>.",
                                "tr": "Bu sahneyi gördüğümde sırtımdan aşağı bir <w>ürperti</w> geçti.",
                                "es": "Cuando vi esa escena, un <w>escalofrío</w> me recorrió la espalda."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мороз по коже",
                        "мороз по спине"
                    ],
