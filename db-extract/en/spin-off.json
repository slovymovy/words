{
    "word": "spin-off",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                "word": "spin-off",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "46f36005-499e-4b51-98fa-91f7b887e5fa",
                        "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "tags": [
                            "plural"
                        ],
                        "form": "spin-offs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25fe7f7a-05a3-3a7d-af35-0876cb10c06c",
                        "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "glosses": [
                            "An offshoot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "775250dd-77ce-4525-9b3e-4654db5cb561",
                                "sense_id": "25fe7f7a-05a3-3a7d-af35-0876cb10c06c",
                                "text": "We are about to broach the fraught saga of the Circle Line, but there is another Metropolitan spin-off that comes first, one that has always appealed to me by the baleful beauty of its name: the City Widened Lines or 'The Widened Lines' for short."
                            }
                        ]
                    },
                    {
                        "sense_id": "96d6b97b-6091-33e2-ac93-c77d8bcf704c",
                        "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "glosses": [
                            "An incidental benefit or unexpected pay-off."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5253542-c691-444c-a3bc-13a8ed3448e5",
                                "sense_id": "96d6b97b-6091-33e2-ac93-c77d8bcf704c",
                                "text": "Space research often provides a spin-off for everyday technology."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cc1189b-a1a3-3499-a2a7-b2fb4d26c6c1",
                        "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "glosses": [
                            "A by-product."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "03759d4b-9794-33a6-8b6b-06331ae5f164",
                        "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "glosses": [
                            "A fictional work where the protagonist was introduced in a preceding work or at least shares the same setting, often in a different aspect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900a0582-1a04-4339-b55b-b2d6d191ea05",
                                "sense_id": "03759d4b-9794-33a6-8b6b-06331ae5f164",
                                "text": "\"Frasier\" was a spin-off from the sitcom \"Cheers\"."
                            },
                            {
                                "example_id": "c32a0bd2-2a48-4ffa-a909-65f9be0cb31b",
                                "sense_id": "03759d4b-9794-33a6-8b6b-06331ae5f164",
                                "text": "The Harry Potter spin-off prequel series Fantastic Beasts has been “parked” by Warner Bros, according to its director David Yates."
                            }
                        ]
                    },
                    {
                        "sense_id": "8117993f-23db-3d96-82ab-2dbbe264ae75",
                        "entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "glosses": [
                            "The formation of a subsidiary company that continues the operations of part of the parent company; the company so formed."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a31c7e71-de6e-44ef-9a26-cd2262c3d382",
                        "source_entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "source_sense_description": "incidental benefit or unexpected pay-off",
                        "target_lang_word": "produkt uboczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "11aedfc8-3065-480c-9ac3-dc5d5b9a9992",
                        "source_entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "source_sense_description": "fictional work",
                        "target_lang_word": "spin-off",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spin-off",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2839056-ded0-3835-a40e-e935b6fc62a0",
                                        "entry_id": "d7c0fff7-37e0-32ac-b5fd-a9109beae1cf",
                                        "glosses": [
                                            "Société commerciale née d'une scission d'une société plus grande."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2436581c-fdda-41f7-b6e3-bfdaa5fa60a8",
                                                "sense_id": "d2839056-ded0-3835-a40e-e935b6fc62a0",
                                                "text": "En levant 3,2 millions d’euros, mercredi 20 mars, la spin-off du CEA-Leti souhaite tester un démonstrateur en conditions réelles chez des clients pour le marché industriel d’ici la fin de l’année."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spin-off",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef570d93-da1f-3bed-ae14-277dee5d774f",
                                        "entry_id": "8b6d32e9-715d-3bc8-a615-34d1e98e0009",
                                        "glosses": [
                                            "Série dérivée créée à partir d'une série à succès. Un personnage secondaire récurrent de la série à succès devient le héros principal de la série dérivée."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba418586-8241-4f5f-b5cc-4707711d1285",
                                                "sense_id": "ef570d93-da1f-3bed-ae14-277dee5d774f",
                                                "text": "Toujours en partenariat avec Netflix, l’éditeur a publié, en septembre, Lupin, Échec à la reine, un spin-off dérivé de la série, écrit avec Bertrand Puard, en concertation avec George Kay, le créateur de Lupin."
                                            },
                                            {
                                                "example_id": "924b5649-f77c-4d85-9d7c-be73446b104c",
                                                "sense_id": "ef570d93-da1f-3bed-ae14-277dee5d774f",
                                                "text": "En mai 2019, la série phénomène d’HBO tirait sa révérence après une ultime saison controversée. Mais les fans se consolaient tout de même avec l’annonce d’un spin-off."
                                            },
                                            {
                                                "example_id": "fd7a8000-f4b5-455c-a1c7-d1eaadeafebd",
                                                "sense_id": "ef570d93-da1f-3bed-ae14-277dee5d774f",
                                                "text": "De quoi s’octroyer la médaille d’argent du lancement le plus regardé depuis 2010, juste derrière celui du spin-off de Game of Thrones, House of the Dragon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11ee529b-f159-47af-be14-b2ebc045197d",
                        "source_entry_id": "5008e493-98fd-3886-b517-fea57f7bcbf5",
                        "source_sense_description": "fictional work",
