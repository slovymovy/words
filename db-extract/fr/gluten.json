                                        "entry_id": "1f215992-a8d4-3d02-bcf7-6ddb83f5da68",
                                        "glosses": [
                                            "ein hauptsächlich aus Proteinen bestehendes Gemisch, das vorwiegend in traditionellen Getreidesorten vorkommt"
                                        ],
                                        "tags": [],
