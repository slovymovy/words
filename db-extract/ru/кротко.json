                                        "entry_id": "9d768214-cbfb-370f-b46c-326c7c04b342",
                                        "glosses": [
                                            "In a demure manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1bf801-8bba-4a75-a79e-68369baa7f05",
                                                "sense_id": "d11a423f-3c4c-3680-8bf9-a07a9b417bc3",
                                                "text": "they spy'd a Cat upon a Shelf; that lay and look'd so Demurely, as if there had been neither Life nor Soul in her."
                                            },
                                            {
                                                "example_id": "f61fa03d-f912-4656-ae52-91854826e24f",
                                                "sense_id": "d11a423f-3c4c-3680-8bf9-a07a9b417bc3",
                                                "text": "When the coffee was drunk, and the cup was put away with many thanks and blessings, she went demurely to the hearth, and pulled out a snuff-horn."
                                            },
                                            {
                                                "example_id": "d7f70eb3-ea31-48bb-8d92-6d746a794051",
                                                "sense_id": "d11a423f-3c4c-3680-8bf9-a07a9b417bc3",
                                                "text": "`I am a hairdresser, but I was advertising as a model,' said Miss A demurely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
