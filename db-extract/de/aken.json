                ],
                "senses": [
                    {
                        "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                        "entry_id": "e51492b3-1af6-3654-9624-5af7bd53eac6",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041ded20-f060-4dbd-9fe2-9bd0ef1bf63a",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Frau Aken ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bd1e0e89-de86-4636-8d8f-3c7078b7cefc",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Herr Aken wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "49bcc60f-ea1f-4e4d-be82-ebe82ae0c858",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Die Akens fahren heute an den Bodensee."
                            },
                            {
                                "example_id": "3fb63cba-7e1f-444c-9548-e5b93d2c42ab",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Der Aken trägt nie die Schals, die die Aken ihm strickt."
                            },
                            {
                                "example_id": "e18ed802-6df4-44e1-80ed-a5c0d8a991c9",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aken kommt, geht der Herr Aken.“"
                            },
                            {
                                "example_id": "423c7c49-23d4-4887-a9c9-ec11358edc19",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Aken kommt und geht."
                            },
                            {
                                "example_id": "5a994999-2f3b-4b92-b13e-60b432075e59",
                                "sense_id": "c36c1121-d9d2-36f7-aebd-6b88acfa84e9",
                                "text": "Akens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
