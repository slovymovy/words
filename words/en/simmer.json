{
    "word_family": [
        "simmering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e919016d-b845-3cc4-a716-15184dbfec01",
                    "sense_definition": "To cook something slowly in liquid at a temperature just below the boiling point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>simmer</w> the soup for ten minutes to let the flavors develop.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>поварить</w> суп на медленном огне десять минут, чтобы вкус раскрылся."
                            }
                        },
                        {
                            "text": "After the water boils, reduce the heat and <w>simmer</w> gently until the vegetables are soft.",
                            "target_lang_translations": {
                                "ru": "После того как вода закипит, убавьте огонь и <w>варите на медленном огне</w>, пока овощи не станут мягкими."
                            }
                        }
                    ],
                    "common_phrases": [
                        "simmer gently",
                        "simmer for minutes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить что-либо медленно в жидкости при температуре чуть ниже точки кипения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варить на медленном огне",
                                "target_lang_sense_clarification": "процесс приготовления"
                            },
                            {
                                "target_lang_word": "тушить",
                                "target_lang_sense_clarification": "медленно готовить в небольшом количестве воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d8e69a6-125e-3dfc-ae47-ec03a97c4bf0",
                    "sense_definition": "To be cooked or heated slowly at or just below the boiling point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delicious beef stew <w>simmered</w> on the stove all afternoon.",
                            "target_lang_translations": {
                                "ru": "Вкусное рагу из говядины весь день <w>томилось</w> на плите."
                            }
                        },
                        {
                            "text": "A large pot of water <w>simmered</w> on the back burner while she prepared the pasta.",
                            "target_lang_translations": {
                                "ru": "Большая кастрюля с водой <w>едва кипела</w> на дальней конфорке, пока она готовила пасту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "simmer on the stove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовиться или нагреваться медленно при температуре чуть ниже точки кипения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "томиться",
                                "target_lang_sense_clarification": "медленно готовиться"
                            },
                            {
                                "target_lang_word": "вариться на медленном огне",
                                "target_lang_sense_clarification": "состояние продукта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14683164-42e5-3359-b233-92bce294cfef",
                    "sense_definition": "To be in a state of suppressed anger or excitement that is close to breaking out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tension between the two rivals <w>simmered</w> for weeks before the final confrontation.",
                            "target_lang_translations": {
                                "ru": "Напряжение между двумя соперниками <w>нарастало</w> неделями перед финальным противостоянием."
                            }
                        },
                        {
                            "text": "He tried to stay calm, but his anger <w>simmered</w> just below the surface.",
                            "target_lang_translations": {
                                "ru": "Он старался сохранять спокойствие, но гнев <w>клокотал</w> внутри него."
                            }
                        }
                    ],
                    "synonyms": [
                        "ferment"
                    ],
                    "common_phrases": [
                        "simmer with anger",
                        "simmer below the surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в состоянии подавленного гнева или волнения, которое вот-вот вырвется наружу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накипать",
                                "target_lang_sense_clarification": "о чувствах, готовых вырваться"
                            },
                            {
                                "target_lang_word": "зреть",
                                "target_lang_sense_clarification": "о скрытом конфликте или напряжении"
                            },
                            {
                                "target_lang_word": "тлеть",
                                "target_lang_sense_clarification": "о скрытом чувстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3f085f2-988f-3ac7-96c4-a33facaae7d5",
                    "sense_definition": "To develop gradually or stay in a quiet state of activity, especially of an idea or a plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plan for the new business had been <w>simmering</w> in her mind for years.",
                            "target_lang_translations": {
                                "ru": "План нового бизнеса <w>вызревал</w> в её голове годами."
                            }
                        },
                        {
                            "text": "While the project <w>simmered</w> in the background, the team focused on more urgent tasks.",
                            "target_lang_translations": {
                                "ru": "Пока проект <w>готовился</w> в фоновом режиме, команда сосредоточилась на более срочных задачах."
                            }
                        }
                    ],
                    "synonyms": [
                        "gestate"
                    ],
                    "common_phrases": [
                        "simmer in the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно развиваться или находиться в состоянии скрытой активности (особенно об идее или плане)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызревать",
                                "target_lang_sense_clarification": "о плане или идее"
                            },
                            {
                                "target_lang_word": "готовиться",
                                "target_lang_sense_clarification": "постепенно развиваться в фоновом режиме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7489460-eb2c-3a4e-a8ba-ac13707d86b9",
                    "sense_definition": "To remain in a state of quiet resentment or to hold a grudge over a long period.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the argument, he continued to <w>simmer</w> in silence for the rest of the evening.",
                            "target_lang_translations": {
                                "ru": "После ссоры он продолжал молча <w>кипеть</w> от злости весь оставшийся вечер."
                            }
                        },
                        {
                            "text": "She chose to <w>simmer</w> rather than confront him about the broken promise.",
                            "target_lang_translations": {
                                "ru": "Она предпочла <w>таить обиду</w>, а не выяснять отношения из-за нарушенного обещания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "simmer in silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в состоянии тихого негодования или затаить обиду на долгий период."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуться",
                                "target_lang_sense_clarification": "обижаться в тишине"
                            },
                            {
                                "target_lang_word": "кипеть",
                                "target_lang_sense_clarification": "внутренне негодовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe3abbc3-8148-3e50-8864-85854a53d5b5",
                    "sense_definition": "The state or process of cooking something at a temperature just below boiling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Keep the sauce at a gentle <w>simmer</w> so it doesn't burn on the bottom.",
                            "target_lang_translations": {
                                "ru": "Держите соус на <w>медленном огне</w>, чтобы он не подгорел."
                            }
                        },
                        {
                            "text": "The kettle was kept on the <w>simmer</w> throughout the cold morning.",
                            "target_lang_translations": {
                                "ru": "Чайник поддерживали в состоянии <w>слабого кипения</w всё холодное утро."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gentle simmer",
                        "on the simmer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или процесс приготовления чего-либо при температуре чуть ниже кипения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медленный огонь",
                                "target_lang_sense_clarification": "режим приготовления"
                            },
                            {
                                "target_lang_word": "слабое кипение",
                                "target_lang_sense_clarification": "состояние жидкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f72d789f-4b2b-34a7-b80f-c88b37944ff9",
                    "sense_definition": "A person who plays or is a fan of the video game series The Sims.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a dedicated <w>simmer</w>, she has spent hundreds of hours building virtual houses.",
                            "target_lang_translations": {
                                "ru": "Как преданный <w>симмер</w>, она провела сотни часов, строя виртуальные дома."
                            }
                        },
                        {
                            "text": "The online community for the game is full of creative <w>simmers</w> sharing their stories.",
                            "target_lang_translations": {
                                "ru": "Онлайн-сообщество игры полно творческих <w>симмеров</w>, делящихся своими историями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used within the gaming community"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который играет или является фанатом серии видеоигр The Sims."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симмер",
                                "target_lang_sense_clarification": "игрок в The Sims"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9987746-6393-3b10-ae01-b2528800fc7d",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Simmer</w> was appointed as the new head of the local history department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Симмер</w> был назначен новым главой отдела местной истории."
                            }
                        },
                        {
                            "text": "The <w>Simmer</w> family has lived in this town for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Симмер</w> живет в этом городе уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Симмер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}