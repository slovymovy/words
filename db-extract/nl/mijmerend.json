                        "examples": [
                            {
                                "example_id": "8c117d5f-9288-445f-9e05-f4a42a0817e5",
                                "sense_id": "8d1e2d78-e308-340a-b410-ce3cb7fb9382",
                                "text": "Burri's portret van een sigarenrokende, mijmerende Guevara was een van de foto's die de revolutionair onsterfelijk zouden maken."
                            },
                            {
                                "example_id": "23f9a7d1-f9dd-405d-af12-6007828cdd2d",
                                "sense_id": "8d1e2d78-e308-340a-b410-ce3cb7fb9382",
                                "text": "Mijmerende oude man: Een verwarde man van honderd, op zijn sterfbed, die terugkijkt op zijn leven. De Braziliaanse uitgever van Chico Buarque de Holanda zal niet meteen steil achterover zijn geslagen toen zijn auteur het plan voor de nieuwe roman bekendmaakte. HP de Tijd 09/03"
                            }
                        ]
                    }
