                "senses": [
                    {
                        "sense_id": "060aee5f-6c9b-3251-ac56-684b5d6c106d",
                        "entry_id": "6f9114da-d63d-3529-ab15-ce005fac5dec",
                        "glosses": [
                            "iemand die stijladvies geeft aan anderen (mode- of kledingstylist), of die spullen uitkiest en rangschikt volgens een bepaalde stijl (woningstylist)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "e649a029-aeaf-4b80-9fd0-3d566f7c2bc8",
                                "sense_id": "060aee5f-6c9b-3251-ac56-684b5d6c106d",
                                "text": "Claudia Schoemacher (47) draagt graag print op print. Het liefst tijgerprint. Volgens styliste Jolanda Oskam moet je vooral dragen waarin je je goed voelt, maar zit er aan bepaalde kleding een leeftijdsgrens."
                            },
                            {
                                "example_id": "e60e5bc6-44fd-48b9-b7b9-2c6bbbec393a",
                                "sense_id": "060aee5f-6c9b-3251-ac56-684b5d6c106d",
                                "text": "In het nieuwe seizoen van vtwonen nemen Kees Tol en de stylisten elke week een huis onder handen van een stel met totaal verschillende woonsmaken. De stylist kijkt met een frisse blik naar de woning en brengt samen met Kees Tol de verschillende woonstijlen bij elkaar in een nieuw interieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aadd9529-ab58-40c0-9e6b-723f9425dc9b",
                        "source_entry_id": "6f9114da-d63d-3529-ab15-ce005fac5dec",
                        "source_sense_id": "060aee5f-6c9b-3251-ac56-684b5d6c106d",
                        "target_lang_word": "stylist",
