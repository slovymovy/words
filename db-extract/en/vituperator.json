                                        "examples": [
                                            {
                                                "example_id": "cff894d7-fad0-48fb-9bd9-9d993f79df1d",
                                                "sense_id": "f087defc-251d-352d-bae2-9778b6eabb63",
                                                "text": "Une personnalité pleine de promesses nouvelles, et dont l'ironique finesse et la tendresse adoucie sont bien éloignées du cri jeté par le vitupérateur insurgé des classes bourgeoises."
                                            },
                                            {
                                                "example_id": "4e3164cd-691f-4ded-92f9-21cef334e63a",
                                                "sense_id": "f087defc-251d-352d-bae2-9778b6eabb63",
                                                "text": "Il y a loin de cette méthode aux combinaisons de ce fameux démocrate chrétien, grand vitupérateur de l'Action française, qui déclarait, étant candidat à la Chambre, « mettre sa conscience au fond d'un tiroir », avant de partir pour les élections."
                                            }
                                        ]
