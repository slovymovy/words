                        "examples": [
                            {
                                "example_id": "87295db3-7c9a-4534-9a79-ad26b454d494",
                                "sense_id": "a7484e8d-107c-3655-ad11-78160ae608a7",
                                "text": "„Status1-6: Hier geht es darum, ob die Satzkonstituente eine notwendige (Argument) oder freie Ergänzung (Adjunkt) ist.“"
                            },
                            {
                                "example_id": "c8463a2f-bfad-4782-ab52-213152e015f5",
                                "sense_id": "a7484e8d-107c-3655-ad11-78160ae608a7",
                                "text": "„Diese drei Funktionsebenen werden jeweils konstituiert von der Textkonstituente 'Äußerung', von der Satzkonstituente 'Satzglied' und von der Gruppenkonstituente 'Gruppenglied',…“"
                            },
                            {
                                "example_id": "2a7cf1c4-a60c-416a-8f17-6801126eecc4",
                                "sense_id": "a7484e8d-107c-3655-ad11-78160ae608a7",
                                "text": "„Eine Satzkonstituente ist ein Wort oder mehrere Wörter, die eine strukturelle Einheit bilden.“"
                            },
                            {
                                "example_id": "7092fac3-3a77-4fa0-9ac2-a9eb15fb25bf",
                                "sense_id": "a7484e8d-107c-3655-ad11-78160ae608a7",
                                "text": "„Neben der Erweiterung einzelner Satzkonstituenten können einfache Sätze auch durch periphere Angaben in ihrer Komplexität erhöht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
