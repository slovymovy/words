                "senses": [
                    {
                        "sense_id": "eb53430a-70f3-3b0a-ab55-03aa61c4c855",
                        "entry_id": "2ee36705-8889-32f1-89f0-3a90118eb8d9",
                        "glosses": [
                            "durchlässige Vorrichtung, Gerät oder Baugruppe zur Trennung oder Aussonderung bestimmter Feststoffe, die in Form eines Schlauches aufgebaut ist (Filterschlauch)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b51d34-0fdc-4b12-b2dc-6ff73230ecde",
                                "sense_id": "eb53430a-70f3-3b0a-ab55-03aa61c4c855",
                                "text": "„Die älteste Abreinigungsmethode für Schlauchfilter - heute noch in mobilen Filter genutzt - besteht aus motorischen oder manuell zu betätigenden Rüttelvorrichtungen. “"
                            },
                            {
                                "example_id": "25579e6a-b085-4a1b-973e-a946a9e53fc5",
                                "sense_id": "eb53430a-70f3-3b0a-ab55-03aa61c4c855",
                                "text": "„Bei allen Typen kann, durch Einsatz von plissierten Filterschläuchen, eine deutlich größere Filterfläche erzielt werden, bei ähnlichem Abreinigungsverhalten eines klassischen Schlauchfilters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
