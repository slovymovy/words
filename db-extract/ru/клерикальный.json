                ],
                "senses": [
                    {
                        "sense_id": "f34e2dea-d194-3d4a-9abc-5e031594d8d9",
                        "entry_id": "6e3d46f3-3170-3c49-8375-ab4e9ddc1678",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными клерикализм, клерикал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ffcbe89-6c2a-4b06-ace9-6999b0a4275f",
                                "sense_id": "f34e2dea-d194-3d4a-9abc-5e031594d8d9",
                                "text": "Клерикалы всё это рассчитали математически, соединение произошло, и клерикальное большинство сената разрешило Мак-Магону разогнать республиканцев."
                            }
                        ]
                    },
                    {
                        "sense_id": "d70bcd01-9896-3b9f-9d73-1401fc818a44",
                        "entry_id": "6e3d46f3-3170-3c49-8375-ab4e9ddc1678",
                        "glosses": [
                            "свойственный клерикализму, клерикалу, характерный для них"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "12c6f12a-c3b1-3e0b-ad19-577db97eea95",
                        "entry_id": "6e3d46f3-3170-3c49-8375-ab4e9ddc1678",
                        "glosses": [
                            "связанный с религиозной моралью, церковной жизнью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a68083dc-31c2-4ff2-9c35-312b90940c52",
                                "sense_id": "12c6f12a-c3b1-3e0b-ad19-577db97eea95",
                                "text": "Начальники, профессоры, студенты, всё подчинялось строгой клерикальной дисциплине."
                            },
                            {
                                "example_id": "89a40484-f475-4c9d-8e86-5ad103354690",
                                "sense_id": "12c6f12a-c3b1-3e0b-ad19-577db97eea95",
                                "text": "Искусственный клерикальный покой, которым, особенно монахи, как сулемой, заморяют целые стороны сердца и ума, был уже и в его речи и во всех движениях."
                            }
                        ]
                    },
                    {
                        "sense_id": "58df9103-507d-37a2-ab74-93581488e7a4",
                        "entry_id": "6e3d46f3-3170-3c49-8375-ab4e9ddc1678",
                        "glosses": [
                            "принадлежащий клерикалам"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "458f6c7d-ada5-4bfa-a499-033483dd7906",
                        "source_entry_id": "6e3d46f3-3170-3c49-8375-ab4e9ddc1678",
                        "source_sense_description": "связанный, соотносящийся по значению с существительными клерикализм, клерикал",
                        "target_lang_word": "clerical",
