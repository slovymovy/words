                    },
                    {
                        "translation_id": "52e96017-d07f-4a76-92a2-2b183c7293b1",
                        "source_entry_id": "0232e4f1-5b44-3cbb-a168-5eaf3e0be18e",
                        "source_sense_id": "aaa32e33-3833-3f05-8b30-7474116d18d6",
                        "target_lang_word": "monsone",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monsone",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "b928ed1b-6af6-3575-a9f5-cfe97296b2e6",
                                        "entry_id": "3327e723-796e-3165-b79c-de63bcda62b5",
                                        "glosses": [
                                            "vento periodico delle zone tropicali che cambia direzione ogni semestre, soffiando d'inverno dalla terraferma verso l'oceano indiano e d'estate dall'oceano verso il continente, per il divario termico tra terra e mare che varia stagionalmente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c963c5-ce5a-483c-9013-7fb59977d21a",
                                                "sense_id": "b928ed1b-6af6-3575-a9f5-cfe97296b2e6",
                                                "text": "il monsone d'inverno (o di terra, perché va dalla terra al mare) è freddo e secco; il monsone d'estate (o di mare, perché va dal mare alla terra) è umido e caldo e provoca la stagione delle piogge"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1cfa74e-f43b-411c-87f6-340b61696602",
                        "source_entry_id": "0232e4f1-5b44-3cbb-a168-5eaf3e0be18e",
                        "source_sense_id": "aaa32e33-3833-3f05-8b30-7474116d18d6",
                        "target_lang_word": "Monsun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monsun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                        "entry_id": "357430a6-1448-3fd3-8810-872f6a14243d",
                                        "glosses": [
                                            "immer wiederkehrendes, feuchtes (im Sommer) bzw. trockenes (im Winter) Windsystem, das starken Einfluss auf das Klima der Subtropen (Rossbreiten) hat, weniger in den Tropen (am Äquator), weil hier der jahreszeitliche Temperaturunterschied zu gering ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871e9740-d0f3-4bdb-899e-a3444f1bece4",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Viele Monsune haben eine starke wirtschaftliche Bedeutung für einzelne Länder."
                                            },
                                            {
                                                "example_id": "5cf8b5ab-de76-4a47-8e1d-f1361026fe7f",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Monsune ändern nur alle halben Jahre ihre Richtung."
                                            },
                                            {
                                                "example_id": "89837fc7-1cfd-47ea-a4c1-d2be83a7748e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Nachdem der Monsun immer wieder Flutwellen in die Bucht getrieben hatte, musste ein Teil Victorias versetzt werden.“"
                                            },
                                            {
                                                "example_id": "bdd6f029-2db7-4d34-b83d-d7786339b18e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Er musste dabei den Stand der Ernte unter den Bedingungen des Monsuns beurteilen, die einmal besser, einmal schlechter sein konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
