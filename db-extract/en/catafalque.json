                                    {
                                        "sense_id": "318fc916-2f60-370a-8cc6-6737a3a948de",
                                        "entry_id": "13b3c15c-8b7a-37ce-8fb3-af8309e0dfb0",
                                        "glosses": [
                                            "podstavec pro vystavení rakve s ostatky zemřelého"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2e8562-49c3-4bdf-92bc-6cdcb786c351",
                                                "sense_id": "318fc916-2f60-370a-8cc6-6737a3a948de",
                                                "text": "Katafalk v chrámě týnském a rakev rovněž pokryta byla věnci, jichž bylo kolem osmdesáti."
                                            },
                                            {
                                                "example_id": "192a0855-d7b4-47b1-9abd-492e67dcc5c9",
                                                "sense_id": "318fc916-2f60-370a-8cc6-6737a3a948de",
                                                "text": "U oltáře vystaven byl nádherný katafalk, na němž nahoře spočívaly insignie říšské; kolem katafalku stáli členové zdejších pompés funebres a členové spolku vojenských vysloužilců a sboru hasičského."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d784da6e-ff32-4bab-9553-f6bccd18df95",
