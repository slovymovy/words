                "senses": [
                    {
                        "sense_id": "291f386d-08fa-3783-8f4f-cd550caf0fc5",
                        "entry_id": "bb8ec640-6dce-3726-8d47-22f977f39be2",
                        "glosses": [
                            "großes, viele Stockwerke umfassendes Gebäude"
                        ],
                        "tags": [
                            "Rumänien"
                        ],
                        "examples": [
                            {
                                "example_id": "773d9c11-93b2-4c73-a8a5-fecbb7cc1860",
                                "sense_id": "291f386d-08fa-3783-8f4f-cd550caf0fc5",
                                "text": "„Ein solcher Fall liegt zwischen den Turmblocks 23 und 25 am Ende des Republicii-Boulevards in der Reschitzaer Neustadt vor, wo gegenwärtig die Teilstücke des Sammelrohrs stellenweise aneinander vorbei verlaufen und wo eine permanente Verstopfstelle existiert.“"
                            },
                            {
                                "example_id": "dddb622d-5f21-4ce9-95db-0125da7602ba",
                                "sense_id": "291f386d-08fa-3783-8f4f-cd550caf0fc5",
                                "text": "„Unklar blieb allerdings, was geschieht, wenn jemand – absurderweise, in der gegenwärtigen Lage der Stadt – die Absicht hat, einen zehnstöckigen Turmblock mit je 40 Appartements pro Treppenhaus zu bauen, wie in der Zeitspanne 1960-1990 in der Reschitzaer Neustadt üblich, wo ein solcher Block aus je vier Treppenhäusern [à] 40 Appartements, also 160 Wohnungen besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
