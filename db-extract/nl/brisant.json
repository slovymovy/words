                        "sense_id": "d77f03a1-cce3-3371-ac99-be662fa91516",
                        "entry_id": "466236ff-2d64-366b-8ffc-13973cc6c2e5",
                        "glosses": [
                            "explosief, gepaard gaand met veel commotie"
