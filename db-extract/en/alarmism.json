                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alarmisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3548ccd-e072-364e-8bb5-d98de96377b0",
                                        "entry_id": "5d348887-e982-3b9e-a235-6e10b2cb5d5b",
                                        "glosses": [
                                            "Production inutile de bruits alarmants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e041845-46ea-478f-ab5a-663862e6bdae",
                                                "sense_id": "e3548ccd-e072-364e-8bb5-d98de96377b0",
                                                "text": "On a reproché à Jacquard son alarmisme écologique. On l'a accusé de déprécier la science en insistant indument sur ses limites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c160a93b-25d0-4485-89d4-3f427da585aa",
                        "source_entry_id": "17b5ecad-c9fa-3855-a374-ec94242d7cab",
                        "source_sense_id": "ae2a28ee-1d34-37fe-9c26-d24492d34845",
                        "source_sense_description": "production of needless alarms",
                        "target_lang_word": "Alarmismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alarmismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                        "entry_id": "d8644f58-e329-369e-9218-63c537cdda9c",
                                        "glosses": [
                                            "Haltung, die sich darin äußert, übertrieben vor sich abzeichnenden gesellschaftlichen Fehlentwicklungen und/oder Gefahren zu warnen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5414ee72-266a-43c7-8b86-551b95bde0a1",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Für die FR entbehren beide ‚Alarmismen‘ jedoch jeglicher konkreter Grundlagen.“"
                                            },
                                            {
                                                "example_id": "efbd6338-c267-4f2e-acb3-7387b7393330",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Schließlich sei es auch mit der Stärke der Sowjetflotte bei genauerer Betrachtung so weit nicht her. ‚Gelassenheit‘ sei daher ‚eher am Platze als Alarmismus‘.“"
                                            },
                                            {
                                                "example_id": "f2656040-2483-4d71-ab9e-df8b5f52f1e3",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Um Kritik schnell zum Verstummen zu bringen, wird bei dieser Haltungslage oft mit dramatisierenden Darstellungen der Situation (Alarmismus) operiert.“"
                                            },
                                            {
                                                "example_id": "08ffc93f-597b-4414-9976-5d6204dda068",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Bevor man mit dem Finger auf schlafmützige Politiker weist, wären hier als erstes die frühen Kinderkrankheiten der Ökologiebewegung zu nennen: Alarmismus, Moralpredigten, konzeptioneller Rigorismus.“"
                                            },
                                            {
                                                "example_id": "a30008d1-0d15-470c-9dea-c99b819785ec",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Die Militärs betreiben einen absurden ‚Rundum-Alarmismus‘, dem kaum nüchterne, plausible Analysen zugrunde liegen.“"
                                            },
                                            {
                                                "example_id": "71ccd972-6c4b-4b76-b6e3-75005ab78e50",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Wer eine präzise Bedrohungsanalyse erwartet, dem begegnen in dieser Leitlinie kommender deutscher (Militär-)Politik nur semantische Allgemeinplätze, Vernebelung, Alarmismus statt Analyse, Strategie-Kauderwelsch.“"
                                            },
                                            {
                                                "example_id": "23e46554-7ca9-46b9-825a-9ef8d965961b",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Offizielle Vertreter der Juden wie der verstorbene Heinz Galinski hatten schon vor Jahren vor einer wachsenden Gefahr von rechts gewarnt. Meist wurden ihre Mahnungen als Alarmismus abgetan.“"
                                            },
                                            {
                                                "example_id": "750bdada-82c0-41f5-89e1-118e8cd81769",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Das Leiden an der eigenen Zeit, das Umgetriebensein von weltverbessernden Ideen, der Alarmismus angesichts eines fast schon rettungslos empfundenen Weltzustands und, wo alles Zureden versagt, die Flucht ins Vergangene, ist womöglich die eigentliche Traditionslinie, die das deutsch-romantische 19. Jahrhundert der Gegenwart vermacht hat.“"
                                            },
                                            {
                                                "example_id": "7cfb2b24-a9c9-42cf-ad00-5e9238616319",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Moderne ‚political correctness‘ und alte deutsche Gesinnungsethik scheinen sich aber zum neuen moralischen Alarmismus der 90er Jahre zu verbinden.“"
                                            },
                                            {
                                                "example_id": "b9c757ac-4bef-4fdb-a793-1557b0d32444",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Nur in Deutschland gibt es das Phänomen, das man ‚Alarmismus‘ nennt, jene Panikanfälligkeit, bei der die Angst schon vorher da ist und nur noch ein Objekt sucht, um ausbrechen zu können.“"
                                            },
                                            {
                                                "example_id": "dec48b6b-d027-4726-8285-14f46d6ea1c7",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Es ist offenkundig, dass [Peter] Sloterdijk beide Ziele ins Visier genommen hat, indem er mit Begriffen wie ‚Selektion‘ und ‚Menschenzüchtung‘ hantierte und die Kritik an seiner frivolen Fascho-Semantik als hysterische Anfälle eines jakobinischen Antifa-Alarmismus denunzierte, dessen Denken sich in Reflexen erschöpfe.“"
                                            },
                                            {
                                                "example_id": "4a36e5b2-2e66-4a81-af30-13a95d960064",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Direkt nach der Wende schlugen wir eine größere Untersuchung zu der Entwicklung bei den Skinheads vor – ein hoher Beamter des Jugendministeriums erklärte das alles für Unsinn und unverantwortlichen Alarmismus und hat das verhindert.“"
                                            },
                                            {
                                                "example_id": "dd1f8db0-2918-4513-9c28-af1f093ba320",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Seine spiritualistische Sichtweise, sein normativer Rekurs auf die dionysische Bejahung des Lebens, seine Vorliebe für Zuspitzungen und Alarmismen, für Paradoxien und schroffe Antithesen wie gesund-krank, stark-schwach oder natürlich-künstlich produzieren erhebliche Differenzierungsverluste.“"
                                            },
                                            {
                                                "example_id": "2b3126ac-cd31-4535-91d9-3d2085b7c67f",
                                                "sense_id": "2666c618-2336-3b34-a665-11e353ccae72",
                                                "text": "„Zwar hat mit der Häufung ihres Erscheinens eine gewisse Nüchternheit der Analyse dieses Phänomens eingesetzt […], doch ist die öffentliche Rede nicht frei von Alarmismen, die in ihnen ein Austreten aus dem demokratischen Konsens sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7db6e375-ebfc-47d1-a616-7a9d4e729119",
                        "source_entry_id": "17b5ecad-c9fa-3855-a374-ec94242d7cab",
                        "source_sense_id": "ae2a28ee-1d34-37fe-9c26-d24492d34845",
                        "source_sense_description": "production of needless alarms",
                        "target_lang_word": "Panikmache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panikmache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                        "entry_id": "3e193afe-7d55-3592-a57e-febb42d1ba2d",
                                        "glosses": [
                                            "Versuch, künstlich Panik zu verursachen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4bbba59-1394-4e93-8aea-dcf99650e7c2",
                                                "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                                "text": "„Ich bin eigentlich sehr anfällig für jegliche Panikmache, aber es gibt so strenge Auflagen im Strahlenschutz - würde man wirklich Mikrowellen verkaufen, seit Jahrzehnten, wenn von den Geräten eine ernsthafte Gefahr ausginge?“"
                                            },
                                            {
                                                "example_id": "c19d8736-6aa4-4ca2-a86e-9f8c3242abfa",
                                                "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                                "text": "„Das rechte Phantasma gesellschaftlichen Zusammenlebens basiert auf der Angst vor der Fragmentierung, auf der Panik und Panikmache vor einer Desintegration der Gesellschaft. Schon historisch führt diese Panikmache in die Irre.“"
                                            },
                                            {
                                                "example_id": "ab0aee84-a7e1-42d1-b42e-4b2aeeac10da",
                                                "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                                "text": "„Vielleicht ist also doch nur alles Panikmache, und wir stehen gar nicht kurz vor der Apokalypse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
