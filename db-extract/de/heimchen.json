                "senses": [
                    {
                        "sense_id": "1629c8d4-fa7d-37d9-a098-9de2059b0d39",
                        "entry_id": "e5aa4fe4-a542-345a-90ab-9290453f639b",
                        "glosses": [
                            "house cricket"
                        ],
