                                "target_senses": [
                                    {
                                        "sense_id": "e4e1efeb-025f-3f8c-9fa7-dbdc11abe41b",
                                        "entry_id": "f8ff2ffb-440b-3486-b2a8-bd0cd6251758",
                                        "glosses": [
                                            "Celui qui prend part à un sauvetage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f89e4fc-a868-4d31-8ba5-672d6239d39c",
                                                "sense_id": "e4e1efeb-025f-3f8c-9fa7-dbdc11abe41b",
                                                "text": "Il eut une médaille comme sauveteur."
                                            },
                                            {
                                                "example_id": "14c3948c-f86f-4731-8ca9-5a156d2de9a1",
                                                "sense_id": "e4e1efeb-025f-3f8c-9fa7-dbdc11abe41b",
                                                "text": "Une brigade de sauvetage du comté de Los Angeles (L.A. County Beach Patrol) menée par le lieutenant Mitch Buchannon et composée d'une dizaine de sauveteurs doit faire face chaque jour aux dangers de la plage, tout en composant avec leur vie personnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e436159-74f6-3a5b-9871-53ba0b696ed4",
                                        "entry_id": "f8ff2ffb-440b-3486-b2a8-bd0cd6251758",
                                        "glosses": [
                                            "Un bateau sauveteur, Une embarcation employée au sauvetage."
                                        ],
                                        "tags": [
                                            "Par apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89e1488a-c416-4ba9-abaf-710e13747227",
                                                "sense_id": "4e436159-74f6-3a5b-9871-53ba0b696ed4",
                                                "text": "Comme chaque année en début de saison estivale, de nombreux effectifs, de gendarmerie, maîtres-nageurs sauveteurs, sapeurs-pompiers, agents techniques et contractuels, viennent renforcer les services de la mairie michelaise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
