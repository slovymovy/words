                                            "предикатив"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2335ccb9-cf6c-4491-b690-1135540c198c",
                                                "sense_id": "2c1dd0da-9783-31d7-b694-517bbb5c8787",
                                                "text": "Всё сделали? Отлично!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf3dffb-d750-306e-a7c7-390a6b2369e8",
                                        "entry_id": "689e1af5-5342-3972-a50a-986ded181bad",
                                        "glosses": [
                                            "наречие к отличныйᴵ; иначе, иным образом, по-другому"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a83260e-ff62-4138-8106-97eca63dd918",
                                                "sense_id": "daf3dffb-d750-306e-a7c7-390a6b2369e8",
                                                "text": "Эта система устроена отлично от той."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bdb736b-b730-397d-8609-f6af7ce16beb",
                                        "entry_id": "689e1af5-5342-3972-a50a-986ded181bad",
                                        "glosses": [
                                            "субстантивир., школьн. оценка «пять»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c0f149-9b44-48b6-a2f5-15e95f1c4753",
                                                "sense_id": "0bdb736b-b730-397d-8609-f6af7ce16beb",
