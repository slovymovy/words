{
    "word_family": [
        "violate",
        "violator",
        "violative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cce9a92-50a6-3624-9b98-35ad1550be97",
                    "sense_definition": "An act of breaking a law, rule, agreement, or principle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "infraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced a heavy fine for a serious <w>violation</w> of safety regulations.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась с крупным штрафом за серьезное <w>нарушение</w> правил техники безопасности.",
                                "tr": "Şirket, güvenlik düzenlemelerinin ciddi bir <w>ihlali</w> nedeniyle ağır bir para cezasıyla karşı karşıya kaldı."
                            }
                        },
                        {
                            "text": "The driver was pulled over by the police for a minor traffic <w>violation</w>.",
                            "target_lang_translations": {
                                "ru": "Водитель был остановлен полицией за незначительное <w>нарушение</w> правил дорожного движения.",
                                "tr": "Sürücü, küçük bir trafik <w>ihlali</w> nedeniyle polis tarafından durduruldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "transgression"
                    ],
                    "antonyms": [
                        "compliance",
                        "obedience"
                    ],
                    "common_phrases": [
                        "traffic violation",
                        "violation of law",
                        "safety violation",
                        "human rights violation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, нарушающее закон, правило, соглашение или принцип.",
                        "tr": "Bir yasayı, kuralı, anlaşmayı veya ilkeyi çiğneme eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "несоблюдение законов или правил"
                            },
                            {
                                "target_lang_word": "несоблюдение",
                                "target_lang_sense_clarification": "уклонение от исполнения обязательств"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ihlâl",
                                "target_lang_sense_clarification": "kanun, kural veya antlaşmayı çiğneme"
                            },
                            {
                                "target_lang_word": "bozma",
                                "target_lang_sense_clarification": "düzeni veya kuralı ihlal etme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29578543-30e1-3332-b2a6-45e5dbd49377",
                    "sense_definition": "A severe or clever insult, often used in a social context to describe someone being 'roasted'.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's joke about his outfit was a total <w>violation</w>.",
                            "target_lang_translations": {
                                "ru": "Шутка комика по поводу его наряда была полным <w>оскорблением</w>.",
                                "tr": "Komedyenin onun kıyafeti hakkındaki şakası tam bir <w>aşağılamaydı</w>."
                            }
                        },
                        {
                            "text": "Calling him out in front of everyone like that was a personal <w>violation</w>.",
                            "target_lang_translations": {
                                "ru": "Выставить его в таком свете перед всеми было личным <w>оскорблением</w>.",
                                "tr": "Onu herkesin önünde bu şekilde rezil etmek kişisel bir <w>saygısızlıktı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal violation",
                        "total violation"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in British and internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткое или остроумное оскорбление, часто используемое в социальном контексте для описания ситуации, когда кого-то «разнесли».",
                        "tr": "Genellikle sosyal bağlamda birinin 'motive bir şekilde aşağılanmasını' tanımlamak için kullanılan ağır veya zekice bir hakaret."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жесткий подкол",
                                "target_lang_sense_clarification": "сленг, обидная шутка"
                            },
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "унижение достоинства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşağılama",
                                "target_lang_sense_clarification": "argo, ağır laf sokma"
                            },
                            {
                                "target_lang_word": "saygısızlık",
                                "target_lang_sense_clarification": "haddini aşan davranış"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf312f59-ab70-33d2-978e-e23ab15c5111",
                    "sense_definition": "The act of desecrating or treating a person or place with great disrespect, including physical or sexual assault.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "desecration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community was outraged by the <w>violation</w> of the ancient burial ground.",
                            "target_lang_translations": {
                                "ru": "Община была возмущена <w>осквернением</w> древнего захоронения.",
                                "tr": "Halk, antik mezarlık alanının <w>kirletilmesine</w> öfkelendi."
                            }
                        },
                        {
                            "text": "The victim spoke out about the physical <w>violation</w> they had endured.",
                            "target_lang_translations": {
                                "ru": "Потерпевшая рассказала о физическом <w>насилии</w>, которое ей пришлось пережить.",
                                "tr": "Mağdur, maruz kaldığı fiziksel <w>saldırı</w> hakkında konuştu."
                            }
                        }
                    ],
                    "synonyms": [
                        "desecration"
                    ],
                    "common_phrases": [
                        "gross violation",
                        "physical violation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт осквернения или крайне неуважительного отношения к человеку или месту, включая физическое или сексуальное насилие.",
                        "tr": "Bir kişiye veya yere büyük bir saygısızlıkla yaklaşma, kirletme veya fiziksel/cinsel saldırıda bulunma eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осквернение",
                                "target_lang_sense_clarification": "неуважение к святыне или месту"
                            },
                            {
                                "target_lang_word": "посягательство",
                                "target_lang_sense_clarification": "физическое или личное насилие"
                            },
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "в контексте неприкосновенности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tecavüz",
                                "target_lang_sense_clarification": "haklara veya bedene ağır saldırı/ihlal"
                            },
                            {
                                "target_lang_word": "saygısızlık etme",
                                "target_lang_sense_clarification": "kutsal bir yere saygısızlık etme, kirletme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}