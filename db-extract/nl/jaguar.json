                ],
                "translations": [
                    {
                        "translation_id": "052290cd-7ecf-4ad9-be3e-bc185a46d5ca",
                        "source_entry_id": "9f71ee79-4b31-3da8-ae9a-a21aec9d9f50",
                        "source_sense_id": "e8fbed57-9827-39da-9828-b7aaf4ab207a",
                        "source_sense_description": "bepaald soort zoogdier, Panthera onca",
                        "target_lang_word": "Jaguar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jaguar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34fc7ec0-d9a4-3e9a-9460-29a785f5d5d3",
                                        "entry_id": "900d43bb-bae6-31b2-aa6e-7ca4c5ef76fa",
                                        "glosses": [
                                            "(in Mittel- und Südamerika beheimatetes, zu den Großkatzen zählendes) leopardenähnliches Raubtier, das ein rötlich gelbes Fell mit schwarzen Tupfen und einen langen Schwanz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eba32f83-4c31-4b98-9a11-2d0d8828458d",
                                                "sense_id": "34fc7ec0-d9a4-3e9a-9460-29a785f5d5d3",
                                                "text": "Wir haben Jaguare in freier Wildbahn gesehen."
                                            },
                                            {
                                                "example_id": "b2ca34e9-6754-4548-8d83-436b8740970d",
                                                "sense_id": "34fc7ec0-d9a4-3e9a-9460-29a785f5d5d3",
                                                "text": "„Von furchtbaren Abgeünden [sic!] zerrissen, von Schlangen durchzogen, von Jaguaren und Panthern gefährdet, der Qual des Hungers, der Pein des Durstes keine Abhilfe bietend, hatte der Forst Santa-Clara bis dahin nur Indianer vom Alapachenstamme beherbergt, Gäste, die jedenfalls noch wilder, schädlicher und furchtbarer als das kriechende Gewürm und die vierfüßigen Raubthiere waren.“"
                                            },
                                            {
                                                "example_id": "c3e5efe3-e8f0-4a2a-897b-4836e494da83",
                                                "sense_id": "34fc7ec0-d9a4-3e9a-9460-29a785f5d5d3",
                                                "text": "„Nach dem Tiger und dem Löwen ist der Jaguar die drittgrößte Raubkatze der Welt und die größte Katze Nord- und Südamerikas.[…]Der Jaguar ist in ganz Süd- und Mittelamerika, von Mexiko bis nach Argentinien verbreitet. Wobei der Regenwald im Amazonasbecken heute als Verbreitungsschwerpunkt für den Jaguar gilt.[…]Der natürliche Lebensraum des Jaguars hat sich in den letzten Jahrzehnten um mehr als 50 Prozent verkleinert.“"
                                            },
                                            {
                                                "example_id": "a830ccac-7d06-4a37-920c-c1680d534f38",
                                                "sense_id": "34fc7ec0-d9a4-3e9a-9460-29a785f5d5d3",
                                                "text": "„Der Jaguar spielte im Kult daher auch eine besondere Rolle und wurde in vielen Darstellungen verewigt.“"
                                            },
                                            {
                                                "example_id": "0cebab53-bd1d-4d01-968c-16858c0da32a",
                                                "sense_id": "34fc7ec0-d9a4-3e9a-9460-29a785f5d5d3",
                                                "text": "„Kaum hatte Pencroff Harbert am Arm gepackt und zur Seite gerissen, da erschien ein Jaguar am Eingang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Jaguar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a93cabf6-3830-3067-96f0-085f3d9000bc",
                                        "entry_id": "56bfd37f-4d30-3fc0-a6da-7bccfd208240",
                                        "glosses": [
                                            "Automobilhersteller mit Sitz in Großbritannien"
                                        ],
                                        "tags": [
                                            "ohne Genus, ohne Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19fb8c97-64fd-4d48-9f59-cbf1baa605b4",
                                                "sense_id": "a93cabf6-3830-3067-96f0-085f3d9000bc",
                                                "text": "„Jaguar stand einmal für Eleganz im Autobau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3346da66-0b37-3ebe-b4ac-a21b32b2952a",
                                        "entry_id": "56bfd37f-4d30-3fc0-a6da-7bccfd208240",
                                        "glosses": [
                                            "Fahrzeug von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a2dd54-d5a3-43bb-9a3c-ef8b69cc1615",
                                                "sense_id": "3346da66-0b37-3ebe-b4ac-a21b32b2952a",
                                                "text": "„Daddy hatte einen Jaguar und Mummy fuhr einen Saab, daher hatten die Mädchen keine Idee, wohin es in einem Taxi gehen mochte.“"
                                            },
                                            {
                                                "example_id": "485d1c79-3ad6-4890-b87f-7033ca171b5a",
                                                "sense_id": "3346da66-0b37-3ebe-b4ac-a21b32b2952a",
                                                "text": "„Ben hat die Fahrertür seines Jaguars geöffnet.“"
                                            },
                                            {
                                                "example_id": "4f227f8c-5244-4e05-bd10-a445163c4b92",
                                                "sense_id": "3346da66-0b37-3ebe-b4ac-a21b32b2952a",
                                                "text": "„Im Hintergrund erkannte er eine Vierergarage, aber ein Jaguar, ein Mercedes, ein Honda S2000 und ein Cadillac standen trotzdem wie an einer Perlenschnur vor der Einfahrt aufgereiht.“"
                                            },
                                            {
                                                "example_id": "27cb5c06-2338-47e8-92a9-5c03cb73ec81",
                                                "sense_id": "3346da66-0b37-3ebe-b4ac-a21b32b2952a",
                                                "text": "„Nie zuvor gab es einen Jaguar mit 600 PS.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
