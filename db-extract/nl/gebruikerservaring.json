                        "glosses": [
                            "term die alle aspecten beschrijft van de ervaring van een gebruiker bij interactie met een product, dienst, omgeving of faciliteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cc6c63d-e501-494c-ae89-ec63623f5c79",
                                "sense_id": "552fa50e-6cd4-373e-8036-33c9a22c82e7",
                                "text": "De gegevens werden gebruikt om \"de gebruikerservaring op het platform te verbeteren\". Dat werd bijvoorbeeld gedaan door vriendschapsverzoeken voor te stellen op basis van gemeenschappelijke vrienden."
                            },
                            {
                                "example_id": "be718a5b-c271-43b4-84ef-a39dedd3f931",
                                "sense_id": "552fa50e-6cd4-373e-8036-33c9a22c82e7",
                                "text": "Want Netflix hield lang vol dat offline kijken niet nodig was, zegt Joost. \"Volgens Netflix zou dat slecht zijn voor de gebruikerservaring, omdat je vooraf zou moeten bepalen wat je wilt kijken. En dat is te omslachtig, vinden ze.\""
                            }
                        ]
                    }
