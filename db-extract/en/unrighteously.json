                        "glosses": [
                            "In an unrighteous manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e56e885-8fde-4b62-96fb-084c4f3912d9",
                                "sense_id": "e6f2fe58-0c3c-3413-b315-d71c30720d25",
                                "text": "Set a happy and an influential example to your fellow slaveholders, by a righteous treatment of those, whom you unrighteously hold in bondage."
                            },
                            {
                                "example_id": "d1a7cd3a-6fdd-4c85-9611-97aed7f4ede5",
                                "sense_id": "e6f2fe58-0c3c-3413-b315-d71c30720d25",
                                "text": "On the other hand, there are persons who have continually disapproved of the principle of compensation for a wrong given up, or the loss of an advantage unrighteously purchased."
                            }
                        ]
                    }
