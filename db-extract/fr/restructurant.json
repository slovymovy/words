                    {
                        "sense_id": "16ca9c32-e521-35db-831c-73fae40fbed6",
                        "entry_id": "caad6c75-2bc2-37cd-9bc9-232780c8c976",
                        "glosses": [
                            "Qui permet de restructurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68df76ff-b1e8-44fb-a7d1-40b44194eb35",
                                "sense_id": "16ca9c32-e521-35db-831c-73fae40fbed6",
                                "text": "Certains produits de dernière génération, aux noms étranges, étaient, disait-on, capables de véritables miracles : acides de fruit « revitalisants », élastine « redensifiante », collagène « repulpant », rétinol « restructurant »."
                            },
                            {
                                "example_id": "cd9bb964-e7bd-4a40-9862-eb50d7496c81",
                                "sense_id": "16ca9c32-e521-35db-831c-73fae40fbed6",
                                "text": "Le processus novateur qui nous occupe introduit un champ de forces restructurantes dans le réseau relationnel global d’un individu."
                            },
                            {
                                "example_id": "61b5fe4c-11fa-4c88-958c-5b556185e908",
                                "sense_id": "16ca9c32-e521-35db-831c-73fae40fbed6",
                                "text": "Très riche en vitamines A, B3, B8, D, K, et E, c’est une huile antioxydante, restructurante et hydratante bien adaptée aux peaux matures."
                            }
                        ]
                    }
