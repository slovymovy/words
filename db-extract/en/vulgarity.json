                    {
                        "translation_id": "6357dfab-1131-4a25-8ba6-daa47d81cc09",
                        "source_entry_id": "11e3146d-3b85-33e9-9b08-440d9f07070e",
                        "source_sense_description": "offensive or obscene act",
                        "target_lang_word": "grossièreté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossièreté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "130210c8-ef81-308c-81dc-a3878f4e4887",
                                        "entry_id": "63085070-e0b0-3b8c-b634-ee61591a4703",
                                        "glosses": [
                                            "Caractère de ce qui manque de finesse, de délicatesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a105167b-7c8f-46f0-97f3-e4819b98ffa1",
                                                "sense_id": "130210c8-ef81-308c-81dc-a3878f4e4887",
                                                "text": "La grossièreté d’une étoffe, d’un drap, d’une toile."
                                            },
                                            {
                                                "example_id": "0dcf73e3-9817-49fd-96dc-a18326c6d2f7",
                                                "sense_id": "130210c8-ef81-308c-81dc-a3878f4e4887",
                                                "text": "La grossièreté des traits."
                                            },
                                            {
                                                "example_id": "7b60b6f7-c819-4b20-aca1-6b2f524522a9",
                                                "sense_id": "130210c8-ef81-308c-81dc-a3878f4e4887",
                                                "text": "La grossièreté de cette architecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad7fae2-f737-3860-ab39-025c1b2674a3",
                                        "entry_id": "63085070-e0b0-3b8c-b634-ee61591a4703",
                                        "glosses": [
                                            "Rudesse qui vient du défaut de culture, d’éducation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf21afad-275e-4a4c-ab12-e4c95e5c08eb",
                                                "sense_id": "cad7fae2-f737-3860-ab39-025c1b2674a3",
                                                "text": "Voici le généralissime Bourbouze : vieux soldat, avec sa grossièreté native et en partie affectée, avec sa bonhomie affectée et peut-être en partie naturelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11b4b564-593c-3491-b3a5-5766d968cfe0",
                                        "entry_id": "63085070-e0b0-3b8c-b634-ee61591a4703",
                                        "glosses": [
                                            "Impolitesse, défaut de civilité dans ce qu’on dit ou ce qu’on fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915907e0-0d66-4e94-9f8c-39c1f991fb6a",
                                                "sense_id": "11b4b564-593c-3491-b3a5-5766d968cfe0",
                                                "text": "Les rares propos qu’un étonnement extrême permit à mesdames d’Hocquincourt et de Puylaurens furent choisis de façon à pousser l’impertinence jusqu’au point précis où elle devient de la grossièreté, et peut déposer contre le savoir-vivre de la personne qui l’emploie."
                                            },
                                            {
                                                "example_id": "5ce14350-a7e1-45df-ae84-412e841c88d7",
                                                "sense_id": "11b4b564-593c-3491-b3a5-5766d968cfe0",
                                                "text": "Mes compagnons étaient des hommes simples et rudes, sans grossièreté pourtant, qui respectaient mon rêve et mes silences – très silencieux eux-mêmes d’ailleurs."
                                            },
                                            {
                                                "example_id": "57628bc9-484c-4f03-810f-76fb62b3028d",
                                                "sense_id": "11b4b564-593c-3491-b3a5-5766d968cfe0",
                                                "text": "Et, tout à l'heure, quand il s'était adressé à la prostituée enceinte, il avait usé d'un terme dont la grossièreté — tirant son origine d'une langue moins noble et moins enveloppée que l'argot — me choquait encore secrètement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7e0dae-151f-3300-a86f-67a8784f2667",
                                        "entry_id": "63085070-e0b0-3b8c-b634-ee61591a4703",
                                        "glosses": [
                                            "Manière de parler grossière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6edc59c3-1bd0-4d2f-b51e-81f78abec025",
                                                "sense_id": "4d7e0dae-151f-3300-a86f-67a8784f2667",
                                                "text": "Fréquent et insupportable à l'urgence, un agité, saoul, méchant et sale, hurle des grossièretés. « Salopes, espèces de salopes, toutes des salopes »."
                                            },
                                            {
                                                "example_id": "15b0ebfb-fa1a-4465-8f55-d50d34f174f8",
                                                "sense_id": "4d7e0dae-151f-3300-a86f-67a8784f2667",
                                                "text": "J'adore sa simplicité, sa sagesse. Il n'a pas besoin de dire des grossièretés pour faire rire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f0e93b-3dfa-3d9f-82d8-d72d40d6a979",
                                        "entry_id": "63085070-e0b0-3b8c-b634-ee61591a4703",
                                        "glosses": [
                                            "Ce qui suppose beaucoup d’ignorance, de sottise, de déraison ou de maladresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9156fbb-a379-4453-bffe-bcce82b09a11",
                                                "sense_id": "11f0e93b-3dfa-3d9f-82d8-d72d40d6a979",
                                                "text": "Cela fait mieux ressortir la grossièreté de cette faute, de cette bévue."
                                            },
                                            {
                                                "example_id": "43d1a68f-3d04-4795-96f2-7021afaa4b4f",
                                                "sense_id": "11f0e93b-3dfa-3d9f-82d8-d72d40d6a979",
                                                "text": "La grossièreté d’une erreur d’une illusion."
                                            },
                                            {
                                                "example_id": "07bef90f-d275-4be6-8482-67a0292c0f92",
                                                "sense_id": "11f0e93b-3dfa-3d9f-82d8-d72d40d6a979",
                                                "text": "Ce mensonge est d’une telle grossièreté qu’on ne peut pas en être dupe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f240c009-9808-4d88-8ffa-1667ba6b08c7",
                        "source_entry_id": "11e3146d-3b85-33e9-9b08-440d9f07070e",
                        "source_sense_description": "offensive or obscene act",
                        "target_lang_word": "по́шлость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "по́шлость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "43570e62-cba3-363e-9c57-23349601d80a",
                                        "entry_id": "0616da77-a92e-3c82-8534-1542aa0f2ca3",
                                        "glosses": [
                                            "свойство по значению прилагательного пошлый, безвкусная и безнравственная грубость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75903a5e-c740-4724-b857-7ee909ed4f56",
                                                "sense_id": "43570e62-cba3-363e-9c57-23349601d80a",
                                                "text": "Пошлость имеет громадную силу; она всегда застает свежего человека врасплох, и, в то время как он удивляется и осматривается, она быстро опутывает его и забирает в свои тиски."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f36f552-5688-3c09-b342-3742833b65b5",
                                        "entry_id": "0616da77-a92e-3c82-8534-1542aa0f2ca3",
                                        "glosses": [
                                            "пошлый поступок либо пошлое высказывание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d4db8c-c6a8-4361-880a-80a2a6a92ce9",
                                                "sense_id": "3f36f552-5688-3c09-b342-3742833b65b5",
                                                "text": "В Петербурге есть особая порода людей, которые специально занимаются тем, что вышучивают каждое явление жизни; они не могут пройти даже мимо голодного или самоубийцы без того, чтобы не сказать пошлости."
                                            },
                                            {
                                                "example_id": "6f6e45fc-b424-4cee-8244-a2af8c0e58b9",
                                                "sense_id": "3f36f552-5688-3c09-b342-3742833b65b5",
                                                "text": "У нас в доме часто повторяли: «деньги счет любят», «копейка рубль бережет» и тому подобное, и сестра, подавленная этими пошлостями, старалась только о том, как бы сократить расходы, и оттого питались мы дурно."
                                            },
                                            {
                                                "example_id": "6e32560a-496d-46f0-b2d3-bbccd630e06f",
                                                "sense_id": "3f36f552-5688-3c09-b342-3742833b65b5",
                                                "text": "Я слишком люблю и уважаю своего мужа, чтобы позволить какому-нибудь проезжему нахалу говорить мне разные пошлости…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea47d222-34e2-38e4-8b6e-cbfa732e26cd",
                                        "entry_id": "0616da77-a92e-3c82-8534-1542aa0f2ca3",
                                        "glosses": [
                                            "плоская шутка, несмешная острота"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
