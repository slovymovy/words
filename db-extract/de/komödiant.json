                        "glosses": [
                            "Person, die anderen theatralisch bestimmte Empfindungen vorspielt/vortäuscht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
