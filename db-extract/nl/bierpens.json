                        "sense_id": "7856ca9c-8c21-30d5-a2f0-899ade20f4ab",
                        "entry_id": "7ab87498-1c46-368f-9add-ef3f72b604e0",
                        "glosses": [
                            "dikke buik, toegeschreven aan het drinken van veel bier"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6f48f6d7-517a-4c4c-a231-546c872aac22",
                                "sense_id": "7856ca9c-8c21-30d5-a2f0-899ade20f4ab",
                                "text": "In Hell or High water is hij een Texas Ranger, inclusief cowboyhoed en bierpens, die op de vooravond van zijn pensioen twee bankrovers achtervolgt."
                            },
                            {
                                "example_id": "b3f677fc-f505-4a94-a7b7-20a814a9f7fb",
                                "sense_id": "7856ca9c-8c21-30d5-a2f0-899ade20f4ab",
                                "text": "Ze sloeg op haar zwanger lichaam als een Duitsche boer op zijn bierpens en ze geeuwde: - Ikke krijg 'n meid."
                            }
                        ]
                    },
                    {
                        "sense_id": "943a015c-0407-3b2c-8c35-d26219160685",
                        "entry_id": "7ab87498-1c46-368f-9add-ef3f72b604e0",
                        "glosses": [
                            "man die te dik is doordat hij veel bier drinkt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "84d63ac5-63d5-4a74-8aab-b49fd8373c02",
                                "sense_id": "943a015c-0407-3b2c-8c35-d26219160685",
                                "text": "Nu lachten zijn vrienden. De bierpens kleurde dieprood, maar had geen verweer."
                            }
                        ]
                    }
                ],
