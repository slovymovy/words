                    {
                        "translation_id": "7d02c164-a958-4d29-8790-a886225b4db9",
                        "source_entry_id": "67db7607-5b33-3384-b1ab-f6c158cdcf34",
                        "source_sense_id": "5f624963-cd2b-301c-ab52-651e8cdd7427",
                        "target_lang_word": "tückisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tückisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5df8e87e-62f3-365d-9379-5c9bc445ac10",
                                        "entry_id": "89da1c52-8162-3197-9b97-1c379d0997b9",
                                        "glosses": [
                                            "gefährlich und dabei unberechenbar"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                        "entry_id": "89da1c52-8162-3197-9b97-1c379d0997b9",
                                        "glosses": [
                                            "gefährlich und dabei unberechenbar",
                                            "durch eine plötzliche oder nicht gleich erkennbare Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e577e3-f0a2-4495-9037-911ec999f757",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Basler schoss den Freistoß und der Ball drehte sich tückisch um die Mauer ins Tor."
                                            },
                                            {
                                                "example_id": "a56c1a17-c417-4918-8c10-7482e73dbb57",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Beim US Masters spielen die besten Golfprofis um das legendäre Green Jacket. Mit Martin Kaymer und Bernhard Langer schlagen zwei Deutsche in Augusta ab. Die tückischen Grüns bereiten besonders Kaymer Probleme."
                                            },
                                            {
                                                "example_id": "cffe4495-2347-4285-9c0f-607dadf4c171",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Bluthochdruck ist eine tückische Krankheit, weil der Kranke nichts von ihr merkt."
                                            },
                                            {
                                                "example_id": "46c041da-57ac-4ef9-8616-e6c29f1dce19",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Tückisch ist die krebserzeugende Wirkung von Aflatoxinen, das sind Ausscheidungsprodukte von Schimmelpilzen."
                                            },
                                            {
                                                "example_id": "15dac431-bdb8-4352-82a4-4b56a9ad46b4",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Harmlos ist sie [die Grippe] nicht: In den USA sterben jährlich 20 000 meist ältere Leute daran. \"Das sind mehr Menschen, als Aids zum Opfer fallen\", sagt [der Forschungschef der kleinen Bio-Tech-Firma Gilead Norbert] Bischofberger. Und etwa alle zwanzig Jahre bricht eine besonders tückische Grippe aus. Die bisher schlimmste, die \"spanische Grippe\", tötete im Winter 1918/19 über 20 Millionen Menschen."
                                            },
                                            {
                                                "example_id": "7d59d415-4ec1-43a5-939f-fec98a24afa2",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Die Strömung in dieser [Meeres-]Enge war stark, tückisch und wechselte mehrmals am Tag die Richtung."
                                            },
                                            {
                                                "example_id": "2108882a-61a1-4616-b51a-6905c4cfb35b",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Es kann gefährlich sein, im Winter auf einen zugefrorenen See zu laufen, denn das Eis kann an einigen Stellen tückisch dünn sein."
                                            },
                                            {
                                                "example_id": "a94fe7a0-b0fc-4165-ad95-390283412bed",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Es ist die Landung, die den Flug zum Nachbarplaneten tückisch macht: Die Erfolgsrate liege bislang unter 50 Prozent, sagt Mars-Programmdirektor Doug McCuistion von der NASA."
                                            },
                                            {
                                                "example_id": "89b72424-9c1a-497f-8d54-06e23b7e5423",
                                                "sense_id": "ffcdfad8-b768-3c20-acd8-a5c8009351b9",
                                                "text": "Aber irgendwie scheint das mit dem Alter tückisch zu sein. So viele kluge Köpfe, die, wenn sie in die Jahre kommen, blödes Zeug von sich geben oder Dinge tun, die konträr zu der Haltung stehen, die sie vor der Grauhaargrenze vertreten haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b756065-f23c-3ed2-8944-d398034ef661",
                                        "entry_id": "89da1c52-8162-3197-9b97-1c379d0997b9",
                                        "glosses": [
                                            "gefährlich und dabei unberechenbar",
                                            "durch jemanden, der einen anderen in eine Falle locken will (häufig in einem Kampf / durch einen Kämpfer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9050c5be-09de-42b9-b7c6-f8d7f642e2ab",
                                                "sense_id": "4b756065-f23c-3ed2-8944-d398034ef661",
                                                "text": "Die Taliban und andere Aufständische nehmen oft Unternehmen ins Visier, die die tückischen Sprengkörper beseitigen."
                                            },
                                            {
                                                "example_id": "ac2e3729-875b-43aa-a25c-e9aa5cfbbe50",
                                                "sense_id": "4b756065-f23c-3ed2-8944-d398034ef661",
                                                "text": "Er [der Fußballer Islam Slimani] setzt jedenfalls zum Sprung an und tritt nach einem mächtigen Satz dem libyschen Verteidiger Mohamed El Mughrabi in den Rücken. Es ist ein tückischer Angriff, von seltener Brutalität. El Mughrabi hat keine Chance zur Abwehr, er hat Slimani nicht mal heran springen sehen und sackt schmerzverzerrt zu Boden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
