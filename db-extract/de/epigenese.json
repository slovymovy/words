                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épigenèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91024755-c4ab-3def-9683-39abe9349c9d",
                                        "entry_id": "cf6bcc69-80ab-365e-bd4d-d8efd4430b70",
                                        "glosses": [
                                            "Genèse graduelle, addition successive de diverses parties : le nouvel être étant d’abord à l’état d’ovule, puis de germe, enfin d’embryon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f67098-22d5-4536-a600-553348b00c21",
                                                "sense_id": "91024755-c4ab-3def-9683-39abe9349c9d",
                                                "text": "L’épigenèse, opposée au système d’après lequel les parties, préexistant dans le germe, ne font que se développer, est adoptée par la physiologie moderne."
                                            },
                                            {
                                                "example_id": "41a817ed-cf20-4cd3-9bba-b0c3c8cdfb15",
                                                "sense_id": "91024755-c4ab-3def-9683-39abe9349c9d",
                                                "text": "La conception de l’épigenèse néonatale, dont l’anticipation est un des piliers, dépend d’abord de la position retenue face à ce dualisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
