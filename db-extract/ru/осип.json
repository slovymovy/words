                    },
                    {
                        "translation_id": "5c8a4f49-c96a-440d-b0dd-dd01cb2b0316",
                        "source_entry_id": "ef1f9a2a-7c3b-3620-9279-06c304a62b6f",
                        "source_sense_id": "8a604922-c13d-3158-80c2-aae805dfb58d",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Józef",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Józef",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "247d7c31-cd5e-30f9-aecd-6a3c92800355",
                                        "entry_id": "3ca7fdd8-3599-3f3d-887f-289b0c2d151f",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ef0aeb-68be-45b6-a2e8-dc76a6650af3",
                                                "sense_id": "247d7c31-cd5e-30f9-aecd-6a3c92800355",
                                                "text": "Wielkie znaczenie dla biblijnej opowieści o ludzie wybranym, jakie przypisuje się Jakubowi, wynika z faktu, że dwunastu jego synów (Ruben, Symeon, Lewi, Juda, Issachar, Zabulon, Józef, Beniamin, Dan, Neftali, Gad , Aser) dało początek tzw. dwunastu plemionom Izraela, po tym, jak sam Jakub zyskał to imię - Izrael, a jego potomkowie od tego czasu będą nazywać siebie Bnej Izrael, Izraelici, synowie Izraela."
                                            },
                                            {
                                                "example_id": "0cd7063c-eaee-4dc4-b26d-2a4a7686bd26",
                                                "sense_id": "247d7c31-cd5e-30f9-aecd-6a3c92800355",
                                                "text": "Mój stryjeczny dziadek ma na imię Józef."
                                            },
                                            {
                                                "example_id": "9730b807-7daa-4b50-8f2d-c262053a400c",
                                                "sense_id": "247d7c31-cd5e-30f9-aecd-6a3c92800355",
                                                "text": "Józef Bem był wybitnym artylerzystą i teoretykiem wojskowości oraz generałem wojsk polskich, węgierskich i tureckich."
                                            },
                                            {
                                                "example_id": "9d0bd535-8ef2-4836-b770-bcb638ac644a",
                                                "sense_id": "247d7c31-cd5e-30f9-aecd-6a3c92800355",
                                                "text": "W Kościele katolickim na 19 marca przypada wspomnienie św. Józefa z Nazaretu, patrona ojców, rodzin, cieśli, drwali, robotników, rzemieślników i dobrej śmierci."
                                            },
                                            {
                                                "example_id": "7687fa3f-401e-4b9e-a07f-ed0f3d0c7f02",
                                                "sense_id": "247d7c31-cd5e-30f9-aecd-6a3c92800355",
                                                "text": "Józefowie dzień swego patrona, czyli imieniny, obchodzą 19 marca, a także 29 stycznia, 4, 14 i 28 lutego, 1 marca, 1 maja, 23 czerwca, 4 lipca, 25 sierpnia, 18 września oraz 14 listopada."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
