                    {
                        "translation_id": "9d7fa5b9-d09d-4e43-91ca-a2b45d5d493a",
                        "source_entry_id": "4f41048d-fbbd-3f04-a5e6-6c238b3ce332",
                        "source_sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
