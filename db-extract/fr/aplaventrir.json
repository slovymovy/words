                        "examples": [
                            {
                                "example_id": "e1d5bc75-d00d-4f43-a266-ece2687bbab6",
                                "sense_id": "72969699-8898-3f31-bad0-79f9c0f8c07e",
                                "text": "Pourquoi devrions nous nous aplaventrir à ce point ?"
                            },
                            {
                                "example_id": "8510db0a-45f8-415b-b542-b0175e2fe4cd",
                                "sense_id": "72969699-8898-3f31-bad0-79f9c0f8c07e",
                                "text": "D'une certaine façon, on pense que la loi nᵒ 103, c'est d'une certaine façon s’aplaventrir."
                            },
                            {
                                "example_id": "072486ba-5e7b-413a-a55d-a566af62102a",
                                "sense_id": "72969699-8898-3f31-bad0-79f9c0f8c07e",
                                "text": "Qu'Israël s’aplaventrisse devant les fous furieux musulmans intégristes ?"
                            },
                            {
                                "example_id": "297fc024-26a9-4199-b4e7-e03cee85f520",
                                "sense_id": "72969699-8898-3f31-bad0-79f9c0f8c07e",
                                "text": "(...) ne lui accordant aucune assistance et même s’aplaventrissant en excuses devant le régime nazi, Couchepin a fait oeuvre utile."
                            }
                        ]
