                                        "glosses": [
                                            "Bremen, die Bremer betreffend; aus Bremen oder von Bremern stammend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da63d58-766a-4c99-8bd8-0f8530f68381",
                                                "sense_id": "77b44a5e-7006-316e-8a82-a1c69033ebf7",
                                                "text": "Er stammte von bremischen Kaufleuten und Senatoren ab, kam also aus der großbürgerlichen Schicht."
                                            },
                                            {
                                                "example_id": "524e3969-74a6-42c8-b43f-4395d325eca0",
                                                "sense_id": "77b44a5e-7006-316e-8a82-a1c69033ebf7",
                                                "text": "Die Bremer sind dankbar, daß sie wieder eine bremische Heimatflotte haben."
                                            }
