                "senses": [
                    {
                        "sense_id": "90304bb2-494b-3326-98d5-125447cb0431",
                        "entry_id": "5c9964ae-e818-3e40-af9d-a722e556c920",
                        "glosses": [
                            "город во Франции, центр департамента Жиронда"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53942d7-97c6-4377-8416-e75f17f0bc5f",
                                "sense_id": "90304bb2-494b-3326-98d5-125447cb0431",
                                "text": "В ноябре того же года назначен русский консул в Бордо, главным образом для надзора за виноторговлею."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afc4aa2d-0b9c-4c2a-8365-dc048c2873fd",
