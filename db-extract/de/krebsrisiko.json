                "senses": [
                    {
                        "sense_id": "ec31e408-9c68-3eb9-9118-ef2d4410a20a",
                        "entry_id": "f62a5ced-d9eb-30ea-80d0-acaaa62e65aa",
                        "glosses": [
                            "Risque de cancer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45af08f-6465-4b67-b2c2-e05052c6e8e1",
                                "sense_id": "ec31e408-9c68-3eb9-9118-ef2d4410a20a",
                                "text": "Nüsse enthalten zudem noch Ballaststoffe. Und die haben grundsätzlich wahnsinnig viele positive Wirkungen – auf das Herz-Kreislauf-System, auf den Cholesterinspiegel, auf das Krebsrisiko und Körpergewicht.",
                                "translation": "Les noix contiennent en outre des fibres alimentaires. Et celles-ci ont en principe un nombre incroyable d'effets positifs - sur le système cardiovasculaire, sur le taux de cholestérol, sur le risque de cancer et sur le poids corporel."
                            }
                        ]
                    }
                ],
