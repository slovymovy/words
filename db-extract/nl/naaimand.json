                                        "glosses": [
                                            "A bag containing tools or material used for work, especially needlework."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ccb72e-edef-4ea1-a3d6-3a62e2aa2f1b",
                                                "sense_id": "f1e14949-bf19-356e-8fce-5e1e601d241b",
                                                "text": "The American Medical Association warns that carrying more than 10 percent of your body weight can lead to injury, and the overnight appearance of low back pain led me to weigh my own workbag a few summers ago (back then, it was a satchel slung over one shoulder)."
                                            }
