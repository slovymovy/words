                "senses": [
                    {
                        "sense_id": "a8f802b3-36bb-322c-ad5d-d4e282faacdf",
                        "entry_id": "963fb9d9-cb96-3ac1-83b4-c89acf7d423c",
                        "glosses": [
                            "To work in a careless and unprofessional manner, messing around."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127aac67-e1d1-4546-b31f-52e9b72f4459",
                                "sense_id": "a8f802b3-36bb-322c-ad5d-d4e282faacdf",
                                "text": "'Wat is dat voor een visbestek waarmee je daar staat te klodderen?' 'Ik klodder niet!' riep heer Ollie verontwaardigd uit. 'En dit zijn pas échte gereedschappen voor een tere kunstbeeldhouwer, die er mee kan timmeren zonder zijn gevoelige handen te bezeren?'",
                                "translation": "'What kind of fish cutlery is that which you are messing around with?' 'I'm not messing around!' said sir Ollie in disdain. 'And these are real tools for the sensitive sculptor, who can work with them without hurting his sensitive hands?'",
                                "english": "'What kind of fish cutlery is that which you are messing around with?' 'I'm not messing around!' said sir Ollie in disdain. 'And these are real tools for the sensitive sculptor, who can work with them without hurting his sensitive hands?'"
                            }
                        ]
                    }
                ],
