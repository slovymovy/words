                                            {
                                                "example_id": "2bbab835-31dd-4939-a237-6107bdb9b121",
                                                "sense_id": "9cdd135b-4222-33dd-b0d1-489d46d7b2a3",
                                                "text": "Proto je tu tolik drožek, aut, zatracených bicyklů, hluku, bank, kolportérů, tramvají,…"
