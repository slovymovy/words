                                        "sense_id": "3bad575e-b7a3-3b08-a470-8b00b15611e8",
                                        "entry_id": "d29fd527-4975-3e8d-992c-74d3b8c8a4d0",
                                        "glosses": [
                                            "An ideology that prioritizes the family by advocating a welfare system that assumes that households, not the state, take responsibility for the care of their members."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89610d89-afbb-4aa3-9b70-a0a908e53e92",
                                                "sense_id": "3bad575e-b7a3-3b08-a470-8b00b15611e8",
                                                "text": "However, I chose to refer to this model as “implicit maternalism” instead of “supported familialism” to emphasize the implicit social and political understanding that mothers instead of fathers (or “families”) perform the bulk of care work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785caccb-e089-3275-9ee8-3148941cb929",
                                        "entry_id": "d29fd527-4975-3e8d-992c-74d3b8c8a4d0",
                                        "glosses": [
                                            "A cultural value that emphasizes the importance of close family relationships, such as prioritizing the needs of the family higher than that of individuals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24f83e72-4e09-4c12-8153-737d5ea59df1",
                                                "sense_id": "785caccb-e089-3275-9ee8-3148941cb929",
                                                "text": "First, Latinas were expected to have higher familialism than European Americans."
                                            }
                                        ]
                                    }
