        "fr-extract.jsonl": [
            {
                "entry_id": "6e64aa1a-011b-3503-b130-04d18b07bf50",
                "word": "déportement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b6942ea-d86d-423c-9071-89e2ccf5f224",
                        "entry_id": "6e64aa1a-011b-3503-b130-04d18b07bf50",
                        "tags": [
                            "plural"
                        ],
                        "form": "déportements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                        "entry_id": "6e64aa1a-011b-3503-b130-04d18b07bf50",
                        "glosses": [
                            "Mauvaise manière de vivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768e311e-aab3-42d0-ae7b-e6367318ad3a",
                                "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                                "text": "Ah ! maudite vie de garçon ! Sans mes déportements, ma Célestine serait aujourd’hui la vicomtesse Popinot !"
                            },
                            {
                                "example_id": "cd6fee31-b6fd-44fc-ae65-40fb768cb278",
                                "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                                "text": "« Monsieur, dit le prince, vos équipées dépassent les bornes, et vos déportements sont tels, que je serai forcé d’implorer du roi, pour vous, la faveur d’un cachot ou d’un exil perpétuels. »"
                            },
                            {
                                "example_id": "8be89f68-c80b-4e89-bf0b-f5ec98f6d0ef",
                                "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                                "text": "Il se posta sous le lit de la camérière avec qui le ministre faisait ses déportements - votre propre camérière, Sire- …"
                            },
                            {
                                "example_id": "4c1a751f-390f-4d2b-807d-82d309d0a721",
                                "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                                "text": "Ils [les grands écrivains] choisissent même de préférence, pour héroïnes, des femmes que leur passions et leurs déportements ont rendues illustres : Médée, Didon, Phèdre."
                            },
                            {
                                "example_id": "cda1eb7e-18ec-4068-bca1-48f70451807f",
                                "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                                "text": "Cette gouvernante ne vous est connue, en somme, que par Mme de Châteaubedeau, qui a rendu elle-même son intervention nécessaire par ses propres déportements."
                            },
                            {
                                "example_id": "8e02c7c3-1d6c-4f49-8d4c-d1d3a75437c7",
                                "sense_id": "687c7dc5-036a-3728-b293-a703e93a96ce",
                                "text": "Monsieur de Caumont, je m'étonne que vous me demandiez justice. Tout votre déportement dans votre province vous accuse et vous condamne."
                            }
                        ]
                    },
                    {
                        "sense_id": "509d786b-c20d-3755-b1fb-62b53a22e957",
                        "entry_id": "6e64aa1a-011b-3503-b130-04d18b07bf50",
                        "glosses": [
                            "Fait d’être déporté, en parlant d’un véhicule."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6dbc773e-e3f1-3ce6-8922-70172afbfeab",
                        "entry_id": "6e64aa1a-011b-3503-b130-04d18b07bf50",
                        "glosses": [
                            "Excédent de taille d’un moule qu’on lui donne quand la matière moulée à chaud subit un retrait lors de son refroidissement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6933d7fa-16cc-4dad-a524-347541db3b4e",
                        "source_entry_id": "6e64aa1a-011b-3503-b130-04d18b07bf50",
                        "source_sense_description": "Mauvaise manière de vivre.",
                        "target_lang_word": "swerve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swerve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70da1471-fc13-37d7-9928-24ae3e365475",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To stray; to wander; to rove."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43fc325b-5213-445e-b1d8-4dedab0632c6",
                                                "sense_id": "70da1471-fc13-37d7-9928-24ae3e365475",
                                                "text": "A maid thitherward did run, / To catch her sparrow which from her did swerve.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6394ccac-2858-3f69-bb93-5c31ca53077b",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To go out of a straight line; to deflect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b03cdc-1e9b-4f28-a4c6-c1180427638f",
                                                "sense_id": "6394ccac-2858-3f69-bb93-5c31ca53077b",
                                                "text": "with the slipping of the pommel , the point swerved",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45bd61d-9bd9-3a4f-a265-76446213da8e",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To wander from any line prescribed, or from a rule or duty; to depart from what is established by law, duty, custom, or the like; to deviate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c2ddf3-0495-4416-83c0-5d86d77c67db",
                                                "sense_id": "a45bd61d-9bd9-3a4f-a265-76446213da8e",
                                                "text": "I swerve not from thy commandments."
                                            },
                                            {
                                                "example_id": "6b2b0549-21e9-4f8b-abe5-c9754ccd670b",
                                                "sense_id": "a45bd61d-9bd9-3a4f-a265-76446213da8e",
                                                "text": "They swerve from the strict letter of the law."
                                            },
                                            {
                                                "example_id": "4aee8285-49d0-4010-a6c9-3968b9fe531c",
                                                "sense_id": "a45bd61d-9bd9-3a4f-a265-76446213da8e",
                                                "text": "[T]here are many Perſons, who, through the Heat of their Luſts and Paſſions, through the Contagion of Ill Example, or too deep an Immerſion in the Affairs of Life, ſwerve exceedingly from the Rules of their Holy Faith; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7363fb39-df30-32b7-ab2c-66010e0ff62e",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To bend; to incline; to give way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc1e2aa-f137-4d38-a324-0a98fd8d8c48",
                                                "sense_id": "7363fb39-df30-32b7-ab2c-66010e0ff62e",
                                                "text": "The battle swerved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bea8d19-704f-34e7-b531-b35ab81ad335",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To climb or move upward by winding or turning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cbc3dd3-4995-4562-9ea5-7430b2d0197d",
                                                "sense_id": "7bea8d19-704f-34e7-b531-b35ab81ad335",
                                                "text": "The tree was high; / Yet nimbly up from bough to bough I swerved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c82034e-70bc-3e8d-b4a4-166d2c65d350",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To turn aside or deviate to avoid impact."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a42abf69-7bcf-31d1-a59f-9fe02ff3f1d6",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "Of a projectile, to travel in a curved line"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d61a268d-4485-411f-885c-c539f6e94273",
                                                "sense_id": "a42abf69-7bcf-31d1-a59f-9fe02ff3f1d6",
                                                "text": "Snodgrass also saw a free-kick swerve just wide before Arsenal, with Walcott and Fabregas by now off the bench, turned their vastly superior possession into chances in the closing moments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1dc98c2-0bf7-33fd-a87d-b9945ded2c72",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To drive in the trajectory of another vehicle to stop it, to cut off."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004aa1d6-c910-4b17-be56-66f344ce78fb",
                                                "sense_id": "f1dc98c2-0bf7-33fd-a87d-b9945ded2c72",
                                                "text": "The French invaders, like an infuriated animal that has in its onslaught received a mortal wound, felt that they were perishing, but could not stop, any more than the Russian army, weaker by one half, could help swerving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa6382d1-ef98-32d4-82b1-ade9cfe7f99f",
                                        "entry_id": "74901f82-4b47-3c55-adc2-de64e23a75fa",
                                        "glosses": [
                                            "To go out of one's way to avoid; to snub."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da2c6933-b631-4850-9ebd-704062d3e3a7",
                                                "sense_id": "aa6382d1-ef98-32d4-82b1-ade9cfe7f99f",
                                                "text": "If I see that type o' muthafucka in the club I just swerve him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swerve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba14133e-f8eb-3667-8023-0453809af2b7",
                                        "entry_id": "392f0769-6aca-393c-b100-aaa96a67d008",
                                        "glosses": [
                                            "A sudden movement out of a straight line, for example to avoid a collision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b145151-3dfa-4167-a9c2-b83377c84c2b",
                                                "sense_id": "ba14133e-f8eb-3667-8023-0453809af2b7",
                                                "text": "The distinction between using a skill subconsciously and employing it in the full knowledge of what was happening made a dramatic difference. I could execute a swerve to avoid an obstacle in a fraction of the time it previously took."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c50f82-057c-38e6-9fad-9c23debaa2b9",
                                        "entry_id": "392f0769-6aca-393c-b100-aaa96a67d008",
                                        "glosses": [
                                            "A deviation from duty or custom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe991247-d625-499b-ab53-8d64856c58a1",
                                                "sense_id": "a9c50f82-057c-38e6-9fad-9c23debaa2b9",
                                                "text": "[…] indubitable evidence of a swerve from the principle of the work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44151773-5a7a-3480-8c1e-47d33269dc44",
                                        "entry_id": "392f0769-6aca-393c-b100-aaa96a67d008",
                                        "glosses": [
                                            "Synonym of drift (“sideways movement imparted by spin bowler”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
