                ],
                "senses": [
                    {
                        "sense_id": "0157ba19-f7a2-34c2-9c63-72ad3fa9f4d1",
                        "entry_id": "de1b4578-9ac7-3819-89b1-c1fc13b0440d",
                        "glosses": [
                            "Réaliser un mixage préalable (en cuisine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c4ab88-e239-4f78-ad61-3853557ea245",
                                "sense_id": "0157ba19-f7a2-34c2-9c63-72ad3fa9f4d1",
                                "text": "Ajouter le quinoa, mélanger, prémixer et la levure et bien mélanger."
                            }
                        ]
                    },
                    {
                        "sense_id": "24bf16b0-cc77-3198-9fac-fc392adf93ae",
                        "entry_id": "de1b4578-9ac7-3819-89b1-c1fc13b0440d",
                        "glosses": [
                            "Réaliser un mixage préalable (en musique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c0bbaf-d63c-4b42-8c37-2a76635d9eca",
                                "sense_id": "24bf16b0-cc77-3198-9fac-fc392adf93ae",
                                "text": "Souvent, les huit pistes ne suffisant pas, il faut prémixer quelques pistes déjà enregistrées pour en libérer d’autres."
                            },
                            {
                                "example_id": "917e910b-2456-4bb8-9d2f-0651607bd737",
                                "sense_id": "24bf16b0-cc77-3198-9fac-fc392adf93ae",
                                "text": "Une fois l’enregistrement terminé, je passerai de trois à neuf heures à prémixer."
                            },
                            {
                                "example_id": "71c750a2-dbfe-4494-9208-54bca68252fb",
                                "sense_id": "24bf16b0-cc77-3198-9fac-fc392adf93ae",
                                "text": "Glyn travaille toujours pareil, il prémixe presque tout, c’est-à-dire que sa manière de travailler est exactement l’opposé de celle de Bob Ezrin."
                            }
                        ]
                    }
