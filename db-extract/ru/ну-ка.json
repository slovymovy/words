                                        "entry_id": "1835a8db-c3b7-3b55-a26d-b2e1d03150db",
                                        "glosses": [
                                            "Conveys comfort; used to calm somebody or urge somebody to relax, especially when the person is crying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33451af3-5c1b-4fa2-a7ae-1a10366afbad",
                                                "sense_id": "e38d13b1-be0b-3d75-bf67-3bce8095e3d7",
                                                "text": "There, there. Even though you broke up with her, you'll be fine."
                                            }
                                        ]
                                    }
                                ]
