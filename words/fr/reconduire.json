{
    "word_family": [
        "conduire",
        "conduite",
        "reconduction",
        "reconduite"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ca21ddb-1dc0-31cf-a18d-0c9c25d2588e",
                    "sense_definition": "Accompagner quelqu'un pour le ramener là d'où il vient ou à son domicile.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme il se faisait tard, Thomas a proposé de me <w>reconduire</w> chez moi en voiture."
                        },
                        {
                            "text": "Nous allons vous <w>reconduire</w> à la gare pour que vous ne manquiez pas votre train."
                        }
                    ],
                    "synonyms": [
                        "raccompagner",
                        "ramener"
                    ],
                    "common_phrases": [
                        "reconduire chez soi",
                        "reconduire en voiture"
                    ]
                },
                {
                    "sense_id": "cc75a4e0-63c6-32bd-9ea5-a382f6b9760d",
                    "sense_definition": "Prolonger la durée ou la validité d'un contrat, d'un accord ou d'un mouvement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renouvellement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a décidé de <w>reconduire</w> le contrat de location pour une année supplémentaire."
                        },
                        {
                            "text": "Les salariés réunis en assemblée générale ont voté pour <w>reconduire</w> la grève jusqu'à vendredi."
                        }
                    ],
                    "synonyms": [
                        "proroger",
                        "renouveler"
                    ],
                    "antonyms": [
                        "résilier",
                        "rompre"
                    ],
                    "common_phrases": [
                        "reconduire la grève",
                        "reconduire un contrat"
                    ]
                },
                {
                    "sense_id": "257024e9-fe82-38ec-ae36-56c36d9b907e",
                    "sense_definition": "Accompagner par politesse un invité ou un visiteur jusqu'à la sortie au moment de son départ.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur s'est levé pour <w>reconduire</w> son invité jusqu'au hall d'entrée."
                        },
                        {
                            "text": "Ne vous dérangez pas pour me <w>reconduire</w>, je connais parfaitement le chemin."
                        }
                    ],
                    "synonyms": [
                        "raccompagner"
                    ],
                    "common_phrases": [
                        "reconduire à la porte",
                        "reconduire jusqu'à la sortie"
                    ]
                },
                {
                    "sense_id": "1bddbfb3-4cb9-3d84-a92e-327b68324492",
                    "sense_definition": "Expulser ou forcer quelqu'un à quitter un endroit, parfois avec fermeté.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir provoqué un scandale dans la salle, il s'est fait <w>reconduire</w> dehors sans ménagement."
                        },
                        {
                            "text": "Les autorités ont décidé de <w>reconduire</w> cet individu à la frontière en raison de sa situation irrégulière."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "éconduire",
                        "expulser"
                    ],
                    "antonyms": [
                        "accueillir"
                    ],
                    "common_phrases": [
                        "reconduire à la frontière"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé avec ironie ou sévérité"
                        }
                    ]
                }
            ]
        }
    ]
