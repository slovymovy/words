                },
                {
                    "sense_id": "ca6a5de7-554b-32fa-9831-afb872f76a4b",
                    "sense_definition": "An alternative spelling of <w>saag</w>, referring to a South Asian dish made of leafy greens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered the <w>sag</w> paneer and some garlic naan for dinner.",
                            "target_lang_translations": {
                                "ru": "Я заказал <w>саг</w> панир и чесночный наан на ужин."
