                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3ede63ea-3e77-30ad-ad7e-eff2993d155a",
                                        "entry_id": "b8be85e4-d7f3-3c7f-bd78-585a1162d1b3",
                                        "glosses": [
                                            "bovenkant van de voet tussen tenen en enkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1322d9a-9c9c-4ffc-9a05-54e2f66e2c01",
                                                "sense_id": "3ede63ea-3e77-30ad-ad7e-eff2993d155a",
                                                "text": "Hij scoorde met de wreef."
                                            },
                                            {
                                                "example_id": "821dc0c4-ee8b-4f94-8fbe-8f7593383a26",
                                                "sense_id": "3ede63ea-3e77-30ad-ad7e-eff2993d155a",
                                                "text": "Doordat England onlangs van schoenenmerk was geswitcht begon de wreef van zijn voet na een week gigantisch op te zwellen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wreef",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                                        "entry_id": "1139c189-4864-3c16-936c-d14358afb48a",
                                        "glosses": [
                                            "enkelvoud verleden tijd van wrijven"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2e8c1a-4b79-48af-9f63-bf1f3024d74e",
                                                "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                                                "text": "Ik wreef."
                                            },
                                            {
                                                "example_id": "6fc2464f-5126-4be5-a6cc-96d074cbc4f3",
                                                "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                                                "text": "Jij wreef."
                                            },
                                            {
                                                "example_id": "fedfe2bc-caef-4fa1-b1d6-009babaf3e13",
                                                "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                                                "text": "Hij, zij, het wreef."
                                            },
                                            {
                                                "example_id": "6adcfd04-4199-409b-b008-0ed2890218cb",
                                                "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                                                "text": "Zijn woorden leidden mijn gedachten weer naar die bruiloft in Nasbinals toen mijn bijna- moordenaar Mikhail zijn bezwete lichaam tegen het mijne wreef en zich aan me opgeilde."
                                            },
                                            {
                                                "example_id": "aa4e2271-9da6-4d8b-a212-b27ddfa6fed0",
                                                "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                                                "text": "Ik wreef in mijn ogen en voelde dat de make-up aan mijn vingers bleef plakken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab44e8a5-8dcc-46f9-86e7-6a37c05237a7",
                        "source_entry_id": "0a87321b-0095-3830-96d4-be6b02db8a08",
                        "source_sense_description": "top of the foot between the toes and the ankle",
                        "target_lang_word": "cou-de-pied",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cou-de-pied",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c433b61-7a10-3962-9b38-953db3fb919c",
                                        "entry_id": "6eaee242-d7e5-32a2-b6d5-d7a88ada5bdb",
                                        "glosses": [
                                            "Cheville. Articulation de la jambe avec le pied."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaedb621-4d60-4eb9-a121-98e99a498ea4",
                                                "sense_id": "0c433b61-7a10-3962-9b38-953db3fb919c",
                                                "text": "Je savais le moyen de les tiédir et d’y mettre du rose ou du vermillon, à ces pieds pâles et froids ; mais cette nuit-là mon moyen manqua… Ma bouche fut impuissante à attirer sur ce cou-de-pied cambré et charmant la plaque de sang que j’aimais souvent à y mettre, comme une rosette ponceau…"
                                            },
                                            {
                                                "example_id": "b1dfc45d-dbb9-4cbb-bf6a-053002c418c1",
                                                "sense_id": "0c433b61-7a10-3962-9b38-953db3fb919c",
                                                "text": "Et les petits pieds sont on voyait la cambrure, le dessous du cou-de-pied, dans un bas presque rose, fin, et le soulier découpé à talon très haut."
                                            },
                                            {
                                                "example_id": "1e1ef326-531f-4d89-a639-afc3ae8e1a6c",
                                                "sense_id": "0c433b61-7a10-3962-9b38-953db3fb919c",
                                                "text": "On peut donner à un visage le bon Dieu sans confession, allonger la ligne, aplatir les seins, raboter les hanches, mais l’érotisme du cou-de-pied n’est pas maîtrisable."
                                            },
                                            {
                                                "example_id": "b93d4334-0f81-4420-8ee0-44f7869381c0",
                                                "sense_id": "0c433b61-7a10-3962-9b38-953db3fb919c",
                                                "text": "Le chien l’avait saisie au cou-de-pied, Nelly ; j’entendais son affreux ronflement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc721553-e543-36fb-832a-d7ff57b99be8",
                                        "entry_id": "6eaee242-d7e5-32a2-b6d5-d7a88ada5bdb",
                                        "glosses": [
                                            "Partie antérieure et supérieure du pied près de son articulation avec la jambe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7594c8c4-c158-4762-961c-72fdd12e1782",
                                                "sense_id": "fc721553-e543-36fb-832a-d7ff57b99be8",
                                                "text": "La languette d’une chaussure, ou langue, sert parfois à protéger le cou-de-pied."
                                            },
                                            {
                                                "example_id": "38fe1881-9725-463f-9157-70638d74388e",
                                                "sense_id": "fc721553-e543-36fb-832a-d7ff57b99be8",
                                                "text": "Les forçats se fabriquent des espèces de tampons qu’ils glissent entre leur anneau de fer et leur chair, afin d’amortir la pesanteur de la manicle sur leurs chevilles et leur cou-de-pied."
                                            },
                                            {
                                                "example_id": "f378b525-9475-4f20-a827-28a75193b716",
                                                "sense_id": "fc721553-e543-36fb-832a-d7ff57b99be8",
                                                "text": "Duchotel. — Sapristi ! Il faut que j’envoie une dépêche ! (Il fait mine de se diriger vers le secrétaire, mais à ce moment, Gontran, qui a continué son manège, est en train de lui tirer son pantalon sur le cou-de-pied, de telle sorte que Duchotel, retenu par la jambe, manque de tomber.)"
                                            },
                                            {
                                                "example_id": "b9da1a44-cf59-4420-8b10-98e5ab7fdac6",
                                                "sense_id": "fc721553-e543-36fb-832a-d7ff57b99be8",
                                                "text": "Alors la douleur siège à la fesse, à la face postéroexterne de la cuisse à la face antéroexterne de la jambe, au cou-de-pied, en avant de la malléole externe, sur le dos du pied en direction du gros orteil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ed2368-faf3-3e53-83c3-c334652e98a0",
                                        "entry_id": "6eaee242-d7e5-32a2-b6d5-d7a88ada5bdb",
                                        "glosses": [
                                            "Partie de chaussure entourant cette partie du pied."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808bb594-4de9-4ebb-8733-e29d7496c6cb",
                                                "sense_id": "f7ed2368-faf3-3e53-83c3-c334652e98a0",
                                                "text": "leurs souliers découverts portent sur le cou-de-pied de larges boucles d’argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
