                                            {
                                                "example_id": "00d52939-9edb-441e-859a-db58ed1e403c",
                                                "sense_id": "fa8630ad-d599-3cd3-891d-eaf154eeb331",
                                                "text": "Die Verschütteten, die man nach sechs Tagen barg, waren stark dehydriert."
                                            },
                                            {
                                                "example_id": "57230d8b-4967-4e9a-b8fe-4ff6f9902d65",
                                                "sense_id": "fa8630ad-d599-3cd3-891d-eaf154eeb331",
                                                "text": "Der Körper dehydriert nach dem Genuss von reichlich Bier."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04f7c21e-a16b-3db7-9dd9-2b18d599e6d7",
                                        "entry_id": "6329dc3c-62b6-340c-9103-682697d4eb29",
                                        "glosses": [
                                            "Feuchtigkeit entziehen, Wasser entziehen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e51e4a9-fd72-4fbc-b48f-1ac7f3669362",
                                                "sense_id": "04f7c21e-a16b-3db7-9dd9-2b18d599e6d7",
                                                "text": "Hörgeräte soll man zumindest nachts mit Silicagel oder anderen hygroskopischen Stoffen dehydrieren."
                                            },
                                            {
                                                "example_id": "3c5d5aea-ebe2-4caf-bd45-61511081c77b",
                                                "sense_id": "04f7c21e-a16b-3db7-9dd9-2b18d599e6d7",
                                                "text": "Wenn man Gips dehydriert, ihm also das Kristallwasser entzieht, entsteht Anhydrit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0b5b87f1-e07d-3e78-8679-6dd6f89169c7",
                                        "entry_id": "6329dc3c-62b6-340c-9103-682697d4eb29",
                                        "glosses": [
                                            "Wasserstoff aus einer Verbindung abspalten"
                                        ],
