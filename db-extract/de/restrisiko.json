                "senses": [
                    {
                        "sense_id": "ba019923-8002-3163-9ea2-93b7c5948a6d",
                        "entry_id": "bb115506-7246-3300-827b-e4136626e2f2",
                        "glosses": [
                            "Risiko, das nicht ausgeschlossen werden kann, auch wenn alle bekannten Maßnahmen ergriffen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed1b18e-f4b8-4477-b5d6-57e3cc14bd24",
                                "sense_id": "ba019923-8002-3163-9ea2-93b7c5948a6d",
                                "text": "Bei der Nutzung der Atomenergie besteht immer ein Restrisiko einer verheerenden Katastrophe."
                            },
                            {
                                "example_id": "c956b10c-3d28-4b41-a0a2-f7c176108496",
                                "sense_id": "ba019923-8002-3163-9ea2-93b7c5948a6d",
                                "text": "Bei gespendetem Blut gibt es trotz aller Kontrollen ein Restrisiko der Belastung mit Viren."
                            },
                            {
                                "example_id": "93b72cd0-6ccb-40c9-80a8-86cc218f20b0",
                                "sense_id": "ba019923-8002-3163-9ea2-93b7c5948a6d",
                                "text": "Bei den großen Impfkampagnen setzt die Weltgesundheitsorganisation auf die Schluckimpfung. Sie ist einfach zu verabreichen und wirksam, und in der Regel ist der Impfstoff sehr sicher, wenn auch ein kleines Restrisiko besteht: Auf eine Million Impfungen kann Kinderlähmung in einem Fall durch den Impfstoff selbst ausgelöst werden."
                            },
                            {
                                "example_id": "1967d86d-9179-45a3-8e0d-2df7f3351e62",
                                "sense_id": "ba019923-8002-3163-9ea2-93b7c5948a6d",
                                "text": "„Energiesparen statt Restrisiko - das könnte eine Maxime der Töpfer-Kommission werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
