                "translations": [
                    {
                        "translation_id": "a69f48f7-e046-4ee7-8bc5-975b1185f6f7",
                        "source_entry_id": "2f14d16f-612d-36aa-9e88-9b6718718825",
                        "source_sense_id": "86a3c1ff-815e-31c9-a981-2c79abc9f5bd",
                        "target_lang_word": "Doktorand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktorand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                        "entry_id": "33797395-2a21-3685-aec6-7a7a051f0e31",
                                        "glosses": [
                                            "Student, der die Doktorwürde anstrebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30289bfe-20f3-4558-96d2-9c32977f0e9b",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "Der Doktorand steht kurz vor der Doktorprüfung."
                                            },
                                            {
                                                "example_id": "ce8cf4fe-61e8-478c-967d-d308544902e6",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "„Wie oft das geschah und wie viele Doktoranden und Doktorandinnen er zum Dr. begleitet hat, mag dahinstehen.“"
                                            },
                                            {
                                                "example_id": "98cfa191-f677-4c23-8a6a-71966f8b01d4",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "„Ein Schweizer Doktorand twittert kritisch über China. Danach will seine Professorin an der Universität St. Gallen nichts mehr mit ihm zu tun haben – sie fürchtet, kein Visum mehr zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e5982778-4973-4b64-a1ef-e791831f74b1",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "„Selbst die Doktoranden sahen unglaublich jung aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "272fde83-c9a4-437e-bde1-083eb5b6a30d",
                        "source_entry_id": "2f14d16f-612d-36aa-9e88-9b6718718825",
                        "source_sense_id": "86a3c1ff-815e-31c9-a981-2c79abc9f5bd",
                        "target_lang_word": "Doktorandin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktorandin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                        "entry_id": "3a357f0a-79e4-3a41-9839-22dbff5df086",
                                        "glosses": [
                                            "Studentin, die die Doktorwürde anstrebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183b0553-d280-41c5-afd3-59d98a5b30df",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "Die Doktorandin steht kurz vor der Doktorprüfung."
                                            },
                                            {
                                                "example_id": "4670bf64-cfd5-447a-81b7-85a6aaedb08a",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "„Die zuständige Fakultät der Universität Düsseldorf hat das Verfahren zur Aberkennung des Doktortitels einer früheren Doktorandin eingeleitet.“"
                                            },
                                            {
                                                "example_id": "28ecaaf8-9c81-4e50-b902-4f09216d3ff9",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "„Die Anspannung, beinah ein Misstrauen gegenüber der Doktorandin, stand spürbar im Raum, erst bei der Schilderung meiner Herkunft schienen sich die Mienen der Anwesenden zu lockern.“"
                                            },
                                            {
                                                "example_id": "a4a72a54-ea2b-4252-82e7-12b39c34ea1f",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "„Einer festen Freundin am nächsten kam in jenem Jahr eine sprunghafte Doktorandin namens Pat McEnerney, die kurz zuvor das Ballett aufgegeben und beschlossen hatte, Lehrerin zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
