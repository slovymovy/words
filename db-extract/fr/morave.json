                        "sense_id": "75985d03-52a2-3413-8c03-a7e1c18733e4",
                        "entry_id": "e5be2704-ba92-35bb-9659-c1f2bf664263",
                        "glosses": [
                            "Habitant de la Moravie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "819f0eec-91b1-42eb-8a05-59cfa5d9a8d0",
                                "sense_id": "75985d03-52a2-3413-8c03-a7e1c18733e4",
                                "text": "Les habitants de la Moravie se définissent comme Moraves et non comme Tchèques. La loi reconnaît la citoyenneté (par définition tchèque) et la nationalité tchèque, mais pas morave qui est considérée comme une composante de la nation tchèque par le législateur en particulier et les ethnolinguistes en général."
                            }
                        ]
                    }
