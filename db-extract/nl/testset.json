                "senses": [
                    {
                        "sense_id": "b24cad4e-3a10-3cea-99a3-13aca830995f",
                        "entry_id": "dbd87ec7-8b4f-3ea2-b041-710ae8028fdf",
                        "glosses": [
                            "groep zaken waarmee men iets kan uitproberen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a95882-df3e-41d5-b853-aac7e918c4e2",
                                "sense_id": "b24cad4e-3a10-3cea-99a3-13aca830995f",
                                "text": "Immers, de keten zorgt ervoor dat misbruik is uitgesloten, geen eigen winstbejag, wordt nagestreefd, bescherming wordt geboden, maar toch niet gebruikt kan worden om door middel van slimme testsets het algoritme toch proberen te kraken."
                            },
                            {
                                "example_id": "40a65324-c25c-4e16-95f5-aa5de80e63ff",
                                "sense_id": "b24cad4e-3a10-3cea-99a3-13aca830995f",
                                "text": "Helaas zijn er ook wat nadelen. Freelux is nog behept met wat kinderziekten. Zo deed de lichtsensor van de testset het niet. Het vervangingsexemplaar werkte prima, maar daarvan was de batterij binnen enkele dagen uitgeput. Dat is vervelend, temeer omdat de 12 volt A23 batterij een kleine 5 euro kost."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a5f52c0-8f9e-345d-9a96-5edeeaa26d52",
                        "entry_id": "dbd87ec7-8b4f-3ea2-b041-710ae8028fdf",
                        "glosses": [
                            "groep zaken die men nodig heeft om iets te onderzoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7afe3f-408c-425f-8c05-ef17b6f89df9",
                                "sense_id": "2a5f52c0-8f9e-345d-9a96-5edeeaa26d52",
                                "text": "Nederlandse vakantiegangers zullen voorlopig nog geen boete krijgen als ze zonder de verplichte alcoholtesten in hun auto door Frankrijk rijden. Als gevolg van de matige verkrijgbaarheid van de testsetjes is de handhaving van de wet tot 1 maart 2013 uitgesteld."
                            }
                        ]
                    }
