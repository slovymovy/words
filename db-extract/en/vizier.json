                        "cross_references": [
                            {
                                "target_word": "vizier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c2292b3d-ac87-3fdb-9b50-de633acfd39e",
                                        "entry_id": "283f6a62-6d4b-3f11-91e8-2e569a09fb9d",
                                        "glosses": [
                                            "richttoestel op de loop van een vuurwapen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "444419ac-6ae0-4f1c-a790-7c336acadcc3",
                                                "sense_id": "c2292b3d-ac87-3fdb-9b50-de633acfd39e",
                                                "text": "Wat wel gheoeffent schutter mach nu dese engheyt misprijsen? Of wie soude den Leering een ruymer Visier of kijckgat op sijne Busse willen maken tot voorderinge van sijn wel schieten?"
                                            },
                                            {
                                                "example_id": "2f6415eb-9b9e-414b-aae9-a59c64c06cfd",
                                                "sense_id": "c2292b3d-ac87-3fdb-9b50-de633acfd39e",
                                                "text": "Hij had 'm in het vizier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72a0d480-e6c8-34cb-a535-feb7bf4c01e4",
                                        "entry_id": "283f6a62-6d4b-3f11-91e8-2e569a09fb9d",
                                        "glosses": [
                                            "klep aan een hoofddeksel of opening in een helm waar men doorheen kan kijken"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b7b1c1-7824-48e7-9b77-3be7c592e6cf",
                                                "sense_id": "72a0d480-e6c8-34cb-a535-feb7bf4c01e4",
                                                "text": "Nichanor sette hem ter weren\nEnde stakene doe vele sciere\nMettien spere dor die visiere\nDor den nese in bede doghen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71fda17f-0cf3-339b-856a-8fe3fe21d08b",
                                        "entry_id": "283f6a62-6d4b-3f11-91e8-2e569a09fb9d",
                                        "glosses": [
                                            "in het vizier hebben: je richten op een haalbaar doel, (van personen) als doelwit (van een aanval, acquisitie, kritiek, wantrouwen, e.d.) nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cbcd76-7c90-4846-9e42-58618fdba875",
                                                "sense_id": "71fda17f-0cf3-339b-856a-8fe3fe21d08b",
                                                "text": ",,We zitten in een heel goede fase”, aldus Hulshoff. ,,Zeker als je ziet waar we vandaan komen. Natuurlijk hebben we, toen het sportief minder goed ging, ook gedacht: verdikke, zou het erin zitten? Maar we hebben voor Jupiler League-begrippen gewoon een hartstikke goede ploeg.” Cambuur staat momenteel elfde in de Jupiler League, maar heeft inmiddels de subtop in het vizier."
                                            },
                                            {
                                                "example_id": "c2319477-cac4-4ea8-8043-694820cb7032",
                                                "sense_id": "71fda17f-0cf3-339b-856a-8fe3fe21d08b",
                                                "text": "Wat wel gheoeffent schutter mach nu dese engheyt misprijsen? Of wie soude den Leering een ruymer Visier of kijckgat op sijne Busse willen maken tot voorderinge van sijn wel schieten?"
                                            },
                                            {
                                                "example_id": "f3dc2028-2322-43ae-9550-e71d650c59e2",
                                                "sense_id": "71fda17f-0cf3-339b-856a-8fe3fe21d08b",
                                                "text": "Clinton Mata heeft intussen aangegeven dat hij Club Brugge graag wil verlaten. De verdediger hoopt op een stap hogerop en verschillende Bundesliga-clubs hebben hem in het vizier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vizier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f399694-3b45-39df-ae72-45480c610dd3",
                                        "entry_id": "b77c1bf9-478d-369f-8ff4-3e73cb49f6f4",
                                        "glosses": [
                                            "minister of hoog staatsdienaar, rechterhand onder een Oosters heerser zoals een sultan (meestal voorafgegaan door primo, groot, eerst)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c36a49-0075-4350-83b1-0b5097ebf39c",
                                                "sense_id": "8f399694-3b45-39df-ae72-45480c610dd3",
                                                "text": "overmits sy desen teghenwoordighen soldaen hebben willen of setten, daer teghens sich alleene ghestelt heeft den Ianitzer Aga, waer over men een ander Primo Vizier geordonneert, ende des Soldaens Regieringhe op 6. Iaren gheconfirmeert heeft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d1b794-07bc-41f7-8758-5939fdf56d5f",
                        "source_entry_id": "7b790ef8-843b-3b71-b23d-a454bae9569f",
                        "source_sense_description": "high-ranking official",
                        "target_lang_word": "vizir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vizir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "559744dc-f18f-38eb-b53f-77c743bf11aa",
                                        "entry_id": "03afc1d9-77dc-3e9f-890d-3a663cad9523",
                                        "glosses": [
                                            "Ministre d’un prince musulman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c0377d-d1b2-4064-b17c-1988fd76d796",
                                                "sense_id": "559744dc-f18f-38eb-b53f-77c743bf11aa",
                                                "text": "On appelle vizirs du banc en Turquie, les vizirs qui ont séance avec le grand-vizir dans le divan, lorsqu’on examine les procès. Ils n’ont que voix consultative, & seulement lorsqu’ils sont mandés. Quelquefois néanmoins lorsqu’il s’agit de délibérations importantes, ils sont admis dans le conseil du cabinet avec le grand-vizir, le mufti & les cadileskers. Ce sont eux qui écrivent ordinairement le nom du grand-seigneur au haut de ses ordonnances, & le sultan pour les autoriser, fait apposer son sceau au-dessous de son nom."
                                            },
                                            {
                                                "example_id": "28cfa6e6-148b-4440-81b9-220cfaebca8d",
                                                "sense_id": "559744dc-f18f-38eb-b53f-77c743bf11aa",
                                                "text": "Les vizirs, les pachas, les généraux, tous les fonctionnaires, toutes les autorités, en grand costume tous, et chamarrés de dorures, étaient parqués sur la grande place de Top-Kapou."
                                            },
                                            {
                                                "example_id": "0c81ed15-ca3c-4e3a-b56d-6b9ab3a3be1a",
                                                "sense_id": "559744dc-f18f-38eb-b53f-77c743bf11aa",
                                                "text": "Les caïds et les chefs religieux qui se rendent dans une Benika du Makhzen doivent y trouver le Vizir entouré de ses secrétaires, travaillant assis en cercle sur des tapis selon l’ancienne coutume."
                                            },
                                            {
                                                "example_id": "18811ebd-dc05-49ba-b66e-ceb2dcfafbea",
                                                "sense_id": "559744dc-f18f-38eb-b53f-77c743bf11aa",
                                                "text": "À l’est de l’afrag s’étendait une sorte d’esplanade, le mechouar, bordé de tentes faisant office de benikas ou bureaux où les vizirs et leurs secrétaires venaient expédier les affaires de leur département."
                                            },
                                            {
                                                "example_id": "6b1517f8-eacd-4e96-9e93-1e8803b9591b",
                                                "sense_id": "559744dc-f18f-38eb-b53f-77c743bf11aa",
                                                "text": "Mais l’état de grâce est bref. En juillet 1912, sous la pression d’un groupe d’officiers antiunionistes stambouliotes en liaison avec des antiunionistes macédoniens, le sultan appelle au pouvoir un nouveau vizir qui forme un gouvernement d’où sont exclus tous les unionistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abb94b0b-4182-49f3-ac4f-e2f428d97c07",
                        "source_entry_id": "7b790ef8-843b-3b71-b23d-a454bae9569f",
                        "source_sense_description": "high-ranking official",
                        "target_lang_word": "Wesir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wesir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c5fedeb-e9a0-3988-b68e-e83fcbc5787a",
                                        "entry_id": "adb449d0-69bd-389a-8cfd-9f24cd11ca5a",
                                        "glosses": [
                                            "hoher Würdenträger in arabischen Ländern, vergleichbar mit einem Minister"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e6c49a-f882-46a9-8231-ae3b4d08c423",
                                                "sense_id": "3c5fedeb-e9a0-3988-b68e-e83fcbc5787a",
                                                "text": "„Ich wurde ausgerüstet, wie es sich für einen vornehmen Krieger geziemte, reiste nach Stambul und schloß mich dem Gefolge des Wesirs an.“"
                                            },
                                            {
                                                "example_id": "fdcb81a7-3be8-496c-a9ae-00701e8683e8",
                                                "sense_id": "3c5fedeb-e9a0-3988-b68e-e83fcbc5787a",
                                                "text": "„Wenn seine Wesire und Generäle ohne sein Wissen, aber in seinem Namen ein Volk abgeschlachtet hätten, dann würde man seinen schwermütigen Blick verstehen.“"
                                            },
                                            {
                                                "example_id": "7692be54-671b-493d-b65a-e3dfe90f4750",
                                                "sense_id": "3c5fedeb-e9a0-3988-b68e-e83fcbc5787a",
                                                "text": "„Spielt das Vöglein demnach darauf an, dass der Wesir sich ständig vor seinen Untergebenen aufplusterte und sie herumkommandierte, damit seine Anordnungen auch ja korrekt ausgeführt wurden?“"
                                            },
                                            {
                                                "example_id": "a15c95b8-45cb-4a50-a0e4-40e8ce89d28c",
                                                "sense_id": "3c5fedeb-e9a0-3988-b68e-e83fcbc5787a",
                                                "text": "„Die zweite Herrschaftsperiode Mahmud Schahs, in der Fateh Khan als Wesir die Regierungsgeschäfte übernahm, dauerte bis 1818.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
