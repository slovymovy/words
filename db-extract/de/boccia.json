                                    {
                                        "sense_id": "d7662037-3416-35a6-9c2e-978c0eb88c2f",
                                        "entry_id": "f41abbd0-0633-3d04-8a83-a5663b64fa88",
                                        "glosses": [
                                            "A game, similar to bowls or pétanque, played on a long, narrow, dirt-covered court, or informally, as a lawn game."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbbab447-5c8d-33e6-99f5-2fca0b2fdd0f",
                                        "entry_id": "f41abbd0-0633-3d04-8a83-a5663b64fa88",
                                        "glosses": [
                                            "One of the eight balls that the player throws in a game of bocce."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2e8254-4016-474c-a2f1-2c3dd899c510",
                                                "sense_id": "dbbab447-5c8d-33e6-99f5-2fca0b2fdd0f",
                                                "text": "The object is throw or roll the bocces as close as possible to the pallino."
                                            },
                                            {
                                                "example_id": "0794fd2e-be25-47e4-a4c0-b5a52e07f425",
                                                "sense_id": "dbbab447-5c8d-33e6-99f5-2fca0b2fdd0f",
                                                "text": "The side with their bocces closest to the pallino earns points."
                                            },
                                            {
                                                "example_id": "e3ec5ebe-33bc-47b1-8acd-b160329c0452",
                                                "sense_id": "dbbab447-5c8d-33e6-99f5-2fca0b2fdd0f",
                                                "text": "When he first started we had to buy a smaller set of bocces because his hands were small."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f584f94-5923-4863-a0d5-c6d7d6ce7342",
                        "source_entry_id": "8c67bfd0-9007-3bf5-bc44-bf08737d539b",
                        "source_sense_id": "29e31c4d-216b-3bce-882c-3b03e6326732",
                        "source_sense_description": "Spiel, bei dem eigene Kugeln an eine kleine Zielkugel geworfen werden müssen",
                        "target_lang_word": "boccia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boccia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ccfec63-0088-35a4-94e1-aa484a73c257",
                                        "entry_id": "c8091a11-da2c-3aaa-a8e5-8abecd2b9f70",
                                        "glosses": [
                                            "Discipline handisport similaire à la pétanque inscrite au programme paralympique depuis 1984 à New-York."
                                        ],
                                        "tags": [
                                            "Handisport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f824b79-a897-463a-8b5e-c3eca8c41cd1",
                                                "sense_id": "0ccfec63-0088-35a4-94e1-aa484a73c257",
                                                "text": "En rejoignant petit à petit ses voisins comme l’Espagne ou le Portugal, la France s’inscrit dans le club des nations ouvrant le sport aux athlètes très lourdement handicapés car mêmes les paralysés des quatre membres, grâce à un système de rampe pour lancer les boules et des assistants, placés dos au jeu, pour régler sous les ordres des joueurs, l’inclinaison et l’orientation des rampes, peuvent disputer des parties de boccia…"
                                            },
                                            {
                                                "example_id": "3950093f-2d4c-4daa-9ee8-98c9810f0fdc",
                                                "sense_id": "0ccfec63-0088-35a4-94e1-aa484a73c257",
                                                "text": "Le Cojop n’a pas lésiné : 24 parasports en démonstration, comme le basket fauteuil, la boccia (sorte de parapétanque), le para-tir à l’arc, ou encore le tennis fauteuil."
                                            },
                                            {
                                                "example_id": "81799621-1926-4af5-acab-496b2f9f9bb0",
                                                "sense_id": "0ccfec63-0088-35a4-94e1-aa484a73c257",
                                                "text": "Ce été, Sonia Heckel a remporté le titre de championne d’Europe de boccia, un sport de boule apparenté à la pétanque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
