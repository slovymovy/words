            {
                "entry_id": "15b98d50-9856-3381-9120-8442667aba13",
                "word": "Apocoloquintose",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "665a9253-6940-364d-be4b-d3dadc17a8ee",
                        "entry_id": "15b98d50-9856-3381-9120-8442667aba13",
                        "glosses": [
                            "Pamphlet de Sénèque sur l’apothéose de l’empereur Claude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f14157dd-ab5e-4b4a-9f59-036657799dd3",
                                "sense_id": "665a9253-6940-364d-be4b-d3dadc17a8ee",
                                "text": "L'Apocoloquintose s’inscrit dans la tradition gréco-latine de la satire ménippée (satura menippea), illustrée par Varron, genre particulier de satire qui mêle les passages en prose et en vers de différentes mesures."
                            },
                            {
                                "example_id": "d35b2a82-dbf1-4c67-95c4-111c51ff96e7",
                                "sense_id": "665a9253-6940-364d-be4b-d3dadc17a8ee",
                                "text": "Depuis deux ans, il donnait un cours hebdomadaire d’une heure et demie sur L’Apoloquintose du divin Claude (c’est-à-dire « métamorphose en citrouille », une pièce satirique de Sénèque."
                            }
                        ]
                    }
                ],
