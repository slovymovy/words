    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aef515d5-ba21-3177-ada0-3a53bafc190a",
                    "sense_definition": "Vor Schreck, Entsetzen oder extremer Kälte regungslos und steif werden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegungslos_werden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor Schreck <w>erstarrte</w> der Wanderer, als er plötzlich eine giftige Schlange vor sich sah."
                        },
                        {
                            "text": "Als die unerwartete Nachricht verkündet wurde, <w>erstarrten</w> alle Anwesenden für einen kurzen Moment."
                        }
                    ],
                    "synonyms": [
                        "versteinern",
                        "einfrieren",
                        "verharren"
                    ],
                    "antonyms": [
                        "sich bewegen"
                    ],
                    "common_phrases": [
                        "vor Schreck erstarren",
                        "zur Salzsäule erstarren",
                        "vor Angst erstarren"
                    ]
                },
                {
                    "sense_id": "54138af0-af37-3f48-a02e-49ac2a795576",
                    "sense_definition": "Von einem flüssigen oder weichen in einen festen und harten Zustand übergehen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fest_werden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Vulkanausbruch floss die heiße Lava ins Meer und <w>erstarrte</w> zu dunklem Gestein."
                        },
                        {
                            "text": "Die flüssige Schokolade muss im Kühlschrank stehen, damit sie vollständig <w>erstarrt</w>."
                        }
                    ],
                    "synonyms": [
                        "fest werden",
                        "aushärten",
                        "gerinnen"
                    ],
                    "antonyms": [
                        "schmelzen",
                        "sich verflüssigen"
                    ],
                    "common_phrases": [
                        "zu Eis erstarren",
                        "zu Stein erstarren"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa05de02-7fb7-372d-a58c-422b0d87b8f8",
                    "sense_definition": "Das Festwerden einer Substanz oder das plötzliche Eintreten körperlicher Regungslosigkeit",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die chemische Masse benötigt bis zum vollständigen <w>Erstarren</w> mindestens zwei Stunden."
                        },
                        {
                            "text": "Das plötzliche <w>Erstarren</w> seiner Muskeln bereitete dem behandelnden Arzt große Sorgen."
                        }
                    ],
                    "synonyms": [
                        "Erstarrung",
                        "Verfestigung",
                        "Aushärtung"
                    ],
                    "antonyms": [
                        "Verflüssigung",
                        "Schmelzen"
                    ],
                    "common_phrases": [
                        "bis zum Erstarren"
                    ]
                }
            ]
        }
    ]
