                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6001208f-3cc0-48b0-9058-293dbd8cc1e3",
                                "sense_id": "9163b867-166f-3c4a-a562-77586a8fbc85",
                                "text": "De jargonloze zin is, schat ik, rond de eeuwwisseling ontstaan. De jargonloze zin dankt zijn bestaan aan de groei van de mediatrainers, die politici afleerden in afkortingen en andere mistigheid te spreken. Politiek draait nu om instant helderheid."
                            }
                        ]
                    }
