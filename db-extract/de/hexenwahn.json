                "senses": [
                    {
                        "sense_id": "da9ec7be-e992-33da-a1d0-4bacc0f8b805",
                        "entry_id": "e715f9ce-16b3-3140-adf8-8c85eec5b93a",
                        "glosses": [
                            "irrationale Furcht vor Personen, die für Hexen gehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570d448a-7508-462d-a3d0-2d86b6a657ef",
                                "sense_id": "da9ec7be-e992-33da-a1d0-4bacc0f8b805",
                                "text": "„Es gibt durchaus mehrere Theorien über den Ursprung des Hexenwahns und der daraus erwachsenen Verfolgung von Frauen, die der Hexerei beschuldigt worden sind.“"
                            },
                            {
                                "example_id": "e93d63f7-9b39-42ad-b82d-16d12479dee5",
                                "sense_id": "da9ec7be-e992-33da-a1d0-4bacc0f8b805",
                                "text": "„Der Hexenwahn macht selbst in unserem aufgeklärten Jahrhundert viel von sich reden.“"
                            },
                            {
                                "example_id": "3915bad6-6a36-4347-8acc-fd964aeb3370",
                                "sense_id": "da9ec7be-e992-33da-a1d0-4bacc0f8b805",
                                "text": "„In der Renaissance, als der Hexenwahn seinem Höhepunkt zutrieb, traten Ärzte auf den Plan, welche die angeblichen Hexen oder auch Besessene zu Geisteskranken erklärten, die nicht dem Inquisitor, sondern dem Arzt zu übergeben seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
