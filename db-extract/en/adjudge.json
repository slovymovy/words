                        "glosses": [
                            "verurteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b75f7c-9e7e-482b-90ca-ff900c56c152",
                                "sense_id": "2d6b5922-a41f-3fa1-8a74-a1876915fdd8",
                                "text": "\"WESTCHESTER WATER COMPANY.; Judge Brown Declines to Adjudge It an Involuntary Bankrupt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "336fa130-1930-4d8b-a582-4982ecb394b0",
                        "source_entry_id": "837bf7ea-0fda-3cf0-9fd6-3dafceeaefc7",
                        "source_sense_id": "2d6b5922-a41f-3fa1-8a74-a1876915fdd8",
                        "source_sense_description": "verurteilen",
                        "target_lang_word": "verurteilen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verurteilen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                        "entry_id": "978ff63d-5976-3218-b219-bde985a8a855",
                                        "glosses": [
                                            "über jemanden ein gerichtliches Urteil fällen, das zu einer Bestrafung führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b241669-12cc-48cd-be2e-c39eaacac544",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "Der Richter verurteilte den Angeklagten zu zwei Jahren Freiheitsstrafe auf Bewährung."
                                            },
                                            {
                                                "example_id": "55cd4575-95d2-42dd-ba9d-0cd5d1518fb0",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "Er wurde zu zwei Jahren Gefängnis verurteilt."
                                            },
                                            {
                                                "example_id": "32aa6cd7-6eed-4310-a6e5-f7f97dd4397b",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "Das Gericht hat den Täter zu einer Geldstrafe verurteilt."
                                            },
                                            {
                                                "example_id": "c4f02c16-3b0c-4ae3-84a8-2b07fa0feb26",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "Al Capone wurde 1931 wegen Steuerhinterziehung verurteilt."
                                            },
                                            {
                                                "example_id": "18cd8b10-b776-44ce-89ed-363685a83bd9",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Beide wurden zu langen Haftstrafen verurteilt.“"
                                            },
                                            {
                                                "example_id": "6645163c-dbd8-4405-825b-363715da893d",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Ein Texaner wurde zu 87 Monaten Gefängnis verurteilt.“"
                                            },
                                            {
                                                "example_id": "025e89ad-db5a-4e35-b432-f062c7f0773b",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Nach seiner letzten Festnahme wurde er in die USA ausgeliefert und dort zu lebenslanger Haft verurteilt.“"
                                            },
                                            {
                                                "example_id": "e465c4af-24b3-4f8c-9258-45647a3eb838",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "[Nelson Mandela:] „Am 12. Juni 1964 wurde der Kämpfer gegen die Apartheid zu lebenslanger Haft verurteilt.“"
                                            },
                                            {
                                                "example_id": "e5316463-9677-44b4-b027-9e09b405e647",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Ein Gericht in der Türkei hat die international hoch angesehene Medizinerin Sebnem Korur Fincanci zu einer Haftstrafe verurteilt,“ […]."
                                            },
                                            {
                                                "example_id": "42e1b178-2444-43c0-82d0-0afd74ab68fe",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Das Münchner Landgericht hat Uli Hoeneß wegen Steuerhinterziehung verurteilt. Der FC-Bayern-Präsident muss dreieinhalb Jahre in Haft.“"
                                            },
                                            {
                                                "example_id": "472ef132-fae9-4818-8820-d63ee974758f",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "[In München war ich 2006 auf der Demo] „und habe mir auf dem Marienplatz einen Faustschlag von einem Polizisten eingefangen – dummerweise für diesen – vor laufender Kamera des Bayerischen Rundfunks. Er wurde viel später wegen Körperverletzung verurteilt.“"
                                            },
                                            {
                                                "example_id": "c22c0649-ea14-4754-8bff-9cdf5c138f52",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Polizisten, die bei einer Verkehrskontrolle in Hamburg von einem LKW-Fahrer einen Obstkorb mit Weintrauben geschenkt bekamen, wurden 2006“ […] „wegen Vorteilsannahme verurteilt.“"
                                            },
                                            {
                                                "example_id": "4131c0e0-ab34-40ce-9922-8edf20549ce4",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Wie viele Meisterwerke er gefälscht hat, ist unklar. Verurteilt wurde er für 14 Fälschungen: Wolfgang Beltracchi, einer der berühmtesten Kunstfälscher seit dem Ende des Zweiten Weltkriegs.“"
                                            },
                                            {
                                                "example_id": "c8346a2f-114c-4a51-8e6b-ad37cbd558a6",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Noch nicht gefasste Mörder begehen jedoch in Staaten mit Todesstrafe öfter weitere Straftaten, um nicht gefasst und verurteilt zu werden.“"
                                            },
                                            {
                                                "example_id": "68b641e9-3db9-4a89-b424-e44f17beca98",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Das Landgericht Detmold hat den 94-jährigen ehemaligen Wachmann im Konzentrationslager Auschwitz zu fünf Jahren Haft verurteilt - wegen Beihilfe zum Mord in 170.000 Fällen.“"
                                            },
                                            {
                                                "example_id": "c0b21b0c-4fad-4d45-b730-3b3e1994fd47",
                                                "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                                                "text": "„Ein Patrizier namens Albinus war des Hochverrats überführt und verurteilt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                        "entry_id": "978ff63d-5976-3218-b219-bde985a8a855",
                                        "glosses": [
                                            "über jemanden oder etwas eine negative Meinung entwickeln, etwas für inakzeptabel halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70b5321-a006-4c9a-9ab4-0982eff7711c",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "Bitte verurteile mich nicht für das, was ich getan habe. Es tut mir leid."
                                            },
                                            {
                                                "example_id": "8a5615e4-152b-4828-9b80-894cce9b5d51",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "Der Bundeskanzler verurteilte die Vorkommnisse und versprach den Opfern schnelle und unbürokratische Hilfe."
                                            },
                                            {
                                                "example_id": "27526d76-c3f4-488f-bbd7-a8152fdd44c6",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "„Sollte man Menschen verurteilen, die ihre Träume ausleben?, fragt die Autorin – und hilft mit vielen praktischen Exkursen zum Thema Höhenbergsteigen.“"
                                            },
                                            {
                                                "example_id": "61302e95-9df7-44e4-942b-821595f8d783",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "[Papst Franziskus:] „Im Juli 2013 erklärte er auf die Frage, wie er mit der „Gay-Lobby“ umgehen wolle: »Wenn einer Gay ist und den Herrn sucht und guten Willen hat – wer bin dann ich, ihn zu verurteilen?«“"
                                            },
                                            {
                                                "example_id": "fd05c1ed-0815-4a5c-aec9-6698734f1166",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "„Der Existentialismus ist eine philosophische Richtung und Lebenshaltung: Der Mensch sei zur radikalen Freiheit verurteilt,“ […]."
                                            },
                                            {
                                                "example_id": "0646d4f0-713a-44de-8667-5d992cceb999",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "[…] „Der Besuch des israelischen Ministers für nationale Sicherheit Itamar Ben-Gvir auf dem Tempelberg in Jerusalem löst Proteste von Palästinensern aus. Mehrerer arabischer Länder verurteilen den Besuch.“"
                                            },
                                            {
                                                "example_id": "362ac8db-904d-42b9-bda0-10d4a959cae0",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "„In der Synode von Elvira um 306 wurden zum ersten Mal in einem Konzil Abtreibungen verurteilt.“"
                                            },
                                            {
                                                "example_id": "76ab9497-ab7e-447d-96c8-62f1ca373930",
                                                "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                                                "text": "[Russischer Angriffskrieg auf die Ukraine im Februar 2022:] „Der russische Angriff wurde im März 2022 von der Generalversammlung der Vereinten Nationen mit großer Mehrheit verurteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
