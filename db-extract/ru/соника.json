                        "glosses": [
                            "устар., карт. первая вскрытая карта (в банке, фараоне и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949ccdfc-77d0-44e7-816b-17ad40dac5f7",
                                "sense_id": "1d0de0d6-6631-365f-8453-88c84581e216",
                                "text": "[Поселенец] Выдёргивал из своей колоды карту, ставил под неё куш и смотрел, на что он поставил, только тогда, когда открывали «соники»."
