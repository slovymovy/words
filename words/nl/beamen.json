{
    "word_family": [
        "beamer",
        "beaming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78369a89-a630-32f8-8fbf-f4dd26a0b274",
                    "sense_definition": "bevestigen dat men het met een bewering of mening eens is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "instemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister kon de geruchten over zijn vertrek gisteren niet <w>beamen</w>.",
                            "target_lang_translations": {
                                "en": "The minister could not <w>confirm</w> the rumors about his departure yesterday."
                            }
                        },
                        {
                            "text": "Ik kan je mening <w>beamen</w> dat dit een lastige situatie is.",
                            "target_lang_translations": {
                                "en": "I can <w>agree with</w> your opinion that this is a difficult situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevestigen"
                    ],
                    "antonyms": [
                        "ontkennen",
                        "tegenspreken"
                    ],
                    "common_phrases": [
                        "volmondig beamen",
                        "je mening beamen"
                    ],
                    "target_lang_definitions": {
                        "en": "to confirm that one agrees with a statement or opinion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confirm",
                                "target_lang_sense_clarification": "to assure the accuracy of a statement"
                            },
                            {
                                "target_lang_word": "affirm",
                                "target_lang_sense_clarification": "to agree or concur with something"
                            },
                            {
                                "target_lang_word": "endorse",
                                "target_lang_sense_clarification": "to support or approve of an opinion"
                            },
                            {
                                "target_lang_word": "assent",
                                "target_lang_sense_clarification": "to agree to a proposal or statement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c1cf9be-979a-3334-9ab3-312fe82d3a35",
                    "sense_definition": "beelden of presentaties projecteren met behulp van een beamer",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "projectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gaan de presentatie direct op de witte muur <w>beamen</w>.",
                            "target_lang_translations": {
                                "en": "We are going to <w>project</w> the presentation directly onto the white wall."
                            }
                        },
                        {
                            "text": "Kun je de foto's naar het scherm <w>beamen</w> voor de hele groep?",
                            "target_lang_translations": {
                                "en": "Can you <w>beam</w> the photos to the screen for the whole group?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "op de muur beamen",
                        "een presentatie beamen"
                    ],
                    "target_lang_definitions": {
                        "en": "to project images or presentations using a projector"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "project",
                                "target_lang_sense_clarification": "to display an image on a surface"
                            },
                            {
                                "target_lang_word": "beam",
                                "target_lang_sense_clarification": "to transmit or project electronically"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88ff7bd3-4c77-3997-807c-f9ffe3b23d81",
                    "sense_definition": "het transporteren van personen of objecten door middel van een energiestraal",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "science-fiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die film kunnen ze mensen van het schip naar de planeet <w>beamen</w>.",
                            "target_lang_translations": {
                                "en": "In that movie, they can <w>beam</w> people from the ship to the planet."
                            }
                        },
                        {
                            "text": "Scotty is een meester in het <w>beamen</w> naar en van de Enterprise.",
                            "target_lang_translations": {
                                "en": "Scotty is a master at <w>beaming</w> to and from the Enterprise."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand ergens heen beamen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "voornamelijk gebruikt in sciencefictioncontext"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to transport people or objects using an energy beam, typically in science fiction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beam",
                                "target_lang_sense_clarification": "to transport via energy beam"
                            },
                            {
                                "target_lang_word": "teleport",
                                "target_lang_sense_clarification": "to move instantly between places"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bcb3fb0-8692-35ae-8b7c-9af3663b2168",
                    "sense_definition": "het uitspreken van 'amen' na een gebed of religieuze uiting",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gelovigen hoorden de priester het gebed plechtig <w>beamen</w>.",
                            "target_lang_translations": {
                                "en": "The believers heard the priest solemnly <w>say amen</w> to the prayer."
                            }
                        },
                        {
                            "text": "Na de zegening begon de hele gemeente het gezang te <w>beamen</w>.",
                            "target_lang_translations": {
                                "en": "After the blessing, the whole congregation began to <w>echo amen</w> to the chant."
                            }
                        }
                    ],
                    "synonyms": [
                        "beamenen"
                    ],
                    "target_lang_definitions": {
                        "en": "to say 'amen' after a prayer or religious expression"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "say amen",
                                "target_lang_sense_clarification": "to conclude a prayer with amen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
