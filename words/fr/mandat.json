    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9cc9b4ac-1213-3078-9e31-5ab95b18cf62",
                    "sense_definition": "Durée pendant laquelle une personne élue ou nommée exerce ses fonctions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a annoncé les priorités de son second <w>mandat</w> lors d'une conférence."
                        },
                        {
                            "text": "Le maire a décidé de ne pas se représenter à la fin de son <w>mandat</w> actuel."
                        }
                    ],
                    "synonyms": [
                        "mandature"
                    ],
                    "common_phrases": [
                        "mandat présidentiel",
                        "renouveler son mandat",
                        "exercer un mandat",
                        "fin de mandat"
                    ]
                },
                {
                    "sense_id": "c2a6cef2-8310-356c-8a81-bfd5692e4546",
                    "sense_definition": "Ordre écrit délivré par un juge ou une autorité judiciaire autorisant une mesure de contrainte ou d'enquête.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont obtenu un <w>mandat</w> pour perquisitionner le domicile du suspect dès l'aube."
                        },
                        {
                            "text": "Le juge a immédiatement signé un <w>mandat</w> contre le fugitif recherché partout."
                        }
                    ],
                    "common_phrases": [
                        "mandat d'arrêt",
                        "mandat de perquisition",
                        "mandat d'amener",
                        "délivrer un mandat"
                    ]
                },
                {
                    "sense_id": "c30bbc89-f8fd-3362-b104-fce8da0abc9a",
                    "sense_definition": "Titre financier ou postal permettant de payer ou de transférer une somme d'argent à une personne.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est allée au bureau de poste pour envoyer un <w>mandat</w> à son cousin."
                        },
                        {
                            "text": "Il faut présenter une pièce d'identité pour pouvoir encaisser ce <w>mandat</w> rapidement."
                        }
                    ],
                    "common_phrases": [
                        "mandat postal",
                        "mandat cash",
                        "envoyer un mandat"
                    ]
                },
                {
                    "sense_id": "f9e538d0-d34f-3988-b1b8-dd0277d80a2a",
                    "sense_definition": "Mission et pouvoir de représentation confiés par le corps électoral à un élu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La députée rappelle régulièrement les engagements pris dans le cadre de son <w>mandat</w> parlementaire."
                        },
                        {
                            "text": "Les citoyens attendent que les représentants respectent fidèlement le <w>mandat</w> qui leur est confié."
                        }
                    ],
                    "synonyms": [
                        "mission"
                    ],
                    "common_phrases": [
                        "mandat électoral",
                        "mandat représentatif",
                        "mandat impératif"
                    ]
                },
                {
                    "sense_id": "8c2a2252-4ead-3666-8f79-de2b3411c99e",
                    "sense_definition": "Contrat par lequel une personne donne à une autre le pouvoir d'agir en son nom et pour son compte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a signé un <w>mandat</w> exclusif avec une agence immobilière pour vendre son appartement."
                        },
                        {
                            "text": "L'avocat agit en vertu d'un <w>mandat</w> formel établi par son client hier matin."
                        }
                    ],
                    "synonyms": [
                        "procuration"
                    ],
                    "common_phrases": [
                        "mandat de vente",
                        "mandat exclusif",
                        "donner mandat"
                    ]
                },
                {
                    "sense_id": "d0801b86-89c5-3fe9-bfc6-d099087f73f9",
                    "sense_definition": "Régime d'administration confié à une puissance sur un territoire sous l'autorité de la Société des Nations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le Proche-Orient a été profondément marqué par l'époque du <w>mandat</w> français au Levant."
                        },
                        {
                            "text": "Certaines anciennes colonies allemandes sont passées sous un <w>mandat</w> international après le traité."
