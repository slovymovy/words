                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a658b0-8a14-40d8-b0c5-e491f566078e",
                                                "sense_id": "1bf9951e-d789-3f89-a0b8-d06e9723de9b",
                                                "text": "Overigens is het ook niet zo dat het virus zich helemaal stilhoudt in de zestig jaar die zit tussen waterpokken en gordelroos, vertelt Verjans. „Mensen scheiden het virus soms asymptomatisch uit, via de mond."
                                            },
                                            {
                                                "example_id": "19da3443-1f69-43bb-bccf-8c3a2ebada5a",
                                                "sense_id": "1bf9951e-d789-3f89-a0b8-d06e9723de9b",
                                                "text": "Asymptomatisch mag men alleen de gevallen noemen, waarbij nooit clinische symptomen voorkomen, die verraden, dat het dier geïnfecteerd is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9109eb7-11ed-4caf-bf3e-0b05fe701489",
                        "source_entry_id": "a46cc2d1-b823-3e64-b30e-52dbb75260b9",
                        "source_sense_description": "person or animal that exhibits no symptoms of disease; people or animals that exhibit no symptoms of disease regarded collectively",
                        "target_lang_word": "asymptomatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
