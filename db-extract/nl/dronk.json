                                        "examples": []
                                    },
                                    {
                                        "sense_id": "043f8933-9347-353b-89e7-50fa86908889",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "A transient, informational unclickable pop-up overlay, less interactive than a snackbar."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d251cd89-e26b-4b21-9efe-b0a01b66b57d",
                                                "sense_id": "043f8933-9347-353b-89e7-50fa86908889",
                                                "text": "With the new Windows Push Notification Service, you can remotely send notifications from a cloud-based web service. In Windows 8, the majority of the Toast messages are standard duration toasts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48cd6fc5-168a-360c-8941-dbae69ba6721",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "A piece of toast."
                                        ],
