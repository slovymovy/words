                                        "sense_id": "fa2b6fc5-ba02-3dac-bca4-9a59ea7ad9b9",
                                        "entry_id": "73e161a0-cd2c-3c36-9e64-794d3062e3b2",
                                        "glosses": [
                                            "To make unavailable, as by removing the last remaining pointer or reference to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
