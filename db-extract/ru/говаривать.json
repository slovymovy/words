                "senses": [
                    {
                        "sense_id": "82807966-6f28-32a8-a2dd-79fc648abeb0",
                        "entry_id": "5474cae8-dad8-3d93-bb05-c70483035e41",
                        "glosses": [
                            "to say (repeatedly or frequently); iterative of говори́ть (govorítʹ)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a0cbf2-c6a5-41c6-aedc-87a2e2ef31c5",
                                "sense_id": "82807966-6f28-32a8-a2dd-79fc648abeb0",
                                "text": "он ча́сто гова́ривал",
                                "translation": "he often used to say; he would often say",
                                "english": "he often used to say; he would often say"
                            },
                            {
                                "example_id": "7ff113af-a8da-4ca4-895f-19327a188766",
                                "sense_id": "82807966-6f28-32a8-a2dd-79fc648abeb0",
                                "text": "Дортуа́ры, и́ли спа́льные ко́мнаты дете́й, находи́лись в ни́жнем этаже́, по пра́вую сто́рону сене́й, а по ле́вую жи́ли две стару́шки, голла́ндки, из кото́рых ка́ждой бы́ло бо́лее ста лет и кото́рые со́бственными глаза́ми вида́ли Петра́ Вели́кого и да́же с ним гова́ривали…",
                                "translation": "Antony Pogorelsky",
                                "english": "Antony Pogorelsky"
                            }
                        ]
                    }
