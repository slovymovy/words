                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce163776-8363-353b-9592-9b3555fe7349",
                        "entry_id": "b8a6c628-aabf-39c7-868a-e3142f267778",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de relâcher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c91582f3-72b9-4e4e-8df2-b4d378df09e7",
                                "sense_id": "ce163776-8363-353b-9592-9b3555fe7349",
                                "text": "Elle se désexalte quand elle relâche sa « tenue à distance » et réintègre ces pulsions dans le moi."
                            },
                            {
                                "example_id": "fecf656a-2879-46d5-893d-82bbaa650db4",
                                "sense_id": "ce163776-8363-353b-9592-9b3555fe7349",
                                "text": "Alors, vous me suivez… le coupable, le vrai, se croit sauvé, il se relâche, il fait une gaffe… mais moi, je surveille sans en avoir l’air. Et, tzoum… je le pince…"
                            }
                        ]
                    },
