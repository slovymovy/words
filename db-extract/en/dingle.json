                    {
                        "sense_id": "7fd3e3b3-14cd-3887-b687-25c4c5974ecc",
                        "entry_id": "19d6636c-165c-3dc2-bdbe-2296d843ae3f",
                        "glosses": [
                            "A small, narrow or enclosed, usually wooded valley."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b9d09d-f45e-4b9e-a235-adb1571943a4",
                                "sense_id": "7fd3e3b3-14cd-3887-b687-25c4c5974ecc",
                                "text": "Turning to the left and skirting this huge hedge Treebeard came in a few strides to a narrow entrance. Through it a worn path passed and dived suddenly down a long steep slope. The hobbits saw that they were descending into a great dingle, almost as round as a bowl, very wide and deep, crowned at the rim with the high dark evergreen hedge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "badd8c13-841d-43a1-9338-e5925441722f",
                        "source_entry_id": "19d6636c-165c-3dc2-bdbe-2296d843ae3f",
                        "source_sense_id": "7fd3e3b3-14cd-3887-b687-25c4c5974ecc",
