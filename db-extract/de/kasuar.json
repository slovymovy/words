                    {
                        "sense_id": "c5143897-a203-3de8-8018-51a521e1341e",
                        "entry_id": "11bbb3a4-dda8-398b-a203-2816e0172634",
                        "glosses": [
                            "großer Straußenvogel mit hornigem Helm (deswegen auch Helmkasuar) auf dem nackten Kopf, der in den Wäldern Australiens und Neuguineas lebt und eine gewisse Ähnlichkeit zum Emu aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dc6c5a-3643-41e7-9ca4-f5fd8f3fb6e0",
                                "sense_id": "c5143897-a203-3de8-8018-51a521e1341e",
                                "text": "Ein Kasuar sieht dem viel bekannteren Emu ähnlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
