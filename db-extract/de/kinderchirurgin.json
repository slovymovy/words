                "senses": [
                    {
                        "sense_id": "18ce0174-674c-36b8-9e77-2ea5d21e0550",
                        "entry_id": "7da26e72-3d1d-34e9-a291-ca6650387a72",
                        "glosses": [
                            "Ärztin, die speziell für Operationen bei Kindern ausgebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebd971d4-560c-4fcb-98c1-67b509bd4d66",
                                "sense_id": "18ce0174-674c-36b8-9e77-2ea5d21e0550",
                                "text": "„Ihr Zustand habe sich \"gebessert\", sagte die Kinderchirurgin Shahnoor Islam, die das OP-Team bei der ersten Operation dieser Art in Bangladesch geleitet hatte.“"
                            },
                            {
                                "example_id": "3b8567ee-ab43-4528-b117-ddb2ebe292b7",
                                "sense_id": "18ce0174-674c-36b8-9e77-2ea5d21e0550",
                                "text": "„Vielmehr ist sie es als Kinderchirurgin gewohnt, mit einem 80-Prozent-Pensum mehr als 50 Stunden in der Woche zu arbeiten und nebenbei drei Kinder in einem etwas schwierigen Alter zu betreuen.“"
                            }
                        ],
