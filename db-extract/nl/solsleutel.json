        "nl-extract.jsonl": [
            {
                "entry_id": "93439ffe-ede1-3894-aabb-32de14adb7d9",
                "word": "solsleutel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2d4d9f88-bd54-4a22-bccf-d9171001c1d5",
