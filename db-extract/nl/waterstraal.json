                        "glosses": [
                            "Een dunne stroom water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4b1f77-62e9-47be-88f8-ae124ad75aa2",
                                "sense_id": "d30784b1-0d0f-3488-8d26-d43849cd866b",
                                "text": "Uit de brandspuit komt een flinke waterstraal."
                            }
                        ]
