                        "examples": [
                            {
                                "example_id": "0710d13e-6dfd-40a6-b9c5-c386a645a48a",
                                "sense_id": "8e4bc607-0ec0-3737-b43b-ff0c5642d7a1",
                                "text": "„Wenn bei einer Jugendweiherede auch gelacht wird, so wie am Sonnabend, ist es eine gute Rede für die jungen Menschen.“"
                            },
                            {
                                "example_id": "d7e0a612-01df-4952-8c28-7f54b577cad9",
                                "sense_id": "8e4bc607-0ec0-3737-b43b-ff0c5642d7a1",
                                "text": "„Einmal hatte ihm ein Betriebsdirektor vorgestöhnt, daß er in den nächsten Tagen zu nichts komme, denn er hätte eine Jugendweiherede zu verfassen […].“"
                            }
                        ],
