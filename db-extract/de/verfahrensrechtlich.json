                            {
                                "example_id": "da27adc0-72a5-424e-b88c-1a387171dda0",
                                "sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                                "text": "„Warum das Verfahren so lange dauerte, beantwortet das Landesverwaltungsgericht: Mehrere ‚verfahrensrechtliche Probleme‘ seien zusammengekommen.“"
                            },
                            {
                                "example_id": "99a1c344-b55e-4d17-87e1-470d3b41925d",
                                "sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                                "text": "„Als Grund hierfür nannte der BGH unter anderem, die vierte Strafkammer habe den verfahrensrechtlichen Grundsatz der Kognitionspflicht außer Acht gelassen.“"
                            },
                            {
                                "example_id": "cc16e947-dcc2-45dc-8404-ee8020d0bfe3",
                                "sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                                "text": "„Dies ist nur noch dann möglich, wenn die davon betroffene Steuerfestsetzung auch verfahrensrechtlich noch geändert werden kann.“"
                            },
                            {
                                "example_id": "30562d86-24e5-4ccb-9265-133a53b8dc66",
                                "sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                                "text": "„Das von Bundesregierung, Bundestag und Bundesrat 2001 angestrengte Verbotsverfahren vor dem Bundesverfassungsgericht scheiterte im Jahr 2003 aufgrund verfahrensrechtlicher Fehler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f48cb31-be31-4405-8827-8c239556f99e",
                        "source_entry_id": "3018d91d-26cd-3ba4-995d-37d3e3fc0f4e",
                        "source_sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                        "source_sense_description": "das Verfahrensrecht betreffend",
                        "target_lang_word": "程序法的",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bafb72c9-662c-4aa9-9021-5142e5bf3b29",
                        "source_entry_id": "3018d91d-26cd-3ba4-995d-37d3e3fc0f4e",
                        "source_sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                        "source_sense_description": "das Verfahrensrecht betreffend",
                        "target_lang_word": "procedural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procedural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29be0925-1e7e-3fcd-ae69-7fb58db8e6af",
                                        "entry_id": "32a8116a-8abc-33e4-bd8e-57f7ddf4956b",
                                        "glosses": [
                                            "Related to procedure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d0c0e42-b235-498b-a4b8-5c2a3219340d",
                                                "sense_id": "29be0925-1e7e-3fcd-ae69-7fb58db8e6af",
                                                "text": "The judge dismissed the case on procedural grounds: it wasn't the facts or the law, but just that they hadn't filed the correct forms."
                                            },
                                            {
                                                "example_id": "8a155df0-6d90-484e-a8bd-9390897659e6",
                                                "sense_id": "29be0925-1e7e-3fcd-ae69-7fb58db8e6af",
                                                "text": "An externment of a person is a harsh punishment on him and calls for procedural safeguards against the abuse of power by the authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ba0203c-e6fd-39cd-b19c-efb015bcb193",
                                        "entry_id": "32a8116a-8abc-33e4-bd8e-57f7ddf4956b",
                                        "glosses": [
                                            "Generated by means of a procedure, rather than being designed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5356b64-ad19-409a-8b2e-ec95eea3151f",
                                                "sense_id": "1ba0203c-e6fd-39cd-b19c-efb015bcb193",
                                                "text": "a procedural texture"
                                            },
                                            {
                                                "example_id": "ed9a5716-f686-4468-9117-dd4bb7ae44fd",
                                                "sense_id": "1ba0203c-e6fd-39cd-b19c-efb015bcb193",
                                                "text": "procedural terrain"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "procedural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9df82bf9-e1de-39d2-ada1-ee7cc6ec90aa",
                                        "entry_id": "900ce59f-d769-36d8-a90b-f78b213ee577",
                                        "glosses": [
                                            "A type of literature, film, or television program involving a sequence of technical detail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdaa0653-47a8-4cd9-b127-ec3539fd7b4e",
                                                "sense_id": "9df82bf9-e1de-39d2-ada1-ee7cc6ec90aa",
                                                "text": "It is only fitting that the investigation of place-based police procedurals begins in America, where the police procedural was invented and turned into a literary art form."
                                            },
                                            {
                                                "example_id": "9b5cbe84-f4ed-41a7-b9fc-836c3773b688",
                                                "sense_id": "9df82bf9-e1de-39d2-ada1-ee7cc6ec90aa",
                                                "text": "David Fincher’s horribly addictive samurai procedural, adapted by Andrew Kevin Walker from the graphic novel by Alexis Nolent, stars Michael Fassbender as the un-named titular hitman[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e9fa81-8bd9-3686-a309-9a44f40ae373",
                                        "entry_id": "900ce59f-d769-36d8-a90b-f78b213ee577",
                                        "glosses": [
                                            "Ellipsis of police procedural."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5876c9b4-681e-4dbc-81de-322946c89712",
                                                "sense_id": "c5e9fa81-8bd9-3686-a309-9a44f40ae373",
                                                "text": "The Wire, however, did not kill the procedural. The procedural simply borrowed The Wire’s aesthetic. The detectives may trudge sombrely from one improbable homicide scene to another, week in, week out, as the blue lights circle bleakly, but we, the viewers, sink gleefully into our sofas ready to drink it in like cocoa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4e5a7a7-46a2-452f-b569-47a8e99f8de1",
                        "source_entry_id": "3018d91d-26cd-3ba4-995d-37d3e3fc0f4e",
                        "source_sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                        "source_sense_description": "das Verfahrensrecht betreffend",
                        "target_lang_word": "procédural",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procédural",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b6027da-6781-3aa8-ac5f-3429d93d1ef5",
                                        "entry_id": "311cb604-e3d8-3add-8559-837dcfcdbe52",
                                        "glosses": [
                                            "Qui relève d’une procédure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d1253d-277f-4fbe-bc35-8ff42c50ec8d",
                                                "sense_id": "7b6027da-6781-3aa8-ac5f-3429d93d1ef5",
                                                "text": "Bien qu’extrêmement dépendantes des décisions des administrations centrales pour l’attribution de subventions, certaines collectivités locales, des villes moyennes soucieuses de se dégager des logiques procédurales étatiques, s’engagent dans des démarches de programmation urbaine singulières avec l’aide d’agences d’urbanisme que certaines créent ou de structures parapubliques ou privées qui se mettent à développer aussi bien des activités d’études que de recherche."
                                            },
                                            {
                                                "example_id": "513e58e8-beff-41d6-af34-80ce9c8316f6",
                                                "sense_id": "7b6027da-6781-3aa8-ac5f-3429d93d1ef5",
                                                "text": "Le fond l’emporte sur la forme. Mais on perd en prévisibilité juridique : c’est une chose de poser une condition procédurale claire que les États doivent respecter – quitte à vérifier effectivement si elle fonctionne comme dans l’affaire Zakharov ; c’en est une autre de supprimer cette exigence procédurale en disant que « ce qui nous intéresse c’est s’il y a eu ou non abus de l’exécutif »."
                                            },
                                            {
                                                "example_id": "5a367708-6641-493a-ac00-4b869be1c490",
                                                "sense_id": "7b6027da-6781-3aa8-ac5f-3429d93d1ef5",
                                                "text": "Mon « patron » partageait son local avec Léo Matarasso, grand spécialiste de cette épineuse loi du 29 juillet 1881 qui régit le droit de la presse, pleine comme elle était (et l’est restée) d’embûches procédurales renouvelées par une jurisprudence à géométrie variable."
                                            },
                                            {
                                                "example_id": "3507571c-cb74-4daf-87c5-e4edc684a00f",
                                                "sense_id": "7b6027da-6781-3aa8-ac5f-3429d93d1ef5",
                                                "text": "Ce régime vise à limiter la sanction des fautes purement formelles ou procédurales, qui doivent désormais relever d’une logique de responsabilité managériale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "249a8911-0071-4e88-a632-2ef657417f06",
                        "source_entry_id": "3018d91d-26cd-3ba4-995d-37d3e3fc0f4e",
                        "source_sense_id": "74b134b4-9816-3863-b7d4-1c8eadc52f55",
                        "source_sense_description": "das Verfahrensrecht betreffend",
                        "target_lang_word": "procédurale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
