        "fr-extract.jsonl": [
            {
                "entry_id": "f9223d9a-8f32-3332-90cd-a9b161ca266d",
                "word": "surproduction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a451b9ad-9e9c-45cd-92df-44bdf964effb",
                        "entry_id": "f9223d9a-8f32-3332-90cd-a9b161ca266d",
                        "tags": [
                            "plural"
                        ],
                        "form": "surproductions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29526166-ca1d-3f84-a6e6-0508c628321a",
                        "entry_id": "f9223d9a-8f32-3332-90cd-a9b161ca266d",
                        "glosses": [
                            "Production excessive."
                        ],
                        "tags": [
                            "Économie politique"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbbb977-9aae-4a8c-bc61-1892076bda86",
                                "sense_id": "29526166-ca1d-3f84-a6e6-0508c628321a",
                                "text": "« Cette crise est un tournant historique. \"Il y aura un avant et un après\" disait Emmanuel Macron. En rejetant l’amendement des 45 députés fléchant le plan de relance de long terme sur la transition écologique, les décideurs français font le choix d’un après qui nous conduit droit dans le mur », en conclut Alma Dufour, chargée de campagne surproduction aux Amis de la Terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d45e4e5-8402-4456-bd90-fb54a42b4a9b",
                        "source_entry_id": "f9223d9a-8f32-3332-90cd-a9b161ca266d",
                        "source_sense_id": "29526166-ca1d-3f84-a6e6-0508c628321a",
                        "target_lang_word": "Überproduktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überproduktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                        "entry_id": "61382894-bb24-303a-bef4-67b4f24b9338",
                                        "glosses": [
                                            "Herstellung (Produktion) von mehr Gütern als geplant/benötigt/sinnvoll/verwendbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e3bd6da-9047-4ed5-bf44-2c523916d1fd",
                                                "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                                "text": "Die frühere Unterversorgung der Bevölkerung wurde durch eine hohe Überproduktion bei wichtigen Agrargütern abgelöst."
                                            },
                                            {
                                                "example_id": "44797dbf-713c-4804-af10-024cd826965f",
                                                "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                                "text": "„Im Gegensatz dazu hilft ein Pull-System, ungeplante Überproduktionen zu verhindern, indem die Arbeit nur dann vorwärtsbewegt wird, wenn der nächste Arbeitsbereich bereit ist, sie zu empfangen.“"
                                            },
                                            {
                                                "example_id": "f78797ee-a2b8-45b3-b2ac-502eb2d63e81",
                                                "sense_id": "767065be-3f43-320e-9ebf-05b18a7d4b3f",
                                                "text": "„Gute Ernten, bedingt durch ein Klimaoptimum, hatten in dieser Zeit eine Überproduktion von Nahrungsmitteln möglich gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11f911ca-7cf0-388e-80f3-f5ab38a138d8",
                                        "entry_id": "61382894-bb24-303a-bef4-67b4f24b9338",
                                        "glosses": [
                                            "Herstellung einer größeren Menge eines Stoffes, den der Körper im normalen Umfang benötigt, der aber bei einem Übermaß schädlich wirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1acdefee-c83f-4759-a1f9-8853b33eb4aa",
                                                "sense_id": "11f911ca-7cf0-388e-80f3-f5ab38a138d8",
                                                "text": "Überproduktion von Schilddrüsenhormonen kann zu Gewichtsverlust, Schwitzen und ständiger Nervosität führen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f45b383-d4a2-420c-8bf9-9a93247ec730",
                        "source_entry_id": "f9223d9a-8f32-3332-90cd-a9b161ca266d",
                        "source_sense_id": "29526166-ca1d-3f84-a6e6-0508c628321a",
