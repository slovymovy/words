                "senses": [
                    {
                        "sense_id": "16e6e85f-ede6-3d6e-a6e7-2473c485d6c4",
                        "entry_id": "25131ce0-54af-38eb-8d6a-b08bc1f04610",
                        "glosses": [
                            "lapjes stof waarin je je neus kunt snuiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a64204d-d9e7-4563-a1b7-f4ecb41af48a",
                                "sense_id": "16e6e85f-ede6-3d6e-a6e7-2473c485d6c4",
                                "text": "In bed met een snotlap, doorweekt van de regen of aan het begin van je herfstdepressie? Dan zijn deze comfortfoods jouw redder in nood! Makkelijk te bereiden en erg lekker. Eet smakelijk!"
                            },
                            {
                                "example_id": "77319d40-e8d6-4dab-8daf-cfdeb429b209",
                                "sense_id": "16e6e85f-ede6-3d6e-a6e7-2473c485d6c4",
                                "text": "Bacteriën vermenigvuldigen zich in hoog tempo in jouw stoffen snotlap. Dus weg met die zakdoek! Gebruik liever papieren zakdoekjes en werp ze na gebruik direct in de afvalbak."
                            },
                            {
                                "example_id": "c898d8b2-de11-49a8-abe5-bb8eb64b5b60",
                                "sense_id": "16e6e85f-ede6-3d6e-a6e7-2473c485d6c4",
                                "text": "\"Hoe krijg je dat nu voor elkaar?\" vraagt haar grote broer droog. Mijn man kijkt me ondertussen licht geamuseerd aan. Ja wat wil je, als je net met je hand in een of andere vieze snotlap zit die doordrenkt is met wat jus van de ballen die we eergisteren (of was het nog langer geleden?) hadden gegeten."
                            }
                        ]
                    }
