                "senses": [
                    {
                        "sense_id": "d39dcc34-390b-34be-a986-fb812bda9bee",
                        "entry_id": "94d295ac-0070-31f8-addc-6797801ad103",
                        "glosses": [
                            "Gesamtheit der Presseorgane, die international rezipiert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b21263f-5fd8-4336-bb8c-3cc918b187c5",
                                "sense_id": "d39dcc34-390b-34be-a986-fb812bda9bee",
                                "text": "„Wie der Versuch ausgeht, wird in der Weltpresse zu verfolgen sein.“"
                            },
                            {
                                "example_id": "81aec90f-141a-40fe-89a5-fc326188d551",
                                "sense_id": "d39dcc34-390b-34be-a986-fb812bda9bee",
                                "text": "„Die Geschichte ging durch die Weltpresse, beide waren berühmt.“"
                            },
                            {
                                "example_id": "d79b1ae2-e188-4ce9-aa6d-0eb4d7234d4a",
                                "sense_id": "d39dcc34-390b-34be-a986-fb812bda9bee",
                                "text": "„Die Weltpresse brachte die Nachricht über unsere Landung mit großen Schlagzeilen.“"
                            },
                            {
                                "example_id": "125431d3-740f-4932-896a-997631442a10",
                                "sense_id": "d39dcc34-390b-34be-a986-fb812bda9bee",
                                "text": "„Dass Irmgard Keun von 1940 bis 1945 unerkannt in Deutschland leben konnte, verdankt sie einer Falschmeldung, die Mitte 1940 durch die Weltpresse ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
