                "translations": [
                    {
                        "translation_id": "f7e1c782-ec4d-47b3-b104-c821301f8c32",
                        "source_entry_id": "d1e0dad9-6583-34fa-8491-40461c0832f5",
                        "source_sense_id": "19740d95-271e-3d27-9984-85a1133b812b",
                        "source_sense_description": "Hauptstadt der Wallonischen Region und der Provinz Namur",
                        "target_lang_word": "Namur",
