                        ],
                        "examples": [
                            {
                                "example_id": "7a7d12e1-9ac7-4169-ae96-2a40589b2082",
                                "sense_id": "efec136d-06b1-3ee9-940c-69517fe7d7f7",
                                "text": "Het J. Paul Getty Museum geeft een terracotta hoofd terug aan Sicilië. Het museum besloot daartoe nadat het had vastgesteld dat de ruim tweeduizend jaar oude kop van de Griekse god Hades illegaal werd opgegraven."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1e5a681-de7b-32f7-b48b-2d4cb050771f",
                        "entry_id": "5e3942f2-d764-36b8-9025-f3b897a62334",
                        "glosses": [
                            "onderaardse wereld waar de geesten van de doden leven"
                        ],
                        "tags": [
                            "Grieken, Romeinen"
                        ],
                        "examples": [
                            {
                                "example_id": "4dbef6b8-fb25-42ce-90ce-937a757171df",
                                "sense_id": "f1e5a681-de7b-32f7-b48b-2d4cb050771f",
                                "text": "De ingang van Hades, de Griekse onderwereld, werd bewaakt door Cerberus, een monsterlijke hond met drie koppen en een lange staart."
                            }
                        ]
                    },
                    {
                        "sense_id": "b642f7b3-94f9-3bb8-9666-e1ba346e2941",
                        "entry_id": "5e3942f2-d764-36b8-9025-f3b897a62334",
                        "glosses": [
                            "plaats waar de zielen van zondaars voortleven"
                        ],
                        "tags": [
                            "bij uitbreiding"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd1336b-3e8c-4bac-b2ec-d136760aeb4c",
                                "sense_id": "b642f7b3-94f9-3bb8-9666-e1ba346e2941",
                                "text": "Het is alsof je in een onderwereld terechtgekomen bent, in een Hades, en daar als schim opereert."
                            }
                        ]
                    }
