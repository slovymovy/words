                "translations": [
                    {
                        "translation_id": "85fc7cc3-9e82-4209-8062-d4b92e1098be",
                        "source_entry_id": "95ec45d8-7bb4-35f0-95d5-51676a68e1f2",
                        "source_sense_id": "6db354aa-e1aa-351f-8bd8-674072a84e45",
