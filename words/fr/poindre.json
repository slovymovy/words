            "pos": "verb",
            "senses": [
                {
                    "sense_id": "660f3631-2693-3fb9-8304-3ff5d63ccf24",
                    "sense_definition": "Commencer à paraître, en parlant du jour ou de la lumière de l'aube.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que le jour commençait à <w>poindre</w>, les pêcheurs quittaient le port silencieux."
                        },
                        {
                            "text": "Nous avons marché toute la nuit jusqu'à voir <w>poindre</w> les premières lueurs du matin."
                        }
                    ],
                    "synonyms": [
                        "naître",
                        "apparaître"
                    ],
                    "common_phrases": [
                        "le jour commence à poindre",
                        "voir le jour poindre"
                    ]
                },
                {
                    "sense_id": "04e6f96a-507a-3233-9baa-9ac93c294240",
                    "sense_definition": "Commencer à se manifester ou à devenir visible, en parlant d'un sentiment ou d'une attitude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un léger sourire semblait enfin <w>poindre</w> sur son visage fatigué."
                        },
                        {
                            "text": "Elle sentait une inquiétude soudaine <w>poindre</w> face au silence prolongé de son ami."
                        }
                    ],
                    "synonyms": [
                        "émerger",
                        "apparaître",
                        "naître"
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "common_phrases": [
                        "voir poindre un espoir",
                        "laisser poindre"
                    ]
                },
                {
                    "sense_id": "4eb8f1f8-3bac-3fe0-bb57-0ebff0ba0dcc",
                    "sense_definition": "Commencer à sortir de terre ou de la peau, en parlant d'un végétal ou d'un poil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la pluie tiède du printemps, les premières pousses vertes commençaient à <w>poindre</w>."
                        },
                        {
                            "text": "Le jeune homme était fier de voir enfin <w>poindre</w> quelques poils sur son menton."
                        }
                    ],
                    "synonyms": [
                        "germer",
                        "pousser",
                        "percer"
                    ],
                    "common_phrases": [
                        "commencer à poindre"
                    ]
                },
                {
                    "sense_id": "203bd203-fc57-3465-bc1d-40e22a1f7453",
                    "sense_definition": "Piquer ou affliger douloureusement, au sens physique ou moral.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "douleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un profond remords ne cessait de lui <w>poindre</w> le cœur depuis cette dispute."
                        },
                        {
                            "text": "De violentes douleurs thoraciques la <w>poignaient</w> dès qu'elle tentait de se lever."
                        }
                    ],
                    "synonyms": [
                        "piquer",
                        "tourmenter",
                        "affliger"
                    ],
                    "antonyms": [
                        "apaiser",
                        "soulager"
                    ],
                    "common_phrases": [
                        "poindre le cœur"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage transitif littéraire ou ancien"
                        }
                    ]
                }
            ]
