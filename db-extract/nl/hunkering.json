                    {
                        "translation_id": "eb6e8701-7405-4f7c-934d-81ed21e53dca",
                        "source_entry_id": "2775112a-7ed0-318f-a2d8-31092123a333",
                        "source_sense_id": "5cc16317-6a09-3ff3-b292-c9ac839edf08",
                        "source_sense_description": "het heftige, pijnlijke verlangen naar iets of iemand",
                        "target_lang_word": "desire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dac1ad9-d58e-3bf9-bbcc-35e4cfa4c8b6",
                                        "entry_id": "fa938dc8-18f6-313a-a34b-20dd35a34e72",
                                        "glosses": [
                                            "To want; to wish for earnestly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729aca76-2af3-4511-8bb4-e61427a01a21",
                                                "sense_id": "0dac1ad9-d58e-3bf9-bbcc-35e4cfa4c8b6",
                                                "text": "I desire to speak with you."
                                            },
                                            {
                                                "example_id": "963ba810-e6f1-42be-85a6-9fec4b91e19d",
                                                "sense_id": "0dac1ad9-d58e-3bf9-bbcc-35e4cfa4c8b6",
                                                "text": "Neither shall any man desire thy land."
                                            },
                                            {
                                                "example_id": "38f42746-fe34-450e-ab71-f85670e5aaa0",
                                                "sense_id": "0dac1ad9-d58e-3bf9-bbcc-35e4cfa4c8b6",
                                                "text": "[S]eeing you desire your child to live, / Thanks, but you work against your own desire; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55808298-d54b-316e-84b2-d85e1952784a",
                                        "entry_id": "fa938dc8-18f6-313a-a34b-20dd35a34e72",
                                        "glosses": [
                                            "To put a request to (someone); to entreat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d485240-6d27-497b-beb7-cb5940c20717",
                                                "sense_id": "55808298-d54b-316e-84b2-d85e1952784a",
                                                "text": "And when they founde no cause of deeth in hym, yet desired they Pilate to kyll him."
                                            },
                                            {
                                                "example_id": "7cef5282-dac0-4259-a899-c21e29b6bce0",
                                                "sense_id": "55808298-d54b-316e-84b2-d85e1952784a",
                                                "text": "Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84afede6-68d8-34aa-a1b8-dbe5ac20695b",
                                        "entry_id": "fa938dc8-18f6-313a-a34b-20dd35a34e72",
                                        "glosses": [
                                            "To want emotionally or sexually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef9edccd-d7ef-4f89-bd5e-d65e2ecfd0b2",
                                                "sense_id": "84afede6-68d8-34aa-a1b8-dbe5ac20695b",
                                                "text": "She has desired him since they first met."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d6510c4-b9e0-3cfa-8940-1f2feebeed82",
                                        "entry_id": "fa938dc8-18f6-313a-a34b-20dd35a34e72",
                                        "glosses": [
                                            "To express a wish for; to entreat; to request."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e41e252b-ef1d-438b-9688-10c30dacc20c",
                                                "sense_id": "9d6510c4-b9e0-3cfa-8940-1f2feebeed82",
                                                "text": "Then shee said, Did I desire a sonne of my Lord ? did I not say, Doe not deceiue me?"
                                            },
                                            {
                                                "example_id": "d18dec55-6d96-4d7a-aa83-dcc0f64b8523",
                                                "sense_id": "9d6510c4-b9e0-3cfa-8940-1f2feebeed82",
                                                "text": "Desire him to go in; trouble him no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9193b9a3-fb0e-3b32-baad-7891370376ff",
                                        "entry_id": "fa938dc8-18f6-313a-a34b-20dd35a34e72",
                                        "glosses": [
                                            "To require; to demand; to claim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a88695c-33e6-4535-8fa8-ebafbc66f2ac",
                                                "sense_id": "9193b9a3-fb0e-3b32-baad-7891370376ff",
                                                "text": "A doleful case desires a doleful song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "720ef234-be7c-39dc-9b48-7db57c7ed0df",
                                        "entry_id": "fa938dc8-18f6-313a-a34b-20dd35a34e72",
                                        "glosses": [
                                            "To miss; to regret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b915675-2242-450b-b42c-2177dd653d3e",
                                                "sense_id": "720ef234-be7c-39dc-9b48-7db57c7ed0df",
                                                "text": "She shall be pleasant while she lives, and desired when she dies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
