                    {
                        "sense_id": "fb4f7242-3458-349d-96d9-5f50cdecd3ae",
                        "entry_id": "b4618fbb-ac26-30cb-8ac8-75d3fe339591",
                        "glosses": [
                            "eine Karte zur Navigation auf See"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8f5087-bd76-461c-be45-556e4fd73714",
                                "sense_id": "fb4f7242-3458-349d-96d9-5f50cdecd3ae",
                                "text": "Ohne eine gute Seekarte wäre die Fahrt nicht möglich gewesen."
                            },
                            {
                                "example_id": "592686e4-4c24-400c-86c3-e8b522311cbf",
                                "sense_id": "fb4f7242-3458-349d-96d9-5f50cdecd3ae",
                                "text": "„Die Auswanderer wissen nur ungefähr, wo sich das verheißungsvolle Eiland befindet, denn Kompass und Seekarten kennen sie nicht.“"
                            },
                            {
                                "example_id": "8ef66398-b12f-4af3-8585-38e997c5a4c5",
                                "sense_id": "fb4f7242-3458-349d-96d9-5f50cdecd3ae",
                                "text": "„Silver besaß einen Kompaß, einen Sextanten und eine Seekarte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
