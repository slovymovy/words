                ],
                "senses": [
                    {
                        "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                        "entry_id": "f023fbc0-238d-356b-a403-0a5330f89777",
                        "glosses": [
                            "Wissen eines Experten in einem Fachgebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb86a063-dce1-4ffb-a589-ebdd4db80f09",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "Jäger müssen ihre Sachkenntnis in Deutschland mit dem Bestehen einer Prüfung belegen."
                            },
                            {
                                "example_id": "dd10277e-64d2-4f3e-8a4e-289f4f45e682",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„Auch wenn es von der Bundesregierung heiße, junge arbeitsfähige Männer könnten sich in den sicheren Landesteilen [von Afghanistan] eine neue Existenz aufbauen, zeuge dies von erstaunlich wenig Sachkenntnis, sagt Ramin Mohabat entschieden.“"
                            },
                            {
                                "example_id": "dcbdb0f4-4bda-44f3-b16e-5447d8a3c74b",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„Selbst die Grünen im Europaparlament lobten [Günther Oettinger] schon wenige Monate nach Amtsantritt für seine Sachkenntnis und Ausdauer.“"
                            },
                            {
                                "example_id": "0fdfb9f5-913c-4ecc-8966-fd289ed45cd6",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„‚[Der Journalist Karl-Heinz] Harenberg hatte einen scharfen Verstand, verfügte über gute Sachkenntnis und seine Art zu (hinter)fragen war nachgerade penetrant. […]‘“"
                            },
                            {
                                "example_id": "69a08723-081c-4bb3-948a-8bc3cd8b1331",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„[…] Goran Tvrdić […] setzt sich mit großer Leidenschaft und Sachkenntnis auch für die Bienen ein.“"
                            },
                            {
                                "example_id": "635ea76c-5a1c-4b56-9304-aaacfd875a08",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„Als Vize-Fraktionschefin Beatrix von Storch kürzlich im Bundestag den Migrationspakt verurteilte, konterte der Christdemokrat [Stephan Harbarth] und warf der Juristin Storch fehlende Sachkenntnis vor […]“"
                            },
                            {
                                "example_id": "730f055b-3247-485c-8443-cde49350cc46",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„Simonetta Sommaruga ist bekannt als ruhige Politikerin, die weniger durch markige Statements als durch Sachkenntnis und Hartnäckigkeit auffällt.“"
                            },
                            {
                                "example_id": "c3c31ea9-9610-4436-aacd-6dbbdec15bea",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„Am Ende allerdings überraschte mich einer der [amerikanischen] Gefangenen mit seiner Sachkenntnis bezüglich unseres Landes [der Schweiz].“"
                            },
                            {
                                "example_id": "f3696841-e651-46b3-b00f-7aaaf6a0ba1e",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "[…] warum die Welt dieser Drohung [mit Atomwaffen und Raketen] so hilflos gegenübersteht und wie Nordkorea und seine Führung ticken, beschreibt Matthias Naß in seinem Buch „Countdown in Korea“ mit hoher Sachkenntnis, kühlem analytischen Kopf und klarer Sprache."
                            },
                            {
                                "example_id": "a9879df2-21f7-4cdc-849c-fba8e9515f11",
                                "sense_id": "7da7f30a-2544-377c-8822-9ea08cb047dc",
                                "text": "„Mit Engelsgeduld und viel Sachkenntnis verwenden die beiden jede freie Minute darauf, das geschichtsträchtige Gebäude wieder herzurichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
