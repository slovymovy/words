                "senses": [
                    {
                        "sense_id": "a467b80a-dd93-320c-8a10-7d515abe0656",
                        "entry_id": "1106038e-3c1c-3b10-90b5-5c7eb809aa33",
                        "glosses": [
                            "wierzchnia szata liturgiczna prezbiterów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b47f21-8b64-4448-9945-9a68b5fef7b5",
                                "sense_id": "a467b80a-dd93-320c-8a10-7d515abe0656",
                                "text": "Proboszcz wyszedł do ołtarza w fioletowym ornacie."
                            },
                            {
                                "example_id": "e9ebf208-5cd8-43d5-86c8-10203d132b94",
                                "sense_id": "a467b80a-dd93-320c-8a10-7d515abe0656",
                                "text": "W okresie zwykłym kapłan nosi ornat koloru zielonego."
                            },
                            {
                                "example_id": "3506e40a-0861-45b9-865c-6b37a0b3d414",
                                "sense_id": "a467b80a-dd93-320c-8a10-7d515abe0656",
                                "text": "Odprawiał bez ornatu, w samej stule."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a3dabd67-13a0-350d-ba48-8848b157f7c3",
