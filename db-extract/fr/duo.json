                                            {
                                                "example_id": "b895cb9b-bc19-40fa-956d-274e9b56804d",
                                                "sense_id": "d7251a5e-0ca6-38f9-82aa-d7412662d161",
                                                "text": "The duo of pork consisted of a smoked sausage and a shoulder joint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74361c75-281a-3476-9e54-ae27a2cdb3a6",
                                        "entry_id": "ddd0ddad-0f64-3311-9576-34a83c38c510",
                                        "glosses": [
                                            "A song in two parts; a duet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687a32c5-ad11-4b83-8190-4ae09ceeef60",
                                                "sense_id": "74361c75-281a-3476-9e54-ae27a2cdb3a6",
                                                "text": "I noticed early on, in playing a duo with a violinist, that when a very cheesy synthesized violin sound plays in counterpoint with a real violin, it can quite convincingly seem as if two violins are playing."
                                            }
                                        ]
                                    }
                                ]
