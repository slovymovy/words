                "senses": [
                    {
                        "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                        "entry_id": "f3bc260d-bdcc-3b51-944b-de428b87b782",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1b4699-2a55-4850-bae1-35aca56bc362",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Frau Hamerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cac36c67-26a6-4dc9-88ce-1159aba3f8e5",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Herr Hamerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7d1ebfd1-2abd-47dc-a31e-d8f8b0bcb8f7",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Die Hamerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1ccf4b75-7fa2-4a69-b6e1-86a6018d6a33",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Der Hamerle trägt nie die Pullover, die die Hamerle ihm strickt."
                            },
                            {
                                "example_id": "76e51070-e67c-4cfe-9d7d-fc6800f9f7e3",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hamerle kommt, geht der Herr Hamerle.“"
                            },
                            {
                                "example_id": "b326c31b-e32a-48ad-9ddd-e442d4b9c104",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Hamerle kommt und geht."
                            },
                            {
                                "example_id": "707b09b3-a1ae-459b-a0b6-a09eb65bd6ca",
                                "sense_id": "27463070-8ba3-3483-9aff-6381389f9331",
                                "text": "Hamerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
