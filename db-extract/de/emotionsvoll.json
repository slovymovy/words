                ],
                "senses": [
                    {
                        "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                        "entry_id": "bb7297cc-eca6-3e67-bb61-3d96aceabcf2",
                        "glosses": [
                            "viele Emotionen und Gefühle aufweisend, vermittelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72d4a90-47af-4a9f-b850-cd7ec2ace06b",
                                "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                                "text": "„Ich schüttelte wild den Kopf - blickte zur Seite und sprudelte emotionsvoll die Worte heraus, die so lange schon in mir kochten und gesagt werden mussten.“"
                            },
                            {
                                "example_id": "d204d9e3-f3cf-44f1-8df8-55fb69c170da",
                                "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                                "text": "„War nie jung, verrückt, ausgelassen, spontan oder emotionsvoll gewesen, dafür stets angepasst, schwerfällig und wenig flexibel.“"
                            },
                            {
                                "example_id": "1bd6372a-9bbd-4a95-9bb1-4993b0b2a925",
                                "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                                "text": "„Yang Lili sang so emotionsvoll, brachte fast alle Patientinnen zum Weinen.“"
                            },
                            {
                                "example_id": "13e19674-4b35-4f01-9a86-1cdd937bd544",
                                "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                                "text": "„Die Songs werden sehr ruhig und emotionsvoll vorgetragen.“"
                            },
                            {
                                "example_id": "39a43f2e-c44c-4eb7-b55d-f56223a8b083",
                                "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                                "text": "„Sie sind so wild und frei und gleichzeitig so nah bei uns und so emotionsvoll.“"
                            },
                            {
                                "example_id": "1386e299-2833-48f8-83ba-101202c169a5",
                                "sense_id": "fed25a9d-634e-3ca6-80fc-4a15736ab2fc",
                                "text": "„Die Abschiedsparty von der netten Französin Simone war sehr emotionsvoll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
