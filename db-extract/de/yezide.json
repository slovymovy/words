                        "glosses": [
                            "Mitglied einer alten monotheistischen Glaubensgemeinschaft im Vorderen Orient (Yezidentum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11add1f2-e864-4b24-8ca8-fc18ca827c85",
                                "sense_id": "fb78d802-4381-37e9-877d-e1a195233d02",
                                "text": "Die Yeziden sind Monotheisten."
                            },
                            {
