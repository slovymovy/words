                        "form": "die Neonazis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                        "entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                        "glosses": [
                            "Anhänger des Nationalsozialismus, dessen Aktivität nach dem Untergang des Dritten Reiches stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d20b721-a58a-4cc4-bbf5-68d7dc18ca2f",
                                "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                "text": "Wenn Neonazis Demonstrationen aufführen, werden sie von der Bundespolizei bewacht."
                            },
                            {
                                "example_id": "da1109f6-b49f-409a-9222-a0baa53c6d84",
                                "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                "text": "„Starre Ansichten wie diese lassen sich beispielsweise bei Islamisten erkennen, aber genauso bei Neonazis oder anderen Extremisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                        "entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                        "glosses": [
                            "Person mit rechter Gesinnung; Ausländerfeind"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "9845b591-eb45-433b-a2e0-f7099cfcf4a6",
                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                "text": "In dem Viertel wohnen nur Neonazis."
                            },
                            {
                                "example_id": "32ed986e-059f-4935-b130-beff9122bea7",
                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                "text": "„Häuser in Mölln und Solingen wurden von Neonazis in Brand gesetzt.“"
                            },
                            {
                                "example_id": "824c966c-f67e-4d30-9f82-231f33b04ba4",
                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                "text": "„Vor den Augen der Sicherheitsbehörden hat sich eine Szene von jungen, gewaltbereiten Neonazis etabliert.“"
                            },
                            {
                                "example_id": "419a6a06-66d5-4100-8ba3-71085560f961",
                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                "text": "„Auch andernorts verübten junge Neonazis zuletzt schwere Gewalttaten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c253a30c-4a8c-4dec-a055-86f4725a3253",
                        "source_entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                        "source_sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                        "source_sense_description": "Anhänger des Nationalsozialismus, dessen Aktivität nach dem Untergang des Dritten Reiches stattfindet",
                        "target_lang_word": "neo-Nazi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neo-Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                        "entry_id": "c2ea2748-9d35-325a-805d-30e32f9c94fd",
                                        "glosses": [
                                            "An adherent of neo-Nazism, any of various (far right, authoritarian, or bigoted) post-World War II Nazi ideologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6c8b78-e57b-4552-9c85-9f63e1f1812e",
                                                "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                                "text": "Andrew Anglin, head of the now defunct alt-right publication Daily Stormer, a Neo-Nazi, and friend of Richard Spencer claimed on his site that “the only thing in our movement that really matters [is] anti-Semitism […] Last but not least, President Trump himself was key in mainstreaming alt-right politics, referring to white supremacists and Neo-Nazis as “very fine people”, […]"
                                            },
                                            {
                                                "example_id": "d60e61c0-a308-4e12-b20e-450c8351f60c",
                                                "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                                "text": "Among his first moves, he dismantled Twitter's trust and safety infrastructure, laying off the vast majority of the staff responsible for things like taking down violent threats and hate speech. In their place, he welcomed neo-Nazis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neo-Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                        "entry_id": "15e32e81-f7bf-33b7-a0cb-8e24ae12e601",
                                        "glosses": [
                                            "Of or pertaining to neo-Nazism or neo-Nazis."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2955ad6f-9017-4635-838b-4cba2e7bc4b8",
                                                "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                                "text": "On the whole the Galicians have been at the more pitiful end of the spectrum, trading infantile political insults on the web, each trying desperately to appear more neo-Nazi than the other."
                                            },
                                            {
                                                "example_id": "04281a07-c4d2-4b90-9a0d-ff3709f4dad8",
                                                "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                                "text": "Wilson has tweeted the phrase “Ausländer Raus” at least four times, including the slogan, “Deutschland den Deutschen. Ausländer raus.” The phrase, which means, “Germany for Germans, foreigners out,” is explicitly considered to be an extremist slogan in Germany with neo-Nazi roots; in fact, a 1992 paper about its use among German skinheads is available on a Department of Justice website."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81e46e47-3b92-4bb0-b371-ae0772e194e4",
                        "source_entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                        "source_sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                        "source_sense_description": "Anhänger des Nationalsozialismus, dessen Aktivität nach dem Untergang des Dritten Reiches stattfindet",
                        "target_lang_word": "néonazi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néonazi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0cebc58-0f95-39f7-9a4a-05c2174d10d3",
                                        "entry_id": "7210002e-4854-345e-b72a-c320eaf7ff40",
                                        "glosses": [
                                            "Variante orthographique de néo-nazi."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0afa45dd-6d58-46ba-a495-c61e112bb387",
                                                "sense_id": "f0cebc58-0f95-39f7-9a4a-05c2174d10d3",
                                                "text": "Procès repoussé en 2011 Le mouvement intégriste Fraternité Saint-Pie X, dont il est membre, a menacé de l’exclure de ses rangs s’il ne renonçait pas aux services de cet avocat, Wolfram Nahrath, très prisé de la mouvance néonazie allemande."
                                            },
                                            {
                                                "example_id": "8e195aac-cf00-4a02-971a-029544207bd6",
                                                "sense_id": "f0cebc58-0f95-39f7-9a4a-05c2174d10d3",
                                                "text": "Écrasée par un conducteur néonazi, une manifestante a pourtant payé de sa vie son opposition à la parade de Charlottesville, qui rassemblait, le week-end dernier, suprémacistes blancs, sudistes nostalgiques de l’esclavage et du général Lee, militants de l’« alt-right » (extrême droite) et autres humanistes du Ku Klux Klan, tous unis, bras tendu, batte de base-ball en main, slogans antisémites et anti-« nègres » aux lèvres, pour hurler leur « fierté d’être blancs »."
                                            },
                                            {
                                                "example_id": "095b8be5-808d-4e54-89d4-2ff203834631",
                                                "sense_id": "f0cebc58-0f95-39f7-9a4a-05c2174d10d3",
                                                "text": "N’oublions pas que de 2005 à 2007, une série d’incendies de chapelles, de profanations et de décapitation de calvaires dans le Finistère et dans le Morbihan (Loqueffret, Saint-Tugdual…) avait mené les enquêteurs d’alors sur la piste de satanistes issus de mouvements néonazis et de black métal."
                                            },
                                            {
                                                "example_id": "15a0868f-8a97-484f-9cfd-9ca349d4454f",
                                                "sense_id": "f0cebc58-0f95-39f7-9a4a-05c2174d10d3",
                                                "text": "En janvier dernier, le média d’investigation allemand Correctiv avait révélé que des membres de l’AFD avaient participé à une réunion, avec des néonazis autrichiens, autour d’un projet de remigration en Allemagne, c’est-à-dire d’expulsion d’étrangers mais aussi de citoyens allemands d’origine étrangère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "néonazi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73273ecd-b31b-31cc-a932-e50e220f1ab9",
                                        "entry_id": "d69c4b3d-64c7-3c09-b70a-28f8d948828d",
                                        "glosses": [
                                            "Variante orthographique de néo-nazi."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fa17511-e23d-4ae0-b1e4-a2c40412734e",
                                                "sense_id": "73273ecd-b31b-31cc-a932-e50e220f1ab9",
                                                "text": "Avoir un néonazi qui prône la supériorité raciale du Blanc et l’infériorité de l’Arabe et du Noir dans une prison où il y a une majorité de jeunes de banlieue pose un problème de sécurité pour lui et pour les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
