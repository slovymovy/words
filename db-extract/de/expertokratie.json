                "senses": [
                    {
                        "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                        "entry_id": "dfdd18fc-01ae-3f80-abae-18ad89c2c43a",
                        "glosses": [
                            "Herrschaft durch Personen, die in ihrem Fach erhebliches Wissen haben; Politikberatung durch Personen mit erheblichem Fachwissen, deren Wissen angewendet wird"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "605d1b41-9a53-4c25-903b-bc40b69d716c",
                                "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                                "text": "„Postdemokratie? Bullshit , sagt der Börsianer. Mehr Expertokratie wagen!“"
                            },
                            {
                                "example_id": "321062fb-3164-48de-89ca-c99a8d462e18",
                                "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                                "text": "[Coronapandemie:] „Etwas mehr Expertokratie hätte uns diese Katastrophe erspart.“"
                            },
                            {
                                "example_id": "33784027-9b2c-494d-a0a1-9f2b3ff16837",
                                "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                                "text": "„Die Welt ist im 21. Jahrhundert komplizierter geworden. Das wiederum hat dazu geführt, dass unsere Demokratie zu sehr zur Expertokratie mutiert ist.“"
                            },
                            {
                                "example_id": "a82f62fc-eb90-4674-b0ce-ddeef22e60b4",
                                "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                                "text": "„Der SPD-Kanzler [Anmerkung: G. Schröder] ersetzte die Volksvertretung durch außerparlamentarische Expertokratie: Hartz, Rürup, Riester, Ethikbeirat und so fort.“"
                            },
                            {
                                "example_id": "21a5fd79-4c9a-4c52-925d-03acac5da354",
                                "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                                "text": "„In der Demokratie müssen interessierte Laien bei hochkomplexen Thematiken mitreden können, sonst landen wir in einer Expertokratie.“"
                            },
                            {
                                "example_id": "6d1dad87-6f8e-435f-b794-f5e9a9b47c48",
                                "sense_id": "351cdc38-c694-3dff-920d-85d1e506ff00",
                                "text": "[Schlagzeile:] Droht uns die Expertokratie?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
