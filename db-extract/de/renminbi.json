                                        "sense_id": "9bbde966-c58c-3fb5-a7c6-3396e9ceab32",
                                        "entry_id": "074f9b00-8ba9-3650-92d4-264171267629",
                                        "glosses": [
                                            "The official currency of the People's Republic of China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0686ca-9622-404f-975d-a170c23c3a83",
                                                "sense_id": "9bbde966-c58c-3fb5-a7c6-3396e9ceab32",
                                                "text": "Now, the Fang County government is trying “incentives,” according to a statement posted Saturday on its website. People who report their own fevers will receive 1,000 renminbi, the equivalent of $143 — a few days’ salary for the average Hubei resident.\nThe statement also said that people who report the fevers of others would get 500 renminbi, which raised the prospect of neighbors turning one another in. Communist Party cadres who investigate and verify such reports would receive the same amount."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e8cae08-4107-4f60-ba37-71416dca29fb",
                        "source_entry_id": "951df7e6-1976-3695-9bcd-5200c5de0bc4",
