                    {
                        "form_id": "3a90d349-2857-40b8-84e9-1e37ed474557",
                        "entry_id": "4aa937b8-8f7e-3c44-922e-89cbd8effa1a",
                        "tags": [
                            "accusative",
                            "singular"
