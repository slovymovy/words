                    {
                        "translation_id": "d2ebdb44-2076-48f7-865c-5d2a055dbc5b",
                        "source_entry_id": "c8f16884-7884-3a24-9ddf-8dbb9a97eeac",
                        "source_sense_id": "cf02823f-35fd-334f-9baa-f87034c2db45",
                        "source_sense_description": "geological feature",
                        "target_lang_word": "modelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b95fa256-a55c-318f-997f-eddf436948b8",
                                        "entry_id": "8d3aa022-d6ff-3837-ad32-5a5a0c06df09",
                                        "glosses": [
                                            "Galbe, forme harmonieuse du corps ou d'une partie de celui-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f2462d-48f7-4a32-85d5-2c836fa59237",
                                                "sense_id": "b95fa256-a55c-318f-997f-eddf436948b8",
                                                "text": "J’aperçois, dans le décor que la pénombre commence à envahir, le modelé de mon front, l’ovale de mon visage et, sous ma paupière clignante, mon regard par lequel j’entre en moi comme dans un tombeau."
                                            },
                                            {
                                                "example_id": "dd0dfdc7-7822-4ffd-a873-666d5d5ef61f",
                                                "sense_id": "b95fa256-a55c-318f-997f-eddf436948b8",
                                                "text": "La serveuse est du genre Lollobrigida, avec un soupçon de Brigitte Bardot dans le modelé de la moue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d13bad3-4301-39b9-a2a0-1a0c0dd74332",
                                        "entry_id": "8d3aa022-d6ff-3837-ad32-5a5a0c06df09",
                                        "glosses": [
                                            "Ensemble de reliefs, de formes de terrain liées soit à un agent d’érosion, soit à un système d’érosion, soit encore à un type de roche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9fc28c-5b3f-42a7-bdcd-66b628e3ce7b",
                                                "sense_id": "7d13bad3-4301-39b9-a2a0-1a0c0dd74332",
                                                "text": "Les modelés de marge glaciaire s’imposent dans le nord de l’Angleterre et dans la grande plaine européenne : drumlins et oesar au Nord, alignements confus de collines surbaissées, désorganisant le drainage de la plaine balte, multipliant les dépressions tourbeuses."
                                            },
                                            {
                                                "example_id": "e0a00358-aff5-4f8c-a703-ec9d21bf873e",
                                                "sense_id": "7d13bad3-4301-39b9-a2a0-1a0c0dd74332",
                                                "text": "Le grès est, d’autre part, sensible à la météorisation qui dégage les grains de sable et lui impose un modelé de détail arrondi et pachydermique (forêt de Fontainebleau)."
                                            },
                                            {
                                                "example_id": "54e64ae1-2290-4e32-8ada-a93ef048ad3b",
                                                "sense_id": "7d13bad3-4301-39b9-a2a0-1a0c0dd74332",
                                                "text": "Ces réactions chimiques associées à la dissolution et à la précipitation du calcaire produisent des modelés caractéristiques : le karst [Nicod, 1972 ; Salomon, 2000]."
                                            }
                                        ]
                                    }
                                ]
                            },
