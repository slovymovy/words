                        "examples": [
                            {
                                "example_id": "9c7a1c93-f26e-4a82-a662-57815ef5fb42",
                                "sense_id": "64cb8a00-1fc3-3d3e-9767-6b9e432e4846",
                                "text": "Parlez-moi de M. Pasquier ! voilà un bon et pur académicien, fidèle à la verdurette, comme il lʼest à la simarre-puce, selon les moments et les lieux !"
                            },
                            {
                                "example_id": "f3b0d7a5-85f0-4e0b-afbb-f0d2168747e0",
                                "sense_id": "64cb8a00-1fc3-3d3e-9767-6b9e432e4846",
                                "text": "Après son admission au palais de la verdurette, j'ai charrié mon ami Obaldia avec quelques joyeux propos du naturaliste Cuvier. « Les cochons, disait-il, se reproduisent beaucoup mieux que les académiciens. »"
                            }
