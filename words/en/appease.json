    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                    "sense_definition": "To make someone less angry or upset by giving them what they want.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to <w>appease</w> the protesters by promising new reforms."
                        },
                        {
                            "text": "She gave the child a toy to <w>appease</w> his crying."
                        }
                    ],
                    "synonyms": [
                        "pacify",
                        "placate",
                        "mollify"
                    ],
                    "antonyms": [
                        "antagonize"
                    ],
                    "common_phrases": [
                        "appease the crowd",
                        "appease the critics"
                    ]
                },
                {
                    "sense_id": "5f72dfef-7688-3a5f-b8a8-845d5c47598c",
                    "sense_definition": "To satisfy a demand or feeling, often by making concessions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They offered a small payment to <w>appease</w> the angry customers."
                        },
                        {
                            "text": "The company made changes to <w>appease</w> the demands of the labor union."
                        }
                    ],
                    "synonyms": [
                        "propitiate"
                    ],
                    "common_phrases": [
