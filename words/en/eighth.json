                {
                    "sense_id": "fcab1ff3-d6e0-3163-b2b8-a5837a02e3cd",
                    "sense_definition": "Coming after the seventh in a sequence; corresponding to the number 8.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordinal_number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She lives on the <w>eighth</w> floor of the apartment building.",
