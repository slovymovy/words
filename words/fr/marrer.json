                        {
                            "text": "Nous nous sommes bien <w>marrés</w> hier soir en regardant ce spectacle comique.",
                            "target_lang_translations": {
                                "en": "We really <w>cracked up</w> last night while watching this comedy show.",
                                "ru": "Вчера вечером, глядя на это комедийное шоу, мы здорово <w>посмеялись</w>.",
                                "nl": "Gisteravond hebben we flink <w>gelachen</w> tijdens het kijken naar deze komische voorstelling.",
                                "de": "Gestern Abend haben wir uns beim Anschauen dieser Comedy-Vorstellung richtig <w>kaputtgelacht</w>.",
                                "pl": "Wczoraj wieczorem, oglądając ten komediowy spektakl, <w>ubawiliśmy się</w> świetnie.",
                                "it": "Ieri sera, guardando questo spettacolo comico, ci siamo proprio <w>sbellicati</w> dalle risate.",
                                "cs": "Včera večer jsme <w>se</w> na tom komickém představení pořádně <w>nasmáli</w>.",
                                "tr": "Dün akşam bu komik gösteriyi izlerken çok <w>güldük</w>.",
                                "es": "Anoche <w>nos reímos</w> muchísimo viendo este espectáculo cómico.",
                                "zh": "昨晚看这场喜剧表演时，我们<w>笑</w>得很痛快。"
                            }
                        },
                        {
                            "text": "Ils se <w>marrent</w> tout le temps ensemble au fond de la classe.",
                            "target_lang_translations": {
                                "en": "They are always <w>laughing</w> together at the back of the classroom.",
                                "ru": "Они всё время вместе <w>смеются</w> на задней парте.",
                                "nl": "Ze <w>lachen</w> altijd samen achterin de klas.",
                                "de": "Sie <w>lachen</w> immer zusammen hinten in der Klasse.",
                                "pl": "Ciągle razem <w>śmieją się</w> z tyłu klasy.",
                                "it": "<w>Ridono</w> sempre insieme in fondo alla classe.",
                                "cs": "Pořád <w>se</w> spolu <w>smějí</w> vzadu ve třídě.",
                                "tr": "Sınıfın arkasında her zaman birlikte <w>gülüyorlar</w>.",
                                "es": "Todo el tiempo <w>se ríen</w> juntos al fondo de la clase.",
                                "zh": "他们总是在教室后排一起<w>笑</w>个不停。"
                            }
                        }
