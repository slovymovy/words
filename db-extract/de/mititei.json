                "senses": [
                    {
                        "sense_id": "94a44cf7-e34d-314c-acb0-0f39dc8e9807",
                        "entry_id": "992b8d1f-62f0-3af9-a58f-d87f8f9f20c3",
                        "glosses": [
                            "gegrillte Hackfleischröllchen (Nationalgericht Rumäniens)"
                        ],
                        "tags": [
                            "Rumänien"
                        ],
                        "examples": [
                            {
                                "example_id": "033b6e48-f99f-4c9f-b692-899705054962",
                                "sense_id": "94a44cf7-e34d-314c-acb0-0f39dc8e9807",
                                "text": "„Gegen Abend waren wir wieder in Schäßburg und fuhren hinauf zur Villa Franka, wo wir bei der bekannten herrlichen Aussicht auf die Stadt unser letztes Abendessen in Schäßburg, Holzfleisch und Mititei, einnahmen.“"
                            },
                            {
                                "example_id": "a4fc56bb-6d03-431a-be68-4bbcb957936a",
                                "sense_id": "94a44cf7-e34d-314c-acb0-0f39dc8e9807",
                                "text": "„Dazu gehören Klassiker wie Mămăligă (Maisbrei), Ardei umpluţi (Gefüllte Paprikaschoten), Sarmale (Krautwickel), Mititei (Hackfleischröllchen) und Clătite (Pfannkuchen) auf der rumänischen und Grünkohl mit Mettwurst, Eisbein mit Sauerkraut, Ochsenschwanzragout und Zwiebelheringe auf der deutschen Seite.“"
                            },
                            {
                                "example_id": "a7049ef4-21cf-4bd9-b8a6-7664ecc17ad8",
                                "sense_id": "94a44cf7-e34d-314c-acb0-0f39dc8e9807",
                                "text": "„Insgesamt 40.000 Liter Bier wurden verkauft, 11.000 Mititei gegessen sowie 6000 Brezeln, 1500 Weißwürste und eine halbe Tonne sauer Eingelegtes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8825ce7d-0d32-4f7b-87bf-c990fb1c7dc3",
                        "source_entry_id": "992b8d1f-62f0-3af9-a58f-d87f8f9f20c3",
                        "source_sense_id": "94a44cf7-e34d-314c-acb0-0f39dc8e9807",
                        "source_sense_description": "Rumänien: gegrillte Hackfleischröllchen (Nationalgericht Rumäniens)",
                        "target_lang_word": "mititei",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mititei",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d88d77b3-1553-3651-b091-b4a544ffdb08",
                                        "entry_id": "8d1459de-5ad6-3238-b565-f3f0f56c297f",
                                        "glosses": [
                                            "A popular Romanian dish of grilled ground meat rolls in cylindrical shape, often spicy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930faaae-368b-41f2-9f8e-fbb4d52e7c48",
                                                "sense_id": "d88d77b3-1553-3651-b091-b4a544ffdb08",
                                                "text": "Men, driven out of their offices by the sweltering heat, walked slowly past the palace gates to their favorite bodega for a mititei, that spicy meat roll, and a cool glass of wine with a dash of seltzer. Autos sped past. Newsboys shouted."
                                            },
                                            {
                                                "example_id": "4ff2f252-e574-44ac-8dd5-902423851cc7",
                                                "sense_id": "d88d77b3-1553-3651-b091-b4a544ffdb08",
                                                "text": "Bulgarians have earned bragging rights for their kufteh (cumin-scented veal and pork burgers). Romanians deserve raves for their mititei (spicy pork and lamb sausages). […] Cooks in the Balkans and Iran add baking soda or seltzer water to make their mititeis and ćevapčičis (the Balkan version of kofta) light."
                                            },
                                            {
                                                "example_id": "35f4fb24-8c70-4af4-828e-576c5005840b",
                                                "sense_id": "d88d77b3-1553-3651-b091-b4a544ffdb08",
                                                "text": "He slow-grills whole pigs, or rotisserie chicken – take your pick – over hot coals, he says. Vegetable kebabs and mititei feature, too. ¶ Traditional Romanian sausages, mititei are made with ground meats – pork, beef and lamb – flavoured with salt, pepper and herbs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
