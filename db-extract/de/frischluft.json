                "senses": [
                    {
                        "sense_id": "3ad9050b-bb63-34f5-819f-a57208fb714b",
                        "entry_id": "82742d01-d6b1-3182-8284-5ab62f61d15e",
                        "glosses": [
                            "unverbrauchte Luft, die von außen einem Raum zugeführt wird oder eingeatmet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8a2cc2-0e4d-44c7-9f4d-9f19357d763d",
                                "sense_id": "3ad9050b-bb63-34f5-819f-a57208fb714b",
                                "text": "Die Wohn- und Lagerräume werden mit Frischluft durch Fensterlüftung, Schachtlüftung oder Fugenlüftung versorgt."
                            },
                            {
                                "example_id": "382836f1-a396-47ba-996d-c578e548493a",
                                "sense_id": "3ad9050b-bb63-34f5-819f-a57208fb714b",
                                "text": "„Die Frischluft wird von außen über Wandeinbauventile in die Wohnräume befördert.“"
                            },
                            {
                                "example_id": "c078f9f2-5cd9-41e7-a458-960b8256b8bc",
                                "sense_id": "3ad9050b-bb63-34f5-819f-a57208fb714b",
                                "text": "„Die Luft war stickig trotz der Dieselgeneratoren, die den Bunker mit Licht, Heizung und Frischluft versorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
