        "nl-extract.jsonl": [
            {
                "entry_id": "69cccb4c-3301-3e73-be42-b0b059c2923e",
                "word": "losprijs",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "217a2ee0-b72d-46e8-b91b-cb88e5c3b396",
                        "entry_id": "69cccb4c-3301-3e73-be42-b0b059c2923e",
                        "tags": [
                            "plural"
                        ],
                        "form": "losprijzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2f9dd3a-9717-36bb-a8c7-2150018cf69b",
                        "entry_id": "69cccb4c-3301-3e73-be42-b0b059c2923e",
                        "glosses": [
                            "geld dat men aan ontvoerders moet betalen om de ontvoerde persoon weer vrij te krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb77e673-16fd-465c-b7f3-1d69a8fcdfa3",
                                "sense_id": "b2f9dd3a-9717-36bb-a8c7-2150018cf69b",
                                "text": "De Standaard Piraten zijn donderdag in Somalische wateren aan boord gegaan van een cargoschip dat onder de vlag van de Verenigde Arabische Emiraten (VAE) voer. Ze eisen nu een losprijs van 1 miljoen dollar (789.000 euro) voor de bemanning en het schip."
                            },
                            {
                                "example_id": "d2ce3567-39b6-4240-ab08-5bd4d1ffb682",
                                "sense_id": "b2f9dd3a-9717-36bb-a8c7-2150018cf69b",
                                "text": "In dit geval is die kern wellicht dat de Amerikaanse en Britse staatsburgers met wie Rye zijn cel deelde, het veelal niet kunnen navertellen. Hun familie is het bij wet verboden om over een losprijs te onderhandelen. En dan ben je ten dode opgeschreven. Een ander verhaal dus. Maar ik voelde er veel minder bij."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d0d71a-089d-3768-a658-7f6ac703bcfb",
                        "entry_id": "69cccb4c-3301-3e73-be42-b0b059c2923e",
                        "glosses": [
                            "geld dat iemand ontvangt als hij iemand anders aangeeft bij de politie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bbb58c4-0bc0-4a4e-a99a-aa6ac25df795",
                                "sense_id": "c3d0d71a-089d-3768-a658-7f6ac703bcfb",
                                "text": "Op zijn hoofd stond een losprijs van tien miljoen euro. 'Ik ben woedend', zei dorpsgenoot Zoran, nadat het nieuws over de arrestatie bekend werd. 'Ze hebben onze held gearresteerd.' Volgens de Servische minister Rasim Ljajic, belast met de samenwerking met het Joegoslavië-Tribunaal, zag Mladic 'er uit als een oude man'. Ljalic: 'Je zou hem voorbijlopen zonder hem te herkennen.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "913248df-fc37-4481-997f-98bf25bf02a8",
                        "source_entry_id": "69cccb4c-3301-3e73-be42-b0b059c2923e",
                        "source_sense_id": "b2f9dd3a-9717-36bb-a8c7-2150018cf69b",
                        "source_sense_description": "geld dat men aan ontvoerders moet betalen om de ontvoerde persoon weer vrij te krijgen",
                        "target_lang_word": "Lösegeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lösegeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                        "entry_id": "c0e1fbfd-0c80-321f-ae37-a603a3ce2db3",
                                        "glosses": [
                                            "Geld, das für die Freilassung einer Geisel gezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6618c150-e54f-4722-a482-27d17b4dda7a",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "Die Entführer verlangen eine Million Euro Lösegeld."
                                            },
                                            {
                                                "example_id": "cd13dddf-0792-4690-8d6b-fa72a364e904",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Die Krise verschärfte sich erheblich, als im Jahre 455 die Vandalen Rom einnahmen, die Stadt plünderten, die Oberschicht gefangen nahmen und erst nach Zahlung eines hohen Lösegeldes entließen.“"
                                            },
                                            {
                                                "example_id": "0c56b100-6486-4d04-a6b4-4d1fd5d50836",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Vielfach enden Entführungen glimpflich für die Entführten, doch hat in letzter Zeit auch die Extremistengruppe Al-Kaida auf der Arabischen Halbinsel (AQAP) mehrere Ausländer entführt, darunter einen südafrikanischen Lehrer, den sie zu ermorden drohen, sollte für ihn kein Lösegeld gezahlt werden.“"
                                            },
                                            {
                                                "example_id": "f973834c-48ae-4ac0-8190-24eac2f57cec",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Polybios erwähnt nicht das hohe Lösegeld, das die Römer für den Abzug der Gallier zahlen müssen, wie Livius berichtet.“"
                                            },
                                            {
                                                "example_id": "7bfe5b8a-d5d5-4392-9a3e-3d4eab73d7b5",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Das musste der Wesir des Mogulreichs erfahren, dessen großes Heer Baji Rao zweimal besiegte, dann aber jedesmal gegen hohes Lösegeld davonziehen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a58f009-95d3-409a-bf1d-1c6fddeb4297",
                        "source_entry_id": "69cccb4c-3301-3e73-be42-b0b059c2923e",
                        "source_sense_id": "b2f9dd3a-9717-36bb-a8c7-2150018cf69b",
                        "source_sense_description": "geld dat men aan ontvoerders moet betalen om de ontvoerde persoon weer vrij te krijgen",
                        "target_lang_word": "ransom",
