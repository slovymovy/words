                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc641153-c1ca-33be-8dec-85212d8b600a",
                        "entry_id": "be817473-080d-3da0-8aa6-02f05ef51c4b",
                        "glosses": [
                            "Marque au fer rouge pour identifier le bétail."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "c219195a-440a-4eb6-9dd2-8b6cacd0bf9c",
                                "sense_id": "bc641153-c1ca-33be-8dec-85212d8b600a",
                                "text": "Тавро — знак, которым каждый заводчик метит свою лошадь; подобно фамильному гербу, он переходит из рода в род и лишь в редких случаях изменяется.",
                                "translation": "Une marque est un signe avec lequel tout éleveur marque son cheval ; tel un blason familial, il se transmet de génération en génération et ne change que rarement."
                            }
                        ]
                    },
                    {
                        "sense_id": "70b42252-158b-3ddc-8b56-232d36e37274",
                        "entry_id": "be817473-080d-3da0-8aa6-02f05ef51c4b",
                        "glosses": [
                            "Marque d’infamie pour identifier les criminels."
                        ],
