                        "examples": [
                            {
                                "example_id": "a82b71ad-e20d-4508-9c4c-130797a0712b",
                                "sense_id": "0cb85e9e-dd22-3381-9035-756e4d713f6f",
                                "text": "UFOs are reported as being either oblate (saucer-shaped) or prolate (cigar-shaped) spheroids."
                            }
                        ]
