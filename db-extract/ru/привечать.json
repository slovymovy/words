                            {
                                "example_id": "df4f4c4e-4878-4065-8e54-352c364e05b3",
                                "sense_id": "6c65287e-684e-3ae0-8899-67e1f84d6c4a",
                                "text": "Шибко за те песенки стали женщины привечать Данилушку"
                            }
                        ]
                    },
                    {
                        "sense_id": "46539fed-d983-3e3a-be72-b690367b8069",
                        "entry_id": "a8253145-b7f3-3cca-a578-c87633d97773",
                        "glosses": [
                            "разг. давать приют у себя кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a51828-6034-4cfd-bad8-1eabd33f283a",
                                "sense_id": "46539fed-d983-3e3a-be72-b690367b8069",
                                "text": "Фаны \"Монако\" – те оживились пуще всего даже не в моменты голов, а когда на поле вышел... Траоре. Слышали бы вы этот свист! А ведь вроде свой игрок. Вот кого ЦСКА теперь вынужден привечать."
                            }
                        ]
                    },
