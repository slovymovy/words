    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "102f3dd0-fcbc-3746-806b-a225fa01d6eb",
                    "sense_definition": "Rendre trouble, altérer la netteté d'une image, de la vue ou perturber la réception d'un signal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie battante sur le pare-brise a commencé à <w>brouiller</w> la vue du conducteur.",
                            "target_lang_translations": {
                                "en": "The driving rain on the windscreen began to <w>blur</w> the driver's vision.",
                                "ru": "Проливной дождь на лобовом стекле начал <w>затуманивать</w> зрение водителя.",
                                "de": "Der strömende Regen auf der Windschutzscheibe begann, die Sicht des Fahrers zu <w>trüben</w>.",
                                "es": "La lluvia torrencial sobre el parabrisas empezó a <w>nublar</w> la vista del conductor.",
                                "zh": "瓢泼大雨打在挡风玻璃上，开始<w>模糊</w>了司机的视线。"
                            }
                        },
                        {
                            "text": "Les orages violents peuvent <w>brouiller</w> la réception des chaînes de télévision.",
                            "target_lang_translations": {
                                "en": "Violent storms can <w>jam</w> the reception of television channels.",
                                "ru": "Сильные грозы могут <w>глушить</w> приём телевизионных каналов.",
                                "de": "Heftige Gewitter können den Empfang der Fernsehsender <w>stören</w>.",
                                "es": "Las tormentas fuertes pueden <w>interferir</w> en la recepción de los canales de televisión.",
                                "zh": "强烈的雷暴天气可能会<w>干扰</w>电视频道的信号接收。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obscurcir",
                        "troubler"
                    ],
                    "antonyms": [
                        "éclaircir"
                    ],
                    "common_phrases": [
                        "brouiller la vue",
                        "brouiller les pistes"
                    ],
                    "target_lang_definitions": {
                        "en": "To make an image, sight or signal unclear or difficult to receive.",
                        "ru": "Делать изображение, зрение или сигнал нечёткими либо затруднять их восприятие.",
                        "de": "Die Klarheit eines Bildes, der Sicht oder eines Signals beeinträchtigen.",
                        "es": "Hacer menos nítida una imagen o la vista, o dificultar la recepción de una señal.",
                        "zh": "使图像或视线变得模糊不清，或干扰信号的正常接收。"
                    },
