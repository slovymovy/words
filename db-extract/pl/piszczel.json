                                        "entry_id": "9b540117-9617-3545-b78e-82a44b147517",
                                        "glosses": [
                                            "The inner and usually the larger of the two bones of the leg or hind limb below the knee, the shinbone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37af3ca-91a4-427c-b8bf-48566aa2298d",
                                                "sense_id": "5546a0ca-3b7e-3775-a507-59651a85b925",
                                                "text": "Her anterior cruciate ligament (ACL) and medial collateral ligament (MCL) are torn and Vonn has a lateral fracture of the tibial plateau, the upper end of the tibia or shin bone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9da8a236-418a-3f44-bc43-46a2e8046dfa",
                                        "entry_id": "9b540117-9617-3545-b78e-82a44b147517",
                                        "glosses": [
                                            "The second segment from the end of an insect's leg, between the femur and tarsus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb57f1a3-da74-3d91-b9d6-e2a041947099",
                                        "entry_id": "9b540117-9617-3545-b78e-82a44b147517",
                                        "glosses": [
                                            "The third segment from the end of an arachnid's leg, between the patella and metatarsus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c9b834e-5d47-3d5f-b8e2-a99127188802",
                                        "entry_id": "9b540117-9617-3545-b78e-82a44b147517",
                                        "glosses": [
                                            "A musical instrument of the flute kind, originally made of the leg bone of an animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
