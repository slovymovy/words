                                    {
                                        "sense_id": "0913cf41-f90e-3816-bdc7-cfc55e20d11f",
                                        "entry_id": "bbc130ee-4512-36bf-9447-f9e78dbe364d",
                                        "glosses": [
                                            "fiependes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3f8feb-0f03-4bd1-ae75-9c96fcf85f6a",
                                                "sense_id": "0913cf41-f90e-3816-bdc7-cfc55e20d11f",
                                                "text": "„Seine Rede wird langsamer, akzentuiert vom matten Fiepen der Tasten seines Handys.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
