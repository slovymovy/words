                        "glosses": [
                            "Qui peut être conquis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1198512-d12b-4e50-8105-0c9b052f80b3",
                                "sense_id": "5cff0a23-4b7c-3ba1-97fb-ce7217eb40cf",
                                "text": "Cette stratégie pour un Internet propriétaire est le fait des multinationales de la télécommunication. Elles perçoivent l’Internet comme une véritable terra nullius, à conquérir et conquérable."
                            },
                            {
                                "example_id": "d19a7e70-8cf7-4f09-9126-f17a57fb1799",
                                "sense_id": "5cff0a23-4b7c-3ba1-97fb-ce7217eb40cf",
                                "text": "À la vision apocalyptique s’oppose l’éclatante image messianique du salut de l’humanité, d’un salut conquérable et reconquérable."
                            },
                            {
                                "example_id": "7cd4b03b-6489-4912-97fd-48ee89af08e3",
                                "sense_id": "5cff0a23-4b7c-3ba1-97fb-ce7217eb40cf",
                                "text": "Je suis facilement conquérable. Il suffit d’un sourire, d’une fossette, d’une mèche de cheveux, de n’importe quoi, en fait."
                            }
                        ]
                    }
