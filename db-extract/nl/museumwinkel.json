                    {
                        "sense_id": "ae2cad77-8f84-3446-b95c-f5247809dda5",
                        "entry_id": "75c1cb40-2d87-3afe-bfd7-3cc654f641c2",
                        "glosses": [
                            "winkel waar men souveniers kan kopen die een relatie hebben met de in het museum tentoongestelde zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce9a4a9f-f243-47b2-bea0-3565b6dcbabd",
                                "sense_id": "ae2cad77-8f84-3446-b95c-f5247809dda5",
                                "text": "In het nieuwe gedeelte van het museum komen de tentoonstellingsruimte, het museumcafé en de museumwinkel. Ook de educatieve werkplaats, een bibliotheek en een evenementenzaal komen daar straks terecht."
                            },
                            {
                                "example_id": "90fdfcec-0df9-43e8-bc4f-6059741b7ccb",
                                "sense_id": "ae2cad77-8f84-3446-b95c-f5247809dda5",
                                "text": "In het nieuwe Filmmuseum komen vier filmzalen, een bibliotheek, een studiecentrum, een café-restaurant, een museumwinkel en kantoren voor medewerkers. Het gebouw komt te staan in de nieuwe wijk Overhoeks. Samen met de toren van Overhoeks wordt het nieuwe museum beeldbepalend voor de wijk. Het nieuwe Filmmuseum wil binnen drie jaar na opening jaarlijks 225.000 bezoekers trekken."
                            }
                        ]
                    }
