        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2870725a-54bc-39c8-9fe7-f3b09bb3c099",
                "word": "Lyra",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f166f8c1-fe35-376c-8ef7-a2bd02ba7492",
                        "entry_id": "2870725a-54bc-39c8-9fe7-f3b09bb3c099",
                        "glosses": [
                            "A summer constellation of the northern sky, said to resemble a lyre. It includes the bright star Vega and the Ring Nebula."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "44428b18-3e2c-3c5d-b36e-a7dd2dad9fae",
                        "entry_id": "2870725a-54bc-39c8-9fe7-f3b09bb3c099",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8dbacd0d-688c-4ef0-88a4-b3b38aa306e5",
                                "sense_id": "44428b18-3e2c-3c5d-b36e-a7dd2dad9fae",
                                "text": "A little parapet ran all the way around the square roof, and Pantalaimon often draped his pine-marten form over the mock-battlements on the corner facing south, and dozed while Lyra sat below with her back against the sun-drenched stone, studying the books she'd brought up with her."
                            }
                        ]
                    }
                ],
