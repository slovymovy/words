                        "entry_id": "10a23911-dfe7-3936-9486-d1c04311c372",
                        "glosses": [
                            "Clameur lancée par une personne qui gueule."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "08a5027f-ed0e-4c6b-b05e-93828942cd45",
                                "sense_id": "bad2bd68-1e5a-3f5d-bc18-25d9d9c0b895",
                                "text": "— En silence !\nIl sembla pourtant, à cette recommandation, que les gueulements redoublaient."
                            },
                            {
                                "example_id": "0286b81a-3797-4cdc-a929-dfba90178bee",
                                "sense_id": "bad2bd68-1e5a-3f5d-bc18-25d9d9c0b895",
                                "text": "Un gueulement se fit entendre dans le pénitencier."
                            },
                            {
                                "example_id": "04673ac4-e5f1-4ed7-b336-794509873202",
                                "sense_id": "bad2bd68-1e5a-3f5d-bc18-25d9d9c0b895",
                                "text": "Nous poussions le grand épouvantable gueulement de l’homme-singe en dévalant l’escalier, à vous figer le sang, les canaris dans leurs cages étranglaient net leur chant…"
                            }
                        ]
                    }
