                            {
                                "example_id": "46beee9f-c4a5-4337-8889-726731903429",
                                "sense_id": "18dc785f-93d6-3c36-929f-89f6b115695c",
                                "text": "Zachowywał się aspołecznie i nie brał udziału w zebraniach."
