                        "glosses": [
                            "Pagayeuse qui pratique le kayak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3757e2a-271c-4158-a3a9-7ea6cd8c625e",
                                "sense_id": "28ae6111-6ba5-38ef-af59-b33811eeebd5",
                                "text": "Tout comme une kayakeuse se ferait emporter si elle pagayait contre le courant à une vitesse inférieure à celle du courant lui-même, le combat de la lumière émise par une galaxie qui nous fuit à une vitesse superluminique est perdu d’avance : elle ne nous atteindra jamais."
                            }
                        ]
                    }
                ],
