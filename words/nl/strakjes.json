                {
                    "sense_id": "d1dad22f-1205-3a18-92e9-150871b374c7",
                    "sense_definition": "Over een korte tijd; binnenkort of later op de dag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zullen <w>strakjes</w> eten, nog even geduld!",
                            "target_lang_translations": {
                                "en": "We will eat <w>later</w>, just a little patience!"
                            }
                        },
                        {
                            "text": "Ik kom <w>strakjes</w> bij je langs om het boek te brengen.",
                            "target_lang_translations": {
                                "en": "I will drop by <w>in a bit</w> to bring you the book."
                            }
                        }
                    ],
                    "synonyms": [
                        "straks"
                    ],
                    "common_phrases": [
                        "tot strakjes",
                        "strakjes bellen"
                    ],
                    "traits": [
