                                    {
                                        "sense_id": "447db243-63cf-3a06-ae06-bf16866e11d0",
                                        "entry_id": "5492600d-073f-36c6-90ce-303de380d759",
                                        "glosses": [
                                            "Prénom féminin français, italien ou anglais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49ed439-5d23-4645-8c7e-89a605b515ca",
                                                "sense_id": "447db243-63cf-3a06-ae06-bf16866e11d0",
                                                "text": "Angela, Angela\n Tu me colles à ta peau\n J'ai ton nom tatoué\n Tout autour de mes ailes."
                                            },
                                            {
                                                "example_id": "f5617ba7-52a8-40b6-b753-384f02f257b0",
                                                "sense_id": "447db243-63cf-3a06-ae06-bf16866e11d0",
                                                "text": "Angela Kogan, une chirurgienne esthétique, a affirmé, photo à l’appui, dans un article écrit pour Shade Room, et supprimé depuis, que 50 Cent a fait partie de ses clients ayant sollicité ses services pour augmenter la taille de leur pénis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
