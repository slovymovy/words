                ],
                "senses": [
                    {
                        "sense_id": "f7202fac-0f44-3978-ab99-9f766ac815ca",
                        "entry_id": "ad384342-89d5-3191-903d-a89c48be51f0",
                        "glosses": [
                            "Zeltlager im Rahmen von Freizeitaktivitäten oder während der Ferien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c8f8e54-573f-48ef-9cf7-991bb82aaea5",
                                "sense_id": "f7202fac-0f44-3978-ab99-9f766ac815ca",
                                "text": "„Auch die Einstellung neuer Lehrkräfte, Anschaffung von Unterrichtsmaterialien und der Zugang zu sauberem Trinkwasser werden gefördert. Seit acht Jahren führt Berlitz Sprachcamps durch. Kinder und Jugendliche lernen mit Spaß und System Englisch, Französisch und Spanisch. Im Camp gibt es zudem viele spannende Freizeit- und Sportaktivitäten. \"In vielen Ländern sind Schulen und Unterricht leider keine Selbstverständlichkeit\", sagt Günther Bedson, Direktor von Berlitz Kids in Deutschland, \"daher möchten wir uns in diesem Bereich engagieren.“"
                            },
                            {
                                "example_id": "b9f04b7e-e0c9-4d6c-a491-99b579296690",
                                "sense_id": "f7202fac-0f44-3978-ab99-9f766ac815ca",
                                "text": "„Doch ich war mir sicher, dass ich in diesem komfortablen, luxuriösen Camp die Dämmerung und den Anbruch der Nacht voll und ganz würde auskosten können.“"
                            },
                            {
                                "example_id": "05db64ad-81e8-48d0-a9ee-d82f32d73fed",
                                "sense_id": "f7202fac-0f44-3978-ab99-9f766ac815ca",
                                "text": "„Bei Sonnenuntergang kamen die ersten Rallyefahrer zurück ins Camp, müde und staubbedeckt, aber auch aufgedreht nach einem Tag in der Wüste.“"
                            },
                            {
                                "example_id": "41b05b8d-4990-4cf7-b826-e59d2f786fc1",
                                "sense_id": "f7202fac-0f44-3978-ab99-9f766ac815ca",
                                "text": "„Der Regenschauer wurde von einem heftigen Wind begleitet, der an Zeltleinen zerrte und Kleidungsstücke, Rennkarten und Klopapierfetzen durch das Camp wirbelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3dca5ae-309e-3195-88b8-2598ae9dc331",
                        "entry_id": "ad384342-89d5-3191-903d-a89c48be51f0",
                        "glosses": [
                            "Lager im Freien, in dem Personen (Flüchtlinge, Gefangene oder dergleichen) provisorisch untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "145d5eee-bd0a-4020-86be-4c8f80af103c",
                                "sense_id": "a3dca5ae-309e-3195-88b8-2598ae9dc331",
                                "text": "„Ihr Camp lag flussabwärts, nicht weit von Kouroussa.“"
                            },
                            {
                                "example_id": "d74a64cc-b176-4261-ae4b-949a7070f1f7",
                                "sense_id": "a3dca5ae-309e-3195-88b8-2598ae9dc331",
                                "text": "„Am Camp ist nicht viel dran.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
