                                        "entry_id": "fb80ee9e-f350-39dd-beca-9699d0ab6944",
                                        "glosses": [
                                            "One who is stingy; someone overly cautious or defensive with money."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839d962d-aa68-45ef-a43e-392f84e91adf",
                                                "sense_id": "6b6889a6-b362-3a11-bea9-d40ac4753be3",
                                                "text": "That tightwad would drive ten miles to save a few cents on gas."
                                            },
                                            {
                                                "example_id": "814670e3-c73a-49f8-9e87-e5e2f918f641",
                                                "sense_id": "6b6889a6-b362-3a11-bea9-d40ac4753be3",
                                                "text": "He gulps down the hot coffee and leaves a nice fat tip. No one can say he's a tightwad."
                                            }
                                        ]
