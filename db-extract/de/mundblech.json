                "senses": [
                    {
                        "sense_id": "43bc4314-9187-3e59-8828-aa008ab15285",
                        "entry_id": "2597d79d-8b58-347a-866c-c057bfdc401c",
                        "glosses": [
                            "verstärkter Bestandteil am Mundstück einer Scheide zum leichteren Einführen einer Waffe"
                        ],
                        "tags": [
                            "bei Blankwaffen"
                        ],
                        "examples": [
                            {
                                "example_id": "916b84ef-5485-42e4-8f82-ac8fe1823000",
                                "sense_id": "43bc4314-9187-3e59-8828-aa008ab15285",
                                "text": "„Im Jahre 1992 kam das bronzene Mundblech einer Schwertscheide aus dem Boden.“"
                            },
                            {
                                "example_id": "f6e03e3a-ca20-4778-9b11-9ba39ed5e72e",
                                "sense_id": "43bc4314-9187-3e59-8828-aa008ab15285",
                                "text": "„Das Mundblech trägt eine Besitzer-Ritzinschrift mit der Abkürzung LPA. Die Inschrift kann als L(egio) P(rima) A(ugusta) gelesen werden.“"
                            },
                            {
                                "example_id": "f6fa0965-dbf9-446b-b095-d45187253998",
                                "sense_id": "43bc4314-9187-3e59-8828-aa008ab15285",
                                "text": "„Die Ornamentik ist mit ebenso feinen oder noch feineren Filigrandrähten versehen wie das zweite Mundblech.“"
                            },
                            {
                                "example_id": "9588383d-8978-4921-96c7-bb734be2f23c",
                                "sense_id": "43bc4314-9187-3e59-8828-aa008ab15285",
                                "text": "„Sämmtliche [sic!] lederne Scheiden erhalten auf der inneren Seite 2 Zoll unter dem Mundblech Stempel wie bei A. Die Mundbleche und Ortbänder erhalten auf der inneren Seite den Stempel des Revisors und Krone.“"
                            },
                            {
                                "example_id": "2a19ade4-5a11-4393-b73d-d5927038586c",
                                "sense_id": "43bc4314-9187-3e59-8828-aa008ab15285",
                                "text": "„Werden einzelne kleine Theile, als Griff, Mundblech, Schlepper etc. von der Truppe bezogen, so erhalten sie den Stempel des Revisors mit der Krone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
