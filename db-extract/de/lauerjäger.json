                "senses": [
                    {
                        "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                        "entry_id": "c251e1e6-b4e8-3317-b290-01a8f3bbb9fa",
                        "glosses": [
                            "fleischfressendes Lebewesen, das oft regungslos, meist getarnt Beutetieren auflauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a5136a1-ff79-4f10-a99a-e4920341b212",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Demnach haben Lauerjäger wie Katzen oder Geckos eher vertikale Pupillen, pflanzenfressende Beutetiere dagegen meistens horizontale, schreibt das Team um Martin Banks von der University of California in Berkeley in der Zeitschrift \"Science Advances\"."
                            },
                            {
                                "example_id": "fe7b0c58-eed6-468d-9228-eb0065aaa5c2",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Für tag- und nachtaktive Lauerjäger wie die Katze ist es wichtig, die Entfernung zur Beute abzuschätzen, ohne den Kopf zu bewegen."
                            },
                            {
                                "example_id": "e14e9a6a-a533-441c-aa1b-976fd9fb8789",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Krabbenspinnen bauen keine Fangnetze, sondern warten als sogenannte Lauerjäger auf Beute."
                            },
                            {
                                "example_id": "63f564f9-0de0-48ea-9823-d473ef952298",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Dieses Kunststück gelingt ihm (dem Pantherchamäleon), weil es seine grossen Augen unabhängig voneinander bewegen kann, was ihm als Lauerjäger beim Insektenfang zugute kommt."
                            },
                            {
                                "example_id": "86b5f291-1bec-45ae-afcd-69c2b4336d78",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Boas sind nachtaktive Lauerjäger, die zwar nicht giftig sind, aber ihre Beute zu Tode würgen."
                            },
                            {
                                "example_id": "d0a07adc-d895-4ba0-8efe-4028d8d6c5ff",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Da Puffottern als Lauerjäger manchmal wochenlang reglos am selben Fleck verharren, ist Unauffälligkeit auch dringend geboten."
                            },
                            {
                                "example_id": "bba3134c-05b2-454f-a091-dc0ff2e00393",
                                "sense_id": "ae75ed7b-5682-3c94-85a0-b331da77a8ac",
                                "text": "Würgeschlangen sind meist Ansitzjäger bzw. Lauerjäger, das heißt, sie suchen nicht nach Beute, sondern warten bis die Beute nahe herankommt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
