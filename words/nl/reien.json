                },
                {
                    "sense_id": "f8d0dd48-e1d7-35a6-8342-e46f2d3dfcb3",
                    "sense_definition": "stevig vastbinden of aanhalen met een touw",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De matrozen moesten het spul goed <w>reien</w> voor de storm uitbrak.",
                            "target_lang_translations": {
                                "fr": "Les matelots ont dû bien <w>amarrer</w> le matériel avant que la tempête n'éclate."
                            }
                        },
                        {
                            "text": "Hij hielp om de lading op de wagen strak te <w>reien</w>.",
                            "target_lang_translations": {
