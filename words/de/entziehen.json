{
    "word_family": [
        "Entzug",
        "Entziehung",
        "entziehbar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78d78c31-a34d-3a4c-b8c3-7d04a60dfeda",
                    "sense_definition": "jemandem ein Recht, eine Erlaubnis oder das Vertrauen aberkennen und nicht länger gewähren",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "aberkennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Behörde wird dem rücksichtslosen Fahrer den Führerschein <w>entziehen</w>."
                        },
                        {
                            "text": "Nach dem schweren Betrug <w>entzog</w> der Vorstand der Geschäftsführung das Vertrauen."
                        }
                    ],
                    "synonyms": [
                        "wegnehmen",
                        "fortnehmen"
                    ],
                    "common_phrases": [
                        "den Führerschein entziehen",
                        "das Vertrauen entziehen"
                    ]
                },
                {
                    "sense_id": "a8275eba-b30e-370d-b542-39c8452b1445",
                    "sense_definition": "sich einer Pflicht, Verantwortung oder Kontrolle bewusst nicht stellen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er versucht seit Wochen, sich der Verantwortung für das Scheitern zu <w>entziehen</w>."
                        },
                        {
                            "text": "Niemand kann sich den rechtlichen Konsequenzen dieser Straftat dauerhaft <w>entziehen</w>."
                        }
                    ],
                    "synonyms": [
                        "ausweichen"
                    ],
                    "common_phrases": [
                        "sich der Verantwortung entziehen"
                    ]
                },
                {
                    "sense_id": "68dd44dc-285b-3cec-89fd-2105d646b6f5",
                    "sense_definition": "einem Organismus oder Stoff einen Bestandteil wie Wasser oder Wärme entfernen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "extrahieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Übermäßiger Konsum von Alkohol <w>entzieht</w> dem menschlichen Körper lebenswichtiges Wasser."
                        },
                        {
                            "text": "Bei der Trocknung von Lebensmitteln <w>entzieht</w> man ihnen die meiste Feuchtigkeit."
                        }
                    ],
                    "synonyms": [
                        "herausziehen"
                    ],
                    "common_phrases": [
                        "dem Körper Wasser entziehen"
                    ]
                }
            ]
        }
    ]
