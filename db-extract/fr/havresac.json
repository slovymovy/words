        "fr-extract.jsonl": [
            {
                "entry_id": "cf954cb6-c46b-31a8-b4fa-52d45e595f03",
                "word": "havresac",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c87f393-1373-4f3d-a3d8-7a230d607f91",
                        "entry_id": "cf954cb6-c46b-31a8-b4fa-52d45e595f03",
                        "tags": [
                            "plural"
                        ],
                        "form": "havresacs"
                    },
                    {
                        "form_id": "aca57b07-acb5-43cb-b1a7-b16771148892",
                        "entry_id": "cf954cb6-c46b-31a8-b4fa-52d45e595f03",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\a.vʁə.sak\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5786db4-468a-322f-94b6-115d4c84c595",
                        "entry_id": "cf954cb6-c46b-31a8-b4fa-52d45e595f03",
                        "glosses": [
                            "Sac à dos dans lequel un fantassin enfermait les effets à son usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f1f057-7f02-4777-88a8-b7570bd33371",
                                "sense_id": "e5786db4-468a-322f-94b6-115d4c84c595",
                                "text": "Wentzel et Goubine revenaient des unités. Ils avaient encore leurs havresacs sur le dos, le visage rouge et animé."
                            },
                            {
                                "example_id": "60be4e56-d151-4d3e-9908-b5ecb57e5f08",
                                "sense_id": "e5786db4-468a-322f-94b6-115d4c84c595",
                                "text": "Dès le lendemain,en sortant de la banque, il commençait à les ramasser; il avait ressorti pour l'occasion son havresac de la guerre, il en aurait vu de belles, celui-là."
                            }
                        ]
                    },
                    {
                        "sense_id": "b902d67e-44f4-32b4-a162-3cda6194750b",
                        "entry_id": "cf954cb6-c46b-31a8-b4fa-52d45e595f03",
                        "glosses": [
                            "Sac à dos où les gens de métier, en courant le pays, mettent leurs provisions, leurs ustensiles, leurs outils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fd6915-8365-43cc-b2d8-4c66134bdfa8",
                                "sense_id": "b902d67e-44f4-32b4-a162-3cda6194750b",
                                "text": "[…], et on se munit en conséquence d'une certaine quantité de viande sèche, de biscuit et de quelques flacons de brandevin, qui ne chargerait pas trop le havresac des explorateurs."
                            },
                            {
                                "example_id": "c963d6d8-162e-46cb-b2a8-45dbe1598f81",
                                "sense_id": "b902d67e-44f4-32b4-a162-3cda6194750b",
                                "text": "Tiens, Nic Deck, le forestier, qui revient de sa tournée, le havresac au dos, le fusil sur l’épaule…"
                            },
                            {
                                "example_id": "1e5fde8a-eee3-4cc8-ab57-a1609a01a25f",
                                "sense_id": "b902d67e-44f4-32b4-a162-3cda6194750b",
                                "text": "Les barils posés sur les graviers de l’eau courante, et les havresacs sous les vestes parmi les roseaux, jusqu’à midi on travaillait sans rien dire."
                            },
                            {
                                "example_id": "8c9a556e-684b-4ad9-a854-57c144daf36d",
                                "sense_id": "b902d67e-44f4-32b4-a162-3cda6194750b",
                                "text": "Tout le monde se mit alors à l’ouvrage : Hans Aden grimpa l’échelle de la grange et jeta des bottes de paille par la lucarne, Mathéus déchargea Schimel et Bruno, dame Thérèse tira les provisions du hâvre-sac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "216a85f5-57a6-4858-b3b9-f639a5611a12",
                        "source_entry_id": "cf954cb6-c46b-31a8-b4fa-52d45e595f03",
                        "target_lang_word": "haversack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haversack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d819aa3-4130-326c-a592-237d9c5bc21b",
                                        "entry_id": "8a906d50-e5d2-3b9e-9c9d-e48bf41b20ee",
                                        "glosses": [
                                            "A small, strong bag carried on the back or the shoulder, usually with only one strap, and originally made of canvas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec1b657-a5bc-4b1e-b18f-479ab09a876d",
                                                "sense_id": "2d819aa3-4130-326c-a592-237d9c5bc21b",
                                                "text": "And most significant, these hordes of nonmotorized tourists, hungry for a taste of the difficult, the original, the real, do not consist solely of people young and athletic but also of old folks, fat folks, pale-faced office clerks who don’t know a rucksack from a haversack, and even children."
                                            },
                                            {
                                                "example_id": "ad757e28-8565-498a-a688-d61b737791f3",
                                                "sense_id": "2d819aa3-4130-326c-a592-237d9c5bc21b",
                                                "text": "When I went, I left from the station / With a haversack and some trepidation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c46949e-80bc-3d81-951d-bd6666c8c76d",
                                        "entry_id": "8a906d50-e5d2-3b9e-9c9d-e48bf41b20ee",
                                        "glosses": [
                                            "An oat-sack, or nosebag for a horse."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2a29d00-812c-4b87-b73f-a0346b7a42fd",
