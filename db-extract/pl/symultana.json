                "senses": [
                    {
                        "sense_id": "a99782e1-ed74-3aa7-8dbb-5c49a6ddecd6",
                        "entry_id": "f1620ae2-7b6d-3110-a305-fc2f7e764751",
                        "glosses": [
                            "simul, simultaneous exhibition"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "bd02182b-adb9-4747-a6c4-2fb46a39f813",
                                "sense_id": "a99782e1-ed74-3aa7-8dbb-5c49a6ddecd6",
                                "text": "Kiedyś ja i Henio Apostel graliśmy w symultanie z samym arcymistrzem Anatolijem Karpowem. A innym razem Hilary Nowak zorganizował w Warszawie turniej symultaniczny z mistrzynią Polski, Krystyną Dąbrowską.",
                                "translation": "Once me and Henio Apostel played in simultaneous exhibition with Grandmaster Anatoly Karpov himself. And another time in Warsaw, Hilary Nowak organized a simultaneous tournament with Polish a champion, Krystyna Dąbrowska.",
                                "english": "Once me and Henio Apostel played in simultaneous exhibition with Grandmaster Anatoly Karpov himself. And another time in Warsaw, Hilary Nowak organized a simultaneous tournament with Polish a champion, Krystyna Dąbrowska."
                            },
                            {
                                "example_id": "7aba7bb0-349b-4166-8269-973624d3166b",
                                "sense_id": "a99782e1-ed74-3aa7-8dbb-5c49a6ddecd6",
                                "text": "Kilka miesięcy później pojechałem do Hamburga, by wziąć udział w kilku wydarzeniach, między innymi w symultanie rozgrywanej z komputerami, i odwiedziłem także pana Friedla w jego podmiejskim domu.",
                                "translation": "A few months later, I traveled to Hamburg to take part in a few events, including the computer simul, and I also visited Mr. Friedel at his suburban home.",
                                "english": "A few months later, I traveled to Hamburg to take part in a few events, including the computer simul, and I also visited Mr. Friedel at his suburban home."
                            }
                        ]
                    }
                ],
