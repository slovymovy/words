                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vereeuwigen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "de66a3a6-3adb-31fb-a8e3-f1dca6378602",
                                        "entry_id": "0f43c466-b84e-3cc9-934f-b215c48a8b6b",
                                        "glosses": [
                                            "eeuwig laten worden, voor eeuwig laten vastleggen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b4b075-a44a-4c14-974c-62cbf3b30334",
                                                "sense_id": "de66a3a6-3adb-31fb-a8e3-f1dca6378602",
                                                "text": "Over de lengte van zijn benen waren de routes en emblemen van verschillende Thru-hikes vereeuwigd."
                                            },
                                            {
                                                "example_id": "5b4cc3e3-dc86-4251-a50b-25561cbe1c6f",
                                                "sense_id": "de66a3a6-3adb-31fb-a8e3-f1dca6378602",
                                                "text": "Het draagt allemaal bij aan de herleving van een roemruchte periode. Daar hoort ook de aparte expositie van fotograaf Rudy Leukfeldt bij, Blues from Heaven. Heel bijzonder hoe hij Muskee heeft vereeuwigd, als heerser van Drenthe, op een hunebed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
