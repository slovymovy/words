                                "target_senses": [
                                    {
                                        "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                        "entry_id": "a5015688-2b6f-3cab-87c9-5ddb78e24830",
                                        "glosses": [
                                            "A mound of earth, especially one placed over a prehistoric tomb; a barrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6714367-1008-4295-b7f9-3f26c5e71c95",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "They planted the cannon on the tumuli, sole elevations in this level country, and formed themselves into column and hollow square."
                                            },
                                            {
                                                "example_id": "de10fb13-0132-45cc-95fe-0cebb9279147",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "Near Smeinogorsk an octagonal tumulus has been found containing the corpse of a horse near a rectangular one with a human corpse, both within stone circles."
                                            },
                                            {
                                                "example_id": "6f94b876-29c9-427b-845d-0875d9a022cd",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "The delicate white body will be covered to-day,\nThe tumulus be reared, the green sod give way:\nAnd there, oh Cynvarch, thy son they will lay."
                                            },
                                            {
                                                "example_id": "4422d69b-30c3-45d3-beaf-8b8a75fd742a",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "The tumulus is one of mankind's oldest burial monuments, dating back to 4,000 to 5,000 years B.C. […] Examples of tumuli can be seen peppering the landscape all over Western Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6513db2-eb09-447b-a555-0a1d2d5d06ff",
                        "source_entry_id": "ceebddc6-313c-3f12-ae66-0f7d69d394ae",
                        "source_sense_id": "109c81f9-60c5-301a-befb-0674e1016ece",
                        "target_lang_word": "tumulus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumulus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e33ae554-ee21-3653-abb7-a5d38c89c8a6",
                                        "entry_id": "0f498ba2-57ec-3642-b1ab-e7234658c865",
                                        "glosses": [
                                            "Amas de terre ou de pierre, en forme de cône ou de pyramide, que les anciens élevaient au-dessus des sépultures pour servir de tombeau."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6818b3a8-8b7a-4978-953e-5b635b78cf00",
                                                "sense_id": "e33ae554-ee21-3653-abb7-a5d38c89c8a6",
                                                "text": "Au pied du cap je distinguais deux tumulus, les tombeaux d’Achille et de Patrocle."
                                            },
                                            {
                                                "example_id": "5b75b193-30cc-4304-8c34-8162ff6017ae",
                                                "sense_id": "e33ae554-ee21-3653-abb7-a5d38c89c8a6",
                                                "text": "Ce sont des tertres, des tumulus, au volume très variable, pouvant aller du petit amas de terre qui se distingue à peine du sol jusqu'au monument haut de trente mètres et plus, et couvrant des dizaines d'hectares de superficie."
                                            },
                                            {
                                                "example_id": "4029aeea-5e3d-44a5-9af8-70a42c4cc3ef",
                                                "sense_id": "e33ae554-ee21-3653-abb7-a5d38c89c8a6",
                                                "text": "L'aspect actuel d'un monument mégalithique se dressant sur un monticule a donné à Schumacher et Karge la fausse impression que les dolmens furent construits au-dessus des tumulus."
                                            },
                                            {
                                                "example_id": "f87ca64c-e502-413a-80e7-4012b15b96f4",
                                                "sense_id": "e33ae554-ee21-3653-abb7-a5d38c89c8a6",
                                                "text": "Les tombes plates et les tumulus de Pact, Voreppe, Rives, Vernas, Optevoz et Mépieu, le casque des Avenières, l'oppidum de Larina (Hières-sur-Amby) témoignent de cette pénétration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c791883-fb1e-3701-a547-db37ab63d1bd",
                                        "entry_id": "0f498ba2-57ec-3642-b1ab-e7234658c865",
                                        "glosses": [
                                            "Meuble représentant l’édifice du même nom dans les armoiries. À rapprocher de pyramide."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a707341b-7b67-43c7-982a-018690dec17e",
                                                "sense_id": "1c791883-fb1e-3701-a547-db37ab63d1bd",
                                                "text": "De gueules au tumulus d’or maçonné de sable, cantonné de quatre tours aussi d’or maçonnées de sable, qui est de la commune de Bougon des Deux-Sèvres → voir illustration « armoiries avec un tumulus »"
                                            }
                                        ]
                                    },
