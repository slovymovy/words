                ],
                "senses": [
                    {
                        "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                        "entry_id": "ab373471-8e35-3254-b227-d8dcfda8a78d",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ac9a62-a2fe-48b5-8be1-2b00a9343385",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Frau Dehnke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3d39abeb-b36f-4e0d-8dd2-c4b5ada48c05",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Herr Dehnke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "061ec93d-e2a0-45b4-85b1-7897ca4b39b1",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Die Dehnkes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3822fc43-23d3-4eee-b6f5-acd375b08721",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Der Dehnke trägt nie die Schals, die die Dehnke ihm strickt."
                            },
                            {
                                "example_id": "036887c0-d2c1-4e3d-a965-e8acf3ad70db",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dehnke kommt, geht der Herr Dehnke.“"
                            },
                            {
                                "example_id": "16e2bcfc-fabb-4445-af78-92c8591fa424",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Dehnke kommt und geht."
                            },
                            {
                                "example_id": "5397917c-984d-4407-9392-d5addfb9d867",
                                "sense_id": "796e921c-15ca-33a3-83d4-d91f9a301026",
                                "text": "Dehnkes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
