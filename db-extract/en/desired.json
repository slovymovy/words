                                        "examples": [
                                            {
                                                "example_id": "33b16739-d75a-4aaa-ae34-57daec6949f9",
                                                "sense_id": "554788e4-b1b0-382a-8566-4c954b5b4de5",
                                                "text": "Die Bundesregierung lehnt die von der Stadt Hamburg gewünschte Kostenbeteiligung für die Ausrichtung Olympischer Spiele 2024 offenbar ab."
                                            },
                                            {
                                                "example_id": "236acf2e-0c7d-43f5-a335-3c8f8c1d15d8",
                                                "sense_id": "554788e4-b1b0-382a-8566-4c954b5b4de5",
                                                "text": "Andere Nachteile: Bei zu kurzfristiger Buchung kann das gewünschte Auto am gewünschten Standort nicht verfügbar sein."
                                            },
                                            {
                                                "example_id": "8d51c043-c9bc-4ac0-a603-c54fd0121fef",
                                                "sense_id": "554788e4-b1b0-382a-8566-4c954b5b4de5",
                                                "text": "Im Wirtschaftskreislauf ist das ein ganz normaler und allgemein akzeptierter, ja sogar gewünschter Vorgang."
                                            },
                                            {
                                                "example_id": "de2e7f05-33c4-4394-8776-4382d9ef1ded",
                                                "sense_id": "554788e4-b1b0-382a-8566-4c954b5b4de5",
                                                "text": "Die Wissenschaftler befragten die Bewohner zu Lüftungsverhalten, gewünschter Raumtemperatur, Einstellungen und auch Emotionen bezüglich der neuen Technik."
                                            },
                                            {
                                                "example_id": "dd9b19ed-08f9-4901-8e84-2032506b77be",
                                                "sense_id": "554788e4-b1b0-382a-8566-4c954b5b4de5",
                                                "text": "Ein gewünschtes und geliebtes Kind zu sein, ist der beste Garant für körperliche und seelische Gesundheit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
