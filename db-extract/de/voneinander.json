        "de-extract.jsonl": [
            {
                "entry_id": "d371dbe0-34c5-30eb-9324-7430391051ef",
                "word": "voneinander",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bcab6bbc-9579-3015-8542-4f42a12139ce",
                        "entry_id": "d371dbe0-34c5-30eb-9324-7430391051ef",
                        "glosses": [
                            "einer oder eines vom anderen"
                        ],
                        "tags": [
                            "gegenseitigen Bezug ausdrückend"
                        ],
                        "examples": [
                            {
                                "example_id": "99ea704d-2c3f-4aee-9f95-4ca12068310f",
                                "sense_id": "bcab6bbc-9579-3015-8542-4f42a12139ce",
                                "text": "Alte und junge Menschen können viel voneinander lernen."
                            },
                            {
                                "example_id": "7e29ba28-dc89-4ac8-8f3c-9d00740fceb0",
                                "sense_id": "bcab6bbc-9579-3015-8542-4f42a12139ce",
                                "text": "„Ich habe plötzlich an mir in jeder Hinsicht gezweifelt, an meiner Fähigkeit, Entscheidungen zu treffen, Gut und Böse voneinander zu unterscheiden, Unrecht von Recht.“"
                            },
                            {
                                "example_id": "e2885a61-a260-44ed-9e18-788f11f259e3",
                                "sense_id": "bcab6bbc-9579-3015-8542-4f42a12139ce",
                                "text": "„In einer Zeit, da ein Mittelklassewagen wie der andere aussieht und sich auch moderne Verkehrsflugzeuge im Design nur unwesentlich voneinander unterscheiden, ist der Airbus A 380 eben ein besonderes Fluggerät.“"
                            },
                            {
                                "example_id": "c541f71a-d63d-452e-94d7-792daaf8c116",
                                "sense_id": "bcab6bbc-9579-3015-8542-4f42a12139ce",
                                "text": "„Wahrscheinlich hat sich Eusozialität innerhalb der Hautflügler nicht weniger als elfmal unabhängig voneinander entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
