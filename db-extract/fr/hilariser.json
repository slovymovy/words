                "senses": [
                    {
                        "sense_id": "4fb0a8d7-b520-37a0-a42c-2ee7f5de2287",
                        "entry_id": "1a315557-bef0-38c7-9a1c-1704d529e968",
                        "glosses": [
                            "Rendre hilare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2722dfdd-dd0a-4e97-9aee-cab9243b466a",
                                "sense_id": "4fb0a8d7-b520-37a0-a42c-2ee7f5de2287",
                                "text": "Je ne pourrais pas vous hilariser avec une bêtise quelconque, même le chauffe-eau a daigné reprendre du service sans intervention"
                            },
                            {
                                "example_id": "9bfa753f-08e9-40bc-b922-1a43a6ce14f6",
                                "sense_id": "4fb0a8d7-b520-37a0-a42c-2ee7f5de2287",
                                "text": "Et surtout, un tumblr de maboule que j'ai découvert ya un moment, et qui ne cesse de m'hilariser."
                            },
                            {
                                "example_id": "a0e57471-0fb1-423f-b73d-f55cac930c6e",
                                "sense_id": "4fb0a8d7-b520-37a0-a42c-2ee7f5de2287",
                                "text": "Et juste avant de s'hilariser avec des substances chimiques de type THC, il est possible de découvrir les textes des paroles de chansons."
                            }
                        ]
                    }
