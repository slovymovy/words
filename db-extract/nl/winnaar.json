                                        "examples": [
                                            {
                                                "example_id": "5efd4cdd-9665-4e0d-8138-83418fbfd911",
                                                "sense_id": "06a3b94d-8674-3c0c-af9a-6592fef56141",
                                                "text": "Ein Gewinner hat gut Lachen."
                                            },
                                            {
                                                "example_id": "bcca1066-588f-4131-9ce8-3f421d88ecb1",
                                                "sense_id": "06a3b94d-8674-3c0c-af9a-6592fef56141",
                                                "text": "Die Vorsitzende des Sportvereins überreichte den Gewinnern der Leichtathletikwettbewerbe ihre Pokale."
