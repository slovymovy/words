                                        "sense_id": "090f8331-0edc-32a1-8025-562cd708a97f",
                                        "entry_id": "3fe37d22-6697-3e61-8b24-5f5db55dbc77",
                                        "glosses": [
                                            "Fruit déhiscent constitué par une capsule plus ou moins longue, formée de deux parties unies par des sutures longitudinales où les semences sont attachées, et divisée en deux loges par une cloison membraneuse ; il a quatre fentes de déhiscence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80143069-3139-4689-b03d-a5de9e94e597",
                                                "sense_id": "090f8331-0edc-32a1-8025-562cd708a97f",
                                                "text": "Dans les péricarpes secs, le plus commun est la capsule, dont la boîte est d'une forme et d'une capacité très variable ; elle est elliptique, ou orbiculaire, ou en croissant, ou bien elle offre la forme d'une silique, comme la grande chélidoine."
                                            },
                                            {
                                                "example_id": "deaae756-34ac-4a79-a6cc-45805ce983c3",
                                                "sense_id": "090f8331-0edc-32a1-8025-562cd708a97f",
                                                "text": "Le chou porte des siliques. — Les fruits des crucifères sont des siliques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27cf73d-054e-34fe-a1b6-0eb7a6e044d1",
                                        "entry_id": "3fe37d22-6697-3e61-8b24-5f5db55dbc77",
                                        "glosses": [
                                            "Ancienne monnaie d'argent en usage dans le monde romain à partir du IV ^(ème) siècle."
                                        ],
