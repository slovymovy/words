                                            {
                                                "example_id": "f1d8bf4c-7676-4a69-ba4f-9793cf37d68a",
                                                "sense_id": "eceaf3c6-f613-32fc-a9f2-006524d9c2fd",
                                                "text": "Opérer avec le trépan."
