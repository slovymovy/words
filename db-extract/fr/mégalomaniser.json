                ],
                "senses": [
                    {
                        "sense_id": "a90548e1-bc27-3b8a-9991-0a7bf67f3909",
                        "entry_id": "65c279c3-b6e1-3593-b5e5-d8650a27d089",
                        "glosses": [
                            "Donner un caractère mégalomane à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c6f523f-d80f-46d6-b716-c565118a8c72",
                                "sense_id": "a90548e1-bc27-3b8a-9991-0a7bf67f3909",
                                "text": "Les premiers témoignanes devraient être le plus précis possibles avant que l’importance du crime et ses répercussions n’altèrent les mémoires ou ne les fassent se mégalomaniser."
                            },
                            {
                                "example_id": "01f152a4-fd3e-4fe1-ab65-f6f93ce646ee",
                                "sense_id": "a90548e1-bc27-3b8a-9991-0a7bf67f3909",
                                "text": "Mon Dieu, notre Dieu du mal Hiddles serait-il en train de se mégalomaniser ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "678bbbe8-7d44-3e93-9635-76f9982429d3",
                        "entry_id": "65c279c3-b6e1-3593-b5e5-d8650a27d089",
                        "glosses": [
                            "Se comporter de façon mégalomane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89eb6cd5-1461-4a5c-b263-98b48e29e498",
                                "sense_id": "678bbbe8-7d44-3e93-9635-76f9982429d3",
                                "text": "Je les fréquente. Je les hante. Cela plagie, cela copie. Cela mégalomanise, cela mythomanise."
                            },
                            {
                                "example_id": "14088fdd-641a-49e4-8c0a-da534d75595d",
                                "sense_id": "678bbbe8-7d44-3e93-9635-76f9982429d3",
                                "text": "Le front Moro et « l’Armée du peuple » marxiste, toux deux débordés par des événements qu’ils n’avaient pas prévus, essaient, comme partout les escrocs de la « Révolution »-sic, de faire dévier les événements à leur profit, multiplient les proclamations, mégalomanisent à grands hurlements dans les micros."
                            }
                        ]
                    }
