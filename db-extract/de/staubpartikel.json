                "senses": [
                    {
                        "sense_id": "2942376c-e734-35fa-8004-e28b203514db",
                        "entry_id": "0fb45b9a-2878-3012-9a29-77a84ca4fa5f",
                        "glosses": [
                            "sehr kleine Teilchen von Staub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9fb060-7d92-4435-8a83-a891c87a74ac",
                                "sense_id": "2942376c-e734-35fa-8004-e28b203514db",
                                "text": "„Insekten schwirrten wie Staubpartikel in einzelnen Sonnenstrahlen.“"
                            },
                            {
                                "example_id": "c656b359-861e-4b2c-9741-44ad5e1eba38",
                                "sense_id": "2942376c-e734-35fa-8004-e28b203514db",
                                "text": "„Feine Staubpartikel tanzten in dem Lichtstreifen.“"
                            },
                            {
                                "example_id": "d0d990a1-0114-4f9b-a492-eea76a4aec14",
                                "sense_id": "2942376c-e734-35fa-8004-e28b203514db",
                                "text": "„Staubpartikel verhalten sich nämlich ganz anders, als die gewohnten Dinge, die uns umgeben, anders als Tische, T-Shirts, Teller, Tassen und Telefone.“"
                            }
                        ],
