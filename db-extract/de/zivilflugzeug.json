                ],
                "senses": [
                    {
                        "sense_id": "a3b92a95-0e1e-36d9-bb9f-9644ab065bba",
                        "entry_id": "54213c8d-e04a-34d2-9ee4-93087e0e8e20",
                        "glosses": [
                            "Flugzeug, das hauptsächlich nicht für militärische Einsätze vorgesehen ist"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "9645ce46-39ad-4496-adf2-23bc880f7de1",
                                "sense_id": "a3b92a95-0e1e-36d9-bb9f-9644ab065bba",
                                "text": "Bei Zivilflugzeugen wird sehr auf den Komfort der Reisenden geachtet."
                            },
                            {
                                "example_id": "9f7d3b33-d65d-4e56-9aaf-2e9fa8e3511b",
                                "sense_id": "a3b92a95-0e1e-36d9-bb9f-9644ab065bba",
                                "text": "„Ersten Erkenntnissen zufolge touchierte das Zivilflugzeug den \"Eurofighter\" während beide eine Linkskurve flogen.“"
                            },
                            {
                                "example_id": "734b3ad3-3c62-4479-b662-b4236fc1b505",
                                "sense_id": "a3b92a95-0e1e-36d9-bb9f-9644ab065bba",
                                "text": "„Die Luftwaffe fliegt ihre Übungen zum Abfangen von Zivilflugzeugen nach dem Unfall über dem Sauerland mit zwei Toten wieder in vollem Umfang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9f86ecc-7c94-4f0e-89af-96fcc1b5b71b",
                        "source_entry_id": "54213c8d-e04a-34d2-9ee4-93087e0e8e20",
                        "source_sense_id": "a3b92a95-0e1e-36d9-bb9f-9644ab065bba",
                        "source_sense_description": "Flugzeug, das hauptsächlich nicht für militärische Einsätze vorgesehen ist",
                        "target_lang_word": "avion civil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avion civil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f11d61e-6337-39cf-a6ac-3a835c5aced2",
                                        "entry_id": "9d46b713-4b07-3ed3-8a1e-ba5fbbade0e8",
                                        "glosses": [
                                            "Tout avion non militaire, qu’il soit utilisé pour le transport de fret ou de passagers, le loisir, ou divers services (scientifiques, agricoles etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8373a1-5751-4863-bd3e-35878515c837",
                                                "sense_id": "5f11d61e-6337-39cf-a6ac-3a835c5aced2",
                                                "text": "Et dans quelle catégorie placer l’avion civil supersonique ? Comme pour les dinosaures, il y a de nombreuses hypothèses pouvant expliquer leur disparition, hypothèses qui pourraient faire l’objet d’un colloque."
                                            },
                                            {
                                                "example_id": "821c756e-cd2b-4ea9-8529-0dde1e6ab806",
                                                "sense_id": "5f11d61e-6337-39cf-a6ac-3a835c5aced2",
                                                "text": "Le groupe japonais Mitsubishi Heavy Industries abandonne son projet d’avion civil, dont la date de commercialisation n’a cessé d’être repoussée en raison de difficultés techniques."
                                            },
                                            {
                                                "example_id": "2acf6107-c928-41d9-80db-4ff8585c4af0",
                                                "sense_id": "5f11d61e-6337-39cf-a6ac-3a835c5aced2",
                                                "text": "Le Dash-8, un avion civil court-courrier, a effectué avec succès un vol de 15 minutes équipé d’un moteur électrique propulsé par une pile à combustible à hydrogène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
