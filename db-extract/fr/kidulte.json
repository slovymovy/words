                        "glosses": [
                            "Adulte immature."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd269e4-39ce-498e-b5a8-8f39b9280779",
                                "sense_id": "f48d00e9-1e52-3fd4-816f-2e8df95d6fbe",
                                "text": "Avec Audrey, on se moquait des kidultes, comme on les appelait, ces gens qui ne font pas leur lessive et ne savent pas ce qu’est un fer à repasser. « Tiens, un kidulte » , me chuchotait parfois Audrey au cinéma quand un homme-enfant apparaissait sur l’écran."
                            },
                            {
                                "example_id": "58e123cc-8a84-47d7-b1b9-4191ab10f37f",
                                "sense_id": "f48d00e9-1e52-3fd4-816f-2e8df95d6fbe",
                                "text": "C’est son côté « je fais ce que je veux, et si ça ne vous plait pas, allez voir ailleurs ». Il est ce qu’on appelle aujourd’hui un kidulte ou un adulescent."
                            }
                        ]
                    }
