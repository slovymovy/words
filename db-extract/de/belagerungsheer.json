                        "examples": [
                            {
                                "example_id": "8d1b1e1a-2e7b-4b34-9c7e-4443308abd2b",
                                "sense_id": "2b626773-7ad3-3d41-b534-fef6d34d75b6",
                                "text": "„154 Jahre dauerte es, bis 1683 erneut ein türkisches Belagerungsheer vor Wien erschien, diesmal noch zahlreicher und noch bedrohlicher.“"
                            },
                            {
                                "example_id": "a3e2085d-1acf-4291-84e5-47720eeb6a6d",
                                "sense_id": "2b626773-7ad3-3d41-b534-fef6d34d75b6",
                                "text": "„Auf unsere Fragen, wer der Offizier sei, erfuhren wir bloß, daß er zum Belagerungsheere von Callao gehöre und einstmaliger Passagier des Kapitäns gewesen.“"
                            }
                        ],
