                                "target_senses": [
                                    {
                                        "sense_id": "c8df77f3-2a3f-34ec-a3e2-67d120ed6d91",
                                        "entry_id": "5c6ef256-dd2c-3106-8111-b6ceb8653fd1",
                                        "glosses": [
                                            "Material, das bereits vorhanden, aber noch nicht ausgewertet/weiterverarbeitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652c4f28-6a8e-49a7-bba3-391acf29a59d",
                                                "sense_id": "c8df77f3-2a3f-34ec-a3e2-67d120ed6d91",
                                                "text": "„Im Ganzen gesehen wird das Rohmaterial der Tagebücher von Jünger geglättet, ausgearbeitet und in eine gefällige, lesbare Form gebracht, wobei eine grundsätzliche Tendenz zur Stilisierung, auch zur gelegentlichen Veränderung von Tatsachen besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
