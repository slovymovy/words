{
    "word_family": [
        "abstain",
        "abstinent",
        "abstainer",
        "abstinency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bb0c0b0-777c-3468-a2cd-9382cfbcf293",
                    "sense_definition": "The act or practice of refraining from indulging a desire or appetite, such as for food or pleasure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended a period of <w>abstinence</w> from sugary snacks to improve his health.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал период <w>воздержания</w> от сладких перекусов, чтобы поправить здоровье."
                            }
                        },
                        {
                            "text": "After years of <w>abstinence</w> from filmmaking, the director finally returned with a new masterpiece.",
                            "target_lang_translations": {
                                "ru": "После многих лет <w>воздержания</w> от кинопроизводства режиссер наконец вернулся с новым шедевром."
                            }
                        }
                    ],
                    "synonyms": [
                        "refrainment",
                        "forbearance",
                        "self-denial"
                    ],
                    "antonyms": [
                        "indulgence",
                        "excess"
                    ],
                    "common_phrases": [
                        "period of abstinence",
                        "total abstinence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или практика отказа от удовлетворения желания или аппетита, например, в еде или удовольствиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздержание",
                                "target_lang_sense_clarification": "общий отказ от чего-либо"
                            },
                            {
                                "target_lang_word": "самоограничение",
                                "target_lang_sense_clarification": "сознательный отказ от удовольствий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1da1a79b-3229-3c77-99e1-6b7fc7bce94e",
                    "sense_definition": "The practice of refraining from sexual intercourse, often for moral, religious, or health reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some schools include <w>abstinence</w> education as part of their health curriculum.",
                            "target_lang_translations": {
                                "ru": "Некоторые школы включают половое <w>воздержание</w> в учебную программу по охране здоровья."
                            }
                        },
                        {
                            "text": "They decided to practice <w>abstinence</w> until they were officially married.",
                            "target_lang_translations": {
                                "ru": "Они решили практиковать <w>воздержание</w> до официального вступления в брак."
                            }
                        }
                    ],
                    "synonyms": [
                        "celibacy",
                        "chastity"
                    ],
                    "antonyms": [
                        "promiscuity"
                    ],
                    "common_phrases": [
                        "sexual abstinence",
                        "practice abstinence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика отказа от половых контактов, часто по моральным, религиозным причинам или по состоянию здоровья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздержание",
                                "target_lang_sense_clarification": "половое воздержание"
                            },
                            {
                                "target_lang_word": "целомудрие",
                                "target_lang_sense_clarification": "сохранение чистоты"
                            },
                            {
                                "target_lang_word": "абстиненция",
                                "target_lang_sense_clarification": "медицинский термин для полового воздержания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e946573d-0ce7-3f91-a647-9fa45dc0d9c4",
                    "sense_definition": "The practice of refraining from drinking intoxicating or alcoholic beverages.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His long-term <w>abstinence</w> from alcohol has significantly improved his liver function.",
                            "target_lang_translations": {
                                "ru": "Его длительное <w>воздержание</w> от алкоголя значительно улучшило работу печени."
                            }
                        },
                        {
                            "text": "The support group encourages complete <w>abstinence</w> for those recovering from addiction.",
                            "target_lang_translations": {
                                "ru": "Группа поддержки призывает к полному <w>воздержанию</w> тех, кто лечится от зависимости."
                            }
                        }
                    ],
                    "synonyms": [
                        "teetotalism",
                        "sobriety"
                    ],
                    "antonyms": [
                        "intoxication",
                        "alcoholism"
                    ],
                    "common_phrases": [
                        "complete abstinence",
                        "abstinence from alcohol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика отказа от употребления опьяняющих или алкогольных напитков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздержание",
                                "target_lang_sense_clarification": "отказ от алкоголя"
                            },
                            {
                                "target_lang_word": "трезвенность",
                                "target_lang_sense_clarification": "состояние без алкоголя"
                            },
                            {
                                "target_lang_word": "абстиненция",
                                "target_lang_sense_clarification": "полное воздержание от спиртного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7754c212-73a8-3274-88d0-eaebbcc58250",
                    "sense_definition": "The religious practice of refraining from certain foods, especially meat, on specific days of penitence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_practice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many traditions, Friday is observed as a day of <w>abstinence</w> from meat.",
                            "target_lang_translations": {
                                "ru": "Во многих традициях пятница соблюдается как день <w>воздержания</w> от мяса."
                            }
                        },
                        {
                            "text": "The monk lived a life of prayer and strict <w>abstinence</w> during the holy season.",
                            "target_lang_translations": {
                                "ru": "Монах вел жизнь в молитве и строгом <w>воздержании</w> во время святого сезона."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasting"
                    ],
                    "antonyms": [
                        "feasting"
                    ],
                    "common_phrases": [
                        "day of abstinence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозная практика отказа от определенных видов пищи, особенно мяса, в установленные дни покаяния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздержание",
                                "target_lang_sense_clarification": "религиозный пост"
                            },
                            {
                                "target_lang_word": "пост",
                                "target_lang_sense_clarification": "религиозное ограничение в пище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8eef4704-f7e4-3475-bf54-fbe7e22322ef",
                    "sense_definition": "The act of delaying spending or consumption in order to accumulate capital or savings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theory suggests that interest is a reward for the <w>abstinence</w> of the investor.",
                            "target_lang_translations": {
                                "ru": "Теория предполагает, что процент — это вознаграждение за <w>воздержание</w> инвестора."
                            }
                        },
                        {
                            "text": "Economic growth often requires a degree of <w>abstinence</w> from immediate consumption.",
                            "target_lang_translations": {
                                "ru": "Экономический рост часто требует определенной степени <w>воздержания</w> от немедленного потребления."
                            }
                        }
                    ],
                    "synonyms": [
                        "saving",
                        "frugality"
                    ],
                    "antonyms": [
                        "consumption",
                        "spending"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical economic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт отсрочки расходов или потребления с целью накопления капитала или сбережений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздержание",
                                "target_lang_sense_clarification": "экономический термин, отказ от потребления"
                            },
                            {
                                "target_lang_word": "бережливость",
                                "target_lang_sense_clarification": "экономия ресурсов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}