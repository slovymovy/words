                "senses": [
                    {
                        "sense_id": "53fd8cb3-391f-3877-b75a-e3c1fc0febf6",
                        "entry_id": "30912bd1-2bfd-349b-9065-cad068ea066d",
                        "glosses": [
                            "Gesamtheit der Personen und Einrichtungen, die den Handel ausmachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720b8675-db8e-41d1-b3e7-333d7ef70e37",
                                "sense_id": "53fd8cb3-391f-3877-b75a-e3c1fc0febf6",
                                "text": "„Winnie brachte die City mit, die Frische, die leichte Eleganz der Geschäftswelt, die nur lose angedeutete Trägheit der erfolgreichen Frau, die es nicht nötig hat, unträge zu sein.“"
                            },
                            {
                                "example_id": "62968173-e00b-4fb6-97a1-864b3f18a5fe",
                                "sense_id": "53fd8cb3-391f-3877-b75a-e3c1fc0febf6",
                                "text": "„Für die jüdischen Kinder ist die erste, die Muttersprache, Spaniolisch, die Umgangssprache außerhalb des Familien- und Synagogenbereichs Bulgarisch, in der Geschäftswelt und von Bediensteten hören sie einige der anderen Sprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
