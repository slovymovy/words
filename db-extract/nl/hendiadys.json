                "senses": [
                    {
                        "sense_id": "558413e8-a1b6-305f-99fa-0ee84b846b8b",
                        "entry_id": "54288d5d-bee3-3b34-8dde-b789fc7fcbdd",
                        "glosses": [
                            "het omschrijven van een begrip door middel van twee nevengeschikte woorden, waarvan er één vooral een attributieve betekenis heeft bij het andere, zodat de nadruk wat verschuift"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": [
                            {
                                "example_id": "eaac248b-cfa4-47fd-a9ce-96db9a394c45",
                                "sense_id": "558413e8-a1b6-305f-99fa-0ee84b846b8b",
                                "text": "Een hendiadys duidt één ding aan door middel van twee omschrijvingen. Vergelijk onze uitdrukking: pais en vree."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc87a67c-68fe-46f1-8c04-a3fd5660a165",
                        "source_entry_id": "54288d5d-bee3-3b34-8dde-b789fc7fcbdd",
                        "source_sense_id": "558413e8-a1b6-305f-99fa-0ee84b846b8b",
                        "target_lang_word": "Hendiadyoin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hendiadyoin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e244e6cf-32ed-36aa-b0f7-80e7168e77ae",
                                        "entry_id": "17484133-1ee1-30fc-a273-30ad14f376bb",
                                        "glosses": [
                                            "Ausdruck, in dem ein Begriff mit zwei Wörtern gleicher oder ähnlicher Bedeutung wiedergegeben wird"
                                        ],
                                        "tags": [
                                            "rhetorische Figur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6285aef0-23c8-4fd2-aa11-e202020e839b",
                                                "sense_id": "e244e6cf-32ed-36aa-b0f7-80e7168e77ae",
                                                "text": "„Schließlich prägte der Spiegel (49/91, 20) das Adverbial beamtig-bräsig, das die Eigenschaft hat, sowohl ein Hendiadyoin zu sein als auch eine Verdoppelung des Affixes aufzuweisen.“"
                                            },
                                            {
                                                "example_id": "c3435bee-46ca-4a2d-ba34-aba2dee8a718",
                                                "sense_id": "e244e6cf-32ed-36aa-b0f7-80e7168e77ae",
                                                "text": "„Besonders das lästige Suchen und Entschlüsse[l]n von Stilfiguren wie Metapher, Synekdoche oder Hendiadyoin, was sonst vielen Schülern zu schaffen macht, entfällt bei dieser Art Lyrik oftmals.“"
                                            },
                                            {
                                                "example_id": "f78c152a-1ccd-4c18-9125-5d4b28cde728",
                                                "sense_id": "e244e6cf-32ed-36aa-b0f7-80e7168e77ae",
                                                "text": "„Phraseologismen wie das Hendiadyoin werden im Deutschen oft in Form einer Alliteration gebildet: Die Paarwörter beginnen mit dem gleichen Laut (wie ‚frank und frei‘, ‚klipp und klar‘). Daneben finden sich auch Paare, die ein Homoioteleuton bilden, also in den Wortendungen übereinstimmen (wie ‚rank und schlank‘).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
