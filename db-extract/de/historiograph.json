                "senses": [
                    {
                        "sense_id": "be3b836a-b812-3bfd-b6f9-53f1c9508fa0",
                        "entry_id": "19028af7-cd23-3af4-9e29-5caf16c70d29",
                        "glosses": [
                            "Person, die historische Vorgänge aufschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d39d2f-be96-4a37-94d3-b666fc4a68ad",
                                "sense_id": "be3b836a-b812-3bfd-b6f9-53f1c9508fa0",
                                "text": "„Die Chronisten und wenig später die frühneuzeitlichen Historiographen und Gelehrten nutzen sämtliche Zuordnungsmöglichkeiten, wahrscheinliche und abwegige.“"
                            },
                            {
                                "example_id": "1c4e25b7-2b42-4f6a-b70c-9c6b7a56f6c1",
                                "sense_id": "be3b836a-b812-3bfd-b6f9-53f1c9508fa0",
                                "text": "„In seiner amtlichen Eigenschaft war er als Chronist, als Historiograph der Stadt eingesetzt und nicht zum Richter berufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
