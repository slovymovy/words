                ],
                "senses": [
                    {
                        "sense_id": "95796584-c34a-31fb-a416-eb0c5b963f14",
                        "entry_id": "4cf02675-f993-3a92-a68a-1a1b193e9681",
                        "glosses": [
                            "Gesamtheit aller festgelegten Regelungen und Bestimmungen, die einen ordnungsmäßigen und zielgerichteten Unterricht und Erziehung in der Schule sicherstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75e4c90-e2cd-4603-a47e-3c61b956080d",
                                "sense_id": "95796584-c34a-31fb-a416-eb0c5b963f14",
                                "text": "„Jedes dritte Elternpaar ist mit den Schlägen für das Kind bei einem Verstoß gegen die Schulordnung einverstanden.“"
                            },
                            {
                                "example_id": "237fef87-9178-4440-ad40-a657cd92dd34",
                                "sense_id": "95796584-c34a-31fb-a416-eb0c5b963f14",
                                "text": "„Verbindliche Kleiderregeln könne eine Schule nur über die Schulordnung festlegen, über die immer die Gesamtkonferenz zu beschließen habe, in der auch Schüler und Eltern vertreten sind.“"
                            },
                            {
                                "example_id": "04f8ae7e-796e-4287-9df9-748837052e17",
                                "sense_id": "95796584-c34a-31fb-a416-eb0c5b963f14",
                                "text": "„Schon von 1641 an gab es Zeugnisse, ein Jahr später wurde mit dem ‚Schulmethodus‘ die erste eigenständige und unabhängig von der Kirche verfasste Schulordnung für das Elementarschulwesen eingeführt: Wenn ‚alles‘ gelernt werden soll, braucht es eine Methode.“"
                            },
                            {
                                "example_id": "db4e0c47-cdbe-4ad3-b85e-8d35c9ee0328",
                                "sense_id": "95796584-c34a-31fb-a416-eb0c5b963f14",
                                "text": "„Westerholt hat ein Heft der alten Schulordnung mitgebracht und liest laut daraus vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
