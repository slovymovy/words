                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                                        "entry_id": "bbb66dc5-089a-3491-80cb-1564f6c137fd",
                                        "glosses": [
                                            "To jump."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d0dae9-dd78-4748-9861-c26322be15db",
                                                "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                                                "text": "It is grete nede a man to go bak to recouer the better his leep"
                                            },
                                            {
                                                "example_id": "73779abe-ece3-4d29-b232-5222ec1d3f20",
                                                "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                                                "text": "I, I defie thee: wert not thou next him when he leapt into the Riuer?"
                                            },
                                            {
                                                "example_id": "3753d517-8f61-4c4f-99ef-f5679fd24a6d",
                                                "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                                                "text": "Th’ infernal monarch rear’d his horrid head, Leapt from his throne, lest Neptune’s arm should lay His dark dominions open to the day."
                                            },
                                            {
                                                "example_id": "efd293e4-6b77-4628-b23b-24d1ca11df43",
                                                "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                                                "text": "“See you, one should not ask for outside proof—no, reason should be enough. But the flesh is weak, it is consolation to find that one is on the right track. Ah, my friend, I am like a giant refreshed. I run! I leap!” And, in very truth, run and leap he did, gambolling wildly down the stretch of lawn outside the long window."
                                            },
                                            {
                                                "example_id": "db4c83fa-2b0b-4e87-89ca-45614b8cc82e",
                                                "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                                                "text": "It is better to leap into the void."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5b73783-22a2-36bd-9a0f-1c1375a9902e",
                                        "entry_id": "bbb66dc5-089a-3491-80cb-1564f6c137fd",
                                        "glosses": [
                                            "To pass over by a leap or jump."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51225ba5-e321-4210-9236-af8ab0157be4",
                                                "sense_id": "f5b73783-22a2-36bd-9a0f-1c1375a9902e",
                                                "text": "to leap a wall or a ditch"
                                            },
                                            {
                                                "example_id": "ce728060-a02a-4329-84d8-92d5486ee1d2",
                                                "sense_id": "f5b73783-22a2-36bd-9a0f-1c1375a9902e",
                                                "text": "⁠Deep folly! yet that this could be—\n⁠That I could wing my will with might\n⁠To leap the grades of life and light,\nAnd flash at once, my friend, to thee: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b6327f-7284-3950-a729-65f77f2d6508",
                                        "entry_id": "bbb66dc5-089a-3491-80cb-1564f6c137fd",
                                        "glosses": [
                                            "To copulate with (a female beast)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36a966c5-cce1-3ba2-95b9-186e9a47bc6d",
                                        "entry_id": "bbb66dc5-089a-3491-80cb-1564f6c137fd",
                                        "glosses": [
                                            "To copulate with (a human)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5fe585f-ae80-4a1b-9b18-caa2c683df28",
                                                "sense_id": "36a966c5-cce1-3ba2-95b9-186e9a47bc6d",
                                                "text": "go leap her, and engender young devilings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "891c7b5a-f1fb-3663-896d-f4ce51d45d30",
                                        "entry_id": "bbb66dc5-089a-3491-80cb-1564f6c137fd",
                                        "glosses": [
                                            "To cause to leap."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3183c151-bfbd-43cb-9fda-b98ad1eced0b",
                                                "sense_id": "891c7b5a-f1fb-3663-896d-f4ce51d45d30",
                                                "text": "to leap a horse across a ditch"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7845e0-5ccc-34a9-8877-1ee14c246dc0",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "The act of leaping or jumping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d0d96cf-998e-483b-8284-1da27b165b4b",
                                                "sense_id": "ec7845e0-5ccc-34a9-8877-1ee14c246dc0",
                                                "text": "He made a leap across the river."
                                            },
                                            {
                                                "example_id": "4f0c0d00-abcd-413f-9788-9545c49349eb",
                                                "sense_id": "ec7845e0-5ccc-34a9-8877-1ee14c246dc0",
                                                "text": "Leaps from one Extream to Another , are Unnatural Motions in the Course of our lives and Humours"
                                            },
                                            {
                                                "example_id": "f18b14bc-a051-42ad-a9d1-c1604774ebe6",
                                                "sense_id": "ec7845e0-5ccc-34a9-8877-1ee14c246dc0",
                                                "text": "1877, Henry Sweet, A Handbook of Phonetics\nChanges of tone may proceed either by leaps or glides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e19b2d16-ce3b-3b19-883f-6d29f4272a37",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "The distance traversed by a leap or jump."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff3ae8c0-a5cb-3173-b607-c6e4bcdfb544",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "A group of leopards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d7387c-4eee-47f4-b5c6-d8aa02f5cd76",
                                                "sense_id": "ff3ae8c0-a5cb-3173-b607-c6e4bcdfb544",
                                                "text": "Manikanta returned to the palace riding on a royal tiger accompanied by a leap of leopards to the utter surprise of the inhabitants of Pantalam."
                                            },
                                            {
                                                "example_id": "0613d35c-941d-4501-a88b-88f1cb7f5cc9",
                                                "sense_id": "ff3ae8c0-a5cb-3173-b607-c6e4bcdfb544",
                                                "text": "I can see it now... a leap of Leopards eating the carcass of a Longhorn out in the Vista...."
                                            },
                                            {
                                                "example_id": "0e09b6fd-3199-4574-aef7-8c115f7247a1",
                                                "sense_id": "ff3ae8c0-a5cb-3173-b607-c6e4bcdfb544",
                                                "text": "Without the Chop Chop Chop Chop Cowville seems almost normal: no hover of helicopters, no leap of leopards."
                                            },
                                            {
                                                "example_id": "bfb406e0-ef98-4857-ae23-3e5e6047f53f",
                                                "sense_id": "ff3ae8c0-a5cb-3173-b607-c6e4bcdfb544",
                                                "text": "I felt like the only one of my kind, and all around me were the other kids in their groups like herds of wildebeests and prides of lions and crashes of rhinos and unkindnesses of ravens and leaps of leopards and wrecks of sea hawks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "775d1fb2-c941-3227-b729-6cfb9ae3378c",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "A significant move forward."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3cb17f2-dbf9-4fbe-b0b8-0ebbf346c2f8",
                                                "sense_id": "775d1fb2-c941-3227-b729-6cfb9ae3378c",
                                                "text": "That's one small step for [a] man, one giant leap for mankind."
                                            },
                                            {
                                                "example_id": "818745cd-be57-49a9-a02f-f74dfdc7ee6f",
                                                "sense_id": "775d1fb2-c941-3227-b729-6cfb9ae3378c",
                                                "text": "Since the arrival of mainstream pornography platforms in the early 2000’s and the rise in smartphone use, online pornography consumption has shown considerable year on year leaps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f793d7-0ae2-3db2-8175-3e77209d31aa",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "A large step in reasoning, often one that is not justified by the facts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39511dc2-0ecb-4dc0-93e5-7383e37e753a",
                                                "sense_id": "32f793d7-0ae2-3db2-8175-3e77209d31aa",
                                                "text": "It's quite a leap to claim that those cloud formations are evidence of UFOs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28a1bdee-1d31-3915-9c40-68a74147d91c",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "A fault."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2eb31e8-a23e-348e-89ca-fbb7ff05d491",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "Copulation with, or coverture of, a female beast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0f888b-abf0-4588-9fff-cb9973746f92",
                                                "sense_id": "c2eb31e8-a23e-348e-89ca-fbb7ff05d491",
                                                "text": "Much difference of opinion exists as to the number of bullings a cow should receive. Here, I think, good judgment should be used. If the bull is cool and quiet, and some time has intervened since he had his last cow, one good leap is better than more […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d244a7-ec8d-3eb2-8412-c42f60ac3396",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "A passing from one note to another by an interval, especially by a long one, or by one including several other intermediate intervals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e17fa9bf-38d4-3f8e-b64c-c005ec41d3c6",
                                        "entry_id": "52d44cb5-fb29-3471-82c1-bef7e707c422",
                                        "glosses": [
                                            "A small cataract over which fish attempt to jump; a salmon ladder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd6b136-6a47-46ed-b82d-e996a5765d62",
                                                "sense_id": "e17fa9bf-38d4-3f8e-b64c-c005ec41d3c6",
                                                "text": "He unfortunately persevered, and the cot veered round towards the fall of the leap, and was running fast towards the rapids, when Mr. Craven lost his self-possession, and jumped out to gain a rock within a length of him, but did not succe[e]d, and he sunk in a part of the river over the leap called the dancing-hole, from which he was never more seen to rise. The cot was dashed with violence against another rock […]"
                                            },
                                            {
                                                "example_id": "a68ca949-e93d-40bc-9e60-3ba79361ffd9",
                                                "sense_id": "e17fa9bf-38d4-3f8e-b64c-c005ec41d3c6",
                                                "text": "[…] where the Esk divides it in the middle, and forms a linn or leap, is named the How burn; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
