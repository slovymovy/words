                "senses": [
                    {
                        "sense_id": "efb05bc5-5e38-3f8d-9aeb-ee009ab89032",
                        "entry_id": "58352fc4-0932-32f6-ad64-3924732e5184",
                        "glosses": [
                            "essbarer Spross einer Zwiebelpflanze; Zwiebel"
                        ],
                        "tags": [
                            "North German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5070f0f0-bf82-4e20-82f8-056e8a3b01ad",
                                "sense_id": "efb05bc5-5e38-3f8d-9aeb-ee009ab89032",
                                "text": "„Auf diese spätlateinische Verkleinerungsform von cepa geht unser heutiger Name Zwiebel – volkstümlich auch Zipolle, Zwifl, Zippel oder Bolle genannt – zurück.“"
                            },
                            {
                                "example_id": "d2856244-dc6c-48f6-b2cf-8400bcc2b6eb",
                                "sense_id": "efb05bc5-5e38-3f8d-9aeb-ee009ab89032",
                                "text": "„Die Zipolle war schon den alten Ägyptern und Israeliten eine beliebte Speise; die letzteren sehnten sich in der arabischen Wüste nach den Zwiebeln und dem Lauche Ägyptens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
