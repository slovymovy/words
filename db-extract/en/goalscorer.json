                ],
                "senses": [
                    {
                        "sense_id": "42a3bf2e-2647-3640-b086-bb6d8c4f9bf2",
                        "entry_id": "d1703805-2e9a-3679-ba98-94f8657c3baa",
                        "glosses": [
                            "A person who scores a goal, or scores goals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec481bd6-f181-4b67-8495-8ede73c02e2e",
                                "sense_id": "42a3bf2e-2647-3640-b086-bb6d8c4f9bf2",
                                "text": "At the other end, goalscorer Krohn-Dehli's 20-yard strike brought a fine stop from Stekelenburg."
                            },
                            {
                                "example_id": "0a310ec8-e93e-455b-93df-1701c8cc14a6",
                                "sense_id": "42a3bf2e-2647-3640-b086-bb6d8c4f9bf2",
                                "text": "At the age of 22, the Norwegian forward had already established himself as one of the best goalscorers in European football – first at Red Bull Salzburg, then with two prolific seasons at Borussia Dortmund."
                            },
                            {
                                "example_id": "2debd910-e35b-4428-bbaa-79b9a9a15d6c",
                                "sense_id": "42a3bf2e-2647-3640-b086-bb6d8c4f9bf2",
                                "text": "Ronaldo Sr., who is the record goalscorer in men’s international soccer with 136 goals for Portugal, congratulated his son on his Instagram Stories by posting a picture of his name on the squad list, saying: “Proud of you, son!”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0af7badf-518f-4f7a-b4fc-af6bd482ca8b",
                        "source_entry_id": "d1703805-2e9a-3679-ba98-94f8657c3baa",
                        "source_sense_id": "42a3bf2e-2647-3640-b086-bb6d8c4f9bf2",
                        "source_sense_description": "person who scores a goal",
                        "target_lang_word": "doelpuntenmaker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doelpuntenmaker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "53f2a83a-99ce-3088-85cd-6cd668ddc0ac",
                                        "entry_id": "6fc8c8e3-6b5f-30db-b840-ca168c6d2091",
                                        "glosses": [
                                            "sporter die een goal maakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bb857a-c8ec-4327-adf6-be81d006ebc6",
                                                "sense_id": "53f2a83a-99ce-3088-85cd-6cd668ddc0ac",
                                                "text": "Heerenveen maakte in de eerste vijf duels indruk door net als FC Twente maar één goal tegen te krijgen, maar afgelopen zaterdag kreeg de formatie van de nieuwe trainer Kees van Wonderen tegen Ajax opeens vijf goals om de oren. „Ze hebben thuis nog wel eens moeite om het spel te maken, maar daar staat tegenover dat ze in de omschakeling heel gevaarlijk kunnen zijn”, aldus FC Twente-trainer Ron Jans. „Met Sarr hebben ze veel snelheid en Van Hooijdonk is een echte doelpuntenmaker.”"
                                            },
                                            {
                                                "example_id": "e7a3d685-75cc-4885-a1d6-cc7cc549f50f",
                                                "sense_id": "53f2a83a-99ce-3088-85cd-6cd668ddc0ac",
                                                "text": "Morgan heeft haar status voornamelijk te danken aan haar killersinstinct. \"Ze is een dynamische speelster met een combinatie van snelheid, creativiteit en het vermogen om altijd haar kansen te benutten\", zegt Goff. \"Ze is een echte doelpuntenmaker en daar houden de mensen van.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a40958a6-1713-4a2b-8a06-f01eef798a21",
                        "source_entry_id": "d1703805-2e9a-3679-ba98-94f8657c3baa",
                        "source_sense_id": "42a3bf2e-2647-3640-b086-bb6d8c4f9bf2",
                        "source_sense_description": "person who scores a goal",
                        "target_lang_word": "buteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buteur",
