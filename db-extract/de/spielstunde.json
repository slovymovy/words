                "senses": [
                    {
                        "sense_id": "8552390a-1e94-39c9-97cc-dc8ec816d81f",
                        "entry_id": "e654e64d-29c8-32ce-9f2e-79d7203b2f41",
                        "glosses": [
                            "Zeitrahmen, der zum Spielen zur Verfügung steht, unterrichtsfreie Schulstunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39654f65-e125-454b-84e1-6c8a8d68fe1b",
                                "sense_id": "8552390a-1e94-39c9-97cc-dc8ec816d81f",
                                "text": "„Die Kinder haben in den Spielstunden oft den Wunsch, bei Kreisspielen neben dem Spielleiter oder sogar auf seinem Schoß zu sitzen.“"
                            },
                            {
                                "example_id": "b3cf9253-8dea-41cf-bc98-ed59bcee0418",
                                "sense_id": "8552390a-1e94-39c9-97cc-dc8ec816d81f",
                                "text": "„In dieser Phase, die in ähnlicher Form bisweilen in Spielstunden mit kleineren Gruppen im Jugend- und Erwachsenenbereich auftreten kann, werden die entscheidenden Impulse vom Leiter erwartet.“"
                            },
                            {
                                "example_id": "c6674b77-c07c-4fc2-8dc9-0a554a82a29c",
                                "sense_id": "8552390a-1e94-39c9-97cc-dc8ec816d81f",
                                "text": "„Wenn heute Schulen regelrechte Spielstunden in ihren Wochenplan aufnehmen, so finden sie, sind einmal die Anfangshemmungen überwunden, bis hin zu den 12- und 13-Jährigen lebhafte Zustimmung.“"
                            },
                            {
                                "example_id": "3ac7d85c-63f3-469a-b06a-b07f92b83727",
                                "sense_id": "8552390a-1e94-39c9-97cc-dc8ec816d81f",
                                "text": "„Wenn eine Spielstunde vereinbart ist, müssen sich auch die Eltern daran halten.“"
                            },
                            {
                                "example_id": "5d755394-6cb7-4b7d-af7b-662a20f0070e",
                                "sense_id": "8552390a-1e94-39c9-97cc-dc8ec816d81f",
                                "text": "„Auf das tägliche Geigen-Minimum von drei Spielstunden will Garrett aber nicht verzichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
