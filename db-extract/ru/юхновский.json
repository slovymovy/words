                "senses": [
                    {
                        "sense_id": "942c21dc-6820-3236-82ff-fdf4e938353d",
                        "entry_id": "99c21633-8676-3973-8f30-ce004ffcf7e1",
                        "glosses": [
                            "относящийся к городу Юхнов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3eb0718-2ec6-4f2f-8f17-aa7dfe338037",
                                "sense_id": "942c21dc-6820-3236-82ff-fdf4e938353d",
                                "text": "Они выбрали исключительной красоты место в Юхновском районе, вблизи деревни Троица."
                            },
                            {
                                "example_id": "beb5ebf8-0940-4236-bfbf-de07e18ac50c",
                                "sense_id": "942c21dc-6820-3236-82ff-fdf4e938353d",
                                "text": "Речь идет о газоснабжении деревень, сел и поселков Юхновского, Жиздринского, Дзержинского, Жуковского, Козельского, Мещовского и Хвастовичского районов."
                            }
                        ]
                    }
