                        ],
                        "examples": [
                            {
                                "example_id": "6881ca07-ffe7-4503-8333-f95a80652398",
                                "sense_id": "5753092a-d50d-3908-bfc6-d22cd48a395f",
                                "text": "Portes de réfrigérateur couverte d’aimantins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55784687-0135-4152-89ff-09b23e8666da",
                        "source_entry_id": "1893dafa-3a16-396d-8bb0-630f988cb61e",
                        "source_sense_id": "5753092a-d50d-3908-bfc6-d22cd48a395f",
                        "target_lang_word": "magnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "694fcbba-ce5b-3cef-94ff-66cdfbd3b1b4",
                                        "entry_id": "79c382cd-44c1-39b3-9fab-a0c285b9adff",
                                        "glosses": [
                                            "A piece of material that attracts some metals by magnetism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                                        "entry_id": "79c382cd-44c1-39b3-9fab-a0c285b9adff",
                                        "glosses": [
                                            "An alluring or attractive person or thing."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-compounds",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af8886d-aca9-47a6-accc-8b3501b89392",
                                                "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                                                "text": "He always had a girl on his arm – he's a bit of a babe magnet."
                                            },
                                            {
                                                "example_id": "788030f3-41da-42a5-ab8d-8420e73cc47f",
                                                "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                                                "text": "Iron and coal were the magnets that drew railways to this land of lovely valleys and silent mountains—for such it was a century-and-a-half ago, before man blackened the valleys with the smoke of his forges, scarred the green hills with his shafts and waste-heaps, and drove the salmon from the quiet Rhondda and the murmuring Taff."
                                            },
                                            {
                                                "example_id": "fdca3faf-e1d5-456c-9602-62af08a6be64",
                                                "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                                                "text": "Again, dude? Man, you just a MAGNET for trouble!"
                                            },
                                            {
                                                "example_id": "cd35bffa-e4a4-4b36-97aa-35ea2c483977",
                                                "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                                                "text": "[…] I wanted to show Nick the largest of the water holes, Rigueik, that act as magnets to life in the dry season."
                                            },
                                            {
                                                "example_id": "989b2e8b-724d-4755-8219-6d587caa7174",
                                                "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                                                "text": "Regular baths will help keep your dog clean and fresh-smelling. The frequency will depend entirely on your own preferences as well as how much of a mud-magnet your dog is!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e411be5b-1809-316f-bd5b-e89eec137aea",
                                        "entry_id": "79c382cd-44c1-39b3-9fab-a0c285b9adff",
                                        "glosses": [
                                            "Ellipsis of magnet link."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7373de83-2895-45f5-b780-ed086f946902",
                                                "sense_id": "e411be5b-1809-316f-bd5b-e89eec137aea",
                                                "text": "Magnets are thus used to create a package of cryptologic information and bundling^([sic]) it together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35f59d95-ba16-4748-b1e5-846ce6643819",
                        "source_entry_id": "1893dafa-3a16-396d-8bb0-630f988cb61e",
                        "source_sense_id": "5753092a-d50d-3908-bfc6-d22cd48a395f",
                        "target_lang_word": "koelkastmagneet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koelkastmagneet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c86cf4c3-7d7a-3d34-8f45-bf7bea6a8b3f",
                                        "entry_id": "3f50494e-7109-356c-8a8c-e486cfc7fec4",
                                        "glosses": [
                                            "magneet met een afbeelding die men op de metalen deur van een koelkast kan plakken en waaronder men notities zoals boodschappenbriefjes kan klemmen"
                                        ],
                                        "tags": [
                                            "huishouden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b52997aa-01a0-4912-8da7-b4d217bc5864",
                                                "sense_id": "c86cf4c3-7d7a-3d34-8f45-bf7bea6a8b3f",
                                                "text": "Wie denkt dat een hoopje stenen of zakje zand van een Sardijns strand een mooi aandenken is voor thuis, kan toch beter naar een lokaal souvenirwinkeltje gaan voor een koelkastmagneet, keukenschort of delicatesse."
                                            },
                                            {
                                                "example_id": "c6126fb0-29c8-4406-8fa4-9309c97c3acb",
                                                "sense_id": "c86cf4c3-7d7a-3d34-8f45-bf7bea6a8b3f",
                                                "text": "Zijn kleine winkel hangt vol met toeristische hebbedingetjes. Petjes met de Turkse vlag, de Galata-toren als koelkastmagneet, cd's van Turkse zangers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
