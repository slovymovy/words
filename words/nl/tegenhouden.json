{
    "word_family": [
        "tegenhouding",
        "tegenhouder",
        "onhoudbaar",
        "tegenstand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e68ba0c3-e57e-3b2d-b02e-acb5c25f3023",
                    "sense_definition": "iets of iemand fysiek stoppen of de voortgang belemmeren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie kon de gewelddadige hooligans met moeite <w>tegenhouden</w>.",
                            "target_lang_translations": {
                                "en": "The police were barely able to <w>stop</w> the violent hooligans."
                            }
                        },
                        {
                            "text": "Je moet de deur even <w>tegenhouden</w> zodat hij niet hard dichtwaait.",
                            "target_lang_translations": {
                                "en": "You need to <w>hold</w> the door for a moment so it doesn't blow shut."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen"
                    ],
                    "antonyms": [
                        "doorlaten"
                    ],
                    "common_phrases": [
                        "iemand tegenhouden",
                        "de deur tegenhouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to physically stop something or someone or to obstruct their progress"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cause something to cease moving"
                            },
                            {
                                "target_lang_word": "hold back",
                                "target_lang_sense_clarification": "to physically restrain or impede"
                            },
                            {
                                "target_lang_word": "block",
                                "target_lang_sense_clarification": "to obstruct a path or opening"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "493015dd-c6b4-3e9c-a88b-7a0dc074b20e",
                    "sense_definition": "voorkomen dat een bepaalde gebeurtenis of ontwikkeling plaatsvindt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verhinderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Helaas is het faillissement van ons bedrijf niet meer <w>tegen te houden</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, our company's bankruptcy can no longer be <w>prevented</w>."
                            }
                        },
                        {
                            "text": "Niks kon hem <w>tegenhouden</w> om zijn droom eindelijk waar te maken.",
                            "target_lang_translations": {
                                "en": "Nothing could <w>stop</w> him from finally making his dream come true."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen"
                    ],
                    "antonyms": [
                        "bevorderen",
                        "toelaten"
                    ],
                    "common_phrases": [
                        "een plan tegenhouden",
                        "niet tegen te houden"
                    ],
                    "target_lang_definitions": {
                        "en": "to prevent a certain event or development from taking place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to interrupt or end an activity or process"
                            },
                            {
                                "target_lang_word": "prevent",
                                "target_lang_sense_clarification": "to keep something from happening"
                            },
                            {
                                "target_lang_word": "halt",
                                "target_lang_sense_clarification": "to bring a process or development to a standstill"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e45ea56-6235-3411-8eb8-7ee8c6d73757",
                    "sense_definition": "iets op een afstand houden of onderdrukken, zoals emoties of een vijand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beheersen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeerde haar tranen <w>tegen te houden</w> tijdens de emotionele toespraak.",
                            "target_lang_translations": {
                                "en": "She tried to <w>hold back</w> her tears during the emotional speech."
                            }
                        },
                        {
                            "text": "Het leger probeerde de vijand bij de grens <w>tegen te houden</w>.",
                            "target_lang_translations": {
                                "en": "The army tried to <w>hold</w> the enemy <w>back</w> at the border."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen"
                    ],
                    "common_phrases": [
                        "tranen tegenhouden",
                        "de vijand tegenhouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to keep something at a distance or suppress it, such as emotions or an enemy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hold back",
                                "target_lang_sense_clarification": "to suppress emotions or restrain an advance"
                            },
                            {
                                "target_lang_word": "keep at bay",
                                "target_lang_sense_clarification": "to prevent someone or something from coming too near"
                            },
                            {
                                "target_lang_word": "restrain",
                                "target_lang_sense_clarification": "to keep under control or prevent from acting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72f1f057-dc84-3926-82e8-5267df7f3c06",
                    "sense_definition": "iemand staande houden of arresteren door de politie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "arrestatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte werd door de agenten op straat <w>tegengehouden</w> voor controle.",
                            "target_lang_translations": {
                                "en": "The suspect was <w>stopped</w> by officers on the street for a check."
                            }
                        },
                        {
                            "text": "Als de politie je wil <w>tegenhouden</w>, moet je direct stoppen.",
                            "target_lang_translations": {
                                "en": "If the police want to <w>pull</w> you <w>over</w>, you must stop immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanhouden",
                        "stoppen"
                    ],
                    "antonyms": [
                        "vrijlaten"
                    ],
                    "common_phrases": [
                        "door de politie tegengehouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to be pulled over or detained by the police for questioning or arrest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull over",
                                "target_lang_sense_clarification": "to be stopped by police while driving"
                            },
                            {
                                "target_lang_word": "detain",
                                "target_lang_sense_clarification": "to keep someone in official custody"
                            },
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to be halted by an authority for inspection"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
