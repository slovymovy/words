                        "examples": [
                            {
                                "example_id": "f538e5d5-89fb-470d-885b-735f0ace27ec",
                                "sense_id": "dd404da4-317e-3ab2-9a5d-6007ec9f8bae",
                                "text": "Nécrobiose lipoïdique des diabétiques."
                            },
                            {
                                "example_id": "6fd542cc-d135-4295-a384-fc464d434e83",
                                "sense_id": "dd404da4-317e-3ab2-9a5d-6007ec9f8bae",
                                "text": "Le but de ce traitement est de faire évoluer le fibrome vers la nécrobiose et donc la régression de volume."
                            },
                            {
                                "example_id": "af51961e-4fd4-4fa8-8011-0693f0f1237e",
                                "sense_id": "dd404da4-317e-3ab2-9a5d-6007ec9f8bae",
                                "text": "Nécrobiose dans le derme avec fibres collagènes légèrement basophiles, débris nucléaires et dépôts de mucine."
                            },
                            {
                                "example_id": "60727c6e-e0c3-412d-8355-b90e6f73724f",
                                "sense_id": "dd404da4-317e-3ab2-9a5d-6007ec9f8bae",
                                "text": "Mahon étudie cette complication que la grossesse rend particulièrement fréquente au niveau des myomes : la nécrobiose."
                            }
                        ]
                    }
