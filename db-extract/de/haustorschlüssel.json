                "senses": [
                    {
                        "sense_id": "2df2404a-9718-3176-9712-0dbce34d11b1",
                        "entry_id": "1bf88927-36e9-35f0-9ecc-a7c160f80c28",
                        "glosses": [
                            "Gegenstand zum Schließen und Öffnen eines Schlosses, das sich am Eingang zu einem Wohnhaus (Haustor) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061688fc-7382-4e1c-a7f7-397b0f7534d0",
                                "sense_id": "2df2404a-9718-3176-9712-0dbce34d11b1",
                                "text": "„Mieter in Wien hatten kein Anrecht auf einen Haustorschlüssel.“"
                            },
                            {
                                "example_id": "cc6ec257-12f8-470a-82bf-220d02564281",
                                "sense_id": "2df2404a-9718-3176-9712-0dbce34d11b1",
                                "text": "„Solange die Mieter keine eigenen Haustorschlüssel besaßen, öffneten sie nach der Sperrstunde (meist 21 Uhr) auf Verlangen (Läuten) gegen Entgelt (in der Monarchie ‚Sperrsechserl‘ [10 Kronen, das heißt der sechste Teil eines Guldens; später 20 Heller], in der Ersten Republik 50 Groschen [weshalb der Halbschilling im Volksmund auch als ‚Nachtschilling‘ bezeichnet wurde]) das Haustor.“"
                            },
                            {
                                "example_id": "e6619e5e-d0bd-4bd9-bc28-f19a8ec5e656",
                                "sense_id": "2df2404a-9718-3176-9712-0dbce34d11b1",
                                "text": "„Es ist auch möglich, dass das BG-Schloss bei der Gegensprechanlage an sich blockiert ist (z. B. durch einen im Schloss steckenden Gegenstand) oder die Haustür von einer Hauspartei zusätzlich mit dem Haustorschlüssel versperrt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
