            {
                "entry_id": "af2e652b-38f6-33ff-9a1d-f981ff08485f",
                "word": "mutterwindallein",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "2c0ef509-169a-4008-80cc-319ad10e2db1",
                        "entry_id": "af2e652b-38f6-33ff-9a1d-f981ff08485f",
                        "tags": [
                            "positive"
                        ],
                        "form": "mutterwindallein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                        "entry_id": "af2e652b-38f6-33ff-9a1d-f981ff08485f",
                        "glosses": [
                            "ganz und gar allein, sehr einsam, völlig vereinsamt; ganz verlassen"
                        ],
                        "tags": [
                            "outdated",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "87e1369a-b6af-431a-b0b4-437c9cee4d56",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„Es gibt keinen schöneren Rock-’n’-Roll-Moment, als mutterwindallein vor der Bühne zu sitzen, und John Fogerty spielt dir Walk With Me.“"
                            },
                            {
                                "example_id": "89da45dc-c562-4cde-95b4-b1c447190561",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„Sieh, auf der Wieſe neulich, da ging es, da waren wir mutterwindallein.“"
                            },
                            {
                                "example_id": "d1e823cb-b10f-43bb-acb4-b97d6f67efcf",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„‚Ja, Geert, wenn Du nur ein bißchen Sehnſucht gehabt hätteſt, ſo hätteſt Du mich nicht ſechs Wochen mutterwindallein in Hohen-Cremmen ſitzen laſſen wie eine Witwe, und nichts da als Niemeyer und Jahnke und ’mal die Schwantikower.[…]‘“"
                            },
                            {
                                "example_id": "a2c57f57-e856-4598-9b24-408f1b1ceec0",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„Alte und junge Treibels, desgleichen die Felgentreus, hatten ſich in eigenen Equipagen eingefunden, während Krola, von ſeinem Quartett begleitet, aus nicht aufgeklärten Gründen die neue Dampfbahn, Korinna aber mutterwindallein — der Alte wollte nachkommen — die Stadtbahn benutzt hatte.“"
                            },
                            {
                                "example_id": "27a88d13-58c2-4882-947e-aa4549ae3461",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„Wir gingen im Burgraum umher, mutterwindallein auf diesem Grat zwischen den Felswänden.“"
                            },
                            {
                                "example_id": "52f287b3-2c8e-47dc-9d96-719e84cf2696",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„Wollte sie auch mal im vergangenen Sommer ‚mutterwindallein‘ wirklich nichts, tun, dann ging dieser Plan, wär’ doch gelacht, natürlich daneben.“"
                            },
                            {
                                "example_id": "68588001-824c-4d27-a2d8-7597da794ea1",
                                "sense_id": "7e288637-085d-359c-be08-bdaeefe77ea9",
                                "text": "„Ilonka also allein, mutterwindallein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
