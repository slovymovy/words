                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0daceb0c-6999-47d9-b94d-c2f2d0d29ae4",
                                "sense_id": "51b5da68-cc03-371c-ba23-16c05cad6231",
                                "text": "Les accidents les plus fréquents sont les accidents de la route, les noyades, les brûlures et les échaudures, […]. Les enfants de un an à trois ans courent plus de risques d’échaudure."
                            }
                        ]
