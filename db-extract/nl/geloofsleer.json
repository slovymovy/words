                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3aacf29-7422-4b5f-bc4e-db7d50dd13d3",
                                                "sense_id": "6eb2bc88-2a0f-3380-a67f-5ee117c30b6b",
                                                "text": "‘[…] There's every Staffordshire crime-piece ever made in this cabinet, and that's unique. The Van Hoyer Museum in New York hasn't that very rare second version of Maria Marten's Red Barn over there, nor the little Frederick George Manning—he was the criminal Dickens saw hanged on the roof of the gaol in Horsemonger Lane, by the way—’"
                                            },
                                            {
                                                "example_id": "c404fd6e-ae36-45c6-8797-79eeae75d5d0",
                                                "sense_id": "6eb2bc88-2a0f-3380-a67f-5ee117c30b6b",
                                                "text": "An extreme version of vorticity is a vortex. The vortex is a spinning, cyclonic mass of fluid, which can be observed in the rotation of water going down a drain, as well as in smoke rings, tornados and hurricanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427c2e2e-d634-33d5-bfe4-aa6976424ed0",
