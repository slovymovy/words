                "senses": [
                    {
                        "sense_id": "581214f2-7409-390c-9a8a-9d0429b75bd4",
                        "entry_id": "408514a3-496f-3072-90c1-3697b85f22c2",
                        "glosses": [
                            "экон. невыполнение договора займа, то есть неоплата своевременно процентов или основного долга по долговым обязательствам или по условиям договора о выпуске облигационного займа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e813b5-224c-4a9e-810f-c34981a1ad8d",
                                "sense_id": "581214f2-7409-390c-9a8a-9d0429b75bd4",
                                "text": "Еврокомиссия обратилась к Китаю с просьбой помочь еврозоне, скупив облигации и другие долговые обязательства стран, находящихся на грани дефолта."
                            }
                        ]
                    },
                    {
                        "sense_id": "77bfed7c-0ce1-3fc1-bcf2-01b00a197692",
                        "entry_id": "408514a3-496f-3072-90c1-3697b85f22c2",
                        "glosses": [
                            "разг. любой экономический кризис в России (1994, 1998 года), после распада СССР"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b9ef0a37-2c04-3516-874f-9bc68be4c0c0",
                        "entry_id": "408514a3-496f-3072-90c1-3697b85f22c2",
                        "glosses": [
                            "комп. настройки по умолчанию"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "56372bd3-d012-343c-b819-75fff067d2ad",
                        "entry_id": "408514a3-496f-3072-90c1-3697b85f22c2",
                        "glosses": [
                            "перен. неол. что-либо обычное, привычное, не вызывающее эмоций"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a33ffc65-ce8d-4a29-bbb2-bc0e72d1c65f",
                        "source_entry_id": "408514a3-496f-3072-90c1-3697b85f22c2",
                        "target_lang_word": "default",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "default",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "The condition of failing to meet an obligation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d81075e-41be-404e-9ad8-d9fdd8881c1f",
                                                "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                                                "text": "He failed to make payments on time, and he is now in default."
                                            },
                                            {
                                                "example_id": "2b96ae44-1838-4deb-8062-b21b225efb5b",
                                                "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                                                "text": "You may cure this default by paying the full amount within a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a77a38f-4f05-3257-aa7e-06ee9cc689a3",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "The condition of being an obligation that has not been met."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
