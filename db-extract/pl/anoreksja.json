                                        "entry_id": "764e2167-0485-3d6c-bc31-d06dbdd94680",
                                        "glosses": [
                                            "die Appetitlosigkeit, der Mangel an Appetit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a52d2c2-b80f-4107-9ccc-2f16f31892f8",
                                                "sense_id": "d6e8f91a-2a7b-3290-9474-ccc50b35ed14",
                                                "text": "[…] nur im Ramadan, wenn ihre Essensverweigerung dem religiösen Fasten gleichkäme, setzt ihre Anorexie aus, da sie ihre Ursprungskultur ablehnt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "275f7607-e786-35d7-8764-334a44937d94",
                                        "entry_id": "764e2167-0485-3d6c-bc31-d06dbdd94680",
                                        "glosses": [
                                            "gestörte Wahrnehmung des eigenen Körpers, die zur Verweigerung der Nahrungsaufnahme führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f2b6f9-5d09-41a4-b72c-2a364c681c8e",
                                                "sense_id": "275f7607-e786-35d7-8764-334a44937d94",
                                                "text": "Sie selbst hatte nach eigenen Angaben eine Zeit von zwei bis drei Jahren gebraucht, um ihre Anorexie als solche zu erkennen. Es war ihr selbst anfangs kaum gelungen, ihren Körper als ungewöhnlich abgemagert zu empfinden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
