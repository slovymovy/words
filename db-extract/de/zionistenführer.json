                "senses": [
                    {
                        "sense_id": "7d17d748-a341-3e7e-aa67-5c89ddaa3e5d",
                        "entry_id": "d86d34c0-b44f-3637-a095-0acfa1af9e7d",
                        "glosses": [
                            "Anführer einer zionistischen Gruppierung/Bewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2cd080-060f-47c6-aee1-6dabd47acaf1",
                                "sense_id": "7d17d748-a341-3e7e-aa67-5c89ddaa3e5d",
                                "text": "„An diesem Donnerstagvormittag trafen sie sich wieder in Ben Gurions Haus, und der Zionistenführer hielt die Diskussion fast wortwörtlich in seinem Tagebuch fest.“"
                            },
                            {
                                "example_id": "fca21325-7cd6-482c-848f-6bfa7ec545b9",
                                "sense_id": "7d17d748-a341-3e7e-aa67-5c89ddaa3e5d",
                                "text": "„Seine Antipathie gegen die religiöse Ausübung bedeutete jedoch nicht, dass er die Bibel abgelehnt hätte, die er gut kannte und die selbst einige der säkularsten Zionistenführer zur Rechtfertigung dafür heranzogen, auf von Arabern bewohntem Land einen jüdischen Staat zu errichten.“"
                            },
                            {
                                "example_id": "dc9ead1d-4af8-4e21-8852-d52f343fa6f2",
                                "sense_id": "7d17d748-a341-3e7e-aa67-5c89ddaa3e5d",
                                "text": "„Lloyd Geroge versicherte dem Zionistenführer, dass Großbritannien niemals eine repräsentative Regierung in Palästina zulassen würde.“"
                            },
                            {
                                "example_id": "f17f37b1-e6e6-418b-bac0-e7322965faf1",
                                "sense_id": "7d17d748-a341-3e7e-aa67-5c89ddaa3e5d",
                                "text": "„Die Vermutung, dass diese Art der Darstellung auch die Tatsache kompensieren sollte, dass der Zionistenführer bei seiner einzigen, vier Jahre vor Erscheinung des Romans erfolgten Jerusalemreise den Tempelberg nicht besucht hatte, liegt nahe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
