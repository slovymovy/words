                                                "sense_id": "a6fea6a1-6604-32e7-a350-72948bf69bbf",
                                                "text": "Czeka nas 5 dni wypełnionych emocjonującymi speedrunami, a wszystko to w szlachetnym celu!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
