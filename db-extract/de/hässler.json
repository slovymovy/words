                ],
                "senses": [
                    {
                        "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                        "entry_id": "2d65cffc-0091-39c6-8d7c-6ef245c51a57",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e35c98-7b8c-449b-b42d-ccb858397c42",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Frau Hässler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "731d5972-3e3f-4214-a797-599d3dca95c1",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Herr Hässler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "440ec7e9-ddc8-4243-9195-fbcfd9e03a2d",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Die Hässlers fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "97ca418a-d7c3-40e5-85d1-d11e91dedda8",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Der Hässler trägt nie die Schals, die die Häßler ihm strickt."
                            },
                            {
                                "example_id": "cb681434-accc-4653-8799-6e2fa629c363",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hässler kommt, geht der Herr Hässler.“"
                            },
                            {
                                "example_id": "9af1ee94-fd70-469d-9aac-ee2db8a8ffc1",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Hässler kommt und geht."
                            },
                            {
                                "example_id": "66a39dcf-8a8b-4b20-9fdb-b5c7afe5e76a",
                                "sense_id": "c83f315e-eea1-3fd8-af6b-4699bb760b1c",
                                "text": "Hässlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
