                        "entry_id": "9cd98d99-cab4-3c84-b912-b52ac94385bb",
                        "glosses": [
                            "Melodie, die programmatisch ist für eine Fernseh- oder Rundfunksendung, einen Film oder dergleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088f238b-9e0d-4198-85f1-941c5aebbda9",
                                "sense_id": "37a815bb-3a67-317b-8e2e-3b3cf0f55e15",
                                "text": "„Diese Titelmelodie erzeugt Spannung und dunkle Vorahnungen menschlicher Erfahrung, die nur durch das Erregen von Gefühlen erfaßbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
