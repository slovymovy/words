                        {
                            "text": "<w>Flik</w> het hem maar eens om te winnen.",
                            "target_lang_translations": {
                                "ru": "Попробуй-ка <w>выиграть</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "повелительное наклонение глагола 'flikken'"
