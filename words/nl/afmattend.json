                            {
                                "target_lang_word": "grueling",
                                "target_lang_sense_clarification": "extremely tiring and demanding"
                            },
                            {
                                "target_lang_word": "draining",
                                "target_lang_sense_clarification": "causing loss of energy or strength"
                            }
