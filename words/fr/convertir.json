                        "convertir en énergie"
                    ]
                },
                {
                    "sense_id": "e4080f07-45e3-3bc7-8f55-2bb23abd9d8f",
                    "sense_definition": "Amener quelqu'un à adopter une religion ou une croyance religieuse différente.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de réflexion spirituelle, il a décidé de se <w>convertir</w> au bouddhisme."
