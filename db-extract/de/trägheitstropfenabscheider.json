                "senses": [
                    {
                        "sense_id": "dd16a459-4f8a-3923-84c6-28f1a9c7afc2",
                        "entry_id": "c54a9c34-8d20-365a-ba6b-d06bb1740900",
                        "glosses": [
                            "Vorrichtung zum Abscheiden von feinst verteilten, schwebenden flüssigen Stoffen aus Luft, Gasen oder Dämpfen bis zu einem bestimmten Grenztropfendurchmesser"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "f45f4987-154d-400e-abdc-72b6dfe52efe",
                                "sense_id": "dd16a459-4f8a-3923-84c6-28f1a9c7afc2",
                                "text": "„Das Bild oben zeigt beispielhaft das Tropfengrößenspektrum eines Siliconöls, wie es nach einem Trägheitstropfenabscheider mit Hilfe eines achtstufigen Kaskadenimpaktors […]. “"
                            },
                            {
                                "example_id": "fe7b37d5-bdee-4044-a51e-b6ed997052f5",
                                "sense_id": "dd16a459-4f8a-3923-84c6-28f1a9c7afc2",
                                "text": "„Tropfen oberhalb eines Grenztropfendurchmessers werden dabei durch Trägheitskräfte (Trägheitstropfenabscheider) abgeschieden.“"
                            },
                            {
                                "example_id": "6535ea1b-d566-42b8-a1b8-8402b02a86fa",
                                "sense_id": "dd16a459-4f8a-3923-84c6-28f1a9c7afc2",
                                "text": "„Die Hauptleistungsmerkmale der Trägheitstropfenabscheider sind die hohen Abscheideleistungen und niedrige Druckdifferenzen.“"
                            },
                            {
                                "example_id": "7bcb3bdd-5491-4bf1-bab6-5cdf971c5565",
                                "sense_id": "dd16a459-4f8a-3923-84c6-28f1a9c7afc2",
                                "text": "Bild 1 Sprühbefeuchter mit Trägheitstropfenabscheider und Gleichrichter."
                            },
                            {
                                "example_id": "932e825f-2a5c-43df-9bd0-c21b1ee2edad",
                                "sense_id": "dd16a459-4f8a-3923-84c6-28f1a9c7afc2",
                                "text": "Hürner-Funken-Trägheitstropfenabscheider dienen zur Abscheidung von Tropfen aus flüssigkeitsbeladenen Gasen. Dies geschieht aus Gründen des Umweltschutzes, der Wirtschaftlichkeit oder weil die abgeschiedenen Flüssigkeiten in Folgeprozessen störende oder nachteilige Auswirkungen hätten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
