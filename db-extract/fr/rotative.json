            {
                "entry_id": "74e88f9b-6147-3c27-bb10-750ac559d27c",
                "word": "rotative",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b345d88-4113-42c2-86f3-ab8e3de6da5f",
                        "entry_id": "74e88f9b-6147-3c27-bb10-750ac559d27c",
                        "tags": [
