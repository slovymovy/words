                    {
                        "translation_id": "c3622695-94c2-45fd-bc54-d7ecb5bd95f6",
                        "source_entry_id": "99028e84-ef4c-3bdc-ad1f-1c57feeb410b",
                        "source_sense_id": "0a191b0f-7818-34d9-b8f9-8d77947c0d65",
