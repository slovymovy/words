                        "glosses": [
                            "Membre d’une confrérie, d’un groupe ayant une cause commune."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "note": "[Alt: attention] Ne semble lié qu’à l’œuvre de J. R. R. Tolkien",
                        "examples": [
                            {
                                "example_id": "2b68a3f5-d690-4d44-8702-dd02d794a782",
                                "sense_id": "fde6a4a4-a2db-39ad-848a-502d7d9fdafb",
                                "text": "Gallen est un sédéiste d’Isengard."
                            },
                            {
                                "example_id": "d64751c0-57f3-4e8d-b8be-5fb870245c1b",
                                "sense_id": "fde6a4a4-a2db-39ad-848a-502d7d9fdafb",
                                "text": "Les groupes de gardes déferlèrent dans la [cité d’]Edoras, éclairés de torches, emprisonnant tous les sédéistes repérés fervents de l’ancien Rohan."
                            },
                            {
                                "example_id": "7da170da-8c4b-444d-8bff-e1cd0c8bbbb4",
                                "sense_id": "fde6a4a4-a2db-39ad-848a-502d7d9fdafb",
                                "text": "Derrière lui ses quatre sédéistes revêtus d’armures étincelantes aux reflets rouge sang […] Matthew vit l’épée d’un des sédéistes de l’OCF foncer vers son visage."
                            }
                        ]
                    }
