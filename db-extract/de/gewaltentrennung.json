                    {
                        "sense_id": "72318039-0e7a-3b8a-96b0-62c4b550e8fc",
                        "entry_id": "a71c7fd3-ef42-30dd-aa3d-2d3bc9cd0904",
                        "glosses": [
                            "Trennung von Exekutive, Legislative und Justiz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45d3a8f-b852-491e-b409-03cc1504eafe",
                                "sense_id": "72318039-0e7a-3b8a-96b0-62c4b550e8fc",
                                "text": "„Wesentlich ist doch, dass der Föderalismus Vielfalt in der Einheit ermöglicht(e), sodass er stabilisierend wirkt, die Demokratie durch näheren Kontakt zum Bürger fördert, die Gewaltentrennung stärkt und den Rechtsstaat intensiviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7b02ae8-334c-4ae1-98a8-048561671ba8",
                        "source_entry_id": "a71c7fd3-ef42-30dd-aa3d-2d3bc9cd0904",
                        "source_sense_id": "72318039-0e7a-3b8a-96b0-62c4b550e8fc",
                        "source_sense_description": "Trennung von Exekutive, Legislative und Justiz",
                        "target_lang_word": "separation of powers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
