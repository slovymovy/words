            "senses": [
                {
                    "sense_id": "c7e130df-54d4-3ff5-a188-41b50bc8cae9",
                    "sense_definition": "Professionnel de santé habilité à exercer la médecine et à soigner les malades.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "médecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu as de la fièvre, tu devrais aller voir le <w>docteur</w> sans attendre."
                        },
                        {
                            "text": "Le <w>docteur</w> a prescrit des antibiotiques pour soigner cette vilaine infection pulmonaire."
                        }
                    ],
                    "synonyms": [
                        "médecin",
                        "praticien",
                        "toubib",
                        "doc"
                    ],
                    "common_phrases": [
                        "aller chez le docteur",
                        "voir le docteur",
                        "appeler le docteur"
                    ]
                },
                {
                    "sense_id": "d0a2c0a0-da16-32f3-83c6-b2cc25d143ef",
                    "sense_definition": "Titulaire du grade universitaire le plus élevé, obtenu après la soutenance d'une thèse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "université",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de recherche et une brillante soutenance, elle est enfin devenue <w>docteur</w> en histoire."
                        },
                        {
                            "text": "Le jeune <w>docteur</w> a présenté ses travaux universitaires devant un jury international très attentif."
                        }
                    ],
                    "common_phrases": [
                        "docteur en sciences",
                        "nouveau docteur"
                    ]
                },
                {
                    "sense_id": "a51e8fa0-c1bf-34b4-a8d9-e0d27053b064",
                    "sense_definition": "Personne reconnue comme autorité pour enseigner ou interpréter une doctrine religieuse ou philosophique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "théologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce texte ancien a été commenté par plusieurs grands <w>docteurs</w> de la loi religieuse."
                        },
                        {
                            "text": "Saint Thomas d'Aquin est reconnu comme un éminent <w>docteur</w> de l'Église catholique."
                        }
                    ],
                    "common_phrases": [
                        "docteur de la loi",
                        "docteurs de l'Église"
                    ]
                },
                {
                    "sense_id": "5d13c0ea-1820-32d7-b855-019f9da62362",
                    "sense_definition": "Personne qui affecte d'en savoir beaucoup et qui parle ou agit avec une assurance pédante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il adore faire le <w>docteur</w> lors des réunions en donnant des leçons à tout le monde."
                        },
                        {
                            "text": "Arrête de prendre ce ton de <w>docteur</w> alors que tu ignores tout de cette affaire complexe."
