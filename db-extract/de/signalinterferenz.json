                "senses": [
                    {
                        "sense_id": "6d42f9af-05f6-3812-ab55-8c56e313f825",
                        "entry_id": "525772b6-4134-39cd-8ac1-f1f0de8ae11e",
                        "glosses": [
                            "Störung oder Beeinträchtigung eines Signals durch externe Faktoren"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "1d49ccec-aca5-407c-8b57-6bc8d4e7b5a7",
                                "sense_id": "6d42f9af-05f6-3812-ab55-8c56e313f825",
                                "text": "„Eine Signalinterferenz ließ ihn ab und zu wabern, als er sich im Raum umblickte.“"
                            },
                            {
                                "example_id": "00bac801-cba5-4bd0-8faa-32231b85cdf7",
                                "sense_id": "6d42f9af-05f6-3812-ab55-8c56e313f825",
                                "text": "„Spot Beam Antennen reduzieren die Eifallswinkel beim Empfänger für Signalumwege und reduzieren deshalb die Signalinterferenz, d. h. die Dispersion und erlauben vereinfachte (leistungsarme) Entzerrer.“"
                            },
                            {
                                "example_id": "c2872c8a-e86d-45f8-8f96-7b25dfcf3c67",
                                "sense_id": "6d42f9af-05f6-3812-ab55-8c56e313f825",
                                "text": "„Über allem lag wie eine Signalinterferenz die Erinnerung an letzten bewussten Augenblicke Bord des marsianischen Kriegsschiffs. Wir hatten eine stille, gemeinsame Störung, die noch keiner von uns genauer untersuchen wollte.“"
                            },
                            {
                                "example_id": "ca047610-1da4-4d4c-a2d8-df54ced764ee",
                                "sense_id": "6d42f9af-05f6-3812-ab55-8c56e313f825",
                                "text": "„Den geheimnisvollen Herzschlag mit der 1-Herz-Frequenz, der eine ungewöhnliche Signalinterferenz bewirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
