                                "target_senses": [
                                    {
                                        "sense_id": "a3f9d31c-c920-35b1-a9f9-966f1b5f3ab4",
                                        "entry_id": "3fe1f5f6-6364-3dd0-9e25-9310b35af923",
                                        "glosses": [
                                            "разг. то же, что психиатрическая больница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f78d80-ba87-43e3-a31f-3a586f5d1286",
                                                "sense_id": "a3f9d31c-c920-35b1-a9f9-966f1b5f3ab4",
                                                "text": "Загнав на скалу святого отца, которого после этого увезли в психушку, Бендер и Воробьянинов добрались до театра, но и в предпоследнем стуле ничего не оказалось."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
