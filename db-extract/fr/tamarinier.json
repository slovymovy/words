                    {
                        "translation_id": "ff97cb6b-a454-45c5-8ad9-2d6056f62e17",
                        "source_entry_id": "8e068d04-aab3-3823-af32-3a03733ee439",
                        "source_sense_id": "657aa17f-371d-37fa-84fe-8c3a648d8003",
