                        "bog myrtle"
                    ],
                    "common_phrases": [
                        "sweet gale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кустарник семейства Восковницевые (Myrica gale), растущий на болотах и вересковых пустошах; восковник болотный.",
                        "es": "Arbusto aromático (Myrica gale) que crece en turberas y marismas."
                    },
                    "translations": {
                        "ru": [
