                        "entry_id": "5e5b9806-2ab1-3bb4-be0e-e84a25d502a7",
                        "glosses": [
                            "beschränkter Horizont; das Bemühen, sich abzukapseln"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "49aa3cab-5737-44a5-86f4-e318fef7f87b",
                                "sense_id": "945ec10f-3c77-3bc3-99a0-923bf7c66779",
                                "text": "Die ablehnende Haltung deines Vaters gegenüber allem Neuen ist nur ein weiterer Beweis für seine ausgeprägte Greißlermentalität."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48d4bc40-8f93-3a43-8b6a-2fb1a3091dd8",
