                "senses": [
                    {
                        "sense_id": "ba722ce0-a60d-37e0-8856-b7eea055b1f3",
                        "entry_id": "2fadf367-1dec-38aa-b5ea-76d1660ce02d",
                        "glosses": [
                            "Maladie infectieuse fongique causée par un aspergille ou Aspergillus."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1684ea22-de93-42b8-9b2b-a1cb24fd40a0",
                                "sense_id": "ba722ce0-a60d-37e0-8856-b7eea055b1f3",
                                "text": "L’aspergillose est aussi une maladie infectieuse. Elle est due à un champignon, l’aspergille, qui sévit sur l’intestin grêle et le foie, y déterminant des plaques nécrosées et des nodules caséeux."
                            },
                            {
                                "example_id": "aff02d5c-078e-4cc1-8214-fcfa497ea082",
                                "sense_id": "ba722ce0-a60d-37e0-8856-b7eea055b1f3",
                                "text": "La pratique clinique montre qu’il est difficile d’asseoir avec certitude le diagnostic d’aspergillose invasive."
                            }
                        ]
                    }
                ],
