                "senses": [
                    {
                        "sense_id": "54368a69-ca8f-3faa-abad-82242d72213f",
                        "entry_id": "117a40f3-3b91-31a3-b0b8-9303f6fad0a5",
                        "glosses": [
                            "(heute meist Synonym für Plane) wetterfeste (wasserdichte) Decke, ursprünglich aus mit Teer oder Ähnlichem getränktem (imprägniertem) Gewebe (meist Segeltuch)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a24387-3d28-4ee0-816b-0837dc0c8551",
                                "sense_id": "54368a69-ca8f-3faa-abad-82242d72213f",
                                "text": "„Das Vieh trug mal wieder Persenninge gegen die Kühle der Nacht, gegen den kühlen Regen.“"
                            },
                            {
                                "example_id": "78721a0b-1b60-429a-b64e-f62e8bb8fbaf",
                                "sense_id": "54368a69-ca8f-3faa-abad-82242d72213f",
                                "text": "„Es wimmelte von Ständen, kleinen Bretterbuden mit einem Dach darüber, das oft nur aus einer Persenning bestand.“"
                            },
                            {
                                "example_id": "8c1183a7-af05-4ec2-baa6-27e3eb75bb4f",
                                "sense_id": "54368a69-ca8f-3faa-abad-82242d72213f",
                                "text": "„Der Turm ist noch nicht ganz durchgeschlüpft, da fallen auch schon von beiden Seiten die schweren Persenninge klatschend wieder zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeece4cd-4352-4be7-b387-91bfdb903068",
                        "source_entry_id": "117a40f3-3b91-31a3-b0b8-9303f6fad0a5",
                        "source_sense_id": "54368a69-ca8f-3faa-abad-82242d72213f",
