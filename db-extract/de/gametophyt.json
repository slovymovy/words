                "senses": [
                    {
                        "sense_id": "90140539-34b6-3f2f-9dcf-38250388ab60",
                        "entry_id": "175dc2e7-58fa-3149-a558-07dc74ff8cb6",
                        "glosses": [
                            "die sexuelle, Gameten-bildende und damit haploide Phase bei diplohaplontischen Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a73a5b9b-f9d8-42a9-9c91-ab8a001bd41a",
                                "sense_id": "90140539-34b6-3f2f-9dcf-38250388ab60",
                                "text": "„… Diese Form des Kernphasenwechsel ist mit dem Alternieren einer haploiden Generation (Gametophyt, Gamont) und einer diploiden Generation (Sporophyt, Agamont) – also mit einem heterophasischen Generationswechsel – verbunden.“"
                            },
                            {
                                "example_id": "a6196a11-57f3-4107-a6af-a54985e9525e",
                                "sense_id": "90140539-34b6-3f2f-9dcf-38250388ab60",
                                "text": "„Bei den meisten Pflanzen sind Gametophyten und Sporophyten deutlich voneinander unterscheidbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
