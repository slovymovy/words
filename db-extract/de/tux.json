                        "sense_id": "b46d01c9-ed1d-3667-bf6e-c67ed87c0ea7",
                        "entry_id": "5be68df2-9f42-378d-9447-e6f29b290edd",
                        "glosses": [
                            "wohlgenährter, glücklicher, rundlicher Pinguin, der das offizielle Maskottchen des freien Betriebssystemkerns Linux ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e0c83a-5bdb-4b58-b7cf-212c2c901ae8",
                                "sense_id": "b46d01c9-ed1d-3667-bf6e-c67ed87c0ea7",
                                "text": "Der ursprüngliche Entwurf für Tux erfolgte 1996 durch Larry Ewing."
                            },
                            {
                                "example_id": "47c143f1-d873-4c17-9eb7-973b77f15dc5",
                                "sense_id": "b46d01c9-ed1d-3667-bf6e-c67ed87c0ea7",
                                "text": "„Linux hat ein neues Maskottchen - Tuz, ein Tasmanischer Teufel mit aufgesetztem Schnabel, wird Tux, den Pinguin ersetzen. Allerdings nur bei der kommenden Linux-Version 2.6.29.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
