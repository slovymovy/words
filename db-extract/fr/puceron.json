        "fr-extract.jsonl": [
            {
                "entry_id": "f93e02ac-5e6d-3f2a-a269-b38861989a31",
                "word": "puceron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1fe0f9a2-568a-43bc-9d53-cefb8dbfea31",
                        "entry_id": "f93e02ac-5e6d-3f2a-a269-b38861989a31",
                        "tags": [
                            "plural"
                        ],
                        "form": "pucerons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bd4efee-06a4-309c-9598-b403e15851e7",
                        "entry_id": "f93e02ac-5e6d-3f2a-a269-b38861989a31",
                        "glosses": [
                            "Espèce d’insecte dont la larve s’attache aux feuilles et aux rameaux des plantes et qui en suce la sève."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142e1501-789d-46c7-b216-e0659cac7b6e",
                                "sense_id": "5bd4efee-06a4-309c-9598-b403e15851e7",
                                "text": "Pour d’autres, nous comptons au moins une génération de mâles, espèces dites « holocycliques », comme chez le puceron noir de la fève."
                            },
                            {
                                "example_id": "3591bc79-c493-424f-bb26-1ca475e9f3a9",
                                "sense_id": "5bd4efee-06a4-309c-9598-b403e15851e7",
                                "text": "Ce sont les larves des pucerons qui, réunies en familles innombrables, recouvrent quelquefois des branches entières de nos arbres fruitiers, la tige de nos fleurs, de nos légumes."
                            },
                            {
                                "example_id": "b59d6cae-920a-4fdd-9883-1ebb4f886349",
                                "sense_id": "5bd4efee-06a4-309c-9598-b403e15851e7",
                                "text": "On sait que les pucerons tirent leur alimentation du phloème ; ils rejettent la sève en excès, sous forme de gouttelettes de miellat."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cfc67f1-a997-3ed8-9fd4-583e2d8b9aba",
                        "entry_id": "f93e02ac-5e6d-3f2a-a269-b38861989a31",
                        "glosses": [
                            "Cette larve elle-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff5b7c36-cbc5-454d-a1d3-48391c59a81c",
                        "source_entry_id": "f93e02ac-5e6d-3f2a-a269-b38861989a31",
                        "target_lang_word": "Blattlaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blattlaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                        "entry_id": "1d3068f5-7ee1-3765-af48-490d3745310d",
                                        "glosses": [
                                            "kleines, schädliches Insekt, das sich von Pflanzensaft ernährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b537bad0-ef64-48bf-8b07-7a2247cc5cf2",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "Die Blattlaus lebt vom Saft der Blätter und dadurch schädigt sie die Pflanzen."
                                            },
                                            {
                                                "example_id": "a6acc585-a885-47cc-8460-d04868c90bb7",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "Ameisen pflegen und melken die Blattläuse, weil sie den Saft für ihre eigene Brut verwenden."
                                            },
                                            {
                                                "example_id": "7afa7ac5-72f7-4979-8b7e-785933e76dee",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "Die Blattläuse scheiden Honigtau aus."
                                            },
                                            {
                                                "example_id": "7ea23cd4-9711-4f11-9aab-e603fe36d1e8",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "„Ohrwürmer verzehren große Mengen von Blattläusen.“"
                                            },
                                            {
                                                "example_id": "472833c6-0c1e-4f91-9292-d3982c0c9289",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "„Bei der Jungfernzeugung (Parthogenese) entwickeln sich auch unbefruchtete Eier (z.B. bei den Bienen und Blattläusen).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
