        "pl-extract.jsonl": [
            {
                "entry_id": "19ba96aa-e670-3f4b-8323-606580853742",
                "word": "drzewiej",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                        "entry_id": "19ba96aa-e670-3f4b-8323-606580853742",
                        "glosses": [
                            "wcześniej, dawniej, kiedyś w przeszłości"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d3f13df7-7ae0-493d-8fce-2f650007b161",
                                "sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                                "text": "Chodźcie, dzieci, dziadek wam opowie, jak to drzewiej bywało."
                            },
                            {
                                "example_id": "7b05cf10-bf20-4fd3-a483-ca0f88a406c9",
                                "sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                                "text": "Tak oto wchodzimy w Góry Polskie, w które drzewiej wdzierali się pionerzy i osadnicy, karczując bór, siejąc płone zboże[,] i wypasując bydło"
                            },
                            {
                                "example_id": "631c4259-0606-4bb6-affc-797e2d810664",
                                "sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                                "text": "Drzewiej było tu inaczej, inaczej. Kiedyś, przed dawnymi laty ziemie te miodem płynęły i mlekiem"
                            },
                            {
                                "example_id": "bf9e94a5-2604-4b73-a05c-db79898ab2f7",
                                "sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                                "text": "Grube, przerażające murzyska mają we framugach zakratowane okna, w poprzek tychże były drzewiej belki, do których przywiązywano skazańca"
                            },
                            {
                                "example_id": "146c0a1e-8425-4ab5-9764-2e350e2cd9fb",
                                "sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                                "text": "Drzewiéj tu u nas inaczéj bywało: / Gdzie dziś doliny, tam jezioro stało, [/ Po „Gorzec” tylko zbiérała miód pszczoła, / A Tatry Dunaj obléwał dokoła.]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92bd5d47-115b-4d27-8dbf-003033ee2639",
                        "source_entry_id": "19ba96aa-e670-3f4b-8323-606580853742",
                        "source_sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                        "target_lang_word": "beforetime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beforetime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e848fabc-c4c4-36a6-9f27-ed34d3169441",
                                        "entry_id": "9075ff71-793b-3a51-b953-23d74bf8f2c9",
                                        "glosses": [
                                            "Formerly, previously."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e994692a-14c7-4dba-a5b6-b6249136c9c5",
                                                "sense_id": "e848fabc-c4c4-36a6-9f27-ed34d3169441",
                                                "text": "There was a certayne man called Simon, which beforetyme in the same cite, used witchecrafte and bewithched the people, sayinge that he was a man that coulde do greate thinges."
                                            },
                                            {
                                                "example_id": "72ae7b04-1b57-49fd-bbb3-2cce17f1d876",
                                                "sense_id": "e848fabc-c4c4-36a6-9f27-ed34d3169441",
                                                "text": "Thou shalt see\nGold tarnished, and the grey above the green\nAnd as the thing thou seest thy face shall be\nAnd no more as the thing beforetime seen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbb15d6f-153c-419f-b481-cfa9aa744c4f",
                        "source_entry_id": "19ba96aa-e670-3f4b-8323-606580853742",
                        "source_sense_id": "db6c0a0f-1325-3603-aa2b-b38c1dac3f9e",
                        "target_lang_word": "dříve",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dříve",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbd7ec3-2831-310b-a66f-64f88043566a",
                                        "entry_id": "691ebe5f-f9d6-3fa8-9a60-ebdb9d3f3c98",
                                        "glosses": [
                                            "před očekávanou dobou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3a51b0-3b8f-45dc-b2cc-c70c041fc3c9",
                                                "sense_id": "6bbd7ec3-2831-310b-a66f-64f88043566a",
                                                "text": "Přišel dříve, než jsme ho čekali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f53d253-6763-3c26-8bfd-fba1c998964c",
                                        "entry_id": "691ebe5f-f9d6-3fa8-9a60-ebdb9d3f3c98",
                                        "glosses": [
                                            "v minulosti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3874b5e2-ef80-4284-afb2-d3203b4ec29d",
                                                "sense_id": "6f53d253-6763-3c26-8bfd-fba1c998964c",
                                                "text": "Dříve chodil s námi, teď už se s námi nebaví."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7365140-36ca-36dc-9b0a-7a642c86aa1f",
                                        "entry_id": "691ebe5f-f9d6-3fa8-9a60-ebdb9d3f3c98",
                                        "glosses": [
                                            "raději"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8262f61-337c-4eeb-9c3c-5986bd504463",
                                                "sense_id": "b7365140-36ca-36dc-9b0a-7a642c86aa1f",
                                                "text": "Dříve bych ze skály skočila, než se za tebe provdat!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
