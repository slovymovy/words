                        "examples": [
                            {
                                "example_id": "0292345b-b44e-4139-9aed-fc55a00cc419",
                                "sense_id": "0f056b3e-bcd1-31d9-95c6-6f9141172001",
                                "text": "„Stattdessen erforschen Ingenieur:innen [sic] flüssigkeitsgekühlte dreidimensionale Supercomputer, die sich am Aufbau unseres Gehirns orientieren.“"
                            },
                            {
                                "example_id": "e6c10cce-cea9-441b-a87e-c69408e202be",
                                "sense_id": "0f056b3e-bcd1-31d9-95c6-6f9141172001",
                                "text": "„Die Schuhe sind flüssigkeitsgekühlt, was will man mehr?“"
                            },
