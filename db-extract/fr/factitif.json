                "senses": [
                    {
                        "sense_id": "6014447b-b976-31e5-933c-39ae0184a68f",
                        "entry_id": "0b74142e-c4dd-3737-b6f4-58b54e1cc1a2",
                        "glosses": [
                            "causative; factitive (said of a verb where the subject is made to do the action)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8f80ce-0f61-4119-a144-fc4a21f8ac76",
                                "sense_id": "6014447b-b976-31e5-933c-39ae0184a68f",
                                "text": "Il faut distinguer forme factitive du verbe et son sens factitif. Ainsi, un verbe comme « construire » peut être employé dans un sens factitif: Pierre construit une maison en banlieue. [Il la construit lui-même, ou il la fait construire, selon le cas].",
                                "translation": "It is necessary to distinguish between the factitive form of the verb and its factitive meaning. In this way, a verb such as “construire” can be used in a factitive sense: Pierre is building a house in the suburbs. [He builds it himself, or he has it built, depending on the case].",
                                "english": "It is necessary to distinguish between the factitive form of the verb and its factitive meaning. In this way, a verb such as “construire” can be used in a factitive sense: Pierre is building a house in the suburbs. [He builds it himself, or he has it built, depending on the case]."
                            }
                        ]
                    }
                ],
