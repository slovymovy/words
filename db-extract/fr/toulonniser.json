                "senses": [
                    {
                        "sense_id": "986ebc84-f725-3cdd-8ee0-1d27cd364ad4",
                        "entry_id": "ca848cfb-4a55-3924-b271-50ccd0fb12bd",
                        "glosses": [
                            "Donner un caractère toulonnais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11140ee-fb51-4037-86a1-fb39a9c934b3",
                                "sense_id": "986ebc84-f725-3cdd-8ee0-1d27cd364ad4",
                                "text": "Étonnant de voir des supporters oyonnaxiens se toulonniser :)"
                            },
                            {
                                "example_id": "593e2f2c-e14e-47e9-bc46-2449697d7019",
                                "sense_id": "986ebc84-f725-3cdd-8ee0-1d27cd364ad4",
                                "text": "Pour cela, il faut des joueurs qui viennent aussi avec le coeur, qui ont envi de se laisser \"toulonniser\" comme d'autres se sont toulousisés."
                            },
                            {
                                "example_id": "94a11e41-ce2b-4b40-b68c-b7c8cd8c928a",
                                "sense_id": "986ebc84-f725-3cdd-8ee0-1d27cd364ad4",
                                "text": "Oh, merde, on va se faire \"toulonniser\" pendant un moment."
                            },
                            {
                                "example_id": "392b8928-e739-445a-b9c3-53b65dcab26f",
                                "sense_id": "986ebc84-f725-3cdd-8ee0-1d27cd364ad4",
                                "text": "2 pétitions: une contre Amritage et l'autre contre le recrutement de ce genre de stars qui va \"toulonniser\" notre club."
                            },
                            {
                                "example_id": "d47d4582-b26f-416a-9f96-91f424fe12b9",
                                "sense_id": "986ebc84-f725-3cdd-8ee0-1d27cd364ad4",
                                "text": "Il a intérêt à se Toulonniser, parce que nous nous Laporteriserons pas !!"
                            }
                        ]
                    }
