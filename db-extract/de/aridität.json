                "senses": [
                    {
                        "sense_id": "23fc538a-bdeb-3565-9664-6d5de7f554a3",
                        "entry_id": "267ed6ea-0ee2-390a-93f7-bfb3828a37b0",
                        "glosses": [
                            "Eigenschaft des Klimas, trocken (arid) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb00cad1-449d-4fb7-bbe4-024da8d07c4e",
                                "sense_id": "23fc538a-bdeb-3565-9664-6d5de7f554a3",
                                "text": "„Die Aridität, d. h. das Überwiegen der Verdunstung über den Niederschlag kennzeichnet diesen Raum im Klimatischen – und als Folge davon auch in seiner potentiellen natürlichen Vegetation – grundlegend und mit deutlichem Unterschied zu Europa.“"
                            },
                            {
                                "example_id": "a6976056-7acf-47d9-a925-10bdc1f18ca7",
                                "sense_id": "23fc538a-bdeb-3565-9664-6d5de7f554a3",
                                "text": "„Ein weiterer Zweig der effektiven Klassifikationen beschäftigte sich mit der Wasserhaushaltsbetrachtung bezüglich Humidität und Aridität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
