                        "cross_references": [
                            {
                                "target_word": "bestuurbaarheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "efbe7724-d5a6-3f59-aa96-12e7ba612b97",
                                        "entry_id": "6667e036-7eaf-3f2d-b7b7-5e3f8e9d1732",
                                        "glosses": [
                                            "de mate waarin iets of iemand geleid kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d235dfa6-28ac-4b87-93b6-27b16d292072",
                                                "sense_id": "efbe7724-d5a6-3f59-aa96-12e7ba612b97",
                                                "text": "Maar de minister van Onderwijs, Jet Bussemaker, heeft toegezegd de ROC's te helpen en welwillend naar de plannen te kijken. Wel heeft Bussemaker nog vragen over de financiële haalbaarheid en de bestuurbaarheid van de vakscholen. Ze wil voorkomen dat er extra bestuurslagen ontstaan."
                                            },
                                            {
                                                "example_id": "da24dc94-57f7-47cd-91c6-c80988d8b810",
                                                "sense_id": "efbe7724-d5a6-3f59-aa96-12e7ba612b97",
                                                "text": "Op het provinciehuis ziet men die verscheidenheid helemaal niet als verrijking. Met zoveel kleine partijen is het moeilijk om stabiele coalities te vormen. Boele Staal, commissaris van de Koning in Overijssel, vreest voor de bestuurbaarheid van de gemeente Almelo."
                                            },
                                            {
                                                "example_id": "35f11a62-1fde-4c84-896e-0057981a9b0a",
                                                "sense_id": "efbe7724-d5a6-3f59-aa96-12e7ba612b97",
                                                "text": "Volgens Noord-Korea is de test van gisteren met het Hwasong-8-systeem goed verlopen. \"In de eerste testlancering bevestigden de nationale defensiespecialisten de bestuurbaarheid en stabiliteit van de raket\", staat in het KCNA-bericht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
