            "senses": [
                {
                    "sense_id": "63e79c27-c525-3b1d-aa51-a1e199994b2d",
                    "sense_definition": "present participle of <w>tamper</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician noticed that someone was <w>tampering</w> with the security lock.",
                            "target_lang_translations": {
                                "ru": "Техник заметил, что кто-то <w>пытался вскрыть</w> замок безопасности."
                            }
                        },
                        {
                            "text": "He was arrested for <w>tampering</w> with critical evidence before the trial began.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за <w>манипуляции</w> с важнейшими уликами до начала судебного процесса."
                            }
                        }
                    ],
                    "synonyms": [
                        "meddling",
                        "interfering"
                    ],
                    "common_phrases": [
                        "tampering with evidence",
                        "tampering with the system"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола «tamper» (вмешиваться, портить, подделывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешивающийся",
                                "target_lang_sense_clarification": "причастие от вмешательства или манипуляций"
                            },
                            {
                                "target_lang_word": "трогающий",
                                "target_lang_sense_clarification": "без разрешения трогающий что-либо"
                            },
                            {
                                "target_lang_word": "манипулирующий",
                                "target_lang_sense_clarification": "незаконно или скрытно изменяющий что-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac56d406-e535-3130-a2ec-a4a46864d610",
                    "sense_definition": "The act of improperly interfering or meddling with something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The package showed clear signs of <w>tampering</w> when it arrived.",
                            "target_lang_translations": {
                                "ru": "Когда посылка прибыла, на ней были явные следы <w>вскрытия</w>."
                            }
                        },
                        {
                            "text": "Investigators found evidence of unlawful <w>tampering</w> with the voting machines.",
                            "target_lang_translations": {
                                "ru": "Следователи обнаружили доказательства незаконного <w>вмешательства</w> в работу машин для голосования."
                            }
                        }
                    ],
                    "synonyms": [
                        "meddling",
                        "interference"
                    ],
                    "common_phrases": [
                        "signs of tampering",
                        "evidence of tampering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несанкционированное или ненадлежащее вмешательство, порча или изменение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешательство",
                                "target_lang_sense_clarification": "несанкционированное изменение или воздействие"
                            },
                            {
                                "target_lang_word": "взлом",
                                "target_lang_sense_clarification": "несанкционированный доступ или вскрытие"
                            },
                            {
                                "target_lang_word": "подделка",
                                "target_lang_sense_clarification": "фальсификация (например, улик)"
                            },
                            {
                                "target_lang_word": "вскрытие",
                                "target_lang_sense_clarification": "несанкционированное нарушение целостности упаковки или замка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
