                    {
                        "sense_id": "a1c7015c-f684-3f84-bd73-a46709ff2b9b",
                        "entry_id": "42bc2e08-535f-3134-87ca-509ee8e115a0",
                        "glosses": [
                            "Étoile qui devient extrêmement brillante pendant quelques jours par une explosion thermonucléaire sur la surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f487fb4-2a25-47fd-aea4-ce4c4712c138",
                                "sense_id": "a1c7015c-f684-3f84-bd73-a46709ff2b9b",
                                "text": "Pour être observable, l’enveloppe d’une nova doit avoir une dimension assez grande: il faut attendre généralement une dizaine d’années pour qu’il en soit ainsi. De plus, à ce moment-là, sa brillance de surface doit être suffisante pour rendre sa détection possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "875b4955-c366-367f-9e96-dbcf233a5116",
