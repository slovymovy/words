                ],
                "senses": [
                    {
                        "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                        "entry_id": "45967b16-f26a-3aee-8a5c-fd60f4006c6f",
                        "glosses": [
                            "Luft, in Räumen und Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c2d2d55-5c02-4a7f-920b-e14db251088e",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "Die Raumluft in Krankenhäusern muss bestimmte Anforderungen erfüllen. Im OP unterliegt dies gar einer Reinraumklasse."
                            },
                            {
                                "example_id": "793c834e-3333-46ef-be20-27a7bfe51dae",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "„[…] Raumluft auch im Zusammenhang mit dem Sick-Building-Syndrom (SBS) zu einer Verbesserung der Raumluftqualität und einer niedrigeren Wahrscheinlichkeit für SBS beitragen kann.“"
                            },
                            {
                                "example_id": "ee7d6f82-ba95-43a4-a988-a89e5daa8890",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "„Schadstoffe und Geruchsstoffe in der Raumluft können gemessen und mit den in verschiedenen Normen und Arbeitsblättern aufgeführten Grenzwerten verglichen werden“"
                            },
                            {
                                "example_id": "015ff957-9c6e-4646-939c-ce8439e23184",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "„Mit unserem Schimmel-Check Raumluft kann eine Schimmelpilzbelastung im Innenraum auf einfache Weise untersucht werden.“"
                            },
                            {
                                "example_id": "c0e98e2c-8997-4eaa-8e7e-40a45aab8381",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "„Wir ermitteln mögliche Schadstoffquellen (Gebäude-/Materialuntersuchungen), messen die vorhandene Belastung der Raumluft, bewerten die Ergebnisse und empfehlen sowie überprüfen Sanierungsmaßnahmen.“"
                            },
                            {
                                "example_id": "ac091aad-e983-4d17-8d25-c067231f7366",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "„Bei der Frage, ob die Symptome und Beschwerden die Sie oder Ihre Lieben erleiden müssen mit Ihrer Raumluft zu tun haben, werden Ihnen die folgenden Artikel sicher weiterhelfen.“"
                            },
                            {
                                "example_id": "4b79ed68-971a-43cf-a628-6e01e4ebb424",
                                "sense_id": "60176850-e723-3db3-a35b-13939f3f6eed",
                                "text": "„Über dicke Luft in Innenräumen mach(t)en sich viele jedoch kaum Gedanken. Dabei stört zu viel CO2 in der Raumluft die Konzentration erheblich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
