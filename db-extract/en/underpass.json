    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                "word": "underpass",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f628c84e-f7d6-4f87-93b7-79d243f5aed6",
                        "entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                        "tags": [
                            "plural"
                        ],
                        "form": "underpasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                        "entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                        "glosses": [
                            "A passage that crosses a road, railroad or similar obstacle in a tunnel underneath it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0334ddbd-dcf8-4302-a4ee-ca949b615f30",
                                "sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                                "text": "Underpass / Underpass / Over all the bridges / Echoes in rows / Talking at the same time / Click click drone"
                            },
                            {
                                "example_id": "86ed4293-c9df-4229-a822-405f95c3c4c8",
                                "sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                                "text": "And in the darkened underpass / I thought oh God, my chance has come at last / But then a strange fear gripped me and I just couldn't ask"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5485ac8-296f-46bb-8c41-63a5bf235328",
                        "source_entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                        "source_sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                        "source_sense_description": "passage",
                        "target_lang_word": "podchod",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe617805-5f02-462f-9421-bf7dca5e61ac",
                        "source_entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                        "source_sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                        "source_sense_description": "passage",
                        "target_lang_word": "passage souterrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passage souterrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20662cfe-6500-3c4b-8cb8-65f3401e6b79",
                                        "entry_id": "e63ef517-3c09-386c-9e6b-d9f6219397d1",
                                        "glosses": [
                                            "Chemin de circulation qui passe en dessous d'une voie de circulation plus importante, afin d'éviter l'intersection des circulations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91cfbeb5-0b6c-4715-8d5a-90a601ed95d8",
                                                "sense_id": "20662cfe-6500-3c4b-8cb8-65f3401e6b79",
                                                "text": "Dès cette époque, la circulation dans Paris avait pris de telles proportions que des passages souterrains pour les voitures commencèrent à être réalisés pour sauvegarder certains emplacements. C'est ainsi que vers 1930 fut créé à la Porte Dauphine un passage qui subsiste aujourd'hui gardant un aspect peu aimable et d'un caractère purement utilitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f638eb29-5c63-3f34-a99b-eca9a37dba38",
                                        "entry_id": "e63ef517-3c09-386c-9e6b-d9f6219397d1",
                                        "glosses": [
                                            "Passage piétonnier sous une voie principale routière ou ferroviaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c12b68d-28e2-4761-baf2-715d19d843f7",
                                                "sense_id": "f638eb29-5c63-3f34-a99b-eca9a37dba38",
                                                "text": "A quoi servait ce passage clouté, cependant indispensable pour gagner le monument fameux, à défaut d'un passage souterrain encore en construction, s'il était, en fait, mortellement dangereux de s'y aventurer ?"
                                            },
                                            {
                                                "example_id": "8abc1a5f-159c-44aa-9e54-71b4842f4f41",
                                                "sense_id": "f638eb29-5c63-3f34-a99b-eca9a37dba38",
                                                "text": "Pourtant, l'importance du trafic des trains de voyageurs fera apparaître un défaut majeur : l'absence de passage souterrain. Depuis 1906 et pendant plusieurs années, on réclamait avec insistance son établissement, d'autant plus que ce type de construction avait déjà été réalisé dans d'autres gares de moindre importance de la région."
                                            },
                                            {
                                                "example_id": "45088497-9202-480b-b6d1-087e248aacce",
                                                "sense_id": "f638eb29-5c63-3f34-a99b-eca9a37dba38",
                                                "text": "Mais, à pied, le chemin le plus rapide l'obligeait à traverser le parc et à prendre le passage souterrain. Normalement, Nin évitait le passage souterrain comme la peste. Mais, aujourd'hui, elle allait tenter le coup."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "283de382-707f-48d0-b3bf-e2c06f8d13ff",
                        "source_entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                        "source_sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                        "source_sense_description": "passage",
                        "target_lang_word": "souterrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souterrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57e2acee-b50c-37fc-8a7e-1985c156f8a7",
                                        "entry_id": "f6fac749-7cff-3936-889c-81300d80b075",
                                        "glosses": [
                                            "Qui est sous terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7ae588-62ce-41bf-8b86-e1d6e3afd985",
                                                "sense_id": "57e2acee-b50c-37fc-8a7e-1985c156f8a7",
                                                "text": "Il n'y a dans l’empire souterrain ni moissons, ni riches vignobles; on y voit le farouche Cerbère, et le hideux nocher du Styx. C'est là que les joues meurtries, et les cheveux consumés par les flammes, la pâle troupe des Ombres erre autour des lacs ténébreux."
                                            },
                                            {
                                                "example_id": "70ce8bb6-ea25-4110-8d70-4ebf7f8a3516",
                                                "sense_id": "57e2acee-b50c-37fc-8a7e-1985c156f8a7",
                                                "text": "Par exemple le travail souterrain dans les mines et les carrières est de plus en plus et dans la plupart des pays soumis à la surveillance de l’Etat."
                                            },
                                            {
                                                "example_id": "7d7d5557-ba48-4472-b8a2-513f06cbcf7e",
                                                "sense_id": "57e2acee-b50c-37fc-8a7e-1985c156f8a7",
                                                "text": "Les éboulis imposent une biologie très spéciale, car de grandes parties souterraines doivent permettre à la plante de se fixer malgré le milieu mouvant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26cdfba2-9646-3766-891e-6202a0f25910",
                                        "entry_id": "f6fac749-7cff-3936-889c-81300d80b075",
                                        "glosses": [
                                            "Qualifie des pratiques invisibles dont le résultat n’est perceptible qu’après un long processus."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28af5511-1b1c-458e-9c81-b09a387f0795",
                                                "sense_id": "26cdfba2-9646-3766-891e-6202a0f25910",
                                                "text": "C’est un travail souterrain, un lent cheminement, qui, une fois la première étincelle allumée, le premier élan impulsé, poursuit sa route, tout seul, sans dévier, sans pour autant qu’un seul indice ne soit ne soit apparent, ne trahisse sa présence en surface"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91c36e10-077f-3266-a22a-94ff29391497",
                                        "entry_id": "f6fac749-7cff-3936-889c-81300d80b075",
                                        "glosses": [
                                            "Qualifie des pratiques cachées pour parvenir à ses fins."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac880bb-d96c-43f5-ac15-6935e420a096",
                                                "sense_id": "91c36e10-077f-3266-a22a-94ff29391497",
                                                "text": "Des menées souterraines."
                                            },
                                            {
                                                "example_id": "5bb553e1-d9b5-481b-a2f7-5a1e9648f0cc",
                                                "sense_id": "91c36e10-077f-3266-a22a-94ff29391497",
                                                "text": "Le patron jouait aux cartes avec deux femmes, près du comptoir, deux femmes qui appartenaient manifestement à la race souterraine qu’on rencontre la nuit dans les rues."
                                            },
                                            {
                                                "example_id": "bcc39903-8751-48e3-a6ff-36d96cd7d043",
                                                "sense_id": "91c36e10-077f-3266-a22a-94ff29391497",
                                                "text": "Dans quel monde vivent donc les politiciens d’aujourd’hui, qui ne peuvent ignorer les courants souterrains d’un populisme et des mouvements extrémistes, déstabilisateurs de nos démocraties chancelantes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759764c6-b052-38f1-a72b-e5a1f6cd1e47",
                                        "entry_id": "f6fac749-7cff-3936-889c-81300d80b075",
                                        "glosses": [
                                            "Qualifie un pan de l’économie dont les activités légales se développent en dehors des règles juridiques et fiscales d’un pays et échappent ainsi à toute comptabilisation et taxation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895e7df4-936c-4075-a2cd-17d46e3ab3a1",
                                                "sense_id": "759764c6-b052-38f1-a72b-e5a1f6cd1e47",
                                                "text": "L’économie souterraine, que nous avons évaluée à 10% des ressources 3, comprend tout d’abord du travail au noir, ensuite des activités de ferraillage, de mécanique, de récupération, enfin de jardinage et d’élevage."
                                            },
                                            {
                                                "example_id": "50c20855-472e-4da8-b6bc-3623c622705a",
                                                "sense_id": "759764c6-b052-38f1-a72b-e5a1f6cd1e47",
                                                "text": "Ce surplus, qui a déréglé les balances de presque tous les plans quinquennaux, indiquait un marché du travail souterrain, et mal maîtrisé, ce qui démentait totalement les justifications que le régime donnait de son propre fonctionnement."
                                            },
                                            {
                                                "example_id": "7fbd4a9f-5a37-4077-af45-7dc1b07a3a38",
                                                "sense_id": "759764c6-b052-38f1-a72b-e5a1f6cd1e47",
                                                "text": "La part de l’économie souterraine n’est pas négligeable ; la culture d’un bout de jardin, l’élevage de quelques animaux sont pratiques courantes dans ce milieu rural et les solidarités locales favorisent le recours au travail au noir"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "souterrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39f9b828-b482-353d-8878-bf105b6a9b2f",
                                        "entry_id": "1a4ca41a-b12a-3c12-9d3f-b54d6c8608d8",
                                        "glosses": [
                                            "Passage pratiqué sous terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a143d3-250e-4f3a-b872-28cb47dec43e",
                                                "sense_id": "39f9b828-b482-353d-8878-bf105b6a9b2f",
                                                "text": "[…], on descendit dans des caves, on suivit des souterrains dont les parois, cotonnées par les fleurs du nitre, […]."
                                            },
                                            {
                                                "example_id": "e3587e6c-54e2-4764-a19c-48acbaa1ddc4",
                                                "sense_id": "39f9b828-b482-353d-8878-bf105b6a9b2f",
                                                "text": "[…] et sa voix monotone me narrait, avec une complaisance affreuse, la mort, dans le souterrain du palais du gouverneur, de plusieurs familles et d’une ribambelle d’enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "979bdd4f-d8e3-466d-94d6-32b437ecb272",
                        "source_entry_id": "e108f353-11e0-3926-9cf3-2a0af8352917",
                        "source_sense_id": "54c0fb67-cb03-3c12-96d8-b45a7b00eed3",
                        "source_sense_description": "passage",
                        "target_lang_word": "Unterführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                        "entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                                        "glosses": [
                                            "Verkehrsweg, der unter einem anderen hindurchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7f5682-9719-4720-b0c1-41c0d3b0a001",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "Um zum Krankenhaus zu kommen, musste er die Unterführung passieren."
                                            },
                                            {
                                                "example_id": "f6096d43-9769-4ebb-b79b-e42222676e61",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "„Wir gelangen über einen Baustellenpfad aus der Unterführung hinaus auf den Bahnhofsvorplatz.“"
                                            },
                                            {
                                                "example_id": "e4913f72-7197-489f-9386-14cd51a40d4d",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "„Morgens zogen sie schweigsam los, vorbei an der Sandkiste und durch die große Unterführung hindurch.“"
                                            },
                                            {
                                                "example_id": "938be085-1d18-4c17-b6cf-84245d1c3eca",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "„In der Unterführung am Zentralplatz war eine Zoohandlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
