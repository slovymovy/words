                    "frequency": "Low",
                    "semantic_group_id": "pregnancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old novel, the character was described as being <w>big</w> with child.",
                            "target_lang_translations": {
                                "ru": "В старом романе героиня описывалась как <w>тяжелая</w> плодом."
                            }
