                        "translation_id": "ddbd6e99-49a6-447a-8ead-ef6bfcb6264b",
                        "source_entry_id": "a0898a84-d7de-3309-92de-fec452996555",
                        "source_sense_id": "f893d9eb-fe0a-37cd-96e4-1778e1c51602",
                        "target_lang_word": "чудотво́рец",
                        "target_lang_code": "ru",
