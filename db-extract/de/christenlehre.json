                "senses": [
                    {
                        "sense_id": "a9f70663-0c3e-30e2-9da9-a50bce6e0382",
                        "entry_id": "75dba902-aff5-35da-adc2-5b5b5aa93db2",
                        "glosses": [
                            "meist evangelischer Religionsunterricht für Jugendliche oder Erwachsene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b5882a-b3ab-47ff-a4a0-953d5310fe3e",
                                "sense_id": "a9f70663-0c3e-30e2-9da9-a50bce6e0382",
                                "text": "„Der Firmung geht die Christenlehre voraus, an der die Kinder im jugendlichen, unschuldigen Alter teilnehmen.“"
                            },
                            {
                                "example_id": "42d9024f-4dc3-47b2-a5dd-565265c6a2d8",
                                "sense_id": "a9f70663-0c3e-30e2-9da9-a50bce6e0382",
                                "text": "„Eines Tages schlugen mir meine Eltern nämlich vor, die Christenlehre zu besuchen.“"
                            },
                            {
                                "example_id": "636410db-e598-430f-b6b6-01ba5889ba39",
                                "sense_id": "a9f70663-0c3e-30e2-9da9-a50bce6e0382",
                                "text": "„Zur Sommerszeit, an Sonntagsnachmittagen pflegt sich in einem der drei Dörfer die Gemeinde zu versammeln, und der Pfarrer hält ihr im Freien eine Christenlehre.“"
                            },
                            {
                                "example_id": "2ff5fab1-171a-45d6-be9b-174996a93bad",
                                "sense_id": "a9f70663-0c3e-30e2-9da9-a50bce6e0382",
                                "text": "„In der Wohnung reiht sich Bücherregal an Bücherregal, daneben steht ein Klavier, an dem die Kinder üben, wenn sie nicht gerade beim Tennis oder zur Christenlehre in der Gemeinde sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
