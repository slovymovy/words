                        "sense_id": "5c8040eb-2100-326d-8e64-305cdb37fd62",
                        "entry_id": "2cbdfc65-e1f4-3cfc-8362-fbcfbf0fd168",
                        "glosses": [
                            "Anzahl der unterschiedlichen Einzelbilder pro Zeiteinheit, aus denen ein Film oder ein anderes bewegtes Bild besteht"
                        ],
                        "tags": [
                            "Filmtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "52df404d-4999-4c12-910c-7ba401bb26d1",
                                "sense_id": "5c8040eb-2100-326d-8e64-305cdb37fd62",
                                "text": "„Dabei wird der Vorgang mit einer Spezialkamera mit extrem kurzen Belichtungszeiten (10⁻⁶ bis 10⁻⁹ Sekunden) oder mit außerordentlich hoher Bildwechselfrequenz aufgenommen und mit niedriger Frequenz wiedergegeben.“"
                            },
                            {
                                "example_id": "13da81d0-fbd3-487e-8ce3-2744e088ff98",
                                "sense_id": "5c8040eb-2100-326d-8e64-305cdb37fd62",
                                "text": "„Die Vertreter der Unterhaltungselektronik-Industrie, […] diskutierten aufgeregt über Bandbreiten, Zeilensprung oder Bildwechselfrequenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
