                        "sense_id": "13075794-6c17-3159-9e51-a95c4b3fc9b9",
                        "entry_id": "e74f9d2b-cfb6-35df-be27-3a491f8101dc",
                        "glosses": [
                            "Type de pouvoir qui serait exercé par les femmes sur les hommes opprimés."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d04ddd88-c1e7-425b-91da-107cdf043bae",
                                "sense_id": "13075794-6c17-3159-9e51-a95c4b3fc9b9",
                                "text": "L'impulsion à s’unir se renverse en rage de se séparer, et l’Éros du retour au sein de la terre et du groupe se transforme en une peur panique de la dissolution et en un dégoût de la vulvocratie socialiste."
                            },
                            {
                                "example_id": "8c08dff4-3bb0-4a67-b950-060b55ef1395",
                                "sense_id": "13075794-6c17-3159-9e51-a95c4b3fc9b9",
                                "text": "Néanmoins le discours d'une association comme SOS-PAPA va beaucoup plus loin que cette seule dénonciant, en parlant, de \"vulvocratie\", de \"néo-facisme anti-pères\", de \"justice matriarcale\"."
                            }
                        ]
                    }
