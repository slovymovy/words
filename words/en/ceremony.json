{
    "word_family": [
        "ceremonial",
        "ceremonious",
        "ceremonially",
        "ceremoniously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c7897cf-e0e9-3005-b1d0-f9056330acf8",
                    "sense_definition": "An official gathering to celebrate, commemorate, or otherwise mark some event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the opening <w>ceremony</w> of the Olympic Games on television.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели <w>церемонию</w> открытия Олимпийских игр по телевизору.",
                                "zh": "我们在电视上观看了奥运会的开幕<w>典礼</w>。"
                            }
                        },
                        {
                            "text": "The couple invited all their friends to the wedding <w>ceremony</w>.",
                            "target_lang_translations": {
                                "ru": "Пара пригласила всех своих друзей на свадебную <w>церемонию</w>.",
                                "zh": "这对夫妇邀请了所有的朋友参加他们的婚礼<w>仪式</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "event",
                        "function",
                        "service"
                    ],
                    "common_phrases": [
                        "opening ceremony",
                        "closing ceremony",
                        "wedding ceremony",
                        "graduation ceremony",
                        "awards ceremony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное собрание для празднования, ознаменования или иного способа отметить какое-либо событие.",
                        "zh": "为庆祝、纪念或标记某项活动而举行的正式集会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церемония",
                                "target_lang_sense_clarification": "торжественное мероприятие"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "праздничное событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仪式",
                                "target_lang_sense_clarification": "正式的庆祝或纪念活动"
                            },
                            {
                                "target_lang_word": "典礼",
                                "target_lang_sense_clarification": "隆重的仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                    "sense_definition": "A ritual, with religious or cultural significance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tribe performed a traditional <w>ceremony</w> to welcome the harvest season.",
                            "target_lang_translations": {
                                "ru": "Племя провело традиционный <w>обряд</w> встречи сезона сбора урожая.",
                                "zh": "部落举行了传统的<w>仪式</w>来迎接收获季节。"
                            }
                        },
                        {
                            "text": "She learned how to conduct the Japanese tea <w>ceremony</w> correctly.",
                            "target_lang_translations": {
                                "ru": "Она научилась правильно проводить японскую чайную <w>церемонию</w>.",
                                "zh": "她学习了如何正确地进行日本茶道<w>礼仪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ritual",
                        "rite",
                        "service",
                        "liturgy"
                    ],
                    "common_phrases": [
                        "religious ceremony",
                        "tea ceremony",
                        "traditional ceremony",
                        "marriage ceremony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритуал, имеющий религиозное или культурное значение.",
                        "zh": "具有宗教或文化意义的礼仪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обряд",
                                "target_lang_sense_clarification": "традиционное или религиозное действие"
                            },
                            {
                                "target_lang_word": "ритуал",
                                "target_lang_sense_clarification": "установленный порядок действий"
                            },
                            {
                                "target_lang_word": "церемония",
                                "target_lang_sense_clarification": "культурная традиция (напр. чайная)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仪式",
                                "target_lang_sense_clarification": "礼仪或程序"
                            },
                            {
                                "target_lang_word": "礼仪",
                                "target_lang_sense_clarification": "传统的行为规范或宗教仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                    "sense_definition": "Formal socially established behaviour, often in relation to people of different ranks; formality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He entered the room without <w>ceremony</w> and immediately started speaking.",
                            "target_lang_translations": {
                                "ru": "Он вошёл в комнату без <w>церемоний</w> и сразу начал говорить.",
                                "zh": "他没讲什么<w>客套</w>就进了房间，直接开始说话。"
                            }
                        },
                        {
                            "text": "Please make yourself at home and do not stand on <w>ceremony</w> with us.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, чувствуйте себя как дома и не разводите с нами <w>церемоний</w>.",
                                "zh": "请随意一点，别跟我们讲那些<w>礼节</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "formality",
                        "protocol",
                        "etiquette",
                        "decorum"
                    ],
                    "antonyms": [
                        "informality"
                    ],
                    "common_phrases": [
                        "without ceremony",
                        "stand on ceremony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное, социально установленное поведение; соблюдение условностей.",
                        "zh": "社会公认的正式行为，通常与不同等级的人有关；拘泥于礼节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церемонии",
                                "target_lang_sense_clarification": "излишние условности, стеснение (обычно мн.ч.)"
                            },
                            {
                                "target_lang_word": "формальность",
                                "target_lang_sense_clarification": "соблюдение правил приличия"
                            },
                            {
                                "target_lang_word": "этикет",
                                "target_lang_sense_clarification": "установленный порядок поведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "礼节",
                                "target_lang_sense_clarification": "社交场合的正式规矩"
                            },
                            {
                                "target_lang_word": "客套",
                                "target_lang_sense_clarification": "形式上的礼貌或拘束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                    "sense_definition": "Show of magnificence, display, ostentation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was crowned with great pomp and <w>ceremony</w> in the ancient cathedral.",
                            "target_lang_translations": {
                                "ru": "Король был коронован с большой помпой и <w>торжественностью</w> в древнем соборе.",
                                "zh": "国王在古老的大教堂里举行了盛大而<w>隆重</w>的加冕仪式。"
                            }
                        },
                        {
                            "text": "She dislikes the excessive <w>ceremony</w> that surrounds official state visits.",
                            "target_lang_translations": {
                                "ru": "Ей не нравится излишний <w>церемониал</w>, окружающий официальные государственные визиты.",
                                "zh": "她不喜欢官方国事访问中那些过度的<w>排场</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pomp",
                        "pageantry",
                        "grandeur",
                        "splendor"
                    ],
                    "antonyms": [
                        "simplicity",
                        "modesty"
                    ],
                    "common_phrases": [
                        "pomp and ceremony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление великолепия, пышности, показной блеск.",
                        "zh": "华丽的展示、排场或铺张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пышность",
                                "target_lang_sense_clarification": "великолепие"
                            },
                            {
                                "target_lang_word": "церемониал",
                                "target_lang_sense_clarification": "торжественность процедуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排场",
                                "target_lang_sense_clarification": "铺张的场面"
                            },
                            {
                                "target_lang_word": "隆重",
                                "target_lang_sense_clarification": "盛大而庄重的气氛"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}