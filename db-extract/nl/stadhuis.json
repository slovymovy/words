                "senses": [
                    {
                        "sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                        "entry_id": "0171f6c5-9a3c-3751-9f23-3e133cb577af",
                        "glosses": [
                            "een gebouw waar de stadsdiensten gehuisvest zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "899cf3b3-d94b-4009-97a6-d9d1bb8862de",
                                "sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                                "text": "Veel mensen trouwen in het stadhuis."
                            },
                            {
                                "example_id": "f632f84d-699e-4e9f-b0da-a1b373354e6e",
                                "sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                                "text": "'Handelslieden bij wie je inkopen doet, kunnen die brieven op het stadhuis inwisselen."
                            },
                            {
                                "example_id": "e7015413-9ebe-4cf9-8b8d-9c9506f7ae0c",
                                "sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                                "text": "Zoals je weet, vond Frans uiteindelijk zijn roeping in het stadhuis, maar de muren van Amsterdam hebben Brandt nooit kunnen vasthouden."
                            },
                            {
                                "example_id": "fc2b1687-5160-4b0c-a853-6b91429ed37a",
                                "sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                                "text": "'Maar mannen die écht barbaars zijn, worden naar de martelkamer onder in het stadhuis gestuurd, naast de schatkamers van Amsterdam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2fce6f6-f1b0-423d-891b-dec37493c55b",
                        "source_entry_id": "0171f6c5-9a3c-3751-9f23-3e133cb577af",
                        "source_sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                        "source_sense_description": "een gebouw waar de stadsdiensten gehuisvest zijn",
                        "target_lang_word": "Rathaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rathaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                        "entry_id": "2215b530-9f86-312f-851e-e6560fef00ea",
                                        "glosses": [
                                            "(historisches) Amtsgebäude, häufig repräsentativer Verwaltungssitz und/oder das Hauptgebäude einer Gemeindeverwaltung oder einer Stadtverwaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b15aece-5a74-480d-bf59-4856199af405",
                                                "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                                "text": "Du musst ins Rathaus, um einen neuen Reisepass zu beantragen!"
                                            },
                                            {
                                                "example_id": "2bcab554-c8e9-4631-8f06-0e9db688c19a",
                                                "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                                "text": "„Er bog auf den kleinen Parkplatz vor dem winzigen Rathaus ein.“"
                                            },
                                            {
                                                "example_id": "1dbb1f04-1813-483b-a14a-6c0dabc59bf5",
                                                "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                                "text": "„Im Rathaus meiner Stadt blieb man hart.“"
                                            },
                                            {
                                                "example_id": "21c4d4e1-bb69-4b99-b5d4-cb4eeaa3054b",
                                                "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                                "text": "„Hinter dem Rathaus gibt es eine Art von Dienststelle, eine Registratur für die Deutschen.“"
                                            },
                                            {
                                                "example_id": "ecce9f3f-c4a7-4954-b52c-627d084ca042",
                                                "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                                "text": "„Das prachtvolle weltliche Rathaus am Marktplatz bedeutete ihm mehr als das christliche Münster hoch auf dem Felsen am Rheinbogen.“"
                                            },
                                            {
                                                "example_id": "597111e5-16d5-4d86-9f19-fe29b6f91782",
                                                "sense_id": "6ff6b7d9-b831-3ec8-bf4a-fb68ff8116a7",
                                                "text": "„Dass die Stadt ihr Rathaus mit gemischten Gefühlen verkauft, dafür sprach nicht nur der lediglich mehrheitliche Beschluss des Rathauses, sondern auch ein beherzter Glückwunsch Losiaks: ‚Betriebswirtschaftlich ist es richtig, dass sich die Stadt von Eigentum trennt.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cd1bd94-0420-3e98-8489-fe3bb5ef56d2",
                                        "entry_id": "2215b530-9f86-312f-851e-e6560fef00ea",
                                        "glosses": [
                                            "Stadtverwaltung, eine Gemeindeverwaltung als Organisation"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621e1a11-192d-44b6-b0d3-cf2ee37404d3",
                                                "sense_id": "2cd1bd94-0420-3e98-8489-fe3bb5ef56d2",
                                                "text": "„Dass die Stadt ihr Rathaus mit gemischten Gefühlen verkauft, dafür sprach nicht nur der lediglich mehrheitliche Beschluss des Rathauses, sondern auch ein beherzter Glückwunsch Losiaks: ‚Betriebswirtschaftlich ist es richtig, dass sich die Stadt von Eigentum trennt.‘“"
                                            },
                                            {
                                                "example_id": "1321d7ab-55e5-4d7b-8b3b-ee793c0cb864",
                                                "sense_id": "2cd1bd94-0420-3e98-8489-fe3bb5ef56d2",
                                                "text": "„So wurde u. a. die Renovierung des Marktplatzes und der unmittelbaren Gassen veranlasst und das Rathaus beschloss aus diesem Anlasse die Umbenennung in ‚patriotische‘ Namen.“"
                                            },
                                            {
                                                "example_id": "3b3fd941-a3d0-4c7a-a694-24468b99ea68",
                                                "sense_id": "2cd1bd94-0420-3e98-8489-fe3bb5ef56d2",
                                                "text": "„Das Rathaus entschied sich nun für ein konventionelles rechteckiges Gebäude mit begrüntem Flachdach, nachdem die von den Architekten favorisierte Lösung mit dreieckiger Grundfläche und dreieckigem Dach als zu teuer und uneffektiv abgetan worden war.“"
                                            },
                                            {
                                                "example_id": "fe3e6c3a-61f9-4db3-b007-be83f6045be7",
                                                "sense_id": "2cd1bd94-0420-3e98-8489-fe3bb5ef56d2",
                                                "text": "„Da ein Landratsamt im Normalfall eine größere Behörde mit vermehrtem Publikumsverkehr sein wird als das vorher zuständige Rathaus, ist mit einer Verlängerung der Wartezeit zu rechnen.“"
                                            },
                                            {
                                                "example_id": "a5bbc0ed-38a9-48a6-8e2a-56b86d32647b",
                                                "sense_id": "2cd1bd94-0420-3e98-8489-fe3bb5ef56d2",
                                                "text": "„Grund für dieses Umdenken war offenbar eine Sonderaufführung, die zu Ehren des Stadtrats veranstaltet worden war und die Entscheidung des Rathauses günstig beeinflusste: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4942c418-cd64-4d8e-8559-ebd8e2c45143",
                        "source_entry_id": "0171f6c5-9a3c-3751-9f23-3e133cb577af",
                        "source_sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
                        "source_sense_description": "een gebouw waar de stadsdiensten gehuisvest zijn",
                        "target_lang_word": "town hall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "town hall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f75fa7d-867b-393f-bea5-056f1688685a",
                                        "entry_id": "16485f42-b916-3122-bde9-b07ed6f040f1",
                                        "glosses": [
                                            "A building that houses the local government offices of a town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa89b99-09f3-48a5-8296-0e91d45a4ef9",
                                                "sense_id": "9f75fa7d-867b-393f-bea5-056f1688685a",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            },
                                            {
                                                "example_id": "ea0a6c83-e538-464b-88fd-e20f2ef1ef52",
                                                "sense_id": "9f75fa7d-867b-393f-bea5-056f1688685a",
                                                "text": "They enjoyed music from a live saxophonist during the journey before visiting Braintree Town Hall for refreshments and Christmas cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e5f597-6f77-397c-ace1-4099b18d15e4",
                                        "entry_id": "16485f42-b916-3122-bde9-b07ed6f040f1",
                                        "glosses": [
                                            "The town council."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                        "entry_id": "16485f42-b916-3122-bde9-b07ed6f040f1",
                                        "glosses": [
                                            "A widely accessible meeting, particularly where the audience is allowed to interact with the speakers."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023b94a9-9985-4dfb-b1c6-d8b06fa3e2b7",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "The president plans to speak to a town hall of employees at its headquarters on Monday."
                                            },
                                            {
                                                "example_id": "5f864569-e154-4f06-bdb4-b7c1c076c194",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "\" […] Sure, you can come down to City Hall when we have a Town Hall Meeting. Write to Maureen Connelly and she'll arrange it. […]\""
                                            },
                                            {
                                                "example_id": "7b9aea50-8d41-4179-916b-b3051fd41e95",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "And in just a few minutes, we'll bring you tonight's town hall debate from here at Washington University in Saint Louis."
                                            },
                                            {
                                                "example_id": "8f2b9297-838d-476f-8bc5-14ea7d680af7",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "The Form 2s are planning to host a town hall meeting with the women of Mara Moja and other local communities to teach the women more effective hygiene practices […]"
                                            },
                                            {
                                                "example_id": "6f466fa1-cc29-4d30-be0a-d59b1d9ef3b8",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "That pushback from inside the administration was combined with rising public anger about the cuts that exploded at several lawmakers’ town halls in recent weeks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca861d0c-e03c-4506-8675-7d7efb2e0878",
                        "source_entry_id": "0171f6c5-9a3c-3751-9f23-3e133cb577af",
                        "source_sense_id": "199bd4c1-8f79-30df-9dde-a20db97070f1",
