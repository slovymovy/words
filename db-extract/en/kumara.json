                    {
                        "sense_id": "c6b973f1-522a-3613-95a1-7107b047f219",
                        "entry_id": "b58648ad-251b-30d1-b6cc-8091c9ef63ea",
                        "glosses": [
                            "The sweet potato."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "46ad8762-ff68-4eb7-b987-00f869d5aede",
                                "sense_id": "c6b973f1-522a-3613-95a1-7107b047f219",
                                "text": "They introduced the gourd, taro and kumara from the Polynesian Islands to the New Zealanders."
                            },
                            {
                                "example_id": "8e500410-e611-47cd-baab-f095efb84a52",
                                "sense_id": "c6b973f1-522a-3613-95a1-7107b047f219",
                                "text": "“And once, a woman threw a piece of cooked kumara at me and I ducked, and laughed…”"
                            },
                            {
                                "example_id": "a40288ee-e110-43df-8a4f-61a04c843ce0",
                                "sense_id": "c6b973f1-522a-3613-95a1-7107b047f219",
                                "text": "In contrast to everything else that these migrant people had lugged from island to island, the kūmara had not come from the west."
                            }
                        ]
                    }
                ],
