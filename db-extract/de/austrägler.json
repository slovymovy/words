                "senses": [
                    {
                        "sense_id": "e5a2cf78-9d9b-39bb-9a3f-9abc32864771",
                        "entry_id": "2d69155e-2acc-3b34-86fe-b6ed7db5d099",
                        "glosses": [
                            "eine sich im Austrag befindende Person"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "6caa3744-ee46-43bc-a60f-bcc9d933dfc0",
                                "sense_id": "e5a2cf78-9d9b-39bb-9a3f-9abc32864771",
                                "text": "„Taglöhner auf dem Lande, die nur eine Hütte ohne Acker besitzen, heißt man in Baiern und in der oberen Pfalz Leerhäusler, und nicht Austrägler.“"
                            },
                            {
                                "example_id": "d2207f4b-d832-4854-ae87-7348c6dc0377",
                                "sense_id": "e5a2cf78-9d9b-39bb-9a3f-9abc32864771",
                                "text": "„Die extraordinari Herdstättanlage gründet sich auf die hierüber alle Jahre zu verfassenden Designationen über die Zahl der Inwohner, Taglöhner und Austrägler“"
                            }
                        ],
                        "sense_index_json": "\"1\""
