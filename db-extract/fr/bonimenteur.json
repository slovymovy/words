                    {
                        "form_id": "67a77b77-7654-47d0-ac97-8566eccbd262",
                        "entry_id": "04c62599-6ca4-3a4a-996b-d6a6f0fe4ed1",
                        "tags": [
                            "feminine"
                        ],
                        "form": "bonimenteuse"
