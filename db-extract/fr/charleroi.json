            {
                "entry_id": "57c63081-1310-35de-90ec-59e03b303935",
                "word": "Charleroi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "377afc3c-9339-38fa-927d-32c1ec537a13",
                        "entry_id": "57c63081-1310-35de-90ec-59e03b303935",
                        "glosses": [
                            "Commune et ville de la province du Hainaut de la région wallonne de Belgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c4230c-b20a-4dee-a95b-1af12dee5293",
                                "sense_id": "377afc3c-9339-38fa-927d-32c1ec537a13",
                                "text": "Tandis qu'une partie de l’Armée Française recevait de front, dans la région de Charleroi, le choc de l'ennemi, la IIIᵉ Armée masquant la place forte de Metz, devait attaquer celui-ci de flanc, de Virton au nord de Longuyon."
                            },
                            {
                                "example_id": "4c325574-a575-4e65-9884-04ba8c76f1b0",
                                "sense_id": "377afc3c-9339-38fa-927d-32c1ec537a13",
                                "text": "— Charleroi ! Si j’m’en rappelle ! Comme on y a souffert, mon gars ! T’étais pas encore né, toi. Des jours et des nuits sans bouffer, sans boire, sans dormir ! Et les Boches à nos trousses !"
                            },
                            {
                                "example_id": "2002e388-b171-44af-9e7b-bb4054ba4725",
                                "sense_id": "377afc3c-9339-38fa-927d-32c1ec537a13",
                                "text": "Enserrée dans son ring urbain, Charleroi est aujourd'hui un véritable centre régional, environné d'une vaste nébuleuse de communes aux développements tentaculaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9dd2705-47e0-3f67-8ae3-4fa32097c377",
                        "entry_id": "57c63081-1310-35de-90ec-59e03b303935",
                        "glosses": [
                            "Aéroport de Charleroi-Bruxelles-Sud, aéroport situé dans cette commune."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "c0401c51-6e87-4ef6-a243-370bebf0d95c",
                                "sense_id": "b9dd2705-47e0-3f67-8ae3-4fa32097c377",
                                "text": "Ton vol arrive à Zaventem ou à Charleroi ?"
                            }
                        ]
                    }
