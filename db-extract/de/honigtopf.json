                                    {
                                        "sense_id": "a33d6072-d1ad-3efd-96f2-81b8c2775e28",
                                        "entry_id": "af0af426-adb4-379b-8910-0ec994c0200c",
                                        "glosses": [
                                            "A pot of honey."
                                        ],
                                        "tags": [],
