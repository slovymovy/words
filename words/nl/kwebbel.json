                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>kwebbel</w> je de hele tijd tijdens de film?",
                            "target_lang_translations": {
                                "en": "Why do you <w>chatter</w> the whole time during the movie?"
                            }
                        },
                        {
                            "text": "Soms <w>kwebbel</w> je zo snel dat ik je niet kan volgen.",
                            "target_lang_translations": {
                                "en": "Sometimes you <w>prattle</w> so fast that I can't follow you."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present tense of 'kwebbelen' in inversion"
                    },
                    "translations": {
                        "en": [
                            {
