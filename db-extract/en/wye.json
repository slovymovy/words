                        "glosses": [
                            "To make something into a wye (letter Y) shape."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d9d445c-e2dd-487d-b536-aafd5261acfb",
                                "sense_id": "0a90152c-d5e0-375e-a0a6-7d86eb77f304",
                                "text": "When a hose line is divided into two or more lines, these lines are known as wyed lines."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb037ead-d966-30ca-b7cf-27fd0cbbb410",
                        "entry_id": "48aaa1c3-f7c8-3def-88cb-4c513cec5ab9",
                        "glosses": [
                            "To reverse the direction of a train using a wye."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1c0f55d6-4e16-4353-8c7f-0c682c939088",
                                "sense_id": "bb037ead-d966-30ca-b7cf-27fd0cbbb410",
                                "text": "Since the train didn't have a control cab at the other end, they wyed the train to turn it around for the trip back to the city."
                            },
                            {
                                "example_id": "0bbf3cdf-3db5-46b9-a1aa-913d70e1b787",
                                "sense_id": "bb037ead-d966-30ca-b7cf-27fd0cbbb410",
                                "text": "Committee contend that when these trains are wyed at Springfield, the road passenger crews are performing yard work at that point to eliminate switching by yard crews."
                            }
                        ]
                    }
