                },
                {
                    "sense_id": "c19045ca-5125-36a7-ba06-52b2bd3b87de",
                    "sense_definition": "Forme d'énergie thermique transmise d'un corps à un autre par conduction, convection ou rayonnement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce métal conduit très efficacement la <w>chaleur</w> produite par la machine."
