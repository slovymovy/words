                ],
                "senses": [
                    {
                        "sense_id": "78df4293-2570-3597-8984-a7204c3a86d9",
                        "entry_id": "fe8707dd-89a5-306b-89aa-d324be75ee23",
                        "glosses": [
                            "dat je emotioneel geraakt wordt, aangrijpend, adembenemend, choquerend, treffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5129349a-04c4-44d3-8913-e3dd6f22d83a",
                                "sense_id": "78df4293-2570-3597-8984-a7204c3a86d9",
                                "text": "Tijdens het journaal werden schokkende beelden getoond over de vliegtuigramp."
                            },
                            {
                                "example_id": "232d9ff9-233d-49aa-bfa0-0123228a93f5",
                                "sense_id": "78df4293-2570-3597-8984-a7204c3a86d9",
                                "text": "Het meest schokkende beeld van de inauguratie van Donald Trump vond ik niet diens ingevallen en daardoor verbetener tronie (weet dat het hem menens is); het was de slagorde van opportunisten achter hem. Elon Musk, Mark Zuckerberg en Jeff Bezos: ooit steunden ze Barack Obama, de tegenpool. Zuckerberg hield hartstochtelijk pleidooien pro migratie; nu bejubelt hij de manosphere. Mannen met het moreel kompas van daytraders."
                            },
                            {
                                "example_id": "bc34767f-badc-4efa-8ced-e9caa13270e8",
                                "sense_id": "78df4293-2570-3597-8984-a7204c3a86d9",
                                "text": "Ik vond het schokkend om te horen."
                            },
                            {
                                "example_id": "a5244b94-2f5e-4f68-9da8-0840561144dc",
                                "sense_id": "78df4293-2570-3597-8984-a7204c3a86d9",
                                "text": "Van levensbelang: \"De omvang en reikwijdte van de hittestress is schokkend\", zegt zeebioloog Melanie McEnfield tegen persbureau Reuters. \"Sommige riffen hadden er tot dusver geen last van en wij dachten dat ze veerkrachtig waren, dat ze het gedeeltelijk afsterven te boven zouden komen.\""
                            }
                        ]
                    }
