                    },
                    {
                        "form_id": "4666c3c8-a12d-4fa7-afb0-41260d9da442",
                        "entry_id": "e85742d4-f874-3c08-9a5f-2f264be430a5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Patres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91bae428-f094-32b0-843f-e5f535a4e1e5",
                        "entry_id": "e85742d4-f874-3c08-9a5f-2f264be430a5",
                        "glosses": [
                            "Anrede für Priester, insbesondere Ordenspriester"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "95a3defe-2a2b-41f7-97b3-29aed59a261f",
                                "sense_id": "91bae428-f094-32b0-843f-e5f535a4e1e5",
                                "text": "Wo ist Pater Benedikt?"
                            },
                            {
                                "example_id": "f56e7d6d-d9ec-46d9-a75e-782af87ff803",
                                "sense_id": "91bae428-f094-32b0-843f-e5f535a4e1e5",
                                "text": "„Gegen die Beichtväter der Fürsten richtet Pater Spee in seinem Gewissensbuch die schwersten Vorwürfe.“"
                            },
                            {
                                "example_id": "27009611-5588-4dbc-b557-c9d1bdace80b",
                                "sense_id": "91bae428-f094-32b0-843f-e5f535a4e1e5",
                                "text": "„Ich dankte dem Doktor für diesen Rat; doch kehrte ich mich nicht daran, weil ich glaubte, der üble Ruf des Paters rührte nur von seinen freien Ansichten her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43f10f2b-82ce-3a90-a206-df536b0bab36",
                        "entry_id": "e85742d4-f874-3c08-9a5f-2f264be430a5",
                        "glosses": [
                            "metonymisch: die Person selbst Ordenspriester"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9abb76-dee5-459a-ae2f-83f9ab9c17d0",
                                "sense_id": "43f10f2b-82ce-3a90-a206-df536b0bab36",
                                "text": "Der Pater im Meßgewand geht mit raschen Schritten über den Platz, gefolgt von Meßknaben. (Max Frisch: Andorra. 1. Bild.)"
                            },
                            {
                                "example_id": "041db6c0-4406-4aa4-b402-5388615c5092",
                                "sense_id": "43f10f2b-82ce-3a90-a206-df536b0bab36",
                                "text": "„Immer wieder wirft sich der Pater vor dem Kreuz zu Boden.“"
                            },
                            {
                                "example_id": "64266e53-83a8-4d14-9f66-40fc1dbed262",
                                "sense_id": "43f10f2b-82ce-3a90-a206-df536b0bab36",
                                "text": "„Ein junger Pater spricht einige kurze Gebete.“"
                            },
                            {
                                "example_id": "4715f44d-ff55-454d-9e97-3b5c6e29e676",
                                "sense_id": "43f10f2b-82ce-3a90-a206-df536b0bab36",
                                "text": "„Damit war der Pater weg, und beinahe gleichzeitig begann das Schiff aus dem Hafen zu gleiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4285779-ea47-41ba-8e53-c1a098fcd5f8",
                        "source_entry_id": "e85742d4-f874-3c08-9a5f-2f264be430a5",
