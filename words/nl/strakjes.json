                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "referring to a time later today"
                            },
                            {
                                "target_lang_word": "in a bit",
                                "target_lang_sense_clarification": "informal expression for a short time from now"
                            },
                            {
                                "target_lang_word": "soon",
                                "target_lang_sense_clarification": "in a short time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78880321-3dde-3392-9820-bfa9f4c20844",
                    "sense_definition": "Op een ietwat strakke of nauwsluitende manier; verkleinwoord van <w>strak</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schoenen zitten wat <w>strakjes</w> aan mijn voeten.",
                            "target_lang_translations": {
                                "en": "The shoes feel <w>a bit tight</w> on my feet."
                            }
                        },
                        {
                            "text": "Zij heeft haar haar vandaag heel <w>strakjes</w> in een staart gebonden.",
                            "target_lang_translations": {
                                "en": "She tied her hair in a ponytail very <w>tightly</w> today."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat strakjes zitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informele vorm om een strakke toestand te verzachten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In a somewhat tight or snug manner; diminutive of 'strak'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a bit tight",
                                "target_lang_sense_clarification": "referring to clothing or shoes that fit snugly"
                            },
