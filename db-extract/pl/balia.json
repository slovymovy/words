                                "target_senses": [
                                    {
                                        "sense_id": "9b5de0f8-6a1a-3e79-bc87-fecc8e6daa53",
                                        "entry_id": "8f591683-5eac-3484-a4d0-abcc31af9d0a",
                                        "glosses": [
                                            "Wanne zum Reinigen von Kleidungsstücken, Geschirr oder anderen Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7edf11-8283-4e63-ac82-5aa43ef1f585",
                                                "sense_id": "9b5de0f8-6a1a-3e79-bc87-fecc8e6daa53",
                                                "text": "Er legte seine dreckige Arbeitshose in die Waschwanne und schrubbte sie sauber."
                                            },
                                            {
                                                "example_id": "09133fee-0d94-41fd-897f-abc6eeb5ea4f",
                                                "sense_id": "9b5de0f8-6a1a-3e79-bc87-fecc8e6daa53",
                                                "text": "Das Besteck klimperte, als sie mit der Hand durch die Waschwanne rührte."
                                            },
                                            {
                                                "example_id": "daf14bac-a52a-468d-aeb7-7b1b579a0680",
                                                "sense_id": "9b5de0f8-6a1a-3e79-bc87-fecc8e6daa53",
                                                "text": "„Er bückte sich und langte in den Bootsboden hinunter, dann richtete er sich auf und hatte eine verzinkte Waschwanne auf den Armen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
