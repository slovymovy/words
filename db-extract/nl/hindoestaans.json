            {
                "entry_id": "eed96e14-1d82-3d2a-9bbf-7a3035fb97f8",
                "word": "Hindoestaans",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3b089992-966f-3703-b498-713f836ce175",
                        "entry_id": "eed96e14-1d82-3d2a-9bbf-7a3035fb97f8",
                        "glosses": [
                            "van, bij of betrekking hebbend op Surinamers of Surinaamse Nederlanders van Indiase afkomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0809ad22-880e-48ab-948e-8486c4233c99",
                                "sense_id": "3b089992-966f-3703-b498-713f836ce175",
                                "text": "Hij gaat nu bij collega-jeugd- en kinderartsen langs met zijn nieuwe gegevens. Die laten zien welke lengte en gewicht normaal zijn voor een Hindoestaans kind van een bepaalde leeftijd."
                            },
                            {
                                "example_id": "ecd90627-1fc3-47c7-94a3-e096d8b0b800",
                                "sense_id": "3b089992-966f-3703-b498-713f836ce175",
                                "text": "Wel waren er mensen die tegen het initiatief van Boas ernstige bezwaren hadden. Als het in hun macht gelegen had dan zou het Avros-bestuur, vanwege al dat Hindoestaans gedoe, naar huis zijn gestuurd. Maar het Hindoestaanse uurtje was door de overheid gevorderd en het bestuur van de omroepvereniging kon niets doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "52f395b1-ef30-3375-a61a-ecb5296aaa79",
                        "entry_id": "eed96e14-1d82-3d2a-9bbf-7a3035fb97f8",
                        "glosses": [
                            "van, bij of betrekking hebbend op migranten vanuit India en hun nazaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b105849-a9f6-4edc-8b38-c1125319148d",
                                "sense_id": "52f395b1-ef30-3375-a61a-ecb5296aaa79",
                                "text": "Overigens bekommert de staat zich vooral om Sinhalezen en minder om burgers die Hindoestaans, Tamil of moslim zijn."
                            },
                            {
                                "example_id": "792d722a-d2f5-433a-a3a8-7e9b62c47d51",
                                "sense_id": "52f395b1-ef30-3375-a61a-ecb5296aaa79",
                                "text": "Danny maakt wereldgerechten van Knorr, ik kook echt Hindoestaans of Italiaans."
                            }
                        ]
                    },
                    {
                        "sense_id": "89075bad-309f-3151-adda-50a84fd51ad8",
                        "entry_id": "eed96e14-1d82-3d2a-9bbf-7a3035fb97f8",
                        "glosses": [
                            "met betrekking tot Hindoestan, de Hindoe's of het Hindoestani"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd87d6b-bcf1-4079-b03d-385d137c70be",
                                "sense_id": "89075bad-309f-3151-adda-50a84fd51ad8",
                                "text": "\"Het is schipperen\", legt de Indiase journalist Sanjay Sharma uit in de studio van het tv-station News India. Dagelijks geeft hij om acht uur ’s avonds een politieke analyse. Deze Hindoestaanse nieuwszender, die nu drie jaar bestaat, bereikt heel India en dagelijks luisteren zo’n 25 miljoen Indiërs naar zijn betoog."
                            }
                        ]
                    }
                ],
