            {
                "entry_id": "7cac9e6e-ccc0-33cf-864c-03782dd8aedd",
                "word": "réveillon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a36506f-ae9c-4e8c-b441-10a95eb1c556",
                        "entry_id": "7cac9e6e-ccc0-33cf-864c-03782dd8aedd",
                        "tags": [
                            "plural"
                        ],
                        "form": "réveillons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                        "entry_id": "7cac9e6e-ccc0-33cf-864c-03782dd8aedd",
                        "glosses": [
                            "Repas qui se fait en famille ou entre amis, vers le milieu de la nuit, particulièrement la nuit de Noël et la nuit précédant le jour de l’an."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1786704e-f249-46d1-8ec9-1c795a2c3557",
                                "sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                                "text": "Tout content de ses achats, il s’arrêta encore chez un caviste où il choisit un magnum de champagne Roederer qui serait sa participation au réveillon."
                            },
                            {
                                "example_id": "1aec8279-839a-4a8f-a7c6-4f04fc603787",
                                "sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                                "text": "On but à larges goulées le vin rude qui vous râpait la gorge et chantait aux tempes ; à grandes bâfrées, on s'empifra de viandes. Oui, jamais ne fut plus joyeux réveillon."
                            },
                            {
                                "example_id": "de991ca8-9538-4294-aa21-e923fdc0cebb",
                                "sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                                "text": "Vers 23 h 30, les danseuses de l'établissement, encore habillées pour l'heure, circulèrent de table en table pour distribuer les inévitables cotillons du réveillon : chapeaux, mirlitons, faux-nez, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e4d33fc-6ee6-474b-8fd7-d5c40c874809",
                        "source_entry_id": "7cac9e6e-ccc0-33cf-864c-03782dd8aedd",
                        "source_sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                        "source_sense_description": "Repas qui se fait en famille ou...",
                        "target_lang_word": "Festessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Festessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                        "entry_id": "12712ca6-c24f-3f08-b79f-ffadbda9c2a5",
                                        "glosses": [
                                            "besonders gutes, aufwendiges, festliches Essen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f991a53-2817-4cb3-8515-dc90d2974aa3",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Die Mutter des Hauses hat ein Festessen gekocht."
                                            },
                                            {
                                                "example_id": "041b25e6-027c-4d27-9919-24834fe9cb6c",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Einige Tage nach dem Festessen bei den Arkesdens kehrten Lucas und Barbara nach einer Fahrt durch das Marschland zum Haus ihrer Eltern zurück.“"
                                            },
                                            {
                                                "example_id": "ee155fcf-28b5-4f0b-9143-f29658698fe6",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Das Festessen war Vals Idee gewesen, als Dankeschön für Barons Gastfreundschaft.“"
                                            },
                                            {
                                                "example_id": "bea2228d-6610-4332-b5a0-478f4b4ee87c",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Ein Fest ohne Festessen verdient seinen Namen nicht, es ist zum Scheitern verurteilt.“"
                                            },
                                            {
                                                "example_id": "81f68588-92b6-4bad-bab4-7ce3febb06ec",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Das Ehepaar lädt zum Festessen."
                                            },
                                            {
                                                "example_id": "157bc23e-b12a-4476-a1f4-ce56cf0936f4",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Das ist ja ein wahres Festessen!"
                                            },
                                            {
                                                "example_id": "56716240-cfb6-4775-8f75-154e20c18a2b",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Sie hatten die meisten Esswaren herausgeholt und diese, da sie anscheinend ein Festessen vorbereiten wollten, auf einem glatten Stein ausgebreitet.“"
                                            },
                                            {
                                                "example_id": "83f1f15c-95fb-41a2-be3a-2c0df497b6de",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Alles war für das Festessen vorbereitet, das Tier getötet, ausgenommen und bratfertig, als wir feststellten, dass der Backofen zu klein war für den imposanten Fisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d35e9985-e21d-4eb3-a05e-340fe89195b6",
                        "source_entry_id": "7cac9e6e-ccc0-33cf-864c-03782dd8aedd",
                        "source_sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                        "source_sense_description": "Repas qui se fait en famille ou...",
                        "target_lang_word": "Silvesternacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silvesternacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f439a71-b9cb-394a-88e8-4fda094efc19",
                                        "entry_id": "39912274-563a-3781-9fb2-dad12fe92e2d",
                                        "glosses": [
                                            "Nacht am letzten Tag des Jahres zum ersten Tag des folgenden Jahres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefd62a2-7493-48ac-a288-1b4d063fdadc",
                                                "sense_id": "9f439a71-b9cb-394a-88e8-4fda094efc19",
                                                "text": "„In der Silvesternacht 1980 hatte selbst in der Stadt noch Schnee gelegen.“"
                                            },
                                            {
                                                "example_id": "3f2b8564-dfdd-4836-ba9a-3aa4eb0a555a",
                                                "sense_id": "9f439a71-b9cb-394a-88e8-4fda094efc19",
                                                "text": "„In New York versammelten sich in der neblig-nieseligen Silvesternacht 750000 Menschen rund um den Times Square.“"
                                            },
                                            {
                                                "example_id": "db27fdd3-6ee5-4c6c-9be6-0366b9e352c3",
                                                "sense_id": "9f439a71-b9cb-394a-88e8-4fda094efc19",
                                                "text": "„Es war eine Silvesternacht mit Schlackerwetter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60a82f4d-5bbf-47f8-8ae1-4f1a684d7ca6",
                        "source_entry_id": "7cac9e6e-ccc0-33cf-864c-03782dd8aedd",
                        "source_sense_id": "29c24542-e5b5-3807-ac28-05f0ecb4be56",
                        "source_sense_description": "Repas qui se fait en famille ou...",
                        "target_lang_word": "Silvesterparty",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silvesterparty",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8569103-9882-39c6-87db-52c173c7058b",
                                        "entry_id": "946c4cc9-831a-38cf-8b34-2fdb02426919",
                                        "glosses": [
                                            "anlässlich Silvester am Abend des 31. Dezembers beziehungsweise in der Nacht vom 31. Dezember auf den 1. Januar veranstaltete Party"
                                        ],
                                        "tags": [
                                            "Brauchtum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d5060e3-962b-4aba-9c03-9d92a3948c84",
                                                "sense_id": "c8569103-9882-39c6-87db-52c173c7058b",
                                                "text": "„Daß nun zu Silvesterpartys eingeladen werden muß, daß sie organisiert, geplant, der Sekt in der richtigen Menge kaltgestellt werden muß, ist klar.“"
                                            },
                                            {
                                                "example_id": "44084beb-205f-45f2-a9aa-311cd964a68c",
                                                "sense_id": "c8569103-9882-39c6-87db-52c173c7058b",
                                                "text": "„Dem Wachmann in der Notfallstation zu schaffen machten die teils feuchtfröhlichen Gesellschaften, die in Begleitung von Patienten ins Universitätsspital Zürich angereist kamen und vor der Türe werweissten, ob sie ihre Zeit noch länger mit Warten zubringen oder lieber die nächste Silvesterparty besuchen sollten.“"
                                            },
                                            {
                                                "example_id": "8c940e5a-1e1f-4c0b-a165-eecfcf7c9e38",
                                                "sense_id": "c8569103-9882-39c6-87db-52c173c7058b",
                                                "text": "„Dann kam eine Silvesterparty.“"
                                            },
                                            {
                                                "example_id": "9ffb9c11-400a-49e0-b2fb-3835ed54ed3d",
                                                "sense_id": "c8569103-9882-39c6-87db-52c173c7058b",
                                                "text": "„Unvergesslich, wie er uns auf Lilos Silvesterparty den Marxismus aus der Bibel abgeleitet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
