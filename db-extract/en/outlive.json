                "senses": [
                    {
                        "sense_id": "2f38d96f-4198-3397-a5d1-80a99f7647ed",
                        "entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "glosses": [
                            "To live longer than; continue to live after the death of; overlive; survive."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5f5b1da5-878c-40bd-b392-6a74cc1c3617",
                                "sense_id": "2f38d96f-4198-3397-a5d1-80a99f7647ed",
                                "text": "And he that calls on thee, let him bring forth / Eternal numbers to outlive long date."
                            },
                            {
                                "example_id": "569a28a1-4fe7-4fcb-94b6-1ae72f7ac233",
                                "sense_id": "2f38d96f-4198-3397-a5d1-80a99f7647ed",
                                "text": "If anything / it makes it worse, your early death, that / having now at last outlived you, I too / have broken ranks."
                            }
                        ]
                    },
                    {
                        "sense_id": "39149e37-cbf5-3839-b6d9-9bbc0f1ed571",
                        "entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "glosses": [
                            "To live through or past (a given time)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5fa4ad7e-fd8b-4f56-87d7-09f6e2c13df0",
                                "sense_id": "39149e37-cbf5-3839-b6d9-9bbc0f1ed571",
                                "text": "This must have been the way mamma had first looked at Sir Claude; it brought back the lustre of the time they had outlived."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffed2c24-469b-389a-a1a8-c00231eb0f24",
                        "entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "glosses": [
                            "To surpass in duration; outlast."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aa5b62bd-c977-37de-b380-878b6bfc072b",
                        "entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "glosses": [
                            "To live longer; continue to live."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57260f42-88eb-45fe-b877-f4b9daef4d6c",
                        "source_entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "source_sense_description": "to live longer than",
                        "target_lang_word": "overleven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overleven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "70329907-426a-3c0a-b37f-c098fa8c5533",
                                        "entry_id": "dc72a758-1002-35da-a553-9970eeb6cc0b",
                                        "glosses": [
                                            "in leven blijven ondanks levensbedreigende omstandigheden of gebeurtenissen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2802a004-8079-44db-8bdd-82751cbe833b",
                                                "sense_id": "70329907-426a-3c0a-b37f-c098fa8c5533",
                                                "text": "Vandaag keek hij vanzelfsprekend niet meer zo tegen de dingen aan. Hij wist dat de oorlog niets anders was dan een reusachtige loterij met levensechte kogels, waarin vier jaar overleven aan het wonderbaarlijke grensde."
                                            },
                                            {
                                                "example_id": "113aefe6-aa7c-4a0c-886c-da5fce7c1f88",
                                                "sense_id": "70329907-426a-3c0a-b37f-c098fa8c5533",
                                                "text": "De Britse wetenschapper en ’s werelds slimste man Stephen Hawking waarschuwt dat de mensheid binnen de honderd jaar de planeet moet verlaten om te kunnen overleven."
                                            },
                                            {
                                                "example_id": "036a430b-86c0-4488-852d-d55cbf748b91",
                                                "sense_id": "70329907-426a-3c0a-b37f-c098fa8c5533",
                                                "text": "Deze storm zou ik moeten overleven boven op Mount Whitney, 4.421 meter hoog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ac937e-cac7-337d-a281-2ca8d4f152b1",
                                        "entry_id": "dc72a758-1002-35da-a553-9970eeb6cc0b",
                                        "glosses": [
                                            "een hogere leeftijd bereiken dan, langer leven dan"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5261e876-217f-4fc3-8571-0f3cb617d87d",
                                                "sense_id": "57ac937e-cac7-337d-a281-2ca8d4f152b1",
                                                "text": "Willem overleefde zijn vader."
                                            },
                                            {
                                                "example_id": "3ee4262a-a689-40aa-9bca-66ed77f930ff",
                                                "sense_id": "57ac937e-cac7-337d-a281-2ca8d4f152b1",
                                                "text": "De vader overleeft zijn kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5881c9-1a5b-31a7-b885-98ec6a32c418",
                                        "entry_id": "dc72a758-1002-35da-a553-9970eeb6cc0b",
                                        "glosses": [
                                            "blijven functioneren"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a1d8d97-650e-41f2-87f8-19656dc14499",
                                                "sense_id": "7e5881c9-1a5b-31a7-b885-98ec6a32c418",
                                                "text": "Of Ingenuity het tot die tijd overleeft, is nog de vraag. De helikopter gaat al veel langer mee dan oorspronkelijk de bedoeling was. NASA ging ervan uit dat de helikopter vijf vluchten zou maken. Inmiddels heeft het apparaat 28 vluchten afgerond en 6,8 kilometer afgelegd."
                                            },
                                            {
                                                "example_id": "f37adc0c-c83b-4ff5-b429-0cff3d24c9f0",
                                                "sense_id": "7e5881c9-1a5b-31a7-b885-98ec6a32c418",
                                                "text": "De met kernwapens uitgeruste Tupolev 16 van de Sovjet-Unie zou een spitsroedeloop met achthonderd jachtvliegtuigen niet overleven wanneer ze Zweden probeerden aan te vallen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e587c39-6c9c-4547-9aa4-137a7de583c5",
                        "source_entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "source_sense_description": "to live longer than",
                        "target_lang_word": "survivre à",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e85ee28b-d87d-481b-abfe-227fcb5af4f5",
                        "source_entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "source_sense_description": "to live longer than",
                        "target_lang_word": "überleben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überleben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                        "entry_id": "25b3f9c9-61bf-3350-9859-2ad27c449b3b",
                                        "glosses": [
                                            "in einer gefährlichen Situation am Leben bleiben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28bd1a66-47b0-4ef9-8bed-b01549a47baa",
                                                "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                                "text": "Die Sanitäter, die zuerst am Unfallort waren, hatten schon den Eindruck, dass er wohl nicht überleben würde."
                                            },
                                            {
                                                "example_id": "646bbdb6-491b-4439-851f-fd768e13f146",
                                                "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                                "text": "Sie [meine Eltern] überlebten den Krieg, aber der Krieg überlebte auch in ihnen."
                                            },
                                            {
                                                "example_id": "282e40c7-b346-4087-b854-662e7c95e204",
                                                "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                                "text": "„Als einziges Mitglied seiner Familie überlebte er den Holocaust.“"
                                            },
                                            {
                                                "example_id": "7d23c7da-99af-41c0-a10b-ccce90d61ec1",
                                                "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                                "text": "„Insgesamt lebten vor dem Ausbruch des Zweiten Weltkriegs rund 80.000 Jüdinnen und Juden in Amsterdam. Nur 15.000 haben die deutsche Besatzungszeit überlebt.“"
                                            },
                                            {
                                                "example_id": "2887e448-d738-4de5-9b74-a870d37a53e4",
                                                "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                                "text": "„Der Verzicht aufs Rasenmähen stärkt die Artenvielfalt bei Pflanzen und hilft vielen Insekten zu überleben.“"
                                            },
                                            {
                                                "example_id": "082fc318-d1d8-4248-b13e-4761018bdc03",
                                                "sense_id": "d2011e9e-d33d-30ed-9c07-af385b7809d3",
                                                "text": "„Bei einer Hitze von 52 Grad Celsius können Menschen im Freien nicht überleben. So heiß wurde es Ende Mai [Anm.: 2024] in Indiens Hauptstadt Neu-Delhi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37263bf3-01a1-3240-8454-72d35d61ea97",
                                        "entry_id": "25b3f9c9-61bf-3350-9859-2ad27c449b3b",
                                        "glosses": [
                                            "länger als jemand anderer leben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e419b93b-1809-423e-b047-7f49056c31b0",
                                                "sense_id": "37263bf3-01a1-3240-8454-72d35d61ea97",
                                                "text": "Seine Verfassung hat ihn überlebt und sie wird auch von keiner Seite ernsthaft in Frage gestellt."
                                            },
                                            {
                                                "example_id": "f9ec663e-e215-4a6a-9d4b-5287dc7bb131",
                                                "sense_id": "37263bf3-01a1-3240-8454-72d35d61ea97",
                                                "text": "„Äußerlich anpassungsfähig und im Innern zählebig, haben die Stierspiele bisher alle Anfeindungen überlebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f0128f0c-99e6-37a9-a269-1946e07d5f60",
                                        "entry_id": "25b3f9c9-61bf-3350-9859-2ad27c449b3b",
                                        "glosses": [
                                            "veraltet sein; nicht mehr in die Gegenwart passen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "476572d9-1a53-4c28-89bb-a599ef7e17ae",
                                                "sense_id": "f0128f0c-99e6-37a9-a269-1946e07d5f60",
                                                "text": "Herr Häussermann, Karstadt kämpft ums Überleben. Dabei hat sich die Idee vom Kaufhaus doch längst überlebt, oder?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cf77374-cb29-4de7-a6dc-c3df4e878043",
                        "source_entry_id": "00daddfc-b7d2-3f4d-a4cc-725f2d127291",
                        "source_sense_description": "to live longer than",
                        "target_lang_word": "пережи́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пережи́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8d7e4a2f-0ad0-324d-8d70-29f4378d2210",
                                        "entry_id": "512eeac0-3c04-3c68-904d-9d024c4505e3",
                                        "glosses": [
                                            "прожить, просуществовать дольше кого-то или чего-то"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db13497c-d984-443b-93ae-e4ef395f0e9a",
                                                "sense_id": "8d7e4a2f-0ad0-324d-8d70-29f4378d2210",
                                                "text": "Юрий Владимирович пережил Анатолия Андреевича месяца на два."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414549e5-9627-34f2-81f8-357fd2129465",
                                        "entry_id": "512eeac0-3c04-3c68-904d-9d024c4505e3",
                                        "glosses": [
                                            "испытать, оставшись в живых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e96f9b-1973-432a-8586-1b19ecc5c9b9",
                                                "sense_id": "414549e5-9627-34f2-81f8-357fd2129465",
                                                "text": "Генералу также надо будет организовать строительство палаточных городков, чтобы беженцы могли пережить зиму, тушить пожары, охранять школы и обеспечивать жителей водой и пищей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63971dea-a262-35aa-ae5a-b6fd79a60980",
                                        "entry_id": "512eeac0-3c04-3c68-904d-9d024c4505e3",
                                        "glosses": [
                                            "вытерпеть, перенести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2893942-2293-4941-ab9b-361aa35f4141",
                                                "sense_id": "63971dea-a262-35aa-ae5a-b6fd79a60980",
                                                "text": "Может рассказывать историю о том, как он в молодости сидел в тюрьме, будучи чуть ли не диссидентом, и что пережил за решёткой, хотя никогда в жизни ни в какой он, к счастью, тюрьме не был."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
