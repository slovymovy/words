                        "target_lang_word": "tchétchène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tchétchène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f7ed1ff-bc4d-385c-85cb-f6acc22212a1",
                                        "entry_id": "5057608a-fc9c-339d-95aa-4bea35b8c76a",
                                        "glosses": [
                                            "Relatif à la Tchétchénie, son peuple, sa culture, sa langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c6b421-2c29-4a2c-bcff-9ab16454b6c4",
                                                "sense_id": "2f7ed1ff-bc4d-385c-85cb-f6acc22212a1",
                                                "text": "L’enseignant de 47 ans a été tué par un jeune réfugié d’origine russe tchétchène de 18 ans, parce qu’il a montré des caricatures de Mahomet durant des cours sur la liberté d’expression."
                                            },
                                            {
                                                "example_id": "06b90113-ba40-4b83-9582-a3ba85099277",
                                                "sense_id": "2f7ed1ff-bc4d-385c-85cb-f6acc22212a1",
                                                "text": "« Des erreurs ont été commises », lance même le président tchétchène, Ramzan Kadyrov, en partie mis au pouvoir par Vladimir Poutine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c8ea740-4701-3e81-80d7-724a981d9f6e",
                                        "entry_id": "5057608a-fc9c-339d-95aa-4bea35b8c76a",
                                        "glosses": [
                                            "Qui appartient à la culture de la Tchétchénie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825d9c17-6d83-4e1e-a681-710819ad691f",
                                                "sense_id": "2c8ea740-4701-3e81-80d7-724a981d9f6e",
                                                "text": "A un des cris ainsi lancés accourt l’endurci patricien tchétchène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchétchène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59d0cfc3-7f08-33f4-a48a-39cb6ee199c5",
                                        "entry_id": "f851900e-3524-30d3-8797-4308490933d8",
                                        "glosses": [
                                            "Langue parlée par les Tchétchènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946f7841-31cb-4c11-86b2-656fbc88c87f",
                                                "sense_id": "59d0cfc3-7f08-33f4-a48a-39cb6ee199c5",
                                                "text": "Sont considérées comme langues officielles du Daghestan celles qui ont une littérature écrite. Elles sont au nombre de 14, soit le russe, l’azéri, l’avar (авар мацI), l’agul (агъул чӀал) [aghoul], le darghin (дарган меэ), le kumyk (du groupe turc), le lezghi (леэги чӀал), le nogaï (du groupe turc), le routoul, le tabasaran (табасаран чӀал), le tat (du groupe iranien), le tsakhur (цӀаьхна миэ) et le tchétchène (нохчийн мотт)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
