                "senses": [
                    {
                        "sense_id": "8d9bdcce-2d56-3af8-93a6-64e94d3d7e2d",
                        "entry_id": "9b5febf6-23eb-38e1-bff5-2f9cbfcf32a4",
                        "glosses": [
                            "Chaîne de montagnes s’étendant le long de la côte ouest de la péninsule Scandinave, couvrant une grande partie de la Norvège, une partie de la Suède et une petite partie de la Finlande, sur 1,700 km avec une largeur maximale de 300 km."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296d0d25-b112-40ad-bf93-9e2cb272826f",
                                "sense_id": "8d9bdcce-2d56-3af8-93a6-64e94d3d7e2d",
                                "text": "La chaîne des Scandes s’étend sur 2 000 km de longueur et 200 à 300 km de largeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
