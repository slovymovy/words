                "forms": [],
                "senses": [
                    {
                        "sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "glosses": [
                            "het betreuren van een eerdere kwalijke daad, spijt, schuldgevoel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55507d44-7fea-488b-aa2a-5f27d71befe7",
                                "sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                                "text": "Japanse premier spreekt berouw uit over leed WOII"
                            },
                            {
                                "example_id": "02dc2f42-6d5f-4e78-9051-f6582cf01490",
                                "sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                                "text": "'Wat wil je nu eigenlijk zeggen, Hannah met een h? Jezus, als ik je beledigd heb op wat voor manier dan ook, sorry!' Er klinkt geen enkel spoortje berouw in haar zogenaamde spijtbetuiging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4375fadf-bcb5-4274-9533-706f79e25f34",
                        "source_entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "source_sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "source_sense_description": "het betreuren van een eerdere kwalijke daad",
                        "target_lang_word": "remorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d88fa4b-782f-3de8-9c22-d489eb9965fd",
                                        "entry_id": "acfdd1de-fc66-3021-a5b9-024ef1652e86",
                                        "glosses": [
                                            "A feeling of regret or sadness for doing wrong or sinning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0cf6aa0-29ea-4b01-802d-460560933081",
                                                "sense_id": "9d88fa4b-782f-3de8-9c22-d489eb9965fd",
                                                "text": "In criminal proceedings, empirical studies have shown that remorse plays an important role in observers’ judgments of defendants."
                                            },
                                            {
                                                "example_id": "52c506e6-5887-42d1-85e0-333685865742",
                                                "sense_id": "9d88fa4b-782f-3de8-9c22-d489eb9965fd",
                                                "text": "Failure, disgrace, poverty, sorrow, despair, suffering, tears even, the broken words that come from lips in pain, remorse that makes one walk on thorns, conscience that condemns . . . —all these were things of which I was afraid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c6b6773-1201-3138-a788-f3e53fdc1bcd",
                                        "entry_id": "acfdd1de-fc66-3021-a5b9-024ef1652e86",
                                        "glosses": [
                                            "Sorrow; pity; compassion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78692bde-9082-4018-bd4d-301708dac57d",
                                                "sense_id": "9c6b6773-1201-3138-a788-f3e53fdc1bcd",
                                                "text": "This is the bloodiest shame,\nThe wildest savagery, the vilest stroke,\nThat ever wall-eyed wrath or staring rage\nPresented to the tears of soft remorse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc37f572-7862-3039-af51-af951338bb36",
                                        "entry_id": "38cd9d37-b1f0-3206-af4d-99f5b0efebc0",
                                        "glosses": [
                                            "To experience remorse; to regret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a07b95-5dc8-4449-a293-72a1673798e5",
                                                "sense_id": "dc37f572-7862-3039-af51-af951338bb36",
                                                "text": "And if we look abroad, to take a view of men as they are, we shall find that they remorse in one place, for doing or omitting that which others, in another place, think they merit by."
                                            },
                                            {
                                                "example_id": "38c14825-1560-4d23-9622-2cc0df0f27eb",
                                                "sense_id": "dc37f572-7862-3039-af51-af951338bb36",
                                                "text": "When they have accepted their advice and have some upleasant experience then they remorse."
                                            },
                                            {
                                                "example_id": "64e59efb-f8b0-4f1f-83cd-cf47de4382d7",
                                                "sense_id": "dc37f572-7862-3039-af51-af951338bb36",
                                                "text": "Then with godly sorrow they remorse with a humble heart, and they repent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7109d774-87c0-4c9d-bc2b-9bf98047501f",
                        "source_entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "source_sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "source_sense_description": "het betreuren van een eerdere kwalijke daad",
                        "target_lang_word": "repentance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repentance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a0d973-6b97-3ee1-a9d3-cf2480e5b3a9",
                                        "entry_id": "16ef1bac-a5a2-3c04-9697-dd98732c4eac",
                                        "glosses": [
                                            "The condition of being repentant, penitent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89775ded-8b5e-4c5c-9326-b1b858e12449",
                                                "sense_id": "81a0d973-6b97-3ee1-a9d3-cf2480e5b3a9",
                                                "text": "1678, Bunyan, The Pilgrim's Progress, second period\nGod hath denied me repentance. His words gives me no encouragement to believe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521ebf6d-3993-3c95-8c26-243eac9b8320",
                                        "entry_id": "16ef1bac-a5a2-3c04-9697-dd98732c4eac",
                                        "glosses": [
                                            "A feeling of regret or remorse for doing wrong or sinning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c9c09e-93ac-4a54-b6e1-825f7e274d68",
                                                "sense_id": "521ebf6d-3993-3c95-8c26-243eac9b8320",
                                                "text": "And here, shipmates, is true and faithful repentance; not clamorous for pardon, but grateful for punishment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c2dde6e-0eeb-4a80-88ca-6b89a462773f",
                        "source_entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "source_sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "source_sense_description": "het betreuren van een eerdere kwalijke daad",
                        "target_lang_word": "compunction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compunction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                        "entry_id": "f4ca972f-36fe-3b7c-a936-72748ba46bb3",
                                        "glosses": [
                                            "A pricking of conscience or a feeling of regret, especially one which is slight or fleeting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ee1cea-a22a-4d38-81db-67a5c9fb6c7d",
                                                "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                                "text": "[H]e would have had no compunction whatever in flinging him out of the highest window in Venice into the deepest water of the city."
                                            },
                                            {
                                                "example_id": "f8ea45ed-4083-42de-8e9c-33e549b62c48",
                                                "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                                "text": "Besides, to do De Joinville justice, he felt, too, a degree of kindly compunction for the former harsh judgment entertained of one who so little deserved it; and—for there is no such thing in the human mind as an unmixed sensation—he was struck both with the spirit with which she resented, and the proud humility with which she forgave the affront."
                                            },
                                            {
                                                "example_id": "ff93cb82-6cd2-477f-8452-65588034a801",
                                                "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                                "text": "His age—his kindness, disarmed Pen’s anger somewhat, and made Arthur feel no little compunction for the deed which he was about to do."
                                            },
                                            {
                                                "example_id": "c02d2ddd-5df1-4af9-b390-0135270975d6",
                                                "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                                "text": "[T]he instant the door had closed behind him, I leaned over and looked at the letters, which were face down on the table. I felt no compunction in doing so, for under the circumstances I felt that I should protect myself in every way I could."
                                            },
                                            {
                                                "example_id": "d45991ab-12a0-4aa7-b6e8-e0fa1be54a64",
                                                "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                                "text": "But he felt, later, a little compunction. He had been violent, cruel with poor Hermione. He wanted to recompense her, to make it up."
                                            },
                                            {
                                                "example_id": "430d4572-9c65-4f47-91bf-71ba7c19a674",
                                                "sense_id": "486d5537-47f3-3e6f-9212-7df5c2754c71",
                                                "text": "As for average U.S. consumers, they've shown little compunction about buying diamonds that fund bloody militias in Africa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b01757cf-eb72-427d-9259-50f287efe7bd",
                        "source_entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "source_sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "source_sense_description": "het betreuren van een eerdere kwalijke daad",
                        "target_lang_word": "contrition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                        "entry_id": "9f8a34b7-93f0-3039-9645-74664e42da9c",
                                        "glosses": [
                                            "The state of being contrite; sincere penitence or remorse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da100a86-da5e-4a26-b2f3-7f65aad89904",
                                                "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                                "text": "Jonathan's mother told Grace on a recent phone call that Jonathan showed no sign of remorse or contrition for his own sister's passing."
                                            },
                                            {
                                                "example_id": "14a692d7-6123-402a-b717-de58f5eefad9",
                                                "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                                "text": "President Trump on Tuesday showed no contrition or regret for instigating the mob that stormed the Capitol and threatened the lives of members of Congress and his vice president, saying that his remarks to a rally beforehand were “totally appropriate” and that the effort by Congress to impeach and convict him was “causing tremendous anger.”"
                                            },
                                            {
                                                "example_id": "eff199eb-e612-47ff-bf5c-a7eb40ace5ba",
                                                "sense_id": "83cb1a06-0411-365a-acbd-fb199defc6f4",
                                                "text": "Kremlin officials have shown no signs of contrition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c398ba7-5951-38e2-ab03-49131a057ed7",
                                        "entry_id": "9f8a34b7-93f0-3039-9645-74664e42da9c",
                                        "glosses": [
                                            "The act of grinding or rubbing to powder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ffd5e4-4c0f-40d7-8e67-9860611e1337",
                        "source_entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "source_sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "source_sense_description": "het betreuren van een eerdere kwalijke daad",
                        "target_lang_word": "contrition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d79ccf8-6c99-397e-81cd-5567d3993f7b",
                                        "entry_id": "8f3928c7-594b-3f25-bc76-2729be01aab3",
                                        "glosses": [
                                            "État de celui, de celle, qui est contrit, qui est plein de regrets pour ses péchés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb90854-219d-45b6-bbdb-8e56bf79dc1c",
                                                "sense_id": "2d79ccf8-6c99-397e-81cd-5567d3993f7b",
                                                "text": "Et si je n’avais pas la contrition ? Si je venais seulement ici, tout de suite après mon péché, parce que j’ai peur de mourir ?"
                                            },
                                            {
                                                "example_id": "321d248b-e156-4fea-9062-6230678220a0",
                                                "sense_id": "2d79ccf8-6c99-397e-81cd-5567d3993f7b",
                                                "text": "Avec des soupirs de contrition, le précepteur avoua le repentir dont il était pénétré pour avoir ouvert les portes de la préceptorerie à Rébecca et à son amant."
                                            },
                                            {
                                                "example_id": "7a3f22b6-f66b-4831-ae9d-59523c0e6c45",
                                                "sense_id": "2d79ccf8-6c99-397e-81cd-5567d3993f7b",
                                                "text": "Malgré lui, M. Hyacinthe, saisi par le mystère du lieu, parle bas comme s’il énumérait avec contrition une longue suite de péchés tous mortels."
                                            },
                                            {
                                                "example_id": "1d1e071f-d620-45ea-af86-31d256251baa",
                                                "sense_id": "2d79ccf8-6c99-397e-81cd-5567d3993f7b",
                                                "text": "Et elle continue ainsi son acte de contrition, heureuse de se trouver coupable, comme on l’est, au jour de l’examen, de découvrir des fautes dans la dictée qu’on relit."
                                            },
                                            {
                                                "example_id": "6039bab7-2ea7-46f2-a553-4e4960ad2ec8",
                                                "sense_id": "2d79ccf8-6c99-397e-81cd-5567d3993f7b",
                                                "text": "La contrition implique le repentir absolu, profond et, pour cela même, digne de pardon. Et comme on nous l’a enseigné au catéchisme […], cela n’a rien à voir avec l’attrition, qui est un repentir intéressé, motivé par la peur du châtiment, non accompagné d’une volonté sincère de ne pas récidiver. La contrition rachète l’individu, contrairement à l’attrition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c1043b-ecf3-3b14-b76f-c94cd9d940ef",
                                        "entry_id": "8f3928c7-594b-3f25-bc76-2729be01aab3",
                                        "glosses": [
                                            "État psychologique d'une personne qui, quoique sans motif religieux, ressent une responsabilité et veut corriger des erreurs passées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62be0f88-29b1-4730-8481-bb62a9471dda",
                                                "sense_id": "62c1043b-ecf3-3b14-b76f-c94cd9d940ef",
                                                "text": "Ces derniers [les Anglo-Montréalais] sont en pleine contrition en raison de la Loi sur les Indiens. (Mais ils ne ressentent aucun remords pour la manière dont ils ont historiquement traité les Québécois francophones)."
                                            },
                                            {
                                                "example_id": "0f90e4d8-de83-4ff5-8a03-0917e3d8ea27",
                                                "sense_id": "62c1043b-ecf3-3b14-b76f-c94cd9d940ef",
                                                "text": "J’étais venu à confesse, et il était normal qu’une attente douloureuse m’amenât à un peu plus de contrition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "656cfcf7-37a7-461c-8001-95a6e8171bcc",
                        "source_entry_id": "9269927b-bd84-39a0-8037-e3a77251536a",
                        "source_sense_id": "063d8fdc-1884-35af-b80b-87781e662523",
                        "source_sense_description": "het betreuren van een eerdere kwalijke daad",
                        "target_lang_word": "arrepentimiento",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrepentimiento",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5e430942-f783-38e5-b55d-5426064dc3e9",
                                        "entry_id": "16bcfc03-790b-31ca-9a17-9e2fe9406db0",
                                        "glosses": [
                                            "Acción o efecto de arrepentirse."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5714b016-33ab-3ec9-a5f9-b4d923c4b09d",
                                        "entry_id": "16bcfc03-790b-31ca-9a17-9e2fe9406db0",
                                        "glosses": [
                                            "Concepto por el cual una persona reconoce que no es buena y ha cometido pecados, y que por tanto necesita someterse a Dios para alcanzar el Paraíso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753decc3-9d23-4178-9f0b-bd3124c17a67",
