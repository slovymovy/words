                                        "sense_id": "b97b0249-9c9f-39c9-b6ed-0df3e15fe43c",
                                        "entry_id": "df24ea64-a514-37f3-861f-b2e67a077f94",
                                        "glosses": [
                                            "An iconic pyramidal mountain on the border of Switzerland and Italy."
