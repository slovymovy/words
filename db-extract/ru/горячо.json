                "translations": [
                    {
                        "translation_id": "812d8c64-e72c-46ad-b9f9-ba3db65e6aa4",
                        "source_entry_id": "a87ce398-e9f5-3d7f-9311-2a9cc4717b31",
                        "source_sense_description": "страстно",
                        "target_lang_word": "eagerly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eagerly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f05b7d-da5b-3ef1-9efb-6838b9f684ee",
                                        "entry_id": "1748034a-356a-3b14-aaf5-8b21fa93f9d2",
                                        "glosses": [
                                            "In an eager manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66927717-d80b-4616-b34f-8b9de46a6b2e",
                                                "sense_id": "d9f05b7d-da5b-3ef1-9efb-6838b9f684ee",
                                                "text": "Heidi had been listening eagerly, with shining eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce328b76-7410-4ad1-8f42-0620b9887243",
                        "source_entry_id": "a87ce398-e9f5-3d7f-9311-2a9cc4717b31",
                        "source_sense_description": "страстно",
                        "target_lang_word": "ardently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ardently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9ff2a75-c309-3459-bce8-8f39c2eff2c7",
                                        "entry_id": "d7be425f-a4b7-3a45-9902-388738aab745",
                                        "glosses": [
                                            "fervently"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2767c8-969b-4719-8ffa-db5f88235717",
                                                "sense_id": "b9ff2a75-c309-3459-bce8-8f39c2eff2c7",
                                                "text": "All scandals aside, Jewish establishment donors and leaders obsessed not only with Jewish continuity but the right kind of continuity—ardently pro-Israel children of two Jewish parents—have failed on their own terms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "350114ba-2940-46ba-aff2-817423f0d98e",
                        "source_entry_id": "a87ce398-e9f5-3d7f-9311-2a9cc4717b31",
                        "source_sense_description": "страстно",
                        "target_lang_word": "passionately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passionately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                        "entry_id": "f7081c0d-aa9c-3e7b-b989-4532101928a9",
                                        "glosses": [
                                            "In a passionate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8e14ab-81a4-4a34-bbd6-86cdeb2d89d1",
                                                "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached ; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]”"
                                            },
                                            {
                                                "example_id": "a62cd9b0-a947-463e-8087-623cb5f902f4",
                                                "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                                "text": "And it was while all were passionately intent upon the pleasing and snake-like progress of their uncle that a young girl in furs, ascending the stairs two at a time, peeped perfunctorily into the nursery as she passed the hallway—and halted amazed."
                                            },
                                            {
                                                "example_id": "36f010e6-4648-4c28-a0ca-9f09480e2f8c",
                                                "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                                "text": "Was the sorrow at Mrs. Inglethorp’s death so great? I realized that there was an emotional lack in the atmosphere. The dead woman had not the gift of commanding love. Her death was a shock and a distress, but she would not be passionately regretted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
