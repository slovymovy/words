    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "555eb246-d22d-3d97-a557-609c6e6b6259",
                    "sense_definition": "Assaillir avec violence, engager un combat ou commettre une agression physique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien de garde a <w>attaqué</w> le voleur qui tentait d'entrer dans la cour."
                        },
                        {
                            "text": "Les soldats ont décidé d'<w>attaquer</w> la forteresse avant le lever du soleil."
                        }
                    ],
                    "synonyms": [
                        "assaillir"
                    ],
                    "common_phrases": [
                        "attaquer par surprise",
                        "attaquer l'ennemi"
                    ]
                },
                {
                    "sense_id": "e8ac7851-0e91-3ff7-a111-e0dd712be10a",
                    "sense_definition": "Entamer ou commencer avec énergie une tâche, un travail ou un repas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commencer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une courte pause café, nous <w>attaquons</w> la rédaction du rapport financier."
                        },
                        {
                            "text": "Tout le monde est assis à table pour <w>attaquer</w> le repas avec grand appétit."
                        }
                    ],
                    "synonyms": [
                        "commencer",
                        "entreprendre"
                    ],
                    "common_phrases": [
                        "attaquer le repas",
                        "attaquer le travail"
                    ]
                },
                {
                    "sense_id": "893a3342-0b14-3014-bc68-59f8bb3a47bc",
                    "sense_definition": "Dégrader, ronger ou altérer progressivement une matière ou un organisme vivant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deteriorer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité constante et le sel marin <w>attaquent</w> le métal du navire."
                        },
                        {
                            "text": "Ce produit chimique puissant peut rapidement <w>attaquer</w> la surface du bois verni."
                        }
                    ],
                    "synonyms": [
                        "détériorer",
                        "ronger"
                    ],
                    "common_phrases": [
                        "attaquer le métal"
                    ]
                },
                {
                    "sense_id": "70fe4c54-3243-318e-91d8-26c0a8f7747b",
                    "sense_definition": "Critiquer avec vivacité une personne, une idée ou une réputation par des paroles ou des écrits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste n'hésite pas à <w>attaquer</w> les propositions faites par le gouvernement."
                        },
                        {
                            "text": "Certains députés ont vivement <w>attaqué</w> la réputation de leur adversaire politique."
                        }
                    ],
                    "common_phrases": [
                        "attaquer la réputation"
                    ]
                },
                {
                    "sense_id": "365f9997-9298-331d-8435-5781e8a99df1",
                    "sense_definition": "Contester la légalité d'un acte ou poursuivre formellement une partie devant un tribunal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a décidé d'<w>attaquer</w> son concurrent en justice pour contrefaçon de brevet."
                        },
                        {
                            "text": "Les riverains souhaitent <w>attaquer</w> ce permis de construire devant le tribunal administratif."
                        }
                    ],
                    "common_phrases": [
                        "attaquer en justice",
                        "attaquer une décision"
                    ]
                }
            ]
        }
    ]
}