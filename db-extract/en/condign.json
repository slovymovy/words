    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                "word": "condign",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c45f15d5-8c1d-4e20-8f30-ed990bb0fd34",
                        "entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more condign"
                    },
                    {
                        "form_id": "8aa20750-4acf-41bb-8f38-e2dd494cc9fb",
                        "entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most condign"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                        "entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                        "glosses": [
                            "Fitting, appropriate, deserved, especially denoting punishment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc80d6cf-b078-43a9-a5c3-93bce73445db",
                                "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                                "text": "Vnlesse it were a bloody Murtherer,\nOr foule felonious Theefe, that fleec'd poore passengers,\nI neuer gaue them condigne punishment."
                            },
                            {
                                "example_id": "a26302db-0b39-41da-b7f3-4efa74edd6c8",
                                "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                                "text": "Consider, then, who is your best friend: he that would have brought him to condign punishment, or he that has saved him?"
                            },
                            {
                                "example_id": "1f627370-c3f2-49d0-b3d1-5dedb4d5729b",
                                "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                                "text": "When our Mahmouds or Selims of Baker Street or Belgrave Square visit their Fatimas with condign punishment, their mothers sew up Fatima’s sack for her, and her sisters and sisters-in-law see her well under water."
                            },
                            {
                                "example_id": "91f83438-5d60-4b8e-851e-13819870ff66",
                                "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                                "text": "Pooh-bah. […] And so, / Although / I wish to go, / And greatly pine / To brightly shine, / And take the line / Of a hero fine, / With grief condign / I must decline—"
                            },
                            {
                                "example_id": "7a1bf19b-0d79-4808-9040-1beeb0aeac2a",
                                "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                                "text": "For a Christian, no Beyond is acceptable or imaginable without the participation of God in our eternal destiny, and this in turn implies a condign punishment for every sin, great and small."
                            },
                            {
                                "example_id": "9d961cde-0aff-4036-b7e5-3a1b1dd94a30",
                                "sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                                "text": "Can liberals accept that an undervote usually reflects either voter carelessness, for which the voter suffers the condign punishment of an unrecorded preference, or it reflects the voter's choice not to express a preference?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e5860a-90fd-48f0-a95b-5a10cde3c7f7",
                        "source_entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                        "source_sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                        "source_sense_description": "fitting",
                        "target_lang_word": "condigne",
