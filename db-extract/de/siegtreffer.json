                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d4df18-ab50-42a7-b08b-fea6370bafac",
                                "sense_id": "be46634d-b103-370f-af1c-ad9a5f18b084",
                                "text": "„Nach einem weiten Einwurf von Filip Krstic köpfte Pieles zum umjubelten Siegtreffer für die Gastgeber ein.“"
                            },
                            {
                                "example_id": "179ea16a-193c-40e5-98ec-7f62d1129a1f",
                                "sense_id": "be46634d-b103-370f-af1c-ad9a5f18b084",
                                "text": "„Doch Frankfurt spielte druckvoll weiter, wollte den Siegtreffer und gewann durch ein Tor von Nationalspielerin Fatmire Bajramaj tatsächlich noch mit 2:1.“"
                            }
                        ],
