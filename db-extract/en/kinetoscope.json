                        "entry_id": "26d28fe7-31e9-366d-bf8d-a0a7bb27352c",
                        "glosses": [
                            "An early device for exhibiting motion pictures, creating the illusion of movement from a strip of perforated film bearing sequential images that is conveyed over a light source with a high-speed shutter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c9d636-6821-4c6a-bd55-804a299297b3",
                                "sense_id": "14c88dab-0a99-3083-89cb-4204d7d1974b",
                                "text": "A paper-over-board book based on a new technology that its inventor, the author, calls “scanimation”: mimicking the effect of a kinetoscope, the pictures of animals, birds and fish seem to move with extraordinary naturalism."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ef6a962-e1b8-38c3-bd84-1d24eea49adc",
                        "entry_id": "26d28fe7-31e9-366d-bf8d-a0a7bb27352c",
                        "glosses": [
                            "An instrument for illustrating the production of kinematic curves by the combination of circular movements of different radii."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f61602f-4a91-41da-b365-63d613b8290d",
                        "source_entry_id": "26d28fe7-31e9-366d-bf8d-a0a7bb27352c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "kinétoscope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kinétoscope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d3d2b31-0554-3e54-9cb6-e5f7f0b2e01f",
                                        "entry_id": "1b5b40f1-8fc9-31ac-a6f2-eab6595603d4",
                                        "glosses": [
                                            "Appareil qui permet la vision individuelle de films grâce à un système de défilement continu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040bf569-76f5-4b48-9e3d-1410defd54e0",
                                                "sense_id": "0d3d2b31-0554-3e54-9cb6-e5f7f0b2e01f",
                                                "text": "Le kinétoscope fut inventé par Edison en 1890."
                                            },
                                            {
                                                "example_id": "69def80a-e6e1-4269-926c-ddf7c28c6d28",
                                                "sense_id": "0d3d2b31-0554-3e54-9cb6-e5f7f0b2e01f",
                                                "text": "Ces évocations tournoyantes et confuses ne duraient jamais que quelques secondes ; souvent ma brève incertitude du lieu où je me trouvais ne distinguait pas mieux les unes des autres les diverses suppositions dont elle était faite, que nous n’isolons, en voyant un cheval courir, les positions successives que nous montre le kinétoscope. Mais j’avais revu tantôt l’une, tantôt l’autre, des chambres que j’avais habitées dans ma vie, et je finissais par me les rappeler toutes dans les longues rêveries qui suivaient mon réveil ;"
                                            },
                                            {
                                                "example_id": "8e28029a-82ef-40bc-9a65-f7787f8f6867",
                                                "sense_id": "0d3d2b31-0554-3e54-9cb6-e5f7f0b2e01f",
                                                "text": "J’aimais coller mes yeux au stéréoscope qui transformait deux plates photographies en une scène à trois dimensions, ou voir tourner dans le kinétoscope une bande d’images immobiles dont la rotation engendrait le galop d’un cheval."
                                            },
                                            {
                                                "example_id": "cf6e9b45-b582-4581-806e-aa9baf6fb28e",
                                                "sense_id": "0d3d2b31-0554-3e54-9cb6-e5f7f0b2e01f",
                                                "text": "Le kinétoscope offre aux visiteurs une plongée dans le temps, puisqu’on peut s’en servir pour regarder des films."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
