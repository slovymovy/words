                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b991ff87-f8d5-37cd-b243-fa6cc3ea70d4",
                                        "entry_id": "4abdd25f-850d-32e9-959e-dc3002905d4f",
                                        "glosses": [
                                            "Synonym of signalman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380bc7f9-2cb7-40a1-ad1b-a87edcbf0b6c",
                                                "sense_id": "b991ff87-f8d5-37cd-b243-fa6cc3ea70d4",
                                                "text": "'We're recruiting an extra signaller for Nunthorpe, the only box [signal box] on the branch', says Chris Gee, Head of Operations - North at Network Rail in York. 'From December Nunthorpe will be staffed 24/7'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4f6d155-40ff-4e30-ae06-86b2e82de745",
                        "source_entry_id": "c8908590-3bd1-3d36-9c58-840c92979a1e",
                        "source_sense_id": "7710f331-aa41-367c-bbbc-2b2a0e743f6e",
                        "target_lang_word": "flagman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flagman",
