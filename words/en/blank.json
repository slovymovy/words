{
    "word_family": [
        "blankly",
        "blankness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ccd96ed7-9bf2-366c-88ce-f107733b87e7",
                    "sense_definition": "Free from writing, printing, marks, or features; having an empty space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "empty_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She handed me a <w>blank</w> sheet of paper to write on.",
                            "target_lang_translations": {
                                "ru": "Она протянула мне <w>чистый</w> лист бумаги, чтобы я мог писать.",
                                "zh": "她递给我一张<w>空白</w>纸让我写字。"
                            }
                        },
                        {
                            "text": "The computer screen went <w>blank</w> when the power failed.",
                            "target_lang_translations": {
                                "ru": "Экран компьютера <w>погас</w>, когда отключилось электричество.",
                                "zh": "断电时电脑屏幕<w>一片空白</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "filled",
                        "written",
                        "marked"
                    ],
                    "common_phrases": [
                        "blank page",
                        "blank screen",
                        "blank check",
                        "leave blank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поверхность, на которой нет надписей, печати или пометок; имеющая пустое пространство.",
                        "zh": "指表面上没有文字、印刷、标记或特征；有空白空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "о листе бумаги"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "об экране или пространстве"
                            },
                            {
                                "target_lang_word": "незаполненный",
                                "target_lang_sense_clarification": "о бланке или форме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空白",
                                "target_lang_sense_clarification": "指没有内容"
                            },
                            {
                                "target_lang_word": "空白的",
                                "target_lang_sense_clarification": "形容词用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dedb2ca4-5fa8-31f1-84c3-96cee48da9c1",
                    "sense_definition": "Showing no feeling, understanding, or expression.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a <w>blank</w> stare when I asked him the question.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел на меня <w>пустым</w> взглядом, когда я задал ему вопрос.",
                                "zh": "当我问他那个问题时，他<w>茫然</w>地盯着我。"
                            }
                        },
                        {
                            "text": "Her face remained <w>blank</w> despite the shocking news.",
                            "target_lang_translations": {
                                "ru": "Её лицо оставалось <w>бесстрастным</w>, несмотря на шокирующие новости.",
                                "zh": "尽管听到了令人震惊的消息，她的表情依然<w>木然</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "expressive"
                    ],
                    "common_phrases": [
                        "blank stare",
                        "blank look",
                        "look blank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не выражающий никаких чувств, понимания или эмоций.",
                        "zh": "指没有表现出任何情感、理解或表情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о взгляде"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "ничего не выражающий"
                            },
                            {
                                "target_lang_word": "отсутствующий",
                                "target_lang_sense_clarification": "о взгляде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "茫然的",
                                "target_lang_sense_clarification": "形容表情或眼神"
                            },
                            {
                                "target_lang_word": "木然的",
                                "target_lang_sense_clarification": "形容表情呆滞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec25577b-db68-3cce-a14a-c500ca940e93",
                    "sense_definition": "Unable to think of anything or remember anything; devoid of thoughts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mind_memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mind went completely <w>blank</w> during the exam.",
                            "target_lang_translations": {
                                "ru": "Во время экзамена у меня в голове стало совершенно <w>пусто</w>.",
                                "zh": "考试时我的脑子完全<w>空白</w>了。"
                            }
                        },
                        {
                            "text": "I tried to remember his name, but my memory was <w>blank</w>.",
                            "target_lang_translations": {
                                "ru": "Я пытался вспомнить его имя, но в памяти была <w>пустота</w>.",
                                "zh": "我试图想起他的名字，但记忆里一片<w>空白</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mind went blank",
                        "memory is blank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный что-либо придумать или вспомнить; лишенный мыслей.",
                        "zh": "指无法思考或回忆起任何事情；脑中一片空白。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о голове, мыслях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空白",
                                "target_lang_sense_clarification": "指思维停滞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb79e289-feaf-3a1a-b3ce-01c0f83cc446",
                    "sense_definition": "Of ammunition: containing gunpowder but no bullet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ammunition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers used <w>blank</w> rounds for the training exercise.",
                            "target_lang_translations": {
                                "ru": "Солдаты использовали <w>холостые</w> патроны для учебных упражнений.",
                                "zh": "士兵们在训练演习中使用了<w>空包弹</w>。"
                            }
                        },
                        {
                            "text": "It is dangerous to fire even a <w>blank</w> cartridge at close range.",
                            "target_lang_translations": {
                                "ru": "Опасно стрелять даже <w>холостым</w> патроном с близкого расстояния.",
                                "zh": "近距离发射<w>空包弹</w>也是危险的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "live"
                    ],
                    "common_phrases": [
                        "blank cartridge",
                        "blank rounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "О боеприпасах: содержащий порох, но без пули.",
                        "zh": "指弹药：含有火药但没有弹头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холостой",
                                "target_lang_sense_clarification": "о патроне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空包弹",
                                "target_lang_sense_clarification": "指无弹头的子弹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32dadc60-e3ee-39da-962b-c36d3a43e427",
                    "sense_definition": "Complete and absolute (usually used with negative nouns).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His request was met with a <w>blank</w> refusal.",
                            "target_lang_translations": {
                                "ru": "Его просьба встретила <w>категорический</w> отказ.",
                                "zh": "他的请求遭到了<w>断然</w>拒绝。"
                            }
                        },
                        {
                            "text": "There was a look of <w>blank</w> terror on the child's face.",
                            "target_lang_translations": {
                                "ru": "На лице ребенка было выражение <w>полного</w> ужаса.",
                                "zh": "孩子脸上露出了<w>彻底的</w>恐惧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blank refusal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный и абсолютный (обычно используется с существительными, имеющими негативный оттенок).",
                        "zh": "指完全且绝对的（通常用于负面名词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "абсолютный"
                            },
                            {
                                "target_lang_word": "категорический",
                                "target_lang_sense_clarification": "об отказе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彻底的",
                                "target_lang_sense_clarification": "强调程度"
                            },
                            {
                                "target_lang_word": "断然的",
                                "target_lang_sense_clarification": "用于拒绝"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc6b1df1-fc55-392b-8744-b6eef1d31804",
                    "sense_definition": "An empty space on a document or form to be filled in.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "empty_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please fill in the <w>blanks</w> with the correct answers.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, заполните <w>пропуски</w> правильными ответами.",
                                "zh": "请在<w>空格</w>处填入正确答案。"
                            }
                        },
                        {
                            "text": "Write your name in the <w>blank</w> at the top of the page.",
                            "target_lang_translations": {
                                "ru": "Напишите свое имя в <w>пустом поле</w> вверху страницы.",
                                "zh": "在页面顶部的<w>空白处</w>写下你的名字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill in the blanks",
                        "leave a blank"
