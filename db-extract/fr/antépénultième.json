                                                "sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                                                "text": "This book has ten chapters — chapter 8 is the antepenultimate one."
                                            },
                                            {
                                                "example_id": "fac978e0-0f8b-4ec6-bda0-eee54cf8613e",
                                                "sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                                                "text": "[…] they [the sounds of an echo] next strike the ultimate secondary object, then the penultimate and antepenultimate; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
