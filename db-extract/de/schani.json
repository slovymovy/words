                "senses": [
                    {
                        "sense_id": "a1c1f199-a7ce-3d94-8a05-65437198a6f7",
                        "entry_id": "429fd831-ccc5-314a-9e77-31a778bba1ea",
                        "glosses": [
                            "helfender Mitarbeiter (vor allem in der Gastronomie); Diener, Handlanger"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "42dee636-b973-4e63-a175-4e59f269edee",
                                "sense_id": "a1c1f199-a7ce-3d94-8a05-65437198a6f7",
                                "text": "„Du, Schani, wann gibt es was zum Trinken?“"
                            },
                            {
                                "example_id": "5c6a9dc8-33ad-48e2-aa84-8c8b93d3173a",
                                "sense_id": "a1c1f199-a7ce-3d94-8a05-65437198a6f7",
                                "text": "„In Schuldiener sein Schani horrchte von draussen zu und sagte zu mier: Hörst Poldi, das schaugn mir sich an, diese Schweineren, daß muß eine Gaudee sein.“",
                                "translation": "Der Helfer des Hausmeisters lauschte von draußen und sagte zu mir: Hör zu Poldi, das schauen wir uns an, diese Schweinereien, das muss ein Spaß sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
