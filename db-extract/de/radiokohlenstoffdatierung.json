                "senses": [
                    {
                        "sense_id": "c61df0ec-49aa-30a4-89da-d31f8f437dcf",
                        "entry_id": "a3ce33f9-484f-352d-85f9-8387fac08380",
                        "glosses": [
                            "Methode zur Bestimmung des Alters von kohlenstoffhaltigen organischen Materialien mit einem Alter bis etwa 60.000 Jahre basierend auf dem radioaktiven Zerfall des Kohlenstoff-Isotops ¹⁴C."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5139e2b-ef66-4a89-87e1-6c3c4d704ecd",
                                "sense_id": "c61df0ec-49aa-30a4-89da-d31f8f437dcf",
                                "text": "„Die Radiokohlenstoffdatierung ergab ein Alter zwischen 10 000 und 11 200 Jahren.“"
                            },
                            {
                                "example_id": "356d55cc-e4a2-4f47-9eea-a83fd0f47212",
                                "sense_id": "c61df0ec-49aa-30a4-89da-d31f8f437dcf",
                                "text": "„Um das Alter der Holzfunde zu eruieren, gab das Museum eine Radiokohlenstoffdatierung in Auftrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
