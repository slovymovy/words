                                "target_lang_sense_clarification": "erfreulich, wohltuend"
                            },
                            {
                                "target_lang_word": "vergnüglich",
                                "target_lang_sense_clarification": "Freude bereitend"
                            },
                            {
                                "target_lang_word": "behaglich",
                                "target_lang_sense_clarification": "wohlig, bequem"
                            }
                        ]
                    }
                }
            ]
        },
        {
