                        "glosses": [
                            "Ernte, mit einem nie zuvor erreichten Ernteertrag; außergewöhnlich gute Ernte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a12138-e02b-46a9-9f34-f36caba3a805",
                                "sense_id": "0510256e-e67d-3ace-8e5f-b5ec9a0a72b6",
                                "text": "„Auch in Russland wurden die Prognosen mehrfach erhöht, und zwar auf die Rekordernte von 65 Millionen Tonnen.“"
                            },
                            {
                                "example_id": "ce168699-ae12-4eea-83eb-4f09d94908d8",
                                "sense_id": "0510256e-e67d-3ace-8e5f-b5ec9a0a72b6",
                                "text": "„In den ersten zwei Jahren lief die landwirtschaftliche Produktion gut an, wozu auch der ausreichende Regen beitrug, so dass die weißen Farmer ebenso wie die Kleinbauern Rekordernten einfahren konnten.“"
                            }
                        ],
