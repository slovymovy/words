                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f735b19-afcc-3f54-bfd1-73b42b518fff",
                        "entry_id": "311838bf-5f15-3422-8f2b-0f730c354bfc",
                        "glosses": [
                            "genitief van elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8be546b-393b-456d-bc4c-e4412a2c8664",
                                "sense_id": "3f735b19-afcc-3f54-bfd1-73b42b518fff",
                                "text": "We maken de schoenen van elkaar schoon. => We maken elkaars schoenen schoon."
                            },
                            {
                                "example_id": "11cd9d1a-5c66-4952-aad9-1248daa027a8",
                                "sense_id": "3f735b19-afcc-3f54-bfd1-73b42b518fff",
                                "text": "Gebroederlijk pakten we elkaars handen vast en liepen de trap op van de enige winkel van het dorp, die ook dienst deed als centrale hangplek voor alle hikers."
                            },
                            {
                                "example_id": "64f67416-c7a4-4536-842c-0b15bf934b27",
                                "sense_id": "3f735b19-afcc-3f54-bfd1-73b42b518fff",
                                "text": "In zijn donkere cel hebben ze gisteravond zwijgend een uur elkaars hand vastgehouden."
                            },
                            {
                                "example_id": "61fa114f-f177-4fe7-8274-4afa0a70553c",
                                "sense_id": "3f735b19-afcc-3f54-bfd1-73b42b518fff",
                                "text": "De jonge weduwe, de min, Otto en Thea, Cornelia - zullen ze elkaars geheimen ontdekken? Ze zijn allemaal losse draadjes - maar dat is altijd zo geweest, denkt Nella."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
