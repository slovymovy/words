                ],
                "senses": [
                    {
                        "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                        "entry_id": "a41cca00-2849-3ef7-ad89-f9deec65764e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0103c042-7e57-44ba-9cda-a2e89af301bd",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Frau Wöhrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7afe4ce6-0101-4f66-918c-36f4aebdb414",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Herr Wöhrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "71505a53-4475-4ca9-9370-a233f8bc57b1",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Die Wöhrles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d85f7fef-3e28-4d1c-8a51-f4501fdc01b0",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Der Wöhrle trägt nie die Pullover, die die Wöhrle ihm strickt."
                            },
                            {
                                "example_id": "a875e619-7453-4bd0-a216-e794046625b9",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wöhrle kommt, geht der Herr Wöhrle.“"
                            },
                            {
                                "example_id": "2b3883c7-5d31-45a4-8570-76e30bbe1a8d",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Wöhrle kommt und geht."
                            },
                            {
                                "example_id": "27581ce2-1227-4826-a2b0-7eca0cb9f481",
                                "sense_id": "9da4c78c-4110-3161-b4b1-3177a589d00c",
                                "text": "Wöhrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
