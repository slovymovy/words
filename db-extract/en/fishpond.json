                        "target_lang_word": "садо́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "садо́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6dcf81-dba3-34ea-af15-98c955f65401",
                                        "entry_id": "6afef766-e65c-3f2e-ae3f-b58efddaa8e2",
                                        "glosses": [
                                            "искусственный водоём для содержания и разведения рыбы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d551cd-1f98-46ac-ab48-2f38edbf7d8a",
                                                "sense_id": "1e6dcf81-dba3-34ea-af15-98c955f65401",
                                                "text": "Прорезь — живорыбный садок на Волге и на низовьях Оки."
                                            },
                                            {
                                                "example_id": "284d68bf-d72d-41ab-ba5f-14346ccb65ba",
                                                "sense_id": "1e6dcf81-dba3-34ea-af15-98c955f65401",
                                                "text": "Буфетчик дрожит и путается языком, но рассказал, что камердинер, проводивши генерала, совсем был здоров и ходил на рыбный садок, себе рыбу купил…"
                                            },
                                            {
                                                "example_id": "997234c4-7345-4929-9531-67378d12e845",
                                                "sense_id": "1e6dcf81-dba3-34ea-af15-98c955f65401",
                                                "text": "Отец велел городить в пруду садки, варил месиво для прикорму и приносил пробных лягушек домой, покуда матушка не заявила, что либо она, либо лягушки, которых она боится до смерти, и что ей противно жить, когда этой гадости полон дом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca9af12b-909c-34fc-96d0-33ea5b3cb420",
                                        "entry_id": "6afef766-e65c-3f2e-ae3f-b58efddaa8e2",
                                        "glosses": [
                                            "помещение для содержания, разведения или откорма птицы и мелких животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c47691-5d63-447d-bc37-42e1fef1b4fb",
                                                "sense_id": "ca9af12b-909c-34fc-96d0-33ea5b3cb420",
                                                "text": "В притворе храма стояла скотина — коровы, быки, бараны, и были сделаны садки с голубями, и сидели за лавками менялы с деньгами."
                                            },
                                            {
                                                "example_id": "07f33ec3-ae43-4bf9-9ef4-b4ff89e83e3c",
                                                "sense_id": "ca9af12b-909c-34fc-96d0-33ea5b3cb420",
                                                "text": "Все трое, они были чужими в доме, как будто случайно попали в одну из клеток этого большого садка для кур, напоминая синиц, которые, спасаясь от мороза, влетают через форточку в душное и грязное жилище людей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab4f0aaf-bdc0-38ff-a4c8-779db3553fda",
                                        "entry_id": "6afef766-e65c-3f2e-ae3f-b58efddaa8e2",
                                        "glosses": [
                                            "охотн. название ряда ловушек для зверей и дичи"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "садо́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2323ea5b-39fc-3695-b9af-cd17f75e6d36",
                                        "entry_id": "2c8124fa-ddbd-3dbf-9428-3ca194c9fa88",
                                        "glosses": [
                                            "уменьш. к сад; небольшой сад"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498f2897-6917-4863-af13-e56078425b39",
                                                "sense_id": "2323ea5b-39fc-3695-b9af-cd17f75e6d36",
                                                "text": "Смотреть в этот садок, любоваться живыми и быстрыми движениями миловидных птичек и наблюдать, как они едят, пьют и ссорятся между собой — было для меня истинным наслаждением."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
