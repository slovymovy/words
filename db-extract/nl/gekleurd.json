                            {
                                "example_id": "98366e16-d2e3-43c0-9c67-1116d42b74f4",
                                "sense_id": "be7264ca-c552-3501-8754-51e451a75810",
                                "text": "Kunstmatig gekleurde diamanten zijn veel goedkoper dan de natuurlijke."
                            },
                            {
                                "example_id": "e96f624f-66ba-40f6-9c52-def8b7df7493",
                                "sense_id": "be7264ca-c552-3501-8754-51e451a75810",
                                "text": "Dan heeft deze auto ook nog het Style+ pakket (€426) dat bestaat uit chromen sierlijsten, vermoeidheidsherkenning, chromen sierlijsten op de portieren, gekleurde panelen in het dashboard en het dak én de voorste raamstijl en de spiegelkappen in een afwijkende kleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd9ff471-0579-37df-b4d7-348e4fb84057",
                        "entry_id": "c18fffd9-878a-336e-b40d-90abec053377",
                        "glosses": [
                            "met een niet-blanke huidskleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "437f4c9d-0dd5-4d6f-aabd-5a671c5ff142",
                                "sense_id": "bd9ff471-0579-37df-b4d7-348e4fb84057",
                                "text": "Na een fout bij een ivf-behandeling heeft een blank stel een gekleurde baby gekregen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f44345e-d6d1-3626-965b-7af74d56818e",
                        "entry_id": "c18fffd9-878a-336e-b40d-90abec053377",
