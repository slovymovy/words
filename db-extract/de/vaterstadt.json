                    {
                        "form_id": "a58b0555-06f6-49cd-965b-41e90c6ef82a",
                        "entry_id": "eb24e0f7-5ce8-3fa8-8df7-28384649d0d3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vaterstädte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                        "entry_id": "eb24e0f7-5ce8-3fa8-8df7-28384649d0d3",
                        "glosses": [
                            "Stadt, aus der man stammt, der man sich zugehörig fühlt und so weiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb143ba-c6a7-4ed2-97c8-fe4af93f988a",
                                "sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                                "text": "„Da wo der Oder-Fluß die überschiffte fluthen Reibt an ein fruchtbahr land und an geschwancke ruhten / Da wo die vaterstadt in ihm den schatten macht / Und unser hirten-volck um deren Nymfen wacht; War ein erhabner ort mit bäumen rings umgeben / So lustig / daß nach ihm auch fremde hirten streben / Dahin verfügte sich die gantze hirten-schaar / Wenn allen vom Montan was vorzutragen war.“ (vor 1708)"
                            },
                            {
                                "example_id": "915eecc2-c775-42da-a93c-e6df52685413",
                                "sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                                "text": "„Rosa ist ein vortreflicher Mensch, er ist ein geborner Römer und stolz auf seine Vaterstadt […]“ (1795)"
                            },
                            {
                                "example_id": "7ebcb580-042e-475a-a4ba-f61940a9cd9f",
                                "sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                                "text": "„Dies war Tonio Krögers seltsamer Aufenthalt in seiner Vaterstadt.“ (1903)"
                            },
                            {
                                "example_id": "e88d35c7-b358-472d-b0cc-f8e5279bb52a",
                                "sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                                "text": "„Der 63jährige ‚rasende Reporter‘, der auf allen Längen- und Breitengraden unterwegs war, starb in seiner Vaterstadt Prag, in die er nach dem zweiten Weltkrieg zurückgekehrt war.“"
                            },
                            {
                                "example_id": "c2c2a931-c594-414f-b7b0-bb4f8f8201b4",
                                "sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                                "text": "„Kurze Zeit zuvor hatte die DDR-Regierung erreicht, daß die Leichen des Generals und seiner Frau von dem seit 1945 weitgehend zerstörten Breslauer Militärfriedhof in seine Vaterstadt überführt werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ef31da8-c6f4-433f-adda-6c066f4f5cd4",
                        "source_entry_id": "eb24e0f7-5ce8-3fa8-8df7-28384649d0d3",
                        "source_sense_id": "6aea907d-668a-3525-813d-475d4e9dd510",
                        "source_sense_description": "Stadt, aus der man stammt, der man sich zugehörig fühlt und so weiter",
                        "target_lang_word": "hometown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hometown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                        "entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                                        "glosses": [
                                            "An individual’s place of birth, childhood home, or place of main residence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a411e779-63cd-4e08-ae1a-f2994494ca76",
                                                "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                                "text": "These vehicles convey Esther from her hometown hospital, then to a city hospital, and finally from the city hospital in another hearselike conveyance […]"
                                            },
                                            {
                                                "example_id": "663e9ffb-5dbc-4eca-a526-21d15f411a02",
                                                "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                                "text": "“It’s not good stewardship. If the guests wanted to walk through a funhouse with guys jumping out of the shadows saying ‘booga-booga,’ they’d go to one of the Halloween Houses in their hometowns. The Mansion’s better than that. I can’t be a part of this plan.”"
                                            },
                                            {
                                                "example_id": "fa0157a6-a075-4cc2-b17b-65bb9343d5af",
                                                "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                                "text": "Candace Rivers’ involvement with trucking began, fittingly, on Interstate 20 not far from her hometown of Oxford, Alabama."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae53230c-f062-3195-bd9b-b410beefaa05",
                                        "entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                                        "glosses": [
                                            "Designating a decision or judgement that is biased, or perceived to be biased, in favour of local preference."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7e4d5ba-5f69-4729-80d5-3fd2b9cc22d9",
                                                "sense_id": "ae53230c-f062-3195-bd9b-b410beefaa05",
                                                "text": "hometown decision, hometown verdict"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
