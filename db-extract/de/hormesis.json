                        "sense_id": "31a0ce9b-f867-34f4-b12c-1a464c067f58",
                        "entry_id": "4f436cca-845c-37af-8a48-442c6a38999a",
                        "glosses": [
                            "Phänomen, dass kleinste Dosen einer eigentlich giftigen oder schädlichen Substanz oder Strahlung positive Wirkung haben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e22cac1-fa5e-4a2d-b24b-c46ff1118b25",
                                "sense_id": "31a0ce9b-f867-34f4-b12c-1a464c067f58",
                                "text": "„Es gibt einige Hinweise, dass bei diesem niedrigem Niveau, chronische Strahlung nicht ganz so gefährlich ist wie früher angenommen; und dass bei Strahlung Hormesis auftritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
