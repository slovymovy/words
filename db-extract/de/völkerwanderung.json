                        "examples": [
                            {
                                "example_id": "c18b9c8b-1b34-4369-80c2-2004c114de78",
                                "sense_id": "b2ced8d3-5862-36ae-b432-202ba0068f22",
                                "text": "Die großen Epochen in der Geschichte verknüpfen sich zu genau mit einander, als daß die eine ohne die andre erklärt werden könnte; und die Begebenheit der Kreuzzüge ist nur der Anfang zur Auflösung eines Räthsels, das dem Philosophen der Geschichte in der Völkerwanderung aufgegeben worden.",
                                "translation": "On the Barbarian Invasions, Crusaders and Middle Ages",
                                "english": "On the Barbarian Invasions, Crusaders and Middle Ages"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4c1a5f1-23b3-3bef-9f15-b5864a2f011b",
                        "entry_id": "6ef0362a-34a2-3199-a44e-7554e10c5d23",
                        "glosses": [
                            "any movement of people"
                        ],
                        "tags": [
                            "broadly",
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "4a6a54c0-b483-4b1f-af03-1605c792b663",
                                "sense_id": "f4c1a5f1-23b3-3bef-9f15-b5864a2f011b",
                                "text": "„Schon im Frühling gab es buchstäblich Völkerwanderungen in die Berliner Wälder“, erzählt Marc Franusch."
                            }
                        ]
