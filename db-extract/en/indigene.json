                    {
                        "translation_id": "26cac481-6cbb-4354-9109-8a950fb2abb9",
                        "source_entry_id": "4e36b132-5eb7-3cc4-a051-2b20dd73c7c8",
                        "source_sense_id": "1979ba06-15e4-3806-8d2e-2757d44a1aed",
                        "source_sense_description": "a native",
                        "target_lang_word": "Eingeborener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eingeborener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bba9374-1703-3fad-92f2-d4009c2c7f16",
                                        "entry_id": "8432de36-241a-3375-affa-48cf0073e50b",
                                        "glosses": [
                                            "Angehöriger eines Volkes, das ein bestimmtes Gebiet ursprünglich bewohnte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a21ed5-4897-43b3-b0b9-151153108a8e",
                                                "sense_id": "9bba9374-1703-3fad-92f2-d4009c2c7f16",
                                                "text": "Die Eingeborenen wurden von europäischen Kolonisten vertrieben."
                                            },
                                            {
                                                "example_id": "efb4e7e8-f7db-4bb5-ad14-dca5b8a8f3b2",
                                                "sense_id": "9bba9374-1703-3fad-92f2-d4009c2c7f16",
                                                "text": "„Welten trennten Eingeborene und Engländer.“"
                                            },
                                            {
                                                "example_id": "350c1229-8f44-4f6f-b159-bdb2b0167cce",
                                                "sense_id": "9bba9374-1703-3fad-92f2-d4009c2c7f16",
                                                "text": "„Wir sind die Eingeborenen von Trizonesien.“"
                                            },
                                            {
                                                "example_id": "a4c28bfc-cdf1-4b7f-9a5c-da0c13d553d1",
                                                "sense_id": "9bba9374-1703-3fad-92f2-d4009c2c7f16",
                                                "text": "„Handelswaren wurden in großen Einbäumen von den Schiffen an Land gebracht: Die Eingeborenen verstanden es, ihre Boote geschickt durch die heimtückische Brandung zu steuern.“"
                                            },
                                            {
                                                "example_id": "03e92d8a-8acd-4a73-9b6f-1ca7d9fb11dc",
                                                "sense_id": "9bba9374-1703-3fad-92f2-d4009c2c7f16",
                                                "text": "„So pflegte er seitdem die alten Leute begierig nach den Kämpfen auszufragen, die sie im Zuge der „friedlichen Durchdringung“ Marokkos mit den Eingeborenen geführt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
