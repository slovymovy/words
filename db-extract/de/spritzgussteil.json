                        "glosses": [
                            "Teil, das im Spritzgussverfahren maschinell gespritzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef864bf4-e2f6-47f9-9b6b-9349969e544b",
                                "sense_id": "fecb7c8c-ba3b-312f-929a-09ebffdf048c",
                                "text": "„Besonders übersichtlich können Verzug und Schwindung des Spritzgussteiles bei der Abmusterung und bei der Produktionskontrolle sichtbar gemacht werden.“"
                            },
                            {
                                "example_id": "a3b6026e-983f-450e-b98f-4f91b08a97e4",
                                "sense_id": "fecb7c8c-ba3b-312f-929a-09ebffdf048c",
                                "text": "„Von Spritzgussteilen, welche eine sichtbare Bindenaht aufweisen, ist mit großer Sicherheit ein reduziertes Einsatzverhalten zu erwarten.“"
                            }
                        ],
