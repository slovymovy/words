                                "target_senses": [
                                    {
                                        "sense_id": "f5abb5af-743b-3149-9304-d29e92f62619",
                                        "entry_id": "e1cefbb1-6d55-3f78-ad24-d35de0ee4495",
                                        "glosses": [
                                            "Part of the large intestine; the final segment of the digestive system, after (distal to) the ileum and before (proximal to) the rectum. (Because the colon is the largest part of the large intestine (constituting most of it), it is often treated as synonymous therewith in broad or casual usage.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1eb1ec-066d-4e24-8801-56f9ef12e5ff",
                                                "sense_id": "f5abb5af-743b-3149-9304-d29e92f62619",
                                                "text": "Colorectal cancer refers to colon cancer, which starts in the colon, and rectal cancer, which starts in the rectum."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colon",
                                "target_lang_code": "en",
                                "target_senses": [
