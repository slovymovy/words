                ],
                "senses": [
                    {
                        "sense_id": "2df8e898-be1a-3c61-a836-a89cefca02d5",
                        "entry_id": "0f1c6e21-d21d-3195-80cf-0bf9d1d4c74f",
                        "glosses": [
                            "interférence linguistique d’une langue postérieure à une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b97b69-13c1-4e6d-8ee6-8963efa9b3ae",
                                "sense_id": "2df8e898-be1a-3c61-a836-a89cefca02d5",
                                "text": "Cette caractéristique oblige à s’interroger sur l’influence d’adstrats c’est-à-dire de langues ayant interféré avec le latin sur ce territoire, qu’il s’agisse d’une strate linguistique antérieure au latin et supplantée par celui-ci (un « substrat ») ou d’une strate supérieure qui sans le supplanter en a conditionné certaines évolutions (un « superstrat »)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fcf10c5-90c2-44a4-8d6d-fa22c9ed101e",
                        "source_entry_id": "0f1c6e21-d21d-3195-80cf-0bf9d1d4c74f",
                        "source_sense_id": "2df8e898-be1a-3c61-a836-a89cefca02d5",
                        "target_lang_word": "Superstrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Superstrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                        "entry_id": "17284bc4-d796-32a4-8a80-b599265b7a36",
                                        "glosses": [
                                            "Linguistik, speziell Beeinflussung einer unterlegenen Sprache mit Elementen einer anderen, überlegenen Sprache"
                                        ],
                                        "tags": [
                                            "Sprachkontaktforschung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e772dbc5-ca72-4432-8bab-231eec4c5335",
                                                "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                                "text": "„Der weiteren können Verschiedenheiten durch Unterschiede von Substraten (Sprachen einheimischer Bevölkerungen bei Einwanderung) und Superstraten (Sprachen zugewanderter Eroberer) entstehen - sowie durch entsprechend starke Fremdeinflüsse.“"
                                            },
                                            {
                                                "example_id": "36113747-fb8a-4dfb-9274-325c6222932a",
                                                "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                                "text": "„Da die germanische Bevölkerung in Frankreich höchstens streckenweise in der Mehrheit war, wirkten die germanischen Sprachen, auch das Fränkische, als Superstrat, nicht als Substrat (…).“"
                                            },
                                            {
                                                "example_id": "e2bb367f-22ec-41cc-abe1-74f73b4aca51",
                                                "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                                "text": "„Sind umgekehrt aus der Sprache des überlegenen Volkes Wörter aufgenommen worden, so spricht man von einem Superstrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
