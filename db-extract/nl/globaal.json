                    {
                        "form_id": "9b2a31a9-2899-469d-80bb-5ea04c011265",
                        "entry_id": "0fde44df-26a0-3cf2-8c80-861ce6fe9e5a",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "globalers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ceb4be07-4e43-3caa-87d3-80be3feeee32",
                        "entry_id": "0fde44df-26a0-3cf2-8c80-861ce6fe9e5a",
                        "glosses": [
                            "niet in bijzonderheden afdalend, ongedetailleerd, ongeveer, benaderend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfa08f1-23f2-4e8b-bb3c-1b81d6042196",
                                "sense_id": "ceb4be07-4e43-3caa-87d3-80be3feeee32",
                                "text": "De inspecteur begon met een globale schouw."
                            },
                            {
                                "example_id": "e0f8548a-2165-41e6-ae26-0222173b648a",
                                "sense_id": "ceb4be07-4e43-3caa-87d3-80be3feeee32",
                                "text": "Bijgevoegd is een globale raming van de kosten."
                            },
                            {
                                "example_id": "30a71f53-da49-4149-8d46-d224be314724",
                                "sense_id": "ceb4be07-4e43-3caa-87d3-80be3feeee32",
                                "text": "(…) eene Rekening en Verantwoording, waarin de Posten zodanig globaal, en zonder specifique opgave zijn ter neder gesteld, dat het voor ons onmogelijk is, daaruit de deugdelijkheid (…) te kunnen beoordeelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1a2a0dc-8976-32d0-874e-051db720eca8",
                        "entry_id": "0fde44df-26a0-3cf2-8c80-861ce6fe9e5a",
                        "glosses": [
                            "volledig, totaal, compleet"
                        ],
                        "tags": [
                            "Vlaams"
                        ],
                        "examples": [
                            {
                                "example_id": "ba9b084b-0bca-4351-b4f1-28678cd2a46e",
                                "sense_id": "c1a2a0dc-8976-32d0-874e-051db720eca8",
                                "text": "De partij wil een globaal plan voor de verkeersveiligheid voor de hele gemeente."
                            }
                        ]
                    },
                    {
                        "sense_id": "c78a62a1-d2d1-306a-bbbf-00e807192c69",
                        "entry_id": "0fde44df-26a0-3cf2-8c80-861ce6fe9e5a",
                        "glosses": [
                            "wereldwijd, mondiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb460ef-459c-45cf-a24c-c926ef1ac34d",
                                "sense_id": "c78a62a1-d2d1-306a-bbbf-00e807192c69",
                                "text": "Het bedrijf reorganiseert om in de globale markt nog een rol te kunnen spelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8a01e19-40fa-3b55-831b-005b876686cc",
                        "entry_id": "0fde44df-26a0-3cf2-8c80-861ce6fe9e5a",
                        "glosses": [
                            "op het geheel betrekking hebbend"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a3a6cdce-99d7-4c9a-a926-35c1e4ba962b",
                                "sense_id": "d8a01e19-40fa-3b55-831b-005b876686cc",
                                "text": "Het is ons voorts niet mogelijk geweest, alle opgaven in dit werk ten toets te brengen: de goede (globaal opgegevene) bronnen en de naauwkeurigheid des Schrijvers waarborgen de echtheid en juistheid van de meeste derzelven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aea6550-126c-4f16-a81d-72013c75da1c",
                        "source_entry_id": "0fde44df-26a0-3cf2-8c80-861ce6fe9e5a",
                        "source_sense_id": "ceb4be07-4e43-3caa-87d3-80be3feeee32",
