                ],
                "senses": [
                    {
                        "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                        "entry_id": "a78cbcea-8616-30ba-ab3a-629ae9c8359c",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef1c1f5-be87-4882-8a19-5edda3d790d4",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Frau Wieczorek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dcd425dd-75d0-473e-a93e-711de5b4fbda",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Herr Wieczorek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "76575ab2-0796-4aa3-b75a-8292977fb0ae",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Die Wieczoreks kommen heute aus den Masuren."
                            },
                            {
                                "example_id": "47d1810b-ea35-489f-9036-04371717322e",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Der Wieczorek trägt nie die Schals, die die Wieczorek ihm strickt."
                            },
                            {
                                "example_id": "64866f23-7fb3-4b61-852e-b43527d3125f",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wieczorek kommt, geht der Herr Wieczorek.“"
                            },
                            {
                                "example_id": "efe14fc4-0df6-4a04-a088-b13f35488208",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Wieczorek kommt und geht."
                            },
                            {
                                "example_id": "51c4b32b-135e-407f-bdb4-cc2ac78fbd36",
                                "sense_id": "45009798-6aa7-3388-bc6f-f4c31d00889f",
                                "text": "Wieczoreks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
