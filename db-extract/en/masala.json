                "senses": [
                    {
                        "sense_id": "44ec9ff8-1e3d-3645-b1ea-37bef991258d",
                        "entry_id": "f40880ca-0476-36f7-83f8-a1f8b3302be6",
                        "glosses": [
                            "Any of many blends of spices used in Indian cuisine, most often containing cardamom, coriander, mace together with pepper, nutmeg, fennel seeds, jeera etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a834b6a8-6354-4819-87c0-fba6831affa9",
                                "sense_id": "44ec9ff8-1e3d-3645-b1ea-37bef991258d",
                                "text": "A couple of vegetables, sambar (spicy and sour lentils and vegetables boiled with masalas and spices), rasam (a hot and fiery lentil soup-like dish) and curds (yoghurt) served with heaps of rice and eaten in that order. […] Basically, it’s a juicy naan bread with an egg coating, stuffed with mutton or chicken, rolled up and sprinkled with a unique masala that gives it its special flavor."
                            },
                            {
                                "example_id": "36532e37-f7b0-45fd-bc0b-e3da600faf59",
                                "sense_id": "44ec9ff8-1e3d-3645-b1ea-37bef991258d",
                                "text": "When she cooked, she reached out for bottles and masalas without glancing up."
                            }
                        ]
                    },
                    {
                        "sense_id": "f80a44d9-d4bc-3bec-bd4e-7c4c475e316c",
                        "entry_id": "f40880ca-0476-36f7-83f8-a1f8b3302be6",
                        "glosses": [
                            "Any dish prepared with such spices."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b7e722a2-7b8b-4430-a147-85946f8c0df0",
                                "sense_id": "f80a44d9-d4bc-3bec-bd4e-7c4c475e316c",
                                "text": "We ordered two lamb bhunas and a masala."
                            }
                        ]
                    },
