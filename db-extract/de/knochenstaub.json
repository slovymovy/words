                        "glosses": [
                            "Staub aus zermahlenen Knochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bfb053c-4c98-4c3e-ba6a-018410ab25b1",
                                "sense_id": "8216982c-b59b-306d-a2d5-880feaba3adc",
                                "text": "„Dahinter in der Dunkelheit strömt der Fluss als faulige Brühe südlichen Meeren zu, vorbei an regenplattem Mais, magerem Getreide und Flusslehmgärten von Pächtern aus dem Hinterland, mahlend wie Knochenstaub, beladen mit der Vergangenheit, irgendwie im Wasser gelösten Träumen, niemals verloren.“"
                            },
                            {
                                "example_id": "728669f3-2094-4e82-808d-a6d554d1621f",
                                "sense_id": "8216982c-b59b-306d-a2d5-880feaba3adc",
                                "text": "„Er zerrieb sie sehr fein und achtete darauf, dass kein Knochenstaub wegwehen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
