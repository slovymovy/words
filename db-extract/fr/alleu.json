                    },
                    {
                        "form_id": "17ccad3a-f4c5-4afa-96ad-b1e7067fb06d",
                        "entry_id": "a07f958a-a071-3191-a225-00c71deee4c9",
                        "tags": [],
                        "form": "alleud"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c17671b-4048-35c2-8ef9-9ca1e8920c1e",
                        "entry_id": "a07f958a-a071-3191-a225-00c71deee4c9",
                        "glosses": [
                            "Fonds de terre, soit noble, soit roturier, exempt de tous les droits et devoirs féodaux."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "33d33338-991c-4119-8382-a7dcdce78392",
                                "sense_id": "6c17671b-4048-35c2-8ef9-9ca1e8920c1e",
                                "text": "Vous savez que rien n’était plus commun, dans les anciens temps, que la conversion des alleux en fiefs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c6571bf-a641-4fb2-9f4d-8145eecf9431",
                        "source_entry_id": "a07f958a-a071-3191-a225-00c71deee4c9",
                        "source_sense_id": "6c17671b-4048-35c2-8ef9-9ca1e8920c1e",
                        "target_lang_word": "Allodialbesitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allodialbesitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a203b1d0-e8f6-3360-80a4-7e442fb7b033",
                                        "entry_id": "641e9fb5-9151-3d34-bec0-3bac04fb1e1a",
                                        "glosses": [
                                            "Privatbesitz fürstlicher Familien; lehensfreier Grundbesitz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8032361b-0d8e-44c4-93a1-93057728f36b",
                                                "sense_id": "a203b1d0-e8f6-3360-80a4-7e442fb7b033",
                                                "text": "„Von dem Allodialbesitz der Straubenhardter in Dobel erfahren wir erstmals im Jahr 1363 aus dem Salbuch der Ebersteiner.“"
                                            },
                                            {
                                                "example_id": "51f65337-4f12-4847-90ba-2cb0968e6544",
                                                "sense_id": "a203b1d0-e8f6-3360-80a4-7e442fb7b033",
                                                "text": "„Ihre Stellung wurde bald so stark, daß sie sich gegen den vom König eingesetzten Grafen erfolgreich zur Wehr setzen konnten. Es ist wahrscheinlich, daß sie sich dabei auf ihren Allodialbesitz stützen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78248d62-2496-4d4d-a5c2-d110e533d945",
                        "source_entry_id": "a07f958a-a071-3191-a225-00c71deee4c9",
                        "source_sense_id": "6c17671b-4048-35c2-8ef9-9ca1e8920c1e",
                        "target_lang_word": "Allod",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allod",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                        "entry_id": "e9923e2b-566c-3272-b175-ddd4dd52a2e0",
                                        "glosses": [
                                            "Grundbesitz, der einem Adeligen, der Kirche oder einem Bauern gehörte ohne Abhängigkeiten von einem Obereigentümer"
                                        ],
                                        "tags": [
                                            "Mittelalter",
                                            "frühe Neuzeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a027b2e-0b55-44ef-9273-a106e0d4f492",
                                                "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                                "text": "„Mit seiner Zustimmung erfolgte im November 1196 seitens Otto’s II. die Lehnsauftragung der markgräflichen Allode in der Alt- und Mittelmark an das Erzstift Magdeburg.“"
                                            },
                                            {
                                                "example_id": "3b12fa0b-dcb8-4f23-928b-4c375b60511c",
                                                "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                                "text": "„Da stellte es sich heraus, daß der Junker an den Schwiegersohn des Amtmanns, Jón von Vatn, sein Allod und väterliches Erbe Braedratunga samt dazugehörender beweglicher Habe verkauft hatte; und der neue Besitzer war mit dem Amtmann auf dem Wege zum Thing zusammen mit zwei Abschätzern gekommen, um den Viehbestand und die Gebäude, über die man beim Kauf noch keine endgültige Absprache getroffen, zu taxieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f827aced-886d-41b9-a792-b5fd7e33d126",
                        "source_entry_id": "a07f958a-a071-3191-a225-00c71deee4c9",
