                    "sense_definition": "Décider d'abandonner une procédure judiciaire ou une affaire sans lui donner suite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
