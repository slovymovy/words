                        "zh": [
                            {
                                "target_lang_word": "果断的",
                                "target_lang_sense_clarification": "坚定决绝的"
                            },
                            {
                                "target_lang_word": "坚定的",
                                "target_lang_sense_clarification": "不易改变的"
                            }
                        ]
                    }
