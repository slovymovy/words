{
    "word_family": [
        "bound",
        "rebounder",
        "rebounding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28f2738c-9fe1-38b4-ae0d-65bc55179b9d",
                    "sense_definition": "To bounce or spring back from a surface or force after hitting it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_bounce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis ball hit the wall and <w>rebounded</w> straight back into my hands.",
                            "target_lang_translations": {
                                "ru": "Теннисный мяч ударился о стену и <w>отскочил</w> прямо мне в руки."
                            }
                        },
                        {
                            "text": "The bullet <w>rebounded</w> off the metal shield and struck the ground nearby.",
                            "target_lang_translations": {
                                "ru": "Пуля <w>срикошетила</w> от металлического щита и ударилась о землю неподалеку."
                            }
                        }
                    ],
                    "synonyms": [
                        "bounce",
                        "recoil",
                        "ricochet"
                    ],
                    "common_phrases": [
                        "rebound off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отскакивать или отпрыгивать от поверхности или силы после удара о нее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отскакивать",
                                "target_lang_sense_clarification": "после удара обо что-либо"
                            },
                            {
                                "target_lang_word": "рикошетить",
                                "target_lang_sense_clarification": "отлетать под углом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af62aae6-7ffa-3ccf-a0cd-179234b40ed6",
                    "sense_definition": "To recover or bounce back from a setback, crisis, or period of decline.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market managed to <w>rebound</w> quickly after the morning's sharp losses.",
                            "target_lang_translations": {
                                "ru": "Фондовому рынку удалось быстро <w>восстановиться</w> после резких утренних потерь."
                            }
                        },
                        {
                            "text": "After a difficult year, the local economy is starting to <w>rebound</w> and grow again.",
                            "target_lang_translations": {
                                "ru": "После трудного года местная экономика начинает <w>оживляться</w> и снова расти."
                            }
                        }
                    ],
                    "synonyms": [
                        "recover",
                        "rally",
                        "bounce back"
                    ],
                    "antonyms": [
                        "decline",
                        "deteriorate"
                    ],
                    "common_phrases": [
                        "rebound from a loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливаться или приходить в норму после неудачи, кризиса или периода спада."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливаться",
                                "target_lang_sense_clarification": "после спада или кризиса"
                            },
                            {
                                "target_lang_word": "оживляться",
                                "target_lang_sense_clarification": "о рынке или экономике"
                            },
                            {
                                "target_lang_word": "приходить в себя",
                                "target_lang_sense_clarification": "после трудностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81dfcfae-e07e-3b64-aaf1-a7f96af78818",
                    "sense_definition": "In basketball, to catch the ball after it has hit the rim or backboard without a basket being scored.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall center was able to <w>rebound</w> the ball and start a fast break.",
                            "target_lang_translations": {
                                "ru": "Высокий центровой смог <w>забрать подбор</w> и начать быстрый прорыв."
                            }
                        },
                        {
                            "text": "He needs to <w>rebound</w> the basketball more aggressively if the team wants to win.",
                            "target_lang_translations": {
                                "ru": "Ему нужно агрессивнее <w>бороться на подборе</w>, если команда хочет победить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rebound the basketball"
                    ],
                    "target_lang_definitions": {
                        "ru": "В баскетболе: ловить мяч после того, как он ударился о кольцо или щит без попадания в корзину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбирать",
                                "target_lang_sense_clarification": "мяч на подборе"
                            },
                            {
                                "target_lang_word": "делать подбор",
                                "target_lang_sense_clarification": "в баскетболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0abd5358-6796-375f-af9f-f6e9e7f1f7c8",
                    "sense_definition": "To echo or reverberate back.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound of the trumpet <w>rebounded</w> through the empty halls of the castle.",
                            "target_lang_translations": {
                                "ru": "Звук трубы <w>отдавался эхом</w> в пустых залах замка."
                            }
                        },
                        {
                            "text": "Her laughter <w>rebounded</w> off the canyon walls, creating a haunting echo.",
                            "target_lang_translations": {
                                "ru": "Ее смех <w>отражался</w> от стен каньона, создавая пугающее эхо."
                            }
                        }
                    ],
                    "synonyms": [
                        "echo",
                        "reverberate",
                        "resonate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдаваться эхом или отражаться (о звуке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдаваться",
                                "target_lang_sense_clarification": "эхом"
                            },
                            {
                                "target_lang_word": "разноситься",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "отражаться",
                                "target_lang_sense_clarification": "о звуке от стен"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "380310a7-e993-3a1b-9809-5594e9101878",
                    "sense_definition": "The act or instance of an object bouncing back after hitting something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_bounce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper was caught off guard by the sudden <w>rebound</w> of the ball.",
                            "target_lang_translations": {
                                "ru": "Вратарь был застигнут врасплох внезапным <w>отскоком</w> мяча."
                            }
                        },
                        {
                            "text": "He caught the ball on the <w>rebound</w> before it could hit the ground.",
                            "target_lang_translations": {
                                "ru": "Он поймал мяч на <w>отскоке</w>, прежде чем тот коснулся земли."
                            }
                        }
                    ],
                    "synonyms": [
                        "bounce",
                        "recoil"
                    ],
                    "common_phrases": [
                        "on the rebound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или случай отскока объекта после удара обо что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отскок",
                                "target_lang_sense_clarification": "физическое действие"
                            },
                            {
                                "target_lang_word": "рикошет",
                                "target_lang_sense_clarification": "случайный отскок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "611977b9-a855-33a6-b249-59996de864d7",
                    "sense_definition": "An instance of gaining possession of the ball in basketball after a missed shot.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player grabbed an offensive <w>rebound</w> and immediately scored a layup.",
                            "target_lang_translations": {
                                "ru": "Игрок взял <w>подбор</w> в нападении и тут же забросил мяч из-под кольца."
                            }
                        },
                        {
                            "text": "She led the league in every category, including points and <w>rebounds</w> per game.",
                            "target_lang_translations": {
                                "ru": "Она лидировала в лиге по всем показателям, включая очки и <w>подборы</w> за игру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offensive rebound",
                        "defensive rebound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай овладения мячом в баскетболе после неудачного броска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбор",
                                "target_lang_sense_clarification": "баскетбольный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5854fb42-6c02-3ebe-859f-20d005fbb2b2",
                    "sense_definition": "The period of emotional recovery following the end of a romantic relationship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started dating someone new while he was still on the <w>rebound</w> from his divorce.",
                            "target_lang_translations": {
                                "ru": "Он начал встречаться с кем-то новым, пока еще <w>отходил</w> от развода."
                            }
                        },
                        {
                            "text": "It is often unwise to make major life decisions while on the <w>rebound</w>.",
                            "target_lang_translations": {
                                "ru": "Часто неразумно принимать важные жизненные решения в <w>период восстановления</w> после разрыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the rebound"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in dating contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период эмоционального восстановления после окончания романтических отношений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "период восстановления",
                                "target_lang_sense_clarification": "после разрыва"
                            },
                            {
                                "target_lang_word": "состояние отскока",
                                "target_lang_sense_clarification": "эмоциональное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1599dc9-e826-3644-b588-c3ccb2790881",
                    "sense_definition": "A person one dates shortly after a breakup to help forget a previous partner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She realized too late that she was just a <w>rebound</w> for him.",
                            "target_lang_translations": {
                                "ru": "Она слишком поздно поняла, что была для него лишь <w>способом забыть бывшую</w>."
                            }
                        },
                        {
                            "text": "He didn't want to be a <w>rebound</w>, so he waited months before asking her out.",
                            "target_lang_translations": {
                                "ru": "Он не хотел быть <w>временным утешением</w>, поэтому ждал несколько месяцев, прежде чем пригласить ее на свидание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "just a rebound"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "refers to a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, с которым начинают встречаться вскоре после разрыва, чтобы забыть предыдущего партнера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена",
                                "target_lang_sense_clarification": "временный партнер"
                            },
                            {
                                "target_lang_word": "утешение",
                                "target_lang_sense_clarification": "человек для отвлечения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10e0d74d-c94e-3d56-832f-c0345f442240",
                    "sense_definition": "A return to a previous state of health, success, or prosperity; a recovery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient showed a remarkable <w>rebound</w> after the new treatment was administered.",
                            "target_lang_translations": {
                                "ru": "Пациент продемонстрировал удивительное <w>восстановление</w> после назначения нового лечения."
                            }
                        },
                        {
                            "text": "Economists are predicting a significant <w>rebound</w> in consumer spending next quarter.",
                            "target_lang_translations": {
                                "ru": "Экономисты прогнозируют значительный <w>подъем</w> потребительских расходов в следующем квартале."
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery",
                        "improvement",
                        "rally"
                    ],
                    "antonyms": [
                        "relapse",
                        "decline"
                    ],
                    "common_phrases": [
                        "economic rebound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение к прежнему состоянию здоровья, успеха или процветания; восстановление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "сил или экономики"
                            },
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "экономическое"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "после спада"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}