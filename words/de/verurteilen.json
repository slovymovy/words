                    "sense_id": "f72cd167-4d0c-33c4-9a5f-bbe96db0c412",
                    "sense_definition": "Ein gerichtliches Urteil fällen, durch das eine angeklagte Person für schuldig befunden und mit einer Strafe belegt wird.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Gericht <w>verurteilte</w> den Angeklagten wegen schweren Betrugs zu einer Geldstrafe."
                        },
                        {
                            "text": "Nach einem monatelangen Prozess wurde der Täter schließlich zu lebenslanger Haft <w>verurteilt</w>."
                        }
                    ],
                    "synonyms": [
                        "schuldigsprechen"
                    ],
                    "antonyms": [
                        "freisprechen"
                    ],
                    "common_phrases": [
                        "zu einer Geldstrafe verurteilen",
                        "zu lebenslanger Haft verurteilen"
                    ]
                },
                {
                    "sense_id": "b7a9c2ee-ba38-3143-ab98-ec155a0f01f2",
                    "sense_definition": "Eine Tat, Verhaltensweise oder Person scharf kritisieren, missbilligen oder moralisch ablehnen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Politiker aus vielen Ländern <w>verurteilten</w> den gewaltsamen Angriff aufs Schärfste."
                        },
                        {
                            "text": "Du solltest andere Menschen nicht sofort nach ihren Fehlern <w>verurteilen</w>."
                        }
                    ],
                    "common_phrases": [
                        "aufs Schärfste verurteilen",
                        "eine Tat scharf verurteilen"
                    ],
                    "synonyms": [
                        "missbilligen",
                        "verdammen"
                    ]
                }
            ]
        },
