                    {
                        "form_id": "2153d1e2-0312-4051-96f0-b6e084a63e13",
                        "entry_id": "34d6113f-8e31-366f-b123-96d8c9a2592e",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ветерка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                        "entry_id": "34d6113f-8e31-366f-b123-96d8c9a2592e",
                        "glosses": [
                            "уменьш. к ветер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ebc0a1-4e2d-4db1-9d18-6c7822f25f5e",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": ".. июльская ночь была тиха, изредка подымался ветерок, и лёгкий шорох пробегал по всему саду."
                            },
                            {
                                "example_id": "3fda4803-333b-429d-a0b7-7fe8655da2a1",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": "Погода была чудесная; .. вечерний ветерок чуть-чуть рябил ровную поверхность воды .."
                            },
                            {
                                "example_id": "02541b12-2280-4e68-a590-fec4aaf08ff7",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": "Лёгкий ветерок едва шевелил листья засыхающих дубовых кустов .., надувал паруса лодок и колыхал волны."
                            },
                            {
                                "example_id": "3b15645b-9c6f-468a-9d03-72a9d5d56db3",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": ".. повсюду зеленели травы; тёплый ветерок шевелил и поднимал их листья, качал головки цветов."
                            },
                            {
                                "example_id": "be6d0225-6384-4b4c-a08a-9938f6d8e0c7",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": ".. сырой ветерок шевелил верхушки трав и качал листья деревьев .."
                            },
                            {
                                "example_id": "669fc302-3342-456b-925e-ae6b86c30b5e",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": "Но вот зашумели верхушки деревьев, задул ветерок .."
                            },
                            {
                                "example_id": "e88772a3-46e6-47b5-b24e-5f3f7509cfc5",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": "Подул холодный ветерок… Ванька поморщился и стал совать зябкие руки в оборванные рукава."
                            },
                            {
                                "example_id": "1a4e4664-b18c-4e00-8c2d-b487cac01d5c",
                                "sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                                "text": "Вышел он в поле. Там пахло весною и дул тёплый, ласковый ветерок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86045a70-0107-48ed-b7cf-0b008a8eb231",
                        "source_entry_id": "34d6113f-8e31-366f-b123-96d8c9a2592e",
                        "source_sense_id": "d0b4de31-3c00-36e0-9054-59dc2992a8bb",
                        "target_lang_word": "breeze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f02dca-22e8-33d8-b686-af8c46dd0242",
                                        "entry_id": "a604f4e7-36df-36d2-beb6-c7bfab51a796",
                                        "glosses": [
                                            "A light, gentle wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1546875-7647-4685-ad07-03b1adf91134",
                                                "sense_id": "f8f02dca-22e8-33d8-b686-af8c46dd0242",
                                                "text": "The breeze rustled the papers on her desk."
                                            },
                                            {
                                                "example_id": "5605466b-8612-4feb-81d0-5456f54c88ad",
                                                "sense_id": "f8f02dca-22e8-33d8-b686-af8c46dd0242",
                                                "text": "Into a gradual calm the breezes sink."
                                            },
                                            {
                                                "example_id": "c3809789-0f66-4548-bf48-c4e58d473969",
                                                "sense_id": "f8f02dca-22e8-33d8-b686-af8c46dd0242",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "492ab67d-c1f5-32e9-89f4-efb372b69c39",
                                        "entry_id": "a604f4e7-36df-36d2-beb6-c7bfab51a796",
                                        "glosses": [
                                            "Any activity that is easy, not testing or difficult."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b66540a6-55d8-46b0-bf8c-ef04bec667db",
                                                "sense_id": "492ab67d-c1f5-32e9-89f4-efb372b69c39",
                                                "text": "After studying Latin, Spanish was a breeze."
                                            },
                                            {
                                                "example_id": "59c062b3-217e-478b-9d45-edc38392dc18",
                                                "sense_id": "492ab67d-c1f5-32e9-89f4-efb372b69c39",
                                                "text": "The eight-minute connection to East Midlands Railway is a breeze. The train is 170208, its First Class downrated, so I enjoy the wider seats for the hour to Ely, where I arrive a couple of minutes early."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d8d21f-49bf-31f2-ba2b-2a34a7118da6",
                                        "entry_id": "a604f4e7-36df-36d2-beb6-c7bfab51a796",
                                        "glosses": [
                                            "Wind blowing across a cricket match, whatever its strength."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "080f1349-8930-380f-b962-f93dcab9b9da",
                                        "entry_id": "a604f4e7-36df-36d2-beb6-c7bfab51a796",
                                        "glosses": [
                                            "An excited or ruffled state of feeling; a flurry of excitement; a disturbance; a quarrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f084ea8-86f0-44be-9fec-6e64ae19e9ab",
                                                "sense_id": "080f1349-8930-380f-b962-f93dcab9b9da",
                                                "text": "The discovery produced a breeze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8189b94e-cee2-3def-b1c3-eff6e7e37eb8",
                                        "entry_id": "a604f4e7-36df-36d2-beb6-c7bfab51a796",
                                        "glosses": [
                                            "A brief workout for a racehorse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "breeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be5427d2-7966-3183-9e4c-66a5bc687502",
                                        "entry_id": "8a919ef6-a098-3199-9342-cd46e27fe330",
                                        "glosses": [
                                            "To move casually, in a carefree manner."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9a9144-9108-4517-8267-6c75e2ec16e7",
                                                "sense_id": "be5427d2-7966-3183-9e4c-66a5bc687502",
                                                "text": "Resting most of their first-choice players for Sunday's vital Euro 2024 qualifier against Croatia, Wales started with four debutants and breezed into an early lead thanks to headers by captain Ben Davies and Kieffer Moore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2042c2e-600b-3fc9-bde8-eb718dccb7c4",
                                        "entry_id": "8a919ef6-a098-3199-9342-cd46e27fe330",
                                        "glosses": [
                                            "To blow gently."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6df6d04-b10e-4e7a-9d15-f0c558196fb7",
                                                "sense_id": "f2042c2e-600b-3fc9-bde8-eb718dccb7c4",
                                                "text": "She's sitting opposite a window that's gently breezing into her face, wafting her hair into cover-girl perfection ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c3e4b5-0a62-302f-8bbc-e579af54f911",
                                        "entry_id": "8a919ef6-a098-3199-9342-cd46e27fe330",
                                        "glosses": [
                                            "To take a horse on a light run in order to understand the running characteristics of the horse and to observe it while under motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8877a3f-120b-3810-8930-5cff354f3a86",
                                        "entry_id": "8a919ef6-a098-3199-9342-cd46e27fe330",
                                        "glosses": [
                                            "To swim near the surface of the water, causing ripples in the surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "595af37e-44bd-4e97-8def-e5ed9849f1ff",
                                                "sense_id": "d8877a3f-120b-3810-8930-5cff354f3a86",
                                                "text": "The first was a school of medium-sized ( 10-pound average ) fish that breezed frequently but bit poorly."
                                            },
                                            {
                                                "example_id": "08cf8e7b-02b6-4647-b330-bce6d1784ed7",
                                                "sense_id": "d8877a3f-120b-3810-8930-5cff354f3a86",
                                                "text": "The Queen Mary stood by while a speedboat moved ahead of a breezing school of tuna to deploy the sound projector and a sonobuoy (Figure 6)."
                                            },
                                            {
                                                "example_id": "40e595eb-1f1d-4f58-a8ca-45703f6b4f8f",
                                                "sense_id": "d8877a3f-120b-3810-8930-5cff354f3a86",
                                                "text": "An intermediate line has its place when chasing breezing tuna that are moving at mach speed on the surface."
                                            }
                                        ]
                                    }
                                ]
                            },
