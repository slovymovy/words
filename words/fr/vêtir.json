                },
                {
                    "sense_id": "6172916c-58a5-36d6-b4bb-6f02c2d63c4f",
                    "sense_definition": "Fournir les vêtements nécessaires à quelqu'un, pourvoir à son habillement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette organisation caritative s'efforce de nourrir et <w>vêtir</w> les familles les plus démunies de la région."
                        },
                        {
                            "text": "Avec un salaire modeste, ils parvenaient difficilement à <w>vêtir</w> convenablement leurs quatre enfants en pleine croissance."
