                },
                {
                    "sense_id": "49f869c5-cac2-3297-b98c-ddf4094c61a2",
                    "sense_definition": "In a state of confusion, distraction, or helplessness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without clear guidance from his boss, his mind was entirely <w>afloat</w>.",
                            "target_lang_translations": {
                                "zh": "没有老板的明确指导，他的思绪完全<w>迷茫</w>了。"
                            }
                        },
                        {
                            "text": "When asked to explain the difficult concept, the student was all <w>afloat</w>.",
                            "target_lang_translations": {
                                "zh": "当被要求解释这个难题时，学生感到十分<w>迷茫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "at sea",
                        "bewildered",
                        "confused",
                        "distracted"
                    ],
                    "common_phrases": [
                        "all afloat"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "处于困惑、分心或无助的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迷茫",
                                "target_lang_sense_clarification": "指思想混乱或不知所措。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a905e8eb-1770-3088-b0ed-8712e64a35d2",
