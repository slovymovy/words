                        "target_lang_word": "Hezbollah",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hezbollah",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5c377b40-58b0-38a1-920a-de464656649d",
                                        "entry_id": "307293ea-122c-3cc3-ab5a-346601e2278f",
                                        "glosses": [
                                            "een politieke partij en een militante beweging in Libanon van sjiitische moslims gesteund door Iran"
                                        ],
                                        "tags": [],
