                                    {
                                        "sense_id": "d15c6a7e-6688-3f24-827d-9d0b9f13f017",
                                        "entry_id": "20197277-216d-3760-82d2-07eb5ff5a454",
                                        "glosses": [
                                            "Bande dessinée."
                                        ],
                                        "tags": [],
