                "senses": [
                    {
                        "sense_id": "cb74c82d-f42c-3538-afea-a485cde75f83",
                        "entry_id": "b8344c00-9f11-3bd6-be98-abe63b0613ba",
                        "glosses": [
                            "Fouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af1dbf7-1ed2-44d3-a584-b207444caeb4",
                                "sense_id": "cb74c82d-f42c-3538-afea-a485cde75f83",
                                "text": "Mais n’allez donc pas fouillonner partout dans ma cuisine !"
                            },
                            {
                                "example_id": "426051f9-58c9-4501-90a0-83fb76a13acd",
                                "sense_id": "cb74c82d-f42c-3538-afea-a485cde75f83",
                                "text": "L'homme fouillonne dans les ordures à la recherche de tout ce qui peut être revendu chez des grossistes spécialisés dans l'achat de telle ou telle matière."
                            },
                            {
                                "example_id": "502ca067-5aeb-4fb9-8125-f73b77418064",
                                "sense_id": "cb74c82d-f42c-3538-afea-a485cde75f83",
                                "text": "En tout cas bienvenue, j'aime bien les nouveaux qui fouillonnent les anciens messages et les font remonter à jour."
                            }
                        ]
                    }
