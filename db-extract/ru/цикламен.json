                    },
                    {
                        "translation_id": "46950041-43d6-4c5e-a21a-2403ce649998",
                        "source_entry_id": "22a4bb2e-40fa-357a-926c-a7a0f0d5d3e3",
                        "source_sense_id": "16b2bdc5-91c8-3492-bc97-ae1dac1e263d",
                        "target_lang_word": "cyclamen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclamen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86403ee2-b03a-392d-a1a4-7eef769e1c11",
                                        "entry_id": "feebb87d-4d33-3b33-8030-87c9a7f2a594",
                                        "glosses": [
                                            "Genre de plantes, de la famille des Primulacées. → voir Cyclamen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8fbfa81-8240-4183-9540-7a2cc1f8cbe5",
                                                "sense_id": "86403ee2-b03a-392d-a1a4-7eef769e1c11",
                                                "text": "Son nom de Cyclamen vient de la forme de sa racine en cercle, κύκλος [",
                                                "translation": "kuklos]; le nom beaucoup moins poétique de pain de pourceau témoigne du goût qu’ont les porcs pour son bulbe, celui d’arthanite lui a été donné par les Arabes."
                                            },
                                            {
                                                "example_id": "77d0afaa-b6f4-4066-b93e-3d5749885ff9",
                                                "sense_id": "86403ee2-b03a-392d-a1a4-7eef769e1c11",
                                                "text": "Quels parterres auront pu ainsi être établis artificiellement dans les bois d’agrément avec les pervenches, les primevères, les scilles, les cyclamens, les sceaux de Salomon, les galanthes, les nivéoles, le saxifrage ombreux, etc… ^([sic : etc.]) […]"
                                            },
                                            {
                                                "example_id": "6297c761-727a-44bf-994f-ced925a50a14",
                                                "sense_id": "86403ee2-b03a-392d-a1a4-7eef769e1c11",
                                                "text": "Notre village était alors comme un cyclamen renversé ; sa fleur enfouie sous terre et, tournés vers le ciel, les poils boueux de son tubercule."
                                            },
                                            {
                                                "example_id": "e36849c8-7850-4b7d-9f6f-93150444c6af",
                                                "sense_id": "86403ee2-b03a-392d-a1a4-7eef769e1c11",
                                                "text": "Le cyclamen de Perse fait partie des plantes fleuries les plus appréciées dans la maison."
                                            },
                                            {
                                                "example_id": "2c60e5f9-3be3-4dfa-9c38-e57406546638",
                                                "sense_id": "86403ee2-b03a-392d-a1a4-7eef769e1c11",
                                                "text": "Par-ci, par-là, de petites menthes à fleurs blanches ou des tapis de cyclamens roses ; — et, en l’air, au-dessus de ces choses mornes, des hiboux qui tournoient sans bruit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
