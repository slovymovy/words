                        "sense_id": "43c01760-f8c4-32bd-b3a0-dd7fec880d86",
                        "entry_id": "41498699-ca87-3068-a086-dad2be24d216",
                        "glosses": [
                            "A motorized bus or coach."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b3d03e4-8a97-4031-a71f-7b3aa2d7330d",
                                "sense_id": "43c01760-f8c4-32bd-b3a0-dd7fec880d86",
                                "text": "“[…]a motor-’bus scorching round into the Square from the Haymarket was swept into the air, and shivered into fragments.” “Professor,” I exclaimed, “a motor-’bus!” “I know how impossible it must sound,” said Professor Henry Tellurin,[…]"
                            },
                            {
                                "example_id": "118f8aa7-8558-4933-af6c-ed3ed94be299",
                                "sense_id": "43c01760-f8c4-32bd-b3a0-dd7fec880d86",
                                "text": "In the afternoon the air became black with locusts, and some of the women shrieked, sinking to the floor of the motorbus and covering their hair with traveling rugs."
                            },
                            {
                                "example_id": "e068c0e4-d8fe-4481-b5dc-2a1887e3017a",
                                "sense_id": "43c01760-f8c4-32bd-b3a0-dd7fec880d86",
                                "text": "The world beyond the sugarcane fields was remote and the village was linked to it only by villagers’ carts and bicycles, wholesalers’ vans and lorries, and an occasional private motorbus that ran to no timetable and along no fixed route."
                            }
                        ]
                    }
