                        "source_entry_id": "62aefb7e-dce1-340e-86c6-0f0e9c9006fe",
                        "target_lang_word": "Verformbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
