                                        "examples": [
                                            {
                                                "example_id": "5a19bdab-3165-497d-afee-2ee95e2eb070",
                                                "sense_id": "c3479a78-2bf1-3265-9c1b-cfe1b969cc2a",
                                                "text": "Kobylka malá kovat se nedá, kováři nechce stát, tak jako má milá, panenka rozmilá, hubičku nechce dát."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7694a230-e148-3df3-9456-baa811595cbc",
                                        "entry_id": "54b2a647-559b-38bf-b120-479d29918463",
                                        "glosses": [
                                            "zástupce podřádu hmyzu z čeledi kobylkovití"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14b0f94-159d-4c1b-bb61-d152bb300448",
                                                "sense_id": "7694a230-e148-3df3-9456-baa811595cbc",
                                                "text": "Jan Křtitel na poušti se údajně živil kobylkami a medem divokých včel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1125a0a5-8333-36cf-a29d-88906bf4ba80",
                                        "entry_id": "54b2a647-559b-38bf-b120-479d29918463",
                                        "glosses": [
                                            "část strunného hudebního nástroje podpírající struny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d983c796-a4e1-4471-bab4-1e7610404b0d",
                                                "sense_id": "1125a0a5-8333-36cf-a29d-88906bf4ba80",
                                                "text": "Na houslích kobylka odděluje strunu nad hmatníkem od části struníkové."
                                            },
                                            {
                                                "example_id": "eb900579-d978-4b61-975b-ef417d47befc",
                                                "sense_id": "1125a0a5-8333-36cf-a29d-88906bf4ba80",
                                                "text": "Aby potrápil tatínkův sluch, schválně přejížděl vzdorný capart co nejvíce smyčcem za kobylkou."
                                            }
                                        ]
                                    }
                                ]
                            },
