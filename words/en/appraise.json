    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c03a3e97-1fda-3675-b4b5-bc26c7a820b1",
                    "sense_definition": "To determine the monetary value or worth of something, often as a professional duty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expert was hired to <w>appraise</w> the antique furniture collection."
                        },
                        {
                            "text": "Experts will <w>appraise</w> the value of the house before the sale."
                        }
                    ],
                    "common_phrases": [
                        "appraise the value"
                    ]
                },
                {
                    "sense_id": "54cbc25a-2295-3f70-84da-0e05eab34e41",
                    "sense_definition": "To evaluate the performance or work quality of an employee.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Managers <w>appraise</w> staff performance annually to determine bonuses."
                        },
                        {
                            "text": "At the end of the contract, you will be <w>appraised</w> by your line manager."
                        }
                    ],
                    "common_phrases": [
                        "appraise performance"
                    ]
                },
                {
                    "sense_id": "8f0a584a-c217-3289-91c3-2dcef66a3056",
                    "sense_definition": "To consider or examine something comprehensively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee met to <w>appraise</w> the situation before making a final decision."
                        },
                        {
                            "text": "She took a moment to <w>appraise</w> the risks involved in the new project."
                        }
                    ],
                    "common_phrases": [
                        "appraise the situation"
                    ]
                },
                {
                    "sense_id": "94307d59-5b69-3eda-81e3-21ace7db5647",
                    "sense_definition": "To form an estimate or conjecture about something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>appraise</w> the impact of these changes so early."
                        },
                        {
                            "text": "The researchers tried to <w>appraise</w> the potential outcome of the experiment."
                        }
                    ],
                    "common_phrases": [
                        "appraise the impact"
                    ]
                },
                {
                    "sense_id": "0b0f2a19-d408-36e1-b4ca-dfdff591bebc",
                    "sense_definition": "To express approval or admiration for someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>appraised</w> the artist for her bold use of color."
                        },
                        {
                            "text": "The community <w>appraised</w> the hero for his selfless actions during the fire."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely considered archaic or non-standard in modern English."
                        }
                    ]
                },
                {
                    "sense_id": "3fcbc521-5989-3d87-b683-40ceb8887837",
                    "sense_definition": "To notify or inform someone of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director was <w>appraised</w> of the latest developments in the case."
                        },
                        {
                            "text": "Please <w>appraise</w> the team of any changes to the schedule."
                        }
                    ],
                    "synonyms": [
                        "apprise"
                    ],
                    "common_phrases": [
                        "appraise of"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often confused with 'apprise'; usage in this sense is rare and considered non-standard."
