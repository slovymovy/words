                            {
                                "example_id": "639b269b-5daa-4f00-8257-94c3f9a7b7c0",
                                "sense_id": "e03d22f2-abe2-35ff-ac6c-2ddbd79e27c9",
                                "text": "„Wer von Birnau immer weiter talaufwärts geht, überschreitet die Grenzmark der hessischen Herrschaft Schmalkalden und gelangt nach Steinbach-Hallenberg, wo hoch überm großen langgebauten Flecken malerisch die Trümmer des Schlosses Hallenberg horstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ac46f92-0f7d-47a9-850e-75f11e0a8d7c",
                        "source_entry_id": "7b523284-986a-3792-8b29-0d5d2f95d665",
                        "source_sense_id": "e03d22f2-abe2-35ff-ac6c-2ddbd79e27c9",
