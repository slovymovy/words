                        "glosses": [
                            "представитель семейства мелких жуков подотряда разноядных (Polyphaga)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b25c1f-277b-4472-bf4d-94147fb688bd",
                                "sense_id": "89813b81-958f-3cf0-95a0-7bba1eaf4727",
                                "text": "А то, что он звучит прямо в голове, вовсе не значит, что он точит там его твердый мореный мозг, как жук-древогрыз, или хотя бы бегает по извилинам с телекамерой, подсматривает в замочные скважины."
                            }
                        ]
