                    },
                    {
                        "translation_id": "9e6c9aca-8c82-44f1-ad27-bf65d5be5f6a",
                        "source_entry_id": "d42bc630-2877-394c-a359-8cc797b3c14b",
                        "source_sense_id": "2479437b-bcaa-39e4-8d73-42cc40ecf450",
                        "source_sense_description": "gespaltener, metallischer Kopf eines Füllfederhalters, der die Tinte gleichmäßig zuführt",
                        "target_lang_word": "plume",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "337fda23-3439-3b65-b515-a88e84079d4b",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Phanère corné, garni de barbes et de duvet, qui couvre le corps des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312bde26-9c08-4a9d-8022-aded1db91202",
                                                "sense_id": "337fda23-3439-3b65-b515-a88e84079d4b",
                                                "text": "Léger comme une plume."
                                            },
                                            {
                                                "example_id": "b43a92d4-5ca4-4134-8f73-1123f6d1bca4",
                                                "sense_id": "337fda23-3439-3b65-b515-a88e84079d4b",
                                                "text": "[…] : puis il […] se coiffa d’un toquet de velours noir sans plume ni pierreries, s’enveloppa d’un manteau de couleur sombre, […]."
                                            },
                                            {
                                                "example_id": "871c3bdb-9b8f-41c7-9488-d80e8065ed1d",
                                                "sense_id": "337fda23-3439-3b65-b515-a88e84079d4b",
                                                "text": "Ce chapeau de paille noire haut de forme, est garni d’un bord de plumes rouleautées, touffe de plumes noires de côté et lyre de plumes vertes posée en aigrette au milieu des plumes noires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b055c7c5-9dd2-3c38-b515-0e4a8b6ba47c",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Plume dont on se servait pour écrire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60f59fd4-7117-4450-a037-10d9f1078c4d",
                                                "sense_id": "b055c7c5-9dd2-3c38-b515-0e4a8b6ba47c",
                                                "text": "Cette terrible histoire des Vaudois, dois-je en parler ou m’en taire ? En parler ? Elle est trop cruelle ; personne ne la racontera sans que la plume n’hésite, et que l’encre, en écrivant, ne blanchisse de larmes."
                                            },
                                            {
                                                "example_id": "9e13e38e-32a6-40fe-bdc7-d2307e1e6de3",
                                                "sense_id": "b055c7c5-9dd2-3c38-b515-0e4a8b6ba47c",
                                                "text": "Avant la généralisation des plumes métalliques, les plumes d’oie préparées à Auvillar étaient réputées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6159993b-72b5-3690-b683-ca9bdf066b0a",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Plumage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e499bd-aa77-412a-b4ba-8b713752922b",
                                                "sense_id": "6159993b-72b5-3690-b683-ca9bdf066b0a",
                                                "text": "La menue plume des oiseaux s’appelle duvet."
                                            },
                                            {
                                                "example_id": "57498ea0-7a33-466c-83b5-576cb13212ae",
                                                "sense_id": "6159993b-72b5-3690-b683-ca9bdf066b0a",
                                                "text": "Cet oiseau mue, toute sa plume tombe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909a5fa0-90dd-3bd4-abc6-606b826e8fdb",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Amas de plumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbc2fc96-f751-49e8-919b-452843daaca5",
                                                "sense_id": "909a5fa0-90dd-3bd4-abc6-606b826e8fdb",
                                                "text": "Mettre de la plume dans un coussin, dans un oreiller, dans un traversin."
                                            },
                                            {
                                                "example_id": "1f077bbc-0885-42e6-a3bc-a1d2405c7c33",
                                                "sense_id": "909a5fa0-90dd-3bd4-abc6-606b826e8fdb",
                                                "text": "Dans le réduit obscur d’une alcôve enfoncée\nS'élève un lit de plume à grands frais amassée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29721a28-0d4f-3b24-adf2-fba202893622",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Oiseaux."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f267bc9-b4ce-4b73-a96b-9abdbc16736e",
                                                "sense_id": "29721a28-0d4f-3b24-adf2-fba202893622",
                                                "text": "Ce chien est au poil et à la plume, il chasse toute sorte de gibier, comme lièvres, perdrix, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a51a544-782a-38b5-921a-0295a8ca7f94",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Mine, bout d’un stylo, lame de métal pointue et fendue, en forme de bec de plume qu’on emploie pour écrire."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f29090b-965e-4ce7-af3a-60a369666c40",
                                                "sense_id": "2a51a544-782a-38b5-921a-0295a8ca7f94",
                                                "text": "Il y avait vraiment une malédiction du Ciel sur les ganaches de sacristie qui n’appréhendaient pas de manier une plume. Leur encre se muait aussitôt en une pâte, en un galipot, en une poix qui engluaient tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc7c542-b558-38e6-8a0f-7872552b2329",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Activité d’écrire en tant qu’écrivain ou journaliste ou dans le but de le devenir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "note": "Toujours précédé de l’article défini « la » au singulier",
                                        "examples": [
                                            {
                                                "example_id": "9f9014f7-1276-4348-85e4-0ad0ce7bac1f",
                                                "sense_id": "5fc7c542-b558-38e6-8a0f-7872552b2329",
                                                "text": "On lui reprochera d’avoir abandonné sa carrière de chanteuse au profit de la plume."
                                            },
                                            {
                                                "example_id": "4cac400b-d52e-4aae-acf5-3ea8cea382b8",
                                                "sense_id": "5fc7c542-b558-38e6-8a0f-7872552b2329",
                                                "text": "Tu admets, ô Prospêtès, que, par le verbe et par la plume, je fasse profession d’amoralité. Que je me décrive comme un être ayant rompu avec la morale officielle ou la morale officieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ebfa5f2-6871-35e1-a52c-5aa3a7c68d84",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Manière d’écrire, style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2514ba-0e03-4667-906a-061c12d7cbc3",
                                                "sense_id": "6ebfa5f2-6871-35e1-a52c-5aa3a7c68d84",
                                                "text": "C’est là, nous le comprenons, une rude tâche à remplir, il faudrait une plume autrement exercée que la nôtre, pour dire tout ce qu’il y a d’irréfléchi, d’irrationnel et d’absurde dans un système trop absolu ; […]."
                                            },
                                            {
                                                "example_id": "0d69bd2a-ba0d-40a0-a388-62cfe835b2d1",
                                                "sense_id": "6ebfa5f2-6871-35e1-a52c-5aa3a7c68d84",
                                                "text": "Certes, la « plume » de George Sand, pour prendre une expression de Brichot qui aimait tant dire qu'un livre était écrit « d'une plume alerte », ne me semblait pas du tout, comme elle avait paru si longtemps à ma mère avant qu'elle modelât lentement ses goûts littéraires sur les miens, une plume magique."
                                            },
                                            {
                                                "example_id": "91574260-9cf2-4fee-83db-377b6f8b7adb",
                                                "sense_id": "6ebfa5f2-6871-35e1-a52c-5aa3a7c68d84",
                                                "text": "Lui qui, d’habitude, d’une plume sûre, attaquait méthodiquement le papier, s’exténuait sur ses phrases. Il peinait, raturait, repoussait soudain une feuille avec violence […]."
                                            },
                                            {
                                                "example_id": "aabc2fbe-2d35-4fe3-a952-d00f25806cd2",
                                                "sense_id": "6ebfa5f2-6871-35e1-a52c-5aa3a7c68d84",
                                                "text": "Vivre de notre plume, ce serait le rêve. Des romans et des piges, des piges et des romans. De quoi vivre d'une manière décente, sans demander le bout du monde. Entre un et deux Smic par mois pour commencer, là, ça irait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0378d06f-9ca8-3f54-930b-846147f4a1c6",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Auteur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b259f2-422e-497c-b988-252090eca606",
                                                "sense_id": "0378d06f-9ca8-3f54-930b-846147f4a1c6",
                                                "text": "Les débutants, les bas-bleus, les actrices qui commencent et celles qui finissent leur carrière, auteurs et libraires caressent ou choyent ces plumes à tout faire."
                                            },
                                            {
                                                "example_id": "0ccf06bf-04d5-4d60-89de-4351d05dc4ec",
                                                "sense_id": "0378d06f-9ca8-3f54-930b-846147f4a1c6",
                                                "text": "Il faudrait, pour l’établir de manière pleine et probante, passer en revue tous les domaines, ce qui, une fois de plus, exigerait une compétence encyclopédique faisant défaut à la présente plume."
                                            },
                                            {
                                                "example_id": "557a2047-5524-48e9-9995-91bb57d5cc53",
                                                "sense_id": "0378d06f-9ca8-3f54-930b-846147f4a1c6",
                                                "text": "Et c’est à moi, haut fonctionnaire au Bureau des relations fédérales-provinciales et ancien conseiller et plume française de M. Trudeau, qu’on demanda de rédiger une réponse aux attaques outrancières de mon ancien patron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4251ac49-e4c6-3bbb-b4d2-bfdf522d13b2",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Fellation."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f9a30e-b4be-42f6-a9c6-07f55e59cee2",
                                                "sense_id": "4251ac49-e4c6-3bbb-b4d2-bfdf522d13b2",
                                                "text": "Cornabœux dont le bras commençait à être fatigué, se tourna vers Culculine qui essayait de tailler une plume à la Chaloupe."
                                            },
                                            {
                                                "example_id": "a37e98e8-3f39-4841-b78e-1e70953b4f9b",
                                                "sense_id": "4251ac49-e4c6-3bbb-b4d2-bfdf522d13b2",
                                                "text": "Si votre professeur vous demande une plume, ne feignez pas de croire qu’il vous prie de lui sucer la queue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec91e71-2352-32a9-b580-0e389b400b9b",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Vague produite par l’étrave plongeant dans une lame."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c56b436b-7cbb-4e10-b61a-167d8a4ff645",
                                                "sense_id": "aec91e71-2352-32a9-b580-0e389b400b9b",
                                                "text": "– Eh bien, Caroline, il faudra remonter sur le pont. Le vent a halé l’est d’un quart, et l’Astara ne tardera pas à mettre le nez dans la plume. »\nCette manière de s’exprimer indique que « monsieur Caterna », puisque tel est son nom, est marin ou a dû l’être."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6037cc3-b6bc-38c6-9673-3a858e8b5f46",
                                        "entry_id": "ffdb8091-f9b2-32e6-bb4d-2125b831044d",
                                        "glosses": [
                                            "Étudiante ayant passé le rite du baptême qui bizute les bleus ; équivalent féminin du poil."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01a3a663-39e9-3df0-bd80-c946d0eff2e5",
                                        "entry_id": "3b8acf7b-a47d-3c87-9f1c-fabd6129c055",
                                        "glosses": [
                                            "Lit, plumard."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "350f813c-d16d-41fd-a76e-29f268960491",
                                                "sense_id": "01a3a663-39e9-3df0-bd80-c946d0eff2e5",
                                                "text": "Rêvassé dans le « plume ». Repensé à la belle gosse."
                                            },
                                            {
                                                "example_id": "88e467f0-d7cb-4701-975e-6c7621df9d87",
                                                "sense_id": "01a3a663-39e9-3df0-bd80-c946d0eff2e5",
                                                "text": "… quand une nuit v’là l’Dudule qui rapplique, les fouilles pleines de fafiots et d’perlouses, qui pose tout ça d’ssus l’plume et qui m’regarde."
                                            },
                                            {
                                                "example_id": "75be3cdf-fc8b-4a77-adaf-7780b6864e2a",
                                                "sense_id": "01a3a663-39e9-3df0-bd80-c946d0eff2e5",
                                                "text": "Ah dis donc, ce qu’on les emmerdait tous, alors ! Il y avait plus que nous deux, bien au chaud dans le plume ; avec la petite lampe à côté."
                                            }
                                        ]
                                    }
                                ]
                            },
