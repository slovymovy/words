                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee73359-b8ba-402d-b524-4c814a9c0053",
                                "sense_id": "561de481-9b25-3f2e-8586-da2ed3c84cf2",
                                "text": "„Die Fiaker-Pferde testen \"orthopädische Hufschuhe\" aus einem Kunststoffgemisch, das auch für die transsibirische Eisenbahn zum Schutz der Achsen vor Eisbrocken und für Golfschuh-Einlagen verwendet wird.“"
                            },
                            {
                                "example_id": "50f94678-c400-4a1d-8435-78242aea4620",
                                "sense_id": "561de481-9b25-3f2e-8586-da2ed3c84cf2",
                                "text": "„Drechsler zog kurzerhand ihre Golfschuhe aus, trat ins Wasser und schlug den Ball aufs Grün.“"
                            }
                        ],
