{
    "word_family": [
        "impoundment",
        "impounder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c022bfed-92d2-3427-8686-475e4771d0dc",
                    "sense_definition": "To seize and take legal custody of something (such as a vehicle or property) due to a violation of the law.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seize_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police decided to <w>impound</w> his car after he was caught driving without a valid license."
                        },
                        {
                            "text": "If you park in a towing zone, the city will <w>impound</w> your vehicle immediately."
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "confiscate"
                    ],
                    "antonyms": [
                        "release",
                        "return"
                    ],
                    "common_phrases": [
                        "impound a vehicle",
                        "impound the car"
                    ]
                },
                {
                    "sense_id": "42f7777c-4338-3bd7-85f6-a0ced0b99080",
                    "sense_definition": "To take and keep something in the official custody of a court or law enforcement for safekeeping or evidence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seize_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge ordered the bailiff to <w>impound</w> the disputed documents until the trial concluded."
                        },
                        {
                            "text": "Authorities had to <w>impound</w> the evidence to prevent any tampering before the investigation."
                        }
                    ],
                    "synonyms": [
                        "confiscate",
                        "sequester"
                    ],
                    "common_phrases": [
                        "impound evidence",
                        "impound documents"
                    ]
                },
                {
                    "sense_id": "d0e4202a-ea0c-33fe-9fda-45058cd9ee77",
                    "sense_definition": "To accumulate and hold back water or other liquid in a reservoir or dam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contain_liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly constructed reservoir is designed to <w>impound</w> millions of gallons of rainwater."
                        },
                        {
                            "text": "They built a massive concrete dam to <w>impound</w> the river water for agricultural use."
                        }
                    ],
                    "synonyms": [
                        "dam",
                        "retain",
                        "hold back"
                    ],
                    "antonyms": [
                        "release",
                        "discharge"
                    ],
                    "common_phrases": [
                        "impound water"
                    ]
                },
                {
                    "sense_id": "d8641127-bc2a-325a-85d5-360650ea7224",
                    "sense_definition": "To collect and hold funds in an escrow account for the payment of property taxes and insurance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_holding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mortgage lender will <w>impound</w> a portion of your monthly payment to cover annual property taxes."
                        },
                        {
                            "text": "They require the bank to <w>impound</w> funds to ensure the home insurance is paid on time."
                        }
                    ],
                    "synonyms": [
                        "escrow"
                    ],
                    "common_phrases": [
                        "impound funds"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4e086fa-1e0e-39e9-b16d-20bf3473eb10",
                    "sense_definition": "A secure yard or storage facility where seized vehicles or property are kept.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impound_lot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to pay a hefty fine at the police <w>impound</w> to get my car back."
                        },
                        {
                            "text": "The towed vehicles were lined up inside the secure city <w>impound</w> overnight."
                        }
                    ],
                    "synonyms": [
                        "pound",
                        "impound lot"
                    ],
                    "common_phrases": [
                        "police impound",
                        "towed to the impound"
                    ]
                },
                {
                    "sense_id": "7927a205-4c85-303d-bb2c-6f6f0b4f15f4",
                    "sense_definition": "The state of being held in legal custody or in an impound lot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impound_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His motorcycle is currently in <w>impound</w> after he was caught speeding."
                        },
                        {
                            "text": "You cannot retrieve your vehicle from <w>impound</w> without showing proof of insurance."
                        }
                    ],
                    "common_phrases": [
                        "in impound",
                        "released from impound"
                    ]
                },
                {
                    "sense_id": "9e15560b-c39e-349d-8f49-b845d0e7fbdb",
                    "sense_definition": "An item, especially a vehicle, that has been seized and impounded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impounded_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auctioneer walked past the rows of <w>impounds</w> to find the one scheduled for sale."
                        },
                        {
                            "text": "The lot was crowded with various <w>impounds</w> waiting to be claimed by their owners."
                        }
                    ]
                },
                {
                    "sense_id": "a4f4a8f5-a87c-3eb1-a24f-702bfc061a20",
                    "sense_definition": "Funds collected from a borrower and held in escrow to pay for property taxes and insurance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_holding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your monthly mortgage payment includes an amount allocated for property tax <w>impounds</w>."
                        },
                        {
                            "text": "The lender manages the <w>impounds</w> to guarantee that the home insurance policy does not lapse."
                        }
                    ],
                    "synonyms": [
                        "escrow"
                    ],
                    "common_phrases": [
                        "tax impounds"
                    ]
                }
            ]
        }
    ]
}