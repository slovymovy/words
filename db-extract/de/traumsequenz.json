                "translations": [
                    {
                        "translation_id": "8ab3300c-bd4b-4314-8b4f-7cb9313ef956",
                        "source_entry_id": "fdf9c500-6e3f-3f9d-a373-e5bb9f19e4d3",
                        "source_sense_id": "bb8604e7-f963-3489-ad9d-3c601f7dc498",
                        "source_sense_description": "Abfolge von (miteinander verbundenen) Träumen",
                        "target_lang_word": "dream sequence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dream sequence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03aff939-6cfb-3f94-a058-293503c30cc2",
                                        "entry_id": "c6c6bd52-fde4-3e37-9864-3b986bd4610d",
                                        "glosses": [
                                            "A section of a film, play, work of literature, or other narrative art, that depicts the events of a character’s dream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9d5a352-3557-4859-b21e-83bf37baaec1",
                                                "sense_id": "03aff939-6cfb-3f94-a058-293503c30cc2",
                                                "text": "Mr. Du Maurier with a dream-sequence, which, if less nightmarish than the great original series, is yet mighty pleasant and ingenious."
                                            },
                                            {
                                                "example_id": "ccba4b7d-6354-4d12-8740-87cad6a305c2",
                                                "sense_id": "03aff939-6cfb-3f94-a058-293503c30cc2",
                                                "text": "The settings are unusually brilliant, particularly those of the dream sequence, and the interpretation is forceful and dramatic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fba6cd0-fd48-3e15-9539-2c00283409bc",
                                        "entry_id": "c6c6bd52-fde4-3e37-9864-3b986bd4610d",
                                        "glosses": [
                                            "A series of events that take place in a person's dream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d324916f-dda2-4153-8441-03f28b459a3c",
                                                "sense_id": "3fba6cd0-fd48-3e15-9539-2c00283409bc",
                                                "text": "Nefzawi, rather ingeniously, offers numerous fantastic explanations and interpretations of dream sequences in The Perfumed Garden."
                                            },
                                            {
                                                "example_id": "ba40b0a5-c8b6-4777-93ea-1364350009a4",
                                                "sense_id": "3fba6cd0-fd48-3e15-9539-2c00283409bc",
                                                "text": "But this dream control takes practice and that first-waking note-taking is important. No matter how nonsensical and muddled the dream sequence is, write it down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
