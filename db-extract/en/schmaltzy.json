                "senses": [
                    {
                        "sense_id": "8ab780de-6b40-3c68-91fe-e6099fa04852",
                        "entry_id": "7785900e-1d7a-314d-89eb-18850b567cfc",
                        "glosses": [
                            "Overly sentimental, emotional, maudlin or bathetic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c87259-d64f-498b-a034-a1f7364726e5",
                                "sense_id": "8ab780de-6b40-3c68-91fe-e6099fa04852",
                                "text": "During a series of interviews, Franzen expressed ambivalence about Oprah’s endorsement—[…] that he had found a few of her choices in the past “schmaltzy” and “one-dimensional.”"
                            },
                            {
                                "example_id": "85ba8689-ac99-4bc2-b314-9fb2517166e1",
                                "sense_id": "8ab780de-6b40-3c68-91fe-e6099fa04852",
                                "text": "“In France, it has the reputation of being a typically American mixture of clichés and of schmaltz,” he wrote in an email. “Clichés about us don’t interest us, and the French are not very schmaltzy.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f94c6ad-51c7-4b5e-a802-4680fb418d08",
                        "source_entry_id": "7785900e-1d7a-314d-89eb-18850b567cfc",
                        "source_sense_id": "8ab780de-6b40-3c68-91fe-e6099fa04852",
                        "source_sense_description": "overly sentimental, emotional, maudlin or bathetic",
                        "target_lang_word": "larmoyant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "larmoyant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "588bdedb-0b6e-33b3-8adc-40a6fda03a87",
                                        "entry_id": "d712351f-9a40-32b5-8052-4b51ba96cea3",
                                        "glosses": [
                                            "Qui larmoie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c80d7ad-219f-42bd-899c-0a5d4f910da9",
                                                "sense_id": "588bdedb-0b6e-33b3-8adc-40a6fda03a87",
                                                "text": "Il taillait sans cesse des images de pierre, en sorte qu’il avait la barbe, les sourcils et les cheveux blancs de poussière, et que ses yeux étaient perpétuellement gonflés et larmoyants."
                                            },
                                            {
                                                "example_id": "b8c68c4b-3cc2-4b5f-a96d-6580fb4c4fa2",
                                                "sense_id": "588bdedb-0b6e-33b3-8adc-40a6fda03a87",
                                                "text": "Ses yeux larmoyants étaient surplombés de sourcils broussailleux tranchant avec son crâne lisse ; quelques touffes rescapées rebiquaient derrière des oreilles aux lobes effondrés de bouddha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "583c37d3-3923-3497-b892-6b0115463d26",
                                        "entry_id": "d712351f-9a40-32b5-8052-4b51ba96cea3",
                                        "glosses": [
                                            "Qui verse des larmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb247a6c-735c-449c-84a8-efac95da36c0",
                                                "sense_id": "583c37d3-3923-3497-b892-6b0115463d26",
                                                "text": "On la trouva toute larmoyante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0212ae-2b57-32e6-97f1-2fb7964472b3",
                                        "entry_id": "d712351f-9a40-32b5-8052-4b51ba96cea3",
                                        "glosses": [
                                            "Qui se plaint, qui gémit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507e0a11-e8db-4c03-8599-9928622b5ce7",
                                                "sense_id": "0d0212ae-2b57-32e6-97f1-2fb7964472b3",
                                                "text": "Il me fatigue à force d’être larmoyant."
                                            },
                                            {
                                                "example_id": "c6a81f60-ef38-4b16-9e69-8591c4de1b66",
                                                "sense_id": "0d0212ae-2b57-32e6-97f1-2fb7964472b3",
                                                "text": "Ton larmoyant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c05dd32-cce5-39cd-bad0-8363b10045b2",
                                        "entry_id": "d712351f-9a40-32b5-8052-4b51ba96cea3",
                                        "glosses": [
                                            "Qui est propre à faire verser des larmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f009de8b-7b69-4e49-8ba5-28acc53523e4",
                                                "sense_id": "9c05dd32-cce5-39cd-bad0-8363b10045b2",
                                                "text": "Ce qu’elle chantait – ah ! la fatale et maudite chanson ! –, c’était une vieille romance larmoyante et tendre, pareille à celles que les aveugles nasillent dans les rues."
                                            },
                                            {
                                                "example_id": "4267b5e5-3dea-4504-bf98-6838eaaf6b3f",
                                                "sense_id": "9c05dd32-cce5-39cd-bad0-8363b10045b2",
                                                "text": "Je ne pourrais point m’attendrir et je ne le veux pas, car je n'ai point l'âge ni le goût des récits larmoyants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "261ad4f0-7ca5-3d05-9315-30e1e9ea52f9",
                                        "entry_id": "d712351f-9a40-32b5-8052-4b51ba96cea3",
                                        "glosses": [
                                            "Qualifie un genre de comédies plus attendrissantes que gaies."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b7d1b2f-98be-4f70-b413-6c59c870c4fc",
                                                "sense_id": "261ad4f0-7ca5-3d05-9315-30e1e9ea52f9",
                                                "text": "Le comique larmoyant. — La comédie larmoyante."
                                            }
                                        ]
                                    }
                                ]
                            },
