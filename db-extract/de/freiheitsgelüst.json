                "senses": [
                    {
                        "sense_id": "258443f3-e156-3691-866e-2465328899af",
                        "entry_id": "5ab7781e-0784-3b5c-b8c2-81007dcd28ab",
                        "glosses": [
                            "dringende, starke Lust auf Freiheit; innerer Drang nach Freiheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7a73e4-42d0-4c17-996c-7115b0f40e3d",
                                "sense_id": "258443f3-e156-3691-866e-2465328899af",
                                "text": "„Der britischen Kolonialverwaltung aber, die sich über Jahrzehnte gegen die Freiheitsgelüste ihrer indischen Untertanen gesträubt hatte, konnte es auf einmal nicht schnell genug gehen.“"
                            },
                            {
                                "example_id": "70863f5e-35bc-405c-8d9f-1f7c3fc48366",
                                "sense_id": "258443f3-e156-3691-866e-2465328899af",
                                "text": "„Alle Dachrinnen liefen über und bildeten sich ein, Sturzbäder zu sein, und alle Rinnsteinbretter bekamen Freiheitsgelüste und schwippsten fröhlich von Bürgersteig zu Bürgersteig davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
