        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8bb571fe-b728-344b-bfff-53440630dfbc",
                    "sense_definition": "die lang aanhoudt en op een vervelende manier hinder geeft, bijvoorbeeld van pijn of geluid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanhoudende_hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het sporten voelde ze de hele dag een <w>zeurende</w> pijn in haar schouder.",
                            "target_lang_translations": {
                                "en": "After exercising, she felt a <w>nagging</w> pain in her shoulder all day."
                            }
                        },
                        {
                            "text": "Door de <w>zeurende</w> hoofdpijn ging hij vroeg naar bed.",
                            "target_lang_translations": {
                                "en": "Because of the <w>nagging</w> headache, he went to bed early."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervelend"
                    ],
                    "antonyms": [
                        "aangenaam"
                    ],
                    "common_phrases": [
                        "zeurende pijn",
                        "zeurende hoofdpijn"
                    ],
                    "target_lang_definitions": {
                        "en": "lasting a long time and causing annoyance in an unpleasant way, for example with pain or sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nagging",
                                "target_lang_sense_clarification": "for pain or discomfort that is persistent and irritating"
                            },
                            {
                                "target_lang_word": "aching",
                                "target_lang_sense_clarification": "for pain, especially one that continues for a long time"
                            },
                            {
                                "target_lang_word": "persistent",
                                "target_lang_sense_clarification": "for something unpleasant, repetitive, or continually bothering someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fe093cb-24a1-3032-bcb4-bd37a0004dd3",
                    "sense_definition": "aanhoudend en op een vervelende manier klagend of vragend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanhoudende_hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zeurende</w> kinderen vroegen de hele middag om ijs.",
                            "target_lang_translations": {
                                "en": "The <w>whining</w> children asked for ice cream all afternoon."
                            }
                        },
                        {
                            "text": "Met een <w>zeurende</w> toon bleef hij om hulp vragen.",
                            "target_lang_translations": {
                                "en": "In a <w>nagging</w> tone, he kept asking for help."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeurderig",
                        "dreinerig",
                        "jengelend",
                        "klagend",
                        "zanikend"
                    ],
                    "antonyms": [
                        "rustig"
                    ],
                    "common_phrases": [
                        "zeurende kinderen",
                        "zeurende toon",
                        "zeurende stem"
                    ],
                    "target_lang_definitions": {
                        "en": "persistently complaining or asking in an annoying way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nagging",
                                "target_lang_sense_clarification": "for someone who keeps complaining or asking in an annoying way"
                            },
                            {
                                "target_lang_word": "whining",
                                "target_lang_sense_clarification": "for complaining or asking in a high, annoying, childlike way"
                            },
                            {
                                "target_lang_word": "complaining",
                                "target_lang_sense_clarification": "for repeated complaining in an irritating way"
                            }
                        ]
                    }
                }
            ]
        },
        {
