                    },
                    {
                        "translation_id": "b17c07bd-1020-4d93-9316-43f629ed1ec6",
                        "source_entry_id": "f4bf706b-3ca4-3e3d-b816-878389e8edb2",
                        "source_sense_id": "eda99956-4e8a-333e-b9e5-475434adc785",
