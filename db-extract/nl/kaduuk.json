                ],
                "senses": [
                    {
                        "sense_id": "73e7b2f2-d423-3c66-a9aa-461ed09ec089",
                        "entry_id": "b916c32e-81a3-3aa2-aed3-761c14503a23",
                        "glosses": [
                            "in een zeer slechte staat van onderhoud verkerend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc86e79-bf50-4537-aaee-59b86e62e4be",
                                "sense_id": "73e7b2f2-d423-3c66-a9aa-461ed09ec089",
                                "text": "De relatie tussen het Nederlandse publiek en kunst is kaduuk. Dat blijkt wel uit de lauwe reactie vorig jaar op de bezuinigingen. Maar je ziet ook initiatieven die de afstand tussen publiek en kunst verkleinen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b950a1b-586e-3752-8886-3580e8abd653",
                        "entry_id": "b916c32e-81a3-3aa2-aed3-761c14503a23",
                        "glosses": [
                            "iets is zo beschadigd dat het zijn functie niet meer kan uitoefenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09beaba7-31ad-4a08-89cc-6639adb39bbd",
                                "sense_id": "3b950a1b-586e-3752-8886-3580e8abd653",
                                "text": "Voor Londen 2012 kwalificeerde hij zich opnieuw met de speer, maar toen stond hij met een kapotte schouder aan de start en hadden artsen hem afgeraden mee te doen als hij ooit nog fatsoenlijk wilde werpen. Twee weken eerder was het gewricht uit de kom geschoten. Maar hij deed het toch - „dit zijn wel de Paralympische Spelen” - en hij won de bronzen medaille. Hij was nadien ook meteen speerwerper-af. Alles in die schouder is zo’n beetje kaduuk - gewrichten, zenuwen, spieren."
                            },
                            {
                                "example_id": "00506fdb-5a57-42b6-8b07-7facda5cf720",
                                "sense_id": "3b950a1b-586e-3752-8886-3580e8abd653",
                                "text": "De buurjongen had een hamer in het gras gegooid. Daar was de voortduwer van die groene grasmaaier mooi klaar mee: door die hamer ging de motor kaduuk."
                            }
                        ]
                    }
                ],
