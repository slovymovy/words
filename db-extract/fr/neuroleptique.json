                ],
                "senses": [
                    {
                        "sense_id": "b7f9ff79-91b8-3755-aa78-10de509c9c25",
                        "entry_id": "a21f0151-4527-3618-bfa8-a5d0f1b1c599",
                        "glosses": [
                            "Médicament à effet sédatif utilisé dans le traitement de certains problèmes de santé mentale — notamment ceux correspondant aux diagnostics de psychoses ou de troubles de l’humeur."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "4f5b66b1-2e50-473e-a497-2944ff6a6137",
                                "sense_id": "b7f9ff79-91b8-3755-aa78-10de509c9c25",
                                "text": "La télévision peut être un impitoyable neuroleptique et un puissant somnifère."
                            },
                            {
                                "example_id": "6f5c9025-598e-43d9-baa3-0da752647c23",
                                "sense_id": "b7f9ff79-91b8-3755-aa78-10de509c9c25",
                                "text": "Lucile ressemblait à tous les gens qui prennent des neuroleptiques à haute dose, leur regard est le même, ils se tiennent de la même façon, leurs gestes ont des allures mécaniques. Ils sont loin, comme protégés du monde, rien ne semble pouvoir les atteindre, leurs émotions sont contenues, régulées, sous contrôle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30583497-7270-4452-90c2-5c3d6808773c",
                        "source_entry_id": "a21f0151-4527-3618-bfa8-a5d0f1b1c599",
                        "source_sense_id": "b7f9ff79-91b8-3755-aa78-10de509c9c25",
                        "target_lang_word": "Neuroleptikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuroleptikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7f7503-4c48-3568-8ad8-c78ba494ee8c",
                                        "entry_id": "78233f35-b8c5-316c-8e89-1dac4803aab0",
                                        "glosses": [
                                            "Arzneistoff mit einer sedierenden und antipsychotischen Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa3c94f-5b00-4dd5-a84e-b4ad80b9fb04",
                                                "sense_id": "8f7f7503-4c48-3568-8ad8-c78ba494ee8c",
                                                "text": "„Die Entdeckung dieses ersten Neuroleptikums war ganz unerwartet.“"
                                            }
