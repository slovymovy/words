                "senses": [
                    {
                        "sense_id": "4fa2cb25-1b62-3379-858c-5d7767faac77",
                        "entry_id": "aa7ed75b-8b8b-3fe4-8dee-a84ca3b30d1a",
                        "glosses": [
                            "Variante de obnubiler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63be3837-4c36-4f0e-ae88-4193d270fd1b",
                                "sense_id": "4fa2cb25-1b62-3379-858c-5d7767faac77",
                                "text": "La conquête du pouvoir politique les obnibulait. Cependant il est bon de savoir que c'est sur les instances pressantes de Marx que Kugelmann adhéra à l'A.I.T."
                            },
                            {
                                "example_id": "cc56274d-23e5-4bc5-8b90-7b72e14aeab3",
                                "sense_id": "4fa2cb25-1b62-3379-858c-5d7767faac77",
                                "text": "Ne sois pas obnibulé par ta carrière — tu iras jusqu'au sommet, c'est sûr, tu peux te permettre de te laisser aller quelque peu et oublier de temps en temps les théories d'administration urbmonadiale."
                            },
                            {
                                "example_id": "d4f54ec2-0e74-4682-8723-11a85357e711",
                                "sense_id": "4fa2cb25-1b62-3379-858c-5d7767faac77",
                                "text": "Celui-ci conférait aux Moudjahidines de la révolution une auréole qui obnibulait la population algérienne, notamment dans les campagnes."
                            }
                        ]
                    }
