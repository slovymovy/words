                                        "glosses": [
                                            "Capable of being salvaged, saved or repaired. Worth rescuing and keeping rather discarding or replacing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf92474-d6cf-4407-9029-218e8e31e57a",
                                                "sense_id": "e9070ce2-3782-38c0-8463-4339a669a3e8",
                                                "text": "The car wasn't salvageable after the engine fire. The insurance company totalled it and I bought a new one."
                                            },
                                            {
                                                "example_id": "d88775b8-c8a1-4aac-bc1a-a65ed3f70a3b",
                                                "sense_id": "e9070ce2-3782-38c0-8463-4339a669a3e8",
                                                "text": "Considerable work had to be done by way of repairs and replacement of bricks and woodwork (doors, floors, skirtings and panelling) where these were too far gone to be salvageable, including reprofiling to match originals."
                                            }
                                        ]
                                    }
