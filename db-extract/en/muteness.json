                        "form": "mutenesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                        "entry_id": "bfee8cda-439a-38e8-8c72-065fb9e4749e",
                        "glosses": [
                            "The characteristic of being mute."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5f94a016-6ba4-4beb-9ccb-74b24390f383",
                                "sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                                "text": "Jamike came with a certain muteness, as if something had silenced him."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a4f1ad3-d5d9-426f-bfc7-59428e9231d9",
                        "source_entry_id": "bfee8cda-439a-38e8-8c72-065fb9e4749e",
                        "source_sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                        "source_sense_description": "characteristic of being mute",
                        "target_lang_word": "němota",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0f45c5d9-12c3-4658-97c0-e2f91c16a9eb",
                        "source_entry_id": "bfee8cda-439a-38e8-8c72-065fb9e4749e",
                        "source_sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                        "source_sense_description": "characteristic of being mute",
                        "target_lang_word": "mutité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eba9cebf-1d58-3926-a2eb-e6b05c59f863",
                                        "entry_id": "9800f302-90d5-314d-802d-730776beb56c",
                                        "glosses": [
                                            "Privation de la parole, de la voix articulée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a9f0b4-8510-40a7-ab88-52e49e90c3a5",
                                                "sense_id": "eba9cebf-1d58-3926-a2eb-e6b05c59f863",
                                                "text": "Ils voyaient des choses quʼils nʼauraient pas dû voir, entendaient des choses quʼils nʼauraient pas dû entendre, subissaient des choses quʼils nʼauraient pas dû subir, cherchaient dans la mutité, dans la sidération, le silence quʼils ne parvenaient pas à trouver autour dʼeux."
                                            },
                                            {
                                                "example_id": "d63e4d21-f055-42f1-97a4-c9cc80234763",
                                                "sense_id": "eba9cebf-1d58-3926-a2eb-e6b05c59f863",
                                                "text": "Jʼen conclus que si la Providence avait placé un des plus habiles [chirurgiens-barbiers] sur mon chemin si tôt le matin, cʼest que la suite à peine croyable des événements qui allaient marquer ma vie avait été expressément voulue par Elle : ma chute, lʼécrasement de mon larynx, lʼintervention du barbier, ma mutité et ma rencontre avec le cardinal Montalto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "062adc2d-3de2-4d6f-a137-e91b63fc0b52",
                        "source_entry_id": "bfee8cda-439a-38e8-8c72-065fb9e4749e",
                        "source_sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                        "source_sense_description": "characteristic of being mute",
                        "target_lang_word": "mutisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15a7e5b2-6da9-3f20-b629-81765cb1d236",
                                        "entry_id": "fefc0a55-24cd-3fd7-af42-7f557529610f",
                                        "glosses": [
                                            "État de celui qui est muet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b07e754-332c-417b-83f7-0cb294324a10",
                                                "sense_id": "15a7e5b2-6da9-3f20-b629-81765cb1d236",
                                                "text": "Le mutisme est ordinairement une suite de la surdité de naissance."
                                            },
                                            {
                                                "example_id": "21f14b46-1847-477c-862a-c52a1ff6b936",
                                                "sense_id": "15a7e5b2-6da9-3f20-b629-81765cb1d236",
                                                "text": "Je ne parle pas ici du mutisme causé par la destruction des nerfs récurrents ou par une attaque d’apoplexie : il n’est alors qu’un symptôme. Je passerai également sous silence le mutisme causé par les divers empoisonnements, parce que j’aurai à m’en occuper plus tard. Lorsque le mutisme est essentiellement nerveux, il constitue le seul symptôme de l’affection."
                                            },
                                            {
                                                "example_id": "853fb2c5-2296-4d97-b2ec-385b6a78b694",
                                                "sense_id": "15a7e5b2-6da9-3f20-b629-81765cb1d236",
                                                "text": "Lise était muette, mais non muette de naissance ; c’est-à-dire que le mutisme n’était point chez elle la conséquence de la surdité. Pendant deux ans elle avait parlé, puis tout à coup, un peu avant d’atteindre sa quatrième année, elle avait perdu l’usage de la parole. Cet accident, survenu à la suite de convulsions, n’avait heureusement pas atteint son intelligence, qui s’était au contraire développée avec une précocité extraordinaire ; non-seulement elle comprenait tout, mais encore elle disait, elle exprimait tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                        "entry_id": "fefc0a55-24cd-3fd7-af42-7f557529610f",
                                        "glosses": [
                                            "Fait de ne pas parler, souvent pour exprimer un retrait, un rejet, un entêtement, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bcbea62-26fa-4986-bb17-2390a7d85f03",
                                                "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                                "text": "Jamais personne ne l’avait entendue chanter, et ce mutisme donnait lieu à de bizarres interprétations."
                                            },
                                            {
                                                "example_id": "8167c764-a6a8-4850-b608-83cfc92bcc03",
                                                "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                                "text": "Ses amis et ses compagnons de promenades lointaines, les spahis du Bureau arabe, s’étaient de nouveau retranchés dans un mutisme lourd, dans la soumission froide des premiers jours."
                                            },
                                            {
                                                "example_id": "ead91669-52ac-49ff-91fd-10778c236a3b",
                                                "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                                "text": "Mais cette nouvelle surprise me coupait la parole : je ne répondis rien. Je donnai même à ce mutisme un air d’imbécillité pour laisser Mauricette expliquer elle-même son mystère."
                                            },
                                            {
                                                "example_id": "f03d0041-f4ff-4a42-b105-27f46a5f625c",
                                                "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                                "text": "Le matin, chez Tante Madeleine, le grand-père, en proie au plus noir chagrin, avait accablé les siens de son mutisme."
                                            },
                                            {
                                                "example_id": "699abeb9-0efa-4c77-aaae-6a4ef3955eb5",
                                                "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                                "text": "Rien n’est plus fort que le mutisme lorsqu’on a quelque chose d’important à se dire."
                                            },
                                            {
                                                "example_id": "b7027fc8-cf77-4802-a9e2-2734eb65d52f",
                                                "sense_id": "503d95f2-c428-3476-9400-82ece65ff761",
                                                "text": "Le mutisme, c’est l’absence de parole. Le silence n’est pas lié à la parole ou à l’absence de parole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81a6e25d-c8ef-4598-bc5c-754f6fa15704",
                        "source_entry_id": "bfee8cda-439a-38e8-8c72-065fb9e4749e",
                        "source_sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                        "source_sense_description": "characteristic of being mute",
                        "target_lang_word": "aphonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c33b32bc-6673-3f6b-9948-02e16c0d1178",
                                        "entry_id": "2037dede-bed6-30f8-ab8c-61bdbb7ee071",
                                        "glosses": [
                                            "Perte plus ou moins complète de la voix."
                                        ],
                                        "tags": [
                                            "Handicap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "863a1274-d4bf-4b21-b29f-ea4127a1173c",
                                                "sense_id": "c33b32bc-6673-3f6b-9948-02e16c0d1178",
                                                "text": "La raucité ou lʼaphonie sont la conséquence de la paralysie des muscles principalement constricteurs de la glotte."
                                            },
                                            {
                                                "example_id": "d042eb78-d02e-44ae-96cf-483c8e3a10e7",
                                                "sense_id": "c33b32bc-6673-3f6b-9948-02e16c0d1178",
                                                "text": "Les Brises ont brui comme des litanies\nEt la flûte s’exile en molles aphonies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1faabea9-74aa-4eb2-9832-08f18dc040ac",
                        "source_entry_id": "bfee8cda-439a-38e8-8c72-065fb9e4749e",
                        "source_sense_id": "5291b5b3-8093-3df8-a40c-65fcb2d86ba6",
                        "source_sense_description": "characteristic of being mute",
                        "target_lang_word": "Stummheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stummheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                        "entry_id": "ae9b8844-29f0-3768-aec3-b1c1e668a020",
                                        "glosses": [
                                            "Unfähigkeit, sich äußern zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4f01c1-097e-4eb4-8896-0f931999044e",
                                                "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                                "text": "„An der Stummheit meiner Eltern, an ihrer Sprachlosigkeit hatte ich mitzutragen.“"
                                            },
                                            {
                                                "example_id": "7fc8a987-84cb-4df7-8852-aed346153da4",
                                                "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                                "text": "„Der Zeichner stand in beredter Stummheit neben ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
