                "senses": [
                    {
                        "sense_id": "edc17c99-97b5-35cb-ad04-de0bb3f3afdc",
                        "entry_id": "2cc7a238-819d-3b9b-b043-0c28b05f8e56",
                        "glosses": [
                            "mit acht Geschoßen gebaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53411129-dd20-4e96-8df9-02f9b45ee42c",
                                "sense_id": "edc17c99-97b5-35cb-ad04-de0bb3f3afdc",
                                "text": "Unglaublich! Dieses achtgeschoßige Gebäude besteht gänzlich aus Massivholz."
                            },
                            {
                                "example_id": "cc413883-52d0-4480-aed5-e7db2a641766",
                                "sense_id": "edc17c99-97b5-35cb-ad04-de0bb3f3afdc",
                                "text": "„Mit Bescheid vom 17. November 1955 wurde die Widmungs- und Baubewilligung zur Errichtung eines Mehrfamilienhauses (achtgeschoßig mit zurückversetztem Dachgeschoß, im Erdgeschoß mit Geschäften) erteilt.“"
