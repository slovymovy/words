                ],
                "senses": [
                    {
                        "sense_id": "e5852004-66a1-3779-843c-21f95a3aecb3",
                        "entry_id": "3e9bec58-ed0b-3d14-908f-5decc4082bf2",
                        "glosses": [
                            "Kopfschmerztablette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51762838-5c23-43d6-bfa5-654c4ee2bf33",
                                "sense_id": "e5852004-66a1-3779-843c-21f95a3aecb3",
                                "text": "„Ich habe gehört, Sie nehmen nicht einmal ein Kopfwehpulver?“"
                            },
                            {
                                "example_id": "30474d9f-3316-46eb-9380-496108464314",
                                "sense_id": "e5852004-66a1-3779-843c-21f95a3aecb3",
                                "text": "„Gleich nach dem Aufstehen ein Kopfwehpulver (wegen des Vorabends) und eine Koffeintablette (wirkt besser als Kaffee).“"
                            },
                            {
                                "example_id": "7c7e12a9-2391-4ec5-96f8-85068323cda9",
                                "sense_id": "e5852004-66a1-3779-843c-21f95a3aecb3",
                                "text": "„Eine Anzahl von Patienten haben es mir zunächst sehr verübelt, wenn ich ihnen keine Kopfwehpulver geben wollte, die doch andere Ärzte so gern anrieten, und die doch so schöne Erleichterung verschaffen konnten.“"
                            },
                            {
                                "example_id": "69129706-087b-4023-aa8d-ecd5b16b2d5e",
                                "sense_id": "e5852004-66a1-3779-843c-21f95a3aecb3",
                                "text": "„‚Im Umgang mit rezeptfreien Schmerzmitteln herrscht eine verblüffende Sorglosigkeit vor‘, kritisiert etwa der Spiegel das systematische Unterschätzen der von vielen als harmlos angesehenen Kopfwehpulver.“"
                            },
                            {
                                "example_id": "10e1e09a-97a4-44ff-b781-201b16bfc7d9",
                                "sense_id": "e5852004-66a1-3779-843c-21f95a3aecb3",
                                "text": "„Ein Aspirin da, ein Schmerzmittel dort, Kopfwehpulver, Schmerz- und Entzündungshemmer und Nahrungsergänzungsmittel, die keiner braucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
