    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db32d1fb-73f7-3e9c-83b0-e46d151c9743",
                    "sense_definition": "Ouverture ou fente profonde qui se produit dans un glacier, dans le sol ou dans une maçonnerie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fissure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les alpinistes progressent avec une grande prudence pour éviter de glisser dans une <w>crevasse</w>."
                        },
                        {
                            "text": "Après le tremblement de terre, une immense <w>crevasse</w> a séparé la route en deux parties distinctes."
                        }
                    ],
                    "common_phrases": [
                        "tomber dans une crevasse",
                        "crevasse de glacier"
                    ]
                },
                {
                    "sense_id": "1f118bbe-427f-3ece-9fe3-1593ffae26e9",
                    "sense_definition": "Petite fente douloureuse de la peau provoquée notamment par le froid, la sécheresse ou l'allaitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fissure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'hiver rigoureux, le vent glacial lui a provoqué une profonde <w>crevasse</w> sur les mains."
                        },
                        {
                            "text": "Cette crème apaisante aide à réparer chaque <w>crevasse</w> douloureuse causée par le froid."
                        }
                    ],
                    "common_phrases": [
                        "crevasse au talon",
                        "soigner une crevasse"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc5af31c-8521-3634-973f-1deab57cb69c",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif de <w>crevasser</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La sécheresse estivale <w>crevasse</w> la terre fertile du jardin en quelques semaines."
                        },
                        {
                            "text": "Le maçon craint que le gel hivernal ne <w>crevasse</w> le mur rénové."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forme verbale conjuguée"
                        }
                    ]
                },
                {
                    "sense_id": "3ee73d45-237a-3c1e-ba0d-10cae4e86bb0",
                    "sense_definition": "Première personne du singulier de l'imparfait du subjonctif de <w>crever</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fallait que je ne <w>crevasse</w> point de faim durant cette terrible expédition."
                        },
                        {
                            "text": "Le médecin craignait que je ne <w>crevasse</w> sous un effort physique aussi violent."
                        }
                    ],
                    "traits": [
