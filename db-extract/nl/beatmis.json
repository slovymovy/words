                "senses": [
                    {
                        "sense_id": "aaa9b3b2-0687-355c-8561-a8b0222c0eb0",
                        "entry_id": "a7a7becc-5c0b-39d4-9097-c70767e516c6",
                        "glosses": [
                            "een kerkelijke eucharistieviering die zich door middel van (beat)muziek specifiek op de jeugd richtte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66fdafa0-accd-4ca4-8dda-c20b11160e48",
                                "sense_id": "aaa9b3b2-0687-355c-8561-a8b0222c0eb0",
                                "text": "Met het beatmis-debacle nog helder voor ogen, valt wel te voorspellen hoe het evangelicale avontuur afloopt: jonge gemeenteleden raken na korte tijd weer uitgekeken op al die nieuwigheden en meer doorgewinterde gelovigen die prijs stellen op een traditionele, plechtige liturgie met stijlvol gezang en een liefst enigszins diepzinnige preek, raken gefrustreerd of haken af."
                            },
                            {
                                "example_id": "02f126f9-2881-4af2-8a65-24185e5534f9",
                                "sense_id": "aaa9b3b2-0687-355c-8561-a8b0222c0eb0",
                                "text": "Al sinds de introductie van de legendarische ‘beatmis’ in de jaren zestig verkeren veel Nederlandse kerken in de veronderstelling dat het christelijk geloof – met het oog op de moderne mens – opgeleukt en gepimpt moet worden."
                            }
                        ]
                    }
                ],
