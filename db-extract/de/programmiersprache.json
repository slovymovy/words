                    {
                        "form_id": "f9b582b9-c272-465c-b912-05b969aeb54f",
                        "entry_id": "5ea12f22-e9a6-39e0-8a54-cd704a70f759",
                        "tags": [
                            "plural"
                        ],
                        "form": "Programmiersprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                        "entry_id": "5ea12f22-e9a6-39e0-8a54-cd704a70f759",
                        "glosses": [
                            "程式语言，电脑语言，编程语言，最常见的是汇编、C、VB、Java、Delphi等"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9a222a-44f9-4673-bde3-5c7e471fe713",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Christoph Böttcher: Last Call: In 5 Webinaren in C++ vom Einsteiger zum Profi mit der heise Academy, heise.de, Heise Medien GmbH & Co. KG, Hannover, Deutschland, 25.07.2023:"
                            },
                            {
                                "example_id": "f17d30c5-97ad-4a9b-ae42-98cc80b2743d",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "C++ zählt seit vielen Jahren zu den bedeutendsten Programmiersprachen, egal ob in Betriebssystemen oder Anwendungen."
                            },
                            {
                                "example_id": "3e2949aa-5234-4924-b253-2b8cc16b62a7",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Rainald Menge-Sonnentag: Security: Schwachstellen-Scanner für Google Go geht an den Start, heise.de, Heise Medien GmbH & Co. KG, Hannover, Deutschland, 14.07.2023:"
                            },
                            {
                                "example_id": "0fe75493-d7c1-4d40-bdbb-1efeefb83dc8",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Google hat das Tool Govulncheck und die zugehörige API in Version 1.0 veröffentlicht. Damit gilt das Tool, das Projekte in der Programmiersprache Go auf Schwachstellen untersucht, als stabil."
                            },
                            {
                                "example_id": "4425133f-b59d-423f-9efe-91e727e09f87",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Astrid Hiller Blin: Einstieg in Fortran: Wie Sie eine Entwicklungsumgebung einrichten, heise.de, Heise Medien GmbH & Co. KG, Hannover, Deutschland, 20.07.2023:"
                            },
                            {
                                "example_id": "161df746-9e63-4caf-8d58-3b48bbe6b6a7",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Obwohl Fortran eine der ersten höheren Programmiersprachen ist, wird sie in der modernen Forschung weiterhin genutzt. Bis heute gilt sie für numerisch intensive Rechnungen als sehr mächtige und schnelle Programmiersprache."
                            },
                            {
                                "example_id": "04203845-6bde-4a6e-b0b4-a0767747010a",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Programmieren können – dank Chat GPT, dw.com, Deutsche Welle, Bonn, Deutschland, 19.07.2023:"
                            },
                            {
                                "example_id": "bcc083b7-88a5-46c0-a218-0a8d4e338e3c",
                                "sense_id": "b2dad855-d459-3fb8-bbec-59bcdd455d9c",
                                "text": "Chat GPT beherrscht mehrere Programmiersprachen."
                            }
                        ]
                    }
                ],
