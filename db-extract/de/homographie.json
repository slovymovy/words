                "senses": [
                    {
                        "sense_id": "8749710d-64a9-3769-89bb-4c7ee169857a",
                        "entry_id": "5da906d2-b7e3-3ef9-ae54-7b240db7b83c",
                        "glosses": [
                            "gleiche Schreibung von Wörtern, die verschiedene Bedeutungen haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9f8560-f2fc-417c-ae21-bce8ae8352d7",
                                "sense_id": "8749710d-64a9-3769-89bb-4c7ee169857a",
                                "text": "Bei den Wörtern \"Bauer\" (= Landwirt) und \"Bauer\" (= Vogelkäfig) liegt Homographie vor."
                            },
                            {
                                "example_id": "e98300d0-3e53-4d16-a886-e7a8afeb0729",
                                "sense_id": "8749710d-64a9-3769-89bb-4c7ee169857a",
                                "text": "„Durch die Einführung einer Alphabetschrift wird die Homonymie zumindest tendenziell auf der Ebene der geschriebenen Sprache durch eine Homographie reproduziert.“"
                            },
                            {
                                "example_id": "db05c1a6-dc4b-4dc0-ad91-cc3225d90966",
                                "sense_id": "8749710d-64a9-3769-89bb-4c7ee169857a",
                                "text": "„…einem Graphomonem entsprechen zwei Phonomoneme (Heterographonie mit Homographie und Heterophonie, z.B. /ˈmodərn/ und /moˈdɛrn/ - (modern)…“"
                            }
                        ],
