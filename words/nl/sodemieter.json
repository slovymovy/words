{
    "word_family": [
        "sodemieteren",
        "gesodemieter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c7a34e2-1a22-3f11-81f1-2902d2bb7bc6",
                    "sense_definition": "Een klein beetje of geen zier (meestal in ontkennende zinnen over interesse of zorg).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij trekt zich er geen <w>sodemieter</w> van aan wat anderen over hem denken. ",
                            "target_lang_translations": {
                                "en": "He doesn't give a <w>damn</w> about what others think of him."
                            }
                        },
                        {
                            "text": "Het maakt mij geen <w>sodemieter</w> uit wat we vanavond gaan eten. ",
                            "target_lang_translations": {
                                "en": "I don't give a <w>shit</w> what we eat tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "moer",
                        "barst",
                        "dutel"
                    ],
                    "common_phrases": [
                        "geen sodemieter uitmaken",
                        "geen sodemieter schelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en licht grof"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A tiny bit or not a damn thing (usually in negative sentences about care or interest)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "damn",
                                "target_lang_sense_clarification": "used in expressions like 'not give a damn'"
                            },
                            {
                                "target_lang_word": "shit",
                                "target_lang_sense_clarification": "vulgar, used in expressions like 'not give a shit'"
                            },
                            {
                                "target_lang_word": "rat's ass",
                                "target_lang_sense_clarification": "informal, used to express complete lack of interest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77718f4c-6b71-398b-ab2d-df66b9848cd5",
                    "sense_definition": "Scheldwoord voor een vervelend of gemeen persoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oude <w>sodemieter</w> probeerde me alweer op te lichten. ",
                            "target_lang_translations": {
                                "en": "That old <w>bastard</w> tried to scam me again."
                            }
                        },
                        {
                            "text": "Pas op voor die <w>sodemieter</w>, hij is niet te vertrouwen. ",
                            "target_lang_translations": {
                                "en": "Watch out for that <w>bugger</w>, he can't be trusted."
                            }
                        }
                    ],
                    "synonyms": [
                        "bliksem",
                        "sodemieterd",
                        "kreng"
                    ],
                    "common_phrases": [
                        "oude sodemieter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pejoratief en licht grof"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Invective or insult for an annoying, mean, or untrustworthy person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bastard",
                                "target_lang_sense_clarification": "an unpleasant or despicable person"
                            },
                            {
                                "target_lang_word": "bugger",
                                "target_lang_sense_clarification": "informal term for a troublesome person"
                            },
                            {
                                "target_lang_word": "sodbuster",
                                "target_lang_sense_clarification": "slang for a low or mean person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28e4805c-31ec-3d2e-84ed-2a9c67070046",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>sodemieteren</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sodemieter</w> al die oude spullen gewoon in de vuilnisbak. ",
                            "target_lang_translations": {
                                "en": "I'm just going to <w>chuck</w> all that old stuff in the trash."
                            }
                        },
                        {
                            "text": "Als je nu niet luistert, <w>sodemieter</w> ik je er meteen uit. ",
                            "target_lang_translations": {
                                "en": "If you don't listen right now, I'll <w>throw</w> you out immediately."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of sodemieteren (to throw, toss, or get lost)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "to toss carelessly"
                            },
                            {
                                "target_lang_word": "chuck",
                                "target_lang_sense_clarification": "informal for throwing away"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a3a98e0-264c-3583-8f99-41f2eafc61ee",
                    "sense_definition": "Gebiedende wijs van <w>sodemieteren</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sodemieter</w> toch op en laat me met rust! ",
                            "target_lang_translations": {
                                "en": "<w>Piss</w> off and leave me alone!"
                            }
                        },
                        {
                            "text": "<w>Sodemieter</w> al die rommel meteen het huis uit. ",
                            "target_lang_translations": {
                                "en": "<w>Throw</w> all that junk out of the house right now."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sodemieter op"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of sodemieteren (used to tell someone to piss off or throw something)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bugger off",
                                "target_lang_sense_clarification": "imperative, telling someone to leave"
                            },
                            {
                                "target_lang_word": "piss off",
                                "target_lang_sense_clarification": "vulgar imperative to tell someone to go away"
                            },
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "imperative, to toss or cast out"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}