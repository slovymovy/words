                "senses": [
                    {
                        "sense_id": "9aac34e1-3a0c-3941-b9e6-66f781180933",
                        "entry_id": "74c8480f-b914-35fa-bdce-a3bd96af4417",
                        "glosses": [
                            "mission, purpose, or vocation in one's life"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8e2bd3b4-36a5-44cf-8f74-7dcb4f135e0d",
                                "sense_id": "9aac34e1-3a0c-3941-b9e6-66f781180933",
                                "text": "Sehr junge Menschen pflegen sich ja, wenn einmal die Periode überwunden ist, in der sie Kutscher, Gärtner oder Zuckerbäcker werden wollten, mit der Phantasie das Gebiet ihrer Lebensaufgaben zunächst dort abzustecken, wo sich ihrem Ehrgeize die meiste Möglichkeit, Auszeichnendes zu leisten, darzubieten scheint.",
                                "translation": "The Confusions of Young Törless",
                                "english": "The Confusions of Young Törless"
                            },
                            {
                                "example_id": "212e4908-9b3e-4e27-8cb1-ae94a5d23407",
                                "sense_id": "9aac34e1-3a0c-3941-b9e6-66f781180933",
                                "text": "Er vermied die Frauen, ja er haßte sie, denn er befürchtete, von ihnen von der Heiligkeit seiner Lebensaufgabe abgelenkt zu werden."
                            },
                            {
                                "example_id": "aef46b0f-8975-41d3-81a1-4c6fdeea54a2",
                                "sense_id": "9aac34e1-3a0c-3941-b9e6-66f781180933",
                                "text": "»Mein Liebling! Zum letztenmal sag ich Dir aus der Ferne Gute Nacht. Von morgen ab wirst Du bei mir sein und bleiben. Eine heilige Lebensaufgabe liegt vor uns, die wir zum Wohle der Menschheit erfüllen wollen, und eine, die unsere bräutliche Ehe uns persönlich auferlegt.",
                                "translation": "Memoirs of a Woman Socialist",
                                "english": "Memoirs of a Woman Socialist"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
