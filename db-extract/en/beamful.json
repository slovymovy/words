                "senses": [
                    {
                        "sense_id": "3def24c7-2863-34fc-a553-9cd0574fa8c6",
                        "entry_id": "20ba0cf8-723f-3b6f-8858-402aed2df260",
                        "glosses": [
                            "A quantity in a beam (of wood, of light, etc)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990b74f6-2e69-47a1-a4a2-e003aea35816",
                                "sense_id": "3def24c7-2863-34fc-a553-9cd0574fa8c6",
                                "text": "Phialai of similar size would be divided into convenient \" beamfuls \" or weighing-lots."
                            },
                            {
                                "example_id": "2f26f255-4488-4553-8d4d-6e23a70efb31",
                                "sense_id": "3def24c7-2863-34fc-a553-9cd0574fa8c6",
                                "text": "Susan committed those confused, tragic eyes of hers to me, fixing on rhy stare, perhaps for some optical beamful of compassion."
                            },
                            {
                                "example_id": "ea7b2dfc-915b-4d82-920e-b54acf938347",
                                "sense_id": "3def24c7-2863-34fc-a553-9cd0574fa8c6",
                                "text": "Behind the olde worlde postcard village, the timbers are rotting away by the beamful and the corpses are piling up."
                            },
                            {
                                "example_id": "41f2fd7b-ba97-43a2-bcd4-c159fedd147b",
                                "sense_id": "3def24c7-2863-34fc-a553-9cd0574fa8c6",
                                "text": "He set off to get some words take some mysteries: he cut a field of reindeer open a big beamful of squirrels; from there he got many words— all of them useless."
                            },
                            {
                                "example_id": "c931c25f-1238-44bc-8edf-74d26536d6c1",
                                "sense_id": "3def24c7-2863-34fc-a553-9cd0574fa8c6",
                                "text": "A rider on a horse approaches: a torch attached to saddle or bridle illuminates a beamful of plummeting needles of rain, as if to reveal them rather than clarify the way forward for the rider."
                            }
                        ]
                    }
