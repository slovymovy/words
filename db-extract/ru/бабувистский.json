                    {
                        "translation_id": "5f1ac0cb-ffec-4635-906a-9361a8c73db3",
                        "source_entry_id": "bab4ce0b-6e6f-3743-a0cb-0d37fba6f6e3",
                        "target_lang_word": "babouviste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babouviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02c3911c-5dc9-3d0e-ab36-c9735c0ffee6",
                                        "entry_id": "3883f7ee-02da-3564-8fe8-6a2aa1f3c02d",
                                        "glosses": [
                                            "Partisan de Gracchus Babeuf ou du babouvisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f73c68b8-57c2-4136-8736-85e939b9f902",
                                                "sense_id": "02c3911c-5dc9-3d0e-ab36-c9735c0ffee6",
                                                "text": "Cela veut dire, somme toute, que les babouvistes n’étaient pas dupés des fictions électorales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4782529d-001f-35b5-bb36-e29a971c8ada",
                                        "entry_id": "3883f7ee-02da-3564-8fe8-6a2aa1f3c02d",
                                        "glosses": [
                                            "Partisan de l’égalité absolue entre tous les hommes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "babouviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "938007d3-e986-3de8-9e19-2324c97731a3",
                                        "entry_id": "a48ab072-7eb2-3e06-bf4c-1a53b1e93fdc",
                                        "glosses": [
                                            "Relatif aux idées politiques de Gracchus Babeuf, au babouvisme et à leurs partisans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17918f18-405c-4e1c-ad65-2478dd21ae72",
                                                "sense_id": "938007d3-e986-3de8-9e19-2324c97731a3",
                                                "text": "En 1796, les conditions n’étaient pas réunies pour voir triompher l’élan babouviste."
                                            }
                                        ]
                                    }
                                ]
                            }
