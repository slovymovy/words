                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38a18cf7-cd06-4630-bdd9-104eb5907650",
                        "entry_id": "d329aff0-8616-35bc-81d9-85c3be2c5b9c",
                        "tags": [
                            "plural"
                        ],
