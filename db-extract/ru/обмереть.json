                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf76f63f-9d57-47a0-b455-252bf82c07f1",
                                "sense_id": "51e10967-f150-3ace-8275-4fe66c0c8cf0",
                                "text": "Наверное, это был обморок. – Рон никак не мог успокоиться. – Ты вдруг обмер, упал и забился"
                            }
                        ]
