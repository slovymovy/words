                ],
                "translations": [
                    {
                        "translation_id": "3b73a1d4-5def-48f8-a387-08b0f78ef752",
                        "source_entry_id": "13d608be-79c2-3230-9703-f1cbfaae2d6b",
                        "source_sense_id": "c6b06a1e-a170-3d9f-9053-7074e552e944",
                        "target_lang_word": "prévention",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prévention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba60f44a-8914-3bad-a82f-6dde7c244067",
                                        "entry_id": "903fdcbd-0605-3589-af4b-76e122177c94",
                                        "glosses": [
                                            "Action de prévenir ; mesure à prendre pour prévenir certains risques."
                                        ],
                                        "tags": [
                                            "Santé publique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de392469-daed-4b8b-ab9f-3e80bcd96fe9",
                                                "sense_id": "ba60f44a-8914-3bad-a82f-6dde7c244067",
                                                "text": "Place Charles-Surugue, des feldgendarmes apprennent aux Auxerrois à traverser dans les passages cloutés qu'ils semblaient ignorer. C'est une leçon de prévention routière avant la lettre."
                                            },
                                            {
                                                "example_id": "5f8edac0-717f-4817-818e-8dd04188821d",
                                                "sense_id": "ba60f44a-8914-3bad-a82f-6dde7c244067",
                                                "text": "Le médecin traitant et le pneumologue en particulier ont donc un rôle important, en liaison avec le médecin du travail pour intervenir à tous les stades de la prévention primaire, secondaire et tertiaire vis-à-vis des risques respiratoires d’origine professionnelle."
                                            },
                                            {
                                                "example_id": "40d84d1c-c2d6-4af8-a7ea-39f96e6bc2f4",
                                                "sense_id": "ba60f44a-8914-3bad-a82f-6dde7c244067",
                                                "text": "On l’oublie un peu, mais les scientifiques de la Santé publique sont davantage des experts en prévention, plutôt habitués à lutter contre le tabagisme et l’obésité qu’à traquer un ennemi mortel, ravageur et invisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86d4764-ce42-3e20-b25f-90a05e13da7f",
                                        "entry_id": "903fdcbd-0605-3589-af4b-76e122177c94",
                                        "glosses": [
                                            "Organisation qui a la charge de cette action."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                        "entry_id": "903fdcbd-0605-3589-af4b-76e122177c94",
                                        "glosses": [
                                            "ou Opinion préconçue, favorable ou défavorable, antérieure à tout raisonnement ou examen."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5613b4-1f59-4be5-93ea-25157ed71101",
                                                "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                                "text": "Les préventions instinctives qu’il avait contre le jeune comte s’augmentèrent, car il ne vit que froideur dans ses yeux distraits."
                                            },
                                            {
                                                "example_id": "f96cc601-ce7a-45b8-8b67-3618911f30d2",
                                                "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                                "text": "— Votre cœur, il me semble, n’a rien à voir dans ce que vous me dites aujourd’hui, puisque vous ne me connaissez pas. Cela ne pourrait être que si on l’avait prévenu contre moi, et alors je vous demanderais de ne pas céder à cette prévention sans m’avoir entendu."
                                            },
                                            {
                                                "example_id": "4b916b82-5823-4e34-9722-1679a1592f0c",
                                                "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                                "text": "Tel saint d’autrefois eût excité chez lui des préventions invincibles, à cause de son peu de souci de la propreté, de sa faible éducation, de son médiocre bon sens."
                                            },
                                            {
                                                "example_id": "b5b4af6d-012d-40f7-860d-d0cbbd1d74f2",
                                                "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                                "text": "Seulement, je me rends compte qu'il n'apparaissait tel que je l'ai retenu que dans l'intimité du foyer, après que le contact avait dissipé les préventions que causaient son aspect et son abord."
                                            },
                                            {
                                                "example_id": "42aededf-d654-46cc-b6f4-aa217e06607f",
                                                "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                                "text": "Mais, contrairement à son attente, Tadeus, froid, courtois, ne prêta aucune attention à Grazyna et se comporta à son égard avec déférence. Feliksa en perdit quelque peu de sa prévention."
                                            },
                                            {
                                                "example_id": "613cea75-3185-4e68-8cad-bc2092f4376d",
                                                "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                                                "text": "La Terre sainte, quelle que soit la prévention que vous inspire cette dénomination, la Terre sainte, fussiez-vous athée, s’impose à vous dans toute sa pluralité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9367add-68a0-3572-811e-80387d0e0222",
                                        "entry_id": "903fdcbd-0605-3589-af4b-76e122177c94",
                                        "glosses": [
                                            "État d’un homme prévenu de délit, de crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d4c3c9-c7fb-425a-97f3-b2d1334f3ff4",
                                                "sense_id": "b9367add-68a0-3572-811e-80387d0e0222",
                                                "text": "Le dix-septième jour de la seconde année de sa prévention, Jacques Errant fut extrait de son cachot et conduit entre deux gendarmes dans une grande salle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19177dbc-8809-3d42-9c18-4b50c199920a",
                                        "entry_id": "903fdcbd-0605-3589-af4b-76e122177c94",
                                        "glosses": [
                                            "Préventive ; détention d'un prévenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8009778a-4115-4944-a348-247a7502af9f",
                                                "sense_id": "19177dbc-8809-3d42-9c18-4b50c199920a",
                                                "text": "Faire trois mois de prévention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17f0585b-e800-4151-a3f3-c28596933df5",
                        "source_entry_id": "13d608be-79c2-3230-9703-f1cbfaae2d6b",
                        "source_sense_id": "c6b06a1e-a170-3d9f-9053-7074e552e944",
                        "target_lang_word": "protection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Action de protéger, de défendre quelqu’un, de veiller à ce qu’il ne lui arrive pas de mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc7f81e-d093-4d11-bc82-a084742a881e",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Depuis que la Gaule est privée de la protection de Rome, sa tutrice, elle est ravagée par une série d’invasions, …."
                                            },
                                            {
                                                "example_id": "41a9cdb1-cc36-4c43-b98b-b02c7c1badad",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Sous les Carolingiens, les Capitulaires recommandent au Comte de veiller à la protection des orphelins; il ne s’agit en somme que de l’exercice pratique de la mainbournie royale."
                                            },
                                            {
                                                "example_id": "334a1d9c-cf16-4595-9a31-313d8b8bb010",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Il serait bon encore d’invoquer la protection du grand thaumaturge vers qui des milliers et des milliers de pèlerins venaient de toutes les provinces, de toutes les nations."
                                            },
                                            {
                                                "example_id": "ae05c937-8411-4a69-a882-d39b684c791d",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Toute caravane qui entrait dans le territoire du sultan d’Ayar devait payer cette taxe, moyennant quoi elle était, théoriquement du moins, sous la protection du sultan jusqu’à ce qu’elle quitte le territoire placé sous son commandement."
                                            },
                                            {
                                                "example_id": "b084ce69-2bbe-405f-879c-7cd12a52ab97",
                                                "sense_id": "0a521084-20a7-31a9-9966-5293b117c6c2",
                                                "text": "Le basculement d’une posture de déni et du consentement meurtrier passif à la protection réelle des enfants et à la lutte contre l’impunité des agresseurs serait un fait historique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Action de prendre soin de la fortune, des intérêts de quelqu’un, de favoriser l’accroissement, le progrès, la défense de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2d1f7a-ffa0-4338-a38b-a52cc6fdc3d4",
                                                "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                                                "text": "La recherche de micro-polluants organiques dangereux s’inscrit dans le concept de développement durable conciliant la protection de l’environnement et le développement économique."
                                            },
                                            {
                                                "example_id": "cde0557b-44e9-4315-be08-6b519de0d626",
                                                "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                                                "text": "La protection accordée par des lois à l’industrie nationale s’oppose au système du libre-échange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Personne qui en protège, qui en favorise d’autres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d21aaaba-b386-4d25-8f5b-10ad1030f170",
                                                "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                                "text": "Cet homme a de puissantes protections."
                                            },
                                            {
                                                "example_id": "73bd3e98-9686-436d-958c-8a03cba2a854",
                                                "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                                "text": "Il compte sur ses protections."
                                            },
                                            {
                                                "example_id": "480179b6-fdb4-4bd2-b25d-4b2381d8da86",
                                                "sense_id": "a388f17e-78d3-3470-af7f-481add64af1f",
                                                "text": "Il n’a aucune protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0fd5c91-1149-3944-8854-08b979f3e364",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Objet qui assure la sécurité des biens ou des personnes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f4152a-f46e-4cd8-8adb-6fb510908d49",
                                                "sense_id": "c0fd5c91-1149-3944-8854-08b979f3e364",
                                                "text": "Cette protection mobile doit recouvrir la partie extérieure de la fraise de désilage et doit rester solidaire de la machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5b52ac-f7dd-34e0-8e67-867b6916f6e5",
                                        "entry_id": "bdc1a8cc-e79b-32a5-a6a3-96f1e1ce31b0",
                                        "glosses": [
                                            "Emploi de protecteur à la cour papale de Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f230c2-e280-47d3-ace5-0c08ecc8bc6b",
                                                "sense_id": "2b5b52ac-f7dd-34e0-8e67-867b6916f6e5",
                                                "text": "Le pape donna la protection des jacobins à tel cardinal."
                                            },
                                            {
                                                "example_id": "345316f4-b385-493f-b8fe-4fd678d24e3b",
                                                "sense_id": "2b5b52ac-f7dd-34e0-8e67-867b6916f6e5",
                                                "text": "Le roi donna la protection de France à tel cardinal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d250684-b10e-4f6e-a879-d15e9b698e09",
                        "source_entry_id": "13d608be-79c2-3230-9703-f1cbfaae2d6b",
                        "source_sense_id": "c6b06a1e-a170-3d9f-9053-7074e552e944",
                        "target_lang_word": "préservation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préservation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "feeb9ea5-5b73-3019-988f-b9db8135c269",
                                        "entry_id": "32139e37-2eb5-31d9-86c8-a7f3f836e4bf",
                                        "glosses": [
                                            "Action de préserver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48dade56-f82b-4363-a43c-13097e9998ac",
                                                "sense_id": "feeb9ea5-5b73-3019-988f-b9db8135c269",
                                                "text": "Veiller à la préservation des droits, des intérêts de quelqu’un."
                                            },
                                            {
                                                "example_id": "1665ec45-9dba-4d56-abd6-657284dd9b4c",
                                                "sense_id": "feeb9ea5-5b73-3019-988f-b9db8135c269",
                                                "text": "Conservation et préservation des races. On parle de préservation lorsqu’il s’agit de sauver des races dont les effectifs sont déjà si réduits que les processus de reproduction habituels ne peuvent pratiquement plus suffire et que des mesures spéciales s’imposent. — (Wiener Gerald, Rouvier Roger, Amélioration génétique animale, 280 p., page 231, 2009, Quae/ CTA/ Presses agronomiques de Gembloux, Agricultures en poche, présentation)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
