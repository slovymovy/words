                ],
                "senses": [
                    {
                        "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                        "entry_id": "b608c43d-e31f-3153-8382-3f66525127fd",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8323f9e-74da-458a-b601-de1950bbcb2b",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Der Lauber trägt nie die Schals, die die Lauber ihm strickt."
                            },
                            {
                                "example_id": "959e2b75-f345-4cde-a178-4e5f91e5974d",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lauber kommt, geht der Herr Lauber.“"
                            },
                            {
                                "example_id": "d2c8449a-e92e-4a09-a18d-6a289b2becfd",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Lauber kommt und geht."
                            },
                            {
                                "example_id": "428011d5-8c85-41f5-a247-6a786527698f",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Laubers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b24d7c82-a591-47ce-9bb6-d2fce0c40d50",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Frau Lauber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8fbc072d-edfa-4959-85e1-5002b713f6f4",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Herr Lauber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d5d24286-325c-4318-a40f-52b50520eb41",
                                "sense_id": "2a8b0c6f-1188-361b-acfe-aab62d13cb9f",
                                "text": "Die Laubers fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
