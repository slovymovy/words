                                        "entry_id": "3d6a38af-511d-39b3-bc18-21d1c3e7c2a2",
                                        "glosses": [
                                            "Of, from or pertaining to Bengal or the Bengalis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15300a4-077b-4e28-ba33-1da470379302",
                                                "sense_id": "4270d55d-0527-307b-88f7-f4a294316b89",
                                                "text": "Ethnologue, the web-based publication, estimates that there are around 41 languages in Bangladesh and all of them are living. However, 8 of them are in danger of extinction. These include Khiang, Murong, Bawm, Pangkhua among others. It is ironic to think that a nation that fought for the right to speak a language, the first recorded instance of this in history, is the same nation that internally follows an agenda of Bengali supremacy."
                                            }
                                        ]
                                    }
                                ]
