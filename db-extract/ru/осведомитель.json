                "senses": [
                    {
                        "sense_id": "fb2f2c88-4d17-3b5f-a9f1-a947d9ed69b2",
                        "entry_id": "df4bad06-687c-3656-9385-12c76a282402",
                        "glosses": [
                            "тот, кто осведомляет кого-либо о чём-либо, доставляет кому-либо нужные сведения"
                        ],
                        "tags": [],
