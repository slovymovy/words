                                "sense_id": "9c83fe82-7f7e-3a7b-9512-2deeddc174eb",
                                "text": "Near-synonyms: indefensible, inexcusable, unforgivable, unjustified, unpardonable, unprovoked, unreasonable, regrettable, unacceptable, unworthy, remiss, blameworthy, culpable, unwarrantable, excessive, immoderate, unconscionable, outrageous, groundless, unfounded, foundationless, baseless, unsupported, unsubstantiated, unconfirmed, uncorroborated, invalid, untenable, weak, shaky, flawed, defective"
                            },
                            {
