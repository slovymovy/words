                    {
                        "sense_id": "8d65d6c9-9c14-3f03-8272-49afba78b6a4",
                        "entry_id": "ee89713e-1a6a-38c9-9a18-9bd4eaca2b41",
                        "glosses": [
                            "durch Eindampfen von Meerwasser gewonnenes Salz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98491731-2c21-4684-ab87-e7329dbfc74e",
                                "sense_id": "8d65d6c9-9c14-3f03-8272-49afba78b6a4",
                                "text": "„Im Meersalz sind neben Natriumchlorid auch noch geringe Mengen bzw. Spuren von anderen Stoffen enthalten, unter anderem Salze von Kalium, Magnesium und Mangan.“"
                            }
