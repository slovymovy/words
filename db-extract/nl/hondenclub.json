                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fcf9b2d-f3e6-414e-9b4b-acb3a1666f57",
                                "sense_id": "397e216f-e7a2-34cd-a153-275ec440ef08",
                                "text": "Het waterschap Rijn En IJssel besloot vier jaar geleden om het riviertje De Slinge haar oude slingerende loop terug te geven. Dat had nadelige gevolgen voor hondenclub HDC Borculo, dat sinds 1953 is gevestigd op 't Galgenveld. Het opnieuw slingerende water sleet de oevers van het oefenterrein af. Toen bomen in het water begonnen te vallen, sloeg HDC alarm. Na twee jaar zijn de partijen rond ’t Galgenveld nu tot een oplossing gekomen."
                            },
                            {
                                "example_id": "54771917-bc78-4553-9817-5472aeaa299c",
                                "sense_id": "397e216f-e7a2-34cd-a153-275ec440ef08",
                                "text": "Dit jaar krijgt IJsclub Vroomshoop de beschikking over het gebouw van de hondenclub in Den Ham, die wegens gebrek aan belangstelling verdwijnt."
                            },
                            {
                                "example_id": "b9a8eda7-a292-4196-a8b5-77291f468d1c",
                                "sense_id": "397e216f-e7a2-34cd-a153-275ec440ef08",
                                "text": "Makelaarskantoor Vredegoor & Lanting uit Doetinchem biedt het eerdere verenigingsgebouw van de hondenclub met anderhalve hectare grond aan voor 275.000 euro (kosten koper). Het pand heeft een recreatieve bestemming."
                            }
                        ]
