                    "sense_definition": "Extreme force.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>violence</w> of the storm caused trees to fall across the road.",
                            "target_lang_translations": {
                                "ru": "<w>Неистовство</w> шторма повалило деревья на дорогу.",
