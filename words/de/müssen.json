    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ddc6d1cf-63ca-3406-b8f3-fbaf59c46bac",
                    "sense_definition": "verpflichtet sein oder die Notwendigkeit haben, etwas Bestimmtes zu tun",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "notwendigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>muss</w> heute Abend noch für die wichtige Prüfung lernen."
                        },
                        {
                            "text": "Alle Mitarbeiter <w>müssen</w> pünktlich zur Konferenz im Büro erscheinen."
                        }
                    ],
                    "common_phrases": [
                        "eine Entscheidung treffen müssen",
                        "Verantwortung übernehmen müssen"
                    ]
                },
                {
                    "sense_id": "577b5559-ce26-34e8-bebb-ffdd524ef7f8",
                    "sense_definition": "die Notwendigkeit haben, sich an einen bestimmten Ort zu begeben",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist schon sehr spät und ich <w>muss</w> jetzt leider nach Hause."
                        },
                        {
                            "text": "Morgen früh <w>muss</w> sie wegen ihrer Zahnschmerzen dringend zum Arzt."
                        }
                    ],
                    "common_phrases": [
                        "nach Hause müssen",
                        "zum Arzt müssen"
                    ]
                },
                {
                    "sense_id": "aab936ae-6b41-3eb9-92c8-b3194c122ede",
                    "sense_definition": "das dringende Bedürfnis verspüren, eine Toilette aufzusuchen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "beduerfnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte halte an der nächsten Raststätte kurz an, ich <w>muss</w> mal."
                        },
                        {
                            "text": "Das kleine Kind sagte seiner Mutter leise, dass es dringend <w>muss</w>."
                        }
                    ],
                    "common_phrases": [
                        "mal müssen",
                        "dringend müssen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "typischerweise mit 'mal' verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "b77a1a7c-eace-3c41-8923-e40eb67754fd",
                    "sense_definition": "eine hohe Wahrscheinlichkeit, Vermutung oder logische Schlussfolgerung ausdrücken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vermutung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Licht brennt noch im Wohnzimmer, also <w>muss</w> jemand zu Hause sein."
                        },
                        {
                            "text": "Nach dieser langen und anstrengenden Reise <w>müsst</w> ihr wirklich sehr müde sein."
                        }
                    ],
                    "common_phrases": [
                        "wahr sein müssen",
                        "richtig sein müssen"
                    ]
                }
            ]
        }
    ]
}