                "senses": [
                    {
                        "sense_id": "abcf90a3-cee6-3659-ac22-28387a11308e",
                        "entry_id": "9ff70260-6cc8-31bd-b677-e3d710b0c3ec",
                        "glosses": [
                            "fürs Erste, bis auf Weiteres"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "5617d611-0334-4e7e-89d3-a2f55a0cb319",
                                "sense_id": "abcf90a3-cee6-3659-ac22-28387a11308e",
                                "text": "„In der ersten Hälfte des Jahres 2008 gab es einen […] steilen Anstieg der Energiepreise, die mit der einsetzenden Wirtschaftskrise einstweilen wieder stark gesunken sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43fda6ed-9575-49fa-b773-9ad2b3454ae8",
                        "source_entry_id": "9ff70260-6cc8-31bd-b677-e3d710b0c3ec",
                        "source_sense_id": "abcf90a3-cee6-3659-ac22-28387a11308e",
                        "source_sense_description": "gehoben: fürs Erste, bis auf Weiteres",
                        "target_lang_word": "in the meantime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the meantime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                        "entry_id": "6f1e09ab-a9b4-36c9-a4f5-460f4faf0409",
                                        "glosses": [
                                            "meanwhile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779d4a11-3bbd-4c10-a9d3-bf2b1bc17fb7",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "But in the meantime Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            },
                                            {
                                                "example_id": "fb1ed1c2-10d1-4690-9706-2ce0b4a2907a",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "\"In the meantime,\" said Norbourne, \"we have arrived at the park-gate, and have not determined whither we shall ride.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67cf6ed2-fc1c-4f6e-8c16-08929cb938c0",
                        "source_entry_id": "9ff70260-6cc8-31bd-b677-e3d710b0c3ec",
                        "source_sense_id": "abcf90a3-cee6-3659-ac22-28387a11308e",
                        "source_sense_description": "gehoben: fürs Erste, bis auf Weiteres",
                        "target_lang_word": "tymczasem",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
