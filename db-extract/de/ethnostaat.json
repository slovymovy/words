                        "cross_references": [
                            {
                                "target_word": "ethnostate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16b7d9b3-053c-3691-ae20-9afd7895ae53",
                                        "entry_id": "c195ab5a-d646-3bb4-8a7f-436396a391a2",
                                        "glosses": [
                                            "A political unit that is populated by and run in the interest of an ethnic group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706e7258-a54a-45d5-ba76-90cea96820a7",
                                                "sense_id": "16b7d9b3-053c-3691-ae20-9afd7895ae53",
                                                "text": "Richard Spencer and others fantasize about a white ethno-state — this is the Northwest Territorial Imperative, or Northwest Imperative, that would stretch from Montana to Oregon and Washington State."
                                            },
                                            {
                                                "example_id": "9f9c2bdc-add4-4f08-94d9-51d5b4d04b7f",
                                                "sense_id": "16b7d9b3-053c-3691-ae20-9afd7895ae53",
                                                "text": "In an email to CNN, Gariépy denied a CBC news article’s characterization of him as supporting “ideas of white superiority and white ‘ethnostates,’” saying, “no proper context was provided by the journalist to understand the circumstances in which I discussed these subjects in the past.”"
                                            },
                                            {
                                                "example_id": "eeb48203-3619-44cb-9b8d-f685f0cc8c60",
                                                "sense_id": "16b7d9b3-053c-3691-ae20-9afd7895ae53",
                                                "text": "“Typically, the ultimate goal of groups like ‘Hate Club’ is to turn America into a white ethnostate where white men are in power,” Segal told CNN via email “They consider themselves as both the last remaining bulwark against enemies of the white race and the only path to a white ethnostate.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
