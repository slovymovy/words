                "senses": [
                    {
                        "sense_id": "e44aa2d2-ae9e-337c-9ed6-029a51060ab0",
                        "entry_id": "7d3ccfac-49db-3e3c-8ed3-31dff3be7bd1",
                        "glosses": [
                            "Kurzbezeichnung der Freien Demokratischen Partei der BRD bis 1968 und seit 2001, dazwischen F.D.P."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407e84f2-1eff-4937-a0a4-3bd6ce6f6c9b",
                                "sense_id": "e44aa2d2-ae9e-337c-9ed6-029a51060ab0",
                                "text": "Die FDP wurde am 11. Dezember 1948 in Heppenheim gegründet."
                            },
                            {
                                "example_id": "b1c35d8b-b4ea-4534-9644-ed8b6b513991",
                                "sense_id": "e44aa2d2-ae9e-337c-9ed6-029a51060ab0",
                                "text": "„Bis dahin hatte ich kein Parteiamt in der FDP gehabt.“"
                            },
                            {
                                "example_id": "c015bf32-e743-4913-af7f-81b46824078f",
                                "sense_id": "e44aa2d2-ae9e-337c-9ed6-029a51060ab0",
                                "text": "„Mit den Stimmen der FDP wurde er im Oktober 1969 zum Kanzler gewählt.“"
                            },
                            {
                                "example_id": "f058e6d9-995d-4d8a-ba5d-8abceb355d2d",
                                "sense_id": "e44aa2d2-ae9e-337c-9ed6-029a51060ab0",
                                "text": "„Dass sich die FDP ausdrücklich als „Partei der Besserverdienenden“ verstand, ist zwar lange her. Doch eindeutig Schlechterverdienende wie Pflegekräfte zählen noch immer nicht zu ihrer Kernwählerschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da8d0e95-f5aa-38db-b259-096a36817475",
