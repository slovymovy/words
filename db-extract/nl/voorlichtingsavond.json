                        "sense_id": "5bb2fd80-a801-372d-bc3d-ed466760df14",
                        "entry_id": "aca198af-4f14-32b5-ab10-a625397f623a",
                        "glosses": [
                            "bijeenkomst in de avonduren waarin mensen over een bepaalde kwestie worden geïnformeerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3524c33f-1ac6-4317-8fda-d715ca1a799e",
                                "sense_id": "5bb2fd80-a801-372d-bc3d-ed466760df14",
                                "text": "Trekt de pijn naar je rug?'probeerde hij nog. (Die vraag meende hij zich te herinneren van een voorlichtingsavond met videofilms en een hoogzwangere vroedvrouw, die halverwege haar exposé moest worden afgelost door een collega.) Zwanet aarzelde."
                            },
                            {
                                "example_id": "f75073ec-553a-4819-b1f5-9fd7947b2870",
                                "sense_id": "5bb2fd80-a801-372d-bc3d-ed466760df14",
                                "text": "De verdachte, een 27-jarige man, heeft zijn daad bekend, zei het OM op de voorlichtingsavond. Hij was vijf jaar in dienst bij Partou. De meisjes, twee zusjes, moesten seksuele handelingen bij hem verrichten. Ze vertelden dat aan hun ouders, die aangifte tegen de man deden."
                            }
                        ]
                    }
