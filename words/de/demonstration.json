                    "frequency": "High",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tausende Menschen nahmen an der friedlichen <w>Demonstration</w> gegen die geplante Autobahn teil."
                        },
                        {
                            "text": "Die Polizei sicherte die Straßen während der großen <w>Demonstration</w> in der Innenstadt ab."
                        }
                    ],
                    "synonyms": [
                        "Demo",
                        "Kundgebung"
                    ],
                    "common_phrases": [
