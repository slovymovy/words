                "senses": [
                    {
                        "sense_id": "7761bfd8-e693-39bb-a00c-ad38b9488d0c",
                        "entry_id": "b5bb71e1-1c7a-3c9e-bf14-231140228275",
                        "glosses": [
                            "Allée, généralement bordée de sphinx, prolongeant, vers l'extérieur, l'axe d'un temple pour le relier à un autre édifice ou à un embarcadère du Nil."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "24d1c368-6da3-427a-bf29-65381114b104",
                                "sense_id": "7761bfd8-e693-39bb-a00c-ad38b9488d0c",
                                "text": "Une longue colonnade irrégulière s'allonge ensuite et forme le dromos en avant des premiers pylônes."
                            },
                            {
                                "example_id": "8f5242dc-90d3-48a8-a9ed-9e4660a62db7",
                                "sense_id": "7761bfd8-e693-39bb-a00c-ad38b9488d0c",
                                "text": "Suivant la description du sérapéum par Strabon, Mariette va repérer dans le désert l’allée des sphinx à tête humaine, ou dromos. Le complexe lui-même, avec temple, enceinte, chapelles et tombeaux souterrains, a disparu, enfoui sous les sables."
                            },
                            {
                                "example_id": "87573f7c-1aaf-4f90-82f0-d56051c8eb64",
                                "sense_id": "7761bfd8-e693-39bb-a00c-ad38b9488d0c",
                                "text": "Le dromos du temple de Louxor."
                            }
                        ]
                    },
                    {
                        "sense_id": "5564cf86-abc8-345f-9ca2-4ba5db8b13f4",
                        "entry_id": "b5bb71e1-1c7a-3c9e-bf14-231140228275",
                        "glosses": [
                            "Passage, couloir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "064567d0-a6ee-4d4a-b7c2-f7bab566a2b5",
                                "sense_id": "5564cf86-abc8-345f-9ca2-4ba5db8b13f4",
                                "text": "En fouillant les dromoi, nous trouvons de nombreux tessons et un certain nombre de vases intacts, souvent placés près de l'entrée."
                            }
                        ]
                    }
