                "senses": [
                    {
                        "sense_id": "4a3358f3-9045-31a9-89cf-ac4d9775af9c",
                        "entry_id": "dc16a4fb-8017-3cc2-963e-534556476265",
                        "glosses": [
                            "Staat in Westafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d8aff40-7723-43af-acd1-a5006388bbac",
                                "sense_id": "4a3358f3-9045-31a9-89cf-ac4d9775af9c",
                                "text": "Er sagt, er komme aus Ghana."
                            },
                            {
                                "example_id": "61939106-cbfb-4faa-a52f-5946ed2b8b1b",
                                "sense_id": "4a3358f3-9045-31a9-89cf-ac4d9775af9c",
                                "text": "Accra ist die Hauptstadt von Ghana."
                            },
                            {
                                "example_id": "e354e26d-f5b5-473d-ba12-58e151b3b30a",
                                "sense_id": "4a3358f3-9045-31a9-89cf-ac4d9775af9c",
                                "text": "„Wirtschaftlich bedeutend ist Ghana aufgrund seines Rohstoffreichtums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65f5b193-154c-43d7-9a89-4921773d411e",
                        "source_entry_id": "dc16a4fb-8017-3cc2-963e-534556476265",
                        "source_sense_id": "4a3358f3-9045-31a9-89cf-ac4d9775af9c",
