                                                "example_id": "9a733236-c720-436b-b230-780efb11d027",
                                                "sense_id": "f30e08a8-c390-31f6-8095-f2f63e60a55e",
                                                "text": "On ne trouve rien qui marque dans cet ouvrage."
                                            }
