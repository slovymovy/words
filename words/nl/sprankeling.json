{
    "word_family": [
        "sprankelen",
        "sprankelend"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9305abfa-260b-326c-9f6a-62d0d6b5bdc4",
                    "sense_definition": "Een schittering of twinkeling van licht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was een mooie <w>sprankeling</w> in haar ogen te zien toen ze lachte.",
                            "target_lang_translations": {
                                "en": "There was a beautiful <w>sparkle</w> to be seen in her eyes when she laughed."
                            }
                        },
                        {
                            "text": "De <w>sprankeling</w> van het zonlicht op het wateroppervlak was prachtig.",
                            "target_lang_translations": {
                                "en": "The <w>sparkle</w> of the sunlight on the water's surface was beautiful."
                            }
                        }
                    ],
                    "synonyms": [
                        "schittering",
                        "fonkeling",
                        "flikkering",
                        "glans",
                        "twinkeling"
                    ],
                    "common_phrases": [
                        "sprankeling in de ogen"
                    ],
                    "target_lang_definitions": {
                        "en": "A shining or twinkling of light."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sparkle",
                                "target_lang_sense_clarification": "shining or twinkling light"
                            },
                            {
                                "target_lang_word": "twinkle",
                                "target_lang_sense_clarification": "intermittent shining light, especially in the eyes"
                            },
                            {
                                "target_lang_word": "glimmer",
                                "target_lang_sense_clarification": "faint, wavering light"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c365c8a6-eb88-38f5-b782-71d92dc6c91f",
                    "sense_definition": "Een levendige of enthousiaste uitstraling; levendigheid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn spel miste vanavond de gebruikelijke <w>sprankeling</w> en creativiteit.",
                            "target_lang_translations": {
                                "en": "His play lacked the usual <w>sparkle</w> and creativity tonight."
                            }
                        },
                        {
                            "text": "Met haar enthousiasme bracht ze weer wat <w>sprankeling</w> in de saaie vergadering.",
                            "target_lang_translations": {
                                "en": "With her enthusiasm, she brought some <w>spark</w> back into the boring meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "opleving",
                        "levendigheid"
                    ],
                    "common_phrases": [
                        "sprankeling in het spel"
                    ],
                    "target_lang_definitions": {
                        "en": "A lively or enthusiastic appearance; liveliness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sparkle",
                                "target_lang_sense_clarification": "liveliness, wit, or vivacity in personality or performance"
                            },
                            {
                                "target_lang_word": "spark",
                                "target_lang_sense_clarification": "a quality of energy, enthusiasm, or liveliness"
                            },
                            {
                                "target_lang_word": "vivacity",
                                "target_lang_sense_clarification": "the quality of being attractively lively and animated"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}