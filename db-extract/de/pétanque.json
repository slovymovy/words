                        "translation_id": "0e1b149e-6c5b-4da2-b4ab-4c737d3addfc",
                        "source_entry_id": "971a08fa-441f-3800-84b1-df3515cef93b",
                        "source_sense_id": "0a86d390-595c-35f2-b957-9a67aabf47ec",
                        "source_sense_description": "Sport, Spiel: ein originär südfranzösisches Zielspiel mit Stahlkugeln auf Naturboden",
                        "target_lang_word": "pétanque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
