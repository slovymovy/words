                "senses": [
                    {
                        "sense_id": "a9853593-9a2d-3b50-9a3e-4c4d0c1c3195",
                        "entry_id": "1f70155b-2329-3bcc-908a-98bedb154716",
                        "glosses": [
                            "Bavarder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e66b67-6639-4409-83f7-416cdc313aaf",
                                "sense_id": "a9853593-9a2d-3b50-9a3e-4c4d0c1c3195",
                                "text": "Ce qui est très-convenable, c’est de faire la grue… Moi, je ne sais pas… Et puis de rester à bavardichonner avec les personnes de son sexe…"
                            },
                            {
                                "example_id": "cfdfc3c6-3597-4802-8008-b4965a49eb6b",
                                "sense_id": "a9853593-9a2d-3b50-9a3e-4c4d0c1c3195",
                                "text": "Renée pourtant a eu plus de chemin à faire pour parler la langue qu’elle « bavardichonne », étant ce qu’elle est, que Suzette pour parler le langage d’une femme de cœur et de sens, étant sortie de son village."
                            }
                        ]
                    }
