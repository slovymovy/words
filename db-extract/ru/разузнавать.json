                "senses": [
                    {
                        "sense_id": "9ede7ae2-df80-3722-ba26-b2cf2752c373",
                        "entry_id": "aab8fb34-ac0d-3c36-b61e-34328328527c",
                        "glosses": [
                            "собирать, получать сведения, известия о ком-либо, чём-либо, узнавать, выведывать в подробностях"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "902bf22e-8c64-4bb0-bed9-086f36945202",
                        "source_entry_id": "aab8fb34-ac0d-3c36-b61e-34328328527c",
                        "source_sense_id": "9ede7ae2-df80-3722-ba26-b2cf2752c373",
                        "target_lang_word": "find out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "find out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover, as by asking or investigating."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d41972-c2be-429a-8700-fb5fbc415413",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I don't know who the twenty-first president of the United States was, but it should be very easy to find out."
                                            },
                                            {
                                                "example_id": "17479836-6c47-456a-882d-d626c2402730",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "\"Why shouldn't somethin' new and wonderful lie in such a country? And why shouldn't we be the men to find it out?\""
                                            },
                                            {
                                                "example_id": "2698d7f2-9c46-4811-99a8-452e180fa116",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "Somethin' happens when everybody finds out\nSee the vultures circling, dark clouds"
                                            },
                                            {
                                                "example_id": "b5779327-7631-4b2d-8526-b5842c554fbe",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover or expose (someone) as disobedient, dishonest, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168f191d-6882-4262-a319-40a2b21fd1cf",
                                                "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                                "text": "He had been fiddling the books for years, but finally he was found out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To uncover a weakness in (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7a0f06-075b-446e-90ad-f31d91d112dd",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "He may cope with the multiple choice questions, but the written exam will find him out."
                                            },
                                            {
                                                "example_id": "7f7cf588-e8e4-4a32-8946-dad5dd8b0b78",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "If you don't try, you do not find it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810bfa98-4168-3a61-9601-b446cfb557a3",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover (something), as by perceiving or coming upon it."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To receive the consequences of one's actions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf557d0e-8915-420a-a72e-49f603f56375",
                                                "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                                "text": "With the way he behaved, it's no wonder he found out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfdf4499-69b6-41b7-a483-7d7352fa474d",
                        "source_entry_id": "aab8fb34-ac0d-3c36-b61e-34328328527c",
                        "source_sense_id": "9ede7ae2-df80-3722-ba26-b2cf2752c373",
                        "target_lang_word": "mouse out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7f1026c3-f8be-41b5-b87f-b59842a81841",
                        "source_entry_id": "aab8fb34-ac0d-3c36-b61e-34328328527c",
                        "source_sense_id": "9ede7ae2-df80-3722-ba26-b2cf2752c373",
                        "target_lang_word": "herausfinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herausfinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae18e8e-0400-37e2-aea7-00ef45315571",
                                        "entry_id": "57da26b0-8021-3fbb-8e68-4a023f12eab5",
                                        "glosses": [
                                            "etwas (durch Nachdenken/Forschen) entdecken, etwas in Erfahrung bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e52ed22-52a2-42e7-b2a2-043fbc9a361c",
                                                "sense_id": "2ae18e8e-0400-37e2-aea7-00ef45315571",
                                                "text": "Ich habe herausgefunden, dass mein Freund mich betrügt."
                                            },
                                            {
                                                "example_id": "4c0bc719-44a7-4df8-920b-c85d8e5a9edb",
                                                "sense_id": "2ae18e8e-0400-37e2-aea7-00ef45315571",
                                                "text": "Welche Ursache Morbus Alzheimer hat, müssen die Forscher noch herausfinden."
                                            },
                                            {
                                                "example_id": "645bfb56-cd73-45a0-a325-6255b0e0a901",
                                                "sense_id": "2ae18e8e-0400-37e2-aea7-00ef45315571",
                                                "text": "Im Alter von zwei Jahren fand sie heraus, dass man sich an Kerzen die Finger verbrennen kann."
                                            },
                                            {
                                                "example_id": "c9319027-f9d4-4bf7-ac2d-9b50545a9961",
                                                "sense_id": "2ae18e8e-0400-37e2-aea7-00ef45315571",
                                                "text": "Um seine Adresse herauszufinden musst du nur im Telefonbuch nachgucken."
                                            },
                                            {
                                                "example_id": "decdcb7f-7c6f-4823-aaab-05b79be4746e",
                                                "sense_id": "2ae18e8e-0400-37e2-aea7-00ef45315571",
                                                "text": "„Herausgefunden hat das Team vom Earth Observation Center (EOC) des DLR jetzt, dass vom Waldverlust überwiegend die Mitte Deutschlands und dort vor allem die Nadelwälder betroffen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d803269-e8a4-3300-8e07-0151edc18c49",
                                        "entry_id": "57da26b0-8021-3fbb-8e68-4a023f12eab5",
                                        "glosses": [
                                            "in einer größeren Menge etwas/jemanden entdecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d3a0ce-d5e2-4de7-91e1-088ccefa4c85",
                                                "sense_id": "0d803269-e8a4-3300-8e07-0151edc18c49",
                                                "text": "„Die Polizei muss also die verschiedensten Aussagen deuten und aus den zum Teil widersprüchlichen Beschreibungen diejenigen herausfinden, die übereinstimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a569d0c4-bdcf-3a44-a2f0-a4b1e830bd61",
                                        "entry_id": "57da26b0-8021-3fbb-8e68-4a023f12eab5",
                                        "glosses": [
                                            "einen Weg aus etwas entdecken/finden (beispielsweise aus einem Labyrinth, einem unbekannten Haus), den Ausgang von etwas finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3d7d26-d8c5-490a-841b-c286166dc72d",
                                                "sense_id": "a569d0c4-bdcf-3a44-a2f0-a4b1e830bd61",
                                                "text": "Hänsel und Gretel konnten den Weg nicht aus dem Wald herausfinden."
                                            },
                                            {
                                                "example_id": "601277ff-651c-421e-865a-6d8bcfc58ee8",
                                                "sense_id": "a569d0c4-bdcf-3a44-a2f0-a4b1e830bd61",
                                                "text": "Aus einem großen Labyrinth kann es schwierig sein, den Weg herauszufinden."
                                            },
                                            {
                                                "example_id": "4b97df2d-a956-4026-9e82-87e6afbc068e",
                                                "sense_id": "a569d0c4-bdcf-3a44-a2f0-a4b1e830bd61",
                                                "text": "„Bleib sitzen, ich finde den Weg allein heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80fcde74-5a1d-482f-bdb1-e45933d6d3cc",
                        "source_entry_id": "aab8fb34-ac0d-3c36-b61e-34328328527c",
                        "source_sense_id": "9ede7ae2-df80-3722-ba26-b2cf2752c373",
                        "target_lang_word": "rausfinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rausfinden",
