                },
                {
                    "sense_id": "7bf51f61-3037-34bf-a1a7-dba0827daf5c",
                    "sense_definition": "Moyen d'attraction ou de tentation employé pour séduire, tromper ou inciter quelqu'un à agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attraction_tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup d'investisseurs imprudents se sont laissé séduire par l'<w>appât</w> du gain rapide."
                        },
                        {
                            "text": "Cette fausse offre promotionnelle n'était en réalité qu'un <w>appât</w> pour recueillir des données."
                        }
                    ],
                    "synonyms": [
                        "leurre",
                        "piège"
                    ],
                    "common_phrases": [
