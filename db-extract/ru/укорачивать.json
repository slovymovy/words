                "translations": [
                    {
                        "translation_id": "f511fc4c-0d4a-4f96-89d6-8b3387c667cc",
                        "source_entry_id": "4d036502-5c5b-30c8-99c7-21b199abe9f5",
                        "target_lang_word": "accourcir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accourcir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdfad64b-af23-3cda-b815-d648e2e507cd",
                                        "entry_id": "9571ceb1-6946-3156-ab31-c68eb022b9bf",
                                        "glosses": [
                                            "ou Rendre plus court."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cea75c6-38a9-4a89-b557-eb4ded1ba961",
                                                "sense_id": "cdfad64b-af23-3cda-b815-d648e2e507cd",
                                                "text": "Une des plus difficiles entreprises du fondateur fut d’accourcir les robes & de faire raser les barbes de son peuple."
                                            },
                                            {
                                                "example_id": "c296da90-f0cb-414e-84ef-897c4fd727aa",
                                                "sense_id": "cdfad64b-af23-3cda-b815-d648e2e507cd",
                                                "text": "Ce n’est pas le tout de chaudronner : il faut vendre ! affirme monsieur Valat sûr de son fait, de son geste, de sa doloire dont, fermant un œil, il vérifie le tranchant avant d’en accourcir le cercle d’un tonneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1369474-6937-3a21-9108-7461004b9c3b",
                                        "entry_id": "9571ceb1-6946-3156-ab31-c68eb022b9bf",
                                        "glosses": [
                                            "ou Prendre une route de traverse qui rende plus court le chemin habituel."
                                        ],
                                        "tags": [
                                            "especially",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c91e3ca8-848f-4064-a446-7594fee13e7b",
                                                "sense_id": "b1369474-6937-3a21-9108-7461004b9c3b",
                                                "text": "C’est avec le secours de cette Méthode, que le capitaine Marchand, assuré, autant qu’il est possible de l’être, de la véritable position du Vaisseau , pouvoit, par des routes directes , accourcir ses Traversées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c8a894-2496-33c1-ab43-c5f790483650",
                                        "entry_id": "9571ceb1-6946-3156-ab31-c68eb022b9bf",
                                        "glosses": [
                                            "Devenir plus court."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcaf1d5f-7ef9-4d40-b34c-3f9918b1d206",
                                                "sense_id": "72c8a894-2496-33c1-ab43-c5f790483650",
                                                "text": "L’ombre des vieux platanes qui bordaient la route s’accourcissait de plus en plus."
                                            },
                                            {
                                                "example_id": "e44c9805-16df-4fc3-86d6-daf7f19beb81",
                                                "sense_id": "72c8a894-2496-33c1-ab43-c5f790483650",
                                                "text": "Les cadeaux récompensèrent l’annonce du marché et l’on prit des friandises dans le grand salon, en attendant la nuit qui d’année en année s’accourcissait et devenait le temps de la sagesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
