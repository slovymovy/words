                                        "sense_id": "4ea148b1-ea74-3fe5-aa4c-e347093887e8",
                                        "entry_id": "738127f6-77bd-34f5-8649-905338f861d8",
                                        "glosses": [
                                            "A male given name transferred from the surname."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7cfb0da-ad4d-42a9-a718-6df2efe6f5cf",
                                                "sense_id": "4ea148b1-ea74-3fe5-aa4c-e347093887e8",
                                                "text": "It was not easy growing up with a first name like Alvis. Every year on the first day of school when the teacher would read off her seating chart, Alvis, all the snotty little kids in my class would laugh."
                                            }
                                        ]
