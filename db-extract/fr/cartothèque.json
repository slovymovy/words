                "senses": [
                    {
                        "sense_id": "f156a26e-ddd0-3df9-91cb-471554a8ed21",
                        "entry_id": "edd230b1-9098-3373-be7e-6c062bf77e35",
                        "glosses": [
                            "Unité chargée de collecter, de référencer, de classer et de conserver les documents cartographiques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9dc44917-4e5f-36b2-afe2-cf3d552e9197",
                        "entry_id": "edd230b1-9098-3373-be7e-6c062bf77e35",
                        "glosses": [
                            "Lieu où sont conservées des cartes géographiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf66862-c359-4b86-bc93-7a6eeba1b3c9",
                                "sense_id": "9dc44917-4e5f-36b2-afe2-cf3d552e9197",
                                "text": "Les cartes de France mais aussi de certaines de ses anciennes colonies sont conservées et peuvent être consultées à la cartothèque de l’IGN à Saint-Mandé."
                            },
                            {
                                "example_id": "a64d6547-b325-44c7-8a92-ff1b70c2bc26",
                                "sense_id": "9dc44917-4e5f-36b2-afe2-cf3d552e9197",
                                "text": "Leur versement à la cartothèque de l’Institut géographique National, où ils ont été diligemment répertoriés par l’actif M. Mirguet, les rend désormais très accessibles au public."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fda2c958-20c8-41fa-a974-81fca9fcea01",
                        "source_entry_id": "edd230b1-9098-3373-be7e-6c062bf77e35",
                        "source_sense_description": "lieu de conservation des cartes",
                        "target_lang_word": "Karteikarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karteikarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5734c145-d9d6-385b-b5eb-6a395c10373c",
                                        "entry_id": "1dd1dd64-6aac-3fb8-bf63-b9692448c299",
                                        "glosses": [
                                            "einzelnes Element einer Kartei; Karte, auf der Daten zu einer Person oder einem Objekt nach einem festgelegten Schema eingetragen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d6c2ef-0ba3-48bf-b8d9-05a2a56b883d",
                                                "sense_id": "5734c145-d9d6-385b-b5eb-6a395c10373c",
                                                "text": "„Trotz des geringen Angebots lohnt es sich für Schüler dennoch, in der Jobvermittlung eine Karteikarte auszufüllen: Einmal registriert, kann man sich immer wieder nach einer Arbeit erkundigen.“"
                                            },
                                            {
                                                "example_id": "0fc4545e-9cc6-4250-b0cf-df8d385e0e4f",
                                                "sense_id": "5734c145-d9d6-385b-b5eb-6a395c10373c",
                                                "text": "„Er wurde sehr respektvoll behandelt und bekam einen Karton mit Einwohnermeldekarten sowie einen Stoß gelber Karteikarten, auf die er Adressen zu schreiben hatte.“"
                                            },
                                            {
                                                "example_id": "db77484c-954c-463c-850e-46ef9e5a9bf8",
                                                "sense_id": "5734c145-d9d6-385b-b5eb-6a395c10373c",
                                                "text": "„Ich stellte mir den jungen Benjamin vor, wie er jedes einzelne Buch und jede einzelne Karteikarte gewissenhaft mit seinem Namen versah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
