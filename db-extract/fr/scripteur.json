                "senses": [
                    {
                        "sense_id": "217d907a-2792-39b1-9858-f49680b0bb0d",
                        "entry_id": "edb389e2-cf2c-37bf-a5c2-ef48575c3ed8",
                        "glosses": [
                            "Secrétaire apostolique chargé de l'écriture des bulles papales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e32290-1aa8-4120-80f3-8961f41e5808",
                                "sense_id": "217d907a-2792-39b1-9858-f49680b0bb0d",
                                "text": "Scripteur à la chancellerie apostolique."
                            }
                        ]
                    },
                    {
                        "sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
                        "entry_id": "edb389e2-cf2c-37bf-a5c2-ef48575c3ed8",
                        "glosses": [
                            "Celui qui écrit, sans pour autant être écrivain."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "a41a9bf1-915d-4f7f-bf46-5de4dbdf16f8",
                                "sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
                                "text": "La graphologie étudie la personnalité du scripteur."
                            },
                            {
                                "example_id": "7b7f4ac3-ae48-4f55-831b-c5ca734b9a1c",
                                "sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
                                "text": "Chaque enfant doit pouvoir avoir accès à un environnement de jeu symbolique riche et stimulant qui a du sens à travers lequel il sera tantôt lecteur, tantôt scripteur, donc qui lui donne le goût de la lecture et de l’écriture."
                            },
                            {
                                "example_id": "4debd2b7-17b0-41c8-b898-97b91850e9a6",
                                "sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
                                "text": "Le texte est un espace à dimensions multiples, produit par un scripteur dont le psychisme, les intentions ou la condition sociale peuvent importer bien sûr."
                            },
                            {
                                "example_id": "054935c0-4e1f-4201-b3c4-4773853e795c",
                                "sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
                                "text": "Or, savoir écrire une lettre à sa grand-mère ne fait pas du scripteur un auteur digne de ce nom."
                            },
                            {
                                "example_id": "2a675416-81f6-4512-bccd-9a2c210f37d7",
                                "sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
                                "text": "Professeurs en CP et en CE1 : deux guides pour enseigner la lecture et l'écriture\nEnseigner la lecture et l'écriture au CP\n— Comment devient-on lecteur et scripteur ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "49610b82-14ad-3485-9e33-d4a177350c6c",
                        "entry_id": "edb389e2-cf2c-37bf-a5c2-ef48575c3ed8",
                        "glosses": [
                            "Parolier, scénariste, celui ou celle qui écrit des textes audiovisuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53dee2da-3fb8-4386-9651-3741fc32842d",
                                "sense_id": "49610b82-14ad-3485-9e33-d4a177350c6c",
                                "text": "[Jovette Bernier] commence à la mi 1950, une carrière de scripteur à la télévision. Quelques mois après l'apparition de Quelles nouvelles, elle devient co-scripteur de La Rumba des radio-romans avec Henri Deyglun, Claude-Henri Grignon, Paul Gury et Jean Desprez."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30b69326-f8cb-44bf-996f-bea32c3fae5c",
                        "source_entry_id": "edb389e2-cf2c-37bf-a5c2-ef48575c3ed8",
                        "source_sense_id": "2067fd6b-b865-3ed8-b63f-a4e0d51ed00b",
