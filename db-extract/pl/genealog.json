                                "target_senses": [
                                    {
                                        "sense_id": "c9cabbd0-0aa6-3851-9d2c-61f66a752e99",
                                        "entry_id": "e318df42-2f24-386a-8c97-73a1c2d02285",
                                        "glosses": [
                                            "A person who studies or practises genealogy; an expert in genealogy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6bb909-0e6f-44fa-8553-b92532f0a6f6",
                                                "sense_id": "c9cabbd0-0aa6-3851-9d2c-61f66a752e99",
                                                "text": "You may not find Dr. Neil Rosenstein’s new book listed on national best-seller lists, but the noted genealogist — with his tongue halfway in his cheek — compares it to the popular thriller “The Da Vinci Code.” Both books, the noted American genealogist and surgeon said, deal in varying degrees with family trees reaching back 30 centuries to the biblical House of David."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb36842-dcd0-4c5f-a193-bcac0cd63053",
                        "source_entry_id": "501ae5d3-1d3e-37db-9984-f4ffd71c33dd",
                        "source_sense_id": "d0964d9e-8a5d-3766-bc98-d6fdfa6a88d6",
                        "target_lang_word": "généalogiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "généalogiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c112777d-8866-3659-b1f0-a2a74f221c4f",
                                        "entry_id": "34a7235e-beee-3a7e-bd2a-bf804441677a",
                                        "glosses": [
                                            "Celui ou celle qui dresse les généalogies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1096bff-38e5-4cd4-9e20-122a97b0d2cb",
                                                "sense_id": "c112777d-8866-3659-b1f0-a2a74f221c4f",
                                                "text": "« Il y a une dimension associative forte chez les généalogistes qui sont majoritairement des seniors ou des retraités », souligne Danielle Musset, ethnologue et conservatrice de l'écomusée de Salagon (Alpes-de-Haute-Provence)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8176fdd-f150-4f25-9ba6-783e1e91a205",
                        "source_entry_id": "501ae5d3-1d3e-37db-9984-f4ffd71c33dd",
                        "source_sense_id": "d0964d9e-8a5d-3766-bc98-d6fdfa6a88d6",
