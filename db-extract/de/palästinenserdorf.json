                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c10d5d-fc4c-4b4a-bca0-d6c44414740c",
                                "sense_id": "c8ccf22a-6577-34c3-bfc5-261272200326",
                                "text": "„Ali wohnt in Chadar, einem Palästinenserdorf fünf Kilometer entfernt, mit seiner Frau und fünf ihrer sieben Kinder.“"
                            },
                            {
                                "example_id": "c43d293a-3a97-4b33-931e-324274fba36e",
                                "sense_id": "c8ccf22a-6577-34c3-bfc5-261272200326",
                                "text": "„Seit 2000 Jahren bewässern Kanäle die Terrassen von Battir. Aber wenn Israel dort seine Sperranlage wie geplant ausbauen würde, wäre das Palästinenserdorf von seinen Gärten und Terrassen abgeschnitten.“"
                            },
                            {
                                "example_id": "eede2a04-b982-4571-b29f-d9f274669a0a",
                                "sense_id": "c8ccf22a-6577-34c3-bfc5-261272200326",
                                "text": "„Israelische Panzer und Armeebulldozer sind am Montagabend in das autonome Palästinenserdorf El Karara im Zentrum des Gazastreifens eingerückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
