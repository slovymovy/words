                                "sense_id": "3c64e0e8-359f-3bcb-b506-0746c95ed99e",
                                "text": "We will be renting bikes hor.",
                                "translation": "If you weren’t aware—we’ll be renting bikes.",
                                "english": "If you weren’t aware—we’ll be renting bikes."
                            },
                            {
