                                    {
                                        "sense_id": "15424e32-b05b-3c60-acd4-c23a93b882fd",
                                        "entry_id": "6ab027b1-af63-3870-a649-54e0d702aeed",
                                        "glosses": [
                                            "A poisoning, as by a spirituous or a narcotic substance."
                                        ],
