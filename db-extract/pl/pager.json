                        "entry_id": "4a70bd7e-b25d-3b0d-b59a-83da328db346",
                        "glosses": [
                            "elektroniczne urządzenie używane do komunikowania się poprzez krótkie informacje odczytywane z wyświetlacza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a174fb67-9a21-4b3c-951e-bf05e8185aee",
                                "sense_id": "2c3f382b-15df-3ecb-94e8-e7cc91fe78d8",
