                        "glosses": [
                            "Proposer aux chalands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ceb17bb-da0b-4840-8913-0db9334828bf",
                                "sense_id": "a8205e37-b4d6-3676-a8e7-da39e649ace3",
                                "text": "Dans un forum nous ne sommes pas au stade de la mise sous emballage de la pensée pour la chalandiser sur le marché des idéologies militantes, nous sommes au contraire dans un processus libre d'auto-construction active de nos connaissances, de nos expériences et de nos opinions."
                            },
                            {
                                "example_id": "c88b659f-327c-41c0-820a-ef5ca8290709",
                                "sense_id": "a8205e37-b4d6-3676-a8e7-da39e649ace3",
                                "text": "Si une zone de « chalandisation » est un espace d'attraction commercial et de déambulation, alors le travail social se chalandise ; prélude à sa privatisation."
                            }
                        ]
                    }
