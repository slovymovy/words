                "senses": [
                    {
                        "sense_id": "a481d504-fa79-30c3-9e45-460d031ffb48",
                        "entry_id": "58cbf65f-60c4-36cf-9030-74d0f8d1f6de",
                        "glosses": [
                            "Fotografie, auf der eine Landschaft abgebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b113302f-9a27-4901-8404-38bd96add2fe",
                                "sense_id": "a481d504-fa79-30c3-9e45-460d031ffb48",
                                "text": "Es handelt sich bei Herrn Winter um einen landesweit für seine stimmungsvollen Landschaftsaufnahmen bekannten Fotografen."
                            },
                            {
                                "example_id": "5b8cae48-3ebb-4b7e-aca2-d568298e6778",
                                "sense_id": "a481d504-fa79-30c3-9e45-460d031ffb48",
                                "text": "Wenn Frau Winkelmann zu Bett geht, erfreut sie sich allabendlich an einer über ihrem Bett aufgehängten Landschaftsaufnahme aus ihrer Heimat, der Uckermark."
                            },
                            {
                                "example_id": "d6c9ed10-b2f0-4e43-9a67-3ebe3bf80d99",
                                "sense_id": "a481d504-fa79-30c3-9e45-460d031ffb48",
                                "text": "In der Gegend um Stralsund hat Frau Müller seit 1991 von fünf Standorten aus über vierhundert Landschaftsaufnahmen gemacht und über die Jahre einige Veränderungen dokumentiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
