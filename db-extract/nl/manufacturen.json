                    {
                        "sense_id": "939ca69a-1abc-334c-a148-4199ba22b0d6",
                        "entry_id": "0e8f29ff-b03f-38ff-b633-774b422832cf",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord manufactuur"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "01feb05f-9ba7-421e-bae6-97a499cefb5b",
                                "sense_id": "939ca69a-1abc-334c-a148-4199ba22b0d6",
                                "text": "De textielfabricage hoort net als bijvoorbeeld het bier brouwen en leer looien tot de ambachten die sinds mensenheugenis niet door één mens alleen konden worden bedreven. Er waren grotere werkplaatsen, manufacturen, voor nodig."
                            },
                            {
                                "example_id": "042a9556-9ead-45a6-ac32-c0e2248e5542",
                                "sense_id": "939ca69a-1abc-334c-a148-4199ba22b0d6",
                                "text": "Tussen deze abstracte beschouwingen door doet Marx uitvoerig uit de doeken hoe fabrieken ontstonden uit de manufacturen en hoe boeren in de loop der eeuwen hun grond kwijtraakten en niets meer hadden dan hun arbeidskracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "91594fdc-da0d-3627-a279-a8eba76d3f95",
                        "entry_id": "0e8f29ff-b03f-38ff-b633-774b422832cf",
                        "glosses": [
                            "producten gemaakt uit geweven katoen, linnen, wol of zijde\\nVóór de 20e eeuw werd ook het onzijdig enkelvoud manufactuur in de betekenis \\\"product van een weverij\\\" gebruikt."
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "93b4004a-8591-45cb-97dd-f9dac57e6058",
                                "sense_id": "91594fdc-da0d-3627-a279-a8eba76d3f95",
                                "text": "Net als veel van hun streekgenoten – de beroemdste namen zijn Dreesmann, Peek, Cloppenburg, Kreijmborg – trokken ze rond 1870 naar het nabije, welvarende Nederland om in confectie en manufacturen te gaan; de Bokerns met weinig succes."
                            },
                            {
                                "example_id": "1215ef4e-62de-4f53-a9ab-0e45e1e6ab8e",
                                "sense_id": "91594fdc-da0d-3627-a279-a8eba76d3f95",
                                "text": "Dick was nog niet uitgezwaaid door Eimert van Middelkoop, of hij verruilde zijn uniform voor een uit diverse manufacturen weer even scherp gesneden burgerkostuum van eenzelfde toon blauw, en verscheen dagelijks in krant, op radio of televisie om het land aan te sporen de inktvlekstrategie krachtig voort te zetten."
                            }
                        ]
                    }
