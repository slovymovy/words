                ],
                "senses": [
                    {
                        "sense_id": "0e29476c-f63c-3fba-a80b-028ee49f0a6e",
                        "entry_id": "ea27c2ba-092a-3e7f-a529-b47b6f1149fe",
                        "glosses": [
                            "Waffe, die einer unterlegenen Partei in einer bewaffneten Auseinandersetzung zum sonst nicht möglichen Sieg verhelfen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7087afa-73c2-4b2f-9a32-0ba2b64d3c7d",
                                "sense_id": "0e29476c-f63c-3fba-a80b-028ee49f0a6e",
                                "text": "Die Messerschmitt Me 163 war eine der Wunderwaffen der Nazis im Zweiten Weltkrieg."
                            },
                            {
                                "example_id": "101fda4d-359a-4960-bb8d-cbcf31cb585f",
                                "sense_id": "0e29476c-f63c-3fba-a80b-028ee49f0a6e",
                                "text": "„Der vermeintlich nahende Einsatz von Wunderwaffen war in den letzten Kriegsjahren elementarer Teil der Propaganda.“"
                            },
                            {
                                "example_id": "969f1b92-9c27-4ba4-b8c1-c7678f6fefae",
                                "sense_id": "0e29476c-f63c-3fba-a80b-028ee49f0a6e",
                                "text": "„Sie hatten im Bergwerk im ostdeutschen Thüringen unter furchtbaren Bedingungen Hitlers Wunderwaffe V2 nach den Plänen von Wernher von Braun und seinen Mitarbeitern zusammenbauen müssen.“"
                            },
                            {
                                "example_id": "590744a8-d42b-4140-9fc0-6afe70b29058",
                                "sense_id": "0e29476c-f63c-3fba-a80b-028ee49f0a6e",
                                "text": "„Vage wurde auch über andere Wunderwaffen gewispert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "337f3762-66c1-35a4-a12c-d7279a58650e",
                        "entry_id": "ea27c2ba-092a-3e7f-a529-b47b6f1149fe",
                        "glosses": [
                            "besonders gut wirkendes Mittel"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a2f247b8-72a2-4198-988b-52deacb65385",
                                "sense_id": "337f3762-66c1-35a4-a12c-d7279a58650e",
                                "text": "„Mit einer einzigen Zutat wird sie sogar zur Wunderwaffe gegen Erkältungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
