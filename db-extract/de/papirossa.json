                "senses": [
                    {
                        "sense_id": "2b51f81a-ff20-3163-89fd-1f457e700553",
                        "entry_id": "f1c2d537-5b6b-3ea8-adf2-33400cece911",
                        "glosses": [
                            "russische Zigarette mit Pappmundstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31441f57-6681-40b3-8a4d-117df9080fcc",
                                "sense_id": "2b51f81a-ff20-3163-89fd-1f457e700553",
                                "text": "„Papa und Ota drehen sich auf russische Art Papyrossi, füllen sie mit Tee und lachen.“"
                            },
                            {
                                "example_id": "b656c5b3-6d53-4a1b-b2c3-6953d97e1462",
                                "sense_id": "2b51f81a-ff20-3163-89fd-1f457e700553",
                                "text": "„Damit hatten die Männer das Feuer angefacht, an dem Pawel mit umgehängter Maschinenpistole stand, eine Papirossa nach der anderen rauchend, die Männer beobachtend, die sich jenseits des Feuers formierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "902ad917-d430-4f0f-84cc-a93974c9b71f",
                        "source_entry_id": "f1c2d537-5b6b-3ea8-adf2-33400cece911",
                        "source_sense_id": "2b51f81a-ff20-3163-89fd-1f457e700553",
                        "source_sense_description": "russische Zigarette mit Pappmundstück",
                        "target_lang_word": "папироса",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "папироса",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb1ecbd-1c5b-34f8-b3e4-d18a89e15543",
                                        "entry_id": "5ccec47b-a723-3821-ae84-f7223cc7c278",
                                        "glosses": [
                                            "трубочка (гильза — из тонкой папиросной бумаги), внутри которой расположена другая трубочка (мундштук — из более плотной бумаги), первая из которых набита курительным табаком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccae9df-ee4a-45ce-81b1-dabe121aff43",
                                                "sense_id": "cdb1ecbd-1c5b-34f8-b3e4-d18a89e15543",
                                                "text": "У меня в руках в эту минуту папироса с бумажным мундштуком."
                                            },
                                            {
                                                "example_id": "14615261-26af-486f-94d8-b8ac1aada5e9",
                                                "sense_id": "cdb1ecbd-1c5b-34f8-b3e4-d18a89e15543",
                                                "text": "Вершина курила папиросу за папиросою. Она не могла жить без табачного дыма перед её носом."
                                            },
                                            {
                                                "example_id": "27516763-3b1a-44a1-a56a-8cf321eae458",
                                                "sense_id": "cdb1ecbd-1c5b-34f8-b3e4-d18a89e15543",
                                                "text": "Я бросил в уголья камина папиросу и задумал: если папироса истлеет и не даст огонька — не буду тебе писать, лучше тебе не писать; если даст огонь — напишу; папироса истлела без огня, а я всё-таки сел писать — третий час ночи."
                                            },
                                            {
                                                "example_id": "e0970fde-e3c6-4c28-bb8e-6d17f5f3166f",
                                                "sense_id": "cdb1ecbd-1c5b-34f8-b3e4-d18a89e15543",
                                                "text": "Пачка «Беломорканала» слежалась лепёшкой, и Алексей никак не мог ухватить сплюснутый мундштук папиросы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0600e445-319f-3048-b563-8d944cb63f62",
                                        "entry_id": "5ccec47b-a723-3821-ae84-f7223cc7c278",
                                        "glosses": [
                                            "мн. ч. пачка папирос 1; пачка с папиросами 1"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bcd02be-8fa7-4120-9d4b-f8ef8e3a9990",
                                                "sense_id": "0600e445-319f-3048-b563-8d944cb63f62",
                                                "text": "Он присел на ящик из-под патронов и протянул мне папиросы."
                                            },
                                            {
                                                "example_id": "2aafeb17-d87a-4823-a675-17a38d6c6725",
                                                "sense_id": "0600e445-319f-3048-b563-8d944cb63f62",
                                                "text": "Вечер Большой Пищи: у ЕЛ. гигантская тарелка дивной рисовой каши с сахарной пудрой, маслом, хлебцем, 2-мя стак. какао и его целый кубик с собой, ещё папиросы, 20 шт."
                                            },
                                            {
                                                "example_id": "73998e45-dd88-483c-88e9-4341e886b929",
                                                "sense_id": "0600e445-319f-3048-b563-8d944cb63f62",
                                                "text": "Страшным усилием воли, преодолевая боль и ужас, Кузнецов достал папиросы и спички."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
