        "nl-extract.jsonl": [
            {
                "entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                "word": "overwegend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
                        "entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                        "glosses": [
                            "voor het grootste gedeelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a772128-ce93-492c-917f-17deb7aeceaf",
                                "sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
                                "text": "\"Het lijkt er op dat de verdachte door het plegen van misdrijven in overwegende mate in zijn levensonderhoud voorziet.\""
                            },
                            {
                                "example_id": "f43fc0e6-9be8-4273-8289-c5f108de7ff8",
                                "sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
                                "text": "Voor Jet Volkering werkte het in ieder geval. Ze zit nu al anderhalf jaar op haar plek in de vestiging van Atlassian in Sydney. ,,Dat was niet vanzelfsprekend: ik kom uit een ander land en ben ook nog eens vrouw in een overwegende mannenwereld. Maar vanaf het begin heb ik me hier welkom gevoeld en kan ik helemaal mezelf zijn.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "838b85b4-93d7-3c7a-a12b-48d951ded9a8",
                        "entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                        "glosses": [
                            "van iets dat het de doorslag geeft bij het maken van een beslissing; van iets dat het het zwaarst weegt bij het maken van een beslissing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "451318f9-86d7-43c6-94bd-15f4c6c50eac",
                                "sense_id": "838b85b4-93d7-3c7a-a12b-48d951ded9a8",
                                "text": "Gevraagd naar het oordeel van de Raad van State zei de premier dat het advies weliswaar kritisch is, maar dat het kabinet 'overwegende reden ziet om door te gaan'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1293fe0b-0282-4c97-9c71-52525c212339",
                        "source_entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                        "source_sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
                        "source_sense_description": "voor het grootste gedeelte",
                        "target_lang_word": "overwhelmingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overwhelmingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e04c980-9716-3ead-a771-64a391db7a8a",
                                        "entry_id": "86b413f9-9c7c-30ce-a4eb-193d46b6fec8",
                                        "glosses": [
                                            "In an overwhelming manner; very greatly or intensely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7a349a-d34b-4460-bbe6-867e35a49b75",
                                                "sense_id": "4e04c980-9716-3ead-a771-64a391db7a8a",
                                                "text": "Gratifying as it is to read such editorials even in the press which supports Mr. Marples' party—and to learn that the G.N. Line's London suburban electrification is at last being given a cost-benefit analysis of the kind which overwhelmingly justified the L.T. Victoria Line [...] but years later than need have been—[...]."
                                            },
                                            {
                                                "example_id": "25d961ac-0e54-4202-a1e9-2203dce59fc0",
                                                "sense_id": "4e04c980-9716-3ead-a771-64a391db7a8a",
                                                "text": "The Conan O’Brien-penned half-hour has the capacity to rip our collective hearts out the way the cute, funny bad girl next door does to Bart when she reveals that her new boyfriend is Jimbo Jones, but the show keeps shying away from genuine emotion in favor of jokes that, while overwhelmingly funny, detract from the poignancy and the emotional intimacy of the episode."
                                            },
                                            {
                                                "example_id": "3a35ee24-6abe-4ec4-b956-e366481b18bb",
                                                "sense_id": "4e04c980-9716-3ead-a771-64a391db7a8a",
                                                "text": "[F]rom the perspective of traditional linguistic landscapes thought, such an overwhelmingly English landscape would normally be considered to exert a negative effect on the vitality and feelings of worth of other languages within this specific multilingual milieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9938743-07a5-3c36-b89b-06e02399f39a",
                                        "entry_id": "86b413f9-9c7c-30ce-a4eb-193d46b6fec8",
                                        "glosses": [
                                            "Mostly; predominantly; almost completely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a7666b-0671-4bac-b4a8-70a633b49a2b",
                                                "sense_id": "e9938743-07a5-3c36-b89b-06e02399f39a",
                                                "text": "Studies on homeless income find that the typical “career panhandler” who dedicates his time overwhelmingly to begging can make between $600 and $1,500 a month."
                                            },
                                            {
                                                "example_id": "46e310f9-0af4-4618-b423-efe8c20d8880",
                                                "sense_id": "e9938743-07a5-3c36-b89b-06e02399f39a",
                                                "text": "Those recurrent noises in Italy about a move to Internazionale have resurfaced this week. It seems overwhelmingly likely Conte will stay, pay rise pending. But it is a feat of rare political skill to have made himself so unusually vital to the current success."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb96d58a-76c8-478b-b763-d23f200a57ab",
                        "source_entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                        "source_sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
                        "source_sense_description": "voor het grootste gedeelte",
                        "target_lang_word": "mostly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mostly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0cebb0f-dbc8-3638-a21e-c968c28a65de",
                                        "entry_id": "180889e0-8b8e-3c59-bad3-08cb8576e1d4",
                                        "glosses": [
                                            "Mainly or chiefly; for the most part; usually, generally, on the whole."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a0cf8b2-7763-4b3a-b2c2-0eec418282ec",
                                                "sense_id": "d0cebb0f-dbc8-3638-a21e-c968c28a65de",
                                                "text": "They're mostly good people, although they have made a few mistakes."
                                            },
                                            {
                                                "example_id": "66b235a1-9d25-4066-aeea-c21830c9f561",
                                                "sense_id": "d0cebb0f-dbc8-3638-a21e-c968c28a65de",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0873a558-85fc-3955-b66d-8975920204cc",
                                        "entry_id": "180889e0-8b8e-3c59-bad3-08cb8576e1d4",
                                        "glosses": [
                                            "To the greatest extent; most."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "592497f3-755c-4c8b-9c68-6a86e275c4d8",
                                                "sense_id": "0873a558-85fc-3955-b66d-8975920204cc",
                                                "text": "She was to be their chosen visitor, she was to be for weeks under the same roof with the person whose society she mostly prized [...]!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "708cc821-96d6-4282-9263-158858d092a9",
                        "source_entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                        "source_sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
                        "source_sense_description": "voor het grootste gedeelte",
                        "target_lang_word": "chiefly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiefly",
                                "target_lang_code": "en",
