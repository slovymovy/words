                ],
                "senses": [
                    {
                        "sense_id": "d503c67f-d877-3165-b716-6c2445d24cde",
                        "entry_id": "671abf37-1cde-3426-ae88-87cec0dea8bb",
                        "glosses": [
                            "To boast; to speak loudly and boastfully."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fab99d1a-d454-4b15-80e1-3e3cf7aa9f84",
                                "sense_id": "d503c67f-d877-3165-b716-6c2445d24cde",
                                "text": "I hyred the to fyght agaynste Alexander, and not to crake and prate."
                            },
                            {
                                "example_id": "b01bd040-4a84-4736-8c08-005966f2a924",
                                "sense_id": "d503c67f-d877-3165-b716-6c2445d24cde",
                                "text": "Each man may crake of that which was his own."
                            },
                            {
                                "example_id": "4d026612-bd12-48aa-877c-82e52eb74c15",
                                "sense_id": "d503c67f-d877-3165-b716-6c2445d24cde",
                                "text": "With him I threatned to be quite, and great things did I crake."
                            },
                            {
                                "example_id": "55a6d847-4839-42b6-b9b5-644e53ecfe74",
                                "sense_id": "d503c67f-d877-3165-b716-6c2445d24cde",
                                "text": "And he that thus doth shal have smal pleasure in his awn rightwysnes, nor no gret lust to crake of his awn deserts or meryts."
                            }
                        ]
                    }
                ],
