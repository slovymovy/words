                    {
                        "sense_id": "6a95340c-642a-3c3b-a25e-66cba67dd658",
                        "entry_id": "e564ab2d-6140-37c4-bdc7-4df9d69109c5",
                        "glosses": [
                            "Cépage donnant de petits raisins blancs réunis en petites grappes compactes. Il est utilisé notamment au nord de la vallée du Rhône. En France en 2009 on en cultivait plus de 4000 hectares."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "3ba4ee73-ccb7-47d1-a400-65f82f151cf3",
                                "sense_id": "6a95340c-642a-3c3b-a25e-66cba67dd658",
                                "text": "Le viognier est un cépage ancien des vignobles de Condrieu et d’Ampuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b46c11d-e63c-3f73-b235-459bb6201621",
                        "entry_id": "e564ab2d-6140-37c4-bdc7-4df9d69109c5",
                        "glosses": [
                            "Vin blanc issu de ce cépage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc2b209-a6fa-4279-9cf4-eae0bce942af",
                                "sense_id": "3b46c11d-e63c-3f73-b235-459bb6201621",
                                "text": "– Vous voulez boire un coup ? demande le père en empoignant la bouteille de viognier."
                            }
                        ]
                    }
