                                    {
                                        "sense_id": "9177deb6-b454-323e-9225-8236a9ab77f9",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "The state or fact of being turbulent or agitated; tempestuousness, disturbance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c33367-eddf-4846-abcc-b778f7483845",
                                                "sense_id": "9177deb6-b454-323e-9225-8236a9ab77f9",
                                                "text": "Turbulence was everywhere, within every blade of grass, every drop of dew on a leaf, every cloud in the sky, and every star beyond. The turbulence was purposeless, but in huge quantities of purposeless turbulence, purpose took shape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b411fc7-2db6-3e1a-8241-ecb42a8a612e",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "Disturbance in a gas or fluid, characterized by evidence of internal motion or unrest."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86270554-3c19-38aa-922e-5578da474454",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "Specifically, a state of agitation or disturbance in the air which is disruptive to an aircraft."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e239cda-15ed-3826-9248-c55e882ae8bf",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "An instance or type of such state or disturbance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc9ec71-e361-4d0c-89b2-2506fb108427",
                                                "sense_id": "7e239cda-15ed-3826-9248-c55e882ae8bf",
                                                "text": "In a brief and abashed Tory conference speech, Kwarteng admitted it had been a “tough day” – hours after rowing back on the tax cut for high earners. He said his economic plan had caused “a little turbulence”."
                                            }
                                        ]
                                    }
