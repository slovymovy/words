                        "examples": [
                            {
                                "example_id": "ac0c139d-5c53-4933-b101-64bd3cb56dc2",
                                "sense_id": "1621136a-13cd-3365-a78b-cdd12eee8083",
                                "text": "„Zalor ging vor mir und verlor auf den glatten Metallstufen den Halt.“"
                            },
                            {
                                "example_id": "cf259c55-23c3-4238-a8cf-167ce66732a0",
                                "sense_id": "1621136a-13cd-3365-a78b-cdd12eee8083",
                                "text": "„Ich schulterte meinen Rucksack und stapfte die wackeligen Metallstufen hinunter, die aus dem ebenso wackeligen Privatjet ragten.“"
                            },
                            {
                                "example_id": "d4881dfb-b7cc-4142-852f-07c04319faa5",
                                "sense_id": "1621136a-13cd-3365-a78b-cdd12eee8083",
                                "text": "„Sie sahen ihn zusammengekrümmt auf der Straße und sich mit beiden Händen das Knie halten; keiner hatte mitbekommen, wie er danebengriff, als er nach Fuhrmannsart mit einem Satz auf den hohen Bock hüpfte und sich im Fallen das Knie an der Metallstufe aufschlug.“"
                            }
                        ],
