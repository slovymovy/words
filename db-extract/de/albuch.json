                "senses": [
                    {
                        "sense_id": "982cc2a5-10fa-3263-9608-09a7282219c0",
                        "entry_id": "2f7aa6ff-6eeb-35a3-9d57-909ee4897a27",
                        "glosses": [
                            "im Osten gelegener Teil der Schwäbischen Alb in Baden-Württemberg, Deutschland"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "9a09b700-9e87-4ab6-924a-5cac3940492f",
                                "sense_id": "982cc2a5-10fa-3263-9608-09a7282219c0",
                                "text": "„Im Albuch haben Unbekannte an mehreren Stellen im gräflichen und staatlichen Forst viele Bäume gefällt.“"
                            },
                            {
                                "example_id": "fb5ec721-43ee-42c5-9a3c-316cc5ea4b10",
                                "sense_id": "982cc2a5-10fa-3263-9608-09a7282219c0",
                                "text": "„Viertklässler der Waldorfschule Rottweil erleben ein spannendes Abenteuer beim Köhlern im Albuch.“"
                            },
                            {
                                "example_id": "288c0864-a19f-4375-8614-da34f432bf06",
                                "sense_id": "982cc2a5-10fa-3263-9608-09a7282219c0",
                                "text": "„Die Hoffnung, dass in einigen Wochen der Schnee auf dem Albuch noch liegt, ist da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
