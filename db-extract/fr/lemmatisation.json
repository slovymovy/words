                                        "sense_id": "a252084f-3d11-3b9c-bd9d-f38f43b2f7df",
                                        "entry_id": "10131d33-1a54-3b8e-ad46-549e83d09ac7",
                                        "glosses": [
                                            "Zuordnung einer Wortform zu einem Lemma"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5682f3-f9ff-41bb-945b-1bdf55deccde",
                                                "sense_id": "a252084f-3d11-3b9c-bd9d-f38f43b2f7df",
                                                "text": "„Die Lemmatisierung ist keineswegs eine kategorische Angelegenheit, bei der immer klar wäre, zu welchem Lemma eine Wortform gehört.“"
                                            }
                                        ],
