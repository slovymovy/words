{
    "word_family": [
        "shrouded",
        "shrouding",
        "unshrouded"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d336fe3-fc68-3ce3-a32d-66bd78ba34d7",
                    "sense_definition": "A cloth or garment in which a dead person is wrapped for burial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The body was carefully wrapped in a white linen <w>shroud</w> before being placed in the tomb.",
                            "target_lang_translations": {
                                "ru": "Тело было тщательно завернуто в льняной белый <w>саван</w> перед тем, как его поместили в гробницу.",
                                "pl": "Ciało zostało starannie owinięte w biały lniany <w>całun</w> przed złożeniem do grobu."
                            }
                        },
                        {
                            "text": "In some cultures, it is traditional to use a simple funeral <w>shroud</w> instead of a wooden casket.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах принято использовать простой погребальный <w>саван</w> вместо деревянного гроба.",
                                "pl": "W niektórych kulturach tradycyjnie używa się prostego <w>całunu</w> pogrzebowego zamiast drewnianej trumny."
                            }
                        }
                    ],
                    "synonyms": [
                        "sindon"
                    ],
                    "common_phrases": [
                        "funeral shroud",
                        "burial shroud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ткань или одежда, в которую заворачивают умершего для погребения.",
                        "pl": "Tkanina lub szata, w którą owija się zmarłego do pochówku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "саван",
                                "target_lang_sense_clarification": "погребальное одеяние"
                            },
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "устар., ткань для обертывания тела"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "całun",
                                "target_lang_sense_clarification": "płótno pogrzebowe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a34b84a-dd7b-3bae-8148-1621c6e51e7b",
                    "sense_definition": "Something that covers, conceals, or protects like a garment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain peak was hidden behind a thick <w>shroud</w> of clouds all morning.",
                            "target_lang_translations": {
                                "ru": "Вершина горы все утро была скрыта за густой <w>пеленой</w> облаков.",
                                "pl": "Szczyt góry przez cały ranek był ukryty za gęstą <w>zasłoną</w> chmur."
                            }
                        },
                        {
                            "text": "The scientists threw grey <w>shrouds</w> over the prototypes to keep them hidden from the visitors.",
                            "target_lang_translations": {
                                "ru": "Ученые набросили серые <w>чехлы</w> на прототипы, чтобы скрыть их от посетителей.",
                                "pl": "Naukowcy narzucili szare <w>pokrywy</w> na prototypy, aby ukryć je przed zwiedzającymi."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloak",
                        "cover",
                        "mantle",
                        "veil"
                    ],
                    "common_phrases": [
                        "shroud of clouds",
                        "protective shroud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что покрывает, скрывает или защищает подобно одежде.",
                        "pl": "Coś, co przykrywa, ukrywa lub chroni niczym odzież."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "то, что укрывает или скрывает"
                            },
                            {
                                "target_lang_word": "завеса",
                                "target_lang_sense_clarification": "скрывающая преграда"
                            },
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "то, что застилает или заволакивает"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zasłona",
                                "target_lang_sense_clarification": "coś, co przesłania widok"
                            },
                            {
                                "target_lang_word": "pokrywa",
                                "target_lang_sense_clarification": "warstwa przykrywająca coś"
                            },
                            {
                                "target_lang_word": "mgła",
                                "target_lang_sense_clarification": "w kontekście zjawisk atmosferycznych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ae1d91-9219-3f46-9017-5bcd140e37c5",
                    "sense_definition": "A set of ropes or cables forming part of the standing rigging of a sailing vessel and supporting a mast from the sides.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor was clinging for his life to the <w>shroud</w> as the waves crashed over the deck.",
                            "target_lang_translations": {
                                "ru": "Моряк изо всех сил цеплялся за <w>ванту</w>, пока волны разбивались о палубу.",
                                "pl": "Marynarz kurczowo trzymał się <w>wanty</w>, gdy fale rozbijały się o pokład."
                            }
                        },
                        {
                            "text": "The heavy winds put immense pressure on the <w>shrouds</w> supporting the main mast.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер оказывал огромное давление на <w>ванты</w>, поддерживающие грот-мачту.",
                                "pl": "Silny wiatr wywierał ogromny nacisk na <w>wanty</w> podtrzymujące grotmaszt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mast shroud"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор тросов или кабелей, являющихся частью стоячего такелажа парусного судна и поддерживающих мачту с боков.",
                        "pl": "Zestaw lin lub kabli stanowiących część olinowania stałego żaglowca, podtrzymujących maszt z boków."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ванты",
                                "target_lang_sense_clarification": "морской термин, поддержка мачты"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wanta",
                                "target_lang_sense_clarification": "lina podtrzymująca maszt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52ec39dd-9f40-3d78-bd23-4f4225d83691",
                    "sense_definition": "A streamlined protective covering used to protect the payload during a rocket-powered launch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "aerospace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satellite was safely tucked inside the payload <w>shroud</w> during the initial ascent.",
                            "target_lang_translations": {
                                "ru": "Спутник был надежно спрятан внутри <w>обтекателя</w> полезной нагрузки во время начального этапа подъема.",
                                "pl": "Satelita był bezpiecznie schowany wewnątrz <w>owiewki</w> ładunku podczas początkowej fazy wznoszenia."
                            }
                        },
                        {
                            "text": "Engineers checked the integrity of the <w>shroud</w> before the rocket was moved to the launch pad.",
                            "target_lang_translations": {
                                "ru": "Инженеры проверили целостность <w>кожуха</w> перед тем, как ракету переместили на стартовую площадку.",
                                "pl": "Inżynierowie sprawdzili integralność <w>osłony</w> przed przetransportowaniem rakiety na platformę startową."
                            }
                        }
                    ],
                    "common_phrases": [
                        "payload shroud"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обтекаемое защитное покрытие, используемое для защиты полезной нагрузки во время ракетного запуска.",
                        "pl": "Opływowa osłona ochronna używana do zabezpieczenia ładunku podczas startu rakiety."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтекатель",
                                "target_lang_sense_clarification": "защитный кожух ракеты"
                            },
                            {
                                "target_lang_word": "кожух",
                                "target_lang_sense_clarification": "защитная оболочка"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "owiewka",
                                "target_lang_sense_clarification": "osłona aerodynamiczna"
                            },
                            {
                                "target_lang_word": "osłona",
                                "target_lang_sense_clarification": "zabezpieczenie techniczne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f683112b-1561-33c1-9da4-2dfb8923b5c5",
                    "sense_definition": "The branching top or foliage of a tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient cedar stood tall with a shadowing <w>shroud</w> of thick green branches.",
                            "target_lang_translations": {
                                "ru": "Древний кедр возвышался, отбрасывая тень своей густой зеленой <w>кроной</w>.",
                                "pl": "Stary cedr stał dumnie, rzucając cień swoją gęstą, zieloną <w>koroną</w>."
                            }
                        },
                        {
                            "text": "Birds found safety within the dense <w>shroud</w> of the forest canopy.",
                            "target_lang_translations": {
                                "ru": "Птицы находили убежище в густом <w>покрове</w> лесного полога.",
                                "pl": "Ptaki znajdowały schronienie w gęstym <w>sklepieniu</w> leśnych koron."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разветвленная верхушка или листва дерева.",
                        "pl": "Rozłożysta korona lub listowie drzewa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крона",
                                "target_lang_sense_clarification": "листва и ветви дерева"
                            },
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "лиственный полог"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "korona",
                                "target_lang_sense_clarification": "górna część drzewa"
                            },
                            {
                                "target_lang_word": "sklepienie",
                                "target_lang_sense_clarification": "gęsty baldachim z liści"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cceffd2-0f59-366f-9789-a53042255fad",
                    "sense_definition": "To conceal or hide from view, as if by covering with a cloth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain was <w>shrouded</w> in mist, making it impossible for the hikers to see the trail.",
                            "target_lang_translations": {
                                "ru": "Гора была <w>окутана</w> туманом, из-за чего туристы не могли разглядеть тропу.",
                                "pl": "Góra była <w>spowita</w> mgłą, co uniemożliwiało turystom dostrzeżenie szlaku."
                            }
                        },
                        {
                            "text": "The details of the secret government project were <w>shrouded</w> in mystery for decades.",
                            "target_lang_translations": {
                                "ru": "Подробности секретного правительственного проекта десятилетиями были <w>окутаны</w> тайной.",
                                "pl": "Szczegóły tajnego projektu rządowego były przez dziesięciolecia <w>otulone</w> tajemnicą."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloak",
                        "cover",
                        "veil",
                        "mantle"
                    ],
                    "antonyms": [
                        "reveal",
                        "uncover"
                    ],
                    "common_phrases": [
                        "shrouded in mystery",
                        "shrouded in mist",
                        "shrouded in secrecy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрывать или прятать от взора, словно накрывая тканью.",
                        "pl": "Ukrywać lub chować przed wzrokiem, jakby przykrywając tkaniną."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "о тумане, тайне"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "делать невидимым"
                            },
                            {
                                "target_lang_word": "заволакивать",
                                "target_lang_sense_clarification": "покрывать дымкой или облаками"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "otulać",
                                "target_lang_sense_clarification": "o mgle, tajemnicy"
                            },
                            {
                                "target_lang_word": "zasłaniać",
                                "target_lang_sense_clarification": "czynić niewidocznym"
                            },
                            {
                                "target_lang_word": "spowijać",
                                "target_lang_sense_clarification": "pokrywać mgłą lub mrokiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9692bf1-f219-3d55-818a-e3560cdc5536",
                    "sense_definition": "To wrap a body in a burial cloth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priests began to <w>shroud</w> the body in preparation for the traditional ceremony.",
                            "target_lang_translations": {
                                "ru": "Жрецы начали <w>облекать</w> тело в саван в рамках подготовки к традиционной церемонии.",
                                "pl": "Kapłani zaczęli <w>owijać w całun</w> ciało w ramach przygotowań do tradycyjnej ceremonii."
                            }
                        },
                        {
                            "text": "Ancient mummies were often <w>shrouded</w> in many layers of fine linen.",
                            "target_lang_translations": {
                                "ru": "Древние мумии часто были <w>запеленуты</w> во множество слоев тонкого льна.",
                                "pl": "Starożytne mumie były często <w>owijane w całun</w> z wielu warstw cienkiego płótna."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заворачивать тело в погребальную ткань.",
                        "pl": "Owijanie ciała w tkaninę pogrzebową."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облекать в саван",
                                "target_lang_sense_clarification": "готовить к погребению"
                            },
                            {
                                "target_lang_word": "пеленать",
                                "target_lang_sense_clarification": "устар., заворачивать покойника"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "owijać w całun",
                                "target_lang_sense_clarification": "przygotowywać do pochówku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f1f5e1a-38f3-3851-9f6c-ad2d8db6ced1",
                    "sense_definition": "To cut off or lop the branches from a tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener had to <w>shroud</w> the old oak tree to prevent the branches from touching the power lines.",
                            "target_lang_translations": {
                                "ru": "Садовнику пришлось <w>обрубить</w> ветви старого дуба, чтобы они не касались линий электропередач.",
                                "pl": "Ogrodnik musiał <w>obciąć gałęzie</w> starego dębu, aby nie dotykały linii energetycznych."
                            }
                        },
                        {
                            "text": "It was common practice in the village to <w>shroud</w> the willows every few years.",
                            "target_lang_translations": {
                                "ru": "В деревне было обычной практикой <w>подрезать</w> ивы каждые несколько лет.",
                                "pl": "W wiosce powszechną praktyką było <w>ogławianie</w> wierzb co kilka lat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Срезать или обрубать ветви с дерева.",
                        "pl": "Obcinanie lub usuwanie gałęzi z drzewa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрубать ветви",
                                "target_lang_sense_clarification": "подрезать дерево"
                            },
                            {
                                "target_lang_word": "очищать от сучьев",
                                "target_lang_sense_clarification": "удалять боковые побеги"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obcinać gałęzie",
                                "target_lang_sense_clarification": "przycinanie drzewa"
                            },
                            {
                                "target_lang_word": "ogławiać",
                                "target_lang_sense_clarification": "usuwanie wierzchołka lub gałęzi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}