                "senses": [
                    {
                        "sense_id": "c75bced2-bf71-3073-b292-f26604e973e1",
                        "entry_id": "ca651f42-e608-39d0-a30d-46f38b4a1fa6",
                        "glosses": [
                            "obniżenie zawartości tlenu w wodzie skutkujące m.in. śnięciem ryb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac183f0-7797-4743-a6cb-88a290d77e5f",
                                "sense_id": "c75bced2-bf71-3073-b292-f26604e973e1",
                                "text": "Zimą, na skutek zlodzenia, ilość tlenu zmniejsza się i często występuje deficyt tlenowy, co doprowadza do zjawiska przyduchy, w wyniku której następuje wyginięcie oksybiontów"
                            },
                            {
                                "example_id": "645c445e-68ad-4747-b5ea-517124904e54",
                                "sense_id": "c75bced2-bf71-3073-b292-f26604e973e1",
                                "text": "Przyducha zimowa jest wynikiem ograniczonej produkcji tlenu przez roślinność wodną i rozkładu resztek substancji organicznych"
                            },
                            {
                                "example_id": "320027ad-499d-429b-aa15-76a393c99152",
                                "sense_id": "c75bced2-bf71-3073-b292-f26604e973e1",
                                "text": "Na przyduchy narażone są najczęściej niewielkie zbiorniki wodne (szczególnie bezodpływowe) zawierające mało rozpuszczonego tlenu"
                            },
                            {
                                "example_id": "5df5fa39-d8b4-4f6c-903b-b8eedfaf3860",
                                "sense_id": "c75bced2-bf71-3073-b292-f26604e973e1",
                                "text": "W Odrze pojawiają się żywe ryby, ale zagraża im przyducha. Będzie napowietrzanie rzeki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
