                "senses": [
                    {
                        "sense_id": "e30102fc-db50-37cc-b428-83b0fee3fa58",
                        "entry_id": "a193af53-2fb0-367e-addd-346a1ffd5c27",
                        "glosses": [
                            "Rendre plus serbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e5aeaae-2731-4780-919a-31d1a4e0ca59",
                                "sense_id": "e30102fc-db50-37cc-b428-83b0fee3fa58",
                                "text": "Au contraire les milices serbes parviennent à « décroatiser » la Slavonie et une partie de la Dalmatie, et « serbiser » la Voïvodine."
                            },
                            {
                                "example_id": "8c0fa1bd-08b4-4544-a044-31d490435b57",
                                "sense_id": "e30102fc-db50-37cc-b428-83b0fee3fa58",
                                "text": "Le même phénomène ne se produit pas entre les autres nationalités : on ne voit guère un Bulgare s’albaniser, se valaquiser, se serbiser, et vice versa."
                            }
                        ]
                    }
