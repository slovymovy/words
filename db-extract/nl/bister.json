            {
                "entry_id": "0eecc221-4d2c-3989-b9b0-61397b894d70",
                "word": "bister",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d1148a3-f9d8-37eb-b425-4ae8d39ed365",
                        "entry_id": "0eecc221-4d2c-3989-b9b0-61397b894d70",
                        "glosses": [
                            "donkerbruine kleurstof, gewonnen uit roet of verkoold beukenhout"
                        ],
                        "tags": [
                            "schilderkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "a3b6e6b4-0037-4f3f-ac8e-d28064cea0e7",
                                "sense_id": "0d1148a3-f9d8-37eb-b425-4ae8d39ed365",
                                "text": "Expres bruin aangezet met bister, een pigment van roet, gekregen van de aquarellist Piet Lap."
                            },
                            {
                                "example_id": "6d98040f-7e4a-4d37-8713-2e558917c361",
                                "sense_id": "0d1148a3-f9d8-37eb-b425-4ae8d39ed365",
                                "text": "Om het bister te bereiden, neemt men de hardste stukken roet, die bij het doorbreken glinsteren, wrijft ze fijn en drijft het poeder door een zeeft [sic!]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0099da01-9f7b-37d4-9a79-8549de74c976",
                        "entry_id": "0eecc221-4d2c-3989-b9b0-61397b894d70",
                        "glosses": [
                            "de kleur van verkoold hout, ook gebruikt voor de blekere tinten daarvan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a6d649-88dd-4256-be7b-a9ef155ec2d5",
                                "sense_id": "0099da01-9f7b-37d4-9a79-8549de74c976",
                                "text": "⧖ De kenmerkende eigenschappen van dit zwart zijn deze, dat het door zoutzuur wit, en door tinzout blaauw wordt, bijtende potasch tast het niet aan, salpeterzuur vernietigt het blaauw, waarop het bister eenige oogenblikken zigtbaar wordt, maar dan ook verdwijnt."
                            }
                        ]
                    }
                ],
                "translations": [
