                                        "examples": [
                                            {
                                                "example_id": "9247b701-1e15-406f-8f67-ae695b4bb544",
                                                "sense_id": "d2fb2eda-b15c-30aa-b6b2-2915b1ed8385",
                                                "text": "`Sprung!' cried Jeff Basin, the local dubbo. 'Oh, der,' moaned Boardie sarcastically."
                                            },
                                            {
                                                "example_id": "936b09da-7aef-4f64-b166-c0ce0060ddfa",
                                                "sense_id": "d2fb2eda-b15c-30aa-b6b2-2915b1ed8385",
                                                "text": "Another pointed out the hypocrisy in the original argument, sarcastically noting, \"Amazing how all of these 'free-thinking alpha males' reach the same conclusions on everything.\""
                                            },
                                            {
                                                "example_id": "3e72ceb3-dddf-4b1e-a21e-86c8c76d9ea1",
                                                "sense_id": "d2fb2eda-b15c-30aa-b6b2-2915b1ed8385",
                                                "text": "Figures from both groups – rightwing activist Charlie Kirk and the Department of Homeland Security (DHS) – boastfully shared these images on X, with the latter sarcastically thanking South Park for helping them in their recruiting efforts. (The show responded on X by asking DHS “Wait, so we ARE relevant? #eatabagofdicks”.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
