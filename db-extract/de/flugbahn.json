                ],
                "senses": [
                    {
                        "sense_id": "ac13e511-3c7b-309c-b04c-42f0743ca710",
                        "entry_id": "162886aa-d58e-3d8d-a5a4-d9135730ece4",
                        "glosses": [
                            "Bahn, die ein fliegender Körper beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a35231-99d5-4042-848b-863cf58a462c",
                                "sense_id": "ac13e511-3c7b-309c-b04c-42f0743ca710",
                                "text": "Die Techniker mussten die Flugbahn der Rakete neu berechnen."
                            },
                            {
                                "example_id": "bc10349d-48a8-4966-a5cb-b8f6e718b37e",
                                "sense_id": "ac13e511-3c7b-309c-b04c-42f0743ca710",
                                "text": "„Genau in ihrer Flugbahn ragte etwa 50 km entfernt ein schroffes Landstück aus dem Meer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85d5107e-93b3-45c9-afc0-fd87fa583ac0",
                        "source_entry_id": "162886aa-d58e-3d8d-a5a4-d9135730ece4",
                        "source_sense_id": "ac13e511-3c7b-309c-b04c-42f0743ca710",
                        "source_sense_description": "Bahn, die ein fliegender Körper beschreibt",
                        "target_lang_word": "trajectory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trajectory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529d49a8-b54b-34fa-87c9-fb2938e4a6ba",
                                        "entry_id": "85371d45-ad48-3d16-b70a-a4293ff0f48e",
                                        "glosses": [
                                            "The path an object takes as it moves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eecd346-4b32-459e-9fa0-21f466022ea1",
                                                "sense_id": "529d49a8-b54b-34fa-87c9-fb2938e4a6ba",
                                                "text": "The USA were dominant but, to England’s immense credit, they repeatedly rallied, refusing to fold. Indeed they could conceivably have gone in level at the interval had Naeher not made an acrobatic, stretching, fingertip save to divert Walsh’s 25-yard thunderbolt as it whizzed unerringly on its apparently inexorable trajectory towards the top corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5de44f-c9a0-3401-b696-2fa78dd97c12",
                                        "entry_id": "85371d45-ad48-3d16-b70a-a4293ff0f48e",
                                        "glosses": [
                                            "The path of a body as it travels through space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d51aec3-b4d4-30df-bcd1-9c90cd1b0566",
                                        "entry_id": "85371d45-ad48-3d16-b70a-a4293ff0f48e",
                                        "glosses": [
                                            "The ordered set of intermediate states assumed by a dynamical system as a result of time evolution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3a12a36-c638-3c1f-8099-1907f32107de",
                                        "entry_id": "85371d45-ad48-3d16-b70a-a4293ff0f48e",
                                        "glosses": [
                                            "A course of development, such as that of a war or career."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6173dc33-fa5d-4cb8-b16d-c6795dd8fe43",
                                                "sense_id": "c3a12a36-c638-3c1f-8099-1907f32107de",
                                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff23b6c5-0109-49d1-8bd5-fb43d608abb8",
                        "source_entry_id": "162886aa-d58e-3d8d-a5a4-d9135730ece4",
                        "source_sense_id": "ac13e511-3c7b-309c-b04c-42f0743ca710",
                        "source_sense_description": "Bahn, die ein fliegender Körper beschreibt",
                        "target_lang_word": "trajectoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trajectoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ace9e5de-ce19-3da0-8745-cbce45ae9d84",
                                        "entry_id": "0e78ffbf-44ab-31c6-8c54-69ffb34e9fa4",
                                        "glosses": [
                                            "Ligne décrite par le centre de gravité d’un corps ou d’un système de corps en mouvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4354088f-194a-4a48-9156-d5caf2d62a83",
                                                "sense_id": "ace9e5de-ce19-3da0-8745-cbce45ae9d84",
                                                "text": "Que disait Joyon de cette trajectoire sur l'eau ? « Quand j'ai vu qu'il descendait le golfe de Gascogne deux nœuds plus vite que nous, avec de surcroît un bien meilleur angle au vent, j'ai compris que la messe était dite. »"
                                            },
                                            {
                                                "example_id": "9ae057da-633b-41af-a930-5606ac2a67a3",
                                                "sense_id": "ace9e5de-ce19-3da0-8745-cbce45ae9d84",
                                                "text": "La trajectoire que décrivent les corps pesants jetés obliquement est à peu près une parabole."
                                            },
                                            {
                                                "example_id": "318b7efb-e231-4ff7-9661-607e00561a70",
                                                "sense_id": "ace9e5de-ce19-3da0-8745-cbce45ae9d84",
                                                "text": "Les trajectoires des planètes sont à peu près des ellipses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429c78eb-61c4-3aac-b8e6-f387ea86dc9d",
                                        "entry_id": "0e78ffbf-44ab-31c6-8c54-69ffb34e9fa4",
                                        "glosses": [
                                            "Déplacement, en parlant d'un objet dans un espace."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd92aa0-2326-40fb-b4aa-0a97aedd456e",
                                                "sense_id": "429c78eb-61c4-3aac-b8e6-f387ea86dc9d",
                                                "text": "Plus tard, par une méthode déjà plus délicate, j’inscrivais les phases d’élévation et d’abaissement des ailes d’un oiseau qui vole, la trajectoire décrite dans l’espace par la pointe de l’aile, les changements du plan alaire, les oscillations du corps dans leurs rapports avec les mouvements du vol."
                                            },
                                            {
                                                "example_id": "51b28ac0-23d9-4b2a-a891-3ea18fe2d26b",
                                                "sense_id": "429c78eb-61c4-3aac-b8e6-f387ea86dc9d",
                                                "text": "Depuis l'Argonne de 1914, […] je n'ai pas l'oreille si mal bâtie que d'avoir, en vingt et un ans, oublié l'art d'apprécier au son la trajectoire d'un obus et le point de chute probable."
                                            },
                                            {
                                                "example_id": "9fe19b4c-4e30-485d-aebd-adf25b2a3f4a",
                                                "sense_id": "429c78eb-61c4-3aac-b8e6-f387ea86dc9d",
                                                "text": "L'avion continuait effectivement sa route sans faire de piqué ni de looping ! Ça aurait pu être amusant de varier un peu la trajectoire, mais les passagers derrière n'auraient peut-être pas apprécié."
                                            },
                                            {
                                                "example_id": "1b90b9e9-b6da-4747-af52-e0238c445e46",
                                                "sense_id": "429c78eb-61c4-3aac-b8e6-f387ea86dc9d",
                                                "text": "Si le son du canon glace d’effroi les assiégés, c'est par ce même son que certains s’accoutument à l'obus, apprennent à deviner les trajectoires et les impacts."
                                            },
                                            {
                                                "example_id": "5c152669-2549-4745-8262-c4b02b91305d",
                                                "sense_id": "429c78eb-61c4-3aac-b8e6-f387ea86dc9d",
                                                "text": "Il gâcha la première sur une volée trop longue et perdit la deuxième sur un passing de Becker qui, heurtant la bande du filet, prit une trajectoire inattendue et passa au-dessus de la raquette de son malheureux adversaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9705a763-ffb9-310f-8a1a-188948d588a4",
                                        "entry_id": "0e78ffbf-44ab-31c6-8c54-69ffb34e9fa4",
                                        "glosses": [
                                            "Évolution personnelle, sociale ou économique, en parlant d'une personne ou d'un groupe humain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "726d96cc-c790-4702-9123-9c9626359803",
                                                "sense_id": "9705a763-ffb9-310f-8a1a-188948d588a4",
                                                "text": "Difficile d’objectiver davantage cette hypothèse étant donné le peu de cas étudiés et l’absence d’informations plus précises sur la trajectoire multigénérationnelle de leurs familles."
                                            },
                                            {
                                                "example_id": "cbfe9abd-df16-42dd-b43f-3443a31509a0",
                                                "sense_id": "9705a763-ffb9-310f-8a1a-188948d588a4",
                                                "text": "La mise en récit est le point de départ d’une élaboration personnelle qui permet l’intégration de l’expérience hors du commun dans la trajectoire de vie du sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26973b0-1d5d-3400-8cc7-35afab782349",
                                        "entry_id": "0e78ffbf-44ab-31c6-8c54-69ffb34e9fa4",
                                        "glosses": [
                                            "Direction que prend une évolution"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f7ff03-3f0e-4204-a0c8-8e8a8990542c",
                                                "sense_id": "d26973b0-1d5d-3400-8cc7-35afab782349",
                                                "text": "Le temps a donc une « valeur œnologique » qui suit une trajectoire concave pour les vins premium à potentiel de vieillissement. Cette valeur œnologique se traduit bien entendu en valeur économique à travers le phénomène d’appréciation/dépréciation de la qualité."
                                            },
                                            {
                                                "example_id": "b555d2a1-16e8-4078-a6d3-994cd1a25ea9",
                                                "sense_id": "d26973b0-1d5d-3400-8cc7-35afab782349",
                                                "text": "Une nouvelle trajectoire budgétaire « crédible » doit être présentée en septembre à la Commission européenne, qui a ouvert une procédure de déficit excessif visant la France, l’entêtement des gouvernements macronistes à ne pas augmenter les impôts ayant conduit à un dérapage des finances publiques."
                                            }
                                        ]
                                    }
