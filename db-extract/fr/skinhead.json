                "senses": [
                    {
                        "sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                        "entry_id": "3261318c-2665-3ed3-bb3c-6c8f60983a89",
                        "glosses": [
                            "Personne appartenant à un mouvement dont les codes sont l’idéologie de la race blanche, le racisme et l’homophobie, organisation affiliée au Ku Klux Klan, les codes vestimentaires sont d'avoir le crâne rasé, de porter des bottes et qui prône l’agressivité."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "54ae4426-4405-4ef5-8396-42cee3147ce2",
                                "sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                                "text": "Témoin clé au procès de trois skinheads jugés pour la mort de l’antifasciste Clément Méric, Serge Ayoub, figure tutélaire de la jeunesse d’ultra-droite, a fait savoir hier à la cour d’assises qu’il ne serait pas présent."
                            },
                            {
                                "example_id": "efc1c15e-e224-470b-8f12-5d727cf96340",
                                "sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                                "text": "Fondé en 1987 aux États-Unis, SHARP (Skinheads Against Racial Prejudice ou Skinheads contre les préjugés raciaux) désigne un mouvement de skinheads dits « traditionnels » (tradskins) qui se positionnent radicalement contre le racisme, contre les néo-fascistes et autres groupes d'extrême droite, plus particulièrement si ceux-ci se proclament eux aussi skinheads"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a4bd8a9-4393-4970-9d0c-fe9acd012e06",
                        "source_entry_id": "3261318c-2665-3ed3-bb3c-6c8f60983a89",
                        "source_sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                        "target_lang_word": "Skinhead",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skinhead",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8132769-82c8-3068-806f-08ba97623e18",
                                        "entry_id": "f9507230-2898-39c8-92c4-4ba9d0204dfb",
                                        "glosses": [
                                            "Person der Skinheadbewegung, oftmals erkennbar an der ziemlich kurzen oder ganz entfernten Kopfbehaarung, schweren Stiefeln, Hosenträger, hochgekrempelter Jeans, Bomber-, Harrington- oder Donkeyjacke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfb5c54-8825-4517-bd05-760527f1ad0f",
                                                "sense_id": "e8132769-82c8-3068-806f-08ba97623e18",
                                                "text": "Die Skinheads sind nicht darüber erfreut, dass sie mit den rechtsgerichteten Skinheads (Boneheads) über einen Kamm geschoren werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aca8da8-2003-469e-aefb-9d7cb7ac3291",
                        "source_entry_id": "3261318c-2665-3ed3-bb3c-6c8f60983a89",
                        "source_sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                        "target_lang_word": "Skin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                        "entry_id": "12d77033-fc40-35a1-98e5-0335ff71a91f",
                                        "glosses": [
                                            "Angehöriger einer heterogenen (Jugend-)Gruppe, der sehr kurze Haare oder einen völlig kahl rasierten Kopf hat, spezielle Kleidung bevorzugt (etwa Bomber-, Harrington- oder Donkeyjacken sowie Stiefel) und unter Umständen links- oder rechtsradikale Ansichten vertritt, aber auch völlig unpolitisch sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0540e512-82be-4ff2-8aee-8bc6f29322b9",
                                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                                "text": "Treib dich nicht dauernd mit den Skins rum!"
                                            },
                                            {
                                                "example_id": "5e74cf07-32b9-48f8-9374-3972f9862438",
                                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                                "text": "Wir könnten den Skin da drüben nach der Uhrzeit fragen."
                                            },
                                            {
                                                "example_id": "70551d61-167b-48e5-a347-0a3b7720a050",
                                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                                "text": "„Zu den Skins fand er über das Bier, die Langeweile und den HSV - über die klassischen Einstiegsdrogen der kahlköpfigen Subkultur.“"
                                            },
                                            {
                                                "example_id": "1043b0c6-5e78-4839-ad1e-9b698110387a",
                                                "sense_id": "8c57f277-8f24-3f38-bcaf-0c64ce9db7de",
                                                "text": "„Laut Anklageschrift waren die Punks für die aus den Kantonen Zürich, Thurgau und St. Gallen stammenden Skins politische Gegner, die es mit Gewalt zu bekämpfen galt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a89b92-fa0c-46b9-bbd2-2549471b1a22",
                        "source_entry_id": "3261318c-2665-3ed3-bb3c-6c8f60983a89",
                        "source_sense_id": "afa95aa5-c943-3762-8bf1-4dea38c0c8fb",
                        "target_lang_word": "skinhead",
