                ],
                "senses": [
                    {
                        "sense_id": "a50ff2fe-30b1-3ac0-885e-cc0402394cd3",
                        "entry_id": "b60230f3-e684-3f73-88ed-eb10eba3786f",
                        "glosses": [
                            "Qui renvoie le son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25331141-9282-4a5b-b8ac-5a5bd5018c09",
                                "sense_id": "a50ff2fe-30b1-3ac0-885e-cc0402394cd3",
                                "text": "Cette voûte, cette église est bien résonnante."
                            },
                            {
                                "example_id": "f1290bda-19d7-42e7-9007-84f6cc9835a2",
                                "sense_id": "a50ff2fe-30b1-3ac0-885e-cc0402394cd3",
                                "text": "Ce salon n’est pas favorable à la musique, parce qu’il est trop résonnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "10850e27-4004-31c6-bcd3-383cf244d6e7",
                        "entry_id": "b60230f3-e684-3f73-88ed-eb10eba3786f",
                        "glosses": [
                            "Qui rend un grand son, beaucoup de son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e99d19-208b-4060-a9a9-382f2cb46059",
                                "sense_id": "10850e27-4004-31c6-bcd3-383cf244d6e7",
                                "text": "Ce violon est bien résonnant."
                            },
                            {
                                "example_id": "37d9ee69-4aab-44e3-8692-9c64d42cea1c",
                                "sense_id": "10850e27-4004-31c6-bcd3-383cf244d6e7",
                                "text": "Une voix claire et résonnante."
                            },
                            {
                                "example_id": "be06f4d9-0d8f-4454-9fd9-94d8fcc3b12b",
                                "sense_id": "10850e27-4004-31c6-bcd3-383cf244d6e7",
                                "text": "J’étais très ému, à cause de la voix résonnante du récitant, à cause de la musique, et surtout parce que la main d’Isabelle était toujours dans la mienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66feb3d1-ba4c-40b8-8762-abbe47eeb690",
                        "source_entry_id": "b60230f3-e684-3f73-88ed-eb10eba3786f",
