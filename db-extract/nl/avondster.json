                    },
                    {
                        "translation_id": "ee4727b5-cbef-4e84-86d9-1bfed58a987b",
                        "source_entry_id": "177456e7-53de-3dfb-a4e0-49c8c94cab5f",
                        "source_sense_id": "399f1c62-dc1a-329a-a01d-6c684c2cd147",
                        "target_lang_word": "Venus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3890faf8-f1df-3940-8705-b3e832ba0441",
                                        "entry_id": "4acc7248-f08a-3c31-8e41-b6cfc37c8a64",
                                        "glosses": [
                                            "The second planet in the Solar system, named for the goddess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b54891a3-37b0-4785-b4a1-3dfeca76b24f",
                                                "sense_id": "3890faf8-f1df-3940-8705-b3e832ba0441",
                                                "text": "Near-synonyms: morning star, Phosphorus, Eosphorus, Lucifer; evening star, Vesper, Hesperus"
                                            },
                                            {
                                                "example_id": "31161d56-abaa-459e-aa22-33043443ac40",
                                                "sense_id": "3890faf8-f1df-3940-8705-b3e832ba0441",
                                                "text": "Venus rises on the 1st day 1/4 to 5 a.m., and 4h. 25m. a.m. on the last day. […] She is now beginning to move northward."
                                            },
                                            {
                                                "example_id": "541292b9-2623-440a-bf75-fd8032ce1230",
                                                "sense_id": "3890faf8-f1df-3940-8705-b3e832ba0441",
                                                "text": "The robot craft, the fifth from the Soviet Union to land on Venus, is a module detached from Venera 13. It plunged through the dense, baking-hot carbon dioxide atmosphere and touched down in the foothills of a mountainous region known as Phoebe, just south of the Venusian equator and also below the active volcanic region of Beta. An identical lander, from Venera 14, is expected to reach Venus Friday and probably put down on the plains east of the Phoebe landing site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e97cb7b-47f5-35ac-b354-7ae1712b4503",
                                        "entry_id": "4acc7248-f08a-3c31-8e41-b6cfc37c8a64",
                                        "glosses": [
                                            "The goddess of love, beauty, fertility, and sexuality;"
                                        ],
                                        "tags": [
                                            "Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76407dc-f82e-4a32-a456-a3c9b116388f",
                                                "sense_id": "2e97cb7b-47f5-35ac-b354-7ae1712b4503",
                                                "text": "Their figures are universally models for brunette Venuses, and their feet arch like rainbows, and are Cinderellian in size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ce0431-f30c-330a-9ce7-cc0687e2f548",
                                        "entry_id": "4acc7248-f08a-3c31-8e41-b6cfc37c8a64",
                                        "glosses": [
                                            "A female given name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Venus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8890b0-ddf5-394b-a741-1c4a23fa7b11",
                                        "entry_id": "dbd3c657-0945-394e-a402-492d3aa833c2",
                                        "glosses": [
                                            "Sexual activity or intercourse, sex; lust, love."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78695325-0ea1-442f-9c78-a7f545eb8caa",
                                                "sense_id": "cb8890b0-ddf5-394b-a741-1c4a23fa7b11",
                                                "text": "Immoderate Venus in excess, as it is a cause, or in defect; so, moderately used, to some parties an only help, a present remedy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca0e00b-3060-3efd-b43c-165c9ef4922c",
                                        "entry_id": "dbd3c657-0945-394e-a402-492d3aa833c2",
                                        "glosses": [
                                            "Copper (a reddish-brown, malleable, ductile metallic element)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d8fd6e-b4cb-4bf7-928a-54abbf5c1e52",
                                                "sense_id": "aca0e00b-3060-3efd-b43c-165c9ef4922c",
                                                "text": "CRYSTALS of Venus or of copper, called also vitriol of Venus, is copper reduced into the form of vitriol by spirit of nitre, or by dissolving verdegris in good distilled vinegar, till the acid be saturated; it is very caustic and used to eat off proud flesh. It is also used by painters, and manufacturers, and sold under the name of distilled vinegar. See CHEMISTRY."
                                            },
                                            {
                                                "example_id": "c23499b9-6501-42e1-8677-778883bf7364",
                                                "sense_id": "aca0e00b-3060-3efd-b43c-165c9ef4922c",
                                                "text": "Another pair of terms which caused some confusion were Spirit of Saturn and Spirit of Venus, names suggesting compounds of lead and copper respectively. Jean Beguin described the preparation from minium and distilled vinegar of a liquid he called burning spirit of Saturn, e cause it was inflammable and he thought it was a compound of lead. Actually the lead takes no part in the reaction and the product of distilling lead acetate is impure acetone. Beguin’s terminology did not go without comment however, for Christopher Glaser later referred to ‘A burning Spirit of Saturn (as it is called) but rather, a Spirit of the Volatile Salt of Vinegar’. Tachenius referred to the product of distillation of copper acetate as ‘pretended spirit of Venus’ because it was really only distilled vinegar - the meaning which Macquer gave to the expression. It is typical of the confusion of terminology in early chemistry that the London Pharmacopoeia of 1721 gave the name Spiritus Veneris to sulphuric acid obtained by the distillation of copper sulphate."
                                            },
                                            {
                                                "example_id": "ce14ce15-566e-49f6-8dbc-cc9120c163c4",
                                                "sense_id": "aca0e00b-3060-3efd-b43c-165c9ef4922c",
                                                "text": "The association of the heavenly bodies with known metals and also with human organs and destinies goes back to ancient Chaldea, the land of astrologers. In Chaucer’s words: ‘The seven bodies eek, lo hear anon. Sol gold is, and Luna silver we declare; Mars yron, Mercurie is quyksilver; Saturnian leed; and Jubitur is tyn, and Venus coper, by my fathers kyn.’ […] Corresponding names were bestowed upon salts of these metals by the alchemists, and some of them have persisted down to the present day. Some examples are lunar caustic (silver nitrate); vitriol of Venus (copper sulphate); sugar of Saturn (lead acetate); and vitriol of Mars, or Martial vitriol (ferrous sulphate)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518620cc-5d8d-3e4d-96e4-de1a5f62001d",
                                        "entry_id": "dbd3c657-0945-394e-a402-492d3aa833c2",
                                        "glosses": [
                                            "Any Upper Palaeolithic statuette portraying a woman, usually carved in the round."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a628fab-b550-465d-affd-39489f383b95",
                                                "sense_id": "518620cc-5d8d-3e4d-96e4-de1a5f62001d",
                                                "text": "While the goddess statues obviously did function in a very public, domestic context, there is no evidence that they were androgynyous or that they were the primary cult of importance. There are probably just as many phalli in the Paleolithic as there are Venuses."
                                            },
                                            {
                                                "example_id": "ff4a6538-aea0-4a45-8e4f-12c9a762aae1",
                                                "sense_id": "518620cc-5d8d-3e4d-96e4-de1a5f62001d",
                                                "text": "However, a number of well-crafted studies in recent years have forcefully questioned—and perhaps refuted—the view that the Venuses were simply or solely goddesses."
                                            },
                                            {
                                                "example_id": "d013d9d5-6a60-4584-aa04-d08ffcf1cba6",
                                                "sense_id": "518620cc-5d8d-3e4d-96e4-de1a5f62001d",
                                                "text": "Her proportions, the stylistic elements, the choice of anatomical elements represented are characteristic of the Aurignacian or Gravettian Venuses, known especially from the statuary of Central and Eastern Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
