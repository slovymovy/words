                ],
                "senses": [
                    {
                        "sense_id": "3886fef5-e1ec-37ae-a1da-44feaf56e5cf",
                        "entry_id": "d6916b0e-ffd5-3def-8537-aa4c105d30a5",
                        "glosses": [
                            "ein Obstbaum, der Feigen als Früchte trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61319315-3be1-4441-997e-85f68c4a2f7e",
                                "sense_id": "3886fef5-e1ec-37ae-a1da-44feaf56e5cf",
                                "text": "Die Blätter des Feigenbaums werden in der Kunst als Stilmittel zur Verhüllung der Scham verwendet."
                            },
                            {
                                "example_id": "6fc5a8a5-9b85-4daa-bf2f-76570ee4025c",
                                "sense_id": "3886fef5-e1ec-37ae-a1da-44feaf56e5cf",
                                "text": "„In dem kleinen Garten von sechs Klafter im Geviert gab es nur Salat und einen Feigenbaum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "834f98bd-dd9a-4da1-a646-fccdc75afa71",
                        "source_entry_id": "d6916b0e-ffd5-3def-8537-aa4c105d30a5",
                        "source_sense_id": "3886fef5-e1ec-37ae-a1da-44feaf56e5cf",
