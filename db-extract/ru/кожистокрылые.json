                                        "entry_id": "65b0ab14-e280-3239-84e2-865f57a8dc8e",
                                        "glosses": [
                                            "Insecto con cercos en forma de pinza, tenaza o tijera en el extremo posterior del cuerpo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1784a50-9686-41bc-afc0-08542f992ec6",
                                                "sense_id": "5a5051dd-0e03-34c7-9b15-49848b359fc1",
                                                "text": "Las tijeretas prefieren áreas húmedas y oscuras."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37fc40ad-d05e-452a-884e-ba882865157f",
                        "source_entry_id": "bb66cadd-abc0-35d4-bf2e-7a889b041ba4",
                        "source_sense_id": "70b3f29c-71e8-3ad2-a429-f63aff588ef5",
                        "target_lang_word": "forfecchia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forfecchia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "9c95ab4b-f42b-33d8-8c1f-396538809540",
                                        "entry_id": "7e443cf6-a9a7-3126-a3be-d2222e4918f5",
