{
    "word_family": [
        "anxious",
        "anxiously",
        "anxiousness",
        "anti-anxiety"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdbeae1d-fc6d-3899-9bfb-4eee2a770f63",
                    "sense_definition": "An unpleasant state of mental uneasiness, nervousness, or concern about an uncertain event or outcome.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a wave of <w>anxiety</w> before the job interview began.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала прилив <w>тревоги</w> перед началом собеседования."
                            }
                        },
                        {
                            "text": "Waiting for the medical results caused him a great deal of <w>anxiety</w>.",
                            "target_lang_translations": {
                                "ru": "Ожидание результатов медицинского обследования причинило ему много <w>беспокойства</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneasiness",
                        "apprehension",
                        "disquiet"
                    ],
                    "antonyms": [
                        "calmness",
                        "confidence",
                        "serenity"
                    ],
                    "common_phrases": [
                        "feel anxiety",
                        "cause anxiety",
                        "social anxiety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятное состояние душевного беспокойства, нервозности или озабоченности по поводу неопределенного события или результата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревога",
                                "target_lang_sense_clarification": "чувство волнения в ожидании неприятности"
                            },
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "состояние озабоченности"
                            },
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "нервное напряжение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e1849e3-9164-37e1-aaec-ed8074d7e5a5",
                    "sense_definition": "A medical condition or psychological disorder characterized by persistent and excessive worry.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>anxiety</w> is a part of me, one that I’ve had to learn to deal with.",
                            "target_lang_translations": {
                                "ru": "Моя <w>тревожность</w> — это часть меня, с которой мне пришлось научиться справляться."
                            }
                        },
                        {
                            "text": "He was diagnosed with generalized <w>anxiety</w> disorder after months of panic attacks.",
                            "target_lang_translations": {
                                "ru": "Ему поставили диагноз «генерализованное тревожное <w>расстройство</w>» после нескольких месяцев панических атак."
                            }
                        }
                    ],
                    "synonyms": [
                        "distress"
                    ],
                    "common_phrases": [
                        "anxiety disorder",
                        "suffer from anxiety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское состояние или психологическое расстройство, характеризующееся постоянным и чрезмерным беспокойством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожность",
                                "target_lang_sense_clarification": "психологическая особенность или состояние"
                            },
                            {
                                "target_lang_word": "тревожное расстройство",
                                "target_lang_sense_clarification": "медицинский диагноз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1471034f-61a8-32a9-9638-bce68fec19dd",
                    "sense_definition": "An eager or distressing desire to do something or to please someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>anxiety</w> to please his new boss made him work late every night.",
                            "target_lang_translations": {
                                "ru": "Его <w>стремление</w> угодить новому боссу заставляло его работать допоздна каждую ночь."
                            }
                        },
                        {
                            "text": "The athlete's <w>anxiety</w> for success drove her to train harder than anyone else.",
                            "target_lang_translations": {
                                "ru": "<w>Жажда</w> успеха заставляла спортсменку тренироваться усерднее всех остальных."
                            }
                        }
                    ],
                    "synonyms": [
                        "solicitude",
                        "care"
                    ],
                    "antonyms": [
                        "indifference"
                    ],
                    "common_phrases": [
                        "anxiety to please"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страстное или мучительное желание сделать что-либо или угодить кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "сильное желание достичь чего-либо"
                            },
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "сильное, нетерпеливое желание"
                            },
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "внутреннее влечение к осуществлению чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79262805-a3f2-3bde-ba2f-816e811ffd64",
                    "sense_definition": "A physical state of restlessness and agitation, often felt as a tightness in the stomach.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physical <w>anxiety</w> in his chest made it difficult for him to breathe deeply.",
                            "target_lang_translations": {
                                "ru": "Физическое <w>беспокойство</w> в груди мешало ему дышать полной грудью."
                            }
                        },
                        {
                            "text": "She experienced a sense of <w>anxiety</w> and restlessness that kept her pacing the room.",
                            "target_lang_translations": {
                                "ru": "Она испытывала чувство <w>тревоги</w> и беспокойства, которое заставляло её мерить комнату шагами."
                            }
                        }
                    ],
                    "synonyms": [
                        "restlessness",
                        "disquietude"
                    ],
                    "common_phrases": [
                        "state of restlessness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое состояние беспокойства и возбуждения, часто ощущаемое как стеснение в животе или груди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "физическая неусидчивость"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "физическое ощущение дрожи или волнения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}