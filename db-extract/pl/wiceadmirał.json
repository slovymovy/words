                    {
                        "translation_id": "8f580534-1e56-45da-8eaf-c7c97f855fc0",
                        "source_entry_id": "f8d9c766-fca7-383b-bb8e-93547fe88a15",
                        "source_sense_id": "0c28478d-0cce-348b-8c38-86252f60bf34",
                        "target_lang_word": "Vizeadmiral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vizeadmiral",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84444055-1027-39e1-9451-c892343436d7",
                                        "entry_id": "0ff37003-c0bd-3954-8916-2ec113827762",
                                        "glosses": [
                                            "Rang zwischen dem Konteradmiral und dem Admiral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69cdf4d9-a79e-4d1d-9802-e4e25a01e7d9",
                                                "sense_id": "84444055-1027-39e1-9451-c892343436d7",
                                                "text": "Der Vizeadmiral ist der zweithöchste Rang der Marine."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                        "entry_id": "0ff37003-c0bd-3954-8916-2ec113827762",
                                        "glosses": [
                                            "Offizier im Range eines Vizeadmirals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a02ec2-40c5-4d5b-b106-c3fbb57834fc",
                                                "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                                "text": "Bring dem Vizeadmiral sein Fernrohr!"
                                            },
                                            {
                                                "example_id": "3e5eafcd-aa2f-4a68-bc1a-a95e321bfba4",
                                                "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                                "text": "„Bereits 1854 wurde [Erzherzog Maximilian von Österreich] zu deren Kommandant (im Range eines Konteradmirals, später eines Vizeadmirals) ernannt.“"
                                            },
                                            {
                                                "example_id": "741ee49b-68b7-4a07-9135-bef583805602",
                                                "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                                "text": "„Seit September 1940 ist er Vizeadmiral, am 14. März 1942 wird Hitler ihn zum Admiral befördern und weitere zehn Monate später zum Großadmiral.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19fd13c1-f1cb-45c5-bdb0-e508ebb0862b",
                        "source_entry_id": "f8d9c766-fca7-383b-bb8e-93547fe88a15",
                        "source_sense_id": "0c28478d-0cce-348b-8c38-86252f60bf34",
                        "target_lang_word": "вице-адмирал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вице-адмирал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e6d6b6d6-afaa-3845-8843-e8398a78a1e8",
                                        "entry_id": "a605a8d0-6db4-312c-a6e6-b7e3601a4a60",
                                        "glosses": [
                                            "воен.-морск. воинское звание высшего командного состава в военно-морском флоте, соответствующее общевойсковому званию генерал-лейтенант; лицо, имеющее такое звание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3fb0ac-d139-4c00-94ce-92ac69f0340f",
                                                "sense_id": "e6d6b6d6-afaa-3845-8843-e8398a78a1e8",
                                                "text": "Недавно третий сын кайзера, принц Альберт, отправился в Австрию в качестве вице-адмирала флота двуединой монархии."
                                            },
                                            {
                                                "example_id": "31496005-d6df-426e-bad3-7e1ce89b9771",
                                                "sense_id": "e6d6b6d6-afaa-3845-8843-e8398a78a1e8",
                                                "text": "В 1916 году произошел резкий карьерный скачок: в апреле Колчака произвели в контр-адмиралы, а уже в июне назначили командующим Черноморским флотом и одновременно «за отличия по службе» присвоили звание вице-адмирала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da10ed49-5cdc-3e0a-be44-6c27f1e3cba9",
                                        "entry_id": "a605a8d0-6db4-312c-a6e6-b7e3601a4a60",
                                        "glosses": [
                                            "истор. военно-морской чин III класса по Табели о рангах Российской империи — командующий флотом; лицо в этом чине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af4eed3-e4e0-4522-a63e-5e09bb1f6bb7",
                                                "sense_id": "da10ed49-5cdc-3e0a-be44-6c27f1e3cba9",
                                                "text": "С того времени, как вице-адмирал Крузенштерн совершил первое путешествие мореплавателей наших вокруг света, многие суда отправлены были, для отвоза разных потребностей на Камчатку, в Американские селения, а некоторые и для изысканий и обретений; все весьма удачно совершили возложенное на них дело; но все они шли, так сказать, по следам вице-адмирала Крузенштерна, который подал пример к совершению таковых плаваний."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
