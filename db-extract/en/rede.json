                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8d225d5f-6604-33fa-a2da-2c685e1bc1f5",
                        "entry_id": "efb48e84-f393-3177-ba40-958936b92cc1",
                        "glosses": [
                            "To advise."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8236b542-a981-4ab9-944c-a3ad4aa530ba",
                                "sense_id": "8d225d5f-6604-33fa-a2da-2c685e1bc1f5",
                                "text": "The meane whyle his squyer founde wryten vpon the crosse that Bagdemagus shold neuer retorne vnto the Courte ageyne / tyll he had wonne a knyȝtes body of the round table body for body / lo syr said his squyer / here I fynde wrytyng of yow / therfor I rede yow retorne ageyne to the Courte / that shalle I neuer said Bagdemagus",
                                "translation": "Meanwhile, his squire found written upon the cross that Bagdemagus should never again return to the court / till he had won a knight's body of the round table, body for body. / “Lo sir,” said his squire, / “here I find writing about you; / therefore I rede you return again to the court.” / “That I never shall,” said Bagdemagus.",
                                "english": "Meanwhile, his squire found written upon the cross that Bagdemagus should never again return to the court / till he had won a knight's body of the round table, body for body. / “Lo sir,” said his squire, / “here I find writing about you; / therefore I rede you return again to the court.” / “That I never shall,” said Bagdemagus."
                            },
                            {
                                "example_id": "091f2f22-1fc8-4be7-ba44-515bcb0a295c",
                                "sense_id": "8d225d5f-6604-33fa-a2da-2c685e1bc1f5",
                                "text": "But let me rede you, marry not."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fe32062-02dc-369b-9ba2-c8a36c3e9461",
                        "entry_id": "efb48e84-f393-3177-ba40-958936b92cc1",
                        "glosses": [
                            "To interpret (a riddle or dream); explain."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "945fd089-68e0-458d-8aa3-5da9f405f544",
                                "sense_id": "2fe32062-02dc-369b-9ba2-c8a36c3e9461",
                                "text": "The secret of Man's Being is still like the Sphinx's secret: a riddle that he cannot rede."
                            }
                        ]
                    }
