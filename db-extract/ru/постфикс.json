                    },
                    {
                        "translation_id": "607c4d92-bac9-4ba2-b1eb-190c112858c8",
                        "source_entry_id": "39f61bbd-43c6-3df4-891c-09a24527e8f8",
                        "source_sense_description": "аффикс, располагающийся в любом положении после корня",
                        "target_lang_word": "postfix",
