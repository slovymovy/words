                    {
                        "translation_id": "6d8a84cf-e547-40e6-aabb-626e4d22ff84",
                        "source_entry_id": "c0f027ce-fbdb-3db6-9792-c735e8ffdb40",
                        "source_sense_id": "cb036c85-5e20-3af3-90a8-0fe02426dfb0",
                        "target_lang_word": "aigle royal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aigle royal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0508f8c-ab49-3394-ae2e-4672eeb95632",
                                        "entry_id": "a040a0c0-74f8-30ec-acf9-670d8790a6d2",
                                        "glosses": [
                                            "Espèce d’oiseau rapace diurne (falconiforme) de la famille des accipitridés, grand aigle au plumage adulte brun sombre, à tête et au cou dorés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280abce2-b565-45f4-910a-a5d193bf86ab",
                                                "sense_id": "a0508f8c-ab49-3394-ae2e-4672eeb95632",
                                                "text": "L’aigle royal construit son gigantesque nid au sommet d’un arbre ou dans la paroi escarpée d’une falaise."
                                            },
                                            {
                                                "example_id": "78120964-41f2-4fe2-b655-c4c37a8ffe5c",
                                                "sense_id": "a0508f8c-ab49-3394-ae2e-4672eeb95632",
                                                "text": "En Mongolie, les Kazakhs chassent toujours avec des aigle royaux femelles, elles pèsent jusqu’à 7 kilos, presque un tiers de plus que les mâles, jugés moins agressifs."
                                            },
                                            {
                                                "example_id": "40d739af-4abc-4590-8678-356f3a6499dd",
                                                "sense_id": "a0508f8c-ab49-3394-ae2e-4672eeb95632",
                                                "text": "À l’état sauvage, les aigle royaux chassent en règle générale de petites proies. Une fois dressés, ils s’attaqueront à des loups ou à des lynx cinq fois plus grands qu’eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29b56cd-10e3-3c59-8a27-d50756d7f6c0",
                                        "entry_id": "a040a0c0-74f8-30ec-acf9-670d8790a6d2",
                                        "glosses": [
                                            "Autre nom (à tort) du pygargue à tête blanche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
