                                        "glosses": [
                                            "Concerning theological matters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c99798-3deb-4884-98bb-1a5dd329f4cf",
                                                "sense_id": "48dbbaee-1d82-3411-99ed-2faeea96e960",
                                                "text": "In the outer reaches of the Magasphere, it would be fair to say the advent of the first pope from the US has not been greeted with unbridled enthusiasm. Take Laura Loomer, the thirtysomething influencer and conspiracy theorist, whose verdict on Leo XIV was as instant as it was theologically uninformed: “Anti-Trump, anti-Maga, pro-open Borders, and a total Marxist like Pope Francis.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc58f76-0a40-408d-99b4-b7348eb7346d",
                        "source_entry_id": "5dccca9f-c2c9-3b6a-ae6a-60d5217fff10",
                        "source_sense_id": "0ec9662d-4452-3485-a276-44b7fbdfd114",
                        "target_lang_word": "theological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theological",
