                                        "entry_id": "ab781b85-6aac-3209-b443-645801f04c46",
                                        "glosses": [
                                            "Having naively optimistic hopes or outlooks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704a4633-cb75-4635-924c-a4dc117ee33f",
                                                "sense_id": "0aab78a7-e77f-3518-988c-3bced9e0967c",
                                                "text": "He was so starry-eyed when he started, but reality ground him down, and he became both more realistic and more practical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
