                        "examples": [
                            {
                                "example_id": "c2eee0da-16a5-4c8b-87b1-d97b6541642d",
                                "sense_id": "76802221-f933-3363-81f2-e0e5ee8c3428",
                                "text": "Men, like falle Glasses, generally represent their Complexion better than Nature has made it. And as they are likely to overflourish their own Case, ſo their Flattery is hardest to be discover'd ."
                            }
                        ]
                    },
                    {
