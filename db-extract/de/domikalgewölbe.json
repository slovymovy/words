                "senses": [
                    {
                        "sense_id": "23fdc69a-4ac8-35a0-9c4a-6f44ff56ae4e",
                        "entry_id": "12c39203-b058-3920-92e8-2d1718a35047",
                        "glosses": [
                            "eine stark einer Kuppel angenäherte Gewölbeform, über einem quadratischen Jochfeld mit steil ansteigenden, gebuchteten Kappen, meist als überhöhtes Rippengewölbe ausgeführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ad1b17-4b1f-41dc-89a4-463827b258b1",
                                "sense_id": "23fdc69a-4ac8-35a0-9c4a-6f44ff56ae4e",
                                "text": "\"Das Domikalgewölbe … ist eine besondere Form des Rippengewölbes (Kreuzgewölbes), das aus einer Vermischung des Konstruktionsprinzips der Kuppel mit dem des Rippengewölbes hervorgegangen ist.\""
                            },
                            {
                                "example_id": "81ca53fd-e7c0-4f9d-974b-455d9f64dd8d",
                                "sense_id": "23fdc69a-4ac8-35a0-9c4a-6f44ff56ae4e",
                                "text": "Domikalgewölbe entstanden gegen Mitte des 12. Jahrhunderts in mittelalterlichen Kirchen Südwestfrankreichs in den Regionen Anjou und Poitou."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
