                    },
                    {
                        "form_id": "80362894-dbd9-4a54-98ad-eba601e6e6bb",
                        "entry_id": "7fc54dce-2274-333a-b130-2e6828178ddc",
                        "tags": [
                            "diminutive",
                            "neuter"
                        ],
                        "form": "uitkijkje"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28a1dd04-c941-35e4-b50e-09aac5d13970",
                        "entry_id": "7fc54dce-2274-333a-b130-2e6828178ddc",
                        "glosses": [
                            "lookout (place from where one watches)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "97a1147f-c82d-437d-a014-1a29f10287cd",
                                "sense_id": "28a1dd04-c941-35e4-b50e-09aac5d13970",
                                "text": "De piraat ging naar de uitkijk om schepen in de verte te zoeken.",
                                "translation": "The pirate went to the lookout to search for ships in the distance.",
                                "english": "The pirate went to the lookout to search for ships in the distance."
                            },
                            {
                                "example_id": "85ca32c6-9d8a-4ddc-8b3c-20a43d030b54",
                                "sense_id": "28a1dd04-c941-35e4-b50e-09aac5d13970",
                                "text": "Vanuit deze uitkijk kun je de hele stad zien.",
                                "translation": "From this lookout, you can see the entire city.",
                                "english": "From this lookout, you can see the entire city."
                            },
                            {
                                "example_id": "c7b0cd49-f094-4669-a587-2347205df396",
                                "sense_id": "28a1dd04-c941-35e4-b50e-09aac5d13970",
                                "text": "Het uitkijkje op de berg biedt een adembenemend uitzicht.",
                                "translation": "The small lookout on the mountain offers a breathtaking view.",
                                "english": "The small lookout on the mountain offers a breathtaking view."
                            }
                        ]
                    },
                    {
                        "sense_id": "b73c0997-69fe-31c1-95b2-3e71bed3c0be",
                        "entry_id": "7fc54dce-2274-333a-b130-2e6828178ddc",
                        "glosses": [
                            "watch, lookout (act or duty of watching, being on the lookout)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "7648da19-0cff-4c6e-840f-976991b6b4e2",
                                "sense_id": "b73c0997-69fe-31c1-95b2-3e71bed3c0be",
                                "text": "Het is jouw beurt voor de uitkijk vannacht.",
                                "translation": "It's your turn for watch duty tonight.",
                                "english": "It's your turn for watch duty tonight."
                            },
                            {
                                "example_id": "de11be90-0425-47ca-bd13-acc56f665978",
                                "sense_id": "b73c0997-69fe-31c1-95b2-3e71bed3c0be",
                                "text": "Tijdens de oorlog was de uitkijk essentieel.",
                                "translation": "During the war, lookout was essential.",
                                "english": "During the war, lookout was essential."
                            },
                            {
                                "example_id": "b0c8b9b2-0df9-4d07-a6cf-b99aef9cdfca",
                                "sense_id": "b73c0997-69fe-31c1-95b2-3e71bed3c0be",
                                "text": "De kapitein zorgde ervoor dat er altijd iemand op uitkijk was.",
                                "translation": "The captain made sure there was always someone on lookout.",
                                "english": "The captain made sure there was always someone on lookout."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9769183-0b7b-399c-ab38-00f22211bdf9",
                        "entry_id": "7fc54dce-2274-333a-b130-2e6828178ddc",
                        "glosses": [
                            "watch (one who keeps watch)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "d983f735-8a93-45bd-bf39-d9b4c2a192ea",
                                "sense_id": "c9769183-0b7b-399c-ab38-00f22211bdf9",
                                "text": "De uitkijk waarschuwde ons voor naderend gevaar.",
                                "translation": "The watch warned us of approaching danger.",
                                "english": "The watch warned us of approaching danger."
                            },
                            {
                                "example_id": "614cf192-6aef-4d2f-bc07-fa842ca8908c",
                                "sense_id": "c9769183-0b7b-399c-ab38-00f22211bdf9",
                                "text": "Elke nacht was er een andere uitkijk aan boord.",
                                "translation": "Every night there was a different watch on board.",
                                "english": "Every night there was a different watch on board."
                            },
                            {
                                "example_id": "af253929-7986-44a9-8c9b-d7728608b8b7",
                                "sense_id": "c9769183-0b7b-399c-ab38-00f22211bdf9",
                                "text": "De uitkijk zag de vijandige schepen eerst.",
                                "translation": "The lookout was the first to see the hostile ships.",
                                "english": "The lookout was the first to see the hostile ships."
                            }
                        ]
                    }
