                "senses": [
                    {
                        "sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                        "entry_id": "04194a81-a918-3764-bb86-c2b78ab09a07",
                        "glosses": [
                            "Qui concerne une théorie du complot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a141c25-9ad7-48aa-9b44-56e61a5f18a2",
                                "sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                                "text": "Un nouveau palier dans la propagation des théories complotistes"
                            },
                            {
                                "example_id": "e94fdbe8-c233-496a-b631-955719095698",
                                "sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                                "text": "La confusion entre les deux domaines scientifiques est entretenue à dessein par la sphère climatosceptique et complotiste."
                            },
                            {
                                "example_id": "5ab1cff1-44cc-45cb-b694-bc876b5715be",
                                "sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                                "text": "Le youtubeur complotiste Silvano Trotta a ainsi critiqué les médias qui n’ont « rien montré de la fraude »."
                            },
                            {
                                "example_id": "e3c7bd45-137a-49d1-8e8f-1e0072590842",
                                "sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                                "text": "Les adultes qui veulent protéger les enfants victimes de violences sexuelles font l’objet de menaces et de sanctions. Ces adultes sont souvent affublés de qualificatifs tels que : manipulatrice, aliénante, imprudent, intrusif, complotiste, féministe, fanatique, caricatural, voire militant qui est le qualificatif le plus péjoratif dans l’esprit de la personne qui l’utilise comme une arme de langage."
                            },
                            {
                                "example_id": "ee0f2199-dfd2-4465-93a6-89d98d5ba226",
                                "sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                                "text": "Plus le réchauffement climatique se rend visible à travers diverses catastrophes naturelles, plus la communauté complotiste s’empare de la question de la modification intentionnelle du climat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c64ae1a-ff67-4a49-a240-5611666c7035",
                        "source_entry_id": "04194a81-a918-3764-bb86-c2b78ab09a07",
                        "source_sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
