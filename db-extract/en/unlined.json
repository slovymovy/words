    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "58710efd-20e3-3eb4-a76e-2e2ba12148d0",
                "word": "unlined",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "842f9cd3-bf88-32e5-96c6-dfaa611b2a77",
                        "entry_id": "58710efd-20e3-3eb4-a76e-2e2ba12148d0",
                        "glosses": [
                            "Without lining; without liner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c3ee8810-298e-41c9-b106-242b16ccc0ce",
                                "sense_id": "842f9cd3-bf88-32e5-96c6-dfaa611b2a77",
                                "text": "The bitter wind made me wish I hadn't opted for that unlined coat."
                            },
                            {
                                "example_id": "c7e5f9d6-c9a4-480e-ab86-16b62d26331a",
                                "sense_id": "842f9cd3-bf88-32e5-96c6-dfaa611b2a77",
                                "text": "To keep constructional costs to a minimum track formations were narrower than is now customary, many tunnels were unlined, timber was largely used for bridging, and 85 lb. per yd. rails were regarded as adequate."
                            }
                        ]
                    },
                    {
                        "sense_id": "1980f7db-46ee-3171-a701-5483d884e156",
                        "entry_id": "58710efd-20e3-3eb4-a76e-2e2ba12148d0",
                        "glosses": [
                            "Unmarked by lines, especially of the skin."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "06f1e359-afbe-4d93-bffb-26022977585f",
                                "sense_id": "1980f7db-46ee-3171-a701-5483d884e156",
                                "text": "Even on her 70th birthday, her skin remains unlined."
                            },
                            {
                                "example_id": "e8b78bc9-24e0-4a8e-a34c-9e7fb932d969",
                                "sense_id": "1980f7db-46ee-3171-a701-5483d884e156",
                                "text": "[...] all other classes are painted in unlined green."
                            }
                        ]
                    }
                ],
