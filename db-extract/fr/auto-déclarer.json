                ],
                "senses": [
                    {
                        "sense_id": "47ce7ca1-4a05-32d2-89fb-2c22e6cf5d73",
                        "entry_id": "cd0cd06f-825e-3ff9-af17-f5212be5cd2d",
                        "glosses": [
                            "Déclarer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec02bfe-d46f-427a-b278-05817e1be2f7",
                                "sense_id": "47ce7ca1-4a05-32d2-89fb-2c22e6cf5d73",
                                "text": "Les Pays Membres de l'OIE ont la possibilité d'auto-déclarer leur pays ou une zone de leur territoire indemne au regard de certaines maladies inscrites sur la liste de l’OIE, autres que celles pour lesquelles l’OIE a mis en place une procédure spécifique de reconnaissance officielle du statut sanitaire, telles la peste équine, la péripneumonie contagieuse bovine (PPCB), la fièvre aphteuse et l’encéphalopathie spongiforme bovine (ESB)."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd275cf4-4492-3ce4-b478-87e89d915fe9",
                        "entry_id": "cd0cd06f-825e-3ff9-af17-f5212be5cd2d",
                        "glosses": [
                            "Se déclarer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "f069a124-d6f8-4062-b48c-6c2e98b186d5",
                                "sense_id": "dd275cf4-4492-3ce4-b478-87e89d915fe9",
                                "text": "On peut s'auto-déclarer écrivain public."
                            },
                            {
                                "example_id": "a6a80c04-bc25-4730-81e1-d8812029bcf7",
                                "sense_id": "dd275cf4-4492-3ce4-b478-87e89d915fe9",
                                "text": "En effet, elle se caractérise par la présence d'éléments qui ne peuvent s'auto-déclarer, qui sont exclus du monnayage."
                            }
                        ]
                    }
                ],
