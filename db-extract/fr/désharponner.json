                "senses": [
                    {
                        "sense_id": "4ae1b8a8-b994-3102-83c7-53be00059472",
                        "entry_id": "c50eb580-0051-3dbf-a364-cad798811632",
                        "glosses": [
                            "Enlever le harpon de la plaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e686b79-9bd8-461a-a08f-15e5a18b356a",
                                "sense_id": "4ae1b8a8-b994-3102-83c7-53be00059472",
                                "text": "Fabio désharponne le crocodile, dont il jette le cadavre au loin."
                            },
                            {
                                "example_id": "3621ed0b-2062-4d52-a9f5-e196b22f9ced",
                                "sense_id": "4ae1b8a8-b994-3102-83c7-53be00059472",
                                "text": "Le truc le plus frustrant c’est sans doute le poisson énorme que l’on parvient à accrocher mais qui est si énorme qu’il parvient à se débattre et se désharponner, ce qui est bête dans cette histoire c’est que le poisson n’a aucune chance de survie et qu’on se sent un peu con quand il se barre sur le flanc, incapable de nager droit."
                            },
                            {
                                "example_id": "fcf140f8-de1b-473e-8e76-50807ae2eccc",
                                "sense_id": "4ae1b8a8-b994-3102-83c7-53be00059472",
                                "text": "C'est les pompiers qui sont venus la désharponner."
                            }
                        ]
                    }
