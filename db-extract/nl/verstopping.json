                            {
                                "example_id": "8a131917-d3de-4784-a40b-d3a137ece362",
                                "sense_id": "e8e6bbff-cbcd-3f06-880a-5e83b3d36f98",
                                "text": "Het is heel vervelend als last hebt van verstopping en je dus niet poepen kunt."
                            }
                        ]
                    },
                    {
                        "sense_id": "972293ac-f6d4-35be-9d92-4bd49779b967",
                        "entry_id": "187b4395-4c47-3032-8e30-4845f74a5a3a",
                        "glosses": [
