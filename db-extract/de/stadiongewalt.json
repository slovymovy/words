                    {
                        "sense_id": "5fb5654c-4676-305d-bcc2-4d8daf82620f",
                        "entry_id": "8b4156b0-b415-3ab1-a542-b2d5589fe14f",
                        "glosses": [
                            "in einem (Sport-)Stadion ausgeübte Gewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf26054-0328-47f0-bbcb-029018a43885",
                                "sense_id": "5fb5654c-4676-305d-bcc2-4d8daf82620f",
                                "text": "„Italiens Innenministerium fordert nun Konsequenzen gegen die zunehmenden [sic!] Stadiongewalt.“"
                            },
                            {
                                "example_id": "c4b3e045-2f0e-4117-a902-3e1ddb435971",
                                "sense_id": "5fb5654c-4676-305d-bcc2-4d8daf82620f",
                                "text": "„Bundesinnenminister Hans-Peter Friedrich ist zuversichtlich, dass die unterschiedlichen Interessengruppen beim Thema Stadiongewalt zusammenfinden werden.“"
                            },
                            {
                                "example_id": "c0e6a384-4bee-44d2-a459-d92fad51ae6c",
                                "sense_id": "5fb5654c-4676-305d-bcc2-4d8daf82620f",
                                "text": "„Nach den Ausschreitungen rund um das Pokalspiel zwischen Hannover 96 und Dynamo Dresden nimmt die Debatte um Stadiongewalt Fahrt auf.“"
                            },
                            {
                                "example_id": "d898060a-ad67-43c7-9986-4807eef6e126",
                                "sense_id": "5fb5654c-4676-305d-bcc2-4d8daf82620f",
                                "text": "„Reinhard Rauball hat vor einiger Zeit eine unmissverständliche Theorie in Sachen Kampf gegen Stadiongewalt kundgetan.“"
                            },
                            {
                                "example_id": "632cd5d4-d8ae-4f04-9b2f-1d0275f53f53",
                                "sense_id": "5fb5654c-4676-305d-bcc2-4d8daf82620f",
                                "text": "„Zuerst sollten wir an die Stadiongewalt in Deutschland denken, die aus den modernisierten Arenen der Bundesliga oft nur in untere Klassen – oder bei Länderspielen ins Ausland – verbannt worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
