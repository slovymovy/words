                    },
                    {
                        "translation_id": "f320c3e2-fbd1-4048-8973-ee2bd1c1d2ff",
                        "source_entry_id": "4ed71f72-1144-389b-bd68-a0debe58a4c4",
                        "source_sense_id": "8ce36c0e-8e9d-3c56-b866-123dd13b5bff",
                        "target_lang_word": "mandoline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandoline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77f8f082-add4-35f3-adb2-c9abeb647064",
                                        "entry_id": "c4835a2d-4eea-3524-b076-bbd04e05eb42",
                                        "glosses": [
                                            "Luth de petite taille, à cordes pincées, à touche garnie de frettes marquant les demi-tons, ayant de 4 à 12 cordes selon les modèles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f563c2f-8625-4b4b-b0ad-384b1833e06f",
                                                "sense_id": "77f8f082-add4-35f3-adb2-c9abeb647064",
                                                "text": "Souvent elle lui jetait des fleurs au visage ; accroupie devant ses pieds, elle tirait des airs d’une mandoline à trois cordes ; puis, lui posant sur l’épaule ses deux mains jointes, disait d’une voix timide :\n— Qu’avez-vous donc, cher seigneur ?"
                                            },
                                            {
                                                "example_id": "8b506013-51f5-483a-a06a-eb37e8ebab53",
                                                "sense_id": "77f8f082-add4-35f3-adb2-c9abeb647064",
                                                "text": "[…], les autres chantaient sur l’estrade, battant des mains et du tambour, tandis qu’un jeune garçon jouait de la flûte arabe et qu’un Juif grattait sur une espèce de mandoline..."
                                            },
                                            {
                                                "example_id": "b319c8e2-eb09-4be2-a40c-4a70fd5a2ef6",
                                                "sense_id": "77f8f082-add4-35f3-adb2-c9abeb647064",
                                                "text": "Les Mangaréviens, qui chantaient harmonieusement, se servaient fort mal de la mandoline et de l'accordéon, et jadis leurs instruments préférés pour les danses étaient les tambours en bois."
                                            },
                                            {
                                                "example_id": "dddcb151-efb1-450c-a9e1-7fdbcb7faa4e",
                                                "sense_id": "77f8f082-add4-35f3-adb2-c9abeb647064",
                                                "text": "La mandoline, c’est une minuscule guitare épileptique qui a une petite voix de tête et un gros ventre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f5048b8-94f7-30c7-abc8-d475a2dc9a2f",
                                        "entry_id": "c4835a2d-4eea-3524-b076-bbd04e05eb42",
                                        "glosses": [
                                            "Ustensile de cuisine, permettant de faire des lamelles, des tranches de légumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8983f4-decf-4b34-9583-91b93c35fd3d",
                                                "sense_id": "1f5048b8-94f7-30c7-abc8-d475a2dc9a2f",
                                                "text": "À la mandoline, taillez le fenouil, le poivron, les cébettes, les radis, les mini-betteraves, le concombre et les asperges."
                                            },
                                            {
                                                "example_id": "bd72c86e-e3e6-4b46-8473-a6e8f95a901d",
                                                "sense_id": "1f5048b8-94f7-30c7-abc8-d475a2dc9a2f",
                                                "text": "Les radis d’hiver se consomment surtout crus ou marinés au vinaigre, en pickles. Ils peuvent être tranchés finement à la ­mandoline, râpés ou taillés en bâtonnets, et font de délicieux snacks, juste ­saupoudrés de fleur de sel, piment, pignons et fromage frais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
