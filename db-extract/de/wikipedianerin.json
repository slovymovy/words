                                    {
                                        "sense_id": "00479b19-7a87-3377-80af-a39507e4420d",
                                        "entry_id": "edd5a2e9-851a-3d2f-8a38-3b2678d7aae4",
                                        "glosses": [
                                            "Vikipedi'de yazı yazan kişi"
                                        ],
                                        "tags": [
                                            "Vikipedi"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "942c49e0-0eb4-43de-81fa-7a1c84680225",
                                                "sense_id": "00479b19-7a87-3377-80af-a39507e4420d",
                                                "text": "Bir vikipedist olarak kaynaklara daha dikkat etmelisin."
                                            }
