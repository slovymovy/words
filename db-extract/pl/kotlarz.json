                            {
                                "target_word": "tinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df8233b5-482f-38a4-acac-bb1cd55f5f55",
                                        "entry_id": "1b9d2768-5d50-36f8-bd8e-293ff9a64001",
                                        "glosses": [
                                            "To work as a tinker."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75771252-e216-39c7-8d31-8aa3059ca754",
                                        "entry_id": "1b9d2768-5d50-36f8-bd8e-293ff9a64001",
                                        "glosses": [
                                            "To fiddle with something in an attempt to fix, mend or improve it, especially in an experimental or unskilled manner."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37012bd-41d0-4177-9317-d4a8ae3ea7da",
                                                "sense_id": "75771252-e216-39c7-8d31-8aa3059ca754",
                                                "text": "the broken bureau-lock and tinkered window-pane"
                                            },
                                            {
                                                "example_id": "9bcb5537-bee3-4b9c-a2ae-549d6c6a6e60",
                                                "sense_id": "75771252-e216-39c7-8d31-8aa3059ca754",
                                                "text": "As in much of biology, the most satisfying truths in ecology derive from manipulative experimentation. Tinker with nature and quantify how it responds."
                                            },
                                            {
                                                "example_id": "8f389f5c-7115-49b4-802b-850f51bf8d1e",
                                                "sense_id": "75771252-e216-39c7-8d31-8aa3059ca754",
                                                "text": "And because he wants to show that he is a dominant male, he tinkered the engine of his motorbike to make it even noisier."
                                            },
                                            {
                                                "example_id": "d85cd8ce-eb18-4b12-8c76-a45609d2ff74",
                                                "sense_id": "75771252-e216-39c7-8d31-8aa3059ca754",
                                                "text": "We're not just talking about changes that tinker around the edges - we're looking to take advantage of some of the world's latest digital and tech developments to improve our service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13f8f603-992a-4393-9b31-e94fb1ad587e",
                        "source_entry_id": "fafd2ecc-a3f3-31b1-a334-7da6c7de26fe",
