                "senses": [
                    {
                        "sense_id": "3e849435-129c-3745-a4fe-acb1294efcd4",
                        "entry_id": "cb72a542-9202-373a-a709-ffd1e0f447b4",
                        "glosses": [
                            "женск. к военнослужащий; женщина, состоящая на военной службе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf385d8-dc9d-4df3-b141-402c461b36c3",
                                "sense_id": "3e849435-129c-3745-a4fe-acb1294efcd4",
                                "text": "― Он уехал на правый фланг, будет только к вечеру, ― она оглядела Даренского опытным взором военнослужащей и спросила: ― Вы, наверное, из штаба фронта, товарищ подполковник?"
                            },
                            {
                                "example_id": "97e9ec10-02a1-4381-a74e-078042a26b63",
                                "sense_id": "3e849435-129c-3745-a4fe-acb1294efcd4",
                                "text": "Уже совсем другим тоном она сказала, что ее дочь ― очень милая девушка, окончившая гимназию, работает переводчицей у полковника, она тоже, как Вайс, военнослужащая."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6934969-3704-4966-9126-5868728973ef",
                        "source_entry_id": "cb72a542-9202-373a-a709-ffd1e0f447b4",
                        "source_sense_id": "3e849435-129c-3745-a4fe-acb1294efcd4",
                        "target_lang_word": "servicewoman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servicewoman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9909ad4b-94b4-3261-b26b-6a9185f60c54",
                                        "entry_id": "2adc6465-753e-307b-abdb-71664b13819e",
                                        "glosses": [
                                            "A woman who serves in the armed forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8673e5ae-420a-48c2-88ef-45d347078279",
                                                "sense_id": "9909ad4b-94b4-3261-b26b-6a9185f60c54",
                                                "text": "The run honors the 160 women who have been killed in Iraq and Afghanistan. There's one mile for each of the fallen servicewomen."
                                            },
                                            {
                                                "example_id": "fa5d95b3-4724-439e-844c-0d18dd8139d6",
                                                "sense_id": "9909ad4b-94b4-3261-b26b-6a9185f60c54",
                                                "text": "Unlike some Western countries it remains rare for Russian servicewomen to go to war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
