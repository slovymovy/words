    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "52d76198-9143-36d5-8250-0ce6707b4125",
                "word": "understory",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "666462da-350c-4a66-b703-6167def1fd3b",
