                                        "entry_id": "a8938272-e94c-32f5-9df6-80a2f5598d48",
                                        "glosses": [
                                            "Frucht, die durch eine Mutation aus dem Pfirsich entsteht und eine glatte Haut hat"
                                        ],
                                        "tags": [
                                            "Obst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6266a3a5-ada5-4702-8e0a-9468a767d9f1",
                                                "sense_id": "58d86bfc-6268-3c01-8f1e-c46959dfca05",
                                                "text": "Eine Nektarine hat, im Gegensatz zum Pfirsich, eine glatte Haut."
                                            },
                                            {
                                                "example_id": "bff897b6-5ae8-402e-9c6d-8d1387f0ac41",
                                                "sense_id": "58d86bfc-6268-3c01-8f1e-c46959dfca05",
                                                "text": "Manchmal wachsen Nektarinen an einem Pfirsichbaum."
                                            },
                                            {
                                                "example_id": "51ad1821-f1d5-4228-af0c-732299949045",
                                                "sense_id": "58d86bfc-6268-3c01-8f1e-c46959dfca05",
                                                "text": "„Einige wenige Namen hatte ich mir gemerkt, doch als ich mich einmal bei meinem Vater nach ihnen erkundigte, musste er plötzlich die Nektarinen umsortieren.“"
                                            }
                                        ],
