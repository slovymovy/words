        "fr-extract.jsonl": [
            {
                "entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                "word": "ossuaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa91c35b-7e18-443a-9d75-e8ee586b5c26",
                        "entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "ossuaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48a89ae4-d44a-36a0-b590-b99d1b9cefbc",
                        "entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                        "glosses": [
                            "Amas d’ossements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce4e1b5-8c84-416c-8c11-c85f4bbe9031",
                                "sense_id": "48a89ae4-d44a-36a0-b590-b99d1b9cefbc",
                                "text": "D’où venait cet ossuaire? M. Ledru avait présidé à l’exhumation des rois à Saint-Denis, et il avait pris dans chaque tombeau ce qui lui avait plu."
                            },
                            {
                                "example_id": "7dc94af3-09f1-49f6-b704-95bd4676d42f",
                                "sense_id": "48a89ae4-d44a-36a0-b590-b99d1b9cefbc",
                                "text": "— Aussi la prairie, théâtre sinistre de combats incessants et terribles, n’est-elle en réalité qu’un vaste ossuaire, où s’engloutissent obscurément chaque année, dans une guerre d’embuscades sans merci, des milliers d’hommes intrépides."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8f142d2-b7fd-31c5-9f15-d508b1bee0ab",
                        "entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                        "glosses": [
                            "Endroit couvert où l’on met des ossements humains."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "2996ce12-67d1-44b6-a335-c6092466d46a",
                                "sense_id": "b8f142d2-b7fd-31c5-9f15-d508b1bee0ab",
                                "text": "L'ensemble monumental du Vieil‐Armand comprend le cimetière du Silberloch inauguré en 1922, rassemblant 1 264 tombes et 6 ossuaires de 64 corps non identifiés."
                            },
                            {
                                "example_id": "5674103e-1a95-4f6d-a083-56e9e86d0f7a",
                                "sense_id": "b8f142d2-b7fd-31c5-9f15-d508b1bee0ab",
                                "text": "Parmi les plus célèbres en France se trouve l’ossuaire de Douaumont, près de Verdun, dont les murs intérieurs sont tapissés des noms de ceux tombés au cours d'une des plus sanglantes batailles de la Première Guerre mondiale."
                            },
                            {
                                "example_id": "aea84397-8645-49f3-9dd1-b5e388c0d55b",
                                "sense_id": "b8f142d2-b7fd-31c5-9f15-d508b1bee0ab",
                                "text": "Tout cimetière traditionnel dispose d’une parcelle d’inhumation des urnes cinéraires, d’une parcelle de dispersion, d'un columbarium et d’un ossuaire."
                            },
                            {
                                "example_id": "e6f03439-91e6-43d8-94b6-d04c9face225",
                                "sense_id": "b8f142d2-b7fd-31c5-9f15-d508b1bee0ab",
                                "text": "— Groupe de combattants réalisé par le sculpteur Real del Sarte pour la pyramide-ossuaire de la ferme de Navarin. Le monument est situé au cœur même du champ de bataille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "002c3973-6957-4e24-b491-407975425ef7",
                        "source_entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                        "source_sense_description": "Endroit",
                        "target_lang_word": "Beinhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beinhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                        "entry_id": "ecc9dde0-8d0f-3f09-99bc-0635bbe16615",
                                        "glosses": [
                                            "ein kapellenartiger Bau auf Friedhöfen, in dem bei der Anlage von neuen Gräbern gefundene Gebeine untergebracht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72fadee-e23e-4531-a566-7d805b0796ff",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„Mit der Jahrhundertwende zum 20. Jahrhundert kamen Beinhäuser immer mehr aus der Mode. Viele wurden abgebrochen oder zweckentfremdet, …“"
                                            },
                                            {
                                                "example_id": "3ff32b47-a5fd-47b3-9bb5-c0cacc653f0a",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„In Süddeutschland versah man außerdem die im Beinhaus aufbewahrten Schädel mit Hausmarken.“"
                                            },
                                            {
                                                "example_id": "2b099146-80cc-42f0-baf6-3ad90317485a",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„Das erinnert an die gruseligen Schilderungen von Menschenopfern der römischen Autoren, man darf aber nicht vergessen, dass noch im Mittelalter Tote in vielen Gegenden Europas in Grüften und Beinhäusern, sogenannten Ossuarien, ausgestellt waren.“"
                                            },
                                            {
                                                "example_id": "ce8eb471-f3ba-4065-b3a5-3a5f86f95a4e",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„Warren schüttelte mir noch die Hand, schlang die Kabelrolle über die Schulter und verschwand in diesem unbeschreiblichen Beinhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b88dd10a-fe00-4b7b-8b59-1b12f81f8e73",
                        "source_entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                        "source_sense_description": "Endroit",
                        "target_lang_word": "Ossuarium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ossuarium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd1f92d-506b-384a-9fff-8895935619be",
                                        "entry_id": "b1a94106-2b25-3d4d-8331-95168bf5ecad",
                                        "glosses": [
                                            "Beinhaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b13849-bf4a-4f0a-9c0d-ed888ebf8a1f",
                                                "sense_id": "1fd1f92d-506b-384a-9fff-8895935619be",
                                                "text": "Das ist unser Ossuarium."
                                            },
                                            {
                                                "example_id": "5a121f79-04fc-4194-aabc-1fc49e3fd526",
                                                "sense_id": "1fd1f92d-506b-384a-9fff-8895935619be",
                                                "text": "„Das erinnert an die gruseligen Schilderungen von Menschenopfern der römischen Autoren, man darf aber nicht vergessen, dass noch im Mittelalter Tote in vielen Gegenden Europas in Grüften und Beinhäusern, sogenannten Ossuarien, ausgestellt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c86b6c10-cd06-38fa-a379-88ea5b08ff00",
                                        "entry_id": "b1a94106-2b25-3d4d-8331-95168bf5ecad",
                                        "glosses": [
                                            "Urne für Gebeine"
                                        ],
                                        "tags": [
                                            "im Altertum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c58c59f-b43d-464d-a0a1-8c169db062b4",
                                                "sense_id": "c86b6c10-cd06-38fa-a379-88ea5b08ff00",
                                                "text": "Die Grabkammer beherbergte mehrere Ossuarien."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db5e5ff7-e5b3-4b86-a336-45e1d90207d7",
                        "source_entry_id": "b29cf79a-b4f3-3d0f-83ea-5a589ec87f3e",
                        "source_sense_description": "Endroit",
                        "target_lang_word": "Beingrab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beingrab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da466481-3b93-3e6b-8d40-b648634e7421",
                                        "entry_id": "d8d0eb69-0c35-3db9-81fa-779553fbee4c",
                                        "glosses": [
                                            "kollektive Grabstätte für die Knochen (Gebeine) Verstorbener"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c71d719e-c3c2-475e-902b-bb28c9122fc0",
                                                "sense_id": "da466481-3b93-3e6b-8d40-b648634e7421",
                                                "text": "„Der Fund eines Beingrabes aus der Glockenbecherkultur lässt auf eine sehr frühe Besiedlung seit der späten Jungsteinzeit (Neolithikum) schließen.“"
                                            },
                                            {
                                                "example_id": "87afd062-b962-4bfc-b404-b4d8b2483980",
                                                "sense_id": "da466481-3b93-3e6b-8d40-b648634e7421",
                                                "text": "„Diese letztere Höhlung ist die auch sonst übliche des Beingrabes, Ostothek, während jene beiden Behälter für Flüssigkeit zu sein scheinen, bestimmt bei der Todtenfeier zur Aufnahme von Wasser und Wein auf dessen Wirkungen die Bilder von Hermes und Aphrodite anspielen mochten.“"
                                            },
                                            {
                                                "example_id": "4a800b49-b462-4e8f-b24e-a151e5c5db25",
                                                "sense_id": "da466481-3b93-3e6b-8d40-b648634e7421",
                                                "text": "„Aus Beingräbern bei Bylan und aus Grabhügeln bei Straškov sind uns ganze Serien erhalten.“"
                                            },
                                            {
                                                "example_id": "738657be-b14d-4d26-8d9b-fd7be82a6393",
                                                "sense_id": "da466481-3b93-3e6b-8d40-b648634e7421",
                                                "text": "„Nur der Lieblingsjünger Johannes konnte in einem Beingrab wiedergefunden werden: es fehlen Kreuz und Maria.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
