                "senses": [
                    {
                        "sense_id": "951e9fa7-78b8-3a71-bf7e-1d1d2113a7e8",
                        "entry_id": "f8635778-e54b-34d1-818a-defcee6b436c",
                        "glosses": [
                            "Opposé aux prisons, au système carcéral."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "3dd1089f-0bfb-49ef-b988-6c7c4d4540d4",
                                "sense_id": "951e9fa7-78b8-3a71-bf7e-1d1d2113a7e8",
                                "text": "Cent dix personnes ont été interpellées dimanche après-midi à Paris lors d'une manifestation anticarcérale aux abords de la prison de la Santé, dans le XIVᵉ arrondissement."
                            },
                            {
                                "example_id": "aceec8e3-e4fe-4b98-9b68-0d436775e934",
                                "sense_id": "951e9fa7-78b8-3a71-bf7e-1d1d2113a7e8",
                                "text": "Cette « marche contre l'enfermement et en solidarité avec les personnes incarcérées à la prison de la Santé », organisée par différents collectifs anticarcéraux, devait partir vers 15 heures de la place Denfert-Rochereau et arriver aux abords de la prison, pour un « rassemblement musical » prévu de 16 heures à 20 heures, selon le tract mis en ligne par les organisateurs."
                            }
                        ]
                    }
                ],
