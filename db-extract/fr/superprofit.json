                "senses": [
                    {
                        "sense_id": "3b672381-439b-3cb6-b070-b2607224b69e",
                        "entry_id": "b9dc5ae9-91a9-306e-a448-b96caeca2278",
                        "glosses": [
                            "Profit dépassant la normale."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "e3cdd318-c625-4c83-a35d-4799207d4376",
                                "sense_id": "3b672381-439b-3cb6-b070-b2607224b69e",
                                "text": "Il s’agit de mettre un terme aux superprofits dont bénéficient actuellement les cigarettiers en sacrifiant la santé et les finances publiques des Français."
                            },
                            {
                                "example_id": "d071e599-df33-4113-94f7-8325526afe01",
                                "sense_id": "3b672381-439b-3cb6-b070-b2607224b69e",
                                "text": "Le patron de Total s’est également efforcé de déminer les critiques récurrentes sur les bénéfices du groupe en opposant «les fantasmes» des «superprofits» ou les «profits insolents de Total» à la «réalité» de ses investissements."
                            },
                            {
                                "example_id": "d1cf28c2-43b4-4722-9536-550b15193b7d",
                                "sense_id": "3b672381-439b-3cb6-b070-b2607224b69e",
                                "text": "\"En plus, beaucoup d’États veulent emboîter le pas à l’Australie, qui prépare une taxation des superprofits des entreprises minières, poursuit-il."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f0bd6f1-9a20-472f-abcd-9da79912e2a0",
                        "source_entry_id": "b9dc5ae9-91a9-306e-a448-b96caeca2278",
                        "source_sense_id": "3b672381-439b-3cb6-b070-b2607224b69e",
                        "target_lang_word": "superprofit",
