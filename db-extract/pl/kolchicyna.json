                                    {
                                        "sense_id": "c6694198-ff66-361b-8dd4-bdaf653455d6",
                                        "entry_id": "b3308c94-bfee-3bf7-95eb-ea7076aa8ab8",
                                        "glosses": [
                                            "A highly toxic alkaloid, chemical formula C₂₂H₂₅NO₆, originally extracted from plants of the genus Colchicum and formerly used to treat rheumatic complaints, now used mainly in the treatment of gout."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d207293-1a75-4ca2-9589-f48fdaeb83c2",
                                                "sense_id": "c6694198-ff66-361b-8dd4-bdaf653455d6",
                                                "text": "Gloriosa superba: spectacularly beautiful climbing lily. Roots, stalks, leaves contain an acrid narcotic, superbine, as well as colchicine and choline. Three grains of colchicine are fatal. Hawaii."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49343a34-e966-4aa0-aa76-3b334a3d609c",
                        "source_entry_id": "248beae7-ad61-3a8b-9c39-59ccff3fcfcc",
                        "source_sense_id": "071bde81-28b3-3ad3-80b9-dc46b3666311",
                        "target_lang_word": "colchicine",
                        "target_lang_code": "fr",
