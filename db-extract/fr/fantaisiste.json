                "senses": [
                    {
                        "sense_id": "e603e8cc-836f-3ba8-bae1-bb0b86415c6e",
                        "entry_id": "9c3109d7-ad4a-3f54-bf39-b2aef8d62cea",
                        "glosses": [
                            "Qui est controuvé, imaginaire, en parlant des choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04aace54-54a8-453d-a0e0-042d4e236cba",
                                "sense_id": "e603e8cc-836f-3ba8-bae1-bb0b86415c6e",
                                "text": "Récit fantaisiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1d173d8-4447-3f1d-9ecd-71173fae7daa",
                        "entry_id": "9c3109d7-ad4a-3f54-bf39-b2aef8d62cea",
                        "glosses": [
                            "Qui semble tiré de la fantaisie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c605120d-46ef-4d3f-9080-ada5432d24a4",
                                "sense_id": "c1d173d8-4447-3f1d-9ecd-71173fae7daa",
                                "text": "Ces champs ne sont-ils pas à moi, et ces bois chanteurs, et ce ciel que raye continuellement le vol fantaisiste des martinets ?"
                            },
                            {
                                "example_id": "9306dfbe-00c4-4468-9946-13118105292b",
                                "sense_id": "c1d173d8-4447-3f1d-9ecd-71173fae7daa",
                                "text": "Rarement une machine sortait de leurs mains en état de rouler sans accrocs. Les plus fantaisistes possibilités de pannes se nichaient dans tous les organes : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "60a6bdcf-166f-3382-b829-7a9797132249",
                        "entry_id": "9c3109d7-ad4a-3f54-bf39-b2aef8d62cea",
                        "glosses": [
                            "Qui a plus d’imagination que de sens du réel, en parlant des personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e4c9370-e819-4a6e-8ae8-b977db8868a0",
                                "sense_id": "60a6bdcf-166f-3382-b829-7a9797132249",
                                "text": "Il est amusant, mais par trop fantaisiste."
                            },
                            {
                                "example_id": "845bfaab-6882-4866-b2cf-806ecb75fdc1",
                                "sense_id": "60a6bdcf-166f-3382-b829-7a9797132249",
                                "text": "Historien fantaisiste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "193397c4-5eb1-47a2-bfd9-8aa506168a5a",
                        "source_entry_id": "9c3109d7-ad4a-3f54-bf39-b2aef8d62cea",
