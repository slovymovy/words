                ],
                "senses": [
                    {
                        "sense_id": "96d4c8f8-b938-3936-ab7f-18b0a4df19ed",
                        "entry_id": "e0d5fb13-5cd2-3ba4-8669-3bbea58aa7f2",
                        "glosses": [
                            "met een snavel of andere mondopening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277f22d5-45b8-4b25-bf77-f9b1ccd99f50",
                                "sense_id": "96d4c8f8-b938-3936-ab7f-18b0a4df19ed",
                                "text": "Elk vogeltje zingt zoals het gebekt is, is een spreekwoord. Maar elk vogeltje is gebekt zoals het eet is ook waar."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf8981f-1000-39bc-83d3-eea3bea6d5be",
                        "entry_id": "e0d5fb13-5cd2-3ba4-8669-3bbea58aa7f2",
                        "glosses": [
                            "het spraakvermogen gebruikend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0fdd493e-80be-405e-9173-5eaa762cac52",
                                "sense_id": "0bf8981f-1000-39bc-83d3-eea3bea6d5be",
                                "text": "De rechtse tiran vindt dat de anderen hun bek moeten houden; de linkse tiran vindt dat de anderen gebekt moeten zijn zoals hij."
                            }
                        ]
                    },
                    {
                        "sense_id": "0926ea0b-8341-389a-b411-91a9f664001c",
                        "entry_id": "e0d5fb13-5cd2-3ba4-8669-3bbea58aa7f2",
                        "glosses": [
                            "met een snavel in een kleur die afwijkt van het lichaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3727b0-af94-4c2f-87a1-a3b14455470f",
                                "sense_id": "0926ea0b-8341-389a-b411-91a9f664001c",
                                "text": "Het 519 squadron heeft als embleem in blauw een afgerukte havikskop van goud, gebekt van zilver en rood getongd."
                            }
                        ]
                    }
                ],
