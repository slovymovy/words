                "senses": [
                    {
                        "sense_id": "f8161993-d340-3600-b361-fd0f379a5ffa",
                        "entry_id": "c07bc618-c197-3aff-abb5-cfe70521373e",
                        "glosses": [
                            "Obsessionnel, en parlant d'un trait de caractère, d'une personnalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e783f76-e716-4b3b-80ff-2f6ee2b70185",
                                "sense_id": "f8161993-d340-3600-b361-fd0f379a5ffa",
                                "text": "La notion de schizoïdie se justifierait probablement chez les personnes pour lesquelles aucun fondement psychopathologique, par exemple anxieux ou anankastique, n'expliquerait la perte de contact avec l'entourage …."
                            },
                            {
                                "example_id": "70a14d42-9f81-4506-9185-672946c90386",
                                "sense_id": "f8161993-d340-3600-b361-fd0f379a5ffa",
                                "text": "La personnalité anankastique - Prévalence : 1 % de la population générale. Également qualifié de personnalité obsessionnelle-compulsive, le sujet anankastique manifeste de la prudence, du doute et de l'indécision excessifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e9c9244-c621-46c8-991c-ffdac75cdcb2",
                        "source_entry_id": "c07bc618-c197-3aff-abb5-cfe70521373e",
                        "source_sense_id": "f8161993-d340-3600-b361-fd0f379a5ffa",
                        "target_lang_word": "anankastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anankastisch",
