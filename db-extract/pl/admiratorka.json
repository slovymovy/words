                    }
                ],
                "translations": [
                    {
                        "translation_id": "78e061d3-9371-49ff-928d-3be32853c21e",
                        "source_entry_id": "c9ddf724-00a4-346c-afc7-c809f5137430",
                        "source_sense_id": "4e0a9526-c494-3fa6-b2fc-792b7bc63c29",
                        "source_sense_description": "weibliche Person, die jemanden/etwas bewundert, hochschätzt",
                        "target_lang_word": "Bewunderin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewunderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d163cc3c-6f41-3b63-82ec-d32ec1198be7",
                                        "entry_id": "b8640f07-1697-30b2-8cf9-4d13edbd6c10",
                                        "glosses": [
                                            "weibliche Person, die jemanden oder etwas sehr verehrt, wertschätzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d693919-d23d-4212-944c-bfb53ed9a928",
                                                "sense_id": "d163cc3c-6f41-3b63-82ec-d32ec1198be7",
                                                "text": "„Er war verheiratet mit der um sechzehn Jahre jüngeren Contessa Clara Carrara Spinelli, einer persönlichen Freundin Verdis und treuen Bewunderin von dessen Werken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bffc9067-6a8a-4a02-a003-130debdd672a",
                        "source_entry_id": "c9ddf724-00a4-346c-afc7-c809f5137430",
                        "source_sense_id": "4e0a9526-c494-3fa6-b2fc-792b7bc63c29",
                        "source_sense_description": "weibliche Person, die jemanden/etwas bewundert, hochschätzt",
                        "target_lang_word": "Verehrerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verehrerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b54a6363-0ab7-3690-b539-82b002c627ca",
                                        "entry_id": "a57248bd-93e5-3542-b021-d79ca3b11db1",
                                        "glosses": [
                                            "weibliche Person, die jemanden anderen (oft heimlich) liebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d4b0155-ab72-4972-b4cb-b2fd4c272e1c",
                                                "sense_id": "b54a6363-0ab7-3690-b539-82b002c627ca",
                                                "text": "Er hat eine heimliche Verehrerin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                        "entry_id": "a57248bd-93e5-3542-b021-d79ca3b11db1",
                                        "glosses": [
                                            "weibliche Person, die jemand anderen bewundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a9f3f8-c531-4573-8d5c-fc4cea39cf76",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Michalis' Erzählung ist in der Gegenwart angelangt, er drückt seine Kippe im leeren Wasserglas aus und bricht auf in Richtung Bar, wo sich zwei Verehrerinnen um ihn balgen.“"
                                            },
                                            {
                                                "example_id": "a5174400-3bdf-431a-abbf-92a2ed5bba76",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Er stellte mich seiner Verehrerin vor und sagte, er bringe mich nach Rom, wo ich das Ordensgewand des heiligen Franziskus nehmen würde.“"
                                            },
                                            {
                                                "example_id": "467e8064-712f-4d09-95a2-c9d7452580d2",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Manchmal hatten mir Verehrerinnen Blumen ins Hotel geschickt.“"
                                            },
                                            {
                                                "example_id": "296d5b7c-54e6-4be9-bc6d-a37b293fe4af",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Doch er schenkte seinen vielen Verehrerinnen keinen Funken Aufmerksamkeit und hatte es nie getan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
