                            {
                                "example_id": "8e91491a-2a00-4fcb-85d0-6fb94b7f5cb0",
                                "sense_id": "2ff4e76f-a95e-3d7b-8aa4-99a843a0b9f1",
                                "text": "Er komt nu een vervolgonderzoek om te bekijken of het verstandig is om elke ic-patiënt meteen een antischimmelmiddel te geven."
                            },
                            {
                                "example_id": "7a17211e-3e88-4447-a5d8-32b8afc6fd3b",
                                "sense_id": "2ff4e76f-a95e-3d7b-8aa4-99a843a0b9f1",
                                "text": "De grootste farmaceutische bedrijven hebben de afgelopen twee jaar meer gedaan dan daarvoor om nieuwe antibiotica en antischimmelmiddelen te ontwikkelen. Ze hebben zich ook meer ingespannen om de toegankelijkheid van bestaande middelen in armere landen te vergroten, al blijft dat een groot probleem."
                            }
