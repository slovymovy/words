                                        "entry_id": "a299d324-a122-3a1d-9632-bdda1758b930",
                                        "glosses": [
                                            "A priest or mage who uses magic based on nature or trees."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81f9655b-5c6a-4924-8115-8d9f8b3adfb7",
                        "source_entry_id": "754d8261-7c78-39a3-a7e0-1a7a93824d4d",
                        "source_sense_id": "194dbfb9-5b3e-33ee-a62f-202fcb73d06a",
