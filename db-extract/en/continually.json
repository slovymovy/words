        "de-extract.jsonl": [
            {
                "entry_id": "30701923-1281-30d1-9126-aba23a41a956",
                "word": "continually",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0048737e-3bda-37be-9e7e-d177607d708b",
                        "entry_id": "30701923-1281-30d1-9126-aba23a41a956",
                        "glosses": [
                            "ständig, dauernd, andauernd, fortwährend, unaufhörlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e1c41f-3ea0-4603-a815-6e3499d073e3",
                                "sense_id": "0048737e-3bda-37be-9e7e-d177607d708b",
                                "text": "\"He bullied and punished me; not two or three times in the week, nor once or twice in the day, but continually: every nerve I had feared him, and every morsel of flesh in my bones shrank when he came near.\"",
                                "translation": "Er tyrannisierte und bestrafte mich; nicht zwei oder drei Male in der Woche oder einmal oder zweimal am Tag, aber fortwährend: jeder Nerv den ich hatte fürchtete ihn, und jedes Stückchen Fleisch an meinen Knochen zog sich zusammen, wenn er nahe kam."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e222c9db-353e-48ba-adbf-5fe58bdf08d6",
                        "source_entry_id": "30701923-1281-30d1-9126-aba23a41a956",
                        "source_sense_id": "0048737e-3bda-37be-9e7e-d177607d708b",
                        "source_sense_description": "ständig, dauernd, andauernd, fortwährend, unaufhörlich",
                        "target_lang_word": "kontinuierlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kontinuierlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                        "entry_id": "1e0bd383-5f6a-318c-afaa-8958955c8259",
                                        "glosses": [
                                            "stetig, über einen langen Zeitraum fortlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229799c7-9187-49a2-a57e-e2427299fade",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "Ein Sonderausschuss des Aufsichtsrats wird schon ab Februar kontinuierlich die Zusammenarbeit zwischen Porsche und dem VW-Konzern überwachen. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "db95fb30-e9cd-488e-9ccf-19ff143e0a80",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "„Seit den 1970er Jahren nimmt die Wahlbeteiligung in Westdeutschland kontinuierlich ab, auch Ostdeutschland folgt nun diesem Trend.“"
                                            },
                                            {
                                                "example_id": "f6b1f0d8-5bd3-40d9-95ad-954675598e97",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "„Ob Reisfelder, Mais oder Tomaten – viele Anbauflächen brauchen eine kontinuierliche Bewässerung.“"
                                            },
                                            {
                                                "example_id": "445e3bf3-26a4-43bf-a70e-c9c7b1fee81b",
                                                "sense_id": "cedba02e-a156-3c73-a6e8-c79d8decc683",
                                                "text": "„Trotz der anfänglich kritischen Haltung der britischen Regierung gegenüber den territorialen Ausweitungen der Ostindiengesellschaft verbuchte die Gesellschaft aufgrund des kontinuierlichen Machtverlustes der Moguln immer weitere Landgewinne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a22f4e72-4cf4-341e-8f9e-8f56e0695303",
                                        "entry_id": "1e0bd383-5f6a-318c-afaa-8958955c8259",
                                        "glosses": [
                                            "fortlaufend, eine Linie bildend"
                                        ],
                                        "tags": [
                                            "Analysis",
                                            "Topologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2976f7e5-a61a-413a-89e7-cf4280f9f751",
                                                "sense_id": "a22f4e72-4cf4-341e-8f9e-8f56e0695303",
                                                "text": "Die Analysis sowie Topologie machen in etwa die gesamte ‚Kontinuierliche‘ Mathematik aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a85d4db5-b786-48f0-81b0-4a2f14e243f2",
                        "source_entry_id": "30701923-1281-30d1-9126-aba23a41a956",
                        "source_sense_id": "0048737e-3bda-37be-9e7e-d177607d708b",
                        "source_sense_description": "ständig, dauernd, andauernd, fortwährend, unaufhörlich",
                        "target_lang_word": "continuellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                        "entry_id": "21c83ecc-d27d-36c0-894d-0da3feb3533c",
                                        "glosses": [
                                            "Sans interruption, de manière continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957ca6d5-768a-4c0c-8d0d-7fe378a3b7d6",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "On n’a point continuellement des juges devant les yeux, et l’on craint la magistrature et non pas les magistrats."
                                            },
                                            {
                                                "example_id": "102357e9-f805-4bf8-8baf-7126def780fd",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Nous le voyons continuellement occupé du soin d’acquérir ce qu’il juge utile et d’écarter ce qu’il présume devoir nuire à sa félicité."
                                            },
                                            {
                                                "example_id": "f5fecb57-70cc-44e1-810b-b4478cf6c3db",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Ces champs ne sont-ils pas à moi, et ces bois chanteurs, et ce ciel que raye continuellement le vol fantaisiste des martinets ?"
                                            },
                                            {
                                                "example_id": "62e5c941-5b8a-4dd5-b009-efc856f04fd0",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Le filage au continu permet d’obtenir une plus grande production, car le fil se produit et se renvide continuellement."
                                            },
                                            {
                                                "example_id": "cb07ea95-6948-4268-b6ed-b350d20b38b5",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "[…], Galilée a dû combattre continuellement les Péripatéticiens qui occupaient alors presque toutes les chaires magistrales des Universités."
                                            },
                                            {
                                                "example_id": "a1664d04-bd9f-4a86-bb05-a5e8e559cc2b",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "[…] le progrès est un perpétuel devenir, nulle méthode ne saurait être considérée comme immuable, tout est en mouvement, tout est continuellement améliorable, tout ce qui existe aujourd’hui sera demain mieux encore…"
                                            },
                                            {
                                                "example_id": "12afbee1-d8c4-48e2-954a-5849f1c7db2f",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "L’inlandsis du continent groenlandais se déversant lentement mais continuellement dans les fjords par des glaciers importants, vêle des icebergs de tailles variant à l’infini […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
