                        "cross_references": [
                            {
                                "target_word": "Curaçao",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33992e4b-babd-359b-b21f-212b61524dde",
                                        "entry_id": "dc67e2d3-c07a-3312-9f59-7b7d9696e8f2",
                                        "glosses": [
                                            "größte Insel der Niederländischen Antillen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36e5991-773a-4a7a-bc38-b2dd3742c56a",
                                                "sense_id": "33992e4b-babd-359b-b21f-212b61524dde",
                                                "text": "Die Insel Curaçao liegt nördlich von Venezuela und nordöstlich von Kolumbien."
                                            },
                                            {
                                                "example_id": "d4e24e70-dd18-47c0-88c2-dfd16e8766a0",
                                                "sense_id": "33992e4b-babd-359b-b21f-212b61524dde",
                                                "text": "Curaçao, mit 444 Quadratkilometern die größte Insel der Niederländischen Antillen, ist bei deutschen Urlaubern sehr beliebt."
                                            },
                                            {
                                                "example_id": "bef119c7-83f6-4856-8d41-e69187b86390",
                                                "sense_id": "33992e4b-babd-359b-b21f-212b61524dde",
                                                "text": "Die Inseln Aruba, Bonaire und Curaçao heißen entsprechend ihren Anfangsbuchstaben auch ABC-Inseln."
                                            },
                                            {
                                                "example_id": "cc305356-d89e-4e6b-98e7-3176ab3ad8d2",
                                                "sense_id": "33992e4b-babd-359b-b21f-212b61524dde",
                                                "text": "Ich bin auf Curaçao geboren."
                                            },
                                            {
                                                "example_id": "aee0cabe-6072-4a83-9600-e275d48237e8",
                                                "sense_id": "33992e4b-babd-359b-b21f-212b61524dde",
                                                "text": "Wir haben auf Curaçao unseren Urlaub verbracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f32ccc3-cc4d-3024-9171-0c5f77988dc0",
                                        "entry_id": "dc67e2d3-c07a-3312-9f59-7b7d9696e8f2",
                                        "glosses": [
                                            "weitgehend autonomer Teilstaat innerhalb des Königreichs der Niederlande"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6e0990-0efa-490e-a6c0-97119afad806",
                                                "sense_id": "4f32ccc3-cc4d-3024-9171-0c5f77988dc0",
                                                "text": "Allerdings übernehmen die Niederlande dafür den größten Teil der von der Curaçao-Verwaltung angehäuften Schulden in Höhe von 1,75 Milliarden Euro."
                                            },
                                            {
                                                "example_id": "5b187931-1149-4171-b3ba-32c8180267bd",
                                                "sense_id": "4f32ccc3-cc4d-3024-9171-0c5f77988dc0",
                                                "text": "Ich bin auf Curaçao geboren."
                                            },
                                            {
                                                "example_id": "a19c7b68-b872-46cc-beb7-b8993003be97",
                                                "sense_id": "4f32ccc3-cc4d-3024-9171-0c5f77988dc0",
                                                "text": "Wir haben auf Curaçao unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "9c23bc6f-4e66-4440-8c3d-06714f128eb2",
                                                "sense_id": "4f32ccc3-cc4d-3024-9171-0c5f77988dc0",
                                                "text": "Curaçao ist seit 10. Oktober 2010 autonomer Teilstaat des Königreichs der Niederlande."
                                            },
                                            {
                                                "example_id": "a8778e90-9467-4d7b-9401-d637483fb04d",
                                                "sense_id": "4f32ccc3-cc4d-3024-9171-0c5f77988dc0",
                                                "text": "Die Ferieninseln Curaçao und St. Maarten sind demnach nicht mehr Teil eines abhängigen Überseegebiets, sondern selbstständige Länder des Königreichs."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Curaçao",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b05ed02b-4dfa-3a12-a93d-1e1566a3b368",
                                        "entry_id": "4221162e-7cb6-3a3e-ae99-9c7a5c7f5c76",
                                        "glosses": [
                                            "Likör mit leicht bittersüßem Geschmack, der sein Aroma von getrockneten Schalen unreifer Curaçaopomeranzen erhält"
                                        ],
                                        "tags": [
                                            "geschützte Marke (®)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed84a200-ea7a-4253-adaf-c97028cce782",
                                                "sense_id": "b05ed02b-4dfa-3a12-a93d-1e1566a3b368",
                                                "text": "Der Likör Curaçao wird bereits seit dem 16. Jahrhundert auf der westindischen Insel Curaçao produziert, die vor der Küste Venezuelas liegt."
                                            },
                                            {
                                                "example_id": "b5794766-1692-4bfc-8f85-5f286b59ba72",
                                                "sense_id": "b05ed02b-4dfa-3a12-a93d-1e1566a3b368",
                                                "text": "Curaçao blue ist ein blau eingefärbter Orangenlikör mit einem Alkoholgehalt von mindestens 30 Volumprozent."
                                            },
                                            {
                                                "example_id": "7d78386e-666a-43dd-902a-8098548b276b",
                                                "sense_id": "b05ed02b-4dfa-3a12-a93d-1e1566a3b368",
                                                "text": "Der Curaçao blue bekommt seine Farbe durch den Zusatz von verschiedenen Kräutern und Gewürzen."
                                            },
                                            {
                                                "example_id": "eb9d0b41-843a-4829-ae0f-29a8ce9a49c7",
                                                "sense_id": "b05ed02b-4dfa-3a12-a93d-1e1566a3b368",
                                                "text": "Für uns bitte zwei Curaçao."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
