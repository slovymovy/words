                                        "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                        "entry_id": "d12fd0b5-4d58-3cd9-9f51-ab7a3db96d5f",
                                        "glosses": [
                                            "Kraftfahrzeug zum Transport von vielen (neun bis hundertfünfzig) Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa321ca5-8f89-4859-9529-1b31638c4d00",
                                                "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                                "text": "Die Autobusse am Amsterdamer Flughafen Schiphol werden bereits von Maschinen gesteuert."
                                            },
                                            {
                                                "example_id": "3ea715f6-10a1-4698-8d3c-3aa30b82c80a",
                                                "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                                "text": "Auch die Passagiere kennen sich und plappern über die wenigen Sitzreihen hinweg, Kinder holen ihre Hausaufgabenhefte aus dem Rucksack, es ist wie im Autobus."
                                            },
                                            {
                                                "example_id": "818b2452-fdf8-4ae1-9121-3d2b3a2930a0",
                                                "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                                "text": "Das Rathaus schiebt den Plänen für Fahrplankürzungen bei Autobus und Straßenbahn einen Riegel vor."
                                            },
                                            {
                                                "example_id": "ff1287b2-a919-4f5e-b6f3-e56cc1cb1320",
                                                "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                                "text": "Er demolierte mit der Schaufel des Baufahrzeugs auf der zentralen Jaffa-Straße mehrere Autos und warf einen Autobus auf die Seite."
                                            },
                                            {
                                                "example_id": "eccf9d68-2ef1-47a9-9363-ebe9cefb6a11",
                                                "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                                "text": "Da sähe man doch wenigstens den guten Willen, wie man ihn sah, als sich der fremdländische Autoomnibus in Autobus und der Kinematograph in einen Kientopp verwandelte."
                                            },
                                            {
                                                "example_id": "bc7595ee-fb40-4d22-b53a-c782e33b198c",
                                                "sense_id": "1aaa7612-76a9-30a1-9ab6-4c66d1ec227b",
                                                "text": "„Er zeigt ihr die Druckschrift des Reisebüros auf Hochglanzpapier mit einem pompösen Autobus auf der Titelseite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
