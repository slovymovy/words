                        "entry_id": "45ac49ad-5d57-365c-a68b-3404af68d5fc",
                        "glosses": [
                            "Koordinierte Weltzeit; die Referenzzeit, von der die Ortszeiten in den verschiedenen Zeitzonen der Erde abgeleitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bac017b-dc58-4d1d-a406-e68b3d344301",
                                "sense_id": "bfb5c65f-9e7e-3fbc-9ed2-01acc0c33449",
                                "text": "17:30 UTC = 18:30 MEZ = 19:30 mitteleuropäischer Sommerzeit (MESZ)"
                            },
                            {
                                "example_id": "d2977690-98ad-4fee-a1ee-56b047f1a974",
                                "sense_id": "bfb5c65f-9e7e-3fbc-9ed2-01acc0c33449",
                                "text": "UTC ist die Standardzeit für die Kommunikation in der Schiff- und Luftfahrt. Auf allen Schiffen und Flugzeugen sowie den landgestützten Kontrolleinrichtungen ticken die Uhren nach dieser Zeit. Somit umgeht man alle Probleme, die verschiedene Zeitzonen und die Sommerzeit-Umstellung mit sich bringen würden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
