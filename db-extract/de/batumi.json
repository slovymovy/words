                        "examples": [
                            {
                                "example_id": "de58349e-2198-4631-8246-d76acfd40c49",
                                "sense_id": "7c4e3a36-7818-3755-a5cb-c93ddd5dd64f",
                                "text": "„Moskau: Russland und Georgien legen nach jahrelangen Verhandlungen einen Zeitplan für den endgültigen Abzug der russischen Truppen fest. Bis Ende 2008 sollen die russischen Einheiten aus den Stützpunkten Batumi und Achalkalaki abrücken.“"
                            },
                            {
                                "example_id": "b82e1a88-5658-4abe-a3dd-32599b2ab2cf",
                                "sense_id": "7c4e3a36-7818-3755-a5cb-c93ddd5dd64f",
                                "text": "„Die Europastraße 692 beginnt in Batumi und verläuft zunächst nordwärts auf der S2 gemeinsam mit der E 70 und der E 97.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
