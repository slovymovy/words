                    }
                ],
                "senses": [
                    {
                        "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                        "entry_id": "b933108d-0c92-3e59-82a3-bb386f2f3a38",
                        "glosses": [
                            "A kind of milkshake made with ice cream."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c15a0f1-7453-434e-ba7d-947b99b91669",
                                "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                "text": "Except for those times when I am drugging myself with movies, vanilla frosteds, the latest novel, or cremes de nepenthe, it is difficult for me to avoid the bothersome thought […]"
                            },
                            {
                                "example_id": "ce300de4-be29-4579-9ce6-d295b97663b9",
                                "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                "text": "They had continued to laugh at the milk bar, tasting in the chocolate frosteds the unlikely flavor of Mr. Mather's turpitude."
                            },
                            {
                                "example_id": "ca616668-ec6e-4b07-99e7-6734f045edac",
                                "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                "text": "Opening with standard flavors and moving quickly to grape, raspberry, blueberry, cinnamon, apple and the frosteds, the variety is putting many chains in a one-out-for-every-one-in frame of mind."
                            }
                        ]
                    }
                ],
