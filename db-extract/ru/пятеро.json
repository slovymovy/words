                "senses": [
                    {
                        "sense_id": "651d88ec-38ff-3574-bb44-bf047a1632d3",
                        "entry_id": "7acc9426-db2f-3a4f-b9c3-acc08064fb9b",
                        "glosses": [
                            "пять (счётного значения не имеет)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df7b7cb-d453-45f5-87cd-d267de140d1d",
                                "sense_id": "651d88ec-38ff-3574-bb44-bf047a1632d3",
                                "text": "Посреди комнаты, на стуле, стояла княжна и держала перед собой мужскую шляпу; вокруг стула толпились пятеро мужчин."
                            },
                            {
                                "example_id": "d787c6f7-13ab-4df5-be72-f7573db7074d",
                                "sense_id": "651d88ec-38ff-3574-bb44-bf047a1632d3",
                                "text": "На пятерых один пойду, пикнуть не дам."
                            },
                            {
                                "example_id": "ddbe263a-647d-4829-8eba-a58a9b822554",
                                "sense_id": "651d88ec-38ff-3574-bb44-bf047a1632d3",
                                "text": "Дюкруа отвечала сразу пятерым, громко хохотала, откидываясь головой на спинку малинового бархатного дивана, и била своих собеседников веером по рукам и губам…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e2d6357-8d7c-46c3-9ca9-d1322f166006",
                        "source_entry_id": "7acc9426-db2f-3a4f-b9c3-acc08064fb9b",
                        "source_sense_id": "651d88ec-38ff-3574-bb44-bf047a1632d3",
                        "target_lang_word": "five",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "five",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c17eda31-2ac9-31d9-a946-4c6fdcf6fa31",
                                        "entry_id": "116fb55a-cdda-37f7-8d85-e5b60a6fe0fa",
                                        "glosses": [
                                            "A numerical value equal to 5; the number following four and preceding six."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4fdf0e6-9dd3-48a0-92bb-d94ac43a3425",
                                                "sense_id": "c17eda31-2ac9-31d9-a946-4c6fdcf6fa31",
                                                "text": "The r-stems had apparently been reduced to the five nuclear kinship terms that still survive in Modern English."
                                            },
                                            {
                                                "example_id": "ff3875af-2916-4fcd-af08-ee88a3d688fe",
                                                "sense_id": "c17eda31-2ac9-31d9-a946-4c6fdcf6fa31",
                                                "text": "The Texas Rangers investigation is one of at least five announced investigations targeting EPIC or EPIC City. Those include investigations led by Texas Attorney General Ken Paxton, the Texas Workforce Commission, the Texas State Board of Securities and the Texas Funeral Service Commission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e70a9d3-d2e6-3fa2-b0cc-fb14ad274c7c",
                                        "entry_id": "116fb55a-cdda-37f7-8d85-e5b60a6fe0fa",
                                        "glosses": [
                                            "Describing a group or set with five elements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "five",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cde26a69-352d-3572-9a30-2f563816638f",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "The digit/figure 5."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f7ae5a-b0cb-4de5-a109-ff956287d0e7",
                                                "sense_id": "cde26a69-352d-3572-9a30-2f563816638f",
                                                "text": "He wrote a five followed by four zeroes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf1cbe3e-3197-3462-941f-93906f273a2b",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "A banknote with a denomination of five units of currency. See also fiver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d62f9547-aba2-4032-a84d-bc1fba11aa13",
                                                "sense_id": "bf1cbe3e-3197-3462-941f-93906f273a2b",
                                                "text": "Can anyone here change a five?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90fc1b5-9561-300e-81d2-cb6404ab356c",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "Anything measuring five units, as length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660632ba-60a7-4d58-85cb-ce5dbe7e5e0d",
                                                "sense_id": "c90fc1b5-9561-300e-81d2-cb6404ab356c",
                                                "text": "All the fives are over there in the corner, next to the fours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9128ec9-e984-3222-8a08-8d60d6aa609e",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "A person who is five years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d74d35-b54d-494e-ad2a-55e511acab96",
                                                "sense_id": "a9128ec9-e984-3222-8a08-8d60d6aa609e",
                                                "text": "The fives and sixes will have a snack first, then the older kids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e26a2cd-b09d-317b-a6d3-d1745fa3b7aa",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "Five o'clock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc61e2bc-f71c-4b67-9572-706e2b9731a7",
                                                "sense_id": "9e26a2cd-b09d-317b-a6d3-d1745fa3b7aa",
                                                "text": "See you at five."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1022d49-5b01-3f23-8550-01a01dcf7081",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "A short rest, especially one of five minutes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72190ed-faca-4c96-ada0-45cdbb34eee0",
                                                "sense_id": "e1022d49-5b01-3f23-8550-01a01dcf7081",
                                                "text": "Take five, soldier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aa12421-3854-3819-a227-d88edc253c29",
                                        "entry_id": "defc6c7c-857c-3e23-9612-3e8efef365a8",
                                        "glosses": [
                                            "A basketball team, club or lineup."
                                        ],
                                        "tags": [],
