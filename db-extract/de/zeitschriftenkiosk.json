                "senses": [
                    {
                        "sense_id": "836b86f3-e8bc-34d1-85ce-7ebad5ba0ea6",
                        "entry_id": "ffd58a78-4702-3247-a234-5040185e25dd",
                        "glosses": [
                            "Kiosk, der hauptsächlich auf den Verkauf von Zeitschriften ausgelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a998571-3d95-4121-af92-17f280c30b45",
                                "sense_id": "836b86f3-e8bc-34d1-85ce-7ebad5ba0ea6",
                                "text": "„Sie wurde donnerstags direkt über die Schulen zum Preis von zehn Pfennig verkauft, war aber auch im Abonnement oder am Zeitschriftenkiosk erhältlich.“"
                            },
                            {
                                "example_id": "9e49406c-5b58-426d-998f-43136bcc13df",
                                "sense_id": "836b86f3-e8bc-34d1-85ce-7ebad5ba0ea6",
                                "text": "„Jobs-Kompakt NORD ist die führende Arbeitsmarktzeitung in der Metropolregion Hamburg und erscheint 14-täglich. Die Zeitung ist in rund 1800 Auslagestellen sowie im Zeitschriftenkiosk erhältlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
