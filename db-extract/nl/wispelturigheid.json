                ],
                "senses": [
                    {
                        "sense_id": "0802d94a-2532-37db-86bd-0c5910f28f71",
                        "entry_id": "5c6176c9-83a9-3da8-88d4-cebe53e05a88",
                        "glosses": [
                            "het op een onvoorspelbare manier steeds weer veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f493324e-b768-442b-8edd-d9406e3e4a1d",
                                "sense_id": "0802d94a-2532-37db-86bd-0c5910f28f71",
                                "text": "De laatste reeks verkiezingen heeft aangetoond dat in veel landsdelen het electoraat op drift is geraakt. In die sfeer van politieke wispelturigheid lijken de Twentenaar en de Achterhoeker nog tamelijk honkvast."
                            },
                            {
                                "example_id": "d2443da4-1228-4e56-bd82-8849023a95d3",
                                "sense_id": "0802d94a-2532-37db-86bd-0c5910f28f71",
                                "text": "Dat betaalt zich altijd uit, is de mening van Vierhouten. Neem Johnny Hoogerland. Wilde in 2012 per se een koers winnen, iets dat mislukte. 'Ik weet dat hij het kan. Maar zijn wispelturigheid belemmert hem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f538859-67a6-4e43-b42c-434c4c52b924",
                        "source_entry_id": "5c6176c9-83a9-3da8-88d4-cebe53e05a88",
                        "source_sense_id": "0802d94a-2532-37db-86bd-0c5910f28f71",
                        "source_sense_description": "het op een onvoorspelbare manier steeds weer veranderen",
                        "target_lang_word": "vagary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagary",
