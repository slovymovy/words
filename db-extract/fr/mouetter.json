                ],
                "senses": [
                    {
                        "sense_id": "ea6508fd-e297-3b0d-b51c-15df37be8175",
                        "entry_id": "684abce3-e08f-313a-a461-6ad51b412555",
                        "glosses": [
                            "Pousser son cri, en parlant du bouc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfabadec-6ba7-41e4-840b-56f648f2fa10",
                                "sense_id": "ea6508fd-e297-3b0d-b51c-15df37be8175",
                                "text": "En parlant du cri du bouc, on dit qu'il mouette."
                            },
                            {
                                "example_id": "b86d325c-3be8-42d3-88e2-bf10a6f8ba8e",
                                "sense_id": "ea6508fd-e297-3b0d-b51c-15df37be8175",
                                "text": "Mon fils, lui répondit-elle, si tu entends les boucs mouetter, les grenouilles coasser, les chiens aboyer, enfin toutes les espèces d'animaux pousser leur cri dans mon ventre, sache qu'à ce moment-là je suis plongée dans le sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a3be88f-37ec-3efa-abdd-77561609a79a",
                        "entry_id": "684abce3-e08f-313a-a461-6ad51b412555",
                        "glosses": [
                            "Puer, sentir mauvais."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d1adb721-2161-4153-bb91-367795238266",
                                "sense_id": "6a3be88f-37ec-3efa-abdd-77561609a79a",
                                "text": "Ça tape, ça fouette, ça cogne, ça mouette : ça pue, ça sent mauvais."
                            }
                        ]
                    }
                ],
