                        "cross_references": [
                            {
                                "target_word": "amortisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ffa03f2-1476-31e3-94ab-08d3b9235db8",
                                        "entry_id": "10a1c45e-cf40-3c22-87c7-88f7e631a6fc",
                                        "glosses": [
                                            "Dispositif mécanique, électrique, hydraulique ou pneumatique destiné à atténuer des chocs, des vibrations, un bruit, etc."
                                        ],
                                        "tags": [
                                            "Tous domaines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "654b5f04-37f9-46a1-a063-e1d2140d5050",
                                                "sense_id": "5ffa03f2-1476-31e3-94ab-08d3b9235db8",
                                                "text": "On peut sortir de ces situations délicates en installant un amortisseur dynamique, appelé aussi absorbeur dynamique, batteur ou damper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26eff0b4-a310-3829-bd3d-2eb1ec75de54",
                                        "entry_id": "10a1c45e-cf40-3c22-87c7-88f7e631a6fc",
                                        "glosses": [
                                            "Ensemble des organes qui servent, sur un véhicule (voiture, camion, moto, bicyclette, etc.) à amortir les chocs et à améliorer la tenue de route."
                                        ],
                                        "tags": [],
                                        "examples": [
