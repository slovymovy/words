                        "examples": [
                            {
                                "example_id": "b12a89e9-f50d-4fa7-a9bc-ff85a867783c",
                                "sense_id": "fa8df73f-33eb-342e-b47f-8ef65562cce4",
                                "text": "Пентаметр гораздо резче разламывается на два симметричных полустишия, чём гексаметр; поэтому каждый элегический дистих из гексаметра и пентаметра стремится к двойной антитезе ..."
                            }
                        ]
