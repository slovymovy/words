                        "sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                        "entry_id": "6031d366-6a41-3a41-b376-57eb9366e7c3",
                        "glosses": [
                            "Personne pratiquant le snowboard, sport de glisse pratiqué sur la neige."
                        ],
                        "tags": [
                            "Snowboard"
                        ],
                        "examples": [
                            {
                                "example_id": "8926f31e-7f98-44ef-a433-ed7eb7d2c5f8",
                                "sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                                "text": "Ils sont fidèles, elle et son amoureux, le snowboardeur australien Scotty James, médaillé deux fois aux Olympiques."
                            },
                            {
                                "example_id": "39a095fa-40e8-42e1-9d16-e73601c94aaf",
                                "sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                                "text": "Une œuvre aussi spectaculaire que décalée, avec le skieur suisse Sam Anthamatten et le snowboardeur savoyard Victor de Le Rue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f91252e-b317-4e6b-85c1-556a15f9658b",
                        "source_entry_id": "6031d366-6a41-3a41-b376-57eb9366e7c3",
                        "source_sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                        "target_lang_word": "snowboarder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowboarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                        "entry_id": "7338a73b-bc8e-38a9-a697-edc6efc771a6",
                                        "glosses": [
                                            "Someone who snowboards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f90a057-c7b3-49de-86b2-fbaa215f1cf8",
                                                "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                                "text": "The same is true in freeskiing, in which skiers pull tricks on some of the same terrain as snowboarders."
                                            },
                                            {
                                                "example_id": "9fffc99f-aae2-45a9-b32a-697c539df0f9",
                                                "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                                "text": "To Enni Rukajarvi, a Finnish snowboarder, the temperatures were not a problem — it was warmer than it often is at home, she pointed out — but the wind was tricky."
                                            }
                                        ]
                                    }
