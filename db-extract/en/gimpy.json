                        "glosses": [
                            "limping, lame, with crippled legs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c25d32a3-1ca7-4733-b4d4-5cc54aa2c11b",
                                "sense_id": "6c6be65c-b249-3c6a-a0bd-34770701fcce",
                                "text": "Presently Gimpy, who limped, as his name indicated, spoke up."
                            },
                            {
                                "example_id": "3eb324b7-1932-4f16-8fb0-cb302b4ff8ef",
                                "sense_id": "6c6be65c-b249-3c6a-a0bd-34770701fcce",
                                "text": "Gimpy Bill\" is a cripple who sold lead-pencils in Market Street. His legs have been cut off almost to the hips, and he gets around on two little platforms,"
                            },
                            {
                                "example_id": "d5912453-c302-4ac9-a480-9d0193bce3b6",
                                "sense_id": "6c6be65c-b249-3c6a-a0bd-34770701fcce",
                                "text": "\"Old guy downstairs, with long hair and a gimpy leg, handed me this yere and gimme fi' cents to fetch it up here to you,\" stated the messenger."
                            }
                        ]
                    },
                    {
                        "sense_id": "7df6dfd8-7b92-3386-a483-f742d9d77ff0",
                        "entry_id": "2a6cb544-1e5b-3717-8c3e-6cac0d8f7d8e",
                        "glosses": [
                            "exhibiting deficiencies associated with the derogatory term \\\"gimp\\\", such as might inspire discomfort or revulsion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242ca046-1c7d-4248-935f-4173d1365342",
                                "sense_id": "7df6dfd8-7b92-3386-a483-f742d9d77ff0",
                                "text": "One of the kittens has a gimpy eye."
