                        ]
                    },
                    {
                        "translation_id": "3ac5fe32-6121-4e50-be17-cc53a97fb41c",
                        "source_entry_id": "e33a07b9-d40f-3a6e-8e17-d54884ef5d43",
                        "source_sense_id": "edc122cb-aca1-3491-9867-1df863d95a88",
                        "source_sense_description": "met behulp van naald en draad iets sluiten",
                        "target_lang_word": "seam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4b435a-0467-32e5-bd7c-5a64996c69fb",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A folded-back and stitched piece of fabric; especially, the stitching that joins two or more pieces of fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a65953ef-6eea-4926-87f7-2043c5edf89c",
                                                "sense_id": "cb4b435a-0467-32e5-bd7c-5a64996c69fb",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9339925-0706-3e3b-ab7d-ba61e0269934",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A suture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfe680d9-84d7-3cb4-a820-e97f54321b6f",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A thin stratum, especially of an economically viable material such as coal or mineral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef8d1dc-b2ce-4586-92d5-b9d90f4d6814",
                                                "sense_id": "cfe680d9-84d7-3cb4-a820-e97f54321b6f",
                                                "text": "He even roused himself to go to the mines once more: […]. He sat there, crippled, in a tub, with the under-ground manager showing him the seam with a powerful torch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e5230f-62e3-3420-895f-af912da5988a",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "The stitched equatorial seam of a cricket ball; the sideways movement of a ball when it bounces on the seam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b583f4c-b2ce-34ea-8107-dedee4ff0b73",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A joint formed by mating two separate sections of materials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7af9150-0854-4ba1-80c4-60a9dc6e0320",
                                                "sense_id": "4b583f4c-b2ce-34ea-8107-dedee4ff0b73",
                                                "text": "Seams can be made or sealed in a variety of ways, including adhesive bonding, hot-air welding, solvent welding, using adhesive tapes, sealant, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34841f25-1fe0-36d2-8539-006998fb7aa7",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A line or depression left by a cut or wound; a scar; a cicatrix."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0ad9303-4a57-3903-8513-38dadf817bed",
                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A line of junction; a joint."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8188b29d-adef-45a1-903d-18d18fbf1fa7",
                                                "sense_id": "c0ad9303-4a57-3903-8513-38dadf817bed",
                                                "text": "Precepts should be so finely wrought together[…]that no coarse seam may discover where they join."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d56b8f5c-0b9b-3f60-b67c-5e8677d8f54b",
                                        "entry_id": "729481ac-a74c-3eb1-a9e8-859016a24555",
                                        "glosses": [
                                            "To put together with a seam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725d6e21-8d2a-43bd-b65d-f12eb4b04b7c",
                                                "sense_id": "d56b8f5c-0b9b-3f60-b67c-5e8677d8f54b",
                                                "text": "Thus, seamed with many scars, / Bursting these prison bars, / Up to its native stars / My soul ascended!"
                                            }
                                        ]
