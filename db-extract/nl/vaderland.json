                                                "text": "defend the homeland"
                                            },
                                            {
                                                "example_id": "6c046bd3-574e-4230-b4e9-f685f7a1bb02",
                                                "sense_id": "e745329d-4314-3927-b077-bedd26884d9d",
                                                "text": "return to the homeland"
                                            },
                                            {
                                                "example_id": "f65f87b7-623e-4cf2-bc86-7cfe07bd9d9d",
                                                "sense_id": "e745329d-4314-3927-b077-bedd26884d9d",
                                                "text": "homeland security"
                                            },
                                            {
                                                "example_id": "e62de37d-b614-4f60-907f-9f84a72ab019",
                                                "sense_id": "e745329d-4314-3927-b077-bedd26884d9d",
                                                "text": "After years abroad, she finally returned to her homeland."
                                            },
                                            {
                                                "example_id": "b8c6745e-bb61-4137-a4d8-5aadd4a77526",
                                                "sense_id": "e745329d-4314-3927-b077-bedd26884d9d",
                                                "text": "They fought bravely to defend their homeland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b08a763f-a944-355d-95d5-7dd80e987e0d",
