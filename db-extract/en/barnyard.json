                "senses": [
                    {
                        "sense_id": "c84374c6-0537-398d-a16f-04327e17a824",
                        "entry_id": "63c073aa-a769-3a36-a7d9-3dba3ac49049",
                        "glosses": [
                            "Vulgar; scatological."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b5f0859-d6d4-48cc-afac-b383977e70e5",
                                "sense_id": "c84374c6-0537-398d-a16f-04327e17a824",
                                "text": "Henderson too barnyard for Casa Loma, so they are rejecting further arrangements by him."
                            },
                            {
                                "example_id": "61095764-242f-4439-959c-5eb239b3046e",
                                "sense_id": "c84374c6-0537-398d-a16f-04327e17a824",
                                "text": "The bad part was that Thor and Chief, with their vivid and clever imaginations, had made up a whole cast of characters, some of them with very barnyard names, and soap-opera lives."
                            },
                            {
                                "example_id": "fde8c48a-26c9-4332-a212-de4dfb0265fd",
                                "sense_id": "c84374c6-0537-398d-a16f-04327e17a824",
                                "text": "They’ve come to be called \"snout\" houses, a label that sounds more barnyard than city street and, in any event, certainly doesn’t sound pretty."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f5a3490-4ae3-3561-983b-3880229096f9",
                        "entry_id": "63c073aa-a769-3a36-a7d9-3dba3ac49049",
                        "glosses": [
                            "having an earthy flavor."
                        ],
                        "tags": [
                            "of food or drink"
                        ],
                        "examples": [
                            {
                                "example_id": "68e9226e-d419-456c-907f-525fcf593894",
                                "sense_id": "9f5a3490-4ae3-3561-983b-3880229096f9",
                                "text": "Mr. Oliver, the brewmaster at Brooklyn Brewery, has a quirky way of describing his creations. He refers to the more complex ones as “a little bit barnyard,” “having a funky nose” or “like a good sourdough bread.”"
                            },
                            {
                                "example_id": "a5ce4ead-057b-450d-ac7c-f6a3aa516680",
                                "sense_id": "9f5a3490-4ae3-3561-983b-3880229096f9",
                                "text": "Cheeses made from goat’s milk tend to have a more barnyard and tangy taste than cow’s milk."
                            }
                        ]
                    }
                ],
