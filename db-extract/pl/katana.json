                                    {
                                        "sense_id": "5c6577cb-b607-3465-9f5d-9e9e61f8bdbb",
                                        "entry_id": "9b840561-17f5-3111-99fe-52d5b20baee6",
                                        "glosses": [
                                            "A type of Japanese longsword, having a single edge and slight curvature, historically used by samurai and ninja."
                                        ],
                                        "tags": [],
