                "translations": [
                    {
                        "translation_id": "dd4a1242-9b6e-4844-8caf-2856d11e853d",
                        "source_entry_id": "8b217d36-20a8-3333-9f65-bdc6bcc93583",
                        "source_sense_id": "f295cae9-7c10-3448-a115-f362ee51fad7",
                        "target_lang_word": "tack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1d0dd4d-47dc-347a-ab3c-9bbb4ddc97e5",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "A small nail with a flat head."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7769ab5e-9df7-4414-bf47-e81d669c1d97",
                                                "sense_id": "e1d0dd4d-47dc-347a-ab3c-9bbb4ddc97e5",
                                                "text": "A tough test for even the strongest climber, it was new to the Tour de France this year, but its debut will be remembered for the wrong reasons after one of those spectators scattered carpet tacks on the road and induced around 30 punctures among the group of riders including Bradley Wiggins, the Tour's overall leader, and his chief rivals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffcf497d-a1d5-3b2e-be6b-9dfc81f1daee",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "A thumbtack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3804676c-58d4-3d0f-94ec-83f549d7175b",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "A loose seam used to temporarily fasten pieces of cloth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cf29404-65b8-3efb-ac99-6c4f766859b3",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "The lower corner on the leading edge of a sail relative to the direction of the wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce6ed812-02ee-355b-a5b6-c5da32b52f62",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "A course or heading that enables a sailing vessel to head upwind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3155d83-4125-3f51-b5ac-fa5f42651c78",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "A direction or course of action, especially a new one; a method or approach to solving a problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e502520-aa0e-4242-aff1-820125bf4c90",
                                                "sense_id": "e3155d83-4125-3f51-b5ac-fa5f42651c78",
                                                "text": "So stoutly held to tack by those near North-wales men;"
                                            },
                                            {
                                                "example_id": "8083f21d-5aa6-4b20-9a01-bc9272fd8ca8",
                                                "sense_id": "e3155d83-4125-3f51-b5ac-fa5f42651c78",
                                                "text": "Maud Gonne’s letter about taking them off O’Connell street at night: disgrace to our Irish capital. Griffith’s paper is on the same tack now: an army rotten with venereal disease: overseas or halfseasover empire."
                                            },
                                            {
                                                "example_id": "365dd7a0-ba39-4b42-a1fb-360fb2dcb63a",
                                                "sense_id": "e3155d83-4125-3f51-b5ac-fa5f42651c78",
                                                "text": "I thought that my refusing Barnard would alienate Botha, and decided that such a tack was too risky."
                                            },
                                            {
                                                "example_id": "666a5da9-ce0d-4662-8eec-bd7f72d5865c",
                                                "sense_id": "e3155d83-4125-3f51-b5ac-fa5f42651c78",
                                                "text": "When even cautious German politicians are questioning Nato’s ‘war-mongering’ actions, it’s clear that a new tack is required"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "190ad56c-8989-36ea-9fcd-48821f7fdd3c",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "The maneuver by which a sailing vessel turns its bow through the wind so that the wind changes from one side to the other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f1e9176-9358-3a1d-a751-86baa0f3e23f",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "The distance a sailing vessel runs between these maneuvers when working to windward; a board."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a134e3f4-8cf1-303e-9b63-7191847f99a7",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "A rope used to hold in place the foremost lower corners of the courses when the vessel is close-hauled; also, a rope employed to pull the lower corner of a studding sail to the boom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77149f2d-f256-3cee-ac6f-6f4c395b3096",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "Any of the various equipment and accessories worn by horses in the course of their use as domesticated animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "714a8306-c6e4-324a-9f0c-7b54803ec0c2",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "The stickiness of a compound, related to its cohesive and adhesive properties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba70b34f-9e81-465f-85f1-7a2debdd0a05",
                                                "sense_id": "714a8306-c6e4-324a-9f0c-7b54803ec0c2",
                                                "text": "The laminate adhesive has very aggressive tack and is hard to move once in place."
                                            },
                                            {
                                                "example_id": "0370e9ab-1774-4b4c-ae59-6153fee94c8a",
                                                "sense_id": "714a8306-c6e4-324a-9f0c-7b54803ec0c2",
                                                "text": "Letterpress and offset gloss varnishes normally have viscosities varying from 50 to 250 poises; they must stain the paper as little as possible, have insufficient tack to cause plucking, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67f267f7-3e85-30e3-8dbd-5bf3f9f29101",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "Food generally; fare, especially of the hard bread or breadlike kind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec53432-69c8-4582-9ddc-d0af3a0830b6",
                                                "sense_id": "67f267f7-3e85-30e3-8dbd-5bf3f9f29101",
                                                "text": "Near-synonyms: biscuit, bread"
                                            },
                                            {
                                                "example_id": "6d2ee76e-709c-423b-a983-5696df7919a2",
                                                "sense_id": "67f267f7-3e85-30e3-8dbd-5bf3f9f29101",
                                                "text": "But if a woman's got nothing but her fair fame to feed on, why, it's thin tack, and a donkey would die of it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e5c0a95-9172-3194-ab66-df63ce4cc7af",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "That which is attached; a supplement; an appendix."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81c6d75e-2efd-4285-bbfc-be9b7d57b02e",
                                                "sense_id": "4e5c0a95-9172-3194-ab66-df63ce4cc7af",
                                                "text": "Some tacks had been made to money bills in King Charles's time."
                                            },
                                            {
                                                "example_id": "8532e2c9-cc15-4d6b-9b31-5fc68dd5639f",
                                                "sense_id": "4e5c0a95-9172-3194-ab66-df63ce4cc7af",
                                                "text": "pay all taxes and subscribe tacks"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839537bc-c69f-3c84-a4cb-9f6c39ce9a40",
                                        "entry_id": "3672fb7c-76fd-3732-8f68-7039c8b5e326",
                                        "glosses": [
                                            "Confidence; reliance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
