                "forms": [
                    {
                        "form_id": "ee23c9b1-a353-46b4-b973-0e8fe593357f",
                        "entry_id": "00294a10-46d6-399a-8465-5a916c98b585",
                        "tags": [
                            "plural"
                        ],
                        "form": "monachists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ab572fb-54da-3f14-91db-f611820b7b31",
                        "entry_id": "00294a10-46d6-399a-8465-5a916c98b585",
                        "glosses": [
                            "A monk, especially one who was part of the religious reform movement of the fourth century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e7e58d-24e0-4115-905a-6feee2ddadc2",
                                "sense_id": "4ab572fb-54da-3f14-91db-f611820b7b31",
                                "text": "He lives in monastic loneliness, not that he is a hermit, but he makes himself into a monastery from which, as at Mount Athos, everything that deals with sex is excluded, and like the monachists of the Middle Ages he pays the penalty to desregarded Nature."
                            },
                            {
                                "example_id": "90c9193b-2a8e-47f7-9601-47bf381f0030",
                                "sense_id": "4ab572fb-54da-3f14-91db-f611820b7b31",
                                "text": "Indeed, the friars went much farther than the reforming monachists."
                            },
                            {
                                "example_id": "1065f986-eee1-4a67-ab63-49a4fb91e095",
                                "sense_id": "4ab572fb-54da-3f14-91db-f611820b7b31",
                                "text": "Both required industry and productive labor from all able-bodied members and were thus sharply distinguished from the begging, communal orders, such as the Buddhist and Christian monachists."
                            },
                            {
                                "example_id": "85797c41-391c-4a5a-8573-cf92f3658de2",
                                "sense_id": "4ab572fb-54da-3f14-91db-f611820b7b31",
                                "text": "The rage for production had swept England, as the rage for piety had swept the age of the monachists."
                            }
                        ]
                    }
                ],
