                ],
                "senses": [
                    {
                        "sense_id": "d950c15c-47c5-30bc-b293-93ef603d0c41",
                        "entry_id": "bceec1dd-b08a-3a97-9be2-ed20b5f8b9b5",
                        "glosses": [
                            "Ackergerät oder Werkzeuge eines Bauern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed0a2a1-9bf6-4972-97f3-f6ac5bf7c42f",
                                "sense_id": "d950c15c-47c5-30bc-b293-93ef603d0c41",
                                "text": "„Als Feldgerät werden in der Landwirtschaft Arbeitsmittel, wie Heugabeln, Schaufeln, Rechen oder Pflug bezeichnet.“"
                            },
                            {
                                "example_id": "af11204c-52e9-4b1f-b0c2-b9dffc5b4594",
                                "sense_id": "d950c15c-47c5-30bc-b293-93ef603d0c41",
                                "text": "„So werden beispielsweise größere Feldgeräte gemeinsam genutzt oder Saatgut unter einander getauscht.“"
                            },
                            {
                                "example_id": "62da4d88-0fec-4bc5-b333-89e29fbdcaca",
                                "sense_id": "d950c15c-47c5-30bc-b293-93ef603d0c41",
                                "text": "„Wir wußten nicht, was es geben sollte, und vernahmen endlich, es werde eine Versteigerung abgehalten über etwas Feldgeräte, Schafe, Schweine und ein Kalb und eine Kuh, welche uns gehörten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "44cc9dfd-9156-3e0b-b346-65cc836377f0",
                        "entry_id": "bceec1dd-b08a-3a97-9be2-ed20b5f8b9b5",
                        "glosses": [
                            "Ausrüstungsgegenstände eines Soldaten auf dem Schlachtfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06809b0f-d0cc-4c50-ada1-123f818849bb",
                                "sense_id": "44cc9dfd-9156-3e0b-b346-65cc836377f0",
                                "text": "Das Feldgerät eines Soldaten besteht nicht nur aus seiner Waffe, vielmehr gehören noch andere Gegenstände zu seiner Feldausrüstung."
                            },
                            {
                                "example_id": "6fe0c962-b305-4f0c-a26d-a9bad1a5549d",
                                "sense_id": "44cc9dfd-9156-3e0b-b346-65cc836377f0",
                                "text": "„Auch hier durften die potenziellen angehenden Soldatinnen selbst Hand anlegen und im ungewohnten Terrain zwischen Geländefahrzeugen und medizinischem Feldgerät erleben, wie unsere Soldaten in Afghanistan, auf dem Balkan und auch in Deutschland sanitätsdienstliche Hilfe leisten können.“"
                            },
                            {
                                "example_id": "4f70bb0a-9471-4878-b33b-230d47708d0a",
                                "sense_id": "44cc9dfd-9156-3e0b-b346-65cc836377f0",
                                "text": "„Zur Erfüllung ihrer Aufgaben verfügten die Verwaltungsdienste über besonderes Feldgerät. In der Regel, d. h. nach den gegebenen Möglichkeiten, arbeiteten Verpflegungsamt, Bäckerei- und Schlächtereieinheiten in ortsfesten Gebäuden, vorhandenen Brotfabriken, Schlachthöfen usw., um das wertvolle Feldgerät zu schonen. Wo diese Einrichtungen nicht zu finden waren, und dies war in den Weiten Rußlands oft genug der Fall, mußte das Feldgerät kriegsmäßig gedeckt aufgebaut werden.“"
                            },
                            {
                                "example_id": "35333ad8-6305-43fb-930c-a37f2ebf8bdd",
                                "sense_id": "44cc9dfd-9156-3e0b-b346-65cc836377f0",
                                "text": "„Dieses Gewicht konnte sich um weitere fünf bis sechs Kilogramm erhöhen, zählte man, so Isabelle Brandauer, das Gewehr mitsamt Riemen hinzu, oder wenn im Winter Wollhandschuhe, Gamaschen, gestrickte Unterhemden und -hosen oder diverses Feldgerät, wie Kochgeschirr, Wassereimer, Spaten oder eine Laterne, noch zusätzlich zu tragen waren.“"
                            },
                            {
                                "example_id": "30529141-d2b2-47c5-828c-795a1f6f2c13",
                                "sense_id": "44cc9dfd-9156-3e0b-b346-65cc836377f0",
                                "text": "„Die Feldzeugmeisterei ist die oberste militärische Einrichtung für die Beschaffung und Verwaltung von Waffen, Munition und Feldgeräten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a34bc48a-100b-35ef-b595-bcb33aa346f6",
                        "entry_id": "bceec1dd-b08a-3a97-9be2-ed20b5f8b9b5",
                        "glosses": [
                            "dezentral, außerhalb der Steuerungszentrale liegende Einrichtung; zum Beispiel ein bewegliches oder fest eingebautes Element, mit dem etwas gemessen, geregelt oder gesteuert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df56cc1-1928-4ce8-9c80-30bba3602471",
                                "sense_id": "a34bc48a-100b-35ef-b595-bcb33aa346f6",
                                "text": "„Die Feldgeräte tauschen die Daten nicht unmittelbar untereinander aus, sondern über die Steuergeräte auf der Prozessebene. Außerdem erzeugen die Feldgeräte Analyse- und Alarmdaten.“"
                            },
                            {
                                "example_id": "adeaf946-0fd3-4536-8ad1-74d76c8af699",
                                "sense_id": "a34bc48a-100b-35ef-b595-bcb33aa346f6",
                                "text": "„Der Einsatz eines externen Protokollkonverters als externe Profinet-IO-Kommunikationsschnittstelle bietet sich an, wenn das Feldgerät über eine serielle Schnittstelle verfügt, die Busanbindung jedoch nicht zum Standardfunktionsumfang des Feldgerätes gehören soll.“"
                            },
                            {
                                "example_id": "dbaf0838-4061-484e-8ca0-310a044cb2b2",
                                "sense_id": "a34bc48a-100b-35ef-b595-bcb33aa346f6",
                                "text": "„Durch das Dokument soll eine einheitliche Bedienung von Feldgeräten mittels einer Anzeige-Bedienkomponente, z.B. einem PC, erreicht werden.“"
                            },
                            {
                                "example_id": "30824df4-e9e3-4aaf-bd5f-16d695c4b80b",
                                "sense_id": "a34bc48a-100b-35ef-b595-bcb33aa346f6",
                                "text": "„Der Techniker benutzt die Softwarekomponente, Device Type Manager (DTM), um das intelligente Feldgerät vollständig zu konfigurieren“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
