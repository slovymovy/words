            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebbdd884-cf52-3085-9536-7a43962d4a04",
                    "sense_definition": "Pouvoir inaliénable de disposer de sa personne et d'agir selon sa propre volonté dans le respect des lois.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "autonomie_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen a le droit fondamental de vivre dans la <w>liberté</w> et la paix."
                        },
                        {
                            "text": "La devise de la République française associe la <w>liberté</w> à l'égalité et à la fraternité."
                        }
                    ],
                    "synonyms": [
                        "indépendance",
                        "libre arbitre",
                        "souveraineté"
                    ],
                    "antonyms": [
                        "esclavage",
                        "servitude",
                        "servage"
                    ],
                    "common_phrases": [
                        "liberté individuelle",
                        "sentiment de liberté"
                    ]
                },
                {
                    "sense_id": "d2f1ef7d-1d84-3b15-bddc-94fa584c455b",
                    "sense_definition": "Possibilité matérielle pour une personne ou un animal de se mouvoir ou d'agir sans contrainte ni enfermement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "non_enfermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois dans un refuge, cet oiseau soigné a finalement retrouvé la <w>liberté</w>."
                        },
                        {
                            "text": "Les animaux sauvages ont besoin de beaucoup d'espace pour se déplacer en toute <w>liberté</w>."
                        }
                    ],
                    "antonyms": [
                        "enfermement",
                        "aliénation"
                    ],
                    "common_phrases": [
                        "en liberté",
                        "remise en liberté",
                        "rendre la liberté"
                    ]
                },
                {
                    "sense_id": "c905f653-abbe-3b68-942e-db5ed4087e35",
                    "sense_definition": "Chacun des droits reconnus et protégés par la loi pour exercer une activité ou exprimer ses convictions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "droits_et_garanties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans une démocratie moderne, la <w>liberté</w> d'expression constitue un principe fondamental indispensable."
                        },
                        {
                            "text": "Les journalistes se mobilisent régulièrement afin de défendre la <w>liberté</w> de la presse."
                        }
                    ],
                    "common_phrases": [
                        "liberté d'expression",
                        "liberté de la presse",
                        "liberté de pensée"
                    ]
                },
                {
                    "sense_id": "ba4883b1-4ff0-3573-84fc-fd0677bd5042",
                    "sense_definition": "Permission ou audace polie que l'on s'accorde pour agir ou s'exprimer sans offenser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formule_de_politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je prends la <w>liberté</w> de vous contacter pour solliciter un entretien avec votre équipe."
                        },
                        {
                            "text": "Le metteur en scène a pris la <w>liberté</w> de modifier la conclusion de la pièce originale."
                        }
                    ],
                    "common_phrases": [
                        "prendre la liberté de"
                    ]
                }
            ]
        }
