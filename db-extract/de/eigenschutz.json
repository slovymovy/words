                "senses": [
                    {
                        "sense_id": "7c9e8d43-d08d-3f1d-a537-88d6f6fac678",
                        "entry_id": "784ece73-6dba-3a02-b15c-b7cd28234454",
                        "glosses": [
                            "Konzept, Idee, Maßnahme und Ausrüstung (Schutz), um sich selbst vor Schaden zu bewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859ad971-d460-4f06-b4b9-7d1a7aa34c84",
                                "sense_id": "7c9e8d43-d08d-3f1d-a537-88d6f6fac678",
                                "text": "Als Ersthelfer am Unfallort sollte man den Eigenschutz an erste Stelle setzen."
                            },
                            {
                                "example_id": "4e8823f7-0e61-43b7-8c1a-046f110a532a",
                                "sense_id": "7c9e8d43-d08d-3f1d-a537-88d6f6fac678",
                                "text": "Meinen Eigenschutz verwahre ich in meinem Spind, wenn ich keinen Dienst habe."
                            },
                            {
                                "example_id": "6d59eee9-d429-4e35-aec9-7daf51c8d21f",
                                "sense_id": "7c9e8d43-d08d-3f1d-a537-88d6f6fac678",
                                "text": "Aus Angst vor den Mordabsichten der Geheimdienstleute hatte sie sich zum Eigenschutz in der Wohnung eingeschlossen."
                            }
                        ],
                        "sense_index_json": "\"1\""
