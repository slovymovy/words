                        "entry_id": "c6d66c86-deba-3262-8ea0-17759b6f6776",
                        "glosses": [
                            "Fähigkeit von Fischen und Amphibien, mit Hilfe des Seitenlinienorgans den Staudruck des Wassers festzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd291db8-afa9-4633-8920-3645ed7c3bcf",
                                "sense_id": "e05d907a-8178-36ab-b508-9549c0e8ef51",
                                "text": "„Besondere Bedeutung hat der Ferntastsinn bei den augenlosen Höhlenfischen erlangt, die auch kleinste Hindernisse umschwimmen können.“"
                            },
                            {
                                "example_id": "895d93ed-da48-48e1-8df1-a9c4abb5a952",
                                "sense_id": "e05d907a-8178-36ab-b508-9549c0e8ef51",
                                "text": "Fische können mittels des Ferntastsinnes über den Staudruck, der beim Anschwimmen entsteht, feste Hindernisse wie eine durchsichtige Aquarienwand „ertasten“."
                            }
                        ],
