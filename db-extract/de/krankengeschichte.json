                "senses": [
                    {
                        "sense_id": "5675abbd-bdd1-3887-ad33-c4b57c7951f3",
                        "entry_id": "8ffa009f-bf65-33f4-8290-1805992e8fef",
                        "glosses": [
                            "Vorgeschichte der Krankheiten einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f4427f-1595-4143-a6d0-6240ff405fa8",
                                "sense_id": "5675abbd-bdd1-3887-ad33-c4b57c7951f3",
                                "text": "„Ihre Biographie gleicht einer Krankengeschichte.“"
                            },
                            {
                                "example_id": "18829a6a-2b2e-4db2-87ac-706db119dfa8",
                                "sense_id": "5675abbd-bdd1-3887-ad33-c4b57c7951f3",
                                "text": "„Zuvor fragte er nach allerlei Daten, nach ihrer Krankengeschichte und Versicherungskarte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10d88539-90e8-308c-957d-b95935cf52c5",
                        "entry_id": "8ffa009f-bf65-33f4-8290-1805992e8fef",
                        "glosses": [
                            "Akte, in der die Vorgeschichte der Krankheiten einer Person dokumentiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78dc45ca-8147-419d-a941-4a7d61ce95b2",
                                "sense_id": "10d88539-90e8-308c-957d-b95935cf52c5",
                                "text": "„Vor ihrer Überweisung an den Psychiater war sie von mehreren Spezialisten in einer großen Klinik untersucht und behandelt worden. Dadurch hatte sich eine Krankengeschichte von eindrucksvollem Volumen angesammelt, […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
