        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9cd057b1-2b58-3148-8678-32605b41b6d5",
                    "sense_definition": "Somme d'argent obtenue auprès d'une banque, d'un organisme ou d'un tiers avec l'obligation de la rembourser.",
