{
    "word_family": [
        "politics",
        "political",
        "politically",
        "politicize",
        "politicization",
        "politic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f593fca0-2f93-3517-a1a9-4b8a269192df",
                    "sense_definition": "One engaged in politics, especially an elected or appointed government official.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "government_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>politician</w> promised to lower taxes if he won the election.",
                            "target_lang_translations": {
                                "ru": "<w>Политик</w> пообещал снизить налоги, если победит на выборах.",
                                "zh": "这位<w>政治家</w>承诺如果赢得选举就会降低税收。"
                            }
                        },
                        {
                            "text": "Many people do not trust a <w>politician</w> who changes their mind too often.",
                            "target_lang_translations": {
                                "ru": "Многие люди не доверяют <w>политику</w>, который слишком часто меняет свое мнение.",
                                "zh": "许多人并不信任那些主张变来变去的<w>政客</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "politico",
                        "pol",
                        "representative",
                        "public servant"
                    ],
                    "common_phrases": [
                        "local politician",
                        "corrupt politician",
                        "opposition politician",
                        "leading politician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, занимающийся политикой, особенно избранное или назначенное должностное лицо.",
                        "zh": "从事政治活动的人，尤指民选或任命的政府官员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "политик",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "политический деятель",
                                "target_lang_sense_clarification": "официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政治家",
                                "target_lang_sense_clarification": "指有远见、有成就的政治人物"
                            },
                            {
                                "target_lang_word": "政客",
                                "target_lang_sense_clarification": "中性或略带贬义，指从事政治活动的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3480026f-4108-3c90-9cea-b1fa7aed6de4",
                    "sense_definition": "Specifically, one who regards elected political office as a career.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "government_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He describes himself as a businessman rather than a <w>politician</w>.",
                            "target_lang_translations": {
                                "ru": "Он называет себя бизнесменом, а не <w>политиком</w>.",
                                "zh": "他称自己是个商人，而不是<w>政客</w>。"
                            }
                        },
                        {
                            "text": "A career <w>politician</w> knows exactly how to campaign effectively.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>политик</w> точно знает, как эффективно вести предвыборную кампанию.",
                                "zh": "一位<w>职业政客</w>非常清楚如何有效地进行竞选活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "politicker"
                    ],
                    "common_phrases": [
                        "career politician",
                        "professional politician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто рассматривает выборную политическую должность как свою профессию.",
                        "zh": "特指将担任民选政治职务作为职业的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "политик",
                                "target_lang_sense_clarification": "профессиональный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "职业政客",
                                "target_lang_sense_clarification": "指长期从事政治职业的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdc4c037-0d1e-3be8-b95b-ff1e7f3c02c7",
                    "sense_definition": "A politically active or interested person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "active_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is quite a <w>politician</w> when it comes to organizing community events.",
                            "target_lang_translations": {
                                "ru": "Она настоящий <w>политик</w>, когда дело доходит до организации общественных мероприятий.",
                                "zh": "说到组织社区活动，她可真是个<w>政治能手</w>。"
                            }
                        },
                        {
                            "text": "My uncle is a real <w>politician</w> and loves to debate current affairs at dinner.",
                            "target_lang_translations": {
                                "ru": "Мой дядя — настоящий <w>политик</w>, он обожает обсуждать текущие события за ужином.",
                                "zh": "我叔叔是个十足的<w>政治迷</w>，晚餐时总喜欢辩论时事。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Политически активный или интересующийся политикой человек.",
                        "zh": "对政治感兴趣或积极参与政治活动的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "политик",
                                "target_lang_sense_clarification": "в переносном смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热衷政治的人",
                                "target_lang_sense_clarification": "指在非正式场合表现出政治热情的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10146799-e39c-3eb2-a784-1acca5c11138",
                    "sense_definition": "A sly or ingratiating person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manipulator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>politician</w>, always saying exactly what the boss wants to hear.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>политикан</w>: всегда говорит именно то, что хочет услышать начальник.",
                                "zh": "他真是个<w>滑头</w>，总是说老板想听的话。"
                            }
                        },
                        {
                            "text": "You have to be a bit of a <w>politician</w> to navigate the complex dynamics of this office.",
                            "target_lang_translations": {
                                "ru": "Нужно быть немного <w>политиком</w>, чтобы ориентироваться в сложной динамике этого офиса.",
                                "zh": "你得有几分<w>滑头</w>才能应付办公室里复杂的人际关系。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be a politician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитрый, изворотливый человек или интриган.",
                        "zh": "指狡猾、善于钻营或阿谀奉承的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "политикан",
                                "target_lang_sense_clarification": "презрительно; интриган"
                            },
                            {
                                "target_lang_word": "политик",
                                "target_lang_sense_clarification": "тонкий стратег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政客",
                                "target_lang_sense_clarification": "贬义，指玩弄权术、投机取巧的人"
                            },
                            {
                                "target_lang_word": "滑头",
                                "target_lang_sense_clarification": "指圆滑、善于应付的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}