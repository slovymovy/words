{
    "word_family": [
        "lavishly",
        "lavishness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "097865e2-7d44-3254-b743-6f5690a6615f",
                    "sense_definition": "Characterized by great abundance or luxury; excessive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offered a <w>lavish</w> meal for all the guests at the wedding.",
                            "target_lang_translations": {
                                "ru": "Отель предложил <w>роскошный</w> обед для всех гостей на свадьбе."
                            }
                        },
                        {
                            "text": "They lived a <w>lavish</w> lifestyle in a large mansion by the sea.",
                            "target_lang_translations": {
                                "ru": "Они вели <w>роскошный</w> образ жизни в большом особняке у моря."
                            }
                        }
                    ],
                    "synonyms": [
                        "extravagant",
                        "opulent"
                    ],
                    "common_phrases": [
                        "lavish lifestyle",
                        "lavish meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся большим изобилием или роскошью; чрезмерный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошный",
                                "target_lang_sense_clarification": "описывает что-то богатое, пышное или дорогое"
                            },
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "описывает что-то, выходящее за рамки меры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c58a1e17-c62e-347b-a9fe-7910fcfab888",
                    "sense_definition": "Giving or spending in large amounts; generous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director was <w>lavish</w> with his praise for the young actor's performance.",
                            "target_lang_translations": {
                                "ru": "Режиссер был <w>щедр</w> на похвалу в адрес игры молодого актера."
                            }
                        },
                        {
                            "text": "She was <w>lavish</w> with her time when helping the new students settle in.",
                            "target_lang_translations": {
                                "ru": "Она <w>не жалела</w> своего времени, помогая новым студентам освоиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "profuse",
                        "generous"
                    ],
                    "common_phrases": [
                        "lavish with praise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Щедрый в проявлении чувств или расходовании чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щедрый",
                                "target_lang_sense_clarification": "описывает человека, который охотно делится или тратит"
                            },
                            {
                                "target_lang_word": "нескупой",
                                "target_lang_sense_clarification": "описывает человека, не жалеющего ресурсов или похвалы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0d963f8-e8d1-398f-b554-e9e1a9657d87",
                    "sense_definition": "Rich and thick with vegetation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lavish</w> hills were covered in a thick blanket of wildflowers.",
                            "target_lang_translations": {
                                "ru": "<w>Пышные</w> холмы были покрыты густым ковром полевых цветов."
                            }
                        },
                        {
                            "text": "We walked through the <w>lavish</w> forest during the peak of summer.",
                            "target_lang_translations": {
                                "ru": "Мы гуляли по пышному лесу в разгар лета."
                            }
                        }
                    ],
                    "synonyms": [
                        "lush",
                        "verdant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Богатый и густой растительностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "описывает густую, обильную растительность"
                            },
                            {
                                "target_lang_word": "изобильный",
                                "target_lang_sense_clarification": "описывает природу, полную жизни и зелени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a20d6ba2-2b50-37a7-a183-d7acbc681dc0",
                    "sense_definition": "Unrestrained or impulsive in speech or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unrestrained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He regretted his <w>lavish</w> words spoken in the heat of the argument.",
                            "target_lang_translations": {
                                "ru": "Он пожалел о своих <w>несдержанных</w> словах, сказанных в пылу спора."
                            }
                        },
                        {
                            "text": "The politician made <w>lavish</w> promises that he could never actually keep.",
                            "target_lang_translations": {
                                "ru": "Политик раздавал чрезмерные обещания, которые он никогда не смог бы выполнить."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrestrained",
                        "rash"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несдержанный или импульсивный в словах или действиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неумеренный",
                                "target_lang_sense_clarification": "описывает отсутствие сдержанности в проявлениях"
                            },
                            {
                                "target_lang_word": "несдержанный",
                                "target_lang_sense_clarification": "описывает человека, не контролирующего свои порывы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fa32221-9fe4-3a96-b6a5-e34d649a2ab4",
                    "sense_definition": "To give or spend something in large, generous amounts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>lavished</w> money on the expensive dinner party.",
                            "target_lang_translations": {
                                "ru": "Они <w>расточали</w> деньги на дорогой званый ужин."
                            }
                        },
                        {
                            "text": "The company <w>lavished</w> resources on the new research project.",
                            "target_lang_translations": {
                                "ru": "Компания <w>щедро тратила</w> ресурсы на новый исследовательский проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "bestow"
                    ],
                    "common_phrases": [
                        "lavish money on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тратить или отдавать что-либо в больших, щедрых количествах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расточать",
                                "target_lang_sense_clarification": "тратить что-либо в большом количестве"
                            },
                            {
                                "target_lang_word": "транжирить",
                                "target_lang_sense_clarification": "неразумно или слишком щедро расходовать деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e59ebed8-da5c-36f8-a72d-c39ea0ca1f95",
                    "sense_definition": "To give someone a large amount of something, such as praise or gifts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans <w>lavished</w> the singer with praise after the concert.",
                            "target_lang_translations": {
                                "ru": "После концерта фанаты <w>осыпали</w> певца похвалами."
                            }
                        },
                        {
                            "text": "Grandparents often <w>lavish</w> their grandchildren with gifts.",
                            "target_lang_translations": {
                                "ru": "Бабушки и дедушки часто <w>осыпают</w> своих внуков подарками."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower"
                    ],
                    "common_phrases": [
                        "lavish with praise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одаривать кого-то большим количеством чего-либо, например похвалой или подарками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осыпать",
                                "target_lang_sense_clarification": "давать что-то в избытке (например, похвалу или подарки)"
                            },
                            {
                                "target_lang_word": "щедро одаривать",
                                "target_lang_sense_clarification": "давать много подарков или внимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e2e3f85-6ec2-315c-abac-c030a636907e",
                    "sense_definition": "A state of excessive abundance or spending.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was decorated with a <w>lavish</w> of gold and velvet.",
                            "target_lang_translations": {
                                "ru": "Комната была украшена с избытком золота и бархата."
                            }
                        },
                        {
                            "text": "The party was a display of pure <w>lavish</w> that shocked the guests.",
                            "target_lang_translations": {
                                "ru": "Вечеринка была демонстрацией чистой <w>роскоши</w>, которая шокировала гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "profusion",
                        "prodigality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние чрезмерного изобилия или расточительства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошь",
                                "target_lang_sense_clarification": "состояние избытка и богатства"
                            },
                            {
                                "target_lang_word": "расточительство",
                                "target_lang_sense_clarification": "чрезмерная трата ресурсов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}