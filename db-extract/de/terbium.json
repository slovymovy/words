                        "entry_id": "1f3ca356-0ecb-30bd-a0a1-5b86a8e1b927",
                        "glosses": [
                            "chemisches Element mit der Ordnungszahl 65, das zu den Lanthanoiden gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4c32a0-3a0e-464c-9796-0f39b66ad46c",
                                "sense_id": "0238f707-d86b-361b-8ba3-99762a836591",
                                "text": "Terbium ist ein silbergraues Metall."
                            },
                            {
                                "example_id": "b44100d7-8fbd-44a3-abcc-218ba09f6ffd",
                                "sense_id": "0238f707-d86b-361b-8ba3-99762a836591",
                                "text": "„Ob Neodym, Terbium oder Dysprosium – Seltenerdmetalle sind für moderne Technologien unverzichtbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceea7c27-739d-4153-b8bd-e333338dbf27",
