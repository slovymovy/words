{
    "word_family": [
        "szczupłość",
        "szczupleć",
        "wyszczupleć",
        "wyszczuplający"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9495fe01-dc4f-31ed-91a7-fca7f482b7a4",
                    "sense_definition": "o człowieku lub ciele: mający zgrabną, wąską sylwetkę i mało tłuszczu",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wygląd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W korytarzu spotkałem wysokiego, <w>szczupłego</w> chłopaka, który szukał sali numer pięć.",
                            "target_lang_translations": {
                                "en": "In the hallway, I met a tall, <w>slim</w> boy who was looking for room number five.",
                                "zh": "我在走廊上遇到一个身材高大、<w>消瘦</w>的男孩，他正在找五号教室。"
                            }
                        },
                        {
                            "text": "Dzięki regularnemu bieganiu i zdrowej diecie ma teraz bardzo <w>szczupłą</w> sylwetkę.",
                            "target_lang_translations": {
                                "en": "Thanks to regular running and a healthy diet, she now has a very <w>slender</w> figure.",
                                "zh": "多亏坚持跑步和健康饮食，她现在拥有非常<w>苗条</w>的身材。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smukły",
                        "wysmukły"
                    ],
                    "antonyms": [
                        "gruby",
                        "tęgi"
                    ],
                    "common_phrases": [
                        "szczupła sylwetka",
                        "szczupła talia",
                        "szczupła twarz"
                    ],
                    "target_lang_definitions": {
                        "en": "describing a person or body: having an attractively slender build with little body fat",
                        "zh": "（人或身材）苗条的、瘦弱的，体态匀称且脂肪少"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slim",
                                "target_lang_sense_clarification": "attractively slender"
                            },
                            {
                                "target_lang_word": "slender",
                                "target_lang_sense_clarification": "gracefully thin"
                            },
                            {
                                "target_lang_word": "lean",
                                "target_lang_sense_clarification": "thin and fit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苗条",
                                "target_lang_sense_clarification": "形容身材匀称纤细，多用于女性或优美体型"
                            },
                            {
                                "target_lang_word": "瘦",
                                "target_lang_sense_clarification": "通指身体脂肪少、不胖"
                            },
                            {
                                "target_lang_word": "修长",
                                "target_lang_sense_clarification": "身材细高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf69496b-c86a-3edd-8bf5-21fb9c323890",
                    "sense_definition": "niewielki pod względem wielkości, liczby lub zasobów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ilość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz projekt musiał zmieścić się w niezwykle <w>szczupłym</w> budżecie na ten rok.",
                            "target_lang_translations": {
                                "en": "Our project had to fit within an extremely <w>tight</w> budget for this year.",
                                "zh": "我们的项目必须控制在今年极其<w>紧缩</w>的预算之内。"
                            }
                        },
                        {
                            "text": "Firma dysponuje bardzo <w>szczupłymi</w> środkami finansowymi na dalsze inwestycje.",
                            "target_lang_translations": {
                                "en": "The company has very <w>meager</w> financial resources for further investments.",
                                "zh": "公司用于进一步投资的资金非常<w>有限</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skąpy"
                    ],
                    "antonyms": [
                        "obfity",
                        "pokaźny"
                    ],
                    "common_phrases": [
                        "szczupły budżet",
                        "szczupłe środki",
                        "szczupłe zasoby"
                    ],
                    "target_lang_definitions": {
                        "en": "small or limited in size, quantity, or available resources",
                        "zh": "（数量、规模或资源等）微薄的、有限的、紧缩的"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tight",
                                "target_lang_sense_clarification": "limited or restricted, e.g. of a budget"
                            },
                            {
                                "target_lang_word": "scant",
                                "target_lang_sense_clarification": "barely sufficient, limited"
                            },
                            {
                                "target_lang_word": "slender",
                                "target_lang_sense_clarification": "meager or small in amount"
                            },
                            {
                                "target_lang_word": "meager",
                                "target_lang_sense_clarification": "lacking in quantity or richness"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微薄",
                                "target_lang_sense_clarification": "指资金、收入等微少"
                            },
                            {
                                "target_lang_word": "有限",
                                "target_lang_sense_clarification": "指资源、预算数量不多"
                            },
                            {
                                "target_lang_word": "紧缩",
                                "target_lang_sense_clarification": "指预算、资金等处于偏紧状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}