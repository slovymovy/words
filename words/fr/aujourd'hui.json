                {
                    "sense_id": "99d2b2d8-0dc0-3541-b6e2-45f3a85f1939",
                    "sense_definition": "À l'époque actuelle, à notre époque.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "epoque_actuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le monde d'<w>aujourd'hui</w>, les nouvelles technologies sont omniprésentes dans la vie quotidienne.",
                            "target_lang_translations": {
                                "en": "In the world of <w>today</w>, new technologies are everywhere in daily life.",
                                "ru": "В <w>современном</w> мире новые технологии повсюду присутствуют в повседневной жизни.",
                                "nl": "In de <w>hedendaagse</w> wereld zijn nieuwe technologieën overal aanwezig in het dagelijks leven.",
                                "de": "In der <w>heutigen</w> Welt sind neue Technologien im Alltag allgegenwärtig.",
                                "pl": "W <w>współczesnym</w> świecie nowe technologie są wszechobecne w codziennym życiu.",
                                "it": "Nel mondo di <w>oggi</w>, le nuove tecnologie sono onnipresenti nella vita quotidiana.",
                                "cs": "V <w>dnešním</w> světě jsou nové technologie všudypřítomné v každodenním životě.",
                                "tr": "<w>Günümüz</w> dünyasında yeni teknolojiler gündelik hayatın her alanında karşımıza çıkıyor.",
                                "es": "En el mundo de <w>hoy</w>, las nuevas tecnologías están omnipresentes en la vida diaria.",
                                "zh": "在<w>如今</w>的世界里，新技术已经渗透到日常生活的方方面面。"
                            }
                        },
                        {
                            "text": "Contrairement à autrefois, beaucoup de personnes travaillent <w>aujourd'hui</w> depuis leur domicile.",
                            "target_lang_translations": {
                                "en": "Unlike in the past, many people work from home <w>these days</w>.",
                                "ru": "В отличие от прошлого, многие люди <w>сегодня</w> работают из дома.",
                                "nl": "In tegenstelling tot vroeger werken veel mensen <w>tegenwoordig</w> vanuit huis.",
                                "de": "Anders als früher arbeiten <w>heutzutage</w> viele Menschen von zu Hause aus.",
                                "pl": "W przeciwieństwie do dawnych czasów wiele osób pracuje <w>obecnie</w> z domu.",
                                "it": "Diversamente da un tempo, <w>oggigiorno</w> molte persone lavorano da casa.",
                                "cs": "Na rozdíl od dřívějška mnoho lidí <w>dnes</w> pracuje z domova.",
                                "tr": "Eskiden olduğunun aksine, birçok insan <w>bugünlerde</w> evlerinden çalışıyor.",
                                "es": "A diferencia de antes, <w>hoy en día</w> mucha gente trabaja desde su casa.",
                                "zh": "和从前不同，<w>现在</w>很多人都在家里办公。"
                            }
                        }
                    ],
                    "synonyms": [
                        "actuellement",
                        "de nos jours",
                        "maintenant"
                    ],
                    "antonyms": [
                        "autrefois",
                        "jadis"
