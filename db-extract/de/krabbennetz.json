                        "glosses": [
                            "Netz für den Krabbenfang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fbf584-5127-44e9-993b-7104ddd1c69b",
                                "sense_id": "567036c2-8c5c-388d-a16f-221869259779",
                                "text": "„Sie nahmen ihre Waschwanne und ihr Krabbennetz, schütteten den größten Teil vom Wasser weg und trugen dann die Shrimps zum Ford, wo sie die Wanne auf den Rücksitz stellten.“"
                            }
                        ],
