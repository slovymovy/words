                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3285a2f3-28c1-3b40-a997-6776fc934a32",
                        "entry_id": "f4399bc6-5385-35c7-babd-f0ef251c8567",
                        "glosses": [
                            "Variante orthographique de Sequoyah (inventeur du syllabaire cherokee)."
                        ],
                        "tags": [
                            "alt-of",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ccbe5df0-c353-4c41-808f-608979dd887d",
                                "sense_id": "3285a2f3-28c1-3b40-a997-6776fc934a32",
                                "text": "Des voix s’élevèrent pourtant à Washington pour protester contre ces crimes : celle du Genevois Albert Gallatin, professeur à Harvard, puis sénateur et ministre des Finances des U.S.A., de 1801 à 1814, et celle d’un Cherokee célèbre, Séquoia, auteur d’un alphabet syllabique, compagnon d’armes de celui qui allait devenir le septième président des États-Unis : Andrew Jackson."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
