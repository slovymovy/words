                        "glosses": [
                            "Bestimmung von Höhenunterschieden im Gelände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c46ef16-b4a4-441a-b92a-74f8c98a1b5d",
                                "sense_id": "0f503413-b9f6-3c82-b561-e114bf8e2136",
                                "text": "Mit einem Nivelliergerät kann man im Gelände eine Nivellierung durchführen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9acebba0-e806-3373-a644-921430d2ae00",
                        "entry_id": "6b3366c2-57e7-3c5f-a50a-0c98e1a60299",
                        "glosses": [
                            "Behebung von Unterschieden, Anpassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48979085-4a0e-44b5-ade7-5b50fa4ac2e9",
                                "sense_id": "9acebba0-e806-3373-a644-921430d2ae00",
                                "text": "An den Universitäten ist ein Prozess der Nivellierung im Gange, der dem Leistungsgedanken nicht gerade förderlich ist."
                            },
                            {
                                "example_id": "ba9cd96b-a8a8-4c51-ada2-9087b56b79c8",
                                "sense_id": "9acebba0-e806-3373-a644-921430d2ae00",
                                "text": "Niemand will eine Nivellierung der Besonderheiten der einzelnen Mitgliedsstaaten der EU."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
