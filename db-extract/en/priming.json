                                    {
                                        "sense_id": "f3fef238-3817-39e7-9a2f-8a942a33df8e",
                                        "entry_id": "879c420e-06ec-36f1-93c8-55ac674265ea",
                                        "glosses": [
                                            "druh paměti, která není přístupná vědomé pozornosti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1aee02-039d-4684-acf1-1ec6fa4d9175",
                                                "sense_id": "f3fef238-3817-39e7-9a2f-8a942a33df8e",
                                                "text": "Aby vědci vyloučili možnost, že priming spustí v myslích pokusných objektů emoce, jež ovlivní jejich pozdější morální soudy, nechali obě skupiny vyplnit ještě dotazník, jak se zrovna cítí."
                                            },
                                            {
                                                "example_id": "0c9de037-2200-4288-bf60-a0107c1f9ea9",
                                                "sense_id": "f3fef238-3817-39e7-9a2f-8a942a33df8e",
                                                "text": "Z teorie primingu a provedených pokusů plyne, že předchozí zkušenost určuje, co a jak vidíme, slyšíme, jak si tyto informace vykládáme, jak je ukládáme do paměti, jak je později užíváme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1ae418c-3e0b-42e5-842c-96e35fabb10f",
