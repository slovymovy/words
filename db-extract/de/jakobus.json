                                                "example_id": "8f1f7091-2139-41e0-81da-e8e557f2a38b",
                                                "sense_id": "aebd1b32-3dbb-3606-bdc6-1ed8f3c57608",
                                                "text": "Jakuba znam jeszcze z podstawówki, ale jego żonę poznałem później."
                                            },
