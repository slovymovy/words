                "senses": [
                    {
                        "sense_id": "3449159b-06c9-3f4c-9776-3f4ee64c7ae7",
                        "entry_id": "ec5fd5f8-9099-3cfd-afd7-dd8f9270392e",
                        "glosses": [
                            "das Durchspielen eines Computerspieles so schnell wie möglich (wobei das eigentliche Ziel des Spieles nicht das schnelle Durchspielen ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634778da-4342-4f65-a772-31755a6b800f",
                                "sense_id": "3449159b-06c9-3f4c-9776-3f4ee64c7ae7",
                                "text": "Manche Speedruns sind äußerst beeindruckend."
                            },
                            {
                                "example_id": "a1251625-cfc0-4423-8bd0-08246163fb1b",
                                "sense_id": "3449159b-06c9-3f4c-9776-3f4ee64c7ae7",
                                "text": "Obwohl Speedruns seit ihrer Entstehung gehörig an Popularität gewonnen haben, fristet die Szene besonders in Deutschland immer noch ein Untergrunddasein."
                            },
                            {
                                "example_id": "a13b834e-4ae1-4813-b808-63614f53e80b",
                                "sense_id": "3449159b-06c9-3f4c-9776-3f4ee64c7ae7",
                                "text": "Der Speedrun ist somit auf seine wesentlichen Bestandteile reduziert: durch perfektes Timing, viel Geschicklichkeit und auch etwas Glück zügig das Ende erreichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b50d1ced-f7d5-424e-bfac-36eb76b8818c",
                        "source_entry_id": "ec5fd5f8-9099-3cfd-afd7-dd8f9270392e",
                        "source_sense_id": "3449159b-06c9-3f4c-9776-3f4ee64c7ae7",
                        "source_sense_description": "das Durchspielen eines Computerspiel so schnell wie möglich",
                        "target_lang_word": "speedrun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speedrun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dfbd69c-71af-3f8b-ba0f-e3e91199d561",
                                        "entry_id": "41d49c98-95c1-3658-b483-a20f76bc6b79",
                                        "glosses": [
                                            "A playthrough of a computer or video game in which the whole game or a select part of it, such as a single level, is played with the intent of completing it as quickly as possible, optionally with certain prerequisites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299e0bb7-9609-468c-a2a0-47f2e3be592f",
                                                "sense_id": "6dfbd69c-71af-3f8b-ba0f-e3e91199d561",
                                                "text": "In the speedrun of Super Mario Bros. 3, Anonymous Jones finishes the whole game in just 11 minutes."
                                            },
                                            {
                                                "example_id": "a3e1b369-5569-43b8-b360-349c1333f865",
                                                "sense_id": "6dfbd69c-71af-3f8b-ba0f-e3e91199d561",
                                                "text": "This paper concerns speedruns of Minecraft: Java Edition, and, in particular, speedruns of the category known as \"Any% Random Seed Glitchless\" (RSG) performed on version 1.16. A brief summary of the relevant mechanics and speedrun strategies follows for the unfamiliar reader."
                                            },
                                            {
                                                "example_id": "82b4c87c-d51f-4df4-84a8-c525a2bc9a31",
                                                "sense_id": "6dfbd69c-71af-3f8b-ba0f-e3e91199d561",
                                                "text": "Many of the strats for the Glitchless speedrun came from Distortion2, who is a widely known speedrunner who has broken records in games Elden Ring and Seikiro."
                                            },
                                            {
                                                "example_id": "7c7ff0d6-4e5d-466e-9d39-6045f3963859",
                                                "sense_id": "6dfbd69c-71af-3f8b-ba0f-e3e91199d561",
                                                "text": "Mae, who describes herself on Patreon as a 20-year-old university student from Canada, holds several world records for Baldur’s Gate 3 speedruns already — including her insane 4:15 any% speedrun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "speedrun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4af7ec77-e0cc-3ff3-8f9e-27c5861e81a5",
                                        "entry_id": "9445c8e7-0e7c-3868-a214-873be1544349",
                                        "glosses": [
                                            "To perform or create a speedrun."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56cbaee4-add7-4e8c-99b5-956e0da223d4",
                                                "sense_id": "4af7ec77-e0cc-3ff3-8f9e-27c5861e81a5",
                                                "text": "In my most recent attempt to speedrun this game, I almost managed to beat the world record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c243aef-908b-334f-a384-93fe28033372",
                                        "entry_id": "9445c8e7-0e7c-3868-a214-873be1544349",
                                        "glosses": [
                                            "To do something or undergo some process as quickly as possible."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dcb19c5-261a-4d4b-9fb4-649088ae4085",
                                                "sense_id": "7c243aef-908b-334f-a384-93fe28033372",
                                                "text": "John decided to speedrun his trip to the grocery store."
                                            },
                                            {
                                                "example_id": "7eaeb907-e6c3-4270-9204-961727853172",
                                                "sense_id": "7c243aef-908b-334f-a384-93fe28033372",
                                                "text": "Dre said in an interview that he created SCAM to poke fun at other \"shitcoins\" or cryptocurrencies that are clearly pump-and-dump schemes, but at the same time make some money for people willing to put money behind it without any lofty talk to convince people anything more noble is going on. In doing so, SCAM is speedrunning the path of many cryptocurrencies: It hit a $70 million market cap (the snapshot current value of all tokens in circulation) almost immediately after launching, then slumped to $7 million, then $5 million, and now sits at $2.5 million."
                                            },
                                            {
                                                "example_id": "a665cf02-cbeb-4bcd-9c59-0274828b9b85",
                                                "sense_id": "7c243aef-908b-334f-a384-93fe28033372",
                                                "text": "I maintain that the first burrito he ever speedran was the most delicious, was folded with the most care, and had the best ratio of fillings, but burrito speedrunning is not about the flavour, it's about the time."
                                            },
                                            {
                                                "example_id": "81a950c8-d94f-4cf5-8289-5ec76d55523f",
                                                "sense_id": "7c243aef-908b-334f-a384-93fe28033372",
                                                "text": "While DeSantis' allies have been speedrunning his political vendettas through the legislature, the Yale and Harvard alum embarked on a national tour ostensibly to promote his literary opus entitled The Courage to Be Free: Florida's Blueprint for America's Revival."
                                            },
                                            {
                                                "example_id": "33520c9a-0080-4d65-8a52-bbacaa985d39",
                                                "sense_id": "7c243aef-908b-334f-a384-93fe28033372",
                                                "text": "The result is an ouroboros of faith and science, where an intentional blurring of lines has created a society where a civilization is speedrunning through its development unaware that there are hands pushing them along."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
