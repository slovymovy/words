                        "source_sense_description": "Informatik, Digitaltechnik: eine Mengeneinheit, siehe auch Byte",
                        "target_lang_word": "exabyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exabyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68ea18f6-e927-3ecc-bd5e-031ba90350ac",
                                        "entry_id": "563a968d-9de2-3309-9cc5-842a545917c0",
                                        "glosses": [
                                            "One quintillion (10¹⁸, or 1,000,000,000,000,000,000) bytes or 1,000 petabytes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ebef3e9-be6b-4fd9-a836-a5ef2daa360f",
                                                "sense_id": "68ea18f6-e927-3ecc-bd5e-031ba90350ac",
                                                "text": "Altogether, the human brain is estimated to hold something in the order of 200 exabytes of information."
                                            },
                                            {
                                                "example_id": "d5aa1301-f5c4-4334-8571-d32f9102c055",
                                                "sense_id": "68ea18f6-e927-3ecc-bd5e-031ba90350ac",
                                                "text": "North American cloud traffic in 2015 measured 1.891 exabytes per year, in the Asia Pacific 908 exabytes per year, […]"
                                            },
                                            {
                                                "example_id": "823c2614-2c4f-42f5-8f70-778a2ecdffed",
                                                "sense_id": "68ea18f6-e927-3ecc-bd5e-031ba90350ac",
                                                "text": "In 2010, Google's CEO, Eric Schmidt, stated: “There were 5 Exabytes of information created between the dawn of civilization through 2003, but that much information is now created every 2 days” (Schmidt, 2010). Schmidt's forecast, indeed, proved to be an underestimation."
                                            }
                                        ]
                                    },
