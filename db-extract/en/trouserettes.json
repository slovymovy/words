                                "example_id": "b766fa16-2a24-4a33-b81c-8d1329196b29",
                                "sense_id": "7a1b5cf5-3b74-328c-8992-9a098b426449",
                                "text": "ANYBODY who thinks that the suffragettes are going to take to trouserettes, anybody who expects to see a suffragette in trouserettes telling the world from a soap box on a street corner that taxation without representation is tyranny, has only to mention trouserettes to a few suffragettes to find out his or her mistake."
                            },
                            {
                                "example_id": "18e87d46-68f8-4dc2-b783-8bdd97ba20b1",
                                "sense_id": "7a1b5cf5-3b74-328c-8992-9a098b426449",
                                "text": "“We think our blue and brown smocks and trouserettes are as honorable and significant a uniform as that of the soldiers in khaki,” said one young woman who was engaged in the dangerous handling of cordite. All women who work on machinery wear trouserettes and many have had their hair cut short in the interest of safety and comfort."
                            },
                            {
                                "example_id": "e9b8e841-de59-4529-982a-0239936d72d5",
                                "sense_id": "7a1b5cf5-3b74-328c-8992-9a098b426449",
                                "text": "Red trouserettes on waitresses cause stir"
                            }
                        ]
