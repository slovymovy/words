        "fr-extract.jsonl": [
            {
                "entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                "word": "alcade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e890d61-d078-409a-ab27-7da93d4e5585",
                        "entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                        "tags": [
                            "plural"
                        ],
                        "form": "alcades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43372382-074b-3b8f-a77c-8d8f0bf8d7dc",
                        "entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                        "glosses": [
                            "Juge ou magistrat d’Espagne, dont l’attribut distinctif est une longue batte blanche."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d177dccc-6631-4c7a-a603-0009aab71578",
                                "sense_id": "43372382-074b-3b8f-a77c-8d8f0bf8d7dc",
                                "text": "DON CARLOS. Je te fais alcade du palais."
                            },
                            {
                                "example_id": "ae0c025b-c763-4bfe-836f-e525151f87f5",
                                "sense_id": "43372382-074b-3b8f-a77c-8d8f0bf8d7dc",
                                "text": "Nous y rencontrâmes quelques alcades des environs, dont la physionomie eût paru suspecte au coin d’un bois, et qui auraient bien fait de se demander leurs papiers à eux-mêmes avant de se laisser circuler librement."
                            }
                        ]
                    },
                    {
                        "sense_id": "26c7e549-d60e-34f9-88e7-7e0cf01aff2d",
                        "entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                        "glosses": [
                            "Maire en Espagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2280bc-06f6-4c13-ba9e-99e3ac2716d0",
                                "sense_id": "26c7e549-d60e-34f9-88e7-7e0cf01aff2d",
                                "text": "L’on a vu des taureaux de muchas piernas (de beaucoup de jambes), comme on les appelle techniquement, franchir la seconde enceinte, comme en fait foi une gravure de la Tauromaquia de Goya, le célèbre auteur des Caprices, gravure qui représente la mort de l’alcade' de Torrezon, misérablement embroché par un taureau sauteur."
                            },
                            {
                                "example_id": "204018f2-3708-4145-94e3-0cba1bd8ad4e",
                                "sense_id": "26c7e549-d60e-34f9-88e7-7e0cf01aff2d",
                                "text": "Mais, sire, nous étions mariés devant l‘alcade et devant le prêtre. Elle a juré sur l’Évangile…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cc67708-01cb-45ca-99e4-6cb7b27b5f5c",
                        "source_entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                        "target_lang_word": "Alkalde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a5ff5fea-7a67-4d5e-9367-abff995ce6a2",
                        "source_entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                        "target_lang_word": "Ortsrichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "85677de0-d086-4fb6-b2ca-2cbded853a77",
                        "source_entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                        "target_lang_word": "Bürgermeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgermeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                        "entry_id": "4815ec34-5c57-371b-b095-42ed891a436b",
                                        "glosses": [
                                            "Oberhaupt einer Stadt, Gemeinde oder anderen Kommune"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683fa349-fb8d-4351-8a93-60d85171fdc2",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "Bürgermeister und Gemeinderat verabschieden den neuen Gemeindehaushalt."
                                            },
                                            {
                                                "example_id": "681e9d45-d377-4a45-8e82-9fb11e355480",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "Es sind nicht die klügsten Bauern, die sich zum Bürgermeister wählen lassen."
                                            },
                                            {
                                                "example_id": "ee4e4e48-b56b-4de6-a96d-829ee8f82333",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„Als Humboldt spätabends vom Empfang beim Bürgermeister heimkam, wollte sein Gastgeber mit ihm trinken.“"
                                            },
                                            {
                                                "example_id": "8137529f-f846-42e7-9415-b2395af3c59a",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„In seinem Amtszimmer angekommen, setzt sich der Bürgermeister einen Augenblick in seinen Sessel und denkt nach.“"
                                            },
                                            {
                                                "example_id": "587ded34-f0ac-49b9-9643-4a77948c81c1",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„Der spätere Bonner Bürgermeister war schon als Kind Mitglied von Johannas Gesangverein und einer ihrer glühenden Verehrer.“"
                                            },
                                            {
                                                "example_id": "0e1be245-07a0-43f7-ac70-9d361e3507ac",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„Es war seine dritte Amtszeit als Bürgermeister, und abgesehen von seiner Intelligenz hatte der Mann eine ganz außergewöhnliche Arbeitsdisziplin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36cb6a58-9b26-4352-9626-041905ec4a0f",
                        "source_entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
