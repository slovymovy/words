{
    "word_family": [
        "gnarled",
        "gnarly",
        "gnarling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4958f49e-ecf0-363e-9841-0dcceaff7e84",
                    "sense_definition": "A knot in wood or a hard protuberance with twisted grain on the trunk of a tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old oak tree was covered in every <w>gnarl</w> and bump imaginable after centuries of growth.",
                            "target_lang_translations": {
                                "ru": "Старый дуб за столетия роста покрылся всеми мыслимыми <w>наростами</w> и буграми."
                            }
                        },
                        {
                            "text": "He ran his hand over the rough <w>gnarl</w> on the surface of the wooden table.",
                            "target_lang_translations": {
                                "ru": "Он провел рукой по грубому <w>сучку</w> на поверхности деревянного стола."
                            }
                        }
                    ],
                    "synonyms": [
                        "knot",
                        "knurl",
                        "protuberance"
                    ],
                    "common_phrases": [
                        "rough gnarl",
                        "wooden gnarl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узел в древесине или твердый нарост с перекрученными волокнами на стволе дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарост",
                                "target_lang_sense_clarification": "на стволе дерева"
                            },
                            {
                                "target_lang_word": "сучок",
                                "target_lang_sense_clarification": "узел в древесине"
                            },
                            {
                                "target_lang_word": "кап",
                                "target_lang_sense_clarification": "нарост с перекрученными волокнами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bffcf0b-dff0-3383-82a7-9fdb134b2c48",
                    "sense_definition": "Something that resembles a knot in wood, such as a twisted part of a limb or a deformity in stone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arthritis had turned the joints of his fingers into a painful <w>gnarl</w>.",
                            "target_lang_translations": {
                                "ru": "Артрит превратил суставы его пальцев в болезненные <w>узлы</w>."
                            }
                        },
                        {
                            "text": "The geologist pointed out a strange <w>gnarl</w> in the ancient rock formation.",
                            "target_lang_translations": {
                                "ru": "Геолог указал на странное <w>искривление</w> в древней горной породе."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "deformity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, напоминающее древесный узел, например, искривленная часть конечности или деформация в камне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "деформация или искривление"
                            },
                            {
                                "target_lang_word": "шишка",
                                "target_lang_sense_clarification": "выпуклость или нарост"
                            },
                            {
                                "target_lang_word": "искривление",
                                "target_lang_sense_clarification": "деформация формы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66654b44-268b-3ccd-a3a3-c878732a9727",
                    "sense_definition": "To twist or knot something into a distorted shape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "twisting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat of the fire began to <w>gnarl</w> the plastic frames of the windows.",
                            "target_lang_translations": {
                                "ru": "Сильный жар от огня начал <w>корежить</w> пластиковые рамы окон."
                            }
                        },
                        {
                            "text": "Years of hard labor in the cold will <w>gnarl</w> even the strongest hands.",
                            "target_lang_translations": {
                                "ru": "Годы тяжелого труда на холоде <w>скрючат</w> даже самые сильные руки."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "contort",
                        "knot"
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скручивать или завязывать что-либо, придавая искаженную форму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скручивать",
                                "target_lang_sense_clarification": "деформировать"
                            },
                            {
                                "target_lang_word": "корежить",
                                "target_lang_sense_clarification": "искажать форму"
                            },
                            {
                                "target_lang_word": "искривлять",
                                "target_lang_sense_clarification": "делать неровным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e165bf6-4fe4-35af-983f-70e3a17cf779",
                    "sense_definition": "To snarl or growl like an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dogs began to <w>gnarl</w> at each other over the scraps of food.",
                            "target_lang_translations": {
                                "ru": "Бродячие собаки начали <w>рычать</w> друг на друга из-за объедков."
                            }
                        },
                        {
                            "text": "I could hear the wolves <w>gnarl</w> in the distance as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как вдалеке <w>рычат</w> волки, когда солнце начало садиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "snarl",
                        "growl",
                        "gnar"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English compared to snarl"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огрызаться или рычать подобно животному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычать",
                                "target_lang_sense_clarification": "издавать злобный звук"
                            },
                            {
                                "target_lang_word": "огрызаться",
                                "target_lang_sense_clarification": "с рычанием"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a10b552-e5c3-3f37-823a-418784ce636f",
                    "sense_definition": "Being <w>gnarled</w>, knotty, or twisted in appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "twisting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gnarl</w> roots of the ancient willow tree reached deep into the riverbank.",
                            "target_lang_translations": {
                                "ru": "<w>Узловатые</w> корни древней ивы уходили глубоко в берег реки."
                            }
                        },
                        {
                            "text": "He used a <w>gnarl</w> walking stick that he had carved himself from a fallen branch.",
                            "target_lang_translations": {
                                "ru": "Он пользовался <w>корявой</w> тростью, которую сам вырезал из упавшей ветки."
                            }
                        }
                    ],
                    "synonyms": [
                        "gnarled",
                        "knotty",
                        "twisted"
                    ],
                    "antonyms": [
                        "smooth",
                        "straight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узловатый, шишковатый или искривленный на вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узловатый",
                                "target_lang_sense_clarification": "с узлами или наростами"
                            },
                            {
                                "target_lang_word": "корявый",
                                "target_lang_sense_clarification": "изогнутый и неровный"
                            },
                            {
                                "target_lang_word": "скрюченный",
                                "target_lang_sense_clarification": "сильно искривленный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}