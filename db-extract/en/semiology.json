                                        "glosses": [
                                            "Description spécifique de systèmes de signes particuliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a7c4be-767e-45ab-9582-51e9eb2fcca6",
                                                "sense_id": "68526b6a-c674-31d2-93a6-6d6f8dad9e69",
                                                "text": "La théorie générale des signes a été baptisée sémiologie par Ferdinand de Saussure."
                                            },
                                            {
                                                "example_id": "b38f3dad-6ea4-40e6-8121-fab6a0c2cc98",
                                                "sense_id": "68526b6a-c674-31d2-93a6-6d6f8dad9e69",
                                                "text": "Pas de sémiologie qui finalement ne s’assume comme une sémioclastie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf52637-0299-34c7-a851-4239e55f04b4",
                                        "entry_id": "e44806b0-9d3a-30d4-b99e-f715037f1193",
                                        "glosses": [
                                            "Partie de la médecine qui traite des signes cliniques et des symptômes des maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b372a137-0222-44d8-8752-b9a0e14ac31d",
                                                "sense_id": "9cf52637-0299-34c7-a851-4239e55f04b4",
                                                "text": "Le patient n’aura conservé aucun souvenir conscient de votre visite et il vous saluera comme la première fois. Les externes en médecine qui découvrent ainsi la sémiologie neurologique répètent souvent à souhait ce test clinique abasourdissant. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 389)"
                                            },
                                            {
                                                "example_id": "ea042e8c-b802-4ff5-9a37-2a239e7e827a",
                                                "sense_id": "9cf52637-0299-34c7-a851-4239e55f04b4",
                                                "text": "La sémiologie générale indique une incidence importante du traumatisme sexuel sur la sphère cognitive."
                                            }
                                        ]
                                    }
                                ]
                            }
