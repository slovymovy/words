                        "sense_id": "62eb25ff-a4e7-361b-b6c7-3f4bb557c5a7",
                        "entry_id": "aab231cd-5fb9-3fc0-9da7-6e93c7831a9f",
                        "glosses": [
                            "Scientifique qui étudie l’astrophysique, l’étude de l’espace et des propriétés des objets de l’univers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc8e8d6-9ebf-4eb7-b41e-1522195cf9c6",
                                "sense_id": "62eb25ff-a4e7-361b-b6c7-3f4bb557c5a7",
                                "text": "En effet, l’astrophysicien québécois Hubert Reeves fait partie des personnalités du monde scientifique que les ésotéristes ont kidnappées dans leurs rangs sans les consulter et, dans le cas précis d’Hubert Reeves, sans qu’il n’y ait aucun fondement à sa prétendue adhésion au monde de l’ésotérisme."
                            },
                            {
                                "example_id": "c20926a1-89aa-423f-854c-abb7a95cd7c0",
                                "sense_id": "62eb25ff-a4e7-361b-b6c7-3f4bb557c5a7",
                                "text": "En 1995, Michel Mayor et Didier Queloz, deux astrophysiciens suisses, présentent au monde Bellérophon, nom officiel « 51 Pegasi b »."
                            }
                        ]
                    }
