                "senses": [
                    {
                        "sense_id": "a782886e-a727-3db0-984b-80e790825a02",
                        "entry_id": "34a47415-7875-3da2-bb01-57655c30d382",
                        "glosses": [
                            "an einem Gegenstand angebrachter Haken, der rückwärtsgerichtet ist und ein Entfernen erschweren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0892ca-9f92-4e4d-aa0f-c16170e2bc66",
                                "sense_id": "a782886e-a727-3db0-984b-80e790825a02",
                                "text": "„An Waffen besitzen sie sechs Fuß lange Bogen aus Zedernholz, die an einem Ende mit einer kurzen eisernen Spitze versehen sind und auch als Speere verwendet werden können; die Pfeile haben eiserne, steinerne oder knöcherne Widerhaken.“"
                            },
                            {
                                "example_id": "9a3376e9-2cb1-466b-91d2-7c5db3d12570",
                                "sense_id": "a782886e-a727-3db0-984b-80e790825a02",
                                "text": "„Aber der dürre lange Tote war Morten Sise, der Kapitän selber, und da er zeit seines Lebens ein sonderbarer Kauz gewesen war, wollte er auch jetzt im Meere bleiben, wo es ihm immer am besten gefallen hatte, und wie sehr man auch mit Stangen und Widerhaken an ihm zerrte, er gab nicht nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "403796c4-a0c1-4db3-a480-eb6731f93997",
                        "source_entry_id": "34a47415-7875-3da2-bb01-57655c30d382",
                        "source_sense_id": "a782886e-a727-3db0-984b-80e790825a02",
                        "source_sense_description": "an einem Gegenstand angebrachter Haken, der rückwärtsgerichtet ist und ein Entfernen erschweren soll",
                        "target_lang_word": "barb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barb",
