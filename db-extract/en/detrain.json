                ],
                "senses": [
                    {
                        "sense_id": "4679476b-3549-337b-bdc9-7714dfdcadab",
                        "entry_id": "81ac5dad-8fa2-3c2a-b862-722d8b734588",
                        "glosses": [
                            "aus einem Zug aussteigen, einen Zug verlassen"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ffe32d00-7048-4fff-8587-571ad34f6ba6",
                                "sense_id": "4679476b-3549-337b-bdc9-7714dfdcadab",
                                "text": "The train will stop at Berlin main station for passengers to detrain.",
                                "translation": "Der Zug wird im Berliner Hauptbahnhof halten, damit die Passagiere aussteigen können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c7afdc8-b18b-4d30-a635-b687e1710595",
                        "source_entry_id": "81ac5dad-8fa2-3c2a-b862-722d8b734588",
                        "source_sense_id": "4679476b-3549-337b-bdc9-7714dfdcadab",
                        "source_sense_description": "intransitiv: aus einem Zug aussteigen, einen Zug verlassen",
                        "target_lang_word": "aussteigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aussteigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "sich aus einem Beförderungsmittel begeben, ein Verkehrsmittel verlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f947ed-d25d-4ab0-b51d-84702e12712d",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„In der ersten Station fiel ihm plötzlich ein, jetzt könne er noch aussteigen, den Gegenzug abwarten, mit diesem nach P. und an den Ort, wo Oberleutnant A. sich aufhielt, fahren, mit ihm dann die dreistündige Bahnfahrt zum Postamt machen usf.“"
                                            },
                                            {
                                                "example_id": "ebe6c31d-3abf-4f47-8a11-06c6d4dfa426",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Sofort nach Ankunft des Zuges wird ein Geheimpolizist aussteigen und Ihnen mitteilen, was man auf der Strecke beobachtet hat.“"
                                            },
                                            {
                                                "example_id": "20d860ed-c434-4474-8f89-5d613fd6a014",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Mich machte diese stumme Feindseligkeit nervös, ich stieg eine Station zu früh aus, und ich ging zu Fuß das Stück die Ebertallee hinunter, bevor ich zum Rhein hin abschwenkte.“"
                                            },
                                            {
                                                "example_id": "47a2a94e-328f-4c4b-9923-0657849e83a5",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Der Sägemüller läßt seine Koffer von einem Gepäckträger auf den Bahnsteig schleppen, steigt in den fernumwehten Interzonenzug und fährt, jeder Zoll ein Gentleman, vom Zoologischen Garten zur Friedrichstraße der Stadt Berlin. Dort steigt er aus.“"
                                            },
                                            {
                                                "example_id": "25851c14-1f63-4dba-99d8-947dea5006d7",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Einmal mußte ich umsteigen, war froh über mein leichtes Köfferchen und ließ mich dann von der Metro in Richtung Süden entführen, überlegte: Wo steigst du aus, Oskar - mein Gott, was alles an einem Tag passieren kann:[…]?“"
                                            },
                                            {
                                                "example_id": "2f8fcef9-15c2-4737-ba86-f3624e4d9efe",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Später fuhr ich mit der Subway, wie üblich: Irt, Express Uptown, ohne Umsteigen am Columbus Circle, obschon ich mit der Independent näher zu meiner Wohnung gelangen könnte, aber ich bin in elf Jahren nie umgestiegen, ich stieg aus, wo ich immer ausgestiegen bin, und ging wie üblich, im Vorbeigehen, zu meiner Chinese Laundry, wo man mich noch kennt.“"
                                            },
                                            {
                                                "example_id": "34e7a52e-15e1-440d-9013-c9222ce001ec",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Das Mädchen stieg im dritten Stock aus, deshalb fuhr er weiter zum vierten.“"
                                            },
                                            {
                                                "example_id": "34f7fe1b-e0d0-480c-98d4-9b423bc92775",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "„Harrison H. Schmitt setzte als bislang letzter Mensch am 12. Dezember 1972 seinen Fuß auf den Mondboden – der Pilot war als Letzter aus der Mondfähre ausgestiegen.“"
                                            },
                                            {
                                                "example_id": "a80c0046-54ea-4c68-9c69-7f472118f02a",
                                                "sense_id": "effe7fd5-f6bd-3c1d-b177-3c773818b1a8",
                                                "text": "Wir sind an der Endstation und müssen jetzt aussteigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a81a34b4-5267-3b69-9018-c674331cb9d5",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "sich bei Gefahr durch Betätigen des Schleudersitzes oder durch Abspringen mit dem Fallschirm retten"
                                        ],
                                        "tags": [
                                            "Fliegersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da1c474-a153-4c2f-83eb-d96299e8e71a",
                                                "sense_id": "a81a34b4-5267-3b69-9018-c674331cb9d5",
                                                "text": "„Wegen der geringen Höhe habe der Pilot keine Möglichkeit mehr gehabt, mit dem Fallschirm auszusteigen.“"
                                            },
                                            {
                                                "example_id": "69b6e9e5-5a4e-42ea-9899-7ba1a841d457",
                                                "sense_id": "a81a34b4-5267-3b69-9018-c674331cb9d5",
                                                "text": "„Für Notfälle sehen die Dienstanweisungen der Bundesluftwaffe vor, dass der Pilot ‚aussteigt‘ und die Maschine aufgibt, selbst wenige Meter über dem Boden wäre theoretisch noch Gelegenheit dazu.“"
                                            },
                                            {
                                                "example_id": "d5272bf9-aeab-4ec5-af0d-b81a834454e4",
                                                "sense_id": "a81a34b4-5267-3b69-9018-c674331cb9d5",
                                                "text": "„Der Pilot, Oberleutnant Jewgenij Lwowitsch Wronskij, war vorher per Schleudersitz ausgestiegen und nördlich des Dorfes Hötzum unmittelbar neben einer Standortschießanlage der Bundeswehr mit seinem Fallschirm unverletzt auf einem Feld gelandet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e66f729f-6ecb-3314-8f36-f5022e402279",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "aus dem Wasser steigen"
                                        ],
                                        "tags": [
                                            "Jägersprache",
                                            "vom Biber, Fischotter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdcd92d4-1ce6-4059-b59f-839038b92be6",
                                                "sense_id": "e66f729f-6ecb-3314-8f36-f5022e402279",
                                                "text": "„Um die Tellereiſen für Biber zu legen, muß man den Ort wiſſen, wo ſie am Ufer ein- und ausﬅeigen; […].“"
                                            },
                                            {
                                                "example_id": "07a6bea3-8101-4ede-9dd2-e68c9d2c455a",
                                                "sense_id": "e66f729f-6ecb-3314-8f36-f5022e402279",
                                                "text": "„Wenn der Biber auf dieser Seite aussteigen würde – was bis jetzt noch nicht beobachtet wurde – würde er sicher diese geschützte, flache Uferzone mit hohem Grasbewuchs wählen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cd435cc3-e9f3-3d4d-8870-3af152dbd8bd",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "bei etwas nicht mehr mitwirken, teilnehmen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c94489-3702-45f9-814f-2e8c078d9808",
                                                "sense_id": "cd435cc3-e9f3-3d4d-8870-3af152dbd8bd",
                                                "text": "Obwohl das Projekt noch nicht gescheitert ist, will er nun aussteigen."
                                            },
                                            {
                                                "example_id": "4d13d5db-0623-4129-80ff-8f0c8c025541",
                                                "sense_id": "cd435cc3-e9f3-3d4d-8870-3af152dbd8bd",
                                                "text": "„Er rufe an, weil ihm gerade einer ausgestiegen sei, ein junger Kerl aus Austin, Texas. Der hätte am 26. August in Oakland, Kalifornien, anfangen müssen, sei deshalb in der vergangenen Woche da gewesen, um sich hier einzurichten; […].“"
                                            },
                                            {
                                                "example_id": "866f3ffc-47d5-4ca8-807a-c4d807eeae7d",
                                                "sense_id": "cd435cc3-e9f3-3d4d-8870-3af152dbd8bd",
                                                "text": "[…] „während die EU seit Russlands Invasion in der Ukraine begonnen hat, aus der russischen Rohstoffversorgung nach und nach auszusteigen, steigert jetzt Indien den Einkauf russischen Rohöls.“"
                                            },
                                            {
                                                "example_id": "7308b5a4-87b5-4ac1-9a7d-cd5c7313142c",
                                                "sense_id": "cd435cc3-e9f3-3d4d-8870-3af152dbd8bd",
                                                "text": "Damals war das risikoscheue Deutschland aus der CCS-Technik ausgestiegen, bevor es überhaupt richtig losging."
                                            },
                                            {
                                                "example_id": "680498ad-83b4-463c-984e-6187afbd24fd",
                                                "sense_id": "cd435cc3-e9f3-3d4d-8870-3af152dbd8bd",
                                                "text": "„Sohn eines vielfach an der Politik gescheiterten und durch Politik geschädigten Mannes, trotzdem idealistisch von Anfang an, dann ein Studentenulk, seriöse Folgen dieses Ulks nützt der Staatssicherheitsdienst zur Erpressung, Wolf geht nur zum Schein darauf ein, erkennt erst im Westen die unselige Tendenz der deutschen Teilung, jetzt will er wirklich helfen, aber er scheitert, außer Spielmaterial hat er fast nichts hinübergebracht, er selber ein Spielball der miteinander konkurrierenden deutschen Staatsschutzdienste, er selber ein groteskes Produkt der immer grotesker werdenden deutsch-deutschen Polarisierung, bis er beschließt, auszusteigen aus dieser unseligen deutsch-deutschen Konkurrenz, an nichts mehr zu denken als an seine Frau, an sich, das kommende Kind, die kommenden Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d0ef4eac-301a-35c1-9625-3068def54dc6",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "ein Spiel, Wettkampf (als Teilnehmer) vorzeitig abbrechen; sich an einem Spiel, Wettkampf nicht mehr beteiligen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9739473-2a99-4cf1-ab56-d0e9e366dedd",
                                                "sense_id": "d0ef4eac-301a-35c1-9625-3068def54dc6",
                                                "text": "„Der fünfmalige Gewinner des ‚Grünen Trikots‘ des besten Sprinters der Tour de France, Erik Zabel (Unna) vom Team Telekom, war am Samstag nach der vierten Etappe aus dem Rennen ausgestiegen und zu den Olympischen Spielen nach Sydney abgereist.“"
                                            },
                                            {
                                                "example_id": "8d9f8104-ec69-486d-ae50-ba43c0119b0b",
                                                "sense_id": "d0ef4eac-301a-35c1-9625-3068def54dc6",
                                                "text": "„Doch nach 20 Kilometern stieg Zaituc aus dem Rennen aus.“"
                                            },
                                            {
                                                "example_id": "c5e2b82c-874a-4831-853d-63b7254ea8cf",
                                                "sense_id": "d0ef4eac-301a-35c1-9625-3068def54dc6",
                                                "text": "„‚Zusammen freut es sich einfach am besten. Das verleiht einem Flügel‘, sagte die Sprintspezialistin, die sofort nach dem Rennen aus der Tour de Ski ausstieg, um Kraft für die Sprintrennen in Mailand (14./15. Januar) zu sparen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a6c2de78-024b-38a9-ba7c-ab6cb28b1cfc",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "(zumeist ziemlich abrupt) seine berufliche Tätigkeit sowie seine sozialen Bindungen und dergleichen aufgeben (um sich von allen Zwängen zu befreien und ein neues Leben abseits gesellschaftlicher Normen zu führen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478ca4c9-76bb-4666-b953-3390dc57e63e",
                                                "sense_id": "a6c2de78-024b-38a9-ba7c-ab6cb28b1cfc",
                                                "text": "„Claire bekommt den Wunsch, auszusteigen, woanders neu anzufangen.“"
                                            },
                                            {
                                                "example_id": "70c97867-f126-4263-851e-6525ace199f7",
                                                "sense_id": "a6c2de78-024b-38a9-ba7c-ab6cb28b1cfc",
                                                "text": "„In Zeiten, in denen Alltagsfrust und Stress überhand nehmen, würden viele gerne aussteigen und den Alltag für immer hinter sich lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "fd4005bd-9a5a-3bef-a739-16bb3f815e0c",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "seine Erwerbstätigkeit aufgeben"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f676022e-4b00-44df-a638-614cee52615d",
                                                "sense_id": "fd4005bd-9a5a-3bef-a739-16bb3f815e0c",
                                                "text": "„Wolff ist aus dem staatlichen Schuldienst ausgestiegen, nach 22 Jahren, um am Jenaplan-Gymnasium neu anzufangen.“"
                                            },
                                            {
                                                "example_id": "4b834e27-6b10-4f0f-b5c6-73af5d92ee22",
                                                "sense_id": "fd4005bd-9a5a-3bef-a739-16bb3f815e0c",
                                                "text": "„Peter und Sabine Lauf sind 1981 aus ihren alten Berufen ausgestiegen und haben in der Gastronomie neu angefangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "fc517401-5f7e-370a-a43e-d473f359f721",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "die Flucht ergreifen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "3ae6508a-e9c6-3f20-86d2-fb40b3bea3b8",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "das Studium vorzeitig zum Abschluss bringen, enden lassen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "467c9ab0-7a8b-3b27-9009-5d3d3bdda291",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "sich des Rauschmittels entwöhnen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a797c6f-82aa-4ad3-bbeb-5d3763253713",
                                                "sense_id": "467c9ab0-7a8b-3b27-9009-5d3d3bdda291",
                                                "text": "„Rund 80 Prozent der Abhängigen steigen irgendwann aus und bleiben clean, durch die HIV-Ansteckung aber steigt die Zahl der Drogentoten.“"
                                            },
                                            {
                                                "example_id": "67dadf17-fd67-4cd7-bb23-e8f79858e7eb",
                                                "sense_id": "467c9ab0-7a8b-3b27-9009-5d3d3bdda291",
                                                "text": "„Sie geht aufs Gymnasium, bereits als 13-Jährige konsumiert sie Alkohol, Marihuana, vierzehnjährig auch Crack. Sie wird süchtig, lebt zwei Jahre auf der Straße, wird schwanger, steigt aus, wird clean, ist infiziert, bringt 1999 eine Tochter zur Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                        "entry_id": "ca7fa29e-5f36-31f1-a32f-adae32da39d3",
                                        "glosses": [
                                            "(mitten in einer Tätigkeit oder dergleichen plötzlich für eine gewisse Zeit oder dauerhaft) aufhören zu funktionieren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607250d6-4a7a-4ee8-9bc5-9bd42122b950",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Wir hatten Angst, dass uns die 15-jährigen Ticket-Automaten bald aussteigen.“"
                                            },
                                            {
                                                "example_id": "e2fdc303-0c50-4f15-b4c7-623d82f25d5b",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Nach einer Viertelstunde stieg der Aussenbordmotor ein erstes Mal aus, ein paar Minuten später ein zweites Mal. […] Zwischendurch sprang der Motor wieder an, aber dann stieg er gleich wieder aus.“"
                                            },
                                            {
                                                "example_id": "96f52f69-a23d-4375-876b-b0d6183fd444",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Während der Prüfung stieg der Motor seines zigarrenförmigen Studebakers aus.“"
                                            },
                                            {
                                                "example_id": "91d79392-2ffa-48a6-aa60-9dabb113b928",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„In der grössten Anlieferphase von Grüngut im Oktober stieg eine Maschine in der Hauptlinie der Anlage aus.“"
                                            },
                                            {
                                                "example_id": "1da90298-3e14-4545-be1e-03b2c197f1b1",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Bestens gelaunt lässt sich der chinesische Kollege beim Wassertrinken filmen, dann steigt der Motor unseres Busses aus.“"
                                            },
                                            {
                                                "example_id": "d3ca4ceb-caa8-4809-ae90-7831cf969158",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Die Athleten schwammen los, Bomio wollte hinterher. Dann stieg der Motor aus.“"
                                            },
                                            {
                                                "example_id": "7a8cafef-ad45-4ab6-bc68-19a81b3fc3e1",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Denn just in dem Moment, als das ganze Material in der Werkstatt in Portugal ankam, stiegen dort die Maschinen aus.“"
                                            },
                                            {
                                                "example_id": "f4aa56ac-34cb-4ebb-8a97-4f833b306b86",
                                                "sense_id": "fc37490d-e9b4-3cfb-988c-f5458acdd269",
                                                "text": "„Drei Kilometer nach dem Start vom Eros Airport steigt der Motor aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    }
                                ]
                            }
                        ]
                    }
