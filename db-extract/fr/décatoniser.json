                "senses": [
                    {
                        "sense_id": "ca3bed60-1d50-36ff-b802-046aba749b17",
                        "entry_id": "37c6d1ae-3396-3e37-9cef-5c14fa723843",
                        "glosses": [
                            "Faire perdre son caractère rappelant Caton à, rendre moins sévère, moins sérieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c67349a9-1aa1-4780-9500-55276d98932c",
                                "sense_id": "ca3bed60-1d50-36ff-b802-046aba749b17",
                                "text": "Après Ronsard, qui voulut créer une langue riche et noble; après Malherbe, qui prétendit dégasconner la cour; après les précieuses, qui se vantèrent de nous avoir dévulgarisés, Scarron n’a pas d’autre ambition que de nous défaire de l’affectation gourmée et pesante, de nous décatoniser."
                            },
                            {
                                "example_id": "d4568bc9-8521-4356-ae26-11fe2ce2bc1e",
                                "sense_id": "ca3bed60-1d50-36ff-b802-046aba749b17",
                                "text": "— Vous m’allez voir tout caton. — Laissez faire, laissez faire, je sais bien les moyens de vous décatoniser."
                            }
                        ]
                    }
                ],
