                        "examples": [
                            {
                                "example_id": "6b754f4f-eac6-400d-bff1-c36ac38cd68b",
                                "sense_id": "db8b378c-c74d-3391-99c1-1ed85d625083",
                                "text": "Vroeger bakten we een taart. Van meel. Gewoon meel. Tegenwoordig liggen de schappen vol havermeel, boekweitmeel, kokosmeel, bananenmeel, quinoameel, kikkererwtenmeel..."
                            },
                            {
                                "example_id": "2a14aba6-e63b-4621-9af8-5d31509a8504",
                                "sense_id": "db8b378c-c74d-3391-99c1-1ed85d625083",
                                "text": "En ook dit jaar zijn er weer ingrediënten waarvan we niet weten wat we ermee aan moeten. Paarse wortels, houtskool en bananenmeel, hoe gebruiken we het en waar is het goed voor?"
                            },
                            {
                                "example_id": "79961ccc-e124-4596-93be-ef716d56868c",
                                "sense_id": "db8b378c-c74d-3391-99c1-1ed85d625083",
                                "text": "Op crappy websites lees ik ook alweer gekke dingen zoals dat bananenmeel een soort negatieve calorieën zouden zijn waarvan je dan op magische wijze niet dik wordt. Wat voor mensen verspreiden dit soort praat? Dat zou ik wel eens willen weten. Ik zou zeggen eet met gezond verstand. Niet teveel en vooral planten, zoals Michael Pollan zegt. En negatieve calorieën bestaan gewoon simpelweg niet."
                            }
                        ]
                    }
