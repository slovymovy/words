                ],
                "translations": [
                    {
                        "translation_id": "86a295c3-e731-4653-a5ed-298532f320b4",
                        "source_entry_id": "0c7fcc53-b7d5-3b1e-ae48-d05743260981",
                        "source_sense_id": "bd557953-c318-3556-a379-734a193f8ff3",
                        "target_lang_word": "Schnellerrechner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7799bdf9-3d14-4351-99d2-8edfe6ee2d11",
                        "source_entry_id": "0c7fcc53-b7d5-3b1e-ae48-d05743260981",
                        "source_sense_id": "bd557953-c318-3556-a379-734a193f8ff3",
                        "target_lang_word": "Rechner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eef9f00e-514f-3928-b9d7-ac70637d2a78",
                                        "entry_id": "55d23158-f398-3bf6-842f-5ea741f09a90",
                                        "glosses": [
                                            "Gerät, das mathematische oder logische Operationen ausführt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82e888f-5c61-4f08-a6e5-d5b3e03d05a4",
                                                "sense_id": "eef9f00e-514f-3928-b9d7-ac70637d2a78",
                                                "text": "Dieser Rechner kann zwei Zahlen addieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "097fa291-0545-34c5-99f7-fe4fd7eb3ca9",
                                        "entry_id": "55d23158-f398-3bf6-842f-5ea741f09a90",
                                        "glosses": [
                                            "hochtechnologische Rechenmaschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71040db4-8258-402a-ba73-a64fd55bce92",
                                                "sense_id": "097fa291-0545-34c5-99f7-fe4fd7eb3ca9",
                                                "text": "Die schnellsten Rechner der Welt stehen in den USA."
                                            },
                                            {
                                                "example_id": "2b32a3c5-13ad-4ca9-b8ee-729355f30201",
                                                "sense_id": "097fa291-0545-34c5-99f7-fe4fd7eb3ca9",
                                                "text": "„Es ist beeindruckend, dass Frauen mehr Zeit investieren als Männer, um für sich den richtigen Rechner zu finden.“"
                                            },
                                            {
                                                "example_id": "7b5d8067-d469-4a9d-ba19-2d10f8bcfac7",
                                                "sense_id": "097fa291-0545-34c5-99f7-fe4fd7eb3ca9",
                                                "text": "„Jana hatte sich an ihren Rechner gesetzt, die Stundenpläne weggeklickt.“"
                                            },
                                            {
                                                "example_id": "4166e1bc-3564-4b01-baa9-af70fee10c71",
                                                "sense_id": "097fa291-0545-34c5-99f7-fe4fd7eb3ca9",
                                                "text": "„Durch meine Suche war ich auch auf zig andere Rechner gestoßen. Rentenrechner, IQ-Rechner, Klimarechner, Depressionsrechner.“"
                                            },
                                            {
                                                "example_id": "2f8caa72-b8b3-4864-9b1d-68eab4f243f9",
                                                "sense_id": "097fa291-0545-34c5-99f7-fe4fd7eb3ca9",
                                                "text": "„Um Forschung in einem Feld zu betreiben, in dem eine neue Sparte der Erzählkultur im Entstehen begriffen ist, braucht man heute seine Wohnung nicht mehr zu verlassen, die benötigten Daten werden bequem und kostenlos per Modem oder Breitbandkabelanschluss in den eigenen Rechner geliefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "498cc97d-5c5d-304f-bdf8-ac36c6569827",
                                        "entry_id": "55d23158-f398-3bf6-842f-5ea741f09a90",
                                        "glosses": [
                                            "tragbares technisches Hilfsmittel zur Lösung mathematischer Aufgaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0b1172-86ac-4ad5-b383-6625963174f0",
                                                "sense_id": "498cc97d-5c5d-304f-bdf8-ac36c6569827",
                                                "text": "Ab der fünften Klasse brauchen viele Schüler einen Rechner in der Schule."
                                            },
                                            {
                                                "example_id": "d33b8c61-4e4b-40a9-82b9-0ba1b51652e6",
                                                "sense_id": "498cc97d-5c5d-304f-bdf8-ac36c6569827",
                                                "text": "„Zufrieden mit der Reiseplanung klappte ich den Rechner zu und nahm den Aufzug in mein Zimmer im fünften Stock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "40b51d13-4516-3a72-8e89-649aab4874c6",
                                        "entry_id": "55d23158-f398-3bf6-842f-5ea741f09a90",
                                        "glosses": [
                                            "eine Person, die eine Sache genau durchrechnet oder kalkuliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475096d7-e52f-4e7a-a16b-1678706c23ef",
                                                "sense_id": "40b51d13-4516-3a72-8e89-649aab4874c6",
                                                "text": "Er ist ein kühler Rechner."
                                            },
                                            {
                                                "example_id": "9b4d8e44-ad97-4a9d-8935-0fa000c11163",
                                                "sense_id": "40b51d13-4516-3a72-8e89-649aab4874c6",
                                                "text": "„Dort an der Alster leben nur Geschäftsleute, die nüchterne Rechner sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac406ba1-9577-4754-998d-eb23bab161dc",
                        "source_entry_id": "0c7fcc53-b7d5-3b1e-ae48-d05743260981",
                        "source_sense_id": "bd557953-c318-3556-a379-734a193f8ff3",
