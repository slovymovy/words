                                        "entry_id": "c9c40002-f47f-35ec-bbea-954f8c641c80",
                                        "glosses": [
                                            "Surnom donné parfois à la Chine (pays)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4528cc9a-71d8-4c59-9bd7-fe4abf04cf1f",
                                                "sense_id": "a798873f-f2db-32b8-b04f-cacec45005b8",
                                                "text": "Quelle que soit la fermeté de ses intentions, le Canada seul fait difficilement le poids face au Dragon."
                                            }
