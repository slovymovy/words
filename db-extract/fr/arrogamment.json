        "fr-extract.jsonl": [
            {
                "entry_id": "77dc03dd-cdb1-3b64-b656-af3da7abcdbb",
                "word": "arrogamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                        "entry_id": "77dc03dd-cdb1-3b64-b656-af3da7abcdbb",
                        "glosses": [
                            "Avec arrogance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e824b4af-3607-418f-be50-bb0fc3346512",
                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                "text": "Oser arrogamment se vanter à mes yeux,\nD’être juste seigneur du bien de mes aïeux !"
                            },
                            {
                                "example_id": "62a1e8b9-a0e5-46b7-940a-b89431558368",
                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                "text": "Il a vu ses faisceaux marcher arrogamment et braver nos drapeaux."
                            },
                            {
                                "example_id": "dcddf1b1-cecf-403b-874e-c872520d8178",
                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                "text": "Cependant le héros pudibond se rengorge comme un paon, et lève arrogamment la crête, lorsque son prôneur impudent ose égaler aux dieux le plus méprisable des faquins […]"
                            },
                            {
                                "example_id": "92254503-7108-4783-8868-da40385088b9",
                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                "text": "L’âme comptait seule ; on posait arrogamment comme un fait l’immortalité de cette entité vague que nous n’avons jamais vu fonctionner dans l’absence du corps, avant de prendre la peine d’en prouver l’existence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "760124a5-8322-4bae-82b5-5b8a12e99538",
                        "source_entry_id": "77dc03dd-cdb1-3b64-b656-af3da7abcdbb",
                        "source_sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                        "target_lang_word": "arrogantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd7ba991-b3b9-313a-a8b1-ea65c4b87145",
                                        "entry_id": "46b679fa-fdec-301d-9830-888a3c0bbd8d",
                                        "glosses": [
                                            "In an arrogant manner; with undue pride or self-importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841fc650-097e-45c5-a912-60392986322f",
                                                "sense_id": "bd7ba991-b3b9-313a-a8b1-ea65c4b87145",
                                                "text": "Many a RP podcaster, blogger, and Youtuber have fired up their livesteaming software, to arrogantly beat their chests, boasting that men reach their “peak SMV” (“Sexual Marketplace Value”, or desirability to women) in their late 30s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cfd9e90-d69f-454d-8224-61fd74b1fc28",
                        "source_entry_id": "77dc03dd-cdb1-3b64-b656-af3da7abcdbb",
                        "source_sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                        "target_lang_word": "condescendingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condescendingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48afd00f-6345-3a1c-a2e0-6034164f0ec3",
                                        "entry_id": "54547e11-096b-3f5b-b15e-a135b86a225c",
                                        "glosses": [
                                            "In a condescending manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930811a0-5b68-4868-8773-8b66a4357e9e",
                                                "sense_id": "48afd00f-6345-3a1c-a2e0-6034164f0ec3",
                                                "text": "[…]; and as there was some perilous probability, in the event of the Colonel and Coloneless saying ‘no,’ of the Captain’s proposing to Miss De Fudgeville, orphan daughter and heiress of the late Rear-Admiral De Fudgeville, who, though she was as ugly as sin, and had something the matter with her spine, had a fortune of ninety thousand pounds, the gallant Colonel, late of the Heavies, and his wife, condescendingly agreed to accept Algernon as their son-in-law."
                                            },
                                            {
                                                "example_id": "d3128d61-9ffd-4e3c-9c8d-a4af21143b10",
                                                "sense_id": "48afd00f-6345-3a1c-a2e0-6034164f0ec3",
                                                "text": "He wore his strange and colourful clothes as if for inspection by a lesser being: condescendingly, casually."
                                            },
                                            {
                                                "example_id": "a7542da9-000c-4733-803b-2d406c77e23f",
                                                "sense_id": "48afd00f-6345-3a1c-a2e0-6034164f0ec3",
                                                "text": "\"What seems to be the trouble my child? Ah, the pains of youth,\" he nodded condescendingly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae497ed0-25a0-4994-a9ff-a02b2e03567e",
