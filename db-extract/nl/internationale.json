                            {
                                "example_id": "fa2157d2-5f5a-4bcb-b889-6e54c85d13c7",
                                "sense_id": "0dbb5a95-608b-3d53-b9e6-14192de9f826",
                                "text": "Ik vroeg of ik zijn telefoon mocht gebruiken omdat het mijn dochters verjaardag was. De internationale belkosten kon hij op mijn rekening zetten."
                            },
                            {
                                "example_id": "3588ce0e-e530-41bc-ba84-e28f0b0a62c8",
                                "sense_id": "0dbb5a95-608b-3d53-b9e6-14192de9f826",
                                "text": "Over de hele wereld wordt bedroefd gereageerd op het overlijden van paus Franciscus. Na de aankondiging vanochtend luidden de kerkklokken in heel Rome. Kort na het nieuws stroomden de reacties binnen, via X en (internationale) media. Wereldleiders en politici zeggen verdrietig te zijn en prijzen de paus voor zijn inzet voor kwetsbare mensen in de samenleving."
                            }
                        ]
