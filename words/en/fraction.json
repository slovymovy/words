{
    "word_family": [
        "fractional",
        "fractionate",
        "fractionation",
        "refraction",
        "fracture",
        "infraction"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4182120d-0e15-3026-821c-834f8cdb0d48",
                    "sense_definition": "A ratio of two numbers, usually written one above the other and separated by a horizontal line.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained how to add a <w>fraction</w> like one half to another one.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как прибавить одну <w>дробь</w>, например одну вторую, к другой.",
                                "zh": "老师讲解了如何将二分之一这样的<w>分数</w>相加。"
                            }
                        },
                        {
                            "text": "You can write a simple <w>fraction</w> using a numerator and a denominator.",
                            "target_lang_translations": {
                                "ru": "Вы можете записать простую <w>дробь</w>, используя числитель и знаменатель.",
                                "zh": "你可以用分子和分母来书写一个简单的<w>分数</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "simple fraction",
                        "decimal fraction",
                        "improper fraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношение двух чисел, обычно записываемое одно над другим и разделенное горизонтальной чертой.",
                        "zh": "数学中表示整体一部分的数值，通常由分子和分母组成，中间用横线隔开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробь",
                                "target_lang_sense_clarification": "математическое число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分数",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3919aaa3-a1cf-3ead-be2d-d6baacddac87",
                    "sense_definition": "A very small amount or a tiny part of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car missed the cyclist by only a <w>fraction</w> of an inch.",
                            "target_lang_translations": {
                                "ru": "Машина разминулась с велосипедистом всего на <w>долю</w> дюйма.",
                                "zh": "汽车与骑车人擦肩而过，距离仅差<w>一小部分</w>英寸。"
                            }
                        },
                        {
                            "text": "He only spent a small <w>fraction</w> of his inheritance on the new house.",
                            "target_lang_translations": {
                                "ru": "Он потратил лишь малую <w>часть</w> своего наследства на новый дом.",
                                "zh": "他只花了遗产中很<w>一小部分</w>的钱来买新房。"
                            }
                        }
                    ],
                    "antonyms": [
                        "whole",
                        "entirety"
                    ],
                    "common_phrases": [
                        "small fraction",
                        "fraction of a second",
                        "tiny fraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленькое количество или крошечная часть чего-либо.",
                        "zh": "极小的数量或部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "незначительная часть"
                            },
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "маленький кусочек или объем"
                            },
                            {
                                "target_lang_word": "малая часть",
                                "target_lang_sense_clarification": "небольшое количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一小部分",
                                "target_lang_sense_clarification": "指代数量"
                            },
                            {
                                "target_lang_word": "微量",
                                "target_lang_sense_clarification": "指代极小的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "443cf2ee-b095-3fbe-9ae8-b2c79b667e20",
                    "sense_definition": "A component of a mixture that has been separated by a chemical process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each liquid <w>fraction</w> was collected in a separate glass tube during the experiment.",
                            "target_lang_translations": {
                                "ru": "Каждая жидкая <w>фракция</w> собиралась в отдельную стеклянную трубку во время эксперимента.",
                                "zh": "实验过程中，每种液体<w>馏分</w>都被收集在单独的玻璃管中。"
                            }
                        },
                        {
                            "text": "Distillation allows chemists to isolate a specific <w>fraction</w> from the crude oil mixture.",
                            "target_lang_translations": {
                                "ru": "Дистилляция позволяет химикам выделять определенную <w>фракцию</w> из смеси сырой нефти.",
                                "zh": "蒸馏法使化学家能够从原油混合物中分离出特定的<w>馏分</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "liquid fraction",
                        "petroleum fraction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компонент смеси, выделенный в результате химического процесса.",
                        "zh": "通过化学或物理过程从混合物中分离出来的成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фракция",
                                "target_lang_sense_clarification": "в химии и физике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "馏分",
                                "target_lang_sense_clarification": "化学分离出的成分"
                            },
                            {
                                "target_lang_word": "组分",
                                "target_lang_sense_clarification": "混合物中的成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4067af79-d087-3937-b6ad-9c6463e32fce",
                    "sense_definition": "The ceremonial breaking of the bread during a Christian eucharistic service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest performed the <w>fraction</w> of the host before the congregation received communion.",
                            "target_lang_translations": {
                                "ru": "Священник совершил <w>преломление</w> гостии перед тем, как община приняла причастие.",
                                "zh": "在会众领圣餐前，牧师进行了<w>掰饼</w>仪式。"
                            }
                        },
                        {
                            "text": "In many traditions, the <w>fraction</w> is a solemn moment representing the body of Christ.",
                            "target_lang_translations": {
                                "ru": "Во многих традициях <w>преломление</w> — это торжественный момент, символизирующий тело Христово.",
                                "zh": "在许多传统中，<w>掰饼</w>是一个象征基督身体的庄严时刻。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Церемониальное преломление хлеба во время христианского евхаристического богослужения.",
                        "zh": "基督教圣餐礼中掰开圣餐饼的仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преломление",
                                "target_lang_sense_clarification": "хлеба в литургии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掰饼",
                                "target_lang_sense_clarification": "宗教仪式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ddae8179-255f-3b0a-960c-21797ba1f772",
                    "sense_definition": "To divide or break something into smaller parts or numerical ratios.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist needed to <w>fraction</w> the sample to analyze its individual components.",
                            "target_lang_translations": {
                                "ru": "Ученому нужно было <w>разделить</w> образец на фракции, чтобы проанализировать его отдельные компоненты.",
                                "zh": "科学家需要对样本进行<w>分离</w>，以分析其各个组成部分。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>fraction</w> the data into meaningful categories without more information.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>раздробить</w> данные на значимые категории без дополнительной информации.",
                                "zh": "如果没有更多信息，很难将数据<w>拆分</w>成有意义的类别。"
                            }
                        }
                    ],
                    "antonyms": [
                        "combine",
                        "unite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять или разбивать что-либо на более мелкие части или числовые отношения.",
                        "zh": "将某物分成较小的部分或进行成分分离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробить",
                                "target_lang_sense_clarification": "разделять на части"
                            },
                            {
                                "target_lang_word": "разделять на фракции",
                                "target_lang_sense_clarification": "в научном контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分离",
                                "target_lang_sense_clarification": "科学实验中的操作"
                            },
                            {
                                "target_lang_word": "拆分",
                                "target_lang_sense_clarification": "将整体分为部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "26d0552e-3151-3fdd-8450-4d9d9c10faf5",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family with the surname <w>Fraction</w> living on the coast.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике была указана семья с фамилией <w>Фракцион</w>, живущая на побережье.",
                                "zh": "当地名录上列出了一户住在海岸边的<w>弗拉克申</w>姓氏人家。"
                            }
                        },
                        {
                            "text": "Mr. <w>Fraction</w> was known in the small town for his extensive library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Фракцион</w> был известен в маленьком городке своей обширной библиотекой.",
                                "zh": "<w>弗拉克申</w>先生因其藏书丰富而在小镇上很有名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фракцион",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弗拉克申",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}