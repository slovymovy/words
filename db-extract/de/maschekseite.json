                        "examples": [
                            {
                                "example_id": "f1b06ac6-f4b0-42e0-b837-641d2b8560bd",
                                "sense_id": "29a27348-d716-3df4-96b9-fc518951fdea",
                                "text": "„Wir kamen von der Maschekseite, über eines der hinteren Tore.“"
                            },
                            {
                                "example_id": "a5574103-9913-4e85-90a8-304834321764",
                                "sense_id": "29a27348-d716-3df4-96b9-fc518951fdea",
                                "text": "„Seine Anleitungen für eine gelungene Existenz geraten Schönburg allerdings ein wenig gar bieder, weit besser funktionieren da die Passagen, in denen er sich seinem Thema von der Maschekseite her nähert und virtuos fragwürdige Wohlstandskonzepte wie Fernreisen, das eigene Auto oder \"schön essen gehen\" demontiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
