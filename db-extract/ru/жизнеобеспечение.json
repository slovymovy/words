                "senses": [
                    {
                        "sense_id": "2808db68-ffbf-3d77-8942-f772c9ef6422",
                        "entry_id": "9f377df5-3a99-3d8c-8fb0-0d8292aa5a40",
                        "glosses": [
                            "книжн. обеспечение условий сохранения жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02beee2-abe1-4fbd-97a4-88e43ed56ac4",
                                "sense_id": "2808db68-ffbf-3d77-8942-f772c9ef6422",
                                "text": "Специалисты предлагали два варианта: уже достаточно отработанный мягкий скафандр с надеваемым на спину ранцем и скафандр полужёсткой конструкции, в которой корпус и ранец с системой жизнеобеспечения составляют одно целое."
                            },
                            {
                                "example_id": "ded90bae-d742-4d5d-bbfb-a2ee405621de",
                                "sense_id": "2808db68-ffbf-3d77-8942-f772c9ef6422",
                                "text": "Системы жизнеобеспечения страны — тепло-, водо-, энергоснабжения и другие — находятся на грани катастрофы."
                            }
                        ]
                    }
