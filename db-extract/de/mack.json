                ],
                "senses": [
                    {
                        "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                        "entry_id": "ee91dcf1-c20b-301d-98da-2cce6fa1efb4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34a250a-0c16-47f6-9f9e-8bc9855f1eb2",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Mack kommt und geht."
                            },
                            {
                                "example_id": "630db4e6-96ad-4709-b083-f8a3ddca11f9",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Macks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5021d3c5-5a3c-4fad-964a-ff14ec741cd3",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Frau Mack ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "38d587a1-c959-40a5-8874-8639009bdbbe",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Herr Mack wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c053ab2c-a036-4b63-83b6-15fcc5214f55",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Die Macks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "98808807-ac32-4f5f-87d2-6a660e6963ba",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Der Mack trägt nie die Schals, die die Mack ihm strickt."
                            },
                            {
                                "example_id": "ecb2c94d-72ea-4a2c-b415-3890ce09a625",
                                "sense_id": "5b7a7e7d-63ad-3810-aa30-6961e565abdf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mack kommt, geht der Herr Mack.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
