                "senses": [
                    {
                        "sense_id": "26fc700a-e94c-30fc-89b1-a6a14e23ef53",
                        "entry_id": "e9e021e6-348d-3b23-94a0-c78973689af0",
                        "glosses": [
                            "Reproduire en utilisant un banc-titre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd359d2d-a07e-48ee-9d23-fa670a52752b",
                                "sense_id": "26fc700a-e94c-30fc-89b1-a6a14e23ef53",
                                "text": "Parmi les nombreuses autres sources d’archives fixes (à scanner ou banc-titrer) figurent les fonds très riches des archives d’Outre-Mer (à Aix), de la Caserne d’Artois (à Versailles), et du Cabinet des estampes de la Bibliothèque Nationale."
                            },
                            {
                                "example_id": "785631dc-f65f-4e43-be45-b535b877259b",
                                "sense_id": "26fc700a-e94c-30fc-89b1-a6a14e23ef53",
                                "text": "De retour de Chypre, Papa Cazals et son chef-opérateur fétiche Jacques Malnou banc-titrent à fond sur une chaise en paille un livre de gravure consacré à l'île."
                            },
                            {
                                "example_id": "bf07645b-3bdf-46c2-81ac-8baa85a61a11",
                                "sense_id": "26fc700a-e94c-30fc-89b1-a6a14e23ef53",
                                "text": "Moi je trouve ça surtout honteux de pas banc-titrer le film sur 35mm."
                            }
                        ]
                    }
