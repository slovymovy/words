                        "cross_references": [
                            {
                                "target_word": "launch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "352f43a3-d490-3817-962b-4b71646eb528",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To throw (a projectile such as a lance, dart or ball); to hurl; to propel with force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27bcfd1b-538f-4065-9de9-1a42b736202a",
                                                "sense_id": "352f43a3-d490-3817-962b-4b71646eb528",
                                                "text": "There they were met by four thousand Ha'apa'a warriors, who launched a volley of stones and spears[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2a13efb-a816-3074-9ef6-ccccc6ff3171",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To pierce with, or as with, a lance."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501b4e00-b8d0-4b90-b787-8df5d0089be8",
                                                "sense_id": "e2a13efb-a816-3074-9ef6-ccccc6ff3171",
                                                "text": "And launch your hearts with lamentable wounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597f9947-a829-3fa7-af15-925fb1ab00e8",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To cause (a vessel) to move or slide from the land or a larger vessel into the water; to set afloat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af23ec1d-afcb-429b-90f5-6f9553ff164d",
                                                "sense_id": "597f9947-a829-3fa7-af15-925fb1ab00e8",
                                                "text": "Now when he had left speaking, he said unto Simon, Launch out into the deep, and let down your nets for a draught."
                                            },
                                            {
                                                "example_id": "42b1dc2a-7cbc-4215-9b81-545b2dac054c",
                                                "sense_id": "597f9947-a829-3fa7-af15-925fb1ab00e8",
                                                "text": "1725–1726, Alexander Pope, Homer's Odyssey (translation), Book V\nWith stays and cordage last he rigged the ship, / And rolled on levers, launched her in the deep."
                                            },
                                            {
                                                "example_id": "2e4491cf-48ba-4a46-8561-47297c5c9a7e",
                                                "sense_id": "597f9947-a829-3fa7-af15-925fb1ab00e8",
                                                "text": "The navy launched another ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15c7728f-2cb0-377a-a4fb-7578886d1328",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To cause (a rocket, balloon, etc., or the payload thereof) to begin its flight upward from the ground."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a2b52be-4308-499e-a623-9e5fccef1bd6",
                                                "sense_id": "15c7728f-2cb0-377a-a4fb-7578886d1328",
                                                "text": "A cheap rocket that could launch military reconnaisance satellites for developing countries has become involved in a tangled web of Nazi rocket scientists, Penthouse magazine, KGB disinformation, and a treaty reminiscent of the height of colonialism in Africa."
                                            },
                                            {
                                                "example_id": "e6d24bc3-b0ea-4f6f-bce6-b2175da46485",
                                                "sense_id": "15c7728f-2cb0-377a-a4fb-7578886d1328",
                                                "text": "NASA launched several unmanned rockets before launching any of the Mercury astronauts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d765dc5d-fe97-3534-9446-89e766dd83d6",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To send out; to start (someone) on a mission or project; to give a start to (something); to put in operation"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3106428-fb59-4a35-9888-d6a6a582dcb4",
                                                "sense_id": "d765dc5d-fe97-3534-9446-89e766dd83d6",
                                                "text": "Our business launched a new project."
                                            },
                                            {
                                                "example_id": "a5b8f5ad-4f81-4bd3-a6bb-2e5522da8c9c",
                                                "sense_id": "d765dc5d-fe97-3534-9446-89e766dd83d6",
                                                "text": "All art is uſed to ſink Epiſcopacy, & lanch Presbytery in England."
                                            },
                                            {
                                                "example_id": "32de171c-3fc5-4325-923e-50f8b600151c",
                                                "sense_id": "d765dc5d-fe97-3534-9446-89e766dd83d6",
                                                "text": "Here was my chance. I took the old man aside, and two or three glasses of Old Crow launched him into reminiscence."
                                            },
                                            {
                                                "example_id": "c34b6ca0-9c6e-49c3-9a94-47ad6751dd3e",
                                                "sense_id": "d765dc5d-fe97-3534-9446-89e766dd83d6",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            },
                                            {
                                                "example_id": "3bd9f893-fd02-4ab9-b6ce-b358c6952b82",
                                                "sense_id": "d765dc5d-fe97-3534-9446-89e766dd83d6",
                                                "text": "I have ordered House Atreides to occupy Arrakis to mine the spice, thus replacing their enemies the Harkonnens. House Atreides will not refuse because of the tremendous power they think they will gain. Then, at an appointed time, Baron Harkonnen will return to Arrakis and launch a sneak attack on House Atreides. I have promised the Baron five legions of my Sardaukar terror troops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4126574-6e07-339c-acb3-862859ca80c0",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To start (a program or feature); to execute or bring into operation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18203320-90be-422f-8221-5a7dea094831",
                                                "sense_id": "a4126574-6e07-339c-acb3-862859ca80c0",
                                                "text": "Double-click an icon to launch the associated application."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0114561-f4ce-395b-b4a0-6c5639af2718",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To release; to put onto the market for sale"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dd85fb0-de36-49b8-88a2-26337dd10ef7",
                                                "sense_id": "b0114561-f4ce-395b-b4a0-6c5639af2718",
                                                "text": "On September 3rd Bionym, a Canadian firm, launched Nymi, a bracelet which detects the wearer’s heartbeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e88b1a79-bc45-38bf-b606-22d5ee85b5ea",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "Of a ship, rocket, balloon, etc.: to depart on a voyage; to take off."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "635575f0-fb60-3526-b884-a50403f9218d",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To move with force and swiftness like a sliding from the stocks into the water; to plunge; to begin."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d779b8-b2e5-4023-b174-5557170e2739",
                                                "sense_id": "635575f0-fb60-3526-b884-a50403f9218d",
                                                "text": "In our language, Spenſer has not contented himſelf with this ſubmiſſive manner of imitation : he launches out into very flowery paths[…]"
                                            },
                                            {
                                                "example_id": "c0e1950f-ca03-4bbf-a616-bc78fc30f6c7",
                                                "sense_id": "635575f0-fb60-3526-b884-a50403f9218d",
                                                "text": "My class was wearing butter-yellow pique dresses, and Momma launched out on mine. She smocked the yoke into tiny crisscrossing puckers, then shirred the rest of the bodice."
                                            },
                                            {
                                                "example_id": "7302b409-8f0a-4769-8202-dae1ebe095d2",
                                                "sense_id": "635575f0-fb60-3526-b884-a50403f9218d",
                                                "text": "to launch into an argument or discussion"
                                            },
                                            {
                                                "example_id": "e9901588-fbb4-49d8-878a-96523f0dc0e7",
                                                "sense_id": "635575f0-fb60-3526-b884-a50403f9218d",
                                                "text": "to launch into lavish expenditures"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d659e99b-e225-379f-9b0b-e57ef7312de5",
                                        "entry_id": "d99aac30-6adb-33f7-95aa-5026a88cd41c",
                                        "glosses": [
                                            "To start to operate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0dbb68-8d28-4c34-855a-6c459283bf9d",
                                                "sense_id": "d659e99b-e225-379f-9b0b-e57ef7312de5",
                                                "text": "After clicking the icon, the application will launch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "launch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2da35c0-60ff-3880-8e11-a4209c7bf397",
                                        "entry_id": "b4991fc7-c77f-3a01-8b71-4427afe7ff85",
                                        "glosses": [
                                            "The movement of a vessel from land into the water; especially, the sliding on ways from the stocks on which it is built. (Compare: to splash a ship.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7b449d0-df9c-3ae7-b5fd-10ffa0578fbe",
                                        "entry_id": "b4991fc7-c77f-3a01-8b71-4427afe7ff85",
                                        "glosses": [
                                            "The act or fact of launching (a ship/vessel, a project, a new book, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a75283-7a4c-4120-bdbd-95248408e1e7",
                                                "sense_id": "d7b449d0-df9c-3ae7-b5fd-10ffa0578fbe",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            },
                                            {
                                                "example_id": "93e0e219-c75f-4e68-9f9f-0e8cc3638011",
                                                "sense_id": "d7b449d0-df9c-3ae7-b5fd-10ffa0578fbe",
                                                "text": "The initial awards will give $316 million to SpaceX for one launch and $337 million to ULA for two launches. […] Military officials did not say exactly how many launches that might enetail^([sic]), nor did they provide a total contract value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f326d94b-e454-39f5-9f56-66912b5e4b91",
                                        "entry_id": "b4991fc7-c77f-3a01-8b71-4427afe7ff85",
                                        "glosses": [
                                            "An event held to celebrate the launch of a ship/vessel, project, a new book, etc.; a launch party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34abb1ec-ba5c-40fe-a0db-75ff1683fbcf",
                                                "sense_id": "f326d94b-e454-39f5-9f56-66912b5e4b91",
                                                "text": "product launch"
                                            },
                                            {
                                                "example_id": "8d910300-d4c1-407e-b1f1-0758dd682e5c",
                                                "sense_id": "f326d94b-e454-39f5-9f56-66912b5e4b91",
                                                "text": "book launch"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "launch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05649c12-5acd-32c1-abe0-f8a31a50cbd2",
                                        "entry_id": "70fbbf5c-1d58-3b63-9bb6-54cd962c870f",
                                        "glosses": [
                                            "The boat of the largest size and/or of most importance belonging to a ship of war, and often called the \\\"captain's boat\\\" or \\\"captain's launch\\\"."
                                        ],
                                        "tags": [],
