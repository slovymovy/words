                            },
                            {
                                "target_word": "whist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8824ea87-54f0-37c0-9cff-ff35412fc318",
                                        "entry_id": "353f0d87-1699-3153-938c-02c4cd3517dc",
                                        "glosses": [
                                            "Silent, hushed."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5baf7bbe-b425-407b-ba61-ffc46f01bfbd",
                                                "sense_id": "8824ea87-54f0-37c0-9cff-ff35412fc318",
                                                "text": "Come unto these yellow sands, / And then take hands: / Courtsied when you have and kiss'd / The wild waves whist, / Foot it featly here and there; / And, sweet sprites, the burthen bear.[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28939da5-4457-4ce6-a4df-c105f4a0883d",
                        "source_entry_id": "66bfe6e0-0490-387b-a9e0-24459d3f272f",
                        "source_sense_id": "7bc48dd1-f8f5-3b26-ba39-0725621be90a",
                        "target_lang_word": "whist",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whist",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                        "entry_id": "5f9d7563-dd6f-3cd1-8a84-cf0626b821f8",
                                        "glosses": [
                                            "Jeu de cartes à levées qui se joue à quatre."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a872b591-1234-47ba-a9b3-ae4df5463dd2",
                                                "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                                "text": "Le whist de l’abbé Duret faisait une utile diversion aux quasi-monologues de la divinité."
                                            },
                                            {
                                                "example_id": "3c895496-28a9-4682-b1c5-aa85177dcac1",
                                                "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                                "text": "Hulot revint chez lui, marchant en furieux, se parlant à lui-même, et trouva sa famille faisant avec calme le whist à deux sous la fiche qu’il avait vu commencer."
                                            },
                                            {
                                                "example_id": "ecea889e-e659-4fdf-8b06-f8a8073fe039",
                                                "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                                "text": "Après une journée laborieuse et bien remplie, il passait de douces soirées en famille avec son ami Guilbault, qui manquait rarement au rendez-vous. On jouait une ou deux parties de whist ; Louise chantait, sans trop se faire prier, tout ce qu’elle savait de romances et de chansonnettes ; l’oncle de Charles racontait quelque histoire du bon vieux temps."
                                            },
                                            {
                                                "example_id": "bf0b7c3b-93e1-4b74-bd4d-f57c2b27df0b",
                                                "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                                "text": "On y jouait le whist à deux sous la fiche."
                                            },
                                            {
                                                "example_id": "89644618-cb25-45f5-8c9d-b260856e6714",
                                                "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                                "text": "Bien que je ne fusse encore qu’un enfant – j’avais treize ans – Baldi m’avait, par horreur du \"mort\", appris le whist et à tricher."
                                            },
                                            {
                                                "example_id": "b1624df8-65fb-4da3-90dc-470bd442b70c",
                                                "sense_id": "cc759322-925f-398c-a228-c9371d989e95",
                                                "text": "— Et pourquoi, dit le philosophe, ne seriez-vous pas la châtelaine d’une bicoque Louis~XIII, blanche et rouge, qu’on apercevrait de loin à travers les trembles ? Vous y porteriez le deuil honorable de feu le colonel de réserve votre mari ; il aurait toujours sa place à la table où, trois fois la semaine, vous joueriez le whist avec quelque hobereau sondeur du voisinage et monsieur le curé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3de8656-89c3-367d-9937-742cc96672c7",
                                        "entry_id": "5f9d7563-dd6f-3cd1-8a84-cf0626b821f8",
                                        "glosses": [
                                            "Whist à la couleur."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
