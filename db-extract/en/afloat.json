                        "glosses": [
                            "Floating upon."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ca38fc7c-0c4d-4ebc-bd98-9e1b2711ecb5",
                                "sense_id": "e8a1d31c-7ae9-39f9-9ac0-0fd9a3b69538",
                                "text": "early 1600s, John Webster and William Rowley, The Thracian Wonder, London: Thomas Johnson, 1661, Act I, Scene 1,\nBut Huswife, as for you, / You with your Brat, wee’l send afloat the Main,"
                            },
                            {
                                "example_id": "9efdfe5f-fb78-4fe9-b424-e41d8e46265d",
                                "sense_id": "e8a1d31c-7ae9-39f9-9ac0-0fd9a3b69538",
                                "text": "[…] great wee see must be the art and cunning of that man, that keeps him afloat the streame of Soveraigne favour,"
                            }
                        ]
                    }
                ],
