                        "translation_id": "c12046ea-f8f7-4b32-b1e2-496a005cb918",
                        "source_entry_id": "90b52914-adf1-32fa-8bc6-e2beacc1f031",
                        "source_sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
