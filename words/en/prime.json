                {
                    "sense_id": "c8789960-a43a-3655-aaf6-957522c1b41d",
                    "sense_definition": "First in importance, degree, or rank.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our <w>prime</w> concern here is to keep the community safe.",
