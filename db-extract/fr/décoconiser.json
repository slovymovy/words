                "senses": [
                    {
                        "sense_id": "d952585f-67c1-3618-9497-299990d777e2",
                        "entry_id": "54eaeb11-2b74-3d97-8b76-7a60d890090d",
                        "glosses": [
                            "Sortir du cocon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb35001b-09a1-4dcd-a23f-9fa3d1a379f8",
                                "sense_id": "d952585f-67c1-3618-9497-299990d777e2",
                                "text": "Et les voilà qui, d’un ongle expert, décoconisent leur ego et en font le centre du monde."
                            },
                            {
                                "example_id": "f40650aa-eb8b-47b0-a2f9-d97e52166db0",
                                "sense_id": "d952585f-67c1-3618-9497-299990d777e2",
                                "text": "Le spectacle vu dépassait toutes les espérances, car ce qu’on voyait, c’était effectivement Brecht ressuscité, décoconisé, et SURTOUT rendu à son âge de 1918 / 1919."
                            },
                            {
                                "example_id": "d8cff493-ba65-45ce-beb5-168c3780cde1",
                                "sense_id": "d952585f-67c1-3618-9497-299990d777e2",
                                "text": "La Bundeswehr vient de décider de \"décoconiser\" une bonne centaine de Leopard 2."
                            }
                        ]
                    }
