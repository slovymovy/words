{
    "word_family": [
        "light",
        "lighten",
        "lighting",
        "lighter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fce7cb26-9722-3d86-a9be-1dbba7322771",
                    "sense_definition": "Burning or on fire",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry grass was quickly set <w>alight</w> by the campfire.",
                            "target_lang_translations": {
                                "tr": "Kuru otlar kamp ateşiyle hızla <w>tutuştu</w>."
                            }
                        },
                        {
                            "text": "The old wooden building was <w>alight</w> within minutes of the spark.",
                            "target_lang_translations": {
                                "tr": "Eski ahşap bina, kıvılcımdan dakikalar sonra <w>yanmaya başladı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "burning",
                        "flaming"
                    ],
                    "common_phrases": [
                        "set alight"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yanmakta olan veya tutuşmuş durumda."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yanan",
                                "target_lang_sense_clarification": "Ateş almış veya yanma eylemi süren nesneler için kullanılır."
                            },
                            {
                                "target_lang_word": "tutuşmuş",
                                "target_lang_sense_clarification": "Ateş almış, yanmaya başlamış durum."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1391d660-8037-3108-b9f9-405cbffb9606",
                    "sense_definition": "Showing strong emotion or excitement",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face was <w>alight</w> with joy when she heard the news.",
                            "target_lang_translations": {
                                "tr": "Haberi duyduğunda yüzü sevinçten <w>parlıyordu</w>."
                            }
                        },
                        {
                            "text": "The young student was <w>alight</w> with curiosity about the new project.",
                            "target_lang_translations": {
                                "tr": "Genç öğrenci yeni proje hakkında merakla <w>ışıldıyordu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "radiant",
                        "glowing"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güçlü bir duygu veya heyecanla parlayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "parlayan",
                                "target_lang_sense_clarification": "Duyguların etkisiyle yüzün veya gözlerin ışıldaması."
                            },
                            {
                                "target_lang_word": "ışıldayan",
                                "target_lang_sense_clarification": "Heyecan veya mutluluktan dolayı canlı görünme."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32f3fcf3-a08a-3483-b45a-1bc85b0e99fc",
                    "sense_definition": "To get off a vehicle or animal",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passengers should <w>alight</w> from the train at the next station.",
                            "target_lang_translations": {
                                "tr": "Yolcular bir sonraki istasyonda trenden <w>inmelidir</w>."
                            }
                        },
                        {
                            "text": "He <w>alighted</w> from his horse and walked toward the house.",
                            "target_lang_translations": {
                                "tr": "Atından <w>indi</w> ve eve doğru yürüdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "disembark",
                        "dismount"
                    ],
                    "common_phrases": [
                        "alight from"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir araçtan veya hayvandan inmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "inmek",
                                "target_lang_sense_clarification": "Toplu taşıma veya binek hayvanından aşağı inme eylemi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "915e0221-9a1c-3476-9db5-9ee937521f46",
                    "sense_definition": "To land or settle on a surface",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small bird <w>alighted</w> on the garden fence.",
                            "target_lang_translations": {
                                "tr": "Küçük bir kuş bahçe çitine <w>kondu</w>."
                            }
                        },
                        {
                            "text": "The butterfly <w>alighted</w> upon the bright red flower.",
                            "target_lang_translations": {
                                "tr": "Kelebek parlak kırmızı çiçeğin üzerine <w>kondu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "land",
                        "perch"
                    ],
                    "common_phrases": [
                        "alight on"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yüzeyin üzerine konmak veya yerleşmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "konmak",
                                "target_lang_sense_clarification": "Kuş veya böcek gibi canlıların bir yere inip durması."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62f18c11-71e7-3a12-b293-de9ae3ab62f0",
                    "sense_definition": "To find something by chance",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I happened to <w>alight</w> on an interesting article about history.",
                            "target_lang_translations": {
                                "tr": "Tarih hakkında ilginç bir makaleye tesadüfen <w>rastladım</w>."
                            }
                        },
                        {
                            "text": "Researchers <w>alighted</w> on a new solution to the problem.",
                            "target_lang_translations": {
                                "tr": "Araştırmacılar soruna yeni bir çözüm <w>buldular</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "discover",
                        "encounter"
                    ],
                    "common_phrases": [
                        "alight on"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi tesadüfen bulmak veya keşfetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "rastlamak",
                                "target_lang_sense_clarification": "Beklenmedik bir şekilde bir bilgi veya nesneyle karşılaşmak."
                            },
                            {
                                "target_lang_word": "denk gelmek",
                                "target_lang_sense_clarification": "Şans eseri bir şeyle karşılaşma durumu."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}