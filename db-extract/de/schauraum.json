                "senses": [
                    {
                        "sense_id": "cbcae495-9350-35fd-b86f-2b9cc34a6442",
                        "entry_id": "b33e35d7-bc1b-3fde-a316-c3380e4b4b34",
                        "glosses": [
                            "ein Raum, in dem etwas zum Anschauen ausgestellt wird, oftmals damit Ware vor dem Erwerb geprüft werden kann, oder auch als Teil eines Museums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01dcf04-9878-46b7-ac98-4aa766f13c71",
                                "sense_id": "cbcae495-9350-35fd-b86f-2b9cc34a6442",
                                "text": "Das Pärchen wanderte im Schauraum von einer Limousine zur nächsten."
                            },
                            {
                                "example_id": "3d00f965-3424-4d0a-a373-771d6e5a3cc0",
                                "sense_id": "cbcae495-9350-35fd-b86f-2b9cc34a6442",
                                "text": "„Das Residenzmuseum besteht aus 130 Schauräumen.“"
                            },
                            {
                                "example_id": "13c98239-57c2-4702-8537-8f5a5a9bb453",
                                "sense_id": "cbcae495-9350-35fd-b86f-2b9cc34a6442",
                                "text": "„Sie schlenderten herum und sahen sich die fertig eingerichteten Schauräume an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
