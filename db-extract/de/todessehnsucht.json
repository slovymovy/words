                    {
                        "form_id": "8e51f120-483b-42eb-b51b-a2fa305d9a8c",
                        "entry_id": "5f98e7df-53b3-37ba-b89d-1235ca55d1f4",
                        "tags": [
                            "accusative",
                            "plural"
