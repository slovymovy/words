                "senses": [
                    {
                        "sense_id": "72093a23-5e8c-3228-bf30-23cc8176314a",
                        "entry_id": "65c6338f-9daf-3648-a056-3d651ccc7924",
                        "glosses": [
                            "Entzündung der Lunge, die durch ein Virus verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19df73f3-0a5c-4375-9f41-7f99b2bdf8cd",
                                "sense_id": "72093a23-5e8c-3228-bf30-23cc8176314a",
                                "text": "„Wen wollen wir dann retten, einen schwer kranken 80-Jährigen oder einen 35-Jährigen mit einer rasenden Viruspneumonie, der binnen Stunden sterben würde und bei künstlicher Beatmung binnen vier Tagen über den Berg wäre?“"
                            },
                            {
                                "example_id": "c35df7e1-3617-4f14-bf96-4d23e4815d71",
                                "sense_id": "72093a23-5e8c-3228-bf30-23cc8176314a",
                                "text": "„Dort entdeckten die Ärzte eine Entzündung seiner Hirnhäute und seines Gehirns und eine leichte Viruspneumonie.“"
                            },
                            {
                                "example_id": "9dd56ee1-e2c4-4a63-92c9-ccb1c33c85b0",
                                "sense_id": "72093a23-5e8c-3228-bf30-23cc8176314a",
                                "text": "„Weber: Die DIVI, das ist die Deutsche interdisziplinäre Vereinigung der Intensivmedizin, hat schon in der Zeit März/April eine Leitlinie publiziert mit Therapieempfehlungen für Viruspneumonie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
