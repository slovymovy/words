                ],
                "senses": [
                    {
                        "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                        "entry_id": "82a517f6-292e-345e-b37c-315513e14955",
                        "glosses": [
                            "einfaches, nicht sehr geistreiches Wortspiel; ursprünglich beruhend auf Wörtern mit gleichem Klang, aber unterschiedlicher Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44396b5d-1569-4ae8-bfad-1f1feafe2181",
                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                "text": "Er erzählte die ganze Zeit alberne Kalauer und langweilte uns damit."
                            },
                            {
                                "example_id": "e0481f66-f9a9-4bb4-95ec-4d188b65c66e",
                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                "text": "Beispiel für einen Kalauer: Fährt der alte Lord fort, fährt er nur im Ford fort."
                            },
                            {
                                "example_id": "16cf7766-0408-4442-9e8b-b7595bfebc41",
                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                "text": "„Kalauer nennt man schlechte Wortwitze…“"
                            },
                            {
                                "example_id": "a0d64855-bda2-41fa-a73f-44241bb0c17b",
                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                "text": "„Diese Laune wurde aufgegriffen und weiter befördert durch Dr. Birgit Sekulski, Warschau, die im Dialog Sprachwitze, Kalauer, Versprecher, Verschreiber, Stilblüten und anderes vorstellte und damit ein wahres »Feuerwerk der Sprachlust« zündete.“"
                            },
                            {
                                "example_id": "68920dea-5cac-454e-b9b9-1ec797dddd97",
                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                "text": "„Und dieses Element gehört fest zu unserem Verhältnis zur Sprache, und in den Sprachwitzen und besonders in den Kalauern tritt es hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "498ad0a5-c5ae-3aa7-bb98-3912a4b56f88",
                        "entry_id": "82a517f6-292e-345e-b37c-315513e14955",
                        "glosses": [
                            "spöttische Anrede für Schustergesellen im 19. Jahrhundert"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3e9fde8-0db9-4dda-8f55-7aeb0ef22a66",
                        "source_entry_id": "82a517f6-292e-345e-b37c-315513e14955",
                        "source_sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                        "target_lang_word": "groaner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groaner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d960b6cb-8dd5-37c3-9bc9-536ad29d7e4f",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "One who groans or complains"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5101002e-ace6-4f1c-845a-547d570c709a",
                                                "sense_id": "d960b6cb-8dd5-37c3-9bc9-536ad29d7e4f",
                                                "text": "I don’t need to hear from groaners like you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89bd088-4de0-3578-818f-e4ace526a87e",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "A work of extremely low quality, so bad as to inspire groaning"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d520c6ab-0d16-470a-b765-038ba7163d09",
                                                "sense_id": "e89bd088-4de0-3578-818f-e4ace526a87e",
                                                "text": "That movie was a real groaner."
                                            },
                                            {
                                                "example_id": "c3ebc494-cb8e-411c-a99a-65dc6bf0c614",
                                                "sense_id": "e89bd088-4de0-3578-818f-e4ace526a87e",
                                                "text": "Some groaners are converted into running gags, as when Joel and his brother (Max Greenfield) get in a duel of parting, one-last-thing-before-you-go affirmations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "A particularly egregious joke, especially a pun."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb5a837-480c-4478-8573-12fbdcac5f54",
                                                "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                                "text": "From the cleverest repartee to the worst groaner, people use and respond to puns, but sometimes find them hard to define."
                                            },
                                            {
                                                "example_id": "5f9a3cbb-891c-4fa5-b36a-7e208dcf2c69",
                                                "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                                "text": "In the '40s, I remember ludicrous puns thought to be funny and repeated by teenagers, sometimes to a chorus of laughter. Here is a groaner example: \"Mother, get off the rafters. That is no way to get on the beam.\" Naturally, to understand the joke, it was necessary to know the idiom of the day. \"Get on the beam\" meant \"get with it\" or understand the situation."
                                            },
                                            {
                                                "example_id": "81b22479-d007-4f91-b17d-4110c18b2850",
                                                "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                                "text": "\"Ever heard a Terry sermon?\" Delaine wanted to know. \"He usually starts with a joke, almost always a groaner. I love his puns! Besides, he's not afraid to tackle any issue, and he makes fun of just about everything in sight.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6dfb374-d7e2-33ca-97d3-d308c1f9ba22",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "A whistling buoy."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc64fdd7-eec7-4ecb-b1f6-1890f0e570eb",
                        "source_entry_id": "82a517f6-292e-345e-b37c-315513e14955",
                        "source_sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                        "target_lang_word": "corny joke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9e04d3e9-7e5d-41f2-b965-12cc39cfa1cf",
                        "source_entry_id": "82a517f6-292e-345e-b37c-315513e14955",
                        "source_sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                        "target_lang_word": "calembour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calembour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                        "entry_id": "5a6491e5-2103-3c62-9750-3b8ae522b9a3",
                                        "glosses": [
                                            "Jeu de mots fondé sur l’homophonie et la polysémie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65cabfe3-dbbe-47a9-ab5a-a44799ea3fff",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Et tous les jours, à la Bourse, on saluait d’un nouveau calembour le spéculateur jalousé."
                                            },
                                            {
                                                "example_id": "5d37ab3e-0aa0-4192-ab76-0bc88bfe2c16",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Le calembour est la fiente de l’esprit qui vole. Le lazzi tombe n’importe où ; et l’esprit, après la ponte d’une bêtise, s’enfonce dans l’azur. Une tache blanchâtre qui s’aplatit sur le rocher n’empêche pas le condor de planer. Loin de moi l’insulte au calembour !"
                                            },
                                            {
                                                "example_id": "e656b0b9-ed96-4322-ab80-bb60b12874bf",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Té ! Boudiou ! s’écrie notre insupportable voisin qui n’a cessé de dire des insanités et de faire des calembours (et quels calembours, grands dieux !)."
                                            },
                                            {
                                                "example_id": "c9f61c0c-6e01-439f-bb69-b88510e8d49c",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "De la même façon, l’écriture rushdienne transcrit la langue de S.S. Sisodia et la « brissétise », en recourant en permanence sur la décomposition des syntagmes pour en exploiter les ambiguïtés et les calembours jaillissant de l’homophonie."
                                            },
                                            {
                                                "example_id": "ba89840a-6907-470c-baee-1768a8a04bdf",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Il demandait pour Locke une formule qui fût pour cette philosophie ce qu'est le « Je pense, donc je suis » de Des­cartes. Je répondis par un horrible calembour. « Je penche, donc je suis »."
                                            },
                                            {
                                                "example_id": "206806af-7cf7-4e6b-ba0c-b9dbcf580415",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "À-peu-près et calembour appartiennent tous les deux à la tribu Jeudemots, mais ils ne sont pas les seuls !"
                                            },
                                            {
                                                "example_id": "d792eaac-902f-47a4-837b-f6c238731e3c",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "La phrase En voyant le lit vide, il le devint. est un calembour souvent attribué à Ponson du Terrail et basé sur l’homonymie de livide et lit vide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
