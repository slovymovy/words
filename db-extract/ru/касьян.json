                "senses": [
                    {
                        "sense_id": "a2366ec8-c2d6-3ca4-ad6a-d3938affd9cd",
                        "entry_id": "83f19960-869b-3bb7-a775-b012ac2a3e2d",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8600276-c779-4dfd-b10f-5446e340663c",
                                "sense_id": "a2366ec8-c2d6-3ca4-ad6a-d3938affd9cd",
                                "text": "В течение всей дороги Касьян сохранял упорное молчание и на мои вопросы отвечал отрывисто и нехотя."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca6c847c-0fb0-31bd-a452-d95041f58635",
                        "entry_id": "83f19960-869b-3bb7-a775-b012ac2a3e2d",
                        "glosses": [
                            "название дня 29 февраля в народном календаре"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce12e48d-82d9-446c-b0ae-514f1b8265b0",
                                "sense_id": "ca6c847c-0fb0-31bd-a452-d95041f58635",
                                "text": "На Касьяна же крестьяне работают, хотя он тоже сердит, работают потому, что Касьян немилостив — не стоит ему, значит, праздновать, отчего ему, Касьяну, и бывает праздник только в четыре года раз."
                            }
                        ]
                    }
