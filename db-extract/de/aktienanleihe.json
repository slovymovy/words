                "senses": [
                    {
                        "sense_id": "8d068324-3df6-3e7a-a0ef-3d63a6f38416",
                        "entry_id": "2e860724-8979-3ce0-93cf-bceb1d55012f",
                        "glosses": [
                            "verzinsliche, an die Kursentwicklung einer Aktie gekoppelte Schuldverschreibung bei deren Laufzeitende der Emittent entscheidet, ob die Auszahlung zum Nominalbetrag oder in der Ausgabe einer festgelegten Anzahl von Aktien erfolgt."
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "76c8134f-b6ad-40f6-afff-f6ada069c9b2",
                                "sense_id": "8d068324-3df6-3e7a-a0ef-3d63a6f38416",
                                "text": "„Während das Finanzinstrument der Aktienanleihe für den Emittenten, der nur mit dem hohen Zinssatz belastet wird, risikolos ist, gerät der Erwerber in eine Risikoposition, die durch den Begriff der ‚Anleihe‘ eher verschleiert wird.“"
                            },
                            {
                                "example_id": "b2fe82e1-01db-444e-81c4-ad6483dbea89",
                                "sense_id": "8d068324-3df6-3e7a-a0ef-3d63a6f38416",
                                "text": "„Aktienanleihen werden Anlegern von den Banken ganz gerne angedreht, immer mit einem Hinweis auf die angeblich so unglaublich attraktive Verzinsung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
