                "senses": [
                    {
                        "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                        "entry_id": "c5fb0c1f-848d-31ff-b610-0e786441d7e5",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ad1638-f5d5-457c-ba75-30508a664593",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Frau Apollo ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "27977810-88d5-4d43-8bd3-7a37bcd0f699",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Herr Apollo wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d23b9730-33e4-4e7e-ad1f-9269d98f01a8",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Die Apollos kommen heute vom Mittelmeer."
                            },
                            {
                                "example_id": "5ef38700-4926-4df0-a650-e4bb5ef306a2",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Der Apollo trägt nie die Schals, die die Apollo ihm strickt."
                            },
                            {
                                "example_id": "62cf429b-2e75-4fce-abd7-9d80d512af91",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Apollo kommt, geht der Herr Apollo.“"
                            },
                            {
                                "example_id": "6ac1837a-0c30-48c1-9aad-0c7535fd6c8a",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Apollo kommt und geht."
                            },
                            {
                                "example_id": "9db691d8-dd47-4f3b-927e-b9e5f836dc83",
                                "sense_id": "212e5b32-926c-37b4-8df9-c111c8343d7a",
                                "text": "Apollos kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
