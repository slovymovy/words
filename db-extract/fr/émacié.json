                    }
                ],
                "senses": [
                    {
                        "sense_id": "b92dcc21-7a1d-3aea-9f2a-524eec6ca306",
                        "entry_id": "af414ef7-7ccc-3979-94ef-4ba5a166d682",
                        "glosses": [
                            "Qui est très amaigri."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "670f1f8f-1ba8-419b-aa4c-3598b7d70884",
                                "sense_id": "b92dcc21-7a1d-3aea-9f2a-524eec6ca306",
                                "text": "Sa figure était pâle, émaciée."
                            },
                            {
                                "example_id": "676af732-9e20-4b0b-bc6e-4dff65d2cdbe",
                                "sense_id": "b92dcc21-7a1d-3aea-9f2a-524eec6ca306",
                                "text": "Vinson … s’était trouvé attiré, séduit par une grande fille aux cheveux teints, aux joues émaciées, aux yeux brillants et dont l’allure faubourienne et parigote l’avait complètement subjugué."
                            },
                            {
                                "example_id": "83d8a382-2de8-40c8-9b46-d18d8e2116c9",
                                "sense_id": "b92dcc21-7a1d-3aea-9f2a-524eec6ca306",
                                "text": "Une fois de plus, je regardai les juges : le colonel avait des traits émaciés de colonial hépatique, des cheveux gris."
                            },
                            {
                                "example_id": "114d7165-3cf3-4afb-a714-dc9f4c1faabc",
                                "sense_id": "b92dcc21-7a1d-3aea-9f2a-524eec6ca306",
                                "text": "Mme Loiseau chuchotait à Henriette que son mari était bien maigre, qu’il lui faudrait des reconstituants. Le fait est qu’Alexis était émacié, il n’en restait que deux profils collés ensemble."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "839e2299-860d-4e26-9a0c-f956e06f5bcc",
                        "source_entry_id": "af414ef7-7ccc-3979-94ef-4ba5a166d682",
                        "source_sense_id": "b92dcc21-7a1d-3aea-9f2a-524eec6ca306",
                        "target_lang_word": "emaciated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emaciated",
