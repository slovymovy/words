                    {
                        "translation_id": "7eedc2b3-7b4a-43c5-b949-0c7f07486660",
                        "source_entry_id": "4cfc8e0c-11d8-38b3-a2ec-d9d4aa61541e",
                        "source_sense_id": "b29f294c-beec-3e8c-a266-b948055cf8d9",
                        "target_lang_word": "Bagdad",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bagdad",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "797033ee-e2cb-3ed3-a787-43c09c082d11",
                                        "entry_id": "76b46c24-bf15-318b-b810-249346524f6a",
                                        "glosses": [
                                            "Capitale de l’Iraq."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb121d0-515d-47f6-acef-66993a07354d",
                                                "sense_id": "797033ee-e2cb-3ed3-a787-43c09c082d11",
                                                "text": "Lucienne. — C’est quand j’étais ainsi que mon mari me trouvait la plus belle ! suis-je vraiment belle ainsi ?\nPontagnac. — Oh ! oui, belle ! belle comme la princesse de Bagdad !"
                                            },
                                            {
                                                "example_id": "bdf88075-c44f-469e-957b-bcaa1e410380",
                                                "sense_id": "797033ee-e2cb-3ed3-a787-43c09c082d11",
                                                "text": "Les Abbassides encouragèrent plus encore une civilisation cosmopolite, dont Bagdad fut le centre et l’arabe la lingua franca."
                                            },
                                            {
                                                "example_id": "17d2aff2-348c-45e5-999b-0a44058be6c7",
                                                "sense_id": "797033ee-e2cb-3ed3-a787-43c09c082d11",
                                                "text": "Mais avant cela, quelle splendeur fut celle de Bagdad. Le long de mes berges, palmiers et palais frôlaient mon flot. J’ai baigné les califes et les princesses aux longs cheveux. Aujourd’hui, Bagdad la tourmentée déverse en moi ses vomissures, sa bile et ses blessés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e79fd89f-14c1-3f3f-a8cf-76221d94aabe",
                                        "entry_id": "76b46c24-bf15-318b-b810-249346524f6a",
                                        "glosses": [
                                            "Gouvernement irakien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8bf4df-3df6-4043-8597-8384edc8cf5a",
                                                "sense_id": "e79fd89f-14c1-3f3f-a8cf-76221d94aabe",
                                                "text": "L’année suivante en passant par l’Iran je pus, avec l’aide des services secrets du shah, (la Savak) enchantés que les Kurdes missent la pâtée aux troupes de Bagdad, franchir clandestinement la frontière et rencontrer le grand Barzani."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9de8ff6-db97-4944-90bd-5db7b612ff0a",
                        "source_entry_id": "4cfc8e0c-11d8-38b3-a2ec-d9d4aa61541e",
                        "source_sense_id": "b29f294c-beec-3e8c-a266-b948055cf8d9",
                        "target_lang_word": "Baghdad",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baghdad",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76b7caa9-0cf0-3665-b7cb-e3c3ce22a67f",
                                        "entry_id": "07b6d526-2de4-3276-b58b-bf68f46be02c",
                                        "glosses": [
                                            "Variante orthographique de Bagdad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7622c93c-0a6d-4273-a662-bd47f555a86a",
                                                "sense_id": "76b7caa9-0cf0-3665-b7cb-e3c3ce22a67f",
                                                "text": "N’oublie jamais ce que sont nos villes d’islam, La Mecque, Médine, Ispahan, Baghdad, Damas, Boukhara, Merv, Le Caire, Samarcande : rien que des oasis qu’un moment d’abandon ramènerait au désert. Constamment à la merci d’un vent de sable !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47dfeb3a-810d-4641-9a61-ea90ba737b30",
                        "source_entry_id": "4cfc8e0c-11d8-38b3-a2ec-d9d4aa61541e",
                        "source_sense_id": "b29f294c-beec-3e8c-a266-b948055cf8d9",
                        "target_lang_word": "Bagdad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bagdad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8eba34-41f0-3d1b-9506-b0cd975fef08",
                                        "entry_id": "a2f06b19-acd6-3864-bacc-7a5822f92542",
                                        "glosses": [
                                            "Hauptstadt von Irak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3358b9-301e-47fc-aae9-a631f4312b4f",
                                                "sense_id": "ad8eba34-41f0-3d1b-9506-b0cd975fef08",
                                                "text": "Er wurde in Bagdad geboren."
                                            },
                                            {
                                                "example_id": "c7fe022d-fc1e-4f68-8e79-4233347c75dd",
                                                "sense_id": "ad8eba34-41f0-3d1b-9506-b0cd975fef08",
                                                "text": "„Die deutsche Botschaft in Bagdad liegt versteckt hinter mehreren hohen Betonwänden.“"
                                            },
                                            {
                                                "example_id": "2d52a663-8912-4cd6-9740-bae821bd4a9f",
                                                "sense_id": "ad8eba34-41f0-3d1b-9506-b0cd975fef08",
                                                "text": "„Als ich siebzehn Jahre alt war, hielten mich viele für einen Freak, sowohl in meiner Familie als auch in der Schule und in dem Viertel, in dem ich in Bagdad aufwuchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
