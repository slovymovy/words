                "senses": [
                    {
                        "sense_id": "2bdd580b-14e8-3219-bc6a-6ac6563348c1",
                        "entry_id": "642fc3e0-b4da-3fb9-9525-d51fa367624b",
                        "glosses": [
                            "Mandataire (attention, pas au sens où le droit commercial l’entend) qui, moyennant une prime, s’entremet pour la vente ou l’achat de certaines marchandises, ou pour les affrètements, les assurances, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b832de6-f2ef-4d73-b2a7-905faff522de",
                                "sense_id": "2bdd580b-14e8-3219-bc6a-6ac6563348c1",
                                "text": "En effet, l’un est courtier en dents, et l’autre est courtière en cheveux. Miss Horatia Bluett représente une importante maison de Londres, la maison Holmes-Holme, à laquelle le Céleste-Empire expédie annuellement pour deux millions de chevelures féminines."
                            },
                            {
                                "example_id": "d78f5cce-89d8-4a6c-b820-5b8559d5a417",
                                "sense_id": "2bdd580b-14e8-3219-bc6a-6ac6563348c1",
                                "text": "Elle arrivait tard, laissait son Austin dans la cour et débouchait dans la salle, une serviette sous le bras, arborant ce que sa mère elle-même appelait « un sourire de courtière »."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d918afd-0812-348e-82b1-3fb46c7aff7c",
                        "entry_id": "642fc3e0-b4da-3fb9-9525-d51fa367624b",
                        "glosses": [
                            "Intermédiaire qui agit sur les marchés financiers pour le compte de tiers ; intermédiaire qui met en relation deux parties pour qu’elles contractent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4125e926-5639-3119-a510-6a6cf7de91c9",
                        "entry_id": "642fc3e0-b4da-3fb9-9525-d51fa367624b",
                        "glosses": [
                            "Dans un moulin hydraulique, emplacement réservé à la roue à aubes."
                        ],
                        "tags": [],
                        "examples": []
                    }
