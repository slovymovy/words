                        "examples": [
                            {
                                "example_id": "bae490e2-d4ad-44b4-9c90-6d464e4db46b",
                                "sense_id": "1bdb3cd1-6f8a-3753-a257-5d6e58dd00d6",
                                "text": "A wolf howled somewhere upmountain. The bear raised his head to the sound, then moved toward the elk to protect its kill."
                            },
                            {
                                "example_id": "af9c99bf-fa20-41dc-b2ce-32843ede641d",
                                "sense_id": "1bdb3cd1-6f8a-3753-a257-5d6e58dd00d6",
                                "text": "“But ladies, we have hardly time for a trip upmountain,” the Mouser called after protestingly, “what with preparations to be made for the Isle's defense and tomorrow's sailing against the Mingols.”"
                            }
                        ]
