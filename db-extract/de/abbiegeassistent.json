                "senses": [
                    {
                        "sense_id": "17ad351e-d92b-3ce9-a2eb-257091b9ae93",
                        "entry_id": "82c53657-4787-3f37-b6d4-3033d4bf89df",
                        "glosses": [
                            "technisches System in Fahrzeugen, das den Fahrer beim Abbiegen unterstützt und Kollisionen vermeiden hilft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4592ecc5-0847-4dad-a53d-72fbf823cb00",
                                "sense_id": "17ad351e-d92b-3ce9-a2eb-257091b9ae93",
                                "text": "„Erfasst der Abbiegeassistent im toten Winkel auf der Beifahrerseite einen Radfahrer oder Fußgänger, geht am Armaturenbrett eine gelbe Warnleuchte an. Droht Kollisionsgefahr, blinkt eine rote Leuchte, zusätzlich ertönt ein akustisches Warnsignal.“"
                            },
                            {
                                "example_id": "4bfd7bc4-afd2-4a79-93fe-56d709576105",
                                "sense_id": "17ad351e-d92b-3ce9-a2eb-257091b9ae93",
                                "text": "„Manche serienmäßig eingebauten Abbiegeassistenten verfügen sogar über eine Notbremsfunktion, die den Lkw automatisch abbremst.“"
                            },
                            {
                                "example_id": "e36c0fb6-251f-4a1d-9d52-e219495af40c",
                                "sense_id": "17ad351e-d92b-3ce9-a2eb-257091b9ae93",
                                "text": "„Abbiegeassistenten sind zwar sinnvoll, ihr Einsatz aber bislang freiwillig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
