        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7df7590c-c749-3bb8-aeb8-fceb3bfea72e",
                "word": "Shiva",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d3a4884-428a-3467-b41c-68d107a520e4",
                        "entry_id": "7df7590c-c749-3bb8-aeb8-fceb3bfea72e",
                        "glosses": [
                            "The god of destruction and transformation, and together with Brahma and Vishnu, one of the principal deities in Hinduism. Within Shaivism he is viewed as the Supreme deity, whereas in other branches of Hinduism such as the Smarta tradition he is worshipped as one of the six manifestations of the Divine."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "faf42f59-7f81-3397-84c0-fb12f3cdf408",
                        "entry_id": "7df7590c-c749-3bb8-aeb8-fceb3bfea72e",
                        "glosses": [
                            "A male given name from Sanskrit used in India."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58ebe6ce-f244-4b3f-8f1f-be2dd4779061",
                        "source_entry_id": "7df7590c-c749-3bb8-aeb8-fceb3bfea72e",
                        "source_sense_description": "deity",
                        "target_lang_word": "Šiva",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7090983b-3247-4f97-aced-673ff1bbe667",
                        "source_entry_id": "7df7590c-c749-3bb8-aeb8-fceb3bfea72e",
                        "source_sense_description": "deity",
                        "target_lang_word": "Schiwa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eef1b40-e077-321e-a338-7832eec8cf9d",
                                        "entry_id": "438de7e6-899b-3b81-95c4-a69ed249b657",
                                        "glosses": [
                                            "Name eines der Hauptgötter in der hinduistischen Götterdreiheit (Trimurti), der sowohl Zerstörung und Tod als auch Fruchtbarkeit und Zeugungskraft symbolisiert"
                                        ],
                                        "tags": [
                                            "hinduistische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26c64158-f021-4d84-ade6-8a2900f1823c",
                                                "sense_id": "8eef1b40-e077-321e-a338-7832eec8cf9d",
                                                "text": "„Der Fahrer des Bemos selbst tankt an kleinen Tempeln neue Kraft, während sein Gefährt, oft ungetankt, mit Schiwas Hilfe ins Ziel einrollt.“"
                                            },
                                            {
                                                "example_id": "95e238c8-d4ac-43b2-af09-e4767a24fd3c",
                                                "sense_id": "8eef1b40-e077-321e-a338-7832eec8cf9d",
                                                "text": "„Das größte hinduistische Heiligtum Indonesiens umfaßte einst einen äußeren Ring von 224 kleineren Tempeln sowie neun Haupttempel, deren wichtigste den drei höchsten Hindu-Göttern Brahma, Wischnu und Schiwa gewidmet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schiwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dbf3684-fcfa-337b-bb70-3c83228f1681",
                                        "entry_id": "1999cf79-5d51-379f-b55b-71ad3835241c",
                                        "glosses": [
                                            "figürliche Darstellung des Gottes Schiwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd060f36-0c77-4277-a843-ac2c9514df7e",
                                                "sense_id": "9dbf3684-fcfa-337b-bb70-3c83228f1681",
                                                "text": "„Ein Buddha aus Ton steht herum, ein kleiner Schiwa; hier muss man sich einfach wohlfühlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schiwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                        "entry_id": "6eda4122-c063-3ff7-8fa7-7d2b78f80c9e",
                                        "glosses": [
                                            "unmittelbar nach dem Begräbnis eines Anverwandten ersten Grades (Vater, Mutter, Bruder, Schwester, Sohn, Tochter sowie Ehegatte, Ehegattin) beginnende siebentägige Trauerzeit"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf5b8a3-4477-4a61-b837-9e28543a19f1",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„Die junge Frau steht mit der Familie des Toten am offenen Grab, sitzt sieben endlos lange Tage Schiwa, verbringt Stunden an der Grabstätte des Mannes, dessen Ehefrau sie hätte werden sollen, mit dem sie Kinder großziehen wollte.“"
                                            },
                                            {
                                                "example_id": "d0a2f801-d44a-444f-8cb0-b89dd96d2257",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„«Nach der Schiwa begann ich, den Gemeinderat, die öffentliche Straßenbaubehörde ‚Maatz‘ und das Verkehrsministerium zu belangen», erzählt Bach.“"
                                            },
                                            {
                                                "example_id": "8b047dc7-a862-4f62-b248-8628ce8e9359",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„Es ist beachtlich, wie viele verbale Seitenhiebe diese Hinterbliebene während Schiwa und Scheloschim, den sieben- beziehungsweise dreissigtägigen jüdischen Trauerzeiten, nach denen Anna Mitgutsch den Roman strukturiert hat, von Jeromes Sippschaft, seinen Kompagnons und FreundInnen [sic] einstecken muss.“"
                                            },
                                            {
                                                "example_id": "b4e1ae00-7440-4fce-a219-838249f59397",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„Prinzipiell kann dieser Kreis um die sieben Personen erweitert werden, die Schiwa zu sitzen haben, nämlich die Kinder, den Vater, die Mutter, den Bruder, die Schwester, den Ehemann bzw. die Ehefrau.“"
                                            },
                                            {
                                                "example_id": "066de6bc-6a36-493a-8b97-d9e62c65e590",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„Laut der Tradition sitzen die Trauernden während der Schiwa auf niedrigen Stühlen oder Hockern – aus dem Bewusstsein heraus, dass eine unwiderrufliche Veränderung in ihrem Leben eingetreten ist.“"
                                            },
                                            {
                                                "example_id": "5fb340e1-0f2c-4c46-9dae-933f29f5d159",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„An den Tod schließen drei Trauerperioden mit jeweils bestimmten Pflichten und Verboten an: die sieben Tage der Trauer (Schiwa), die dreißig Tage der Trauer (Shloshim) sowie das Trauerjahr.“"
                                            },
                                            {
                                                "example_id": "79d452a8-4dec-4a86-b594-5a93befde37a",
                                                "sense_id": "a10839a2-5931-3581-b636-3d809973f3aa",
                                                "text": "„Auf die Beerdigung folgt die Schiwa, die Trauerwoche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
