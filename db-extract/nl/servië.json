                "senses": [
                    {
                        "sense_id": "b8fbc9f5-1ea5-304e-ae57-dd68cd2e338e",
                        "entry_id": "1bc7e6f4-739a-3617-963c-6d228d665e82",
                        "glosses": [
                            "een land in Zuidoost-Europa, grenzend aan Kroatië en Bosnië en Herzegovina in het westen, aan Hongarije in het noorden, aan Roemenië en Bulgarije in het oosten en aan Noord-Macedonië, Kosovo en Montenegro in het zuiden"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46cec3e4-410b-440a-a10e-29d3627c205c",
                        "source_entry_id": "1bc7e6f4-739a-3617-963c-6d228d665e82",
                        "source_sense_id": "b8fbc9f5-1ea5-304e-ae57-dd68cd2e338e",
                        "source_sense_description": "een land in Zuidoost-Europa.",
                        "target_lang_word": "Serbien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serbien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                        "entry_id": "ec945141-22b6-3f97-9825-13c022806f1b",
                                        "glosses": [
                                            "Staat in Südosteuropa"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce9d3eb-9887-4c45-93a6-c3d411044e04",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Ich komme aus Serbien."
                                            },
                                            {
                                                "example_id": "eccfd2a3-34c6-4e9e-9798-54244f7bf8b3",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Belgrad ist die Hauptstadt der Republik Serbien."
                                            },
                                            {
                                                "example_id": "3bd1a4a5-ec86-4629-b158-524f5bb84c9e",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Alle wichtigen Verkehrswege Südosteuropas kreuzen sich in Serbien."
                                            },
                                            {
                                                "example_id": "fe707f9c-ce5d-4471-80bb-6ffd66f9f087",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "„Ich hatte Sébastien und seine hübsche Freundin Anis vor einer knappen Woche beim Donaudurchbruch in Serbien getroffen.“"
                                            },
                                            {
                                                "example_id": "96b70474-6c97-4c53-a358-fc30ea2c6efd",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "„Doch sosehr sie die Arbeit, die sie in Serbien verrichtete, schätzte, es war nicht ihre Art von Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cbc22d8-e718-4847-8a0c-808ac59dc0c1",
                        "source_entry_id": "1bc7e6f4-739a-3617-963c-6d228d665e82",
                        "source_sense_id": "b8fbc9f5-1ea5-304e-ae57-dd68cd2e338e",
                        "source_sense_description": "een land in Zuidoost-Europa.",
                        "target_lang_word": "Serbia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serbia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9b9e67-029f-3c7b-a716-8cd7f6f79337",
                                        "entry_id": "ca0a600f-1564-3d8e-961a-c1877325baa3",
                                        "glosses": [
                                            "A country on the Balkan Peninsula in Southeast Europe. Official name: Republic of Serbia. Capital and largest city: Belgrade. Part of Yugoslavia until 1992, then part of Serbia and Montenegro until 2006."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7beb5148-0848-4ef9-a9d0-d3a76a0b7afd",
                                                "sense_id": "7e9b9e67-029f-3c7b-a716-8cd7f6f79337",
                                                "text": "The 153-page ruling from the International Court of Justice means that modern-day Serbia will not have to pay restitution to Croatia, which in 1991 split from what was then Yugoslavia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "debb5515-6cad-3315-aea9-b1990273de62",
                                        "entry_id": "ca0a600f-1564-3d8e-961a-c1877325baa3",
                                        "glosses": [
                                            "A geographic region of Southeast Europe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "193e4e07-3e24-4deb-aad9-a27c4f2b282c",
                        "source_entry_id": "1bc7e6f4-739a-3617-963c-6d228d665e82",
