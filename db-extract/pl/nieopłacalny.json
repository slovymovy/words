                ],
                "senses": [
                    {
                        "sense_id": "abd0aa70-134b-3c32-81e9-d1dd8acdb38a",
                        "entry_id": "9198d89f-5e62-34bc-8c78-5c84898403a3",
                        "glosses": [
                            "taki, który nie pokrywa poniesionych kosztów i przynosi straty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54a2efd-c268-4474-b263-f857bd179ec1",
                                "sense_id": "abd0aa70-134b-3c32-81e9-d1dd8acdb38a",
                                "text": "W piśmie naczelnika wydziału infrastruktury komunalnej Jana Galicy przeczytać można, że inwestycja z punktu widzenia władz miasta jest nieopłacalna"
                            },
                            {
                                "example_id": "e5670d4f-11ec-4cd7-a4fa-efa978a36ea5",
                                "sense_id": "abd0aa70-134b-3c32-81e9-d1dd8acdb38a",
                                "text": "Zaczął od tego, że na październikowym plenum w 1956 roku chciał zaprzestać nieopłacalnego wywozu węgla do ZSRR"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8598fd2-5658-49d4-ab83-eaf3ab5b7723",
                        "source_entry_id": "9198d89f-5e62-34bc-8c78-5c84898403a3",
                        "source_sense_id": "abd0aa70-134b-3c32-81e9-d1dd8acdb38a",
                        "target_lang_word": "uneconomic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uneconomic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1862432-78c3-33e1-9371-375be20e1dcd",
                                        "entry_id": "d90052ab-a532-3b29-99db-79e57ed98f34",
                                        "glosses": [
                                            "Financially inefficient, costly, wasteful, or loss-making."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863c0568-0055-4fff-b144-c34a35cffa0c",
                                                "sense_id": "d1862432-78c3-33e1-9371-375be20e1dcd",
                                                "text": "Barker believed that evidence was emerging that a \"solid proportion\" of operations were \"grossly uneconomic\", and that no amount of improvement in equipment would make them viable. He suggested that \"while the superstructure of the report is correct, the foundations require radical re-examination\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f66b79e6-1736-412b-afe3-c9aa96bb2f86",
                        "source_entry_id": "9198d89f-5e62-34bc-8c78-5c84898403a3",
                        "source_sense_id": "abd0aa70-134b-3c32-81e9-d1dd8acdb38a",
                        "target_lang_word": "unrentabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrentabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                        "entry_id": "7fc200ba-bd24-3099-afad-71b4904e8a88",
                                        "glosses": [
                                            "nicht rentabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c07678f-2628-4211-8a7f-7980dd9dde20",
                                                "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                                "text": "„Als der Zugverkehr auf dieser unrentablen Strecke im September 1968 eingestellt wurde, fiel das fast auf den Tag genau mit dem Ende unserer Jugendzeit zusammen, denn nur wenige Monate später gingen wir, in alle Winde verstreut, jeder für sich seinen Weg.“"
                                            },
                                            {
                                                "example_id": "18331b36-01f8-427f-8abc-4b8c68f2d981",
                                                "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                                "text": "„Der Erdöl- und Gaskonzern OMV denkt im Zuge seiner Strategieüberprüfung auch über einen Verkauf seines unrentablen türkischen Gaskraftwerks nach.“"
                                            },
                                            {
                                                "example_id": "6f7cfa0f-2228-4a2e-a622-e850feab6ef2",
                                                "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                                "text": "„Als die Briten nach Nordwestindien vordrangen, verkauften sie 1846 große Teile von Jammu und Kaschmir für ca. eine Million Pfund an den Dografürsten Gulab Singh, da sie die Region für wirtschaftlich unrentabel hielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71beb3ad-bd71-49b9-b996-eccb59e9aa3b",
                        "source_entry_id": "9198d89f-5e62-34bc-8c78-5c84898403a3",
                        "source_sense_id": "abd0aa70-134b-3c32-81e9-d1dd8acdb38a",
                        "target_lang_word": "unwirtschaftlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwirtschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c49375d8-d525-3b8f-a7d6-629f29b9a9e9",
                                        "entry_id": "11c3dc39-7780-3938-98cb-abce5939c0fd",
                                        "glosses": [
                                            "wenig oder keinen Ertrag erzielend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33414ac8-d272-4411-ae18-43e94b7e2bfc",
                                                "sense_id": "c49375d8-d525-3b8f-a7d6-629f29b9a9e9",
                                                "text": "„Die Stadt Potsdam hält die Rückkehr zu Oberleitungsbussen für unwirtschaftlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "270cdcb6-3397-3ab8-9340-32fd0de13286",
