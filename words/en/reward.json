{
    "word_family": [
        "rewarding",
        "unrewarding",
        "rewardable",
        "rewarder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b577e4b-fc09-3821-aaee-6d5058aaa705",
                    "sense_definition": "Something of value, such as money or a prize, given in return for an act, service, or achievement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police offered a large <w>reward</w> for information about the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция предложила крупное <w>вознаграждение</w> за информацию об ограблении.",
                                "tr": "Polis, soygunla ilgili bilgi için büyük bir <w>ödül</w> teklif etti."
                            }
                        },
                        {
                            "text": "She received a cash <w>reward</w> for finding the lost dog.",
                            "target_lang_translations": {
                                "ru": "Она получила денежное <w>вознаграждение</w> за то, что нашла пропавшую собаку.",
                                "tr": "Kayıp köpeği bulduğu için nakit <w>ödül</w> aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "payment",
                        "recompense",
                        "bounty",
                        "prize",
                        "award"
                    ],
                    "antonyms": [
                        "punishment"
                    ],
                    "common_phrases": [
                        "cash reward",
                        "offer a reward",
                        "reward for information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценность, такая как деньги или приз, выдаваемая в обмен на поступок, услугу или достижение.",
                        "tr": "Bir eylem, hizmet veya başarı karşılığında verilen para veya ödül gibi değerli bir şey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вознаграждение",
                                "target_lang_sense_clarification": "плата за услугу или помощь"
                            },
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "приз или почетный знак"
                            },
                            {
                                "target_lang_word": "премия",
                                "target_lang_sense_clarification": "денежное поощрение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ödül",
                                "target_lang_sense_clarification": "bir başarı veya yardım karşılığında verilen hediye veya para"
                            },
                            {
                                "target_lang_word": "mükâfat",
                                "target_lang_sense_clarification": "iyilik veya başarı karşılığı verilen karşılık"
                            },
                            {
                                "target_lang_word": "ikramiye",
                                "target_lang_sense_clarification": "parasal ödül veya bahşiş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                    "sense_definition": "The result or consequence of an action, usually referring to something deserved.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His success is the <w>reward</w> for all his hard work.",
                            "target_lang_translations": {
                                "ru": "Его успех — это <w>награда</w> за весь его упорный труд.",
                                "tr": "Onun başarısı, tüm sıkı çalışmasının <w>mükâfatıdır</w>."
                            }
                        },
                        {
                            "text": "Is this the <w>reward</w> I get for telling the truth?",
                            "target_lang_translations": {
                                "ru": "Это та <w>награда</w>, которую я получаю за то, что сказал правду?",
                                "tr": "Doğruyu söylediğim için aldığım <w>karşılık</w> bu mu?"
                            }
                        }
                    ],
                    "synonyms": [
                        "consequence"
                    ],
                    "common_phrases": [
                        "just reward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат или последствие действия, обычно заслуженное.",
                        "tr": "Genellikle hak edilmiş bir şeyi ifade eden, bir eylemin sonucu veya getirisi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "заслуженный итог"
                            },
                            {
                                "target_lang_word": "вознаграждение",
                                "target_lang_sense_clarification": "отдача за усилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ödül",
                                "target_lang_sense_clarification": "çabanın veya eylemin olumlu sonucu"
                            },
                            {
                                "target_lang_word": "mükâfat",
                                "target_lang_sense_clarification": "emeklerin hak edilen karşılığı"
                            },
                            {
                                "target_lang_word": "karşılık",
                                "target_lang_sense_clarification": "yapılan bir şeyin getirisi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                    "sense_definition": "To give something to someone in recognition of their services, efforts, or achievements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>rewarded</w> the employees with a bonus.",
                            "target_lang_translations": {
                                "ru": "Компания <w>поощрила</w> сотрудников премией.",
                                "tr": "Şirket, çalışanları ikramiye ile <w>ödüllendirdi</w>."
                            }
                        },
                        {
                            "text": "You should <w>reward</w> your dog for good behavior.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>поощрять</w> свою собаку за хорошее поведение.",
                                "tr": "Köpeğinizi iyi davranışları için <w>ödüllendirmelisiniz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "recompense",
                        "repay",
                        "compensate"
                    ],
                    "common_phrases": [
                        "reward generously",
                        "be rewarded with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать что-либо кому-либо в знак признания заслуг, усилий или достижений.",
                        "tr": "Birine hizmetleri, çabaları veya başarıları karşılığında bir şey vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награждать",
                                "target_lang_sense_clarification": "вручать награду"
                            },
                            {
                                "target_lang_word": "вознаграждать",
                                "target_lang_sense_clarification": "оплачивать или компенсировать"
                            },
                            {
                                "target_lang_word": "поощрять",
                                "target_lang_sense_clarification": "стимулировать наградой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ödüllendirmek",
                                "target_lang_sense_clarification": "bir başarıyı veya davranışı ödülle karşılıklandırmak"
                            },
                            {
                                "target_lang_word": "mükâfatlandırmak",
                                "target_lang_sense_clarification": "çabayı veya iyiliği karılık vererek takdir etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                    "sense_definition": "To yield a return or result for an action or effort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our patience was finally <w>rewarded</w> when the rain stopped.",
                            "target_lang_translations": {
                                "ru": "Наше терпение было наконец <w>вознаграждено</w>, когда дождь прекратился.",
                                "tr": "Yağmur durduğunda sabrımızın nihayet <w>karşılığını aldık</w>."
                            }
                        },
                        {
                            "text": "The long climb was <w>rewarded</w> by a beautiful view.",
                            "target_lang_translations": {
                                "ru": "Долгий подъем был <w>вознагражден</w> прекрасным видом.",
                                "tr": "Uzun tırmanış güzel bir manzarayla <w>ödüllendirildi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "patience is rewarded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносить результат или отдачу за действие или усилие.",
                        "tr": "Bir eylem veya çaba karşılığında sonuç vermek veya meyve vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вознаграждать",
                                "target_lang_sense_clarification": "приносить плоды или отдачу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşılığını vermek",
                                "target_lang_sense_clarification": "çabanın boşa gitmeyip sonuç getirmesi"
                            },
                            {
                                "target_lang_word": "ödüllendirmek",
                                "target_lang_sense_clarification": "sabır veya emeğin iyi bir sonuçla taçlanması"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}