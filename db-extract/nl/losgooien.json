                                "target_senses": [
                                    {
                                        "sense_id": "8dbc5fa3-64ea-36be-a3a9-1f3a816223de",
                                        "entry_id": "c6d40461-e2b2-3369-b322-e5ce72833573",
                                        "glosses": [
                                            "To discard or reject something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2548259-1a77-438b-9284-2cec186773fe",
                                                "sense_id": "8dbc5fa3-64ea-36be-a3a9-1f3a816223de",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "e21e9925-5824-44d4-8131-df6aee83571d",
                                                "sense_id": "8dbc5fa3-64ea-36be-a3a9-1f3a816223de",
                                                "text": "Mr. Christie, who as a presidential candidate has frequently suppressed his most pugilistic instincts, cast off any restraint and did what he does best: slice and slash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e221ca-83c0-3544-9752-8e165d626720",
                                        "entry_id": "c6d40461-e2b2-3369-b322-e5ce72833573",
                                        "glosses": [
                                            "To let go (a cable or rope securing a vessel to a buoy, wharf, etc.) so that the vessel may make way."
                                        ],
