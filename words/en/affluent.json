{
    "word_family": [
        "affluence",
        "affluently",
        "affluential"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da9954ca-99be-3c40-b8d2-962515039b7f",
                    "sense_definition": "Having a great deal of money; wealthy and successful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Upper East Side is an <w>affluent</w> neighborhood in New York City where many celebrities live.",
                            "target_lang_translations": {
                                "ru": "Верхний Ист-Сайд — это <w>богатый</w> район Нью-Йорка, где живут многие знаменитости."
                            }
                        },
                        {
                            "text": "As nations become more <w>affluent</w>, the demand for luxury goods and high-end services typically increases.",
                            "target_lang_translations": {
                                "ru": "По мере того как страны становятся более <w>состоятельными</w>, спрос на товары роскоши и элитные услуги обычно растет."
                            }
                        }
                    ],
                    "synonyms": [
                        "wealthy",
                        "rich",
                        "prosperous",
                        "well-off"
                    ],
                    "antonyms": [
                        "indigent"
                    ],
                    "common_phrases": [
                        "affluent neighborhood",
                        "affluent lifestyle",
                        "affluent society"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий большим количеством денег; богатый и успешный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "обладающий большим имуществом"
                            },
                            {
                                "target_lang_word": "состоятельный",
                                "target_lang_sense_clarification": "имеющий достаток"
                            },
                            {
                                "target_lang_word": "зажиточный",
                                "target_lang_sense_clarification": "обеспеченный, обычно о слоях населения"
                            },
                            {
                                "target_lang_word": "процветающий",
                                "target_lang_sense_clarification": "успешный и богатый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51ca37df-e3da-3d99-9884-7e2da7bee267",
                    "sense_definition": "Existing in large amounts; abundant or copious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shores are <w>affluent</w> in beauty, and the drive to the heights is incomparably lovely.",
                            "target_lang_translations": {
                                "ru": "Берега <w>изобилуют</w> красотой, а поездка к вершинам несравненно прекрасна."
                            }
                        },
                        {
                            "text": "The region is <w>affluent</w> in natural resources, providing plenty of materials for local industry.",
                            "target_lang_translations": {
                                "ru": "Регион <w>богат</w> природными ресурсами, обеспечивающими обилие материалов для местной промышленности."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundant",
                        "copious",
                        "plenteous"
                    ],
                    "common_phrases": [
                        "affluent in beauty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в больших количествах; обильный или изобильный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обильный",
                                "target_lang_sense_clarification": "имеющийся в избытке"
                            },
                            {
                                "target_lang_word": "изобильный",
                                "target_lang_sense_clarification": "богатый чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cfac1e2-83e2-36c2-871c-4ed51da18fe3",
                    "sense_definition": "Flowing towards a point or flowing in great abundance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor observed the <w>affluent</w> blood moving through the vessels during the procedure.",
                            "target_lang_translations": {
                                "ru": "Врач наблюдал за <w>обильно текущей</w> по сосудам кровью во время процедуры."
                            }
                        },
                        {
                            "text": "The <w>affluent</w> waters of the spring surged forward after the heavy seasonal rains.",
                            "target_lang_translations": {
                                "ru": "<w>Прибывающие</w> воды источника хлынули вперед после сильных сезонных дождей."
                            }
                        }
                    ],
                    "synonyms": [
                        "flowing",
                        "confluent"
                    ],
                    "common_phrases": [
                        "affluent blood"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Текущий к определенной точке или текущий в большом изобилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обильно текущий",
                                "target_lang_sense_clarification": "о потоке жидкости"
                            },
                            {
                                "target_lang_word": "прибывающий",
                                "target_lang_sense_clarification": "о воде или крови"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cad83b9-04b6-3336-a74e-e5b92b66ffe8",
                    "sense_definition": "Flowing into a larger body of water; acting as a tributary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>affluent</w> stream joins the main river just a few miles before it reaches the sea.",
                            "target_lang_translations": {
                                "ru": "<w>Впадающий</w> ручей соединяется с главной рекой всего за несколько миль до того, как она достигает моря."
                            }
                        },
                        {
                            "text": "Several <w>affluent</w> branches contribute to the massive volume of the Amazon river system.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>приточных</w> ветвей вносят вклад в огромный объем речной системы Амазонки."
                            }
                        }
                    ],
                    "synonyms": [
                        "tributary"
                    ],
                    "common_phrases": [
                        "affluent stream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впадающий в более крупный водоем; являющийся притоком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вливающийся",
                                "target_lang_sense_clarification": "о потоке воды"
                            },
                            {
                                "target_lang_word": "приточный",
                                "target_lang_sense_clarification": "относящийся к притоку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bfaf298-fd85-3c5a-bed5-1a9e3e5a48ef",
                    "sense_definition": "A person who is wealthy or has a high social status due to their riches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>affluents</w> in this city often prefer private hospitals that offer more personalized care.",
                            "target_lang_translations": {
                                "ru": "<w>Богачи</w> в этом городе часто предпочитают частные больницы, предлагающие более индивидуальный уход."
                            }
                        },
                        {
                            "text": "Marketing campaigns are often designed specifically to attract the <w>affluents</w> who can afford luxury cars.",
                            "target_lang_translations": {
                                "ru": "Маркетинговые кампании часто разрабатываются специально для привлечения <w>состоятельных людей</w>, которые могут позволить себе роскошные автомобили."
                            }
                        }
                    ],
                    "synonyms": [
                        "millionaire",
                        "plutocrat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который богат или имеет высокий социальный статус благодаря своему богатству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богач",
                                "target_lang_sense_clarification": "состоятельный человек"
                            },
                            {
                                "target_lang_word": "представитель имущих слоев",
                                "target_lang_sense_clarification": "человек с высоким достатком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5aca7f2-86c3-303a-9e93-55a1a0fe557c",
                    "sense_definition": "A stream or river that flows into a larger river or a lake.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>affluents</w> of the Amazon are diverse, with some being clear and others being quite opaque.",
                            "target_lang_translations": {
                                "ru": "<w>Притоки</w> Амазонки разнообразны: одни прозрачные, а другие довольно мутные."
                            }
                        },
                        {
                            "text": "All of the <w>affluents</w> quickly descend from the mountains into the desert valley below.",
                            "target_lang_translations": {
                                "ru": "Все <w>притоки</w> быстро спускаются с гор в пустынную долину внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "tributary",
                        "feeder",
                        "branch"
                    ],
                    "common_phrases": [
                        "river affluents"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручей или река, впадающая в более крупную реку или озеро."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приток",
                                "target_lang_sense_clarification": "река, впадающая в другую"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}