                        ],
                        "examples": [
                            {
                                "example_id": "4989eacd-b77f-45f4-8cc3-728cfa3db821",
                                "sense_id": "624cc4c2-474d-3903-a05f-27411e5c990f",
                                "text": "„Wie sich jetzt bei der Reprivatisierung der Offizin herausstellt, sind diese orientalischen Schriften in der Nachkriegszeit bis auf einige kyrillische Alphabete verschwunden.“"
                            },
                            {
                                "example_id": "b8343016-989b-4ab0-8d46-e7fa6e46fb08",
                                "sense_id": "624cc4c2-474d-3903-a05f-27411e5c990f",
                                "text": "„Also nicht nur die „berühmten Söhne“, sondern auch die Offizin des Gustav Kühn haben entscheidend zur Bekanntheit der Stadt beigetragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
