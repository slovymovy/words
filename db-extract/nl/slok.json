                "senses": [
                    {
                        "sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                        "entry_id": "10c5f1c9-6fbe-3000-9178-84d652d8e180",
                        "glosses": [
                            "een mondvol vloeistof die ingeslikt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b1f199-ac7f-45e3-9c5a-94dea524b381",
                                "sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                                "text": "Hij nam een slok uit zijn veldfles."
                            },
                            {
                                "example_id": "6ab886aa-57b4-4581-af2e-2577a03c6dc6",
                                "sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                                "text": "Ze neemt nog een grote slok van haar rode wijn."
                            },
                            {
                                "example_id": "276bab7a-1419-404d-9ce2-db46c1438255",
                                "sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                                "text": "Op 10 juli 2019 bereikt la belle fille op haar racefiets zwoegend de top. Ze zou net als haar voorgangers uit de 17de eeuw ook wel een frisse duik willen nemen, maar voorlopig volstaan gulzige slokken uit haar bidon."
                            },
                            {
                                "example_id": "841d6ab1-acaf-4374-9ac4-1e7bcadc0f64",
                                "sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                                "text": "Volgens de strandwacht kan dat gebeuren, bijvoorbeeld als mensen een golf over zich heen krijgen, een flinke slok zeewater drinken en dan ook nog de stroom tegen zich voelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a34cc156-e1c8-464f-be14-004ff2494391",
                        "source_entry_id": "10c5f1c9-6fbe-3000-9178-84d652d8e180",
                        "source_sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                        "source_sense_description": "een mondvol vloeistof die ingeslikt wordt",
                        "target_lang_word": "swig",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
