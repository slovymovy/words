                    },
                    {
                        "form_id": "44abe51f-b0de-40d8-97e5-8a5487966c8c",
                        "entry_id": "4cf81035-d0a4-39a5-8e83-f48e228487c9",
                        "tags": [],
                        "form": "anet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7307acb4-417d-3754-8d64-e7abac105fe3",
                        "entry_id": "4cf81035-d0a4-39a5-8e83-f48e228487c9",
                        "glosses": [
                            "Anethum, genre de plantes aromatiques de la famille des apiacées."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "82017d7b-bac1-33aa-9c26-e9195c8c9cee",
                        "entry_id": "4cf81035-d0a4-39a5-8e83-f48e228487c9",
                        "glosses": [
                            "Aneth odorant (Anethum graveolens), dont la semence est tonique et carminative, notamment utilisée dans la cuisine."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ea4de41c-a2c6-4320-8573-e3d760c52579",
                                "sense_id": "82017d7b-bac1-33aa-9c26-e9195c8c9cee",
                                "text": "Parsemez d’aneth (ou de menthe) hachée et de sumac, arrosez d’un trait d’huile d’olive et servez immédiatement."
                            },
                            {
                                "example_id": "843e6da8-0e68-44e4-ab7c-ec4f2f893eeb",
                                "sense_id": "82017d7b-bac1-33aa-9c26-e9195c8c9cee",
                                "text": "Les mets étaient agrémentés de plantes aromatiques (aneth, coriandre, sarriette), mais aussi de miel et d’huile d’olive importée d’Espagne, accompagnés de vin d’Italie ou du sud de la Gaule."
                            },
                            {
                                "example_id": "7c6a5c78-83e8-4d20-95a6-fd8058e68424",
                                "sense_id": "82017d7b-bac1-33aa-9c26-e9195c8c9cee",
                                "text": "Les mains chargées de branches d’aneth, chaque convive faisait éclater ses transports."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b9d74f5-1a6e-469f-b955-9901f31dcea8",
                        "source_entry_id": "4cf81035-d0a4-39a5-8e83-f48e228487c9",
                        "target_lang_word": "Dill",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dill",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "322742c5-2d78-385d-b9ea-bd073e4330b0",
                                        "entry_id": "b162d162-a0c1-3d69-989b-dea847db2c33",
                                        "glosses": [
                                            "Küchenkraut, Gewürzpflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e6ffd3-9b58-4047-9f99-be6632bbd2f8",
                                                "sense_id": "322742c5-2d78-385d-b9ea-bd073e4330b0",
                                                "text": "Dann geben wir reichlich Dill dazu."
                                            },
                                            {
                                                "example_id": "4809dd36-cfc8-43f4-81e0-70275032e88e",
                                                "sense_id": "322742c5-2d78-385d-b9ea-bd073e4330b0",
                                                "text": "Der Sternekoch hat in seinem riesigen Kräutergarten sogar verschiedene Dille gepflanzt."
                                            },
                                            {
                                                "example_id": "7a49464e-a7a1-4081-b43c-c585787a46c8",
                                                "sense_id": "322742c5-2d78-385d-b9ea-bd073e4330b0",
                                                "text": "„Außerdem legte er um das Haus herum Gemüsebeete an und pflanzte Petersilie, Dill, Schnittlauch, Mohrrüben, Kopfsalat und Fleischtomaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dill",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68800a84-f0fc-3420-91ca-a913c680eb12",
                                        "entry_id": "4de72b8e-778e-3a26-a2c3-05daab13b49f",
                                        "glosses": [
                                            "ein Fluss in Deutschland, Nebenfluss der Lahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5732057-bfe0-46ee-8924-177230932e79",
                                                "sense_id": "68800a84-f0fc-3420-91ca-a913c680eb12",
                                                "text": "Fahr mal wieder die Dill entlang!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0d63c2-96e3-4366-9bed-69698d13ce93",
                        "source_entry_id": "4cf81035-d0a4-39a5-8e83-f48e228487c9",
                        "target_lang_word": "dill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "503a8a50-021d-38a7-8582-0ca85892cf15",
                                        "entry_id": "b73bbffa-0b69-3cc7-bc13-0bb902a828fa",
                                        "glosses": [
                                            "Anethum graveolens (the type species of the genus Anethum), a herb, the seeds of which are moderately warming, pungent, and aromatic, formerly used as a soothing medicine for children; also known as dillseed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ad81da7-cb31-47c7-8624-514ef8d64d72",
                                                "sense_id": "503a8a50-021d-38a7-8582-0ca85892cf15",
                                                "text": "The life of one plant would be affected by another. Rue was definitely hostile to basil, rosemary to hyssop, but coriander, dill and chervil lived on the friendliest of terms[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0e062c-01ee-36d3-a586-fe30ab320396",
                                        "entry_id": "b73bbffa-0b69-3cc7-bc13-0bb902a828fa",
                                        "glosses": [
                                            "A cucumber pickled with dill flavoring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9639892-fe8c-30aa-8169-d36a01871546",
                                        "entry_id": "89436372-f483-375f-935c-bf325fd2a34f",
                                        "glosses": [
                                            "To cook or flavor with dill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681461db-2eb6-4ea4-912d-e7e7d40e0034",
                                                "sense_id": "a9639892-fe8c-30aa-8169-d36a01871546",
                                                "text": "My mother would pickle them and dill them, and we still had an abundance of fresh vegetables left."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                                        "entry_id": "7d0c2387-8a38-3058-af47-c67c28814141",
                                        "glosses": [
                                            "To still; to assuage; to calm; to soothe, as one in pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d977c9-bfec-4b01-b084-41083f6d7bc9",
                                                "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                                                "text": "The noise of the Queen's voyage to France is dilled down ; no money for her furniture will be got in haste; and the Cardinal has no will of her mother."
                                            },
                                            {
                                                "example_id": "aa278e7c-d5c2-48cb-9cf0-5d712b543b30",
                                                "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                                                "text": "The innocent was punished. The gear is payed and the thieves dilled down."
                                            },
                                            {
                                                "example_id": "5af8f5a4-070c-441a-8f24-c0a9bdb47ae6",
                                                "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                                                "text": "The Provincial Assembly sits down. Dr. Guild moderator. Dr. Scroggie preaches. His sermon found faulty. It dills down."
                                            },
                                            {
                                                "example_id": "36bbde29-b586-47fb-ae30-56b509554e42",
                                                "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                                                "text": "And there is nought to call them back, while these Curmudgeon generals dill down in their fear."
                                            },
                                            {
                                                "example_id": "de8250bf-3866-403a-95eb-ef0cacb9ef1e",
                                                "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                                                "text": "That now the dinn o' it wad soon dill down, An' but a story at the last be found."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49fa965d-a95b-378e-91f1-82265540b98c",
                                        "entry_id": "8487466f-2bbb-33bb-bc6a-c0051abf1935",
                                        "glosses": [
                                            "A fool."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a4b6c4-7c4d-4e2c-b463-c9c3864ae1c2",
                                                "sense_id": "49fa965d-a95b-378e-91f1-82265540b98c",
                                                "text": "He could go over and monster his way among the poms, but he was that drunk he'd probably only make a dill of himself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
