                ],
                "senses": [
                    {
                        "sense_id": "63c41369-11e8-34cb-ab3c-9094c1f1d683",
                        "entry_id": "e2968667-3910-3353-a77c-5a152bb9f7e5",
                        "glosses": [
                            "miejsce składowania i sprzedaży towarów w dużych ilościach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2584eb-f7ef-4800-83dd-e48ec5d5068d",
                                "sense_id": "63c41369-11e8-34cb-ab3c-9094c1f1d683",
                                "text": "Rok temu przed hurtownią, którą codziennie mijałem na rowerze, stał niepilnowany tir pełen arbuzów, które każdy mógł sobie zabrać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8130858e-a8d7-4a95-8e9e-22833965f174",
                        "source_entry_id": "e2968667-3910-3353-a77c-5a152bb9f7e5",
                        "source_sense_id": "63c41369-11e8-34cb-ab3c-9094c1f1d683",
                        "target_lang_word": "опто́вка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "опто́вка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "09f69c72-068c-39d4-8a9d-8170e17a7bf0",
                                        "entry_id": "9b147881-3294-3789-8cb9-915a07d07dfc",
                                        "glosses": [
                                            "разг. оптовый рынок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10f2fd0-d676-4862-81a4-bff07fd19b6a",
                                                "sense_id": "09f69c72-068c-39d4-8a9d-8170e17a7bf0",
                                                "text": "На Черкизовской оптовке я подхватил своего приятеля Илюху Зюзина (благо живёт он рядом) и начал закупки."
                                            },
                                            {
                                                "example_id": "28b5d919-9616-4814-bc3e-be9cd4dd756f",
                                                "sense_id": "09f69c72-068c-39d4-8a9d-8170e17a7bf0",
                                                "text": "У нас нет биржи нефтепродуктов, так что «оптовка» складывается непосредственно на нефтеперерабатывающих заводах."
                                            },
                                            {
                                                "example_id": "e81c1fe9-8d87-4e7d-a9b2-72cae8c82962",
                                                "sense_id": "09f69c72-068c-39d4-8a9d-8170e17a7bf0",
                                                "text": "В Урумчи пара мужских носков стоит на наши деньги 1 рубль, на оптовке Новосибирска — 8–10 руб."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
