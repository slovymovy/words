                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8993d80c-bbc2-495b-be29-bcef35600a40",
                        "entry_id": "d6f03539-0b33-399b-a935-471ebe11711c",
                        "tags": [
                            "plural",
