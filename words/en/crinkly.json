{
    "word_family": [
        "crinkle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47d474f2-3f19-329e-82c0-f1f98e812794",
                    "sense_definition": "Having many small folds or wrinkles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had a <w>crinkly</w> face that showed many years of smiling.",
                            "target_lang_translations": {
                                "zh": "那位老人有一张<w>皱巴巴的</w>脸，那是多年微笑留下的痕迹。"
                            }
                        },
                        {
                            "text": "She wrapped the gift in <w>crinkly</w> paper that made a loud noise.",
                            "target_lang_translations": {
                                "zh": "她用那种会发出响声的<w>有褶皱的</w>纸把礼物包了起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wrinkled"
                    ],
                    "common_phrases": [
                        "crinkly paper",
                        "crinkly skin"
                    ],
                    "target_lang_definitions": {
                        "zh": "指表面有很多细小褶皱或皱纹的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有褶皱的",
                                "target_lang_sense_clarification": "形容物体表面布满细小皱纹或折痕。"
                            },
                            {
                                "target_lang_word": "皱巴巴的",
                                "target_lang_sense_clarification": "形容物体或皮肤因折叠或老化而显得不平整。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00fb3d7b-9317-338c-876d-de565cf6709d",
                    "sense_definition": "Causing a sensation of shivering or tingling, often due to fear or excitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ghost story gave everyone a <w>crinkly</w> feeling in their spine.",
                            "target_lang_translations": {
                                "zh": "那个鬼故事让每个人的脊背都产生了一种<w>战栗的</w>感觉。"
                            }
                        },
                        {
                            "text": "A <w>crinkly</w> sensation ran down her back when she heard the strange noise.",
                            "target_lang_translations": {
                                "zh": "当她听到那个奇怪的声音时，背上掠过一阵<w>战栗的</w>感觉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crinkly feeling"
                    ],
                    "target_lang_definitions": {
                        "zh": "因恐惧或兴奋而产生的战栗或刺痛感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "战栗的",
                                "target_lang_sense_clarification": "形容因强烈情绪引起的身体发抖或发麻的感觉。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "395c4c7c-76d9-3a65-954a-b043db6db281",
                    "sense_definition": "An elderly person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenager joked about the <w>crinklies</w> walking slowly in the park.",
                            "target_lang_translations": {
                                "zh": "那个青少年开玩笑地谈论着公园里慢吞吞走路的<w>老家伙</w>们。"
                            }
                        },
                        {
                            "text": "He felt like one of the <w>crinklies</w> after working in the garden all day.",
                            "target_lang_translations": {
                                "zh": "在花园里干了一整天活后，他觉得自己就像个<w>老家伙</w>一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "old person"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in a disrespectful or humorous way."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指老年人（俚语，常含不敬或戏谑意味）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "老家伙",
                                "target_lang_sense_clarification": "对老年人的非正式称呼，带有戏谑或不尊重的色彩。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}