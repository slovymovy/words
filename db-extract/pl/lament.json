                ],
                "translations": [
                    {
                        "translation_id": "a63d6a58-b8de-4eaa-949c-1eb10f706deb",
                        "source_entry_id": "d5b11853-764d-3baf-84df-d21dfb74f01c",
                        "source_sense_id": "2cfd34eb-d905-3b60-91b0-1955965460d0",
                        "target_lang_word": "lament",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lament",
