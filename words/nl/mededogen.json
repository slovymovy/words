                        "onbarmhartigheid"
                    ],
                    "common_phrases": [
                        "met mededogen",
                        "mededogen tonen"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of deep sympathy and sorrow for another who is stricken by misfortune, accompanied by a strong desire to alleviate the suffering."
                    },
                    "translations": {
                        "en": [
                            {
