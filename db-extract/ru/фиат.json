                "senses": [
                    {
                        "sense_id": "96d60df5-364e-3b6f-b599-ab311017cd9d",
                        "entry_id": "bf493d34-df29-3b8b-a776-3f1268de5f09",
                        "glosses": [
                            "легковой автомобиль производства итальянской компании «Фиат»"
                        ],
                        "tags": [],
