                "senses": [
                    {
                        "sense_id": "fc8210c2-5aba-3db3-b4bc-51e5f60efd05",
                        "entry_id": "eef9b8b3-cf7e-345c-a37a-c0f70e667a96",
                        "glosses": [
                            "mit der Rückseite (dem Arsch) zuerst; nach hinten, von hinten; verkehrt herum"
                        ],
                        "tags": [
                            "bayrisch und österreichisch",
                            "sonst veraltet",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "9efb81e9-7ea0-4613-832e-03b7dcc7b01c",
                                "sense_id": "fc8210c2-5aba-3db3-b4bc-51e5f60efd05",
                                "text": "Es ist ganz schön schwierig, den riesigen Anhänger arschling in den Schuppen zu manövrieren."
                            },
                            {
                                "example_id": "e12e895b-2f82-4403-b3de-720296406e1b",
                                "sense_id": "fc8210c2-5aba-3db3-b4bc-51e5f60efd05",
                                "text": "Geh nicht immer arschling, du hast doch hinten keine Augen!"
                            },
                            {
                                "example_id": "777677f6-1fe9-4bbe-a4f2-bb825e665cbc",
                                "sense_id": "fc8210c2-5aba-3db3-b4bc-51e5f60efd05",
                                "text": "Beim Schlittschuhlaufen fiel Sepp arschling hin, so dass er zwei Wochen nicht schmerzfrei sitzen konnte."
                            },
                            {
                                "example_id": "d82914d3-fbd8-476b-af1e-8b4affbc69b6",
                                "sense_id": "fc8210c2-5aba-3db3-b4bc-51e5f60efd05",
                                "text": "„Wenn der Priester orate fratres sagt, sieht er die Hexen arschling in der Kirche stehen.“ [= mit dem Rücken zum Altar]"
                            },
                            {
                                "example_id": "40a90b60-45bb-4bf2-817c-5e3b7a0e0aef",
                                "sense_id": "fc8210c2-5aba-3db3-b4bc-51e5f60efd05",
                                "text": "Du hast deine Dirndlbluse ja arschling an. [= verkehrt herum, auf der linken Seite]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
