                "senses": [
                    {
                        "sense_id": "d4848b21-1f4d-326c-8f46-7a8e2c309fe5",
                        "entry_id": "49d6ff19-41bd-3558-b5a7-e7e9e056e70d",
                        "glosses": [
                            "recovery of sight"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6b72f9b3-e778-33ae-8db3-1c476f2e1bfe",
                        "entry_id": "49d6ff19-41bd-3558-b5a7-e7e9e056e70d",
                        "glosses": [
                            "enlightenment, insight, epiphany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c335ee-5176-42e1-bbc7-3e677293c7a7",
                                "sense_id": "6b72f9b3-e778-33ae-8db3-1c476f2e1bfe",
                                "text": "Дре́вний поэ́т сказа́л, что любо́е повествова́ние подо́бно тка́ни, растя́нутой на ле́звиях то́чных прозре́ний. И е́сли мои́ прозре́ния в о́ркскую ду́шу точны́ — а они́ точны́, — то в э́том не моя́ заслу́га.",
                                "translation": "An ancient poet once said that any narrative is like fabric stretched over the blades of several precise insights. If my insights into the Orkish soul are precise – and they are – the credit for that is not due to me.",
                                "english": "An ancient poet once said that any narrative is like fabric stretched over the blades of several precise insights. If my insights into the Orkish soul are precise – and they are – the credit for that is not due to me."
                            }
                        ]
                    }
                ],
