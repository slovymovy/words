                    {
                        "sense_id": "df9258c8-60cf-330e-ab5c-62b70aec26e8",
                        "entry_id": "a2d16d43-2d9a-3eed-a200-16f5824f43df",
                        "glosses": [
                            "Kombination aller zur Verfügung stehenden Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ebf0e9-793a-48af-80d1-fc07ec3c060a",
                                "sense_id": "df9258c8-60cf-330e-ab5c-62b70aec26e8",
                                "text": "Wenn die Datenlage es zulässt, wird eine weiterreichende Entscheidung getroffen werden können."
                            },
                            {
                                "example_id": "6e0a859e-c27a-44e6-9e0d-2a1bb19618e0",
                                "sense_id": "df9258c8-60cf-330e-ab5c-62b70aec26e8",
                                "text": "„Sie müssen die Menschen mitnehmen. Sie können keine Entscheidung rein nur auf Grund von Datenlagen machen.“"
                            },
                            {
                                "example_id": "b7b4b9b7-6491-47b0-a767-e501dd06a3ad",
                                "sense_id": "df9258c8-60cf-330e-ab5c-62b70aec26e8",
                                "text": "„Die Feststellung des Gesamtergebnisses dieser Gemeindewahlen ist gar nicht einfach, ist doch die Datenlage nicht eindeutig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
