{
    "word_family": [
        "zadel",
        "zadelen",
        "opzadeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09242691-41c0-3593-8152-1d0bbc2b8a30",
                    "sense_definition": "Iemand belasten met een vervelende taak, probleem of verantwoordelijkheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil je niet met mijn persoonlijke problemen <w>opzadelen</w>.",
                            "target_lang_translations": {
                                "en": "I don't want to <w>saddle</w> you with my personal problems."
                            }
                        },
                        {
                            "text": "De manager besloot zijn team met een onmogelijke taak <w>op</w> te <w>zadelen</w>.",
                            "target_lang_translations": {
                                "en": "The manager decided to <w>burden</w> his team with an impossible task."
                            }
                        }
                    ],
                    "synonyms": [
                        "belasten",
                        "opdringen",
                        "zadelen"
                    ],
                    "common_phrases": [
                        "met een taak opzadelen",
                        "met problemen opzadelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To burden someone with an unpleasant task, problem, or responsibility."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saddle with",
                                "target_lang_sense_clarification": "to burden someone with an unwanted responsibility or task"
                            },
                            {
                                "target_lang_word": "burden",
                                "target_lang_sense_clarification": "to load someone with a heavy duty or problem"
                            },
                            {
                                "target_lang_word": "lumber with",
                                "target_lang_sense_clarification": "to leave someone with an unwanted responsibility (informal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77e9a41e-ef58-334b-b42f-26d41bf66ebc",
                    "sense_definition": "Een paard voorzien van een zadel om erop te kunnen rijden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "paardrijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ruiter begon vroeg in de ochtend zijn paard <w>op</w> te <w>zadelen</w>.",
                            "target_lang_translations": {
                                "en": "The rider started to <w>saddle up</w> his horse early in the morning."
                            }
                        },
                        {
                            "text": "Voordat we kunnen vertrekken, moet je eerst het paard <w>opzadelen</w>.",
                            "target_lang_translations": {
                                "en": "Before we can leave, you must first <w>saddle</w> the horse."
                            }
                        }
                    ],
                    "synonyms": [
                        "zadelen"
                    ],
                    "common_phrases": [
                        "een paard opzadelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put a saddle on a horse in order to ride it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saddle up",
                                "target_lang_sense_clarification": "to put a saddle on a horse"
                            },
                            {
                                "target_lang_word": "saddle",
                                "target_lang_sense_clarification": "to equip a horse with a saddle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}