                                "target_senses": [
                                    {
                                        "sense_id": "6a93b361-a75d-3210-bd07-f1100ac0a7bd",
                                        "entry_id": "29021feb-c491-3254-82b9-62f3dcaf55af",
                                        "glosses": [
                                            "Lehre vom Schall, Lehre von den Tönen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923da5d0-7b75-4827-b70a-ec56b78bdcf3",
                                                "sense_id": "6a93b361-a75d-3210-bd07-f1100ac0a7bd",
                                                "text": "„Zu den wichtigsten Anwendungen der Akustik gehört neben der Erforschung und Minderung von Lärm auch das Bemühen, einen Wohlklang hervorzurufen oder eine akustische Information zu übertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dc75b3d-2541-333e-8c35-256aa5d874ac",
                                        "entry_id": "29021feb-c491-3254-82b9-62f3dcaf55af",
                                        "glosses": [
                                            "Eigenschaft eines Raums, die beschreibt, wie gut sich Klänge in ihm ausbreiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2dd5cc-bda4-4d6f-b113-ebb374363cd9",
                                                "sense_id": "9dc75b3d-2541-333e-8c35-256aa5d874ac",
                                                "text": "Der Konzertsaal bietet eine gute Akustik."
                                            },
                                            {
                                                "example_id": "30e3de17-8397-4b37-8cfc-7078ba4c3a92",
                                                "sense_id": "9dc75b3d-2541-333e-8c35-256aa5d874ac",
                                                "text": "„Bei der trefflichen Akustik der Kirche kommt sowohl Gesang, als auch die von Gebr. Jehmlich in Dresden erbaute Orgel sehr zur Geltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
