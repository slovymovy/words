            {
                "entry_id": "65406504-ea23-3754-808e-1b778eefe9a9",
                "word": "partitif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76769836-e976-4d03-b16f-2d89b60a158d",
                        "entry_id": "65406504-ea23-3754-808e-1b778eefe9a9",
                        "tags": [
                            "plural"
                        ],
                        "form": "partitifs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc606084-64b0-33fb-bdad-d950683c10d8",
                        "entry_id": "65406504-ea23-3754-808e-1b778eefe9a9",
                        "glosses": [
                            "Cas grammatical qui exprime la partie d’un tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9732bfd-a6f1-48b4-b9a4-07b7e639a84c",
                                "sense_id": "fc606084-64b0-33fb-bdad-d950683c10d8",
                                "text": "Tout comme le N bouquet dénote plusieurs fleurs, le N mobilier dénote plusieurs meubles; Mais mobilier, vaisselle, argenterie ne visent pas des totalités closes. Sauf contexte particulier, ces N ne s’emploient pas précédés d'un déterminant de la discontinuité (? j’ai acheté un mobilier); Il est nécessaire d’ajouter un complément (j’ai acheté un mobilier tout neuf). En revanche, le partitif est toujours possible (j’ai acheté du mobilier tout neuf)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d60edd7-600f-4679-bc80-d705ea298bd5",
                        "source_entry_id": "65406504-ea23-3754-808e-1b778eefe9a9",
                        "source_sense_id": "fc606084-64b0-33fb-bdad-d950683c10d8",
                        "target_lang_word": "Partitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Partitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0cfec25-d685-37ac-a5f0-9e08615850ac",
                                        "entry_id": "e37efe95-48fb-3578-aa61-b2874e33c9eb",
                                        "glosses": [
                                            "grammatischer Fall (Kasus), der nicht im Deutschen, aber in vielen anderen Sprachen (beispielsweise im Finnischen) vorkommt und einen Teil von etwas bezeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be56b64b-0cc1-45cb-af97-76541964a272",
                                                "sense_id": "c0cfec25-d685-37ac-a5f0-9e08615850ac",
                                                "text": "„Der Partitiv bezeichnet den Teil eines Ganzen oder eine unbestimmte Menge… Bei Stoffnamen entspricht dem Partitiv des Finnischen die artikellose Form des Substantivs im Deutschen.“"
                                            },
                                            {
                                                "example_id": "c359b40b-a2ae-432d-8256-be092b71115e",
                                                "sense_id": "c0cfec25-d685-37ac-a5f0-9e08615850ac",
                                                "text": "„Aber zurück zum Partitiv - dem zweifellos wichtigsten und tiefsten Fall des Finnischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
