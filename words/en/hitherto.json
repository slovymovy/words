    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                    "sense_definition": "Up to the present time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has <w>hitherto</w> been very successful in all its international business ventures.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf is <w>tot nu toe</w> zeer succesvol geweest in al zijn internationale zakelijke ondernemingen.",
                                "ru": "Компания <w>до сих пор</w> была весьма успешна во всех своих международных деловых начинаниях."
                            }
                        },
                        {
                            "text": "Many details of the project have <w>hitherto</w> remained unknown to the general public.",
                            "target_lang_translations": {
                                "nl": "Veel details van het project zijn <w>tot dusver</w> onbekend gebleven voor het grote publiek.",
                                "ru": "Многие подробности проекта <w>доныне</w> оставались неизвестными широкой публике."
                            }
                        }
                    ],
                    "synonyms": [
                        "heretofore",
                        "so far",
                        "to date",
                        "up to now"
                    ],
                    "antonyms": [
                        "henceforth"
                    ],
                    "common_phrases": [
                        "hitherto unknown",
                        "hitherto unrecognized"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formal and literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tot op het huidige moment.",
                        "ru": "До настоящего времени, до сих пор."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tot nu toe",
                                "target_lang_sense_clarification": "meest gebruikelijke uitdrukking voor 'tot op dit moment'"
                            },
                            {
                                "target_lang_word": "tot dusver",
                                "target_lang_sense_clarification": "formeel alternatief voor 'tot nu toe'"
                            },
                            {
                                "target_lang_word": "tot hiertoe",
                                "target_lang_sense_clarification": "literair of formeel gebruik"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "до сих пор",
                                "target_lang_sense_clarification": "наиболее частотное соответствие для 'до настоящего времени'"
                            },
                            {
                                "target_lang_word": "доныне",
                                "target_lang_sense_clarification": "книжное или возвышенное выражение"
                            },
                            {
                                "target_lang_word": "по сей день",
                                "target_lang_sense_clarification": "стилистически возвышенное 'вплоть до сегодняшнего дня'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f3f3456-be50-32b1-bd64-515bb7d916ff",
                    "sense_definition": "Up to this point in a text or discussion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everything I have <w>hitherto</w> explained is essential for understanding the next chapter.",
                            "target_lang_translations": {
                                "nl": "Alles wat ik <w>tot dusver</w> heb uitgelegd is essentieel voor het begrijpen van het volgende hoofdstuk.",
                                "ru": "Всё, что я объяснил <w>до сих пор</w>, крайне важно для понимания следующей главы."
                            }
                        },
                        {
                            "text": "The arguments <w>hitherto</w> presented do not fully support the author's main conclusion.",
                            "target_lang_translations": {
                                "nl": "De argumenten die <w>tot dusver</w> zijn gepresenteerd ondersteunen de hoofdconclusie van de auteur niet volledig.",
                                "ru": "Аргументы, представленные <w>ранее</w>, не вполне подтверждают главный вывод автора."
                            }
                        }
                    ],
                    "synonyms": [
                        "thus far"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formal and literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tot op dit punt in een tekst of discussie.",
                        "ru": "До этого места в тексте или рассуждении."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tot dusver",
                                "target_lang_sense_clarification": "verwijzend naar wat eerder in de tekst is besproken"
                            },
                            {
                                "target_lang_word": "tot dan toe",
                                "target_lang_sense_clarification": "verwijzend naar een specifiek punt in het verleden"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "до сих пор",
                                "target_lang_sense_clarification": "до этого момента в изложении или речи"
                            },
                            {
                                "target_lang_word": "до настоящего момента",
                                "target_lang_sense_clarification": "о ходе аргументации или изложения"
                            },
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "в значении 'до этого места в тексте'"
                            }
                        ]
                    }
                }
            ]
        }
