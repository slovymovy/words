                "translations": [
                    {
                        "translation_id": "1ba52e91-368c-4121-be3c-8b9b2a5530ee",
                        "source_entry_id": "9a227762-0049-351b-9bb1-069451c0f525",
                        "source_sense_id": "9826d1dd-4085-3eff-b7a6-5a3323f9ca6f",
