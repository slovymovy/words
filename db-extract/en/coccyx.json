                                        "entry_id": "3de9c684-f413-3cbf-a0eb-9cd8f5a1b4db",
                                        "glosses": [
                                            "malá trojúhelníkovitá kost, tvořící zakončení páteře"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb3b0be-73ad-4ed4-a91e-e8f44fde894f",
                                                "sense_id": "a16dddd2-7157-3fc4-811f-d5ce03c70884",
                                                "text": "Já byl zase bekem, jako před patnácti nebo dvaceti lety; a zrovna když jsem chytal břichem míč, kopl mne můj vlastní brankář do — hm, ono se tomu říká kostrč čili cauda equina."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
