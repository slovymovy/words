                    {
                        "sense_id": "8ef6ad6b-b948-3282-968f-440b57652384",
                        "entry_id": "73933210-7943-37fc-a2ee-3946c8bdb8b4",
                        "glosses": [
                            "mit fünfzig vervielfacht; zehnmal und vierzig weitere Male; fünfzigfach vorgekommen, durchgeführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb45910-6cef-459b-81df-cac6a17c0556",
                                "sense_id": "8ef6ad6b-b948-3282-968f-440b57652384",
                                "text": "„Erst in den 1840ern wurde die Rossrobbe entdeckt. In den folgenden 100 Jahren wurde sie wohl nicht öfter als fünfzigmal von Menschen gesichtet.“"
                            },
                            {
                                "example_id": "f9377680-14d4-4961-94c7-9bca88c0b689",
                                "sense_id": "8ef6ad6b-b948-3282-968f-440b57652384",
                                "text": "„Stahl wird fast fünfzigmal mehr hergestellt als Aluminium, das in der Weltproduktion den zweiten Platz einnimmt.“"
                            },
                            {
                                "example_id": "15cc2962-a951-4e2a-9733-e9321b9568ae",
                                "sense_id": "8ef6ad6b-b948-3282-968f-440b57652384",
                                "text": "„Mit Ausnahme der Keimzellen haben alle normalen Zellen eines Organismus eine beschränktes Fortpflanzungspotential, das heißt, sie können sich maximal etwa fünfzigmal teilen[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
