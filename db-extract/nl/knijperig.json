                        "translation_id": "a3ded04c-65c6-4ca8-a816-828990d48454",
                        "source_entry_id": "5351313e-53c4-317b-a850-c5359197d372",
                        "source_sense_id": "7bf00ddb-4d25-3c42-8518-471a1a5d0ced",
                        "source_sense_description": "al te zuinig",
                        "target_lang_word": "pinchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca2320b4-eaa7-3d88-b19d-0c7fca712630",
                                        "entry_id": "f587de58-f6c1-3834-b31d-8631231f2274",
                                        "glosses": [
                                            "slightly painful, akin to being pinched"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f69294e-e8cc-4fbf-9f3f-9cc975e2f885",
                                                "sense_id": "ca2320b4-eaa7-3d88-b19d-0c7fca712630",
                                                "text": "I pushed my cropped hair up and away from the back of my neck where it was pinchy and itching."
                                            },
                                            {
                                                "example_id": "40ea8028-d38f-4f23-a9ea-fd6b7b2a1577",
                                                "sense_id": "ca2320b4-eaa7-3d88-b19d-0c7fca712630",
                                                "text": "It's a rare treat in these days when anyone can truck in a case of trendy flavors, set out a few pinchy wire chairs and call the whole sterile spread an ice cream parlor."
                                            },
                                            {
                                                "example_id": "41baa984-ae94-4e15-84d3-3580fdbc590f",
                                                "sense_id": "ca2320b4-eaa7-3d88-b19d-0c7fca712630",
                                                "text": "I can't keep still. I feel like I'm caught in a trap — my tight corset and pinchy shoes don't help."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6447c2-2aad-3035-9e99-2e68484a0e37",
                                        "entry_id": "f587de58-f6c1-3834-b31d-8631231f2274",
                                        "glosses": [
                                            "prone or designed to pinch"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5511b1d1-3c3f-4bd6-ac47-268259c344d2",
                                                "sense_id": "1a6447c2-2aad-3035-9e99-2e68484a0e37",
                                                "text": "“I don't understand this whatchamacallit. The way it wraps all the way around. Wouldn't it be simpler if it went straight up? Hey, hand me that pinchy thing with the zapper on one end."
                                            },
                                            {
                                                "example_id": "0ccb3b98-a99c-4785-a17f-62a74619ae9a",
                                                "sense_id": "1a6447c2-2aad-3035-9e99-2e68484a0e37",
                                                "text": "A skittery, pinchy thing ran sideways in front of Roy. It had plenty of legs. “Are you a horse?” he asked. “A horse? I'll pinch you good! A horse is friendly. I'm a crab!” said the crab."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
