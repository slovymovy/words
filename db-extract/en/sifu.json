                    {
                        "translation_id": "869a42a4-f91c-48d5-a2e3-b074bea48e3e",
                        "source_entry_id": "dcf3d652-0347-3e03-9611-cc0ea52e981b",
                        "source_sense_description": "martial arts instructor",
                        "target_lang_word": "先生",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "先生",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "e8fcfb41-9ec3-332f-a814-7582c2087230",
                                        "entry_id": "010c24eb-ca79-3a22-9b34-edbbfabb1f72",
                                        "glosses": [
                                            "（原義）先に生まれた人。"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd9d7cd4-4f89-3f36-b305-2964447181e1",
                                        "entry_id": "010c24eb-ca79-3a22-9b34-edbbfabb1f72",
                                        "glosses": [
                                            "学問や芸能を教える人。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d2dd4b9-2255-3b5e-b287-883c0f823bd2",
                                        "entry_id": "010c24eb-ca79-3a22-9b34-edbbfabb1f72",
                                        "glosses": [
                                            "教師及び教育関係者（の名）を呼ぶときの敬称。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccedb649-2702-4ab6-9a82-d3108e65e597",
                                                "sense_id": "6d2dd4b9-2255-3b5e-b287-883c0f823bd2",
                                                "text": "教授、准教授、助手、講師、教諭、保育士"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "543ca26b-4ab8-3bad-b504-72196c3066be",
                                        "entry_id": "010c24eb-ca79-3a22-9b34-edbbfabb1f72",
                                        "glosses": [
                                            "（尊敬すべき職業についている）人を呼ぶときの敬称。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1478354b-edb5-404f-aa86-f206ce60f5aa",
                                                "sense_id": "543ca26b-4ab8-3bad-b504-72196c3066be",
                                                "text": "政治家、弁護士、会計士、医師、作家、棋士など、多くは自営の知的職業。"
                                            },
                                            {
                                                "example_id": "35a5670d-ac96-4066-a44a-436e0f59ac7c",
                                                "sense_id": "543ca26b-4ab8-3bad-b504-72196c3066be",
                                                "text": "講演会の演者は「先生」と呼ばれることが多い。"
                                            },
                                            {
                                                "example_id": "374068c3-414e-42ac-b5cc-113727bc760d",
                                                "sense_id": "543ca26b-4ab8-3bad-b504-72196c3066be",
                                                "text": "水商売や暴力団の関係者などが警察官や検察官を「先生」と呼ぶことがある。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f085c55a-16c5-32c5-8e65-adff4e1155f9",
                                        "entry_id": "010c24eb-ca79-3a22-9b34-edbbfabb1f72",
                                        "glosses": [
                                            "（諧謔的）人。御仁。傑物。大将。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2c5f8a-c557-427e-bb08-d2339fa4845f",
                                                "sense_id": "f085c55a-16c5-32c5-8e65-adff4e1155f9",
                                                "text": "思うに、この先生は、ほかの泥棒のように、セッパつまった稼ぎ方はしていなかったのである。主として芸者をつれて豪遊し、そうすることによって容疑をまぬがれ、当分の遊興費には事欠かないが、ちょッとまア、食後の運動に、趣味を行う、という程度の余裕綽々たるものであった。（中略）彼が捕えられて伊東署へ留置されると、芸者、料理屋、置屋などからゴッソリ差入れがあった。ところがこの先生、山とつまれた凄い御馳走には目もくれず、ハンストをやりだしたのである。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4f2fbd-74b1-34fe-baea-63730442ad2a",
                                        "entry_id": "010c24eb-ca79-3a22-9b34-edbbfabb1f72",
                                        "glosses": [
                                            "前生。前世。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
