                        "entry_id": "596e8d65-54cf-3723-a7a6-376a327f2e02",
                        "glosses": [
                            "bewegliche Puppe, die besonders dazu verwendet wird, bestimmte (menschliche) Körperhaltungen zu veranschaulichen und zu studieren (Kunst, Medizin, Sport)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f927be59-c811-485e-b983-367e008c152c",
                                "sense_id": "19882da5-69b3-3749-9f47-f0be382c4882",
                                "text": "„Kurz darauf entdeckte er im Kaiser-Friedrich-Museum die beweglichen altdeutschen Gliederpuppen, die einst Dürer als Modelle gedient hatten.“"
                            },
                            {
                                "example_id": "085c06a9-c5ca-4ea6-b390-38d4b51a4c1a",
                                "sense_id": "19882da5-69b3-3749-9f47-f0be382c4882",
                                "text": "„Als der Deckel aufgestemmt war, fiel das Stroh beiseite, Seidenpapier glitt herab, und die Gliederpuppe erschien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
