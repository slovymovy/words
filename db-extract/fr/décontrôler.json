                                "example_id": "fa097d6a-4f70-4b55-a9b0-d8e09781f60f",
                                "sense_id": "c2d81a6e-1015-3f05-a47b-6db34cb24cb0",
                                "text": "Voilà l'interprétation que j'en fais : j'ai une fâcheuse tendance à décontrôler en synchronicité avec ce qui advient."
                            },
                            {
                                "example_id": "199cfd8a-c761-4014-87fa-e328fd9c9fed",
                                "sense_id": "c2d81a6e-1015-3f05-a47b-6db34cb24cb0",
                                "text": "Cependant, il n'est pas possible de décontrôler l'exportation de ces produits car le règlement européen no 1334/2000 du 22 juin 2000 s'y oppose."
                            }
                        ]
