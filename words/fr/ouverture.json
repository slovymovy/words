{
    "word_family": [
        "ouvertement",
        "ouvreur",
        "ouvreuse",
        "ouvrir",
        "réouverture"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c57d0d5e-ac05-39ad-a2a4-b75134708cb5",
                    "sense_definition": "Action de rendre accessible ou disponible ce qui était clos ou inaccessible.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>ouverture</w> du magasin est prévue tous les matins à huit heures précises."
                        },
                        {
                            "text": "Le client a demandé l'<w>ouverture</w> d'un nouveau compte bancaire."
                        }
                    ],
                    "antonyms": [
                        "fermeture"
                    ],
                    "common_phrases": [
                        "heures d'ouverture",
                        "ouverture d'un compte"
                    ]
                },
                {
                    "sense_id": "319335e4-ef4c-3cbd-9be7-28575fd3f995",
                    "sense_definition": "Espace libre, trou ou passage pratiqué dans un mur, un obstacle ou un récipient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat s'est faufilé discrètement par une petite <w>ouverture</w> dans le grillage."
                        },
                        {
                            "text": "Les architectes ont prévu plusieurs grandes <w>ouvertures</w> pour faire entrer la lumière naturelle."
                        }
                    ],
                    "synonyms": [
                        "trou",
                        "baie",
                        "passage"
                    ],
                    "common_phrases": [
                        "petite ouverture"
                    ]
                },
                {
                    "sense_id": "b428275c-0201-3799-ba2f-51639f3f2ec3",
                    "sense_definition": "Commencement ou inauguration solennelle d'un événement, d'une période ou d'une assemblée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "debut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons assisté hier soir à la cérémonie d'<w>ouverture</w> du festival international de cinéma."
                        },
                        {
                            "text": "Le maire a prononcé un long discours d'<w>ouverture</w> devant tous les délégués réunis."
                        }
                    ],
                    "synonyms": [
                        "début",
                        "commencement",
                        "inauguration"
                    ],
                    "antonyms": [
                        "fermeture"
                    ],
                    "common_phrases": [
                        "cérémonie d'ouverture",
                        "discours d'ouverture"
                    ]
                },
                {
                    "sense_id": "db5a9e7b-cda5-3d99-8af3-9d82c95105ec",
                    "sense_definition": "Disposition morale ou intellectuelle à écouter autrui, à accepter des idées nouvelles ou d'autres cultures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son incroyable <w>ouverture</w> d'esprit lui permet de comprendre facilement les points de vue différents."
                        },
                        {
                            "text": "Cette formation exige une grande <w>ouverture</w> aux cultures étrangères et au dialogue."
                        }
                    ],
                    "synonyms": [
                        "tolérance",
                        "réceptivité"
                    ],
                    "common_phrases": [
                        "ouverture d'esprit"
                    ]
                },
                {
                    "sense_id": "b6787767-3270-3dd4-9031-dd025c316f53",
                    "sense_definition": "Pièce orchestrale qui introduit un opéra, un ballet ou une suite symphonique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orchestre a commencé la soirée en interprétant une célèbre <w>ouverture</w> de Mozart."
                        },
                        {
                            "text": "Le public a chaleureusement applaudi l'<w>ouverture</w> avant même l'entrée des chanteurs."
                        }
                    ],
                    "synonyms": [
                        "prélude"
                    ],
                    "common_phrases": [
                        "ouverture d'opéra"
                    ]
                },
                {
                    "sense_id": "bc79d108-60e2-384f-841b-35aa6b9c9c93",
                    "sense_definition": "Opportunité favorable ou moment propice permettant d'engager une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opportunite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attaquant a profité d'une <w>ouverture</w> dans la défense adverse pour marquer un but magnifique."
                        },
                        {
                            "text": "Le jeune diplômé cherche une <w>ouverture</w> sur le marché du travail international."
                        }
                    ],
                    "synonyms": [
                        "opportunité",
                        "occasion"
                    ],
                    "common_phrases": [
                        "chercher une ouverture"
                    ]
                },
                {
                    "sense_id": "7057b9d9-778d-3ef3-bbd7-91b472a225fe",
                    "sense_definition": "Premières propositions faites à une partie adverse pour engager des négociations ou un accord.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negociation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les médiateurs ont finalement fait des <w>ouvertures</w> pour tenter de rétablir un dialogue de paix."
                        },
                        {
                            "text": "Le ministre s'est montré très attentif aux <w>ouvertures</w> formulées par l'opposition."
                        }
                    ],
                    "synonyms": [
                        "proposition",
                        "avance"
                    ],
                    "common_phrases": [
                        "faire des ouvertures"
                    ]
                },
                {
                    "sense_id": "36a032da-2c52-3df5-9a95-91709cc98c6c",
                    "sense_definition": "Suite des premiers coups joués dans une partie de jeu de société stratégique, en particulier aux échecs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand maître étudie chaque matin une nouvelle <w>ouverture</w> pour surprendre ses adversaires."
                        },
                        {
                            "text": "Son choix d'<w>ouverture</w> avec les pièces blanches a complètement désorienté son adversaire."
                        }
                    ],
                    "common_phrases": [
                        "ouverture italienne"
                    ]
                },
                {
                    "sense_id": "0ff68cc8-fa2e-3733-aac3-67e16e14535e",
                    "sense_definition": "Diamètre utile du diaphragme d'un instrument d'optique régulant l'entrée de la lumière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe a sélectionné une grande <w>ouverture</w> pour réduire nettement la profondeur de champ."
                        },
                        {
                            "text": "Cette lunette astronomique offre une <w>ouverture</w> remarquable pour observer les étoiles peu lumineuses."
                        }
                    ],
                    "synonyms": [
                        "diaphragme"
                    ],
                    "common_phrases": [
                        "grande ouverture"
                    ]
                }
            ]
        }
    ]
}