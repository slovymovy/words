                    "sense_definition": "Relatif aux foires et aux fêtes foraines.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "foire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque été, une grande fête <w>foraine</w> s'installe sur la place principale."
                        },
                        {
                            "text": "Les enfants aiment beaucoup les attractions <w>foraines</w> et les stands de tir."
                        }
                    ],
                    "common_phrases": [
                        "fête foraine",
                        "art forain",
                        "attraction foraine"
                    ]
                },
                {
                    "sense_id": "6ada20d9-de4f-3675-af70-9d69a3e3abe2",
                    "sense_definition": "Qui n'est pas du lieu, qui vient du dehors ; étranger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exterieur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce document ancien mentionne l'arrivée d'un commerçant <w>forain</w> dans la ville."
                        },
                        {
                            "text": "Le juge a ordonné une saisie <w>foraine</w> contre ce débiteur de passage."
                        }
                    ],
                    "common_phrases": [
                        "marchand forain",
                        "saisie foraine"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Vieilli en dehors de certaines formules juridiques"
