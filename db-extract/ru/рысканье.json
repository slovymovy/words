                ],
                "translations": [
                    {
                        "translation_id": "fa948571-9f16-4c04-87a9-ea455b13d56e",
                        "source_entry_id": "45d58f6a-6f09-367e-948a-f77d2f17e474",
                        "source_sense_description": "отклонение от курса",
                        "target_lang_word": "hunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3444f1f-72b0-350a-bce0-dd0ff6f7d3fa",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To find or search for an animal in the wild with the intention of killing the animal for its meat or for sport."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7a1660-5328-4c3c-a818-3feaff78c6e4",
                                                "sense_id": "f3444f1f-72b0-350a-bce0-dd0ff6f7d3fa",
                                                "text": "State Wildlife Management areas often offer licensed hunters the opportunity to hunt on public lands."
                                            },
                                            {
                                                "example_id": "354053ee-bdd4-4f93-938a-c94eaac41fd4",
                                                "sense_id": "f3444f1f-72b0-350a-bce0-dd0ff6f7d3fa",
                                                "text": "Her uncle will go out and hunt for deer, now that it is open season."
                                            },
                                            {
                                                "example_id": "059d5fb3-bf2e-4488-ba67-d3f3f7b06e61",
                                                "sense_id": "f3444f1f-72b0-350a-bce0-dd0ff6f7d3fa",
                                                "text": "Like a dog, he hunts in dreams, and thou art staring at the wall, / Where the dying night-lamp flickers, and the shadows rise and fall."
                                            },
                                            {
                                                "example_id": "31448b06-f872-4241-b978-e103fe085854",
                                                "sense_id": "f3444f1f-72b0-350a-bce0-dd0ff6f7d3fa",
                                                "text": "Either the bird will be downgraded to \"threatened\" status — which means it can be hunted — or it will be declared a nonspecies, as has already happened to all its taxonomic kissing cousins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To try to find something; search (for)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "832d60e8-f7e2-429b-b946-217c604668a7",
                                                "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                                "text": "The little girl was hunting for shells on the beach."
                                            },
                                            {
                                                "example_id": "b5b1c067-67ea-413b-9b77-ba66ceeedf59",
                                                "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                                "text": "The police are hunting for evidence."
                                            },
                                            {
                                                "example_id": "5f6d305b-e276-4758-960b-6f245733855d",
                                                "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                                "text": "He after honour hunts, I after love."
                                            },
                                            {
                                                "example_id": "6113c976-623b-4342-86b5-a033ddda5e27",
                                                "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "5232d14c-bffc-4cd1-bf88-55d4cf5e3451",
                                                "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                                "text": "My idea of retirement was to hunt seashells, play golf, and do a lot of walking."
                                            },
                                            {
                                                "example_id": "059c29c8-8ab2-4ce8-8484-41538489147a",
                                                "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                                                "text": "What kind of woman came to an island and stayed there through a violent storm and then got up the next morning to hunt seashells? She had fine, delicate features with high cheekbones and the greenest eyes he'd ever seen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88e33bd-b504-31e6-af81-ddd9e5e481f9",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To drive; to chase; with down, from, away, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158ee961-e47b-4984-8d51-7962ea814839",
                                                "sense_id": "a88e33bd-b504-31e6-af81-ddd9e5e481f9",
                                                "text": "to hunt down a criminal"
                                            },
                                            {
                                                "example_id": "1f8bfd2c-8764-4d66-9e11-3aa78cde5afb",
                                                "sense_id": "a88e33bd-b504-31e6-af81-ddd9e5e481f9",
                                                "text": "He was hunted from the parish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd3fc6d-76ac-36ea-b71a-907ef5e4d8cb",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To use or manage (dogs, horses, etc.) in hunting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c4e861-e0b0-4b19-abe6-140432333405",
                                                "sense_id": "0fd3fc6d-76ac-36ea-b71a-907ef5e4d8cb",
                                                "text": "Did you hunt that pony last week?"
                                            },
                                            {
                                                "example_id": "05e8f79a-e760-421f-9b5d-00d2959a14f4",
                                                "sense_id": "0fd3fc6d-76ac-36ea-b71a-907ef5e4d8cb",
                                                "text": "He hunts a pack of dogs better than any man in the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d29c365c-2378-3fb3-bc70-41242cc1084c",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To use or traverse in pursuit of game."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0e5776-4f29-436a-8b87-866c0b81c30f",
                                                "sense_id": "d29c365c-2378-3fb3-bc70-41242cc1084c",
                                                "text": "He hunts the woods, or the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a13bf045-5865-35f0-8a44-5f9fd009a59b",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To move or shift the order of (a bell) in a regular course of changes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db870e23-2a77-386a-942d-47a8bcb54cd6",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To shift up and down in order regularly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b77ce287-513b-3f1a-bfd7-5a3bd901c79a",
                                        "entry_id": "0020cabb-4e7b-3691-8741-446daddc6827",
                                        "glosses": [
                                            "To be in a state of instability of movement or forced oscillation, as a governor which has a large movement of the balls for small change of load, an arc-lamp clutch mechanism which moves rapidly up and down with variations of current, etc.; also, to seesaw, as a pair of alternators working in parallel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b2e7f2-58a2-4dab-8e39-2fd4d140219e",
                                                "sense_id": "b77ce287-513b-3f1a-bfd7-5a3bd901c79a",
                                                "text": "[…] after which the inertia of the camera causes the motor to hunt with fluctuating speed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92e4898d-4aeb-3ddd-843b-dc288d5f5bb2",
                                        "entry_id": "a4774459-c6fd-3d0e-a3bb-a69d9189a358",
                                        "glosses": [
                                            "The act of hunting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a8d51e-6ef6-4abf-910f-08602baac0ba",
                                                "sense_id": "92e4898d-4aeb-3ddd-843b-dc288d5f5bb2",
                                                "text": "Through male bonding, the subculture of the hunt caught up in the mystique of the chase, the hunting party became a military force, and men discovered that they need not stop at defense: they could go out to hunt for other people's wealth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf2c07b-284d-38a2-a171-b964a0c1a949",
                                        "entry_id": "a4774459-c6fd-3d0e-a3bb-a69d9189a358",
                                        "glosses": [
                                            "A hunting expedition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b6ba41e-7265-3450-b4f4-12033dfa7133",
                                        "entry_id": "a4774459-c6fd-3d0e-a3bb-a69d9189a358",
                                        "glosses": [
                                            "An organization devoted to hunting, or the people belonging to it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4d49f28-129a-3405-9437-a9c877e5f75c",
                                        "entry_id": "a4774459-c6fd-3d0e-a3bb-a69d9189a358",
                                        "glosses": [
                                            "A pack of hunting dogs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d50185c-46b8-4aac-ba39-69c0a9ab0613",
                        "source_entry_id": "45d58f6a-6f09-367e-948a-f77d2f17e474",
