                "senses": [
                    {
                        "sense_id": "d6f732ce-d78b-3355-a0e1-81b0ce7c7388",
                        "entry_id": "a0e19467-0ca1-30ff-9386-b1020925b672",
                        "glosses": [
                            "eiland waarop een schat is begraven (door zeerovers)"
                        ],
                        "tags": [
                            "onbewoond"
                        ],
                        "examples": [
                            {
                                "example_id": "5c43e1e4-90c9-40c7-bde3-f12bbd34b830",
                                "sense_id": "d6f732ce-d78b-3355-a0e1-81b0ce7c7388",
                                "text": "Die zeelui in Schateiland leken niet op elkaar, hè? Maar ja, dat waren geen gewone zeelui."
                            },
                            {
                                "example_id": "3894b716-acaf-4411-85b7-12278fc4be49",
                                "sense_id": "d6f732ce-d78b-3355-a0e1-81b0ce7c7388",
                                "text": "Een Britse ontdekkingsreiziger gaat een tripje maken naar Schateiland. Althans, dat moet het eiland zijn. Het gaat om Cocoseiland, niet ver van Costa Rica; een onbewoond eiland. Piraten in de 19e eeuw zouden daar een enorme schat verborgen hebben, gestolen van de Spanjaarden."
                            },
                            {
                                "example_id": "3c74ec71-6593-4f02-ac1a-e66b3926dce2",
                                "sense_id": "d6f732ce-d78b-3355-a0e1-81b0ce7c7388",
                                "text": "Na Kidds dood ging het verhaal dat hij het grootste deel van zijn buit had verstopt. De legende van Captain Kidd komt onder meer voor in de beroemde roman Schateiland (Treasure Island) van Robert Louis Stevenson."
                            }
                        ]
                    }
