            "senses": [
                {
                    "sense_id": "4958367d-e8e6-3a45-b0c8-67a276660b4e",
                    "sense_definition": "Prédiction des événements futurs sous l'effet d'une inspiration divine ou surnaturelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple attendait avec ferveur l'accomplissement de cette ancienne <w>prophétie</w>."
                        },
                        {
                            "text": "L'ermite affirmait avoir reçu une <w>prophétie</w> directement dans ses songes."
                        }
                    ],
                    "synonyms": [
                        "oracle",
                        "révélation",
                        "vaticination"
                    ],
                    "common_phrases": [
