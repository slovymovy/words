                "senses": [
                    {
                        "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                        "entry_id": "9860a2fe-3fed-387a-8b46-78a1e30429ca",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9435ae1-0c60-49a8-a849-5a1f31eaa3fd",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Frau Eisenhower ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7a39149f-1924-4a7b-8da5-730acbc4c579",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Herr Eisenhower wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "12277f53-abdb-4779-b153-94eb254f3eac",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Die Eisenhowers fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "9eb5067e-325d-4144-834d-04de01ffd897",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Der Eisenhower trägt nie die Pullover, die die Eisenhower ihm strickt."
                            },
                            {
                                "example_id": "ba37ac49-faeb-4321-ae4c-73a3d777d45c",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisenhower kommt, geht der Herr Eisenhower.“"
                            },
                            {
                                "example_id": "cf210e07-230f-4b81-b843-fca7cb41f5ed",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Eisenhower kommt und geht."
                            },
                            {
                                "example_id": "201c75f3-15c6-4ecd-8e10-869c6ccc7f63",
                                "sense_id": "39a1226e-c889-3219-8536-2a82559ec7cf",
                                "text": "Eisenhowers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
