                ],
                "senses": [
                    {
                        "sense_id": "58e69eca-89a2-35b3-921a-74673f9a8824",
                        "entry_id": "2aa57f1f-7459-3822-af83-48feabe00001",
                        "glosses": [
                            "stürmischer Nordwind oder Nordostwind; Aquilo, Nordwind, Nordostwind"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "8dab1f0c-8fdc-49e0-800d-f9a8591fbf58",
                                "sense_id": "58e69eca-89a2-35b3-921a-74673f9a8824",
                                "text": "„Bóg mrozy w pomoc nam zeszle! Ciężko będzie baterye sypać, podkopy czynić i przytem wy będziecie się do ciepłych izb luzować, a im akwilony zbrzydzą prędko oblężenie!“"
                            },
                            {
                                "example_id": "fe67103c-ed9d-4dbe-8dce-5c5e2865534e",
                                "sense_id": "58e69eca-89a2-35b3-921a-74673f9a8824",
                                "text": "„Zefiry, akwilony i zwyczajne wietrzyki ucichły, błyskawice migały coraz słabiej...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc2b84b-1b30-4180-8857-2efa6a23149d",
                        "source_entry_id": "2aa57f1f-7459-3822-af83-48feabe00001",
                        "source_sense_id": "58e69eca-89a2-35b3-921a-74673f9a8824",
                        "source_sense_description": "poetisch: stürmischer Nordwind oder Nordostwind; Aquilo, Nordwind, Nordostwind",
                        "target_lang_word": "Aquilo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "16ba959e-eaf9-4404-9944-39da5cc9c611",
                        "source_entry_id": "2aa57f1f-7459-3822-af83-48feabe00001",
                        "source_sense_id": "58e69eca-89a2-35b3-921a-74673f9a8824",
                        "source_sense_description": "poetisch: stürmischer Nordwind oder Nordostwind; Aquilo, Nordwind, Nordostwind",
                        "target_lang_word": "Nordwind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordwind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef53c6b-0b50-35f7-a9ac-12584aecdbdb",
                                        "entry_id": "5e31ae91-4ad2-3ed8-b51e-39bf15eae4ee",
                                        "glosses": [
                                            "von Norden her wehender Wind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56c4102-4397-466f-9fb4-a75702377597",
                                                "sense_id": "0ef53c6b-0b50-35f7-a9ac-12584aecdbdb",
                                                "text": "„Es ist eisig kalt, bis hierher dringt der Nordwind, der aus den nördlichen Eismeeren kommt, über das Mittelmeer zieht, die ägyptischen Wüsten, das Niltal, monatelang die dunklen Völker am oberen Nil erschauern macht.“"
                                            },
                                            {
                                                "example_id": "acb6db3b-bd89-4c7c-8ada-9f741ba03d36",
                                                "sense_id": "0ef53c6b-0b50-35f7-a9ac-12584aecdbdb",
                                                "text": "„Der scharfe Nordwind zauste die nackten Pappelzweige.“"
                                            },
                                            {
                                                "example_id": "61c714c8-d60e-4480-acb9-9d7340be7fef",
                                                "sense_id": "0ef53c6b-0b50-35f7-a9ac-12584aecdbdb",
                                                "text": "„Aber heute ist der Nordwind nicht so scharf wie in den letzten Tagen.“"
                                            },
                                            {
                                                "example_id": "0baebc4b-03dd-43fd-957d-f268b71bcb40",
                                                "sense_id": "0ef53c6b-0b50-35f7-a9ac-12584aecdbdb",
                                                "text": "„Da erhob sich ein Nordwind, der in weniger als einer Stunde so steif wurde, daß wir gefährlich dicht am Winde segelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e5f34c0-14db-4bd0-8a6b-cd621a5b5dc8",
                        "source_entry_id": "2aa57f1f-7459-3822-af83-48feabe00001",
                        "source_sense_id": "58e69eca-89a2-35b3-921a-74673f9a8824",
                        "source_sense_description": "poetisch: stürmischer Nordwind oder Nordostwind; Aquilo, Nordwind, Nordostwind",
                        "target_lang_word": "Nordostwind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordostwind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef5c088-e88c-3080-99dc-002b0a3b0957",
                                        "entry_id": "eaa99ce7-4f93-3858-a801-d76474517f33",
                                        "glosses": [
                                            "nordöstliche Luftbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d626ae72-dc84-4080-b8b3-95c4d4be248e",
                                                "sense_id": "1ef5c088-e88c-3080-99dc-002b0a3b0957",
                                                "text": "Für Morgen ist Nordostwind angesagt."
                                            },
                                            {
                                                "example_id": "f6a6f04c-14c5-4307-bdd5-759d3c87f554",
                                                "sense_id": "1ef5c088-e88c-3080-99dc-002b0a3b0957",
                                                "text": "„Bei Nordostwind würde der Rauch zwar wieder in die Küche zurückschlagen, aber Koch Nab war da nicht empfindlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
