                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97bdce4e-e707-3e8d-ac69-78b40265c5bc",
                                        "entry_id": "182e2852-a96b-3c81-b540-46ee3b7edcf5",
                                        "glosses": [
                                            "ein Motorfahrzeug, das hauptsächlich dem Transport von Gütern dient"
                                        ],
                                        "tags": [
                                            "Transport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7f0f4b-4a63-4a50-b934-5588ef11b47e",
                                                "sense_id": "97bdce4e-e707-3e8d-ac69-78b40265c5bc",
                                                "text": "Der Müller braust nun mit einem Lastkraftwagen durch die Gegend. Das Pferdefuhrwerk hat er abgeschafft."
                                            },
                                            {
                                                "example_id": "3552f721-b13b-4036-b406-cd10845f59c6",
                                                "sense_id": "97bdce4e-e707-3e8d-ac69-78b40265c5bc",
                                                "text": "In den zahlreichen Lagern an den französischen Ufern des Ärmelkanals leben vorwiegend Flüchtlinge afghanischer Herkunft, meist mit dem Ziel, als „blinder Passagier“ auf Güterzügen oder Lastkraftwagen durch den Eurotunnel nach England zu gelangen."
                                            },
                                            {
                                                "example_id": "65950b3f-3e11-4074-9bac-0861e15e849f",
                                                "sense_id": "97bdce4e-e707-3e8d-ac69-78b40265c5bc",
                                                "text": "„Auf einem Lastkraftwagen kam ein großes Schaukelgestell für uns, aus Metall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adacadbc-0435-4c27-9045-b915586c1410",
                        "source_entry_id": "18cc17bd-cfe9-3841-bb36-218bbb7fad83",
                        "source_sense_id": "16bcd53b-14a6-3808-bd40-5228d15edda3",
                        "source_sense_description": "een auto voor goederenvervoer",
                        "target_lang_word": "Lastwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lastwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "affc6e82-f297-3cf8-9095-31df92a0b828",
                                        "entry_id": "e9e28130-6dd5-30e1-9d22-c71bf3e6d558",
                                        "glosses": [
                                            "zum Transport von Last gemachter Kraftwagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88e8d11-0521-41a4-80b2-da1b88e80f32",
                                                "sense_id": "affc6e82-f297-3cf8-9095-31df92a0b828",
                                                "text": "Für diesen Transport brauchen wir einen Lastwagen."
                                            },
                                            {
                                                "example_id": "7ef7b88d-6305-4d89-a45e-8b53cdc41571",
                                                "sense_id": "affc6e82-f297-3cf8-9095-31df92a0b828",
                                                "text": "„Aber wir haben noch Zeit, bis die Lastwagen kommen.“"
                                            },
                                            {
                                                "example_id": "4dbcc1bb-0636-47fd-8b7e-cd3298e9e718",
                                                "sense_id": "affc6e82-f297-3cf8-9095-31df92a0b828",
                                                "text": "„Am Morgen führt mich ein Auto, dem ein Lastwagen mit schwer bewaffneten Soldaten folgt, zum Gerichtsgebäude.“"
                                            },
                                            {
                                                "example_id": "2a7d93b0-7cb7-4e38-8487-8ba022c310de",
                                                "sense_id": "affc6e82-f297-3cf8-9095-31df92a0b828",
                                                "text": "„Die letzten Kilometer fuhr ich mit einem Lastwagen.“"
                                            },
                                            {
                                                "example_id": "5207be90-ae47-4846-9396-03de1e9b634c",
                                                "sense_id": "affc6e82-f297-3cf8-9095-31df92a0b828",
                                                "text": "„Sie haben einen hohen alten Lastwagen, der ziemlich mitgenommen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fce13815-68d5-4c95-8405-8ca785d5bbc2",
                        "source_entry_id": "18cc17bd-cfe9-3841-bb36-218bbb7fad83",
