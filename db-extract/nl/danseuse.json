                "senses": [
                    {
                        "sense_id": "bfb7301e-2333-3fa6-b9a5-e63889c0b6f8",
                        "entry_id": "2985a872-9def-342d-a700-fbc01111711f",
                        "glosses": [
                            "vrouw die geld verdient met dansvoorstellingen waarbij zij sierlijk op muziek beweegt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "dc5c96e5-7738-40ff-b2ca-ef207958c630",
                                "sense_id": "bfb7301e-2333-3fa6-b9a5-e63889c0b6f8",
                                "text": "De theateragent betreurt het vertrek van zijn typiste. Samen met de danseuse en haar impresario, ‘de misdaad, gehuld in een getailleerde jas’, beraamt hij plannen om het meisje terug te halen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1010139-ba20-3dc4-b0b2-e364b0675154",
                        "entry_id": "2985a872-9def-342d-a700-fbc01111711f",
                        "glosses": [
                            "vrouw die goed kan dansen, vrouw die graag danst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "092634aa-21f4-42bc-bac2-5c0b8d346bba",
                                "sense_id": "b1010139-ba20-3dc4-b0b2-e364b0675154",
                                "text": "‘Zeker. Wat moeten de mensen wel denken, als we de hele avond dansen!’\n\"De hele avond?\"\n‘'n Groot gedeelte tenminste.’\n\"Wel, wat kan men denken? Hoogstens toch, dat ik graag met je dans, wat voor een zo goede danseuse geen buitengewone voorkeur mag heten.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "861f6931-0a69-3833-9956-c63afe34e65b",
                        "entry_id": "2985a872-9def-342d-a700-fbc01111711f",
                        "glosses": [
                            "vrouw waarmee je danst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e962e15d-360c-4bed-9861-ffa956db27f1",
                                "sense_id": "861f6931-0a69-3833-9956-c63afe34e65b",
                                "text": "De danseuses met wie je in Parijs tegen betaling uit dansen kon gaan, boden ook seksuele diensten aan."
                            }
                        ]
                    }
