                        "examples": [
                            {
                                "example_id": "dd960704-497a-4d28-969b-eb2e74a1c3d5",
                                "sense_id": "2edfe9f8-b200-36a0-b3a9-4795e8456d54",
                                "text": "„Überschwang aber zeigt sich eher nach außen, Furcht wirkt stärker nach innen.“"
                            },
                            {
                                "example_id": "bd179b4f-04bb-4815-ab74-5707be0b1bce",
                                "sense_id": "2edfe9f8-b200-36a0-b3a9-4795e8456d54",
                                "text": "„Was wie im Kongo meist im Überschwang der Unabhängigkeitsfeiern beginnt, endet fast überall in Agonie.“"
                            },
                            {
                                "example_id": "35f0192f-98a8-4806-ba34-a94ec44facac",
                                "sense_id": "2edfe9f8-b200-36a0-b3a9-4795e8456d54",
                                "text": "„Lucien nutzte den Überschwang seines Gesprächspartners, um endlich seinen ersten Schluck zu trinken.“"
                            },
                            {
                                "example_id": "347c2e14-a743-4a60-9fcf-07671895549f",
                                "sense_id": "2edfe9f8-b200-36a0-b3a9-4795e8456d54",
                                "text": "„Doch ehe noch der Abend dämmerte, war der Überschwang schon wieder verflogen.“"
                            }
                        ],
