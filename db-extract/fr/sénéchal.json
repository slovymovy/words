            {
                "entry_id": "06a13b95-63a8-3c75-8b0a-801a9f1bbe5d",
                "word": "sénéchal",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "574ead41-f315-49ce-81f7-69bd5ad03494",
                        "entry_id": "06a13b95-63a8-3c75-8b0a-801a9f1bbe5d",
                        "tags": [
                            "plural"
                        ],
                        "form": "sénéchaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a22378bc-e30e-3d6f-b6f4-72bff9b7515f",
                        "entry_id": "06a13b95-63a8-3c75-8b0a-801a9f1bbe5d",
                        "glosses": [
                            "Officier féodal qui était chargé principalement de la surintendance, de l’hôtel, du seigneur et de la justice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fba81d3-d3c3-4421-8e6c-6fcdcbbcd85a",
                                "sense_id": "a22378bc-e30e-3d6f-b6f4-72bff9b7515f",
                                "text": "Deux des plus humbles fils de notre mère l’Église ! répéta Wamba intérieurement,[…] ; je voudrais voir ses sénéchaux, ses grands échansons et ses autres principaux."
                            },
                            {
                                "example_id": "75ec8876-e5a1-4589-9ab5-37ab17dd3bf0",
                                "sense_id": "a22378bc-e30e-3d6f-b6f4-72bff9b7515f",
                                "text": "Et quand il y fut, le sénéchal tança d'une verte manière les deux lévriers qui se disputaient un os de jambon."
                            }
                        ]
                    },
                    {
                        "sense_id": "061c70dd-511a-30af-b444-da34177ead35",
                        "entry_id": "06a13b95-63a8-3c75-8b0a-801a9f1bbe5d",
                        "glosses": [
                            "Fonctionnaire d’ordre administratif analogues aux baillis, qui rendaient la justice dans un certain ressort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34dc616-ad63-4a54-acc1-a1e374e578a8",
                                "sense_id": "061c70dd-511a-30af-b444-da34177ead35",
                                "text": "Carcassonne alors fit partie du domaine royal, et un sénéchal y commandait pour le roi de France."
                            },
                            {
                                "example_id": "2e7b0fb4-a6bd-449c-b510-69fca4c2d527",
                                "sense_id": "061c70dd-511a-30af-b444-da34177ead35",
                                "text": "En 1246, il fit jeter en prison tous les juifs de Carcassonne, puis il invita le sénéchal à tirer d'eux le plus d'argent possible."
                            },
                            {
                                "example_id": "b26a9543-5534-451c-86cc-e344263e65cd",
                                "sense_id": "061c70dd-511a-30af-b444-da34177ead35",
                                "text": "Grand sénéchal de France, titre d’un emploi dans l’hôtel du roi qui était en même temps une charge militaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d800700-dd60-4055-8707-8ad990387dc4",
                        "source_entry_id": "06a13b95-63a8-3c75-8b0a-801a9f1bbe5d",
                        "target_lang_word": "seneschal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seneschal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1813f36-d15f-307a-b806-f7f487f74e1d",
                                        "entry_id": "84f82e20-6ae7-32db-8c9a-9b3eb3d02dcb",
                                        "glosses": [
                                            "A steward, particularly (historical) one in charge of a medieval nobleman's estate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73eaaaa-782d-4216-bb81-202e67b4b764",
                                                "sense_id": "e1813f36-d15f-307a-b806-f7f487f74e1d",
                                                "text": "Beside stood seneschals, the appointed witnesses of the ensuing games."
                                            },
                                            {
                                                "example_id": "8bf2a978-0d2a-4f0f-9241-bf0062732c2d",
                                                "sense_id": "e1813f36-d15f-307a-b806-f7f487f74e1d",
                                                "text": "[…] so the very keenest seneskal can't see no sign […]"
                                            },
                                            {
                                                "example_id": "5584d87e-a138-43b5-9e39-f525c1a76129",
                                                "sense_id": "e1813f36-d15f-307a-b806-f7f487f74e1d",
                                                "text": "It was in the queer little Church of Vera Cruz, beneath the castle, that the Knights Templar performed their secret rites of chivalry, standing vigil over their arms all night, in all the mysterious splendour of seneschal, gonfalon, and accolade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd06693-6c53-37c7-a588-d44bf43070d8",
                                        "entry_id": "84f82e20-6ae7-32db-8c9a-9b3eb3d02dcb",
                                        "glosses": [
                                            "An officer of the crown in late medieval and early modern France who served as a kind of governor and chief justice of the royal court in Normandy and Languedoc."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
