                "senses": [
                    {
                        "sense_id": "ff1aa007-8dd9-30c2-872f-1b4135f45b41",
                        "entry_id": "e70d602a-4723-3699-94fd-759bd497bfc1",
                        "glosses": [
                            "Hoorapparaat. Toestel voor slechthorenden om het gehoor te versterken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36fe8d5c-f1ee-4ae8-ae43-7333fe32bc9f",
                                "sense_id": "ff1aa007-8dd9-30c2-872f-1b4135f45b41",
                                "text": "De oude man had een gehoorapparaat nodig."
                            },
                            {
                                "example_id": "470de874-e3e6-4ae7-a9a5-f0f0a99667f4",
                                "sense_id": "ff1aa007-8dd9-30c2-872f-1b4135f45b41",
                                "text": "David Hockney zet zijn tanden in een Double Smash Burger met gekarameliseerde uien en gerookte cheddar. Zijn twee gehoorapparaten heeft hij naast zijn bord gelegd, op zijn schoot ligt een zorgvuldig gevouwen servet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "702f0c16-d579-4bd9-bc1e-4267450c880f",
                        "source_entry_id": "e70d602a-4723-3699-94fd-759bd497bfc1",
                        "source_sense_id": "ff1aa007-8dd9-30c2-872f-1b4135f45b41",
                        "target_lang_word": "Hörgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hörgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                        "entry_id": "107d972a-37bc-3ce2-a630-336fb0ccd1a5",
                                        "glosses": [
                                            "Gerät für Hörgeschädigte, um die Hörfähigkeit zu verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad50a7b-97d8-45d6-9362-063b22ff4912",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "Als ihr Vater sechzig Jahre alt war, brauchte er wegen Hörverlustes ein Hörgerät."
                                            },
                                            {
                                                "example_id": "4465e7a5-53b1-41f4-b256-32a178430641",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "„Wir sehen Gehhilfen, Hörgeräte, Tablettendosen, zitternde und gleichwohl konzentrierte Hände, die die Medikamente neben dem Besteck ordnen.“"
                                            },
                                            {
                                                "example_id": "2a20f7a3-5a35-40ed-a3ce-6f89592fbf0b",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "„Erst kürzlich hatte ich mir bei einem Besuch bei meiner Mutter ihre Hörgeräte ausgeborgt und in die Ohren geschoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b0d9fba-e3ed-4301-823b-16674fb13469",
                        "source_entry_id": "e70d602a-4723-3699-94fd-759bd497bfc1",
