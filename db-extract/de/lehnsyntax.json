                "senses": [
                    {
                        "sense_id": "df60bea7-2d37-31e5-b11f-de28d45deaf8",
                        "entry_id": "fcc20dc8-6deb-3605-83ce-0c661d06c789",
                        "glosses": [
                            "aus einer anderen Sprache übernommene syntaktische Erscheinung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4348e63-1c26-4eae-a115-94eff2e9b76a",
                                "sense_id": "df60bea7-2d37-31e5-b11f-de28d45deaf8",
                                "text": "„Darüber hinaus haben Lehnübersetzungen und Lehnsyntax nach hebräischen Vorbildern die grammatische Struktur der Sprache in grundlegender Weise geprägt.“"
                            },
                            {
                                "example_id": "dc8e5297-f127-497a-82bc-a482c61e7406",
                                "sense_id": "df60bea7-2d37-31e5-b11f-de28d45deaf8",
                                "text": "„Zur Lehnprägung rechnen Lehnsyntax, Lehnbedeutung, Lehnbildung und Lehnwendung.“"
                            },
                            {
                                "example_id": "9c8868dd-f370-4a7b-a307-d0eed2fe6a33",
                                "sense_id": "df60bea7-2d37-31e5-b11f-de28d45deaf8",
                                "text": "Das Metzler Lexikon Sprache nennt Lehnsyntax als eine der Erscheinungsformen unter dem Stichwort Lehngut."
                            },
                            {
                                "example_id": "7f83f559-14d4-4480-8e7b-38db3507dcef",
                                "sense_id": "df60bea7-2d37-31e5-b11f-de28d45deaf8",
                                "text": "„Lehnsyntax ist, wie Karl Brugmann einmal bemerkte, der Empfängersprache meist nicht ganz fremd, nur etwas seltsam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
