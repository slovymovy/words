                "translations": [
                    {
                        "translation_id": "99a87121-3129-435e-b299-193b8986fba7",
                        "source_entry_id": "6bd12c61-0508-3064-8bdc-a19586498b32",
                        "source_sense_id": "4e2d5363-081f-3466-a71a-5d470c069e85",
                        "source_sense_description": "umgangssprachlich, berlinerisch: wir",
                        "target_lang_word": "wir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                        "entry_id": "8543c9ab-8de8-39c8-a89b-db44d57c4cc4",
                                        "glosses": [
                                            "1. Person Plural; mehrere Personen, die sprechende eingeschlossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00123786-f005-4484-8f85-5383205678f6",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Wir, das sind mindestens zwei."
                                            },
                                            {
                                                "example_id": "588b7312-f945-4fd9-a352-11b3bfee5076",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Mein Vater und ich reisen viel. Jetzt fahren wir nach Dänemark."
                                            },
                                            {
                                                "example_id": "9400f3b5-8e22-43cf-90af-31aff8515ec1",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Herr, erbarme dich unser."
                                            },
                                            {
                                                "example_id": "e684cf1a-b2fa-4aab-ae31-6d786ba15cb2",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Ich möchte Ihnen in unser aller Namen unseren Dank aussprechen."
                                            },
                                            {
                                                "example_id": "72121d42-5e38-450d-8ea6-960ea1eb7395",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Es sind unser drei erschienen."
                                            },
                                            {
                                                "example_id": "9fb45fff-cf9b-4cb5-b34e-575381c74f09",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Sie gaben uns keine Auskunft."
                                            },
                                            {
                                                "example_id": "6448baf7-9763-453c-954c-f87618c15007",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Sie erzählte uns alles."
                                            },
                                            {
                                                "example_id": "1539fd92-400e-40bc-a9e7-2556f5b720ab",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Helft uns!"
                                            },
                                            {
                                                "example_id": "664870bd-77f9-4a3a-be09-d0ec4a7c66da",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Warum vertraust du uns nicht?"
                                            },
                                            {
                                                "example_id": "df384f56-6f19-4be7-81b5-d65479082fb9",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Er hat uns nicht gesehen."
                                            },
                                            {
                                                "example_id": "389751af-480e-4a50-8d0e-6952f5c15b78",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Wartet auf uns!"
                                            },
                                            {
                                                "example_id": "36e12235-cfba-45ac-9fe7-987926fdb32f",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Wer hat uns gerufen?"
                                            },
                                            {
                                                "example_id": "6c533800-4568-4a17-8a42-b681d2eb5648",
                                                "sense_id": "87ec0200-7f0a-3712-99e1-4fa3ffbdfafa",
                                                "text": "Sie können sich auf uns verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
