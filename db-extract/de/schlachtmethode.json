                    {
                        "sense_id": "72a47aa7-8931-35bc-99ad-784e0462603d",
                        "entry_id": "a3c50e33-b36d-3e78-9ba9-b2d570b558c2",
                        "glosses": [
                            "Art und Weise des Schlachtens; Schlachtverfahren"
