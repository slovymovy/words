                                    {
                                        "sense_id": "8e2f182c-ba09-35a0-88fa-ba7db52bf580",
                                        "entry_id": "e17ff07d-9d3e-3cdc-ba68-ed9cdd3e6894",
                                        "glosses": [
                                            "A member of a Semitic people of Ethiopia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1aea72-9aec-483a-8317-4e12eaf5419a",
                                                "sense_id": "8e2f182c-ba09-35a0-88fa-ba7db52bf580",
                                                "text": "Ahmed was also appreciated for his talents as a showman, because he had no equal in letting loose the famous eskista, with the heaving quiver of the torso and shoulders, of which Ethiopians are so fond. Eskista is the dance of the Amharas, enhancing amorous repartee and expressing collective jubilation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amhara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9aefcd-0493-303c-9d6c-8ca07e79fd3b",
                                        "entry_id": "d4c2220b-ae6b-3f03-95c7-523a98af0cd6",
                                        "glosses": [
                                            "Ellipsis of Amhara people; synonym of Amharas; a Semitic-speaking people of Ethiopia."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0e023ee-c20a-37d2-a5f2-50811e8d7153",
                                        "entry_id": "d4c2220b-ae6b-3f03-95c7-523a98af0cd6",
                                        "glosses": [
                                            "Ellipsis of Amhara language; synonym of Amharic; a Semitic language spoken by the Amharas, and a lingua franca used by Ethiopia."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68ba77fb-444b-39fe-ac06-257fe0a44dd3",
                                        "entry_id": "d4c2220b-ae6b-3f03-95c7-523a98af0cd6",
                                        "glosses": [
                                            "a province of the Ethiopian Empire"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bca44cd9-88b6-348a-af43-ca5e399c8931",
                                        "entry_id": "d4c2220b-ae6b-3f03-95c7-523a98af0cd6",
                                        "glosses": [
                                            "A state of Ethiopia; in full, Amhara Region. Seat: Bahir Dar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb63534-a2a0-47cd-bccd-9fcb40da76b1",
                                                "sense_id": "bca44cd9-88b6-348a-af43-ca5e399c8931",
                                                "text": "Spokespeople for the Ethiopian government, the army and Amhara's regional administration did not immediately respond to requests for comment. The government has not publicly commented on allegations its forces have committed abuses in Amhara."
                                            }
                                        ]
                                    }
                                ]
                            }
