                "senses": [
                    {
                        "sense_id": "9fc12710-79e7-3045-bfcd-358bda4a285b",
                        "entry_id": "6f4d6b56-6f89-3825-b95e-e33fede65c4d",
                        "glosses": [
                            "To make simpler, either by reducing in complexity, reducing to component parts, or making easier to understand."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "50d9ba15-bfbe-407f-a415-4828d07c5873",
                                "sense_id": "9fc12710-79e7-3045-bfcd-358bda4a285b",
                                "text": "In ancient times there existed in the region of the Tung-chia River 佟佳江 in present Liaoning a people called Kao-chü-li 高句驪. In the fifth century they moved their capital to P’ing-jang. The name of the country was simplified to Kao-li 高麗 (Korea)."
                            },
                            {
                                "example_id": "2015e0cd-f8ce-404b-8c74-7b6d02271305",
                                "sense_id": "9fc12710-79e7-3045-bfcd-358bda4a285b",
                                "text": "Quizzed on simplifying fares, Heaton-Harris said the Government had inherited a \"mix of ticketing and unbelievable, interesting fares up and down the system, and we do want to simplify them\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "852be95e-4f3f-3f93-829c-d052e0d19181",
                        "entry_id": "6f4d6b56-6f89-3825-b95e-e33fede65c4d",
                        "glosses": [
                            "To become simpler."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "63135bdc-3177-4120-84b7-f7ea30e942bd",
                                "sense_id": "852be95e-4f3f-3f93-829c-d052e0d19181",
                                "text": "Thus, throughout the nineteenth century, linguists generally held that more grammatically complex languages were older and that languages tended to simplify over time—the four grammatical cases of German as contrasted with the seven of Latin, for example."
                            }
                        ]
                    }
                ],
