                "senses": [
                    {
                        "sense_id": "053be53f-c634-3a6e-9380-e4c7d80ddb97",
                        "entry_id": "422e4c2f-1efa-367d-9b54-f71e24eba6d8",
                        "glosses": [
                            "Celui qui fait la fonction de chancelier, en l’absence de ce dignitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0823265b-f19f-4ca6-8853-e988611143b2",
                                "sense_id": "053be53f-c634-3a6e-9380-e4c7d80ddb97",
                                "text": "Le vice-chancelier Maupeou manda Mme Calas et ses compagnons d'infortune; il leur annonça lui-même les dons du roi. […]. On leur avait dit que si le roi leur accordait une gratification, c’était pour éviter qu’ils prissent à partie le Parlement qui les avait jetés dans l’indigence en même temps que dans le deuil : […]."
                            },
                            {
                                "example_id": "a53b4cf7-c1d4-42c3-a98b-e375dcba4e83",
                                "sense_id": "053be53f-c634-3a6e-9380-e4c7d80ddb97",
                                "text": "Dupaillon.– J’en aurais peut-être le droit : je suis plus ancien que lui, son supérieur en grade… je suis chancelier et il n’est que vice-chancelier…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edc9e6bc-0347-445d-973e-2d5b6efd3525",
                        "source_entry_id": "422e4c2f-1efa-367d-9b54-f71e24eba6d8",
                        "source_sense_id": "053be53f-c634-3a6e-9380-e4c7d80ddb97",
                        "target_lang_word": "Vizekanzler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vizekanzler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5611003-4d6e-3b4e-94c2-af3175592793",
                                        "entry_id": "07bf82f0-08db-3b72-96b3-6b55986b8530",
                                        "glosses": [
                                            "Stellvertreter des Kanzlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d4e7fb-9588-45f6-bced-1af093fc1f7a",
                                                "sense_id": "d5611003-4d6e-3b4e-94c2-af3175592793",
                                                "text": "Der abwesende Bundeskanzler wird heute durch den Vizekanzler vertreten."
                                            },
                                            {
                                                "example_id": "67be843e-10b1-4ec3-97d8-1fdf7a18fb3d",
                                                "sense_id": "d5611003-4d6e-3b4e-94c2-af3175592793",
                                                "text": "Der Kanzler und der Vizekanzler legen heute die neuen Sparpläne vor."
                                            },
                                            {
                                                "example_id": "8b666cb0-fd68-484e-a576-157a1f04aeb5",
                                                "sense_id": "d5611003-4d6e-3b4e-94c2-af3175592793",
                                                "text": "„Lord Eftsoons ließ sich selten an der Hohen Tafel blicken, besonders jetzt, da er als Vizekanzler zusätzliche gesellschaftliche Verpflichtungen hatte.“"
                                            },
                                            {
                                                "example_id": "db97e573-40c1-4287-a8ef-ac93ac17b115",
                                                "sense_id": "d5611003-4d6e-3b4e-94c2-af3175592793",
                                                "text": "„Dem Vizekanzler ist etwas auf den Magen geschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
