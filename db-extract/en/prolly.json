                "senses": [
                    {
                        "sense_id": "b644f248-ec7c-3422-92d5-f13a7550501c",
                        "entry_id": "c87af4e0-2de2-3ece-b264-ccc2573adf19",
                        "glosses": [
                            "Probably."
                        ],
                        "tags": [
                            "colloquial",
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "08f5dcc6-8ab7-45c8-b5c0-0a7d2f697723",
                                "sense_id": "b644f248-ec7c-3422-92d5-f13a7550501c",
                                "text": "I should prolly keep my eyes on the road."
                            },
                            {
                                "example_id": "633bfa65-36ff-457b-9dbb-b1319f6742ff",
                                "sense_id": "b644f248-ec7c-3422-92d5-f13a7550501c",
                                "text": "Take or be taken. Get yours or get got. It was the code of the streets and I'd lived by it. The way things was looking, I was prolly gone die by it too."
                            },
                            {
                                "example_id": "cc30e2ab-05a1-4f3e-b364-637e4681d016",
                                "sense_id": "b644f248-ec7c-3422-92d5-f13a7550501c",
                                "text": "Naw. That stream's so lazy, it prolly wouldn't even float thee."
                            },
                            {
                                "example_id": "a48c14c2-805c-4181-820b-2a20b7f6d601",
                                "sense_id": "b644f248-ec7c-3422-92d5-f13a7550501c",
                                "text": "Prolly wouldn't be stopped by da cops all da time, even though I ain't doin' nothin' wrong. Prolly wouldn't have my teachers tryna put me in special ed all da time. And prolly would be in the Gifted and Talented Program wit' you and Echo."
                            },
                            {
                                "example_id": "e3cfaa6d-5139-47bc-a28d-b54ccb4d03b9",
                                "sense_id": "b644f248-ec7c-3422-92d5-f13a7550501c",
                                "text": "\"There's prolly good parts of the province. Only good part of the town is it's easy to sneak into the abandoned movie theater and throw expired Milk Duds to the rats.\""
                            }
                        ]
                    }
                ],
