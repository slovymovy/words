                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He joined the varsity <w>crew</w> team during his freshman year.",
                            "target_lang_translations": {
                                "ru": "Он присоединился к университетской команде по <w>академической гребле</w> на первом курсе.",
                                "tr": "Birinci sınıfında üniversitenin <w>kürek</w> takımına katıldı.",
                                "zh": "他大一时加入了校<w>赛艇队</w>。"
                            }
                        },
                        {
                            "text": "The university is famous for its excellent <w>crew</w> program.",
                            "target_lang_translations": {
