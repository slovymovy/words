                        ],
                        "form": "den Peiniger"
                    },
                    {
                        "form_id": "ce5391bf-c79c-460c-bf1b-5765e4522cd1",
                        "entry_id": "12ff00ff-0a03-388c-bdd8-160f25394bb2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Peiniger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                        "entry_id": "12ff00ff-0a03-388c-bdd8-160f25394bb2",
                        "glosses": [
                            "Person, die jemanden peinigt, die jemandem Leid zufügt, jemanden quält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61669c7-42e8-45e1-841d-68cb12a1f4c7",
                                "sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                                "text": "Erst beim Prozess sah die junge Frau ihren Peiniger wieder."
                            },
                            {
                                "example_id": "e5acbe3e-81bd-4e71-9b33-aa159422877c",
                                "sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                                "text": "Auch 32 Jahre nach der Entführung kann sich Richard Oetker nicht vorstellen, seinem Peiniger zu verzeihen."
                            },
                            {
                                "example_id": "7801a54b-c075-4421-8c0a-5071ee62b734",
                                "sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                                "text": "„Die Rufe des Abscheus, die sich wie Wellen von Haß zu Beginn der Rede aus der Versammlung gegen die Peiniger erhoben hatten, waren bald verstummt.“"
                            },
                            {
                                "example_id": "8a7d4e9c-5882-4e22-b062-fb7a75347e5f",
                                "sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                                "text": "„Seine Peiniger jagten ihn zurück in die Baracke.“"
                            },
                            {
                                "example_id": "31daa7e7-baa2-44f1-802f-3ea31d44b37d",
                                "sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                                "text": "„Am nächsten Morgen um 10 Uhr machte sich Thomas Lieven, heiter und durchaus nicht müde, nach einem umfangreichen Frühstück daran, vor seiner Abreise aus Europa noch gründliche Rache an seinen Peinigern vom deutschen, englischen und französischen Geheimdienst zu nehmen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e394f4b-abb5-479d-a7f1-aa05564541c7",
                        "source_entry_id": "12ff00ff-0a03-388c-bdd8-160f25394bb2",
                        "source_sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                        "source_sense_description": "Person, die jemanden peinigt, die jemandem Leid zufügt, jemanden quält",
                        "target_lang_word": "tormentor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tormentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d45f6ed0-3efb-359a-ba86-f1c08949402a",
                                        "entry_id": "5dd3ad8d-1781-3250-bbff-ba09bf786c83",
                                        "glosses": [
                                            "One who torments; a person, animal, or object that causes suffering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc8f0d90-3b7d-4b4b-ba7f-ec568f600d9a",
                                                "sense_id": "d45f6ed0-3efb-359a-ba86-f1c08949402a",
                                                "text": "Before that estimable lady could recover herself, or offer the slightest retaliation, she was forced into a kneeling posture by a crowd of shouting tormentors, and compelled to swallow a spoonful of the odious mixture […]"
                                            },
                                            {
                                                "example_id": "2fb9ca48-54a3-41ff-a6b1-03fa02c4a5c9",
                                                "sense_id": "d45f6ed0-3efb-359a-ba86-f1c08949402a",
                                                "text": "A girl of the village […] came and rang at my bell as soon as it was light […] perfectly maddened with an aching tooth. […] The poor thing begged me with tears in her eyes to take out her tormentor, if I dragged her head off."
                                            },
                                            {
                                                "example_id": "2cb6c8f5-d87e-42ae-b104-60b62d6d0720",
                                                "sense_id": "d45f6ed0-3efb-359a-ba86-f1c08949402a",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3acf528d-7882-31c6-ae2a-e2e71cc78d6c",
                                        "entry_id": "5dd3ad8d-1781-3250-bbff-ba09bf786c83",
                                        "glosses": [
                                            "One who torments; a person, animal, or object that causes suffering.",
                                            "A person delegated to torture prisoners."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f20bb2fc-ce79-4c88-8299-7c44144b201f",
                                                "sense_id": "3acf528d-7882-31c6-ae2a-e2e71cc78d6c",
                                                "text": "And his lord was wroth, and delivered him to the tormentors, till he should pay all that was due unto him."
                                            },
                                            {
                                                "example_id": "952ad41e-53d5-470f-908b-c932b4fa0ed8",
                                                "sense_id": "3acf528d-7882-31c6-ae2a-e2e71cc78d6c",
                                                "text": "All the racks and dungeons of Rome, with their tormentors, could not terrify him."
                                            },
                                            {
                                                "example_id": "2942b94e-03df-4fcc-afc4-a54342fcf3f8",
                                                "sense_id": "3acf528d-7882-31c6-ae2a-e2e71cc78d6c",
                                                "text": "1933, Hervey Allen, Anthony Adverse, New York: Farrar and Rinehart, Volume 1, Book 1, Chapter 6, p. 78,\nHer eyes rested on him for an instant like those of an accused person seeing the state tormentor approach for the first time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5ce83f0-f152-308b-bb9f-ed723eb5755b",
                                        "entry_id": "5dd3ad8d-1781-3250-bbff-ba09bf786c83",
                                        "glosses": [
                                            "Something abstract that causes suffering."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df56ee7d-8d79-4863-9346-1ea72c99bc05",
                                                "sense_id": "c5ce83f0-f152-308b-bb9f-ed723eb5755b",
                                                "text": "These words hereafter thy tormentors be!"
                                            },
                                            {
                                                "example_id": "bcf3cc37-ab5c-4880-b21c-df3b6c8ae9b8",
                                                "sense_id": "c5ce83f0-f152-308b-bb9f-ed723eb5755b",
                                                "text": "Thoughts my Tormenters arm’d with deadly stings\nMangle my apprehensive tenderest parts,"
                                            },
                                            {
                                                "example_id": "410d14e0-184a-4a1c-90e7-a81ce4ff7ef2",
                                                "sense_id": "c5ce83f0-f152-308b-bb9f-ed723eb5755b",
                                                "text": "1759, Adam Smith, The Theory of Moral Sentiments, Edinburgh: A. Kincaid and J. Bell, Part 1, Section 1, p. 10,\nThe infant […] feels only the uneasiness of the present instant, which can never be great. With regard to the future it is perfectly secure, and in its thoughtlessness and want of foresight possesses an antidote against fear and anxiety, the great tormentors of the human breast, from which reason and philosophy will in vain attempt to defend it when it grows up to a man."
                                            },
                                            {
                                                "example_id": "b041393b-0dfb-4921-a4a3-85a7e4a542fe",
                                                "sense_id": "c5ce83f0-f152-308b-bb9f-ed723eb5755b",
                                                "text": "As he spoke about his loss, it became clear why he had waited at the station platform every day to meet their train: he was matching his wits with time the great tormentor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ecf6c5-8f74-34ad-9743-3ab43479a5d6",
                                        "entry_id": "5dd3ad8d-1781-3250-bbff-ba09bf786c83",
                                        "glosses": [
                                            "One of a pair of narrow curtains just behind the front curtain and teaser that mask the areas on the sides of the stage and can be adjusted to the desired width."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d2b102-9653-4db4-900c-0f11295bb835",
                                                "sense_id": "f7ecf6c5-8f74-34ad-9743-3ab43479a5d6",
                                                "text": "Then Nathan Eldred, gently pushing, was muttering, ‘On you go, dear. Good luck!’ and she was edging between the tormentor and the backing flats, in front of the curtain, holding her small hands out to the sudden-silenced audience […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b74c64e9-6b7b-3833-9a57-57b469235808",
                                        "entry_id": "5dd3ad8d-1781-3250-bbff-ba09bf786c83",
                                        "glosses": [
                                            "An implement for reducing a stiff soil, resembling a harrow, but running upon wheels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6db640e8-38f3-3d5c-ac48-21a0bd2cca20",
                                        "entry_id": "5dd3ad8d-1781-3250-bbff-ba09bf786c83",
                                        "glosses": [
                                            "A long meat-fork."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aca5907-23af-4524-955e-3ce1b9dd85dc",
                                                "sense_id": "6db640e8-38f3-3d5c-ac48-21a0bd2cca20",
                                                "text": "1813, Charles Stewart, enclosure in a letter to the Secretary of the Navy, dated 18 October, 1813, in William S. Dudley (editor), The Naval War of 1812: A Documentary History, Washington D.C.: Naval Historical Center, Department of the Navy, 1992, Volume 2, p. 392,\nCabin furniture received onboard the U.S.F. Constellation at Washington […] 1 Cleaver and tormentors/Cook; [footnote:] A tormentor is a long iron meat fork used by sea cooks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ba7aa38-d1be-4c32-9d71-80b78b4cb483",
                        "source_entry_id": "12ff00ff-0a03-388c-bdd8-160f25394bb2",
                        "source_sense_id": "32847da6-4c2c-3a31-abf2-097ed8a41200",
                        "source_sense_description": "Person, die jemanden peinigt, die jemandem Leid zufügt, jemanden quält",
                        "target_lang_word": "bourreau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bourreau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c728c98-b7ca-3fbc-a0a0-54f87349efb7",
                                        "entry_id": "c8ba7fdb-4b65-3240-880b-35f05addbb17",
                                        "glosses": [
                                            "Qui est une cause de tourment physique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a417ae09-295b-4029-9c5d-3c18551be5ff",
                                                "sense_id": "2c728c98-b7ca-3fbc-a0a0-54f87349efb7",
                                                "text": "La nature est assez bourrelle, elle nous force assez à manger, à rechercher la boustiffe, par tombereaux, par tonnes, pour entretenir sa chaleur, elle peut bien mettre un peu de drôlerie au fond de cette damnée carcasse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bourreau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                        "entry_id": "a65ea3e0-7e5d-3f22-9a75-0ecbee5dfc44",
                                        "glosses": [
                                            "Exécuteur des arrêts rendus par les cours criminelles, chargé de la peine capitale. Préposé à la guillotine, avant la suppression de la peine de mort, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbed9199-b25b-4d06-bac7-57fd9c554c56",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "Le dernier bourreau a pris sa retraite."
                                            },
                                            {
                                                "example_id": "8e70efad-378d-4047-aea7-c0aff5b24207",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "Ne serait-il pas nécessaire d’ajouter les demandes suivantes ? Un parlement dans chaque ville capitale de province, la suppression des substitutions et enfin celle du bourreau."
                                            },
                                            {
                                                "example_id": "e9896e79-8632-4a68-b71a-6eb11c5f97c6",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "Malgré l’activité des bourreaux, les préparatifs du supplice ne purent être achevés avant le coucher du soleil."
                                            },
                                            {
                                                "example_id": "23fa155e-7158-4433-bc4e-956fd9d01039",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "Au moment où ses yeux se fermaient, où tout sentiment se dispersait en elle, elle crut sentir s'imprimer sur ses lèvres un attouchement de feu, un baiser plus brûlant que le fer rouge du bourreau."
                                            },
                                            {
                                                "example_id": "928ef904-9a4a-43c3-9781-122251679df8",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "« Mais qui êtes-vous donc? » s'écrièrent tous les témoins de cette scène.\n— Demandez-le à cette femme, dit l'homme au manteau rouge, car vous voyez bien qu'elle m'a reconnu, elle.\n— Le bourreau de Lille, le bourreau de Lille ! » s'écria Milady en proie à une terreur insensée et se cramponnant des mains à la muraille pour ne pas tomber."
                                            },
                                            {
                                                "example_id": "2edacf6a-313a-44b5-aa1c-d3c94979d320",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "— Le bourreau peut tuer, sans être pour cela un assassin, madame, dit l’homme au manteau rouge en frappant sur sa large épée : c’est le dernier juge, voilà tout. Nachrichter, comme disent nos voisins les Allemands."
                                            },
                                            {
                                                "example_id": "99584af4-bfff-4855-9483-de9f83293997",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "Demain la cour martiale, après−demain la guillotine. La Vendée est morte.\nGauvain ne répliqua pas une parole, et Cimourdain, préoccupé de la chose suprême qui lui restait à faire, le quitta. Cimourdain avait des heures à désigner et des emplacements à choisir. Il avait comme Lequinio à Granville, comme Tallien à Bordeaux, comme Châlier à Lyon, comme Saint−Just à Strasbourg, l'habitude, réputée de bon exemple, d'assister de sa personne aux exécutions ; le juge venant voir travailler le bourreau ; usage emprunté par la Terreur de 93 aux parlements de France et à l'inquisition d'Espagne."
                                            },
                                            {
                                                "example_id": "f20a75bd-4ea7-4532-b2fb-5e458a47d21d",
                                                "sense_id": "58abb670-784e-39ff-aadf-ecf5d47ae49e",
                                                "text": "Les bourreaux doivent savourer la même omnipotence, se livrer à pareille furie, goûter une égale joie de meurtrir sans remords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78d249e2-38fd-36a1-a5b3-a3752d5c6ea3",
                                        "entry_id": "a65ea3e0-7e5d-3f22-9a75-0ecbee5dfc44",
                                        "glosses": [
                                            "Homme cruel, inhumain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a248de-a845-478b-abf3-667fb0f402dc",
                                                "sense_id": "78d249e2-38fd-36a1-a5b3-a3752d5c6ea3",
                                                "text": "C’est un vrai bourreau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7164242b-4850-3d5e-876c-71fc172367c2",
                                        "entry_id": "a65ea3e0-7e5d-3f22-9a75-0ecbee5dfc44",
                                        "glosses": [
                                            "Personne qui ne ménage pas les autres ou soi-même."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2837efb-e620-44ad-80ec-1b820c2bce24",
                                                "sense_id": "7164242b-4850-3d5e-876c-71fc172367c2",
                                                "text": "C’est un vrai bourreau de travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "533629f5-a3ff-3f96-a044-af0642e2045a",
                                        "entry_id": "a65ea3e0-7e5d-3f22-9a75-0ecbee5dfc44",
                                        "glosses": [
                                            "Homme excessif."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f541a1c2-c76e-42e7-8f1d-8ac6556fb5ae",
                                                "sense_id": "533629f5-a3ff-3f96-a044-af0642e2045a",
                                                "text": "C’est un bourreau de travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db6b865-9df5-32ec-89d8-000c838f87d9",
                                        "entry_id": "a65ea3e0-7e5d-3f22-9a75-0ecbee5dfc44",
                                        "glosses": [
                                            "Tourment de l'âme, mauvaise conscience, remords ou passion pénible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a58e6e-87fa-4b08-89d3-4a18053d5d8f",
                                                "sense_id": "6db6b865-9df5-32ec-89d8-000c838f87d9",
                                                "text": "Cet homme paraît faire tout ce qu'il veut : mais il s'en faut bien qu'il ne le fasse ; il fait tout ce que veulent ses passions féroces ; il est toujours entraîné par son avarice, par sa crainte, par ses soupçons. Il paraît maître de tous les autres hommes : mais il n'est pas maître de lui-même; car il a autant de maîtres et de bourreaux qu'il a de désirs violents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c42d6aee-9891-3a36-aec1-5caeff2fd03e",
                                        "entry_id": "a65ea3e0-7e5d-3f22-9a75-0ecbee5dfc44",
                                        "glosses": [
                                            "Terme de reproche, expression d’humeur et d’impatience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b299d5a-ebcf-4b6b-81d0-b261ba27273d",
                                                "sense_id": "c42d6aee-9891-3a36-aec1-5caeff2fd03e",
                                                "text": "Eh bien, bourreau, t’expliqueras-tu ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bourreau",
                                "target_lang_code": "fr",
                                "target_senses": [
