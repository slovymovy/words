                    {
                        "sense_id": "d10d1995-f945-3136-9b49-db84fbe18036",
                        "entry_id": "c10520d8-d76f-305c-8384-956195a27299",
                        "glosses": [
                            "de plaats waar de kardinalen van de Katholieke Kerk bijeenkomen om de paus te kiezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ecbe5e9-b23d-491e-81c4-39bc9e09ad3b",
                                "sense_id": "d10d1995-f945-3136-9b49-db84fbe18036",
                                "text": "Het volk maakte van het conclave, trots de strengste verboden, een gokpartij alsof het een wedren gold. Ook heden staan trouwens in de loterijkantoortjes reeds de reclameborden uitgestald met de nummers, die men Zaterdag in het wekelijksche „lotto” spelen moet om een winstje te halen uit den dood van Pius XI’."
                            },
                            {
                                "example_id": "028d89dc-608d-49f3-960b-0af3cbe1438c",
                                "sense_id": "d10d1995-f945-3136-9b49-db84fbe18036",
                                "text": "Conclave beteekent ‘gesloten vertrek.’ Dewijl nu in zulk een vertrek, waarmede vele kleinere kamers of cellen in verband staan, doorgaans in het groote paleis van het Vaticaan daartoe gereed gemaakt, de keuze van een Paus geschiedt, draagt ook de vergadering zelve der Kardinalen, die een Paus moeten kiezen, den naam van conclave."
                            }
                        ]
                    }
