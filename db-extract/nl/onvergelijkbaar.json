                                "target_word": "incomparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "384b2962-e9f7-348e-9cb2-011cbffb3fee",
                                        "entry_id": "87520ea0-710e-33cf-beb2-cde9c84f4e4a",
                                        "glosses": [
                                            "Not comparable."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a3b00a6-d8ea-3c7c-85a6-8e6724c03424",
                                        "entry_id": "87520ea0-710e-33cf-beb2-cde9c84f4e4a",
                                        "glosses": [
                                            "So much better than another as to be beyond comparison."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82ea953-130f-4662-ba9e-00482306a949",
                                                "sense_id": "2a3b00a6-d8ea-3c7c-85a6-8e6724c03424",
                                                "text": "I know of nothing in all drama more incomparable from the point of view of art, nothing more suggestive in its subtlety of observation, than Shakespeare's drawing of Rosencrantz and Guildenstern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a8ccf02-198e-3932-a5dc-d1fe07377447",
                                        "entry_id": "74abfcc5-2770-3477-8472-a5ac48a6be84",
                                        "glosses": [
                                            "Something beyond compare; a thing with which there is no comparison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b8a8f31-19ad-4114-b581-d84935984c38",
                        "source_entry_id": "5ff1c2be-feb8-3707-8cd5-5fb47ac6e608",
                        "source_sense_id": "50434448-f439-3beb-846c-95e7bf3d4e2e",
                        "source_sense_description": "niet te vergelijken",
                        "target_lang_word": "incomparable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                        "entry_id": "412c659c-07e4-3d6e-ac8d-7e453306143a",
                                        "glosses": [
                                            "À qui ou à quoi rien ne peut être comparé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f1ae0b-ee3b-4ebe-895c-f889c3efa33f",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Puis, après une demi-heure d’un incomparable éclat, sans qu’il se fût resserré ni concentré, sans un amoindrissement même partiel de sa lumière, le splendide météore s'éteignit soudain, […]."
                                            },
                                            {
                                                "example_id": "21625221-a492-45dc-bc68-e02e9b093e04",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Au bout d'une heure nous atteignons la cime, du haut de laquelle on domine tout l'archipel féroésien; contemplée au crépuscule de minuit, cette vue est d'une incomparable magnificence."
                                            },
                                            {
                                                "example_id": "22bfca14-af4c-4349-bed3-a2c21f0a7698",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Ce chef de gouvernement capable de discuter avec Einstein la théorie de la relativité de l'espace et du temps emprunte à sa vie intérieure un incomparable prestige."
                                            },
                                            {
                                                "example_id": "c94605fd-d948-4b61-847d-86b5c9e52cc6",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Le Caux est une terre à blé, mais la vallée verdoyante du Bray est un immense et magnifique pâturage où un élevage intensif se pratique dans des prés incomparables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
