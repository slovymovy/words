                        "glosses": [
                            "A speech disorder in which a person is unable to produce a grammatical or intelligible sentence."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56efcdc6-9a1b-4a80-81b4-ce0c97bf9240",
                                "sense_id": "c290ef1b-ccdf-3347-85e8-0bfafd9d696d",
                                "text": "On the other hand, when answering she always tended to limit her answer to the linguistically essential minimum, and sometimes she ended in some slight agrammaphasia […]"
                            },
                            {
                                "example_id": "02b90549-77bb-4e7e-a61e-9314c76c93f9",
                                "sense_id": "c290ef1b-ccdf-3347-85e8-0bfafd9d696d",
                                "text": "Mixed aphasia: characterized by such disorders as agrammaphasia, syntactical aphasia, word-salad speech, groping speech, repetitious speech or paraphasia."
                            },
                            {
                                "example_id": "8132eabf-96b4-4d44-885e-93945f08bda1",
                                "sense_id": "c290ef1b-ccdf-3347-85e8-0bfafd9d696d",
                                "text": "Broca's aphasia involves a deficit with regard to combining phonemes (word simplification associated with phonetic disintegration) and combining words (decrease in volume of voice, stereotypy, agrammaphasia)."
                            }
                        ]
                    }
