                                        "sense_id": "7b446d88-92bf-3b1d-af18-748d362c064e",
                                        "entry_id": "fa29b108-6497-3494-a5d8-83dc410672cd",
                                        "glosses": [
                                            "Synonym of malmsey (“wine”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b358cab-57d8-4a54-a9b2-51628810a033",
                                                "sense_id": "7b446d88-92bf-3b1d-af18-748d362c064e",
                                                "text": "Now this Malvoisie has a body, and slips down the red lane with an unctuous savour; […]"
                                            },
                                            {
                                                "example_id": "6075f110-f771-4d3c-be98-1d51152f3b25",
                                                "sense_id": "7b446d88-92bf-3b1d-af18-748d362c064e",
                                                "text": "Adrian stood and refilled Shelagh's glass. ‘A little more malvoisie for you?’"
                                            },
                                            {
                                                "example_id": "ecf783ae-6b82-4955-bd1e-117db7073317",
                                                "sense_id": "7b446d88-92bf-3b1d-af18-748d362c064e",
                                                "text": "There, gifts were exchanged […] and Philip's mistrels performed in front of the king's mother who sat, appreciative, her customary glass of malvesey to hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
