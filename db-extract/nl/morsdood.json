                                        "sense_id": "1c5fc75b-d129-37bd-9b27-6725b19fbdde",
                                        "entry_id": "b52b1bcf-f217-365c-8d7b-ffff61e8b2b8",
                                        "glosses": [
                                            "Utterly dead."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39cfa26a-b308-41ed-b920-79e3aaef3f43",
                                                "sense_id": "1c5fc75b-d129-37bd-9b27-6725b19fbdde",
                                                "text": "'I congratulate you; it was a lovely shot, and mine were vile.' We got out of the boat and ran to the buck, which was shot through the spine and stone dead."
                                            },
                                            {
                                                "example_id": "5c263e92-5bd5-498b-9c5c-8e3f7f8e61b7",
                                                "sense_id": "1c5fc75b-d129-37bd-9b27-6725b19fbdde",
                                                "text": "[Owner]: No no he's not dead, he's, he's restin'! Remarkable bird, the Norwegian Blue, idn'it, ay? Beautiful plumage!\n[Mr. Praline]: The plumage don't enter into it. It's stone dead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7043577c-7929-48fb-8cda-083a462712f8",
                        "source_entry_id": "23337983-be08-360f-b976-aaa485b909ab",
                        "source_sense_id": "0fc7707b-bba0-3b43-a975-ec70673d2496",
