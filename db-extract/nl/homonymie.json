                                "example_id": "eaf22c8f-ef4f-4391-bf47-507ded005835",
                                "sense_id": "3bcb5820-6b54-332e-af7f-7820e4ad7b50",
                                "text": "In ons land kwam de homonymie slechts sporadisch ter sprake."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb3a2b22-1dca-497d-b993-a327403f8e63",
                        "source_entry_id": "93df598b-4fb2-385b-bf66-41bebc82f3ae",
                        "source_sense_id": "3bcb5820-6b54-332e-af7f-7820e4ad7b50",
                        "target_lang_word": "Homonymie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homonymie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce98bab8-b0f7-3644-b821-35bfbfc4e3ba",
                                        "entry_id": "1f82e78e-d1c0-3b3f-ae8c-3d36ec1314c5",
                                        "glosses": [
                                            "gleiche Wortform bei Wörtern, die verschiedene Bedeutungen haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7890afc8-86f5-44ba-868b-3cb45821cc8c",
                                                "sense_id": "ce98bab8-b0f7-3644-b821-35bfbfc4e3ba",
                                                "text": "Die Wörter Schloss (= herrschaftliches Gebäude) und Schloss (= Schließvorrichtung, z. B. an einer Tür) weisen Homonymie in beiden Formen auf: zwischen ihnen besteht sowohl Homographie als auch Homophonie."
                                            },
                                            {
                                                "example_id": "32583e5b-1175-49dc-a5d8-48b07d1fdb09",
                                                "sense_id": "ce98bab8-b0f7-3644-b821-35bfbfc4e3ba",
                                                "text": "„Dazu gehören auch die Abgrenzung von Polysemie und Homonymie und die Darstellung der Bedeutungsstruktur eines Wortes.“"
                                            },
                                            {
                                                "example_id": "4b5b172c-d023-4167-bac4-befb0605a0a0",
                                                "sense_id": "ce98bab8-b0f7-3644-b821-35bfbfc4e3ba",
                                                "text": "„Sind zwei ursprungsverschiedene Wörter gleichlautend, so nennt man dies eine Homonymie (sind sie nicht ganz gleichlautend, eine Paronymie).“"
                                            },
                                            {
                                                "example_id": "21ee9842-e493-4068-a13f-e2456364bbc0",
                                                "sense_id": "ce98bab8-b0f7-3644-b821-35bfbfc4e3ba",
                                                "text": "„Diese Nominalphrase disambiguiert in den meisten Fällen die Homonymien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
