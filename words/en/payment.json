            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05cf3c9b-3e97-30e0-9245-aaf27050724c",
                    "sense_definition": "The act of paying money to someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_paying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company requires immediate <w>payment</w> upon delivery of the goods.",
                            "target_lang_translations": {
                                "ru": "Компания требует немедленной <w>оплаты</w> при доставке товаров.",
                                "zh": "公司要求在货物送达时立即<w>付款</w>。"
                            }
                        },
                        {
                            "text": "Late <w>payment</w> may result in additional fees on your account.",
                            "target_lang_translations": {
                                "ru": "Просроченный <w>платёж</w> может привести к начислению дополнительных комиссий на вашем счете.",
                                "zh": "逾期<w>付款</w>可能会导致您的账户产生额外费用。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-payment",
                        "nonpayment"
                    ],
                    "common_phrases": [
                        "method of payment",
                        "terms of payment",
                        "prompt payment",
                        "late payment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по передаче денег кому-либо.",
                        "zh": "支付金钱的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплата",
                                "target_lang_sense_clarification": "действие по внесению денег за что-либо"
                            },
                            {
                                "target_lang_word": "платёж",
                                "target_lang_sense_clarification": "финансовая операция, перевод денег"
                            },
                            {
                                "target_lang_word": "уплата",
                                "target_lang_sense_clarification": "внесение денег в погашение обязательства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支付",
                                "target_lang_sense_clarification": "指付钱的行为或过程"
                            },
                            {
                                "target_lang_word": "付款",
                                "target_lang_sense_clarification": "指交付货款的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eb89410-0f3c-3259-8fbe-0395a0969e08",
                    "sense_definition": "An amount of money paid for goods or services.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "money_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a large down <w>payment</w> on the new house.",
                            "target_lang_translations": {
                                "ru": "Он сделал большой первоначальный <w>взнос</w> за новый дом.",
                                "zh": "他为新房支付了一笔大额<w>首付</w>。"
                            }
                        },
                        {
                            "text": "Her car requires a monthly <w>payment</w> of three hundred dollars.",
                            "target_lang_translations": {
                                "ru": "За её машину требуется ежемесячный <w>платёж</w> в размере трехсот долларов.",
                                "zh": "她的车每月需要支付三百美元的<w>分期款</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "down payment",
                        "monthly payment",
                        "cash payment",
                        "interest payment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, уплачиваемая за товары или услуги.",
                        "zh": "为商品或服务所支付的金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платёж",
                                "target_lang_sense_clarification": "сумма денег, подлежащая уплате"
                            },
                            {
                                "target_lang_word": "плата",
                                "target_lang_sense_clarification": "денежное вознаграждение или цена"
                            },
                            {
                                "target_lang_word": "выплата",
                                "target_lang_sense_clarification": "выплаченная сумма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "款项",
                                "target_lang_sense_clarification": "指具体的金额或款项"
                            },
                            {
                                "target_lang_word": "费用",
                                "target_lang_sense_clarification": "指为服务或商品支付的代价"
                            }
                        ]
                    }
                }
            ]
        },
