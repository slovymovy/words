                                "sense_id": "2fe30123-6a6e-3298-92ae-db7cd7552745",
                                "text": "„Irgendwann werden die Kräne mit den Abrissbirnen anrücken.“"
                            },
                            {
                                "example_id": "316b2098-09c2-4d82-a409-7b61b18de36b",
                                "sense_id": "2fe30123-6a6e-3298-92ae-db7cd7552745",
                                "text": "„Seitdem haben die Valencianer die Baustellen ertragen, den Lärm der Abrissbirnen, Betonmischmaschinen und Kräne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
