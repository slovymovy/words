                        "glosses": [
                            "Qualifie une chaussure pouvant être équipée de crampons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509b0353-b320-48f2-9020-e237c5dea2bb",
                                "sense_id": "efba13cc-48c0-38f4-a2a1-02135da4a758",
                                "text": "Avec ses 880 g la paire, elle est bien plus légère qu’une chaussure d’alpinisme. Sa semelle est toutefois rigide, et possède un débord arrière pour être cramponnable."
                            },
                            {
                                "example_id": "4041c47b-2b29-459f-8dec-4e6784e80335",
                                "sense_id": "efba13cc-48c0-38f4-a2a1-02135da4a758",
                                "text": "Les G Trek 4 et G Trek 5 sont conçues pour accompagner le trekkeur sur les sentiers techniques des Alpes et de l’Himalaya, mais également sur les courses d’alpinisme sur neige et glacier, les deux modèles étant cramponnables."
                            },
                            {
                                "example_id": "9da0ba90-62c7-4acc-bf80-cdaea94b3b89",
                                "sense_id": "efba13cc-48c0-38f4-a2a1-02135da4a758",
                                "text": "Le matériel personnel de montagne à prévoir est : chaussures cramponnables, lunettes de soleil, gants, vêtements chauds et si possible crampons, baudrier et casque."
                            }
                        ]
                    }
