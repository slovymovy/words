                                                "example_id": "7fc74c7b-3ca6-4ce9-b5d7-faa75823a803",
                                                "sense_id": "3ff35c82-d2d3-3497-bbb8-0c7d21e08ce6",
                                                "text": "De ondergang van de Klassieke Mayacultuur is nog altijd raadselachtig."
                                            },
                                            {
                                                "example_id": "9f1386e2-52ac-4c99-b59d-1dc3a0018e63",
                                                "sense_id": "3ff35c82-d2d3-3497-bbb8-0c7d21e08ce6",
                                                "text": "Mathematicus Spina, die voor desen treffelijck getroffen heeft, deselve prognosticeert des Turcken ondergang in den Iare 1650. desgelijcx doetoock een Monnick , dewelcke over Vranckrijck in Polen ghe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "699eab6d-1499-3479-b552-d00dbacdb61b",
                                        "entry_id": "14bad232-f273-3d7c-a24e-e28de27e3f6d",
                                        "glosses": [
                                            "het kapot gaan van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de35e6c-18fc-4f27-b86b-b1769fb2d17c",
                                                "sense_id": "699eab6d-1499-3479-b552-d00dbacdb61b",
                                                "text": "Als de aanstaande ondergang van het Aquarium dit jaar het sombere nieuwtje binnen de familie was, dan was het des te merkwaardiger dat hij bij zijn broer thuis was om te vieren wat juist de grootste vreugde van de familie was geweest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d8636c8-5354-3bb8-9401-f71e74fc5f8e",
                                        "entry_id": "14bad232-f273-3d7c-a24e-e28de27e3f6d",
                                        "glosses": [
                                            "de dood of het verzinken in ellende van een persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c41780-a4be-4e73-8eed-5db788145dcd",
                                                "sense_id": "7d8636c8-5354-3bb8-9401-f71e74fc5f8e",
                                                "text": "De drank wordt nog je ondergang als je zo doorzuipt!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ed96612-5954-421e-b8e3-8e1fa21f3685",
                        "source_entry_id": "d489cb64-55b9-3bef-8e2d-87b107524e15",
                        "source_sense_description": "(Figuré) État de décadence",
                        "target_lang_word": "verloedering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verloedering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9882f1a8-e5a2-3e45-b621-e8483136dd4a",
                                        "entry_id": "3e611890-4483-3659-8597-dee12237f2bf",
                                        "glosses": [
                                            "door slecht onderhoud en leegstand steeds lelijker en armoediger worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77edd255-3a42-4552-87f4-b25ba24a6955",
                                                "sense_id": "9882f1a8-e5a2-3e45-b621-e8483136dd4a",
                                                "text": "De strijd tegen verloedering door graffiti-vandalen langs onze snelwegen moet worden opgevoerd. De stadsbesturen van Rotterdam en Den Haag vragen in een brandbrief om ingrijpen door minister Van Nieuwenhuizen (Infrastructuur)."
                                            },
                                            {
                                                "example_id": "32eaf813-ce6e-41fe-9953-146e4f1d8b57",
                                                "sense_id": "9882f1a8-e5a2-3e45-b621-e8483136dd4a",
                                                "text": "Het PBL ziet geen bewijs dat kantorenleegstand ook een maatschappelijk probleem is. Er lijkt geen sprake te zijn van verloedering en leefbaarheidsproblemen, met bijvoorbeeld dalende huizenprijzen tot gevolg. Leegstand is dan ook vooral het probleem van de verhuurder die inkomsten misloopt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
