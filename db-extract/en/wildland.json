                                        "entry_id": "30afe053-31fb-3947-bedf-31789e5eb0de",
                                        "glosses": [
                                            "een bosachtig gebied dat weinig door de mens geregeld is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90da9bb3-ac50-4ee2-9e3f-21c77d366777",
                                                "sense_id": "cdeeab51-3e61-3d03-93fd-8ccbf369441f",
                                                "text": "Hij trok zich enige tijd terug in de wildernis."
                                            },
                                            {
                                                "example_id": "c1002a34-810f-4868-8f37-a029e6e4db99",
                                                "sense_id": "cdeeab51-3e61-3d03-93fd-8ccbf369441f",
                                                "text": "Ik wilde met mijn hele hebben en houden op mijn rug in de overweldigende wildernis van Amerika slapen onder de sterren, nieuwe mensen ontmoeten, alleen met mijn gedachten door de bossen lopen en de vrijheid hebben om te gaan en te staan waar ik wilde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
