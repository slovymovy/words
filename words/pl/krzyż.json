                {
                    "sense_id": "c0edd0b0-bc7c-3598-8d50-466a7b0b1c51",
                    "sense_definition": "Odznaczenie państwowe lub wojskowe w kształcie krzyża.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Za swoje zasługi żołnierz otrzymał <w>Krzyż</w> Walecznych.",
                            "target_lang_translations": {
                                "ru": "За свои заслуги солдат получил <w>Крест</w> Храбрых.",
                                "en": "For his service, the soldier received the <w>Cross</w> of Valour."
                            }
                        },
                        {
                            "text": "Prezydent uroczyście wręczył weteranom pamiątkowe <w>krzyże</w>.",
                            "target_lang_translations": {
                                "ru": "Президент торжественно вручил ветеранам памятные <w>кресты</w>.",
                                "en": "The president ceremoniously presented the veterans with commemorative <w>crosses</w>."
                            }
