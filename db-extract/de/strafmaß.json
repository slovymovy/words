                "senses": [
                    {
                        "sense_id": "03ada923-7397-30eb-8d15-87f2e62e534d",
                        "entry_id": "414514b8-f0e5-3b06-9e08-5756c7ee39a3",
                        "glosses": [
                            "(gerichtlich/gesetzlich festgelegte) Höhe und Art der Strafe für ein Vergehen"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4d623e63-7edd-4fb0-bae5-75861d9d1b75",
                                "sense_id": "03ada923-7397-30eb-8d15-87f2e62e534d",
                                "text": "„Dem Arzt droht eine Gefängnisstrafe von bis zu zehn Jahren. Sollten ihm und seinem mutmaßlichen Komplizen ein gewerbs- oder bandenmäßiges Delikt nachgewiesen werden, sieht das 2015 verabschiedete Antidopinggesetz dieses Strafmaß vor.“"
                            },
                            {
                                "example_id": "42615727-2cbe-4327-8405-f54cd87a11d9",
                                "sense_id": "03ada923-7397-30eb-8d15-87f2e62e534d",
                                "text": "„Der neue Gefängnisdirektor macht seinen ersten Rundgang und fragt die Häftlinge nach Strafmaß und Grund der Verurteilung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
