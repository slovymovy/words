                                "example_id": "0debff55-956c-4589-ac9a-61cc171de302",
                                "sense_id": "62d098a8-3c2a-3f79-ba1c-eac67beb610d",
                                "text": "Protrusion globale, médiane, postéro-latérale ou latéralisée."
                            },
                            {
                                "example_id": "67aeb1ab-1112-4663-a2e4-615b618726d0",
                                "sense_id": "62d098a8-3c2a-3f79-ba1c-eac67beb610d",
                                "text": "Elles veulent que leur vulve soit plate, sans aucune protrusion en dehors des grandes lèvres…"
                            }
                        ]
                    },
