                        "examples": [
                            {
                                "example_id": "d2693724-446d-41be-8e9c-c35db53e139c",
                                "sense_id": "0ef415d2-2002-3452-9407-2d4ea27caa4e",
                                "text": "Bitte vergessen Sie nicht, Frau Müller noch vor Ihrem Urlaub die Autorisation für den Kleinteileeinkauf zu erteilen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
