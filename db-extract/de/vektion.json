                "senses": [
                    {
                        "sense_id": "d7ce908f-911a-37bd-9963-de769c71406a",
                        "entry_id": "746efedc-47f2-3095-9ec4-aec723086320",
                        "glosses": [
                            "durch visuelle oder andere sensorische Sinneseindrücke eines ruhenden Beobachters induzierte Illusion der eigenen Bewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5690dc0-284a-43b7-84e8-3099eb7f2c16",
                                "sense_id": "d7ce908f-911a-37bd-9963-de769c71406a",
                                "text": "Dieses Phänomen, das als Vektion bezeichnet wird, begegnet und regelmäßig bei Zugreisen."
                            },
                            {
                                "example_id": "422ed71b-ddd1-4cac-abd5-4d0b0e68a30f",
                                "sense_id": "d7ce908f-911a-37bd-9963-de769c71406a",
                                "text": "Dies würde die Wahrnehmung der optokinetisch induzierten Vektion stabilisieren und gegenüber Störreizen durch unwillkürliche Kopfbeschleunigungen in anderen Ebenen als der Fortbewegungsebene schützen."
                            },
                            {
                                "example_id": "96e47f89-85c6-46ea-8258-135dc3413edd",
                                "sense_id": "d7ce908f-911a-37bd-9963-de769c71406a",
                                "text": "Die wahrgenommene Eigenbewegung in Flugsimulatoren beruht ebenso auf Vektion wie die Bewegungswahrnehmung beim Fahren in Fahrzeugen mit konstanter Geschwindigkeit."
                            },
                            {
                                "example_id": "7718dd9a-cc8d-4700-aee7-0d4a98a64a5d",
                                "sense_id": "d7ce908f-911a-37bd-9963-de769c71406a",
                                "text": "Vektion kommt durch die Verbindungen der Netzhaut mit den Vestibulariskernen und die Interaktion des zentralen visuellen Systems mit den vestibulären Regionen der Großhirnrinde zustande."
                            },
                            {
                                "example_id": "8f98ec34-065e-4cd1-9dd9-d9070be649cc",
                                "sense_id": "d7ce908f-911a-37bd-9963-de769c71406a",
                                "text": "In einer Serie von Vektionsexperimenten fanden wir folgende Ergebnisse: Eine photorealistische Szene eines Raumes verstärkt die Vektion, verglichen zu abstrakten visuellen Stimuli, die keine räumliche Interpretation zulassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
