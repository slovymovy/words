    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                "word": "shocker",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cf834e38-d49c-4d02-b69b-012862b08776",
                        "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "shockers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e67763dc-d786-30ab-be3e-f60affc33416",
                        "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                        "glosses": [
                            "One who or that which shocks or startles."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "24243454-78fc-40a3-b263-2383a12d9fbb",
                                "sense_id": "e67763dc-d786-30ab-be3e-f60affc33416",
                                "text": "The election results were a real shocker."
                            }
                        ]
                    },
                    {
                        "sense_id": "783b6cbf-ba46-370f-84c4-2143af75bd6b",
                        "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                        "glosses": [
                            "A device for giving electric shocks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c82820-2236-49d7-b0ac-d03092997bc2",
                                "sense_id": "783b6cbf-ba46-370f-84c4-2143af75bd6b",
                                "text": "Olimar: 'This shocker was one of several weapons wielded by the nightmarish titan dweevil. It allowed the creature to smite Pikmin with zaps of lightning!'"
                            },
                            {
                                "example_id": "bb2b9b82-e8cc-4afa-8e43-6ce4962529f1",
                                "sense_id": "783b6cbf-ba46-370f-84c4-2143af75bd6b",
                                "text": "Recently, the family decided that some obedience training would be of great value. The cost of doggie school being what it is, my daughter opted to purchase a shocker collar instead."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8ed82c0-4ae0-3798-8b04-f7d9cabb66f5",
                        "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                        "glosses": [
                            "Something done very badly."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bda79c3e-62e9-4779-89a1-5738ff98f186",
                                "sense_id": "a8ed82c0-4ae0-3798-8b04-f7d9cabb66f5",
                                "text": "My performance today was an absolute shocker, I just wasn't feeling it."
                            }
                        ]
                    },
                    {
                        "sense_id": "a28270ad-e369-3212-a5a3-766f4ef8a9f1",
                        "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                        "glosses": [
                            "Synonym of stooker."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "882351fa-bd1d-4c22-8f57-ce5e87d52a90",
                                "sense_id": "a28270ad-e369-3212-a5a3-766f4ef8a9f1",
                                "text": "The mechanical shocker is attached to the ordinary binder by two tubular stays, the more important one passing from about the center of the bull wheel and supporting a chain and sprocket wheel which transmit the drive to the shocker."
                            }
                        ]
                    },
                    {
                        "sense_id": "f203185e-43f6-3acd-85b7-279b02f45035",
                        "entry_id": "cea51371-1680-3135-9cb9-1b5b6d8187c9",
                        "glosses": [
                            "An offensive hand gesture suggesting two in the pink, one in the stink."
                        ],
                        "tags": [
                            "colloquial",
                            "slang",
                            "vulgar"
                        ],
                        "examples": []
                    }
                ],
