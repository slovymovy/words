                        "glosses": [
                            "Extremely happy or celebratory; overjoyed."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7c875c6f-636a-43f9-817f-e3c4456602f1",
                                "sense_id": "369c7e15-6b30-37b0-b972-39dbe47c52c6",
                                "text": "Sir John when he heard it was over-joyous."
                            },
                            {
                                "example_id": "c175f3aa-f6a3-4845-be52-19ee585aa361",
                                "sense_id": "369c7e15-6b30-37b0-b972-39dbe47c52c6",
                                "text": "I, Aurora Leigh, was born\nTo make my father sadder, and myself\nNot overjoyous, truly."
                            },
                            {
                                "example_id": "afc580be-f13f-4f64-8dd0-d7556dda8c49",
                                "sense_id": "369c7e15-6b30-37b0-b972-39dbe47c52c6",
                                "text": "Sometimes there was a celebration. One or two members of the little community were inclined to become a trifle over joyous too often for their health."
                            },
                            {
                                "example_id": "3f9c3507-dd8b-4eb7-b9d5-fae7e02e4513",
                                "sense_id": "369c7e15-6b30-37b0-b972-39dbe47c52c6",
                                "text": "Now and then a note from the bugle of some overjoyous youths as he entered the forest, brought a frown upon the brow of old Congo."
                            }
                        ]
                    }
                ],
