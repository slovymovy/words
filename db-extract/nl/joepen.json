                                "sense_id": "734bf1e2-624d-31ec-a454-320b309dcb47",
                                "text": "Enige weken geleden werd mijn fiets gejoept."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f327ee9-4382-347e-b8ba-864b62a4a074",
