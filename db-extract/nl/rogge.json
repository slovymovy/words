                                                "example_id": "49f46b9d-cd3f-4597-b117-1b37127d3845",
                                                "sense_id": "d28789f7-36ba-390e-a40a-5f245bb689aa",
                                                "text": "Мешок ржи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5e0f77-03b8-33a8-b49a-d1a88a7590a8",
                                        "entry_id": "f85fc709-8cba-3e3f-a91f-771df6e93029",
                                        "glosses": [
                                            "мн. ч. растущая рожь; ржаное поле (рег.)"
