                "senses": [
                    {
                        "sense_id": "517ee6bc-9024-3052-9e80-d5c187d54efd",
                        "entry_id": "70390678-7a5d-3bec-ae51-1632505d7a95",
                        "glosses": [
                            "Tier, das in einer Gruppe zusammengehöriger Tiere (Herde, Rudel ...) eine führende Rolle spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a81efd-af9f-4f08-81af-6b33b6c2433a",
                                "sense_id": "517ee6bc-9024-3052-9e80-d5c187d54efd",
                                "text": "„Das aggressivste Huhn, das zuoberst auf der Stufenleiter steht, bezeichnet man als Alphatier; es ist der Despot, der alle anderen Hühner hackt, selbst aber von keinem gehackt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b44ce302-910f-3714-b878-a5eae81e6a7d",
                        "entry_id": "70390678-7a5d-3bec-ae51-1632505d7a95",
                        "glosses": [
                            "in einer Gruppe dominante Person"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ea0272ac-74b6-4459-9404-f168e9a8f6ff",
                                "sense_id": "b44ce302-910f-3714-b878-a5eae81e6a7d",
                                "text": "„Die Mitangeklagten beschreiben ihn als Alphatier.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
