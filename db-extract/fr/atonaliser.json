                "senses": [
                    {
                        "sense_id": "c84ecf4b-33ce-39cb-b1f4-d74d38edab08",
                        "entry_id": "72c0bcdc-399d-36a6-9b69-df20253b6f29",
                        "glosses": [
                            "Donner un caractère atonal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7e71ae-72cf-4217-b5bd-e8bba6f27bfd",
                                "sense_id": "c84ecf4b-33ce-39cb-b1f4-d74d38edab08",
                                "text": "(...) j’en arrivais à oublier l’irrémédiable que j’étais en train de vivre pour ne plus penser qu’à dramatiser mes répliques ; ou, au contraire, à les atonaliser, à affûter mes raisonnements, déjà noyés dans une semi-ivresse, à prévoir ceux qu’Amélie allait arracher à son désarroi."
                            },
                            {
                                "example_id": "12bd3bd1-dcd2-481b-9a80-9c3644ec78bb",
                                "sense_id": "c84ecf4b-33ce-39cb-b1f4-d74d38edab08",
                                "text": "Un envol flambant neuf pour vidéotrompettiser l'atmosphère, exécuter l'imprévisible, tonaliser l'apparence, atonaliser l'évidence, instrumentiser l'éphémère."
                            }
                        ]
                    }
