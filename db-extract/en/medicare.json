                        "entry_id": "7d3363b4-c259-3b15-b609-fa5031f9f2e6",
                        "glosses": [
                            "The system of government subsidies for health care for the elderly and disabled."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "d13c2468-e399-4f94-b6d9-76de92aa1ebc",
                                "sense_id": "8b7cdac6-2644-34ed-a7b5-8e290ed0960d",
                                "text": "My mom started getting Medicare last week."
                            },
                            {
                                "example_id": "d9ebd05d-e1ee-4a2c-848d-0a0ec8120c6d",
                                "sense_id": "8b7cdac6-2644-34ed-a7b5-8e290ed0960d",
                                "text": "One Nation, a new 501(c)4 linked to the Karl-Rove-backed American Crossroads super PAC, is spending more than $1.9 million on print, radio and digital ads highlighting the efforts of Illinois Sen. Mark Kirk, North Carolina Sen. Richard Burr, New Hampshire Sen. Kelly Ayotte, Ohio Sen. Rob Portman and Pennsylvania Sen. Pat Toomey to pass the “doc fix” legislation that realigned payments to Medicare providers with inflation."
                            }
                        ]
                    },
                    {
                        "sense_id": "f328cac4-51d9-3fad-9905-f9fe6a0ebfb3",
                        "entry_id": "7d3363b4-c259-3b15-b609-fa5031f9f2e6",
                        "glosses": [
                            "The publicly funded universal health care system, operated by the government authority Medicare Australia."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "d1aaac4f-d790-478d-869d-56a51e7d38de",
                                "sense_id": "f328cac4-51d9-3fad-9905-f9fe6a0ebfb3",
                                "text": "Medicare benefits are available to all persons ordinarily resident in Australia with the exception of members of foreign diplomatic missions and their dependants."
                            },
                            {
                                "example_id": "70a234be-36c1-4a5d-87ec-ed7c254b2ac7",
                                "sense_id": "f328cac4-51d9-3fad-9905-f9fe6a0ebfb3",
                                "text": "All Australians are covered by Medicare, which is a universal insurance system controlled by the Australian Government through Commonwealth–State Health Care Agreements."
                            },
                            {
                                "example_id": "016be3a5-0ae6-437e-9f08-ff59893b510f",
                                "sense_id": "f328cac4-51d9-3fad-9905-f9fe6a0ebfb3",
                                "text": "Aside from Medicare, Australia′s universal health care system, most other support is income- or means-tested, depending on the level of income and assets of the care recipient, with some residents required to pay a daily fee to contribute to their care."
                            }
                        ]
                    },
