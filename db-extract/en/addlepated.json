                        "glosses": [
                            "Addled; confused; stupid; flustered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd10996-5921-4fcf-a5c2-c77a60f8f3c1",
                                "sense_id": "ac92b668-7a23-350f-bad5-a50cc506e2c9",
                                "text": "Let euery idle addle-pated gull\nWith stinking sweet Tobacco stuffe his skull."
                            },
                            {
                                "example_id": "f73c0555-2d0a-4284-8595-9bb378aededd",
                                "sense_id": "ac92b668-7a23-350f-bad5-a50cc506e2c9",
                                "text": "Hallo father, here’s Pecksniff! He gets more addle-pated every day he lives, I do believe,’ muttered Jonas, shaking his honoured parent roundly."
                            },
                            {
                                "example_id": "666870a4-e2f4-49d9-b3cc-68af70ef7bb9",
                                "sense_id": "ac92b668-7a23-350f-bad5-a50cc506e2c9",
                                "text": "“[…] I don’t really know if I’m doing right—it may make you more addle-pated than ever—but you can ask Diana to come over and spend the afternoon with you and have tea here.”"
                            },
                            {
                                "example_id": "fc63a1f8-bfcb-4157-b38b-1f4afc4b4e35",
                                "sense_id": "ac92b668-7a23-350f-bad5-a50cc506e2c9",
                                "text": "“Do you actually expect me to wander the world as if I were an addlepated bald woman escaped from the circus?” she would say."
                            },
                            {
                                "example_id": "851437ff-c877-4ede-bbad-f07038ad91f7",
                                "sense_id": "ac92b668-7a23-350f-bad5-a50cc506e2c9",
                                "text": "His best-known creations are the addlepated, cheese-loving inventor Wallace, and Gromit, his patient, intelligent dog."
                            }
                        ]
                    }
