                "senses": [
                    {
                        "sense_id": "66b5341d-3557-3a7e-a4d0-5e5f7bdb81b2",
                        "entry_id": "8ed349af-5ccf-3cc7-a91c-3090905f1605",
                        "glosses": [
                            "психоактивный ядовитый алкалоид, содержащийся в различных видах эфедры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f24f4f-7399-44f7-9488-7e5b284b2d68",
                                "sense_id": "66b5341d-3557-3a7e-a4d0-5e5f7bdb81b2",
                                "text": "Это знаменитое лекарственное растение (Ephedra Sinica) содержит эфедрин, мощный стимулятор и бронхорасширитель."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0096ae8d-9b59-440d-8a97-bfb956bf262e",
                        "source_entry_id": "8ed349af-5ccf-3cc7-a91c-3090905f1605",
                        "source_sense_id": "66b5341d-3557-3a7e-a4d0-5e5f7bdb81b2",
