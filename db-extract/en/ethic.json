                "senses": [
                    {
                        "sense_id": "b43a7d17-ea28-3f37-85c6-823b828d55f9",
                        "entry_id": "5f6b32cc-fef2-3069-b481-0df4aab8aa8a",
                        "glosses": [
                            "η ηθική, η δεοντολογία, οι ηθικές αρχές που ελέγχουν ή επηρεάζουν τη συμπεριφορά ενός ατόμου"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "981f2459-4a6a-42d7-8515-f61da1cd2e75",
                                "sense_id": "b43a7d17-ea28-3f37-85c6-823b828d55f9",
                                "text": "Christian ethics - Χριστιανική ηθική"
                            },
                            {
                                "example_id": "03bc41a1-7a8f-42b6-aa8b-58909cc5adac",
                                "sense_id": "b43a7d17-ea28-3f37-85c6-823b828d55f9",
                                "text": "This man has no ethics.",
                                "translation": "Ο άντρας αυτός δεν έχει ηθική."
                            },
                            {
                                "example_id": "9840b425-a300-442a-bc8c-6068ea67de77",
                                "sense_id": "b43a7d17-ea28-3f37-85c6-823b828d55f9",
                                "text": "He began to question the ethics of his position.",
                                "translation": "Άρχισε να αμφισβητεί τη δεοντολογία της θέσης του."
                            },
                            {
                                "example_id": "705b7812-21d7-4a26-a7bc-4968afcd0ac5",
                                "sense_id": "b43a7d17-ea28-3f37-85c6-823b828d55f9",
                                "text": "In this case, the code of medical ethics was not adhered to.",
                                "translation": "Στην περίπτωση αυτή δεν τηρήθηκε ο κώδικας της ιατρικής δεοντολογίας."
                            }
                        ]
                    },
                    {
                        "sense_id": "76f1368e-4d7f-3c0c-a239-bbccaa0ec56e",
                        "entry_id": "5f6b32cc-fef2-3069-b481-0df4aab8aa8a",
                        "glosses": [
                            "η ηθική, σύστημα ηθικών αρχών ή κανόνων συμπεριφοράς"
                        ],
                        "tags": [
                            "singular-only"
                        ],
                        "examples": [
                            {
                                "example_id": "837249b4-0f79-47c4-a822-be0d4928c2f0",
                                "sense_id": "76f1368e-4d7f-3c0c-a239-bbccaa0ec56e",
                                "text": "The ethic of personal achievement is very strong in Western societies.",
                                "translation": "Η ηθική της προσωπικής επίτευξης είναι πολύ ισχυρή στις δυτικές κοινωνίες."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef5cfd51-041c-3adc-80d6-d4e72515023f",
                        "entry_id": "5f6b32cc-fef2-3069-b481-0df4aab8aa8a",
                        "glosses": [
                            "η ηθική"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "55647155-8b53-44cd-9f4e-11b83f77a9d4",
                                "sense_id": "ef5cfd51-041c-3adc-80d6-d4e72515023f",
                                "text": "Ethics is a branch of philosophy.",
                                "translation": "Η ηθική είναι κλάδος της φιλοσοφίας."
                            }
                        ]
                    }
