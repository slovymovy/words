                "senses": [
                    {
                        "sense_id": "3ef49ebd-8501-34f4-8ad4-3fd1ab540fa8",
                        "entry_id": "abde22e5-bc4d-3a30-a792-b33b37c31a37",
                        "glosses": [
                            "Énoncer avec quelqu'un d'autre (soit à la suite l'un de l'autre, soit en considérant quelqu'un d'autre dans ce qu'on énonce)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e23d4f-ca1a-4139-a6b4-e4043e224ce0",
                                "sense_id": "3ef49ebd-8501-34f4-8ad4-3fd1ab540fa8",
                                "text": "Cette réécriture multimédia rappelle qu'énoncer ou coénoncer est un événement profond et puissant, qui peut, de surcroît, prendre une logique figurative pour se stabiliser."
                            },
                            {
                                "example_id": "579a60ad-333c-4d5a-beeb-4df2082f9894",
                                "sense_id": "3ef49ebd-8501-34f4-8ad4-3fd1ab540fa8",
                                "text": "Le locuteur choisi bien le moment pour coénoncer, puisque la pause dramatique entre les tours de parole rend la blague plus puissante."
                            }
                        ]
                    }
