                "senses": [
                    {
                        "sense_id": "22857d46-9a1e-3a28-9b76-081b530654be",
                        "entry_id": "7c5f3e4b-20c8-3b84-a195-81c898c076d1",
                        "glosses": [
                            "Sprache, die vorwiegend in der Republik Kalmückien im Südwesten Russlands gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a41cd5-4fe5-4d85-aee2-3d3d1c64f521",
                                "sense_id": "22857d46-9a1e-3a28-9b76-081b530654be",
                                "text": "„In Kuldža wurde ein mittelasiatischer Dialekt […] unterrichtet, wahrscheinlich Kasachisch, sowie Mandschurisch, Chinesisch und Kalmückisch, was auf die Ojraten in Sinkiang abzielte.“"
                            },
                            {
                                "example_id": "3de31269-1d90-4f02-9492-57a0c3157ac0",
                                "sense_id": "22857d46-9a1e-3a28-9b76-081b530654be",
                                "text": "„Der Altaïsche Iyictu (Gottesberg) oder Alas-tau, auf Kalmückisch Kahler Berg, liegt am linken Ufer der Tschuja, und wird von den colossalen Katunja-Säulen durch den Flußs Argut getrennt.“"
                            },
                            {
                                "example_id": "b928e89c-262b-4658-a3a0-a50357c32f91",
                                "sense_id": "22857d46-9a1e-3a28-9b76-081b530654be",
                                "text": "„Unter chinesischem Einfluß gaben sie die waagrechte Schreibweise auf und schrieben senkrecht, wie auch heute noch Mongolisch, Kalmückisch und Mandschu geschrieben werden.“"
                            },
                            {
                                "example_id": "363ddd01-a214-4cd0-b74f-d0cb62468530",
                                "sense_id": "22857d46-9a1e-3a28-9b76-081b530654be",
                                "text": "„Ich? ich? nicht Deutsch! Es wäre ein verdammter Streich, wenn ich Kalmückisch redete, und wüßte es nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
