                    {
                        "sense_id": "16821564-69a7-3fd3-9b52-9bd40984c05b",
                        "entry_id": "7c89f79b-58bd-3e36-9e69-8224db81770e",
                        "glosses": [
                            "Before a depression."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "32b4f2ac-87b5-44b0-a794-5a12daf556a1",
                                "sense_id": "16821564-69a7-3fd3-9b52-9bd40984c05b",
                                "text": "Murphy et al. (1988) found that, when the effect of physical illness was controlled, depressed elderly patients (particularly men) had a significantly higher four-year mortality, suggesting that the greater mortality in the depressed group was not due to differences of pre-depression physical health alone."
                            },
                            {
                                "example_id": "6f47487e-b5d9-4fd2-a910-2f3fb3ecbafb",
                                "sense_id": "16821564-69a7-3fd3-9b52-9bd40984c05b",
                                "text": "A child who has dysthymia, or chronic mild depression, captured in the persistent depressive disorder diagnosis in DSM-5, a milder but more chronic set of symptoms over a period of at least 12 months, may not have the cognitive-developmental awareness that their depressive symptoms are different from the emotions of other children, or even their own pre-depression life."
                            },
                            {
                                "example_id": "ad09c91e-ab1a-4c6e-87dd-b8a8f61ff919",
                                "sense_id": "16821564-69a7-3fd3-9b52-9bd40984c05b",
                                "text": "When recovering or recovered from depression, as the sources I consider highlight, some people seem to have a heightened appreciation of beauty, both when compared to when they were depressed, and also when compared to their pre-depression state."
                            }
                        ]
                    }
