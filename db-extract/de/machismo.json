                    {
                        "translation_id": "da777166-5356-46da-9aaf-36a27081a251",
                        "source_entry_id": "6e17e665-5fd4-3c02-9200-1397a42c506f",
                        "source_sense_id": "daf34a95-18c7-3208-9c50-d18bd1faddae",
                        "source_sense_description": "Gefühl/Einstellung der starken Überlegenheit des Mannes",
                        "target_lang_word": "machismo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machismo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66702d90-4dc4-3e59-86d7-1c165fee163c",
                                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                                        "glosses": [
                                            "An excessive masculine pride."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee9eb93c-060d-35b8-b87a-ad22e9388850",
                                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                                        "glosses": [
                                            "exaggerated masculinity"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00fbf398-c765-4c59-b164-44654bfade14",
                                                "sense_id": "ee9eb93c-060d-35b8-b87a-ad22e9388850",
                                                "text": "September 1971, Germaine Greer, \"My Mailer Problem\", in Esquire\nThe tragedy of machismo is that a man is never quite man enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233a9e1f-05c3-3876-8348-41e3c38f4e35",
                                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                                        "glosses": [
                                            "characteristic, behavior or particularity of Male; Macheza."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92589950-76d2-32f8-b28d-75942b5f9ad5",
                                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                                        "glosses": [
                                            "male chauvinism, misogyny"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eaf5353-a94a-4530-8fbd-adfd580bdda7",
                                                "sense_id": "92589950-76d2-32f8-b28d-75942b5f9ad5",
                                                "text": "PSP [Puerto Rican Socialist Party] spokesperson Victor Lopez-Tosado told GCN: \"[…] The party is mainly organized in a Latin American country where oppression, as a result of machismo, etc., to homosexuals is very common.\""
                                            },
                                            {
                                                "example_id": "59744483-37bb-4ab5-b83a-f5862e27f847",
                                                "sense_id": "92589950-76d2-32f8-b28d-75942b5f9ad5",
                                                "text": "The Dominican Republic is traditionally regarded as a patriarchal island brimming with machismo — where, indeed, a recent U.S. ambassador was publicly vilified for bringing his husband to his posting. It was, and is, an unlikely place to find an enclave of acceptance. So what explains this unique tolerance?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e826023-dfc3-47d3-bba9-62a72379b7d8",
                        "source_entry_id": "6e17e665-5fd4-3c02-9200-1397a42c506f",
                        "source_sense_id": "daf34a95-18c7-3208-9c50-d18bd1faddae",
                        "source_sense_description": "Gefühl/Einstellung der starken Überlegenheit des Mannes",
                        "target_lang_word": "machisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                        "entry_id": "5555d107-ae46-3a9b-ad5e-cc22655018f7",
                                        "glosses": [
                                            "Culte de la virilité comprise comme une supériorité de l’homme sur la femme. Masculinité affichée, virilité revendiquée, telle que pratiquée dans les années 1970, en Amérique latine, et dans le bassin méditerranéen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db633386-b264-472c-b1a0-fe91810e62b2",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "De plus, en tant que femme elle se trouve prise dans les contradictions du machisme, tenace même dans les mouvements révolutionnaires."
                                            },
                                            {
                                                "example_id": "29aea354-f995-4695-aab6-08c21ed50f32",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "Le machisme existe à une très forte puissance en Amérique latine, pour les raisons culturelles que j’ai dites et où la religion joue son rôle, de même que la tradition guerrière. Le machisme est virulent aussi dans tout le bassin méditerranéen, aussi bien du côté du monde arabe que du monde gréco-latin"
                                            },
                                            {
                                                "example_id": "89226d4a-6587-4b15-aa10-53ac7e78bb14",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "Dans de nombreuses cultures, le machisme est admis et même bien vu."
                                            },
                                            {
                                                "example_id": "dfe289cf-f46d-4fe6-8a30-d05a439ce315",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "La tragédie du machisme est que l’homme n’est jamais assez masculin."
                                            },
                                            {
                                                "example_id": "0b6aeb31-ffb7-4b04-881a-92fdd07dc7a0",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "Le machisme représente le culte de la masculinité, prescrivant un comportement agressif pour faire sentir sa supériorité dans les rapports d’homme à homme et de l’arrogance et de l’agressivité sexuelle dans les rapports d’homme à femme."
                                            },
                                            {
                                                "example_id": "c8627a77-e253-4517-be97-d5ed18697444",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "Certes on ne se bat plus en duel. Mais c’est sans doute que le machisme meurtrier a trouvé mieux. Il s’est épanoui dans l’automobile."
                                            },
                                            {
                                                "example_id": "6c7b1dd4-7662-416e-869d-c34cf1b44da7",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "Le machisme se réfère à une idéologie fondée sur l’idée que l’homme domine la femme et qu’à ce titre il a droit à des privilèges de maître."
                                            },
                                            {
                                                "example_id": "5bc67bca-1dcc-45a0-85b9-23c84201cea8",
                                                "sense_id": "2bba53f0-b0d3-39cf-86e0-272fbb0d0cbf",
                                                "text": "Alors que les médias japonais débattent de la possibilité pour une femme de devenir impératrice en l’absence d’un descendant mâle, les propos machistes d’un ministre et d’un fonctionnaire donnent à penser que la parité au plus haut niveau de l’État nippon est loin d’être acquise dans un pays qui s’enorgueillit de compter parmi les plus avancés de la planète. Le machisme de ces messieurs se double de dédain politique à l’égard de certains de leurs concitoyens : les habitants d’Okinawa, archipel à l’extrémité sud du Japon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "machisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95295e95-8cb5-31da-b73f-d98ea9033098",
                                        "entry_id": "a5ecb899-1bcf-3094-8ae0-166313e312e2",
                                        "glosses": [
                                            "Philosophie des sciences d’Ernst Mach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47b6967e-656b-43fb-8d3a-d6af5c0a0468",
                                                "sense_id": "95295e95-8cb5-31da-b73f-d98ea9033098",
                                                "text": "Après la révolution de 1905, la doctrine marxiste fut soumise à une nouvelle révision, fondée non sur la philosophie de Kant ou de Nietzsche, mais sur le « machisme », c’est-à-dire sur les théories d’Ernst Mach, physicien viennois bien connu."
                                            },
                                            {
                                                "example_id": "f9002cef-a1aa-493e-8445-9a7f48d1158b",
                                                "sense_id": "95295e95-8cb5-31da-b73f-d98ea9033098",
                                                "text": "La seconde étape de l'évolution du positivisme est celle de l'empiriocriticisme (le « machisme ») qui se constitue à la limite du xixc et du xxe siècles. Alors que les positivistes du xix° siècle niaient qu'il fût possible de donner une réponse fondée, précise, au problème fondamental de la philosophie, les machistes (Mach, Avenarius et autres) essaient une autre façon de se défaire du matérialisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
