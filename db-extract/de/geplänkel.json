                    },
                    {
                        "sense_id": "6b2cf046-8000-3025-ab1e-d4e4433ebbd8",
                        "entry_id": "b1e4d1db-d54b-3863-b1ad-1a1f3aa22e77",
                        "glosses": [
                            "kleines Wortgefecht, Streit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619d63e8-e48b-477e-8156-6b3cbebcd6bb",
                                "sense_id": "6b2cf046-8000-3025-ab1e-d4e4433ebbd8",
                                "text": "„Dabei ist die blaue Blume kein romantisches Geplänkel ohne Daseinsschwere.“"
                            },
                            {
                                "example_id": "ffde8aba-47df-4dfc-9548-148ddf0cc2d7",
                                "sense_id": "6b2cf046-8000-3025-ab1e-d4e4433ebbd8",
                                "text": "„Unser gemütliches Geplänkel wurde unterbrochen, als eine kleine, drahtige Frau mittleren Alters mit wuscheligem Haar auftauchte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec8f8a55-33f1-4d4f-967d-366213c2bb3e",
                        "source_entry_id": "b1e4d1db-d54b-3863-b1ad-1a1f3aa22e77",
                        "source_sense_id": "12e6a4ae-0e18-38de-a15f-00bac87fceb2",
                        "source_sense_description": "Militär: kleines Gefecht neben, vor oder nach den Hauptkampfhandlungen",
                        "target_lang_word": "skirmish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skirmish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "A brief battle between small groups, usually part of a longer or larger battle or war."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2643b16a-6172-40d5-b390-7923148f0eb0",
                                                "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                                "text": "On 2 March, Chinese border guards with the help of regular PLA forces skillfully ambushed Strelnikov's unit on the ice near Chen Pao, killing him and 30 Soviets in the subsequent skirmish."
                                            },
                                            {
                                                "example_id": "ce21b10d-84e6-43ab-80b6-4ac587cca09f",
                                                "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                                "text": "The walls are slitted with embrasures through which bowmen could fire, indicating that the belfry also served as a stronghold during border skirmishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "Any minor dispute."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c49f50-992b-4728-9bf4-ca601ffb1f9a",
                                                "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                                "text": "Three people were arrested after a skirmish in a bar."
                                            },
                                            {
                                                "example_id": "2dc778bb-c64c-4afc-89bb-c0a95b8636a7",
                                                "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                                "text": "Fires which have heretofore been one‐alarm skirmishes are now multialarm small wars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5390ec15-2f52-3d7e-942c-5f24b7cb3097",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "A type of outdoor military style game using paintball or similar weapons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "skirmish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                        "entry_id": "71014977-97c1-3f67-9422-5a4f011c521d",
                                        "glosses": [
                                            "To engage in a minor battle or dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f082c05b-7707-4a2d-86e6-ab3863eefe5b",
                                                "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                                "text": "The deer and the pig and the nilghai were milling round and round in a circle of eight or ten miles radius, while the Eaters of Flesh skirmished round its edge."
                                            },
                                            {
                                                "example_id": "64c7c6b9-c63e-43b8-b698-c69c01c05f23",
                                                "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                                "text": "Other historians might also remark that […] they have persisted all this time, constantly wrestling and skirmishing and yet never destroying themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a367661-1c6b-479b-a578-ccab577addf2",
                        "source_entry_id": "b1e4d1db-d54b-3863-b1ad-1a1f3aa22e77",
                        "source_sense_id": "6b2cf046-8000-3025-ab1e-d4e4433ebbd8",
                        "source_sense_description": "kleines Wortgefecht, Streit",
                        "target_lang_word": "spat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                        "entry_id": "70ff6630-432c-3ea2-9629-567b5f6ec8c5",
                                        "glosses": [
                                            "A brief argument, falling out, quarrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3a67a7-826d-489f-81dc-ffaaabfe8fba",
                                                "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                                "text": "get into a trivial spat over punctuality"
                                            },
                                            {
                                                "example_id": "7609225f-81c6-4e50-bb4c-2abb4c742c9d",
                                                "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                                "text": "have a vicious spat with the cousins"
                                            },
                                            {
                                                "example_id": "01ebe2ec-f497-411c-b33d-7df556139363",
                                                "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                                "text": "The downside of this cost-saving strategy was that the train service could only be covered by goodwill. Whenever there was a spat between ASLEF and management - regardless of cause - the withdrawal of this goodwill became a stick with which unions could beat management."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                                        "entry_id": "570426ba-3fc6-3660-9778-1e78237e2be2",
                                        "glosses": [
                                            "simple past and past participle of spit"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5eaa82-ee72-49e1-a41d-32e80eea382f",
                                                "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                                                "text": "There was no sink in the room so we spat out the window."
                                            },
                                            {
                                                "example_id": "faf3fe4f-c7e6-49e3-8f81-2ed15d2155fd",
                                                "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                                                "text": "If I had known you had a spittoon in the corner I would never have spat on the floor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcb4cd5-3f05-3d1e-982f-5addbb215455",
                                        "entry_id": "a5724c18-4e7d-36d6-a0b6-6c00c4486b4f",
                                        "glosses": [
                                            "The spawn of shellfish, especially oysters and similar molluscs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9511117b-8948-4603-a390-b5464895bfc7",
                                                "sense_id": "9dcb4cd5-3f05-3d1e-982f-5addbb215455",
                                                "text": "As spat-fall often occurs in areas away from environments suitable for oyster growing, the collection, transport and sale of oyster spat has developed into a separate industry."
                                            },
                                            {
                                                "example_id": "0d3d04c3-7670-4c63-9a9f-c38e2def4e71",
                                                "sense_id": "9dcb4cd5-3f05-3d1e-982f-5addbb215455",
                                                "text": "But Orata’s oysters were, like the dormice and fish, collected in the wild, as spat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                                        "entry_id": "a5724c18-4e7d-36d6-a0b6-6c00c4486b4f",
                                        "glosses": [
                                            "A juvenile shellfish which has attached to a hard surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95dc77d8-19bc-4539-a906-76d5bf966a1e",
                                                "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                                                "text": "Conditions in pearl oyster hatcheries are optimized for growth and survival of spat."
                                            },
                                            {
                                                "example_id": "f09ea976-7ee8-41d3-b55a-139009faa214",
                                                "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                                                "text": "If the spat are allowed to remain attached to the tank bottom for more than two days, they are difficult to remove without damage to the shell."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
