                        "source_sense_id": "72980ce0-6356-391f-8adc-ee45a456586d",
                        "source_sense_description": "Zoologie: eine Tiergattung aus der Familie der Perlboote, welche zur Ordnung der Nautiliden gehört",
                        "target_lang_word": "nautilus",
