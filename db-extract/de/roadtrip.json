                ],
                "senses": [
                    {
                        "sense_id": "48bcc4a7-39dc-30a2-a219-0c9e9ce8beb4",
                        "entry_id": "d5343a58-b479-3287-a152-a1cb0d6e9151",
                        "glosses": [
                            "Ausflugs- oder Erkundungsfahrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8b9550-f568-4e94-af86-67d25980bac4",
                                "sense_id": "48bcc4a7-39dc-30a2-a219-0c9e9ce8beb4",
                                "text": "„Der Westen, er ist für Menschen, die drei oder vier Tage haben, ein kleines Island, ein kleiner Roadtrip.“"
                            },
                            {
                                "example_id": "9c2a1661-6c99-4705-8de3-3a646ce67d28",
                                "sense_id": "48bcc4a7-39dc-30a2-a219-0c9e9ce8beb4",
                                "text": "„Die mentale Belastung durch die ständigen neuen Eindrücke ist typisch für solche Roadtrips –, aber wir hatten das Gefühl, uns keinen Ruhetag erlauben zu können, bevor wir die Sahara durchquert hatten, und bis dahin lag noch ein weiter Weg vor uns.“"
                            },
                            {
                                "example_id": "999db95d-0f42-4cf4-9d70-291024262d79",
                                "sense_id": "48bcc4a7-39dc-30a2-a219-0c9e9ce8beb4",
                                "text": "„Das wird ja ein spannender Roadtrip, denke ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
