                        "glosses": [
                            "с.-х. действие по значению гл. закосить (закашивать)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b1dade-4ac3-4ac1-a35f-2a3e0aae02e1",
                                "sense_id": "a6a553a6-374a-37b7-a005-95028c89b9a6",
                                "text": "Уход за скотом образцовый, сено заготовляется самого раннего закоса, скот летом подкармливается травой и пр., и пр."
                            },
                            {
                                "example_id": "c6596757-9834-407c-8264-aad1b6650e08",
                                "sense_id": "a6a553a6-374a-37b7-a005-95028c89b9a6",
                                "text": "Закосы по дороге, пробует отбитые косы."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec7af7de-2769-3564-8360-af6625c7a772",
                        "entry_id": "a793c9c5-0647-3a46-88b4-90a6648e04d8",
