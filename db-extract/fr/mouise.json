                                        "examples": [
                                            {
                                                "example_id": "70f0175c-fa79-46e6-9949-58f98e45bd14",
                                                "sense_id": "61a93522-e347-380c-973c-67b53555e1d2",
                                                "text": "Eine Klemme hielt die Quittungen zusammen."
                                            },
                                            {
                                                "example_id": "2fad3e52-ecff-436f-8e9d-a0d3e5fcfb9f",
                                                "sense_id": "61a93522-e347-380c-973c-67b53555e1d2",
                                                "text": "Am besten wäre eine Klemme, die die beiden Teile mindestens eine Stunde zusammenpresst."
                                            },
                                            {
                                                "example_id": "e976a1e9-e143-405e-8542-28d7a61e3b3c",
                                                "sense_id": "61a93522-e347-380c-973c-67b53555e1d2",
                                                "text": "„Vorsichtig entfernt Papin die Klemme und öffnet den Topf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc91a611-5ad3-3700-ba08-c2da43cc9a75",
                                        "entry_id": "0f3dd271-b451-34e0-8558-66672396b54e",
