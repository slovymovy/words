                        "glosses": [
                            "Habitant du Marais poitevin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be68d2d2-b7fe-4493-89be-839c4daa93cb",
                                "sense_id": "8acd31bf-2230-3139-9031-a3eeef9c7fd0",
                                "text": "Un homme du chevalier, un maraîchin – ou encore, comme on les appelait : un « mouton noir », à cause de la veste de peau que la plupart portaient – vint se saisir du cheval pour le conduire vers les écuries."
