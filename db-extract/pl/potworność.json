                        "translation_id": "1a0cf391-847b-4954-8ea3-42497451164c",
                        "source_entry_id": "544b966d-a791-3ceb-b6ea-e0b46ec274a0",
                        "source_sense_id": "d4740238-8034-35f2-991e-011b3015163b",
                        "target_lang_word": "Grauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cee78c1f-75bb-3773-b217-5cce822ec2d4",
                                        "entry_id": "5e9faeaa-8e0d-3a62-9d42-d92be9cf0e85",
                                        "glosses": [
                                            "Gefühl der Furcht, des Entsetzens aufgrund von etwas Bedrohlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1ede91-517e-469d-b993-1b6a6ef9b24f",
                                                "sense_id": "cee78c1f-75bb-3773-b217-5cce822ec2d4",
                                                "text": "Ich habe ein Grauen vor Spinnen."
                                            },
                                            {
                                                "example_id": "78b0907c-4872-4519-92be-0976c88b7ee4",
                                                "sense_id": "cee78c1f-75bb-3773-b217-5cce822ec2d4",
                                                "text": "„Deshalb nützen wir jede Gelegenheit dazu, und unmittelbar, hart, ohne Übergang steht neben dem Grauen der Blödsinn."
                                            },
                                            {
                                                "example_id": "aefa1fe0-4162-484b-9664-04e40e98b3a4",
                                                "sense_id": "cee78c1f-75bb-3773-b217-5cce822ec2d4",
                                                "text": "„Ihr zweiter Roman ist erfüllt vom eisigen Grauen einer scheiternden Sinnsuche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f39b82f8-9fa2-3c51-97a6-15c6ae89c46f",
                                        "entry_id": "5e9faeaa-8e0d-3a62-9d42-d92be9cf0e85",
                                        "glosses": [
                                            "Gefühl des Schauderns in einer unheimlichen Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b817ca7a-53b9-4822-8627-d0d6a6e4ee84",
                                                "sense_id": "f39b82f8-9fa2-3c51-97a6-15c6ae89c46f",
                                                "text": "Allein in der Dunkelheit wurde er von Grauen überfallen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e2f6dbfc-9db1-359d-9864-250985a824b9",
                                        "entry_id": "5e9faeaa-8e0d-3a62-9d42-d92be9cf0e85",
                                        "glosses": [
                                            "furchtbares Geschehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "878065f0-837e-4ce9-a5e3-5c7fa6685bcb",
                                                "sense_id": "e2f6dbfc-9db1-359d-9864-250985a824b9",
                                                "text": "Das Grauen des Bürgerkriegs geht weiter."
                                            },
                                            {
                                                "example_id": "de8da31f-1548-4fe5-a56a-82464076b5ce",
                                                "sense_id": "e2f6dbfc-9db1-359d-9864-250985a824b9",
                                                "text": "„In diesen Jahren vor dem Kriege lebte in der Romantik des Wandervogels die Begeisterung für eine neue, freie Zukunft, die dann in den Schützengräben noch eine Zeit lang loderte und 1917 im Grauen der Materialschlachten zusammenbrach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
