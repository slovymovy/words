                                "sense_id": "e3749942-f8b0-35ec-80a2-ca8d336e7dcf",
                                "text": "Special lamps were provided for working during the blackout, and an anti-aircraft gun, manned by the R.A.O.C., was mounted on the coal depot line."
                            },
                            {
                                "example_id": "c4fe92a9-5a11-4739-8629-88932de2c2f8",
                                "sense_id": "e3749942-f8b0-35ec-80a2-ca8d336e7dcf",
                                "text": "Truth's ships are clustered above the excavation site. And his infantry has deployed anti-aircraft batteries around the perimeter."
                            }
                        ]
                    }
