                ],
                "senses": [
                    {
                        "sense_id": "85fc414e-3e3b-3a46-b315-a477ec4e7d3d",
                        "entry_id": "542eece8-d38c-3c5d-b72f-89c401d507b3",
                        "glosses": [
                            "Traverser un moment difficile, un moment d’angoisse."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "d25a69a6-708a-4f7e-91c9-854b5cc1fc05",
                                "sense_id": "85fc414e-3e3b-3a46-b315-a477ec4e7d3d",
                                "text": "Dézingue, carcasse, j’t’arrache les nibards. Je pourris ta race, tu peux flipper grave. Bâtarde ! Saphir, furax, râlait comme un vieux pou. Elle bad-tripait."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3402d0f-9d6f-359a-9cd4-a3d2b6250932",
                        "entry_id": "542eece8-d38c-3c5d-b72f-89c401d507b3",
                        "glosses": [
                            "Subir une mauvaise expérience psychique en consommant de la drogue, traverser un bad trip."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "384da6ea-eaeb-48c7-9126-bbe7daaec361",
                                "sense_id": "e3402d0f-9d6f-359a-9cd4-a3d2b6250932",
                                "text": "Ado, elle avait fui l’ennui petit-bourgeois de Limoges pour rejoindre des communautés, militer contre tout, vivre l’amour libre, défendre la condition féminine, porter des ponchos et des sabots, fumer des joints, s’éclater aux acides, bad-triper avec des champignons, vivre la grande époque du Larzac […]."
                            }
                        ]
                    }
