                        "glosses": [
                            "von einem Substantiv abgeleitetes Adjektiv in Form eines Partizips"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0accd5bc-1980-4389-b513-a21d466e35cb",
                                "sense_id": "958f6e1b-3fcd-3aae-8f9b-24de48ddb21c",
                                "text": "„Verwitwet“ und „befranst“ sind Pseudopartizipien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "82c617eb-9f52-32ad-a2fb-3502e4a0a418",
                        "entry_id": "b454fda7-d6e4-3d88-aac4-7ccbb2748f27",
                        "glosses": [
                            "finite Verbform der ägyptischen Sprache"
                        ],
                        "tags": [
                            "Ägyptologie"
                        ],
                        "examples": [
                            {
                                "example_id": "73ee8ccd-4462-442c-8051-510d24c0bcfe",
                                "sense_id": "82c617eb-9f52-32ad-a2fb-3502e4a0a418",
                                "text": "„Das Pseudopartizip ist eine perfektische Form, die sich auf faktitiv-resultative Aktionsart spezialisiert hat (vgl. Kap. 10.2.3). Bei transitiv verwendeten Verben ist die Bedeutung des Pseudopartizips passivisch.“"
                            },
                            {
                                "example_id": "9c9a2de4-95e6-44f5-9366-cde0f3e44e1b",
                                "sense_id": "82c617eb-9f52-32ad-a2fb-3502e4a0a418",
                                "text": "„Bei Zustandsverben steht das Pseudopartizip in Stativ-Funktion und wird üblicherweise mit Endung 4 gebildet. Das Pseudopartizip (Perfekt) unterscheidet sich vom Pseudopartizip (Stativ) durch die Endung -ti‚ wobei das auslautende -l im Stativ fakultativ, im Perfekt nie geschrieben wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
