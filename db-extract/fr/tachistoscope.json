                    {
                        "sense_id": "d760b097-3a50-37a1-a903-892f3186cb77",
                        "entry_id": "67f4d982-963e-3c16-8143-39ba73491e98",
                        "glosses": [
                            "Appareil permettant la présentation ultrarapide (de l’ordre de la milliseconde) d’un stimulus à un seul hémichamp visuel à la fois ou à l'intégralité du champ visuel, selon les modalités expérimentales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6150f1a2-fd8b-4fe1-a26a-2e9fcfcf221e",
                                "sense_id": "d760b097-3a50-37a1-a903-892f3186cb77",
                                "text": "Pour étudier ses effets en perception visuelle, on utilise traditionnellement un appareil appelé tachistoscope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abb26864-a529-45d0-a3fa-92827f4a14a8",
                        "source_entry_id": "67f4d982-963e-3c16-8143-39ba73491e98",
                        "source_sense_id": "d760b097-3a50-37a1-a903-892f3186cb77",
                        "source_sense_description": "appareil de mesure ophtalmologique",
                        "target_lang_word": "Tachistoskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tachistoskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd2c1c3-3609-37e9-b4d8-f535e5cbf25f",
                                        "entry_id": "fce86f86-ae7f-3c02-a917-c75b19937528",
                                        "glosses": [
                                            "Gerät, mit dessen Hilfe einer Versuchsperson visuelle Reize präsentiert werden, um ihre Wahrnehmung zu überprüfen"
                                        ],
                                        "tags": [
                                            "Wahrnehmungspsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8336714-31c7-4077-bf84-447f4d07da9d",
                                                "sense_id": "8fd2c1c3-3609-37e9-b4d8-f535e5cbf25f",
                                                "text": "„Die Versuchsperson sitzt vor einem Tachistoskop, einer Vorrichtung, mittels der Wörter für beliebig kurze Zeiträume sichtbar gemacht werden können.“"
                                            },
                                            {
                                                "example_id": "96002d83-9844-417c-9862-be364083afce",
                                                "sense_id": "8fd2c1c3-3609-37e9-b4d8-f535e5cbf25f",
                                                "text": "„Hierzu verwenden sie ein Gerät namens Tachistoskop, das einzelne Wörter in hoher Geschwindigkeit auf einem Bildschirm aufblitzen lässt, ohne Verweilen, ohne Wiederholung, sondern stetig auf der Stelle laufend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
