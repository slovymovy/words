{
    "word_family": [
        "находка",
        "находчивый",
        "находчивость"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "078d6f01-dc85-342d-b7ef-5748a155abb1",
                    "sense_definition": "Обнаружить что-либо скрытое или потерянное в результате целенаправленного поиска.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция смогла <w>найти</w> украденные документы через два дня.",
                            "target_lang_translations": {
                                "en": "The police were able to <w>find</w> the stolen documents after two days."
                            }
                        },
                        {
                            "text": "Мне нужно <w>найти</w> ключи от квартиры, иначе я не попаду домой.",
                            "target_lang_translations": {
                                "en": "I need to <w>find</w> my apartment keys, otherwise I won't get home."
                            }
                        }
                    ],
                    "synonyms": [
                        "обнаружить",
                        "отыскать",
                        "разыскать"
                    ],
                    "antonyms": [
                        "потерять"
                    ],
                    "common_phrases": [
                        "найти ключи",
                        "найти решение"
                    ],
                    "target_lang_definitions": {
                        "en": "To locate or discover something that was hidden, lost, or sought after."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "to locate something being searched for"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a90d351-8a25-3ff3-ab05-8dd0352fbc36",
                    "sense_definition": "Неожиданно обнаружить что-либо, набрести на что-либо.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гуляя в лесу, мы <w>нашли</w> много грибов под старой елью.",
                            "target_lang_translations": {
                                "en": "While walking in the forest, we <w>found</w> many mushrooms under an old spruce."
                            }
                        },
                        {
                            "text": "Я случайно <w>нашел</w> старую фотографию в кармане зимней куртки.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>found</w> an old photograph in my winter jacket pocket."
                            }
                        }
                    ],
                    "synonyms": [
                        "встретить"
                    ],
                    "common_phrases": [
                        "найти случайно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To discover something unexpectedly or by chance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "to encounter or discover by accident"
                            },
                            {
                                "target_lang_word": "come across",
                                "target_lang_sense_clarification": "to find something by chance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "631543a6-6f67-371e-93a5-f87f6106fd25",
                    "sense_definition": "Иметь определенное мнение, считать кого-либо или что-либо каким-то.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>нахожу</w> этот фильм довольно скучным и затянутым.",
                            "target_lang_translations": {
                                "en": "I <w>find</w> this movie rather boring and long-winded."
                            }
                        },
                        {
                            "text": "Многие <w>находят</w> его поведение странным, но он просто очень застенчив.",
                            "target_lang_translations": {
                                "en": "Many people <w>find</w> his behavior strange, but he is just very shy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have a specific opinion or judgment about someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "to form an opinion about something"
                            },
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to believe or judge something to be a certain way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c415fe4c-fe2a-3481-95f8-38213147bc89",
                    "sense_definition": "Вычислить или определить значение математической величины.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calculate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученику нужно <w>найти</w> значение переменной в этом уравнении.",
                            "target_lang_translations": {
                                "en": "The student needs to <w>find</w> the value of the variable in this equation."
                            }
                        },
                        {
                            "text": "Чтобы <w>найти</w> площадь круга, используйте формулу с числом пи.",
                            "target_lang_translations": {
                                "en": "To <w>find</w> the area of a circle, use the formula with pi."
                            }
                        }
                    ],
                    "synonyms": [
                        "высчитать",
                        "подсчитать"
                    ],
                    "common_phrases": [
                        "найти значение"
                    ],
                    "target_lang_definitions": {
                        "en": "To calculate or determine a mathematical value."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "to determine a value or result"
                            },
                            {
                                "target_lang_word": "calculate",
                                "target_lang_sense_clarification": "to compute a mathematical value"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d49579cc-f804-3918-9a74-319120ca8800",
                    "sense_definition": "Выбрать или улучить подходящий момент или время для чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужно <w>найти</w> время, чтобы обсудить с вами этот важный вопрос.",
                            "target_lang_translations": {
                                "en": "I need to <w>find</w> time to discuss this important matter with you."
                            }
                        },
                        {
                            "text": "Он <w>нашел</w> подходящий момент, чтобы сделать ей предложение.",
                            "target_lang_translations": {
                                "en": "He <w>found</w> the right moment to propose to her."
                            }
                        }
                    ],
                    "synonyms": [
                        "выкроить",
                        "улучить"
                    ],
                    "common_phrases": [
                        "найти время"
                    ],
                    "target_lang_definitions": {
                        "en": "To manage to secure or set aside time for a specific purpose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "to gain or secure as an object of effort"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to create time for something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47f52f0e-a8ad-3246-a0ab-46dd875b0541",
                    "sense_definition": "Овладевать человеком (о внезапном порыве, настроении или состоянии).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На него иногда <w>находит</w> странное желание уехать далеко от всех.",
                            "target_lang_translations": {
                                "en": "Sometimes a strange desire <w>comes over</w> him to go far away from everyone."
                            }
                        },
                        {
                            "text": "Когда на неё <w>находит</w> грусть, она начинает писать стихи.",
                            "target_lang_translations": {
                                "en": "When sadness <w>comes over</w> her, she starts writing poems."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly overcome or seize a person (referring to a mood, impulse, or state)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come over",
                                "target_lang_sense_clarification": "to suddenly affect someone with a feeling"
                            },
                            {
                                "target_lang_word": "seize",
                                "target_lang_sense_clarification": "to suddenly take hold of someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}