                {
                    "sense_id": "911863d5-e102-3df1-a44a-4a20bdaf209f",
                    "sense_definition": "De nacht die voorafging aan de huidige dag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <vannacht> helemaal niet lekker geslapen door de storm.",
                            "target_lang_translations": {
                                "en": "I didn't sleep well at all <last night> because of the storm.",
                                "ru": "Я совсем плохо спал <сегодня ночью> из-за шторма.",
                                "de": "Ich habe wegen des Sturms <w>letzte Nacht</w> überhaupt nicht gut geschlafen.",
                                "pl": "Przez burzę w ogóle nie spało mi się dobrze <w>zeszłej nocy</w>.",
                                "fr": "Je n'ai pas du tout bien dormi <w>cette nuit</w> à cause de la tempête.",
                                "it": "Non ho dormito affatto bene <w>stanotte</w> a causa della tempesta.",
                                "cs": "Kvůli té bouřce jsem se <w>dnes v noci</w> vůbec dobře nevyspal.",
                                "tr": "Fırtına yüzünden <w>dün gece</w> hiç iyi uyuyamadım.",
                                "es": "No he dormido nada bien <w>esta noche</w> por la tormenta."
                            }
                        },
                        {
                            "text": "Er is <vannacht> ingebroken bij de buren terwijl ze weg waren.",
                            "target_lang_translations": {
                                "en": "There was a break-in at the neighbors' <last night> while they were away.",
                                "ru": "<Сегодня ночью> к соседям залезли воры, пока их не было.",
                                "de": "Bei den Nachbarn wurde <w>heute Nacht</w> eingebrochen, während sie weg waren.",
                                "pl": "<w>Dziś w nocy</w> włamano się do sąsiadów, podczas gdy byli poza domem.",
                                "fr": "Les voisins ont été cambriolés <w>la nuit dernière</w> pendant leur absence.",
                                "it": "C'è stato un furto dai vicini <w>ieri notte</w> mentre erano via.",
                                "cs": "K sousedům se <w>dnes v noci</w> vloupali, zatímco byli pryč.",
                                "tr": "Komşular dışarıdayken <w>dün gece</w> evlerine hırsız girdi.",
                                "es": "Robaron en casa de los vecinos <w>anoche</w> mientras estaban fuera."
