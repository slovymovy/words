                        "examples": [
                            {
                                "example_id": "0abb531d-480a-48b0-8a68-c289c5eb8134",
                                "sense_id": "ea5485f1-4eae-32f1-aac6-49486cd8ae70",
                                "text": "Er wechselte ständig nervös von Spielbein zu Standbein und zurück."
                            },
                            {
                                "example_id": "dd9f6c56-1b30-4547-b8ba-4aa12aa1b4a8",
                                "sense_id": "ea5485f1-4eae-32f1-aac6-49486cd8ae70",
                                "text": "Der physiologische Bewegungsablauf des Menschen im Gehen besteht im Wechsel zwischen Stand- und Spielbein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff26bad4-30d9-3a7a-a39f-c42d1a96b9e8",
