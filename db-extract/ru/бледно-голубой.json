                ],
                "senses": [
                    {
                        "sense_id": "250e2416-a1ed-3142-8920-adb106ef201a",
                        "entry_id": "33b33110-3a66-3495-8657-ca03f042c4e9",
                        "glosses": [
                            "имеющий ненасыщенный голубой цвет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad20414b-a4d3-4579-979e-b2dd49685db9",
                                "sense_id": "250e2416-a1ed-3142-8920-adb106ef201a",
                                "text": "Материал рассыпался и рвался, оставляя след искр, трение перешло на топливный бак, и жидкий водород взорвался ослепительным огненным шаром бледно-голубого пламени."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "215f32e7-6427-423d-90b0-f9e9242bd8ac",
                        "source_entry_id": "33b33110-3a66-3495-8657-ca03f042c4e9",
                        "source_sense_id": "250e2416-a1ed-3142-8920-adb106ef201a",
                        "target_lang_word": "pale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                        "entry_id": "e1d73e61-294e-3375-83e2-78e96cf94763",
                                        "glosses": [
                                            "Light in color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39181cd-5b63-468d-937d-63cc4e69459d",
                                                "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                                "text": "I have pale yellow wallpaper."
                                            },
                                            {
                                                "example_id": "9f7e575f-c9a0-4965-8e66-f2496bfd143c",
                                                "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                                "text": "She had pale skin because she didn't get much sunlight."
                                            },
                                            {
                                                "example_id": "71af4982-773a-4e86-9eb6-9789cd6b2ace",
                                                "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                                "text": "She turned pale and screamed on seeing the spider in the toilet."
                                            },
                                            {
                                                "example_id": "657f3396-8501-470d-825c-937a2fc5dcb1",
                                                "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            },
                                            {
                                                "example_id": "97dd1f13-aa8d-484d-823e-49accdb2d094",
                                                "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                                "text": "A rangy, gangly, Scandinavian youth of a sailor, droop-shouldered, six feet six and slender as a lath, with pallid eyes of palest blue and skin and hair attuned to the same colour scheme, joined Kwaque in his work."
                                            },
                                            {
                                                "example_id": "dda6e8c6-831f-4182-ad9c-6c836264b622",
                                                "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                                                "text": "Three years later, the unwatered cactus was still about two feet tall, a dark green color. The watered cactus was a paler green, its trunk visibly swollen with moisture. It had grown to be over five feet tall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772cd8ed-b411-37a3-a733-6fc28c49d28c",
                                        "entry_id": "e1d73e61-294e-3375-83e2-78e96cf94763",
                                        "glosses": [
                                            "Having a pallor (a light color, especially due to sickness, shock, fright etc.)."
                                        ],
                                        "tags": [
                                            "of human skin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d1876c-81e5-4f38-b5b0-d087859eb49d",
                                                "sense_id": "772cd8ed-b411-37a3-a733-6fc28c49d28c",
                                                "text": "His face turned pale after hearing about his mother's death."
                                            },
                                            {
                                                "example_id": "252e83d5-73d7-4b47-a28b-27fae4b6f8e5",
                                                "sense_id": "772cd8ed-b411-37a3-a733-6fc28c49d28c",
                                                "text": "Mr. Campion appeared suitably impressed and she warmed to him. He was very easy to talk to with those long clown lines in his pale face, a natural goon, born rather too early she suspected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d539e3a9-e220-3e70-9a92-4ec95a8826d5",
                                        "entry_id": "e1d73e61-294e-3375-83e2-78e96cf94763",
                                        "glosses": [
                                            "Feeble, faint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1299ae7-1a96-41a1-b390-3a41a35183b7",
                                                "sense_id": "d539e3a9-e220-3e70-9a92-4ec95a8826d5",
                                                "text": "He is but a pale shadow of his former self."
                                            },
                                            {
                                                "example_id": "5b3db5e7-82f4-44ff-9126-8eb2c127c20f",
                                                "sense_id": "d539e3a9-e220-3e70-9a92-4ec95a8826d5",
                                                "text": "The son's clumsy paintings are a pale imitation of his father's."
                                            },
                                            {
                                                "example_id": "8e877771-4444-450d-963c-b5e98e682495",
                                                "sense_id": "d539e3a9-e220-3e70-9a92-4ec95a8826d5",
                                                "text": "Many in the gay community were quick to assure everyone that gay marriage was not on the horizon. One community leader even tried to stop the introduction of a \"domestic partnership\" bill—at best a pale substitute for marriage—claiming that it would have polarized our opposition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e443f3af-1122-362f-ba17-9ca9b7775f30",
                                        "entry_id": "28fc6c44-fa66-3839-85ad-35792e96fff4",
                                        "glosses": [
                                            "To turn pale; to lose colour."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8722be6f-0606-4e72-aac5-224eaedbac6d",
                                                "sense_id": "e443f3af-1122-362f-ba17-9ca9b7775f30",
                                                "text": "But a man— / Note men !—they are but women after all, / As women are but Auroras !—there are men / Born tender, apt to pale at a trodden worm, / Who paint for pastime, in their favourite dream, / Spruce auto-vestments flowered with crocus-flames / There are, too, who believe in hell and lie : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "353949fe-bb52-38ab-bd5c-650dd163ec39",
                                        "entry_id": "28fc6c44-fa66-3839-85ad-35792e96fff4",
                                        "glosses": [
                                            "To become insignificant."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccacfe16-c435-4f29-bf4f-adfe6f19be33",
                                                "sense_id": "353949fe-bb52-38ab-bd5c-650dd163ec39",
                                                "text": "(Although the conditions are rather different, the generosity of the offer certainly pales by comparison with the \"Eurailpass\" now available to tourists from North and South America at $125 (£44 13s.), which allows two months' unlimited first class travel throughout the railway systems of thirteen countries—[...].)"
                                            },
                                            {
                                                "example_id": "ff292806-9b59-490d-bf50-cb79aca00192",
                                                "sense_id": "353949fe-bb52-38ab-bd5c-650dd163ec39",
                                                "text": "Its financing pales next to the tens of billions that the Bill and Melinda Gates Foundation will have at its disposal, especially with the coming infusion of some $3 billion a year from Warren E. Buffett, the founder of Berkshire Hathaway."
                                            },
                                            {
                                                "example_id": "710ad736-6e87-4953-9388-62e510d54c9e",
                                                "sense_id": "353949fe-bb52-38ab-bd5c-650dd163ec39",
                                                "text": "12 July 2012, Sam Adams, AV Club Ice Age: Continental Drift\nThe matter of whether the world needs a fourth Ice Age movie pales beside the question of why there were three before it, but Continental Drift feels less like an extension of a theatrical franchise than an episode of a middling TV cartoon, lolling around on territory that’s already been settled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9543d1b1-c1d0-36bb-a83c-d987c42b7576",
                                        "entry_id": "28fc6c44-fa66-3839-85ad-35792e96fff4",
                                        "glosses": [
                                            "To make pale; to diminish the brightness of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d089d1-f3b8-4973-9005-20d1fcb0b282",
                                                "sense_id": "9543d1b1-c1d0-36bb-a83c-d987c42b7576",
                                                "text": "The Glow-worme ſhowes the Matine to be neere, / And gins to pale his vneffectuall Fire : / Adue, adue, Hamlet : remember me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9c7ae4a-56fd-3038-95b1-090a519dd21e",
                                        "entry_id": "ea6c4521-942e-33d4-82d7-07e012152eee",
                                        "glosses": [
                                            "Paleness; pallor."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01219d5-43ef-4dd3-82ab-9da0a2c4805a",
                                                "sense_id": "c9c7ae4a-56fd-3038-95b1-090a519dd21e",
                                                "text": "The boare (quoth ſhe) whereat a ſuddain pale, / Like lawne being ſpred vpon the bluſhing roſe, / Vſurpes her cheeke, ſhe trembles at his tale, / And on his neck her yoaking armes ſhe throwes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3847abf7-220c-304b-9c17-cd31199a76a5",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A wooden stake; a picket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a5ff3a-1600-45b1-9f3c-5d93b5c40220",
                                                "sense_id": "3847abf7-220c-304b-9c17-cd31199a76a5",
                                                "text": "1707, John Mortimer, The Whole Art of Husbandry, London: H. Mortlock & J. Robinson, 2nd edition, 1708, Chapter 1, pp. 11-12,\n[…] if you deſign it a Fence to keep in Deer, at every eight or ten Foot diſtance, ſet a Poſt with a Mortice in it to ſtand a little ſloping over the ſide of the Bank about two Foot high; and into the Mortices put a Rail […] and no Deer will go over it, nor can they creep through it, as they do often, when a Pale tumbles down."
                                            },
                                            {
                                                "example_id": "d3860285-fd41-41e5-bcd2-f3c212d1f766",
                                                "sense_id": "3847abf7-220c-304b-9c17-cd31199a76a5",
                                                "text": "Ceiling joists were sometimes grooved to receive riven staves or pales that secured mud-and-straw walling."
                                            },
                                            {
                                                "example_id": "82303d6a-8ab2-45c6-9245-b31cf8070dae",
                                                "sense_id": "3847abf7-220c-304b-9c17-cd31199a76a5",
                                                "text": "Pales (irregular, hand-riven, 1′′ × 4′′ boards) are inserted into grooves on both sides of the floor joists; on top of these, similar pales are laid at right angles; finally a plasterlike mixture is poured over and around the top pales,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c76935-0b19-3f99-b89a-2608ff3241df",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A fence made from wooden stake; palisade."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092e75a4-56b8-4800-865c-b665892714ad",
                                                "sense_id": "90c76935-0b19-3f99-b89a-2608ff3241df",
                                                "text": "How are we park’d and bounded in a pale, / A little herd of England’s timorous deer, / Mazed with a yelping kennel of French curs!"
                                            },
                                            {
                                                "example_id": "1fa146bc-9a44-4648-9cce-677d3f85eb69",
                                                "sense_id": "90c76935-0b19-3f99-b89a-2608ff3241df",
                                                "text": "Fourthly, they ſhall not vpon any occaſion whatſoeuer breake downe any of our pales, or come into any of our Townes or forts by any other waies, iſſues or ports then ordinary […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b571533-a38c-35a4-b753-de5b8e1ababc",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "Limits, bounds (especially before of)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be90a39e-37cb-4fa3-abb4-4892329c0a4c",
                                                "sense_id": "3b571533-a38c-35a4-b753-de5b8e1ababc",
                                                "text": "But let my due feet never fail, / To walk the ſtudious cloyſters pale, / And love the high embowed roof, / With antic pillars maſſy proof, / And ſtoried windows richly dight, / Caſting a dim religious light."
                                            },
                                            {
                                                "example_id": "d1aeec7b-e182-447c-a354-87b5a5a2b68c",
                                                "sense_id": "3b571533-a38c-35a4-b753-de5b8e1ababc",
                                                "text": "The moſſy pales that ſkirt the orchard-green, / Here hid by ſhrub-vvood, there by glimpſes ſeen; […]"
                                            },
                                            {
                                                "example_id": "35f798b7-4944-497e-a41f-b213229ca862",
                                                "sense_id": "3b571533-a38c-35a4-b753-de5b8e1ababc",
                                                "text": "Men so situated, beyond the pale of the honor and the law, are not to be trusted."
                                            },
                                            {
                                                "example_id": "e5bd3480-f682-4255-bdd9-de3cd1ac9f87",
                                                "sense_id": "3b571533-a38c-35a4-b753-de5b8e1ababc",
                                                "text": "All things considered, we advise the male reader to keep his desires in check till he is at least twenty-five, and the female not to enter the pale of wedlock until she has attained the age of twenty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dc7dbdd-3b4e-37f6-8d2d-3a546d8e1d5b",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A vertical band down the middle of a shield."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a95b2fa-a4f0-4a3a-9c7f-05fb61475719",
                                                "sense_id": "0dc7dbdd-3b4e-37f6-8d2d-3a546d8e1d5b",
                                                "text": "The shield was silver, charged with a red cross voided (that is, with the centre cut out and only the edges left), between in chief (that is, above the horizontal limb of the cross) two black dragon's wings, and in base two red daggers, and in the centre of the cross a black winged helmet; on a red chief (a broad band across the top of the shield), a silver pale (a broad vertical band), and thereon eight black arrows crossed X-wise, four and four, and encircled with a black band, between on the dexter three bendlets (narrow bands slanting from dexter chief to sinister base) enhanced (that is, raised above the centre), and on the sinister a fleur-de-lis, all of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24555732-1f88-3a2a-a455-8d04dd2cbaf9",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A territory or defensive area within a specific boundary or under a given jurisdiction.",
                                            "The parts of Ireland under English jurisdiction."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37baabf9-8870-38da-b9ef-67ca0a3db2a8",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A territory or defensive area within a specific boundary or under a given jurisdiction.",
                                            "The territory around Calais under English control (from the 14th to 16th centuries)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14f3372a-9a11-44bc-980c-fbfd9dc57725",
                                                "sense_id": "37baabf9-8870-38da-b9ef-67ca0a3db2a8",
                                                "text": "He knows the fortifications – crumbling – and beyond the city walls the lands of the Pale, its woods, villages and marshes, its sluices, dykes and canals."
                                            },
                                            {
                                                "example_id": "7227827b-1f47-4c16-9e2f-b78259b6dec9",
                                                "sense_id": "37baabf9-8870-38da-b9ef-67ca0a3db2a8",
                                                "text": "A low-lying, marshy enclave stretching eighteen miles along the coast and pushing some eight to ten miles inland, the Pale of Calais nestled between French Picardy to the west and, to the east, the imperial-dominated territories of Flanders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb547043-82d4-3aaa-81c3-532c75c522d2",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A territory or defensive area within a specific boundary or under a given jurisdiction.",
                                            "A portion of Russia in which Jews were permitted to live (the Pale of Settlement)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e8375e8-7e1b-31a3-92fd-2e41148bb4c7",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "The jurisdiction (territorial or otherwise) of an authority."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f8f1de3-fcfa-38f0-81c9-ef9353f3ad3c",
                                        "entry_id": "6461d36b-7ab5-3de5-af6f-53ebc6948f75",
                                        "glosses": [
                                            "A cheese scoop."
                                        ],
