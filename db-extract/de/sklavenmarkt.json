                ],
                "senses": [
                    {
                        "sense_id": "c408a8bc-0136-3d09-802b-da7b47c85d3b",
                        "entry_id": "eb152035-1957-33ab-bbfb-c830ba7f2cd8",
                        "glosses": [
                            "Markt, auf dem Sklaven gehandelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "787e85b3-5655-4f43-aeb4-4d6e65bc2439",
                                "sense_id": "c408a8bc-0136-3d09-802b-da7b47c85d3b",
                                "text": "„Weil es keine regulären Sklavenmärkte in dieser Region gab, zeigten örtliche Stammeshäuptlinge und Händler mit Rauchsignalen vorbeisegelnden europäischen Schiffen an, dass sie Sklaven zu verkaufen hatten.“"
                            },
                            {
                                "example_id": "ba71a4e1-8cc8-4264-86ba-4575773c4312",
                                "sense_id": "c408a8bc-0136-3d09-802b-da7b47c85d3b",
                                "text": "„Goupil musterte sie wie ein vereidigter Taxator auf dem römischen Sklavenmarkt und wies sie dann mit einem trockenen »usure générale« zurück.“"
                            },
                            {
                                "example_id": "a542b53b-86f6-4627-bb72-2d89d8df0918",
                                "sense_id": "c408a8bc-0136-3d09-802b-da7b47c85d3b",
                                "text": "„Brasilianische Schiffe fuhren zu den afrikanischen Sklavenmärkten, wo sie Tabak, Zuckerrohrschnaps („Cachaça“) und später Gold gegen die menschliche Ware eintauschten.“"
                            },
                            {
                                "example_id": "67b26bff-5272-46e9-83fe-433a6b3162c7",
                                "sense_id": "c408a8bc-0136-3d09-802b-da7b47c85d3b",
                                "text": "„Vor allem an der Westküste wachsen die Sklavenmärkte zu Handelszentren heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
