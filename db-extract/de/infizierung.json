                "senses": [
                    {
                        "sense_id": "4f2bc3ce-b368-3fb3-a310-29095dee0315",
                        "entry_id": "9e611a86-6660-3c14-96a1-7e233b738d3e",
                        "glosses": [
                            "Ansteckung mit einem Krankheitserreger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bf6df4-48fb-4fab-aa94-02b465095ee8",
                                "sense_id": "4f2bc3ce-b368-3fb3-a310-29095dee0315",
                                "text": "„Wir haben die Anwesenheit des Virus in den Mücken bis nach 18 Tagen nach der Infizierung kontrolliert, obwohl wir schon nach kürzeren Intervallen sahen, daß kein aktives Virus mehr in den Mücken zu finden war.“"
                            },
                            {
                                "example_id": "6f68369b-9257-4238-b971-6b045c140853",
                                "sense_id": "4f2bc3ce-b368-3fb3-a310-29095dee0315",
                                "text": "„Die Infizierung mit einer Krankheit ist eine Gesundheitsbeschädigung, auch wenn die Krankheit selbst noch nicht zum Ausbruch gekommen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
