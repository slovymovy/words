                                    {
                                        "sense_id": "593ae249-d3fc-344f-ac87-773f3da59452",
                                        "entry_id": "11e7550c-745f-374c-82d7-3a7fb6303438",
                                        "glosses": [
                                            "een voor bepaalde grootheden gebruikelijke naam voor de meting van hoogten (hemellichamen, bergen, wolken), diepten (zeewateren) , hoeken en richtingen in het horizontale vlak (koersen, kompasrichtingen) en statistische gegevens (opinies)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0191e966-3ea3-4708-96d9-082149b9bd16",
                                                "sense_id": "593ae249-d3fc-344f-ac87-773f3da59452",
                                                "text": "Een peiling, dat klinkt toch minder exact dan “meting”, vind je niet?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92ef38c-cdff-3362-b841-1497ce254fe1",
                                        "entry_id": "11e7550c-745f-374c-82d7-3a7fb6303438",
                                        "glosses": [
                                            "met behulp van een enquête onderzoeken wat de mening van een bepaalde groep mensen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c9a5fc-1e32-4d6e-803f-7126be3fd7d0",
                                                "sense_id": "d92ef38c-cdff-3362-b841-1497ce254fe1",
                                                "text": "Uit peilingen blijkt dat er in Finland en Zweden inmiddels veel steun is voor een NAVO-lidmaatschap. Voor de oorlog was dat niet het geval."
                                            },
                                            {
                                                "example_id": "b248afeb-c86b-4997-8901-08cacfaaaf37",
                                                "sense_id": "d92ef38c-cdff-3362-b841-1497ce254fe1",
                                                "text": "Maar liefst 40 procent van de Amerikanen gelooft niet in de evolutieleer. Dat blijkt uit een peiling van het Amerikaanse onderzoeksbureau Gallup. De ondervraagden zijn ervan overtuigd dat de mens in zijn huidige vorm geschapen is door God en dat dit ergens in de jongste 10.000 jaar gebeurd moet zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
