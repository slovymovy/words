        "fr-extract.jsonl": [
            {
                "entry_id": "124c0b1e-a763-3b87-9bfa-91adda2c722c",
                "word": "éréthisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c46a98f-ae2d-4489-9bac-53fd7f11ce8a",
                        "entry_id": "124c0b1e-a763-3b87-9bfa-91adda2c722c",
                        "tags": [
                            "plural"
                        ],
                        "form": "éréthismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "748c6050-3a7a-38fc-957c-556d52b13808",
                        "entry_id": "124c0b1e-a763-3b87-9bfa-91adda2c722c",
                        "glosses": [
                            "Augmentation morbide de l’activité d’un organe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d72d2406-529d-4a1b-af25-0feb99be0aa8",
                                "sense_id": "748c6050-3a7a-38fc-957c-556d52b13808",
                                "text": "Dès qu’on le prononce devant lui, immédiatement une partie de ses cellules cérébrales entre en éréthisme."
                            },
                            {
                                "example_id": "08af5333-2339-466c-9da9-a522110da9dd",
                                "sense_id": "748c6050-3a7a-38fc-957c-556d52b13808",
                                "text": "Éréthisme mercuriel, symptômes induits par une intoxication au mercure"
                            }
                        ]
                    },
                    {
                        "sense_id": "be562720-be62-324d-a085-866b54be5272",
                        "entry_id": "124c0b1e-a763-3b87-9bfa-91adda2c722c",
                        "glosses": [
                            "Augmentation des bruits du cœur."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d98ef37f-617f-302b-a3e8-09f5e49a4fc6",
                        "entry_id": "124c0b1e-a763-3b87-9bfa-91adda2c722c",
                        "glosses": [
                            "Passion maladive à l’état d’exaltation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c57e8069-87f2-47ed-95d2-f8db0b22b1d3",
                                "sense_id": "d98ef37f-617f-302b-a3e8-09f5e49a4fc6",
                                "text": "Personne ne pense tant aux plaisirs sexuels que ceux chez lesquels l’amour a été réprimé.(…). La nuit et le jour ces malheureux sont la proie de rêvasseries lubriques qu’accompagne un éréthisme pénible."
                            },
                            {
                                "example_id": "60751faa-38ac-4425-9bfe-62b16c3fa9dd",
                                "sense_id": "d98ef37f-617f-302b-a3e8-09f5e49a4fc6",
                                "text": "La grande faiblesse de l’enchantement marchand, c’est sa tendance irrépressible à la banalisation accélérée. Ses prodiges ne sont qu'éphémères, ses merveilles sans épaisseur. Il est donc obligé de compenser, par un éréthisme continuel et de plus en plus exacerbé des sensations chez les sujets à stupéfier, l’ennui et la déception qui dérivent comme une fatalité de ses produits, ou mieux sont contenus en eux comme leur composante essentielle."
                            },
                            {
                                "example_id": "8c89e4b1-9c6a-4d38-a1a2-967446a82e4c",
                                "sense_id": "d98ef37f-617f-302b-a3e8-09f5e49a4fc6",
                                "text": "L’éréthisme de mon cœur est d’une extraordinaire brutalité."
                            },
                            {
                                "example_id": "156b6740-cc42-42e4-b3c3-0b86496aedff",
                                "sense_id": "d98ef37f-617f-302b-a3e8-09f5e49a4fc6",
                                "text": "...Le brigand, devenu véritablement presque insensé par une sorte d'éréthisme de vengeance sanguinaire..."
                            },
                            {
                                "example_id": "8c8644ff-ee3b-4d5f-ada3-bee08076c774",
                                "sense_id": "d98ef37f-617f-302b-a3e8-09f5e49a4fc6",
                                "text": "… ce changement d'habitude réveillant l'éréthisme nerveux que le café et les émotions du procès portaient à son comble …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f23dd971-f45a-4704-afa0-a18cbc3e4153",
                        "source_entry_id": "124c0b1e-a763-3b87-9bfa-91adda2c722c",
