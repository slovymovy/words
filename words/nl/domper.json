{
    "word_family": [
        "dompen",
        "verdompen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d052ede-3d9f-3af3-8637-8af5bab7ed24",
                    "sense_definition": "Een tegenvaller of gebeurtenis die de vreugde en het enthousiasme overstemt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "teleurstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het slechte weer tijdens de vakantie was een grote <w>domper</w>.",
                            "target_lang_translations": {
                                "en": "The bad weather during the holiday was a big <w>downer</w>."
                            }
                        },
                        {
                            "text": "Dat verlies op het laatste moment bleek een enorme <w>domper</w> voor het team.",
                            "target_lang_translations": {
                                "en": "That last-minute loss turned out to be a huge <w>disappointment</w> for the team."
                            }
                        }
                    ],
                    "synonyms": [
                        "afknapper",
                        "anticlimax"
                    ],
                    "common_phrases": [
                        "een enorme domper",
                        "een domper op de feestvreugde"
                    ],
                    "target_lang_definitions": {
                        "en": "A setback or event that dampens joy and enthusiasm."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "downer",
                                "target_lang_sense_clarification": "disappointing event"
                            },
                            {
                                "target_lang_word": "damper",
                                "target_lang_sense_clarification": "something that reduces enthusiasm"
                            },
                            {
                                "target_lang_word": "disappointment",
                                "target_lang_sense_clarification": "setback"
                            },
                            {
                                "target_lang_word": "party pooper",
                                "target_lang_sense_clarification": "spoilsport/buzzkill"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "478d195b-6231-37cf-8a0e-98e0c8e90795",
                    "sense_definition": "Een voorwerp dat wordt gebruikt om de vlam van een kaars uit te doven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uitdover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gebruikte een koperen <w>domper</w> om de kaars uit te blazen zonder rook.",
                            "target_lang_translations": {
                                "en": "He used a copper <w>snuffer</w> to put out the candle without smoke."
                            }
                        },
                        {
                            "text": "Naast de kandelaar lag een oude <w>domper</w> op tafel.",
                            "target_lang_translations": {
                                "en": "Next to the candlestick lay an old <w>candle snuffer</w> on the table."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An object used to extinguish a candle flame."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "candle snuffer",
                                "target_lang_sense_clarification": "tool to put out candles"
                            },
                            {
                                "target_lang_word": "snuffer",
                                "target_lang_sense_clarification": "device for extinguishing flames"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0d1c16-a42c-3af9-8f74-1e4d203c32c7",
                    "sense_definition": "Iemand met zeer behoudende of reactionaire opvattingen die vooruitgang tegengaat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politiek_religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De progressieve politici noemden hun conservatieve tegenstander een echte <w>domper</w>.",
                            "target_lang_translations": {
                                "en": "The progressive politicians called their conservative opponent a true <w>reactionary</w>."
                            }
                        },
                        {
                            "text": "In de negentiende eeuw werd dit scheldwoord vaak gebruikt voor een <w>domper</w> in het parlement.",
                            "target_lang_translations": {
                                "en": "In the nineteenth century, this insult was often used for an <w>obscurantist</w> in parliament."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In deze betekenis verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone with very conservative or reactionary views who opposes progress."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obscurantist",
                                "target_lang_sense_clarification": "person opposing progress or enlightenment"
                            },
                            {
                                "target_lang_word": "reactionary",
                                "target_lang_sense_clarification": "ultra-conservative person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}