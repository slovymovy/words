                        "glosses": [
                            "Exoplanète de masse comprise entre une et dix fois environ celle de la Terre, composé principalement de fer et de roches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a378c5f-f280-48ed-b94f-d61b539af8ec",
                                "sense_id": "144cf1a5-8456-3432-bf68-f5ba5ea3093c",
                                "text": "Pour la première fois, à l’aide du télescope spatial Spitzer, la lumière d’une « superterre » […] a été captée directement."
                            }
                        ]
                    }
                ],
                "translations": [
