                        "partir seul"
                    ]
                },
                {
                    "sense_id": "b3c80771-a328-3ae2-a17c-cb36fc0fa920",
                    "sense_definition": "Unique, à l'exclusion de tout autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unicite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prendre le train était notre <w>seul</w> moyen d'arriver à l'heure."
                        },
                        {
                            "text": "Elle est la <w>seule</w> personne capable de résoudre ce problème."
                        }
                    ],
                    "antonyms": [
