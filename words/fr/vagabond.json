{
    "word_family": [
        "vagabondage",
        "vagabonder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "577ba01a-5a27-3499-b93b-dcd479ca3be2",
                    "sense_definition": "Personne qui erre sans domicile fixe et généralement sans travail régulier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "errance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pauvre <w>vagabond</w> cherchait simplement un abri pour passer la nuit au chaud."
                        },
                        {
                            "text": "Autrefois, le vieux <w>vagabond</w> parcourait les routes de village en village en quête de travail."
                        }
                    ],
                    "synonyms": [
                        "chemineau",
                        "errant",
                        "nomade"
                    ],
                    "antonyms": [
                        "sédentaire"
                    ],
                    "common_phrases": [
                        "vie de vagabond"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8a182c6-1262-358a-891e-8644391e05e8",
                    "sense_definition": "Qui erre continuellement çà et là, sans demeure fixe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "errance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons croisé un chien <w>vagabond</w> qui semblait chercher de la nourriture le long du chemin."
                        },
                        {
                            "text": "Ils menaient une existence <w>vagabonde</w>, traversant les pays sans jamais s'attacher à un lieu."
                        }
                    ],
                    "synonyms": [
                        "errant",
                        "itinérant",
                        "nomade"
                    ],
                    "antonyms": [
                        "fixe",
                        "sédentaire"
                    ],
                    "common_phrases": [
                        "chien vagabond",
                        "vie vagabonde"
                    ]
                },
                {
                    "sense_id": "766450e4-3440-39b5-9b7b-c87301075f5d",
                    "sense_definition": "Qui s'égare facilement d'un sujet à un autre, inconstant ou distrait.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inconstance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la leçon, il laissait souvent son esprit <w>vagabond</w> s'évader par la fenêtre."
                        },
                        {
                            "text": "Son imagination <w>vagabonde</w> inventait sans cesse des histoires extraordinaires pour divertir ses amis."
                        }
                    ],
                    "synonyms": [
                        "distrait",
                        "inconstant"
                    ],
                    "antonyms": [
                        "attentif",
                        "concentré"
                    ],
                    "common_phrases": [
                        "esprit vagabond",
                        "imagination vagabonde",
                        "pensée vagabonde"
                    ]
                },
                {
                    "sense_id": "877aeed3-9cb0-301b-983d-b731aaac65c1",
                    "sense_definition": "Qualifie un courant électrique parasite qui circule de manière imprévue et non maîtrisée dans un conducteur ou dans le sol.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ingénieur a détecté un courant <w>vagabond</w> qui provoquait une corrosion prématurée des canalisations en acier."
                        },
                        {
                            "text": "Pour éviter les risques d'électrolyse causés par les courants <w>vagabonds</w>, une isolation supplémentaire a été installée."
                        }
                    ],
                    "synonyms": [
                        "parasite"
                    ],
                    "common_phrases": [
                        "courant vagabond"
                    ]
                }
            ]
        }
    ]
}