            "senses": [
                {
                    "sense_id": "8db3080e-bddc-3638-b4a3-2ed1686066b4",
                    "sense_definition": "Prettig en comfortabel aanvoelend, vaak gekenmerkt door aangename warmte en gezelligheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Binnen bij de open haard was het heerlijk <w>behaaglijk</w> na een lange wandeling in de vrieskou.",
                            "target_lang_translations": {
                                "en": "Inside by the fireplace it was delightfully <w>cozy</w> after a long walk in the freezing cold.",
                                "ru": "Внутри у камина было чудесно и <w>уютно</w> после долгой прогулки на морозе."
                            }
                        },
                        {
                            "text": "Er heerste een <w>behaaglijk</w> gevoel in de pas gerenoveerde woonkamer.",
                            "target_lang_translations": {
                                "en": "There was a <w>comfortable</w> feeling in the newly renovated living room.",
                                "ru": "В недавно отремонтированной гостиной царила <w>уютная</w> атмосфера."
                            }
                        }
                    ],
                    "synonyms": [
                        "behagelijk",
                        "comfortabel",
                        "knusjes"
                    ],
                    "antonyms": [
                        "onbehaaglijk"
                    ],
                    "common_phrases": [
                        "behaaglijk gevoel",
                        "behaaglijk warm"
                    ],
                    "target_lang_definitions": {
                        "en": "Pleasant and comfortable feeling, often characterized by pleasant warmth and coziness.",
                        "ru": "Приятный, уютный и комфортный, часто с ощущением приятного тепла."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cozy",
                                "target_lang_sense_clarification": "warm and comfortable atmosphere"
                            },
                            {
                                "target_lang_word": "snug",
                                "target_lang_sense_clarification": "comfortably sheltered and warm"
                            },
                            {
                                "target_lang_word": "comfortable",
                                "target_lang_sense_clarification": "giving a feeling of physical comfort"
                            }
                        ],
                        "ru": [
