                ],
                "senses": [
                    {
                        "sense_id": "1b0fe9bf-0328-38eb-98a2-eee35136fc46",
                        "entry_id": "1b3cb4de-57de-31bd-a01f-39f7b07e0b9c",
                        "glosses": [
                            "unbestimmtes Pronomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5915d373-cb53-4cea-acb5-441367c07936",
                                "sense_id": "1b0fe9bf-0328-38eb-98a2-eee35136fc46",
                                "text": "Wörter wie „jemand“, „kein(er)“, „einer“, „mancher“, „alle“ und „man“ sind Indefinitpronomen."
                            },
                            {
                                "example_id": "334176e1-873f-487d-832c-4cf3187532ce",
                                "sense_id": "1b0fe9bf-0328-38eb-98a2-eee35136fc46",
                                "text": "„Das Indefinitpronomen (lateinisch »indefinitus« ‚unbestimmt‘) bezeichnet eine Menge beziehungsweise ein einzelnes aus einer Menge, die je nach Kontext und Situation den Charakter der Unbestimmtheit aufweisen…“"
                            },
                            {
                                "example_id": "7477d9d3-ea97-4f57-af50-a906c78622e3",
                                "sense_id": "1b0fe9bf-0328-38eb-98a2-eee35136fc46",
                                "text": "„Zum Schluss noch ein wichtiger Punkt: Indefinitpronomen = unbestimmte Pronomen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
