                    {
                        "translation_id": "2462d87e-aa9c-440c-9f73-aa5de2dac1a7",
                        "source_entry_id": "1a8fda2f-be96-3465-805b-d509a12e84fe",
                        "source_sense_id": "3c1619f3-7bfe-3a74-8719-fbce82d90fb1",
