                        "glosses": [
                            "Kind einer Familie, in der wenigstens ein Elternteil eine akademische Ausbildung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fc736c-b5ac-43a6-a97d-28f8eb7eafe3",
                                "sense_id": "69e6ffd3-dbf5-3d87-9f4f-8fe510d41120",
                                "text": "„Die Unis sind vor allem eine Domäne von Akademikerkindern.“"
                            },
                            {
                                "example_id": "82bf1346-9eba-4249-9efd-59fe97b31d2b",
                                "sense_id": "69e6ffd3-dbf5-3d87-9f4f-8fe510d41120",
                                "text": "„Dass es mehr Akademikerkinder als je zuvor vorziehen, nach dem Abi eine Berufsausbildung zu machen, erstaunt auch die Hochschulforscher, die den Sozialbericht geschrieben haben.“"
                            }
                        ],
