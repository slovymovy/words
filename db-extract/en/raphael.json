                ],
                "senses": [
                    {
                        "sense_id": "671adda9-afcb-3f75-9b36-ad7364e26622",
                        "entry_id": "76ccb47f-4367-3d67-a404-8325c046fd06",
                        "glosses": [
                            "An archangel in Christianity, Judaism, and Islam."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "29fb6347-5814-4433-b485-b5cdbc538565",
                                "sense_id": "671adda9-afcb-3f75-9b36-ad7364e26622",
                                "text": "I am Raphael, one of the seven holy angels, which present the prayers of the saints, and which go in and out before the glory of the Holy One."
                            }
                        ]
                    },
                    {
                        "sense_id": "5568d81b-28f6-3518-af6d-86cdc048bcd3",
                        "entry_id": "76ccb47f-4367-3d67-a404-8325c046fd06",
                        "glosses": [
                            "A male given name from Hebrew."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9a951f30-0f9e-33a2-990c-850820adc16c",
                        "entry_id": "76ccb47f-4367-3d67-a404-8325c046fd06",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [
