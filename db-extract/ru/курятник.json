                        "entry_id": "167885d4-3952-306c-a2e5-bc0c5eae0ff2",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "куря́тниках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a24fc0a8-7ae4-3b25-9d83-131cb0751fbf",
                        "entry_id": "167885d4-3952-306c-a2e5-bc0c5eae0ff2",
                        "glosses": [
                            "помещение для кур"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26dbd521-23f2-4e55-8dd6-973377c20716",
                                "sense_id": "a24fc0a8-7ae4-3b25-9d83-131cb0751fbf",
                                "text": "Для этого у них имеются разные помещения ― сарай, курятник, хлев и другие."
                            }
                        ]
                    },
                    {
                        "sense_id": "19175a05-3806-3167-96e2-15e944651e5d",
                        "entry_id": "167885d4-3952-306c-a2e5-bc0c5eae0ff2",
                        "glosses": [
                            "перен., пренебр. маленькое, неуютное помещение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e7444e-593c-4b1e-a540-aa8933ee945c",
                                "sense_id": "19175a05-3806-3167-96e2-15e944651e5d",
                                "text": "Заморское «мыло» произвело на советских обывателей неизгладимое впечатление: достаточно сказать, что именно после него все «курятники» на шести сотках стали пышно именовать фазендами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9abe053-5bbe-4ae1-860a-f7041c62c77e",
                        "source_entry_id": "167885d4-3952-306c-a2e5-bc0c5eae0ff2",
                        "target_lang_word": "Hühnerstall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hühnerstall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eef8183-53be-3e41-ba3f-9a5e1fb16366",
                                        "entry_id": "6c72ada7-ff3c-32ba-a7d9-df2f70d59c84",
                                        "glosses": [
                                            "Verschlag oder Stall zur Unterbringung von Hühnervieh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99128bbd-e37e-4e48-a3cc-f5ec07a61936",
                                                "sense_id": "7eef8183-53be-3e41-ba3f-9a5e1fb16366",
                                                "text": "Am Abend gehen alle Hühner in den Hühnerstall."
                                            },
                                            {
                                                "example_id": "005727ac-78ad-4bda-8071-efa6db186659",
                                                "sense_id": "7eef8183-53be-3e41-ba3f-9a5e1fb16366",
                                                "text": "Mutter Else war nach der Stadt gefahren gewesen und hatte sich ein paar schneeweisse Hühner und einen schönen weissen Hahn zur Zucht mitgebracht; diese wurden den Abend auf der Flur von ihren Fußfesseln befreit und sollten in den Hühnerstall gesetzt werden."
                                            },
                                            {
                                                "example_id": "b5840338-1135-49e2-be93-371345fff206",
                                                "sense_id": "7eef8183-53be-3e41-ba3f-9a5e1fb16366",
                                                "text": "„Über dem Hof schwebte Musik, wurde von der düsteren Wand der Scheune zurückgeworfen und kam durch das Rohr des Kanonenofens in den Hühnerstall, wo die Mutter sich auf einen langen Abend eingerichtet hatte.“"
                                            },
                                            {
                                                "example_id": "b3b8debe-20f7-4a4a-85ff-8a6aff210cbd",
                                                "sense_id": "7eef8183-53be-3e41-ba3f-9a5e1fb16366",
                                                "text": "„Sie rannten zu den Heuballen, die den rückwärtigen Eingang des Kuhstalls versperrten, und krochen dann so tief geduckt wie möglich zum Hühnerstall unter dem Küchenfenster.“"
                                            },
                                            {
                                                "example_id": "069d3a50-876a-42e5-9011-7bd5afffce3d",
                                                "sense_id": "7eef8183-53be-3e41-ba3f-9a5e1fb16366",
                                                "text": "„Die arbeitet nach wie vor im Hühnerstall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
