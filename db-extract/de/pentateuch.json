                                    {
                                        "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                        "entry_id": "e9352b75-81ef-34f6-ac6f-f508c048072d",
                                        "glosses": [
                                            "Ensemble des cinq premiers livres de la Bible (Genèse, Exode, Lévitique, Nombres, et Deutéronome)."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15da0160-5c18-4f93-9654-9013710f5721",
                                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                                "text": "[…], il n'est pas nécessaire que ce serment soit reçu par le rabbin dans un temple Israélite; il suffit qu'il soit prêté devant le juge-commissaire, more judaico, la tête couverte et la main droite posée sur le Pentateuque hébraïque."
                                            },
                                            {
                                                "example_id": "bece4337-a688-4680-a3eb-10fb7e638195",
                                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                                "text": "Aux premiers temps du christianisme primitif, les lois alimentaires ont été abolies par Paul de Tarse. Vers la fin du premier siècle, il en va de même pour les sacrifices d'animaux et un certain nombre de règles figurant dans le Pentateuque."
                                            },
                                            {
                                                "example_id": "38c7b8c5-9080-4874-9ed5-2dfd188c83d6",
                                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                                "text": "Dans la Bible hébraïque, le livre du Deutéronome conclut le Pentateuque, mais pas seulement."
                                            },
                                            {
                                                "example_id": "915a6ff0-a90d-4192-a7c8-00c98a3690b2",
                                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                                "text": "Pour Paul, le passé, c'est le temps de la Torah, du Pentateuque, selon le nom que les Juifs d'Alexandrie donnèrent à cette dernière et qui fut repris par les chrétiens; …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
