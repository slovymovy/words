        "fr-extract.jsonl": [
            {
                "entry_id": "328f82a5-b780-3d81-b017-e8ca9ffde068",
                "word": "Barbier",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "938a8a7d-e554-347e-ab93-ee62d34a0177",
                        "entry_id": "328f82a5-b780-3d81-b017-e8ca9ffde068",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ae039f-6b58-4ff6-9f5d-94296f7b0aed",
                                "sense_id": "938a8a7d-e554-347e-ab93-ee62d34a0177",
                                "text": "Ronan Barbier, vainqueur senior hommes, et Evana Rémy-Buzaré, victorieuse simple dames, lors de la remise des récompenses par Jean-Yves Le Querrec, président du Tennis-club, dimanche 24 juillet."
                            },
                            {
                                "example_id": "a6daf3c5-f6ce-49cd-84fa-568aba5fbbd9",
                                "sense_id": "938a8a7d-e554-347e-ab93-ee62d34a0177",
                                "text": "Nathalie Barbier, avocate de l’une des victimes, affirme que l’ensemble des familles sont « très satisfaires de cette décision »."
                            },
                            {
                                "example_id": "59fd2c98-31df-4d75-96b2-40ed97c63c6e",
                                "sense_id": "938a8a7d-e554-347e-ab93-ee62d34a0177",
                                "text": "Les protégés de Bernard Barbier, l’ex-geek de la DGSE reconverti dans le cyber."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                "word": "barbier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ec67bfc-d00a-45b6-86c3-a2b0d356005c",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "tags": [
                            "plural"
                        ],
                        "form": "barbiers"
                    },
                    {
                        "form_id": "e6fcad72-745d-49bd-bd16-528bfaadf9b8",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "tags": [
                            "feminine"
                        ],
                        "form": "barbière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a58cbcc6-f057-30e8-84d8-3ab5b928f022",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "glosses": [
                            "Celui dont le métier est de couper la barbe ou les cheveux."
                        ],
                        "tags": [
                            "Métier",
                            "Barbe"
                        ],
                        "examples": [
                            {
                                "example_id": "8c68f386-ea40-459d-bbe8-613da15d5a4a",
                                "sense_id": "a58cbcc6-f057-30e8-84d8-3ab5b928f022",
                                "text": "C’était le mercredi 15 novembre de l’an de grâce 1665. Ce soir-là, il y avait petit souper et grande compagnie, rue Vieille-du-Temple, chez La Vienne, le baigneur à la mode, l'étuviste en renom, le barbier du monde élégant."
                            },
                            {
                                "example_id": "c5c7338e-7306-45cc-8b7a-a503b04cf0f8",
                                "sense_id": "a58cbcc6-f057-30e8-84d8-3ab5b928f022",
                                "text": "Ce sont les plaies faites maladroitement, par les barbiers d’occasion, à l’aide de mauvais rasoirs, voire même de couteaux, plus ou moins bien affilés, qui créent des portes d’entrée à la contamination."
                            },
                            {
                                "example_id": "9aee4812-5bb9-4ed7-9d31-e6097a960875",
                                "sense_id": "a58cbcc6-f057-30e8-84d8-3ab5b928f022",
                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui."
                            },
                            {
                                "example_id": "9c6cb32a-3681-4a8a-a0ab-06138b57b39a",
                                "sense_id": "a58cbcc6-f057-30e8-84d8-3ab5b928f022",
                                "text": "Les activités qui faisaient partie de ce qu'on appelle aujourd'hui “les services”, notamment les porteurs, les déchargeurs et autres charretiers, tout comme les lavandières et les barbiers, étaient également exclues à cette époque des communautés de métier."
                            },
                            {
                                "example_id": "39c97099-bfc8-4817-be51-c9b6d4ebf1c7",
                                "sense_id": "a58cbcc6-f057-30e8-84d8-3ab5b928f022",
                                "text": "Le meilleur barbier de France est à Brive, et il s’agit d’une barbière !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0379133-4aeb-3788-90f6-53a8fd313e4f",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "glosses": [
                            "Coiffeur pour homme, sans nécessairement qu’il coupe les barbes."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "bde3465e-a90c-4de3-aabf-06e09b995f2b",
                                "sense_id": "c0379133-4aeb-3788-90f6-53a8fd313e4f",
                                "text": "Ainsi, divers mots et expressions, courants au Québec au début du siècle, ont pratiquement disparu aujourd’hui. En voici… un barbier (un coiffeur) ; une bombe (une bouilloire) ; un haim (un hameçon) ; une pelle-à-feu (une sage-femme) ; etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "f95685b3-d1ac-3358-ac56-f228a6d61928",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "glosses": [
                            "Synonyme de barbier commun (poisson)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2bcdbeb7-517a-3123-9ed8-51758289cf13",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "glosses": [
                            "Synonyme de gobiésocidé ou porte-écuelle (poisson)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "63be30bd-66bf-3b3f-af56-8defb23d1574",
                        "entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "glosses": [
                            "Chirurgien."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "33891a8c-21f1-4a18-a5c2-ac33391cfb02",
                                "sense_id": "63be30bd-66bf-3b3f-af56-8defb23d1574",
                                "text": "(...) bien te blesseras quelque hutte, dont tu languiras toute ta vie entre les mains des barbiers."
                            },
                            {
                                "example_id": "6b3d4f0a-9dab-4725-9a86-dff8c6c7cad0",
                                "sense_id": "63be30bd-66bf-3b3f-af56-8defb23d1574",
                                "text": "On sait fort bien que beaucoup de barbiers avaient ajouté à leurs multiples activités médicales ou dentaires la pratique de l’orchidectomie (la castration), avec des instruments plus que primitifs et dans des conditions d’hygiène que l’on peut imaginer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8acf967-3382-4afa-b951-fcd72d7ba4a5",
                        "source_entry_id": "5a9e490e-3d01-32fb-b2f3-9e060ab5378f",
                        "target_lang_word": "Barbier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barbier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f40fb57-4fe7-3fc7-9ed1-c4cdb14afca3",
                                        "entry_id": "5cefe49b-80ad-3b3e-ab73-489e0f05fde8",
                                        "glosses": [
                                            "Bezeichnung für einen veralteten Beruf; ein Mann, dessen Handwerk es ist, das Kopfhaar seiner Klienten zu pflegen, unter Umständen jedoch auch Zähne zu ziehen, Aderlasse oder andere chirurgische Eingriffe durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b4c829-dab1-4dcc-9360-dd0f03976e0d",
                                                "sense_id": "0f40fb57-4fe7-3fc7-9ed1-c4cdb14afca3",
                                                "text": "„Gegen Mitternacht, als seine Wange noch dicker geworden war und jede Bewegung an jeder Stelle seines Körpers weh tat, wurde ihm klar, daß der Barbier den falschen Zahn gezogen hatte.“"
                                            },
                                            {
                                                "example_id": "64b523e1-c6c2-4f7b-888e-bd354e2d0c0a",
                                                "sense_id": "0f40fb57-4fe7-3fc7-9ed1-c4cdb14afca3",
                                                "text": "Sweeney Todd ist der Name eines fiktiven Barbiers, der sich angeblich als Mörder in London herumgetrieben hat."
                                            },
                                            {
                                                "example_id": "6e49d25e-de3d-43e6-a498-bbb692e93fea",
                                                "sense_id": "0f40fb57-4fe7-3fc7-9ed1-c4cdb14afca3",
                                                "text": "„Auf dem Marktplatz bei dem Barbier bediente eine bildhübsche junge Frau und ihre Nichte, ein schönes blutjunges Ding.“"
                                            },
                                            {
                                                "example_id": "354860ed-6f78-44d7-86cb-f33389518f04",
                                                "sense_id": "0f40fb57-4fe7-3fc7-9ed1-c4cdb14afca3",
                                                "text": "„Die Rasierklinge schabt wie beim Barbier, kurze gleichmäßige Züge und dann eine Pause.“"
                                            },
                                            {
                                                "example_id": "9c660fba-115a-4532-a209-f01dfe4bae6e",
                                                "sense_id": "0f40fb57-4fe7-3fc7-9ed1-c4cdb14afca3",
                                                "text": "„Als Cook später wieder wegen eines polynesischen Diebes in Rage geriet, befahl er dem Barbier des Schiffes, dem Mann den Kopf zu rasieren und ihm die Ohren abzuschneiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
