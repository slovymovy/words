                                        "examples": [
                                            {
                                                "example_id": "5f364ac3-e1d8-4900-81e2-3292899cad4f",
                                                "sense_id": "3276790d-1640-3791-8939-7ff8a2d63b9c",
                                                "text": "Ich denke jetzt anders darüber, als ich es früher gemacht habe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfaedb07-be7c-4810-8f7f-a98785d4d101",
                        "source_entry_id": "149802b3-7e19-308b-8ef9-df3d643503d2",
                        "source_sense_id": "ee8aeae7-ec37-32f3-ba6d-379a4e8034fb",
                        "source_sense_description": "zur jetzigen Zeit; aktuell, jetzt, gegenwärtig, zurzeit, momentan",
                        "target_lang_word": "gegenwärtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gegenwärtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89f82ba6-e6b5-3471-a0de-e0c5dc7ae755",
                                        "entry_id": "49ab1a9d-84e3-3517-be2c-514f203bd569",
                                        "glosses": [
                                            "jetzig, in der Gegenwart geschehend; sich im zeitlichen Jetzt zwischen der Vergangenheit und der Zukunft ereignend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "407fc2bb-ac9d-4644-9361-b40330d938a3",
                                                "sense_id": "89f82ba6-e6b5-3471-a0de-e0c5dc7ae755",
                                                "text": "Zum gegenwärtigen Zeitpunkt können wir noch nichts sagen."
                                            },
                                            {
                                                "example_id": "d9502e13-fe9b-4af1-be76-72ac428b08d2",
                                                "sense_id": "89f82ba6-e6b5-3471-a0de-e0c5dc7ae755",
                                                "text": "In der gegenwärtigen Schriftsprache kommt diese Form nicht mehr vor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ffba22dd-aa0c-34ea-9393-e655af4415bf",
                                        "entry_id": "49ab1a9d-84e3-3517-be2c-514f203bd569",
                                        "glosses": [
                                            "sich bei einem Ereignis befindlich"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ec3af8-6f55-4b42-b77b-951efc05e4c8",
                                                "sense_id": "ffba22dd-aa0c-34ea-9393-e655af4415bf",
                                                "text": "„Mehrere Sachkundige sind der Meinung, dass der Autor bei den beschriebenen Pokerspielen nicht gegenwärtig war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd109959-2cfe-3bca-aa11-980e0f4927d9",
                                        "entry_id": "49ab1a9d-84e3-3517-be2c-514f203bd569",
                                        "glosses": [
                                            "derzeit, im Moment, in der Gegenwart"
                                        ],
                                        "tags": [
                                            "adverbieller Gebrauch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e591e73a-99b4-435f-be03-7b936f79dad0",
                                                "sense_id": "dd109959-2cfe-3bca-aa11-980e0f4927d9",
                                                "text": "Wir sind gegenwärtig auf der Suche nach einem Nachfolger."
                                            },
                                            {
                                                "example_id": "b289d379-5a06-4f10-9a09-40ad931368d9",
                                                "sense_id": "dd109959-2cfe-3bca-aa11-980e0f4927d9",
                                                "text": "Ich finde, dass gegenwärtig zu wenig in Bildung investiert wird."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bacfca8-f5b3-4577-aeed-90cf9f6c284e",
                        "source_entry_id": "149802b3-7e19-308b-8ef9-df3d643503d2",
                        "source_sense_id": "ee8aeae7-ec37-32f3-ba6d-379a4e8034fb",
                        "source_sense_description": "zur jetzigen Zeit; aktuell, jetzt, gegenwärtig, zurzeit, momentan",
                        "target_lang_word": "zurzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zurzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b523b51-402c-3a9a-9623-615e9c729821",
                                        "entry_id": "fac96c14-7a47-3717-87c6-ad36cf7456bd",
                                        "glosses": [
                                            "in diesem Moment, gerade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028f98d6-984d-4c1f-9af0-b684d718477d",
                                                "sense_id": "9b523b51-402c-3a9a-9623-615e9c729821",
                                                "text": "Alle Telefonleitungen sind zurzeit besetzt."
                                            },
                                            {
                                                "example_id": "bcf581d8-fbc6-488a-b458-21f929787f6c",
                                                "sense_id": "9b523b51-402c-3a9a-9623-615e9c729821",
                                                "text": "Zurzeit ist Guntbrecht arbeitslos."
                                            },
                                            {
                                                "example_id": "5ee0cf4b-16e3-4b39-ab8b-20bfa174f70b",
                                                "sense_id": "9b523b51-402c-3a9a-9623-615e9c729821",
                                                "text": "„In der Europäischen Union sind zurzeit ca. 300 Zusatzstoffe zugelassen, die im Klartext auf der Packung aufgeführt oder durch Angabe der E-Nummern kenntlich gemacht werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c813e32-67d1-40f5-89a8-20ea0e71219a",
                        "source_entry_id": "149802b3-7e19-308b-8ef9-df3d643503d2",
                        "source_sense_id": "ee8aeae7-ec37-32f3-ba6d-379a4e8034fb",
                        "source_sense_description": "zur jetzigen Zeit; aktuell, jetzt, gegenwärtig, zurzeit, momentan",
                        "target_lang_word": "momentan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
