        "fr-extract.jsonl": [
            {
                "entry_id": "4512eb19-e0b1-360f-854d-b4c78fb5fb03",
                "word": "cahotement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f94f643e-733e-4039-bcc3-b2781b06df8a",
                        "entry_id": "4512eb19-e0b1-360f-854d-b4c78fb5fb03",
                        "tags": [
                            "plural"
                        ],
                        "form": "cahotements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b721b105-5489-3612-b494-88ba6dbcc4c4",
                        "entry_id": "4512eb19-e0b1-360f-854d-b4c78fb5fb03",
                        "glosses": [
                            "Secousse qu’on éprouve dans une voiture qui cahote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0188bf68-506e-42bb-a4ac-8d85900a48a3",
                                "sense_id": "b721b105-5489-3612-b494-88ba6dbcc4c4",
                                "text": "Ils entendirent, dans le silence des bois, le bruit éloigné du petit train dont le cahotement rythmé leur était familier et qu’ils imitaient souvent, l’hiver, à Bordeaux, pour se rappeler le bonheur des vacances."
                            },
                            {
                                "example_id": "7a799067-d9d9-4597-9726-37ef15db9441",
                                "sense_id": "b721b105-5489-3612-b494-88ba6dbcc4c4",
                                "text": "Le cahotement des roues du convoi m’irrite, mais c’est avec ma mémoire que je suis en procès."
                            },
                            {
                                "example_id": "39fdcf2e-ef4f-4832-959c-996c2918668b",
                                "sense_id": "b721b105-5489-3612-b494-88ba6dbcc4c4",
                                "text": "Pendant des jours, un certain nombre de jours encore, la vue à la fois vague et fixe de la bohémienne, obstinément retournée contre le fond, s’attachait, par l’ouverture de la lucarne, à la nature fuyante derrière la voiture, — et qui lointainement se perdait, se brouillait, disparaissait, en tressautant, dans le cahotement des mauvais chemins."
                            }
                        ]
                    },
                    {
                        "sense_id": "434ccfef-3bca-33c1-abcc-7bc552ff5eb8",
                        "entry_id": "4512eb19-e0b1-360f-854d-b4c78fb5fb03",
                        "glosses": [
                            "Mouvement évoquant une secousse."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff58a51-b608-49ce-832a-8f3779c20769",
                                "sense_id": "434ccfef-3bca-33c1-abcc-7bc552ff5eb8",
                                "text": "Le temps était noir comme la tombe, et le vent qui berçait des monceaux de nuages faisait de leurs cahotements ruisseler une averse de grêle et de pluie."
                            }
                        ]
                    }
                ],
