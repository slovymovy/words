                                ]
                            },
                            {
                                "target_word": "overblijvend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a321cba7-2cc3-3b7a-b479-acd48d98f469",
                                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                                        "glosses": [
                                            "van een kind dat het tussen de middag op school blijft in plaats van naar huis te gaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd69280e-cf36-43ae-98cf-80f09757a3e7",
                                                "sense_id": "a321cba7-2cc3-3b7a-b479-acd48d98f469",
                                                "text": "De overblijvende kinderen hadden brood, fruit en melk meegenomen van huis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3012666d-b346-3f9c-ac00-bdb56966a854",
                                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                                        "glosses": [
                                            "resterend na vertrek of ontslag van anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c91036-1083-4982-b706-87531e29a6c0",
                                                "sense_id": "3012666d-b346-3f9c-ac00-bdb56966a854",
                                                "text": "Dit jaar moet de organisatie verder op poten worden gezet. Ook worden allerhande veranderingen doorgevoerd met flitsende Engelse namen als Blackboard en Peoplesoft. De opleidingen worden ondergebracht in zestien schools, zoals de School of Economics en de School of Social Work. Deze zijn verspreid over zes hoofd- en vier nevenlocaties. Arbeidsplaatsen worden geschrapt, waardoor docenten en andere medewerkers vertrekken. De onderwijsinspectie concludeert dat deskundigheid en ervaring hieronder lijden en de druk op het overblijvende personeel vergroot wordt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe35f1f-7a51-3c56-b73a-cfc873cacc5c",
                                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                                        "glosses": [
                                            "niet gebruikt; overtallig, overbodig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89aded4e-deaf-4fc6-820c-e9f41acbafdd",
                                                "sense_id": "8fe35f1f-7a51-3c56-b73a-cfc873cacc5c",
                                                "text": "Omdat de griep altijd nog kan verergeren, worden de overblijvende virusremmers en vaccins op voorraad gehouden. Minister Klink liet doorschemeren dat mensen die niet tot de risicogroepen behoren maar tóch willen worden gevaccineerd, dit wellicht tegen betaling kunnen laten doen."
                                            },
                                            {
                                                "example_id": "ffd42c81-3296-4a69-a2cf-1c8a336d7bdf",
                                                "sense_id": "8fe35f1f-7a51-3c56-b73a-cfc873cacc5c",
                                                "text": "De koppeling knuffel-healing is in het geval van de veertigduizend Nederlandse knuffelbeesten losgelaten, meldde Dorien Striekwold onlangs op de actiewebsite. De overblijvende knuffels worden gewoon uitgedeeld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2485d4d-380b-379a-bdd6-58ef0ab95002",
                                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                                        "glosses": [
                                            "in staat meermaals te bloeien tijdens de levensduur"
                                        ],
                                        "tags": [
                                            "planteneigenschap"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "291396a1-bdb6-4963-8873-9bc6612a997f",
                        "source_entry_id": "1872f7a8-50c9-3b0d-90b6-a5ed3b307c34",
