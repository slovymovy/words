                ],
                "senses": [
                    {
                        "sense_id": "fd900c87-6b08-350d-9627-fce76be58e5c",
                        "entry_id": "f2bfb770-818a-32a3-93ee-2aac36e03db5",
                        "glosses": [
                            "an der Wand eines Gebäudes (zum Beispiel im eigenen Heim) angebrachte Ladestation für E-Autos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9548ca3f-8166-4d9f-87ab-e1b027db8fdc",
                                "sense_id": "fd900c87-6b08-350d-9627-fce76be58e5c",
                                "text": "„Zum Volltanken an die Tankstelle? Ganz normal beim Verbrenner. Elektroautos werden geladen, idealerweise zuhause – an der eigenen Wallbox.“"
                            },
                            {
                                "example_id": "a6fa073b-46c0-4457-9765-6cf2c5ac7c04",
                                "sense_id": "fd900c87-6b08-350d-9627-fce76be58e5c",
                                "text": "„In den vergangenen Monaten ist die Nachfrage nach solchen Wallboxen rasant gestiegen.“"
                            },
                            {
                                "example_id": "0f4353df-9382-48a9-9d83-52461c5518f1",
                                "sense_id": "fd900c87-6b08-350d-9627-fce76be58e5c",
                                "text": "„Entweder man kauft den Aufbau der Wallbox direkt mit dem Kasten oder man engagiert selbst einen Fachmann.“"
                            },
                            {
                                "example_id": "874f46e7-f439-49be-90ce-31280e1783a4",
                                "sense_id": "fd900c87-6b08-350d-9627-fce76be58e5c",
                                "text": "„Der Markt für Wallboxen ist insgesamt recht unübersichtlich, es gibt eine Vielzahl von Anbietern.“"
                            },
                            {
                                "example_id": "85c7265c-0b18-40b7-aa0e-8e51eaf3f3c8",
                                "sense_id": "fd900c87-6b08-350d-9627-fce76be58e5c",
                                "text": "„Seit 2018 vertreibt das Unternehmen eine eigene Wallbox.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
