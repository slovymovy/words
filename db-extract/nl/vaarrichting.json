                                "target_senses": [
                                    {
                                        "sense_id": "5c8fd61b-8f04-3262-aed0-8ceb55a619a0",
                                        "entry_id": "aff728a0-68bf-3550-a2d0-0120bddd3df0",
                                        "glosses": [
                                            "eine eingeschlagene, vorgeschriebene oder aufgezeichnete Richtung einer Person, eines Fahrzeuges, eines Flugzeugs oder eines Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a4a834-ef6c-47f8-8c72-ff6c7a24ae30",
                                                "sense_id": "5c8fd61b-8f04-3262-aed0-8ceb55a619a0",
                                                "text": "Kurs Südsüdost liegt an."
                                            },
                                            {
                                                "example_id": "df9e3ac9-e4cf-425f-86a2-02e3e949e90a",
                                                "sense_id": "5c8fd61b-8f04-3262-aed0-8ceb55a619a0",
                                                "text": "Der 360-Grad-Kurs führte durch den Wald."
                                            },
                                            {
                                                "example_id": "54fab6ed-54cc-4939-a328-dd79c96d5672",
                                                "sense_id": "5c8fd61b-8f04-3262-aed0-8ceb55a619a0",
                                                "text": "„Die ›Exitus‹ verändert jede Nacht ihren Kurs.“"
                                            },
                                            {
                                                "example_id": "e8035ab7-6aab-478c-b06b-fa8c108e753f",
                                                "sense_id": "5c8fd61b-8f04-3262-aed0-8ceb55a619a0",
                                                "text": "„Cook drehte nach Westen ab und hielt diesen Kurs ungefähr einen Monat lang, wobei außer Seehunden und Albatrossen wenig gesichtet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7ae627e-a29d-3aa8-85de-2b457d3813aa",
                                        "entry_id": "aff728a0-68bf-3550-a2d0-0120bddd3df0",
                                        "glosses": [
                                            "nach bestimmten Prinzipien festgelegte Richtung, Generallinie"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc324ce3-2da2-493b-8f57-a9212a6f5e0d",
                                                "sense_id": "e7ae627e-a29d-3aa8-85de-2b457d3813aa",
                                                "text": "Japans Zentralbank hält vorerst an ihrem geldpolitischen Kurs [des Ankaufs von Staatsanleihen und riskantere Wertpapiere in großem Stil] fest."
                                            },
                                            {
                                                "example_id": "f4f46452-eb5f-4c4c-9d09-b6565b75ea6b",
                                                "sense_id": "e7ae627e-a29d-3aa8-85de-2b457d3813aa",
                                                "text": "„Auch beim Thema Flüchtlingspolitik scheint der Kurs offener als je zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                        "entry_id": "aff728a0-68bf-3550-a2d0-0120bddd3df0",
                                        "glosses": [
                                            "eine Lehrveranstaltung, eine Bildungsveranstaltung, ein Abschnitt oder Modul einer solchen Veranstaltung"
                                        ],
                                        "tags": [
                                            "Ausbildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "493f53c3-c87e-44d1-89dc-8ad74fe3b3cb",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "„In der Literatur bisher weniger beachtet wurden die in den siebziger Jahren entwickelten Curricula […] zu einem mehrperspektivischen Unterricht […], in denen Lernen in Projekten und Kursen das grundlegende Vermittlungsverfahren ist.“"
                                            },
                                            {
                                                "example_id": "0fa77dde-bc8a-4575-9623-9e61bc108fc8",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "Der HTML-Kurs ist online abrufbar."
                                            },
                                            {
                                                "example_id": "a9c32352-ddee-4625-adf7-b0b76f115185",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "Dieser Kurs findet in Haus 13 statt."
                                            },
                                            {
                                                "example_id": "a9df14d7-59ac-45a8-9dc5-3632c7bfd8c2",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "Hier sind wir mit 20 Leuten im Kurs und nicht mit 700 im Hörsaal der Uni."
                                            },
                                            {
                                                "example_id": "34b4ab6c-2586-4804-9b86-ca8b8f8a7df4",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "Im Kurs der \"Speedstudents\" sitze ich zwischen 30 Stundenten; jeder liest ein Buch seiner Wahl."
                                            },
                                            {
                                                "example_id": "1626892c-9ded-43f2-8368-815913c369bb",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "Der kostenlose Online-Sprachkurs Deutsch Interaktiv richtet sich an Deutschlerner der Niveaustufen A1 bis B1 des Europäischen Referenzrahmens."
                                            },
                                            {
                                                "example_id": "bcb558e8-cd4e-4632-a7da-0a3ba92117e7",
                                                "sense_id": "2600a15a-1336-38b6-8a7f-c1c6ace03239",
                                                "text": "„Auch das lehre Selbstkontrolle, meinte sie schulterzuckend, und dass für Milena der Kurs dann wohl Strafe genug gewesen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3b84c2b-cfe1-3a4a-992d-bb15db688e5c",
                                        "entry_id": "aff728a0-68bf-3550-a2d0-0120bddd3df0",
                                        "glosses": [
                                            "Handelspreis eines Wertpapieres"
                                        ],
