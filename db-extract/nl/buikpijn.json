                                "sense_id": "a47e5a0c-4ead-333a-8d86-c91461cfc0ba",
                                "text": "Ik heb buikpijn na het eten van te veel snoep.",
                                "translation": "I have a bellyache after eating too much candy.",
                                "english": "I have a bellyache after eating too much candy."
                            },
                            {
                                "example_id": "fa252750-1829-416c-8960-ea660a341f8c",
                                "sense_id": "a47e5a0c-4ead-333a-8d86-c91461cfc0ba",
                                "text": "Ze klaagt over buikpijn en kan niet naar school gaan.",
                                "translation": "She's complaining of stomachache and can't go to school.",
                                "english": "She's complaining of stomachache and can't go to school."
                            },
                            {
                                "example_id": "fba3bfcc-4bf0-49e2-9653-90daa67df0c7",
                                "sense_id": "a47e5a0c-4ead-333a-8d86-c91461cfc0ba",
                                "text": "Deze thee kan helpen bij buikpijn.",
                                "translation": "This tea may help with stomachache.",
                                "english": "This tea may help with stomachache."
                            }
                        ]
