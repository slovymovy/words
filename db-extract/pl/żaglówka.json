                                    {
                                        "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                        "entry_id": "81f4829d-95a2-3701-bb28-66e27620c63d",
                                        "glosses": [
                                            "ein Sportboot, das in erster Linie durch Windkraft angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82facca3-107f-48b3-ac11-4b70b3d1f32e",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "Segelboote benutzen Segel, um die Energie des Windes in Fahrt umzusetzen."
                                            },
                                            {
                                                "example_id": "d418a89c-c2d4-4c66-bf07-3f0929d82e08",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "„Derweil überholt die MS Regina ein kleines Segelboot, ein Einmaster aus Holz mit einem blendend-weißen Segel, in dem ein Mann und eine Frau, beide in unserem Alter, sitzen.“"
                                            },
                                            {
                                                "example_id": "7ef90544-3981-4b91-b5a5-922299383e4f",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "„Sie schlug die Augen auf und fand sich auf den Planken eines Segelboots, auf Philips Mantel, der sie vor Flugsand schützte, vor Wassertropfen und Insekten.“"
                                            },
                                            {
                                                "example_id": "184a345a-1df5-4e31-9744-fc40c6476650",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "„Ein Segelboot jagte über den Sund, eine weiße, sonnengefüllte Schwinge in dem vielen Blau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
