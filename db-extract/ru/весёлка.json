                "senses": [
                    {
                        "sense_id": "1c277e13-0027-314f-aa84-80ef19dfd62a",
                        "entry_id": "193d24df-382d-379f-965f-1ca82bb1bf99",
                        "glosses": [
                            "ботан. гриб порядка гастеромицетов (Phallus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f92f32-585b-4605-bf0b-964d347839fe",
                                "sense_id": "1c277e13-0027-314f-aa84-80ef19dfd62a",
                                "text": "Хорошо известны лечебные свойства весёлки ― её настойка заживляет раны."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba0fce16-b17b-3e24-9ba3-3c8dbe766460",
                        "entry_id": "193d24df-382d-379f-965f-1ca82bb1bf99",
                        "glosses": [
                            "рег. лопатка для размешивания растворов, жидкого теста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99f1a13a-328d-4fc7-b3b0-461606bb8cf7",
                                "sense_id": "ba0fce16-b17b-3e24-9ba3-3c8dbe766460",
                                "text": "Мы едим хлеб и смотрим, как Саня с другим монашком помешивают весёлками в низких кадках — разводят квас."
                            }
                        ]
                    }
                ],
