    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d7616302-770c-3b20-8988-de07e045d459",
                    "sense_definition": "Fully grown and ready to be harvested, eaten, or used (of fruit, grain, or vegetables).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maturity_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bananas are yellow and <w>ripe</w> enough to eat.",
                            "target_lang_translations": {
                                "ru": "Бананы желтые и достаточно <w>спе́лые</w>, чтобы их есть.",
                                "de": "Die Bananen sind gelb und <w>reif</w> genug zum Essen."
                            }
                        },
                        {
                            "text": "Farmers wait until the wheat is fully <w>ripe</w> before harvesting it.",
                            "target_lang_translations": {
                                "ru": "Фермеры ждут, пока пшеница станет полностью <w>зре́лой</w>, прежде чем собирать урожай.",
                                "de": "Landwirte warten, bis der Weizen voll <w>reif</w> ist, bevor sie ihn ernten."
                            }
                        }
                    ],
                    "synonyms": [
                        "mature",
                        "ready"
                    ],
                    "antonyms": [
                        "unripe"
                    ],
                    "common_phrases": [
                        "ripe fruit",
                        "ripe banana",
                        "ripe tomato"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью выросший и готовый к сбору или употреблению (о фруктах, зерне или овощах).",
                        "de": "Vollständig entwickelt und bereit zur Ernte oder zum Verzehr (bei Obst, Getreide oder Gemüse)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спе́лый",
                                "target_lang_sense_clarification": "готовый к употреблению (о плодах)"
                            },
                            {
                                "target_lang_word": "зре́лый",
                                "target_lang_sense_clarification": "достигший полного развития"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "reif",
                                "target_lang_sense_clarification": "bereit zum Verzehr oder zur Ernte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab378a31-37f5-33fa-ac51-35bebfce6958",
                    "sense_definition": "Completely ready or suitable for a particular action, change, or event.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "readiness_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The time is <w>ripe</w> for us to make a change in our strategy.",
                            "target_lang_translations": {
                                "ru": "Время <w>созре́ло</w> для того, чтобы мы внесли изменения в нашу стратегию.",
                                "de": "Die Zeit ist <w>reif</w> für uns, eine Änderung in unserer Strategie vorzunehmen."
                            }
                        },
                        {
                            "text": "After years of neglect, the industry was <w>ripe</w> for reform.",
                            "target_lang_translations": {
                                "ru": "После долгих лет запустения отрасль <w>созре́ла</w> для реформ.",
                                "de": "Nach Jahren der Vernachlässigung war die Industrie <w>reif</w> für Reformen."
                            }
                        }
                    ],
                    "synonyms": [
                        "ready",
                        "prepared",
                        "set"
                    ],
                    "common_phrases": [
                        "the time is ripe",
                        "ripe for change",
                        "ripe for the picking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью готовый или подходящий для определенного действия, изменения или события.",
                        "de": "Vollständig bereit oder geeignet für eine bestimmte Handlung, Veränderung oder ein Ereignis."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гото́вый",
                                "target_lang_sense_clarification": "подготовленный к чему-либо"
                            },
                            {
                                "target_lang_word": "созре́вший",
                                "target_lang_sense_clarification": "достигший нужного момента"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "reif",
                                "target_lang_sense_clarification": "bereit für eine Entwicklung oder ein Ereignis"
                            },
                            {
                                "target_lang_word": "bereit",
                                "target_lang_sense_clarification": "vorbereitet auf etwas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09ccc737-6ae6-32d6-b078-38161e8932ba",
                    "sense_definition": "Fully aged and developed in flavor (especially of cheese or wine).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "maturity_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served a very <w>ripe</w> cheese that had a strong aroma.",
                            "target_lang_translations": {
                                "ru": "Он подал очень <w>вы́держанный</w> сыр с сильным ароматом.",
                                "de": "Er servierte einen sehr <w>reifen</w> Käse, der ein starkes Aroma hatte."
                            }
                        },
                        {
                            "text": "This <w>ripe</w> wine pairs perfectly with the steak.",
                            "target_lang_translations": {
                                "ru": "Это <w>вы́держанное</w> вино идеально сочетается со стейком.",
                                "de": "Dieser <w>reife</w> Wein passt perfekt zum Steak."
                            }
                        }
                    ],
                    "synonyms": [
                        "aged",
                        "matured",
                        "mellow"
                    ],
                    "common_phrases": [
