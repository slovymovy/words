                                "sense_id": "db84bb40-f204-3747-9c63-cbef9e6cce3e",
                                "text": "He is wearing a freshly starched cravat and a new sergdusoy jacket, his boots are polished and he carries a clumsily wrapped package under his arms."
                            }
