                        "examples": [
                            {
                                "example_id": "cd66ef85-d197-4c8b-97b8-ecea52dd6282",
                                "sense_id": "de6f45af-9d8d-3ec3-9918-b9df6a6d0586",
                                "text": "Apollo 8 uit het Overijsselse Borne jaagt nog op zijn eerste titel. Vorig jaar pakte de ploeg voor het eerst in zijn bestaan de beker. Sliedrecht won die prijs dit seizoen, voor de zesde keer in de clubgeschiedenis."
                            },
                            {
                                "example_id": "fb809be9-f541-43cd-8666-aba330dd6808",
                                "sense_id": "de6f45af-9d8d-3ec3-9918-b9df6a6d0586",
                                "text": "Orion vocht in de thuishal in Doetinchem voor z'n laatste kans. De eerste twee wedstrijden waren beide met 3-1 gewonnen door Dynamo, waardoor Orion het derde duel moest winnen om zicht te houden op het derde landskampioenschap in de clubgeschiedenis."
                            },
                            {
                                "example_id": "e1309616-72d7-40cf-bc02-3de87e1b6d94",
                                "sense_id": "de6f45af-9d8d-3ec3-9918-b9df6a6d0586",
                                "text": "En bovenal was dat het elftal van de Braziliaans middenvelder Falcão, bijgenaamd de Achtste Koning van Rome. Na Francesco Totti geldt hij nog altijd als de grootste speler in de clubgeschiedenis."
                            }
                        ]
