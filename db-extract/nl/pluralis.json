                    {
                        "sense_id": "67a66f15-0842-3fe2-96e0-d37197062107",
                        "entry_id": "18df738e-e4f0-3557-ac11-60f53a7df743",
                        "glosses": [
                            "geval waarin een woord verwijst naar meerdere exemplaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe8ffd6-3193-4bf8-a4d7-59766c233f27",
                                "sense_id": "67a66f15-0842-3fe2-96e0-d37197062107",
                                "text": "De toekenning van het bepaald lidwoord in de pluralis levert voor de kinderen en studenten geen problemen op. De studenten kennen bij elk zelfstandig naamwoord het bepaald lidwoord \"de\" toe en de kinderen doen dat, met één uitzondering waarbij het onbepaald lidwoord \"een\" gebruikt werd, ook."
                            }
                        ]
                    },
                    {
                        "sense_id": "789a0aaa-1813-3af4-b9ea-bbe519779d2b",
                        "entry_id": "18df738e-e4f0-3557-ac11-60f53a7df743",
                        "glosses": [
                            "vorm die een woord aanneemt als het verwijst naar meerdere exemplaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589a4a1f-44f0-4f70-9d4c-766716e2206e",
                                "sense_id": "789a0aaa-1813-3af4-b9ea-bbe519779d2b",
                                "text": "Aangezien er sprake is van nachtvlinders, van een pluralis, kan aangenomen worden dat de hoofdpersoon lange tijd - wellicht een hele nacht - als een spin in een web zit."
                            }
                        ]
                    }
