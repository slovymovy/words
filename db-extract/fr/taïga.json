                        ],
                        "form": "taïgas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                        "entry_id": "f89deb6c-c13d-3223-b44e-714b1777b6f4",
                        "glosses": [
                            "Forêt de conifères de climat boréal, dans le nord de l’Europe, de l’Asie et de l’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e100bfed-5fdb-4595-9e05-1b5ce5e06a5d",
                                "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                "text": "Mais il ne s’agit jamais de pergélisol continu. De fait, seule la taïga russe est affectée par ce phénomène."
                            },
                            {
                                "example_id": "84fa781b-5ef8-4877-bef4-d854e644a32d",
                                "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                "text": "Regarder vers l’est était le pire. La Sibérie orientale et la taïga."
                            },
                            {
                                "example_id": "b6b25d74-0ba3-4161-9eb6-688f32f59ed4",
                                "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                "text": "Bien caché sous mon affût, je contemple le paysage de taïga saupoudré de neige, qui se ternit sous l’étreinte de la nuit et se momifie progressivement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06bf9b35-7bda-4096-bda1-60147b1fd8fa",
                        "source_entry_id": "f89deb6c-c13d-3223-b44e-714b1777b6f4",
                        "source_sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                        "target_lang_word": "borealer Wald",
                        "target_lang_code": "de",
