                        "examples": [
                            {
                                "example_id": "15b8d1bf-d9b6-40c4-bfb6-abbe2aafa3e1",
                                "sense_id": "56113039-22a2-3ad7-b288-38905f635b26",
                                "text": "« Tout ce que j’ai pu faire avec l’équipe nationale me rend très fier », a déclaré le désormais ex-sélectionneur."
                            },
                            {
                                "example_id": "a87cd085-4e5e-46d4-b784-1e439f728897",
                                "sense_id": "56113039-22a2-3ad7-b288-38905f635b26",
                                "text": "Il ne comprenait pas pourquoi son ex-sélectionneur lui avait joué un tel tour."
                            },
                            {
                                "example_id": "af86175f-5ff2-482b-8fff-70dcb0325a62",
                                "sense_id": "56113039-22a2-3ad7-b288-38905f635b26",
                                "text": "Tout le mois de juillet, l’ex-sélectionneur multiplie les allers et retours entre sa résidence secondaire de Cassis et la ville de Barcelone où se déroulent les vingt-deuxièmes Jeux olympiques d'été."
                            }
