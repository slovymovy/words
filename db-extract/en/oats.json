                                "sense_id": "7adfbc8a-365b-3d6c-84bb-3cdb72ecbbae",
                                "text": "Oats are in the north corner of the farm."
                            },
                            {
                                "example_id": "23f53bec-f459-44c0-b3aa-b98bf939a6f1",
                                "sense_id": "7adfbc8a-365b-3d6c-84bb-3cdb72ecbbae",
                                "text": "Usually oats is last in a rotation and does not get the fertilizer that other feed grains get."
                            }
                        ]
