                        "entry_id": "8c77ab7f-c89e-379d-89d8-af493270eaf0",
                        "glosses": [
                            "A male given name from Latin, equivalent to Italian Tiziano, notably used in reference to",
                            "Tiziano Vecellio (c. 1488/1490 – 1576), an Italian Renaissance painter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997be8f5-3cc2-4150-b8c7-2122dbab7d22",
                                "sense_id": "a6707879-82f9-37ea-8b33-d8087f22b770",
                                "text": "There are no evidences in these days of Michelangelos and Titians, who at the age of eighty or ninety could turn out stronger work than our people of thirty and forty today! Nowhere else in the world is there any such evidence. But there is a sympathy, a tenderness of understanding in these modern painters which is as typical of this age, as the titanic :power of the Tintorettos and Titians."
                            }
                        ]
                    }
