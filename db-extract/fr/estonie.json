        "fr-extract.jsonl": [
            {
                "entry_id": "6bf91ff4-5895-322c-a9d6-07f195306991",
                "word": "Estonie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d17ef44-76b0-30ab-97e1-87a890ca589d",
                        "entry_id": "6bf91ff4-5895-322c-a9d6-07f195306991",
                        "glosses": [
                            "Pays d’Europe orientale, bordé par le golfe de Finlande au nord, la Russie à l’est, la Lettonie au sud, et la mer Baltique à l’ouest. Sa capitale est Tallinn."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "27508a5f-4ae5-4d5b-b190-de483ca85fe7",
                                "sense_id": "3d17ef44-76b0-30ab-97e1-87a890ca589d",
                                "text": "En fait, ils s’étaient rendus en Estonie chez les parents du musicien, que Jeanne et Egon n’avaient plus revus depuis la visite qui avait suivi le mariage à Dresde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a84c77bd-44a2-4370-96b8-5a3a69532c36",
                        "source_entry_id": "6bf91ff4-5895-322c-a9d6-07f195306991",
                        "source_sense_id": "3d17ef44-76b0-30ab-97e1-87a890ca589d",
                        "target_lang_word": "Estland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                        "entry_id": "165bd71e-e546-3546-84b9-6b497e66b0cc",
                                        "glosses": [
                                            "ein Land im Baltikum (Nordeuropa)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dde040c-0a5d-4584-9353-ae0f51c8e43b",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Das heutige Estland ist Europa wieder nähergekommen."
                                            },
                                            {
                                                "example_id": "bb50fc1e-25a0-4637-b6de-435ee8fbe5ee",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Tallinn ist die Hauptstadt von Estland."
                                            },
                                            {
                                                "example_id": "fb42206f-2cea-4cc1-bfa8-cfbd0e09365f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Haupthandelspartner Estlands sind die skandinavischen Nachbarländer Schweden und Finnland sowie die Baltikum-Nachbarstaaten Lettland und Litauen.“"
                                            },
                                            {
                                                "example_id": "492477d2-238f-44ab-97da-eb4b0131f07a",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„In Estland und Litauen entstanden auch Lokalposten: echte Bedarfsbriefe sind jedoch nur wenige bekannt.“"
                                            },
                                            {
                                                "example_id": "1d011b8b-a9b4-48a7-8a08-c09b978dcc3f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Wer in Estland russisch spricht, macht sich verdächtig: der Zuneigung zu Wladimir Putin und seinem neoimperialen Projekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44661d98-4b14-41a7-b26c-a7eb333a0706",
                        "source_entry_id": "6bf91ff4-5895-322c-a9d6-07f195306991",
                        "source_sense_id": "3d17ef44-76b0-30ab-97e1-87a890ca589d",
