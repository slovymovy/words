        "fr-extract.jsonl": [
            {
                "entry_id": "69ffb0c5-2989-3cc4-808c-cc0279aca896",
                "word": "grigou",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "922db633-5b7c-4c33-a885-915186f4c6e8",
                        "entry_id": "69ffb0c5-2989-3cc4-808c-cc0279aca896",
                        "tags": [
                            "plural"
                        ],
                        "form": "grigous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                        "entry_id": "69ffb0c5-2989-3cc4-808c-cc0279aca896",
                        "glosses": [
                            "Celui qui, ayant de quoi vivre, affecte la pauvreté pour servir de prétexte à une avarice sordide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2860fa-b0cb-4d4e-96f1-8af0bbcd4106",
                                "sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                                "text": "— Voyez-vous le vieux grigou, dit Mme Vauquer à Vautrin, comme ses yeux s’allument !"
                            },
                            {
                                "example_id": "65a70486-254b-4c76-b5b9-a8afde037266",
                                "sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                                "text": "Écoute, je vais te montrer que je ne suis pas un grigou. Achète mon étalon, je te donnerai les âmes par-dessus le marché."
                            },
                            {
                                "example_id": "d2d3fe0a-4ed2-4e75-9794-08fb828c9821",
                                "sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                                "text": "« On ne peut pas toujours suivre le conseil de ce vieux grigou de Benjamin Franklin.\n— Benjamin Franklin ? répéta son interlocuteur.\n— Mais oui, tourte : « Ça ne coûte rien ; c’est sans danger ; c’est agréable. »"
                            },
                            {
                                "example_id": "058706b7-04fc-4a06-9ecb-743698ff7c49",
                                "sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                                "text": "Le vieux grigou est également maître dans l’art de se rincer à l’œil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c06fa55-617a-44de-b526-90570e3a9453",
                        "source_entry_id": "69ffb0c5-2989-3cc4-808c-cc0279aca896",
                        "source_sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                        "target_lang_word": "Geizhals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geizhals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                        "entry_id": "f0115770-e4cc-38df-a492-9d420a10d5d7",
                                        "glosses": [
                                            "sehr geizige Person; jemand, der sehr wenig Neigung hat, anderen etwas zu geben oder überhaupt etwas auszugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c71237f-fb21-4ec1-abb2-66ad11217301",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "Dieser Geizhals hat uns in unserer Notlage nicht mal 50 Cent zum Telefonieren gegeben!"
                                            },
                                            {
                                                "example_id": "4b5e09e8-e354-4715-aa58-d97aad856730",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Beinahe wöchentlich stand der Gerichtsvollzieher vor der Tür, um etwas zu pfänden, immer wieder drohte der Rauswurf aus den Wohnungen – vielleicht mit ein Grund, warum mein Vater zeitlebens so erpicht darauf war, Reichtümer anzuhäufen und dennoch lebte wie ein Geizhals, der sich nur das Nötigste gönnte.“"
                                            },
                                            {
                                                "example_id": "4bd5820d-b94f-4edc-82e9-86637af32d68",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Alles ist hier schön an seinem Ort, Hoffmann führt Regie, und wir spüren, daß es ihm sehr viel leichter fällt, einen Maler einen alten Geizhals prellen zu lassen, als einer vornehmen französischen Dame eine Moralpredigt in den Mund zu legen.“"
                                            },
                                            {
                                                "example_id": "d6625696-6dbe-4bf1-8516-ad4165a1de90",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Der Sohn eines Geizhalses ist verschwenderisch, der Sohn eines Verschwenders ist geizig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e304d3-3b9b-43b2-b201-d90a8ac78575",
                        "source_entry_id": "69ffb0c5-2989-3cc4-808c-cc0279aca896",
                        "source_sense_id": "7c77acf1-abc4-37ec-b954-bd654f379582",
                        "target_lang_word": "scrooge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d159afbc-2f2e-3c41-af6a-701436de023f",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A miserly person; a person with an excessive dislike of spending money or other resources."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a197ea4-ba44-33ab-ade4-54ed3b3b1ec6",
