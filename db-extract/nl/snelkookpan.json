                        "entry_id": "39fc69a5-31f6-3afa-bdb4-f09272777ee0",
                        "glosses": [
                            "kookpan met een hermetisch sluitend deksel waarin spijzen bij hogere temperatuur dan 100 graden en onder druk snel gaar worden"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "7c40b7bb-4755-43f4-8997-0621682350dd",
                                "sense_id": "fa2b4f12-9be5-3a80-b100-63e2984cf763",
                                "text": "Een snelkookpan is een pan met een speciale deksel die de pan afsluit. De druk wordt hierdoor hoger in de pan waardoor het eten tijdens het koken sneller klaar en gaar is."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce48870-5104-3987-bdba-6c9fbac7a26c",
                        "entry_id": "39fc69a5-31f6-3afa-bdb4-f09272777ee0",
                        "glosses": [
                            "situatie die lastig is doordat er veel zaken tegelijkertijd bij elkaar komen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c64179e2-fea2-441c-a76e-db2cbbe6b0e7",
                                "sense_id": "0ce48870-5104-3987-bdba-6c9fbac7a26c",
                                "text": "Daarom ook was het zo'n meesterlijk idee om voor Hello Goodbye te filmen op Schiphol, snelkookpan van grote emoties als afscheid, verdriet, liefde en geluk."
                            }
                        ]
