            {
                "entry_id": "7f99c1ec-a8d9-3055-8b14-9219ac3a3e0a",
                "word": "JFK",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10ce30e0-14e6-43a6-8329-d6ef9e36eb68",
                        "entry_id": "7f99c1ec-a8d9-3055-8b14-9219ac3a3e0a",
                        "tags": [
                            "third-person",
