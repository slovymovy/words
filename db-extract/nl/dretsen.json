                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "3ae61852-ef1a-456c-b880-f6d0c7bbffa0",
                                "sense_id": "443a141a-b9a5-3f81-9520-9ba78725f5ed",
                                "text": "De beerbak viel om en de beer dretste op mijn kleeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "a06b7ea7-e197-374d-9426-aa14501dd292",
                        "entry_id": "337f6841-abde-3106-9e14-bcee3d02d900",
                        "glosses": [
                            "gedurig heen en weer lopen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "ee341d8d-7f50-4338-9d93-bbc4c1468372",
                                "sense_id": "a06b7ea7-e197-374d-9426-aa14501dd292",
                                "text": "Mie Gendarme, zoals men haar noemde... heeft de ganse dag al gelopen en gedretst, langs kronkelende en slingerende binnenbaantjes, die haar steeds dichter bij die verre rivier, de Leie, moeten brengen."
                            }
                        ]
                    }
