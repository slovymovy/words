                        ],
                        "form": "den Polemiker"
                    },
                    {
                        "form_id": "d6b5047b-7981-4e1f-b654-c13bb45333c4",
                        "entry_id": "8b116330-b9af-36d2-b4f7-bc08938494d1",
                        "tags": [
                            "accusative",
