{
    "word_family": [
        "horror",
        "horrify",
        "horribly",
        "horrid",
        "horrific"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "074d874c-6980-3a8c-879a-625af8282670",
                    "sense_definition": "Tremendously bad or unpleasant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quality_bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a <w>horrible</w> movie that was boring and poorly made.",
                            "target_lang_translations": {
                                "ru": "Мы посмотрели <w>ужасный</w> фильм, который был скучным и плохо сделанным.",
                                "zh": "我们看了一部<w>糟糕的</w>电影，既无聊又粗制滥造。",
                                "fr": "Nous avons regardé un film <w>horrible</w> qui était ennuyeux et mal réalisé."
                            }
                        },
                        {
                            "text": "The weather was <w>horrible</w> during our entire vacation.",
                            "target_lang_translations": {
                                "ru": "Погода была <w>ужасной</w> в течение всего нашего отпуска.",
                                "zh": "我们整个假期期间天气都非常<w>糟糕</w>。",
                                "fr": "Le temps a été <w>affreux</w> pendant toutes nos vacances."
                            }
                        }
                    ],
                    "synonyms": [
                        "bad",
                        "awful",
                        "terrible"
                    ],
                    "antonyms": [
                        "wonderful",
                        "great",
                        "excellent"
                    ],
                    "common_phrases": [
                        "horrible weather",
                        "horrible smell",
                        "horrible taste",
                        "feel horrible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой или неприятный.",
                        "zh": "极其糟糕或令人不快的。",
                        "fr": "Extrêmement mauvais ou désagréable."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "неприятный, мерзкий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕的",
                                "target_lang_sense_clarification": "形容情况或质量非常差"
                            },
                            {
                                "target_lang_word": "讨厌的",
                                "target_lang_sense_clarification": "形容令人不悦的"
                            },
                            {
                                "target_lang_word": "难受的",
                                "target_lang_sense_clarification": "形容感觉非常不舒服"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "horrible",
                                "target_lang_sense_clarification": "très mauvais, déplaisant"
                            },
                            {
                                "target_lang_word": "affreux",
                                "target_lang_sense_clarification": "très désagréable ou de mauvaise qualité"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c9d3ef0-d3ce-32f9-9a28-b4ec2a45feca",
                    "sense_definition": "Causing horror, shock, or intense fear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causing_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strangers were scared by the <w>horrible</w> mask he wore.",
                            "target_lang_translations": {
                                "ru": "Незнакомцев напугала <w>страшная</w> маска, которая была на нём.",
                                "zh": "陌生人被他戴的<w>可怕的</w>面具吓坏了。",
                                "fr": "Les inconnus ont été effrayés par le masque <w>horrible</w> qu'il portait."
                            }
                        },
                        {
                            "text": "It was a <w>horrible</w> accident that shocked the whole town.",
                            "target_lang_translations": {
                                "ru": "Это был <w>ужасный</w> несчастный случай, потрясший весь город.",
                                "zh": "那是一起震惊全城的<w>恐怖</w>事故。",
                                "fr": "C'était un accident <w>épouvantable</w> qui a choqué toute la ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening",
                        "awful",
                        "terrible"
                    ],
                    "antonyms": [
                        "pleasant",
                        "delightful"
                    ],
                    "common_phrases": [
                        "horrible accident",
                        "horrible crime",
                        "horrible nightmare",
                        "horrible sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий ужас, шок или сильный страх.",
                        "zh": "引起恐惧、震惊或极度害怕的。",
                        "fr": "Qui provoque l'horreur, le choc ou une peur intense."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "пугающий"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "трагический, шокирующий"
                            },
                            {
                                "target_lang_word": "чудовищный",
                                "target_lang_sense_clarification": "крайне жестокий или пугающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可怕的",
                                "target_lang_sense_clarification": "引起恐惧的"
                            },
                            {
                                "target_lang_word": "恐怖的",
                                "target_lang_sense_clarification": "令人感到惊悚的"
                            },
                            {
                                "target_lang_word": "骇人的",
                                "target_lang_sense_clarification": "程度极深的惊吓"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "horrible",
                                "target_lang_sense_clarification": "qui fait horreur"
                            },
                            {
                                "target_lang_word": "épouvantable",
                                "target_lang_sense_clarification": "qui cause de l'épouvante ou de la frayeur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69df9712-cb50-3928-bfe3-8cf04eb030f1",
                    "sense_definition": "A thing that causes horror; a terrifying thing or prospect.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer listed every possible <w>horrible</w> that could result from the new law.",
                            "target_lang_translations": {
                                "ru": "Юрист перечислил все возможные <w>ужасы</w>, которые могли возникнуть из-за нового закона.",
                                "zh": "律师列举了新法律可能导致的每一种<w>恐怖之事</w>。",
                                "fr": "L'avocat a énuméré toutes les <w>horreurs</w> possibles qui pourraient résulter de la nouvelle loi."
                            }
                        },
                        {
                            "text": "She tried to ignore the <w>horribles</w> of the war and focus on survival.",
                            "target_lang_translations": {
                                "ru": "Она пыталась не замечать <w>ужасов</w> войны и сосредоточиться на выживании.",
                                "zh": "她试图忽略战争带来的<w>惨状</w>，专注于生存。",
                                "fr": "Elle a essayé d'ignorer les <w>horreurs</w> de la guerre et de se concentrer sur sa survie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "parade of horribles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, вызывающее ужас; пугающая вещь или перспектива.",
                        "zh": "引起恐惧的事物；令人害怕的情况或前景。",
                        "fr": "Chose qui cause de l'horreur ; événement ou perspective terrifiante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "пугающее событие или явление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恐怖之事",
                                "target_lang_sense_clarification": "指代令人恐惧的事件"
                            },
                            {
                                "target_lang_word": "惨状",
                                "target_lang_sense_clarification": "指代令人不忍目睹的悲惨景象"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "horreur",
                                "target_lang_sense_clarification": "chose qui inspire de l'horreur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af69bc8e-8205-3eef-b47a-374c6369b3cb",
                    "sense_definition": "A person wearing a comic or grotesque costume in a parade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children dressed up as <w>horribles</w> for the annual town parade.",
                            "target_lang_translations": {
                                "ru": "Дети нарядились <w>ряжеными</w> для ежегодного городского парада.",
                                "zh": "孩子们为了年度城镇游行打扮成了<w>怪装者</w>。",
                                "fr": "Les enfants se sont déguisés en <w>personnages grotesques</w> pour le défilé annuel de la ville."
                            }
                        },
                        {
                            "text": "He laughed at the <w>horribles</w> marching down the street in their strange masks.",
                            "target_lang_translations": {
                                "ru": "Он смеялся над <w>ряжеными</w>, марширующими по улице в своих странных масках.",
                                "zh": "他嘲笑着那些戴着奇怪面具在街上游行的<w>扮装者</w>。",
                                "fr": "Il a ri des <w>mascarades</w> qui défilaient dans la rue avec leurs masques étranges."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек в комичном или гротескном костюме на параде.",
                        "zh": "在游行中穿着滑稽或怪诞服装的人。",
                        "fr": "Personne portant un costume comique ou grotesque lors d'un défilé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ряженый",
                                "target_lang_sense_clarification": "человек в маскарадном костюме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扮装者",
                                "target_lang_sense_clarification": "指代参加游行或表演的化装人员"
                            },
                            {
                                "target_lang_word": "怪装者",
                                "target_lang_sense_clarification": "指代穿着怪异服装的人"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "mascarade",
                                "target_lang_sense_clarification": "personne déguisée pour un défilé"
                            },
                            {
                                "target_lang_word": "costumé",
                                "target_lang_sense_clarification": "personne portant un costume de carnaval"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}