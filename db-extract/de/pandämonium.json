                    {
                        "sense_id": "784eeab9-f2bd-35b6-bb01-a867ad56b812",
                        "entry_id": "f64040af-af2b-3cdd-90c2-f74b254cbb46",
                        "glosses": [
                            "Aufenthaltsort der Dämonen, auch Abgrund"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2f061c15-468c-4c62-9ea5-dcaa4b5f48a9",
                                "sense_id": "784eeab9-f2bd-35b6-bb01-a867ad56b812",
                                "text": "„Da blitzen aus dem Pandämonium Charaktere auf, aus denen sich der Charakter der Stadt verdichtet.“"
                            },
                            {
                                "example_id": "7a9fb591-69af-4191-a8c1-a6a9ec2a74eb",
                                "sense_id": "784eeab9-f2bd-35b6-bb01-a867ad56b812",
                                "text": "„Dazu kam ein fraulicher Liebreiz, der sich mit einem Pandämonium an Temperament und Theaterblut verband.“"
                            }
                        ],
