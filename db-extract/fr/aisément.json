        "fr-extract.jsonl": [
            {
                "entry_id": "0d149bf6-3ac0-3b5b-b759-0a541602a438",
                "word": "aisément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                        "entry_id": "0d149bf6-3ac0-3b5b-b759-0a541602a438",
                        "glosses": [
                            "D’une manière aisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab244db-6d8f-4071-8089-0b955ed9cd2b",
                                "sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                                "text": "Ce caractère soudain, intuitif, de la «découverte» gœthéenne, peut évidemment être aisément reproché au poète."
                            },
                            {
                                "example_id": "ae082995-5664-4000-89cc-dcd12f74eb5b",
                                "sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                                "text": "Le délégué à ce morceau d’Éden en godet est aisément identifiable à son gilet en mailles polaires vert de gris pissouille et à sa gueule de six pieds de long."
                            },
                            {
                                "example_id": "57b63dfb-e76a-4ae1-a187-93de585f11bc",
                                "sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                                "text": "J’en viendrai aisément à bout. — Je veux des chaussures que je puisse mettre aisément."
                            },
                            {
                                "example_id": "3636df57-41cd-4b81-a2b7-427611c59d72",
                                "sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                                "text": "Travailler aisément. — Faire aisément des vers."
                            },
                            {
                                "example_id": "ecf94932-2182-4463-87ff-ee679b4839b7",
                                "sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                                "text": "Il change aisément d’avis. — Vivre aisément. — Ce cheval va aisément."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea9a0023-afff-4fb1-bfa4-bd8a2a0e183b",
                        "source_entry_id": "0d149bf6-3ac0-3b5b-b759-0a541602a438",
                        "source_sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                        "target_lang_word": "easily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "easily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "Comfortably, without discomfort or anxiety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef2a41d-c145-4478-969b-08be97e52d1f",
                                                "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                                                "text": "Eftsoones she causd him vp to be conuayd, / And of his armes despoyled easily […]"
                                            },
                                            {
                                                "example_id": "e5697fbd-63a0-4e85-9de0-20171846afe1",
                                                "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                                                "text": "Why this already very fast train should be speeded up still further, when none of the other more easily timed S.R. West of England trains has a single minute pared from its schedule, is unexplained - unless this is a playful dig at the Western Region, most of whose expresses, by reason of additional stops, will be decelerated from the same date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "Without difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec2c8d4-67a1-4ebc-8d41-2b229f1edffc",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "Individuals without a family network are easily controlled."
                                            },
                                            {
                                                "example_id": "440a8791-4a61-4fbf-8ffa-38b5c81cd629",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations. It is easily earned repetition to state that Josephine St. Auban's was a presence not to be concealed."
                                            },
                                            {
                                                "example_id": "d640ae62-ba5d-4b09-ab46-a5bed5e1fda5",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis[…]interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "a2948249-cde3-43b6-a33e-21a2b3256298",
                                                "sense_id": "4ddacfbc-bf5a-3a7b-a21d-fba3769a7c19",
                                                "text": "For instance, if the girl character is getting rescued by a boy, we can tell our girls the story could easily have been changed so the girl is doing the rescuing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40c6e3f8-c748-3fd9-aee9-7cd81d972a0b",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "Absolutely, without question."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ee722e-81e5-487a-9f6a-e04950359ac3",
                                                "sense_id": "40c6e3f8-c748-3fd9-aee9-7cd81d972a0b",
                                                "text": "This is easily the best meal I have eaten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                                        "entry_id": "bf6260e9-3b3e-33bb-9d14-62d75892a580",
                                        "glosses": [
                                            "More quickly or likely than is usual or expected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96572097-814b-40c4-904a-b04bc5c9937b",
                                                "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                                                "text": "not easily offended"
                                            },
                                            {
                                                "example_id": "461767dd-94d7-47fb-aa1f-d73228851226",
                                                "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                                                "text": "I get distracted very easily."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2deea5d6-12be-400d-85be-53eac9c3349c",
                        "source_entry_id": "0d149bf6-3ac0-3b5b-b759-0a541602a438",
                        "source_sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                        "target_lang_word": "effortlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effortlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0735d9c6-6c77-3e1e-824f-f1f5d2544f33",
                                        "entry_id": "8121426a-9f62-3bf8-90df-8313d7ca1e97",
                                        "glosses": [
                                            "Without effort; without difficulty or struggle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81efc2a9-2389-4034-a83c-8a5ec2ad4fc5",
                                                "sense_id": "0735d9c6-6c77-3e1e-824f-f1f5d2544f33",
                                                "text": "She hoisted the child effortlessly and plopped him in bed."
                                            },
                                            {
                                                "example_id": "13dc750d-efb9-4cf9-b4c7-26353f1f3c23",
                                                "sense_id": "0735d9c6-6c77-3e1e-824f-f1f5d2544f33",
                                                "text": "Pass the chalk. Dr. Levine was there with a friend and fellow psychiatrist (detect a pattern?), Alexa Albert, Coco’s mother, who squinted up into the sun as her daughter effortlessly sailed skyward. Dr. Albert is an acrophobe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85a82747-9e15-4802-8aff-e8fcee16ffdc",
                        "source_entry_id": "0d149bf6-3ac0-3b5b-b759-0a541602a438",
                        "source_sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                        "target_lang_word": "gemakkelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemakkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36622b67-e39d-38dc-8372-731dc482546c",
                                        "entry_id": "d612b541-254c-3213-b9a8-2c63f674fb24",
                                        "glosses": [
                                            "geen moeite of inspanning vereisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e38e5d7d-ea7b-49fa-8498-cc5831bbb874",
                                                "sense_id": "36622b67-e39d-38dc-8372-731dc482546c",
                                                "text": "Alle leerlingen vonden dat een gemakkelijke proefwerkopgave."
                                            },
                                            {
                                                "example_id": "acbdbf3c-f429-4b0e-8096-a6360f38a27e",
                                                "sense_id": "36622b67-e39d-38dc-8372-731dc482546c",
                                                "text": "Het was gemakkelijk om de Engelsen te haten, ten slotte zo gemakkelijk dat het een plezier was ze te doden."
                                            },
                                            {
                                                "example_id": "fa056b6a-7fa5-4854-a2ea-e60ec76966dc",
                                                "sense_id": "36622b67-e39d-38dc-8372-731dc482546c",
                                                "text": "Zo iemand moest je wel mogen. Bewonderen zelfs, omdat ze het niet altijd even gemakkelijk kon hebben gehad in haar leven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a5549e-2fe8-3151-8e91-7ccb851d704e",
                                        "entry_id": "d612b541-254c-3213-b9a8-2c63f674fb24",
                                        "glosses": [
                                            "comfortabel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2c7100-6d3a-4523-bbe9-3c89993e0592",
                                                "sense_id": "b6a5549e-2fe8-3151-8e91-7ccb851d704e",
                                                "text": "Hij installeerde zich in die gemakkelijke stoel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e7668ba-32ec-30d0-8444-b2dd1edd58f9",
                                        "entry_id": "d612b541-254c-3213-b9a8-2c63f674fb24",
                                        "glosses": [
                                            "bereidwillig om zich aan te passen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7108b681-1e7f-4c19-86dc-a8a95613f589",
                                                "sense_id": "7e7668ba-32ec-30d0-8444-b2dd1edd58f9",
                                                "text": "Wij vonden haar erg gemakkelijk in de omgang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97c6c345-3fc5-445d-a0df-dd8186c2a77b",
                        "source_entry_id": "0d149bf6-3ac0-3b5b-b759-0a541602a438",
                        "source_sense_id": "bdbacb6f-7c7d-3c5e-bd5f-d13e7a916c69",
                        "target_lang_word": "moeiteloos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moeiteloos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8ebda09-a26f-306d-9e02-07366e409e51",
                                        "entry_id": "b0387d52-b5d5-356d-b453-4821e141e305",
                                        "glosses": [
                                            "geen moeite kostend; zonder inspaning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f498deb-bb0b-47d4-a041-b9f7d4781288",
                                                "sense_id": "d8ebda09-a26f-306d-9e02-07366e409e51",
                                                "text": "Het was bepaald geen moeiteloze bevalling."
                                            },
                                            {
                                                "example_id": "97dfcc7b-b960-4b4a-bae9-75fae09026c3",
                                                "sense_id": "d8ebda09-a26f-306d-9e02-07366e409e51",
                                                "text": "Terwijl ik liep voelde het alsof ik zweefde en neerkeek op mijn lichaam dat zich moeiteloos voortbewoog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
