                        "glosses": [
                            "etwas, das live übertragen wird, meistens per Fernsehen, Internet oder Radio"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ffbdee1-6f54-4de8-88a4-68ae73c5aef1",
                                "sense_id": "9cb49f7d-e44f-3570-a8c3-db25e18a1987",
                                "text": "„Die Stahlbrücke war für die Direktübertragung des rbb aufgestellt worden.“"
                            },
                            {
                                "example_id": "2277f461-0eb1-4d59-a1ad-e88899ca73ab",
                                "sense_id": "9cb49f7d-e44f-3570-a8c3-db25e18a1987",
                                "text": "„Der Ständerat hat am Mittwoch mit 34 zu 6 Stimmen eine Motion von Martin Schmid (Graubünden, fdp.) gutgeheissen, welche die Direktübertragung im Internet von öffentlichen Urteilsberatungen des Bundesgerichts verlangt.“"
                            }
                        ],
