                        "glosses": [
                            "een tol die men heel snel kan laten ronddraaien met behulp van een zweepje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335f771a-dfb1-4759-8a8c-8eae3a5a9daa",
                                "sense_id": "72777b47-1b27-36e4-943e-b505916d4ad9",
                                "text": "Maar opeens zegt dat Antilliaanse meisje: 'Pa Sem, Reinaldo is nog binnen!' Ik draaide om m'n as als een drijftol: wat moet ik doen? Terug! Een paar Afrikanen probeerden me tegen te houden: Papa don't go back, you'll get burned. Door de vlammen ben ik naar achteren gelopen. Ademen kon je er niet meer. Ik hoorde de jongen schreeuwen. Ik heb hem kunnen vinden: Loop voor mij! Nog een metertje!"
                            }
                        ]
                    }
