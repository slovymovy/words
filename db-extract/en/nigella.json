                                        "glosses": [
                                            "Echter Schwarzkümmel, eine Art von [1] und speziell dessen Samen, der als Gewürz und Heilmittel verwendet wird"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cade7b8-cc3e-4f37-a2c5-ebdc05b6c01e",
                                                "sense_id": "f9b648a0-cbb9-3f1a-aaea-8a1a5a3ca89f",
                                                "text": "Schau an, hier wächst Schwarzkümmel."
                                            },
                                            {
                                                "example_id": "a768af9e-ebc9-4f80-8573-484cf6d26c1a",
                                                "sense_id": "f9b648a0-cbb9-3f1a-aaea-8a1a5a3ca89f",
                                                "text": "Oder \"Glückskörnchen\", Schwarzkümmel, der in der arabischen Welt auf Tomaten oder Halloumi-Käse ebenso gestreut wird wie auf süßes Hefegebackenes."
                                            },
                                            {
                                                "example_id": "18f30c8d-7e1d-4368-b660-bcf6e085983b",
                                                "sense_id": "f9b648a0-cbb9-3f1a-aaea-8a1a5a3ca89f",
                                                "text": "Dieser hatte vor eineinhalb Jahrtausenden in seiner Schrift \"Hadith\" bereits verkündet: \"Schwarzkümmel heilt jede Krankheit, außer den Tod.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
