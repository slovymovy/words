                ],
                "senses": [
                    {
                        "sense_id": "39211a0d-7c96-3a01-9ca9-7566a66b2485",
                        "entry_id": "00b4db0e-4a56-3dc2-8227-4fc52159cb74",
                        "glosses": [
                            "ruimte of vertrek voor wachtenden, bijvoorbeeld bij een arts of op een station"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16949733-36a7-4531-a80b-67c8af053ca3",
                                "sense_id": "39211a0d-7c96-3a01-9ca9-7566a66b2485",
                                "text": "De wachtkamer was propvol."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c8f1e9e-0239-3f5d-a2a6-59d0f421be3b",
                        "entry_id": "00b4db0e-4a56-3dc2-8227-4fc52159cb74",
                        "glosses": [
                            "hoeveelheid personen die zich in een wachtkamer bevinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f5b26c-5745-4f5b-9b30-dc21ab0f6e6b",
                                "sense_id": "9c8f1e9e-0239-3f5d-a2a6-59d0f421be3b",
                                "text": "Vertel verder over wat je familierecht noemt. Wordt er van mij ook verwacht dat ik me daarmee bezighoud?\n„Ja, absoluut, op maandag, neem ik aan. Je krijgt de helft van degenen die ik anders zou hebben gehad, allebei een halve wachtkamer.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ccb5696-d9dc-42c9-b289-4aa8cdca17fc",
                        "source_entry_id": "00b4db0e-4a56-3dc2-8227-4fc52159cb74",
                        "source_sense_id": "39211a0d-7c96-3a01-9ca9-7566a66b2485",
                        "source_sense_description": "ruimte of vertrek voor wachtenden, bijvoorbeeld bij een arts of op een station",
                        "target_lang_word": "Wartezimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wartezimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                        "entry_id": "6b67a1ac-71ef-37e0-a101-5f2d7f863caa",
                                        "glosses": [
                                            "Raum, in dem man sich während einer Wartezeit aufhalten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11faff94-ae1b-4088-8bdb-085ec03fa4f8",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "Im Winter sind die Wartezimmer in den Arztpraxen noch voller als sonst."
                                            },
                                            {
                                                "example_id": "f19aa3b9-ab9b-4d87-b8f2-bfcc15739dd8",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "Ich habe gestern fast zwei Stunden im Wartezimmer verbracht."
                                            },
                                            {
                                                "example_id": "8f69be7d-acf4-4f0c-8b2a-f7eb3cdd72d1",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„Man saß wie im Wartezimmer des Zahnarztes, solidarisch in der Erwartung einer unangenehmen Erfahrung, die allen bevorstand.“"
                                            },
                                            {
                                                "example_id": "842d6080-3e90-459f-a139-b18be112582c",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„Beim ersten Arzt sitzt das ganze Wartezimmer voll.“"
                                            },
                                            {
                                                "example_id": "93633ee0-36a7-4150-acdf-397994eb7684",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„So was geht einem durch den Kopf, wenn man selbst in einem Berliner Wartezimmer sitzt und seiner Vorsorgeuntersuchung entgegensieht.“"
                                            },
                                            {
                                                "example_id": "76243b6f-c920-4e43-91a0-e02af6959e9f",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„Dann sitze ich im Wartezimmer und habe Angst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b390aa1-a7e3-45ae-81e9-5daff1beb41e",
                        "source_entry_id": "00b4db0e-4a56-3dc2-8227-4fc52159cb74",
                        "source_sense_id": "39211a0d-7c96-3a01-9ca9-7566a66b2485",
                        "source_sense_description": "ruimte of vertrek voor wachtenden, bijvoorbeeld bij een arts of op een station",
                        "target_lang_word": "Warteraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warteraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72206966-c922-3234-b426-869b38e89dd1",
                                        "entry_id": "930ce995-c156-33fc-8077-bc5ac438b20d",
                                        "glosses": [
                                            "Raum, in dem man sich während einer Wartezeit aufhalten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918f23cb-0d83-45d8-97ea-2e70719e3aea",
                                                "sense_id": "72206966-c922-3234-b426-869b38e89dd1",
                                                "text": "„Im nächsten Warteraum saßen ein hagerer Tuareg mit indigoblauem Tagelmoust, ein Schwarzer, der sich ständig über die rechte Fußsohle strich, und ein libanesischer Junge mit unruhigem Blick.“"
                                            },
                                            {
                                                "example_id": "1391cce9-fb85-45dd-9204-758314d4e530",
                                                "sense_id": "72206966-c922-3234-b426-869b38e89dd1",
                                                "text": "„Die Pförtnerin winkt mich in einen kleinen Warteraum.“"
                                            },
                                            {
                                                "example_id": "8e1135d6-e5e9-431b-a2d5-dc84033919ee",
                                                "sense_id": "72206966-c922-3234-b426-869b38e89dd1",
                                                "text": "„Sie blieben zunächst im Warteraume, bis das östliche Prachttor geöffnet wurde.“"
                                            },
                                            {
                                                "example_id": "b012e9b1-589d-4b8d-8945-d6a29954d427",
                                                "sense_id": "72206966-c922-3234-b426-869b38e89dd1",
                                                "text": "„Im Warteraum erster und zweiter Klasse sah er zwei Männer sitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28bc74bc-bea7-4a15-bf96-e98bd97775e4",
                        "source_entry_id": "00b4db0e-4a56-3dc2-8227-4fc52159cb74",
                        "source_sense_id": "39211a0d-7c96-3a01-9ca9-7566a66b2485",
                        "source_sense_description": "ruimte of vertrek voor wachtenden, bijvoorbeeld bij een arts of op een station",
                        "target_lang_word": "waiting room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waiting room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                        "entry_id": "53220167-0377-3de3-97a2-324d5a3860af",
                                        "glosses": [
                                            "A room in a public place for people to wait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47267aba-5967-4a83-bbb4-efe4142ff607",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "In the third place, by its situation it serves only for a waiting-room, and a passage to the principal apartments, instead of being reserved, as it ought to be, for entertaining company […]"
                                            },
                                            {
                                                "example_id": "5e25ec93-d852-4299-b76f-2f396a16e924",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "A blind bearing the monogram G.V.T. is pulled down over the waiting room window as if still in mourning for the passing of the railway."
                                            },
                                            {
                                                "example_id": "6347a7e7-e6c5-4c2d-800b-d59a63dd8252",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "To lovers of Victoriana it will not be necessary to enlarge on the original beauty of many [old stations], but to the modern traveller romantic nostalgia will not compensate for bleak, draughty waiting rooms, ancient sanitation, uncomfortable grimy seats and gas lighting; he is likely to prefer the comforts of a modern car on a winter's morning."
                                            },
                                            {
                                                "example_id": "feabf2a8-dba2-4582-b8cf-2606fdfdd818",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "At Hanwell, two lifts have been installed along with a refurbished ticket office with accessible window. A new waiting room is being installed on Platform 2, while the one on Platform 3 is being refurbished."
                                            },
                                            {
                                                "example_id": "e12b718b-5ac8-4214-a198-7578e70e0ce5",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "\"This is a particularly good example of a timber railway station, with its Royal connection giving rise to some outstanding internal and external detailing. The swan-necked iron lamps, the porte-cochère and outstanding decoration in the Royal waiting room set the station apart.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1a9939d-ce41-4e56-bdfa-eb3b6e1c5619",
                        "source_entry_id": "00b4db0e-4a56-3dc2-8227-4fc52159cb74",
