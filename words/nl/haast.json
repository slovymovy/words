                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>haast</w> me naar de winkel voordat deze gaat sluiten.",
                            "target_lang_translations": {
