                                "target_senses": [
                                    {
                                        "sense_id": "e1019e87-f04e-38cf-861f-4ab7c31f882e",
                                        "entry_id": "b4ce5c06-3647-3eae-ac84-a38afe2227a2",
                                        "glosses": [
                                            "Nom de famille, surtout connu via Karl Marx."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b483b2cc-b17c-4291-aaa0-23584ef17ba6",
                                                "sense_id": "e1019e87-f04e-38cf-861f-4ab7c31f882e",
                                                "text": "Les fruits de mer sont donc des aliments de choix pour les seniors. Ils font partie, avec les poissons, du régime « pescétarien », « régime varié et facile à adopter pour toute la famille », notent le Dʳ Alexandra Dalu, spécialiste en nutrition, et Thierry Marx, chef cuisinier, dans leur livre L’assiette santé."
                                            },
                                            {
                                                "example_id": "71fbc1b8-fbfa-41fe-a325-77ac40f7ad1b",
                                                "sense_id": "e1019e87-f04e-38cf-861f-4ab7c31f882e",
                                                "text": "Les Springboks ajoutaient alors trois nouveaux essais par Malcolm Marx (42e), Bongi Mbonambi (59e) et Kwagga Smith (67e)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1e59ca-cf5d-3e19-8787-94cda2e34866",
                                        "entry_id": "b4ce5c06-3647-3eae-ac84-a38afe2227a2",
                                        "glosses": [
                                            "Karl Marx, philosophe, économiste, historien, sociologue, journaliste et communiste prussien."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e53eac0-9bdb-40fc-b229-db4ae5b88cd9",
                                                "sense_id": "5c1e59ca-cf5d-3e19-8787-94cda2e34866",
                                                "text": "Marx, Nietzsche et Freud finiront de défondamentaliser la conscience cartésienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e7ab58b-b78b-42dc-9197-cd3c9cca9b2b",
                        "source_entry_id": "78aa5588-b741-3dbd-a061-97d9eed69543",
                        "source_sense_description": "surname",
                        "target_lang_word": "Marx",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marx",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                        "entry_id": "44a04e9f-7fb8-3178-8132-8f9e80af817c",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b62ebe-cb56-4204-a9fd-5aca87242e1f",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Frau Marx ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e36e945f-af47-44ed-b5b4-30c861eb1f11",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Herr Marx wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f793366b-aeea-4412-977d-3d2f908dc2f1",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Die Marx fliegen heute nach Paris."
                                            },
                                            {
                                                "example_id": "990bc26d-8613-4e89-99ef-dd21dc2e4d43",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Der Marx trägt nie die Pullover, die die Marx ihm strickt."
                                            },
                                            {
                                                "example_id": "d81155e3-2e86-44da-ac66-1890bb48b202",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Marx kommt, geht der Herr Marx.“"
                                            },
                                            {
                                                "example_id": "f84e221f-cc27-45a3-9309-b606dcca13c3",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Marx kommt und geht."
                                            },
                                            {
                                                "example_id": "47aff586-9565-4a75-a4d9-695b361ef04b",
                                                "sense_id": "e5a01908-aee5-30ed-9748-1f107eab9666",
                                                "text": "Marxens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
