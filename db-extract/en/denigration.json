                        "entry_id": "13c36fee-6a78-3f7f-9029-73f928018e60",
                        "glosses": [
                            "The act of making black; a blackening or defamation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ceff8850-7c58-39f6-8993-1b96ca4db2aa",
                        "entry_id": "13c36fee-6a78-3f7f-9029-73f928018e60",
                        "glosses": [
                            "An unfair criticism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f137be31-6180-4d6b-9c20-b40a322c06a5",
                                "sense_id": "ceff8850-7c58-39f6-8993-1b96ca4db2aa",
                                "text": "To nostalgic eyes they became absolutely and almost mercifully unrecognisable. Nor did they escape a full measure of denigration."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67259f18-3002-4db5-b507-dca07c37cbe8",
                        "source_entry_id": "13c36fee-6a78-3f7f-9029-73f928018e60",
                        "source_sense_description": "blackening or defamation",
                        "target_lang_word": "Verunglimpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verunglimpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                        "entry_id": "143c7379-3e0a-3471-90a8-cdd90e765236",
                                        "glosses": [
                                            "Herabsetzung, Verächtlichmachung von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63292ca3-ac82-4862-9a6d-3079ef3e7601",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Seit Mitte des 19. Jahrhunderts wurde es zur Verunglimpfung von Personen verwendet.“"
                                            },
                                            {
                                                "example_id": "78c92635-1df6-43ea-a677-5639c4d26389",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Der sogenannte Blasphemieartikel 295 a-c des pakistanischen Strafgesetzbuchs stellt die Schändung religiöser Texte jeder Religionsgruppe unter Strafe. Auf die Verunglimpfung des Korans steht lebenslange Haft, auf die des Propheten die Todesstrafe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
