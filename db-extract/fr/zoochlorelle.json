                        "glosses": [
                            "Algue verte, genre Zoochlorella (K. Brandt, 1881), symbiote de nombreux animaux comme par exemple l’hydre d’eau douce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147f6cfb-7219-4047-a0ce-9acfa26f0842",
                                "sense_id": "b1c5974e-043f-33e3-9561-39cdcd135095",
                                "text": "M. Famintzine [Andrei Sergeevich Famintzin] a isolé les zoochlorelles en écrasant un Stentor ou une Paramécie verte sous une lamelle de verre : sous l’influence de la pression l’animal est brisé en plusieurs fragments et quelques zoochlorelles sont entièrement isolées."
                            }
                        ]
                    }
