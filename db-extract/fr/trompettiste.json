        "fr-extract.jsonl": [
            {
                "entry_id": "2ee87410-4c8c-3b20-9d76-9af6657bf979",
                "word": "trompettiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0a85fe94-1109-4a4e-b78f-d59fb14b6de3",
                        "entry_id": "2ee87410-4c8c-3b20-9d76-9af6657bf979",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "trompettistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a187f08-c9f0-34d8-bff3-c7755c5f84b3",
                        "entry_id": "2ee87410-4c8c-3b20-9d76-9af6657bf979",
                        "glosses": [
                            "Musicien ou musicienne qui joue de la trompette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22dcddc3-8827-4b79-b26e-c8b54828c90e",
                                "sense_id": "9a187f08-c9f0-34d8-bff3-c7755c5f84b3",
                                "text": "Il est quasiment impossible pour un trompettiste de tenir seul la vedette pendant trois ou quatre sets d’une heure sans s’abîmer les lèvres. Encore aujourd’hui, rares sont ceux que l’on voit se produire en quartet, sans le soutien indispensable du saxophone qui leur permettra de se reposer un peu."
                            },
                            {
                                "example_id": "df0c4c0e-5553-428b-8283-cafdef396bc7",
                                "sense_id": "9a187f08-c9f0-34d8-bff3-c7755c5f84b3",
                                "text": "Trompettiste' de génie, Ibrahim Maalouf va ambiancer le stade Léo-Lagrange de Bondy (Seine-Saint-Denis) ce week-end'."
                            },
                            {
                                "example_id": "04812716-e348-466e-9d01-4c1325e3fc91",
                                "sense_id": "9a187f08-c9f0-34d8-bff3-c7755c5f84b3",
                                "text": "Le concert sur la plage des Nonnes samedi 2 septembre de la trompettiste Lucienne Renaudin Vary et de l’accordéoniste Félicien Brut, devrait prolonger en douceur l’été michelais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75b75dc0-5f9d-4b36-aeaf-fbba15d5f918",
                        "source_entry_id": "2ee87410-4c8c-3b20-9d76-9af6657bf979",
                        "source_sense_id": "9a187f08-c9f0-34d8-bff3-c7755c5f84b3",
                        "target_lang_word": "Trompeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trompeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                        "entry_id": "f96f4396-6b56-30cb-8d59-5073bb6bc90a",
                                        "glosses": [
                                            "jemand, der Trompete spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656a5ead-23f9-41f8-b829-5b0439e664b9",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "Der Trompeter übte an jedem Tag mindestens fünf Stunden das Spielen seines Instrumentes."
                                            },
                                            {
                                                "example_id": "53f8b325-ad1b-4a6c-8e36-55a204ca9074",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "„Das Jazz at the Lincoln Center Orchestra ehrte Legenden von Benny Goodman bis Dizzy Gillespie. Besonders berührend: ein Duett von Wynton Marsalis mit dem hiesigen Trompeter Thomas Gansch.“"
                                            },
                                            {
                                                "example_id": "2fffef31-097d-4ecc-b38e-4209c1128c2d",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "„Sie stand am Tresen und schäkerte mit einem Blondschopf, dem Trompeter von Bernhard Ettés Orchester.“"
                                            },
                                            {
                                                "example_id": "6222d15a-b014-4fe3-80f0-e53e833c297c",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "„Ein Trompeter blies die Sonne in ihr Nachtlager, die Soldaten sangen Lieder und schwärmten von Fischen und gebratenem Ochsenfleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81037ed8-de1b-31cf-add7-10d0ee0a2f95",
                                        "entry_id": "f96f4396-6b56-30cb-8d59-5073bb6bc90a",
                                        "glosses": [
                                            "Dienstgrad im Deutschen Reich für einen Soldaten des Trompeterkorps"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fd743bc-13fe-485e-8a51-ba95d94d52f3",
                                                "sense_id": "81037ed8-de1b-31cf-add7-10d0ee0a2f95",
                                                "text": "„Sergeant Henry Serpollet tot, Trompeter Wenzel Zavadil 41,2 Grad Fieber.“"
                                            },
                                            {
                                                "example_id": "fb0e6c46-a5f1-4413-b486-6a0bc2bda60e",
                                                "sense_id": "81037ed8-de1b-31cf-add7-10d0ee0a2f95",
                                                "text": "„Auf jedem Gesicht von Denissow bis zum Trompeter zeigte sich ein bei allen gleicher Ausdruck von Kampflust, Spannung und Aufregung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a459934-6817-4d45-baca-b8116d47e2e9",
                        "source_entry_id": "2ee87410-4c8c-3b20-9d76-9af6657bf979",
                        "source_sense_id": "9a187f08-c9f0-34d8-bff3-c7755c5f84b3",
