{
    "word_family": [
        "omtrekken",
        "trek",
        "trekken",
        "uittrek",
        "uittrekken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88318a67-05b3-3c9e-8b10-2ba54629d553",
                    "sense_definition": "de totale lengte van de buitenrand van een gesloten figuur of vorm",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wiskundeleraar legde uit hoe je de <w>omtrek</w> van een cirkel berekent.",
                            "target_lang_translations": {
                                "en": "The math teacher explained how to calculate the <w>circumference</w> of a circle."
                            }
                        },
                        {
                            "text": "De <w>omtrek</w> van het voetbalveld is ongeveer driehonderd meter.",
                            "target_lang_translations": {
                                "en": "The <w>perimeter</w> of the football field is approximately three hundred meters."
                            }
                        }
                    ],
                    "synonyms": [
                        "perimeter",
                        "omvang"
                    ],
                    "common_phrases": [
                        "omtrek berekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "The total length of the outer boundary of a closed figure or shape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "perimeter",
                                "target_lang_sense_clarification": "the distance around a shape"
                            },
                            {
                                "target_lang_word": "circumference",
                                "target_lang_sense_clarification": "specifically for circles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29b2dbaf-d6a6-336f-918d-5906c059d49e",
                    "sense_definition": "de omgeving of het gebied rondom een specifieke plek",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omgeving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is in de wijde <w>omtrek</w> geen supermarkt te bekennen.",
                            "target_lang_translations": {
                                "en": "There is no supermarket to be found in the wide <w>vicinity</w>."
                            }
                        },
                        {
                            "text": "De politie zocht in de wijde <w>omtrek</w> naar de vermiste jongen.",
                            "target_lang_translations": {
                                "en": "The police searched the wide <w>surrounding area</w> for the missing boy."
                            }
                        }
                    ],
                    "synonyms": [
                        "omgeving",
                        "nabijheid",
                        "omtrekking"
                    ],
                    "common_phrases": [
                        "wijde omtrek"
                    ],
                    "target_lang_definitions": {
                        "en": "The surrounding area or the region around a specific place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vicinity",
                                "target_lang_sense_clarification": "the area near or surrounding a place"
                            },
                            {
                                "target_lang_word": "surroundings",
                                "target_lang_sense_clarification": "the area around someone or something"
                            },
                            {
                                "target_lang_word": "area",
                                "target_lang_sense_clarification": "a region or part of a town"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f750b6fc-e226-3cb6-a3bf-89c52f0be32c",
                    "sense_definition": "de zichtbare lijn die de buitenkant van een object vormt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de mist zag ik alleen de vage <w>omtrek</w> van een groot gebouw.",
                            "target_lang_translations": {
                                "en": "In the mist, I only saw the faint <w>outline</w> of a large building."
                            }
                        },
                        {
                            "text": "De kunstenaar tekende eerst de <w>omtrek</w> van het gezicht op het doek.",
                            "target_lang_translations": {
                                "en": "The artist first drew the <w>contour</w> of the face on the canvas."
                            }
                        }
                    ],
                    "synonyms": [
                        "contour",
                        "silhouette",
                        "grenslijn"
                    ],
                    "common_phrases": [
                        "vage omtrek"
                    ],
                    "target_lang_definitions": {
                        "en": "The visible line that forms the outside of an object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outline",
                                "target_lang_sense_clarification": "a line or set of lines enclosing or indicating the shape of an object"
                            },
                            {
                                "target_lang_word": "contour",
                                "target_lang_sense_clarification": "an outline representing or bounding the shape or form of something"
                            },
                            {
                                "target_lang_word": "silhouette",
                                "target_lang_sense_clarification": "the dark shape and outline of someone or something visible against a lighter background"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "764ca2cb-f0fc-3545-9d55-38fa2ed01afd",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>omtrekken</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>omtrek</w> de figuur met een zwarte stift voor meer duidelijkheid.",
                            "target_lang_translations": {
                                "en": "I <w>trace</w> the figure with a black marker for more clarity."
                            }
                        },
                        {
                            "text": "Wanneer ik de kaart teken, <w>omtrek</w> ik de grenzen heel voorzichtig.",
                            "target_lang_translations": {
                                "en": "When I draw the map, I <w>outline</w> the borders very carefully."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'omtrekken' (to trace or outline)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trace",
                                "target_lang_sense_clarification": "to draw around the edge of something"
                            },
                            {
                                "target_lang_word": "outline",
                                "target_lang_sense_clarification": "to draw the outer edge of a shape"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}