                "senses": [
                    {
                        "sense_id": "f7b7505f-ed9e-3509-a055-aac3a1798156",
                        "entry_id": "369c37a5-4166-31bc-a388-2605b029f958",
                        "glosses": [
                            "диал. землекоп"
