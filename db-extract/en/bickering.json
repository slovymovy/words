                ],
                "senses": [
                    {
                        "sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                        "entry_id": "4a4a0463-e6a3-33f1-811b-5e0b753b311b",
                        "glosses": [
                            "Petty quarreling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82bd802a-b1fb-4640-949e-ead71cbaac44",
                                "sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                                "text": "1820, in Memoirs of John Duke of Marlborough, By William Coxe, Ch.40 heading.\nMeeting of Parliament. — Choice of a whig Speaker. — Speech from the throne. — Parliamentary proceedings, and party bickerings."
                            },
                            {
                                "example_id": "efc2ffda-3977-4d8f-856b-9d6b98ca7e57",
                                "sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                                "text": "By this time the two companies were beginning to realise that the continual bickering was not doing either of them much good, and the L.Y.R. (like many others) was becoming tired of the dominance of Euston."
                            },
                            {
                                "example_id": "587d3928-30c0-4876-b589-34142b4dfa15",
                                "sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                                "text": "After Evra was also shown a yellow card following a prolonged bout of bickering which also involved Suarez, Ferguson decided on a double change by replacing Park Ji-sung and Ashley Young with Nani and Rooney."
                            },
                            {
                                "example_id": "e42dd17f-38f6-4506-8111-416dbfa86db4",
                                "sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                                "text": "Ukrainian intelligence said on Friday that Prigozhin’s public bickering with the army leadership confirmed “their fear of responsibility for the inevitable geopolitical defeat of Moscow”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08276d86-9527-465f-a3f8-c3405527a763",
                        "source_entry_id": "4a4a0463-e6a3-33f1-811b-5e0b753b311b",
                        "source_sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                        "source_sense_description": "petty quarreling",
                        "target_lang_word": "chamaillerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chamaillerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                        "entry_id": "6104feab-8858-39e8-a645-d54acff3043d",
                                        "glosses": [
                                            "Action de se chamailler, querelle peu importante souvent accompagnée de cris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c939fe44-7c8e-4cc1-a1cb-18ba4f7e94dd",
                                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                                "text": "Les enfants, cessez vos chamailleries !"
                                            },
                                            {
                                                "example_id": "34527af1-8a4d-49e1-8551-c2260fde073b",
                                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                                "text": "Ce n’était qu’une chamaillerie, ils se sont vite réconciliés."
                                            },
                                            {
                                                "example_id": "6ac414a5-1c09-46fb-aa70-b8ea5cb6a8e8",
                                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                                "text": "Vous êtes moins bouillant, et je suis sûr que maintenant il nous serait beaucoup plus facile de vivre ensemble en bonne intelligence et sans chamaillerie."
                                            },
                                            {
                                                "example_id": "8be91bc0-7944-43be-a226-1d7bc6006b04",
                                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                                "text": "Ils abritaient des oiseaux qui nous égayaient de leurs chamailleries et de leurs chants et parfois, le soir, explosait un immense piaillement de moineaux."
                                            },
                                            {
                                                "example_id": "65c68928-ebe5-4188-9c61-ac6b20c69c31",
                                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                                "text": "Si j’ai des trucs à leur dire, et j’ai des trucs à leur dire, évidemment, je vais le faire entre quatre-z-yeux, discrètement, sans étaler désaccords et chamailleries dans ces colonnes, ou sur la place publique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b8e3dd0-5042-4459-b913-59048d9a2150",
                        "source_entry_id": "4a4a0463-e6a3-33f1-811b-5e0b753b311b",
