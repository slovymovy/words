                "senses": [
                    {
                        "sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                        "entry_id": "8f6ee6a3-26eb-3a88-9fe3-c74799b46b03",
                        "glosses": [
                            "de complexe maatschappij waarin veel van de mensen in steden leven en hun voedsel door middel van landbouw verkrijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711a0ba4-67de-4dde-99b1-f9ab25eb2a71",
                                "sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                                "text": "De Chinese beschaving staat al lange tijd op een hoog peil."
                            },
                            {
                                "example_id": "951fb3ea-a667-4364-8568-ba60b49aac1f",
                                "sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                                "text": "Nooit eerder rende ik zó hard over een parkeerplaats naar een McDonald’s toen ik er eindelijk was. Dolgelukkig sloot ik achter aan in de rij. Een moeder voor me trok woedend aan de bovenarm van haar kind, een stel maakte ruzie over het menu en een getatoeëerde man stond luid te bellen. Ik stond weer met beide benen in de ‘beschaving’."
                            }
                        ]
                    },
                    {
                        "sense_id": "5050e789-649a-38a3-ba6e-186ac3eb16c9",
                        "entry_id": "8f6ee6a3-26eb-3a88-9fe3-c74799b46b03",
                        "glosses": [
                            "de mate waarin iemand gevormd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a780ee98-6588-4397-8a36-4f921fe2f21e",
                                "sense_id": "5050e789-649a-38a3-ba6e-186ac3eb16c9",
                                "text": "Deze mensen zijn zonder enige vorm van beschaving, ze lezen niet, ze luisteren niet naar klassieke muziek, zijn niet volgens de laatste mode gekleed en praten plat."
                            }
                        ]
                    },
                    {
                        "sense_id": "212b2a37-edf4-3a7d-b7c4-07a763505b68",
                        "entry_id": "8f6ee6a3-26eb-3a88-9fe3-c74799b46b03",
                        "glosses": [
                            "de mate waarin men fatsoenlijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3317ec-aac7-4e28-9aed-1e11927f6430",
                                "sense_id": "212b2a37-edf4-3a7d-b7c4-07a763505b68",
                                "text": "Geen verlopen huisvrouw die flessen vieux achter in de keukenkastjes verstopt, maar degene die haar glas op feestjes heel snel in de keuken bijvult terwijl ze er tijdens gesprekken delicaat van nipt, waardoor het lijkt alsof ze amper drinkt. Zij vindt dat ongetwijfeld een teken van beschaving. Haar broer had minder beschavingsdrang. Hij en ik, we klonken uitbundig met glazen, en man, wat hebben we goede feestjes gegeven."
                            },
                            {
                                "example_id": "20885159-5d6b-4856-8589-0e2f4a771eb9",
                                "sense_id": "212b2a37-edf4-3a7d-b7c4-07a763505b68",
                                "text": "Joodse Amsterdammers die betrokken waren bij het Nederlands Auschwitz Comité, werden na hun terugkeer uit de kampen bespioneerd door de voorloper van de AIVD. Nabestaanden en het Auschwitz Comité zijn ontsteld. ‘Het feit dat je verslag doet van de mensen die stil kwamen staan bij hun familie die was afgeslacht, tart elk idee van beschaving.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3411b1a-e016-4439-bb36-57303e60af3e",
                        "source_entry_id": "8f6ee6a3-26eb-3a88-9fe3-c74799b46b03",
                        "source_sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                        "source_sense_description": "de complexe maatschappij waarin veel van de mensen in steden leven en hun voedsel door middel van landbouw verkrijgen",
                        "target_lang_word": "civilisation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civilisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c864998-8300-34a2-8823-abab90e5df33",
                                        "entry_id": "f13586ef-a659-3233-b16c-94eb8f9ba2c3",
                                        "glosses": [
                                            "UK, Ireland, Australia, New Zealand, South Africa, Hong Kong, and Commonwealth spelling of civilization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b560e085-4035-41fd-94de-ae581cd0b264",
                                                "sense_id": "6c864998-8300-34a2-8823-abab90e5df33",
                                                "text": "From Keighley onwards we had obviously returned to civilisation, for the surrounding country was now studded with the sodium street lights of suburbia and a thickening industrial haze was blotting out the moon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52b0f345-db06-43a5-b685-75ce57b2c5a3",
                        "source_entry_id": "8f6ee6a3-26eb-3a88-9fe3-c74799b46b03",
                        "source_sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                        "source_sense_description": "de complexe maatschappij waarin veel van de mensen in steden leven en hun voedsel door middel van landbouw verkrijgen",
                        "target_lang_word": "civilisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civilisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                        "entry_id": "db99d3ca-136e-358b-adbe-37c4c107f89d",
                                        "glosses": [
                                            "Action de civiliser ou état de ce qui est civilisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f3fe98e-5946-489e-bc75-f800e2fc7297",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "À bon droit les Ministres de la Religion ont-ils le premier rang dans une société bien ordonnée. La religion est sans contredit le premier et le plus utile frein de l’humanité; c’est le premier ressort de la civilisation ; elle nous prêche et nous rappelle sans cesse la confraternité, elle adoucit notre cœur, etc."
                                            },
                                            {
                                                "example_id": "b0c60fac-6141-4b34-a25d-4abd5eafa84e",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "La phase de civilisation dans laquelle se trouve ce peuple est encore bien éloignée de celle où nous sommes arrivés en Europe."
                                            },
                                            {
                                                "example_id": "a409c4f5-534a-41be-9440-edb1a273f1b8",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "Nous sommes de ceux qui croient que les bottes vernies et les paletots en caoutchouc contribuent très-peu à la civilisation, et qui estiment la civilisation elle-même quelque chose de peu désirable."
                                            },
                                            {
                                                "example_id": "b4838339-29a8-47f5-a00f-ea09979e059c",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "J’ai appelé l’attention sur le danger que présentent pour l’avenir d’une civilisa­tion les révolutions qui se produisent dans une ère de déchéance économique."
                                            },
                                            {
                                                "example_id": "d6920353-794e-4795-8ec2-1060905d7a18",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "Un corbeau déjà dressé et comment (il buvait du vin), avait jugé bon néanmoins de renoncer aux bienfaits de la civilisation et de reprendre la clé des bois."
                                            },
                                            {
                                                "example_id": "2d0ad8c0-7330-4eba-bb44-c2b3415279e9",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "J’admets même que votre art cauchemardeux et tératologique, faussement ingénu et savamment puéril, possède une valeur de signe, qu’il soit la transcription symboliquement exacte d’une civilisation qui a perdu sa table de valeurs et d’une humanité qui a peur d’elle-même."
                                            },
                                            {
                                                "example_id": "72dea75d-72b5-42be-a0ad-49d06633fab3",
                                                "sense_id": "8116dda3-8fdb-3f41-ab02-ccfb2ed5acb1",
                                                "text": "Monsieur André, l’Inspecteur le lui répète chaque fois, devrait savoir que la cravate fait partie de la civilisation, que ce soit une lavallière, un nœud droit ou une régate et que le décorum est lié à la fonction publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1cf6995-9409-3164-be44-35171c5734fa",
                                        "entry_id": "db99d3ca-136e-358b-adbe-37c4c107f89d",
                                        "glosses": [
                                            "Ensemble des connaissances, des mœurs, des idées d’un pays considéré comme civilisé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb1a9fa4-955f-40bf-ac1e-52ad21cbc440",
                                                "sense_id": "f1cf6995-9409-3164-be44-35171c5734fa",
                                                "text": "Comme la langue latine a été la source de notre langue, comme les ruines de la civilisation romaine ont été le berceau de notre civilisation, ainsi les littératures de la Grèce et de Rome ont été les premières nourrices des lettres françaises."
                                            },
                                            {
                                                "example_id": "ffe8f0d2-a161-47e7-a7bc-795ef8b585e9",
                                                "sense_id": "f1cf6995-9409-3164-be44-35171c5734fa",
                                                "text": "La civilisation au sein de laquelle nous vivons apparaît comme l’aboutissant final de l’effort humain."
                                            },
                                            {
                                                "example_id": "2a306c4e-6949-4eb4-ba24-0f015144f841",
                                                "sense_id": "f1cf6995-9409-3164-be44-35171c5734fa",
                                                "text": "Les immenses succès obtenus par la civilisation matérielle ont fait croire que le bonheur se produirait tout seul, pour tout le monde, dans un avenir tout prochain."
                                            },
                                            {
                                                "example_id": "5006a0f2-2337-4a81-9b0b-d6785c0a5f88",
                                                "sense_id": "f1cf6995-9409-3164-be44-35171c5734fa",
                                                "text": "Va-t-il me falloir enregistrer que Castelsarrasin, centre d’un obscurantisme homicide, évolue à rebours de la civilisation ? Non !"
                                            },
                                            {
                                                "example_id": "a6e0b8df-92a3-4e5c-8bd8-074ba0012a9c",
                                                "sense_id": "f1cf6995-9409-3164-be44-35171c5734fa",
                                                "text": "Sous les Omeyyades, les Arabes ont créé, en moins d’un siècle, entre 660 et 750, les conditions dans lesquelles une civilisation islamique nouvelle a pu se développer dans les grands centres urbains du Proche-Orient ancien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9ec1bd-6379-3ac2-86c1-0c3fee8e1467",
                                        "entry_id": "db99d3ca-136e-358b-adbe-37c4c107f89d",
                                        "glosses": [
                                            "État de développement économique, social et culturel élevé, en parlant d'un peuple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d65872-657d-481b-bd7f-b98e4201170b",
                                                "sense_id": "cb9ec1bd-6379-3ac2-86c1-0c3fee8e1467",
                                                "text": "Les hommes anéantissent leur civilisation avant de l’avoir achevée. Partout ils se battent et s’exterminent, partout ! Jusque dans l’Amérique du Sud, on s’entre-tue."
                                            },
                                            {
                                                "example_id": "cab21af7-c612-4a01-849f-6a6325dab318",
                                                "sense_id": "cb9ec1bd-6379-3ac2-86c1-0c3fee8e1467",
                                                "text": "Les seules traces de civilisation rencontrées remontaient à dix-huit siècles avec des oppida romaines."
                                            },
                                            {
                                                "example_id": "e9c0b3f8-9167-41e1-a70a-44a099674c20",
                                                "sense_id": "cb9ec1bd-6379-3ac2-86c1-0c3fee8e1467",
                                                "text": "La fin de la guerre froide a permis une floraison d’études sur le nouveau monde, le nouvel ordre international, l’universalisation du libéralisme ou le clash des civilisations. Les avions qui ont foncé sur les tours de New York dans le ciel bleu d’un beau matin de septembre ont jeté le doute sur tous ces exercices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "646b1e4e-0339-3a0b-ab12-25ca76959cda",
                                        "entry_id": "db99d3ca-136e-358b-adbe-37c4c107f89d",
                                        "glosses": [
                                            "Ensemble d’individus ayant en commun des mêmes éléments religieux, culturels, politiques et technologiques"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5bed87-e380-4ee5-b0d8-f67ff71b5f2d",
                                                "sense_id": "646b1e4e-0339-3a0b-ab12-25ca76959cda",
                                                "text": "La civilisation mégalithique, qui succède à celle des cavernes, a surtout pour caractère saillant les grands monuments connus sous le nom de dolmens, allées couvertes, menhirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55396154-b149-486e-a6b7-e0a8777a1cb1",
                        "source_entry_id": "8f6ee6a3-26eb-3a88-9fe3-c74799b46b03",
                        "source_sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                        "source_sense_description": "de complexe maatschappij waarin veel van de mensen in steden leven en hun voedsel door middel van landbouw verkrijgen",
