                                "target_lang_sense_clarification": "разг., низшая часть турнирной таблицы"
                            },
                            {
                                "target_lang_word": "подвал",
                                "target_lang_sense_clarification": "перен., конец списка команд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垫底",
                                "target_lang_sense_clarification": "体育比赛中处于最后一名"
                            },
                            {
                                "target_lang_word": "末位",
                                "target_lang_sense_clarification": "排名列表的最后位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b3a36e2-69b2-3758-9c52-2f1d9dd4d01b",
                    "sense_definition": "A mass of igneous or metamorphic rock forming the foundation over which a platform of sedimentary rocks is laid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oil well was drilled deep enough to reach the crystalline <w>basement</w>.",
                            "target_lang_translations": {
                                "ru": "Нефтяная скважина была пробурена достаточно глубоко, чтобы достичь кристаллического <w>фундамента</w>.",
                                "zh": "油井钻得足够深，已经触及了结晶<w>基底</w>。"
                            }
                        },
                        {
                            "text": "Geologists analyzed the <w>basement</w> rock beneath the layers of sediment.",
                            "target_lang_translations": {
                                "ru": "Геологи проанализировали породы <w>фундамента</w> под слоями осадочных отложений.",
                                "zh": "地质学家分析了沉积层下方的<w>基底</w>岩石。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Массив магматических или метаморфических пород, образующий основание, на котором залегают осадочные породы.",
                        "zh": "构成沉积岩层下方基础的火成岩或变质岩块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фундамент",
                                "target_lang_sense_clarification": "геол., кристаллическое основание"
                            },
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "базис горных пород"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基底",
