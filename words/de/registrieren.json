    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d6f644f-3976-30ca-aa71-48d44c1aad6f",
                    "sense_definition": "in ein amtliches Register, ein Verzeichnis oder ein Datensystem eintragen oder aufnehmen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eintragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der Nutzung der Webseite müssen Sie sich zuerst online <w>registrieren</w>.",
                            "target_lang_translations": {
                                "en": "Before using the website, you must first <w>register</w> online."
                            }
                        },
                        {
                            "text": "Die Behörde hat das neue Fahrzeug im zentralen System ordnungsgemäß <w>registriert</w>.",
                            "target_lang_translations": {
                                "en": "The authority properly <w>registered</w> the new vehicle in the central system."
                            }
                        }
                    ],
                    "synonyms": [
                        "anmelden",
                        "eintragen",
                        "erfassen",
                        "verzeichnen",
                        "einschreiben"
                    ],
                    "antonyms": [
                        "abmelden",
                        "austragen",
                        "löschen",
                        "streichen"
                    ],
                    "common_phrases": [
                        "sich online registrieren",
                        "offiziell registrieren"
                    ],
                    "target_lang_definitions": {
                        "en": "to enter or record into an official register, directory, or data system"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "register",
                                "target_lang_sense_clarification": "to officially enter details into a record or system"
                            },
                            {
                                "target_lang_word": "record",
                                "target_lang_sense_clarification": "to store information formally in a database or directory"
                            },
                            {
                                "target_lang_word": "sign up",
                                "target_lang_sense_clarification": "to register oneself, e.g., on a website or service"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e443bc5f-0110-34cc-9c58-fcd5839939f6",
                    "sense_definition": "etwas aufmerksam wahrnehmen, bemerken oder zur Kenntnis nehmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wahrnehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich war so müde, dass ich die Durchsage am Bahnhof gar nicht <w>registriert</w> habe.",
                            "target_lang_translations": {
                                "en": "I was so tired that I did not <w>notice</w> the announcement at the train station at all."
                            }
                        },
                        {
                            "text": "Die empfindlichen Messgeräte <w>registrieren</w> jede kleinste Veränderung der Temperatur im Raum.",
                            "target_lang_translations": {
                                "en": "The sensitive measuring instruments <w>register</w> even the smallest change in room temperature."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemerken",
                        "feststellen",
                        "merken",
                        "wahrnehmen",
                        "erkennen"
                    ],
                    "antonyms": [
                        "übersehen"
                    ],
                    "common_phrases": [
                        "eine Veränderung registrieren",
                        "gar nicht registrieren"
                    ],
                    "target_lang_definitions": {
                        "en": "to attentively perceive, notice, or become aware of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "notice",
                                "target_lang_sense_clarification": "to become aware of or observe something"
                            },
                            {
                                "target_lang_word": "register",
                                "target_lang_sense_clarification": "to perceive mentally, or of an instrument to detect"
                            },
                            {
                                "target_lang_word": "take note of",
                                "target_lang_sense_clarification": "to observe or acknowledge something deliberately"
                            }
                        ]
                    }
                }
            ]
        }
    ]
