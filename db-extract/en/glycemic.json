                                            {
                                                "example_id": "54ee7412-1a2c-4ed0-85b5-6c8699cfb88b",
                                                "sense_id": "e31baede-79a1-3d81-98b9-a479c99582fb",
                                                "text": "Les sucres lents (ou à index glycémique bas) ont besoin de transformations avant d’être assimilés ; ils passent donc plus lentement dans le sang et assurent une alimentation en sucre « régulière » et douce."
                                            },
                                            {
                                                "example_id": "8fd92529-6472-438d-803d-4990076c799c",
                                                "sense_id": "e31baede-79a1-3d81-98b9-a479c99582fb",
                                                "text": "La charge glycémique d’un aliment est calculée en multipliant l’index glycémique d’un aliment donné par la quantité de glucides d’une portion de cet aliment, puis en le divisant par 100."
                                            }
