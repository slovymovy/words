                                "target_senses": [
                                    {
                                        "sense_id": "ffd6c384-54d5-3ef8-8b3f-a69641244fc2",
                                        "entry_id": "fe988cc4-4ccd-3f44-af63-bae5781dd140",
                                        "glosses": [
                                            "A person who works on the dock of a harbor or shipyard, usually employed to load or unload freight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ac86ef2-9117-4646-80ec-bbb9f0efc3f5",
                                                "sense_id": "ffd6c384-54d5-3ef8-8b3f-a69641244fc2",
                                                "text": "Red Hook is fabled dockworker territory, not necessarily for inspirational reasons. The mob violence and union corruption that long defined the piers were part of the underpinnings of the classic 1954 movie “On the Waterfront.”"
                                            },
                                            {
                                                "example_id": "39fe7a35-0d44-4e99-84ca-a4a727dda16d",
                                                "sense_id": "ffd6c384-54d5-3ef8-8b3f-a69641244fc2",
                                                "text": "The East Coast dockworkers understand what’s happening around the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b91dd389-a285-4b5b-af44-cfa9892821b4",
                        "source_entry_id": "252af271-de07-35d0-9ab0-a6156fd77e2c",
                        "source_sense_id": "66842ce4-12df-3177-9e6b-9d6f924f1d41",
                        "source_sense_description": "arbeider die in een haven werkt",
                        "target_lang_word": "dock worker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dock worker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c035a2ab-3fac-3e43-87b3-5d4380dbccb6",
                                        "entry_id": "e73e6ade-7b60-3be2-8e8f-85f5e888c4dc",
                                        "glosses": [
                                            "Alternative form of dockworker."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff3c98c-1692-44de-907e-e3fb1036abc7",
                                                "sense_id": "c035a2ab-3fac-3e43-87b3-5d4380dbccb6",
                                                "text": "Postmen, binmen, dock workers, even barristers are now on strike. Where will all this end?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d8fd611-4eb7-40b9-a96d-2115021008dc",
                        "source_entry_id": "252af271-de07-35d0-9ab0-a6156fd77e2c",
                        "source_sense_id": "66842ce4-12df-3177-9e6b-9d6f924f1d41",
                        "source_sense_description": "arbeider die in een haven werkt",
                        "target_lang_word": "débardeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débardeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84dbd5c2-f059-33bf-a297-cffe69d702e6",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Celui qui fait le métier de débarder le bois ou la pierre, qui transporte les grumes de bois."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd376e8-53ca-4483-a9a1-a6ef2b1a970f",
                                                "sense_id": "84dbd5c2-f059-33bf-a297-cffe69d702e6",
                                                "text": "A part quelques coups de tronçonneuse de temps en temps, on n’entends que le cliquetis des chaines des deux juments, et les ordres brefs du débardeur, Marc Denis. Cela fait plus de 15 ans qu’il débarde avec des chevaux de traits […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de3ab6a0-8e05-319a-b999-bbc386c2d0d3",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Machine forestière conçue spécifiquement pour le déplacement des grumes par traînage."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45b97986-55de-4f7e-8a9f-9f1a80633848",
                                                "sense_id": "de3ab6a0-8e05-319a-b999-bbc386c2d0d3",
                                                "text": "Le débardeur à câble accomplit donc un rôle particulier que ne jouent pas les autres débardeurs, c’est-à-dire qu’il forme lui-même sa propre charge en allant chercher les arbres un par un, là où les véhicules ne peuvent se rendre. … Par contre, même s’ils sont tous deux désignés en anglais par le terme général skidder, le débardeur à pince (grapple skidder) et le débardeur à pince portante (clambunk skidder), ne font pas de débusquage et ne peuvent être appelés débusqueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89439e0-15c0-3d51-ada4-dc2aee66dca9",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Travailleur des quais, docker."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Transport maritime",
                                            "Encore utilisé au Canada dans ce sens",
                                            "vieilli en France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e5e3f5-27de-4b81-a790-47c0b8bf9eba",
                                                "sense_id": "f89439e0-15c0-3d51-ada4-dc2aee66dca9",
                                                "text": "Mais être un rude travailleur ;\nAimer à boir’, chanter et rire,\nVoilà, voilà le débardeur !"
                                            },
                                            {
                                                "example_id": "d7a39e86-ce82-4ed6-a7d6-10a849c8dbd1",
                                                "sense_id": "f89439e0-15c0-3d51-ada4-dc2aee66dca9",
                                                "text": "J’ai été me proposer au maître débardeur du quai Saint-Paul, et j’y gagne ma vie."
                                            },
                                            {
                                                "example_id": "db20ab28-564c-4de7-bcd1-f710f259c069",
                                                "sense_id": "f89439e0-15c0-3d51-ada4-dc2aee66dca9",
                                                "text": "Qu’ils [les critiques littéraires] admirent tous votre style vigoureux, et vous vous croirez obligé d’écrire dorénavant comme un débardeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b134d62-fa50-3f92-ad1a-c79b420676a1",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Tricot court, sans col ni manche."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b83481-5ffc-4e1a-9b1c-40cb71a5d7d8",
                                                "sense_id": "7b134d62-fa50-3f92-ad1a-c79b420676a1",
                                                "text": "Steph portait un jean ajusté, des spartiates en cuir et un débardeur blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470a6341-569d-3054-9251-2c873f997a19",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Sous-vêtement ou vêtement sans col ni manche, très échancré, laissant apparaître les épaules, généralement en jersey."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b41357-556c-442e-aeca-b4cd84a76da0",
                                                "sense_id": "470a6341-569d-3054-9251-2c873f997a19",
                                                "text": "Le vent sèche en quelques minutes les chaussettes et caleçons tout juste lavés par des militaires désormais en short et en débardeur."
                                            },
                                            {
                                                "example_id": "b8d0737b-2d62-4e05-ab07-be9ea4530358",
                                                "sense_id": "470a6341-569d-3054-9251-2c873f997a19",
                                                "text": "À partir de janvier 2022, les femmes devront porter des \"pantalons courts et ajustés\" et un \"débardeur ajusté\" lors des compétitions de beach handball, selon le nouveau règlement publié le 3 octobre dernier par la Fédération internationale de handball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6728ee8-33cf-3066-942b-16dd4b470a84",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Personnage typique du carnaval de Paris, très en vogue au xixᵉ siècle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65efd1af-7b54-4580-af08-4c03d68e4c2e",
                                                "sense_id": "a6728ee8-33cf-3066-942b-16dd4b470a84",
                                                "text": "Le débardeur mâle et femelle... vivants !... rapportés d'un voyage autour du monde par Monsieur Chicard, célèbre naturaliste, avec la permission des autorités !... Le débardeur est carnivore, fumivore, hydrophobe et nocturne ! se repaît de gibier, de volaille et de poisson !... il mange de l'huître, de la sole au gratin, de la mayonnaise de homard !... il mange de tout !..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58996d87-8e8f-31fe-8249-421066669322",
                                        "entry_id": "62b0ad2c-4f2e-3933-a8cc-49a8e3933263",
                                        "glosses": [
                                            "Vêtement porté par le personnage de carnaval du même nom, et consistant en un pantalon large, une ceinture de tissu rouge, une perruque et un calot."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
