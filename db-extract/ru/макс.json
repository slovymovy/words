                    }
                ],
                "senses": [
                    {
                        "sense_id": "43a19430-6b53-3442-b913-786c75da075d",
                        "entry_id": "1eab3c20-26cf-3970-9678-fe2722c57941",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "645afeeb-4998-4be2-a5a8-17dddec89cd2",
                                "sense_id": "43a19430-6b53-3442-b913-786c75da075d",
                                "text": "Бруно Бауер живёт здесь, но никто его не видит, о нём не слышит; на днях я встретил в концерте человечка прилизанного и печально-смиренного… Это был Макс Штирнер."
                            }
                        ]
                    },
                    {
                        "sense_id": "aca6f9e1-dd6e-3019-90ae-d65c01829a66",
                        "entry_id": "1eab3c20-26cf-3970-9678-fe2722c57941",
                        "glosses": [
                            "разг. гипокор. к Максим или Максимилиан"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad3174e8-7e09-436b-b834-59497e421a95",
                                "sense_id": "aca6f9e1-dd6e-3019-90ae-d65c01829a66",
                                "text": "Я статью Макса Волошина о вашем муже наизусть помню."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e35aa467-9481-425d-a008-b4fe96b63e1a",
                        "source_entry_id": "1eab3c20-26cf-3970-9678-fe2722c57941",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Max",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Max",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "732ec420-c350-3f71-9549-22f79ee2b611",
                                        "entry_id": "f466f0b0-72e4-391f-b4ab-fa50f7b8e593",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845f080c-6f43-4208-b1a7-690b8123cac9",
                                                "sense_id": "732ec420-c350-3f71-9549-22f79ee2b611",
                                                "text": "Since it seems to me that this fad of child-rearing has turned into an actual trend, that babies are an increasingly popular accessory for people-on-the-go, I first want to say to stop naming your boys Max. Max is a perfectly nice name, ensuring its owner a certain precocious sensibility, but there are enough Maxes now. Any more Maxes and the breed will go to the dogs."
                                            },
                                            {
                                                "example_id": "a0e436bc-7d7c-4923-b609-44933589756f",
                                                "sense_id": "732ec420-c350-3f71-9549-22f79ee2b611",
                                                "text": "Kyle: Okay, Max. Search."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac83dd4-b7e1-3f41-badd-b1d330b1826e",
                                        "entry_id": "f466f0b0-72e4-391f-b4ab-fa50f7b8e593",
                                        "glosses": [
                                            "A diminutive of the male given names Maximilian or Maxwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7631fa89-bc7f-4cb0-9b92-dec294fed30b",
                                                "sense_id": "6ac83dd4-b7e1-3f41-badd-b1d330b1826e",
                                                "text": "Hamtramck is described in the resolution as “one of the most diverse cities in the United States.” The city has a large immigrant presence and all the city council members are of the Muslim faith, city manager Max Garbarino told CNN Thursday. Hamtramck was also the first known city in the US to inaugurate an all-Muslim government, CNN previously reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be01683d-1f30-32a3-860d-2d180bd47714",
                                        "entry_id": "f466f0b0-72e4-391f-b4ab-fa50f7b8e593",
                                        "glosses": [
                                            "A diminutive of the female given name Maxine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a385d4fc-cead-4636-9e16-645586a713a0",
                        "source_entry_id": "1eab3c20-26cf-3970-9678-fe2722c57941",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Max",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Max",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b4315f7-8bcb-3a5d-b040-4128d2cd6504",
                                        "entry_id": "4aa7f106-b774-3a13-9db0-3ade18b6de37",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc7c53b-0f3d-4792-a36d-5dfc4ee811c9",
                                                "sense_id": "5b4315f7-8bcb-3a5d-b040-4128d2cd6504",
                                                "text": "Max ist beim Überholen ins Schleudern gekommen und konnte den Wagen gerade noch abfangen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27e68ab3-2fe7-4d53-8f8e-2e36b9cfe722",
                        "source_entry_id": "1eab3c20-26cf-3970-9678-fe2722c57941",
                        "source_sense_description": "Иноязычные аналоги",
