                    }
                ],
                "senses": [
                    {
                        "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                        "entry_id": "5d5534d1-2893-332d-ae24-39df3830c97e",
                        "glosses": [
                            "aufgerollte Backware mit einem Biskuitteig mit einer Füllung aus Creme oder Marmelade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded7d2fd-f602-48b1-b5f3-72683494f44b",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "Ich habe meiner Familie zum Wochenende eine Biskuitrolle gebacken."
                            },
                            {
                                "example_id": "cf309b70-b1f5-431c-a2b3-d36edef2a8bc",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "Diese Biskuitrolle mit der Schokoladencremefüllung schmeckt einfach super."
                            },
                            {
                                "example_id": "c81e89b8-5f80-4b79-b3e5-0a51ee766f80",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "Eine Biskuitrolle muss nach dem Verstreichen der Cremefüllung und Aufrollen in den Kühlschrank gestellt werden."
                            },
                            {
                                "example_id": "dc7beca8-f303-47e4-97c7-a9794c3750a6",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Denkt man an edle Backwerke, fallen einem sofort aufwändige Sahnetorten aber auch geniale Biskuitrollen ein.“"
                            },
                            {
                                "example_id": "3aaff92e-fdcc-4efa-a8cf-3fcf67e77b29",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Wie bekommt man die Biskuitrolle ordentlich eingerollt? Wir zeigen einen ganz einfachen Trick […].“"
                            },
                            {
                                "example_id": "dc2e80ae-1e72-4495-98b6-0926212ed303",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Biskuitrollen werden gerne mit Gelee, Konfitüre oder Buttercreme gefüllt.“"
                            },
                            {
                                "example_id": "8faa8509-522a-4639-97bb-923bd213fd0a",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Die Biskuitrolle schmeckt wunderbar als leichtes Dessert, aber auch toll zum Nachmittagskaffee oder -tee.“"
                            },
                            {
                                "example_id": "5f1695fc-0c0a-4664-89b2-57d94b25e047",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Zum Backen von Tortenböden oder Biskuitrollen ist die lockere, luftige Biskuitmasse ideal. Biskuit zählt nicht zu den Teigen, sondern zu den Massen. Hauptzutaten sind Eier und Zucker und nur wenig Mehl.“"
                            },
                            {
                                "example_id": "3aade166-1baa-40e6-a113-0ea74b0fd976",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Aber natürlich liegt auch etwas Süßes im Picknickkorb: eine Biskuitroulade mit Heidel- oder Walderdbeeren“."
                            },
                            {
                                "example_id": "dd74aa20-5156-4810-8466-a38ba2158a98",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Zugegeben, Biskuitrollen sind ursprünglich nicht aus Nordrhein-Westfalen...ABER echt totaaal lecker und wir essen sie hier schon ziemlich lange!“"
                            },
                            {
                                "example_id": "487016d6-c92d-44f3-9c52-131231319e80",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "[Die Kellnerin ] „nahm ihn mit in die Küche, wo sie ihm einen Teller Eintopf gab, ein Stück Biskuitrolle und Kaffee.“"
                            },
                            {
                                "example_id": "ae061874-ff49-4c50-8730-d9c06fd1e0de",
                                "sense_id": "db6e6321-d665-37a5-b649-47072ec04d53",
                                "text": "„Etwas altmodisch ist sie ja schon, die Biskuitrolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
