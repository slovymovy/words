                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25f1688e-9ed6-4d0e-a955-245f983dbe6f",
                        "source_entry_id": "b126b694-400e-3e14-93a2-586c993c47d9",
                        "source_sense_description": "человек, добывающий золото",
                        "target_lang_word": "Goldsucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Goldsucher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2cbed0a-919a-3308-997c-8a9b69b0e56a",
                                        "entry_id": "b776fd15-0cca-32b1-9157-a42abefb576e",
                                        "glosses": [
                                            "Person, die (beruflich) nach Goldvorkommen sucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63978cd7-578c-4e06-aeb3-8309c904fbf1",
                                                "sense_id": "c2cbed0a-919a-3308-997c-8a9b69b0e56a",
                                                "text": "Die Goldsucher hatten Pech und fanden nur Rohdiamanten."
                                            },
                                            {
                                                "example_id": "fd0b9ea4-a4c2-4695-98b6-f72036d95233",
                                                "sense_id": "c2cbed0a-919a-3308-997c-8a9b69b0e56a",
                                                "text": "Der Goldsucher hatte Glück und fand viele Goldnuggets."
                                            },
                                            {
                                                "example_id": "bd5f3f6f-847a-4eb9-b1b5-2ad61c500b85",
                                                "sense_id": "c2cbed0a-919a-3308-997c-8a9b69b0e56a",
                                                "text": "„Zuerst berührte sich dieses Gebiet nur, dann gab es nach Erweiterungen einen Sonderstatus für dieses Gebiet und die Goldsucher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba895c50-ed91-4710-8d96-b742b3c5c7b4",
                        "source_entry_id": "b126b694-400e-3e14-93a2-586c993c47d9",
                        "source_sense_description": "человек, добывающий золото",
                        "target_lang_word": "Goldwäscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Goldwäscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbfbfb43-48e1-3429-ad50-334fd954917b",
                                        "entry_id": "5bb49bc6-c37b-3331-beac-44fd93f82c82",
                                        "glosses": [
                                            "eine Person, die mittels Wasser in losem Gestein Gold sucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737a9dba-fb5b-44c9-a9e9-bd44eb27d8af",
                                                "sense_id": "cbfbfb43-48e1-3429-ad50-334fd954917b",
                                                "text": "Der Goldwäscher sitzt am Fluss und schwenkt seine Schale."
                                            },
                                            {
                                                "example_id": "7317083a-199e-4972-9ffa-8aaac907e82b",
                                                "sense_id": "cbfbfb43-48e1-3429-ad50-334fd954917b",
                                                "text": "Der Goldwäscher winkt dem Goldsucher zu, der in seiner Mine hämmert."
                                            },
                                            {
                                                "example_id": "6f0f8f0a-9777-4128-98cf-eb6194e11247",
                                                "sense_id": "cbfbfb43-48e1-3429-ad50-334fd954917b",
                                                "text": "„Es gab Fischergilden - und die Goldwäscher, fast wie vor hundert Jahren in Alaska am Klondike.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
