                    {
                        "sense_id": "5ae976d3-6a6d-3a68-b2cd-70c1388bfbec",
                        "entry_id": "8dafd345-1eb3-3cfd-a316-97eb4f545fc3",
                        "glosses": [
                            "The status of being unconstitutional, or of not being in accord with the provisions of a constitution."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2de12e72-0cca-4642-8f90-61938701e526",
                                "sense_id": "5ae976d3-6a6d-3a68-b2cd-70c1388bfbec",
                                "text": "I have heard again and again, remonstrances have been addressed to me more than once, because of the condemnation which Democratic speakers so continually utter about the unnationality as well as the unconstitutionality of the Republican party."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fa82b63-0204-4f58-8187-105d27aabe6b",
                        "source_entry_id": "8dafd345-1eb3-3cfd-a316-97eb4f545fc3",
                        "source_sense_id": "5ae976d3-6a6d-3a68-b2cd-70c1388bfbec",
                        "source_sense_description": "status of being unconstitutional",
                        "target_lang_word": "inconstitutionnalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconstitutionnalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9234f21f-a0b6-3c5b-a22b-002952b3b3bc",
                                        "entry_id": "5917bbdc-dc1f-31b5-8faa-2caff0d011dd",
                                        "glosses": [
                                            "Fait d’être contraire à la constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa19151-c47f-4b3c-9c3f-77d8ea02326e",
                                                "sense_id": "9234f21f-a0b6-3c5b-a22b-002952b3b3bc",
                                                "text": "Cap 21 propose de créer le droit de soulever l’inconstitutionnalité d’une loi pour tout citoyen, dans le cadre d’une procédure judiciaire."
                                            },
                                            {
                                                "example_id": "b584a261-ff42-4fbd-9d6e-3eed3d3196b3",
                                                "sense_id": "9234f21f-a0b6-3c5b-a22b-002952b3b3bc",
                                                "text": "Lorsque le Conseil constitutionnel est saisi de la conformité à la Constitution de la loi votée en application de l’article 61, l’empiétement du législateur sur le domaine réglementaire n’est pas une cause d’inconstitutionnalité de cette disposition […]."
                                            },
                                            {
                                                "example_id": "7131dbb0-7da0-4a86-bfac-6df5f0665eae",
                                                "sense_id": "9234f21f-a0b6-3c5b-a22b-002952b3b3bc",
                                                "text": "Il estime, enfin, qu’il existe un « vrai risque d’inconstitutionnalité », pour cette réforme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
