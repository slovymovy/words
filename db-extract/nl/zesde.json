                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sixth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                        "entry_id": "f8050b46-6b02-31a9-867c-761e8b2980db",
                                        "glosses": [
                                            "The ordinal form of the number six."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66cc5f1c-61fc-4856-bef9-1d74809b8b7a",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "And * God ſaw euery thing that hee had made : and behold, it was very good. And the euening and the moꝛning were the ſixth day.",
                                                "translation": "And God saw everything that he had made: and behold, it was very good. And the evening and the morning were the sixth day.",
                                                "english": "And God saw everything that he had made: and behold, it was very good. And the evening and the morning were the sixth day."
                                            },
                                            {
                                                "example_id": "1aef3002-f666-425a-83a4-9d407b888ebb",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "Dr. Ridpath, in his usual happy manner, thanked the Executive Committee and the various members of the Association who had so earnestly cooperated with him in the work of the Sixth Annual Meeting now drawing to a close."
                                            },
                                            {
                                                "example_id": "0d02015b-29cb-4e63-bd67-b2fe99ce7c72",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "[T]he law codes drafted in Athens in the late seventh and early sixth centuries were the work of individuals, Drakon and then Solon."
                                            },
                                            {
                                                "example_id": "7f5f2460-ae18-4a3d-928f-61fd9465f5bb",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "On Monday, the federal Immigration and Customs Enforcement agency placed a similar detainer on Melvin Jovel, 18, who on Sunday was the sixth person to be arrested in the case."
                                            },
                                            {
                                                "example_id": "ff2fb097-8fea-4c18-8ca8-bd4fa37168a0",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "As this sixth edition is published in 2011, it is exactly 25 years since the publication of the first edition in 1986. That, in itself, is a very sobering thought, for all kinds of reasons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sixth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a681994-e98a-3374-837a-53f61b2d3d65",
                                        "entry_id": "aeaced94-da9c-3cdf-bc0f-521790194e31",
                                        "glosses": [
                                            "The person or thing in the sixth position."
                                        ],
                                        "tags": [
                                            "not used in the plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21b4e259-e79a-3ebe-876f-e23be5810730",
                                        "entry_id": "aeaced94-da9c-3cdf-bc0f-521790194e31",
                                        "glosses": [
                                            "One of six equal parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53844e5c-7f37-440e-b7e1-a2432683f646",
                                                "sense_id": "21b4e259-e79a-3ebe-876f-e23be5810730",
                                                "text": "On the moon, however the weight of a pound-mass (lb or lbm) is only about one sixth of a pound-force (lbf)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7cdcab-15d8-34bf-840e-b24c0d4a741a",
                                        "entry_id": "aeaced94-da9c-3cdf-bc0f-521790194e31",
                                        "glosses": [
                                            "The interval between one note and another, five notes higher in the scale; for example C to A, a major sixth, or C to A flat, a minor sixth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sixth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "595b77f0-5f80-318c-af16-ea11aa42f155",
                                        "entry_id": "ee9da277-435e-36be-8d06-ed8f2aeaa8a3",
                                        "glosses": [
                                            "To divide by six, equivalent to multiplying a denominator by six."
                                        ],
                                        "tags": [
                                            "informal",
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0171841d-5d29-417a-a18f-2880c619462b",
                                                "sense_id": "595b77f0-5f80-318c-af16-ea11aa42f155",
                                                "text": "Why would anyone use sixthing when any (N − a²) divisible by 6 would also be divisible by 3? The answer is that sometimes the numerator and/or the denominator is simpler in sixthing,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7ecdb3c-4d4b-4133-bce6-ca76741395c2",
                        "source_entry_id": "cd7a86b1-4906-313d-b7cd-625a8126c173",
                        "source_sense_description": "nummer zes in een rij",
                        "target_lang_word": "sixième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sixième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a89c08a5-41c2-3eb5-8406-1f142e3d1e23",
                                        "entry_id": "ee73b90a-3834-31f4-baa9-fea03f19b44a",
                                        "glosses": [
                                            "Qui concerne l’ordinal correspondant au cardinal six."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637483db-74cc-4a13-a43e-692501d78f36",
                                                "sense_id": "a89c08a5-41c2-3eb5-8406-1f142e3d1e23",
                                                "text": "Parti sixième sur la grille, dimanche, le Français a abandonné dès le troisième virage, à la suite d’un violent accrochage avec l’Espagnol Marc Marquez."
                                            },
                                            {
                                                "example_id": "d4d32620-274e-4a4e-aae9-28b00e3290da",
                                                "sense_id": "a89c08a5-41c2-3eb5-8406-1f142e3d1e23",
                                                "text": "Vincent Demarconnay (161 matchs de L2), qui va entamer sa sixième saison de rang en deuxième division avec le Paris FC, se verrait bien, lui, sauter dans le grand bain, à 39 ans."
                                            },
                                            {
                                                "example_id": "691f1dd3-4f73-4892-885b-87ce93971f31",
                                                "sense_id": "a89c08a5-41c2-3eb5-8406-1f142e3d1e23",
                                                "text": "C’est une possibilité que les stades soient vides, mais pas une crainte, car on a l’habitude, lâche Arnaud Assoumani, spécialiste de la longueur et du triple saut, qui vient de se qualifier pour ses sixièmes Jeux paralympiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256880b8-876e-342a-a478-16702a53dc98",
                                        "entry_id": "ee73b90a-3834-31f4-baa9-fea03f19b44a",
                                        "glosses": [
                                            "Qui concerne la fraction d’une unité divisée en 6 parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1829ba11-2047-4aa9-8f10-0ec88d6d8869",
                                                "sense_id": "256880b8-876e-342a-a478-16702a53dc98",
                                                "text": "Donnez-moi une sixième partie de ce gâteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0ef409-66bc-3792-a5c7-1d87277b482b",
                                        "entry_id": "ee73b90a-3834-31f4-baa9-fea03f19b44a",
                                        "glosses": [
                                            "Avec cinq autres."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "note": "Dans les expressions: Lui sixième, elle sixième ou en sixième",
                                        "examples": [
                                            {
                                                "example_id": "40305e71-4ec7-4c8a-941d-bce1df5aeaa5",
                                                "sense_id": "3b0ef409-66bc-3792-a5c7-1d87277b482b",
                                                "text": "La membrure du canot dans lequel le capitaine Pamphile était embarqué, lui sixième, était faite d’un bois très fort mais pliant, uni par des pièces d’écorce de bouleau cousues les unes aux autres, et recouvertes sur leurs coutures d’une forte couche de goudron."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sixième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4896d015-b4c4-3b6a-a6a3-1558e3bbc3cb",
                                        "entry_id": "e8d56b13-4b79-3925-ba94-404c471f1691",
                                        "glosses": [
                                            "Élément ordinal, correspondant au cardinal six."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed2daad-0c70-4f5d-87ec-59b3403797a0",
                                                "sense_id": "4896d015-b4c4-3b6a-a6a3-1558e3bbc3cb",
                                                "text": "Une sixième fut la femme de toute sa vie : Fernande Choisel, sa fidèle secrétaire durant 32 ans."
                                            },
                                            {
                                                "example_id": "f5478b46-48ef-4bf1-b22b-3a436b12ba1f",
                                                "sense_id": "4896d015-b4c4-3b6a-a6a3-1558e3bbc3cb",
                                                "text": "Il est arrivé sixième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "509fa257-f713-3950-a8aa-2dc9754f50ba",
                                        "entry_id": "e8d56b13-4b79-3925-ba94-404c471f1691",
                                        "glosses": [
                                            "Fraction d’une unité divisée en 6 parties."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aae0ace-6f60-4bb3-8b3e-63521e4f0c6d",
                                                "sense_id": "509fa257-f713-3950-a8aa-2dc9754f50ba",
                                                "text": "Donnez-moi un sixième de ce gâteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98b5650-249f-3533-b52f-32e56f680577",
                                        "entry_id": "e8d56b13-4b79-3925-ba94-404c471f1691",
                                        "glosses": [
                                            "Première classe de collège, accessible après une CM2, et suivie par une cinquième."
                                        ],
                                        "tags": [
                                            "France",
                                            "Au féminin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fdbee6-90d9-4d42-9f23-18c4a0d00318",
                                                "sense_id": "f98b5650-249f-3533-b52f-32e56f680577",
                                                "text": "En sixième, quand on a fait la mythologie grecque, je me suis dit que c’était normal que les gouers, ils croyaient que Jésus était le fils de Dieu parce que leurs ancêtres, ils croyaient bien qu’Héraclès était le fils de Zeus."
                                            },
                                            {
                                                "example_id": "875f0482-3e5d-46f3-a7c8-d5708543672e",
                                                "sense_id": "f98b5650-249f-3533-b52f-32e56f680577",
                                                "text": "Sylvie, elle, a même un rituel : offrir à chaque entrée en sixième de ses neveux, nièces, filleuls et enfants un exemplaire de Pieds nus sur la terre sacrée, de Teresa Carolyn McLuhan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "651c30df-262f-31a3-ac31-b810856e8896",
                                        "entry_id": "e8d56b13-4b79-3925-ba94-404c471f1691",
                                        "glosses": [
                                            "Sixième étage."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a741fe9d-5b78-4e38-8815-8710c90102cb",
                                                "sense_id": "651c30df-262f-31a3-ac31-b810856e8896",
                                                "text": "On entendait, du rez-de-chaussée au sixième, des bruits de vaisselle, des poêlons qu’on barbotait, des casseroles qu’on grattait avec des cuillers pour les récurer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc82a99-9b06-3df2-9864-6032a37ae00b",
                                        "entry_id": "e8d56b13-4b79-3925-ba94-404c471f1691",
                                        "glosses": [
                                            "Suite de six cartes de même couleur."
                                        ],
                                        "tags": [
                                            "Au féminin",
                                            "Jeu de carte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e08936a-1489-44b7-8116-208e47a3598b",
                                                "sense_id": "7fc82a99-9b06-3df2-9864-6032a37ae00b",
                                                "text": "Une sixième au roi."
                                            },
