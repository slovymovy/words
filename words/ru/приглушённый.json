{
    "word_family": [
        "глухой",
        "глушить",
        "приглушить",
        "глухота"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6de18079-a514-36f3-aed9-0d0e6833e29f",
                    "sense_definition": "Звук, который слышится неясно, как будто через преграду.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С улицы доносился <w>приглушённый</w> шум проезжающих машин.",
                            "target_lang_translations": {
                                "en": "A <w>muffled</w> noise of passing cars could be heard from the street."
                            }
                        },
                        {
                            "text": "За дверью послышался <w>приглушённый</w> свист, который сразу затих.",
                            "target_lang_translations": {
                                "en": "A <w>muffled</w> whistle was heard behind the door, which immediately fell silent."
                            }
                        }
                    ],
                    "synonyms": [
                        "сдавленный",
                        "глуховатый"
                    ],
                    "antonyms": [
                        "громкий",
                        "звонкий"
                    ],
                    "common_phrases": [
                        "приглушённый звук",
                        "приглушённый голос"
                    ],
                    "target_lang_definitions": {
                        "en": "A sound that is heard unclearly, as if through an obstacle or barrier."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muffled",
                                "target_lang_sense_clarification": "describing a sound that is quieted or obscured"
                            },
                            {
                                "target_lang_word": "muted",
                                "target_lang_sense_clarification": "describing a sound that has been reduced in volume or intensity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4394cc58-ce3d-3b15-a498-9a26ebdae3fd",
                    "sense_definition": "Неяркий, невыразительный или подавленный (о цвете, свете или чувствах).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате горел <w>приглушённый</w> свет, создавая уютную атмосферу.",
                            "target_lang_translations": {
                                "en": "A <w>subdued</w> light was burning in the room, creating a cozy atmosphere."
                            }
                        },
                        {
                            "text": "Она чувствовала <w>приглушённый</w> гнев, но старалась не показывать его окружающим.",
                            "target_lang_translations": {
                                "en": "She felt a <w>subdued</w> anger, but tried not to show it to those around her."
                            }
                        }
                    ],
                    "synonyms": [
                        "тусклый"
                    ],
                    "antonyms": [
                        "яркий",
                        "усиленный"
                    ],
                    "common_phrases": [
                        "приглушённый свет",
                        "приглушённые тона"
                    ],
                    "target_lang_definitions": {
                        "en": "Not bright, dull, or subdued (referring to colors, light, or emotions)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subdued",
                                "target_lang_sense_clarification": "describing light, colors, or emotions that are restrained or not intense"
                            },
                            {
                                "target_lang_word": "dim",
                                "target_lang_sense_clarification": "specifically for light that is not bright"
                            },
                            {
                                "target_lang_word": "soft",
                                "target_lang_sense_clarification": "describing colors or light that are gentle and not harsh"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1edd9f65-61f0-3ffa-9189-2dd19bb78025",
                    "sense_definition": "Страдательное причастие прошедшего времени от глагола <w>приглушить</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Радио, <w>приглушённое</w> заботливой рукой, больше не мешало разговору.",
                            "target_lang_translations": {
                                "en": "The radio, <w>muted</w> by a caring hand, no longer interfered with the conversation."
                            }
                        },
                        {
                            "text": "Скрипка, <w>приглушённая</w> сурдинкой, звучала очень нежно и печально.",
                            "target_lang_translations": {
                                "en": "The violin, <w>muffled</w> by a mute, sounded very gentle and sad."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма глагола"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'to muffle' or 'to mute'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muffled",
                                "target_lang_sense_clarification": "the state of having been made quieter"
                            },
                            {
                                "target_lang_word": "muted",
                                "target_lang_sense_clarification": "the state of having been reduced in volume"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}