                                "target_senses": [
                                    {
                                        "sense_id": "7e155ce2-eb25-3ed2-bfe9-fbc25822b0fe",
                                        "entry_id": "c655c2de-926c-31bc-93ad-3f1545ad2421",
                                        "glosses": [
                                            "Handwerker, der Fässer oder Bottiche herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d958ca-bbf9-4097-80e0-a446e9667865",
                                                "sense_id": "7e155ce2-eb25-3ed2-bfe9-fbc25822b0fe",
                                                "text": "Der Böttcher bog die Eisenbänder sorgfältig um die Dauben."
                                            },
                                            {
                                                "example_id": "0eda81d4-b2b4-477d-9f79-cdd60a807d33",
                                                "sense_id": "7e155ce2-eb25-3ed2-bfe9-fbc25822b0fe",
                                                "text": "„Sein Großvater kam aus Berlin und betrieb das Handwerk eines Böttchers, das auch der Vater erlernte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
