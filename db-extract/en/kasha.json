                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3111202-9ed0-3c30-9d7c-864b8752e11c",
                        "entry_id": "e7c1b35f-c53c-3b54-901b-5d472e795b57",
                        "glosses": [
                            "A porridge made from boiled buckwheat groats, or sometimes from other cereal groats."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e2ba82-e06f-4930-92c3-833888597139",
                                "sense_id": "b3111202-9ed0-3c30-9d7c-864b8752e11c",
                                "text": "Some cooks add nuts as well, and I like the way their flavor complements that of the kasha and the browned onions."
                            },
                            {
                                "example_id": "7d01f987-7bc4-4acb-b09d-b98ad43b657f",
                                "sense_id": "b3111202-9ed0-3c30-9d7c-864b8752e11c",
                                "text": "Kristina Pankofska, a Polish exile whom Anna Petrovna paid a gold rouble a month to clean and help, arrived with a pail of hot kasha and two new eggs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c3638bf-4998-4731-9957-cb242f085788",
                        "source_entry_id": "e7c1b35f-c53c-3b54-901b-5d472e795b57",
                        "source_sense_id": "b3111202-9ed0-3c30-9d7c-864b8752e11c",
                        "source_sense_description": "porridge",
                        "target_lang_word": "kaše",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kaše",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "617f80c5-8549-3b47-8fa4-1949870304bf",
                                        "entry_id": "f18bca3c-77ae-3c13-834f-6815cd690318",
                                        "glosses": [
                                            "pokrm z rozmělněných potravin polotuhé konzistence"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e97795e-6afe-4498-ba47-b6fe72e27c9f",
                                                "sense_id": "617f80c5-8549-3b47-8fa4-1949870304bf",
                                                "text": "Ó, matičko milá, viz tato míska plná kaše byla pro tebe, abys sobě pochutnala, však divná nehoda se s kaší stala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b79a0f67-73ee-3d8d-89a4-484db658a1e1",
                                        "entry_id": "f18bca3c-77ae-3c13-834f-6815cd690318",
                                        "glosses": [
                                            "něco připomínající kaši"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e53f970-58dc-43b9-8208-3a6802f6028d",
                        "source_entry_id": "e7c1b35f-c53c-3b54-901b-5d472e795b57",
                        "source_sense_id": "b3111202-9ed0-3c30-9d7c-864b8752e11c",
                        "source_sense_description": "porridge",
                        "target_lang_word": "kacha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kacha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00859fd0-41b7-3186-ab8e-6daf17b87bc3",
                                        "entry_id": "4ba77e03-0e8b-364a-a765-5a500a6ecf66",
                                        "glosses": [
                                            "Plat russe, gruau de sarrasin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0868663f-ef71-4df7-b1a4-1a11cf445e81",
                                                "sense_id": "00859fd0-41b7-3186-ab8e-6daf17b87bc3",
                                                "text": "Je savais qu’il avait pris sa retraite, obtenu un studio dans un immeuble neuf, après avoir habité dans de vétustes baraquements de caserne, et qu’il y vivait seul, se nourrissant de lait et de kacha , parce que végétarien convaincu."
                                            },
                                            {
                                                "example_id": "abc0f1f1-1b1d-45ca-984e-dfc014b663f0",
                                                "sense_id": "00859fd0-41b7-3186-ab8e-6daf17b87bc3",
                                                "text": "Le frère Timofey se dirigea vers un homme qui s'activait au-dessus de cuves d'où s'échappaient des vapeurs alléchantes. Il en revint avec une assiette de kacha qui se révéla parfaitement comestible, même si Artyom était incapable d'en reconnaître les ingrédients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ceb840-9eba-32d5-a607-ede009303aca",
                                        "entry_id": "4ba77e03-0e8b-364a-a765-5a500a6ecf66",
                                        "glosses": [
                                            "Plat polonais, mélange d’orge cuit dans du lait, de crème aigre et d’œufs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44375bf2-a3d9-4501-a1ca-2fcd8a0dc9bd",
