                    },
                    {
                        "sense_id": "594d9c0a-7c08-3fa3-93f2-d3327dab04c8",
                        "entry_id": "03ff7e4f-3d7a-3656-babf-99ea8c125853",
                        "glosses": [
                            "Cavité, fosse, espace, poche, logette.",
                            "Synonyme de rhinopharynx, nasopharynx."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "9aeaa593-adc4-4a7c-a884-0bde377fe87d",
                                "sense_id": "594d9c0a-7c08-3fa3-93f2-d3327dab04c8",
                                "text": "L’encombrement du cavum peut être tel qu’il gêne la succion et la déglutition, entrave l’alimentation et trouble le sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2fb9d87-606f-38f4-b537-a19201ef5914",
                        "entry_id": "03ff7e4f-3d7a-3656-babf-99ea8c125853",
                        "glosses": [
                            "Zone circulaire (parfois linéaire) dégagée dans une couche très mince de nuages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "546ac002-b3a9-4b33-9668-fb1350f4b692",
                                "sense_id": "d2fb9d87-606f-38f4-b537-a19201ef5914",
                                "text": "Un cavum se forme lorsqu’une partie des gouttelettes de la couche de nuages se congèle de façon immédiate, diminuant soudain localement la densité du nuage, créant une percée et des virgas. Ce phénomène peut être provoqué notamment par le passage d’un avion à travers une couche de nuages […]"
                            }
                        ]
                    }
