                "senses": [
                    {
                        "sense_id": "209737d6-54e4-335d-95d3-2dbfc7ecbf40",
                        "entry_id": "820e2a06-061d-3533-b8d3-8323ee439bd3",
                        "glosses": [
                            "Film, in dem die Hauptfiguren in spannende Handlungen verwickelt sind"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5ffe325f-28b4-4628-9bc2-1b9824e452d4",
                                "sense_id": "209737d6-54e4-335d-95d3-2dbfc7ecbf40",
                                "text": "„Bereits 1918 drehten Lubitsch und die Negri zusammen zwei Filme: »Die Augen der Mumie Ma«, einen Abenteuerstreifen um eine junge Araberin, und die Dreiecksgeschichte »Carmen«. “"
                            },
                            {
                                "example_id": "91dd0ac0-0def-49cc-b715-ff8b52737479",
                                "sense_id": "209737d6-54e4-335d-95d3-2dbfc7ecbf40",
                                "text": "„30 Jahre später löste ein Abenteuerstreifen um zwei menschenfressende Löwen in den USA einen kurzen, aber starken 3D-Boom aus: \"Bwana Devil\" war 1952 der erste abendfüllende Spielfilm in der neuen Natural-Vision-Technologie.“"
                            }
                        ],
