                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f7b1241-5c94-43c8-9684-3bdf93a7bb10",
                                "sense_id": "785739bf-b2b7-3782-b018-84793b892b38",
                                "text": "Этого кожника в Химках видал, руки у него шершавые."
