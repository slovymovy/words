                        "entry_id": "09816ca9-d9d4-395d-8e4a-147079709439",
                        "glosses": [
                            "Qui est de nature à bouleverser, qui cause beaucoup d’émotion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "952e1c9d-e4b4-4c17-a639-a877d943a550",
                                "sense_id": "9e324c6a-d250-3100-863f-5ddb661d58fb",
                                "text": "Le deuxième long métrage de Laurent Larivière, À propos de Joan, présenté à la Berlinale cette année, met en lumière une Isabelle Huppert bouleversante."
                            },
                            {
                                "example_id": "c25ef116-fa7f-494a-b48a-12b596491779",
                                "sense_id": "9e324c6a-d250-3100-863f-5ddb661d58fb",
                                "text": "Anne Dorval, une nouvelle fois, est impériale, bouleversante."
                            }
                        ]
                    }
                ],
