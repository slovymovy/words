                "senses": [
                    {
                        "sense_id": "b1a5ee0d-5636-39de-9406-26f93cea4238",
                        "entry_id": "f2181134-6d9c-390e-8473-bea19b3be568",
                        "glosses": [
                            "Raum für Vorräte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5acf1a2-656c-4327-93e5-d99ce5ef4773",
                                "sense_id": "b1a5ee0d-5636-39de-9406-26f93cea4238",
                                "text": "„Dann verschwand ich wieder hinter dem Bastvorhang in den Vorratsraum, wo ich auf dem Boden meine Barbies zum Schlafen nebeneinandergelegt hatte.“"
                            },
                            {
                                "example_id": "a88109c6-7d6e-4b06-8378-f4588f83db10",
                                "sense_id": "b1a5ee0d-5636-39de-9406-26f93cea4238",
                                "text": "„Auf dem Hof angekommen, dachte Mawra Kusminitschna eine Weile darüber nach, wohin sie jetzt gehen sollte, ob zum Teetrinken ins Seitenhaus zu Wassilijitsch oder in die Vorratsräume, wo es noch allerhand zu ordnen gab.“"
                            },
                            {
                                "example_id": "b7dd58da-46ee-43f2-8285-287d0598dcbf",
                                "sense_id": "b1a5ee0d-5636-39de-9406-26f93cea4238",
                                "text": "„Der Saal wurde nur bei großen Familienfesten genutzt; in den Wochen vor der Flucht diente er dann als Vorrats- und Wirtschaftsraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
