                        "entry_id": "36e4aa64-d97f-378d-b4aa-d053c0d4e439",
                        "glosses": [
                            "Existing or happening outside the frame of the cinema or television screen"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
