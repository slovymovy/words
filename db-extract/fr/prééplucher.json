                ],
                "senses": [
                    {
                        "sense_id": "5d1aceae-0e4d-3ce0-a836-6a36d0e60545",
                        "entry_id": "38e99662-e1a0-35b8-948b-63c9b11c1009",
                        "glosses": [
                            "Éplucher avant stockage ou distribution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5ee1fef-1a95-4aeb-b00b-53e1327ac2c0",
                                "sense_id": "5d1aceae-0e4d-3ce0-a836-6a36d0e60545",
                                "text": "Pour faciliter l'utilisation de certains produits et les rendre plus faciles à cuisiner, les industriels ont été amenés à prédécouper, prééplucher ou précuire certains aliments."
                            },
                            {
                                "example_id": "63252f92-7259-4594-8d2c-aa356a7dd732",
                                "sense_id": "5d1aceae-0e4d-3ce0-a836-6a36d0e60545",
                                "text": "Préépluchés, lavés, coupés ou râpés et mis en sachets sous atmosphère contrôlée, ils ont, s’ils sont correctement réfrigérés, une durée de vie de dix jours."
                            },
                            {
                                "example_id": "2e5a0dd5-7084-4124-872c-c03e15da2b46",
                                "sense_id": "5d1aceae-0e4d-3ce0-a836-6a36d0e60545",
                                "text": "Sa particularité : après avoir longtemps produit des légumes pour des entreprises de conserve, Planète Végétal s'est repositionnée depuis 2007 sur le marché du légume frais conditionné, emballé et préépluché."
                            }
                        ]
                    }
