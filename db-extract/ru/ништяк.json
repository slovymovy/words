                                        "entry_id": "71b1fc2a-d6ce-304a-b297-34fbe4c0610b",
                                        "glosses": [
                                            "Endorsement; approval; acceptance; acquiescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3fd28b-6637-4e1f-b409-24fe797ee0c3",
