                    {
                        "translation_id": "1e34dba3-343f-4f3c-a81a-d58ef80b8f5f",
                        "source_entry_id": "c0ebc3f8-2932-3ef2-86ad-4978f4390972",
                        "source_sense_description": "причиняя что-либо (обычно неприятное) в сильной степени",
                        "target_lang_word": "empfindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empfindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "körperlich leicht auf äußere Einflüsse reagierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b9d949-ec74-4f1d-a99c-5986127a662a",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "Er ist gegen hohe Temperaturen sehr empfindlich."
                                            },
                                            {
                                                "example_id": "01b4bbb9-6f9c-493b-be6e-891ce8232679",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Als Blonde reagiere ich sehr empfindlich auf die Sonne. Ich muß mich immer gut mit Sonnencreme einschmieren.“"
                                            },
                                            {
                                                "example_id": "53a2378e-3cd9-4a04-8151-f9661e8fe09c",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            },
                                            {
                                                "example_id": "a898190d-5850-443f-bdd4-214d038c1586",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Dubslav, sonst empfindlich gegen Zug, hatte die Thüren aufmachen lassen, und von dem großen Portal her zog ein erquicklicher Luftstrom bis auf die mit weiß und schwarzen Fliesen gedeckte Veranda hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "leicht, schnell beleidigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1744fa-1663-43d2-b817-bfafaae9faff",
                                                "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                                "text": "Man muss bei ihm sehr aufpassen, was man sagt: Er ist sehr empfindlich."
                                            },
                                            {
                                                "example_id": "5d3a2674-88f0-4e34-9fae-285a5e93c3b8",
                                                "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                                "text": "„Ihr Tod war genauso wenig ein Unfall, wie mein Hintern ein Unfall ist, sagte ich zu Svanhvít und hoffte, dass sie nicht empfindlich war, eine klitzekleine Portion grober Wortwahl zu ertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e558d2f8-ea41-35ac-9223-d3e7ca88d976",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "genau, präzise reagierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed392d5-4ab8-4914-ade0-a458bde8e500",
                                                "sense_id": "e558d2f8-ea41-35ac-9223-d3e7ca88d976",
                                                "text": "Dazu benötigt man ein empfindliches Messgerät."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e30cf20b-b902-3413-93ec-92c3f61da6b1",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "sehr fühlbar, spürbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d312eb8e-27d0-492f-a3fb-4877f75cb223",
                                                "sense_id": "e30cf20b-b902-3413-93ec-92c3f61da6b1",
                                                "text": "Das gibt eine empfindliche Strafe."
                                            },
                                            {
                                                "example_id": "75264bfe-166d-4bac-9e35-511f86bf3f04",
                                                "sense_id": "e30cf20b-b902-3413-93ec-92c3f61da6b1",
                                                "text": "Die Arktis reagiert viel empfindlicher als andere Erdteile auf die globale Erwärmung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
