                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea11f0b5-2df9-3985-b9df-2d07e2cf6426",
                                        "entry_id": "62f3dc57-e99c-315c-bfc6-ca5fed2d1de7",
                                        "glosses": [
                                            "A filthy place."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14d3826d-e7b0-4105-b989-4d338b571acf",
                                                "sense_id": "ea11f0b5-2df9-3985-b9df-2d07e2cf6426",
                                                "text": "You will be less amused when I ask you when you will take your turn cleaning out this shithouse."
                                            },
                                            {
                                                "example_id": "c473a1c5-60a8-4996-9694-d0d85ddd59a0",
                                                "sense_id": "ea11f0b5-2df9-3985-b9df-2d07e2cf6426",
                                                "text": "It immediately caught my attention that the area was a total shithouse. Open C-ration cans, cardboard boxes, discarded socks and underwear, you name it, it was scattered all over the damn place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shithouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae5b7ae-98ae-3c75-8601-efcb515ceee9",
                                        "entry_id": "8f5254af-55dd-3b7e-bb74-2239274bfacc",
                                        "glosses": [
                                            "Of poor quality."
