                    {
                        "form_id": "19557689-416b-4153-bbca-bb805442c11d",
                        "entry_id": "eed930d6-5848-3b55-a5f3-669fa21240b5",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "сты́ривши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e29eb518-3230-3983-8c46-ecb90213b8cc",
                        "entry_id": "eed930d6-5848-3b55-a5f3-669fa21240b5",
                        "glosses": [
                            "жарг. стащить, утащить; украсть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d719dcc4-b962-4431-b61e-a30906335da7",
                                "sense_id": "e29eb518-3230-3983-8c46-ecb90213b8cc",
                                "text": "Наш знакомый немец не боялся стырить со стройки доски для декорации, бронированное стекло ― из местной сберкассы, из дворика банка ― фанеру, пенопласт, пластмассовую трубу, искусственную пальму унести."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01336179-2a28-4dc1-bd6b-e4e52d9233cc",
                        "source_entry_id": "eed930d6-5848-3b55-a5f3-669fa21240b5",
                        "source_sense_id": "e29eb518-3230-3983-8c46-ecb90213b8cc",
                        "target_lang_word": "pinch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4582f4a-75de-3ed1-9a5c-06f00b7f7809",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To squeeze a small amount of a person's skin and flesh, making it hurt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76381e4b-13c4-4de7-b6b9-20da8088f331",
                                                "sense_id": "d4582f4a-75de-3ed1-9a5c-06f00b7f7809",
                                                "text": "The children were scolded for pinching each other."
                                            },
                                            {
                                                "example_id": "d9645205-9bfe-42ad-ab8f-1b5405db4042",
                                                "sense_id": "d4582f4a-75de-3ed1-9a5c-06f00b7f7809",
                                                "text": "This shoe pinches my foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994299ae-ae2e-3022-9808-26a47977e6d3",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To squeeze between the thumb and forefinger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "646a3398-d447-417f-96fa-584f51faf7d4",
                                                "sense_id": "994299ae-ae2e-3022-9808-26a47977e6d3",
                                                "text": "He took the plate in his hand, holding it between thumb and forefinger at one corner, letting it hang down. With the other hand he pinched it at the opposite corner, pressing thumb and forefinger together tightly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2770ef-a9c1-3944-ac54-826766ea91cd",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To squeeze between two objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d9163c6-7b39-4745-b4fe-ba917f1c756d",
                                                "sense_id": "fc2770ef-a9c1-3944-ac54-826766ea91cd",
                                                "text": "Since the resistance of the channel is inversely proportional to its width, the most resistive region is the one pinched between the gates where they come closest to each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32511e70-c4f6-39c0-b2d6-f2b7c27697a2",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "Of clothing, to be uncomfortably tight in specific spots."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d003cb-1ceb-407c-91a9-cf551c98284d",
                                                "sense_id": "32511e70-c4f6-39c0-b2d6-f2b7c27697a2",
                                                "text": "With their jock-straps pinching, they slouch to attention\nWhile queueing for sarnies at the office canteen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b905b0-b171-36fd-bf88-c5abcacfa97b",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To steal, usually something inconsequential."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024fe869-072a-49d0-8a31-71813fe5c509",
                                                "sense_id": "03b905b0-b171-36fd-bf88-c5abcacfa97b",
                                                "text": "Someone has pinched my handkerchief!"
                                            },
                                            {
                                                "example_id": "50f797dc-3f8b-4077-b9ee-2b96118d67e0",
                                                "sense_id": "03b905b0-b171-36fd-bf88-c5abcacfa97b",
                                                "text": "“Hey, blokes,” yelled Dean or perhaps Serge, “let's pinch a boat.”"
                                            },
                                            {
                                                "example_id": "63bc62be-ae55-44a9-97b3-ac63817e3d76",
                                                "sense_id": "03b905b0-b171-36fd-bf88-c5abcacfa97b",
                                                "text": "Then, as the Sunderland fans' cheers bellowed around the stadium, United's title bid was over when it became apparent City had pinched a last-gasp winner to seal their first title in 44 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75c49886-0d4e-328b-a080-a0ad7abc7f5a",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To arrest or capture."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a3ed4ee-3f51-3f1e-a455-d3f7a49138f2",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To cut shoots or buds of a plant in order to shape the plant, or to improve its yield."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22f5dc6e-8612-3129-98d3-ced440dcc1b2",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To sail so close-hauled that the sails begin to flutter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51090784-cd8b-3b2d-8e69-1972a443a4ae",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To take hold; to grip, as a dog does."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61d80381-170a-3735-8a5d-e0e1264d2ef0",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To be stingy or covetous; to live sparingly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82b9d00-c4e3-4eb7-8a33-4be997632d2d",
                                                "sense_id": "61d80381-170a-3735-8a5d-e0e1264d2ef0",
                                                "text": "There was with him none other fare,\nBut for to pinche and for to spare"
                                            },
                                            {
                                                "example_id": "075c2fa8-b0d5-4f8f-9119-c8307a122d08",
                                                "sense_id": "61d80381-170a-3735-8a5d-e0e1264d2ef0",
                                                "text": "1788, Benjamin Franklin (attributed), Paper\nthe wretch whom avarice bids to pinch and spare"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1a745b-7e9b-3693-a688-6b82c36fa3ce",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To seize; to grip; to bite."
                                        ],
                                        "tags": [
                                            "of animals"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5800e31e-4c41-49ea-9ab5-28a6c0c273a6",
                                                "sense_id": "ad1a745b-7e9b-3693-a688-6b82c36fa3ce",
                                                "text": "He [the hound] pinch'd and pull'd her down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a08f022-3d34-388e-82da-7c2128e9165a",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To cramp; to straiten; to oppress; to starve."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31edadf-6161-46e8-a685-3ff3cc05ce78",
                                                "sense_id": "6a08f022-3d34-388e-82da-7c2128e9165a",
                                                "text": "to be pinched for money"
                                            },
                                            {
                                                "example_id": "9662a849-11cb-4983-a59b-590bf28211cd",
                                                "sense_id": "6a08f022-3d34-388e-82da-7c2128e9165a",
                                                "text": "Camillo was his helpe in this, his Pandar:\nThere is a Plot against my Life, my Crowne;\nAll's true that is mistrusted: that false Villaine,\nWhom I employ'd, was pre-employ'd by him:\nHe ha's discouer'd my Designe, and I\nRemaine a pinch'd Thing;"
                                            },
                                            {
                                                "example_id": "82a0cc47-0450-4ed1-a196-2dbdf8ccd3b7",
                                                "sense_id": "6a08f022-3d34-388e-82da-7c2128e9165a",
                                                "text": "want of room […] which pincheth the whole nation"
                                            },
                                            {
                                                "example_id": "f1eb8914-a714-45a5-9434-7ef008cc547d",
                                                "sense_id": "6a08f022-3d34-388e-82da-7c2128e9165a",
                                                "text": "[…]the well-to-do working men did not hope, since they were not pinched and had no means of learning their degraded position[…]"
                                            },
                                            {
                                                "example_id": "30dd7087-19e3-416c-9dcc-f4211fe19db5",
                                                "sense_id": "6a08f022-3d34-388e-82da-7c2128e9165a",
                                                "text": "The Christian also spurns the pinched and mumping sick-room attitude, and the lives of saints are full of a kind of callousness to diseased conditions of body which probably no other human records show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "773417cf-0dc0-300b-9e50-3eba28c6c4d3",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To move, as a railroad car, by prying the wheels with a pinch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0783c213-aba5-34bf-8623-9e2bf816f486",
                                        "entry_id": "73360c64-9bdc-32fc-879b-9bd0406bcf8a",
                                        "glosses": [
                                            "To complain or find fault."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ca5e4e6-a657-4ac9-9177-9fe1d64eedd6",
                                                "sense_id": "0783c213-aba5-34bf-8623-9e2bf816f486",
                                                "text": "Therefore who so them accuse\nOf any double entencion,\nTo speake, rowne, other to muse,\nTo pinch at their condicion,\nAll is but false collusion,\nI dare rightwell the sothe express,\nThey have no better protection,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48100803-7fdb-39c7-9da2-b317a6d4ffd6",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "The action of squeezing a small amount of a person's skin and flesh, making it hurt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67808619-0740-3ff2-a608-8b731e791314",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "A close compression of anything with the fingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee14c7d3-3a1d-459d-9016-5c828317a1b8",
                                                "sense_id": "67808619-0740-3ff2-a608-8b731e791314",
                                                "text": "I gave the leather of the sofa a pinch, gauging the texture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ef3d72-f8fd-3ed8-8f43-e98ecfa942b0",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "A small amount of powder or granules, such that the amount could be held between fingertip and thumb tip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd005b59-3386-40d1-83bb-45c09f0f6512",
                                                "sense_id": "79ef3d72-f8fd-3ed8-8f43-e98ecfa942b0",
                                                "text": "Mix about four cups of white flour with a pinch of salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d882c34-149c-3fb5-84ce-7dfe875d41e5",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "An awkward situation of some kind (especially money or social) which is difficult to escape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b60f54-a1c7-4e32-9ee4-7c5e786be2f6",
                                                "sense_id": "4d882c34-149c-3fb5-84ce-7dfe875d41e5",
                                                "text": "And wel his merits ſhew him to be made\nHis Fortunes maiſter, and the king of men.\nThat could perſwade at ſuch a ſodaine pinch,\nWith reaſons of his valour and his life,\nA thouſand ſworne and ouer-matching foes:"
                                            },
                                            {
                                                "example_id": "d0ef41e0-4e40-407c-bfa5-cf832b10b12c",
                                                "sense_id": "4d882c34-149c-3fb5-84ce-7dfe875d41e5",
                                                "text": "It took nerve and muscle both to carry the body out and down the stairs to the lower hall, but he damn well had to get it out of his place and away from his door, and any of those four could have done it in a pinch, and it sure was a pinch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13174985-26ca-3a98-94ae-35baf9c6970b",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "A metal bar used as a lever for lifting weights, rolling wheels, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09ec7cf1-ce81-3467-b986-ecc29e86cd98",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "An organic herbal smoke additive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ce1042e-3773-37ec-bd76-b1b7de92f8cb",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "A magnetic compression of an electrically conducting filament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1471d270-bee6-3685-9207-0a8d6ec11a10",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "The narrow part connecting the two bulbs of an hourglass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa64e0d5-183c-4b39-b86d-7de81d118a7f",
                                                "sense_id": "1471d270-bee6-3685-9207-0a8d6ec11a10",
                                                "text": "It looked like an hourglass, but all those little glittering shapes tumbling through the pinch were seconds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578ec274-26d6-3f6b-af0f-e4c45b9a78a9",
                                        "entry_id": "5e6c22c6-85d9-377d-a546-4f0b1dc1eb65",
                                        "glosses": [
                                            "An arrest."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
