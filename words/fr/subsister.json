{
    "word_family": [
        "subsistance",
        "subsistant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3ce7661-0b81-3d70-8fb2-4b8a5e5cf8f3",
                    "sense_definition": "Continuer d'exister, perdurer à travers le temps ou malgré des destructions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux vestiges de l'époque romaine <w>subsistent</w> encore au centre de la ville."
                        },
                        {
                            "text": "Quelques doutes <w>subsistent</w> dans mon esprit au sujet de cette étrange décision."
                        }
                    ],
                    "synonyms": [
                        "demeurer",
                        "perdurer",
                        "persister"
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "common_phrases": [
                        "des doutes subsistent",
                        "des vestiges subsistent"
                    ]
                },
                {
                    "sense_id": "df46392c-03fa-31d8-a343-6591d8296099",
                    "sense_definition": "Avoir les ressources indispensables pour se nourrir, vivre et subvenir à ses besoins.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "survie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants de ce petit village isolé pêchent quotidiennement pour <w>subsister</w>."
                        },
                        {
                            "text": "Avec la perte de son emploi, il a trouvé de quoi <w>subsister</w> grâce à des aides."
                        }
                    ],
                    "synonyms": [
                        "survivre"
                    ],
                    "common_phrases": [
                        "de quoi subsister",
                        "pour subsister"
                    ]
                },
                {
                    "sense_id": "8b61ef5f-8e88-31e2-9bfb-a48ebe6efac6",
                    "sense_definition": "Rester en vigueur ou conserver sa valeur, en parlant d'une loi, d'une règle ou d'un accord.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne disposition légale <w>subsiste</w> tant qu'aucun nouveau décret ne l'annule."
                        },
                        {
                            "text": "Malgré les récentes réformes administratives, une règle stricte <w>subsiste</w> toujours."
                        }
                    ],
                    "synonyms": [
                        "demeurer",
                        "persister"
                    ],
                    "common_phrases": [
                        "un accord subsiste"
                    ]
                }
            ]
        }
    ]
