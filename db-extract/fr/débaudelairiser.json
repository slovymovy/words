                "senses": [
                    {
                        "sense_id": "065b5dc0-0b9e-341f-a854-feec78392624",
                        "entry_id": "6c3c4668-0acd-3dad-be0e-b3a343b150d7",
                        "glosses": [
                            "Débarrasser de l’influence de Charles Baudelaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6610b7-881c-40b1-a509-8f9a53a1464f",
                                "sense_id": "065b5dc0-0b9e-341f-a854-feec78392624",
                                "text": "Mais autant l’exploration de l’œuvre du poète américain ne saurait se passer du laser baudelairien, autant, d’une enquête sur sa vie, Edgar Poe doit sortir débaudelairisé."
                            },
                            {
                                "example_id": "99c78401-488a-4d21-8ac8-4c0f83f128f7",
                                "sense_id": "065b5dc0-0b9e-341f-a854-feec78392624",
                                "text": "Cette sévérité qui devait l’aider à se « débaudelairiser » agit sur la première «Hérodiade», dont il espérait faire «un poème digne de Poe et que les siens ne surpasseront pas», et le conduisit à une crise intellectuelle et morale décisive."
                            },
                            {
                                "example_id": "cfee1ae2-ea1e-4ff0-b6dd-2a831232b91e",
                                "sense_id": "065b5dc0-0b9e-341f-a854-feec78392624",
                                "text": "Mallarmé s’est à la fois fortement baudelairisé et « débaudelairisé » (c'est son mot)."
                            }
                        ]
                    }
                ],
