                        "glosses": [
                            "gemaakt van een kalksteen met een meer of minder uitgesproken blauwgrijze kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117ef06e-ea7d-4bba-b69e-6d65322a4592",
                                "sense_id": "0d728b50-51d7-3ec6-b82e-c3ca0d6266cc",
                                "text": "Rustend op een hardstenen plint met de bordestrap in het midden en aan weerszijden een gladde stoepplaat, rees de bakstenen gevel langs regelmatig verdeelde pilasters op naar de geblokte kroonlijst in de hoogte, klassiek met triglyfen en gootklossen."
                            },
                            {
                                "example_id": "dc662e35-835c-4dc3-ad18-e9020f1ae176",
                                "sense_id": "0d728b50-51d7-3ec6-b82e-c3ca0d6266cc",
                                "text": "Het kunstwerk bestaat uit twee iets achter over hellende zwarte hardstenen platen, die schuin ten opzichte van elkaar staan. Daartussen is een doorkijk naar de plaats van het ongeluk. Op de platen staan de namen van de slachtoffers."
                            }
                        ]
