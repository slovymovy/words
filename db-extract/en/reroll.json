                                "sense_id": "a208036a-3dbd-35b9-a58c-3960ce140f26",
                                "text": "You can reroll if you don't like your character's initial stats."
                            },
                            {
                                "example_id": "953ddc2d-ad8b-4caa-9cb7-7d7ad26aa716",
                                "sense_id": "a208036a-3dbd-35b9-a58c-3960ce140f26",
                                "text": "[T]he others worked preparing breakfast and re-rolling swags."
                            }
                        ]
                    },
                    {
