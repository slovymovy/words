                        ]
                    },
                    {
                        "sense_id": "0d72a2ce-9d9c-370b-a407-bcd16ed7461d",
                        "entry_id": "033d1c67-06d4-3fb8-bd39-7c99fd73e0a3",
                        "glosses": [
                            "iemand die zich roekeloos gedraagt, vrijbuiter"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4f47f54d-18b2-4dd3-b754-aa6791acbd84",
                                "sense_id": "0d72a2ce-9d9c-370b-a407-bcd16ed7461d",
                                "text": "Dat kun je toch verwachten van dat stelletje cowboys?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d855d67-c5fc-3e80-843d-228121ec9329",
