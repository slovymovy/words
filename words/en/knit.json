                            },
                            {
                                "target_lang_word": "凝聚",
                                "target_lang_sense_clarification": "使聚集在一起"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "unir",
                                "target_lang_sense_clarification": "juntar personas o cosas"
                            },
                            {
                                "target_lang_word": "vincular",
                                "target_lang_sense_clarification": "establecer una conexión estrecha"
                            },
                            {
                                "target_lang_word": "estrechar lazos",
                                "target_lang_sense_clarification": "hacer más fuerte una relación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc744fa7-6f45-30d3-a6ad-c192128a7107",
                    "sense_definition": "To grow back together and heal, especially referring to a broken bone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "heal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said that the broken bone would <w>knit</w> in about six weeks.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что сломанная кость <w>срастется</w> примерно через шесть недель.",
                                "zh": "医生说骨折大约六周后就会<w>愈合</w>。",
                                "es": "El médico dijo que el hueso roto se <w>soldaría</w> en unas seis semanas."
                            }
                        },
                        {
                            "text": "It takes time for a serious fracture to <w>knit</w> completely.",
                            "target_lang_translations": {
                                "ru": "Требуется время, чтобы серьезный перелом полностью <w>сросся</w>.",
                                "zh": "严重的骨折需要时间才能完全<w>长好</w>。",
                                "es": "Lleva tiempo que una fractura grave se <w>suelde</w> por completo."
                            }
                        }
                    ],
                    "synonyms": [
                        "heal",
                        "mend",
                        "fuse"
                    ],
                    "antonyms": [
                        "break",
                        "fracture"
                    ],
                    "common_phrases": [
                        "bones knit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Срастаться и заживать, особенно говоря о сломанной кости.",
                        "zh": "指断裂的骨头重新长在一起并愈合。",
                        "es": "Volver a unirse y sanar, especialmente referido a un hueso roto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срастаться",
                                "target_lang_sense_clarification": "о костях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愈合",
                                "target_lang_sense_clarification": "伤口或骨折处长好"
                            },
                            {
                                "target_lang_word": "长好",
                                "target_lang_sense_clarification": "骨头恢复原状"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "soldar",
                                "target_lang_sense_clarification": "referido a la unión de huesos fracturados"
                            },
                            {
                                "target_lang_word": "consolidar",
                                "target_lang_sense_clarification": "término médico para la unión de una fractura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "460b9dbc-9c82-3f1d-a238-348f27c9f74a",
                    "sense_definition": "To tighten the eyebrows to show concentration, worry, or anger.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>knitted</w> his brows as he tried to solve the difficult puzzle.",
                            "target_lang_translations": {
                                "ru": "Он <w>нахмурил</w> брови, пытаясь решить сложную головоломку.",
                                "zh": "他在试图解开那道难题时<w>皱</w>起了眉头。",
                                "es": "Él <w>frunció</w> el ceño mientras intentaba resolver el difícil rompecabezas."
                            }
                        },
                        {
                            "text": "She <w>knitted</w> her forehead in deep thought while reading the letter.",
                            "target_lang_translations": {
                                "ru": "Она <w>наморщила</w> лоб в глубокой задумчивости, читая письмо.",
                                "zh": "她读信时陷入沉思，<w>蹙</w>起了额头。",
                                "es": "Ella <w>frunció</w> la frente en profunda reflexión mientras leía la carta."
                            }
                        }
                    ],
                    "synonyms": [
                        "furrow",
                        "frown",
                        "wrinkle"
                    ],
                    "antonyms": [
                        "smooth",
                        "relax"
                    ],
                    "common_phrases": [
                        "knit one's brows",
                        "knit one's forehead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдвигать брови, выражая сосредоточенность, беспокойство или гнев.",
                        "zh": "收紧眉毛以表示专注、担忧或愤怒。",
                        "es": "Fruncir las cejas para mostrar concentración, preocupación o enojo."
                    },
                    "translations": {
