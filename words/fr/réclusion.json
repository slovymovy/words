                    "frequency": "Middle",
                    "semantic_group_id": "peine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a été condamné à vingt ans de <w>réclusion</w> criminelle pour ses actes."
                        },
                        {
                            "text": "Le juge a finalement décidé d'une peine de <w>réclusion</w> à perpétuité."
                        }
                    ],
