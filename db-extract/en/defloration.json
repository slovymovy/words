                        "translation_id": "b3de07b8-f891-4d1a-8de7-11d400637201",
                        "source_entry_id": "0d0b7ead-d2a2-3e4c-8375-8615687aeb67",
                        "source_sense_id": "4bd5eaf3-abeb-3167-8e87-5a898f0c7c71",
