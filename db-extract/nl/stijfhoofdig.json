                "senses": [
                    {
                        "sense_id": "db23c875-898b-3781-9909-2fa043f9b135",
                        "entry_id": "d6e5ecd7-bd69-335c-b2ef-14123d8565ed",
                        "glosses": [
                            "van een persoon dat deze niet bereid is zijn mening te herzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56939d7d-ec0f-4d58-a876-466b4aa78cff",
                                "sense_id": "db23c875-898b-3781-9909-2fa043f9b135",
                                "text": "De Franstalige liberalen blijven vreemd stil, vooral als je bedenkt dat de gepasseerde burgemeester Damien Thiéry uit hun rangen komt, sterker, dat hij een paar jaar geleden voor hen heeft gekozen omdat hij het FDF te stijfhoofdig vond."
                            },
                            {
                                "example_id": "55bd28e2-176f-4a3a-be91-e5edfdffe591",
                                "sense_id": "db23c875-898b-3781-9909-2fa043f9b135",
                                "text": "Decadance, een icoon van het (Gentse) nachtleven, moest koste wat het kost dicht. Op bevel van de burgemeester, en aan de hand van een dossier dat juridisch met zo’n haken en ogen aan elkaar hing én waarin de stad zich zo stijfhoofdig opstelde dat de Raad van State gisteren geen andere keuze had dan het in de prullenband te kegelen."
                            }
                        ]
                    }
                ],
                "translations": [
