                                            {
                                                "example_id": "c1a60206-90b3-43b0-8e54-05bcb4caf893",
                                                "sense_id": "ee76cb2e-f906-37e4-bd4c-26e363a444f0",
                                                "text": "His incessant coughing made his voice sound raspy."
                                            },
                                            {
                                                "example_id": "5cce0423-a8c1-44a8-b89e-174d38ce86b4",
                                                "sense_id": "ee76cb2e-f906-37e4-bd4c-26e363a444f0",
                                                "text": "“This,” [Ambassador Robert Lighthizer] stressed in his raspy voice, “is the key economic policy battle of patriotic Americans in the upcoming generation.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c07b812-9ee3-30c8-a8e6-ecab6af74ed4",
                                        "entry_id": "7a997c47-2a03-3b2e-b940-441360e4e89e",
                                        "glosses": [
                                            "Irritable."
                                        ],
