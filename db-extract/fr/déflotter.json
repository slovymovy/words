                "senses": [
                    {
                        "sense_id": "f225e49b-18a1-35d5-83c2-09d6fe6c05d5",
                        "entry_id": "9f4d1922-a0fd-3bf0-9697-4be91b7c1903",
                        "glosses": [
                            "Faire sortir de l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dbfcfc2-d7e9-43f4-a180-1b454177c791",
                                "sense_id": "f225e49b-18a1-35d5-83c2-09d6fe6c05d5",
                                "text": "Il a fallu « déflotter » les morceaux de la carlingue par une météo exécrable et sous une pression médiatique formidable."
                            },
                            {
                                "example_id": "8ad083ec-fd59-4380-81ca-e41771804163",
                                "sense_id": "f225e49b-18a1-35d5-83c2-09d6fe6c05d5",
                                "text": "Le citoyen Nicolas Edmond, marinier, étant occupé à déflotter les deux trains de Preuilly, a perdu dans la débâcle des glaces deux crocs et une cognée de charpentier."
                            }
                        ]
                    }
