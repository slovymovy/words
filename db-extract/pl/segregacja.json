                        "sense_id": "823804f5-579c-32f9-a3c4-f44150021469",
                        "entry_id": "4e8eaa82-c75c-3ada-b572-9a0449f55fb8",
                        "glosses": [
                            "nierównomierność rozkładu składników stopowych w metalu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4d2de9a-e5f9-4e56-91eb-c41a1d462915",
                        "source_entry_id": "4e8eaa82-c75c-3ada-b572-9a0449f55fb8",
