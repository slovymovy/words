    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dd42bbd-87e4-388c-a210-5da53fc7c2ee",
                    "sense_definition": "wypuszczać strumień powietrza z ust w określonym kierunku",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przepływ powietrza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek długo <w>dmuchał</w> na gorący obiad, aby szybciej ostygł.",
                            "target_lang_translations": {
                                "ru": "Марек долго <w>дул</w> на горячий обед, чтобы тот быстрее остыл."
                            }
                        },
                        {
                            "text": "Dziecko z radością <w>dmucha</w> na świeczki na torcie urodzinowym.",
                            "target_lang_translations": {
                                "ru": "Ребёнок с радостью <w>дует</w> на свечки на праздничном торте."
                            }
                        }
                    ],
                    "synonyms": [
                        "dąć"
                    ],
                    "common_phrases": [
                        "dmuchać na zimne",
                        "dmuchać na świeczki"
                    ],
                    "target_lang_definitions": {
                        "ru": "выпускать струю воздуха изо рта в определенном направлении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуть",
                                "target_lang_sense_clarification": "ртом, направляя струю воздуха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "269a33fc-86ec-3322-905d-fe12b9f5bd1f",
                    "sense_definition": "o wietrze lub urządzeniu: wiać, wywoływać silny ruch powietrza",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przepływ powietrza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysoko w górach zimny wiatr <w>dmuchał</w> turystom prosto w twarz.",
                            "target_lang_translations": {
                                "ru": "Высоко в горах холодный ветер <w>дул</w> туристам прямо в лицо."
                            }
                        },
                        {
                            "text": "Ten stary wentylator bardzo głośno pracuje i słabo <w>dmucha</w>.",
                            "target_lang_translations": {
                                "ru": "Этот старый вентилятор очень шумно работает и слабо <w>дует</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dąć"
                    ],
                    "common_phrases": [
                        "wiatr dmucha w twarz"
                    ],
                    "target_lang_definitions": {
                        "ru": "о ветре или устройстве: дуть, вызывать движение воздуха"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуть",
                                "target_lang_sense_clarification": "о ветре или вентиляторе"
                            },
                            {
                                "target_lang_word": "веять",
                                "target_lang_sense_clarification": "слегка обдувать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f789a1dd-16b4-37c1-871f-8af91251f2e8",
                    "sense_definition": "odbywać stosunek seksualny",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "seks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyźni przy barze wulgarnie opowiadali o tym, kogo ostatnio <w>dmuchali</w>.",
                            "target_lang_translations": {
                                "ru": "Мужчины у бара вульгарно рассказывали о том, кого недавно <w>трахали</w>."
                            }
                        },
                        {
                            "text": "W takich filmach bohaterowie tylko piją alkohol i bez przerwy kogoś <w>dmuchają</w>.",
                            "target_lang_translations": {
                                "ru": "В таких фильмах герои только пьют алкоголь и без перерыва кого-то <w>трахают</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dymać",
                        "ruchać"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "wulgarne określenie stosunku seksualnego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вступать в половую связь (грубое, вульгарное выражение)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трахать",
                                "target_lang_sense_clarification": "груб., совершать половой акт"
                            },
                            {
                                "target_lang_word": "драть",
                                "target_lang_sense_clarification": "вульг., иметь половую связь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
