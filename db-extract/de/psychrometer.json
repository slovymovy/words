                "senses": [
                    {
                        "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                        "entry_id": "f0c979f4-3232-3d5c-84d0-a87a632de7e2",
                        "glosses": [
                            "Instrument zur Bestimmung der Luftfeuchtigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ff76ec-e7db-4513-a8ea-5c4a144c1609",
                                "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                "text": "„Schließlich kann die Luftfeuchte noch durch Messung mit dem Psychrometer ermittelt werden.“"
                            },
                            {
                                "example_id": "c77bfab9-fd84-4c6c-b915-612ef4e4bfbc",
                                "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                "text": "„Bei dem Psychrometer nach Aßmann strömt die zu messende Luft mit einer definierten Geschwindigkeit an zwei Thermometern vorbei.“"
                            },
                            {
                                "example_id": "3e8c554b-fd43-40e6-9fe2-7a738aa9cbb6",
                                "sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                                "text": "„Gleichzeitig wurden mehrere Observationen mit dem Psychrometer der nahe gelegenen meteorologischen Station vorgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34ef9af4-3312-4ab7-a493-aeb6a292c7bb",
                        "source_entry_id": "f0c979f4-3232-3d5c-84d0-a87a632de7e2",
                        "source_sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                        "source_sense_description": "Meteorologie: Instrument zur Bestimmung der Luftfeuchtigkeit",
                        "target_lang_word": "psychrometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychrometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34c6c700-8da3-3ac6-bf0c-b30ac01c0732",
                                        "entry_id": "5f51b58e-3343-3e9c-ad28-e629f6a5001c",
                                        "glosses": [
                                            "Any of several instruments used to measure the relative humidity of the atmosphere; especially a wet-and-dry-bulb hygrometer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd9d84ad-85d3-47b1-85c5-28672be77e8b",
                                                "sense_id": "34c6c700-8da3-3ac6-bf0c-b30ac01c0732",
                                                "text": "1982 July, Ray W. Brown, Dale L. Bartos, A Calibration Model for Screen-caged Peltier Thermocouple Psychrometers, United States Department of Agriculture: Forest Service, Research Paper INT-293, page 2,\nGross adjustment of the model using a small number of well controlled calibration measurements would suffice to make the model applicable to any new psychrometer or group of psychrometers."
                                            },
                                            {
                                                "example_id": "e943dbe1-d353-4252-bd1e-4dc162b3dab3",
                                                "sense_id": "34c6c700-8da3-3ac6-bf0c-b30ac01c0732",
                                                "text": "2007, N. J. Livingston, G. Clarke Topp, 71: Soil Water Potential, M. R. Carter, E. G. Gregorich (editors), Soil Sampling and Methods of Analysis, 2nd Edition, Canadian Society of Soil Science, Taylor & Francis (CRC Press), page 976,\nPsychrometers have two main components: the porous cup with its contained sensing and reference junctions and the instrument for generating the electrical current and measuring the psychrometer output."
                                            },
                                            {
                                                "example_id": "68f7cab5-16e7-4284-a4c1-87258772d148",
                                                "sense_id": "34c6c700-8da3-3ac6-bf0c-b30ac01c0732",
                                                "text": "2008, Ross Montgomery, Robert McDowall, Fundamentals of HVAC Control Systems, American Society of Heating, Refrigerating and Air-Conditioning Engineers, Elsevier, page 132,\nAn aspirated psychrometer combines low cost with the fundamental measurement principle of wet- and dry-bulb readings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71008673-26ec-40e8-b4ad-cfc084525dbc",
                        "source_entry_id": "f0c979f4-3232-3d5c-84d0-a87a632de7e2",
                        "source_sense_id": "88348c0d-75c2-39da-bd4b-5d587e804d6b",
                        "source_sense_description": "Meteorologie: Instrument zur Bestimmung der Luftfeuchtigkeit",
                        "target_lang_word": "psychromètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40f35c90-6c1c-3909-a02d-7bbb58706e98",
                                        "entry_id": "92d58ee1-cb3c-32b6-9661-1a856ef8c8ed",
                                        "glosses": [
                                            "Instrument de mesure composé de deux thermomètres, l’un sec et l’autre humide, et qui sert à mesurer le taux d’humidité de l’air. Le thermomètre humide subit l’évaporation de son eau, ce qui lui emprunte une partie de sa chaleur; la différence des températures est alors convertie en une mesure hygrométrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60cd78bb-885c-4fc3-995f-9ce7f0073b22",
                                                "sense_id": "40f35c90-6c1c-3909-a02d-7bbb58706e98",
                                                "text": "Le psychromètre est un appareil qui permet de repérer en même temps la température de bulbe sec et de bulbe humide de l’air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
