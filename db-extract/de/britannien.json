                                        "entry_id": "2e0a45aa-32d2-3d17-88f7-177e2d5fb88f",
                                        "glosses": [
                                            "The British Empire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "535db8e6-e17a-45f1-8f56-435935fa9593",
                                                "sense_id": "821598ae-08a8-37fa-b47b-907b05d2d1b2",
                                                "text": "The name of 'Britain' […] ought to answer every purpose, or if that be thought too condensed, it may be pluralized into ‘The Britains’."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Britain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e562a50b-0b06-3ac7-b45d-f41696b7cc0c",
                                        "entry_id": "6374d3f4-c1d5-334d-92a8-6c105b9d6128",
                                        "glosses": [
                                            "An ancient Briton."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba85daf-750b-4cbe-816d-1a1fda355fa5",
                                                "sense_id": "e562a50b-0b06-3ac7-b45d-f41696b7cc0c",
                                                "text": "The Britains’ struggles with the Scots and Picts [...] led to the Britains asking the Romans for help in constructing a great wall."
                                            }
