                        "examples": [
                            {
                                "example_id": "122cb9c5-3a67-452e-b4d6-26409fd8c34e",
                                "sense_id": "ab1e6f90-98c0-33fa-a3c7-11b81e55952a",
                                "text": "Een in de wereld unieke samenwerking tussen vier rijksinstellingen, die samen een half miljoen zeer uiteenlopende objecten op één plek gaan bewaren: dat is het CollectieCentrum Nederland."
                            },
                            {
                                "example_id": "61c04862-a02b-4420-ab59-0c6b9e627423",
                                "sense_id": "ab1e6f90-98c0-33fa-a3c7-11b81e55952a",
                                "text": "Een hele operatie, waar al sinds 2011 aan wordt gewerkt. \"Voor ons is het heel fijn dat alles nu is samengekomen in het CollectieCentrum Nederland\", zegt Michel van Maarseveen, directeur van Paleis Het Loo."
                            }
                        ]
                    }
