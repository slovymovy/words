                        "sense_id": "209c79c1-bec8-3115-be36-295d2cc117a4",
                        "entry_id": "dba9ce21-7c74-3fa3-9a5a-3fbf99d35500",
                        "glosses": [
                            "„Absatz, neue Zeile“"
                        ],
                        "tags": [
                            "Typographie"
                        ],
                        "examples": [
                            {
                                "example_id": "05c0c6e0-eb9f-4922-b1bb-9fc21c57065c",
                                "sense_id": "209c79c1-bec8-3115-be36-295d2cc117a4",
                                "text": "Wenn ich Alinea sage, meine ich einen Umbruch in eine neue Zeile, nicht einen neuen Absatz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c234cd87-feed-36b6-9990-eed4ab5f076a",
                        "entry_id": "dba9ce21-7c74-3fa3-9a5a-3fbf99d35500",
                        "glosses": [
