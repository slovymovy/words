                ],
                "senses": [
                    {
                        "sense_id": "563d1abd-5ba2-3e6e-8ceb-49747d6c635c",
                        "entry_id": "57c5f1c6-e166-3158-aa72-e002540daffc",
                        "glosses": [
                            "Stufe aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14184899-1cff-4ad1-84e2-035bf66b3b00",
                                "sense_id": "563d1abd-5ba2-3e6e-8ceb-49747d6c635c",
                                "text": "„Er stieg die Marmorstufen hinauf, passierte den alten Säulengang und ging durch die Empfangshalle zu einem Tisch.“"
                            },
                            {
                                "example_id": "36af2312-8eaa-4ea9-b950-de110421e9df",
                                "sense_id": "563d1abd-5ba2-3e6e-8ceb-49747d6c635c",
                                "text": "„Der junge Mann presste die Hände vors Gesicht und sprang dann mit einer unbeschreiblichen Geste die Marmorstufen hinauf, die Bronzetür schloss sich hinter ihm, und eine halbe Stunde später schlenderten die Bummler von dannen, und die verängstigte Taube kehrte zu ihrem Platz in den Armen des Schicksals zurück.“"
                            },
                            {
                                "example_id": "0cac14ba-488e-45fe-b8ca-112cae9fb5eb",
                                "sense_id": "563d1abd-5ba2-3e6e-8ceb-49747d6c635c",
                                "text": "„Stolz stieg er die Marmorstufen hinauf, während die Araber den Atem anhielten und sich langsam zum Ausgang zurückzogen.“"
                            },
                            {
                                "example_id": "334c8ea0-38f7-48e4-b618-6b4170326d58",
                                "sense_id": "563d1abd-5ba2-3e6e-8ceb-49747d6c635c",
                                "text": "„Zehn Minuten später verlasse ich das Gebäude durch das Hauptportal und steige die schmalen Marmorstufen hinunter, gehe vorbei an Grüppchen bibbernder Touristen, die darauf warten, einen Blick in den Tempel unseres nationalen Orakels werfen zu dürfen.“"
                            },
                            {
                                "example_id": "f495d63e-d5bd-462a-b868-f65d9af10be6",
                                "sense_id": "563d1abd-5ba2-3e6e-8ceb-49747d6c635c",
                                "text": "„Der lächerliche Wasserfall weißer Marmorstufen vor dem Gebäude dient ihr nur als weitere Rampe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
