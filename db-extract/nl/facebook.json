                        ],
                        "form": "Facebooks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b4c81a8-16cd-38fa-8885-7caa7c7cd0a5",
                        "entry_id": "be632de5-ef1f-351c-9637-2e8abb66d767",
                        "glosses": [
                            "wereldwijd veel gebruikte netwerksite voor het onderhouden van sociale contacten"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "654767a1-8936-4b61-8aa6-3bcc5292551c",
                                "sense_id": "0b4c81a8-16cd-38fa-8885-7caa7c7cd0a5",
                                "text": "Waar er eerst gefocust werd om bezoekers binnen te halen via Google, wordt er nu steeds meer op Facebook gericht."
                            },
                            {
                                "example_id": "39da1ee0-008b-4327-b895-aff9f69c5bb8",
                                "sense_id": "0b4c81a8-16cd-38fa-8885-7caa7c7cd0a5",
                                "text": "Binnen een uur had ik de Gofundme-website opgezet en vroeg ik mijn vrienden thuis via Facebook om wat geld te doneren."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6f99cef-d88d-3290-b334-3f5a7eefbde3",
                        "entry_id": "be632de5-ef1f-351c-9637-2e8abb66d767",
                        "glosses": [
                            "naam van het bedrijf dat onder meer de gelijknamige website exploiteert"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d573dab0-e00b-4a7a-9188-ab05f4af8bc6",
                                "sense_id": "f6f99cef-d88d-3290-b334-3f5a7eefbde3",
                                "text": "Facebook beloofde bij de overname de gebruikersgegevens van de twee diensten niet aan elkaar te koppelen, maar deed dat vorig jaar toch."
                            },
                            {
                                "example_id": "ddbce234-f79b-461f-87f3-7170258d56a8",
                                "sense_id": "f6f99cef-d88d-3290-b334-3f5a7eefbde3",
                                "text": "Facebook heeft een databedrijf geschorst voor het misbruiken van naar verluidt miljoenen gebruikersgegevens. Het bedrijf zou een belangrijke rol hebben gespeeld bij de Amerikaanse presidentsverkiezingen en de Brexit.\nHet bedrijf stelde op basis van Facebook-data veel nauwkeurigere gebruikersprofielen op en bewaarde die veel langer dan is toegestaan.\nVolgens klokkenluiders heeft het bedrijf de gebruikersdata van ruim 50 miljoen Facebook-profielen zonder hun toestemming en medeweten gekopieerd. Dat is één van de grootste datalekken in de geschiedenis van Facebook."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "484603d9-2dd4-41f1-a6a8-248c7fc172d3",
                        "source_entry_id": "be632de5-ef1f-351c-9637-2e8abb66d767",
                        "source_sense_id": "0b4c81a8-16cd-38fa-8885-7caa7c7cd0a5",
                        "source_sense_description": "wereldwijd veel gebruikte netwerksite voor sociale contacten",
                        "target_lang_word": "Facebook",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Facebook",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                        "entry_id": "dc005cb8-9297-37ce-becb-bdfaf7a3ddfe",
                                        "glosses": [
                                            "soziales Netzwerk, das für Kommunikation und die Darstellung der eigenen Person benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0276ca-3a67-4368-82f5-c2df510b06df",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "Sie hat sich bei Facebook angemeldet."
                                            },
                                            {
                                                "example_id": "0e89351c-67a3-4d71-89f5-9c7ca67b06d9",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "Er hat ein Urlaubsfoto auf Facebook gepostet."
                                            },
                                            {
                                                "example_id": "93ec425c-89c0-4938-aa8c-db075e086c16",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "Sie hat mir bei Facebook geschrieben, dass sie krank sei."
                                            },
                                            {
                                                "example_id": "5dcc5912-2f04-4807-81f0-92b601aa60fa",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "„Auf Facebook trudeln Nachrichten in meinem Postfach ein.“"
                                            },
                                            {
                                                "example_id": "f0559756-a4c3-4b55-990f-79195c4bc212",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "„Gleich nach unserer Ankunft hat Facebook mir die Tochter meiner Cousine Litsa als Freundin vorgeschlagen […].“"
                                            },
                                            {
                                                "example_id": "f4a91c7a-53ed-4f26-9d85-d54e0a2e8caf",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "„Deswegen hatte ihr Herz bei seiner Freundschaftsanfrage auf Facebook einen Sprung gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a9d0836-ce93-44d6-9151-9185d7d3367b",
                        "source_entry_id": "be632de5-ef1f-351c-9637-2e8abb66d767",
