                "senses": [
                    {
                        "sense_id": "0975bd80-cb41-32d5-ae90-bfe0dc62bcac",
                        "entry_id": "d00bf3be-9e41-3d7c-b7a0-044beb90faf0",
                        "glosses": [
                            "степень изношенности инструмента, механизма."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b2942ae0-c277-3de3-8dde-79dc476ff3a0",
                        "entry_id": "d00bf3be-9e41-3d7c-b7a0-044beb90faf0",
                        "glosses": [
                            "согласованность, согласие в работе."
                        ],
                        "tags": [],
