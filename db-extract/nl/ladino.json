                    {
                        "translation_id": "2ad826e8-6f66-46c3-8460-f58f12e4c28f",
                        "source_entry_id": "50646522-8bc5-35dc-8f2f-6636cd7bc5f8",
                        "source_sense_id": "040e23eb-2cb1-3693-a9af-6158478703c2",
