                "senses": [
                    {
                        "sense_id": "c4cf87b4-3f07-396d-9c85-d8cfbe4216a5",
                        "entry_id": "d26fff45-2cdd-3a76-8a7d-94507f89fa04",
                        "glosses": [
                            "Abstimmung aller wahlberechtigten Bürger über ein wichtiges politisches Thema"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2206b1f0-8ba7-4946-9c0f-7e847367e0c5",
                                "sense_id": "c4cf87b4-3f07-396d-9c85-d8cfbe4216a5",
                                "text": "„Die Grünen rechnen mit weit höheren Baukosten für Stuttgart 21 und wollen das Vorhaben mit einer Volksabstimmung zu Fall bringen.“"
                            },
                            {
                                "example_id": "dcb92f27-b642-445e-8c37-a6bc603cbb5c",
                                "sense_id": "c4cf87b4-3f07-396d-9c85-d8cfbe4216a5",
                                "text": "„1830 spaltete Venezuela sich nach Volksabstimmungen von Großkolumbien ab.“"
                            },
                            {
                                "example_id": "90debb28-e763-4d0a-b890-6bb3d252128e",
                                "sense_id": "c4cf87b4-3f07-396d-9c85-d8cfbe4216a5",
                                "text": "„Im März 1921 votierten in der Volksabstimmung in Oberschlesien 59,6% der Wähler der Gemeinde Zabrze für den Verbleib bei Deutschland, während 40,4% der Bewohner ihre Zukunft in Polen sahen.“"
                            },
                            {
                                "example_id": "3e943cc8-329d-4fa7-8fe0-bc14b80b91b9",
                                "sense_id": "c4cf87b4-3f07-396d-9c85-d8cfbe4216a5",
                                "text": "„Die Volksabstimmung wurde mit nur einer Woche Vorlauf angesetzt.“"
                            },
                            {
                                "example_id": "4496fc44-2af8-44e2-aa38-76b9a20c9f80",
                                "sense_id": "c4cf87b4-3f07-396d-9c85-d8cfbe4216a5",
                                "text": "„Die Ablehnung der EU-Verfassung bei Volksabstimmungen in Frankreich und den Niederlanden zeigte, dass nur eine Minderheit eine weitere Vertiefung der EU bzw. deren Weiterentwicklung von einem Staatenbund hin zu einem Bundesstaat wünschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
