                "senses": [
                    {
                        "sense_id": "a22573a0-7c4a-3d12-add6-e82c0a0377f0",
                        "entry_id": "8dd1df3a-014e-3303-b498-cb97610bc816",
                        "glosses": [
                            "Nichtannahme oder Nichtstattgabe eines Anliegens oder Antrages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "110339e7-a141-408f-9f4e-3f8de2b1c80f",
                                "sense_id": "a22573a0-7c4a-3d12-add6-e82c0a0377f0",
                                "text": "Noch immer auf seinen Knien hockend, inmitten der verstreuten Rosen, kämpfte er verdattert mit der Abweisung seines Heiratsantrages."
                            },
                            {
                                "example_id": "11304b81-72cb-40c1-95dd-33b86a2faf17",
                                "sense_id": "a22573a0-7c4a-3d12-add6-e82c0a0377f0",
                                "text": "Das Landgericht hat die Klage, soweit sie auf urheberrechtliche Ansprüche gestützt ist, als unbegründet und [teilweise] unzulässig abgewiesen. […] das Oberlandesgericht [hat] der Klage […] stattgegeben und die weitergehende Berufung zurückgewiesen. Hiergegen richten sich die Revision der Beklagten, die damit ihren Antrag auf Abweisung der Klage weiterverfolgt, sowie die Anschlußrevision des klagenden Landes, das sich gegen die Teilabweisung der Klage wendet. Die Parteien beantragen jeweils, das Rechtsmittel der Gegenseite zurückzuweisen."
                            },
                            {
                                "example_id": "eb2249ec-215b-4413-971c-aaa8dca75611",
                                "sense_id": "a22573a0-7c4a-3d12-add6-e82c0a0377f0",
                                "text": "„Gegenüber dieser Abweisung schwieg Bai Lai-gwang, blieb aber sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
