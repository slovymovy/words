                        "examples": [
                            {
                                "example_id": "84e1f977-d490-48b2-ab49-37ca6a9d253c",
                                "sense_id": "17275489-ccf6-35b9-b4d1-0c3bf8ec8c06",
                                "text": "„28 Prozent der Kitaleiter in Bremen bleibt gar keine Zeit für Leitungsaufgaben, in Sachsen-Anhalt und Thüringen ist es nur ein Prozent.“"
                            },
                            {
                                "example_id": "1772ab87-a439-4bb0-824c-12d23c9d0c70",
                                "sense_id": "17275489-ccf6-35b9-b4d1-0c3bf8ec8c06",
                                "text": "„Die meisten Kitaleiter litten zudem unter mangelnder Wertschätzung und schlechter Bezahlung ihrer Arbeit sowie unter zunehmender Bürokratie.“"
                            }
                        ],
