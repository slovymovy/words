                        "glosses": [
                            "Artist, der ein Schwert durch seinen Mund in die Speiseröhre einführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929056bd-90d9-4fc7-9c8f-25e2b22991bd",
                                "sense_id": "c14b1610-78ac-3791-8dfd-531d02541365",
                                "text": "Ihr Sohn war vom Schwertschlucker begeistert, den sie im Zirkus gesehen hatten."
                            },
                            {
                                "example_id": "0850fc00-0e30-4756-8021-c14b4a2f783e",
                                "sense_id": "c14b1610-78ac-3791-8dfd-531d02541365",
                                "text": "„Auf die Schlangendame folgt eine leere Nische für den Glasfresser, der gleichzeitig auch Schwertschlucker war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
