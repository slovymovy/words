                        "entry_id": "3c86a253-6295-3b42-9fe2-2d6afb590d71",
                        "glosses": [
                            "Qui est couvert de nuages petits et arrondis, en parlant du ciel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d517ad-4c6d-474b-970e-a0179f051f68",
                                "sense_id": "83317e90-59c2-325f-9a48-276da201632a",
                                "text": "Un ciel pommelé."
                            },
                            {
                                "example_id": "510b6281-b341-4c89-abbb-c92efd5251e6",
                                "sense_id": "83317e90-59c2-325f-9a48-276da201632a",
                                "text": "La colline fume de pruniers blancs, chacun d’eux immatériel et pommelé comme une nue ronde."
                            },
                            {
                                "example_id": "494a8bd9-dd03-40ad-a87f-23cb1e1cec2f",
                                "sense_id": "83317e90-59c2-325f-9a48-276da201632a",
                                "text": "[…] un vert gazon soigneusement entretenu, qui contrastait avec le blanc du marbre, le bleu pommelé du ciel et le noir des cèdres […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0468e887-9660-342c-9ec0-bce8f92af87f",
                        "entry_id": "3c86a253-6295-3b42-9fe2-2d6afb590d71",
                        "glosses": [
                            "Dont la robe est couverte de taches arrondies, en parlant d'un cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d24349a-bbb4-4706-81b1-d76889c0773b",
                                "sense_id": "0468e887-9660-342c-9ec0-bce8f92af87f",
                                "text": "Kobus, après avoir passé son inspection, choisit deux vigoureux roussins gris pommelés."
                            },
                            {
                                "example_id": "0d20198e-4e73-4082-8dcd-551a9bc8ea10",
                                "sense_id": "0468e887-9660-342c-9ec0-bce8f92af87f",
                                "text": "Un cheval gris pommelé."
                            }
                        ]
                    }
