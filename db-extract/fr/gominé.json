                ],
                "senses": [
                    {
                        "sense_id": "4c33aea1-2819-3649-9267-c406a40fc1f3",
                        "entry_id": "6fadaff8-afd4-334b-91af-8f47ab4ab652",
                        "glosses": [
                            "Qui est imprégné de gomina."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ee3b44-e2e1-4c4b-8f68-8b4d8f0e6d23",
                                "sense_id": "4c33aea1-2819-3649-9267-c406a40fc1f3",
                                "text": "7 octobre 1940 – Le quartier Latin se repeuple de crétins, cheveux gominés, vestes à soufflet, qui fredonnent : I want to say Boo, Mama…"
                            },
                            {
                                "example_id": "ff81a999-4f9d-4870-a53a-f5036f7f55f4",
                                "sense_id": "4c33aea1-2819-3649-9267-c406a40fc1f3",
                                "text": "Opaque et gominé, le faciès de Buck revient vers moi jusqu’à m’aveugler, comme les yeux bleu-vert des gros phares biseautés du train de la Southern & Allegheny Railways, celui qui m’a déposé là-bas, la première fois."
                            },
                            {
                                "example_id": "e85891b3-bab7-4b77-a199-0177dda0cc5d",
                                "sense_id": "4c33aea1-2819-3649-9267-c406a40fc1f3",
                                "text": "Avec leurs uniformes de chasseurs griffés Ralph Lauren, leurs cheveux gominés, leurs bouteilles de champagne à la main, ils se sentaient comme des Pères éternels mais ils n'étaient que trois sacs à merde ivres morts."
                            },
                            {
                                "example_id": "1176b82d-4a51-4c9c-8886-8c11e8bc7243",
                                "sense_id": "4c33aea1-2819-3649-9267-c406a40fc1f3",
                                "text": "Il se rendait aux réunions politiques en costume, les cheveux gominés, cherchant à incarner la dédiabolisation initiée par Marine Le Pen, pour se débarrasser du passé xénophobe et antisémite du RN."
                            }
                        ]
                    }
                ],
