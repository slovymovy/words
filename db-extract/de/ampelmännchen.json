                    {
                        "sense_id": "8810918d-bf41-3185-957c-4f8e0e77da16",
                        "entry_id": "39f2eef6-7387-3879-91ed-921aef985cbe",
                        "glosses": [
                            "walking figure shown on pedestrian signals"
