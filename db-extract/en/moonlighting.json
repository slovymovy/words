                ],
                "senses": [
                    {
                        "sense_id": "631ef94c-eec1-38f1-92f8-e19ec8ee33c7",
                        "entry_id": "33d01871-1219-33b4-a0dd-19d866ec144a",
                        "glosses": [
                            "The act of, or a period of, working on the side (at a secondary job), often in the evening or during the night, either openly or secretly."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce8183f8-6c35-4477-b972-dd5b52b9b3d6",
                                "sense_id": "631ef94c-eec1-38f1-92f8-e19ec8ee33c7",
                                "text": "Aiming for sky-high productivity, the company discourages the distractions and fatigue of moonlighting by paying people enough that most choose not to bother with a second job."
                            }
                        ]
                    },
                    {
                        "sense_id": "bec5dfb8-e45b-3a8e-b3a0-9cd03854fa71",
                        "entry_id": "33d01871-1219-33b4-a0dd-19d866ec144a",
                        "glosses": [
                            "Moonshining."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "rare",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8337dd29-be5e-4e00-b171-5712425a7dc6",
                        "source_entry_id": "33d01871-1219-33b4-a0dd-19d866ec144a",
                        "source_sense_description": "period of working on the side",
                        "target_lang_word": "melouch",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melouch",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "47fee8ea-b0f2-3011-9e3d-7b75e7fa42ec",
                                        "entry_id": "e196e532-1f8b-3648-b896-d22a1c0c1bc8",
                                        "glosses": [
                                            "práce sjednaná a zaplacená neoficiálním způsobem (tzv. na černo), vykonaná obvykle v jinak volném čase pracovníka"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f38c95c-2e54-4e4b-8e7c-87b39b47138e",
                                                "sense_id": "47fee8ea-b0f2-3011-9e3d-7b75e7fa42ec",
                                                "text": "A po tomto strohém vysvětlení, vyfasoval několik desítek šroubů do dřeva, na nábytek do své chalupy, který mu dělali jako melouch v ústavní truhlárně."
                                            },
                                            {
                                                "example_id": "b6004794-5394-452e-8c1c-388fde2f3a0a",
                                                "sense_id": "47fee8ea-b0f2-3011-9e3d-7b75e7fa42ec",
                                                "text": "Pepan Šimánek - jak už jsem naznačil - se vyžíval ve vydělávání peněz, jimiž rodinu solidně zaopatřoval. Plynule zaopatřoval i nějakou další ženu, u které trávil většinu z toho pramála volného času, co si vedle melouchů dopřával. K tomuto způsobu života se klidně uchýlil, když zjistil, že na krk si uvázal..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b85154b-8076-4015-b456-c7ca0ccfe521",
                        "source_entry_id": "33d01871-1219-33b4-a0dd-19d866ec144a",
                        "source_sense_description": "period of working on the side",
                        "target_lang_word": "travail au noir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "travail au noir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e10dd0a9-07d5-366d-830d-616ef966fb05",
                                        "entry_id": "fd0dc973-0f68-3a72-bb89-66d8e885f966",
                                        "glosses": [
                                            "Embauche intentionnelle d’un employé sans les formalités déclaratives légales."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a52479cd-0a0b-4a61-8529-877b05ab4dea",
                                                "sense_id": "e10dd0a9-07d5-366d-830d-616ef966fb05",
                                                "text": "Mais les flux sont de plus en plus souvent clandestins, ceux-ci étant liés aux législations contraignantes des pays récepteurs comme des pays émetteurs, mais aussi aux situations des migrants de plus en plus contraints à la semi-clandestinité et au travail au noir sinon aux trafics en tous genres, donc ne pouvant pas passer par les canaux officiels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
