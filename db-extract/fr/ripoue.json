                    {
                        "sense_id": "772f6aa4-e712-345c-a542-c960621d5d7e",
                        "entry_id": "8b37b5e2-a33c-377b-8b31-23a3e3d2ece1",
                        "glosses": [
                            "Policière corrompue."
