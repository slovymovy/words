                "senses": [
                    {
                        "sense_id": "a6701166-c4f9-33c6-abaf-c969c6e172ee",
                        "entry_id": "c0c4571f-6886-33fe-8aad-a2805adb34da",
                        "glosses": [
                            "zeer duidelijk, klaarblijkelijk, in 't oog springend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7045f339-c83b-4297-8100-63de92e2b7bb",
                                "sense_id": "a6701166-c4f9-33c6-abaf-c969c6e172ee",
                                "text": "Derhalve is het besluit tot ongewenstverklaring evident onjuist."
                            },
                            {
                                "example_id": "d0d309ea-b906-41ff-a887-9ffe513a059a",
                                "sense_id": "a6701166-c4f9-33c6-abaf-c969c6e172ee",
                                "text": "Het roept de vraag op waarom in de tien jaar dat The Donald het Amerikaanse politieke landschap domineert de literatuur zo’n laf tegengeluid heeft geproduceerd. De weinige satirische romans die tijdens Trumps eerste termijn verschenen – Dave Eggers’ De kapitein en de Glory (2019) of Howard Jacobsons Pussy (2017) – bleven steken in overdrijving van het evidente: dat Trump een oliedomme, van empathie gespeende pestkop is, een maffiakoning die maatschappelijke onvrede kanaliseert voor eigen ego en gewin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e11a6f1d-5502-4684-87c8-a0c4a6fa5d3f",
                        "source_entry_id": "c0c4571f-6886-33fe-8aad-a2805adb34da",
                        "source_sense_id": "a6701166-c4f9-33c6-abaf-c969c6e172ee",
