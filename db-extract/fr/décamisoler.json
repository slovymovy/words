                "senses": [
                    {
                        "sense_id": "cecee4a9-66b3-33be-be37-809b92864d87",
                        "entry_id": "88051779-58f8-3ebd-b111-ba9299f86a80",
                        "glosses": [
                            "Enlever sa camisole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e01c844-4c99-429b-8422-7f77ca02435c",
                                "sense_id": "cecee4a9-66b3-33be-be37-809b92864d87",
                                "text": "Nous allons vous dévêtir, monsieur Tricotin, ce qui veut dire que nous allons vous désentraver et vous décamisoler."
                            },
                            {
                                "example_id": "a1bd37f1-6c49-4b3d-8e10-4edb33096616",
                                "sense_id": "cecee4a9-66b3-33be-be37-809b92864d87",
                                "text": "Elle est d’ailleurs très difficile à maintenir car, souple et robuste, elle sait se décamisoler en quelques minutes pour commettre systématiquement d’importants dégâts matériels."
                            }
                        ]
                    }
