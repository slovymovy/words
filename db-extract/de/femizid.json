                        "examples": [
                            {
                                "example_id": "cd7a7452-2a46-4050-91db-73db0d2f8558",
                                "sense_id": "efee630e-7e51-3768-b201-b01ec708d861",
                                "text": "Stoppt Femizide! Man tötet nicht aus Liebe",
                                "translation": "Stop femicides! You don't kill out of love!",
                                "english": "Stop femicides! You don't kill out of love!"
                            },
                            {
                                "example_id": "f1cb5db0-32ce-4de7-a56d-93099b0fa23e",
                                "sense_id": "efee630e-7e51-3768-b201-b01ec708d861",
                                "text": "Die Be­ob­ach­te­r*in­nen verstehen sich als Beistand für die Familie, solidarisieren sich in Form von Mahnwachen und fordern Fälle wie diesen als das zu benennen, was sie seien: Femizide. Tötungsdelikte an Frauen, die passieren, weil sie Frauen sind."
                            }
                        ]
                    }
