                                    {
                                        "sense_id": "5ffaf2c9-39e6-358d-bf17-e804369f54c8",
                                        "entry_id": "51063060-6507-3481-9e5a-51ac4aedd20a",
                                        "glosses": [
                                            "Of, relating to, consisting of, or resembling a cell or cells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a9d045-17dc-490f-bf75-4e49b6d64fa2",
                                                "sense_id": "5ffaf2c9-39e6-358d-bf17-e804369f54c8",
                                                "text": "The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, just as having the human genome has made it possible to ask new questions about cellular and molecular systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26e9664-1186-3ef8-ab57-d8bd823a7760",
                                        "entry_id": "51063060-6507-3481-9e5a-51ac4aedd20a",
                                        "glosses": [
                                            "Light to mid-weight, having a regular cell-like construction with small perforations, generally woven; (of a garment) made of cellular fabric."
                                        ],
                                        "tags": [
                                            "of a fabric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60776617-4def-4740-b68f-25f69b1ace4c",
                                                "sense_id": "b26e9664-1186-3ef8-ab57-d8bd823a7760",
                                                "text": "a cellular sports shirt"
                                            },
                                            {
                                                "example_id": "77986f5c-35f9-467f-b6d3-3c97906904eb",
                                                "sense_id": "b26e9664-1186-3ef8-ab57-d8bd823a7760",
                                                "text": "for man is born free but everywhere is in cellular underwear"
                                            },
                                            {
                                                "example_id": "ba8bf622-c7cf-445d-a3f2-c1f01a420a63",
                                                "sense_id": "b26e9664-1186-3ef8-ab57-d8bd823a7760",
                                                "text": "the wind hitting your chest through your cellular blouse as though you had absolutely nothing on"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cellular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f877253-205d-3b81-9730-bcd6285bcffd",
                                        "entry_id": "d483031d-024c-3297-aa3e-e4caa91c4cd1",
                                        "glosses": [
                                            "A cellular phone (mobile phone)."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2f4c07-b3ce-411f-bd04-7a9204a84d56",
                                                "sense_id": "4f877253-205d-3b81-9730-bcd6285bcffd",
                                                "text": "MULDER: Yeah, Eddie, this is all good stuff. Yeah, see what else you can find on him from the N.C.I.C. and call me back. At, at this number or on my cellular."
                                            }
                                        ]
                                    }
                                ]
