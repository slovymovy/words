                                            {
                                                "example_id": "be1d7864-7562-470d-9a97-56836cfa27bb",
                                                "sense_id": "61164fea-c6fa-3b5d-83bd-9d9eae8c6159",
                                                "text": "Naukowiec nie jest twórcą prawdy, ale jej odkrywcą"
