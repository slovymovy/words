                "senses": [
                    {
                        "sense_id": "87979a62-bc3e-3742-95ba-066d8ed0b95c",
                        "entry_id": "abe345a8-c3fe-3dad-895f-409ed84ebcfa",
                        "glosses": [
                            "Langue caucasienne de la famille des langues abkhazo-adygiennes parlée dans le sud de l’Abkhazie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0a482c-82ac-4a90-aa99-414db0e1c619",
                                "sense_id": "87979a62-bc3e-3742-95ba-066d8ed0b95c",
                                "text": "En abaza moderne, sana signifie « groseillier », arbuste dont les fruits rouges sont en grappes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81bed3ba-8a79-4e22-b347-9ee40ef02170",
                        "source_entry_id": "abe345a8-c3fe-3dad-895f-409ed84ebcfa",
                        "source_sense_id": "87979a62-bc3e-3742-95ba-066d8ed0b95c",
                        "target_lang_word": "Abasinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abasinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abeafa0d-d818-303f-b9bb-452d22c3b401",
                                        "entry_id": "9c7c25e2-c3d9-3413-8290-dd84b1af7e8b",
                                        "glosses": [
                                            "Sprache, die in Karatschai-Tscherkessien (Russland) und der Türkei vom Volk der Abasinen gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d75f872-b9c2-4548-a85a-aff1c31a4dab",
                                                "sense_id": "abeafa0d-d818-303f-b9bb-452d22c3b401",
                                                "text": "„Das Abasinische ist, wie bereits gesagt, als entfernter Vertreter des südwestkaukasischen (‚abchasischen‘) Dialektverbands einzuordnen.“"
                                            },
                                            {
                                                "example_id": "e8f9c660-c7ca-4a4b-918a-350bef5229cc",
                                                "sense_id": "abeafa0d-d818-303f-b9bb-452d22c3b401",
                                                "text": "„So hat jede Sprache nicht weniger als zwei Vokale. Die Ausnahme bilden zwei Sprachen: Abasinisch und Aranta.“"
                                            },
                                            {
                                                "example_id": "db47482e-8ea7-470a-92c4-cf78d546e3c3",
                                                "sense_id": "abeafa0d-d818-303f-b9bb-452d22c3b401",
                                                "text": "„Das ist typisch für das Abasinische, das die Palatisierung verloren hat, worauf ich schon vor langer Zeit hingewiesen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
