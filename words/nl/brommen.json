    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "186ed798-0823-3e1b-9ec9-d7350b4b5fdd",
                    "sense_definition": "een laag, monotoon en trillend geluid maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude koelkast in de keuken begon plotseling hard te <w>brommen</w>.",
                            "target_lang_translations": {
                                "en": "The old refrigerator in the kitchen suddenly started to <w>hum</w> loudly."
                            }
                        },
                        {
                            "text": "Ik hoorde een dikke vlieg tegen het raam <w>brommen</w>.",
                            "target_lang_translations": {
                                "en": "I heard a fat fly <w>buzzing</w> against the window."
                            }
                        }
                    ],
                    "synonyms": [
                        "gonzen",
                        "zoemen",
                        "ronken"
                    ],
                    "common_phrases": [
                        "zachtjes brommen",
                        "monotoon brommen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a low, monotonous, and vibrating sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hum",
                                "target_lang_sense_clarification": "a continuous low sound"
                            },
                            {
                                "target_lang_word": "buzz",
                                "target_lang_sense_clarification": "a vibrating sound like an insect"
                            },
                            {
                                "target_lang_word": "drone",
                                "target_lang_sense_clarification": "a low, monotonous sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68035588-0e5a-3606-9c48-6ac31057761c",
                    "sense_definition": "op een ontevreden of norse manier binnensmonds praten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar <w>bromde</w> tegen zijn luie leerlingen dat ze beter moesten werken.",
                            "target_lang_translations": {
                                "en": "The teacher <w>grumbled</w> at his lazy students that they should work harder."
                            }
                        },
                        {
                            "text": "Toen ik hem wakker maakte, <w>bromde</w> hij alleen iets onverstaanbaars.",
                            "target_lang_translations": {
                                "en": "When I woke him up, he only <w>muttered</w> something unintelligible."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopperen",
                        "murmelen",
                        "reutelen"
                    ],
                    "antonyms": [
                        "juichen"
                    ],
                    "common_phrases": [
                        "iets binnensmonds brommen",
                        "boos brommen"
                    ],
                    "target_lang_definitions": {
                        "en": "to speak under one's breath in a dissatisfied or surly manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grumble",
                                "target_lang_sense_clarification": "to complain in a low voice"
                            },
                            {
                                "target_lang_word": "mutter",
                                "target_lang_sense_clarification": "to speak quietly and unclearly"
                            },
                            {
                                "target_lang_word": "growl",
                                "target_lang_sense_clarification": "to speak in a low, angry voice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7d17603-07fb-3425-ad5a-b26b84a0aeeb",
                    "sense_definition": "rijden op een bromfiets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het weekend gaan de jongeren vaak samen een eindje <w>brommen</w>.",
                            "target_lang_translations": {
                                "en": "On the weekend, the youngsters often go out <w>riding their mopeds</w> together."
                            }
                        },
                        {
                            "text": "Hij is de hele middag naar de stad <w>gebromd</w> op zijn nieuwe voertuig.",
                            "target_lang_translations": {
                                "en": "He <w>scooted</w> to the city all afternoon on his new vehicle."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een eindje brommen",
                        "naar school brommen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik gerelateerd aan bromfietsen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to ride on a moped or light motorcycle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ride a moped",
                                "target_lang_sense_clarification": "informal use for traveling by moped"
                            },
                            {
                                "target_lang_word": "scoot",
                                "target_lang_sense_clarification": "to travel on a small motorized vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4f15ef3-e16d-3fbc-8f88-7fde886d13a3",
                    "sense_definition": "een gevangenisstraf uitzitten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "straf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter veroordeelde de dief tot drie jaar <w>brommen</w>.",
                            "target_lang_translations": {
                                "en": "The judge sentenced the thief to <w>do</w> three years <w>time</w>."
                            }
                        },
                        {
                            "text": "Hij heeft al vaker moeten <w>brommen</w> voor kleine vergrijpen.",
                            "target_lang_translations": {
                                "en": "He has had to <w>be inside</w> several times for minor offenses."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastzitten",
                        "zitten"
                    ],
                    "common_phrases": [
                        "vijf jaar brommen",
                        "moeten brommen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informele taal voor gevangenisstraf"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to serve a prison sentence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do time",
                                "target_lang_sense_clarification": "slang for serving a sentence"
                            },
                            {
                                "target_lang_word": "be inside",
                                "target_lang_sense_clarification": "informal for being in prison"
                            },
                            {
                                "target_lang_word": "rot in jail",
                                "target_lang_sense_clarification": "informal for spending time in prison"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0650567f-0921-30d8-94d2-ce45616a45b9",
                    "sense_definition": "op een hoogmoedige manier over jezelf praten",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij hield niet op met <w>brommen</w> over zijn grote successen in het buitenland.",
                            "target_lang_translations": {
                                "en": "He didn't stop <w>boasting</w> about his great successes abroad."
                            }
                        },
                        {
                            "text": "Zit niet zo te <w>brommen</w> over je nieuwe auto.",
                            "target_lang_translations": {
                                "en": "Don't <w>brag</w> so much about your new car."
                            }
                        }
                    ],
                    "synonyms": [
                        "opscheppen",
                        "pochen",
                        "snakken"
                    ],
                    "common_phrases": [
                        "hoog van de toren brommen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in deze betekenis minder gebruikelijk in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to talk about oneself in a haughty or boastful manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boast",
                                "target_lang_sense_clarification": "to speak with excessive pride"
                            },
                            {
                                "target_lang_word": "brag",
                                "target_lang_sense_clarification": "to show off about achievements"
                            }
                        ]
                    }
                }
            ]
