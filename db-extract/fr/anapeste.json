                        "entry_id": "8d1088be-938f-32ff-a585-70ad6890a8b7",
                        "glosses": [
                            "Pied composé de deux brèves et d’une longue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b0ffb74-0f08-43b1-83d4-800cc32cefb2",
                                "sense_id": "277dd32f-5105-357e-918c-4460fa938f6c",
                                "text": "Le vers anapestique tire son nom du pied anapeste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c788bb15-195a-4a3f-af8b-1e84660e1cf3",
