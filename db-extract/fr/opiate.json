                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d8133a78-9dfb-49e7-8ff5-ae532138ff5d",
                                "sense_id": "ef6c08ef-94a7-315a-8c5f-20b384b09a36",
                                "text": "Mêlez le tout exactement avec une suffisante quantité de sirop d’absinthe, pour en faire un opiate de consistance requise."
                            },
                            {
                                "example_id": "9b1255d5-fc36-44c9-9d26-27a6a9b8a648",
                                "sense_id": "ef6c08ef-94a7-315a-8c5f-20b384b09a36",
                                "text": "Dentifrice. … Il y en a de secs, dont quelques-uns sont en façon d’opiate [médicament constitué de poudres] ou de poudres sèches grossement pulvérisées."
                            },
                            {
                                "example_id": "8a334cbe-93b4-4c30-93ca-027ca997e273",
                                "sense_id": "ef6c08ef-94a7-315a-8c5f-20b384b09a36",
                                "text": "Opiate Anti-Asthmatique.\nPrenez de la graine de Nielle lavée, […].\nIncorporez le tout avec le miel de Narbonne pour former une Opiate à prendre à la dose d’un gros & demi le matin à jeun, enveloppé dans du pain à chanter, en buvant par-dessus un gobelet d’infusion de fleur de Tussilage."
                            }
                        ]
                    }
