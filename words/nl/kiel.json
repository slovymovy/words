                {
                    "sense_id": "bfc80aba-407a-3524-9395-7f281bac58b4",
                    "sense_definition": "een gleuf of geul met een wigvormige doorsnede in de grond",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het regenwater verzamelde zich in de diepe <w>kiel</w> langs de rand van de akker.",
                            "target_lang_translations": {
                                "en": "The rainwater collected in the deep <w>furrow</w> along the edge of the field."
                            }
