        "fr-extract.jsonl": [
            {
                "entry_id": "ae467a3e-4b36-3365-b732-0e5b49073c14",
                "word": "frusques",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                        "entry_id": "ae467a3e-4b36-3365-b732-0e5b49073c14",
                        "glosses": [
                            "Vêtements."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5218a9ad-3af1-43c0-bc4b-f7ea02fbe02c",
                                "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                                "text": "Il campait là ses frusques pour passer une robe de chambre de velours bleu."
                            },
                            {
                                "example_id": "fca5d2fd-cfb4-4971-8ef4-7f32dbf293b3",
                                "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                                "text": "Et aujourd’hui, parce qu’un peu de bois et quelques briques sont atteints par la stratégie des désespérés, ceux pour qui l’on s’est ruinés et pour qui l’on va mourir vont-ils nous jeter leur paquet de frusques à travers les jambes ?"
                            },
                            {
                                "example_id": "8a1fe1eb-ee34-4bcd-ac10-1a3ce6855830",
                                "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                                "text": "Mes frusques ! réclame la nymphe Monsavon."
                            },
                            {
                                "example_id": "f0dc42b2-ab2c-41da-ad57-2f3d591e2a0e",
                                "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                                "text": "Ils vendront leurs livres aux bouquinistes, leurs frusques aux fripiers."
                            },
                            {
                                "example_id": "3ef520f9-cf07-4216-84a5-97062f02687a",
                                "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                                "text": "– Alors voilà, tu vas chercher tes frusques, tu t’installes chez moi et, quand Marie-Claude part, tu prends sa suite."
                            },
                            {
                                "example_id": "f03c4b53-f358-4370-b409-b8714259062e",
                                "sense_id": "704e35b2-5c4b-3357-bffd-1073cd12b60b",
                                "text": "Mais ce désarroi vestimentaire s’est traduit, tout à coup, par une fringale de costumes sur mesures, de belles chaussures, de frusques de qualité, une frénésie de garde-robe, un appétit de chemises de couleur, de cravates éclatantes."
                            }
                        ]
                    }
                ],
