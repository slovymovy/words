{
    "word_family": [
        "unhinge",
        "hingeless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da85d428-ecd2-3164-8c69-8cc89d6c4aaa",
                    "sense_definition": "A movable mechanism or jointed piece of hardware on which a door, gate, or lid swings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy wooden door squeaked on its old rusty <w>hinges</w> when I pushed it open.",
                            "target_lang_translations": {
                                "ru": "Тяжелая деревянная дверь заскрипела на старых ржавых <w>петлях</w>, когда я толкнул ее."
                            }
                        },
                        {
                            "text": "He oiled the door <w>hinge</w> to stop the loud noise.",
                            "target_lang_translations": {
                                "ru": "Он смазал дверную <w>петлю</w>, чтобы прекратить громкий шум."
                            }
                        }
                    ],
                    "common_phrases": [
                        "door hinge",
                        "rusty hinge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижный механизм или шарнирное изделие, на котором вращается дверь, ворота или крышка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петля",
                                "target_lang_sense_clarification": "дверная или оконная"
                            },
                            {
                                "target_lang_word": "шарнир",
                                "target_lang_sense_clarification": "подвижное соединение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdb3815a-6a2c-3299-ae25-cdd89ed23cbd",
                    "sense_definition": "A central principle, point, or event on which everything else depends.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This crucial fact became the <w>hinge</w> on which the entire legal argument turned.",
                            "target_lang_translations": {
                                "ru": "Этот решающий факт стал <w>стержнем</w>, вокруг которого строилась вся юридическая аргументация."
                            }
                        },
                        {
                            "text": "The election was the turning point and main <w>hinge</w> of recent political history.",
                            "target_lang_translations": {
                                "ru": "Выборы стали переломным моментом и главным <w>поворотным пунктом</w> новейшей политической истории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hinge of the argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральный принцип, ключевой момент или событие, от которого зависит всё остальное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стержень",
                                "target_lang_sense_clarification": "основа, ключевой элемент"
                            },
                            {
                                "target_lang_word": "поворотный пункт",
                                "target_lang_sense_clarification": "решающий момент"
                            },
                            {
                                "target_lang_word": "опора",
                                "target_lang_sense_clarification": "то, на чем всё держится"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "300c8627-3660-3648-ba95-4a0133fbe6fa",
                    "sense_definition": "A natural joint resembling hardware, such as the mechanism connecting the shells of a bivalve mollusk.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist carefully examined the delicate <w>hinge</w> connecting the two halves of the clam shell.",
                            "target_lang_translations": {
                                "ru": "Биолог внимательно изучил хрупкий <w>замок</w>, соединяющий две половинки раковины моллюска."
                            }
                        },
                        {
                            "text": "Damage to the shell's <w>hinge</w> prevents the creature from opening properly.",
                            "target_lang_translations": {
                                "ru": "Повреждение <w>замка</w> раковины мешает моллюску правильно раскрываться."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественное соединение у животных или растений, напоминающее шарнир (например, сочленение створок моллюска)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замок",
                                "target_lang_sense_clarification": "сочленение раковины моллюска"
                            },
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "анатомическое сочленение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cf6966a-69e4-301d-903b-ab5b9769ece5",
                    "sense_definition": "A small piece of folded, gummed paper used by stamp collectors to affix postage stamps into an album.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached the valuable stamp to the album page using a paper <w>hinge</w>.",
                            "target_lang_translations": {
                                "ru": "Он прикрепил ценную марку к странице альбома с помощью бумажной <w>наклейки</w>."
                            }
                        },
                        {
                            "text": "Be careful when removing the <w>hinge</w> so you do not damage the back of the stamp.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны при удалении <w>наклейки</w>, чтобы не повредить оборотную сторону марки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stamp hinge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая полоска клейкой бумаги, используемая филателистами для прикрепления марок в альбом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклейка",
                                "target_lang_sense_clarification": "филателистическая для марок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e56107-8ca2-3122-8798-70d107d4e9f4",
                    "sense_definition": "In statistics, the median of the upper or lower half of a dataset.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statistician calculated the lower <w>hinge</w> to summarize the bottom distribution of the sample.",
                            "target_lang_translations": {
                                "ru": "Статистик рассчитал нижний <w>квартиль</w>, чтобы обобщить нижнюю часть распределения выборки."
                            }
                        },
                        {
                            "text": "In a box plot, the <w>hinges</w> correspond to the upper and lower quartiles.",
                            "target_lang_translations": {
                                "ru": "На диаграмме размаха <w>края ящика</w> соответствуют верхнему и нижнему квартилям."
                            }
                        }
                    ],
                    "synonyms": [
                        "quartile"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical statistical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В статистике: медиана верхней или нижней половины набора данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хворда",
                                "target_lang_sense_clarification": "шарнир, квартиль в статистике"
                            },
                            {
                                "target_lang_word": "квартиль",
                                "target_lang_sense_clarification": "статистический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8b9a567-0755-3548-aa4a-1cde3ba5e0f3",
                    "sense_definition": "To depend entirely on something else.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The outcome of the match will <w>hinge</w> on the decision made by the referee.",
                            "target_lang_translations": {
                                "ru": "Исход матча будет <w>зависеть</w> от решения, принятого судьей."
                            }
                        },
                        {
                            "text": "Our success will <w>hinge</w> upon how well we cooperate under pressure.",
                            "target_lang_translations": {
                                "ru": "Наш успех будет <w>зависеть</w> от того, насколько хорошо мы сплотимся под давлением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hinge on",
                        "hinge upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависеть полностью от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависеть",
                                "target_lang_sense_clarification": "целиком определяться чем-либо"
                            },
                            {
                                "target_lang_word": "вращаться вокруг",
                                "target_lang_sense_clarification": "сводиться к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c104070-d6ce-30a3-ba55-e6cb534b933c",
                    "sense_definition": "To attach to or equip with a hinge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter decided to <w>hinge</w> the wooden lid so that it would open smoothly.",
                            "target_lang_translations": {
                                "ru": "Плотник решил <w>повесить на петли</w> деревянную крышку, чтобы она плавно открывалась."
                            }
                        },
                        {
                            "text": "They <w>hinged</w> the panel securely to the cabinet frame.",
                            "target_lang_translations": {
                                "ru": "Они надежно <w>закрепили на петлях</w> панель к раме шкафа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hinge a door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять с помощью петель или оснащать шарниром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вешать на петли",
                                "target_lang_sense_clarification": "устанавливать на шарниры"
                            },
                            {
                                "target_lang_word": "прикреплять шарнирами",
                                "target_lang_sense_clarification": "делая подвижным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f15d2b76-8641-3418-a608-0656866cee85",
                    "sense_definition": "To bend, as if on a joint.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be sure to <w>hinge</w> at your hips when lifting heavy boxes off the floor.",
                            "target_lang_translations": {
                                "ru": "Обязательно <w>сгибайтесь</w> в тазобедренных суставах, поднимая тяжелые коробки с пола."
                            }
                        },
                        {
                            "text": "He <w>hinged</w> his knees slightly before jumping high into the air.",
                            "target_lang_translations": {
                                "ru": "Он слегка <w>согнул</w> ноги в коленях, прежде чем подпрыгнуть высоко вверх."
                            }
                        }
                    ],
                    "synonyms": [
                        "swing"
                    ],
                    "common_phrases": [
                        "hinge at the hips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгибаться, как на шарнирах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгибаться",
                                "target_lang_sense_clarification": "в суставах или сочленениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "49fba048-2e19-362a-96ae-4188d276cbba",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We met Professor <w>Hinge</w> at the international history conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на международной исторической конференции мы встретили профессора <w>Хинджа</w>."
                            }
                        },
                        {
                            "text": "The author Mr. <w>Hinge</w> published a new novel last month.",
                            "target_lang_translations": {
                                "ru": "Писатель мистер <w>Хиндж</w> опубликовал новый роман в прошлом месяце."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хиндж",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}