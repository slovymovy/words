                            }
                        },
                        {
                            "text": "In de lege tunnel hoorden we een <w>galmend</w> geluid van voetstappen.",
                            "target_lang_translations": {
                                "en": "In the empty tunnel, we heard an <w>echoing</w> sound of footsteps."
                            }
