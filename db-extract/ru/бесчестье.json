                                        "entry_id": "1d90fa30-d223-3ccf-8bed-5267e16b4c3f",
                                        "glosses": [
                                            "Shame or disgrace."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Ireland",
