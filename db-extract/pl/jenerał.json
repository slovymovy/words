                        ],
                        "examples": [
                            {
                                "example_id": "186b9b45-3873-4b32-827a-285ed6d88628",
                                "sense_id": "4615aca5-08fc-3e54-9337-54ffb2989e36",
                                "text": "On opowiadał jako Jenerał Dąbrowski\nZ ziemi Włoskiéj stara się przyciągnąć do Polski",
                                "translation": "He would relate how General Dombrowski was making efforts to penetrate from the Italian land into Poland [transl. by George Rapall Noyes]",
                                "english": "He would relate how General Dombrowski was making efforts to penetrate from the Italian land into Poland [transl. by George Rapall Noyes]"
                            },
                            {
                                "example_id": "b066642e-8579-47a8-81ec-8e5554bedff7",
                                "sense_id": "4615aca5-08fc-3e54-9337-54ffb2989e36",
                                "text": "W starym kościołku na Woli\nZostał jenerał Sowiński,\nStarzec o drewnianej nodze,\nI wrogom się broni szpadą",
                                "translation": "In the old churchhouse of Wola,\nGeneral Sowinski remained,\nOld man with a wooden leg,\nDefending himself with a sword [transl. by Walter Whipple]",
                                "english": "In the old churchhouse of Wola,\nGeneral Sowinski remained,\nOld man with a wooden leg,\nDefending himself with a sword [transl. by Walter Whipple]"
                            }
                        ]
                    }
