                "senses": [
                    {
                        "sense_id": "f4e89a56-a537-3995-9ead-ed730e633771",
                        "entry_id": "6be4e14e-a861-31e7-a2e5-8b0d61dc444b",
                        "glosses": [
                            "osoba płci żeńskiej, która nie ma rodzeństwa; jedyne dziecko rodziny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec16ac0-371a-45a5-9651-bba2a1792af7",
                                "sense_id": "f4e89a56-a537-3995-9ead-ed730e633771",
                                "text": "Moja koleżanka Teresa jest jedynaczką."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e880079-1c02-46a7-9b7f-d30b07667655",
                        "source_entry_id": "6be4e14e-a861-31e7-a2e5-8b0d61dc444b",
                        "source_sense_id": "f4e89a56-a537-3995-9ead-ed730e633771",
                        "target_lang_word": "hija única",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "79bd4825-1707-40a4-b51a-1150cc66c5b1",
                        "source_entry_id": "6be4e14e-a861-31e7-a2e5-8b0d61dc444b",
                        "source_sense_id": "f4e89a56-a537-3995-9ead-ed730e633771",
                        "target_lang_word": "Einzelkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einzelkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                                        "entry_id": "b78d52a3-f8d7-3672-a4f3-1faf7d813e7c",
                                        "glosses": [
                                            "Kind oder Jugendlicher ohne Geschwister"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e57012-6ec2-47c9-a876-0933d4ef557d",
                                                "sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                                                "text": "„Ich habe überhaupt keine Geschwister, ich bin Einzelkind.“"
                                            },
                                            {
                                                "example_id": "7414b704-242e-49b3-a95b-bc178a59abaa",
                                                "sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                                                "text": "„Mag sein: Mein Leben als Einzelkind und der spärliche Umgang mit Gleichaltrigen haben mich zum Sonderling und Grübler gemacht.“"
                                            },
                                            {
                                                "example_id": "78a36695-50fc-4c62-8d0d-bf8431992af8",
                                                "sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                                                "text": "„Und unser Einzelkind ist erstaunlich schnell zum angepassten Geschwisterkind mutiert.“"
                                            },
                                            {
                                                "example_id": "94a3a246-bfb6-4a0a-8e77-b5c5bd1d456d",
                                                "sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                                                "text": "„Durch ihre Familienstruktur haben Einzelkinder mehr Kontaktmöglichkeiten mit Erwachsenen als Kinder in größeren Familien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
