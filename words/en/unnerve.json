{
    "word_family": [
        "unnerving",
        "unnervingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93e93523-ddeb-3815-a4ba-0034473bc7fc",
                    "sense_definition": "To make someone lose their confidence, composure, or courage; to make nervous or upset.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long silence before the interview began to <w>unnerve</w> him completely.",
                            "target_lang_translations": {
                                "ru": "Долгое молчание перед собеседованием начало совершенно <w>выбивать его из колеи</w>."
                            }
                        },
                        {
                            "text": "I was greatly <w>unnerved</w> by the strange noises outside the cabin.",
                            "target_lang_translations": {
                                "ru": "Странные звуки снаружи хижины меня сильно <w>напугали</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disconcert",
                        "fluster",
                        "rattle",
                        "unsettle"
                    ],
                    "antonyms": [
                        "encourage",
                        "reassure"
                    ],
                    "common_phrases": [
                        "unnerve someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать кого-либо уверенности, самообладания или мужества; заставлять нервничать, выбивать из колеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "приводить в замешательство, лишать уверенности"
                            },
                            {
                                "target_lang_word": "нервировать",
                                "target_lang_sense_clarification": "вызывать беспокойство, тревогу"
                            },
                            {
                                "target_lang_word": "выбивать из колеи",
                                "target_lang_sense_clarification": "нарушать душевное равновесие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac582579-046c-364b-9f8e-fc8e9a3b38b5",
                    "sense_definition": "To deprive of physical strength, vigor, or power; to weaken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prolonged illness had begun to <w>unnerve</w> his once powerful body.",
                            "target_lang_translations": {
                                "ru": "Затяжная болезнь начала <w>ослаблять</w> его некогда сильное тело."
                            }
                        },
                        {
                            "text": "Sudden intense exhaustion seemed to <w>unnerve</w> the athlete during the race.",
                            "target_lang_translations": {
                                "ru": "Казалось, внезапное сильное истощение полностью <w>лишило сил</w> спортсмена во время забега."
                            }
                        }
                    ],
                    "synonyms": [
                        "debilitate",
                        "enervate",
                        "weaken"
                    ],
                    "antonyms": [
                        "fortify",
                        "strengthen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English for physical weakening"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать физической силы, бодрости или энергии; ослаблять (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "лишать физической силы"
                            },
                            {
                                "target_lang_word": "истощать",
                                "target_lang_sense_clarification": "доводить до потери сил"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}