                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f46e3088-bb72-444c-beb6-7b3d374c7918",
                                "sense_id": "e8b55f67-9ba9-33da-a06d-e2ff2853da41",
                                "text": "La droite a été réunifiée autour de la droite dure -dont le cœur est le RPR des Hauts-de-Seine, héritier de la tradition barbouzarde du gaullisme- et la gauche a été réunifiée autour de la gauche molle, avec le déclin du PCF."
                            },
                            {
                                "example_id": "f32ae4ce-e4d6-41dd-964a-0ef832f2f246",
                                "sense_id": "e8b55f67-9ba9-33da-a06d-e2ff2853da41",
                                "text": "Ravi d’exporter son savoir-faire barbouzard, le général Stewart envisage une mise a jour annuelle de ce document, qui sera traduit en huit langues."
                            },
                            {
                                "example_id": "65b6edd4-e21a-4a6a-a0bf-88897aad5c9d",
                                "sense_id": "e8b55f67-9ba9-33da-a06d-e2ff2853da41",
                                "text": "C'est du jamais vu dans une enquête secrète que je qualifie de barbouzarde."
                            }
                        ]
                    }
