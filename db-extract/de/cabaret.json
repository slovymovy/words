                ],
                "senses": [
                    {
                        "sense_id": "f4bb87ce-aa73-3ac9-a5f3-93e6bf39e62c",
                        "entry_id": "eb154b31-7f56-3cd9-8184-483c39d18ee8",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "8719e477-1a27-465d-a77d-de5f176a072b",
                                "sense_id": "f4bb87ce-aa73-3ac9-a5f3-93e6bf39e62c",
                                "text": "„Touristen kommen hierher, Hochzeitsgesellschaften, Leute, die in den Cabarets gewesen sind, andere, die wachgeblieben sind, um den berühmten Markt zu besuchen.“"
                            },
                            {
                                "example_id": "eb531cd6-0e64-4f5d-a687-f1e4d4e28793",
                                "sense_id": "f4bb87ce-aa73-3ac9-a5f3-93e6bf39e62c",
                                "text": "„Hier genossen sie den Blick auf Cabarets, Kaffeehäuser und den stumpfen Hauben der preußischen Schutzpolizei.“"
                            },
                            {
                                "example_id": "bc6cf41d-1832-4710-81dc-ab6adf24ce78",
                                "sense_id": "f4bb87ce-aa73-3ac9-a5f3-93e6bf39e62c",
                                "text": "„Gelegentlich endeten die Nächte auch im Cabaret, wo die Damen nicht nur sangen und spielten.“"
                            },
                            {
                                "example_id": "553ee82e-c531-4360-b073-34288160d6cc",
                                "sense_id": "f4bb87ce-aa73-3ac9-a5f3-93e6bf39e62c",
                                "text": "„Wir begleiteten sie zu dem Cabaret zurück und machten uns dann daran, die Stadt eingehend zu erforschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
