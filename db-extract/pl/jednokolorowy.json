                        "source_entry_id": "6547aad5-6c4c-3eae-83da-8e727203f1f7",
                        "source_sense_id": "7b85c932-c8f2-3768-af05-9552c0cd89e0",
                        "target_lang_word": "monochrome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monochrome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e3d2c6b-5700-3c98-8fca-7d8f6a7465d1",
                                        "entry_id": "d8d4cc7c-69d5-3907-880f-236b58151b10",
                                        "glosses": [
                                            "Qui contient seulement des luminances et non pas de différence de chromaticité, comme le noir et blanc."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2691b6f7-3333-4e92-a01b-b203f9144771",
                                                "sense_id": "0e3d2c6b-5700-3c98-8fca-7d8f6a7465d1",
                                                "text": "Les camaïeux, les grisailles sont des peintures monochromes."
                                            },
                                            {
                                                "example_id": "2946bd2c-c7b7-4e20-89e7-d0b60bd58ffe",
                                                "sense_id": "0e3d2c6b-5700-3c98-8fca-7d8f6a7465d1",
                                                "text": "Les ordinateurs des années 1980 étaient le plus souvent vendus avec un moniteur monochrome, les moniteurs couleur étant beaucoup plus chers."
                                            },
                                            {
                                                "example_id": "3e309132-b6e8-4cee-92bd-b43a98f208fc",
                                                "sense_id": "0e3d2c6b-5700-3c98-8fca-7d8f6a7465d1",
                                                "text": "Les formes sont monochromes et simples à ce stade, rien à voir avec notre sens de la vue. Mais cela représente une avancée par rapport aux vagues zones sombres et claires que des humains ont pu percevoir précédemment grâce à des implants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monochrome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afc31565-326c-3e1c-826a-f265d6997f37",
                                        "entry_id": "6b0ccf49-a1d8-3e64-8acd-1199a701e80e",
                                        "glosses": [
                                            "Œuvre monochrome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a7688e9-2b56-40cf-a26c-4c81178eb7c2",
                                                "sense_id": "afc31565-326c-3e1c-826a-f265d6997f37",
                                                "text": "Cette seconde section s’avère la plus problématique puisque y étaient exposés un monochrome noir de Günter Umberg, une représentation de miroir aveugle par Roy Lichtenstein, un vrai miroir de Jeff Koons, un tableau de René Magritte…"
                                            },
                                            {
                                                "example_id": "1a4688c5-d8f3-408c-b263-3931daf69615",
                                                "sense_id": "afc31565-326c-3e1c-826a-f265d6997f37",
                                                "text": "En essayant de produire un monochrome réaliste, j’ai mélangé plein de couleurs, avec pour résultat une couleur brune et sale : le signe banal d’une réalité morose."
                                            },
                                            {
                                                "example_id": "96835c0a-efd8-45a1-ae2f-0fec4f7698f4",
                                                "sense_id": "afc31565-326c-3e1c-826a-f265d6997f37",
                                                "text": "Alors que sort Multicolore, la dernière création de Mehdi Bayad, on prend le pari du monochrome, d’une œuvre d’un seul tenant, publiée l’an dernier : Rouge vif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
