                "senses": [
                    {
                        "sense_id": "21b62cec-2a46-3618-8c9f-fa51eabd8c17",
                        "entry_id": "b66c4d82-f8a9-3170-8fb5-6ff6f6fdadaf",
                        "glosses": [
                            "de horizon: de lijn waarboven, bij vrij uitzicht zoals op zee, de hemellichamen zichtbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3593e3f0-5299-4e45-bcbd-a433ed02b4c2",
                                "sense_id": "21b62cec-2a46-3618-8c9f-fa51eabd8c17",
                                "text": "Een nieuwe dag begint wanneer de zon boven de kimme verschijnt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58cfe03f-a0dc-4e12-91dc-20850ad3ce31",
                        "source_entry_id": "b66c4d82-f8a9-3170-8fb5-6ff6f6fdadaf",
                        "source_sense_id": "21b62cec-2a46-3618-8c9f-fa51eabd8c17",
                        "source_sense_description": "kimme",
                        "target_lang_word": "Horizont",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Horizont",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                        "entry_id": "bcfac724-02a4-3a0a-9b0c-cf28c11e2d97",
                                        "glosses": [
                                            "Grenzlinie zwischen der sichtbaren Erde und dem Himmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1e9023-ce9b-4926-a244-a503e682e3ce",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "Der Horizont im mathematischen Sinn ist ein Großkreis, der die Sphäre oder Himmelskugel in zwei gleiche Hälften teilt und dessen oberer Pol der Zenit ist, der Gegenpol heißt Nadir."
                                            },
                                            {
                                                "example_id": "3ea7350d-18db-4add-bdcf-ef01e36fd3bc",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "Am westlichen Horizonte ging hinter Wolken trübe die Sonne unter; am nächsten Tage würden von dort schwarze Regenwolken aufziehen."
                                            },
                                            {
                                                "example_id": "64decd8b-20f4-435b-beac-b37e3f3552ed",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "„Die Sonne hatte den Horizont erreicht, wer hier neu ist, kommt in den ersten drei Tagen an diese Stelle, um den Sonnenuntergang zu betrachten, später kommen sie nicht mehr, sie haben sich an die Pracht gewöhnt.“"
                                            },
                                            {
                                                "example_id": "c97cd4b4-54e4-4c5f-815a-cf13beba1eeb",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "„Er suchte den Horizont ab.“"
                                            },
                                            {
                                                "example_id": "f4bc1da9-0fcb-4655-9318-4ddc53e4b7ab",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "„Die Dünung rollte unter ihnen hinweg, warf sie dem bleichen Halbmond entgegen, so daß ringsum der ganze Horizont zu sehen war, und zog sie dann wieder in den schwarzen Wellentrog hinunter.“"
                                            },
                                            {
                                                "example_id": "316b8cb3-c7d0-415a-aebd-e62c3cacc93c",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "„Um nämlich morgens am östlichen Horizont zu erscheinen, musste die Sonne in ihrer nächtlichen Fahrt durch die Unterwelt den Gefahren der Finsternis widerstehen und die feindlichen Dämonen der Nacht besiegen.“"
                                            },
                                            {
                                                "example_id": "e14468c2-92b2-4411-80a9-91591b0bb68a",
                                                "sense_id": "9cbe26e3-2b73-3269-9655-b82e2db8db6b",
                                                "text": "„Deshalb tun sich die Deutschen so schwer, über die eigenen Erfahrungen und Wertesysteme hinauszudenken oder sich gar für neue Ideen zu erwärmen: In jungen Jahren wird ihr Horizont stark eingeschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cabec61f-1bad-3cb3-9bf7-4fb9f7cf76fb",
                                        "entry_id": "bcfac724-02a4-3a0a-9b0c-cf28c11e2d97",
                                        "glosses": [
                                            "geistiger Gesichtskreis, Enge oder Weite der Bildung, Grad von Einsicht oder Verständnis"
                                        ],
                                        "tags": [
                                            "bildhaft zu [1]",
                                            "bezogen auf Geistiges"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b441da-c59c-463c-859d-bd304f60ae31",
                                                "sense_id": "cabec61f-1bad-3cb3-9bf7-4fb9f7cf76fb",
                                                "text": "Das geht wohl über deinen beschränkten Horizont?"
                                            },
                                            {
                                                "example_id": "4fd211ec-ae95-4b66-bfad-54456952a64a",
                                                "sense_id": "cabec61f-1bad-3cb3-9bf7-4fb9f7cf76fb",
                                                "text": "Wer lernt, erweitert seinen Horizont."
                                            },
                                            {
                                                "example_id": "f12e47bc-73da-4b28-b393-787444eea8ee",
                                                "sense_id": "cabec61f-1bad-3cb3-9bf7-4fb9f7cf76fb",
                                                "text": "„Der Horizont vieler Menschen ist ein Kreis mit Radius Null – und diesen nennen sie ihren Standpunkt.“ (In dieser oder ähnlicher Form unter anderen David Hilbert zugeschrieben.)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1964cc0-4d1f-3c49-ac5c-060a7df9ad3a",
                                        "entry_id": "bcfac724-02a4-3a0a-9b0c-cf28c11e2d97",
                                        "glosses": [
                                            "Zukunftsaussichten, Hoffnungen"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3011c517-bf83-48a8-aa1f-15d7d58e19d4",
                                                "sense_id": "b1964cc0-4d1f-3c49-ac5c-060a7df9ad3a",
                                                "text": "Die weltwirtschaftlichen Horizonte sind trübe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13c03131-d902-4389-b811-ec72e169986e",
                        "source_entry_id": "b66c4d82-f8a9-3170-8fb5-6ff6f6fdadaf",
                        "source_sense_id": "21b62cec-2a46-3618-8c9f-fa51eabd8c17",
                        "source_sense_description": "kimme",
                        "target_lang_word": "horizon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horizon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dab68cb6-6c83-3268-a342-898f99c5199b",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The visible horizontal line (in all directions) where the sky appears to meet the earth in the distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcc85a1-ae28-42ed-abbf-45d54a92e8d4",
                                                "sense_id": "dab68cb6-6c83-3268-a342-898f99c5199b",
                                                "text": "A tall building was visible on the whole sweep of the horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The range or limit of one's knowledge, experience or interest; a boundary or threshold."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11f22e3-120c-4efc-bf26-87f55bf33ac6",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "Some students take a gap year after finishing high school to broaden their horizons."
                                            },
                                            {
                                                "example_id": "4e637c15-024b-485c-b992-7bbf2f1c9d8c",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "With clinical researchers hard at work, a new treatment is on the horizon."
                                            },
                                            {
                                                "example_id": "abfaba7f-4584-4d2c-a39a-4ad363b66cf0",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "It is because theirs has become the only explicit general philosophy of social policy held by a large group, the only system or theory which raises new problems and opens new horizons, that they have succeeded in inspiring the imagination of the intellectual."
                                            },
                                            {
                                                "example_id": "9cd34097-8faf-4a10-805f-b218d2c95338",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "The Indians of the Americas totaled no less than 70 million when the foreign conquerors appeared on the horizon; a century and a half later they had been reduced to 3.5 million."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d661b4-bff7-3a99-b413-511c3d8549ee",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The range or limit of any dimension in which one exists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92082519-4936-4abc-b2c5-7c047336fe8c",
                                                "sense_id": "c2d661b4-bff7-3a99-b413-511c3d8549ee",
                                                "text": "Only mortality, this irreducible and primordial horizon, that very horizon which, in Being and Time, Heidegger so compellingly revealed as the unsurpassable and defining possibility, remains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aa78fd1-d0f5-34b9-97d7-391ee1422b18",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "A specific layer of soil, or stratum"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9860d0f-f9d8-3133-b43e-50d7acd34166",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "A cultural sub-period or level within a more encompassing time period."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cc4e1de-a563-37b8-82cc-85dabb3506b9",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "Any level line or surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffab316f-5542-37bc-b413-b5aaa375e241",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The point at which a computer chess algorithm stops searching for further moves."
                                        ],
