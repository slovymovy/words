                        "entry_id": "0a21e7e2-bbbf-3409-b573-c8b3b93598f1",
                        "glosses": [
                            "Habitant ou personne originaire de Rennes, commune française située dans le département de l’Ille-et-Vilaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efabe65f-f16c-4312-82d5-54fe7eebd9d7",
                                "sense_id": "2b005ab7-3a00-33ff-a054-dd7ec7a3dc21",
                                "text": "Les Rennais restaient sur trois victoires face à Caen (2-1), Augsbourg (3-2) et Nantes (1-0)."
                            },
                            {
                                "example_id": "5a9b2481-5522-48eb-a67c-286a6c06e8c3",
                                "sense_id": "2b005ab7-3a00-33ff-a054-dd7ec7a3dc21",
                                "text": "Je voudrais m’appuyer sur un exemple, celui de Nayyef Aguerd (ancien Rennais transféré à West Ham cet été, ndlr), issu de Rabat."
                            }
                        ]
                    }
