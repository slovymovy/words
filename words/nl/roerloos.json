            "senses": [
                {
                    "sense_id": "5bbf8427-b0a8-3ad2-a6b8-8048763bf60f",
                    "sense_definition": "volkomen stil, zonder zich te roeren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stilstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toeschouwers stonden <w>roerloos</w> te kijken naar de prachtige zonsondergang boven de zee.",
                            "target_lang_translations": {
                                "en": "The spectators stood <w>motionless</w> watching the beautiful sunset over the sea."
                            }
                        },
                        {
                            "text": "Zij bleven <w>roerloos</w> staan als standbeelden om niet opgemerkt te worden door de bewakers.",
                            "target_lang_translations": {
                                "en": "They remained <w>still</w> as statues so as not to be noticed by the guards."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegingloos",
                        "onbeweeglijk",
                        "stil"
                    ],
                    "antonyms": [
                        "beweeglijk",
                        "onrustig"
                    ],
                    "common_phrases": [
                        "roerloos staan",
                        "roerloos blijven zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "completely still, without moving at all"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "motionless",
                                "target_lang_sense_clarification": "not moving at all"
                            },
                            {
                                "target_lang_word": "still",
                                "target_lang_sense_clarification": "without movement"
                            },
                            {
                                "target_lang_word": "immobile",
                                "target_lang_sense_clarification": "unable to move or not moving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1170a23a-1d41-3f65-a39d-54c3a1d3f02e",
                    "sense_definition": "zonder roer",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het beschadigde schip dreef <w>roerloos</w> op de oceaan nadat het stuurmechanisme was afgebroken.",
                            "target_lang_translations": {
                                "en": "The damaged ship drifted <w>rudderless</w> on the ocean after the steering mechanism had broken off."
                            }
                        },
                        {
                            "text": "Een <w>roerloos</w> vaartuig is onmogelijk te besturen in een sterke stroming.",
                            "target_lang_translations": {
                                "en": "A <w>rudderless</w> vessel is impossible to steer in a strong current."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literal meaning related to a rudder"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "without a rudder (nautical)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rudderless",
                                "target_lang_sense_clarification": "lacking a rudder for steering"
                            }
                        ]
                    }
                }
            ]
        }
