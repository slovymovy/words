                "senses": [
                    {
                        "sense_id": "72358179-9279-3048-8d32-403aa471b48e",
                        "entry_id": "d13142fd-9b02-33c0-ba8a-470b8933b3bc",
                        "glosses": [
                            "Qui ressent une lassitude extrême dans tout le corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be233792-73ee-4d1e-93d6-25e9b4302b79",
                                "sense_id": "72358179-9279-3048-8d32-403aa471b48e",
                                "text": "Je me couchais, le soir, heureux, courbatu, mort de saine lassitude"
                            },
                            {
                                "example_id": "2403423d-a149-4317-941a-8c6dd65bfadb",
                                "sense_id": "72358179-9279-3048-8d32-403aa471b48e",
                                "text": "Dans ma hutte, je m’abattis tout de suite sur le lit de camp. Ce fut un mauvais sommeil, courbatu, fiévreux."
                            },
                            {
                                "example_id": "34fd1463-f86e-400e-af0d-3c40012f27ad",
                                "sense_id": "72358179-9279-3048-8d32-403aa471b48e",
                                "text": "Ses sens apaisés, ses muscles courbatus et la douce langueur qui l'habitaient lui donnaient la réponse."
                            }
                        ]
                    }
                ],
