                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3b268b8-e247-321b-b9c9-759771dae3f5",
                        "entry_id": "1117b91f-53db-363d-b392-e5f60330ac71",
                        "glosses": [
                            "pijnlijk hard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35163085-aa49-43b6-bdd5-28630a0a5dfd",
                                "sense_id": "b3b268b8-e247-321b-b9c9-759771dae3f5",
                                "text": "En soms had ik wind mee en zonneschijn op mijn tocht, maar vaak ook forse tegenwind en striemende regen”, blikt Ineke terug."
                            },
                            {
                                "example_id": "6c529763-c15b-4d1b-95dd-c21e348888e5",
                                "sense_id": "b3b268b8-e247-321b-b9c9-759771dae3f5",
                                "text": "Ik heb een nacht buiten op de boot in de regen en striemende wind moeten slapen omdat we aan een sluis werden tegengehouden. Dat was echt zwaar.\""
                            },
                            {
                                "example_id": "db8d07ca-d718-4120-881e-b7ee0e53aa9b",
                                "sense_id": "b3b268b8-e247-321b-b9c9-759771dae3f5",
                                "text": "Het dramatische veldspel, de onverwachte tussenstand en de merkwaardige wissels van coach Maas, kwamen Vitesse op striemende fluitconcerten te staan."
                            },
                            {
                                "example_id": "40e19c97-d546-4a28-92af-4a3d3278ab1b",
                                "sense_id": "b3b268b8-e247-321b-b9c9-759771dae3f5",
                                "text": "Maar wat een feest is de samensmelting van de striemende rock van Josh Homme en zijn mannen met de voorkeur voor melodieuze pop van Ronson."
                            }
                        ]
                    }
