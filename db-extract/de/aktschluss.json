                "senses": [
                    {
                        "sense_id": "9c89599c-ac66-3d51-882b-0f257fa4e3bc",
                        "entry_id": "f949352a-b0ea-3e88-a98a-f69138552013",
                        "glosses": [
                            "Abschluss/Ende eines Akts oder einer Szene in einem künstlerischen Werk, insbesondere in einem Bühnenstück oder in einer Oper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9988eb-65ee-4a1d-9ef3-8e29c9a62aed",
                                "sense_id": "9c89599c-ac66-3d51-882b-0f257fa4e3bc",
                                "text": "„An dieser Stelle erscheint also der Aktschluss, den schon die ersten Herausgeber hier gemacht haben, ganz gerechtfertigt.“"
                            },
                            {
                                "example_id": "565cf570-ba2d-4bab-a9fc-a62bbfb03bd4",
                                "sense_id": "9c89599c-ac66-3d51-882b-0f257fa4e3bc",
                                "text": "„Zum Schluss des zweiten Aktes hatte man auf der Erde die Kraft des Wortes entdeckt, das war der Aktschluss gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
