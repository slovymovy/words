                "senses": [
                    {
                        "sense_id": "754efeec-80ef-3dbc-a36b-8b2c036743e5",
                        "entry_id": "af0c4632-4935-3009-882f-c4c5a80aa3e1",
                        "glosses": [
                            "To cause a proc to occur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31eec5b-017c-46c5-8cde-1d8f29a07b92",
                                "sense_id": "754efeec-80ef-3dbc-a36b-8b2c036743e5",
                                "text": "Dunno the weapons' stats, except they both procced fairly frequently - lightning sword procced decapitation (instant death), and the whip procced fire reel (or whatever it was called) which reeled to target into the balor's body, engulfing you in searing flames for big damage."
                            },
                            {
                                "example_id": "7f015d0e-4817-4d00-8401-79629f62956b",
                                "sense_id": "754efeec-80ef-3dbc-a36b-8b2c036743e5",
                                "text": "Establish a proccing percentage of a weapon by putting it in the primary hand and then put it in your offhand and check the proccing percentage with varying levels of dual wield skill (while keeping level and dex constant)."
                            }
                        ]
                    }
                ],
