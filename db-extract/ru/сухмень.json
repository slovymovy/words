                        "examples": [
                            {
                                "example_id": "30e89751-e971-4f82-b1e7-7ed535668f4b",
                                "sense_id": "868bae36-b527-32d4-ba82-46ed18cb42b6",
                                "text": "Сряду три года то вымокнет, то сухмень высушит, то градом побьёт."
                            },
                            {
                                "example_id": "9a2a9b61-1dc7-4105-985b-837c855abae5",
                                "sense_id": "868bae36-b527-32d4-ba82-46ed18cb42b6",
                                "text": "Суглинка в мокредь не вспашешь, вязнет, а в сухмень не подымешь, слипается."
                            }
                        ]
