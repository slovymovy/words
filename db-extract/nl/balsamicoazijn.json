                                "target_senses": [
                                    {
                                        "sense_id": "4b3e676d-7bad-355f-91b3-cba9ef5b4081",
                                        "entry_id": "821734ec-7072-31f8-a4b7-61c4715ef73a",
                                        "glosses": [
                                            "dunkelbrauner, etwas süßlicher Essig aus dem Most italienischer Weißweintrauben"
                                        ],
                                        "tags": [
                                            "italienische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c53d04f-9d0c-43e6-8998-81e5749e7335",
                                                "sense_id": "4b3e676d-7bad-355f-91b3-cba9ef5b4081",
                                                "text": "„Das Hauptgericht ist ein geschmortes Schulterscherzel vom Jungbullen mit altem Balsamessig auf Olivenpüree und Soßengemüse. Ein spannendes Arrangement, bei dem vor allem die dunkle, kräftige Sauce und das leicht säuerliche Aroma der Oliven hervorstechen.“"
                                            },
                                            {
                                                "example_id": "ac39e9e3-6359-40d9-bfcb-eb6c6ea6d8fb",
                                                "sense_id": "4b3e676d-7bad-355f-91b3-cba9ef5b4081",
                                                "text": "„Thomas Steger verkauft auch Pesto, verschiedene Olivenöle, Balsamessig, Nudeln, Senf, sowie regionale Eigenerzeugnisse wie eingelegte Walnüsse von eigenen Bäumen und süßsauer marinierte Zwetschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b7f9623-16b9-4773-8286-28690217db5a",
                        "source_entry_id": "a5b84cfd-cf7a-3696-951e-e6930cf4744f",
                        "source_sense_id": "37de8481-18b2-3996-8fb6-3d86e612e14d",
