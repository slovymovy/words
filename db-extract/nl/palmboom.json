                ],
                "senses": [
                    {
                        "sense_id": "c113c51b-b548-3cc5-b445-9bd94d0faf2b",
                        "entry_id": "e471642d-b8f3-34fb-b1b7-66bdb89980a5",
                        "glosses": [
                            "De palmenfamilie (Palmae of Arecaceae: beide zijn toegestaan) is de enige familie in de orde Arecales. Van de palmenfamilie zijn bijna 4000 soorten bekend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccfd2b0d-268f-403f-8d24-0f0de8c4c267",
                                "sense_id": "c113c51b-b548-3cc5-b445-9bd94d0faf2b",
                                "text": "Ik citeer hier de Lonely Planet en hoewel het proza van deze reisgids in staat zou zijn om zelfs de Gazastrook nog op te leuken (‘the locals are very passionate’) moet gezegd worden: die Malediven zien er verdomd mooi uit. Een paradijs op aarde. Witte stranden, helder water, palmbomen en vrijwel geen mensen. Het oogt boven alles heel…puur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e9a20a3-50e3-4190-90d9-f56986692f05",
                        "source_entry_id": "e471642d-b8f3-34fb-b1b7-66bdb89980a5",
                        "source_sense_id": "c113c51b-b548-3cc5-b445-9bd94d0faf2b",
                        "target_lang_word": "Palme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85a0bf45-21b2-3f5a-9055-cb228b25ba47",
                                        "entry_id": "1498ead4-1330-3bba-b15f-c2c58b59f95d",
                                        "glosses": [
                                            "Einzelgewächs aus der Familie der Palmenartigen (Arecaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c78163-22cd-4741-809b-d4ec6482a078",
                                                "sense_id": "85a0bf45-21b2-3f5a-9055-cb228b25ba47",
                                                "text": "Wer Bilder mit Palmen sieht, denkt an Süden, Sonne, Strand und Meer."
                                            },
                                            {
                                                "example_id": "2469b450-fb55-4341-a394-18788b5b8b2d",
                                                "sense_id": "85a0bf45-21b2-3f5a-9055-cb228b25ba47",
                                                "text": "„Wir bogen links ab, dann rechts und hielten in einer ruhigen Seitenstraße, in der Palmen wedelten und Bougainvilleen blühten.“"
                                            },
                                            {
                                                "example_id": "9d930e53-2549-43d9-8a35-5e30de1c7df2",
                                                "sense_id": "85a0bf45-21b2-3f5a-9055-cb228b25ba47",
                                                "text": "„Und aus dem Saft der Palmen ließ sich Wein machen oder ein rumartiger Schnaps namens Arrak brennen.“"
                                            },
                                            {
                                                "example_id": "6deffefd-b876-4ecb-993a-3457daab3415",
                                                "sense_id": "85a0bf45-21b2-3f5a-9055-cb228b25ba47",
                                                "text": "„Einmal war er ihm in Sansibar begegnet, als er unter einer Palme Nietzsche las.“"
                                            },
                                            {
                                                "example_id": "30b5d373-6865-484f-a28d-866daca5424e",
                                                "sense_id": "85a0bf45-21b2-3f5a-9055-cb228b25ba47",
                                                "text": "„Ein Mann sitzt in der Wüste unter einer Palme und spielt Geige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3bb3006-0df3-442c-a811-eef00256003b",
                        "source_entry_id": "e471642d-b8f3-34fb-b1b7-66bdb89980a5",
                        "source_sense_id": "c113c51b-b548-3cc5-b445-9bd94d0faf2b",
                        "target_lang_word": "Palmenbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palmenbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9259213-c1ed-3016-acd5-ba9088d6d744",
                                        "entry_id": "64b84f46-fc02-3549-9975-82bd5dc7ca66",
                                        "glosses": [
                                            "der biologischen Familie der Palmengewächse angehörender Laubbaum; Palme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc236d13-1f6e-4ab9-bb84-11b29ee68d75",
                                                "sense_id": "d9259213-c1ed-3016-acd5-ba9088d6d744",
                                                "text": "„Die «Societas fructiferia», wie sie lateinisch genannt wurde, ist nach ihrem Emblem, einem «indianischen Palmenbaum», auch als «Palmenorden» bekannt geworden.“"
                                            },
                                            {
                                                "example_id": "a8070501-85e1-44e8-9232-bb92a0b4993c",
                                                "sense_id": "d9259213-c1ed-3016-acd5-ba9088d6d744",
                                                "text": "„Im Koran ist erzählt, daß Maria an einem Palmenbaum stand, als der Engel [Gabriel] zu ihr trat und sagte: »Ich will dir einen reinen Knaben schenken.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "106baa72-ac94-4069-a543-116c5ee44fea",
                        "source_entry_id": "e471642d-b8f3-34fb-b1b7-66bdb89980a5",
                        "source_sense_id": "c113c51b-b548-3cc5-b445-9bd94d0faf2b",
