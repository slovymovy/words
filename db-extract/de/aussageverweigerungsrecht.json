                        "entry_id": "8148a6da-ccb8-37e6-86f8-86185c023711",
                        "glosses": [
                            "das Recht eines Verdächtigten vor Gericht oder einer öffentlichen Stelle, die Aussage zu einer Sache zu verweigern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a14e9ee-a26e-411f-922d-c6610daeead6",
                                "sense_id": "b5ffd162-daaa-39c3-911c-c00254d23cfd",
                                "text": "Das Aussageverweigerungsrecht ist das Recht eines Verdächtigten, auf bestimmte Fragen die Auskunft zu verweigern."
                            },
                            {
                                "example_id": "1f2fd2ac-f50b-4c26-907d-35d0575cf59b",
                                "sense_id": "b5ffd162-daaa-39c3-911c-c00254d23cfd",
                                "text": "Der Angeklagte macht von seinem Aussageverweigerungsrecht Gebrauch."
                            }
                        ],
