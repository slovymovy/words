                "senses": [
                    {
                        "sense_id": "572c7c7b-7967-357e-8a30-a03d6238336e",
                        "entry_id": "5ea6b7ca-3f87-39a6-ab24-b437179bea44",
                        "glosses": [
                            "Variante orthographique de ébouser (dans son sens de tuer)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3d8afdb6-2636-4f21-b6f1-039044794bbe",
                                "sense_id": "572c7c7b-7967-357e-8a30-a03d6238336e",
                                "text": "Noir sur noir, je ne distinguais rien au sol, et déjà mon petit pote du matin devait contourner en douce ma charrette, sur la pointe des pieds, le calibre prudemment pointé, le doigt sur la détente, prêt à m’ébouzer à vue, tandis que moi, guettant ausi par où la purée allait me venir, je ne pouvais plus que balayer la route du pied, à l’aveugle, dans tous les sens, et reculer vers le fossé, instinctivement."
                            },
                            {
                                "example_id": "e00f6153-ff1e-471a-b7e1-76e56add20e1",
                                "sense_id": "572c7c7b-7967-357e-8a30-a03d6238336e",
                                "text": "Il risquait que des compliments si, au cours d’un échange avec ses suiveurs, le Maltais se faisait par bonheur ébouzer !"
                            }
                        ]
                    }
