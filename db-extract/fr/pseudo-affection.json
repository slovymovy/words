                    {
                        "sense_id": "52e91c28-c97f-3032-8dbb-87f215e17ca1",
                        "entry_id": "df7dc760-09b0-312c-9ab0-4befca4af3c8",
                        "glosses": [
                            "Quelque chose qui ressemble à une maladie, une affection, mais n'en est en réalité pas une."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1056452-fa51-4e46-97d5-ac5d7478437a",
                                "sense_id": "52e91c28-c97f-3032-8dbb-87f215e17ca1",
                                "text": "Les soi-disant affections articulaires de la période d’incubation n’ont rien à faire aux articulations elles-mêmes ; elles sont plutôt des pseudo-affections articulaires."
                            },
                            {
                                "example_id": "88cb51dd-2dc2-4658-b8b5-a2b2e54b9e3c",
                                "sense_id": "52e91c28-c97f-3032-8dbb-87f215e17ca1",
                                "text": "M. le Dr Boulay, dans sa revue générale, consacre un chapitre à la fièvre hystérique avec pseudo-affection viscérale ; c’est dire que les cas ne sont pas très rares ; la pseudo-fièvre typhoïde y tient le premier rang."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff76c698-9981-3f94-ab34-146014e50db9",
                        "entry_id": "df7dc760-09b0-312c-9ab0-4befca4af3c8",
                        "glosses": [
                            "Affection simulée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f80bca50-6e43-4e62-a8d0-a984684808dc",
                                "sense_id": "ff76c698-9981-3f94-ab34-146014e50db9",
                                "text": "Je ne crois pas une seconde à sa pseudo-affection pour la vieille timbrée."
                            },
                            {
                                "example_id": "db38254e-b16b-481e-9be9-f124ba7d273c",
                                "sense_id": "ff76c698-9981-3f94-ab34-146014e50db9",
                                "text": "Si les avantages mondains possédés par la personne aimée viennent à lui être enlevés, cette pseudo-affection disparaît aussitôt."
                            }
                        ]
                    }
                ],
