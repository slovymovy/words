                {
                    "sense_id": "ab31a0db-5129-3872-a8c3-e785c58d1f92",
                    "sense_definition": "Ajouter ou incorporer un nouvel élément dans un ensemble pour former un tout cohérent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développeur a <w>intégré</w> ce nouveau module dans l'application mobile."
                        },
                        {
                            "text": "Nous devons <w>intégrer</w> ces graphiques récents dans notre rapport final."
                        }
                    ],
                    "synonyms": [
