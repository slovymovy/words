                        "entry_id": "021fa7ed-b3d4-3698-b73a-53755a51ce6a",
                        "glosses": [
                            "Lehrer, der an einer Berufsschule arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf017bb-9bd9-4b8f-8dcb-f048536cedab",
                                "sense_id": "c6adae7a-3de2-3819-9c3b-68c5517c6b58",
                                "text": "In der letzten Stunde unterrichtete der Berufsschullehrer Informatik."
                            },
                            {
                                "example_id": "8f84ba45-ef96-40a3-84f5-deb2b386403e",
                                "sense_id": "c6adae7a-3de2-3819-9c3b-68c5517c6b58",
                                "text": "„Nach dem Lehramtsstudium und einem Doktoratsstudium der Politikwissenschaft war er zwischen 1981 und 1997 Berufsschullehrer in Wien.“"
                            },
                            {
                                "example_id": "af95a9f3-cdca-4328-a83f-a6f29919cd4c",
                                "sense_id": "c6adae7a-3de2-3819-9c3b-68c5517c6b58",
                                "text": "„Zum neuen Schuljahr stockte das Ministerium die Übergangsklassen auf, stellte alle angehenden Lehrer für Grund- und Mittelschule sowie 147 Berufsschullehrer ein.“"
                            }
                        ],
