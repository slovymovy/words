                "senses": [
                    {
                        "sense_id": "36bf369a-1f1e-3f16-9744-9bbf9ea40041",
                        "entry_id": "1c907786-df22-3a1d-8f78-48f7c9b5c099",
                        "glosses": [
                            "Rendre dubitatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e927a8a-0698-4122-972b-158faf8c3139",
                                "sense_id": "36bf369a-1f1e-3f16-9744-9bbf9ea40041",
                                "text": "Une chose néanmoins me dubitativise: pourquoi \"coder\" ainsi PI alors que la boussole, si parfaitement circulaire, nous y amènerait tôt ou tard ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e616217d-98de-3f2e-b55c-781c0a1707c8",
                        "entry_id": "1c907786-df22-3a1d-8f78-48f7c9b5c099",
                        "glosses": [
                            "Se montrer dubitatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b9a7eb4-145d-42d3-86df-a36ee00fd6b8",
                                "sense_id": "e616217d-98de-3f2e-b55c-781c0a1707c8",
                                "text": "Geoff toujours le nez sous les motos, Jihem scotche et le mari de la médecin dubitativise… (mais qu'allaient-ils faire dans cette galère ?)."
                            },
                            {
                                "example_id": "c4d45703-0b0b-4e92-87fe-6ee44217db1a",
                                "sense_id": "e616217d-98de-3f2e-b55c-781c0a1707c8",
                                "text": "C'est presque anti-fluff, mais c'est possible.. Greed, qui dubitativise."
                            },
                            {
                                "example_id": "d3f65d52-4e00-48b7-9c8c-313078c3e6d3",
                                "sense_id": "e616217d-98de-3f2e-b55c-781c0a1707c8",
                                "text": "Mais je dubitativise."
                            }
                        ]
                    }
                ],
