                "translations": [
                    {
                        "translation_id": "345ea7c7-7e36-474b-bbc0-df0ca8932abb",
                        "source_entry_id": "bb187e7f-10f1-3953-81a5-c9d8df7801bc",
                        "source_sense_id": "60de036b-a670-38cb-89c2-1d562b49790c",
                        "source_sense_description": "state of being joyful",
                        "target_lang_word": "радость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "радость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                        "entry_id": "81ab8dec-d324-3aa9-992d-0b5c6dec8274",
                                        "glosses": [
                                            "чувство удовольствия, внутреннего удовлетворения, весёлое настроение; внешнее проявление этого чувства"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63b99ef-0926-4e3a-b5d1-4fe1e2dcb368",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Острая захватывающая радость вдруг овладела им."
                                            },
                                            {
                                                "example_id": "8eaf79fa-fa5b-457b-a6ea-afadd1eca174",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "От радости в зобу дыханье спёрло."
                                            },
                                            {
                                                "example_id": "b5d35c36-fa5a-4a92-9be8-0e1d3b611a37",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Другая б на моём месте прыгала от радости."
                                            },
                                            {
                                                "example_id": "50ea7253-de4a-463e-99a7-b19d71340339",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Вне себя от радости."
                                            },
                                            {
                                                "example_id": "87141389-fbe2-406d-a4d1-fcab76dc542b",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Мне от этого мало радости."
                                            },
                                            {
                                                "example_id": "41fbe000-4f92-48d9-bc23-0b38bd9b07ff",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Доставлять радость."
                                            },
                                            {
                                                "example_id": "62f576c1-2d64-4a53-91a5-8d63e1fbb3cd",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Испытывать радость."
                                            },
                                            {
                                                "example_id": "23e807ab-af0f-4b67-8380-0b42b38c1008",
                                                "sense_id": "8c20ae07-707a-3fd3-b2b1-a4f54643c4b5",
                                                "text": "Радость светится в глазах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d2bcbe-0a5b-3108-a7c5-0e046fd0e2a2",
                                        "entry_id": "81ab8dec-d324-3aa9-992d-0b5c6dec8274",
                                        "glosses": [
                                            "событие, предмет, возбуждающие такое чувство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ccece68-963b-43f4-a13a-7bcbe4139bbe",
                                                "sense_id": "70d2bcbe-0a5b-3108-a7c5-0e046fd0e2a2",
                                                "text": "Радости для меня миновались."
                                            },
                                            {
                                                "example_id": "c3dec4f2-a814-48ce-afd4-c861b57282d0",
                                                "sense_id": "70d2bcbe-0a5b-3108-a7c5-0e046fd0e2a2",
                                                "text": "И радость, и печаль — всё было пополам."
                                            },
                                            {
                                                "example_id": "f6461dea-a4b4-4f6f-9248-5bd16123da95",
                                                "sense_id": "70d2bcbe-0a5b-3108-a7c5-0e046fd0e2a2",
                                                "text": "Какая радость!"
                                            },
                                            {
                                                "example_id": "2ad11b23-a982-4e48-9ecd-6f936a102a32",
                                                "sense_id": "70d2bcbe-0a5b-3108-a7c5-0e046fd0e2a2",
                                                "text": "Радости жизни (всё то, что сопровождается удовольствием, что доставляет удовольствие в жизни)."
                                            },
                                            {
                                                "example_id": "8e820265-1805-40f5-9127-93f769e0f096",
                                                "sense_id": "70d2bcbe-0a5b-3108-a7c5-0e046fd0e2a2",
                                                "text": "С какой радости я буду это делать?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e14dfab-2998-3195-8532-d6fab327eb88",
                                        "entry_id": "81ab8dec-d324-3aa9-992d-0b5c6dec8274",
                                        "glosses": [
                                            "разг. · милый, любимый"
                                        ],
                                        "tags": [
                                            "употребляется при обращении в значении"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2178d3b8-d7f0-4b6e-b727-dfdf7bc9b98b",
                                                "sense_id": "5e14dfab-2998-3195-8532-d6fab327eb88",
                                                "text": "Слушая повесть твою, полюбил я тебя, моя радость."
                                            },
                                            {
                                                "example_id": "966070d2-f70a-4a30-ab65-d03ba4ef312c",
                                                "sense_id": "5e14dfab-2998-3195-8532-d6fab327eb88",
                                                "text": "Ах, радость моя! мне ми́ло твое чистосердечие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcda7028-6597-4b12-9940-abf9362af5df",
                        "source_entry_id": "bb187e7f-10f1-3953-81a5-c9d8df7801bc",
