                ],
                "senses": [
                    {
                        "sense_id": "76c578a7-acee-356f-a872-ccdb8003f64c",
                        "entry_id": "4484699b-ea03-345f-9c30-6ff4bb01d938",
                        "glosses": [
                            "Forme pronominale de offrir : se payer quelque chose à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcbe722b-0fb7-418a-863c-cd8f6893ff37",
                                "sense_id": "76c578a7-acee-356f-a872-ccdb8003f64c",
                                "text": "Il vivait comme vivent bien des Parisiens qui ont perdu leur femme étant jeunes, c'est-à-dire qu'il ne se privait pas de s'offrir des consolations, mais il avait toujours sauvegardé les apparences."
                            },
                            {
                                "example_id": "d16b7491-56d8-4065-9670-044f52c3e56d",
                                "sense_id": "76c578a7-acee-356f-a872-ccdb8003f64c",
                                "text": "Elle s’est donnée à lui, elle ne l’a pas pris. Moi, je me l’étais offert."
                            },
                            {
                                "example_id": "448fcd3e-132e-442f-9458-059da34df953",
                                "sense_id": "76c578a7-acee-356f-a872-ccdb8003f64c",
                                "text": "Un de ses grands luxes était sa collection de montres. Toutes les Breitlings. Il venait de s'offrir la toute dernière, la chronographe « Bentley Motors » qui lui donnait l'impression d'être un lord anglais."
                            }
                        ]
                    },
                    {
                        "sense_id": "c65210d0-1764-3f99-bc5e-68fa54719811",
                        "entry_id": "4484699b-ea03-345f-9c30-6ff4bb01d938",
                        "glosses": [
                            "Se présenter."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "155bf554-ee1a-4bbe-8813-fb241816243d",
                                "sense_id": "c65210d0-1764-3f99-bc5e-68fa54719811",
                                "text": "Voir une opportunité s'offrir."
                            }
                        ]
                    },
                    {
                        "sense_id": "27fdafeb-1092-3b54-b602-fb4914fbe897",
                        "entry_id": "4484699b-ea03-345f-9c30-6ff4bb01d938",
                        "glosses": [
                            "Se donner."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "163faaa0-bdf8-3466-b83a-3b1cb23db929",
                        "entry_id": "4484699b-ea03-345f-9c30-6ff4bb01d938",
                        "glosses": [
                            "Se donner sexuellement."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "dca1b198-a9b8-4d91-8ec7-fee5cf5c7e0c",
                                "sense_id": "163faaa0-bdf8-3466-b83a-3b1cb23db929",
                                "text": "Mais dans le Royaume-Uni des années 1970, la reine refuse l'union de son fils avec une femme qui s'était offerte avant le mariage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92113f71-73ac-4b17-a6b5-604adcabdae0",
                        "source_entry_id": "4484699b-ea03-345f-9c30-6ff4bb01d938",
                        "target_lang_word": "sich bieten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e2c6954b-7ac3-42d0-a9e5-dc92bd8ae981",
                        "source_entry_id": "4484699b-ea03-345f-9c30-6ff4bb01d938",
                        "target_lang_word": "erlauben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erlauben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a418c486-102e-30e4-8cdb-8b2eced8eece",
                                        "entry_id": "375193dd-5060-3b81-b83a-bf0f3c231287",
                                        "glosses": [
                                            "jemandem die Zustimmung oder die Möglichkeit geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affb9f79-fc18-4b1c-8b2f-22844d47c5ff",
                                                "sense_id": "a418c486-102e-30e4-8cdb-8b2eced8eece",
                                                "text": "Ich erlaube dir heute, länger wach zu bleiben."
                                            },
                                            {
                                                "example_id": "a36a7521-a50e-47fd-be69-7b81e069cebe",
                                                "sense_id": "a418c486-102e-30e4-8cdb-8b2eced8eece",
                                                "text": "„Zum Glück erlaubte der von allem Antiken begeisterte Kirchenfürst sehr bald, dass Abschriften hergestellt wurden.“"
                                            },
                                            {
                                                "example_id": "8195a198-dfce-401f-8ca5-b1227fa0b383",
                                                "sense_id": "a418c486-102e-30e4-8cdb-8b2eced8eece",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79917ee7-9d22-3d9a-b183-fd5c6ee52af3",
                                        "entry_id": "375193dd-5060-3b81-b83a-bf0f3c231287",
                                        "glosses": [
                                            "etwas tun, das gegen eine Regel oder Konvention verstößt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad52c000-28fe-42a7-ae68-0cd5de1b822f",
                                                "sense_id": "79917ee7-9d22-3d9a-b183-fd5c6ee52af3",
                                                "text": "Trotz meines hohen Blutdruckes erlaube ich mir heute eine Zigarre."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "edd75cc8-fe9d-3f54-be8d-7e4616a42d21",
                                        "entry_id": "375193dd-5060-3b81-b83a-bf0f3c231287",
                                        "glosses": [
                                            "etwas tun können, weil man über die nötigen Mittel verfügt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1ecc538-825d-4bd5-a43b-eb01d41688fe",
                                                "sense_id": "edd75cc8-fe9d-3f54-be8d-7e4616a42d21",
                                                "text": "Ich habe mir heute eine neue Tasche erlaubt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
