                "entry_id": "abe6bf63-bb02-336a-9b01-74407e0ec4f6",
                "word": "snobbery",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f2c79704-c2ca-4853-b1d8-d2d015d461e3",
                        "entry_id": "abe6bf63-bb02-336a-9b01-74407e0ec4f6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more snobbery"
                    },
                    {
                        "form_id": "6c994c85-b07f-4a99-93eb-9879d3b9854a",
                        "entry_id": "abe6bf63-bb02-336a-9b01-74407e0ec4f6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most snobbery"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1834a453-79fb-300f-a704-fa8c2619309c",
                        "entry_id": "abe6bf63-bb02-336a-9b01-74407e0ec4f6",
                        "glosses": [
                            "Synonym of snobby."
                        ],
                        "tags": [
                            "colloquial",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "94681383-667c-4ade-b1f2-eeb20662a40f",
                                "sense_id": "1834a453-79fb-300f-a704-fa8c2619309c",
                                "text": "The only thing Volksworld acts snobbery about is the amount of dangerously built shit they have had to put with over the years."
                            },
                            {
                                "example_id": "7e654b72-bb2e-44f2-8477-7a308076720e",
                                "sense_id": "1834a453-79fb-300f-a704-fa8c2619309c",
                                "text": "When I was at college, studying music, ALW [Andrew Lloyd Webber] music was frowned upon. In fact all show-type music was seen as non-classical, and non-innovative! Looks were given by staff, if someone were heard jamming ALW tunes. […] It is just so snobbery!! I think attitudes have changed slightly since I was there."
                            },
                            {
                                "example_id": "8a88c3bc-eb67-4fef-9fb2-21d8f4eca199",
                                "sense_id": "1834a453-79fb-300f-a704-fa8c2619309c",
                                "text": "He seemed all right to me. Didn't act snobbery like so many Kappins."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
