                                        "entry_id": "6d22db3f-4352-34e8-b141-351845d62647",
                                        "glosses": [
                                            "Período de oración ofrecido durante nueve días consecutivos, para alguna celebración, solemnidad o petición."
                                        ],
                                        "tags": [
                                            "se aplica también a donaciones o sufragios por difuntos y al libro que se emplee para rezar una novena"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bdf97fc-d80d-470d-937a-431f8a75d8e1",
                                                "sense_id": "0b40e850-afb4-39f9-a007-747cfef0786a",
                                                "text": "—No, padre Carlos, por favor, no me hable de novenas, de nada piadoso… Si estoy aquí es porque hace agradable y fresco a esta hora del día."
                                            }
                                        ],
