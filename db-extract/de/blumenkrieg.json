                "senses": [
                    {
                        "sense_id": "bc9cf5cc-ee90-3eaf-bacb-f64647b9845e",
                        "entry_id": "7e0834cf-5676-3be0-8e30-a6e4283c28e9",
                        "glosses": [
                            "von den Azteken und verwandten Völkern geführte Feldzüge, welche der Beschaffung von Kriegsgefangenen für Menschenopfer dienten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e813fd6d-258e-43ac-ae8a-09ffc8f82f7b",
                                "sense_id": "bc9cf5cc-ee90-3eaf-bacb-f64647b9845e",
                                "text": "„Vermutlich deshalb begannen die Mexica die sogenannten Blumenkriege, eine Art Olympische Spiele, die alle paar Jahre veranstaltet wurden.“"
                            },
                            {
                                "example_id": "be4bb2a1-c132-4f57-bc62-ffd1893dff4d",
                                "sense_id": "bc9cf5cc-ee90-3eaf-bacb-f64647b9845e",
                                "text": "„In sogenannten Blumenkriegen (xochiyaoyatl) wurden Gefangene gemacht, die dazu dienten, für die Götter geopfert zu werden.“"
                            },
                            {
                                "example_id": "6308295b-b6fd-4c45-8b31-a39f441504fc",
                                "sense_id": "bc9cf5cc-ee90-3eaf-bacb-f64647b9845e",
                                "text": "„Eine Sonderfunktion kam demgegenüber den sogenannten Blumenkriegen zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
