                        "target_lang_word": "silent as the grave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silent as the grave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8435978-87b3-3969-832e-019f498d3540",
                                        "entry_id": "28f4b56c-a68f-3db3-b6cb-4f866a0fca90",
                                        "glosses": [
                                            "Saying absolutely nothing (especially about a particular subject)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9809ecab-f505-4273-bc56-2177c1ef1af1",
                                                "sense_id": "f8435978-87b3-3969-832e-019f498d3540",
                                                "text": "The investigation is ongoing, but all the suspects have been silent as the grave so far."
                                            },
                                            {
                                                "example_id": "361c6cdd-f160-45df-829e-7ed71ff93de2",
                                                "sense_id": "f8435978-87b3-3969-832e-019f498d3540",
                                                "text": "“Livesey,” returned the squire, “you are always in the right of it. I’ll be as silent as the grave.”"
                                            },
                                            {
                                                "example_id": "0fcd44c1-7f90-4aea-afe9-3692e6615a4d",
                                                "sense_id": "f8435978-87b3-3969-832e-019f498d3540",
                                                "text": "“Well, then, if you’re bound to go, I’ll tell you the way to do when you get to the village. Shut the door and blindfold the doctor tight and fast, and make him swear to be silent as the grave, and put a purse full of gold in his hand, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de3de3f-a519-3ff4-bd57-cbfbc32c73a6",
                                        "entry_id": "28f4b56c-a68f-3db3-b6cb-4f866a0fca90",
                                        "glosses": [
                                            "Deathly still and silent."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754a8ac0-11b3-407a-b3d7-0edb815c8607",
                                                "sense_id": "9de3de3f-a519-3ff4-bd57-cbfbc32c73a6",
                                                "text": "The abandoned village is silent as the grave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
