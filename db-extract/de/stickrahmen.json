                        "sense_id": "3b892a10-e73b-34bc-9611-b143640f8c4d",
                        "entry_id": "0310759c-1cd3-32e1-8b2b-36b2cdf1ca88",
                        "glosses": [
                            "Gerät für Handarbeit, in das ein Stück Stoff eingespannt werden kann, das bestickt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2759459-2eda-497a-a8b7-b69751cf3767",
                                "sense_id": "3b892a10-e73b-34bc-9611-b143640f8c4d",
                                "text": "„Thomas sah ihnen nach, und die Schwester, die mit ihrem Stickrahmen ihm gegenübersaß, schlug mit der flachen Hand auf den Tisch.“"
                            },
                            {
                                "example_id": "bfc54f7c-f52a-424e-8b2c-7c86a39ef52a",
                                "sense_id": "3b892a10-e73b-34bc-9611-b143640f8c4d",
                                "text": "„Die beiden Schwestern, die mit Angela am Stickrahmen arbeiteten, waren deren beste Freundinnen und in alle ihre Geheimnisse eingeweiht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
