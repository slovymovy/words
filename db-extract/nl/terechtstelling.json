                ],
                "translations": [
                    {
                        "translation_id": "e32c8e82-519e-4b87-85e5-9a7a302a97ab",
                        "source_entry_id": "f5278b0c-f33a-3424-ab4a-35a5a005efd4",
                        "source_sense_id": "103216c8-c07c-3ca3-b28c-82eebc517f2d",
                        "target_lang_word": "Hinrichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinrichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                        "entry_id": "6fb28562-8ad5-3de2-a8ac-9703fcfc10e3",
                                        "glosses": [
                                            "die Tötung eines sich in der Gewalt der Hinrichtenden befindlichen, gefangenen Menschen, meist als Vollzug einer von den Justizbehörden eines Landes ausgesprochenen Todesstrafe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706836f8-eee9-4702-bf3f-fefb6d92619f",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "Die Hinrichtung wurde wegen heftiger internationaler Proteste verschoben."
                                            },
                                            {
                                                "example_id": "dc0e4656-5df6-414a-bbce-582d1b499f0d",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "„Seine Hinrichtung stand bereits vor Beginn des Nürnberger Prozesses fest.“"
                                            },
                                            {
                                                "example_id": "9656322c-e4a4-44ce-a414-01e515ed3c0d",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "„Jeder derartige Versuch werde unnachgiebig mit der Hinrichtung bestraft.“"
                                            },
                                            {
                                                "example_id": "5850f316-1b71-4a6d-ba37-70ab2f7fa537",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "Die Menschenrechtsorganisation Amnesty International registrierte [im Jahr 2017 weltweit] 993 Hinrichtungen und damit vier Prozent weniger als im Vorjahr."
                                            },
                                            {
                                                "example_id": "d53f5b53-9c79-4209-8d08-8ca4621b69c2",
                                                "sense_id": "b29792e8-e2ee-307c-8839-c3f02e2d4cff",
                                                "text": "Amnesty geht davon aus, dass es dort [in China] Jahr für Jahr Tausende Todesurteile und Hinrichtungen gibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hinrichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                        "entry_id": "20bcaffa-c215-3830-b130-49ce61c75210",
                                        "glosses": [
                                            "vorwärts, hinzu verlaufende Richtung; Bewegung oder Übergang zu etwas hin im Gegensatz zum umgekehrten, rückwärtigen Verlauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff0c7d11-ba3d-4c97-b959-2b9c8f14c9c0",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "Bei diesem Äquivalenzbeweis lässt sich die Hinrichtung leichter beweisen als die Rückrichtung."
                                            },
                                            {
                                                "example_id": "db4b1721-ece4-4b0f-a372-a8a808eb95e0",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "„Die Anzahl der Fahrten auf diesem Weg, in dieser Richtung, sei dann xᵢ (z.B. gerader Index für die Hinrichtung und ungerader Index für die Rückrichtung).“"
                                            },
                                            {
                                                "example_id": "d541be29-0d1c-4989-ae1a-4711a0d5dd9e",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "„Hinrichtung und Rückrichtung einer Strecke sind im Netzmodell zwei eigenständige Objekte, denen die gleiche Streckennummer zugeordnet ist und deren Von-Knoten-Nummer und Nach-Knoten-Nummer gerade vertauscht sind.“"
                                            },
                                            {
                                                "example_id": "1ab81a2d-b580-4586-ad41-e5b313958d1f",
                                                "sense_id": "203f238b-dfbd-3dd8-84b5-6a0dbc4f8c79",
                                                "text": "„Der Wert der Signalgeschwindigkeit in Rückrichtung BA ergibt sich als Folgerung aus der Festlegung des Wertes der Signalgeschwindigkeit in Hinrichtung AB.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aeb71408-8fac-4ddb-b649-2555e7a0d7cd",
                        "source_entry_id": "f5278b0c-f33a-3424-ab4a-35a5a005efd4",
