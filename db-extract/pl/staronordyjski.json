                "translations": [
                    {
                        "translation_id": "ce4e2be7-df12-4504-bc1f-077bcf2796a3",
                        "source_entry_id": "629b47c4-1d12-302d-ac0b-ac7346ce5430",
                        "source_sense_id": "bbf607a2-2119-36ef-9718-857c1b92b595",
                        "target_lang_word": "Old Norse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Old Norse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3df1a035-46b0-3a05-a9eb-d1f423b69557",
                                        "entry_id": "87bbbd41-ccd4-3396-abc7-bd0d9087ebb2",
                                        "glosses": [
                                            "The language of Scandinavia until the 14th century, the common ancestor of modern Swedish, Danish, Norwegian, Faroese, and Icelandic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9ff446-bfe8-4821-a0b5-eef96a6fe27e",
                        "source_entry_id": "629b47c4-1d12-302d-ac0b-ac7346ce5430",
                        "source_sense_id": "bbf607a2-2119-36ef-9718-857c1b92b595",
                        "target_lang_word": "Altnordisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altnordisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f1c1137-4121-3765-9a1f-ba3e3b37e7eb",
                                        "entry_id": "0cbaa44d-10df-35c8-9c60-27c59f4cf87e",
                                        "glosses": [
                                            "Bezeichnung für verschiedene ausgestorbene skandinavische Sprachen, die zwischen 800 und 1500 gesprochen wurden (zum Beispiel Altnorwegisch und Altisländisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2baa7b-9194-4319-a342-db5bf629ca47",
                                                "sense_id": "3f1c1137-4121-3765-9a1f-ba3e3b37e7eb",
                                                "text": "„Allmählich wurde das Altnordische zum Transportmittel einer großen und vielfältigen mundartlichen Literatur – einzigartig im mittelalterlichen Europa.“"
                                            },
                                            {
                                                "example_id": "70fcfee6-fe83-4479-b683-a1672151b129",
                                                "sense_id": "3f1c1137-4121-3765-9a1f-ba3e3b37e7eb",
                                                "text": "„Bemerkenswert ist, dass sich das Isländische (zusammen mit dem Färöischen) in den letzten tausend Jahren im Bereich der Formenlehre (Morphologie) kaum verändert hat und somit dem Altnordischen noch am ehesten ähnelt.“"
                                            },
                                            {
                                                "example_id": "76bc8769-e479-48f0-9245-c0d5c4a7c242",
                                                "sense_id": "3f1c1137-4121-3765-9a1f-ba3e3b37e7eb",
                                                "text": "„Dann aber brach diese Einheit auseinander, und nun setzte im Norden eine stürmische und radikale und im wesentlichen selbständige Umwandlung der Sprache ein, die dazu führte, daß das Altnordische, das daraus entstand und um 800 so gut wie fertig ausgebildet war, ein gänzlich anderes Gepräge hatte als das Urnordische und auch das Westgermanische derselben Zeit.“"
                                            },
                                            {
                                                "example_id": "ed3b383c-0bd3-408a-b2de-29cc010d9bd8",
                                                "sense_id": "3f1c1137-4121-3765-9a1f-ba3e3b37e7eb",
                                                "text": "„Die älteren gehören dem Urgermanischen (Urnordischen), die jüngeren dem Altnordischen mit seinen verschiedenen Dialekten an.“"
                                            },
                                            {
                                                "example_id": "fc66b308-c70e-4e2d-b581-b0d65b499f33",
                                                "sense_id": "3f1c1137-4121-3765-9a1f-ba3e3b37e7eb",
                                                "text": "„Zeugnisse mythologischen Inhalts - zum Beispiel aus dem Altnordischen - belegen die ältesten Quellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
