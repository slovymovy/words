                        "entry_id": "b7a68f67-9a16-3bf8-846a-fb6825483068",
                        "glosses": [
                            "Soße auf Basis von Champignonfonds, Paprika, Zwiebeln und Tomaten"
                        ],
                        "tags": [
                            "teilweise als abwertend verstanden"
                        ],
                        "examples": [
                            {
                                "example_id": "689dd0e6-4eb0-4b04-b938-148a3a9adba5",
                                "sense_id": "8ae99d8b-bc25-35b6-8102-4edd66721efb",
                                "text": "Sein Schnitzel bestellte er mit Zigeunersoße."
                            },
                            {
                                "example_id": "1ce46537-6ebc-4855-8cb8-490af6f33afd",
                                "sense_id": "8ae99d8b-bc25-35b6-8102-4edd66721efb",
                                "text": "„Zigeunersoße ist eine der beliebtesten Soßen der Deutschen, respektive im deutschsprachigen Raum, die gerne zu Koteletts oder Schnitzel gereicht wird.“"
                            },
                            {
                                "example_id": "9c526326-c052-4d46-a064-92a5eed47e0d",
                                "sense_id": "8ae99d8b-bc25-35b6-8102-4edd66721efb",
                                "text": "„Die Lebensmittelmarke Homann hat ihre frühere ‚Zigeunersoße‘ umbenannt, nennt sie jetzt ‚Paprika Sauce Balkan-Art‘ bzw. ‚Scharfe Paprika-Sauce Balkan Art‘.“"
                            }
                        ],
