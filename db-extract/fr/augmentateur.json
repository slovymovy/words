                        "sense_id": "4be19262-9a48-326a-8209-51f8b0694637",
                        "entry_id": "49ca9c13-c40b-380e-bc92-02eae1c5da8f",
                        "glosses": [
                            "Celui qui augmente quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b75c569-ee31-441b-8e0c-459b568a5e91",
                                "sense_id": "4be19262-9a48-326a-8209-51f8b0694637",
                                "text": "Vilmouth, l’augmentateur du réel."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4325329-a8ce-3c76-8705-6208a44cc6e2",
                        "entry_id": "49ca9c13-c40b-380e-bc92-02eae1c5da8f",
                        "glosses": [
                            "Celui qui augmente le livre d’un autre écrivain."
                        ],
                        "tags": [
                            "dated",
                            "especially",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4ad6b71b-f9ad-47c2-903b-1d60c1ee0bba",
                                "sense_id": "c4325329-a8ce-3c76-8705-6208a44cc6e2",
                                "text": "De-là vint que l’Augmentateur de la Vie de sainte Geneviève, que M. L.B. croit avoir été un Diacre de l’Abbaye, apellé Felix , regarda son Eglise comme située juxta Novemenia Parisii. (sic)"
                            },
                            {
                                "example_id": "2210c7eb-4001-4a62-bf8a-38b1c756ff65",
                                "sense_id": "c4325329-a8ce-3c76-8705-6208a44cc6e2",
                                "text": "L’augmentateur du dictionnaire de l’Académie a adopté le mot inconvenant."
                            }
                        ]
                    },
                    {
                        "sense_id": "497b8010-76d4-3bd2-bd06-4aa8c3252022",
                        "entry_id": "49ca9c13-c40b-380e-bc92-02eae1c5da8f",
                        "glosses": [
                            "Dispositif permettant d’augmenter quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc099df-15d9-427a-aad4-6e0823d0e208",
                                "sense_id": "497b8010-76d4-3bd2-bd06-4aa8c3252022",
                                "text": "[…] participation commune au projet d’essai de vol d’un avion muni d’un augmentateur alaire."
                            }
                        ]
                    }
