                    {
                        "sense_id": "2232b26e-56d1-31dc-aeaf-1e8f7e503be8",
                        "entry_id": "a460d326-100c-33c2-8a5e-fe6f1a063b6e",
                        "glosses": [
                            "Ceinture épaisse pour recevoir l’extrémité des baux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4699982d-654b-4672-81b9-7f96e677b448",
                                "sense_id": "2232b26e-56d1-31dc-aeaf-1e8f7e503be8",
                                "text": "La ceinture superposée sur la bauquière sera entaillée dans la membrure, les écarts seront longs et à crochets."
                            },
                            {
                                "example_id": "0f9b3476-035d-4d2d-b547-a9e88defc0ab",
                                "sense_id": "2232b26e-56d1-31dc-aeaf-1e8f7e503be8",
                                "text": "Il part en cabine ranger soigneusement sa guitare, et, quand il remonte pour prendre sa place sur la bauquière externe du gaillard d’arrière, le bateau vogue déjà dans la rade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eaf5514-49f3-4ad5-b965-5eee486aa1e4",
                        "source_entry_id": "a460d326-100c-33c2-8a5e-fe6f1a063b6e",
                        "source_sense_id": "2232b26e-56d1-31dc-aeaf-1e8f7e503be8",
