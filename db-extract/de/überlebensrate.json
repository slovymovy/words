                "senses": [
                    {
                        "sense_id": "081bddcf-d199-36dd-aeba-a8c22f40d148",
                        "entry_id": "227a7e06-c42d-3c23-bcdf-8729f230a9ba",
                        "glosses": [
                            "Anzahl der Überlebenden, derjenigen Personen einer untersuchten Gruppe, die nicht versterben (in Prozent)"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "daca6887-6899-41f6-a777-c9f8c4d7e520",
                                "sense_id": "081bddcf-d199-36dd-aeba-a8c22f40d148",
                                "text": "„Um die Überlebensraten zu berechnen, hat es sich bewährt, Zeitspannen von 5 Jahren zu betrachten. Der Grund: Bei vielen Krebsarten haben Patienten, die die ersten 5 Jahre nach der Diagnose überlebt haben, gute Chancen auf eine dauerhafte Heilung, weil Rückfälle danach meist immer weniger wahrscheinlich werden.“"
                            },
                            {
                                "example_id": "22010429-12f4-4ad6-81a3-a2b3207b18d9",
                                "sense_id": "081bddcf-d199-36dd-aeba-a8c22f40d148",
                                "text": "Die Überlebensrate unter den Lungentransplantierten hat sich seit den 1980er Jahren kontinuierlich verbessert."
                            },
                            {
                                "example_id": "906bc45b-e2ff-45c3-b192-5685eb04cf39",
                                "sense_id": "081bddcf-d199-36dd-aeba-a8c22f40d148",
                                "text": "„Die Überlebensrate nach der neuen Therapie liegt durchweg über derjenigen der Standardbehandlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
