                "senses": [
                    {
                        "sense_id": "da719074-da9b-34c5-a71b-902833d7eafc",
                        "entry_id": "d22637a8-90ea-35d2-868b-2df134ea5967",
                        "glosses": [
                            "État d'équilibre réalisé à une profondeur dite profondeur de compensation, pour laquelle la pression de charge est la même en tout point."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36258bdc-c34a-460b-ac2b-68b9e7896591",
                                "sense_id": "da719074-da9b-34c5-a71b-902833d7eafc",
                                "text": "L’isostasie, c’est tout simplement l’application du principe d’Archimède qui veut qu’un corps plongé dans un fluide subit une poussée vers le haut égale à la masse du fluide déplacé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdbb8660-300f-4627-871e-c99525682039",
                        "source_entry_id": "d22637a8-90ea-35d2-868b-2df134ea5967",
                        "source_sense_id": "da719074-da9b-34c5-a71b-902833d7eafc",
                        "target_lang_word": "isostasy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isostasy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95442023-d542-31c7-9d88-e14d6ffccdb5",
                                        "entry_id": "37884748-2bab-3fd7-8352-8a1be4bc8f64",
                                        "glosses": [
                                            "The state of balance or pressure equilibrium thought to exist within the Earth's crust, whereby the upper lithosphere floats on denser magma beneath."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e25df0-ef83-4f55-9660-2810e755eae6",
                                                "sense_id": "95442023-d542-31c7-9d88-e14d6ffccdb5",
                                                "text": "The process of vertical movement, known as isostasy, was a foundation of geological belief for generations, though no-one had any really good theories as to how or why it happened."
                                            },
                                            {
                                                "example_id": "cac9ccb8-b9b6-41b8-9b98-89f63088a220",
                                                "sense_id": "95442023-d542-31c7-9d88-e14d6ffccdb5",
                                                "text": "A great thickness of comparatively light sedimentary rocks accumulating in a geosyncline would ultimately ‘rebound’ because of isostasy – like a depressed rubber duck bouncing back upwards in a bath."
                                            },
                                            {
                                                "example_id": "6b230e5c-7c01-47dd-b04d-1e78fdaaa00c",
                                                "sense_id": "95442023-d542-31c7-9d88-e14d6ffccdb5",
                                                "text": "When a continent carries an ice sheet, the weight of that sheet distorts the equilibrium, the isostasy that causes the crust to float as it does."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
