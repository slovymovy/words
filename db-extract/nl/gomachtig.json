                            },
                            {
                                "target_word": "gummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                        "entry_id": "679ce93c-115f-357f-8686-8194234b1842",
                                        "glosses": [
                                            "Clipping of gummy shark."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aef5989-16cd-4a58-b313-62f614c8c68a",
                                                "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                                "text": "Over there [the UK], gummies are called smooth hound and a six kilo fish would stop the nation."
                                            },
                                            {
                                                "example_id": "fb5d31fa-42fa-46b8-83de-8e74177a760b",
                                                "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                                "text": "2007, Bill Classon, Fishing Guide to Victoria′s Coastline, Australian Fishing Network, page 60,\nWestern Port is a great location to find gummies. […] Gummy sharks are one of the favoured species in Western Port and for good reason: they put up a strong fight and feed of fresh flake is pretty hard to beat."
                                            },
                                            {
                                                "example_id": "0f07979d-752b-433f-891e-95d39e5a3e3f",
                                                "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                                "text": "This area of vast mudflats is right at the top of the port is home to some of the best gummy shark fishing around.[…]As the water drops, the feeding gummies drop off the banks and wait in the channels for food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb7d80f-daec-300d-adcf-595533c56018",
                                        "entry_id": "679ce93c-115f-357f-8686-8194234b1842",
                                        "glosses": [
                                            "A sheep that is losing or has lost its teeth."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13b4082c-13cb-3d37-896f-e5f6071ce228",
                                        "entry_id": "7acc611d-adb6-39c3-a31d-805e4bae4e16",
                                        "glosses": [
                                            "Resembling gum (the substance)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7da0ac27-cfa1-369d-92f6-dd2c20b2cde6",
                                        "entry_id": "7acc611d-adb6-39c3-a31d-805e4bae4e16",
                                        "glosses": [
                                            "Covered with gum or a substance resembling gum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c046a0e-59bc-44d0-a6b2-465ff3754711",
                                                "sense_id": "7da0ac27-cfa1-369d-92f6-dd2c20b2cde6",
                                                "text": "the gummie bark of Firr or Pine"
                                            },
                                            {
                                                "example_id": "3a550095-9a5d-4faf-b864-34ca74af2907",
                                                "sense_id": "7da0ac27-cfa1-369d-92f6-dd2c20b2cde6",
                                                "text": "Then rubs his gummy eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f58749a-fecd-3908-ab62-5fd796e70691",
                                        "entry_id": "7acc611d-adb6-39c3-a31d-805e4bae4e16",
                                        "glosses": [
                                            "Thick; fat."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2455c15a-767f-4447-a47e-03022080adcf",
                                                "sense_id": "1f58749a-fecd-3908-ab62-5fd796e70691",
                                                "text": "Probably, in times gone by, when flowing gowns were seldom worn in England, some fashionable dame of high degree, having splay feet, or gummy ankles, might have put them under cover."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd33257c-d955-320f-9519-5a9eb4e6b662",
                                        "entry_id": "f3c5a6ab-de44-396c-9058-a220bd80cf07",
                                        "glosses": [
                                            "A gummi candy."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae7a859-fa02-4f9b-ada8-fbe8ec6ec118",
                                                "sense_id": "bd33257c-d955-320f-9519-5a9eb4e6b662",
                                                "text": "I opened the fridge to take out my lunch and gave her a gummy. She licked my hand gratefully as I placed the food into the microwave and when it was heated up, she watched me eat and when I was done, she licked my plate happily."
                                            },
                                            {
                                                "example_id": "2ecba639-fa40-41cc-9412-dc1fc00327be",
                                                "sense_id": "bd33257c-d955-320f-9519-5a9eb4e6b662",
                                                "text": "Cristina hands him a gummy but holds tight to her cupcake, for she's still working on it, and doesn't want to set it free yet."
                                            }
                                        ]
                                    }
                                ]
                            }
