                "senses": [
                    {
                        "sense_id": "8a6574c7-90d4-3d6f-8acc-a5f211102111",
                        "entry_id": "1fabfe75-7875-343c-b2e8-9d22f32b3f1e",
                        "glosses": [
                            "Faire cesser de bouillonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd43629f-0980-4004-bf0c-cdb27f046739",
                                "sense_id": "8a6574c7-90d4-3d6f-8acc-a5f211102111",
                                "text": "Parce que ça me décompresse, ça me débonde, ça me débouillonne, ça me décoince, ça me débloque !"
                            }
                        ]
                    },
                    {
                        "sense_id": "97a4649a-e39f-3649-b895-10d15862cf09",
                        "entry_id": "1fabfe75-7875-343c-b2e8-9d22f32b3f1e",
                        "glosses": [
                            "Cesser de bouillonner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9c8fa1e7-9dd8-4891-a40c-9295327ed777",
                                "sense_id": "97a4649a-e39f-3649-b895-10d15862cf09",
                                "text": "Eh bien, si cette vérité est incontestable, le peuple n’a-t-il pas le droit, lui, de débouillonner d’un excès de patriotisme qui le porte jusqu’au délire patriotique, lorsque cette tribune est presque une arène de gladiateurs ?"
                            }
                        ]
                    }
                ],
