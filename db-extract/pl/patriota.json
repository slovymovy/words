                                    },
                                    {
                                        "sense_id": "e94be1fd-51b8-3696-9962-e14796fa372d",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Personne qui adhère à l’idée de patrie, qui aime sa patrie et s’efforce de bien la servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef558bbf-35e9-4689-b50b-60684a177a72",
                                                "sense_id": "e94be1fd-51b8-3696-9962-e14796fa372d",
                                                "text": "Je me suis toujours appliqué à être un patriote, mais, en vérité, j’étais un patriote de salon."
                                            },
                                            {
                                                "example_id": "0dcdb856-2788-44e2-a230-d3c5d9a96fcd",
                                                "sense_id": "e94be1fd-51b8-3696-9962-e14796fa372d",
                                                "text": "L’empire assyrien, l’empire persan, l’empire d’Alexandre ne furent pas non plus des patries. Il n’y eut jamais de patriotes assyriens ; l’empire persan fut une vaste féodalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2ffc5d-3631-3f98-b2b7-f7e6c1172de3",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Résistant à l’occupant, dans les guerres de libération nationale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6010f886-1999-3314-bfe9-2acb3a003914",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Partisan de la Révolution française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a339150b-1000-3e96-bde6-fe342a4cb6b2",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Résistant à l’Occupation allemande de la France en 1940-1945, par opposition aux collaborateurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7b296e3-8aa9-345d-850d-5051b6b0bfd7",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Personne prônant le rattachement de Hong Kong à la Chine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbff675f-409b-4908-99e2-0f738206792d",
                                                "sense_id": "c7b296e3-8aa9-345d-850d-5051b6b0bfd7",
                                                "text": "Pour cause, le patriotisme est devenu synonyme de contrôle croissant de la Chine sur sa région administrative spéciale. Le PCC a ainsi réformé le système électoral de Hong Kong en adoptant une «loi sur les patriotes» qui interdit aux citoyens qui la violeraient d'exercer une fonction politique. Plus récemment, le parti a interdit ce qui est devenu l'hymne officieux de Hong Kong: une chanson contestataire intitulée «Glory to Hong Kong» («gloire à Hong Kong» en français)."
                                            },
                                            {
                                                "example_id": "070b5e83-60cb-4e4f-ab7b-000676e0a5d7",
                                                "sense_id": "c7b296e3-8aa9-345d-850d-5051b6b0bfd7",
                                                "text": "Le parti n’a plus de siège à l’Assemblée depuis que ses élus ont démissionné en 2020 pour protester contre la reprise en main chinoise et que Hongkong a remanié son système électoral en 2021 pour le réserver à des « patriotes ». Cela sonnait alors le début de la fin pour le Parti démocrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635d53ca-2c31-3b54-9b6e-b6afc25e81db",
                                        "entry_id": "35d15ab6-9007-3c44-817e-47dec9c6dd4b",
                                        "glosses": [
                                            "Membre du mouvement des Patriotes (essentiellement 1826-1840, et surtout 1837-1840)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patriote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3775ce0-8d06-3b7d-8e88-813564b9f4ca",
                                        "entry_id": "532407ed-82c0-3d29-9f57-06fab551b472",
                                        "glosses": [
                                            "Qui fait preuve d’un vif attachement envers sa patrie et la sert avec dévouement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6d3ab1-fdf4-4ec1-b0e3-935a82301241",
                                                "sense_id": "e3775ce0-8d06-3b7d-8e88-813564b9f4ca",
                                                "text": "En 1910, le parti pro-germanique secondait les attaques contre la Chambre des Lords, dont la majorité était patriote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c18ac0-2f92-305e-9029-def5872278ea",
                                        "entry_id": "532407ed-82c0-3d29-9f57-06fab551b472",
                                        "glosses": [
                                            "Partisan de la Révolution française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
