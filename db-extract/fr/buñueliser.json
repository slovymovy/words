                "senses": [
                    {
                        "sense_id": "89c3265d-a10a-33c6-a657-13e1bd3cf297",
                        "entry_id": "7d56c881-57fd-3dda-96b5-f57efab1cac9",
                        "glosses": [
                            "Donner un caractère rappelant Luis Buñuel à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3efe49e4-d32b-485c-9ab6-3a0327b31175",
                                "sense_id": "89c3265d-a10a-33c6-a657-13e1bd3cf297",
                                "text": "Je me demande, réflexion faite, (à quoi il faut du temps, évidemment), si le « non à Vichy » perdrait à inclure les pastilles du même nom, pour ce qu’elles ressemblent formellement aux dessins des molécules, —quel mot laid que ce « molécule »—, qui représentent la cure alternative aux desseins de la clinique qui porte si bien son nom, de ce qu’on y laisse ses allonges, en y chassant ses argots de clille-nique ; le certificat de moralité garantie par l’état-de-droit (dans ses bottes de Never, comme disent les Anglais) délesterait la clinique de cet obscur objet du désir en la buñuelisant d’un retour au symbolisme qui représente sa mise à pied."
                            },
                            {
                                "example_id": "4434e6aa-5e55-402e-9a2b-291244d1be52",
                                "sense_id": "89c3265d-a10a-33c6-a657-13e1bd3cf297",
                                "text": "On évite soigneusement de la “buñueliser” ou de la “ferreriser”"
                            }
                        ]
                    }
