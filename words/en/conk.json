    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9b249150-7121-332e-baab-428b4110186f",
                    "sense_definition": "To hit or strike, especially on the head.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falling branch nearly <w>conked</w> him on the head while he walked.",
                            "target_lang_translations": {
                                "it": "Il ramo caduto per poco non lo ha <w>colpito</w> alla testa mentre camminava."
                            }
                        },
                        {
                            "text": "He accidentally <w>conked</w> his friend with a tennis racket.",
                            "target_lang_translations": {
                                "it": "Ha accidentalmente <w>colpito</w> il suo amico con una racchetta da tennis."
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "strike",
                        "clobber",
                        "whack"
                    ],
                    "common_phrases": [
                        "conk on the head"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Colpire con forza, in particolare sulla testa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "colpire",
                                "target_lang_sense_clarification": "dare una botta"
                            },
                            {
                                "target_lang_word": "picchiare",
                                "target_lang_sense_clarification": "battere sulla testa"
                            },
                            {
                                "target_lang_word": "assestare un colpo",
                                "target_lang_sense_clarification": "dare un colpo secco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d894d9d-a272-3930-bf20-904a943440ae",
                    "sense_definition": "To break down, fail, or stop operating properly (usually followed by \"out\").",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stop_working",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our old car finally <w>conked</w> out right in the middle of the highway.",
                            "target_lang_translations": {
                                "it": "La nostra vecchia auto alla fine ci ha <w>mollato</w> proprio nel bel mezzo dell'autostrada."
                            }
                        },
                        {
                            "text": "If the engine <w>conks</w> during the journey, we will have to call for help.",
                            "target_lang_translations": {
                                "it": "Se il motore si <w>guasta</w> durante il viaggio, dovremo chiamare i soccorsi."
                            }
                        }
                    ],
                    "synonyms": [
                        "break down",
                        "fail"
                    ],
                    "common_phrases": [
                        "conk out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Guastarsi, smettere di funzionare o cedere all'improvviso (solitamente 'conk out')."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "mollare",
                                "target_lang_sense_clarification": "di macchinari o motori"
                            },
                            {
                                "target_lang_word": "piantare in asso",
                                "target_lang_sense_clarification": "smettere improvvisamente di funzionare"
                            },
                            {
                                "target_lang_word": "guastarsi",
                                "target_lang_sense_clarification": "rompersi improvvisamente"
                            },
                            {
                                "target_lang_word": "tirare le cuoia",
                                "target_lang_sense_clarification": "figurato per motore o veicolo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa7938ca-a5a2-3fce-a835-946045da793c",
                    "sense_definition": "To fall asleep suddenly from exhaustion, or to lose consciousness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sleep_unconscious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After working a double shift, she <w>conked</w> out on the sofa immediately.",
                            "target_lang_translations": {
                                "it": "Dopo aver fatto un doppio turno di lavoro, è <w>crollata</w> subito sul divano."
                            }
                        },
                        {
                            "text": "The exhausted runner <w>conked</w> out as soon as he crossed the finish line.",
                            "target_lang_translations": {
                                "it": "Il corridore esausto è <w>svenuto</w> appena tagliato il traguardo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass out",
                        "faint"
                    ],
                    "common_phrases": [
                        "conk out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Addormentarsi di colpo per l'estrema stanchezza, o svenire (solitamente 'conk out')."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "crollare",
                                "target_lang_sense_clarification": "dal sonno o dalla stanchezza"
                            },
                            {
                                "target_lang_word": "addormentarsi di colpo",
                                "target_lang_sense_clarification": "per sfinimento"
                            },
                            {
                                "target_lang_word": "svenire",
                                "target_lang_sense_clarification": "perdere i sensi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1a83ad3-216e-38fc-bda3-abd1a0dca2cc",
                    "sense_definition": "To straighten curly hair chemically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men used harsh chemicals to <w>conk</w> their hair in the mid-twentieth century.",
                            "target_lang_translations": {
                                "it": "A metà del Novecento gli uomini usavano prodotti chimici aggressivi per <w>stirare</w> i propri capelli."
                            }
                        },
                        {
                            "text": "He decided to <w>conk</w> his hair before attending the dance.",
                            "target_lang_translations": {
                                "it": "Decise di <w>lisciare chimicamente</w> i capelli prima di andare alla festa da ballo."
                            }
                        }
                    ],
                    "synonyms": [
                        "relax",
                        "straighten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to a mid-20th-century hairstyle"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Lisciare chimicamente i capelli ricci o crespi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "stirare chimicamente",
