                "senses": [
                    {
                        "sense_id": "457fa838-8795-3545-a206-6a2d678fd7a9",
                        "entry_id": "1372fc88-b3f2-37f6-b1ca-319aa70228d7",
                        "glosses": [
                            "утративший связь со своим социальным классом, морально опустившийся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca50e35-fba1-4df6-8064-432da25a911e",
                                "sense_id": "457fa838-8795-3545-a206-6a2d678fd7a9",
                                "text": "Эта отвратительная щель населена теми, кого на языке науки называют деклассированным элементом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
