                                "target_senses": [
                                    {
                                        "sense_id": "75b582de-947e-3045-b3ae-5dc1fd4dfd15",
                                        "entry_id": "e68f602b-7704-3162-ae93-d4373b8138fc",
                                        "glosses": [
                                            "Any part of an animal organism, such as an organ, limb or extremity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1574eddd-984d-4651-ad97-49e760383c0f",
                                                "sense_id": "75b582de-947e-3045-b3ae-5dc1fd4dfd15",
                                                "text": "Eighteen of the Alzheimer elderly were able to identify at least ten body-parts."
                                            },
                                            {
                                                "example_id": "eaad4373-4e21-4e04-8c16-907c8643c77e",
                                                "sense_id": "75b582de-947e-3045-b3ae-5dc1fd4dfd15",
                                                "text": "1997, Gerald Thorn, Phil Embleton, Encyclopedia of Bodybuilding\nHEAVY DUTY The low-set, high-intensity system (1 to 3 sets per bodypart) was popularized by Dr. Arthur Jones, inventor of the Nautilus equipment."
                                            },
                                            {
                                                "example_id": "6a348efc-ebfa-4c71-a2a6-c06a82b6c818",
                                                "sense_id": "75b582de-947e-3045-b3ae-5dc1fd4dfd15",
                                                "text": "Bodybuilders love to talk about their routines for this body part or that bodypart"
                                            },
                                            {
                                                "example_id": "64c3ac67-39ff-4f47-85f6-e74b2902651d",
                                                "sense_id": "75b582de-947e-3045-b3ae-5dc1fd4dfd15",
                                                "text": "The detached body part should be quickly irrigated to remove contaminants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "484a49cd-0c76-38e9-ad89-2ccc6b3c123c",
                                        "entry_id": "e68f602b-7704-3162-ae93-d4373b8138fc",
                                        "glosses": [
                                            "Any part of the body of a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb8beb28-a05a-4e7f-abe3-f1e8b215af37",
                        "source_entry_id": "14d98b83-5dbb-361e-a6a9-c62c37a366a3",
                        "source_sense_id": "8ae06f95-d58d-3ee6-862c-736a1ee53f79",
                        "source_sense_description": "onderdeel van een lichaam",
                        "target_lang_word": "membre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "membre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b442e5a0-b4d1-34a6-af46-3c85d22d57d6",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Partie extérieure du corps d’un être humain ou d’un animal, distinguée de toutes les autres par quelque fonction particulière. Note d’usage : Se dit principalement des bras et des jambes ; ne se dit jamais de la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdf4cad-7607-4eda-b77b-1b255af6712c",
                                                "sense_id": "b442e5a0-b4d1-34a6-af46-3c85d22d57d6",
                                                "text": "J’avais les membres roidis et ressentais une si pénible lassitude, que je restai longtemps sans pouvoir trouver le sommeil."
                                            },
                                            {
                                                "example_id": "12e945eb-a5f3-4adc-aa60-699b5c7f3f1a",
                                                "sense_id": "b442e5a0-b4d1-34a6-af46-3c85d22d57d6",
                                                "text": "Elle crispa ses membres pour que le jeune homme ne devinât point son trouble."
                                            },
                                            {
                                                "example_id": "ca3290e8-0eaf-486e-b2be-417cce6292e3",
                                                "sense_id": "b442e5a0-b4d1-34a6-af46-3c85d22d57d6",
                                                "text": "Se démettre, se casser un membre. — La fracture d’un membre. — Remettre un membre."
                                            },
                                            {
                                                "example_id": "c059d1c0-eda0-4907-b2e5-99e0a52b1698",
                                                "sense_id": "b442e5a0-b4d1-34a6-af46-3c85d22d57d6",
                                                "text": "Il ne peut s’aider d’aucun de ses membres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d9aac26-c8ad-3ab6-99a1-aa2581a2d03e",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Membre viril, pénis."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ed27f6-af8b-4240-99c0-ac2a1150f648",
                                                "sense_id": "5d9aac26-c8ad-3ab6-99a1-aa2581a2d03e",
                                                "text": "Aux femmes aussi, par dessus leurs chaperons au derrière, aucunes fois en mettoit faicts en forme d’un membre d’homme."
                                            },
                                            {
                                                "example_id": "e5435c9c-dc26-4930-94fe-f762c874b168",
                                                "sense_id": "5d9aac26-c8ad-3ab6-99a1-aa2581a2d03e",
                                                "text": "Si un vieux satyre vous montre son membre au détour d’une allée, vous n’êtes nullement obligée de lui montrer votre petit con par échange de courtoisie."
                                            },
                                            {
                                                "example_id": "a2707ca0-c141-4689-9549-7ee1c203df8f",
                                                "sense_id": "5d9aac26-c8ad-3ab6-99a1-aa2581a2d03e",
                                                "text": "Plus bas, à côté de la scène, une partie de l’assemblée s’agitait en découvrant, sur la nouvelle façade, sous les néons, le dessin d’un « membre », comme on dirait dans les livres. Il s’agissait d’un géant pénétrant, un obus céleste, qui adressait un clin d’œil joyeux aux invités stupéfaits."
                                            },
                                            {
                                                "example_id": "f1fcda49-4e46-43d8-b362-3ccc78555529",
                                                "sense_id": "5d9aac26-c8ad-3ab6-99a1-aa2581a2d03e",
                                                "text": "Quoique, parfois, je rêve encore de sa lourde poitrine. Opulente et chaude. Alors je me réveille le membre gonflé, comme un tronc débordant de sève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0e7c62-5d73-3b7c-875d-c222baefb876",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Élément d’un groupe humain."
                                        ],
                                        "tags": [
                                            "Plus courant",
                                            "Rarement au féminin pour décrire une femme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f458a9-9c32-494e-ac8d-a08d3668bb7a",
                                                "sense_id": "5c0e7c62-5d73-3b7c-875d-c222baefb876",
                                                "text": "Voit-elle la grimace agonisante d’un membre quelconque de la famille Kinck, […] ?"
                                            },
                                            {
                                                "example_id": "9fd0798c-4043-40a3-829f-34cf98b30eb1",
                                                "sense_id": "5c0e7c62-5d73-3b7c-875d-c222baefb876",
                                                "text": "Sur les trois finalistes, une quinquagénaire, une sexagénaire et une octogénaire, on retrouve ainsi la présidente des Visca Tolosa et une membre éminente du Club des supporters des Violets."
                                            },
                                            {
                                                "example_id": "9a07fb4b-8536-4478-9516-e3fac3ca1394",
                                                "sense_id": "5c0e7c62-5d73-3b7c-875d-c222baefb876",
                                                "text": "La CIIVISE a d’abord été conçue comme une instance collégiale et pluridisciplinaire. Elle réunit ainsi 23 membres : experts de la santé, de la police et de la justice, de la protection de l’enfance, de la promotion des droits des personnes en situation de handicap, de la lutte contre les violences sexuées, de l’éducation ou fondateurs d’associations d’aide aux victimes et de plaidoyer."
                                            },
                                            {
                                                "example_id": "e1bdd385-2b27-481d-8b88-4a07898f3176",
                                                "sense_id": "5c0e7c62-5d73-3b7c-875d-c222baefb876",
                                                "text": "Cet État était alors membre de la confédération germanique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b735dbb9-0c1c-3379-9c5f-4a0968af6b02",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Chacune des personnes qui composent un corps constitué dans l’État, une société littéraire ou savante, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "919eba5c-30c7-4d11-b11e-0ee215e71c93",
                                                "sense_id": "b735dbb9-0c1c-3379-9c5f-4a0968af6b02",
                                                "text": "Du haut en bas de l’échelle, tous les membres d’une armée vraiment solide ont leur pensée tendue vers cette issue catastrophique des conflits internationaux."
                                            },
                                            {
                                                "example_id": "482c2cc1-2e1e-49dc-af18-bb9d8d765914",
                                                "sense_id": "b735dbb9-0c1c-3379-9c5f-4a0968af6b02",
                                                "text": "Selon les statuts de cette société savante, ses futurs membres s'engageaient à offrir, pour leur intronisation, leur portrait grandeur nature. Bach fit donc peindre son portrait par Elias Gottlob Haussmann, le peintre officiel de Leipzig."
                                            },
                                            {
                                                "example_id": "f79c147a-d82d-478f-b11c-7750a707c26f",
                                                "sense_id": "b735dbb9-0c1c-3379-9c5f-4a0968af6b02",
                                                "text": "Lundi 29 janvier, l’ambassade de France à Budapest a remis la Légion d’honneur à une membre du gouvernement Orbán."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3728c38d-7b0e-3695-82f1-69a11aafc45e",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Partie distincte d’un tout."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "588c8fc6-a21c-3807-9783-b23bdd7e0ecd",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Partie distincte d’un tout.",
                                            "Chaque partie d’une période ou d’une phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be743bd0-4009-4222-bc94-1ce4e021521c",
                                                "sense_id": "588c8fc6-a21c-3807-9783-b23bdd7e0ecd",
                                                "text": "Les membres d’une période."
                                            },
                                            {
                                                "example_id": "6e0e1a16-8bf6-4e0e-81f4-cd6e41e15a03",
