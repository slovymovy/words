                ],
                "senses": [
                    {
                        "sense_id": "7080cb48-a454-3492-ac8b-b779ec4f8976",
                        "entry_id": "15d10c1f-c855-3eec-bf03-7a85e19f22da",
                        "glosses": [
                            "Faire quelque chose, mais rien d’efficace."
                        ],
                        "tags": [
                            "Suisse",
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "ab4afe3b-1e9c-4b5d-844b-a8afdc7a5099",
                                "sense_id": "7080cb48-a454-3492-ac8b-b779ec4f8976",
                                "text": "Que va-t-on alors bien pouvoir « foutimasser » de ces millions de vaccins inutiles ?"
                            },
                            {
                                "example_id": "6a8ee85d-df54-4ebd-aead-da6ed65014ef",
                                "sense_id": "7080cb48-a454-3492-ac8b-b779ec4f8976",
                                "text": "Loin de nous l'idée de foutimasser, de miquemaquer, pas plus que de potringuer, je le jure, ni même de jouer à la courate."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1dc10f9-e09a-3911-8759-7c410a0675f9",
                        "entry_id": "15d10c1f-c855-3eec-bf03-7a85e19f22da",
                        "glosses": [
                            "S’amuser à des riens, perdre son temps."
                        ],
                        "tags": [
                            "Ille-et-Vilaine"
                        ],
                        "examples": [
                            {
                                "example_id": "d6dacd43-5398-4aa4-9087-2c7097a08dda",
                                "sense_id": "a1dc10f9-e09a-3911-8759-7c410a0675f9",
                                "text": "Le docteur Ganche employait seulement pour son fils quelques mots dont je n’ai constaté qu’un rare usage et n’ai pas découvert l’origine. Il disait «foutimasser», pour: s’amuser à des riens, perdre son temps."
                            }
                        ]
                    }
                ],
