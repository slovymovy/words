                    {
                        "sense_id": "3eab6a60-e8e3-3853-93fd-c3833ca7de67",
                        "entry_id": "902c33b3-a3d2-3103-b182-b75ba25da072",
                        "glosses": [
                            "Mesure de terre jugée nécessaire pour faire vivre un homme et sa famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa55518-f067-459b-a11d-c4ea9573366d",
                                "sense_id": "3eab6a60-e8e3-3853-93fd-c3833ca7de67",
                                "text": "Il y avait des manses appartenant à des hommes libres et des manses serviles."
                            }
                        ]
                    },
                    {
                        "sense_id": "feab243f-e510-31e9-9ed1-7eeabd5d127e",
                        "entry_id": "902c33b3-a3d2-3103-b182-b75ba25da072",
                        "glosses": [
                            "Tenure correspondant à une parcelle agricole suffisamment importante pour nourrir une famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62aeb4a7-664c-4e77-827c-7f62fc153140",
                                "sense_id": "feab243f-e510-31e9-9ed1-7eeabd5d127e",
                                "text": "Le manse traduit dans l’environnement et dans la société les droits et les obligations du chef de ménage : occuper avec sa famille un territoire rural de manière permanente (mansus vient de manere, « vivre à demeure ») et héréditaire."
                            }
                        ]
                    }
                ],
