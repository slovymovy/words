                                            {
                                                "example_id": "517459ff-f016-4723-bef8-b61c3909dd95",
                                                "sense_id": "436a6191-547d-341f-b65c-a15c2ebb735a",
                                                "text": "discretionary income"
                                            },
                                            {
                                                "example_id": "40277469-d34b-4195-a83b-56d3b99fec19",
                                                "sense_id": "436a6191-547d-341f-b65c-a15c2ebb735a",
                                                "text": "discretionary powers"
                                            },
                                            {
                                                "example_id": "b122576f-84b4-44c3-a517-745fa3038e14",
                                                "sense_id": "436a6191-547d-341f-b65c-a15c2ebb735a",
                                                "text": "The new normal: Will demand quickly return to pre-COVID levels?\nUnlikely, if only because with the country (and the world) in deep recession, many younger people will be in serious financial difficulty. A lack of disposable income simply won't allow them much discretionary travel."
                                            }
