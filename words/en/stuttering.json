{
    "word_family": [
        "stutter",
        "stutterer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdc70ec3-5a5b-3eb3-a785-3a4d7b901c27",
                    "sense_definition": "A speech disorder characterized by involuntary repetitions, prolongations, or blocks of sounds and syllables.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He underwent speech therapy as a child to help manage his <w>stuttering</w>.",
                            "target_lang_translations": {
                                "ru": "В детстве он проходил курс логотерапии, чтобы справиться со своим <w>заиканием</w>."
                            }
                        },
                        {
                            "text": "Severe <w>stuttering</w> can make public speaking extremely challenging for some individuals.",
                            "target_lang_translations": {
                                "ru": "Сильное <w>заикание</w> может сделать публичные выступления крайне сложными для некоторых людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "stammering"
                    ],
                    "common_phrases": [
                        "severe stuttering",
                        "speech therapy for stuttering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение речи, характеризующееся непроизвольными повторениями, удлинениями или задержками звуков и слогов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заикание",
                                "target_lang_sense_clarification": "дефект речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8254f080-38e8-3227-874b-5f95d045cc0a",
                    "sense_definition": "An instance or occurrence of speaking with a stutter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite a few nervous <w>stutterings</w> at the beginning, her presentation went very well.",
                            "target_lang_translations": {
                                "ru": "Несмотря на несколько нервных <w>запинок</w> в начале, её презентация прошла очень хорошо."
                            }
                        },
                        {
                            "text": "The listener could hear occasional <w>stutterings</w> in his voice when he became anxious.",
                            "target_lang_translations": {
                                "ru": "Слушатель мог заметить редкие <w>запинки</w> в его голосе, когда он начинал волноваться."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или проявление речи с заиканием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запинка",
                                "target_lang_sense_clarification": "в речи"
                            },
                            {
                                "target_lang_word": "заикание",
                                "target_lang_sense_clarification": "единичное проявление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f0282f3-60cc-3281-bd0c-745032578707",
                    "sense_definition": "Hesitant, faltering, or lacking smooth progress or development.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country is showing signs of a <w>stuttering</w> economic recovery after the recession.",
                            "target_lang_translations": {
                                "ru": "Страна демонстрирует признаки <w>неуверенного</w> экономического восстановления после рецессии."
                            }
                        },
                        {
                            "text": "They managed to secure a <w>stuttering</w> victory despite playing poorly in the second half.",
                            "target_lang_translations": {
                                "ru": "Им удалось вырвать <w>тяжелую</w> победу, несмотря на плохую игру во втором тайме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stuttering economy",
                        "stuttering start"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нерешительный, колеблющийся или лишенный плавного развития."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуверенный",
                                "target_lang_sense_clarification": "о развитии, прогрессе"
                            },
                            {
                                "target_lang_word": "прерывистый",
                                "target_lang_sense_clarification": "о процессе или росте"
                            },
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "о восстановлении или старте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56ad8b83-59f8-3135-b940-cb86537ac2f0",
                    "sense_definition": "Having a habit of speaking with a stutter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stuttering</w> child found it difficult to express his thoughts quickly.",
                            "target_lang_translations": {
                                "ru": "<w>Заикающемуся</w> ребенку было трудно быстро выражать свои мысли."
                            }
                        },
                        {
                            "text": "She spoke in a <w>stuttering</w> voice when she was put on the spot.",
                            "target_lang_translations": {
                                "ru": "Она говорила <w>запинающимся</w> голосом, когда её застали врасплох."
                            }
                        }
                    ],
                    "synonyms": [
                        "stammering"
                    ],
                    "common_phrases": [
                        "stuttering voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий привычку говорить с заиканием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заикающийся",
                                "target_lang_sense_clarification": "о человеке или голосе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e8a0ded-0f8e-37ad-9377-4133b6609155",
                    "sense_definition": "Present participle and gerund of <w>stutter</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>stuttering</w> so much that we could barely understand what he was trying to say.",
                            "target_lang_translations": {
                                "ru": "Он так сильно <w>заикался</w>, что мы едва могли понять, что он пытается сказать."
                            }
                        },
                        {
                            "text": "The engine started <w>stuttering</w> before finally dying on the highway.",
                            "target_lang_translations": {
                                "ru": "Двигатель начал <w>барахлить</w>, прежде чем окончательно заглохнуть на шоссе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола stutter (заикаться, барахлить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заикающийся",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "барахлящий",
                                "target_lang_sense_clarification": "о моторе или механизме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}