                ],
                "senses": [
                    {
                        "sense_id": "03b58246-26da-321f-89d2-667cb825ba60",
                        "entry_id": "39636edd-1f20-3a18-af28-6ca84bd1c0b0",
                        "glosses": [
                            "Getränk, das durch Mischen von Honig mit warmem Wasser zubereitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c390dd04-b236-4412-a171-f65ce3508e3f",
                                "sense_id": "03b58246-26da-321f-89d2-667cb825ba60",
                                "text": "„Sie saßen auf Ruhebetten, die aus demselben Stoffe wie der Tisch bestanden, jeder hatte einen ungeheuren Krug voll Honigwasser neben sich stehen, und das Mahl begann.“"
                            },
                            {
                                "example_id": "262346bf-38c2-4a79-9ef6-f834801d6e11",
                                "sense_id": "03b58246-26da-321f-89d2-667cb825ba60",
                                "text": "„Bei meinem verzweifelten Nachdenken, womit in aller Welt man solche Gäste bewirten könne – denn dass sie auf Kaffee, Kakao oder Schokolade sauer reagieren würden, schien mir sicher –, war ich auf den Gedanken gekommen, ihnen einen Topf voll Honigwasser machen zu lassen.“"
                            },
                            {
                                "example_id": "c87651de-2417-4b0a-82a5-4de6ad449036",
                                "sense_id": "03b58246-26da-321f-89d2-667cb825ba60",
                                "text": "„Das Volk betrank sich auf des Königs Wohl, wenn auch nur mit dünnem Bier und Honigwasser.“"
                            },
                            {
                                "example_id": "693bde2f-2567-4363-a0dc-c7d414ff2afb",
                                "sense_id": "03b58246-26da-321f-89d2-667cb825ba60",
                                "text": "„Sollten hinsichtlich der Schwangerschaft noch Zweifel bestehen, so trinke die Frau beim Zubettgehen Honigwasser; wenn sich darauf ein Gefühl der Schwere im Unterleib einstellt, so ist dies ein Beweis, daß die Frau ein Kind trägt.“"
                            },
                            {
                                "example_id": "bb30a6b0-73d2-48cd-a7c0-d18046fd1cf6",
                                "sense_id": "03b58246-26da-321f-89d2-667cb825ba60",
                                "text": "„Der König sandte Honig zu dem Jäger. Der Jäger kochte den Honig mit Wasser. Er nahm auch Wabenwachs, in dem noch Honig war, und steckte es in seine Schultertasche. Das Honigwasser gab er aber dem König.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
