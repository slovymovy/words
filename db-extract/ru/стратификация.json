                                        "examples": [
                                            {
                                                "example_id": "407f4dc0-d3f3-4fb2-ac21-3d98eb46ac57",
                                                "sense_id": "272dd55e-69fd-3ac2-9b23-d32c305168ea",
                                                "text": "Zunächst muss man eine Stratifikation des Logikprogramms vornehmen."
                                            },
                                            {
                                                "example_id": "f8fd72b4-c9b4-40c1-a2de-a0c7da5d5b23",
                                                "sense_id": "272dd55e-69fd-3ac2-9b23-d32c305168ea",
                                                "text": "Die Gesellschaft differenziert sich, es findet Stratifikation statt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05402038-ad22-3dbc-96a5-872f80b0c56e",
                                        "entry_id": "0e25957e-48d4-3c0c-9725-0f9364447ede",
                                        "glosses": [
                                            "Behandlung von Saat/Keimgut, es zum Beispiel warm, kalt oder feucht halten, um das Keimen zu ermöglichen/beschleunigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afa3600-bde3-45da-9849-bb53993101e0",
                                                "sense_id": "05402038-ad22-3dbc-96a5-872f80b0c56e",
                                                "text": "Das Saatgut wird zur Stratifikation in ein Gemisch aus Sand und Torf geschichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddceea7a-7551-4f7c-be72-98bb91ee60c1",
                        "source_entry_id": "40d02e38-37d5-38a4-b197-c08e074ede58",
