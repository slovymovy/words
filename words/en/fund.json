{
    "word_family": [
        "funding",
        "refund",
        "fundraiser",
        "defund",
        "underfund",
        "overfund"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1ec2830-b397-3aff-970b-095d2c33acf6",
                    "sense_definition": "A sum of money saved, collected, or provided for a particular purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community started a <w>fund</w> to help the victims of the flood.",
                            "target_lang_translations": {
                                "ru": "Местная община создала <w>фонд</w> помощи пострадавшим от наводнения.",
                                "tr": "Yerel topluluk, sel mağdurlarına yardım etmek için bir <w>fon</w> başlattı."
                            }
                        },
                        {
                            "text": "She contributes a small amount to her pension <w>fund</w> every month.",
                            "target_lang_translations": {
                                "ru": "Она ежемесячно вносит небольшую сумму в свой пенсионный <w>фонд</w>.",
                                "tr": "Her ay emeklilik <w>fonuna</w> küçük bir miktar yatırıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "capital",
                        "reserve",
                        "endowment",
                        "kitty"
                    ],
                    "common_phrases": [
                        "pension fund",
                        "emergency fund",
                        "trust fund",
                        "relief fund"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, накопленная или выделенная для определенной цели.",
                        "tr": "Belirli bir amaç için biriktirilmiş, toplanmış veya sağlanmış para miktarı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фонд",
                                "target_lang_sense_clarification": "денежные средства для определенной цели"
                            },
                            {
                                "target_lang_word": "капитал",
                                "target_lang_sense_clarification": "денежные средства, богатство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fon",
                                "target_lang_sense_clarification": "belirli bir amaç için ayrılan para"
                            },
                            {
                                "target_lang_word": "sermaye",
                                "target_lang_sense_clarification": "maddi kaynak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e266c63f-5fc2-31e9-a786-e150169f6c37",
                    "sense_definition": "An organization or investment vehicle that manages a pool of money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors were worried when the hedge <w>fund</w> reported significant losses.",
                            "target_lang_translations": {
                                "ru": "Инвесторы были обеспокоены, когда хедж-<w>фонд</w> сообщил о значительных убытках.",
                                "tr": "Hedge <w>fonu</w> önemli kayıplar bildirdiğinde yatırımcılar endişelendi."
                            }
                        },
                        {
                            "text": "He decided to put his savings into a low-risk mutual <w>fund</w>.",
                            "target_lang_translations": {
                                "ru": "Он решил вложить свои сбережения в паевой инвестиционный <w>фонд</w> с низким риском.",
                                "tr": "Birikimlerini düşük riskli bir yatırım <w>fonuna</w> yatırmaya karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "investment trust",
                        "mutual fund"
                    ],
                    "common_phrases": [
                        "hedge fund",
                        "index fund"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организация или инвестиционный инструмент, управляющий объединенным капиталом.",
                        "tr": "Toplu parayı yöneten bir kuruluş veya yatırım aracı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фонд",
                                "target_lang_sense_clarification": "организация или инвестиционный инструмент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fon",
                                "target_lang_sense_clarification": "yatırım kuruluşu veya aracı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6ca4a69-f73b-3fe6-bdf4-106831ef250e",
                    "sense_definition": "A large supply or quantity of something, especially qualities or knowledge, available to be used.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor possessed an immense <w>fund</w> of knowledge about ancient history.",
                            "target_lang_translations": {
                                "ru": "Профессор обладал огромным <w>запасом</w> знаний о древней истории.",
                                "tr": "Profesör, antik tarih hakkında muazzam bir bilgi <w>hazinesine</w> sahipti."
                            }
                        },
                        {
                            "text": "He entertained the guests all evening with his inexhaustible <w>fund</w> of stories.",
                            "target_lang_translations": {
                                "ru": "Весь вечер он развлекал гостей своим неиссякаемым <w>запасом</w> историй.",
                                "tr": "Tükenmez hikaye <w>hazinesiyle</w> bütün akşam konukları eğlendirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "reservoir",
                        "supply",
                        "wealth"
                    ],
                    "common_phrases": [
                        "fund of knowledge",
                        "fund of stories",
                        "fund of goodwill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой запас или количество чего-либо (знаний, качеств), доступное для использования.",
                        "tr": "Kullanılmaya hazır büyük miktarda kaynak, bilgi veya nitelik birikimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "резерв, количество чего-либо"
                            },
                            {
                                "target_lang_word": "фонд",
                                "target_lang_sense_clarification": "ресурсы, собрание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hazine",
                                "target_lang_sense_clarification": "bilgi veya nitelik birikimi"
                            },
                            {
                                "target_lang_word": "depo",
                                "target_lang_sense_clarification": "kaynak birikimi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37686c3b-1762-3c89-b842-917f6613ce6b",
                    "sense_definition": "To provide the money necessary to pay for a project, activity, or organization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government agreed to <w>fund</w> the construction of the new library.",
                            "target_lang_translations": {
                                "ru": "Правительство согласилось <w>профинансировать</w> строительство новой библиотеки.",
                                "tr": "Hükümet, yeni kütüphanenin inşaatını <w>finanse etmeyi</w> kabul etti."
                            }
                        },
                        {
                            "text": "They are looking for sponsors to <w>fund</w> their research expedition.",
                            "target_lang_translations": {
                                "ru": "Они ищут спонсоров, чтобы <w>профинансировать</w> свою исследовательскую экспедицию.",
                                "tr": "Araştırma gezilerini <w>finanse edecek</w> sponsorlar arıyorlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "finance",
                        "sponsor",
                        "subsidize",
                        "bankroll"
                    ],
                    "antonyms": [
                        "defund"
                    ],
                    "common_phrases": [
                        "fully funded",
                        "publicly funded",
                        "privately funded",
                        "government funded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять деньги, необходимые для оплаты проекта, деятельности или организации.",
                        "tr": "Bir proje, faaliyet veya kuruluşun masraflarını karşılamak için gerekli parayı sağlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансировать",
                                "target_lang_sense_clarification": "снабжать денежными средствами"
                            },
                            {
                                "target_lang_word": "спонсировать",
                                "target_lang_sense_clarification": "быть спонсором, оплачивать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "finanse etmek",
                                "target_lang_sense_clarification": "maddi kaynak sağlamak"
                            },
                            {
                                "target_lang_word": "fon sağlamak",
                                "target_lang_sense_clarification": "para veya para kaynağı ayırmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}