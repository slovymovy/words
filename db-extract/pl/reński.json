                                                "sense_id": "b1e6f605-b6ea-3f2c-ad3a-b744cfb3bfab",
                                                "text": "Tatík vzal si na cestu několik rýnských na útratu, nařídil domácím, co se má stát, a vydal se na cestu."
                                            },
                                            {
                                                "example_id": "503c786c-1c5d-4c8a-baed-79bc14fb7329",
                                                "sense_id": "b1e6f605-b6ea-3f2c-ad3a-b744cfb3bfab",
                                                "text": "Kolo kolo mlýnský, za čtyři rýnský, kolo se nám polámalo, mnoho škody nadělalo, udělalo bác!"
                                            }
                                        ]
                                    }
                                ]
                            },
