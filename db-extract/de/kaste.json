                            "singular"
                        ],
                        "form": "die Kaste"
                    },
                    {
                        "form_id": "fdd734d8-23f5-4bba-a106-072f59cd61eb",
                        "entry_id": "102f6f87-3cb3-3672-9ba2-128e09eed4de",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kasten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                        "entry_id": "102f6f87-3cb3-3672-9ba2-128e09eed4de",
                        "glosses": [
                            "geschlossene Gesellschaftsschicht innerhalb einer (insbesondere der hinduistischen) Gesellschaftsordnung"
                        ],
                        "tags": [
                            "Soziologie",
                            "Völkerkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "fc464059-44e9-4999-976c-bded40be1d98",
                                "sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                                "text": "„Bertram Rickmers also steht für den Aufstieg und den Fall einer mächtigen Kaste.“"
                            },
                            {
                                "example_id": "5cbb9617-8a04-4bf2-ad90-77dc47482d27",
                                "sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                                "text": "„Das Kastensystem im Hinduismus ist unterteilt in vier Kasten: Brahmanen (sie studieren die heiligen Schriften der Veden), Kshatriyas (Kriegerkaste), Vaishyas (Kaste der Händler und Hirten) und Shudras (dienende Kaste).“"
                            },
                            {
                                "example_id": "9c4752a3-b6f9-497b-a1d4-9ad874b42d99",
                                "sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                                "text": "„Sie riskierten, aus ihrer Kaste ausgestoßen zu werden.“"
                            },
                            {
                                "example_id": "677a0bd1-b9e0-45cc-9ad3-35add6c457cd",
                                "sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                                "text": "„Es ist eine kleine Kaste von Kongolesen, die genau so leben wollen wie die Kolonialherren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cec7ff7e-5ef7-4cfe-89ee-6732ae7c530f",
                        "source_entry_id": "102f6f87-3cb3-3672-9ba2-128e09eed4de",
                        "source_sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                        "source_sense_description": "geschlossene Gesellschaftsschicht",
                        "target_lang_word": "caste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa0d46b-d9f5-396c-8312-20fabaee6e4f",
                                        "entry_id": "ed65f5ff-fc1b-3c27-963d-2d0bd235468b",
                                        "glosses": [
                                            "Any of the hereditary social classes and subclasses of South Asian societies or similar found historically in other cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa035ea-57ab-4678-ab25-380691eec0df",
                                                "sense_id": "1fa0d46b-d9f5-396c-8312-20fabaee6e4f",
                                                "text": "Pakistan is a conservative, religious state. The Edhi Foundation is unusual in its ignoring of caste, creed, religion and sect. This strict stance has led to some criticism from religious groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5cb32c-5119-31e3-b8c2-60bc96170ab7",
                                        "entry_id": "ed65f5ff-fc1b-3c27-963d-2d0bd235468b",
                                        "glosses": [
                                            "A separate and fixed order or class of persons in society who chiefly associate with each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f592fd3d-80c5-4b61-886b-e24142fa6654",
                                                "sense_id": "bf5cb32c-5119-31e3-b8c2-60bc96170ab7",
                                                "text": "Ah! Can you give me all I've asked for — not now, nor a few months later, but when you begin to think of what you might have done if you had kept your own appointment and your caste here — when you begin to look upon me as a drag and a burden?"
                                            },
                                            {
                                                "example_id": "3a5c37b5-0a0e-4d69-8a62-f143db0d68ef",
                                                "sense_id": "bf5cb32c-5119-31e3-b8c2-60bc96170ab7",
                                                "text": "'I believe, Messieurs, in loyalty - to one's friends and one's family and one's caste.'"
                                            },
                                            {
                                                "example_id": "121c6a42-10ec-4a22-b41c-e4227eaaeb2c",
                                                "sense_id": "bf5cb32c-5119-31e3-b8c2-60bc96170ab7",
                                                "text": "The tinkers then formed a hereditary caste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5405a640-adff-32e3-9171-2193a6c5f9ea",
                                        "entry_id": "ed65f5ff-fc1b-3c27-963d-2d0bd235468b",
                                        "glosses": [
                                            "The division of society into castes; the caste system."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8ddf363-3f46-4df3-b08c-bfdafe43c021",
                                                "sense_id": "5405a640-adff-32e3-9171-2193a6c5f9ea",
                                                "text": "It was an evidence of the peculiar nature of caste in country towns[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69555835-da56-3efc-b75c-397cab887192",
                                        "entry_id": "ed65f5ff-fc1b-3c27-963d-2d0bd235468b",
                                        "glosses": [
                                            "A class of polymorphous eusocial insects of a particular size and function within a colony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa7e820-0d72-4d6b-a9a6-2526085b3f81",
                                                "sense_id": "69555835-da56-3efc-b75c-397cab887192",
                                                "text": "In beehives, most bees belong to the worker caste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2e66b23-d73b-4f59-a46e-b33bacf40675",
                        "source_entry_id": "102f6f87-3cb3-3672-9ba2-128e09eed4de",
                        "source_sense_id": "96c86502-4555-3407-a1a3-c01418bec512",
                        "source_sense_description": "geschlossene Gesellschaftsschicht",
                        "target_lang_word": "caste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c8520e0-7a63-3dd3-89ac-3190727145f2",
                                        "entry_id": "88181dde-99b2-34f8-93ad-0f281ff7ba02",
                                        "glosses": [
                                            "Chacune des tribus ou classes qui partagent la société de certains pays comme l’Inde ou l’ancienne Égypte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a176a6-0a60-4e37-a8be-5dbf3af8b700",
                                                "sense_id": "6c8520e0-7a63-3dd3-89ac-3190727145f2",
                                                "text": "Née dans l’Inde, pays de caste et d’exclusion, elle a foulé aux pieds la distinction des castes, elle a dit que tous les peuples étaient appelés; persécuté par les brahmes, le bouddhisme a eu la gloire du martyre; il a scellé sa foi à l’humanité de son sang."
                                            },
                                            {
                                                "example_id": "3602b1eb-6f41-468e-b46b-50b658b00330",
                                                "sense_id": "6c8520e0-7a63-3dd3-89ac-3190727145f2",
                                                "text": "La Perse n'a point de caste. Tous sont égaux chez elle au point de vue religieux."
                                            },
                                            {
                                                "example_id": "77e011cb-8bef-423f-8b87-a13a8a9f6ff8",
                                                "sense_id": "6c8520e0-7a63-3dd3-89ac-3190727145f2",
                                                "text": "Pourtant, le système continue à protéger un immuable ordre ancien où la société mauritanienne se subdivise en castes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5f9837-fb05-3c0a-8233-163e9199c519",
                                        "entry_id": "88181dde-99b2-34f8-93ad-0f281ff7ba02",
                                        "glosses": [
                                            "Classe de la société, que l’on considère alors comme exclusive et fermée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af54d650-f7e8-46c4-ad52-a21626f30845",
                                                "sense_id": "6b5f9837-fb05-3c0a-8233-163e9199c519",
                                                "text": "D’une caste incontrôlée, étrangère au socialisme, la bureaucratie est devenue une caste incontrôlable, mortellement hostile au socialisme de Russie, comme à l’échelle mondiale."
                                            },
                                            {
                                                "example_id": "e2bed083-8e79-405c-b61e-46d85405c609",
                                                "sense_id": "6b5f9837-fb05-3c0a-8233-163e9199c519",
                                                "text": "Dans notre France démocratique et égalitaire, l’existence d’une caste et d’une oligarchie militaires était, au contraire, une monstruosité."
                                            },
                                            {
                                                "example_id": "a04bef00-3c1a-4035-9213-ecc675fcdaf9",
                                                "sense_id": "6b5f9837-fb05-3c0a-8233-163e9199c519",
                                                "text": "Les tailleurs de pierre forment la seconde caste et la portion la plus considérable des habitans de Chausey."
                                            },
                                            {
                                                "example_id": "90fbf4f3-8db9-424a-9a5f-dc8397d936be",
                                                "sense_id": "6b5f9837-fb05-3c0a-8233-163e9199c519",
                                                "text": "Acceptons que le courage militaire demeure l’apanage d’une caste enfantine et bruyante, et ne se répande pas, comme l’a fait la Légion d’honneur, son insigne, parmi les professeurs, les contrôleurs, les peintres…"
                                            },
                                            {
                                                "example_id": "1ec2cd9b-fc33-4705-8eee-ebd7b44ad4c9",
                                                "sense_id": "6b5f9837-fb05-3c0a-8233-163e9199c519",
                                                "text": "Je ne doute pas du reste que dans certaines classes les intérêts de caste n'effacent tout sentiment de patriotisme, et que pour conserver leur saint-frusquin, ces gens-là se feraient volontiers le sacrifice des trois-quarts de la France."
                                            }
                                        ]
                                    }
                                ]
                            },
