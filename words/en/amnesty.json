        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8d26f8d-dcd8-3e86-b262-59325b8af06a",
                    "sense_definition": "An official pardon granted by a government or sovereign power, especially for political offenses or a group of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government declared a general <w>amnesty</w> for all political prisoners after the peace treaty was signed."
                        },
                        {
                            "text": "Under the terms of the tax <w>amnesty</w>, citizens could declare their hidden assets without facing penalties."
                        }
                    ],
                    "synonyms": [
                        "pardon",
                        "reprieve",
                        "absolution"
                    ],
                    "antonyms": [
                        "prosecution",
                        "punishment"
                    ],
                    "common_phrases": [
                        "general amnesty",
                        "tax amnesty",
                        "grant amnesty"
                    ]
                },
                {
                    "sense_id": "b406ee95-3293-3645-a2df-1891de8ff003",
                    "sense_definition": "A state of forgetfulness or oblivion, specifically the intentional overlooking or forgetting of past offenses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forgetfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They agreed to a mutual <w>amnesty</w> regarding their past arguments to rebuild their friendship."
                        },
                        {
                            "text": "The treaty brought a welcome <w>amnesty</w> of old grievances between the neighboring towns."
                        }
                    ],
                    "synonyms": [
                        "oblivion",
                        "forgetfulness"
                    ],
                    "antonyms": [
                        "remembrance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of oblivion or forgetting past wrongs"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dac037f8-2e95-349e-991f-551933e87b58",
                    "sense_definition": "To grant an official pardon to a group of people, especially for political or legal offenses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president decided to <w>amnesty</w> those who had fled the country to avoid military service."
                        },
                        {
                            "text": "There were intense debates over whether the state should <w>amnesty</w> the rebels."
                        }
                    ],
                    "synonyms": [
                        "pardon",
                        "excuse",
                        "forgive"
                    ],
                    "antonyms": [
                        "prosecute",
                        "punish",
                        "condemn"
                    ]
