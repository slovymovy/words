{
    "word_family": [
        "menuless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bc19d14-a789-3c85-885d-32c33fe24c1d",
                    "sense_definition": "A list of food and beverages available for purchase at a restaurant, café, or bar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter handed us the <w>menu</w> as soon as we sat down at the table.",
                            "target_lang_translations": {
                                "ru": "Официант подал нам <w>меню</w>, как только мы сели за стол."
                            }
                        },
                        {
                            "text": "We looked at the lunch <w>menu</w> to see if they had any vegetarian options.",
                            "target_lang_translations": {
                                "ru": "Мы посмотрели обеденное <w>меню</w>, чтобы узнать, есть ли у них вегетарианские блюда."
                            }
                        }
                    ],
                    "synonyms": [
                        "bill of fare"
                    ],
                    "common_phrases": [
                        "lunch menu",
                        "dinner menu",
                        "dessert menu",
                        "drink menu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список блюд и напитков, доступных для покупки в ресторане, кафе или баре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меню",
                                "target_lang_sense_clarification": "листок или карта с перечнем блюд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c13d6207-e2c5-32b0-a9db-ec4ffcaa9bc4",
                    "sense_definition": "The actual selection of food or drinks that are offered by an establishment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant decided to take the spicy chicken sandwich off their <w>menu</w>.",
                            "target_lang_translations": {
                                "ru": "Ресторан решил убрать острый сэндвич с курицей из своего <w>меню</w>."
                            }
                        },
                        {
                            "text": "They have added several healthy vegan dishes to the new <w>menu</w> this season.",
                            "target_lang_translations": {
                                "ru": "В этом сезоне они добавили несколько полезных веганских блюд в новое <w>меню</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "new menu",
                        "seasonal menu",
                        "limited menu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фактический ассортимент блюд или напитков, предлагаемых заведением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меню",
                                "target_lang_sense_clarification": "ассортимент или подбор блюд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6032a65-5fd7-39ff-b868-f251c5f389f8",
                    "sense_definition": "A list of options or commands displayed on a computer screen for a user to select from.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click on the main <w>menu</w> to find the settings for your account.",
                            "target_lang_translations": {
                                "ru": "Нажмите на главное <w>меню</w>, чтобы найти настройки вашей учетной записи."
                            }
                        },
                        {
                            "text": "You can access the print options through the drop-down <w>menu</w> at the top.",
                            "target_lang_translations": {
                                "ru": "Вы можете получить доступ к настройкам печати через выпадающее <w>меню</w> вверху."
                            }
                        }
                    ],
                    "common_phrases": [
                        "main menu",
                        "drop-down menu",
                        "context menu",
                        "settings menu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список опций или команд, отображаемых на экране компьютера для выбора пользователем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меню",
                                "target_lang_sense_clarification": "элемент интерфейса программы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03c38894-b0a1-3b52-85b1-7e4f7a2fe29a",
                    "sense_definition": "The specific details of the food to be served at a formal banquet or special event.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wedding <w>menu</w> featured a choice of roasted beef or grilled salmon.",
                            "target_lang_translations": {
                                "ru": "Свадебное <w>меню</w> включало выбор между жареной говядиной или лососем на гриле."
                            }
                        },
                        {
                            "text": "After the ceremony, the fixed <w>menu</w> was displayed at the entrance of the hall.",
                            "target_lang_translations": {
                                "ru": "После церемонии у входа в зал было выставлено фиксированное <w>меню</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bill of fare"
                    ],
                    "common_phrases": [
                        "wedding menu",
                        "fixed menu",
                        "banquet menu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный перечень блюд, которые будут подаваться на официальном банкете или специальном мероприятии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меню",
                                "target_lang_sense_clarification": "состав блюд для мероприятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d6e0eb5-443d-36a2-b49c-bb8e81614fde",
                    "sense_definition": "A list of items, activities, or topics to be addressed; an agenda.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agenda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What is on the <w>menu</w> for today's business meeting?",
                            "target_lang_translations": {
                                "ru": "Что у нас на <w>повестке дня</w> на сегодняшней деловой встрече?"
                            }
                        },
                        {
                            "text": "The coach said that hard work was the only thing on the <w>menu</w> for practice.",
                            "target_lang_translations": {
                                "ru": "Тренер сказал, что тяжелая работа — это единственное, что запланировано в <w>программе</w> тренировки."
                            }
                        }
                    ],
                    "synonyms": [
                        "agenda",
                        "program"
                    ],
                    "common_phrases": [
                        "on the menu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список дел, мероприятий или тем для обсуждения; повестка дня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа",
                                "target_lang_sense_clarification": "план действий или мероприятий"
                            },
                            {
                                "target_lang_word": "повестка дня",
                                "target_lang_sense_clarification": "список тем для обсуждения"
                            },
                            {
                                "target_lang_word": "меню",
                                "target_lang_sense_clarification": "переносное значение: список доступных вариантов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                    "sense_definition": "To include a specific dish or item in a menu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>menu</w> the seafood dish as a seasonal appetizer.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>включить в меню</w> блюдо из морепродуктов в качестве сезонной закуски."
                            }
                        },
                        {
                            "text": "By <w>menuing</w> a bisque, the restaurant can justify a slightly higher price point.",
                            "target_lang_translations": {
                                "ru": "<w>Вводя в меню</w> биск, ресторан может оправдать чуть более высокую цену."
                            }
                        }
                    ],
                    "synonyms": [
                        "feature",
                        "list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать определенное блюдо или позицию в меню."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать в меню",
                                "target_lang_sense_clarification": "добавлять блюдо в список"
                            },
                            {
                                "target_lang_word": "вносить в меню",
                                "target_lang_sense_clarification": "регистрировать позицию в перечне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9819715f-e333-3531-bc5d-799b7191e178",
                    "sense_definition": "A surname of French origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical documents mention a certain Pierre <w>Menu</w> who lived in the village.",
                            "target_lang_translations": {
                                "ru": "В исторических документах упоминается некий Пьер <w>Меню</w>, живший в этой деревне."
                            }
                        },
                        {
                            "text": "She is researching the genealogy of the <w>Menu</w> family in northern France.",
                            "target_lang_translations": {
                                "ru": "Она исследует генеалогию семьи <w>Меню</w> на севере Франции."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "French origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия французского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Меню",
                                "target_lang_sense_clarification": "французская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}