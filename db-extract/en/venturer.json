                        "examples": [
                            {
                                "example_id": "b7a8c953-88f9-4eb9-b75a-1d8ce76fb7c8",
                                "sense_id": "09a5f767-6e6b-3cc5-a23b-45bbcbe7acbf",
                                "text": "Pleased to be a solitary venturer, he spent the next three weeks on an odyssey in search of these delights."
                            },
                            {
                                "example_id": "ce9aa425-9c13-4a19-8918-2f2b32937e9d",
                                "sense_id": "09a5f767-6e6b-3cc5-a23b-45bbcbe7acbf",
                                "text": "Tellingly, after demonstrating his virility as a venturer to India, where he made his fortune, he married upon his return."
                            },
                            {
                                "example_id": "db4486f8-8544-4184-b218-cf90f4770925",
                                "sense_id": "09a5f767-6e6b-3cc5-a23b-45bbcbe7acbf",
                                "text": "Some of the earliest venturers into Africa before colonisation were missionaries, who spread into Southern and Eastern Africa as well as other regions."
                            }
                        ]
                    },
