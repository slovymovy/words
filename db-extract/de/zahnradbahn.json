                ],
                "senses": [
                    {
                        "sense_id": "e46ec338-10d8-3ba8-81c8-a2072c4fe11f",
                        "entry_id": "b4f33587-ca22-3474-8066-2bc8b8ade0ec",
                        "glosses": [
                            "Eisenbahn, bei der die Übertragung der Antriebskraft über eine im Gleis eingebaute Zahnstange erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff55a9a-e98e-4b98-8822-1a8bb34c4fe6",
                                "sense_id": "e46ec338-10d8-3ba8-81c8-a2072c4fe11f",
                                "text": "Zahnradbahnen können besonders große Steigungen überwinden."
                            },
                            {
                                "example_id": "a89cd630-43c6-49ac-9161-fdbe8bda897c",
                                "sense_id": "e46ec338-10d8-3ba8-81c8-a2072c4fe11f",
                                "text": "„Das Adenauerhaus in Rhöndorf liegt am Fuß eines Bergs, der ohnehin überlaufen war: der Drachenfels, auf dem die romantische Sage ein Untier ansiedelte, das von einer frommen Jungfrau gezähmt wurde, auf dem ein Denkmal an die Befreiungskriege erinnert und auf den die erste deutsche Zahnradbahn führte.“"
                            },
                            {
                                "example_id": "200d4f56-c3ca-48fb-9fa3-f50d45a338fe",
                                "sense_id": "e46ec338-10d8-3ba8-81c8-a2072c4fe11f",
                                "text": "„Auf das Kind Elias hinterlässt die Fahrt in Zürich mit der Zahnradbahn auf den Zürichberg und dann der Blick von oben auf die Stadt und den See mit den Bergen am Horizont einen bleibenden Eindruck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b39b24-44b3-40fe-afb8-b4ce6e8c1be2",
                        "source_entry_id": "b4f33587-ca22-3474-8066-2bc8b8ade0ec",
                        "source_sense_id": "e46ec338-10d8-3ba8-81c8-a2072c4fe11f",
                        "source_sense_description": "Eisenbahn, bei der die Übertragung der Antriebskraft über eine im Gleis eingebaute Zahnstange erfolgt",
                        "target_lang_word": "rack railway",
