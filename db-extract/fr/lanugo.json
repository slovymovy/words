                                    {
                                        "sense_id": "7ad21d18-b3fa-37fd-8f9a-949cedf4cc4c",
                                        "entry_id": "cf86c550-db4e-37f0-91bb-644ef9de8608",
                                        "glosses": [
                                            "Soft down or fine hair, specifically that covering the human foetus or a tumorous area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f432ac6-9baa-4468-84bf-0674f290880b",
                                                "sense_id": "7ad21d18-b3fa-37fd-8f9a-949cedf4cc4c",
                                                "text": "From the presence of the woolly hair or lanugo on the human fœtus, and of rudimentary hairs scattered over the body during maturity, we may infer that man is descended from some animal which was born hairy and remained so during life."
                                            },
                                            {
                                                "example_id": "b5e94cbe-6a41-4b13-aedb-4a3a0a6f23e1",
                                                "sense_id": "7ad21d18-b3fa-37fd-8f9a-949cedf4cc4c",
                                                "text": "[…] early spring mountains with young-elephant lanugo along their spines […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
