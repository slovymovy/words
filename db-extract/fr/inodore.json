                        "cross_references": [
                            {
                                "target_word": "odourless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "405c2ab6-1edc-3ee3-a742-9e02ec9711ab",
                                        "entry_id": "04faa5b2-92ec-3c99-ad3a-ee8af13dea66",
                                        "glosses": [
                                            "Having no odour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d2bfaa-d196-441c-9c62-4a25fd3d832e",
                                                "sense_id": "405c2ab6-1edc-3ee3-a742-9e02ec9711ab",
                                                "text": "They were taken unawares and overcome when the room filled with a lethal, odourless gas."
                                            },
                                            {
                                                "example_id": "dcc50bde-65fc-41c1-98a5-95ee468dc665",
                                                "sense_id": "405c2ab6-1edc-3ee3-a742-9e02ec9711ab",
                                                "text": "Smiling, young, muscular, paunchless, probably odourless, he went."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec80baa7-6f6e-4c38-a8a9-0d879eecf9c2",
                        "source_entry_id": "32df1f93-3e6c-382f-8425-b55e599d14a8",
                        "source_sense_id": "e400bb22-5d33-34d7-b9b3-62d9c183f9f0",
                        "target_lang_word": "odorless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odorless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                        "entry_id": "07d49f3a-0e6e-30ad-87eb-2d393a7a8d7f",
                                        "glosses": [
                                            "Having no odor."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac54eec9-0f4d-449a-9ccc-e853e9fb3ff0",
                                                "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                                "text": "They were taken unawares and overcome when the room filled with a lethal, odorless gas."
                                            },
                                            {
                                                "example_id": "5cbaaf4d-7d88-4c6d-acc8-63bfbf83d54b",
                                                "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                                "text": "The garlion is a cross between the garlic and onion; the topeppo combines the tomato and the pepper. We have the odorless onion, the odorless cabbage, the lemon cucumber that grows on a vine but looks like a lemon, and a giant cucumber"
                                            },
                                            {
                                                "example_id": "ba4e0963-1328-4ef9-956f-7e605d7d95a9",
                                                "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                                "text": "The Invisible Killer Dihydrogen monoxide is colorless, odorless, tasteless, and kills uncounted thousands of people every year. Most of these deaths are caused by accidental inhalation of DHMO, but the dangers of dihydrogen monoxide do not end there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d425e376-2cb4-4cfd-b703-a45f102233ce",
                        "source_entry_id": "32df1f93-3e6c-382f-8425-b55e599d14a8",
                        "source_sense_id": "e400bb22-5d33-34d7-b9b3-62d9c183f9f0",
