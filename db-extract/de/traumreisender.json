                        "examples": [
                            {
                                "example_id": "bd570247-e215-478d-b8da-ef13217b2ca7",
                                "sense_id": "7916df92-2c8e-3bbb-a401-fa3af2ff8e0c",
                                "text": "„Bald nahmen die Felswände zur Linken normale Formen an und pressten den Weg wieder zu einer schmalen Gasse, und der Traumreisende lief immer noch hinter dem Yak her, dessen große, weit auseinanderliegende Hufspuren von seiner verzweifelten Flucht kündeten.“"
                            }
                        ],
