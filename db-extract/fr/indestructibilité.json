                "senses": [
                    {
                        "sense_id": "ef181609-8cf8-3c9c-86b2-632d8e6ef97b",
                        "entry_id": "48759002-3e2f-3efd-975d-8493648ae6a9",
                        "glosses": [
                            "Qualité ou état de ce qui est indestructible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8507c1d-79f2-4cce-9eee-68a511b2be9b",
                                "sense_id": "ef181609-8cf8-3c9c-86b2-632d8e6ef97b",
                                "text": "L’indestructibilité de l’Or établie, il est manifeste qu’il ne peut étre d’aucun usage , ni dans la Médecine, ni dans l’Alchymie : Et ceux qui ajoûtent des fueilles d’Or à leurs remedes, les rendent plus precieux, à la verité, mais nullement meilleurs."
                            },
                            {
                                "example_id": "08fe1673-24ac-4d42-8cec-e935a9d49dcd",
                                "sense_id": "ef181609-8cf8-3c9c-86b2-632d8e6ef97b",
                                "text": "Elle imprègne la mentalité humaine au point sensible qui assure à l’antisémitisme l’une de ses indestructibilités."
                            },
                            {
                                "example_id": "b4d99061-b826-4c3d-9e59-a1e5fb8aaa3c",
                                "sense_id": "ef181609-8cf8-3c9c-86b2-632d8e6ef97b",
                                "text": "Le principe de base de la chimie est l’indestructibilité de la matière durant les transformations chimiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7b944cf-4c6a-432f-8608-5fc187c88340",
                        "source_entry_id": "48759002-3e2f-3efd-975d-8493648ae6a9",
