        "fr-extract.jsonl": [
            {
                "entry_id": "aca9df63-353c-3d18-8e18-03d337b93daf",
                "word": "Auvergne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                        "entry_id": "aca9df63-353c-3d18-8e18-03d337b93daf",
                        "glosses": [
                            "Province française couvrant le Massif central."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "6e3a4cc8-b996-497c-a66e-1f2a36e97b89",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "— Je viendrai le Vendredi saint… vous faire mes adieux car nous allons passer les fêtes de Pâques en Auvergne.\n— En Auvergne ? pour vous faire manger par les puces et la vermine, grand bien vous fasse !"
                            },
                            {
                                "example_id": "ef15c96e-e29d-435c-84a0-41ba52b59d31",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "— Des femmes pareilles, on devrait les envoyer aux galères. Heureusement qu’il n’y en a guère comme ça, en ces côtés !... Quel pays cela doit être, cette Auvergne !"
                            },
                            {
                                "example_id": "18b476bc-3add-43b9-8360-9fe1d277ce59",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "Les Bretons, ces émigrants celtiques venus de Grande-Bretagne au Vᵉ siècle de notre ère, avaient ramené en Armorique une langue très analogue à ce parler gaulois que d’ailleurs employait encore à cette époque, la population d’Auvergne."
                            },
                            {
                                "example_id": "7a0854b9-be10-468a-b512-687bd5993053",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "Beaucoup des tripolis et des randanites […], se sont ainsi formés autrefois dans les lacs de notre pays d’Auvergne, en particulier dans le versant nord de l'ancien grand volcan du Cantal, […]."
                            },
                            {
                                "example_id": "d3d195e3-a7d3-4376-8e80-de01e6261373",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "C’est pourquoi il aimait l’Auvergne où, comme disait ce maire de village, « il y a plus de montées que de descentes »."
                            },
                            {
                                "example_id": "001a1955-7281-4c80-90d2-2ca1e837ee72",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "Ces travaux urgeaient spécialement dans l’Auvergne montagneuse où le réseau routier déjà insuffisant fut gravement endommagé par les pluies diluviennes de l'automne 1787."
                            },
                            {
                                "example_id": "c4b41b00-c108-452b-b58e-2202689a9c87",
                                "sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                                "text": "Mais trop d’Auvergne, c'est comme trop de potée de la même origine ou trop de patranque qu'on appelle aussi aligot, c'est de l’étouffe-chrétien pour ceux qui ne sont pas nés natifs du Cantal et des départements limitrophes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb147726-9e80-4993-acab-5e2b9420d2d2",
                        "source_entry_id": "aca9df63-353c-3d18-8e18-03d337b93daf",
                        "source_sense_id": "e8012862-7ade-367b-9e4d-743e759c575c",
                        "target_lang_word": "Auvergne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auvergne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c4c576a-b3d2-30b5-9061-2f06aeeadbc8",
                                        "entry_id": "2f2ac5ab-f9d9-38c7-9b8e-696326310f63",
