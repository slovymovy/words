{
    "word_family": [
        "burl"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6b392178-b173-3f31-8215-32aefdad854d",
                    "sense_definition": "Large, well-built, and muscular.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_stature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>burly</w> security guard stood at the entrance to ensure everyone had a ticket.",
                            "target_lang_translations": {
                                "cs": "<w>Urostlý</w> ochrankář stál u vchodu, aby zajistil, že každý má vstupenku."
                            }
                        },
                        {
                            "text": "He is a <w>burly</w> man with broad shoulders and a very strong build.",
                            "target_lang_translations": {
                                "cs": "Je to <w>robustní</w> muž se širokými rameny a velmi silnou postavou."
                            }
                        }
                    ],
                    "synonyms": [
                        "husky",
                        "sturdy",
                        "brawny",
                        "muscular"
                    ],
                    "antonyms": [
                        "frail",
                        "slight"
                    ],
                    "common_phrases": [
                        "burly man",
                        "burly guard"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velký, urostlý a svalnatý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "urostlý",
                                "target_lang_sense_clarification": "popisující fyzicky silnou a dobře stavěnou postavu"
                            },
                            {
                                "target_lang_word": "svalnatý",
                                "target_lang_sense_clarification": "mající vyvinuté svaly"
                            },
                            {
                                "target_lang_word": "robustní",
                                "target_lang_sense_clarification": "mající silnou a pevnou tělesnou konstrukci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5151fbd3-dcf3-3aec-9c2b-11bbc2093d8d",
                    "sense_definition": "Full of burls or knots; knotty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter chose a <w>burly</w> piece of oak for the table top.",
                            "target_lang_translations": {
                                "cs": "Truhlář si pro desku stolu vybral <w>sukovitý</w> kus dubového dřeva."
                            }
                        },
                        {
                            "text": "The <w>burly</w> wood grain made the surface difficult to sand smooth.",
                            "target_lang_translations": {
                                "cs": "<w>Sukovitá</w> kresba dřeva způsobila, že povrch bylo obtížné vyhladit broušením."
                            }
                        }
                    ],
                    "synonyms": [
                        "knotty",
                        "gnarled"
                    ],
                    "common_phrases": [
                        "burly wood"
                    ],
                    "target_lang_definitions": {
                        "cs": "Plný suků nebo uzlů; sukovitý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sukovitý",
                                "target_lang_sense_clarification": "mající mnoho suků, obvykle o dřevě"
                            },
                            {
                                "target_lang_word": "uzlovitý",
                                "target_lang_sense_clarification": "mající hrboly nebo uzly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "348f858f-fc04-32d1-a264-ea8dd50cb90f",
                    "sense_definition": "Of large magnitude, dangerous, or difficult.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfers faced a <w>burly</w> wave that was nearly ten feet high.",
                            "target_lang_translations": {
                                "cs": "Surfaři čelili <w>impozantní</w> vlně, která byla vysoká téměř tři metry."
                            }
                        },
                        {
                            "text": "It was a <w>burly</w> climb that required all of our energy and focus.",
                            "target_lang_translations": {
                                "cs": "Byl to <w>náročný</w> výstup, který vyžadoval veškerou naši energii a soustředění."
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "formidable",
                        "challenging"
                    ],
                    "common_phrases": [
                        "burly wave",
                        "burly climb"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in extreme sports contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velkého rozsahu, nebezpečný nebo obtížný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náročný",
                                "target_lang_sense_clarification": "vyžadující velké úsilí nebo schopnosti"
                            },
                            {
                                "target_lang_word": "impozantní",
                                "target_lang_sense_clarification": "budící respekt svou velikostí nebo silou"
                            },
                            {
                                "target_lang_word": "nebezpečný",
                                "target_lang_sense_clarification": "představující riziko nebo hrozbu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}