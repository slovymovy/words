                                        "examples": [
                                            {
                                                "example_id": "a155238b-26d1-4f49-865d-188f542ed249",
                                                "sense_id": "35631bc4-97b0-35e3-b13f-f67a1e4049a2",
                                                "text": "Wenigstens mit ein paar Euro könntest du dich beteiligen."
                                            },
                                            {
                                                "example_id": "ac1801a8-594b-4da4-99d4-2adfc4f5c364",
                                                "sense_id": "35631bc4-97b0-35e3-b13f-f67a1e4049a2",
                                                "text": "„Bei dem Hundewetter soll man sie wenigstens ausschlafen lassen.“"
                                            },
                                            {
                                                "example_id": "c3c8e2db-d47d-42e3-a04b-6c00e5ddd119",
                                                "sense_id": "35631bc4-97b0-35e3-b13f-f67a1e4049a2",
                                                "text": "„Die Gesichter waren verschlafen, Unwille lag auf ihnen, der Unwille, aus dem wenigstens animalisch erwärmten Bett in den Frost der Straße, aus der Ruhe in harte Fron zu müssen.“"
                                            }
