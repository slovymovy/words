                            {
                                "example_id": "1a639809-ba7c-44d5-a1a3-359c623f0a2e",
                                "sense_id": "680f9ea6-ca39-3e13-8486-9e59e6956c65",
                                "text": "Mon oncle Jean eut du temps libre à consacrer à son pavillon, des flopées de temps libre. Mais pas un rond pour acheter un sac de ciment ou une bottelée de frises à parquet."
                            }
