                ],
                "senses": [
                    {
                        "sense_id": "fe2a40cd-c133-323e-b5a2-8c0559782817",
                        "entry_id": "ed20a503-aa1a-35c7-8286-ec853764ac13",
                        "glosses": [
                            "aktuell gegebene Sachlage im Verkehrsleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba904963-3e8b-483d-bf6b-ca659c318e80",
                                "sense_id": "fe2a40cd-c133-323e-b5a2-8c0559782817",
                                "text": "„Die Verkehrskreuzung ist eine sehr komplexe Verkehrssituation, die dem Verkehrsverständnis und Verkehrskönnen der Kinder viel abverlangt.“"
                            },
                            {
                                "example_id": "23772f4f-8e48-4b25-b7f5-a4906ff2903f",
                                "sense_id": "fe2a40cd-c133-323e-b5a2-8c0559782817",
                                "text": "„Kinder brauchen ein Verkehrsgefühl, das es ihnen ermöglicht, in aktuellen Verkehrssituationen angemessen zu reagieren.“"
                            },
                            {
                                "example_id": "05baf122-9457-44c9-ad41-f579615b97e2",
                                "sense_id": "fe2a40cd-c133-323e-b5a2-8c0559782817",
                                "text": "„Denn häufig führt gerade der elterliche Chauffeurdienst zur Verschärfung der Verkehrssituation an Schulen und Kindergärten, hieß es.“"
                            },
                            {
                                "example_id": "641f6f5d-8d91-4015-92c6-580e9703751f",
                                "sense_id": "fe2a40cd-c133-323e-b5a2-8c0559782817",
                                "text": "„Die Testfahrt hat gezeigt, wie viele Verkehrssituationen die automatische Steuerung bereits beherrscht – und welche noch nicht, ja, welche sie womöglich nie beherrschen wird.“"
                            },
                            {
                                "example_id": "6653f20b-960c-49d5-8a51-03d026ad4404",
                                "sense_id": "fe2a40cd-c133-323e-b5a2-8c0559782817",
                                "text": "„Es gibt kaum eine städtische Verkehrssituation, die man hier nicht erleben kann, sagt Hoellerbauer und dreht sich lässig zu seinem Gesprächspartner im Auto um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
