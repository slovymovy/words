                                "target_senses": [
                                    {
                                        "sense_id": "df671af8-2cbf-3c2a-895a-0468cd2876ad",
                                        "entry_id": "71b6e3d4-246e-3dee-93c6-5b0229ea814e",
                                        "glosses": [
                                            "A muscle whose contraction acts to bend a joint or limb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad67a5fb-ce55-485d-8df6-2052a12cb090",
                                                "sense_id": "df671af8-2cbf-3c2a-895a-0468cd2876ad",
                                                "text": "Starting at the point of shoulder, use muscle squeezings, picking-ups, kneadings and gentle frictions, interspersed with effleurages, over the triceps muscle as well as the fleshy part of the flexor and extensor muscle groups."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
