        "nl-extract.jsonl": [
            {
                "entry_id": "670dcc2e-4c17-3054-89c6-d69a3b46b20a",
                "word": "ouderling",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "35ec6b69-65d1-42bc-b6b8-a909ece0556d",
                        "entry_id": "670dcc2e-4c17-3054-89c6-d69a3b46b20a",
                        "tags": [
                            "plural"
                        ],
                        "form": "ouderlingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d93688f6-c8e5-39fc-a9ff-0fb84f76bdf3",
                        "entry_id": "670dcc2e-4c17-3054-89c6-d69a3b46b20a",
                        "glosses": [
                            "een functie binnen een kerkelijke gemeenschap, lid van de kerkenraad"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "7aaec64b-0f19-4386-9aea-76e79f16ee9a",
                                "sense_id": "d93688f6-c8e5-39fc-a9ff-0fb84f76bdf3",
                                "text": "Jehova's getuigen vinden dat hun interne rechtssysteem boven dat van de wereldse autoriteiten staat. Mannelijke ouderlingen treden op als rechters, die de richtlijnen van het Amerikaanse hoofdkantoor hanteren."
                            },
                            {
                                "example_id": "2bdbacb1-e74b-49ae-9650-89244ce6214a",
                                "sense_id": "d93688f6-c8e5-39fc-a9ff-0fb84f76bdf3",
                                "text": "'Ja,' zegt de jongere ouderling, 'het is wel alles tegelijk, eerst uw vader, nu uw moeder. Maar God zal u kracht naar kruis geven."
                            }
                        ]
                    },
                    {
                        "sense_id": "f30353a3-c900-3613-89fe-d21395fe02bf",
                        "entry_id": "670dcc2e-4c17-3054-89c6-d69a3b46b20a",
                        "glosses": [
                            "oud persoon in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f2d4d0-8013-4016-af37-748fb9d7e1e5",
                                "sense_id": "f30353a3-c900-3613-89fe-d21395fe02bf",
                                "text": "In de zorg hangt dit heel nauw samen, een goede zorg heeft immers menselijkheid en vertrouwen nodig. Steeds maar wisselend personeel dat bovendien steeds minder tijd krijgt voor zorgtaken, is nefast. Dat geldt voor ouderlingen en patiënten, maar ook voor drugsverslaafden, daklozen en mensen in armoede. Het succes van het werken met deze kwetsbare groepen is afhankelijk van een vertrouwensband. Daar gaat in vele gevallen een lang proces aan vooraf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb137a76-f0d5-4824-a240-198aceca7666",
                        "source_entry_id": "670dcc2e-4c17-3054-89c6-d69a3b46b20a",
                        "source_sense_id": "d93688f6-c8e5-39fc-a9ff-0fb84f76bdf3",
                        "source_sense_description": "(religie) een functie binnen een kerkelijke gemeenschap, lid van de kerkenraad",
                        "target_lang_word": "elder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                        "entry_id": "7fbfd918-9e1d-3cda-88d9-7bc552a89d69",
                                        "glosses": [
                                            "comparative degree of old: older, greater than another in age or seniority."
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16084b22-698a-4b55-b6ac-32e1ede9b75c",
                                                "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                                "text": "It's typical for elder married couples to live in retirement homes."
                                            },
                                            {
                                                "example_id": "7e548c5d-9cdd-49e1-90c3-e41150cb909b",
                                                "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                                "text": "The elder of the two was also an elder statesman."
                                            },
                                            {
                                                "example_id": "1fae8db6-4b03-4dc3-a3cc-7db0ec45090d",
                                                "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                                "text": "She removed Stranleigh’s coat with a dexterity that aroused his imagination. The elder woman returned with dressings and a sponge, which she placed on a chair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "A leader or senior member of a tribe or community, often of considerable age, respected as an authority figure, especially in a counselling, consultative, or ceremonial role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553d0a81-e357-4d0e-9f2e-2e9136ce82bb",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "We were presented to the village elder."
                                            },
                                            {
                                                "example_id": "36e1756b-432d-49c2-8ff9-6745563b5d3c",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "At the friendship centre, you can arrange to meet with a social worker or an elder."
                                            },
                                            {
                                                "example_id": "5160e34f-2939-4fc0-a63e-6d7929e5f4e2",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "People saw in the elders, who were closer to death, the manifestation of the divine force that was thought to achieve its full liberation at death."
                                            },
                                            {
                                                "example_id": "93a22593-ba19-4101-85ec-5a311637db9e",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "I probably wouldn't be here talking about this very topic if it weren't for the few but mighty elders in the tech and gender rights spaces. Folks like South Africa-based Jan Moolman from the Association for Progressive Communications[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb595a9c-4baf-3f8f-8562-d75737a7cba7",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "An old person."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b6c9f45-449d-4b4f-a638-336d8b9fb43f",
                                                "sense_id": "eb595a9c-4baf-3f8f-8562-d75737a7cba7",
                                                "text": "Treating illness among society’s elders is challenging since board-certified geriatricians (physicians trained, knowledgeable and certified in treating older patients) are in short supply, here in El Paso and throughout the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447ca576-1919-37d0-8c41-80f1687d04c2",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "One who is older than another."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7037e843-2e9f-4486-ab3d-779df900c0ee",
                                                "sense_id": "447ca576-1919-37d0-8c41-80f1687d04c2",
                                                "text": "Respect your elders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab590bf9-a204-37cb-be90-f56164ff1b3e",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "One who lived at an earlier period; a predecessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e16c4af-f9a9-41f3-b205-07c180d77109",
                                                "sense_id": "ab590bf9-a204-37cb-be90-f56164ff1b3e",
                                                "text": "Carry your Head[…] as your Elders have done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e49c610-e8ed-39d1-85c5-a14ba932d15b",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "An officer of a church, sometimes having teaching responsibilities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e269278c-2b56-374f-b0f8-e3b7c0307c8b",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "A clergyman authorized to administer all the sacraments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7c1916-b021-4af5-89f4-c89f7d819874",
                                                "sense_id": "e269278c-2b56-374f-b0f8-e3b7c0307c8b",
                                                "text": "a travelling elder"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee22686-442a-334d-ad6e-a384b64a0546",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "One ordained to the lowest office in the Melchizedek priesthood."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4273a298-e47f-4069-a4c9-568cf089dbce",
                                                "sense_id": "2ee22686-442a-334d-ad6e-a384b64a0546",
                                                "text": "After being a member of the Church for a while, Bill was ordained to the office of elder."
                                            },
                                            {
                                                "example_id": "98ad95f6-2789-41cb-953e-5a3297a8d3f7",
                                                "sense_id": "2ee22686-442a-334d-ad6e-a384b64a0546",
                                                "text": "Jack had been an elder for only a few days when he received a new calling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c2cda10-84dc-3f77-9fe9-9fb138371d3a",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "A male missionary."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02bc49a4-ba27-4878-93c1-d7e9405d9453",
                                                "sense_id": "8c2cda10-84dc-3f77-9fe9-9fb138371d3a",
                                                "text": "The elders are coming over for dinner tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b13c2f-08b3-3fcb-b9c1-a358f98c6ae4",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "Title for a male missionary; title for a general authority."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292ab3f1-edee-437b-bf83-238774f61a6b",
                                                "sense_id": "65b13c2f-08b3-3fcb-b9c1-a358f98c6ae4",
                                                "text": "One of the long-time leaders in the Church is Elder Packer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49f6f6b-aed6-3a28-ae42-78398ccfb47d",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "A pagan or Heathen priest or priestess."
                                        ],
                                        "tags": [
                                            "Germanic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "elder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddcd2e85-68e3-3d5b-a2c7-9b154bacf584",
                                        "entry_id": "0a108506-0641-373b-9114-bbcda11fad6b",
                                        "glosses": [
                                            "To admonish or reprove for improper conduct by the elders of the meeting."
                                        ],
                                        "tags": [
                                            "Quakerism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e358e7-482e-47d6-bea5-a330962e98fc",
                                                "sense_id": "ddcd2e85-68e3-3d5b-a2c7-9b154bacf584",
                                                "text": "I was eldered for directly responding to someone else's message in meeting for worship."
                                            }
                                        ]
