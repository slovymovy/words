                                                "sense_id": "bb195e7a-4407-37cf-b70a-372668704c5a",
                                                "text": "„Sie hatte einen Stadtrat einmal gewaltig verärgert, den sie als »schütter und zwergenhaft« beschrieb – was er war.“"
                                            },
                                            {
                                                "example_id": "ad3d7d07-8bbc-439b-bb7e-ce30de7442f1",
                                                "sense_id": "bb195e7a-4407-37cf-b70a-372668704c5a",
                                                "text": "Dich scheint aber auch gar nichts zu verärgern."
                                            },
                                            {
                                                "example_id": "859c8bc3-ca9b-4cc4-8bba-bf8ec437910e",
                                                "sense_id": "bb195e7a-4407-37cf-b70a-372668704c5a",
                                                "text": "Achte darauf, die Kunden nicht zu verärgern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
