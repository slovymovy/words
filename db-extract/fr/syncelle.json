                    {
                        "sense_id": "8bf28ca1-9a76-3b78-9be3-790384b176da",
                        "entry_id": "a1e9b5ec-6058-3068-8834-02580ebde7b0",
                        "glosses": [
                            "Nom, dans l’Église orthodoxe, d'un officier placé auprès des patriarches, des évêques, etc. pour avoir inspection sur leur conduite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8a9ece-166a-400c-a4b1-0e151804a126",
                                "sense_id": "8bf28ca1-9a76-3b78-9be3-790384b176da",
                                "text": "Syncelle pontifical, titre que les empereurs de Constantinople donnaient aux prélats."
                            },
                            {
                                "example_id": "6f99c20c-a4fa-45a4-be1d-612597467e8e",
                                "sense_id": "8bf28ca1-9a76-3b78-9be3-790384b176da",
                                "text": "Le syncelle logeait au palais épiscopal, pour que l'évêque eût toujours un surveillant à sa porte."
                            },
                            {
                                "example_id": "efdc1b45-516c-4a9f-a5e6-07755aa8b52a",
                                "sense_id": "8bf28ca1-9a76-3b78-9be3-790384b176da",
                                "text": "George, syncelle de Taraise, patriarche de Constantinople, vivait vers la fin du VIIIe siècle."
                            }
                        ]
                    }
                ],
