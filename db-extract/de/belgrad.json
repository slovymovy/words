                                "target_senses": [
                                    {
                                        "sense_id": "7d30500e-596a-3301-a83e-2221684bbf2a",
                                        "entry_id": "ee131ff8-bf6a-34d2-bdce-8c1bd0a6f53c",
                                        "glosses": [
                                            "The capital city of Serbia; the former capital of Yugoslavia; the former capital of Serbia and Montenegro."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "686fb022-ef6c-337b-a804-82038c542b2d",
                                        "entry_id": "ee131ff8-bf6a-34d2-bdce-8c1bd0a6f53c",
                                        "glosses": [
                                            "The Serbian or Yugoslav government."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64755c4-a233-476b-8e7d-3caa64e74983",
                                                "sense_id": "686fb022-ef6c-337b-a804-82038c542b2d",
                                                "text": "Prosecution witness Osman Selak claimed that the Bosnian Serb army was under the de facto control of Belgrade, as the Prosecution alleged, but under cross-examination could not produce a single example of an order issued by the Yugoslav army to the Bosnian Serb army."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7ae80bd-23d6-4d6f-8b25-15ae0ccfd5c3",
                        "source_entry_id": "b5ef9464-1c01-328e-b549-f0fd159f5159",
                        "source_sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                        "source_sense_description": "Hauptstadt von Serbien",
                        "target_lang_word": "Belgrade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belgrade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8a99058-1d7c-3507-93bb-3c82a39f9c2f",
                                        "entry_id": "0793a280-5828-3bf0-b400-b423019ea400",
                                        "glosses": [
                                            "Ville et capitale de la république de Serbie, et anciennement capitale de la Yougoslavie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b096961-c8a9-4602-8ef0-5378e345d2d0",
                                                "sense_id": "d8a99058-1d7c-3507-93bb-3c82a39f9c2f",
                                                "text": "J'étais à Belgrade du 2 au 4 octobre 1914. A cette date, les Autrichiens avaient bombardé la ville pendant trente-six jours et autant de nuits."
                                            },
                                            {
                                                "example_id": "99e96539-85e2-41cf-92e8-e6570079adbb",
                                                "sense_id": "d8a99058-1d7c-3507-93bb-3c82a39f9c2f",
                                                "text": "En 1955, nous étions sous le choc de la “réconciliation” soviéto-yougoslave. Sans crier gare, la troïka moscovite avait débarqué à Belgrade pour se jeter dans les bras de Tito et le couvrir de fleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae1799ef-7b84-326b-ae05-39314cede465",
                                        "entry_id": "0793a280-5828-3bf0-b400-b423019ea400",
                                        "glosses": [
                                            "Gouvernement serbe."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Belgrade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a55d7f1e-de5c-3a9f-8907-d8b095a5cd02",
                                        "entry_id": "dd32f630-df41-3079-b801-ab05a891edc5",
