                                "target_senses": [
                                    {
                                        "sense_id": "bc1f37d2-ad11-390a-a36f-c64eeacfe902",
                                        "entry_id": "13940437-d658-3440-bec1-99f9ca5223bf",
                                        "glosses": [
                                            "A utensil in the shape of an inverted hollow cone terminating in a narrow pipe, for channeling liquids or granular material; typically used when transferring said substances from any container into ones with a significantly smaller opening."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e9a1bd0-898d-3d42-ab87-442818373ac5",
                                        "entry_id": "13940437-d658-3440-bec1-99f9ca5223bf",
                                        "glosses": [
                                            "A passage or avenue for a fluid or flowing substance; specifically, a smoke flue or pipe; the chimney of a steamship or the like."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a48ce62-f218-36bc-b4e1-14eb8af3072a",
                                        "entry_id": "13940437-d658-3440-bec1-99f9ca5223bf",
                                        "glosses": [
                                            "Ellipsis of purchase funnel (“the process of customer acquisition conceptualized as a series of stages, from initial awareness (top) to sale or conversion (bottom)”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11fa4ca-cea1-4a86-87b5-684fa0e41265",
                                                "sense_id": "9a48ce62-f218-36bc-b4e1-14eb8af3072a",
                                                "text": "top of (the) funnel marketing",
                                                "translation": "awareness stage marketing",
                                                "english": "awareness stage marketing"
                                            },
                                            {
                                                "example_id": "6356aa07-49c7-4a7a-92c2-38464616a949",
                                                "sense_id": "9a48ce62-f218-36bc-b4e1-14eb8af3072a",
                                                "text": "Then there's the funnel. Marketing usually spends most of their time at the top of the funnel with a quantity strategy. On the other hand, Sales spends their time trying to convert, accelerate, or close accounts that are in the middle or bottom of the funnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adba335-d391-3278-9b0f-6be717058f01",
                                        "entry_id": "13940437-d658-3440-bec1-99f9ca5223bf",
                                        "glosses": [
                                            "Ellipsis of funnel cloud."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "funnel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b147a0-502a-38d4-8b40-9f3837165c2a",
                                        "entry_id": "e9b3510d-07a4-371e-a9f1-f733787d094b",
                                        "glosses": [
                                            "To use a funnel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7f174c0-25e0-30c0-afa9-17d42c58873a",
                                        "entry_id": "e9b3510d-07a4-371e-a9f1-f733787d094b",
                                        "glosses": [
                                            "To proceed through a narrow gap or passageway akin to a funnel; to condense or narrow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6ac137-bb9b-4eb6-8c9b-f2f69a2f0620",
                                                "sense_id": "b7f174c0-25e0-30c0-afa9-17d42c58873a",
                                                "text": "Expect delays where the traffic funnels down to one lane."
                                            },
                                            {
                                                "example_id": "702b29f2-4b0b-4392-a0f2-c90773ddead0",
                                                "sense_id": "b7f174c0-25e0-30c0-afa9-17d42c58873a",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nA line of clocks in our cheap hotel displays the time in Lagos, Bucharest, Kiev: the capitals of pilgrims who come to kneel at the birthplace of Christ. In reality the entire world funnels through the Church of the Nativity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab722a3-2711-353b-86b7-638fa4359285",
                                        "entry_id": "e9b3510d-07a4-371e-a9f1-f733787d094b",
                                        "glosses": [
                                            "To channel, direct, or focus (emotions, money, resources, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b0f007f-0917-4d25-a6c9-7feb41648a52",
                                                "sense_id": "6ab722a3-2711-353b-86b7-638fa4359285",
                                                "text": "Our taxes are being funnelled into pointless government initiatives."
                                            },
                                            {
                                                "example_id": "c5fb51b5-4954-47d6-8555-4a53dac3610f",
                                                "sense_id": "6ab722a3-2711-353b-86b7-638fa4359285",
                                                "text": "Like so many others, I was awestruck by the first season, which captured a moment in time and successfully funnelled its rage outwards at a world in which women are indeed silenced, controlled and killed by men."
                                            },
                                            {
                                                "example_id": "ee9e8a3b-10b2-4716-bd55-a8e95b0ce768",
                                                "sense_id": "6ab722a3-2711-353b-86b7-638fa4359285",
                                                "text": "The Soviet Union had a substantially larger land army, considerably larger than NATO and the U.S.,” Sharpless said. […]So, one strategy was to block various access routes and perhaps funnel them into an area where you could use larger weapons against them."
                                            },
                                            {
                                                "example_id": "529c738b-ace5-4e92-ba0d-555fecb76466",
                                                "sense_id": "6ab722a3-2711-353b-86b7-638fa4359285",
                                                "text": "He was alive to every creak and dunt, the thinness of the walls, as if the tenement block was a kind of aural panopticon that funnelled every sound to the other residents, let everyone eavesdrop on their business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb9b8ea-39ec-30d6-a4b7-44b20568eae0",
                                        "entry_id": "e9b3510d-07a4-371e-a9f1-f733787d094b",
                                        "glosses": [
                                            "To consume (beer, etc.) rapidly through a funnel, typically as a stunt at a party."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba7f5540-a100-4945-86cf-8c0759d1d741",
                                                "sense_id": "abb9b8ea-39ec-30d6-a4b7-44b20568eae0",
                                                "text": "The first time he did it was to this freshman Kevin Ryers and we all just burst out laughing, watching Kevin try to funnel a beer."
                                            }
                                        ]
                                    }
                                ]
                            },
