                "senses": [
                    {
                        "sense_id": "66538a8f-12bb-3b6d-adad-451ba9f529dc",
                        "entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                        "glosses": [
                            "nachgestellte Seeschlacht zur Unterhaltung der Bevölkerung"
                        ],
                        "tags": [
                            "historisch, Antike"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2374fed6-c18a-3fe3-a963-033929268df7",
                        "entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                        "glosses": [
                            "Anlage, in der nachgestellte Seeschlachten zur Unterhaltung der Bevölkerung stattfanden"
                        ],
                        "tags": [
                            "historisch, Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "47461c2e-beba-449f-8735-045a06228310",
                                "sense_id": "2374fed6-c18a-3fe3-a963-033929268df7",
                                "text": "„Zur Volksbelustigung veranlasst Augustus schließlich noch, jenseits des Tibers eine Naumachie auszuheben, ein von einer eigenen Wasserleitung gespeistes riesiges Becken, in dem Seeschlachten nachgestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d06712a4-d00c-3f2b-9503-dddceff430f7",
                        "entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                        "glosses": [
                            "Seeschlacht"
                        ],
                        "tags": [
                            "historisch, Antike",
                            "Griechenland"
                        ],
                        "examples": [
                            {
                                "example_id": "869fce1a-f367-4590-8309-18fa2bf34d9f",
                                "sense_id": "d06712a4-d00c-3f2b-9503-dddceff430f7",
                                "text": "„Plötzlich weiß ich das Wort für eine nächtliche Seeschlacht, nach dem ich so lange schon suche: Naumarchie.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbf15e1f-f618-4182-a421-3f7bb2e6bafc",
                        "source_entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                        "source_sense_id": "66538a8f-12bb-3b6d-adad-451ba9f529dc",
                        "source_sense_description": "nachgestellte Seeschlacht zur Unterhaltung der Bevölkerung",
                        "target_lang_word": "naumachia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naumachia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480a9041-f6d7-338f-a01e-e311d0e44d60",
                                        "entry_id": "d5f8c83e-4367-34e4-bb07-bb63bde9c710",
                                        "glosses": [
                                            "The recreation of a sea battle staged for entertainment."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f34c1cdc-3a80-454f-932f-264268e5ed57",
                                                "sense_id": "480a9041-f6d7-338f-a01e-e311d0e44d60",
                                                "text": "BEFORE he went to feed with owls and bats\nNebuchadnezzar had an ugly dream,\nWorse than an Hus'if's when she thinks her cream\nMade a Naumachia for mice and rats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6154f299-8bd7-3d77-b6f9-5229ae5dc607",
                                        "entry_id": "d5f8c83e-4367-34e4-bb07-bb63bde9c710",
                                        "glosses": [
                                            "The location where such recreated sea battles took place; a building featuring an artificial body of water."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9174a1f0-bcc0-4ce1-8354-435812573221",
                                                "sense_id": "6154f299-8bd7-3d77-b6f9-5229ae5dc607",
                                                "text": "Our clerical guide did not fail us, but took us to see some ancient architectural remains, water tanks, a naumachia and other ruins of a similar sort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8824264b-7614-47d8-96bc-62816c0c0879",
                        "source_entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                        "source_sense_id": "66538a8f-12bb-3b6d-adad-451ba9f529dc",
