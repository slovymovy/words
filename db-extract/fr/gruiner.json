                "senses": [
                    {
                        "sense_id": "1a83458e-e4f1-33fd-b2f0-6f0522d4b539",
                        "entry_id": "f818fdcf-b913-3ede-8151-cc483e804bc9",
                        "glosses": [
                            "Pousser le cri particulier à leur espèce, en parlant de la grue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf87fd9-d254-4dab-84d0-c9e12cac4829",
                                "sense_id": "1a83458e-e4f1-33fd-b2f0-6f0522d4b539",
                                "text": "Grow, s. Grue, gros oiseau de passage qui vole fort haut et par bandes. Ce n’est donc plus par compagnies. Quand les grues sont abattues, c’est-à-dire quand elles sont à terre, l’une d’elles se tient en sentinelle sur une jambe : voit-elle l’ennemi, elle gruine son cri d’alarme ; toute la bande gruine et s’envole."
                            }
                        ]
                    }
