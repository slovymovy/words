                                "target_senses": [
                                    {
                                        "sense_id": "8cee044d-5147-3230-ad5d-418fed716758",
                                        "entry_id": "0cd49371-c542-37e8-8b72-54e56066f963",
                                        "glosses": [
                                            "A district of a city or town (in a country other than China) in which there is a large concentration of Chinese residents and businesses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1602dd3d-cb71-40ac-9c29-781214934962",
                                                "sense_id": "8cee044d-5147-3230-ad5d-418fed716758",
                                                "text": "She grabbed his hand again and marched him under the fake Oriental archway that heralded the beginning of Chinatown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2569e6d-5890-3bf8-97e3-b3fe0633094c",
                                        "entry_id": "0cd49371-c542-37e8-8b72-54e56066f963",
                                        "glosses": [
                                            "By extension, such a district filled with stereotypical \\\"Chinese\\\" people, of East Asians and Southeast Asians."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
