                    "sense_definition": "Принадлежащий тебе, относящийся к тебе или связанный с тобой (используется при обращении к одному лицу, с которым говорящий на «ты»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где сейчас живёт <w>твоя</w> семья?",
                            "target_lang_translations": {
                                "en": "Where does <w>your</w> family live now?",
                                "zh": "<w>你的</w>家人现在住在哪里？",
                                "nl": "Waar woont <w>jouw</w> familie nu?",
                                "pl": "Gdzie teraz mieszka <w>twoja</w> rodzina?",
                                "de": "Wo lebt <w>deine</w> Familie jetzt?",
                                "fr": "Où habite <w>ta</w> famille en ce moment ?",
                                "it": "Dove vive ora la <w>tua</w> famiglia?",
                                "cs": "Kde teď bydlí <w>tvoje</w> rodina?",
                                "tr": "<w>Senin</w> ailen şu an nerede yaşıyor?",
                                "es": "¿Dónde vive <w>tu</w> familia ahora?"
                            }
                        },
                        {
                            "text": "Мне очень нравится <w>твой</w> новый дом.",
                            "target_lang_translations": {
                                "en": "I really like <w>your</w> new house.",
                                "zh": "我很喜欢<w>你的</w>新房子。",
                                "nl": "Ik vind <w>jouw</w> nieuwe huis erg mooi.",
                                "pl": "Bardzo podoba mi się <w>twój</w> nowy dom.",
                                "de": "Ich mag <w>dein</w> neues Haus sehr.",
                                "fr": "J'aime beaucoup <w>ton</w> nouvelle maison.",
                                "it": "Mi piace molto la <w>tua</w> nuova casa.",
                                "cs": "Moc se mi líbí <w>tvůj</w> nový dům.",
                                "tr": "<w>Senin</w> yeni evini çok beğendim.",
                                "es": "Me gusta mucho <w>tu</w> casa nueva."
                            }
                        },
                        {
                            "text": "Это <w>твоё</w> решение, и я его уважаю.",
                            "target_lang_translations": {
                                "en": "It is <w>your</w> decision, and I respect it.",
                                "zh": "这是<w>你的</w>决定，我尊重它。",
                                "nl": "Dit is <w>jouw</w> beslissing en ik respecteer die.",
                                "pl": "To <w>twoja</w> decyzja i szanuję ją.",
                                "de": "Das ist <w>deine</w> Entscheidung, und ich respektiere sie.",
                                "fr": "C'est <w>ta</w> décision, et je la respecte.",
                                "it": "Questa è una <w>tua</w> decisione e la rispetto.",
                                "cs": "Je to <w>tvoje</w> rozhodnutí a já ho respektuji.",
                                "tr": "Bu <w>senin</w> kararın ve ben buna saygı duyuyorum.",
                                "es": "Es <w>tu</w> decisión y la respeto."
                            }
                        }
                    ],
