                                "example_id": "77ee3904-c105-4fc1-a8a8-5682fcf81b0c",
                                "sense_id": "51104334-1c06-3b54-b417-5970f1a60cd8",
                                "text": "MS-DOS hatte einen Unterstrich als Cursor."
                            },
                            {
                                "example_id": "e5247f59-3ddd-4399-9d37-62c38a8a8674",
                                "sense_id": "51104334-1c06-3b54-b417-5970f1a60cd8",
                                "text": "„Ich hatte gestern sogar auf dem Bildschirm des Laptops den Cursor geschlagen, weil ich dachte, es sei eine Mücke.“"
                            }
                        ],
