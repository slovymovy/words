                                                "example_id": "fb75ad6c-a77f-44a5-96bd-9e6badf9d08d",
                                                "sense_id": "df5e27a7-2f8a-3ba8-b638-81be3691c731",
                                                "text": "She was Lo, plain Lo, in the morning, standing four feet ten in one sock. She was Lola in slacks. She was Dolly at school. She was Dolores on the dotted line. But in my arms she was always Lolita."
                                            }
                                        ]
