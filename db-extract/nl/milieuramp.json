                    {
                        "sense_id": "03bac5f1-ec7d-3759-8100-320dcf884c46",
                        "entry_id": "89f0e0d8-93b9-3f6b-8efb-f0023154b4a8",
                        "glosses": [
                            "een gebeurtenis waardoor de leefomgeving ernstig beschadigd raakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517e31cb-6a5b-497c-9af1-82e57e1d9dbf",
                                "sense_id": "03bac5f1-ec7d-3759-8100-320dcf884c46",
                                "text": "De Belgische baggergroep Deme treedt in de voetsporen van Jules Vernes. Met hypermoderne zeerobots wil ze de bodem van de Stille Oceaan afschrapen op zoek naar mangaanknollen. Die zitten vol kostbare mineralen zoals nikkel, koper en kobalt. Ngo’s waarschuwen voor een dreigende milieuramp."
                            },
                            {
                                "example_id": "c256604a-352f-4520-b261-0ecca1a265df",
                                "sense_id": "03bac5f1-ec7d-3759-8100-320dcf884c46",
                                "text": "Toen geprobeerd werd het schip te bergen, brak het in twee stukken en zonk het. Over een lengte van drieduizend kilometer werden de Atlantische kusten van Zuid-Europa vervuild met olie. Het was de grootste milieuramp in Spanje ooit."
                            }
                        ]
                    }
                ],
