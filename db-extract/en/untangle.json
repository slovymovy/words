                                        "glosses": [
                                            "Défaire des cheveux qui étaient nattés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364f6d7d-9488-4c92-b681-825e31630c42",
                                                "sense_id": "4208f7a5-e1cb-3e22-827f-903c2acc17a8",
                                                "text": "Dénatter des cheveux."
                                            },
                                            {
                                                "example_id": "4ad0ea74-8102-4a66-a95b-0b44d95d43b9",
                                                "sense_id": "4208f7a5-e1cb-3e22-827f-903c2acc17a8",
                                                "text": "Dénatter les crins d’un cheval."
                                            },
                                            {
                                                "example_id": "a304b4b4-d8a2-496c-9e94-060f663dee6b",
                                                "sense_id": "4208f7a5-e1cb-3e22-827f-903c2acc17a8",
                                                "text": "Se faire dénatter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31469761-bec0-4558-9a10-0ae344c54498",
                        "source_entry_id": "16225360-9ab3-305f-8f10-299388b19730",
                        "source_sense_description": "to remove tangles or knots — see also disentangle",
                        "target_lang_word": "dénouer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dénouer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6905b73b-d1ad-3cff-8b22-a5638d3db84e",
                                        "entry_id": "abc743cd-18ff-3ad5-a9c1-7a38a877c48e",
                                        "glosses": [
                                            "Défaire ce qui forme un nœud, ce qui est noué, ou ce qui est retenu par un nœud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2813020-9125-4814-8f27-44736e9860c2",
                                                "sense_id": "6905b73b-d1ad-3cff-8b22-a5638d3db84e",
                                                "text": "Dénouer des cordons. - Cette corde est nouée si fort qu’on ne saurait la dénouer. Ce ruban s’est dénoué."
                                            },
                                            {
                                                "example_id": "3391caeb-db48-4573-82aa-ba35c415fd15",
                                                "sense_id": "6905b73b-d1ad-3cff-8b22-a5638d3db84e",
                                                "text": "Parce que ses mains tremblaient toujours, il eut beaucoup de mal à dénouer les lacets qui fermaient la musette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db581585-76bf-3c33-92ae-ef34c52d01de",
                                        "entry_id": "abc743cd-18ff-3ad5-a9c1-7a38a877c48e",
                                        "glosses": [
                                            "Rendre plus souple, plus agile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd142892-c0e6-4c85-afff-32fa99ecdb10",
                                                "sense_id": "db581585-76bf-3c33-92ae-ef34c52d01de",
                                                "text": "Les exercices, la chasse, la danse, l’escrime dénouent le corps, les membres. - Les jambes de ce cheval se sont bien dénouées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b11c000-703d-3478-85ff-f536f971ea75",
                                        "entry_id": "abc743cd-18ff-3ad5-a9c1-7a38a877c48e",
                                        "glosses": [
                                            "Démêler, développer ; et il se dit principalement en parlant du nœud, de l’intrigue d’une pièce de théâtre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f805bea-f4ca-40e6-aab7-9368e1d2b876",
                                                "sense_id": "5b11c000-703d-3478-85ff-f536f971ea75",
                                                "text": "La Gazette des Tribunaux publie des romans autrement faits que ceux de Walter Scott, qui se dénouent terriblement, avec du vrai sang et non avec de l’encre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5a0595d-4f26-4693-ba17-b827a8690ea3",
                        "source_entry_id": "16225360-9ab3-305f-8f10-299388b19730",
                        "source_sense_description": "to remove tangles or knots — see also disentangle",
                        "target_lang_word": "entwirren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entwirren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a62c09-03e8-3352-9a0d-668ef8d170b2",
                                        "entry_id": "7eeb69a5-c3a5-3612-80b9-0746a9cfe2a7",
                                        "glosses": [
                                            "etwas, das sich verheddert, verknotet hat, wieder in seine einzelnen Bestandteile zerlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fddfe2-4d31-4da4-85bd-05d8d870e3e0",
                                                "sense_id": "d1a62c09-03e8-3352-9a0d-668ef8d170b2",
                                                "text": "Hilfst du mir, die Wollknäule zu entwirren?"
                                            },
                                            {
                                                "example_id": "b571e5c3-b384-4468-bf8e-d3013346d786",
                                                "sense_id": "d1a62c09-03e8-3352-9a0d-668ef8d170b2",
                                                "text": "„Sie sollen Haarknoten entwirren, für schönen Glanz sorgen und die Durchblutung der Kopfhaut anregen. Doch welche Haarbürste ist wirklich gut?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2614c890-b966-3735-98f7-9d65ffede4b8",
                                        "entry_id": "7eeb69a5-c3a5-3612-80b9-0746a9cfe2a7",
                                        "glosses": [
                                            "eine unklare, undeutliche Situation/Information aufklären oder auch verständlich machen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1affb4b-77a8-41a8-b619-527de587accb",
                                                "sense_id": "2614c890-b966-3735-98f7-9d65ffede4b8",
                                                "text": "Es dauerte recht lange, bis ich die verschiedenen Verwandschaftsbeziehungen und Geschäftsbeziehungen in meiner angeheirateten Familie entwirrt hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
