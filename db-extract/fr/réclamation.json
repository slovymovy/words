        "fr-extract.jsonl": [
            {
                "entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                "word": "réclamation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4612fc23-45b2-48df-9b96-1c0fe9e74ed1",
                        "entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                        "tags": [
                            "plural"
                        ],
                        "form": "réclamations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                        "entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                        "glosses": [
                            "Action de protester, de s’opposer, de revendiquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f84501c-867a-47f6-8b4a-ab5eb318f208",
                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                "text": "La réclamation préalable est également indispensable d’un point de vue juridique, l’absence de réclamation préalable empêchant la saisine du juge fiscal."
                            },
                            {
                                "example_id": "4894851b-0a39-46d8-9ad2-0554e8ee95f9",
                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                "text": "Car, c’est en usant de la liberté, qu'on peut s'entendre, se consulter, se faire éclairer par les gens instruits, puis après se syndiquer pour faire valoir ses réclamations."
                            },
                            {
                                "example_id": "8bcc4639-57dd-41c0-9f45-aeb65763c59e",
                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                "text": "[…] la mendicité est soumise, en Belgique, à un arbitraire adminis­tratif que l’on peut comparer à celui de la police des mœurs ; on sait que cette police, malgré d’innombrables réclamations, continue à être presque souveraine en France."
                            },
                            {
                                "example_id": "78d9eb1b-5ce8-4f67-9b87-9d25d6e43888",
                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                "text": "Cette loi excita beaucoup de réclamations."
                            },
                            {
                                "example_id": "d0a444c8-511c-4d4f-89f0-3c62dc29968e",
                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                "text": "Cet avis a passé sans réclamation, malgré toutes les réclamations."
                            },
                            {
                                "example_id": "5923297b-03b6-4ba3-96b4-bb33693aee5e",
                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                "text": "Réclamation d’état : Action judiciaire ayant pour objet de faire statuer sur l’état civil d’une personne à laquelle il est contesté."
                            }
                        ]
                    },
                    {
                        "sense_id": "db3610bb-6668-306b-b3fa-abf281ed0cf0",
                        "entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                        "glosses": [
                            "Expression d’une insatisfaction qu’un client attribue à son fournisseur et qu'il demande de traiter."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "936d7d6c-b2f9-4c14-8ad6-cb0b1bbcc1ee",
                                "sense_id": "db3610bb-6668-306b-b3fa-abf281ed0cf0",
                                "text": "Le directeur a dû traiter les réclamations quotidiennes des clients de sa société."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fbf1f8d-0d8c-4536-9a96-b31a41226ca9",
                        "source_entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                        "target_lang_word": "complaint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complaint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "The act of complaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7bbb8d-cb6c-41f8-b3a7-54949c2b5b35",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "customer complaints"
                                            },
                                            {
                                                "example_id": "39915696-1c7d-4a3e-a049-bb8c72bce35b",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "noise complaints"
                                            },
                                            {
                                                "example_id": "e32e11cf-072e-48bb-b5c9-674a6049f35d",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "file complaints"
                                            },
                                            {
                                                "example_id": "9502a581-463e-4db5-aac0-b810a841b18e",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "The company received numerous complaints about the product."
                                            },
                                            {
                                                "example_id": "ab871c97-3c9e-401d-83d6-889b37f18fc0",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "He filed complaints with the housing authority."
                                            },
                                            {
                                                "example_id": "b431d094-92b1-4566-a851-294c3b904fab",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "Complaints have risen in particular from passengers changing trains, who have observed little or no improvement in their ability to navigate between the station's 13 platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "A grievance, problem, difficulty, or concern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9945dc4c-16bc-46f8-aa7d-4544e8cb4ec0",
                                                "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                                                "text": "I have no complaints about the quality of his work, but I don't enjoy his company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e463f31c-2b18-3adb-983b-f2dde912c82a",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "In a civil action, the first pleading of the plaintiff setting out the facts on which the claim is based."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e04f556-0304-3958-9e08-c01162ed4bfc",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "In criminal law, the preliminary charge or accusation made by one person against another to the appropriate court or officer, usually a magistrate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93892e42-f94d-3429-990d-52bb94eb728f",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "A bodily disorder or disease; the symptom of such a disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a9a44a-d6a9-418a-8a6a-a52d888f82a0",
                                                "sense_id": "93892e42-f94d-3429-990d-52bb94eb728f",
                                                "text": "Don't come too close; I've got this nasty complaint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
