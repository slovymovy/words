                {
                    "sense_id": "41c305a9-6afa-34ee-b690-53922f7fb02a",
                    "sense_definition": "Intoxicating liquor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent all their money on cheap <w>lush</w>.",
