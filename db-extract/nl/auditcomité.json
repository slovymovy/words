                        "entry_id": "4ed72759-c5e5-3f87-a380-bba010b9ff74",
                        "glosses": [
                            "groep mensen die de raad van bestuur van informeert en aanbeveling doet op het gebied van interne en externe risico's die een bedrijf of organisatie loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f015c6ce-8a27-42fd-ba54-f6b476431836",
                                "sense_id": "1fab5eb0-6e6c-3472-86c6-a3e806d03882",
                                "text": "Het Auditcomité oefent toezicht uit op de interne of externe risico’s van een organisatie en de wijze waarop een organisatie daarop controle voert. Dit evaluerend orgaan doet aanbevelingen voor verbeteringen."
                            },
                            {
                                "example_id": "db429ab3-0541-4cb4-bdc8-fc92364827f8",
                                "sense_id": "1fab5eb0-6e6c-3472-86c6-a3e806d03882",
                                "text": "Friso is sinds 2004 onafhankelijk bestuurder bij Telenet. Vorig jaar woonde hij alle vergaderingen van de raad van bestuur bij en drie vergaderingen van het auditcomité."
                            },
                            {
                                "example_id": "322ae393-e288-44f4-b606-f4f9f094d8de",
                                "sense_id": "1fab5eb0-6e6c-3472-86c6-a3e806d03882",
                                "text": "Zijn opvolger Huët trad in 2014 toe tot het toezichtsorgaan van Heineken. Hij stond er afgelopen jaren aan het hoofd van het auditcomité."
                            }
                        ]
                    }
