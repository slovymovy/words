            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17e2c12b-b36b-3432-9379-2ab6e3df1eaa",
                    "sense_definition": "Agir ou se comporter d'une certaine façon envers une personne ou un animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut toujours bien <w>traiter</w> les animaux de compagnie de la maison."
                        },
                        {
                            "text": "Le directeur <w>traite</w> tous ses employés avec le même respect."
                        }
                    ],
                    "common_phrases": [
                        "bien traiter",
                        "traiter en ami"
                    ]
                },
                {
                    "sense_id": "9e4f0d7a-8e95-3376-9267-89ee20d0a248",
                    "sense_definition": "Donner des soins médicaux à une personne malade ou appliquer un remède à une maladie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin <w>traite</w> une maladie rare avec un nouveau médicament efficace."
                        },
                        {
                            "text": "Cette clinique moderne peut <w>traiter</w> les patients atteints d'infections sévères."
                        }
                    ],
                    "synonyms": [
                        "soigner"
                    ],
                    "common_phrases": [
                        "traiter une maladie",
                        "traiter un patient"
                    ]
                },
                {
                    "sense_id": "65d281f6-93dc-38c5-bca4-2b5f8d2e45f8",
                    "sense_definition": "Aborder, développer ou analyser un sujet à l'oral ou par écrit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre récent <w>traite</w> de l'histoire économique de l'Europe."
                        },
                        {
                            "text": "Le professeur a choisi de <w>traiter</w> un sujet complexe pendant le cours."
                        }
                    ],
                    "synonyms": [
                        "disserter"
                    ],
                    "common_phrases": [
                        "traiter un sujet",
                        "traiter une question"
                    ]
                },
                {
                    "sense_id": "9a5254ba-ec2d-30f7-9f0a-0abcf0e87a78",
                    "sense_definition": "Prendre en charge, analyser ou exécuter des tâches, des demandes ou des données numériques.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe doit <w>traiter</w> un dossier urgent avant la fin de la semaine."
                        },
                        {
                            "text": "Ce puissant ordinateur <w>traite</w> les données en quelques secondes seulement."
                        }
                    ],
                    "common_phrases": [
                        "traiter un dossier",
                        "traiter les données",
                        "traiter une demande"
                    ]
                },
                {
                    "sense_id": "d2f9d626-88c1-3194-963c-926b99d5f364",
                    "sense_definition": "Qualifier quelqu'un d'un nom désobligeant ou d'une injure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "qualification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est emporté et a <w>traité</w> son voisin de menteur sans réfléchir."
                        },
                        {
                            "text": "Les enfants se disputent dans la cour et se <w>traitent</w> de tous les noms."
                        }
                    ],
                    "synonyms": [
                        "qualifier",
                        "taxer"
                    ],
                    "common_phrases": [
                        "traiter de menteur",
                        "traiter de tous les noms"
                    ]
                },
                {
                    "sense_id": "7eaa994e-8212-3a87-9cb7-11b91999e328",
                    "sense_definition": "Appliquer un produit chimique ou protecteur sur un matériau, un végétal ou une surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>traiter</w> le bois de la terrasse contre la pluie et les insectes."
                        },
                        {
                            "text": "Le jardinier <w>traite</w> les rosiers avec un mélange naturel pour chasser les parasites."
                        }
                    ],
                    "common_phrases": [
                        "traiter le bois",
                        "traiter les plantes"
                    ]
                },
                {
                    "sense_id": "8c0c8732-796f-36a1-8305-3d2934466ae0",
                    "sense_definition": "Négocier ou conclure un accord formel, une paix ou une convention avec quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "negociation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a fermement refusé de <w>traiter</w> avec ces rebelles armés."
                        },
                        {
                            "text": "Les diplomates se sont réunis pour <w>traiter</w> de la paix dans la région."
                        }
                    ],
                    "synonyms": [
                        "négocier"
                    ],
                    "common_phrases": [
                        "traiter de la paix",
                        "traiter avec un client"
                    ]
                }
            ]
        }
