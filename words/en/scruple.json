{
    "word_family": [
        "scrupulous",
        "unscrupulous",
        "scrupulosity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0bec0388-15d8-38bf-9c04-a2cffe169ba4",
                    "sense_definition": "A feeling of doubt or hesitation about whether an action is morally right.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had no <w>scruples</w> about lying to his boss to get the promotion."
                        },
                        {
                            "text": "She felt a moral <w>scruple</w> regarding the fairness of the new company policy."
                        }
                    ],
                    "synonyms": [
                        "qualm",
                        "hesitation",
                        "misgiving"
                    ],
                    "common_phrases": [
                        "moral scruples",
                        "have no scruples"
                    ]
                },
                {
                    "sense_id": "611fae1c-ff87-3d0e-9983-30e3665def82",
                    "sense_definition": "A very small amount or particle of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was not a <w>scruple</w> of evidence to support his wild claims."
                        },
                        {
                            "text": "He did not possess a <w>scruple</w> of doubt about the final outcome."
                        }
                    ],
                    "synonyms": [
                        "particle",
                        "iota",
                        "trace"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or historical."
                        }
                    ]
                },
                {
                    "sense_id": "154e307a-06bb-36f9-a2fc-07d7ecde9b2b",
                    "sense_definition": "A historical unit of weight equal to about 1.3 grams.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old apothecary measured out exactly one <w>scruple</w> of the dried herb."
                        },
                        {
                            "text": "Ancient medical texts often prescribed a <w>scruple</w> of medicine for various ailments."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in historical contexts regarding pharmacy or weights."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0785c52-a8aa-3d06-a80d-1ecf827c734f",
                    "sense_definition": "To hesitate to do something because it feels morally wrong.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They would not <w>scruple</w> to cheat if they thought they could get away with it."
                        },
                        {
                            "text": "He did not <w>scruple</w> to use his influence to help his friends."
                        }
                    ],
                    "synonyms": [
                        "hesitate",
                        "waver"
                    ],
                    "common_phrases": [
                        "not scruple to"
                    ]
                }
            ]
        }
    ]
}