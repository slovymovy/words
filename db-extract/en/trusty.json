                "senses": [
                    {
                        "sense_id": "26726151-fb25-3e3a-9e63-1af409843654",
                        "entry_id": "f83c2cbf-bd60-35d1-aee5-b83449763a3f",
                        "glosses": [
                            "A trusted person, especially a prisoner who has been granted special privileges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "391c9d28-cfd0-4ecb-9109-d009607f93e7",
                                "sense_id": "26726151-fb25-3e3a-9e63-1af409843654",
                                "text": "We usta have a rule that if a trusty shot an escaping convict, then the trusty would go free."
                            },
                            {
                                "example_id": "dc91eb5a-fcb2-4647-89ad-954a4a48451b",
                                "sense_id": "26726151-fb25-3e3a-9e63-1af409843654",
                                "text": "The cell block is clean and doesn't smell of disinfectant. The trusties do all the work. The supply of trusties is always ample."
                            }
                        ]
                    }
                ],
