                            {
                                "example_id": "60bddd54-a0da-4338-9ad5-600128d99f2d",
                                "sense_id": "4f40b2dc-6ae8-3e75-9030-3d59b1697b58",
                                "text": "„Seit einiger Zeit brandschatzte, wie uns ein Privat-Telegramm aus Köln meldet, ein angeblicher Artillerieoffizier in Begleitung einer Dame die Hotels der größeren rheinisch-westfälischen Städte.“"
                            },
                            {
                                "example_id": "9d21ce89-5af2-4e92-b49e-1588a0da24c4",
                                "sense_id": "4f40b2dc-6ae8-3e75-9030-3d59b1697b58",
                                "text": "„Amerikanische Artillerieoffiziere standen in seinen Diensten.“"
                            }
                        ],
