                    {
                        "translation_id": "6231152a-fdd1-498e-a664-0b5f1a602031",
                        "source_entry_id": "394c243d-432b-300c-aef5-35ccce3742c2",
                        "source_sense_id": "88626c66-5c53-3a9a-b06f-9e9d00045ff5",
