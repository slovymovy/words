                                "target_senses": [
                                    {
                                        "sense_id": "2c76f625-b700-3da9-816e-ae5e9308c011",
                                        "entry_id": "dbc0a57c-8daf-3d12-bb84-2ea8f0ec60f9",
                                        "glosses": [
                                            "not surveyed or mapped"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c394c290-8f71-4f13-aa74-e2022865bf60",
                                                "sense_id": "2c76f625-b700-3da9-816e-ae5e9308c011",
                                                "text": "Far out in the uncharted backwaters of the unfashionable end of the Western Spiral arm of the Galaxy lies a small unregarded yellow sun."
                                            },
                                            {
                                                "example_id": "af8e21d3-5669-4f1b-8af4-72eacb78a727",
                                                "sense_id": "2c76f625-b700-3da9-816e-ae5e9308c011",
                                                "text": "John Wesley Powell ... the one-armed Civil War veteran led nine men in four wooden dories down the untamed and uncharted Colorado River and into the equally untamed and uncharted Grand Canyon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
