                    "frequency": "High",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle ne sait pas <w>exactement</w> à quelle heure le train doit arriver."
                        },
                        {
                            "text": "Le technicien a mesuré <w>exactement</w> la distance entre les deux murs."
                        }
                    ],
