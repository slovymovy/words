                "senses": [
                    {
                        "sense_id": "eebcd478-ef8b-3a3e-a3b7-ecfd3d21fe7c",
                        "entry_id": "837a0727-e523-3219-af6d-c32d00698ac5",
                        "glosses": [
                            "Straftat, bei der Täter und Opfer in einer Beziehung/Partnerschaft waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7788e77-0e3b-4190-8575-8f0897a4256e",
                                "sense_id": "eebcd478-ef8b-3a3e-a3b7-ecfd3d21fe7c",
                                "text": "„Einen Abend nachdem Waltemeyer und Dave Brown sich in der Klinik die beiden Bluter geteilt haben, bekommen Donald Worden und Rick James ihren ersten frischen Mord seit der Monroe Street, eine Beziehungstat wie aus dem Bilderbuch, die sich in der Küche eines Hauses im Süden von Baltimore zugetragen hat: Ein zweiunddreißigjähriger Ehemann liegt auf dem Boden und blutet aus Löchern in seiner Brust, die von Kugeln des Kalibers .22 geschlagen wurden.“"
                            },
                            {
                                "example_id": "11e8d1f9-f123-45dd-ae0d-cba64af4268d",
                                "sense_id": "eebcd478-ef8b-3a3e-a3b7-ecfd3d21fe7c",
                                "text": "„Mit dem Einwand, dass drei Fünftel von D'Addarios Mordfällen mti Drogen zu tun haben und sieben der von Stantons Truppe aufgeklärten Morde Beziehungstaten waren oder sich auf vergleichbare Streitigkeiten zurückführen lassen, braucht man gar nicht zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
