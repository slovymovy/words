                                        "sense_id": "d43b4feb-9b55-3018-8fec-c036a1409c5f",
                                        "entry_id": "58fa0ed0-7915-3426-b5da-83954f9a8f0d",
                                        "glosses": [
                                            "The quantity of goods that can be carried in a freight car."
