                            },
                            {
                                "target_lang_word": "waanzinnig",
                                "target_lang_sense_clarification": "buiten zinnen, verdwaasd"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "лишившийся рассудка"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "умалишённый, сошедший с ума"
                            }
                        ]
                    }
                }
            ]
        }
