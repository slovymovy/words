{
    "word_family": [
        "fading",
        "faded",
        "fader",
        "fadeless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                    "sense_definition": "To lose freshness, color, or brightness; to become faint in hue or tint.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "loss_of_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright red curtains <w>faded</w> after years in the sun.",
                            "target_lang_translations": {
                                "ru": "Ярко-красные шторы <w>выгорели</w> после многих лет на солнце.",
                                "zh": "在阳光下暴晒多年后，鲜红色的窗帘<w>褪色</w>了。"
                            }
                        },
                        {
                            "text": "My favorite blue jeans have <w>faded</w> to a pale sky color.",
                            "target_lang_translations": {
                                "ru": "Мои любимые синие джинсы <w>выцвели</w> до бледно-небесного цвета.",
                                "zh": "我最喜欢的那条蓝色牛仔裤已经<w>掉色</w>成了浅天蓝色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bleach"
                    ],
                    "antonyms": [
                        "darken",
                        "brighten"
                    ],
                    "common_phrases": [
                        "colors fade",
                        "fade in the sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять свежесть, цвет или яркость; становиться бледным.",
                        "zh": "指颜色、光泽或新鲜度逐渐减退，变得暗淡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выцветать",
                                "target_lang_sense_clarification": "терять цвет"
                            },
                            {
                                "target_lang_word": "блёкнуть",
                                "target_lang_sense_clarification": "терять яркость"
                            },
                            {
                                "target_lang_word": "выгорать",
                                "target_lang_sense_clarification": "на солнце"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "褪色",
                                "target_lang_sense_clarification": "指颜色变浅"
                            },
                            {
                                "target_lang_word": "掉色",
                                "target_lang_sense_clarification": "指颜色脱落或变淡"
                            },
                            {
                                "target_lang_word": "枯萎",
                                "target_lang_sense_clarification": "指失去新鲜度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                    "sense_definition": "To disappear gradually; to grow dim or vanish from sight or hearing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music slowly <w>faded</w> into silence at the end of the song.",
                            "target_lang_translations": {
                                "ru": "Музыка медленно <w>затихла</w> в конце песни.",
                                "zh": "歌曲结束时，音乐声慢慢<w>淡出</w>，归于寂静。"
                            }
                        },
                        {
                            "text": "As the boat sailed away, the coastline began to <w>fade</w> from view.",
                            "target_lang_translations": {
                                "ru": "Когда лодка отплыла, береговая линия начала <w>исчезать</w> из виду.",
                                "zh": "随着船只远去，海岸线开始从视野中<w>消失</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decrease",
                        "diminish",
                        "wane",
                        "disappear",
                        "vanish"
                    ],
                    "antonyms": [
                        "appear",
                        "emerge"
                    ],
                    "common_phrases": [
                        "fade away",
                        "fade out",
                        "fade into the distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно исчезать; становиться тусклым или пропадать из виду или слышимости.",
                        "zh": "指逐渐消失，变得模糊或难以察觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "пропадать"
                            },
                            {
                                "target_lang_word": "затухать",
                                "target_lang_sense_clarification": "о звуке или свете"
                            },
                            {
                                "target_lang_word": "растворяться",
                                "target_lang_sense_clarification": "постепенно пропадать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消失",
                                "target_lang_sense_clarification": "指不再可见"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指声音或光线变弱"
                            },
                            {
                                "target_lang_word": "淡出",
                                "target_lang_sense_clarification": "指逐渐隐去"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3a43731-a87c-31da-809a-38f72c1668f2",
                    "sense_definition": "To grow weak; to lose strength or vitality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loss_of_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His energy began to <w>fade</w> after running for two hours.",
                            "target_lang_translations": {
                                "ru": "Его энергия начала <w>иссякать</w> после двух часов бега.",
                                "zh": "跑了两个小时后，他的体力开始<w>衰退</w>。"
                            }
                        },
                        {
                            "text": "Without water, the flowers in the vase will <w>fade</w> quickly.",
                            "target_lang_translations": {
                                "ru": "Без воды цветы в вазе быстро <w>завянут</w>.",
                                "zh": "没有水的话，花瓶里的花很快就会<w>枯萎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weaken",
                        "wither"
                    ],
                    "antonyms": [
                        "strengthen",
                        "flourish"
                    ],
                    "common_phrases": [
                        "fade fast",
                        "memories fade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабеть; терять силу или жизненную энергию.",
                        "zh": "指变得虚弱，失去力量或活力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увядать",
                                "target_lang_sense_clarification": "о растениях или красоте"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "об энергии или чувствах"
                            },
                            {
                                "target_lang_word": "слабеть",
                                "target_lang_sense_clarification": "терять физическую силу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "指力量或活力下降"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指强度降低"
                            },
                            {
                                "target_lang_word": "枯竭",
                                "target_lang_sense_clarification": "指精力耗尽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "846eeff5-6ff6-31f5-b4e6-d25cab32686b",
                    "sense_definition": "To hit a golf ball so that it curves intentionally to the right (for a right-handed player).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "golf_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional golfer <w>faded</w> the ball around the tree to reach the green.",
                            "target_lang_translations": {
                                "ru": "Профессиональный гольфист <w>закрутил</w> мяч вокруг дерева, чтобы попасть на грин.",
                                "zh": "那位职业高尔夫球手打出一记<w>右曲球</w>绕过树木，成功将球送上果岭。"
                            }
                        },
                        {
                            "text": "He learned to <w>fade</w> his shots to avoid the water hazard on the left.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>подкручивать</w> свои удары, чтобы избежать водной преграды слева.",
                                "zh": "他学会了<w>打出右曲球</w>，以避开左侧的水障碍区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fade the ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять удар в гольфе так, чтобы мяч намеренно отклонялся вправо (для правши).",
                        "zh": "高尔夫术语，指击球时使球在飞行中向右侧轻微弯曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкручивать",
                                "target_lang_sense_clarification": "мяч вправо"
                            },
                            {
                                "target_lang_word": "делать фейд",
                                "target_lang_sense_clarification": "термин гольфа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侧旋球",
                                "target_lang_sense_clarification": "指带有侧向旋转的击球"
                            },
                            {
                                "target_lang_word": "右曲球",
                                "target_lang_sense_clarification": "指飞行轨迹向右弯曲的球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0990483c-6144-3a8b-8767-39930dd565ff",
                    "sense_definition": "To bet against someone, especially in dice games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to <w>fade</w> him because he was on a winning streak.",
                            "target_lang_translations": {
                                "ru": "Никто не хотел <w>играть против</w> него, потому что у него была полоса везения.",
                                "zh": "因为他正处于连胜状态，没人愿意跟他<w>对赌</w>。"
                            }
                        },
                        {
                            "text": "I decided to <w>fade</w> the shooter and bet that he would lose.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>поставить против</w> стрелка и поспорил, что он проиграет.",
                                "zh": "我决定<w>押输</w>给那个投掷者，赌他会输。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gambling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать ставку против кого-либо, особенно в игре в кости.",
                        "zh": "指在赌博中与某人对赌，即押注对方会输。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть против",
                                "target_lang_sense_clarification": "делать ставку против"
                            },
                            {
                                "target_lang_word": "принимать ставку",
                                "target_lang_sense_clarification": "отвечать на ставку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对赌",
                                "target_lang_sense_clarification": "指与对方下相反的注"
                            },
                            {
                                "target_lang_word": "押输",
                                "target_lang_sense_clarification": "指赌对方会输"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "890a5af1-c0b2-3e6f-8ac9-6294fc5ac943",
                    "sense_definition": "A haircut where the hair is short or shaved on the sides and longer on top.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "haircut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the barber to get a fresh <w>fade</w> before the party.",
                            "target_lang_translations": {
                                "ru": "Он пошел к парикмахеру, чтобы сделать свежий <w>фейд</w> перед вечеринкой.",
                                "zh": "派对前，他去理发店剪了一个清爽的<w>渐变发型</w>。"
                            }
                        },
                        {
                            "text": "The stylist suggested a high <w>fade</w> to suit his face shape.",
                            "target_lang_translations": {
                                "ru": "Стилист предложил высокий <w>фейд</w>, чтобы он подходил к форме его лица.",
                                "zh": "造型师建议他剪一个高位<w>渐变发型</w>，以修饰脸型。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skin fade"
                    ],
                    "common_phrases": [
                        "high fade",
                        "low fade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стрижка, при которой волосы коротко острижены или выбриты по бокам и длиннее сверху.",
                        "zh": "一种发型，两侧头发修剪得极短或剃光，顶部头发较长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фейд",
                                "target_lang_sense_clarification": "название стрижки"
                            },
                            {
                                "target_lang_word": "стрижка с переходом",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渐变发型",
                                "target_lang_sense_clarification": "指两侧有过渡的短发"
                            },
                            {
                                "target_lang_word": "铲青",
                                "target_lang_sense_clarification": "指将两侧剃短的风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07e896e9-4189-3872-b577-9e3fec48fefc",
                    "sense_definition": "A gradual decrease in the brightness of an image or the volume of sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The song ended with a long <w>fade</w> into silence.",
                            "target_lang_translations": {
                                "ru": "Песня закончилась долгим <w>затуханием</w> в тишину.",
                                "zh": "这首歌以一段漫长的<w>淡出</w>结束，最终归于寂静。"
                            }
                        },
                        {
                            "text": "The director used a slow <w>fade</w> to black to close the scene.",
                            "target_lang_translations": {
                                "ru": "Режиссер использовал медленное <w>затемнение</w>, чтобы завершить сцену.",
                                "zh": "导演用了一个缓慢的<w>渐黑</w>效果来结束这一幕。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fade out",
                        "fade in",
                        "cross fade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенное уменьшение яркости изображения или громкости звука.",
                        "zh": "指图像亮度或声音音量的逐渐减弱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затухание",
                                "target_lang_sense_clarification": "звука"
                            },
                            {
                                "target_lang_word": "затемнение",
                                "target_lang_sense_clarification": "изображения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淡出",
                                "target_lang_sense_clarification": "指声音或画面逐渐消失"
                            },
                            {
                                "target_lang_word": "渐弱",
                                "target_lang_sense_clarification": "指音量逐渐降低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b63d481-de7c-31ae-a475-696e53937e4d",
                    "sense_definition": "A golf shot that curves intentionally to the player's right (for a right-handed player).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "golf_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hit a perfect <w>fade</w> that landed softly on the green.",
                            "target_lang_translations": {
                                "ru": "Он выполнил идеальный <w>фейд</w>, который мягко приземлился на грин.",
                                "zh": "他打出了一记完美的<w>右曲球</w>，轻柔地落在了果岭上。"
                            }
                        },
                        {
                            "text": "Most professional players prefer hitting a <w>fade</w> over a draw for better control.",
                            "target_lang_translations": {
                                "ru": "Большинство профессиональных игроков предпочитают бить <w>фейд</w>, а не дро, для лучшего контроля.",
                                "zh": "大多数职业选手为了更好的控制力，更倾向于打<w>右曲球</w>而不是左曲球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit a fade"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар в гольфе, при котором мяч намеренно отклоняется вправо (для правши).",
                        "zh": "高尔夫球的一种击球方式，球在飞行中向右侧弯曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фейд",
                                "target_lang_sense_clarification": "тип удара"
                            },
                            {
                                "target_lang_word": "подкрутка",
                                "target_lang_sense_clarification": "вращение мяча"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "右曲球",
                                "target_lang_sense_clarification": "指飞行轨迹向右的球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "401af2d1-dbeb-387c-9d74-cbdbf64926fb",
                    "sense_definition": "The act of disappearing from a place so as not to be found; a covert departure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did a quick <w>fade</w> when the police arrived at the scene.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>смылся</w>, когда полиция прибыла на место происшествия.",
                                "zh": "警察到达现场时，他迅速<w>溜走</w>了。"
                            }
                        },
                        {
                            "text": "She pulled a <w>fade</w> from the boring party without saying goodbye.",
                            "target_lang_translations": {
                                "ru": "Она <w>исчезла</w> со скучной вечеринки, не попрощавшись.",
                                "zh": "她没打招呼就从无聊的派对上<w>溜走</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do a fade"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт исчезновения с места так, чтобы не быть найденным; скрытный уход.",
                        "zh": "指为了不被发现而悄悄离开或消失。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезновение",
                                "target_lang_sense_clarification": "внезапный уход"
                            },
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "скрытный уход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溜走",
                                "target_lang_sense_clarification": "指悄悄离开"
                            },
                            {
                                "target_lang_word": "潜逃",
                                "target_lang_sense_clarification": "指隐秘地逃离"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7499e01-36bd-3fe4-a4cb-52cbbc4725a0",
                    "sense_definition": "A fight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was looking to catch a <w>fade</w> with anyone who disrespected him.",
                            "target_lang_translations": {
                                "ru": "Он искал, с кем бы <w>подраться</w>, кто проявил к нему неуважение.",
                                "zh": "他想找任何对他不敬的人<w>打架</w>。"
                            }
                        },
                        {
                            "text": "They went outside to settle their argument with a <w>fade</w>.",
                            "target_lang_translations": {
                                "ru": "Они вышли на улицу, чтобы разрешить свой спор <w>дракой</w>.",
