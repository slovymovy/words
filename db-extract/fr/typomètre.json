                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7a6ddcaf-e27d-4a4a-a1ca-9fe6672461cc",
                        "entry_id": "54f0e1c7-5aab-35f5-abb4-50981684d262",
                        "tags": [
                            "plural"
                        ],
                        "form": "typomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                        "entry_id": "54f0e1c7-5aab-35f5-abb4-50981684d262",
                        "glosses": [
                            "Règle divisée en cicéros, demi cicéros et quarts de cicéros, avec laquelle on évalue les compositions typographiques."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "b342e6b4-4201-41db-a67a-97c87f2bac6f",
                                "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                "text": "On apprécie ensuite les distances, que l’on figurera avec les garnitures en les évaluant à l’aide du typomètre."
                            },
                            {
                                "example_id": "3a099d39-5f7d-4c2e-91fe-0dce45f669ae",
                                "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                "text": "Une minute plus tard, abandonnant qui le massicot, qui le typomètre et qui les brucelles du correcteur, nous organisions, dans notre domaine, une battue méticuleuse."
                            },
                            {
                                "example_id": "39463ca4-0e3d-4927-b4a4-1d1f7126c627",
                                "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                "text": "Il raclait toutes les piges qui se présentaient, avait accepté de devenir technicien du typomètre dans un magazine local où le futur maire faisait ses premiers pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "662253c7-b0c6-43a9-9584-bbbbde62b5e7",
                        "source_entry_id": "54f0e1c7-5aab-35f5-abb4-50981684d262",
                        "source_sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                        "target_lang_word": "Typometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Typometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                        "entry_id": "b832ccf2-9d29-3bfc-883b-c309da6b8ea5",
                                        "glosses": [
                                            "Hilfsmittel zur Bestimmung des Schriftgrads"
                                        ],
                                        "tags": [
                                            "Typografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8b8adf-e7e5-4c55-8f08-22d5ccc03afa",
                                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                                "text": "„Der Diensthabende musste mit einem Blatt Papier, einem Typometer und einem Bleistift als Hilfsmitteln auskommen.“"
                                            },
                                            {
                                                "example_id": "1546f15d-4d56-4ec5-8e63-d4ff33b1a44d",
                                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                                "text": "„Wenn Sie gerade kein Typometer zur Hand haben, aber für dieses Buch Schriften messen sollen, können Sie diese Skala verwenden.“"
                                            },
                                            {
                                                "example_id": "326fc4cd-88a3-4032-b9fa-dc528d942699",
                                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                                "text": "„Zum möglichst genauen Justieren ist ein eigenes Instrument, der Typometer, erfunden worden.“"
                                            },
                                            {
                                                "example_id": "831cd0f0-1a26-49e8-a90f-8a3d71d39ae0",
                                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                                "text": "„Speziell für DTP-Setzer wurde ein Typometer entwickelt, das auf die Besonderheiten des DTP-Maßsystems eingeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
