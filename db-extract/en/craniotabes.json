                "senses": [
                    {
                        "sense_id": "a5fed41a-5ead-347d-891a-56c3e458574e",
                        "entry_id": "16969227-6158-33f9-b71f-64810c24a597",
                        "glosses": [
                            "The medical finding of a softening or thinning of the skull."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d3e9136-5a4f-450b-b787-1918adfac114",
                                "sense_id": "a5fed41a-5ead-347d-891a-56c3e458574e",
                                "text": "Dr. Elsässer applies the terms \"soft occiput, or craniotabes,\" to the particular phase of this affection as he observed it, because it attacked the cranial bones, and especially the occipital bone, producing in these changes precisely analogous to those which rickets occasions in other parts of the skeleton."
                            },
                            {
                                "example_id": "5c3702d7-9b83-494e-81da-341939f690ff",
                                "sense_id": "a5fed41a-5ead-347d-891a-56c3e458574e",
                                "text": "The greater number of cases of acquired rickets develop in the first half year (often in the first three months), with softness of the occiput which Elsässer has well defined as craniotabes."
                            },
                            {
                                "example_id": "deb739ff-bdd6-4349-a607-e925ba51cdb8",
                                "sense_id": "a5fed41a-5ead-347d-891a-56c3e458574e",
                                "text": "Palpate the scalp firmly above and behind the ears to detect craniotabes, a softening of the outer table of the skull."
                            }
                        ]
                    }
                ],
