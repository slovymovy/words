                    {
                        "sense_id": "a3590238-5315-37a8-97e8-924374558e5a",
                        "entry_id": "3aa50a20-5809-3fea-92b7-79d3d2ab1257",
                        "glosses": [
                            "ronde verdikking of verheffing in een anderszins vlak oppervlak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b513c91-5ddf-46d7-9c22-8c36b9e43979",
                                "sense_id": "a3590238-5315-37a8-97e8-924374558e5a",
                                "text": "Dat bobbeltje is een onschuldige vetophoping."
                            },
                            {
                                "example_id": "890c5aa1-7dcc-470f-a0fb-d23ce744c633",
                                "sense_id": "a3590238-5315-37a8-97e8-924374558e5a",
                                "text": "De derde tree van boven die kraakte, een bobbel in het tapijt van de overloop die een vreemd geluid maakte als je er met je volle gewicht op ging staan, het middenstuk van de trapleuning dat piepte als je het te veel belastte."
                            }
                        ]
                    },
                    {
                        "sense_id": "22403d20-cb63-3b65-9b9e-2fa77d30a676",
                        "entry_id": "3aa50a20-5809-3fea-92b7-79d3d2ab1257",
                        "glosses": [
                            "gasbel die zich uit een vloeistof aan het oppervlak vertoont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f160e2f-e421-4dca-ac6d-8c56a6abc373",
                                "sense_id": "22403d20-cb63-3b65-9b9e-2fa77d30a676",
                                "text": "Wanneer je bobbels ziet, begint het water te koken."
                            }
                        ]
                    }
                ],
