                                    },
                                    {
                                        "sense_id": "ec43b13c-65a6-320e-b7c5-9fdd413ae44b",
                                        "entry_id": "ba6a1c14-95ea-38a3-82de-b39b73b47e88",
                                        "glosses": [
                                            "An individual or group that monitors the activities of another entity (such as an individual, corporation, non-profit group, or governmental organization) on behalf of the public to ensure that entity does not behave illegally or unethically."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026cf029-4b92-4daf-b79f-2a9ef03b2aa5",
                                                "sense_id": "ec43b13c-65a6-320e-b7c5-9fdd413ae44b",
                                                "text": "Governments must \"outline how they will reassure passengers that it will be as safe as possible to travel by public transport\", according to industry watchdogs Transport Focus and London TravelWatch."
                                            },
                                            {
                                                "example_id": "8af63dbd-4238-434b-8b5a-f61ff709ac3b",
                                                "sense_id": "ec43b13c-65a6-320e-b7c5-9fdd413ae44b",
                                                "text": "The UK’s data watchdog is seeking clarification from Mark Zuckerberg’s Meta about parental controls on its popular virtual reality headset, as campaigners warned that it could breach an online children’s safety code."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90f89737-56cc-326d-a41a-35ce10e3c5d4",
                                        "entry_id": "ba6a1c14-95ea-38a3-82de-b39b73b47e88",
                                        "glosses": [
                                            "Ellipsis of watchdog timer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
