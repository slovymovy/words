                "senses": [
                    {
                        "sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                        "entry_id": "c623b5bd-77f1-3144-8ec7-1d473ef6c765",
                        "glosses": [
                            "Säulengang oder -halle als Vorbau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a2a0d4-dda8-457b-b061-3179eb8ba644",
                                "sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                                "text": "„An allen vier Seiten war der Platz von Portiken umgeben, unter denen sich Läden, Tavernen und öffentliche Gebäude öffneten.“"
                            },
                            {
                                "example_id": "4da01190-d29d-4afc-b7fa-2464e7b8c150",
                                "sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                                "text": "„An der West- und der Ostfassade bestehen die Portiken aus je acht mächtigen Säulen.“"
                            },
                            {
                                "example_id": "200a8422-9fec-4cd0-9258-6bc50c8d609a",
                                "sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                                "text": "„Der Lettner durchlief als freistehender Portikus die Kirche, die Vorderseite war meist mit drei Arkaden zum Brüderchor hin ausgestaltet.“"
                            },
                            {
                                "example_id": "94588335-aed1-41d4-9afe-4ecdbfe39dc6",
                                "sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                                "text": "„Hinter jedem dorischen oder korinthischen Portikus, hinter dem eine Zentralbehörde amtiert, ist auch eine Geheimabteilung tätig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "624df95e-edd2-4b20-a369-fe33bd6047db",
                        "source_entry_id": "c623b5bd-77f1-3144-8ec7-1d473ef6c765",
                        "source_sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                        "source_sense_description": "Säulengang oder -halle als Vorbau",
                        "target_lang_word": "portico",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portico",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                        "entry_id": "33db6eed-c250-35d3-8e0c-57937e803a62",
                                        "glosses": [
                                            "A porch, or a small space with a roof supported by columns, serving as the entrance to a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e9b01-8852-43d4-8113-d603cd6b90dd",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The amphitheatre hath two portici as that at Niſmes."
                                            },
                                            {
                                                "example_id": "29ed6276-46f1-4547-a284-dd01134f824b",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The great house itself was a large, white, wooden building, with wings on three sides of it. In front, a large portico, extending the entire length of the building, and supported by a long range of columns, gave to the whole establishment an air of solemn grandeur."
                                            },
                                            {
                                                "example_id": "c90fc34b-33ed-4b32-9903-db0ff2d13298",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The long-closed G.W.R. station alongside has a decidedly derelict-looking frontage, with eight gargoyles or figureheads still clinging to the portico."
                                            },
                                            {
                                                "example_id": "1efc4b19-b475-4645-9211-692f82d14c24",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "[…] Porticus Milliaria (portico of the thousand paces) which was the longest, if not the most attractive, of the many portici of ancient Rome."
                                            },
                                            {
                                                "example_id": "bf66a62e-85d4-419b-9ee7-24bc32985ca7",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The portici enhance street life today, as they did when they were first constructed, not simply by providing protection from sun and rain, but by providing attractive public spaces for friends to meet, for business people to conduct business, for vendors to display their wares, for musicians to play their music and for beggars to beg. […] Most tours of Bologna begin in the Piazza Maggiore, on the site of the Roman forum, but it’s important to remember that the piazza didn’t begin to take its present shape till toward the end of the 13th century—after the age of medieval towers, after the citizens began to enjoy their portici."
                                            },
                                            {
                                                "example_id": "3be274a1-33a8-48c9-9223-be65389ca7ec",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "These lines are possibly meant to represent two portici flanking the building on its long sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49e90934-5df2-4256-84e0-4e536e095437",
                        "source_entry_id": "c623b5bd-77f1-3144-8ec7-1d473ef6c765",
                        "source_sense_id": "3ce30cac-ba7d-3e64-84b0-d91acb245e27",
                        "source_sense_description": "Säulengang oder -halle als Vorbau",
                        "target_lang_word": "portique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7338551-3d73-3e27-badf-0f4216fddf01",
                                        "entry_id": "8406c78d-4ea5-3fd5-a45a-50d4fdd3f2b4",
                                        "glosses": [
                                            "Galerie ouverte dont la voûte ou le plafond sont soutenus par des colonnes, par des arcades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "667e253b-9869-40a2-a51d-a3549e8c6d78",
                                                "sense_id": "c7338551-3d73-3e27-badf-0f4216fddf01",
                                                "text": "Du coté de l’est et du nord les murailles n’étaient doublées que par un simple portique."
                                            },
                                            {
                                                "example_id": "f9b06564-67cf-4f5d-b8bd-99add358ee64",
                                                "sense_id": "c7338551-3d73-3e27-badf-0f4216fddf01",
                                                "text": "Les Grecs vivaient au grand air. […] Leurs lieux de réunion, cela est assez connu, étaient des places publiques, généralement voisines des portiques ou colonnades où l’on se réfugiait en cas de pluie."
                                            },
                                            {
                                                "example_id": "f72b15a3-da8a-4e66-ade3-06d92a412111",
                                                "sense_id": "c7338551-3d73-3e27-badf-0f4216fddf01",
                                                "text": "Devant les marches du portique, la mule Macarie s’arrêta sur ses quatre pattes frémissantes, […]"
                                            },
                                            {
                                                "example_id": "c7cd3b30-1a1e-43b7-b5c6-7264c295d74b",
                                                "sense_id": "c7338551-3d73-3e27-badf-0f4216fddf01",
                                                "text": "La mosquée d’El-Sakhra, de forme octogonale, est surmontée d’une coupole qui se dresse dans les cieux à une hauteur de 29 mètres au-dessus du sol de l’Esplanade des mosquées. Elle est entourée de quatre portiques situés aux quatre points cardinaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aba71ede-fcd4-3db0-98bb-cd1be8d42b94",
                                        "entry_id": "8406c78d-4ea5-3fd5-a45a-50d4fdd3f2b4",
                                        "glosses": [
                                            "Construction destinée à des exercices gymnastiques, où des poteaux supportent une poutre transversale à laquelle sont suspendus des agrès."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d92ed330-3b8b-410b-a3e6-d1eb62ba32cc",
                                                "sense_id": "aba71ede-fcd4-3db0-98bb-cd1be8d42b94",
                                                "text": "— Il découvrit les installations et les accessoires d'un endroit où l'on pratiquait le SM. Il y avait là toutes sortes de portiques pour attacher dans toutes les positions, des cages que Louis XI n'eût pas reniées pour y condamner l'un de ses opposants; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7690b126-2730-32c9-993c-7645cf9aa807",
                                        "entry_id": "8406c78d-4ea5-3fd5-a45a-50d4fdd3f2b4",
                                        "glosses": [
                                            "Petite salle à l’entrée d’une maison, vestibule."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb522f4a-99ce-43ab-9eff-da49b6adbbae",
                                                "sense_id": "7690b126-2730-32c9-993c-7645cf9aa807",
                                                "text": "J’ai laissé mes bottes dans le portique pour ne pas salir le plancher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d895483f-7b08-3694-9daf-9262cf78cb22",
                                        "entry_id": "8406c78d-4ea5-3fd5-a45a-50d4fdd3f2b4",
                                        "glosses": [
                                            "Appareil de levage en forme de pont se déplaçant au sol sur des rails, ou une structure fixe sur lequel un chariot de levage peut se déplacer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a193316-9edc-49e2-bd7d-df0ba88c0608",
                                                "sense_id": "d895483f-7b08-3694-9daf-9262cf78cb22",
                                                "text": "Zarzavadjian avait appris à aimer l'univers enchevêtré des arrière-gares et des voies de triage. Tous les poteaux, les potences et les portiques et leurs signalisations suspendues. […]. Et bien entendu l'infinie arborescence des rails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7b1a1c-4d74-38cc-a454-9b19085f844a",
                                        "entry_id": "8406c78d-4ea5-3fd5-a45a-50d4fdd3f2b4",
                                        "glosses": [
                                            "Cadre de métal à quatre pattes auquel on accroche, par exemple, une balançoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b545ae8f-478c-4c3a-a7a4-cedf217da417",
                                                "sense_id": "1f7b1a1c-4d74-38cc-a454-9b19085f844a",
                                                "text": "La maison, boulevard Alexandre-Martin, était claire et s'ouvrait sur un jardin fleuri où rouillait un portique sans balançoire. Personne n'a jamais su pourquoi il était là, inutile, oublié, encombrant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
