                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small, round ball at the end of a barrel of a gun used for aiming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b61e287a-7969-4a2b-a563-f505b69a88bb",
                                                "sense_id": "e9850a9e-395d-3b7a-a548-1e6c10280340",
                                                "text": "She drew a bead on the target and fired."
                                            },
                                            {
                                                "example_id": "c4290d32-f0f4-4201-a7f9-ed6625eda917",
                                                "sense_id": "e9850a9e-395d-3b7a-a548-1e6c10280340",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7730dcf7-9f7d-3a0e-bcbe-f1a8f6447b75",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small, round ball at the end of a barrel of a gun used for aiming.",
                                            "Knowledge sufficient to direct one's activities to a purpose."
                                        ],
