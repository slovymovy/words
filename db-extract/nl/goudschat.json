                "senses": [
                    {
                        "sense_id": "1d570d98-24fa-38eb-b6ef-2ed215f7c27f",
                        "entry_id": "e296929a-e4e0-3126-85e1-2a3250cf93f3",
                        "glosses": [
                            "grote, waardevolle hoeveelheid goud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a15292f-69c2-4e6d-8d0d-536cc95ef8ae",
                                "sense_id": "1d570d98-24fa-38eb-b6ef-2ed215f7c27f",
                                "text": "Voor de kust van Israël is een enorme goudschat gevonden. Leden van een lokale duikersvereniging zagen iets fonkelen op de bodem van de zee. Ze dachten nog even dat het speelgoedgeld was, maar ontdekten al snel dat de partij veel meer waard was dan wat plastic dukaten."
                            },
                            {
                                "example_id": "c8e011bf-f789-4e61-8f57-23e6e31ee2d4",
                                "sense_id": "1d570d98-24fa-38eb-b6ef-2ed215f7c27f",
                                "text": "In de stad Passau, in de Duitse deelstaat Beieren, hebben bouwvakkers een grote goudschat gevonden. Ze waren bezig een muur af te breken op een privéterrein toen een aantal goudstaven en rollen bladgoud tevoorschijn kwam, schrijft persbureau DPA."
                            }
                        ]
                    }
