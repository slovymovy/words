                ],
                "senses": [
                    {
                        "sense_id": "8c392fd5-e59a-3b48-92d1-e0d8911d2a28",
                        "entry_id": "7821d55c-939e-3c61-ae54-d5d2f3196238",
                        "glosses": [
                            "so, dass es versiegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75e562a-40ff-419c-977c-a998a41c2f75",
                                "sense_id": "8c392fd5-e59a-3b48-92d1-e0d8911d2a28",
                                "text": "„Die neue Kirche möge ein Brothaus werden, das nie versiegbar, gleich einer Quelle, die nie erschöpfbar werde.“"
                            },
                            {
                                "example_id": "31ac80f6-5116-46a5-9ca8-b9b91329d099",
                                "sense_id": "8c392fd5-e59a-3b48-92d1-e0d8911d2a28",
                                "text": "„Spricht man mit dem 75 jährigen Helmut Postai über die Kampfsportart Ringen, so beginnen seine Augen zu funkeln und die positiven, aber auch negativen Erinnerungen sprudeln wie eine nie versiegbare Quelle aus ihm heraus.“"
                            },
                            {
                                "example_id": "a6cb7047-0110-43fa-8478-6b2052c924c2",
                                "sense_id": "8c392fd5-e59a-3b48-92d1-e0d8911d2a28",
                                "text": "„Sie denkt, die Geldquelle des deutschen Mannes ist nie versiegbar und nur für ihr Leben geschaffen.“"
                            },
                            {
                                "example_id": "e2c405f7-4c4a-4291-a18c-259f526b6ada",
                                "sense_id": "8c392fd5-e59a-3b48-92d1-e0d8911d2a28",
                                "text": "„Nichtwissen ist eben etwas, das immer sein wird. Es ist nicht versiegbar, jedenfalls nicht mit unserer momentanen Art zu denken.“"
                            },
                            {
                                "example_id": "a0f9c54c-9ab3-4077-ad98-dc4bc1669870",
                                "sense_id": "8c392fd5-e59a-3b48-92d1-e0d8911d2a28",
                                "text": "„Und der eigentliche Nibelungenhort sollte dabei immer noch alle anderen Schätze bei weitem übertreffen. Er war in den Augen der Urheber quasi unendlich, nicht versiegbar, gigantisch gross.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
