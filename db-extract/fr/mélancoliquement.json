        "fr-extract.jsonl": [
            {
                "entry_id": "a9e7b6f3-79c5-3623-b307-93dca147bb3a",
                "word": "mélancoliquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                        "entry_id": "a9e7b6f3-79c5-3623-b307-93dca147bb3a",
                        "glosses": [
                            "D’une manière mélancolique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd37d081-7a59-4d7f-b323-e5581a74d668",
                                "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                                "text": "Quand la bonne femme y vint, vers les huit heures, avec un copieux déjeuner, elle le trouva assis qui embattait mélancoliquement sa faux."
                            },
                            {
                                "example_id": "6c6c3011-2b49-4643-9c04-299e9aa64023",
                                "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                                "text": "Le soir seulement, au moment où le soleil se couchait, on ouvrait la fenêtre, et la mourante souriait mélancoliquement à son dernier rayon."
                            },
                            {
                                "example_id": "d2978d9f-d3a9-42de-85a4-12f07b695dd3",
                                "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                                "text": "La mer calme grondait mélancoliquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e61a1a74-c870-4458-973d-a93c97fab90a",
                        "source_entry_id": "a9e7b6f3-79c5-3623-b307-93dca147bb3a",
                        "source_sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                        "target_lang_word": "melancholically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fde1b58b-f995-3757-aea6-8d183d333f71",
                                        "entry_id": "6e2ff42c-83e7-3650-bc65-e4578d98fac7",
                                        "glosses": [
                                            "In a melancholic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86832c00-ad36-4290-93cd-b8d981c70213",
                                                "sense_id": "fde1b58b-f995-3757-aea6-8d183d333f71",
                                                "text": "I take the knife and slit the smaller stems free, leaving the stigma alone, dancing melancholically in the wake of my blade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
