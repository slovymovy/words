                        "glosses": [
                            "S’escamoter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2006b2-d36f-429c-9c4d-b2dfe00eac53",
                                "sense_id": "75f8e354-82f5-3ad3-996d-600fa25eff41",
                                "text": "«C'est un classique des spectacles de grande illusion, comme la femme sciée en deux», explique celui qui rêve de s'auto-escamoter à titre professionnel."
                            },
                            {
                                "example_id": "8b40c102-16db-429f-85b6-54773c52d56d",
                                "sense_id": "75f8e354-82f5-3ad3-996d-600fa25eff41",
                                "text": "De plus, scotché ou non, le produit reste présent et il ne va pas s'auto-escamoter par un coup de baguette magique."
                            },
                            {
                                "example_id": "f70c7161-0a57-4ca0-afc6-1f56f9f34ab4",
                                "sense_id": "75f8e354-82f5-3ad3-996d-600fa25eff41",
                                "text": "Je pense qu'il se moque juste des gens qui shootent en mode tout automatique, dans quel cas le flash a tendance à s'auto-escamoter tout seul."
                            }
                        ]
                    }
                ],
