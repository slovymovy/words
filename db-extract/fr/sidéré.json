                    {
                        "sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                        "entry_id": "289b43fc-f1ec-3c3d-8944-71cdc476689b",
                        "glosses": [
                            "Qui est frappé de stupeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0034b6-9d65-4db6-80a0-5589f9da97fb",
                                "sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                                "text": "[…] : tout le visage était redevenu vivant, et les yeux lui lancèrent un regard tel qu’il finit par frissonner et, faisant quelques pas en arrière, prononça, d’une voix sidérée : « il regarde, il regarde, avec des yeux humains ! »"
                            },
                            {
                                "example_id": "80e7ca4d-d6a4-4456-a99a-aac767f34c37",
                                "sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                                "text": "Il admire Vladimir Poutine qu’il croit impressionner, alors que ce dernier le méprise et demeure sidéré que Donald Trump ait pu être élu président des États-Unis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
