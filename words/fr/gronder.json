    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "120409df-ce9b-326c-a84d-b5feac3c2584",
                    "sense_definition": "Réprimander quelqu'un avec sévérité en lui faisant des reproches.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reprimande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le père a <w>grondé</w> son fils parce qu'il n'avait pas rangé sa chambre.",
                            "target_lang_translations": {
                                "en": "The father <w>scolded</w> his son because he hadn't tidied his room.",
                                "de": "Der Vater hat seinen Sohn <w>ausgeschimpft</w>, weil er sein Zimmer nicht aufgeräumt hatte.",
                                "es": "El padre <w>regañó</w> a su hijo porque no había ordenado su habitación.",
                                "zh": "父亲<w>训斥</w>了儿子，因为他没有收拾房间。",
                                "ru": "Отец <w>отругал</w> сына за то, что тот не убрал свою комнату."
                            }
                        },
                        {
                            "text": "Elle avait peur de se faire <w>gronder</w> par la maîtresse après avoir oublié ses devoirs.",
                            "target_lang_translations": {
                                "en": "She was afraid of being <w>scolded</w> by the teacher after forgetting her homework.",
                                "de": "Sie hatte Angst, von der Lehrerin <w>ausgeschimpft</w> zu werden, nachdem sie ihre Hausaufgaben vergessen hatte.",
                                "es": "Tenía miedo de ser <w>regañada</w> por la maestra después de olvidar los deberes.",
                                "zh": "她忘了做作业，很怕被老师<w>训斥</w>。",
                                "ru": "Она боялась, что учительница её <w>отругает</w>, после того как забыла сделать домашнее задание."
                            }
                        }
                    ],
                    "synonyms": [
                        "réprimander",
                        "disputer"
                    ],
                    "common_phrases": [
                        "se faire gronder"
                    ],
                    "target_lang_definitions": {
                        "en": "To scold someone severely by making reproaches.",
                        "de": "Jemanden streng tadeln und ihm dabei Vorwürfe machen.",
                        "es": "Reprender a alguien con severidad, haciéndole reproches.",
                        "zh": "严厉地指责某人，并当面批评他的过错。",
                        "ru": "Строго упрекать кого-либо за его проступки."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scold",
                                "target_lang_sense_clarification": "to scold a child"
                            },
                            {
                                "target_lang_word": "reprimand",
                                "target_lang_sense_clarification": "formal or official rebuke"
                            },
                            {
                                "target_lang_word": "tell off",
                                "target_lang_sense_clarification": "informal, harsh direct rebuke"
                            }
                        ],
