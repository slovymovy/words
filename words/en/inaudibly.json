    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "96b8436f-24da-3aa9-95ab-397e92d2e323",
                    "sense_definition": "In a manner that cannot be heard or is not loud enough to be heard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manner of sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief moved <w>inaudibly</w> through the dark hallway to avoid waking anyone.",
                            "target_lang_translations": {
                                "zh": "小偷<w>无声地</w>穿过黑暗的走廊，以免惊醒任何人。"
                            }
                        },
                        {
                            "text": "She whispered <w>inaudibly</w> to her friend so the teacher would not hear them.",
                            "target_lang_translations": {
                                "zh": "她<w>听不见地</w>对朋友耳语，这样老师就不会听见她们说话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "silently",
                        "soundlessly",
                        "voicelessly"
                    ],
                    "antonyms": [
                        "audibly",
                        "loudly",
                        "vocally"
                    ],
                    "target_lang_definitions": {
                        "zh": "以无法听见或声音不够大的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "听不见地",
                                "target_lang_sense_clarification": "描述声音微弱到无法被察觉的状态。"
                            },
                            {
                                "target_lang_word": "无声地",
                                "target_lang_sense_clarification": "强调动作或声音完全没有发出。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
