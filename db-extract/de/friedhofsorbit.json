                "senses": [
                    {
                        "sense_id": "c464013e-6010-32c6-ae59-c036982a74c9",
                        "entry_id": "73adaa43-3247-358f-bf5c-a186f9e6f088",
                        "glosses": [
                            "Umlaufbahn im Weltraum, in die ausgediente (geostationäre) Satelliten manövriert werden, um potenzielle Gefahren für andere Satelliten zu vermeiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779637e2-bbd0-499a-a07d-5a7aaa971ad9",
                                "sense_id": "c464013e-6010-32c6-ae59-c036982a74c9",
                                "text": "„Nach Ablauf seiner Dienstzeit, die betrug nur wenige Monate, wurde der Reaktor mit einem Raketenmotor auf einen „Friedhofsorbit“ in etwa 950 Kilometer Höhe gebracht.“"
                            },
                            {
                                "example_id": "3e389a7e-4355-4944-b536-aa65e8dface2",
                                "sense_id": "c464013e-6010-32c6-ae59-c036982a74c9",
                                "text": "„Diese beiden Satelliten sind seit Februar letzten Jahres nicht mehr in Betrieb und wurden in der Zwischenzeit in einen Friedhofsorbit verbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
