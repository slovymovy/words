                    {
                        "sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                        "entry_id": "4dab03cc-bbcf-305d-9c48-3dc89d7ba382",
                        "glosses": [
                            "A triumphant shouting; rejoicing; exultation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "32b94fa1-d769-42a9-bb2b-b04adb0d526f",
                                "sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                                "text": "The final whistle triggered scenes of wild jubilation at Eden Park as a nation celebrated a repeat of the outcome from the very first World Cup final in 1987."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "519f547f-2502-47a6-80f2-be2f26123481",
                        "source_entry_id": "4dab03cc-bbcf-305d-9c48-3dc89d7ba382",
                        "source_sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                        "source_sense_description": "triumphant shouting; rejoicing; exultation",
                        "target_lang_word": "Jubel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jubel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                        "entry_id": "dc74b7ba-f329-30be-a0c5-dea69499a9d9",
                                        "glosses": [
                                            "Offenbarung großer Freude durch entsprechendes Verhalten in Gestik, Mimik, Stimme, Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f16a0b-9eb2-4319-a072-cccee4ee961d",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "Der Jubel über den Sieg wollte kein Ende nehmen."
                                            },
                                            {
                                                "example_id": "88850e93-e4cd-484d-a416-0324741739f3",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "„Trotzdem gab es regelmäßig Jubel, wenn Soldatenkolonnen in Uniform ihre Kasernen verließen und sich auf den Weg zu den Bahnhöfen machten.“"
                                            },
                                            {
                                                "example_id": "6640fdac-12a4-4adc-ac4a-3d2066832209",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "„Kein Jubel, kein Frohlocken war jedoch unter der versammelten, größtenteils aus Frauen und Kindern bestehenden Menge zu hören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
