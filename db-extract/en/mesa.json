            {
                "entry_id": "d42c60b1-014e-31e7-8c7a-bb4018b78b1c",
                "word": "mesa",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c9136b3-8ebc-4ad2-884e-2612fe49b47d",
                        "entry_id": "d42c60b1-014e-31e7-8c7a-bb4018b78b1c",
                        "tags": [
                            "plural"
                        ],
                        "form": "mesas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b6263f7-0b4e-3da0-9036-68ba19b98783",
                        "entry_id": "d42c60b1-014e-31e7-8c7a-bb4018b78b1c",
                        "glosses": [
                            "Flat area of land or plateau higher than other land, with one or more clifflike edges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "136b18bd-f827-4695-b425-8836ca6213c5",
                                "sense_id": "8b6263f7-0b4e-3da0-9036-68ba19b98783",
                                "text": "A few more miles of hot sand and gravel and red stone brought us around a low mesa to the Little Colorado River."
                            },
                            {
                                "example_id": "4a5d0840-5836-4720-b000-20ba9723d237",
                                "sense_id": "8b6263f7-0b4e-3da0-9036-68ba19b98783",
                                "text": "Low mesas, dry, treeless, stretch back from the brink of the canyon, often showing smooth surfaces of naked, solid rock."
                            },
                            {
                                "example_id": "5e72ea9f-eb79-4843-88f9-99d1e1afec22",
                                "sense_id": "8b6263f7-0b4e-3da0-9036-68ba19b98783",
                                "text": "Those multitoned buttes and mesas [of the Grand Canyon], and that incandescent sequence of colorful bands that make one of the natural wonders of the world so grand, can also be found over 100 million miles away [on Mars]."
                            }
                        ]
                    },
                    {
                        "sense_id": "d706335b-a604-3404-95d8-df3ee35ed76d",
                        "entry_id": "d42c60b1-014e-31e7-8c7a-bb4018b78b1c",
                        "glosses": [
                            "a structure with components rising above the insulating substrate that surrounds it"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4118b73-3797-497e-a38a-2203647d60fa",
                                "sense_id": "d706335b-a604-3404-95d8-df3ee35ed76d",
                                "text": "The ohmic contacts were deposited at the edge of the mesa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b58099c-d42c-4c47-a948-58d38e7fca0e",
                        "source_entry_id": "d42c60b1-014e-31e7-8c7a-bb4018b78b1c",
