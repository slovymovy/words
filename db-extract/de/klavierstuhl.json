                        "examples": [
                            {
                                "example_id": "080a3dbf-c343-40ec-aced-67d5551d94dc",
                                "sense_id": "c90d670a-69cd-32fa-9b77-55d7632fa3b8",
                                "text": "„Als Sohn eines Musikprofessors und einer Opernsängerin wurde er 1977 in Detmold geboren und saß schon mit vier Jahren auf dem Klavierstuhl.“"
                            },
                            {
                                "example_id": "c3e02e59-51d0-42bc-8917-7eda8a93e268",
                                "sense_id": "c90d670a-69cd-32fa-9b77-55d7632fa3b8",
                                "text": "„Der heute 42-Jährige wurde mit sechs auf den Klavierstuhl gesetzt, zum wirklichen Freund aber entwickelte sich die Gitarre.“"
                            },
                            {
                                "example_id": "44da07a0-5997-483c-b3b4-1c46f73b0558",
                                "sense_id": "c90d670a-69cd-32fa-9b77-55d7632fa3b8",
                                "text": "„Mit 23 übenahm Stan Kenton den Klavierstuhl in Everett Hoaglands Orchester in Los Angeles.“"
                            }
                        ],
