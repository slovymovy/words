                        "examples": [
                            {
                                "example_id": "630bd1ca-41a4-4597-bff2-08387a4af59a",
                                "sense_id": "7eaeb029-3e39-3e13-90d5-028ff55d2cbf",
                                "text": "Thus has he, and many more of the same breed that I\nknow the drossy age dotes on, only got the tune of the\ntime and, out of an habit of encounter, a kind of\nyeasty collection, which carries them through and\nthrough the most profane and winnowed opinions"
                            },
                            {
                                "example_id": "e3d01aec-4094-4819-a999-1ad16a3347c9",
                                "sense_id": "7eaeb029-3e39-3e13-90d5-028ff55d2cbf",
                                "text": "They found the Mass, ’tis true, but in their Mould\nThey purg’d the drossy Oar to current Gold:\nMending their patttern, they escap’d the Curse,\nYet had they not writ better, they’d writ worse."
                            }
                        ]
                    }
