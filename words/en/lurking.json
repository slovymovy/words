{
    "word_family": [
        "lurk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7416fe9-8ac1-31a8-a361-7168bbbf7927",
                    "sense_definition": "Present participle and gerund of <w>lurk</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A shadow was <w>lurking</w> in the dark corner of the room.",
                            "target_lang_translations": {
                                "ru": "В темном углу комнаты <w>скрывалась</w> тень.",
                                "de": "Ein Schatten <w>lauerte</w> in der dunklen Ecke des Raumes."
                            }
                        },
                        {
                            "text": "He felt a <w>lurking</w> suspicion that something was wrong.",
                            "target_lang_translations": {
                                "ru": "Его не покидало <w>тайное</w> подозрение, что что-то не так.",
                                "de": "Er hatte einen <w>schlummernden</w> Verdacht, dass etwas nicht stimmte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lurking in shadows",
                        "lurking suspicion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в засаде, скрывающийся или таящийся где-либо.",
                        "de": "Sich verborgen halten, lauern oder im Verborgenen existieren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрывающийся",
                                "target_lang_sense_clarification": "о человеке или предмете, который прячется"
                            },
                            {
                                "target_lang_word": "таящийся",
                                "target_lang_sense_clarification": "о чувстве или угрозе, которая присутствует незаметно"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lauern",
                                "target_lang_sense_clarification": "auf jemanden oder etwas warten, oft mit böser Absicht"
                            },
                            {
                                "target_lang_word": "sich verstecken",
                                "target_lang_sense_clarification": "sich an einem Ort aufhalten, um nicht gesehen zu werden"
                            },
                            {
                                "target_lang_word": "schlummernd",
                                "target_lang_sense_clarification": "von Gefühlen oder Gefahren, die unbemerkt vorhanden sind"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b032865d-7675-3940-9ae0-17bfe98edaa8",
                    "sense_definition": "The act of staying hidden or waiting in secret.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>lurking</w> of the predator made the animals nervous.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>выслеживание</w> хищником заставляло животных нервничать.",
                                "de": "Das ständige <w>Lauern</w> des Raubtiers machte die Tiere nervös."
                            }
                        },
                        {
                            "text": "His <w>lurking</w> in the hallway was noticed by the security guard.",
                            "target_lang_translations": {
                                "ru": "Его <w>скрытное пребывание</w> в коридоре было замечено охранником.",
                                "de": "Sein <w>Herumlungern</w> im Flur wurde vom Wachmann bemerkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiding",
                        "ambush"
                    ],
                    "common_phrases": [
                        "constant lurking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс скрытного наблюдения или выжидания в засаде.",
                        "de": "Der Vorgang des verborgenen Wartens oder des Auflauerns."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслеживание",
                                "target_lang_sense_clarification": "процесс скрытного наблюдения за кем-либо"
                            },
                            {
                                "target_lang_word": "затаивание",
                                "target_lang_sense_clarification": "состояние ожидания в скрытом месте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Lauern",
                                "target_lang_sense_clarification": "das geduldige Warten in einem Versteck"
                            },
                            {
                                "target_lang_word": "das Auflauern",
                                "target_lang_sense_clarification": "das heimliche Warten auf jemanden, um ihn zu überraschen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}