                            {
                                "example_id": "9d211a07-4a7b-4d68-936b-9df25dac6872",
                                "sense_id": "1c28950d-47ff-347a-832f-0bb80784a9d1",
                                "text": "„Er starrte vor sich hin, bis zwei Studenten in Schlapphosen und mit modisch langem Haar sich zu ihm setzten.“"
                            },
                            {
                                "example_id": "8f4bd585-c4e1-449b-bc7e-23aab5d6fd23",
                                "sense_id": "1c28950d-47ff-347a-832f-0bb80784a9d1",
                                "text": "„Dazu trägt er eine crèmefarbene Schlapphose, die so bequem wirkt wie ein Pyjama, außerdem eine farbig dazu passende Hemdbluse.“"
                            }
                        ],
