                    {
                        "sense_id": "60e2c933-7a19-3429-8a06-dd3eec664c03",
                        "entry_id": "41351e1c-30d4-3dcf-a3a8-566e06603ead",
                        "glosses": [
                            "Angehörige der Aristokratie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b14d6c-a68b-4758-9396-54b4bd7240d6",
                                "sense_id": "60e2c933-7a19-3429-8a06-dd3eec664c03",
                                "text": "Die englische Aristokratin schaute ihn nur schweigend an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f2ba9ff-e1b4-448a-a170-cedf5eec6e89",
                        "source_entry_id": "41351e1c-30d4-3dcf-a3a8-566e06603ead",
                        "source_sense_id": "60e2c933-7a19-3429-8a06-dd3eec664c03",
                        "source_sense_description": "Angehörige der Aristokratie",
                        "target_lang_word": "aristocrat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aristocrat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8ada88-a7c3-3408-9319-93348d2bdf4d",
                                        "entry_id": "075fb10f-d26f-3ba5-b537-819582c14ab3",
                                        "glosses": [
                                            "One of the aristocracy, nobility, or people of rank in a community; one of a ruling class; a noble (originally in Revolutionary France)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4109b37b-a04c-4505-aec5-df4914838cb1",
                                                "sense_id": "0c8ada88-a7c3-3408-9319-93348d2bdf4d",
                                                "text": "The remains of a Roman aristocrat have been unearthed by archaeologists in northern England."
                                            },
                                            {
                                                "example_id": "894bb6e5-4bd0-4696-84ee-cda2a21b3ed4",
                                                "sense_id": "0c8ada88-a7c3-3408-9319-93348d2bdf4d",
                                                "text": "Magazines kept aristocrats on the payroll to facilitate access to jet-set playgrounds like Corfu and Mustique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5239e8e-d0af-3726-a695-5fbad73438db",
                                        "entry_id": "075fb10f-d26f-3ba5-b537-819582c14ab3",
                                        "glosses": [
                                            "A proponent of aristocracy; an advocate of aristocratic government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3985762-bbf2-4242-809b-0c73ef7dc074",
                                                "sense_id": "a5239e8e-d0af-3726-a695-5fbad73438db",
                                                "text": "Professor Fite, in The Platonic Legend, deprecates earlier idealization, and finds Plato to be an aristocrat, something of a snob, and the advocate of a restrictively organized society.\n[…]\nPlato was, as has so often been observed, temperamentally an aristocrat. And he believed that the qualities needed in his rulers were, in general, hereditary, and that given knowledge and opportunity you could deliberately breed for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163a95cc-a7a5-3d1a-9c49-1c8526c40ff4",
                                        "entry_id": "075fb10f-d26f-3ba5-b537-819582c14ab3",
                                        "glosses": [
                                            "A cipher in which the original punctuation and spacing are retained."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a71250ac-835a-407a-9c33-4731382d8dee",
                        "source_entry_id": "41351e1c-30d4-3dcf-a3a8-566e06603ead",
                        "source_sense_id": "60e2c933-7a19-3429-8a06-dd3eec664c03",
                        "source_sense_description": "Angehörige der Aristokratie",
                        "target_lang_word": "aristocrate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aristocrate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82076572-5614-3535-9eff-07adc416def3",
                                        "entry_id": "4fea08e7-f1bc-3919-8cba-c2236e75138e",
                                        "glosses": [
                                            "Membre d’une aristocratie, noble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac88094d-3772-48b5-a4c6-754ea380e91d",
                                                "sense_id": "82076572-5614-3535-9eff-07adc416def3",
                                                "text": "Mondenod, doué d’un cœur excellent et homme de courage, un peu voltairien, fut disposé à faire le gentilhomme, reprit M. Alain ; son éducation aux Grassins, où se trouvaient des nobles, et ses relations galantes lui avait donné les mœurs polies des gens de condition, que l’on appelait alors aristocrates."
                                            },
                                            {
                                                "example_id": "76d74141-f62f-4d7a-80f4-a8319b02510c",
                                                "sense_id": "82076572-5614-3535-9eff-07adc416def3",
                                                "text": "Cette épaisseur, cette lourdeur de la démarche, un certain air rogue, les vestes de chasse à boutons historiés qu’il portait, et qui ménageaient une grande poche dans le dos, deux ou trois chiens galopant autour de lui qu’il sifflait brusquement, c’est bien ainsi que j'imaginais l’aristocrate aux champs."
                                            },
                                            {
                                                "example_id": "fe0ec423-c1a2-4408-a81e-814ef63980d2",
                                                "sense_id": "82076572-5614-3535-9eff-07adc416def3",
                                                "text": "Un système complexe de taxes permettait au gouvernement, aux aristocrates et aux religieux de profiter du travail de la plus grande partie de la population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa12e78f-29ae-3298-8851-51dc68582add",
                                        "entry_id": "4fea08e7-f1bc-3919-8cba-c2236e75138e",
                                        "glosses": [
                                            "Partisan de l’aristocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2d64a3-7240-4264-9312-a1510f953d96",
                                                "sense_id": "fa12e78f-29ae-3298-8851-51dc68582add",
                                                "text": "Ah ! ça ira, ça ira, ça ira\nLes aristocrates à la lanterne\nAh ! ça ira, ça ira, ça ira\nLes aristocrates on les pendra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6759769-dd32-34ff-bbe5-a7f7b0c25205",
                                        "entry_id": "4fea08e7-f1bc-3919-8cba-c2236e75138e",
                                        "glosses": [
                                            "Celui, celle qui en a adopté le genre de vie et les habitudes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9685ccc7-19e5-4fc1-a8b1-ae0188bfe29f",
                                                "sense_id": "f6759769-dd32-34ff-bbe5-a7f7b0c25205",
                                                "text": "Sous prétexte qu’ils se transmettent d’une génération à l’autre une vieille propriété infestée de punaises, ils ont dans l’idée qu’ils sont des aristocrates, alors qu’à parler net ce sont tout bonnement des indigents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aristocrate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f27fb3f3-8b29-3966-94b0-6fad2aa63a28",
                                        "entry_id": "8cdd13ce-17c5-3465-b1f3-42a1430b1bfa",
                                        "glosses": [
