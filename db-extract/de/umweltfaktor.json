                "senses": [
                    {
                        "sense_id": "88e945ac-f541-3336-b960-e109d2687c0a",
                        "entry_id": "931544c5-fe0c-3543-be9c-08c33fa619f1",
                        "glosses": [
                            "ökologischer Faktor, der eine fördernde oder hemmende Wirkung auf die Lebensbedingungen eines Organismus hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19aadb23-99ee-463e-baf6-4cb9ec2a0b3a",
                                "sense_id": "88e945ac-f541-3336-b960-e109d2687c0a",
                                "text": "Zu den Umweltfaktoren zählen sicherlich Klima, Nahrungsangebot und Stressfaktoren."
                            },
                            {
                                "example_id": "1ad9bbaa-9509-42a5-b528-59130f0c7a22",
                                "sense_id": "88e945ac-f541-3336-b960-e109d2687c0a",
                                "text": "„Der Einfluß der geistigen und emotionellen Umweltfaktoren auf die Sprachentwicklung wird sehr deutlich, wenn man die ungenügende sprachliche Entwicklung der Kleinkinder betrachtet, die in Heimen, Kliniken und anderen Institutionen aufwachsen, in denen normale Familienkontakte und die damit verbundenen Anregungen und Geborgenheit fehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
