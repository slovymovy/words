{
    "word_family": [
        "happy",
        "happily",
        "unhappy",
        "unhappiness",
        "unhappily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                    "sense_definition": "The state or emotion of being <w>happy</w>, characterized by feelings of joy, contentment, or satisfaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found <w>happiness</w> in the small things like a warm cup of tea.",
                            "target_lang_translations": {
                                "ru": "Она находила <w>счастье</w> в мелочах, таких как чашка теплого чая."
                            }
                        },
                        {
                            "text": "Many people believe that money can't buy <w>happiness</w> but it can provide comfort.",
                            "target_lang_translations": {
                                "ru": "Многие люди верят, что за деньги не купишь <w>счастья</w>, но они могут обеспечить комфорт."
                            }
                        },
                        {
                            "text": "The birth of their first child brought true <w>happiness</w> to the entire family.",
                            "target_lang_translations": {
                                "ru": "Рождение первого ребенка принесло истинное <w>счастье</w> всей семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "joy",
                        "gladness",
                        "contentment",
                        "delight",
                        "elation",
                        "cheerfulness"
                    ],
                    "antonyms": [
                        "unhappiness",
                        "sadness",
                        "suffering"
                    ],
                    "common_phrases": [
                        "true happiness",
                        "seek happiness",
                        "bring happiness",
                        "find happiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или эмоция человека, который чувствует высшую удовлетворённость жизнью, радость или довольство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счастье",
                                "target_lang_sense_clarification": "состояние глубокого довольства"
                            },
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "чувство удовольствия и весёлое настроение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e996032-d2de-306d-aabb-4507d2f745ed",
                    "sense_definition": "A state of well-being, prosperity, or thriving in life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "well-being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government should focus on the pursuit of <w>happiness</w> and the general welfare of its citizens.",
                            "target_lang_translations": {
                                "ru": "Правительство должно сосредоточиться на стремлении к <w>счастью</w> и общем благополучии своих граждан."
                            }
                        },
                        {
                            "text": "In this context, <w>happiness</w> refers to the overall prosperity and health of the community.",
                            "target_lang_translations": {
                                "ru": "В данном контексте под <w>счастьем</w> понимается общее процветание и здоровье общества."
                            }
                        }
                    ],
                    "synonyms": [
                        "well-being",
                        "prosperity",
                        "felicity"
                    ],
                    "common_phrases": [
                        "pursuit of happiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние благополучия, процветания или успешного развития в жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благополучие",
                                "target_lang_sense_clarification": "спокойная и счастливая жизнь в достатке"
                            },
                            {
                                "target_lang_word": "процветание",
                                "target_lang_sense_clarification": "успешное развитие и преуспевание"
                            },
                            {
                                "target_lang_word": "счастье",
                                "target_lang_sense_clarification": "в контексте общего блага и успеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b4bb95a-4c55-36ae-9a0f-3a5139054348",
                    "sense_definition": "Good luck or good fortune.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wish that all <w>happiness</w> bechance to you on your long journey abroad.",
                            "target_lang_translations": {
                                "ru": "Я желаю, чтобы всяческая <w>удача</w> сопутствовала вам в вашем долгом путешествии за границу."
                            }
                        },
                        {
                            "text": "It was a stroke of pure <w>happiness</w> that we met under such unlikely circumstances.",
                            "target_lang_translations": {
                                "ru": "Это было чистым <w>везением</w>, что мы встретились при таких невероятных обстоятельствах."
                            }
                        }
                    ],
                    "synonyms": [
                        "luck",
                        "fortune",
                        "good luck",
                        "good fortune"
                    ],
                    "antonyms": [
                        "haplessness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean luck"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удача или благоприятное стечение обстоятельств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удача",
                                "target_lang_sense_clarification": "благоприятный случай"
                            },
                            {
                                "target_lang_word": "везение",
                                "target_lang_sense_clarification": "разговорное обозначение удачи"
                            },
                            {
                                "target_lang_word": "счастье",
                                "target_lang_sense_clarification": "устар. или книжн. в значении удачного случая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1987f377-90c3-3303-aa80-4b3ab504c6b2",
                    "sense_definition": "A striking or fortunate elegance and appropriateness, especially in language or art.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "elegance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet's work is marked by a certain <w>happiness</w> of expression that feels entirely unstudied.",
                            "target_lang_translations": {
                                "ru": "Работа поэта отмечена определенной <w>меткостью</w> выражения, которая кажется совершенно естественной."
                            }
                        },
                        {
                            "text": "There is a <w>happiness</w> as well as care in the way she chooses her words.",
                            "target_lang_translations": {
                                "ru": "В том, как она выбирает слова, чувствуется как <w>удачность</w>, так и тщательность."
                            }
                        }
                    ],
                    "synonyms": [
                        "felicity",
                        "grace"
                    ],
                    "common_phrases": [
                        "happiness of expression"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or technical use in criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поразительная или удачная элегантность и уместность, особенно в языке или искусстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меткость",
                                "target_lang_sense_clarification": "точность и уместность выражения"
                            },
                            {
                                "target_lang_word": "удачность",
                                "target_lang_sense_clarification": "уместность и изящество формы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}