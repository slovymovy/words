                        "glosses": [
                            "Wärme, die als Nebenprodukt bei Prozessen anfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5baa58f4-743a-4b54-97cd-e8cb55c1b591",
                                "sense_id": "64d43d59-4b56-3a47-937c-effc3124d525",
                                "text": "Die Abwärme von Industrieanlagen kann man zur Heizung von Gebäuden nutzen."
                            },
                            {
                                "example_id": "8c232df4-ea50-4475-aefc-94a4dd3002e2",
                                "sense_id": "64d43d59-4b56-3a47-937c-effc3124d525",
                                "text": "„Der jüngste Preisschock treibt die Unternehmen dazu, nach den letzten Reserven zu fahnden: zum Beispiel nach Leckagen von Druckluftsystemen, nach stromfressenden Antriebssystemen oder nach Abwärme, die nutzlos in die Atmosphäre verpufft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
