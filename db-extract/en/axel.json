                    {
                        "sense_id": "e5f43b9f-5fb1-3468-9006-b99662cf792c",
                        "entry_id": "2810c53c-c4b7-36df-aba2-85a84e63ef34",
                        "glosses": [
                            "A male given name from the Germanic languages in quiet use since the 19th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91797429-1b73-425d-8dde-6f1df196acdb",
                                "sense_id": "e5f43b9f-5fb1-3468-9006-b99662cf792c",
                                "text": "The riots began after misinformation circulated widely online about the identity and motives of the suspect in the Southport murders, who was named on Thursday as 17-year-old Axel Rudakubana. The media had been unable to name the teenager, who was born in Cardiff to Rwandan parents, because he is under 18."
                            }
                        ]
                    },
                    {
                        "sense_id": "e513a03b-d237-3eaf-b988-a1fda7be3199",
                        "entry_id": "2810c53c-c4b7-36df-aba2-85a84e63ef34",
