                    {
                        "translation_id": "b8afef42-3496-484c-b721-6e09e4ff6095",
                        "source_entry_id": "c7104ae3-4fe2-3ff9-8440-fc212d6153f3",
                        "source_sense_id": "e083750a-1237-3d9b-8ea9-8545f36107e9",
