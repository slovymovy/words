                        "examples": [
                            {
                                "example_id": "47b3f3c9-a8a1-49ab-9802-b171703b82ce",
                                "sense_id": "a560ed02-fc23-3bff-8c2c-b971cd7409f0",
                                "text": "Un decrescendo."
                            },
                            {
                                "example_id": "ce4fe6c0-bb0a-428d-a41e-220783e8053b",
                                "sense_id": "a560ed02-fc23-3bff-8c2c-b971cd7409f0",
                                "text": "La sourdine sonore, plus sonore que sourde, sonore par son intensité, mais tournée vers le decrescendo de par son intentionnalité, ne présuppose-t-elle pas un forte préexistant et prédominant, secondairement atténué ?"
                            },
                            {
                                "example_id": "29d64f02-4796-479f-b7c8-cb0985b812f5",
                                "sense_id": "a560ed02-fc23-3bff-8c2c-b971cd7409f0",
                                "text": "Un soldat ayant négligé les avis de cette inscription, madame Chèvreplat s’en souvint touts les soirs pendant six mois et en parla à voix haute, sans mollesse, sans erreur, sans lassitude et sans decrescendo."
                            }
                        ]
                    }
                ],
