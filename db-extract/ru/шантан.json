                        "examples": [
                            {
                                "example_id": "296650a9-3f3b-44c0-a2e1-e24aabd4a062",
                                "sense_id": "0748bfe6-f736-3101-8702-caf3ba4092d4",
                                "text": "По целым дням бродил я по городу, сдвинув шляпу набекрень и независимо насвистывая самые залихватские мотивы, подслушанные мною в летних шантанах — месте, которое восхищало меня сначала до глубины души."
                            }
                        ]
                    }
