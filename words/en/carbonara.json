    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35753fa0-6130-35ec-8c5f-3d484faef7c2",
                    "sense_definition": "A thick Italian pasta sauce made with cured pork, cheese, egg yolks, and black pepper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pasta_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a rich <w>carbonara</w> sauce using fresh eggs and high-quality cheese.",
                            "target_lang_translations": {
                                "zh": "厨师用新鲜鸡蛋和优质奶酪调制出浓郁的<w>卡邦尼酱</w>。"
                            }
                        },
                        {
                            "text": "Authentic <w>carbonara</w> relies on the quality of the guanciale and the creaminess of the eggs.",
                            "target_lang_translations": {
                                "zh": "正宗的<w>卡邦尼酱</w>取决于猪脸肉的品质和鸡蛋的浓稠度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "creamy carbonara"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种浓郁的意大利面酱，由腌制猪肉、奶酪、蛋黄和黑胡椒制成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡邦尼酱",
                                "target_lang_sense_clarification": "指代制作意大利面的酱汁本身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ab7e5f9-627f-3a23-886b-9da888881a4d",
                    "sense_definition": "A pasta dish, typically spaghetti, served with a sauce of cured pork, cheese, egg, and pepper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pasta_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a delicious plate of <w>carbonara</w> at the local Italian restaurant.",
                            "target_lang_translations": {
                                "zh": "我们在当地的意大利餐厅点了一盘美味的<w>卡邦尼意面</w>。"
                            }
                        },
                        {
                            "text": "She learned how to cook a traditional <w>carbonara</w> while visiting Rome.",
                            "target_lang_translations": {
                                "zh": "她在罗马旅游时学会了如何烹饪传统的<w>卡邦尼意面</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spaghetti carbonara"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种意大利面食，通常为意大利面，配以腌制猪肉、奶酪、鸡蛋和胡椒制成的酱汁。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卡邦尼意面",
                                "target_lang_sense_clarification": "指代整道菜肴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc9bf34c-5f9b-3152-883f-c0a12f13f88a",
                    "sense_definition": "A variation of a pasta dish using bacon or other cured pork instead of traditional guanciale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pasta_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many home cooks make a quick <w>carbonara</w> using simple bacon from the supermarket.",
                            "target_lang_translations": {
                                "zh": "许多家庭厨师会用超市买的普通培根快速制作<w>培根卡邦尼</w>。"
                            }
                        },
                        {
                            "text": "Although not strictly traditional, this <w>carbonara</w> with pancetta is very popular.",
                            "target_lang_translations": {
                                "zh": "虽然算不上严格传统，但这种用意式培根做的<w>培根卡邦尼</w>非常受欢迎。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用培根或其他腌制猪肉代替传统猪脸肉制作的卡邦尼意面变体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "培根卡邦尼",
                                "target_lang_sense_clarification": "指代使用培根制作的改良版菜肴"
                            }
                        ]
                    }
                }
            ]
        },
