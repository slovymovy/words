                            {
                                "example_id": "f20783bd-2704-4e60-be59-2f857c033805",
                                "sense_id": "f21527e0-c98b-3792-8232-d4bf16157b0a",
                                "text": "Die Interkontinentalraketen wurden aus mehreren Raketensilos abgefeuert."
