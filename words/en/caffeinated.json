{
    "word_family": [
        "caffeine",
        "caffeinate",
        "decaffeinate",
        "decaffeination"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68d819a8-678d-3d4c-ae0c-21bd5ebfdea9",
                    "sense_definition": "Containing caffeine, either naturally or as an added ingredient.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caffeine_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers to avoid <w>caffeinated</w> drinks in the late evening because they disrupt her sleep.",
                            "target_lang_translations": {
                                "zh": "她更愿意在深夜避免饮用<w>含咖啡因的</w>饮料，因为它们会扰乱睡眠。"
                            }
                        },
                        {
                            "text": "Many students drink highly <w>caffeinated</w> beverages to stay awake while studying for exams.",
                            "target_lang_translations": {
                                "zh": "许多学生在备考时喝高<w>含咖啡因的</w>饮料来保持清醒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caffeinic"
                    ],
                    "antonyms": [
                        "caffeine-free",
                        "decaf",
                        "decaffeinated"
                    ],
                    "common_phrases": [
                        "caffeinated drinks",
                        "caffeinated beverages",
                        "caffeinated coffee"
                    ],
                    "target_lang_definitions": {
                        "zh": "（饮料或食物等）含有咖啡因的，无论是天然存在还是人工添加的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "含咖啡因的",
                                "target_lang_sense_clarification": "最常用、标准的形容词表述"
                            },
                            {
                                "target_lang_word": "加咖啡因的",
                                "target_lang_sense_clarification": "侧重人工额外添加"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39470685-fce4-3d86-8274-38dbc2388c5f",
                    "sense_definition": "Feeling overly energetic, excited, or stimulated as a result of consuming caffeine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "caffeine_effects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After three cups of strong espresso, he felt excessively <w>caffeinated</w> and could not sit still.",
                            "target_lang_translations": {
                                "zh": "喝了三杯浓缩咖啡后，他感到极度<w>亢奋</w>，根本坐不住。"
                            }
                        },
                        {
                            "text": "The team worked through the night in a highly <w>caffeinated</w> rush to finish the project.",
                            "target_lang_translations": {
                                "zh": "团队靠大量咖啡因提神，在极度<w>亢奋的</w>冲刺中通宵达旦地完成了项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "juiced"
                    ],
                    "common_phrases": [
                        "heavily caffeinated",
                        "fully caffeinated"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used casually to describe an energetic state"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（因摄入咖啡因而）亢奋的，极度兴奋的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "亢奋的",
                                "target_lang_sense_clarification": "形容精神高度兴奋、坐立不安"
                            },
                            {
                                "target_lang_word": "被咖啡因刺激兴奋的",
                                "target_lang_sense_clarification": "具体指受咖啡因影响而精神饱满或激动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed811f99-cb67-3877-8b56-b3d54da0382e",
                    "sense_definition": "simple past and past participle of <w>caffeinate</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "form_of_caffeinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer <w>caffeinated</w> the new soft drink to appeal to younger consumers.",
                            "target_lang_translations": {
                                "zh": "制造商在这款新软饮料中<w>添加了咖啡因</w>，以吸引年轻消费者。"
                            }
                        },
                        {
                            "text": "They had intentionally <w>caffeinated</w> the beverage line to increase energy levels.",
                            "target_lang_translations": {
                                "zh": "他们特意给这一系列饮料<w>加入了咖啡因</w>以提升提神效果。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 caffeinate 的过去式和过去分词；向……中加入咖啡因。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加入咖啡因",
                                "target_lang_sense_clarification": "往饮料中添加咖啡因"
                            },
                            {
                                "target_lang_word": "添加咖啡因",
                                "target_lang_sense_clarification": "向配方或产品中添加咖啡因"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}