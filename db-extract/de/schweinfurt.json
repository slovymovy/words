                        "entry_id": "b4b7efad-b7c3-3805-94bb-827e62e0e89a",
                        "glosses": [
                            "am Main gelegene, kreisfreie Stadt im bayerischen Regierungsbezirk Unterfranken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b820937-39c5-4389-b6df-0400c580c4a1",
                                "sense_id": "8746a79d-ab89-3479-95c5-2abc4b8c975c",
                                "text": "„Am Main, in der Gegend, wo nach der Zeit Schweinfurt erbaut worden ist, wurde zur Zeit des Heidentums ein Götze verehrt, der Lollus hieß.“"
                            },
                            {
                                "example_id": "96f800bb-92ea-4529-ad56-300654ebba21",
                                "sense_id": "8746a79d-ab89-3479-95c5-2abc4b8c975c",
                                "text": "„Er nennt sich Gerhard Piscator aus Schweinfurt« – hier sah der Ankläger den armen Magister mit stechendem Auge an – »der Name ist gefälscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
