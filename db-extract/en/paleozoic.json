                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bc764421-462e-4f24-9cb7-781e4bd84012",
                        "entry_id": "f24056d6-894b-3286-8a4d-0f08bec4bf0b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Paleozoic"
                    },
                    {
                        "form_id": "2101da28-888a-4b5e-ac9f-657284ad4759",
                        "entry_id": "f24056d6-894b-3286-8a4d-0f08bec4bf0b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Paleozoic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4034adf4-c705-3c05-bca7-977a0bf359d5",
                        "entry_id": "f24056d6-894b-3286-8a4d-0f08bec4bf0b",
                        "glosses": [
                            "Of a geologic era within the Phanerozoic eon that comprises the Cambrian, Ordovician, Silurian, Devonian, Carboniferous and Permian periods from about 542 to 250 million years ago, from the age of trilobites to that of reptiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab91648-48f0-4a30-888d-67bbd1820dc5",
                                "sense_id": "4034adf4-c705-3c05-bca7-977a0bf359d5",
                                "text": "‘Itʼs all Paleozoic rock under our feet, this part of the world: to think of it, laid down five hundred million years before, shrugging its shoulders and bringing down the steeples on the churches!’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46a98957-8c7f-4617-bef3-10dcf2450bbc",
                        "source_entry_id": "f24056d6-894b-3286-8a4d-0f08bec4bf0b",
                        "source_sense_id": "4034adf4-c705-3c05-bca7-977a0bf359d5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "paléozoïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paléozoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ea2c51-3d6b-392c-8d4b-595f65e75f0a",
                                        "entry_id": "bd295804-040d-3345-b36f-14528dd3f938",
                                        "glosses": [
                                            "Relatif au Paléozoïque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paléozoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4bcf22-7576-3f48-9552-d7b884338a3d",
                                        "entry_id": "79dc5d2b-8c30-3387-aa7c-c64961c5e493",
                                        "glosses": [
                                            "Variante de Paléozoïque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662fd48c-f1e1-4cff-b3e2-cbdd4f8c6017",
                                                "sense_id": "2c4bcf22-7576-3f48-9552-d7b884338a3d",
                                                "text": "… ce terme doit rester si on ne ramène pas le paléozoïque jusqu'à ce qu'il comprenne tout le carbonifère et le dyas , c'est-à-dire la bonne moitié des strates de la terre, ce qui a amené forcément l'expression néozoique pour l'autre moitié ; …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7d68f5-81bf-46d9-a4e8-0170cf047388",
                        "source_entry_id": "f24056d6-894b-3286-8a4d-0f08bec4bf0b",
                        "source_sense_id": "4034adf4-c705-3c05-bca7-977a0bf359d5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "paläozoisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paläozoisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4c563e3-81df-3de7-95bc-286cd386e30f",
                                        "entry_id": "16adef9d-080e-3f7d-a800-64bbef3b0aeb",
                                        "glosses": [
                                            "das Paläozoikum betreffend; zum Paläozoikum gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bad976b0-3677-46b8-b86e-fd05066bbabe",
                                                "sense_id": "a4c563e3-81df-3de7-95bc-286cd386e30f",
                                                "text": "Zwischen beiden ist die Transaustralische Mobilzone ein überwiegend proterozoisch und paläozoisch stabilisiertes Gebiet."
                                            },
                                            {
                                                "example_id": "86848f90-6cdf-4228-be53-e26be618cbbe",
                                                "sense_id": "a4c563e3-81df-3de7-95bc-286cd386e30f",
                                                "text": "Wenn die jüngsten, die tertiären Kohlenwasserstoffe somit an Bedeutung und Verbreitung alle anderen weit überragen, so steht dies in eigentümlichem Gegensatze zum Verhalten des anderen fossilen Brennstoffes, der Kohle, bei der wohl mehr als neun Zehntel aller bisher ausgebeuteten Mengen paläozisch sind und dem Karbon angehören."
                                            },
                                            {
                                                "example_id": "ffdec694-f628-4679-b0ab-a5a838e3b051",
                                                "sense_id": "a4c563e3-81df-3de7-95bc-286cd386e30f",
                                                "text": "Noch innerhalb der paläozoischen Epoche indessen, nach Ablagerung des Kohlenkalks, tritt damit eine rasche Aenderung ein, indem die vordem so reich entwickelten Crinoideen auf ganz wenige Arten zurücksinken."
                                            },
                                            {
                                                "example_id": "37d6594d-56bb-4b09-b058-001d13346460",
                                                "sense_id": "a4c563e3-81df-3de7-95bc-286cd386e30f",
                                                "text": "Wie Wilson bereits festgehalten hat, beschleunigt sich im Laufe der menschlichen Evolution die gehirnimplizierte Leistungssteigerung und bringt die paläozoisch fundierenden Erbanlagen in die Defensive."
                                            },
                                            {
                                                "example_id": "ada6362e-3900-4b08-960d-1273fa4c0437",
                                                "sense_id": "a4c563e3-81df-3de7-95bc-286cd386e30f",
                                                "text": "Diese Ketten aus sehr altem Gestein (präkambrisch und paläozoisch) bilden die Grenzen dessen, was einst das Russische Turkestan hieß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd5684bf-33b0-4abc-b8cd-9e81714eac5b",
                        "source_entry_id": "f24056d6-894b-3286-8a4d-0f08bec4bf0b",
                        "source_sense_id": "4034adf4-c705-3c05-bca7-977a0bf359d5",
