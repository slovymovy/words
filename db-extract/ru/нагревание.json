                ],
                "senses": [
                    {
                        "sense_id": "7e8fa35d-7a72-3c57-9da8-8e691a81fded",
                        "entry_id": "8864f299-bc5e-3913-8fef-75acc352ff3d",
                        "glosses": [
                            "действие по значению гл. нагревать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce07cd0c-a58d-4dd4-9504-038fa637c7cd",
                                "sense_id": "7e8fa35d-7a72-3c57-9da8-8e691a81fded",
                                "text": "Во избежание нагревания воды в кристаллизаторе конденсирующимся водяным паром, её следует частично вычерпывать или сифонировать и добавлять холодной воды."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed8d184b-2554-4ea0-bd26-48581db966ab",
                        "source_entry_id": "8864f299-bc5e-3913-8fef-75acc352ff3d",
                        "source_sense_id": "7e8fa35d-7a72-3c57-9da8-8e691a81fded",
                        "target_lang_word": "chauffage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauffage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4554365-0b9e-3e38-b560-dcfa971c19ca",
                                        "entry_id": "98c41874-c3da-387a-875a-71c0f95a758e",
                                        "glosses": [
                                            "Action de chauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2b69c9-adb3-41c2-9cfc-de5ae411217d",
                                                "sense_id": "f4554365-0b9e-3e38-b560-dcfa971c19ca",
                                                "text": "L’installation d’une filature doit comprendre également une organisation du système de ventilation, d’humidification et de chauffage."
                                            },
                                            {
                                                "example_id": "5f335e65-ae7e-4df3-a074-8687a1139418",
                                                "sense_id": "f4554365-0b9e-3e38-b560-dcfa971c19ca",
                                                "text": "Les gazettes et les journaux accroissent alors leur public parce que leurs lecteurs se co-abonnent à une feuille et la font circuler dans de petites sociétés ou « coteries » de dix, vingt ou trente personnes ; ils peuvent faire encore mieux et louer un local à frais communs, payer le chauffage et l’éclairage, le gardiennage et l’entretien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d18d2e7-372c-384a-80e9-d761d7809779",
                                        "entry_id": "98c41874-c3da-387a-875a-71c0f95a758e",
                                        "glosses": [
                                            "Manière de chauffer ; système utilisé pour chauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc5bc447-6f77-4044-bcda-407adef1185f",
                                                "sense_id": "8d18d2e7-372c-384a-80e9-d761d7809779",
                                                "text": "Un groupe de trois générateurs dont un fournit la vapeur nécessaire au réchauffage de l’air dans les locomoteurs et dont les deux autres alimentent le chauffage de la gare et la bouillotterie pour le chauffage des trains."
                                            },
                                            {
                                                "example_id": "b58eaacb-54f4-472b-bea6-0f52bb4899d0",
                                                "sense_id": "8d18d2e7-372c-384a-80e9-d761d7809779",
                                                "text": "Le recours massif et typiquement français au chauffage électrique pour écouler la production nucléaire amène à rallumer en cas de grand froid les centrales thermiques comme celle de Cordemais (dont la fermeture n’est pas prévue - ndlr), pour répondre aux pics de consommation."
                                            },
                                            {
                                                "example_id": "db15038a-6b41-42c9-a13f-6f60928eec10",
                                                "sense_id": "8d18d2e7-372c-384a-80e9-d761d7809779",
                                                "text": "Chauffage central : système de distribution de chaleur dans un appartement, une maison, un immeuble à partir d’une source unique."
                                            },
                                            {
                                                "example_id": "e08042b0-2352-4283-8115-9168c01b38a5",
                                                "sense_id": "8d18d2e7-372c-384a-80e9-d761d7809779",
                                                "text": "Chauffage urbain : système de distribution de chaleur alimentant une ville ou un quartier ou un groupe d’immeubles à partir d'usines thermiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f180314d-0c92-3f22-90f3-3e23b2bc8092",
                                        "entry_id": "98c41874-c3da-387a-875a-71c0f95a758e",
                                        "glosses": [
                                            "Ce que l’on consume de bois, de mazout, de gaz chaque année pour se chauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38afc55-32d2-4960-9f57-50448e78be25",
                                                "sense_id": "f180314d-0c92-3f22-90f3-3e23b2bc8092",
                                                "text": "Je dépense beaucoup pour le chauffage."
                                            },
                                            {
                                                "example_id": "1bf5af36-58da-46e6-913c-bde8a232a492",
                                                "sense_id": "f180314d-0c92-3f22-90f3-3e23b2bc8092",
                                                "text": "Il a le chauffage et l’éclairage, : il est chauffé et éclairé gratuitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ccbba8b-62ac-3ace-b122-b559252e51e4",
                                        "entry_id": "98c41874-c3da-387a-875a-71c0f95a758e",
                                        "glosses": [
                                            "Droit de couper dans une forêt une certaine quantité de bois à brûler."
                                        ],
                                        "tags": [
                                            "vieux"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8f6b9d7-d947-471e-a829-288e35a5dec5",
                        "source_entry_id": "8864f299-bc5e-3913-8fef-75acc352ff3d",
                        "source_sense_id": "7e8fa35d-7a72-3c57-9da8-8e691a81fded",
                        "target_lang_word": "échauffement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échauffement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Action d’échauffer ou de s’échauffer ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba6a9e4-527d-4543-9c24-41ccbfd2791b",
                                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                                "text": "La centrale thermique de Vernou-sur-Seine est située approximativement au milieu du bief. D'une puissance totale de 750 MW, elle prélève lorsqu’elle fonctionne à pleine charge, un débit de 28 m³/s qu'elle réchauffe de 7°C, ce qui correspond à un échauffement théorique de la Seine d'environ 2°C pour le débit moyen annuel de 120 m³/s."
                                            },
                                            {
                                                "example_id": "8874d92e-08ba-4c02-b37b-e3df577f6552",
                                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                                "text": "Car tout bourgeois, dans l’échauffement de sa jeunesse, ne fût-ce qu’un jour, une minute, s’est cru capable d’immenses passions, de hautes entreprises."
                                            },
                                            {
                                                "example_id": "d2ebaddb-ddd3-4078-bd7e-2705b4dd5c52",
                                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                                "text": "Compte tenu de la durée de vie de certains radioéléments, le principal atout d’une pile nucléaire tient dans son incomparable durée d’utilisation… qu’on s’en serve ou pas ; et cela sans échauffement de la pile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742fce89-dcfd-3e9b-99f5-c320f5b85134",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Course destinée à s’échauffer, et de manière général mouvements destinés à se préparer à un effort physique, permettant de diminuer le risque d’accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a4a7ec-96f4-480c-b9ce-e23886c37d59",
                                                "sense_id": "742fce89-dcfd-3e9b-99f5-c320f5b85134",
                                                "text": "Ainsi, un échauffement de 5,2 km est organisé par l’Unesco, baptisé \"course du petit-déjeuner\" dès 8 h 30."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fce114bb-3226-3f72-a4e8-92e2168ce8e0",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Trouble intestinal qui se manifeste par la constipation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ac40c4c-e8d1-3999-8c9e-09db36df0f2b",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Pourriture partielle d’un bois récemment abattu par des champignons lignivores, formant des taches noires et blanches typiques ; le bois doté d’échauffure est dit échauffé."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ca55c6-942d-4675-a38e-9ef678b436af",
                                                "sense_id": "9ac40c4c-e8d1-3999-8c9e-09db36df0f2b",
                                                "text": "L'échauffure est le résultat de lʼéchauffement du bois dû à la fermentation de la sève ou à une attaque par des champignons lignivores. Le bois échauffé est utilisé pour ses qualités décoratives. La cause de l'échauffement doit alors être neutralisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
