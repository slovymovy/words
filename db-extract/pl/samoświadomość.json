                                        "sense_id": "065e812a-ab85-39bb-b5d0-5d65a865aabb",
                                        "entry_id": "41a850f3-e88f-32fb-897d-44fe53f5e8b7",
                                        "glosses": [
                                            "A personal trait regarding someone's ability to persistently and accurately perceive their presence amongst other people, and their own knowledge and abilities."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dddc8ce9-87a4-48d4-acd6-4495eb9fc9d0",
                                                "sense_id": "065e812a-ab85-39bb-b5d0-5d65a865aabb",
                                                "text": "As with any good relationship, readers who have experience with ENM say self-awareness and communication are key to keeping things harmonious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66b479e1-270e-42e7-be83-509ef46b49b5",
                        "source_entry_id": "00e19212-2233-3649-bf7f-bf932e301cc2",
                        "source_sense_id": "27cbe93d-7c33-389a-b4b6-e2a7cfc7b835",
                        "target_lang_word": "self-consciousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-consciousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc1135d7-569b-310e-b463-4d54635e220d",
                                        "entry_id": "336019d3-6164-35b0-bc6f-276fa20d3ba7",
                                        "glosses": [
                                            "The awareness of the self as an entity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac55bda-a463-4df3-8da7-282fbfcfcf66",
                                                "sense_id": "bc1135d7-569b-310e-b463-4d54635e220d",
                                                "text": "[A]nd that one great and all-important occasion and provocative of these beliefs was actually the rise of self-consciousness — that is, the coming of the mind to a more or less distinct awareness of itself and of its own operation, and the consequent development and growth of Individualism, and of the Self-centred attitude in human thought and action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c62ff1d-74a5-3f25-a24f-940da17563e8",
                                        "entry_id": "336019d3-6164-35b0-bc6f-276fa20d3ba7",
                                        "glosses": [
                                            "Shyness; a feeling of unease in social situations."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79dee386-990a-4aee-8d4c-f2f51d4fb6fb",
                                                "sense_id": "7c62ff1d-74a5-3f25-a24f-940da17563e8",
                                                "text": "Adam Gopnik has, by many accounts, including his own, a lovely life. A longtime staff writer for the New Yorker and bestselling author, Gopnik lives in Manhattan with his wife, Martha, a film-maker, and their two children, and he moves in the kind of circles that allow him to drop casual lines into conversation such as: “As John Updike once said to me …”, although he has the nervy Jewish self-consciousness to follow that with “… if you’ll forgive the namedrop.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f1e355-302f-4e8a-88c0-cdde66a4c0ff",
                        "source_entry_id": "00e19212-2233-3649-bf7f-bf932e301cc2",
                        "source_sense_id": "27cbe93d-7c33-389a-b4b6-e2a7cfc7b835",
                        "target_lang_word": "Selbstbewusstsein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbewusstsein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                        "entry_id": "b534826f-1edf-3b1c-b41b-76f40596337f",
                                        "glosses": [
                                            "Selbstwertgefühl, Selbstsicherheit"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29d77dc-7bd8-42d3-883a-2d217e169789",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "Dass ich diese Herausforderung gemeistert habe, hat mein Selbstbewusstsein enorm gesteigert."
                                            },
                                            {
                                                "example_id": "e3c91375-d3da-4184-9da0-8384bcfa4c8a",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Das Selbstbewusstsein der Grünen in Nordrhein-Westfalen war im Frühjahr dieses Jahres groß.“"
                                            },
                                            {
                                                "example_id": "29424a2f-7b22-41e7-a367-1e36b55866eb",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Der Erfolg gab dem Künstler ein neues Selbstbewusstsein.“"
                                            },
                                            {
                                                "example_id": "c7efa12a-6d37-4a18-a60d-a196433f5f17",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Schon dieses Selbstbewusstsein war anstößig.“"
                                            },
                                            {
                                                "example_id": "cdcbfa54-dfbe-48cb-88dd-cd32e0c412ad",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Der theoretische Höchstwert, der ein hohes Maß an Selbstbewusstsein widerspiegelt, liegt bei dieser Befragung bei 25 Punkten.“"
                                            },
                                            {
                                                "example_id": "ed5d9812-b97a-49d8-90f5-35d48cd75d76",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Wenn Sie allerdings spüren, dass die Frau Sie nur nutzt, um ihr Selbstbewusstsein aufzupolieren, sollten Sie sich zurückziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebfd31b2-67c7-341d-b3c9-fe7589847477",
                                        "entry_id": "b534826f-1edf-3b1c-b41b-76f40596337f",
                                        "glosses": [
                                            "Fähigkeit, das eigene Ich zu beobachten und zu reflektieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74f9053-1c31-4930-ac3a-7f1e50d73663",
                                                "sense_id": "ebfd31b2-67c7-341d-b3c9-fe7589847477",
                                                "text": "Moralisches Handeln setzt Selbstbewusstsein voraus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
