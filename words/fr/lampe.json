                    "semantic_group_id": "luminaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il allume la petite <w>lampe</w> de son bureau pour continuer à lire."
                        },
                        {
                            "text": "N'oublie pas d'éteindre la <w>lampe</w> du couloir avant d'aller te coucher."
                        }
                    ],
