                        "glosses": [
                            "Of, pertaining to or typical of an antihero."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de785d0-1cd7-4466-9de1-1272a14caf2f",
                                "sense_id": "10a87965-80c3-367b-bd1a-3b387fd0f0e2",
                                "text": "“Monsieur Verdoux” may once again be timely, but the audacity of its statement derives less from Chaplin’s antiwar polemic than from his antiheroic pose."
                            }
                        ]
