                    {
                        "translation_id": "ab0c5c29-fa60-4f35-8d26-82502625246a",
                        "source_entry_id": "a08cf5c9-3299-3efe-ad8b-8c3121eee572",
                        "source_sense_id": "dbcf944b-1ba5-3b88-9f6d-920e5281ba9b",
                        "source_sense_description": "shop selling groceries",
                        "target_lang_word": "бакале́я",
