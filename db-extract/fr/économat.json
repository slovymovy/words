                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bc501bcf-bde2-43b1-9e6c-5a7ecccdfd81",
                                "sense_id": "8c4fed83-fa45-3671-bf83-3061f37b585b",
                                "text": "Aller à l’économat."
                            }
                        ]
                    },
                    {
                        "sense_id": "15d0f99e-fd7a-39ed-a169-1e023890828b",
                        "entry_id": "c7154465-8982-3d64-b822-791ab7587464",
                        "glosses": [
                            "Magasin de vente à l’usage des ouvriers d’une même grande entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b99438a-f95c-4eff-9166-a576e832bbdf",
                                "sense_id": "15d0f99e-fd7a-39ed-a169-1e023890828b",
                                "text": "Une fois tous les tremblements de terre, le train de l'économat stationnait à la gare, réservé aux titulaires d’une précieuse carte d’employé ou de retraité de la SNCF."
                            }
                        ]
