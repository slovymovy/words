                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b746cb7-df68-3c31-ade1-91615b4535c2",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A cord formed by spinning or twisting together textile fibers or filaments into one or more continuous strands, typically used in needlework."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd6b865-4bf0-4bf8-a80c-7326f25408c9",
                                                "sense_id": "0b746cb7-df68-3c31-ade1-91615b4535c2",
                                                "text": "Woolen threads were an occult means, according to the Roman poet Horace, of depriving a person of virility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17fab064-6565-385f-821b-b47e8b2df3e8",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A piece of yarn, especially said of warps and wefts in a woven fabric."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a8e869f-32d6-342b-adb8-34b9b498b0e7",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "Any of various natural (as spiderweb, etc.) or manufactured filaments (as glass, plastic, metal, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c046892-b3df-4b3d-a65d-fd669ddaacff",
                                                "sense_id": "1a8e869f-32d6-342b-adb8-34b9b498b0e7",
                                                "text": "the threads of a spiderweb"
                                            },
                                            {
                                                "example_id": "10628edb-b9d8-4af1-8059-bca22eb9f0c0",
                                                "sense_id": "1a8e869f-32d6-342b-adb8-34b9b498b0e7",
                                                "text": "He walked. To the corner of Hamilton Place and Picadilly, and there stayed for a while, for it is a romantic station by night. The vague and careless rain looked like threads of gossamer silver passing across the light of the arc-lamps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0aff351-2001-3bf5-82ea-bac9e8be6741",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A slender stream of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58032a7f-76fc-46c0-8420-9646470d9516",
                                                "sense_id": "b0aff351-2001-3bf5-82ea-bac9e8be6741",
                                                "text": "a thread of water"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9338ae94-8a2f-335f-9875-be633762e098",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "The line midway between the banks of a stream."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9f8a8d1-2582-3e91-b3f8-af40868d003d",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A screw thread."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6271291-f492-3f05-972f-3f82985fa4a0",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "The continuing course of life; thread of life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "An ordered course, that which connects the successive points in a discourse.",
                                            "A line of reasoning, sequence of ideas, or train of thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a812f5-44a6-427c-8099-2b399126fed8",
                                                "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                                "text": "I’ve lost the thread of what you’re saying."
                                            },
                                            {
                                                "example_id": "9cedc89a-dea5-433a-b1f8-7f7c5b3cda74",
                                                "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                                "text": "I was pondering these things, when an incident, and a somewhat unexpected one, broke the thread of my musings."
                                            },
                                            {
                                                "example_id": "89414d5a-251a-4be1-b636-f8916ac77367",
                                                "sense_id": "b2e94e1c-4ab4-3e09-99da-df82e3f61dcf",
                                                "text": "‘Let him go on. Do not interrupt him. He cannot go back, and maybe could not proceed at all if once he lost the thread of his thought.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6ed44d-ff91-3b69-a031-8fba53d82632",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "An ordered course, that which connects the successive points in a discourse.",
                                            "A continuing theme that modifies the whole discourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7f2a8e-f628-419e-9b4e-39a3840a737c",
                                                "sense_id": "0f6ed44d-ff91-3b69-a031-8fba53d82632",
                                                "text": "All of these essays have a common thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62dec016-d81e-3a59-94e3-3e032667e0fc",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A unit of execution, lighter in weight than a process, usually sharing memory and other resources with other threads executing concurrently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9eaf22f3-3822-3f45-861a-dc840f6d62fb",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A series of posts or messages, consisting of an initial post and responses to it, generally relating to the same subject, on a newsgroup, Internet forum, or social media platform."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9759f4f-07bd-3c01-86d0-0aaf114ea417",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A sequence of connections."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0e0924-6171-3592-af6c-6c79b6cb6420",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "A precarious condition; something that which offers no real or otherwise perceived security."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d010f6-b064-4249-9d27-ef29ce93e71c",
                                                "sense_id": "ef0e0924-6171-3592-af6c-6c79b6cb6420",
                                                "text": "a life hanging by a thread"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17442501-edb4-337f-9c13-38138035e87c",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "The degree of fineness; quality; nature."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd84a08f-c050-48b8-9629-478abffdadd4",
                                                "sense_id": "17442501-edb4-337f-9c13-38138035e87c",
                                                "text": "A neat courtier, / Of a most elegant thread."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72e380ef-e853-33fc-a756-32bad5d52478",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To pass a thread through the eye of a needle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd78a130-6b69-355e-85e4-a8b2c404453d",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To fix (beads, pearls, etc.) upon a thread that is passed through; to string."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To make one's way through or between (a constriction or obstacles)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82fefd8a-fa49-43d4-a6f5-96e62f2d16e4",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "Picking the ball up in his own half, Januzaj threaded a 40-yard pass into the path of Rooney to slice Southampton open in the blink of an eye."
                                            },
                                            {
                                                "example_id": "359b94f3-8fc8-4f62-bb75-617424347bae",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "to thread through narrow passages"
                                            },
                                            {
                                                "example_id": "8faddf13-2044-40d6-8115-7d588aebe6c5",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "I think I can thread my way through here, but it’s going to be tight."
                                            },
                                            {
                                                "example_id": "f31d063a-70e6-4019-afe0-08b10619b43f",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "The line to Uganda goes up the side of a slope in a series of S-bends, and as the telegraph wires follow the line, from below they look like a forest as they thread backwards and forwards about six times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b648c4ab-555f-3fb4-adc0-3183700a7df7",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To make one's way through or between (a constriction or obstacles).",
                                            "To cautiously make (one's way) through a precarious place or situation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c717e54-7aa4-4cd9-b21b-8c8bdc9736be",
                                                "sense_id": "b648c4ab-555f-3fb4-adc0-3183700a7df7",
                                                "text": "He threaded his way through legal entanglements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To pass through; to pierce through; to penetrate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1a8aa3-4127-44b3-9eb3-6a78119699d1",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "And when the Miners by theſe Shafts or Adits do ſtrike or threed a Vein of any Metal […] then the Metal which is digged […] is called Oar […]"
                                            },
                                            {
                                                "example_id": "390e9fca-7948-4f6b-aeda-b632c57b3bf6",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "Tom out here will have leave to thrid you with bullets."
                                            },
                                            {
                                                "example_id": "c87153cd-009c-491f-8561-77b492c3a998",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "Only the swifts were alert and busy, flashing, poising, diving under the eaves; thridding Ned's brain as they passed with a receding sound like that made by pebbles hopping over ice."
                                            },
                                            {
                                                "example_id": "b60f68f3-6301-42c1-9d59-15cca1ac867c",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "On the descent the line is often in cuttings; some are high, such as at Scarcroft, where a cut through firestone and fireclay was necessary, and near Bardsey, where the line threads a deep tree-lined gorge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To interweave as if with thread; to intersperse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da195be0-4884-486e-9fdf-0da9abf8921a",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] the urban landscape threaded with parks and trees to the horizon. The enormous sky over that flat line dazzled clear blue or filled with towers of cumulus clouds."
                                            },
                                            {
                                                "example_id": "f021b7a2-18df-4381-904c-c2d67c43e1ea",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] dark hair threaded with gray pulled back from a face still beautiful in spite of clear evidence of the passage of time."
                                            },
                                            {
                                                "example_id": "9cf2bb23-370d-4e56-8474-ce1f08eeb2f9",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] landscape threaded with rivers, roads, tracks, pathways and an airport runway; one peppered with villages, farms, crofts and distilleries. Visitors to Islay, especially those coming from densely populated urban areas, often mistakenly[…]"
                                            },
                                            {
                                                "example_id": "61c0f3bc-ff5e-4178-b657-d4e4412cb1ad",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] dark hair threaded with early silver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d308fd7f-0ad8-3a72-9772-3f5d7446b731",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To form a screw thread on or in (a bolt, hole, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4135e40e-61a4-41f9-9f8f-e26f2661022b",
                                                "sense_id": "d308fd7f-0ad8-3a72-9772-3f5d7446b731",
                                                "text": "Coordinate term: tap"
                                            },
                                            {
                                                "example_id": "022c7b49-f988-4952-8f73-50444110111e",
                                                "sense_id": "d308fd7f-0ad8-3a72-9772-3f5d7446b731",
                                                "text": "to thread a bolt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d37617-844b-3063-a33a-3e4f584a2541",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To remove (facial hair) by way of a looped thread that is tightly wound in the middle."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dac26f8-e33e-4dd8-b095-9e176bf8d40f",
                                                "sense_id": "17d37617-844b-3063-a33a-3e4f584a2541",
                                                "text": "to thread your eyebrows and trim them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95fc4471-1276-3137-ae54-e6f7cc82f93f",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To feed (a sewing machine or otherwise a projecting or exposing mechanism, such as a projector, a camera, etc.) with film."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4b5e3a2-e465-399a-bdbd-dd6ac1076a01",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
