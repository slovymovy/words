                ],
                "senses": [
                    {
                        "sense_id": "48ac3371-a1e2-34fd-9126-bf95d972af1d",
                        "entry_id": "62f43fc2-94b0-37e7-b214-12075e4db2a5",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5cafa40-52bb-4acf-8699-601e7d18eddb",
                                "sense_id": "48ac3371-a1e2-34fd-9126-bf95d972af1d",
                                "text": "A jednak stało się! Powiedziałem tej bladolicej dziewczynie, że ją kocham, i jutro slę mego groma Leonarda na siwym rumaku do jej babki z epistołą błagającą, aby wstawiła się za mną do jej matki etc., etc., aby na koniec rączka panny Wacławy została własnością twego wiernego sługi."
                            },
                            {
                                "example_id": "0c564169-1d3d-48d6-ba94-3cd2fab7d512",
                                "sense_id": "48ac3371-a1e2-34fd-9126-bf95d972af1d",
                                "text": "Często odnosił wrażenie, że Leonard, który pchnął intelekt na nieodkryte dotąd wyżyny, znalazł tam duże i specjalizowane złoża głupoty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53ffdb43-a3a2-43c3-a7b4-b07cadfffd4c",
                        "source_entry_id": "62f43fc2-94b0-37e7-b214-12075e4db2a5",
                        "source_sense_id": "48ac3371-a1e2-34fd-9126-bf95d972af1d",
                        "target_lang_word": "Leonard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leonard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9be36a86-f73d-379a-b8a6-3920bfbbdc27",
                                        "entry_id": "d2778c97-3e19-3113-8cda-bc2c15c5fcea",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f33f3a-6ac2-4ccb-8d3f-07179ad66e92",
                                                "sense_id": "9be36a86-f73d-379a-b8a6-3920bfbbdc27",
                                                "text": "- - - save the delight of being called \"Leo\" by those whom the newspapers call \"the leading fashionables\", whereas, had he stuck to the city, he might still have been called only Leonard, like his father before him."
                                            },
                                            {
                                                "example_id": "59c920ce-f72e-4bff-8994-bfb5d5db4a42",
                                                "sense_id": "9be36a86-f73d-379a-b8a6-3920bfbbdc27",
                                                "text": "\"You want names, I'll give you names. My name is Leonard Alfred Schneider. What was I doing when I took the name Lenny Bruce? I was moving towards the invisible middle."
                                            }
                                        ]
                                    },
