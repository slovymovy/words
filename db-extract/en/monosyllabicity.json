                        "glosses": [
                            "The state or characteristic of being monosyllabic."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ecd62a3-3fb9-4886-92f6-c3ddd947118c",
                                "sense_id": "3b10faa8-d1a5-30e1-835d-4aa64d89fbcf",
                                "text": "The monosyllabicity of Chinese morphemes and units of writing has certain advantages in the use of operational synonyms of symbols under varying conditions of use."
                            },
                            {
                                "example_id": "2fd6d012-9ab1-4708-83f0-de2fd401de13",
                                "sense_id": "3b10faa8-d1a5-30e1-835d-4aa64d89fbcf",
                                "text": "He was attractive, in a sinister yet compelling way, but taciturn to the point of monosyllabicity."
                            },
                            {
                                "example_id": "7de93067-6601-41f4-a2f8-e157e7219c44",
                                "sense_id": "3b10faa8-d1a5-30e1-835d-4aa64d89fbcf",
                                "text": "It has often been claimed that linguistic evolution leads toward monosyllabicity and that an artificial international language should therefore contain no disyllabic words."
                            }
                        ]
                    }
