                                    {
                                        "sense_id": "1a63cf6b-66e4-3029-96f8-5d76bb26c5c5",
                                        "entry_id": "ac812a60-ae40-382f-a68b-f4442dfe7c8b",
                                        "glosses": [
                                            "Parti politico-religieux libanais, d’obédience chiite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47543610-669e-458d-b73f-152eeaf8b111",
                                                "sense_id": "1a63cf6b-66e4-3029-96f8-5d76bb26c5c5",
                                                "text": "Le Liban est ruiné, le système est vermoulu, mais il n’a pas encore craqué. Et le Hezbollah se tient en embuscade."
                                            },
                                            {
                                                "example_id": "30241abb-f4da-4f74-a6b2-f497a7148b9d",
                                                "sense_id": "1a63cf6b-66e4-3029-96f8-5d76bb26c5c5",
                                                "text": "Toi t’es musclé ? Macha’Allah ! Nous on est armés comme le Hezbollah."
                                            },
                                            {
                                                "example_id": "9b9cc9a4-3cfa-4864-a9ba-03b6bdd3650e",
                                                "sense_id": "1a63cf6b-66e4-3029-96f8-5d76bb26c5c5",
                                                "text": "Le premier ministre israélien, Benyamin Nétanyahou, a recommandé lundi aux citoyens libanais de « s’éloigner de zones dangereuses », à un moment où Israël pilonne des cibles du mouvement islamiste Hezbollah dans le sud et l’est du Liban voisin."
                                            }
                                        ]
                                    }
                                ]
                            }
