                "senses": [
                    {
                        "sense_id": "4fbc077c-923c-3cad-b8e9-01ff06aa3714",
                        "entry_id": "a45fa926-c20b-3f62-b14a-090ff115519c",
                        "glosses": [
                            "A fixed vaulted canopy over a Christian altar, supported on four columns."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9956fbe8-f913-3591-8a10-0133d208c982",
                        "entry_id": "a45fa926-c20b-3f62-b14a-090ff115519c",
                        "glosses": [
                            "A covered receptacle for holding the consecrated wafers of the Eucharist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff450edb-32ee-4632-a32f-fd93464ee2d3",
                                "sense_id": "9956fbe8-f913-3591-8a10-0133d208c982",
                                "text": "Michael came after her, solemnly bearing the teapot like a ciborium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dac9903d-fa56-4062-900f-8af4905a530e",
                        "source_entry_id": "a45fa926-c20b-3f62-b14a-090ff115519c",
                        "source_sense_description": "A fixed vaulted canopy",
                        "target_lang_word": "ciborium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciborium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c74aa75a-f3df-3416-a2ea-d3b0e252990a",
                                        "entry_id": "9e957ad0-96e3-375f-84ed-8288a1950837",
                                        "glosses": [
                                            "Dais (de pierre, de métal ou de bois) qui est porté par quatre colonnes et qui surmonte un autel pour le protéger et le mettre en valeur. À partir de l’époque médiévale c’est le terme « baldaquin » qui est préféré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc1bfa75-9d0a-4d76-a872-f76e629daf93",
                                                "sense_id": "c74aa75a-f3df-3416-a2ea-d3b0e252990a",
                                                "text": "Ces représentations nous montrent soit le tombeau du Christ, soit le ciborium seul, soit le ciborium abrité par la rotonde extérieure."
                                            },
                                            {
                                                "example_id": "2cef872b-9dbb-4276-ad3f-8bbb70c4eec5",
                                                "sense_id": "c74aa75a-f3df-3416-a2ea-d3b0e252990a",
                                                "text": "Chertier réalise une Colombe pour les saintes huiles, offerte à la cathédrale par Napoléon III, signe le ciborium de la basilique de Tours, les portes du portail central de la cathédrale Notre-Dame de Strasbourg."
                                            },
                                            {
                                                "example_id": "597b0acb-5545-4e68-85f8-c38950b22e1d",
                                                "sense_id": "c74aa75a-f3df-3416-a2ea-d3b0e252990a",
                                                "text": "Il montrait l'emplacement où se trouveraient jubé, culot, ciborium et sacraire et émaillait ses explications de considérations historiques et architecturales concernant la particularité des voussures et l'atypie du déambulatoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
