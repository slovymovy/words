                    {
                        "sense_id": "7cac73aa-e18f-351c-8295-b52717d293af",
                        "entry_id": "b690988e-8375-3205-9202-a429fd60e58a",
                        "glosses": [
                            "rzeczywiste posługiwanie się językiem, w odróżnieniu od znajomości języka"
                        ],
