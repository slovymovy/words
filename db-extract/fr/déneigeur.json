                    {
                        "sense_id": "62486b25-567e-3d0d-8d07-343e1e78afaf",
                        "entry_id": "56153dcb-4332-3bf2-af7b-2c53acda1ed7",
                        "glosses": [
                            "professionnel du déneigement."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "047ac59b-5662-430e-86bb-25b60fa4038f",
                                "sense_id": "62486b25-567e-3d0d-8d07-343e1e78afaf",
                                "text": "Le travail se décline aussi autour du combat incessant mené contre l'hiver. Coupeurs de glace, déneigeurs de tout acabit, « aplanisseurs de neige », etc."
                            },
                            {
                                "example_id": "deebb120-d24c-45bc-b1a1-e73761bbc96f",
                                "sense_id": "62486b25-567e-3d0d-8d07-343e1e78afaf",
                                "text": "Il dit souhaiter que sa condamnation serve de leçon aux autres déneigeurs qui seraient tentés de ne pas respecter le Code de la route."
                            },
                            {
                                "example_id": "a848469a-5e4d-4266-9bec-df8be16df359",
                                "sense_id": "62486b25-567e-3d0d-8d07-343e1e78afaf",
                                "text": "Bien qu’ils ne chôment pas lors des tempêtes de neige, les déneigeurs sont soumis aux mêmes lois et aux mêmes règlements que les autres conducteurs de véhicule moteur."
                            }
                        ]
                    }
