                ],
                "senses": [
                    {
                        "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                        "entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                        "glosses": [
                            "A denial; a renunciation; denial of desire or self-interest."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "19308f5a-e2d3-4761-9a5f-78af699e4eb4",
                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                "text": "With abnegation of God, of his honor, and of religion, they may retain the friendship of the court."
                            },
                            {
                                "example_id": "b9afd4d4-d9d6-49ba-977d-46a492fad771",
                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one, while in the case of monk and crusader there must have been a sustaining purpose, and possibly a great abnegation, a leaving of lands and possessions.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52173ebc-8aa9-4222-93d1-c67be83a2984",
                        "source_entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                        "source_sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
