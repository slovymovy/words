                ],
                "senses": [
                    {
                        "sense_id": "d55a9426-0ca0-364c-ab2f-9719db2d3ad3",
                        "entry_id": "85bf1394-b2fd-3832-866e-f939baa88c65",
                        "glosses": [
                            "optische Erhellung als permanentes Sicherheitszeichen, das angibt, in welche Richtung man den Raumes oder das Objekt zu jeder Zeit sicher verlassen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894f94ed-9aaf-45e3-8acb-deced978a884",
                                "sense_id": "d55a9426-0ca0-364c-ab2f-9719db2d3ad3",
                                "text": "„Sicherheitsbeleuchtung ist der Teil der Notbeleuchtung, der Personen das gefahrlose Verlassen eines Gebäudes ermöglicht.“"
                            },
                            {
                                "example_id": "b087c36f-ba76-4125-99c9-b8f2f4ce1e41",
                                "sense_id": "d55a9426-0ca0-364c-ab2f-9719db2d3ad3",
                                "text": "„Eine Sicherheitsbeleuchtung muss gemäß § 35 (7) MBO in innenliegenden notwendigen Treppenräumen in Gebäuden mit einer Höhe nach § 2 Abs. 3 Satz 2 von mehr als 13 m vorhanden sein.“"
                            },
                            {
                                "example_id": "80843f47-ce5b-4410-b0ac-906b6fc86c33",
                                "sense_id": "d55a9426-0ca0-364c-ab2f-9719db2d3ad3",
                                "text": "„Der 2. Rettungsweg ist neben der Sicherheitsstromversorgung und der Sicherheitsbeleuchtung die einzige bauordnungsrechtlich geforderte Redundanz, was darauf zurückzuführen ist, dass der „Ausfall der ersten Versorgungs- bzw. Erschließungsebene“ regelmäßig unterstellt wird bzw. dass der Ausfall des ersten Rettungsweges (vor allem durch Raucheintritt) nicht ausgeschlossen werden kann, ja sogar planmäßig einkalkuliert wird.“"
                            },
                            {
                                "example_id": "44b6c527-2147-4348-a78b-f7880f319eef",
                                "sense_id": "d55a9426-0ca0-364c-ab2f-9719db2d3ad3",
                                "text": "„Der Arbeitgeber hat Sicherheitseinrichtungen zur Verhütung oder Beseitigung von Gefahren, insbesondere Sicherheitsbeleuchtungen, Feuerlöscheinrichtungen, Signalanlagen, Notaggregate und Notschalter sowie raumlufttechnische Anlagen, in regelmäßigen Abständen sachgerecht zu warten und auf ihre Funktionsfähigkeit prüfen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
