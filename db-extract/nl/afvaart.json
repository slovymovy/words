                "translations": [
                    {
                        "translation_id": "222b823a-56d8-49f1-974d-fba953edc2a5",
                        "source_entry_id": "7e8157bf-f2e4-3c6d-9841-c615978cf9f7",
                        "source_sense_id": "f158d6c0-7c12-36d8-a62d-6b8cd8db8d9d",
                        "source_sense_description": "wegvaren van de wal van een vaartuig",
                        "target_lang_word": "departure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "departure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The act of departing or something that has departed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f37bf43-822c-4d43-b05d-9f8c781a200e",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "The departure was scheduled for noon."
                                            },
                                            {
                                                "example_id": "8733b008-122d-442f-a7e6-f2de85cfb329",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "The departure was not unduly prolonged. In the road Mr. Love and the driver favoured the company with a brief chanty running: “Got it?—No, I ain't, 'old on,—Got it? Got it?—No, 'old on sir.”"
                                            },
                                            {
                                                "example_id": "11f822ed-3319-4375-beb3-245d602c6119",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "But the outstanding feature of the new timetable arrangement, additional to the standardised departure times, is the number of intermediate points, in addition to such principal cities as Bristol, Plymouth, Cardiff and Birmingham, that now have departures for Paddington at the same minutes past the hour throughout the day."
                                            },
                                            {
                                                "example_id": "d27d924e-face-4bfa-a84b-290a6c3b0b26",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "Villa spent most of the second period probing from wide areas and had a succession of corners but despite their profligacy they will be glad to overturn the 6-0 hammering they suffered at St James' Park in August following former boss Martin O'Neill's departure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b96ea70-c1ad-3702-8376-12446148ca5a",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "A deviation from a plan or procedure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d9991c-1888-4801-990a-5956d1dbe751",
                                                "sense_id": "0b96ea70-c1ad-3702-8376-12446148ca5a",
                                                "text": "any departure from a national standard"
                                            },
                                            {
                                                "example_id": "cc4fdb11-f9ff-44b5-a12c-5cd587d2d2d4",
                                                "sense_id": "0b96ea70-c1ad-3702-8376-12446148ca5a",
                                                "text": "There are several significant departures, however, from current practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9237fd92-61fd-3482-9db8-1634f7c44cf6",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "A death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51923c57-f2dc-4969-b57d-4c5e09c26e4f",
                                                "sense_id": "9237fd92-61fd-3482-9db8-1634f7c44cf6",
                                                "text": "The time of my departure is at hand."
                                            },
                                            {
                                                "example_id": "d42d739b-030b-4fd2-9787-1154a86c963f",
                                                "sense_id": "9237fd92-61fd-3482-9db8-1634f7c44cf6",
                                                "text": "His timely departure […] barred him from the knowledge of his son's miseries.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e1f441-5208-3545-bdcd-8334bae07678",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The distance due east or west made by a ship in its course reckoned in plane sailing as the product of the distance sailed and the sine of the angle made by the course with the meridian."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "015f8494-5324-3fd7-87d0-3b1d950cf8c3",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The difference in easting between the two ends of a line or curve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d912ab6-cd30-45e1-a8e5-c8a62d6ddf96",
                                                "sense_id": "015f8494-5324-3fd7-87d0-3b1d950cf8c3",
                                                "text": "The area is computed by latitudes and departures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50eb3d0-40f2-3660-ac92-ccf6e458da70",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The desertion by a party to any pleading of the ground taken by him in his last antecedent pleading, and the adoption of another"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a96ffe20-7374-3892-a0be-8a6e8f8e4a90",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "Division; separation; putting away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5af2c1b-7b77-4c60-8766-c29477a81770",
                                                "sense_id": "a96ffe20-7374-3892-a0be-8a6e8f8e4a90",
                                                "text": "no other remedy […] but absolute departure"
                                            }
                                        ]
                                    }
                                ]
                            }
