                    {
                        "translation_id": "d780aad7-8eb1-45e4-a00b-6e163aa69481",
                        "source_entry_id": "7f3c642f-0856-381d-9a69-1c461f32fa48",
                        "source_sense_id": "02f38140-f8df-3bc3-b9b8-e1929692e184",
                        "target_lang_word": "Liebkosung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebkosung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93b5e578-2073-3e5f-a074-abdb032a64c9",
                                        "entry_id": "c3428158-b3f4-38c9-8e7e-507962807d7e",
                                        "glosses": [
                                            "Handlung, jemanden zu liebkosen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eccf9efc-4483-4b04-9057-1468b2c8a049",
                                                "sense_id": "93b5e578-2073-3e5f-a074-abdb032a64c9",
                                                "text": "„Die Liebkosungen der vergangenen Nacht waren brennendes Entzücken gewesen wie vielfarbige Funken eines Feuerwerks, Gluten explodierender Sonnen und Neonlichter im Blut, Kometen, die in die Zentren der Lust zielten.“"
                                            },
                                            {
                                                "example_id": "d8d9cd9d-a857-4f66-be74-2983dad83c65",
                                                "sense_id": "93b5e578-2073-3e5f-a074-abdb032a64c9",
                                                "text": "„Sie entkleideten sich und fingen sogleich ihre Liebkosungen an.“"
                                            },
                                            {
                                                "example_id": "52c97099-863c-41dd-9065-97960a7d39e6",
                                                "sense_id": "93b5e578-2073-3e5f-a074-abdb032a64c9",
                                                "text": "„Sie selbst ließ sich meine Liebkosungen recht ungern gefallen, denn sie hoffte, daß der Harlekin sie heiraten werde, und wollte ihm keinen Anlaß zu einem Zerwürfnis geben.“"
                                            },
                                            {
                                                "example_id": "4a64d641-a56b-4c79-9bd8-0b3e691f9cf6",
                                                "sense_id": "93b5e578-2073-3e5f-a074-abdb032a64c9",
                                                "text": "„Und wieder umschlangen sie das wunderschöne Mädchen und erdrückten es beinahe in ihren Liebkosungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
