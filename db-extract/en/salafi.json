                                        "examples": [
                                            {
                                                "example_id": "cb7cf59c-ed55-482d-b81e-941da7f1970b",
                                                "sense_id": "1d24e5c2-6c41-39ff-824f-7fef63314795",
                                                "text": "De Oostenrijkse regering heeft vrijdag plannen aangekondigd voor het sluiten van verschillende salafistische instellingen en zeven moskeeën. Ook wil het land meerdere imams uitwijzen"
                                            }
