                                    {
                                        "sense_id": "fd30cbd4-55f0-364e-889a-89d96c91b6a9",
                                        "entry_id": "9dc6ec66-449d-3005-a5d3-793adf13d8ae",
                                        "glosses": [
                                            "To use poison to kill or paralyse (somebody)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456f26c2-e780-4e1f-a631-2b8952c797d8",
                                                "sense_id": "fd30cbd4-55f0-364e-889a-89d96c91b6a9",
                                                "text": "The assassin poisoned the king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c13c24d-8c88-35ff-a991-603fd27c4129",
                                        "entry_id": "9dc6ec66-449d-3005-a5d3-793adf13d8ae",
                                        "glosses": [
                                            "To pollute; to cause to become poisonous."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3242c11-5796-4e1d-bcc3-430e5e0e43ad",
                                                "sense_id": "4c13c24d-8c88-35ff-a991-603fd27c4129",
                                                "text": "That factory is poisoning the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53346a38-a093-3355-af53-7f3bbb9d4919",
                                        "entry_id": "9dc6ec66-449d-3005-a5d3-793adf13d8ae",
                                        "glosses": [
                                            "To cause to become much worse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e37aa5-b395-4c81-927e-44740bd69acd",
                                                "sense_id": "53346a38-a093-3355-af53-7f3bbb9d4919",
                                                "text": "Suspicion will poison their relationship."
                                            },
                                            {
                                                "example_id": "4a320f2b-de6a-40da-be5b-655d1629cef3",
                                                "sense_id": "53346a38-a093-3355-af53-7f3bbb9d4919",
                                                "text": "He poisoned the mood in the room with his non-stop criticism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd457b5b-0d35-3578-9ce2-f0e4e8998b9a",
                                        "entry_id": "9dc6ec66-449d-3005-a5d3-793adf13d8ae",
                                        "glosses": [
                                            "To cause (someone) to hate or to have unfair negative opinions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccf9ce7-f776-4123-9d1a-bdbac268c46f",
                                                "sense_id": "dd457b5b-0d35-3578-9ce2-f0e4e8998b9a",
                                                "text": "She's poisoned him against all his old friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af673634-2160-37c5-8fda-1e705a2ae6ea",
                                        "entry_id": "9dc6ec66-449d-3005-a5d3-793adf13d8ae",
                                        "glosses": [
                                            "To inhibit the catalytic activity of."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2c008f0-c304-35ba-9bb3-94254157ca8e",
                                        "entry_id": "9dc6ec66-449d-3005-a5d3-793adf13d8ae",
                                        "glosses": [
                                            "To place false or malicious data into (a cache, etc.) as part of an exploit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e735c79-0150-4af6-a855-98ad15983798",
                                                "sense_id": "f2c008f0-c304-35ba-9bb3-94254157ca8e",
                                                "text": "In this technique, the hacker poisons the cache to launch malware into Web pages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poison",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de3cd308-33ee-3471-949d-59e4d874ac1a",
                                        "entry_id": "403d52f2-0480-34c2-8d74-8aeba67f4888",
                                        "glosses": [
                                            "A substance that is harmful or lethal to a living organism when ingested."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253ea881-86a9-498f-8b99-0fbaf802b6f2",
                                                "sense_id": "de3cd308-33ee-3471-949d-59e4d874ac1a",
                                                "text": "Near-synonym: (loosely) venom"
                                            },
                                            {
                                                "example_id": "d84801e4-9682-4e00-b2a6-48697576de68",
                                                "sense_id": "de3cd308-33ee-3471-949d-59e4d874ac1a",
                                                "text": "We used a poison to kill the weeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7086c64-7514-39d2-97c9-cdb877d5e7d3",
                                        "entry_id": "403d52f2-0480-34c2-8d74-8aeba67f4888",
                                        "glosses": [
                                            "Anything harmful to a person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb255d04-ba20-49a5-bafd-b1271d153d5b",
                                                "sense_id": "c7086c64-7514-39d2-97c9-cdb877d5e7d3",
                                                "text": "Gossip is a malicious poison."
                                            },
                                            {
                                                "example_id": "903a9f0c-a7e6-4dd2-9f4a-9add692f9ed6",
                                                "sense_id": "c7086c64-7514-39d2-97c9-cdb877d5e7d3",
                                                "text": "Awaie with the Rebels ſuffer them not to ſpeake,\nHis words are poyſon in the eares of the people, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b54e5c-ab17-3bb3-8146-69107a431748",
                                        "entry_id": "403d52f2-0480-34c2-8d74-8aeba67f4888",
                                        "glosses": [
                                            "An alcoholic drink. (Mainly in the phrases \\\"name your poison\\\" and \\\"what's your poison?\\\")"
                                        ],
                                        "tags": [
                                            "countable",
                                            "idiomatic",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffb470b8-0f2a-4dd5-ae67-bed62fe01657",
                                                "sense_id": "56b54e5c-ab17-3bb3-8146-69107a431748",
                                                "text": "— What's your poison?\n— I'll have a glass of whiskey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365ec2b2-7674-3fda-bc4a-718853df17f5",
                                        "entry_id": "403d52f2-0480-34c2-8d74-8aeba67f4888",
                                        "glosses": [
                                            "Any substance that inhibits catalytic activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8beb1bae-6715-4b6c-b713-f4fcc8a66b0f",
                                                "sense_id": "365ec2b2-7674-3fda-bc4a-718853df17f5",
                                                "text": "The temperature effect of poisons. The influence of poison on the catalyst can be different with the change of reaction conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
