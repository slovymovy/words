{
    "word_family": [
        "ravel",
        "raveling",
        "unravelment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20ae41a6-8d53-3b45-acac-5c1240f7ff0a",
                    "sense_definition": "To untangle something that is knotted or twisted.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "untangle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took me an hour to <w>unravel</w> the tangled fishing line.",
                            "target_lang_translations": {
                                "ru": "У меня ушёл час на то, чтобы <w>распутать</w> запутавшуюся леску."
                            }
                        },
                        {
                            "text": "She tried to <w>unravel</w> the knot in the necklace.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>развязать</w> узел на цепочке."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsnarl",
                        "untangle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распутать что-либо завязанное в узел или перекрученное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распутывать",
                                "target_lang_sense_clarification": "несовершенный вид, приводить в порядок спутанное"
                            },
                            {
                                "target_lang_word": "распутать",
                                "target_lang_sense_clarification": "совершенный вид, привести в порядок спутанное"
                            },
                            {
                                "target_lang_word": "развязывать",
                                "target_lang_sense_clarification": "узлы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "055bd8c5-7681-308e-86cf-4db616b53689",
                    "sense_definition": "To solve a mystery or explain a complicated problem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective worked hard to <w>unravel</w> the mystery of the missing jewels.",
                            "target_lang_translations": {
                                "ru": "Детектив усердно работал, чтобы <w>раскрыть</w> тайну пропавших драгоценностей."
                            }
                        },
                        {
                            "text": "Scientists are still trying to <w>unravel</w> the secrets of the human brain.",
                            "target_lang_translations": {
                                "ru": "Учёные всё ещё пытаются <w>разгадать</w> тайны человеческого мозга."
                            }
                        }
                    ],
                    "synonyms": [
                        "unpuzzle",
                        "unriddle",
                        "straighten out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрыть тайну или разобраться в сложной, запутанной проблеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распутывать",
                                "target_lang_sense_clarification": "сложное дело, тайну"
                            },
                            {
                                "target_lang_word": "распутать",
                                "target_lang_sense_clarification": "завершить расследование или разгадку"
                            },
                            {
                                "target_lang_word": "разгадывать",
                                "target_lang_sense_clarification": "тайну, загадку"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "преступление, секрет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf6b7d2-c414-3972-865f-b368f44b61b2",
                    "sense_definition": "To separate the threads of a knitted or woven fabric.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "untangle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>unravel</w> the hem of your new sweater.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы случайно не <w>распустить</w> край своего нового свитера."
                            }
                        },
                        {
                            "text": "The cat began to <w>unravel</w> the edge of the wool blanket.",
                            "target_lang_translations": {
                                "ru": "Кошка принялась <w>распускать</w> край шерстяного одеяла."
                            }
                        }
                    ],
                    "antonyms": [
                        "ravel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распускать нити вязаного или тканого изделия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распускать",
                                "target_lang_sense_clarification": "вязание, ткань"
                            },
                            {
                                "target_lang_word": "распустить",
                                "target_lang_sense_clarification": "вязаную вещь"
                            },
                            {
                                "target_lang_word": "распороть",
                                "target_lang_sense_clarification": "швы, край ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "962ef152-1a3a-3b26-ab56-c47408b2bd17",
                    "sense_definition": "Of fabric or thread, to come apart or separate into individual strands.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "untangle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old scarf started to <w>unravel</w> after years of use.",
                            "target_lang_translations": {
                                "ru": "Старый шарф начал <w>распускаться</w> после долгих лет носки."
                            }
                        },
                        {
                            "text": "I noticed a loose thread <w>unraveling</w> from my sleeve.",
                            "target_lang_translations": {
                                "ru": "Я заметил, как из моего рукава <w>распускается</w> торчащая нитка."
                            }
                        }
                    ],
                    "synonyms": [
                        "come undone"
                    ],
                    "target_lang_definitions": {
                        "ru": "О ткани или нитях: распадаться, распускаться на отдельные волокна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распускаться",
                                "target_lang_sense_clarification": "о вязании, нитках"
                            },
                            {
                                "target_lang_word": "распуститься",
                                "target_lang_sense_clarification": "о трикотаже, шве"
                            },
                            {
                                "target_lang_word": "расползаться",
                                "target_lang_sense_clarification": "о ветхой ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e5514a5-7c7a-3bd9-b3d1-4e45d5ee1b5d",
                    "sense_definition": "To fail, collapse, or fall into disorder.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peace agreement began to <w>unravel</w> after the new election.",
                            "target_lang_translations": {
                                "ru": "Мирное соглашение начало <w>разваливаться</w> после новых выборов."
                            }
                        },
                        {
                            "text": "Their carefully laid plans started to <w>unravel</w> when the funding was cut.",
                            "target_lang_translations": {
                                "ru": "Их тщательно продуманные планы начали <w>рушиться</w>, когда урезали финансирование."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Терпеть неудачу, рушиться, приходить в упадок или беспорядок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рушиться",
                                "target_lang_sense_clarification": "о планах, договоренностях"
                            },
                            {
                                "target_lang_word": "разваливаться",
                                "target_lang_sense_clarification": "о системе, соглашении, структуре"
                            },
                            {
                                "target_lang_word": "трещать по швам",
                                "target_lang_sense_clarification": "образно: о ситуации или планах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}