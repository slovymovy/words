                                "target_senses": [
                                    {
                                        "sense_id": "cb99c7c8-ebb1-3305-8307-a07f9cf5f3b5",
                                        "entry_id": "1abf580b-3555-3a0e-86d7-c27602b31cd7",
                                        "glosses": [
                                            "Gänsekrautgewächs (Spinacia oleracea) mit langgestielten Blättern und getrenntgeschlechtlichen in Knäueln stehenden Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c685385-9ec0-4587-92a3-ac4a873d6406",
                                                "sense_id": "cb99c7c8-ebb1-3305-8307-a07f9cf5f3b5",
                                                "text": "Spinat ist reich an Vitamin A und C sowie an Mineralstoffen."
                                            },
                                            {
                                                "example_id": "ab5d871a-c39a-4330-8707-a9777746c779",
                                                "sense_id": "cb99c7c8-ebb1-3305-8307-a07f9cf5f3b5",
                                                "text": "„Sie war dann still, aber in der Nacht, als er schlief, ist sie aus dem Fenster, und heute morgen war der Spinat plötzlich da.“"
                                            },
                                            {
                                                "example_id": "7bd14eb5-7baa-45d4-8f28-73a1e58e9fbe",
                                                "sense_id": "cb99c7c8-ebb1-3305-8307-a07f9cf5f3b5",
                                                "text": "„Noch mehr zur Erziehung der Hausfrau trug ein unvorsichtiger Gast bei, dem es gelang, einen Löffel Spinat zwischen Schüssel und Teller weitläufig über das schneeweiße Tischtuch zu schlabbern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
