                    {
                        "translation_id": "05ba4ff4-e433-42a1-8709-15437714b867",
                        "source_entry_id": "57c333b6-7315-3e9a-97d1-5cce95dee705",
                        "source_sense_id": "82fd1a44-0b00-30b9-8e17-295cf5c88fdb",
                        "target_lang_word": "triclorometano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "681f0531-52a2-4f8d-93d1-f52857da7f0f",
                        "source_entry_id": "57c333b6-7315-3e9a-97d1-5cce95dee705",
                        "source_sense_id": "82fd1a44-0b00-30b9-8e17-295cf5c88fdb",
                        "target_lang_word": "Chloroform",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chloroform",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                        "entry_id": "cb6d736b-8840-39a8-bc4e-1a896ec5b971",
                                        "glosses": [
                                            "ein 1831 erstmals hergestellter chlorierter Kohlenwasserstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3651edf5-a996-4eee-ba32-fe86eae125c9",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Ihm gelang 1831 die Herstellung von Chloroform, unabhängig von Justus von Liebig und Eugene Souberain.“"
                                            },
                                            {
                                                "example_id": "c0bfc149-47e8-45e6-aafa-df03e3fa5bda",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Am Abend des 4. November 1847 testete er mit zwei Freunden in einer privaten Runde Chloroform als Narkosemittel.“"
                                            },
                                            {
                                                "example_id": "f19f081f-8001-492f-b5b9-85931ba9bc14",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Die Vorteile des neuen Medikamentes lagen darin, dass es leicht herstellbar war, gut sedativ wirkte und wenig Nebenwirkungen aufwies, auch nicht den vom Chloroform bekannten und gefürchteten Rausch.“"
                                            },
                                            {
                                                "example_id": "bc0f6239-d29c-4819-9bf6-146e099260e5",
                                                "sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                                                "text": "„Aus der spanischen Fliege, einem Käfer, der zu den Forstschädlingen gehört, wird durch Ausziehn mit Chloroform eine organische Substanz, das Kantharidin, gewonnen, die offizinell ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e83bb286-e9cd-45c5-8c80-a24ff8c1221d",
