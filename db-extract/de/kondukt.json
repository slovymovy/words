                        "examples": [
                            {
                                "example_id": "5d224450-38b7-4942-85cd-748f4ccd8ca9",
                                "sense_id": "88f61edc-38d3-3324-b4c2-27ec0b6b0dcd",
                                "text": "„Nach der Aufbahrung setzte sich der Kondukt mit rund 150 großteils jungen Angehörigen und Freunden der beiden Verstorbenen in Richtung Stiftskirche in Bewegung.“"
                            },
                            {
                                "example_id": "a0cba8ed-5d24-470e-b84d-536935ce0f8c",
                                "sense_id": "88f61edc-38d3-3324-b4c2-27ec0b6b0dcd",
                                "text": "„Danach ging es im Kondukt zur Beisetzung auf dem Friedhof gleich nebenan.“"
                            }
                        ],
