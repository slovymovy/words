                        "entry_id": "3317b47a-5e66-3ecc-939f-da448e855deb",
                        "glosses": [
                            "One of several categories within a particular genre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8aee64e-62a0-4ca6-ac67-fa14fbce908d",
                                "sense_id": "dea816ff-bbc0-33c7-9f79-0500d4b6eac0",
                                "text": "You have to give director Colm McCarthy, a Scottish TV veteran making his feature film debut, and writer Mike Carey, adapting his own novel, credit for attempting the seemingly impossible task of doing something new with the zombie subgenre."
                            },
                            {
                                "example_id": "d5b132b5-83ca-4c91-9466-53c360d4d206",
                                "sense_id": "dea816ff-bbc0-33c7-9f79-0500d4b6eac0",
                                "text": "Black metal is a subgenre of heavy metal music that typically takes on anti-Christian, satanic and pagan themes."
                            }
                        ]
                    }
