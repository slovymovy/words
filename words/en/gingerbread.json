{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "343e1647-d2ef-3925-81e9-ad3736bfc6d7",
                    "sense_definition": "A baked sweet treat or cake flavored with ginger and molasses or honey.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every holiday season, the children look forward to decorating a <w>gingerbread</w> house.",
                            "target_lang_translations": {
                                "de": "In jeder Weihnachtszeit freuen sich die Kinder darauf, ein <w>Lebkuchenhaus</w> zu verzieren."
                            }
                        },
                        {
                            "text": "She baked fresh <w>gingerbread</w> that filled the entire kitchen with a warm aroma.",
                            "target_lang_translations": {
                                "de": "Sie buk frischen <w>Lebkuchen</w>, der die ganze Küche mit einem warmen Duft erfüllte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gingerbread house",
                        "gingerbread man",
                        "gingerbread cookie"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein süßes Gebäck oder ein Kuchen, der mit Ingwer sowie Melasse oder Honig gewürzt ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Lebkuchen",
                                "target_lang_sense_clarification": "Gebäck zur Weihnachtszeit"
                            },
                            {
                                "target_lang_word": "Pfefferkuchen",
                                "target_lang_sense_clarification": "regional für Lebkuchen"
                            },
                            {
                                "target_lang_word": "Honigkuchen",
                                "target_lang_sense_clarification": "mit Honig gesüßter Lebkuchen"
                            },
                            {
                                "target_lang_word": "Gewürzkuchen",
                                "target_lang_sense_clarification": "kuchenartiges Gebäck"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03994aaf-5ece-3bd4-a21c-9054db52a1e3",
                    "sense_definition": "Elaborate, ornate architectural decoration, especially fretwork or carving characteristic of late Victorian houses.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ornamentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seaside cottages are famous for their colorful Victorian <w>gingerbread</w> along the porches.",
                            "target_lang_translations": {
                                "de": "Die Küstenhäuschen sind berühmt für ihren farbenfrohen viktorianischen <w>Zierrat</w> an den Veranden."
                            }
                        },
                        {
                            "text": "Early modern architects rejected ornate <w>gingerbread</w> in favor of sleek, minimalist lines.",
                            "target_lang_translations": {
                                "de": "Frühe moderne Architekten lehnten verschnörkeltes <w>Schnitzwerk</w> zugunsten schlichter, minimalistischer Linien ab."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Victorian gingerbread"
                    ],
                    "target_lang_definitions": {
                        "de": "Aufwendige, verspielte architektonische Verzierungen, insbesondere Laubsägearbeiten oder Schnitzereien an Häusern aus der späten viktorianischen Zeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Laubsägearbeiten",
                                "target_lang_sense_clarification": "ornamentaler Holzschmuck"
                            },
                            {
                                "target_lang_word": "Schnitzwerk",
                                "target_lang_sense_clarification": "dekorative Holzschnitzereien"
                            },
                            {
                                "target_lang_word": "Zierrat",
                                "target_lang_sense_clarification": "überschwängliche architektonische Ornamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ed745a-1c12-31dd-9d80-289ed39ec074",
                    "sense_definition": "Superficial, showy, or gaudy decoration that conceals a lack of real substance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ornamentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics dismissed the fancy web design as mere <w>gingerbread</w> hiding a weak product.",
                            "target_lang_translations": {
                                "de": "Kritiker taten das ausgefallene Webdesign als bloßen <w>Schnickschnack</w> ab, der ein schwaches Produkt verberge."
                            }
                        },
                        {
                            "text": "Strip away all the rhetorical <w>gingerbread</w>, and you find an empty political promise.",
                            "target_lang_translations": {
                                "de": "Nimmt man all den rhetorischen <w>Firlefanz</w> weg, bleibt nur ein leeres politisches Versprechen übrig."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Oberflächliche, auffällige oder kitschige Ausschmückung, die das Fehlen von wirklicher Substanz verbergen soll."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schnickschnack",
                                "target_lang_sense_clarification": "überflüssiges Beiwerk"
                            },
                            {
                                "target_lang_word": "Flitter",
                                "target_lang_sense_clarification": "wertloses, oberflächliches Beiwerk"
                            },
                            {
                                "target_lang_word": "Firlefanz",
                                "target_lang_sense_clarification": "unnützes Zeug oder Gehabe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52e7486f-f276-32ba-a66f-c7d34a5c8f54",
                    "sense_definition": "To adorn or embellish something in an ornate, fussy, or excessively intricate manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ornamentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>gingerbread</w> the porch railings with intricate scrollwork carvings.",
                            "target_lang_translations": {
                                "de": "Er beschloss, das Geländer der Veranda mit kunstvollen Schnitzereien zu <w>verschnörkeln</w>."
                            }
                        },
                        {
                            "text": "The builders chose to <w>gingerbread</w> the facade until it looked like a fairy tale cottage.",
                            "target_lang_translations": {
                                "de": "Die Erbauer entschieden sich dafür, die Fassade so <w>überladen zu verzieren</w>, bis sie wie ein Märchenhäuschen aussah."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gingerbread up"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas auf übertrieben verspielte, detailreiche oder überladene Weise verzieren oder ausschmücken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschnörkeln",
                                "target_lang_sense_clarification": "übermäßig verzieren"
                            },
                            {
                                "target_lang_word": "überladen verzieren",
                                "target_lang_sense_clarification": "mit vielen Zierelementen versehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}