                        "target_lang_word": "unisexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unisexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8db43fe-8c9a-3a8d-a7e7-8ec3eb6ca3ca",
                                        "entry_id": "4628e242-c663-3dcc-b5e2-55602bccc464",
                                        "glosses": [
                                            "Of an organism, having characteristics of a single sex (as opposed to hermaphrodites)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba1558aa-fd76-47eb-a4a2-4ebcefa3b091",
                                                "sense_id": "d8db43fe-8c9a-3a8d-a7e7-8ec3eb6ca3ca",
                                                "text": "Most animals are unisexual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a38fc30-a126-3590-bcdb-ac02f4126d6a",
                                        "entry_id": "4628e242-c663-3dcc-b5e2-55602bccc464",
                                        "glosses": [
                                            "Of a species, having only a single (potentially hermaphroditic) sex (as opposed to bisexual)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9cf89e3-6380-401d-b05b-e9fbc08de063",
                                                "sense_id": "3a38fc30-a126-3590-bcdb-ac02f4126d6a",
                                                "text": "The second line of inquiry has to do with the ultimate fate of unisexual species. Are they doomed to more rapid extinction than bisexual species? On the assumption that unisexual populations lack genetic variation, most theoretical studies […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111e3225-8f8c-3c8d-907a-9d3a2fe4e010",
                                        "entry_id": "4628e242-c663-3dcc-b5e2-55602bccc464",
                                        "glosses": [
                                            "Unisex; suitable for any sex or gender."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b62e12-e28a-4f30-9bf0-45dbe527d3ee",
                                                "sense_id": "111e3225-8f8c-3c8d-907a-9d3a2fe4e010",
                                                "text": "You may not be familiar with the name or it could be a unisexual name, and some women and men may have first names that are more traditional for the opposite gender."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unisexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76072b1c-76aa-3232-8024-99a7f507a0c7",
                                        "entry_id": "09b2a818-d92f-3a2c-ba8c-86c720b87c03",
                                        "glosses": [
                                            "An organism which is unisexual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8511ea84-85a2-41e1-ad83-5d4e9cccb946",
                                                "sense_id": "76072b1c-76aa-3232-8024-99a7f507a0c7",
                                                "text": "Populations of ambystomatid salamanders on Middle Bass and North Bass Islands in the western basin of Lake Erie consist largely of female unisexuals. On both islands, diploid unisexuals are more abundant than triploid ..."
                                            },
                                            {
                                                "example_id": "ca08f850-ac1d-478c-9be7-35171e6f204b",
                                                "sense_id": "76072b1c-76aa-3232-8024-99a7f507a0c7",
                                                "text": "Samples that included both bisexual and unisexual females were obtained from all localities shown in Figure 2 except sites C, J, and O. The proportion of unisexuals in these samples varied from 2% to 94% of the females in a given sample."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
