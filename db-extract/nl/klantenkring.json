                                        "entry_id": "45e24c1d-414c-3bc6-9f50-b8522076d0c3",
                                        "glosses": [
                                            "The body or class of people who frequent an establishment or purchase a service, especially when considered as forming a more-or-less homogeneous group of clients in terms of values or habits."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a53277-cc80-4e9a-9aca-b3049ae8e295",
                                                "sense_id": "0ec35f8a-3eb7-3577-b295-f529165be9c5",
                                                "text": "Helen's clientele encompasses a broad range of different ages, races and social statuses."
                                            },
                                            {
                                                "example_id": "abb9d1d1-5745-4f98-8a47-90d716682ba8",
                                                "sense_id": "0ec35f8a-3eb7-3577-b295-f529165be9c5",
                                                "text": "The bars’ clientèle called Foucault “Herr Doktor”."
                                            },
                                            {
                                                "example_id": "e9673d46-e343-4dd3-8e40-6fed2cbbe091",
                                                "sense_id": "0ec35f8a-3eb7-3577-b295-f529165be9c5",
                                                "text": "Due to its mixed clientele over the years, the Record Rack has a varied product array."
                                            },
                                            {
                                                "example_id": "e0938d2d-9c05-4cee-837c-45e99fda0efb",
                                                "sense_id": "0ec35f8a-3eb7-3577-b295-f529165be9c5",
                                                "text": "Most of his clientele (95 percent are women, he estimates) were familiar with cupcakes from living or studying abroad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
