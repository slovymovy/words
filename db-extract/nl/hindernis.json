                        "target_lang_word": "Hemmnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hemmnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "807d672b-ce6d-3783-a05a-7c038bfc84ad",
                                        "entry_id": "04e2aa4d-08f6-3adc-aea7-37593ca86991",
                                        "glosses": [
                                            "Erschwernis, Hindernis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a4b991-e34a-4e62-a89f-73d5c30ce42b",
                                                "sense_id": "807d672b-ce6d-3783-a05a-7c038bfc84ad",
                                                "text": "„Das anschließende Gerichtsverfahren wurde zwar wegen mangelnder Beweise eingestellt, aber das politische Hemmnis war aus dem Weg geräumt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57e5b1e9-d997-3904-83db-3490be7c6399",
                                        "entry_id": "04e2aa4d-08f6-3adc-aea7-37593ca86991",
                                        "glosses": [
                                            "künstliches, unnatürliches Hindernis auf dem Golfplatz"
                                        ],
                                        "tags": [
                                            "Golfsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c50e9b02-5d1e-40fc-b587-4d7542934c54",
                                                "sense_id": "57e5b1e9-d997-3904-83db-3490be7c6399",
                                                "text": "Eine Mauer, die Teil der Einzäunung des Golfplatzes ist, ist kein Hemmnis."
                                            },
                                            {
                                                "example_id": "8dffaf5c-8b70-4fa3-884a-0039b6d66812",
                                                "sense_id": "57e5b1e9-d997-3904-83db-3490be7c6399",
                                                "text": "Nicht zu den Hemmnissen gehören Begrenzungen des Platzes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
