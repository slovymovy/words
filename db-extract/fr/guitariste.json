        "fr-extract.jsonl": [
            {
                "entry_id": "8f084875-910b-36e5-bb57-b5655ad31d9a",
                "word": "guitariste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7096647f-5706-4789-8a64-c51852af35ed",
                        "entry_id": "8f084875-910b-36e5-bb57-b5655ad31d9a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "guitaristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "995fac3d-92a8-37c8-a853-31c13f06e4dc",
                        "entry_id": "8f084875-910b-36e5-bb57-b5655ad31d9a",
                        "glosses": [
                            "Celui ou celle qui joue de la guitare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ad2f7d-03b2-441e-945e-a0d02c716cc6",
                                "sense_id": "995fac3d-92a8-37c8-a853-31c13f06e4dc",
                                "text": "Il y avait un homme, un Espagnol, un guitariste qui voyagea longtemps avec Paganini : c’était avant l’époque de la grande gloire officielle de Paganini."
                            },
                            {
                                "example_id": "15a1a4aa-01f4-4de2-96a5-16e0eff6ad47",
                                "sense_id": "995fac3d-92a8-37c8-a853-31c13f06e4dc",
                                "text": "À l’affiche cette année, entre autres, le chanteur, guitariste et auteur-compositeur Gilberto Gil, le pétillant groupe de jazz-funk Earth Wind and Fire, la chanteuse Jane Birkin, l’organiste Rhoda Scott ou encore l’ensemble vocal de gospel Golden Gate Quartet."
                            },
                            {
                                "example_id": "7d8f69b1-e160-4bd1-ab05-99dfeac0e089",
                                "sense_id": "995fac3d-92a8-37c8-a853-31c13f06e4dc",
                                "text": "Avec Sophie Belloir, mezzo-soprano ; Maël Fauvy, guitariste et compositeur, et Chani Stroobant, violoniste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "879054f7-7319-45d7-a0c7-14740bf0a44a",
                        "source_entry_id": "8f084875-910b-36e5-bb57-b5655ad31d9a",
                        "source_sense_id": "995fac3d-92a8-37c8-a853-31c13f06e4dc",
                        "target_lang_word": "Gitarrenspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gitarrenspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f748b1b-d389-34b0-93e2-f607192179b3",
                                        "entry_id": "6afa9c8b-fc23-3a16-a17f-73c6fdc47cd9",
                                        "glosses": [
                                            "(männliche^☆) Person, die Gitarre spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f4e948e-2c2d-4cc2-8eb8-e491ab87d644",
                                                "sense_id": "8f748b1b-d389-34b0-93e2-f607192179b3",
                                                "text": "„Ein Imbissstand verkauft reichlich teure Burger, auf Höhe der Tate Modern hofft ein Gitarrenspieler auf ein paar Münzen.“"
                                            },
                                            {
                                                "example_id": "8d91661c-10ee-4bc2-9d28-e15ae615cba3",
                                                "sense_id": "8f748b1b-d389-34b0-93e2-f607192179b3",
                                                "text": "„Ed Sheeran gilt als passionierter Gitarrenspieler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0063dac2-8246-47f9-8e85-8a85de48eb7e",
                        "source_entry_id": "8f084875-910b-36e5-bb57-b5655ad31d9a",
                        "source_sense_id": "995fac3d-92a8-37c8-a853-31c13f06e4dc",
                        "target_lang_word": "Gitarrenspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gitarrenspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
