                        "source_sense_id": "c235039a-8eb9-3d96-b65e-238d1238d116",
                        "target_lang_word": "alternative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7473faf-885d-3079-8c2c-34fc84dfa171",
                                        "entry_id": "8cf10ada-787a-3fef-9d77-6f5decf540b8",
                                        "glosses": [
                                            "Relating to a choice between two or more possibilities."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b82b5f-f41a-4530-94e3-914978ded33f",
                                                "sense_id": "b7473faf-885d-3079-8c2c-34fc84dfa171",
                                                "text": "an alternative proposition"
                                            },
                                            {
                                                "example_id": "cd44b259-b3e0-4180-a7f0-6af9b0e76156",
                                                "sense_id": "b7473faf-885d-3079-8c2c-34fc84dfa171",
                                                "text": "Reason would seem to dictate that it was an alternative offer,—either to receive $15,000 if the grantor perform the condition or $12,000 if he did not perform the condition."
                                            },
                                            {
                                                "example_id": "0a53a400-a4dc-4603-8d6f-c175ddab9379",
                                                "sense_id": "b7473faf-885d-3079-8c2c-34fc84dfa171",
                                                "text": "Who is right, Augusto or Unamuno? In general critics have seen this confrontation as offering an alternative choice: either we are free or we are predetermined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094bffe4-dacd-342b-a583-c07d0070672e",
                                        "entry_id": "8cf10ada-787a-3fef-9d77-6f5decf540b8",
                                        "glosses": [
                                            "Relating to a choice between two or more possibilities.",
                                            "Presenting two or more alternatives."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb338951-5bfa-4695-adc6-681b3eb7afb7",
                                                "sense_id": "094bffe4-dacd-342b-a583-c07d0070672e",
                                                "text": "alternative conjunctions like or"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17e7fdff-d82b-3b07-a250-8c7a080a6a2a",
                                        "entry_id": "8cf10ada-787a-3fef-9d77-6f5decf540b8",
                                        "glosses": [
                                            "Other; different from something else."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e8bc617-9302-34aa-aa16-3fe903554969",
                                        "entry_id": "8cf10ada-787a-3fef-9d77-6f5decf540b8",
                                        "glosses": [
                                            "Not traditional, outside the mainstream, underground."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3e0287-a0f8-43fe-a245-e2f22ed2d2dc",
                                                "sense_id": "9e8bc617-9302-34aa-aa16-3fe903554969",
                                                "text": "alternative medicine; alternative lifestyle; alternative rock"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a707e1f5-d258-3d76-8b7f-6b01f8241d34",
                                        "entry_id": "8cf10ada-787a-3fef-9d77-6f5decf540b8",
                                        "glosses": [
                                            "Alternate, reciprocal."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe600fb-9d6b-409b-a5d4-de420129060e",
                                                "sense_id": "a707e1f5-d258-3d76-8b7f-6b01f8241d34",
                                                "text": "He [the Sun] it is that giveth light to all things, and riddeth them from darkneſſe : hee hideth the other ſtarres, and ſheweth them againe : he ordereth the ſeaſons in their alternative courſe : he tempereth the yeere, ariſing ever freſh and new againe, for the benefite and good of the world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alternative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3b7daa0-b096-3a65-b908-4c95b4d0b7c0",
                                        "entry_id": "3c66003d-d99a-3845-8d79-6b02464a506d",
                                        "glosses": [
                                            "A situation which allows a mutually exclusive choice between two or more possibilities; a choice between two or more possibilities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d940baa4-ae61-4a79-8e83-31fca7ac89e9",
                                                "sense_id": "f3b7daa0-b096-3a65-b908-4c95b4d0b7c0",
                                                "text": "“The cloister or a betrothed husband?” I echoed—“Is that the alternative destined for Miss Vernon?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb135e53-ed6b-392a-a120-a7c252bbd554",
                                        "entry_id": "3c66003d-d99a-3845-8d79-6b02464a506d",
                                        "glosses": [
                                            "One of several mutually exclusive things which can be chosen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2909355b-2049-4151-92b9-be905db28c39",
                                                "sense_id": "eb135e53-ed6b-392a-a120-a7c252bbd554",
                                                "text": "Between these alternatives there is no middle ground. The Constitution is either a superior, paramount law, unchangeable by ordinary means, or it is on a level with ordinary legislative acts, and, like other acts, is alterable when the legislature shall please to alter it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee66578-2280-3b3e-953d-97fd4e8e61f2",
                                        "entry_id": "3c66003d-d99a-3845-8d79-6b02464a506d",
                                        "glosses": [
                                            "The remaining option; something available after other possibilities have been exhausted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e04ccdec-9e5c-32ae-ae55-a699fc5b5202",
                                        "entry_id": "3c66003d-d99a-3845-8d79-6b02464a506d",
                                        "glosses": [
                                            "alternative rock"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02ee1025-1e63-3ade-a737-2bd1bf9a7f32",
                                        "entry_id": "3c66003d-d99a-3845-8d79-6b02464a506d",
                                        "glosses": [
                                            "A non-offensive word or phrase that serves as a replacement for a word deemed offensive or unacceptable, though not as a euphemism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3a5cdb0-c95c-45ce-8588-d114342c15df",
                                                "sense_id": "02ee1025-1e63-3ade-a737-2bd1bf9a7f32",
                                                "text": "Disability activists discourage the use of the words \"crazy\" and \"insane\" due to their negative connections to mental health, suggesting alternatives such as \"wild\", \"silly\", or \"out of this world\", which do not relate to mental health."
                                            }
                                        ]
                                    }
                                ]
