                "translations": [
                    {
                        "translation_id": "f286b854-a015-4801-a569-acdf52a8d176",
                        "source_entry_id": "0931f338-5fb8-3e1b-95e0-b07f27705f00",
                        "source_sense_id": "e7bdc14a-5b4c-34f9-813f-527b509b87ea",
                        "source_sense_description": "schakeling die een elektrische spanning afgeeft waarvan de grootte onafhankelijk is van de belasting",
                        "target_lang_word": "Spannungsquelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spannungsquelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b20606-886a-3b91-a6b2-f749ecba6d54",
                                        "entry_id": "e50601d8-0472-37f3-81a6-a140b76e8183",
                                        "glosses": [
                                            "Gerät oder Bauteil, das einen elektrischen Potentialunterschied herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08c6c35-86f6-4758-b875-df95740e5a4b",
                                                "sense_id": "a8b20606-886a-3b91-a6b2-f749ecba6d54",
                                                "text": "„Als Spannungsquelle bezeichnet man in der Schaltungstheorie der Elektrotechnik einen aktiven Zweipol, der zwischen seinen Anschlusspunkten eine elektrische Spannung liefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5981215f-5e45-359d-af55-aff2edef8784",
                                        "entry_id": "e50601d8-0472-37f3-81a6-a140b76e8183",
                                        "glosses": [
                                            "Ursache von Unstimmigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d65afa4-9691-4706-8dda-46e979e47d34",
                                                "sense_id": "5981215f-5e45-359d-af55-aff2edef8784",
                                                "text": "„Die Minister sind der Auffassung, daß eine europäische Friedensregelung unter anderem Fortschritte bei der Beseitigung bestehender Spannungsquellen im Herzen Europas voraussetzt.“"
                                            },
                                            {
                                                "example_id": "e1baf8ea-ac6d-4186-9311-5a0ee50f75ed",
                                                "sense_id": "5981215f-5e45-359d-af55-aff2edef8784",
                                                "text": "„Betriebsräte […] können etwa bei der Planung von Arbeitsplätzen und Arbeitsabläufen mitwirken, um Spannungsquellen, die zu Mobbing führen können, schon in der Planungsphase zu verhindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
