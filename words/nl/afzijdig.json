    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95fa4f6c-a758-3943-b6f8-7dea0725089d",
                    "sense_definition": "ervoor kiezen om niet mee te doen of zich ergens niet mee te bemoeien",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non-involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kerken hebben zich tot nu toe in het conflict grotendeels <w>afzijdig</w> gehouden.",
                            "target_lang_translations": {
                                "en": "The churches have largely remained <w>aloof</w> from the conflict so far."
                            }
                        },
                        {
                            "text": "Zij besloot om zich <w>afzijdig</w> te houden tijdens de felle discussie over de nieuwe plannen.",
                            "target_lang_translations": {
                                "en": "She decided to keep <w>aloof</w> during the fierce discussion about the new plans."
                            }
                        }
                    ],
                    "synonyms": [
                        "teruggetrokken",
                        "afgezonderd"
                    ],
                    "antonyms": [
                        "betrokken",
                        "actief"
                    ],
                    "common_phrases": [
                        "zich afzijdig houden"
                    ],
                    "target_lang_definitions": {
                        "en": "choosing not to participate or not to get involved in something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aloof",
                                "target_lang_sense_clarification": "keeping one's distance from a situation or group"
                            },
                            {
                                "target_lang_word": "detached",
                                "target_lang_sense_clarification": "not emotionally or actively involved"
                            },
                            {
                                "target_lang_word": "uninvolved",
                                "target_lang_sense_clarification": "not taking part in something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e471b7-127b-3f11-b782-d510e1f1034e",
                    "sense_definition": "neutraal en niet emotioneel of politiek betrokken bij een situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non-involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het land kan zich geen afwachtende en <w>afzijdige</w> houding veroorloven.",
                            "target_lang_translations": {
                                "en": "The country cannot afford a wait-and-see and <w>neutral</w> attitude."
                            }
                        },
                        {
                            "text": "De journalist probeerde een <w>afzijdige</w> positie in te nemen om objectief te kunnen rapporteren.",
                            "target_lang_translations": {
                                "en": "The journalist tried to take an <w>impartial</w> position in order to report objectively."
                            }
                        }
                    ],
                    "synonyms": [
                        "neutraal",
                        "onpartijdig",
                        "onbetrokken"
                    ],
                    "antonyms": [
                        "partijdig",
                        "geëngageerd"
                    ],
                    "common_phrases": [
                        "een afzijdige houding"
                    ],
                    "target_lang_definitions": {
                        "en": "neutral and not emotionally or politically involved in a situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "neutral",
                                "target_lang_sense_clarification": "not taking sides in a conflict or debate"
                            },
                            {
                                "target_lang_word": "impartial",
                                "target_lang_sense_clarification": "unbiased and objective"
                            },
                            {
                                "target_lang_word": "disinterested",
                                "target_lang_sense_clarification": "having no personal involvement or bias"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d89557f-e609-341c-8f6c-7d1d7d02ce2f",
                    "sense_definition": "apart of afgezonderd van anderen geplaatst of levend",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij woonde in een <w>afzijdig</w> huisje aan de rand van het grote bos.",
                            "target_lang_translations": {
                                "en": "He lived in a <w>secluded</w> cottage on the edge of the large forest."
                            }
                        },
                        {
                            "text": "Tijdens het feestje zat zij op een <w>afzijdige</w> plek rustig een boek te lezen.",
                            "target_lang_translations": {
                                "en": "During the party, she sat in an <w>isolated</w> spot quietly reading a book."
                            }
                        }
                    ],
                    "synonyms": [
