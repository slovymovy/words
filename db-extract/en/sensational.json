                                                "sense_id": "05f5c44f-a521-3cc1-98e1-c0f4c34ec191",
                                                "text": "De nieuwe president hield een opzienbarende speech."
                                            },
                                            {
                                                "example_id": "07fea12b-4b30-4db1-8731-0cb0a325cf25",
                                                "sense_id": "05f5c44f-a521-3cc1-98e1-c0f4c34ec191",
                                                "text": "De leerling haalde een opzienbarend goed cijfer voor wiskunde."
                                            }
