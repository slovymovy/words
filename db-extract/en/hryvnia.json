                                                "sense_id": "36cbe961-1937-343b-b7ac-875a11c701da",
                                                "text": "V první den zavítali stavové všichni, to pod pokutou pěti hřiven do Těšína, aby oslavili přítomností svou zahájení práva zemského."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3f2c5e-8bfa-363f-a80e-7ddc32baec38",
                                        "entry_id": "6eda4d7a-d869-3e3a-9a69-2a3eee7994bf",
                                        "glosses": [
                                            "jednotka hmotnosti"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08772fe-6226-4867-81c4-aef9b5995733",
                                                "sense_id": "ed3f2c5e-8bfa-363f-a80e-7ddc32baec38",
                                                "text": "…že ten hrob Davidův otevřel, a tři tisíce hřiven zlata z něho vzal : pět set z nich Antiochovi dal, aby odtrhl a jeho při pokoji zanechal, ostatek na jiné potřeby obrátil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21ce102-8c6b-36f1-b1b2-8f2cbf608759",
                                        "entry_id": "6eda4d7a-d869-3e3a-9a69-2a3eee7994bf",
                                        "glosses": [
                                            "hodnota obecně, nadání"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c754e9-87e5-4af0-8e92-171c1d906b2f",
                                                "sense_id": "c21ce102-8c6b-36f1-b1b2-8f2cbf608759",
                                                "text": "Bělorusko přispělo svou hřivnou do pokladnice světových kultur a dalo České republice nejen vzpomínku na Franciska Skorinu…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
