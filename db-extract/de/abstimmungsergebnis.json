                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f11091f-d4f3-4a1a-8bec-db32a12a04a5",
                                "sense_id": "2a6de6bb-d688-3828-ab08-d6c6d6220d3d",
                                "text": "Das Abstimmungsergebnis hat ein für alle Beteiligte schwieriges Resultat erbracht."
                            },
                            {
                                "example_id": "5add5606-078e-4eaa-b426-e4975e177d8c",
                                "sense_id": "2a6de6bb-d688-3828-ab08-d6c6d6220d3d",
                                "text": "„Gemäss dem Bundesgericht soll ein knappes Abstimmungsergebnis nur dann nachgezählt werden, wenn es zu Unregelmässigkeiten gekommen ist, die das Resultat beeinflussen können.“"
                            }
                        ],
