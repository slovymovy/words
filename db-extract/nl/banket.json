                    {
                        "sense_id": "5d7a06c8-dcc7-3310-ad49-f4db718e33df",
                        "entry_id": "e21be465-2b5a-36d2-a994-841f2e4680a4",
                        "glosses": [
                            "een feestelijke en vaak ook officiële maaltijd"
                        ],
                        "tags": [
                            "feest"
                        ],
                        "examples": [
                            {
                                "example_id": "83bac5cd-313b-4176-a8e1-a18d084e0694",
                                "sense_id": "5d7a06c8-dcc7-3310-ad49-f4db718e33df",
                                "text": "Zij gaven gisteren een banket."
                            },
                            {
                                "example_id": "0697ce2f-156d-4845-b322-8647a74e8fa8",
                                "sense_id": "5d7a06c8-dcc7-3310-ad49-f4db718e33df",
                                "text": "Slechts twee jaar later zeilde hij het mooiste en snelste jacht dat er toen was naar de overwinning in de Kielregatta en zat aan de tafel van de Kaiser bij het afsluitende banket, net verloofd met Ingeborg."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada0bff1-6266-397c-9f73-606d1a71f814",
                        "entry_id": "e21be465-2b5a-36d2-a994-841f2e4680a4",
                        "glosses": [
                            "een vet en zoet gebak van bladerdeeg dat gevuld is met spijs [2]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fb95b4-96dd-4879-905c-8254b6c94f4c",
                                "sense_id": "ada0bff1-6266-397c-9f73-606d1a71f814",
                                "text": "Wij vinden banket heerlijk!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4e29742f-7387-3881-bb62-74080ddbf14c",
                        "entry_id": "e21be465-2b5a-36d2-a994-841f2e4680a4",
                        "glosses": [
                            "horizontaal gedeelte in een talud; ook gebruikt als ophoging op het strand tegen de duinvoet"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "e42ddb5a-c1d2-40c4-b0c3-010febccee8f",
                                "sense_id": "4e29742f-7387-3881-bb62-74080ddbf14c",
                                "text": "⧖ Ter opsluiting van de ballast zijn over de geheele lijn banketten aangebracht"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d98b0cdc-5149-435c-add0-b0ebbef31677",
                        "source_entry_id": "e21be465-2b5a-36d2-a994-841f2e4680a4",
                        "source_sense_id": "5d7a06c8-dcc7-3310-ad49-f4db718e33df",
                        "source_sense_description": "een feestelijke, officiële maaltijd",
                        "target_lang_word": "Bankett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bankett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f820006-dee1-3bdd-9b3a-4f333c5e04ff",
                                        "entry_id": "2a0eec4d-0302-34f6-8c9b-2b3b701c3245",
                                        "glosses": [
                                            "gemeinsame Mahlzeit in feierlichem Rahmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb19174-5edf-4a2c-92fd-b4ef1bc8ff66",
                                                "sense_id": "4f820006-dee1-3bdd-9b3a-4f333c5e04ff",
                                                "text": "Sie waren zum königlichen Bankett eingeladen."
                                            },
                                            {
                                                "example_id": "fc0fb253-4c0b-4f81-b838-56b3823dd419",
                                                "sense_id": "4f820006-dee1-3bdd-9b3a-4f333c5e04ff",
                                                "text": "„Schließlich schritt die Gesellschaft zum feierlichen Bankett unter freiem Himmel.“"
                                            },
                                            {
                                                "example_id": "1f4d1da9-7aee-409c-849a-340fc5633d7c",
                                                "sense_id": "4f820006-dee1-3bdd-9b3a-4f333c5e04ff",
                                                "text": "„Es gibt Bankette, ein Rennen, eine Militärparade, eine Staatsprozession, in der das Kaiserpaar alle Kirchen der Stadt besucht und Almosen verschenkt.“"
                                            },
                                            {
                                                "example_id": "401183a3-8e89-47d1-b572-a40278e8df43",
                                                "sense_id": "4f820006-dee1-3bdd-9b3a-4f333c5e04ff",
                                                "text": "„Die Bankette finden deshalb im Schloss Charlottenburg statt, einst Wohnsitz der preußischen Könige.“"
                                            },
                                            {
                                                "example_id": "e5be1f0c-8874-4153-9e1a-2d80778ee5ff",
                                                "sense_id": "4f820006-dee1-3bdd-9b3a-4f333c5e04ff",
                                                "text": "„Bei einem Bankett, das der schon ergraute ruhmreiche Feldherr und Herzog Yang Su zu Ehren des vornehmen, schönen Jünglings Li Tsing aus der mächtigen, nach dem Thron strebenden Sippe der Li in seinem Palast gab, durfte sie neben den anderen Damen der Frauengemächer mit dabei sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9086ec18-99f3-3f7e-ae13-68f1ad4ae106",
                                        "entry_id": "2a0eec4d-0302-34f6-8c9b-2b3b701c3245",
                                        "glosses": [
                                            "(im Hotel) Abteilung, in der [1] veranstaltet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34dab6fd-0201-463d-959f-9350ed9df607",
                                                "sense_id": "9086ec18-99f3-3f7e-ae13-68f1ad4ae106",
                                                "text": "Die Feier findet im Bankett statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bankett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "126bdceb-f315-3e2a-8440-f97282e1897a",
                                        "entry_id": "85580286-5309-390d-8037-d3860f2bc947",
                                        "glosses": [
                                            "(im Straßenbau) unbefestigter Seitenstreifen"
                                        ],
