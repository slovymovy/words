                                        "sense_id": "b4c2d2fa-8054-36e2-ad26-344ebea17d3f",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "Six tricks taken by one side."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54ddd7dd-ca63-3405-bf63-d20c1e075ea3",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "Four of a kind."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87d492cc-636c-30a6-9781-0b857c523d21",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "A document, held by the referee, of the incidents that happened in a game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b6c70ac-3d5b-3d44-a42b-e6cc0e2eaf93",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "A list of all players who have been booked (received a warning) in a game."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92eb9536-88b0-449a-8e3e-02ff14a9251f",
                                                "sense_id": "7b6c70ac-3d5b-3d44-a42b-e6cc0e2eaf93",
                                                "text": "Celtic captain Scott Brown joined team-mate Majstorovic in the book and Rangers' John Fleck was also shown a yellow card as an ill-tempered half drew to a close."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1fb7c8b-3b5e-3d5f-b8c1-80d5b24becdf",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "The list of mares that a stallion will breed in a given season."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "557ab874-f3a7-3575-9f24-f2529fb6918e",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "A list of the races that a jockey is scheduled to ride in."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27c60a0c-9f68-31a6-81c7-7ab97b0d7e32",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "The twenty-sixth Lenormand card."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76ae81ac-a600-3ece-a71b-6c2226928c92",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "Any source of instruction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc9ca8a5-a1fd-328f-a08c-db6164632493",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "The accumulated body of knowledge passed down among black pimps."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc3a4b0-33c4-4f4f-a334-92ac2361110a",
                                                "sense_id": "bc9ca8a5-a1fd-328f-a08c-db6164632493",
                                                "text": "The Book is an oral tradition of belief in The Life that has been passed down from player to player from generation to generation."
                                            },
                                            {
                                                "example_id": "67035439-320b-4688-8829-acde3cf9a708",
                                                "sense_id": "bc9ca8a5-a1fd-328f-a08c-db6164632493",
                                                "text": "On the other hand The Book is an oral tradition containing the rules and principles to be adopted by a pimp who wishes to be a player."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "979a577f-d173-3d00-a490-fc90e7355ef4",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "A portfolio of one's previous work in the industry."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a5151e0-82b7-486f-8d03-50373365fd84",
                                                "sense_id": "979a577f-d173-3d00-a490-fc90e7355ef4",
                                                "text": "Getting your book (portfolio) organised is the first step, and knowing both what to include, and what to leave out, is an essential step towards achieving that important agency placement."
                                            },
                                            {
                                                "example_id": "8fb9b625-75fa-4106-acbe-1d9a7e2a83cc",
                                                "sense_id": "979a577f-d173-3d00-a490-fc90e7355ef4",
                                                "text": "Your portfolio — your book — has to be killer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a37166-7b60-3279-970d-a653b7ed08a9",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "The sum of chess knowledge in the opening or endgame."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89999eda-7ccf-431c-8920-dd8d9db3b8bc",
                                                "sense_id": "d9a37166-7b60-3279-970d-a653b7ed08a9",
                                                "text": "The opposite-colored bishops endgame is usually a book draw."
                                            },
                                            {
                                                "example_id": "25eadff5-6f26-4d40-8449-7ecd425b31bd",
                                                "sense_id": "d9a37166-7b60-3279-970d-a653b7ed08a9",
                                                "text": "A book move"
                                            },
                                            {
                                                "example_id": "99242b51-f4b4-409f-9a88-3a408c7b01cf",
                                                "sense_id": "d9a37166-7b60-3279-970d-a653b7ed08a9",
                                                "text": "out of book"
                                            },
                                            {
                                                "example_id": "617ed9b6-3baf-4e2d-9365-37d5b5a1e489",
                                                "sense_id": "d9a37166-7b60-3279-970d-a653b7ed08a9",
                                                "text": "White to move and win. How can he do it? The BK plans a march to h8, eating the f4 pawn en route, for a book draw."
                                            },
                                            {
                                                "example_id": "34e949b9-d031-489e-842f-7d7c9ce4c7cc",
                                                "sense_id": "d9a37166-7b60-3279-970d-a653b7ed08a9",
                                                "text": "This seems certain to simplify into a battle between White's king, rook and two pawns against Black's king and rook. In some cases a book draw is possible. But a book win is more likely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90fe0db9-3af3-3504-80f8-7047b3ac1eea",
                                        "entry_id": "4bf39dba-84cd-316f-82f2-027a5636f99c",
                                        "glosses": [
                                            "A package of silk."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "690753f9-9de4-4c6f-b472-90a4c3b74b8c",
                                                "sense_id": "90fe0db9-3af3-3504-80f8-7047b3ac1eea",
                                                "text": "This machinery was provided with a rotary drum with received upon its periphery the \"books\" of silk to be operated upon and presented them to travelling, combing, or dressing surfaces. The books were clamped and released automatically by the aid of bars formed with wedges and put in operation by screws […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "book",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06bac635-10d2-340b-96cc-ba0e828ab360",
                                        "entry_id": "895d98d1-2d8e-332d-9745-17b5e8af0503",
                                        "glosses": [
                                            "To reserve (something) for future use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8830de3c-3618-4d45-a168-4c88ed73fc58",
                                                "sense_id": "06bac635-10d2-340b-96cc-ba0e828ab360",
                                                "text": "I want to book a hotel room for tomorrow night."
                                            },
                                            {
                                                "example_id": "3f422ed0-d45d-43ad-910f-d4fadadd362d",
                                                "sense_id": "06bac635-10d2-340b-96cc-ba0e828ab360",
                                                "text": "I can book tickets for the concert next week."
                                            },
                                            {
                                                "example_id": "50cca059-98af-4c63-90f7-72c813f57ae6",
                                                "sense_id": "06bac635-10d2-340b-96cc-ba0e828ab360",
