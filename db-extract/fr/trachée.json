                        ],
                        "form": "trachées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc5e9faf-a280-37f0-88df-59881caa436b",
                        "entry_id": "f0eb112b-3290-31c3-990c-36c6118b8ff5",
                        "glosses": [
                            "Tube délié, petit vaisseau des insectes et des plantes, formé d’un fil élastique contourné en spirale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30c1435-b922-40e7-ae4f-283b570cfe0c",
                                "sense_id": "fc5e9faf-a280-37f0-88df-59881caa436b",
                                "text": "Les insectes respirent par les trachées."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2cd4438-088a-3a2e-83c5-9dd7b3b2fe19",
                        "entry_id": "f0eb112b-3290-31c3-990c-36c6118b8ff5",
                        "glosses": [
                            "Tuyau élastique qui, chez les vertébrés, permet de transporter l’air entre le larynx et les bronches, aussi appelé trachée-artère."
                        ],
                        "tags": [
                            "Pneumologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dd24c607-c2ff-4e13-bfd3-a5c0dd1b69cd",
                                "sense_id": "e2cd4438-088a-3a2e-83c5-9dd7b3b2fe19",
                                "text": "L’hypertrophie thyroïdienne dont est atteint le sujet, et peut-être aussi un certain degré de sthénose de la trachée, consécutive à la trachéotomie, rendirent la chloroformisation très difficile."
                            },
                            {
                                "example_id": "36984da8-7e21-46ed-856d-36822397d4b2",
                                "sense_id": "e2cd4438-088a-3a2e-83c5-9dd7b3b2fe19",
                                "text": "Il pesa de tout son poids sur le bambou, le plus fort qu’il le pût, écrasant la trachée du Yab."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36f425f8-1d99-4baf-8b0a-1b68d7d3f64b",
                        "source_entry_id": "f0eb112b-3290-31c3-990c-36c6118b8ff5",
                        "source_sense_description": "organe de la respiration des vertébrés",
                        "target_lang_word": "Luftröhre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftröhre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                        "entry_id": "c687dd61-0883-3ac2-83cc-50a7bddf86df",
                                        "glosses": [
                                            "Teil der Atemwege; Zubringer der Atemluft zu den Bronchien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743a64c3-f349-4f16-bbeb-38fe4660ba3e",
                                                "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                                "text": "Sie lachte beim Trinken, so dass etwas Wein in die Luftröhre gelangte."
                                            },
                                            {
                                                "example_id": "2c43dd4f-92e6-4c82-af89-74cf6aa27432",
                                                "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                                "text": "„Die Beschreibung von Stimmritze, Nase mit Velum, Mund, Zunge, Zähnen und Lippen als Artikulatoren und von Lunge, Luftröhre und Larynx mit Glottis als zur Stimmerzeugung notwendigen Werkzeugen entspricht im Wesentlichen der auch heute noch in der artikulatorischen Phonetik benutzten Klassifikation.“"
                                            },
                                            {
                                                "example_id": "90f3f7d5-36bf-4f84-94af-49c42b99bfe4",
                                                "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                                "text": "„Mit Schwellungen an Lippen, Zunge und in der Luftröhre war der Student bewusstlos ins Krankenhaus eingeliefert worden, sein Zustand war lebensbedrohend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
