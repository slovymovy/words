{
    "word_family": [
        "assertion",
        "assertive",
        "assertiveness",
        "assertor",
        "reassert"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7230124-690a-3316-9750-17f6ccebaadb",
                    "sense_definition": "To state a fact or belief confidently and forcefully.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "declare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness continued to <w>assert</w> that he had seen the defendant at the scene.",
                            "target_lang_translations": {
                                "ru": "Свидетель продолжал <w>утверждать</w>, что видел подсудимого на месте происшествия."
                            }
                        },
                        {
                            "text": "It is difficult to <w>assert</w> authority when you do not have the support of your team.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>утверждать</w> свой авторитет, когда у тебя нет поддержки команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "affirm",
                        "aver",
                        "avow"
                    ],
                    "antonyms": [
                        "deny"
                    ],
                    "common_phrases": [
                        "assert authority",
                        "assert a claim",
                        "boldly assert"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уверенно и решительно заявлять о факте или убеждении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "уверенно высказывать что-либо"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "официально или открыто сообщать"
                            },
                            {
                                "target_lang_word": "отстаивать",
                                "target_lang_sense_clarification": "настаивать на правильности чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f494a7-cabc-3b66-b29c-cbe4267e2a81",
                    "sense_definition": "To use or exercise a right or power so that its existence is recognized.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise_rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>assert</w> its rights under the terms of the contract.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>отстоять</w> свои права в соответствии с условиями контракта."
                            }
                        },
                        {
                            "text": "You must <w>assert</w> your independence if you want to make your own decisions.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>отстаивать</w> свою независимость, если хотите принимать собственные решения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assert your rights",
                        "assert independence",
                        "assert control"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать или осуществлять право или власть, чтобы добиться их признания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстаивать",
                                "target_lang_sense_clarification": "защищать свои права или интересы"
                            },
                            {
                                "target_lang_word": "предъявлять",
                                "target_lang_sense_clarification": "заявлять о своих правах или требованиях"
                            },
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "применять власть или права на практике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bb2da8f-8b9c-35c6-b81a-0b023d6eab95",
                    "sense_definition": "To behave in a confident way so that people take notice of your opinions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has learned to <w>assert</w> herself more in business meetings.",
                            "target_lang_translations": {
                                "ru": "Она научилась вести себя более <w>уверенно</w> на деловых встречах."
                            }
                        },
                        {
                            "text": "It is important to <w>assert</w> yourself without being aggressive toward others.",
                            "target_lang_translations": {
                                "ru": "Важно уметь <w>постоять за себя</w>, не проявляя агрессии к окружающим."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assert yourself",
                        "assert one's presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя уверенно, чтобы окружающие считались с вашим мнением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждаться",
                                "target_lang_sense_clarification": "добиваться признания, заявлять о себе"
                            },
                            {
                                "target_lang_word": "проявлять характер",
                                "target_lang_sense_clarification": "действовать решительно и уверенно"
                            },
                            {
                                "target_lang_word": "самоутверждаться",
                                "target_lang_sense_clarification": "доказывать свою значимость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83e32414-0cea-36e7-9c37-db07b990413d",
                    "sense_definition": "To declare that a condition must be true at a specific point in a computer program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer used a command to <w>assert</w> that the input value was never zero.",
                            "target_lang_translations": {
                                "ru": "Программист использовал команду, чтобы <w>подтвердить</w>, что входное значение никогда не было равным нулю."
                            }
                        },
                        {
                            "text": "If the condition fails, the system will <w>assert</w> an error and stop the process.",
                            "target_lang_translations": {
                                "ru": "Если условие не будет выполнено, система <w>выдаст</w> ошибку и остановит процесс."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assert a condition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять, что условие должно быть истинным в определенной точке компьютерной программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проверять условие",
                                "target_lang_sense_clarification": "использовать макрос assert для проверки истинности"
                            },
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "задавать логическое утверждение в коде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe97a747-5aed-39aa-a245-249d4a2e3b3f",
                    "sense_definition": "To set a signal on an electrical line using a specific voltage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controller will <w>assert</w> the interrupt signal to stop the current operation.",
                            "target_lang_translations": {
                                "ru": "Контроллер <w>активирует</w> сигнал прерывания, чтобы остановить текущую операцию."
                            }
                        },
                        {
                            "text": "When the data is ready, the device will <w>assert</w> the logic high signal.",
                            "target_lang_translations": {
                                "ru": "Когда данные будут готовы, устройство <w>выставит</w> сигнал логической единицы."
                            }
                        }
                    ],
                    "antonyms": [
                        "deassert"
                    ],
                    "common_phrases": [
                        "assert a signal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать сигнал на электрической линии, используя определенное напряжение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активировать",
                                "target_lang_sense_clarification": "подавать активный уровень сигнала"
                            },
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "устанавливать значение сигнала на шине"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b458c872-6690-320f-a61e-2764db882cbd",
                    "sense_definition": "A synonym of <w>assertion</w>; a confident and forceful statement of fact or belief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "declare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document was filled with various <w>asserts</w> regarding the company's future growth.",
                            "target_lang_translations": {
                                "ru": "Документ был полон различных <w>утверждений</w> относительно будущего роста компании."
                            }
                        },
                        {
                            "text": "His latest <w>assert</w> about the economy was met with skepticism by the experts.",
                            "target_lang_translations": {
                                "ru": "Его последнее <w>заявление</w> об экономике было встречено экспертами со скептицизмом."
                            }
                        }
                    ],
                    "synonyms": [
                        "assertion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уверенное и решительное заявление о факте или убеждении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "высказанная мысль, положение"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "сообщение о чем-либо в официальной форме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}