                                            {
                                                "example_id": "15c95202-7928-408f-86ed-9e43c922ddc8",
                                                "sense_id": "c3d4b973-923c-3a80-aebc-0cc2c49c0dab",
                                                "text": "Erfurt liegt am Fluss Gera."
                                            },
                                            {
                                                "example_id": "96d23fff-fe1f-46e9-ad06-557447bca728",
                                                "sense_id": "c3d4b973-923c-3a80-aebc-0cc2c49c0dab",
                                                "text": "Für ein Schulprojekt musste er sich über das Erfurt der zwanziger Jahre informieren."
                                            },
                                            {
                                                "example_id": "527c80b6-aa15-44c8-b85c-c6f67d9a176d",
                                                "sense_id": "c3d4b973-923c-3a80-aebc-0cc2c49c0dab",
                                                "text": "„Ich war tatsächlich einmal hingefahren und hatte mich mit irgendwelchen Kulturfritzen in Erfurt getroffen.“"
                                            },
                                            {
                                                "example_id": "d528940c-cf9a-4fe3-ae6b-903d7e61ff40",
                                                "sense_id": "c3d4b973-923c-3a80-aebc-0cc2c49c0dab",
                                                "text": "„Am Ende stand der Ruf an die Universität von Erfurt.“"
                                            },
                                            {
                                                "example_id": "41b2dea9-0bb9-4e8d-bd65-8cf23d6be220",
                                                "sense_id": "c3d4b973-923c-3a80-aebc-0cc2c49c0dab",
                                                "text": "„In Erfurt, einer der renommiertesten Universitätsstädte des Reichs, kam es in der aufgeheizten Stimmung des ›tollen Jahrs‹ bei einem Kirchweihfest zu bürgerkriegsähnlichen Kämpfen zwischen Studenten und Stadtbürgern und zur Erstürmung eines Kollegs durch städtische Söldner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
